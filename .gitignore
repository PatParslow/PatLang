# Rust build output
/rust-runtime/target/
**/*.rs.bk
*.pdb

# Self-hosted compiler build artifacts (regenerate: pat --ir-run self_hosting/build_patc1.patlang)
self_hosting/build/
patc1.exe
patc2.exe

