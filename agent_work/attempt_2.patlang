make a function called isPalindrome takes s returns result
  if s == "" then
    let result = true
  else
    let filtered_chars = []
    let i = 0
    while i < s.length do
      let c = char_code(s, i)
      if (c >= char_code("a") and c <= char_code("z")) or (c >= char_code("A") and c <= char_code("Z")) or (c >= char_code("0") and c <= char_code("9")) then
        list_push(filtered_chars, chr(c))
      end
      let i = i + 1
    end
    
    if filtered_chars.length == 0 then
      let result = true
    else
      let j = 0
      while j < (filtered_chars.length / 2) do
        if filtered_chars[j] != filtered_chars[filtered_chars.length - 1 - j] then
          let result = false
          break
        end
        let j = j + 1
      end
      
      if j == (filtered_chars.length / 2) then
        let result = true
      end
    end
  end
  
  return result
end

print(isPalindrome("Race car"))
print(isPalindrome("hello"))
print(isPalindrome(""))
print(isPalindrome("A man, a plan, a canal, Panama"))
print(isPalindrome("Was it a car or a cat I saw?"))
print(isPalindrome("Not a palindrome"))

make a function called check_palindrome takes s returns done
  let actual = isPalindrome(s)
  if actual == true then
    print("PASS: " + s + " is a palindrome")
  else
    print("FAIL: " + s + " is not a palindrome")
  end
  return true
end

check_palindrome("Race car")
check_palindrome("hello")
check_palindrome("")
check_palindrome("A man, a plan, a canal, Panama")
check_palindrome("Was it a car or a cat I saw?")
check_palindrome("Not a palindrome")