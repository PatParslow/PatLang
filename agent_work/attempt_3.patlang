make a function called isPalindrome takes s returns result
  # Normalize the string to lowercase and filter out non-alphanumeric characters
  let normalized = []
  let i = 0
  while i < s.length do
    if (s[i] >= 'a' and s[i] <= 'z') or (s[i] >= 'A' and s[i] <= 'Z') or (s[i] >= '0' and s[i] <= '9') then
      let normalized = list_push(normalized, char_code(s[i]))
    end
    let i = i + 1
  end

  # Convert to lowercase for case-insensitive comparison
  let i = 0
  while i < normalized.length do
    if normalized[i] >= 65 and normalized[i] <= 90 then
      let normalized[i] = normalized[i] + 32
    end
    let i = i + 1
  end

  # Check if the normalized string is a palindrome
  let left = 0
  let right = normalized.length - 1
  while left < right do
    if normalized[left] != normalized[right] then
      return false
    end
    let left = left + 1
    let right = right - 1
  end

  return true
end

# Example usage:
print(isPalindrome("Race car"))  # Output: true
print(isPalindrome("hello"))     # Output: false
print(isPalindrome(""))          # Output: true
print(isPalindrome("A man, a plan, a canal, Panama"))  # Output: true

make a function called check_isPalindrome takes s, expected returns done
  let actual = isPalindrome(s)
  if actual == expected then
    print("PASS: isPalindrome(\"" + s + "\")")
  else
    print("FAIL: isPalindrome(\"" + s + "\") expected " + expected + " got " + actual)
  end
  return true
end

check_isPalindrome("Race car", true)
check_isPalindrome("hello", false)
check_isPalindrome("", true)
check_isPalindrome("A man, a plan, a canal, Panama", true)
check_isPalindrome("No lemon, no melon", true)
check_isPalindrome("Was it a car or a cat I saw?", true)
check_isPalindrome("Not a palindrome", false)
