make a function called isPalindrome takes s returns result
  # Check for empty string immediately
  if s.length == 0 then
    return true
  end

  # Extract alphanumeric characters and convert to lowercase
  let chars = []
  let i = 0
  while i < s.length do
    let ch = s[i]
    if (ch >= 'a' and ch <= 'z') or (ch >= 'A' and ch <= 'Z') or (ch >= '0' and ch <= '9') then
      list_push(chars, char_code(ch) % 32) # Convert to lowercase by taking modulo 32 of ASCII value
    end
    let i = i + 1
  end

  # If no alphanumeric characters, it's a palindrome
  if chars.length == 0 then
    return true
  end

  # Compare elements from start and end moving inward
  let left = 0
  let right = chars.length - 1
  while left < right do
    if chars[left] != chars[right] then
      return false
    end
    let left = left + 1
    let right = right - 1
  end

  # If no mismatches found, it's a palindrome
  return true
end

# Example usage:
print(isPalindrome("Race car")) # Should print true
print(isPalindrome("hello"))    # Should print false


make a function called check_isPalindrome takes s, expected returns done
  let actual = isPalindrome(s)
  if actual == expected then
    print("PASS: isPalindrome('" + s + "')")
  else
    print("FAIL: isPalindrome('" + s + "') expected " + expected + " got " + actual)
  end
  return true
end

check_isPalindrome("", true) # Empty string should be a palindrome
check_isPalindrome("A man, a plan, a canal, Panama", true) # Case-insensitive and ignoring punctuation/space
check_isPalindrome("race a car", false) # Contains non-alphanumeric characters but is not a palindrome
check_isPalindrome("no lemon, no melon", true) # Punctuation and case-insensitivity should be handled
check_isPalindrome("0P", false) # Contains digits but is not a palindrome