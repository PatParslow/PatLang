make a function called isPalindrome takes s returns result
  if s == "" then
    return true
  end
  
  let alphanumeric_chars = []
  let i = 0
  while i < s.length do
    let c = char_code(s, i)
    if (c >= char_code('a') and c <= char_code('z')) or 
       (c >= char_code('A') and c <= char_code('Z')) or 
       (c >= char_code('0') and c <= char_code('9')) then
      list_push(alphanumeric_chars, toLower(substr(s, i, 1)))
    end
    let i = i + 1
  end
  
  if alphanumeric_chars.length == 0 then
    return true
  end
  
  let left = 0
  let right = alphanumeric_chars.length - 1
  while left < right do
    if alphanumeric_chars[left] != alphanumeric_chars[right] then
      return false
    end
    let left = left + 1
    let right = right - 1
  end
  
  return true
end

print(isPalindrome("race car"))   # should print: true
print(isPalindrome("hello"))     # should print: false


make a function called check_isPalindrome takes s, expected returns done
  let result = isPalindrome(s)
  if result == expected then
    print("PASS: isPalindrome('" + s + "')")
  else
    print("FAIL: isPalindrome('" + s + "') expected " + expected + " got " + result)
  end
  return true
end

check_isPalindrome("", true)
check_isPalindrome("A man, a plan, a canal, Panama", true)
check_isPalindrome("race car", true)
check_isPalindrome("hello", false)
check_isPalindrome("Was it a car or a cat I saw?", true)
check_isPalindrome("Not a palindrome", false)
check_isPalindrome(" ", true)