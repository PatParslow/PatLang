make a function called renderPrimeTester takes no arguments retuurns ui_component
▁▁let number_input = input("Number to Test", placeholder="Enter a number")
▁▁let filter_checkbox = checkbox("Filter integers only")
▁▁let result_display = text("Prime Result")

▁▁let submit_button = button("Calculate")

▁▁let validate_input = function(input_value)
▁▁▁▁if filter_checkbox.checked then
▁▁▁▁▁▁let regex = "^[0-9]+$"
▁▁▁▁▁▁if input_value != "" and not input_value matches regex then
▁▁▁▁▁▁▁▁print("Error: Only integers allowed.")
▁▁▁▁▁▁▁▁return false
▁▁▁▁▁▁else
▁▁▁▁▁▁▁▁return true
▁▁▁▁▁▁end
▁▁▁▁else
▁▁▁▁▁▁return true #allow any string as a number to test. 
▁▁▁▁end

▁▁let calculate_primes = function(number_str)
▁▁▁▁if number_str == "" then
▁▁▁▁▁▁print("Please enter a number.")
▁▁▁▁▁▁return false
▁▁▁▁end

▁▁▁▁let number = to_int(number_str) #attempt conversion; returns 0 if invalid.
▁▁▁▁if number == 0 then
▁▁▁▁▁▁▁▁print("Invalid input")
▁▁▁▁▁▁▁▁return false
▁▁▁▁end


▁▁▁▁let is_prime = function(n)
▁▁▁▁▁▁if n <= 1 then return false
▁▁▁▁▁▁let i = 2
▁▁▁▁▁▁while i * i <= n do
▁▁▁▁▁▁▁▁if n % i == 0 then return false
▁▁▁▁▁▁▁▁let i = i + 1
▁▁▁▁▁▁end
▁▁▁▁▁▁return true
▁▁▁▁end

▁▁▁▁let result_str = if is_prime(number) then "Yes" else "No"
▁▁▁▁set_text(result_display, result_str)
▁▁▁▁return true #indicate successful calculation.



▁▁# Handle the submit button click event
▁▁on_click(submit_button) do
▁▁▁▁let number_str = get_text(number_input)

▁▁▁▁if validate_input(number_str) then
▁▁▁▁▁▁calculate_primes(number_str)
▁▁▁▁else
▁▁▁▁▁▁print("Please enter a valid number.") #display to user. 
▁▁▁▁end


end

