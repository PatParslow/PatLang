 let input1 = input_field("Number to Test")
 let input2 = input_field("Test Type")
 let checkbox = checkbox("Restrict to Integers")
 let submit_button = button("Calculate")

 let is_integer_only = checkbox.value

 let calculate_function = function(number, test_type)
▁▁if is_integer_only then
▁▁▁▁if not is_integer(number) then
▁▁▁▁▁▁print("Error: Only integers allowed.")
▁▁▁▁▁▁return "" # Return empty string to prevent display
▁▁▁▁end
▁▁▁if number <= 1 then
▁▁▁▁▁print("Not a prime")
▁▁▁else
▁▁▁▁let is_prime = true
▁▁▁▁let i = 2
▁▁▁▁while i * i <= number do
▁▁▁▁▁▁if number % i == 0 then
▁▁▁▁▁▁▁▁let is_prime = false
▁▁▁▁▁▁▁▁break
▁▁▁▁▁▁end
▁▁▁▁▁▁let i = i + 1
▁▁▁▁end
▁▁▁▁if is_prime then
▁▁▁▁▁▁print(number + " is a prime")
▁▁▁▁else
▁▁▁▁▁▁print(number + " is not a prime")
▁▁▁▁end

▁▁else
▁▁▁print("Prime test for: " + number + ", type: " + test_type) #Show input details.



 end


 let on_submit = function()
▁▁let num_to_test = input1.value
▁▁let test_type = input2.value
▁▁if num_to_test == "" and test_type == "" then
▁▁▁▁print("Please enter a number to test.")
▁▁▁▁return
▁▁end

▁▁if is_integer_only then
▁▁▁▁▁▁if not is_integer(num_to_test) then
▁▁▁▁▁▁▁▁▁print("Invalid input: Only integers are allowed")
▁▁▁▁▁▁▁▁▁return
▁▁▁▁▁▁end
▁▁end

▁▁calculate_function(num_to_test, test_type)


 end

 let ui = vcomponent(
▁▁input1,
▁▁input2,
▁▁checkbox,
▁▁submit_button,
▁▁on_submit = on_submit
 )

 return ui
end

