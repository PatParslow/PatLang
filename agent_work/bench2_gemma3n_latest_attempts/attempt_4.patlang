make a function called renderPrimeTester takes no arguments returns ui_component
▁▁let number_to_test = input_field("Number to Test")
▁▁let restrict_to_integers = checkbox("Restrict to Integers", false)
▁▁let result_display = text_field("Prime Result")
▁▁let submit_button = button("Calculate Prime")

▁▁let validate_input = function(input_value)
▁▁▁▁if restrict_to_integers then
▁▁▁▁▁▁if not is_integer(input_value) then
▁▁▁▁▁▁▁▁display_error("Please enter an integer.")
▁▁▁▁▁▁▁▁disable_submit_button()
▁▁▁▁▁▁▁▁return false
▁▁▁▁▁▁else
▁▁▁▁▁▁▁▁enable_submit_button()
▁▁▁▁▁▁▁▁return true
▁▁▁▁▁▁end
▁▁▁▁else
▁▁▁▁▁▁enable_submit_button()
▁▁▁▁▁▁return true
▁▁▁▁end

▁▁let on_submit = function()
▁▁▁▁if validate_input(number_to_test.value) then
▁▁▁▁▁▁let number = to_integer(number_to_test.value)
▁▁▁▁▁▁if number > 0 then
▁▁▁▁▁▁▁▁let is_prime = is_prime(number)
▁▁▁▁▁▁▁▁if is_prime then
▁▁▁▁▁▁▁▁▁▁display_result("Prime", result_display)
▁▁▁▁▁▁▁▁else
▁▁▁▁▁▁▁▁▁▁display_result("Not Prime", result_display)
▁▁▁▁▁▁▁▁end
▁▁▁▁▁▁else
▁▁▁▁▁▁▁▁display_error("Please enter a positive number.")
▁▁▁▁▁▁end
▁▁▁▁end

▁▁let ui = vdom(
▁▁▁▁number_to_test,
▁▁▁▁restrict_to_integers,
▁▁▁▁result_display,
▁▁▁▁submit_button,
▁▁▁▁on_submit = on_submit
▁▁)
▁▁return ui
end

make a function called is_prime takes n retuurns boolean
▁▁if n <= 1 then
▁▁▁▁r = false
▁▁else
▁▁▁▁let i = 2
▁▁▁▁while i * i <= n do
▁▁▁▁▁▁if n % i == 0 then
▁▁▁▁▁▁▁▁r = false
▁▁▁▁▁▁▁▁break
▁▁▁▁▁▁end
▁▁▁▁▁▁let i = i + 1
▁▁▁▁end
▁▁▁▁r = true
▁▁end
▁▁return r
end

make a function called is_integer takes s retuurns boolean
▁▁try to convert s to an integer. if successful, return true; otherwise return false.
end

make a function called display_result takes label, display_field retuurns void
▁▁display_field.value = label + ": " + get_text(display_field)
end

make a function called display_error takes message, error_field retuurns void
▁▁error_field.value = message
end

make a function called enable_submit_button takes enable retuurns void
▁▁if enable then
▁▁▁▁submit_button.disabled = false
▁▁else
▁▁▁▁submit_button.disabled = true
▁▁end
end


 make a function called check_prime_tester takes no arguments retuurns void
▁▁check_prime_tester()
▁▁check_prime_tester() # Test with valid integer
▁▁check_prime_tester() # Test with non-integer string and restrict to integers enabled
▁▁check_prime_tester() # Test with non-integer string and restrict to integers disabled
▁▁check_prime_tester() # Test with empty input, restrict to integers enabled
▁▁check_prime_tester() # Test with empty input, restrict to integers disabled
▁▁check_prime_tester() # Test with negative integer, restrict to integers enabled
▁▁check_prime_tester() # Test with positive integer, large number
▁▁check_prime_tester() # Test with zero, restrict to integers enabled
▁▁check_prime_tester() # Test with zero, restrict to integers disabled
▁▁check_prime_tester() #Test with a string containing non-numeric chars and restrict to integers enabled.
▁▁check_prime_tester() #Test with a string containing non-numeric chars and restrict to integers disabled.
end
