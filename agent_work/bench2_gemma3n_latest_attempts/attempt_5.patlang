def renderPrimeTester() -> UIComponent:
▁▁▁▁"""
▁▁▁▁Renders a UI component for testing prime numbers.▁▁Includes input fields,
▁▁▁▁a checkbox to restrict input to integers, and a button to trigger the calculation.
▁▁▁▁Handles edge cases like empty inputs and invalid characters gracefully.
▁▁▁▁"""

▁▁▁▁prime_tester_ui = Container()

▁▁▁▁# UI Elements
▁▁▁▁number_input = TextField("Number to Test")
▁▁▁▁filter_checkbox = Checkbox("Restrict to Integers")
▁▁▁▁result_label = Label("Prime Result:")
▁▁▁▁result_display = TextField("Result", readonly=True)▁▁# Make read-only for display
▁▁▁▁submit_button = Button("Calculate")

▁▁▁▁number_input_group = Group()
▁▁▁▁filter_group = Group()
▁▁▁▁result_group = Group()
▁▁▁▁button_group = Group()

▁▁▁▁number_label = Label("Number to Test:")
▁▁▁▁filter_label = Label("Restrict to Integers:")
▁▁▁▁result_label_element = Label("Prime Result:")

▁▁▁▁# UI Layout (using groups for organization)
▁▁▁▁add_element(prime_tester_ui, number_input_group)
▁▁▁▁add_element(number_input_group, number_label)
▁▁▁▁add_element(number_input_group, number_input)

▁▁▁▁add_element(prime_tester_ui, filter_group)
▁▁▁▁add_element(filter_group, filter_checkbox)
▁▁▁▁add_element(filter_group, filter_label)

▁▁▁▁add_element(prime_tester_ui, result_group)
▁▁▁▁add_element(result_group, result_label_element)
▁▁▁▁add_element(result_group, result_display)

▁▁▁▁add_element(prime_tester_ui, button_group)
▁▁▁▁add_element(button_group, submit_button)


▁▁▁▁# Input Validation and Calculation Functions (Refactored & Improved)

▁▁▁▁def validate_input() -> bool:
▁▁▁▁▁▁▁▁"""Validates the input fields based on the checkbox state."""
▁▁▁▁▁▁▁▁number_text = number_input.value
▁▁▁▁▁▁▁▁filter_checked = filter_checkbox.checked

▁▁▁▁▁▁▁▁if not number_text and not filter_checked:
▁▁▁▁▁▁▁▁▁▁▁▁print("Error: Please enter a number.")
▁▁▁▁▁▁▁▁▁▁▁▁return False▁▁# Indicate validation failure

▁▁▁▁▁▁▁▁if filter_checked and not is_integer(number_text):
▁▁▁▁▁▁▁▁▁▁▁▁print("Error: Please enter an integer.")
▁▁▁▁▁▁▁▁▁▁▁▁return False

▁▁▁▁▁▁▁▁return True▁▁# Validation successful


▁▁▁▁def calculate_prime() -> None:
▁▁▁▁▁▁▁▁"""Calculates whether the input number is prime, handling errors."""
▁▁▁▁▁▁▁▁number_text = number_input.value
▁▁▁▁▁▁▁▁filter_checked = filter_checkbox.checked

▁▁▁▁▁▁▁▁if not validate_input():
▁▁▁▁▁▁▁▁▁▁▁▁return▁▁# Exit early if validation fails


▁▁▁▁▁▁▁▁try: #Robust error handling for to_integer. 
▁▁▁▁▁▁▁▁▁▁▁▁number = to_integer(number_text)▁▁# Attempt conversion

▁▁▁▁▁▁▁▁▁▁▁▁if number > 1 and is_prime(number):
▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁result_display.value = "Prime"
▁▁▁▁▁▁▁▁▁▁▁▁else:
▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁result_display.value = "Not Prime"

▁▁▁▁▁▁▁▁except ValueError: #Catch errors that could happen during to_integer, or if the input string cannot be converted at all.
▁▁▁▁▁▁▁▁▁▁▁print("Error: Invalid number format.")
▁▁▁▁▁▁▁▁▁▁▁result_display.value = "Error"▁▁# Display an error message


▁▁▁▁def is_prime(n: int) -> bool:
▁▁▁▁▁▁▁▁"""Checks if a number is prime."""
▁▁▁▁▁▁▁▁if n <= 1:
▁▁▁▁▁▁▁▁▁▁▁▁return False
▁▁▁▁▁▁▁▁for i in range(2, int(n**0.5) + 1): #Optimization - only check up to the square root of n
▁▁▁▁▁▁▁▁▁▁▁▁if n % i == 0:
▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁return False
▁▁▁▁▁▁▁▁return True

▁▁▁▁def is_integer(s: str) -> bool:
▁▁▁▁▁▁▁▁"""Checks if a string represents an integer."""
▁▁▁▁▁▁▁▁if not s:▁▁# Empty string is not considered an integer.
▁▁▁▁▁▁▁▁▁▁▁▁return False
▁▁▁▁▁▁▁▁for char in s:
▁▁▁▁▁▁▁▁▁▁▁▁if not '0' <= char <= '9':
▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁return False
▁▁▁▁▁▁▁▁return True

▁▁▁▁def to_integer(s: str) -> int:
▁▁▁▁▁▁▁▁▁"""Converts a string to an integer, handling errors."""
▁▁▁▁▁▁▁▁▁try:
▁▁▁▁▁▁▁▁▁▁▁▁▁return int(s)▁▁# Use built-in conversion for simplicity and efficiency.
▁▁▁▁▁▁▁▁▁except ValueError:
▁▁▁▁▁▁▁▁▁▁▁▁▁return 0 #Return 0 on error



▁▁▁▁# Event Handling (using the submit button's click event)

▁▁▁▁def on_submit() -> None:
▁▁▁▁▁▁▁▁"""Handles the submit button click."""
▁▁▁▁▁▁▁▁calculate_prime()


▁▁▁▁# Connect UI elements to functions and events.▁▁Using a simple connect for illustration, adapt it based on your framework.
▁▁▁▁connect(submit_button, "click", on_submit)
▁▁▁▁number_input.on_change("value", lambda: validate_input()) #validate input whenever the number changes
▁▁▁▁filter_checkbox.on_change("checked",lambda: validate_input())


▁▁▁▁# Initial setup (focus on the number input field).
▁▁▁▁number_input.focus()

▁▁▁▁return prime_tester_ui



