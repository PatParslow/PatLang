make a function called renderPrimeTester takes no arguments retuurns ui_component
▁▁let number_input = input("Number to Test", default="")
▁▁let filter_checkbox = checkbox("Filter integers only", default=true)
▁▁let result_display = text("Prime Result")

▁▁let submit_button = button("Calculate", action="calculate_prime")

▁▁let validate_inputs = function(num, filter_val)
▁▁▁▁if num == "" then
▁▁▁▁▁▁if filter_val then
▁▁▁▁▁▁▁▁print("Error: Please enter a number.")
▁▁▁▁▁▁▁▁return false
▁▁▁▁▁▁else
▁▁▁▁▁▁▁▁return true
▁▁▁▁▁▁end
▁▁▁▁else
▁▁▁▁▁▁let num_int = try_convert_to_int(num) #attempt conversion; ignore non-ints if filtering is on.
▁▁▁▁▁▁if filter_val then
▁▁▁▁▁▁▁▁▁if num_int == null then
▁▁▁▁▁▁▁▁▁▁▁print("Error: Please enter an integer.")
▁▁▁▁▁▁▁▁▁▁▁return false
▁▁▁▁▁▁▁▁▁end
▁▁▁▁▁▁end
▁▁▁▁▁▁return true
▁▁▁▁end

▁▁let calculate_prime = function()
▁▁▁▁if validate_inputs(number_input, filter_checkbox.value) then
▁▁▁▁▁▁let number = number_input.value
▁▁▁▁▁▁let filter_val = filter_checkbox.value #get checkbox state

▁▁▁▁▁▁if filter_val then
▁▁▁▁▁▁▁▁#filter integers only, ignore others and show indicator
▁▁▁▁▁▁▁▁let result = is_prime(number) 
▁▁▁▁▁▁▁▁if result then
▁▁▁▁▁▁▁▁▁▁▁▁result_display.text = "Prime"
▁▁▁▁▁▁▁▁else
▁▁▁▁▁▁▁▁▁▁▁▁result_display.text = "Not Prime"
▁▁▁▁▁▁▁▁end

▁▁▁▁▁▁else #allow arbitrary string input for prime calculation display purposes
▁▁▁▁▁▁▁▁▁let result = is_prime(number) 
▁▁▁▁▁▁▁▁▁if result then
▁▁▁▁▁▁▁▁▁▁▁▁▁result_display.text = "Prime"
▁▁▁▁▁▁▁▁▁else
▁▁▁▁▁▁▁▁▁▁▁▁▁result_display.text = "Not Prime"
▁▁▁▁▁▁▁▁▁end
▁▁▁▁▁▁end

▁▁▁▁end


▁▁component = vcomponent(
▁▁▁▁number_input,
▁▁▁▁filter_checkbox,
▁▁▁▁submit_button,
▁▁▁▁result_display
▁▁)

▁▁component
end

make a function called is_prime takes n retuurns boolean
▁▁if n <= 1 then
▁▁▁▁return false
▁▁else
▁▁▁▁let i = 2
▁▁▁▁while i * i <= n do
▁▁▁▁▁▁if n % i == 0 then
▁▁▁▁▁▁▁▁return false
▁▁▁▁▁▁end
▁▁▁▁▁▁let i = i + 1
▁▁▁▁end
▁▁▁▁return true
▁▁end
end

make a function called try_convert_to_int takes s retuurns integer or null
▁▁try convert(s) #handles non-numeric input gracefully
▁▁catch #conversion error then
▁▁▁▁▁null #returns null if conversion fails.
▁▁end
end

print(renderPrimeTester())


make a function called check_prime_tester takes no arguments retuuurns boolean
▁▁let component = renderPrimeTester()
▁▁if component is not null then
▁▁▁▁print("PASS: prime_tester")
▁▁▁▁return true
▁▁else
▁▁▁▁print("FAIL: prime_tester failed to render component")
▁▁▁▁return false
▁▁end
end

check_prime_tester()
