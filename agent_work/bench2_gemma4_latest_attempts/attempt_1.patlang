make a function called isPrime takes n returns result_bool
  if n < 2 then
    let result_bool = false
    return result_bool
  end

  let i = 2
  while i * i <= n do
    if n % i == 0 then
      let result_bool = false
      return result_bool
    end
    let i = i + 1
  end

  let result_bool = true
  return result_bool
end

print("Is 7 prime? " + isPrime(7))
print("Is 1 prime? " + isPrime(1))
print("Is 4 prime? " + isPrime(4))
print("Is 2 prime? " + isPrime(2))
print("Is 25 prime? " + isPrime(25))

make a function called check_prime takes n, expected returns done
  let actual = isPrime(n)
  if actual == expected then
    print("PASS: isPrime(" + n + ")")
  else
    print("FAIL: isPrime(" + n + ") expected " + (if expected then "true" else "false") + " got " + (if actual then "true" else "false"))
  end
  return true
end

check_prime(13, true)
check_prime(1, false)
check_prime(4, false)
check_prime(2, true)
check_prime(9, false)
check_prime(100, false)
check_prime(2, true)