make a function called isPrime takes n returns result_boolean
  if n < 2 then
    let result_boolean = false
    return result_boolean
  end

  let i = 2
  while i * i <= n do
    if n % i == 0 then
      let result_boolean = false
      return result_boolean
    end
    let i = i + 1
  end

  let result_boolean = true
  return result_boolean
end

print("Is Prime of 2:", isPrime(2))
print("Is Prime of 1:", isPrime(1))
print("Is Prime of 25:", isPrime(25))
print("Is Prime of 7:", isPrime(7))
print("Is Prime of 49:", isPrime(49))

make a function called check_isPrime takes n, expected returns done
  let actual = isPrime(n)
  if actual == expected then
    print("PASS: isPrime(" + n + ")")
  else
    print("FAIL: isPrime(" + n + ") expected " + thing_to_string(expected) + " got " + thing_to_string(actual))
  end
  return true
end

make a function called thing_to_string takes x returns s
  if x == true then
    return "true"
  else if x == false then
    return "false"
  else
    return "" + x
  end
end

check_isPrime(2, true)
check_isPrime(1, false)
check_isPrime(0, false)
check_isPrime(-5, false)
check_isPrime(3, true)
check_isPrime(4, false)
check_isPrime(9, false)
check_isPrime(25, false)
check_isPrime(7, true)
check_isPrime(11, true)
check_isPrime(121, false)
check_isPrime(100, false)