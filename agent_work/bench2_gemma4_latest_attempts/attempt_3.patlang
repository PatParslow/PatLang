make a function called isPrime takes n returns is_prime
  if n < 2 then
    return false
  end

  let d = 2
  let sqrt_n_check = floor(sqrt(n))

  while d <= sqrt_n_check do
    if n % d == 0 then
      return false
    end
    let d = d + 1
  end

  return true
end

print("Is Prime of " + 2 + ":")
print(isPrime(2))
print("Is Prime of " + 1 + ":")
print(isPrime(1))
print("Is Prime of " + 25 + ":")
print(isPrime(25))
print("Is Prime of " + 7 + ":")
print(isPrime(7))
print("Is Prime of " + 49 + ":")
print(isPrime(49))

make a function called check_isPrime takes n returns done
  let expected = if n < 2 then false else (n > 1 and all_divisors_check(n)) end

  if expected == isPrime(n) then
    print("PASS: isPrime(" + n + ")")
  else
    print("FAIL: isPrime(" + n + ") expected " + String.valueOf(expected) + " got " + String.valueOf(isPrime(n)))
  end
  return true
end

# Helper function to check for divisors, used in test harness logic above (not part of main testing structure required by prompt)
make a function called all_divisors_check takes n returns bool
  let d = 2
  let sqrt_n_check = floor(sqrt(n))
  while d <= sqrt_n_check do
    if n % d == 0 then
      return false
    end
    let d = d + 1
  end
  return true
end

check_isPrime(2)
check_isPrime(3)
check_isPrime(4)
check_isPrime(7)
check_isPrime(11)
check_isPrime(13)
check_isPrime(1)
check_isPrime(0)
check_isPrime(-5)
check_isPrime(25)
check_isPrime(49)
check_isPrime(121)