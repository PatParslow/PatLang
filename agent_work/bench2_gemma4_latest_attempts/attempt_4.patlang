make a function called isPrime takes n returns result_bool
  if n < 2 then
    let result_bool = false
    return result_bool
  end

  let d = 2
  let limit = floor(sqrt(n))
  let found_divisor = false

  while d <= limit do
    if (n % d) == 0 then
      let found_divisor = true
      break
    end
    let d = d + 1
  end

  if found_divisor then
    let result_bool = false
  else
    let result_bool = true
  end

  return result_bool
end

print("Is 7 prime? " + isPrime(7))
print("Is 1 prime? " + isPrime(1))
print("Is 4 prime? " + isPrime(4))
print("Is 2 prime? " + isPrime(2))
print("Is 9 prime? " + isPrime(9))

make a function called check_isPrime takes n, expected returns done
  let actual = isPrime(n)
  if actual == expected then
    print("PASS: isPrime(" + n + ")")
  else
    print("FAIL: isPrime(" + n + ") expected " + (expected ? "true" : "false") + " got " + (actual ? "true" : "false"))
  end
  return true
end

check_isPrime(2, true)
check_isPrime(1, false)
check_isPrime(0, false)
check_isPrime(-5, false)
check_isPrime(3, true)
check_isPrime(4, false)
check_isPrime(9, false)
check_isPrime(25, false)
check_isPrime(29, true)