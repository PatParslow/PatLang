make a function called isSquare takes n returns r
  let r = (integer_sqrt(n) * integer_sqrt(n)) == n
end

make a function called isPrime takes n returns result
  if n < 2 then
    let result = false
  else
    let d = 2
    let is_prime_flag = true
    while d * d <= n do
      if n % d == 0 then
        let is_prime_flag = false
        break
      end
      let d = d + 1
    end
    let result = is_prime_flag
  end
  return result
end

print("Is prime of 1? " + isPrime(1))
print("Is prime of 2? " + isPrime(2))
print("Is prime of 9? " + isPrime(9))
print("Is prime of 17? " + isPrime(17))
print("Is prime of 25? " + isPrime(25))

make a function called check_isPrime takes n, expected returns done
  let actual = isPrime(n)
  if actual == expected then
    print("PASS: isPrime(" + n + ")")
  else
    print("FAIL: isPrime(" + n + ") expected " + to_string(expected) + " got " + to_string(actual))
  end
  return true
end

check_isPrime(0, false)
check_isPrime(1, false)
check_isPrime(2, true)
check_isPrime(3, true)
check_isPrime(4, false)
check_isPrime(7, true)
check_isPrime(9, false)
check_isPrime(16, false)
check_isPrime(17, true)
check_isPrime(25, false)
check_isPrime(-5, false)