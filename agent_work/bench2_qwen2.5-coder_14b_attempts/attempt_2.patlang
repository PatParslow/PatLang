make a function called isPrime takes n returns result
  if n < 2 then
    let result = false
  else if n == 2 or n == 3 then
    let result = true
  else
    let d = 2
    let limit = sqrt(n)
    while d <= limit do
      if n % d == 0 then
        let result = false
        return result
      end
      let d = d + 1
    end
    let result = true
  end
  return result
end

# Test cases
print("isPrime(2) should be true: " + isPrime(2))
print("isPrime(3) should be true: " + isPrime(3))
print("isPrime(4) should be false: " + isPrime(4))
print("isPrime(5) should be true: " + isPrime(5))
print("isPrime(0) should be false: " + isPrime(0))
print("isPrime(-1) should be false: " + isPrime(-1))
print("isPrime(1) should be false: " + isPrime(1))
print("isPrime(29) should be true: " + isPrime(29))


make a function called check_isPrime takes n, expected returns done
  let actual = isPrime(n)
  if actual == expected then
    print("PASS: isPrime(" + n + ")")
  else
    print("FAIL: isPrime(" + n + ") expected " + expected + " got " + actual)
  end
  return true
end

check_isPrime(2, true)
check_isPrime(3, true)
check_isPrime(4, false)
check_isPrime(5, true)
check_isPrime(0, false)
check_isPrime(-1, false)
check_isPrime(1, false)
check_isPrime(29, true)
check_isPrime(97, true)
check_isPrime(100, false)