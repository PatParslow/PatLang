make a function called isPrime takes n returns result
  if n < 2 then
    let result = false
  else if n == 2 or n == 3 then
    let result = true
  else
    let d = 2
    let limit = sqrt(n)
    while d <= limit do
      if (n % d) == 0 then
        let result = false
        return result
      end
      let d = d + 1
    end
    let result = true
  end
  return result
end

# Test cases
if isPrime(-5) then
  print("PASS: -5 is correctly identified as non-prime")
else
  print("FAIL: -5 should be identified as non-prime")
end

if isPrime(0) then
  print("FAIL: 0 should be identified as non-prime")
else
  print("PASS: 0 is correctly identified as non-prime")
end

if isPrime(1) then
  print("FAIL: 1 should be identified as non-prime")
else
  print("PASS: 1 is correctly identified as non-prime")
end

if isPrime(2) then
  print("PASS: 2 is correctly identified as prime")
else
  print("FAIL: 2 should be identified as prime")
end

if isPrime(3) then
  print("PASS: 3 is correctly identified as prime")
else
  print("FAIL: 3 should be identified as prime")
end

if isPrime(4) then
  print("FAIL: 4 should be identified as non-prime")
else
  print("PASS: 4 is correctly identified as non-prime")
end

if isPrime(17) then
  print("PASS: 17 is correctly identified as prime")
else
  print("FAIL: 17 should be identified as prime")
end

if not isPrime(18) then
  print("PASS: 18 is correctly identified as non-prime")
else
  print("FAIL: 18 should be identified as non-prime")
end


