make a function called isPrime takes n returns result
  if n < 2 then
    let result = false
  else if n == 2 or n == 3 then
    let result = true
  else
    let d = 2
    while d * d <= n do
      if n % d == 0 then
        let result = false
        return result
      end
      let d = d + 1
    end
    let result = true
  end
  return result
end

# Test cases
print("2 is prime: " + (isPrime(2) ? "PASS" : "FAIL"))
print("3 is prime: " + (isPrime(3) ? "PASS" : "FAIL"))
print("4 is not prime: " + (not isPrime(4) ? "PASS" : "FAIL"))
print("5 is prime: " + (isPrime(5) ? "PASS" : "FAIL"))
print("0 is not prime: " + (not isPrime(0) ? "PASS" : "FAIL"))
print("1 is not prime: " + (not isPrime(1) ? "PASS" : "FAIL"))
print("-3 is not prime: " + (not isPrime(-3) ? "PASS" : "FAIL"))
print("9 is not prime: " + (not isPrime(9) ? "PASS" : "FAIL"))


make a function called check_prime takes n, expected returns done
  let actual = isPrime(n)
  if actual == expected then
    print("PASS: isPrime(" + n + ")")
  else
    print("FAIL: isPrime(" + n + ") expected " + expected + " got " + actual)
  end
  return true
end

check_prime(2, true)
check_prime(3, true)
check_prime(4, false)
check_prime(5, true)
check_prime(0, false)
check_prime(1, false)
check_prime(-3, false)
check_prime(9, false)
check_prime(17, true)
check_prime(18, false)
check_prime(19, true)
check_prime(20, false)
check_prime(21, false)
check_prime(22, false)
check_prime(23, true)
check_prime(24, false)