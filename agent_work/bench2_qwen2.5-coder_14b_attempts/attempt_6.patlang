make a function called isPrime takes n returns result
  if n < 2 then
    let result = false
  else if n == 2 or n == 3 then
    let result = true
  else
    let d = 2
    let limit = sqrt(n)
    let foundDivisor = false
    while d <= limit and not foundDivisor do
      if n % d == 0 then
        let foundDivisor = true
      else
        let d = d + 1
      end
    end
    let result = not foundDivisor
  end
  return result
end

print(isPrime(-1))  # false
print(isPrime(0))   # false
print(isPrime(1))   # false
print(isPrime(2))   # true
print(isPrime(3))   # true
print(isPrime(4))   # false


make a function called check_isPrime takes n, expected returns done
  let actual = isPrime(n)
  if actual == expected then
    print("PASS: isPrime(" + n + ")")
  else
    print("FAIL: isPrime(" + n + ") expected " + expected + " got " + actual)
  end
  return true
end

check_isPrime(-1, false)
check_isPrime(0, false)
check_isPrime(1, false)
check_isPrime(2, true)
check_isPrime(3, true)
check_isPrime(4, false)
check_isPrime(5, true)
check_isPrime(9, false)
check_isPrime(11, true)
check_isPrime(13, true)
check_isPrime(16, false)
check_isPrime(17, true)
check_isPrime(19, true)
check_isPrime(20, false)
check_isPrime(23, true)
check_isPrime(24, false)
check_isPrime(25, false)
check_isPrime(29, true)
check_isPrime(31, true)