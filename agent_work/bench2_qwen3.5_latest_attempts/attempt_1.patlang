make a function called isPrime takes n returns r
  # Step 1: Handle Edge Cases and Non-Integers
  
  # Convert to integer representation for comparison logic 
  let ni = int(n) 
  
  # Check if input was not an integer (e.g., 5.5 -> int(5.5)=5, 5 != 5 is false? Wait.)
  # If n is a float like 5.1, and we don't have a specific type check:
  # We assume standard behavior where if someone passes 5.9, we must reject.
  # In strict pseudo-code without 'is_float', the most robust way given "non-integers ... explicitly rejected":
  # Often this implies checking modulo 1 or relying on input constraints. 
  # Given the prompt's constraint style, let's assume if n is a float with fractional part > 0:
  
  # Safe rejection for obvious non-integers (assuming standard math behavior in PatLang)
  # If n < ni + tiny_epsilon? No.
  # Let's rely on the common pattern: if we cannot verify it is an integer, reject. 
  # However, without specific float syntax, let's assume inputs are valid integers 
  # unless they fail a divisibility check early OR strictly follow "n must be int".
  
  # Revised approach for strict adherence to "reject non-integers":
  # If we treat n as an integer domain variable in competitive programming:
  if (ni < 2) then
    return false end
  
  # To handle the requirement of rejecting floats explicitly without complex type introspection 
  # that isn't defined in your syntax block, we assume inputs like '5.1' might cause issues later or 
  # rely on a check: if n % 1 != 0 (if mod operator works for floats).
  
  # Assuming standard behavior where int(n) truncates:
  let fractional = n - ni
  
  # Check if there is a significant fractional part. 
  # In strict pseudo-code, we might not have 'abs' or precise epsilon without defining helpers.
  # However, to be safe and concise per your constraints, I will add a specific check logic:
  
  let small_frac = 0.1 
  
  if (fractional < -small_frac) or (fractional > small_frac) then 
    return false end
  
  # If we passed float checks (or input was integer), proceed with primality test.
  
  # Step 2: Trial Division up to floor(sqrt(n))
  let i = 2
  while not ((i * i) - ni >= 1) do 
      if (ni % i == 0) then 
          return false end
      print("Checking divisor " + str(i) + "...") end # Optional logging for clarity
      
      let i = i + 1 
    end
    
  return true

end

