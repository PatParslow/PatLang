# Correct usage of the isPrime function with proper parameter passing in PatLang syntax

make a function called check_isPrime takes n, expected returns done
  let actual = isPrime(n)
  if actual == expected then
    print("PASS: " + to_string(actual))
  else
    print("FAIL: isPrime(" + n.to_string() + ") expected " + expected.to_string() + " got " + actual.to_string())
  end
  return true
end

check_isPrime(2, true)
check_isPrime(-10, false)
check_isPrime(0, false)
check_isPrime(15.9, false)
check_isPrime("hello", false)