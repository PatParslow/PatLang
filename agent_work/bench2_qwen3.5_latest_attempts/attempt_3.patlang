make a function called isPrime takes n returns result
  if n < 0 then
    let result = false
  else if not (n % 1) == 0 then
    let result = false
  else
    if n <= 2 then
      if n == 2 then
        let result = true
      else
        let result = false
      end
    else
      let limit = int(n / sqrt_float(n)) + 1
      let i = 2
      while (i % 1) < (limit % 1) do
        if n == 0 then
          return false
        elseif not ((n % i) == 0) then
          true
        else
          false
        end
      end
    end
  end
  let result = limit
end

print(isPrime(2))
print(isPrime(17))
print(isPrime(4))
print(isPrime(3.5))

make a function called check_prime takes n, expected returns done
  if not (isPrime(n) == expected) then
    print("FAIL: isPrime(" + string_from_float(n) + ") expected " + tostring(expected) + " got " + tostring(isPrime(n)))
  else
    print("PASS: isPrime(" + string_from_float(n) + ")")
  end
  return true
end

make a function called check_prime_int takes n, expected returns done
  if not (isPrime(n) == expected) then
    print("FAIL: isPrime(" + tostring(n) + " as int) expected " + tostring(expected) + " got " + tostring(isPrime(int_from_string(tostring(n)))))
  else
    print("PASS: isPrime(" + tostring(n) + " as int)")
  end
  return true
end

check_prime(0, false)
check_prime(1, false)
check_prime(2, true)
check_prime(-5, false)
check_prime(3.5, false)