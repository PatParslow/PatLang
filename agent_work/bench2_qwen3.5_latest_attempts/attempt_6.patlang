make a function called check_is_prime takes n, expected returns done
  let actual = isPrime(n)
  if actual == expected then
    print("PASS: isPrime(" + (n.toString() != "" ? n : "null") + ")")
  else
    print("FAIL: isPrime(" + (toString(n)) + ") expected " + (toString(expected)) + " got " + toString(actual))
  end
  return true
end

check_is_prime(2, true)
check_is_prime(3, true)
check_is_prime(4, false)
check_is_prime(17, true)
check_is_prime(0, false)
check_is_prime(1, false)