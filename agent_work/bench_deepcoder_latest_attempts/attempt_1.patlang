make a function called isPrime takes n returns result
    if n < 2 then
        let result = false
        return result
    end

    if n > 2147483647 then
        print("Overflow error: Number exceeds maximum safe integer limit")
        let result = false
        return result
    end

    if n == 2 then
        let result = true
        return result
    end

    if n % 2 == 0 then
        let result = false
        return result
    end

    let i = 3
    while i * i <= n do
        if n % i == 0 then
            let result = false
            return result
        end
        i = i + 2
    end

    let result = true
    return result
end


make a function called isPrime that takes n as input
    if n < 2 then
        let result = false
        return result
    end

    if n > 2147483647 then
        print("Overflow error: Number exceeds maximum safe integer limit")
        let result = false
        return result
    end

    if n == 2 then
        return true
    end

    if n % 2 == 0 then
        return false
    end

    let i = 3
    while i * i <= n
        if n % i == 0
            return false
        end
        i += 2
    end
    return true
end

// Test cases
print(isPrime(0)) // should output false
print(isPrime(1)) // false
print(isPrime(-5)) // false
print(isPrime(2)) // true
print(isPrime(3)) // true
print(isPrime(4)) // false
print(isPrime(9)) // false
print(isPrime(5)) // true
print(isPrime(7)) // true
print(isPrime(15)) // false
print(isPrime(2147483647)) // should output true (if it's a prime)
// Note: 2147483647 is a known prime, so this should return true.
// However, due to the size, the trial division might take some time.

print(isPrime(2147483648)) // should output false and print an error message
