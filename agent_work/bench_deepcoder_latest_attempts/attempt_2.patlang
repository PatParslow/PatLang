make a function called isPrime takes n returns result
  if n < 2 then
    return false
  else if n > 0x7FFFFFFF then
    print("Error: Number exceeds maximum safe integer.")
    return false
  end

  let i = 2
  while i * i <= n do
    if n % i == 0 then
      return false
    end
    i = i + 1
  end
  return true
end


make function is_prime takes n returns boolean
  if n <= 1
    return false
  elif n == 2
    return true
  elif n mod 2 == 0
    return false
  end

  let i = 3
  while i * i <= n
    if n mod i == 0
      return false
    end
    i += 2
  end
  return true
end
