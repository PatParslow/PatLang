def is_prime(n):
    if n <= 1:
        return False
    elif n <= 3:
        return True
    elif n % 2 == 0 or n % 3 == 0:
        return False
    i = 5
    while i * i <= n:
        if n % i == 0:
            return False
        if n % (i + 2) == 0:
            return False
        i += 6
    return True


def is_prime(n):
    if n <= 1:
        return False
    elif n <= 3:
        return True
    elif n % 2 == 0 or n % 3 == 0:
        return False
    i = 5
    w = 6  # Using 'w' to avoid confusion with 'i'
    while i * i <= n:
        if n % i == 0:
            return False
        if n % (i + w) == 0:  # Checking both i and i+2 using a step of 6k ±1
            return False
        i += w  # Increment by 6 to skip even numbers and multiples of 3
    return True

def check_is_prime(n, expected):
    actual = is_prime(n)
    if actual == expected:
        print(f"PASSED: is_prime({n}) returned {actual}")
    else:
        print(f"FAILED: is_prime({n}) expected {expected} but returned {actual}")

# Running the test cases
check_is_prime(-5, False)
check_is_prime(0, False)
check_is_prime(1, False)
check_is_prime(2, True)
check_is_prime(3, True)
check_is_prime(4, False)
check_is_prime(5, True)
check_is_prime(9, False)  # Should be False as it's divisible by 3
check_is_prime(11, True)
check_is_prime(25, False)  # Should be False as it's 5 squared
check_is_prime(49, False)  # Should be False as it's 7 squared
check_is_prime(101, True)  # A larger prime number
