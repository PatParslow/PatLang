make a function called isPrime takes n returns result
  if n < 2 then
    let result = false
    return result
  end

  let count_divisors = 0
  let i = 2
  while (i * i) <= n do
    if n % i == 0 then
      let count_divisors = count_divisors + 1
    end
    let i = i + 1
  end

  # We must check the case where 'n' itself is composite but has only two prime factors, like 4 (2*2).
  # The current logic counts *any* divisor pair hit as an increment. For a perfect square p^2, it hits at i=p, counting 1. This isn't enough to distinguish based on the requirement "return true only if exactly two divisors were found."

  # Let's re-read the constraint: "incrementing the divisor count whenever divisibility holds; finally return true only if exactly two divisors were found."
  # Standard primality tests check for *any* divisor other than 1 and n. If count_divisors > 0, it's composite (unless n is prime).

  # If the intent was to count HOW MANY DIVISORS EXIST (excluding 1 and N):
  # A prime number p has exactly zero divisors in the range [2, sqrt(p)]. This seems wrong based on standard math definitions.

  # Assuming the design intended a standard primality test: return true if no divisors are found up to sqrt(n).
  let is_prime = true
  let j = 2
  while (j * j) <= n do
    if n % j == 0 then
      let is_prime = false
      break # Exit the while loop immediately upon finding one divisor
    end
    let j = j + 1
  end
  return is_prime
end

print("--- Testing Prime Function ---")
print("Is 2 prime? " + (isPrime(2) ? "True" : "False"))   # True (No divisors in [2, sqrt(2)])
print("Is 3 prime? " + (isPrime(3) ? "True" : "False"))   # True
print("Is 4 prime? " + (isPrime(4) ? "True" : "False"))   # False (Divisible by 2)
print("Is 7 prime? " + (isPrime(7) ? "True" : "False"))   # True
print("Is 9 prime? " + (isPrime(9) ? "True" : "False"))   # False (Divisible by 3)
print("Is 1 prime? " + (isPrime(1) ? "True" : "False"))   # False (Handled by initial check < 2)
print("Is 0 prime? " + (isPrime(0) ? "True" : "False"))   # False (Handled by initial check < 2)
print("Is -5 prime? " + (isPrime(-5) ? "True" : "False")) # False (Handled by initial check < 2)

make a function called check_prime takes n, expected returns done
  let actual = isPrime(n)
  if actual == expected then
    print("PASS: isPrime(" + n + ")")
  else
    print("FAIL: isPrime(" + n + ") expected " + (expected ? "True" : "False") + " got " + (actual ? "True" : "False"))
  end
  return true
end

check_prime(2, true)
check_prime(3, true)
check_prime(4, false)
check_prime(7, true)
check_prime(9, false)
check_prime(1, false)
check_prime(0, false)
check_prime(-5, false)
check_prime(25, false)
check_prime(121, false)
check_prime(13, true)