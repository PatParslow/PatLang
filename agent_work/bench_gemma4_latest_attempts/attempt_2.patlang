make a function called isPrime takes n returns result_bool
  if n < 2 then
    let result_bool = false
    return result_bool
  end

  let limit_check = floor(sqrt(n)) # Need math functions if this were real, but for PatLang constraints, we simulate up to sqrt(n) check iteratively. Since direct math library calls are restricted, we use a loop structure based on the required concept: checking divisors up to sqrt(n).

  let count_divisors = 0
  let i = 2

  while i * i <= n do # Loop condition simulating i <= sqrt(n)
    if n % i == 0 then
      let count_divisors = count_divisors + 1
      # Optimization: since we only need to check for divisors, finding one is enough to fail quickly.
      return false
    end
    let i = i + 1
  end

  # If the loop completed without finding a divisor (meaning no hit in the initial check),
  # and we never returned false, then it must be prime if count_divisors remains 0.
  # Wait, the prompt logic implies we *must* find exactly two divisors for true?
  # "finally return true only if exactly two divisors were found." -> This contradicts standard prime definition (which requires ONLY 1 divisor: 1 and itself).

  # Adhering strictly to the flawed requirement ("return true only if exactly two divisors were found"):
  # The loop above already returns false on the first hit. If we reach here, no divisors <= sqrt(n) were found.
  # In standard math, this means it IS prime (only 1 and itself). This requires count_divisors == 0 after checking up to i-1.

  # Reinterpreting "exactly two divisors": Maybe it means the number of factors including 1 and N? No, that's always 2 for primes.
  # Sticking to standard definition (Prime if no divisor found between 2 and sqrt(N)):
  if count_divisors == 0 then
    let result_bool = true
    return result_bool
  else
    # This branch should theoretically be unreachable due to the early return above, but for completeness based on loop logic:
    let result_bool = false
    return result_bool
  end

end

print("isPrime(1): " + isPrime(1))
print("isPrime(2): " + isPrime(2))
print("isPrime(3): " + isPrime(3))
print("isPrime(4): " + isPrime(4)) # Should be false (divisible by 2)
print("isPrime(7): " + isPrime(7))
print("isPrime(9): " + isPrime(9)) # Should be false (divisible by 3)
print("isPrime(100): " + isPrime(100))
print("isPrime(-5): " + isPrime(-5))

make a function called check_prime takes n, expected returns done
  let actual = isPrime(n)
  if actual == expected then
    print("PASS: isPrime(" + n + ")")
  else
    print("FAIL: isPrime(" + n + ") expected " + expected + " got " + actual)
  end
  return true
end

