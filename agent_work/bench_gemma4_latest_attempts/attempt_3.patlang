make a function called isPrime takes n returns is_prime
  if n < 2 then
    return false
  end

  let divisor_count = 0
  let i = 2

  while i * i <= n do
    if n % i == 0 then
      let divisor_count = divisor_count + 1
      // Since we only count factors, we must also account for the pair factor (n/i)
      // For prime checking, we just need to know if ANY division happens.
      // If a number is composite, it has at least two distinct factors: i and n/i
      // unless i * i == n, in which case i is counted once as the square root factor.
      // The requirement "return true only if exactly two divisors were found" implies we are counting 
      // the number of distinct prime factors or something else.
      // Given standard primality testing (only checking for composite nature):
      // We should return false immediately upon finding ANY divisor, unless n=1 which is handled above.
      return false // Found a factor, so it's not prime

    end
    let i = i + 1
  end

  // If the loop completes without returning false, no divisors were found up to sqrt(n).
  return true
end

print("isPrime(2): " + isPrime(2))
print("isPrime(1): " + isPrime(1))
print("isPrime(0): " + isPrime(0))
print("isPrime(9): " + isPrime(9)) // Composite (3*3) -> should be false
print("isPrime(7): " + isPrime(7)) // Prime -> should be true
print("isPrime(25): " + isPrime(25)) // Composite (5*5) -> should be false

make a function called check_prime takes n, expected returns done
  let actual = isPrime(n)
  if actual == expected then
    print("PASS: isPrime(" + n + ")")
  else
    print("FAIL: isPrime(" + n + ") expected " + expected + " got " + actual)
  end
  return true
end

check_prime(2, true)
check_prime(1, false)
check_prime(0, false)
check_prime(-5, false)
check_prime(9, false)
check_prime(7, true)
check_prime(25, false)
check_prime(4, false)
check_prime(31, true)
check_prime(100, false)