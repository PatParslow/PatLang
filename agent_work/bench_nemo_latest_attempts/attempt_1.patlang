
make a function called isPrime takes n returns result
  if n < 2 then
    let result = false
  else
    let i = 2
    while i * i <= n do
      if n % i == 0 then
        let result = false
        return result
      end
      let i = i + 1
    end
    let result = true
  end
  return result
end

print(isPrime(2))
print(isPrime(1))
print(isPrime(0))
print(isPrime(-5))
print(isPrime(97))


make a function called check_isPrime takes n, expected returns done
  let actual  = isPrime(n)
  if actual == expected then
    print("PASS: isPrime("  + n  +  ")") 
  else
    print("FAIL: isPrime("  + n  +  ") expected "  + expected  + " got "  + actual) 
  end
  return true
end
check_isPrime(2, true)
check_isPrime(1, false)
check_isPrime(0, false)
check_isPrime(-5, false)
check_isPrime(97, true)
check_isPrime(4, false)
check_isPrime(9, false)