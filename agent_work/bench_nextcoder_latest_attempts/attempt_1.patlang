make a function called check_prime takes n returns result
  if not (n is an integer) then
    return { "isPrime": false, "error": "Input must be an integer." }
  end

  if n <= 1 then
    return { "isPrime": false }
  end

  let limit = n
  let i = 2
  while i * i <= limit do
    if (n % i) == 0 then
      return { "isPrime": false }
    end
    let i = i + 1
  end

  return { "isPrime": true }
end

# Example usage:
print(check_prime(29)) # {"isPrime": true}
print(check_prime(-5)) # {"isPrime": false, "error": "Input must be an integer."}
print(check_prime(0))  # {"isPrime": false}
print(check_prime(1))  # {"isPrime": false}


