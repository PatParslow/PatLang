make a function called check_prime takes n returns result
  # Validate input strictly as an integer first
  if not (is_integer(n)) then
    let result = { "error": "Input must be an integer" }
  else if n <= 1 then
    let result = { "isPrime": false, "reason": "n is less than or equal to 1" }
  else
    # Function to check divisibility without using sqrt by squaring candidates
    make a function called is_divisible takes num, candidate returns bool
      return (num % candidate) == 0
    end

    let limit = n
    let i = 2
    while i * i <= n do
      if is_divisible(n, i) then
        let result = { "isPrime": false, "reason": "divisible by " + i }
        return result
      end
      let i = i + 1
    end

    # If no divisors found in the loop, it's prime
    let result = { "isPrime": true, "reason": "no divisors found" }
  end
  return result
end

# Example usage:
print(check_prime(29))  # {"isPrime": true, "reason": "no divisors found"}
print(check_prime(10))  # {"isPrime": false, "reason": "divisible by 2"}
print(check_prime(-5))  # {"error": "Input must be an integer"}
print(check_prime(1))   # {"isPrime": false, "reason": "n is less than or equal to 1"}

