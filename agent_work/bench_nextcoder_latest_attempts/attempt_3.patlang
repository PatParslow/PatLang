make a function called check_prime takes n returns result
  if not (type(n) == "int") then
    return { "isPrime": false, "message": "Input must be an integer" }
  end

  let result = {}
  
  if n <= 1 then
    set(result, "isPrime", false)
    set(result, "message", "Number must be greater than 1")
    return result
  else
    let is_prime = true
    let max_check = sqrt(n)
    
    for i from 2 to max_check do
      if n % i == 0 then
        let is_prime = false
        break
      end
    end
    
    set(result, "isPrime", is_prime)
    if is_prime then
      set(result, "message", "Number is prime")
    else
      set(result, "message", "Number is not prime")
    end

    return result
  end
end

# Example usage:
print(check_prime(29)) # {"isPrime": true, "message": "Number is prime"}
print(check_prime(-5)) # {"isPrime": false, "message": "Input must be an integer"}
print(check_prime(1))  # {"isPrime": false, "message": "Number must be greater than 1"}

make a function called check_add takes a, b, expected returns done
  let actual = check_prime(a).isPrime and check_prime(b).isPrime
  if actual == expected then
    print("PASS: check_prime(" + a + ", " + b + ")")
  else
    print("FAIL: check_prime(" + a + ", " + b + ") expected " + expected + " got " + actual)
  end
  return true
end

check_add(2, 3, true)
check_add(-1, 5, false)
check_add(0, 7, false)
check_add(29, 31, true)
check_add(15, 17, false)
check_add(4, 6, false)