make a function called check_prime takes n returns result
  # Validate input strictly as an integer first
  if not (n == int(n)) then
    let result = { "isPrime": false }
  else
    # Return false for negatives or n <= 1 immediately
    if n < 2 then
      let result = { "isPrime": false }
    else
      # Initialize the result as true and check divisibility up to the square root of n
      let is_prime = true
      let i = 2
      while i * i <= n do
        if n % i == 0 then
          let is_prime = false
          break
        end
        let i = i + 1
      end
      # Construct the result object
      let result = { "isPrime": is_prime }
    end
  end
  return result
end

# Example usage
print(check_prime(29))
print(check_prime(-5))
print(check_prime(1))
print(check_prime(0))


make a function called check_check_prime takes n expected returns done
  let actual = check_prime(n)
  if actual.isPrime == expected then
    print("PASS: check_prime(" + n + ")")
  else
    print("FAIL: check_prime(" + n + ") expected " + expected + " got " + actual.isPrime)
  end
  return true
end

check_check_prime(29, true)
check_check_prime(-5, false)
check_check_prime(1, false)
check_check_prime(0, false)
check_check_prime(4, false)
check_check_prime(2, true)
check_check_prime(3, true)
check_check_prime(17, true)
check_check_prime(18, false)
check_check_prime(9973, true)