make a function called check_prime takes n returns result
  if not (n instanceof Number) then
    return { "isPrime": false }
  end

  if n <= 1 then
    return { "isPrime": false }
  end

  let i = 2
  while i * i <= n do
    if n % i == 0 then
      return { "isPrime": false }
    end
    let i = i + 1
  end

  return { "isPrime": true }
end

print(check_prime(7))   # { "isPrime": true }
print(check_prime(10))  # { "isPrime": false }


make a function called check_result takes case, expected, got returns done
  if expected == got then
    print("PASS: " + case)
  else
    print("FAIL: " + case + " expected " + expected + " got " + got)
  end
  return true
end

check_result('check_prime(2)', { "isPrime": true }, check_prime(2))
check_result('check_prime(-3)', { "isPrime": false }, check_prime(-3))
check_result('check_prime(1)', { "isPrime": false }, check_prime(1))
check_result('check_prime(0)', { "isPrime": false }, check_prime(0))
check_result('check_prime(97)', { "isPrime": true }, check_prime(97))
check_result('check_prime(50)', { "isPrime": false }, check_prime(50))
check_result('check_prime(13.5)', { "isPrime": false }, check_prime(13.5))