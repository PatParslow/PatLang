make a function called check_prime takes n returns result
  # Validate input as an integer
  if not (n == int(n)) then
    let result = { "isPrime": false, "error": "Input must be an integer" }
  else if n <= 1 then
    let result = { "isPrime": false }
  else
    let is_prime = true
    let i = 2
    while i * i <= n do
      if n % i == 0 then
        let is_prime = false
        break
      end
      let i = i + 1
    end
    let result = { "isPrime": is_prime }
  end
  return result
end

# Example usage:
print(check_prime(29))  # {"isPrime": true}
print(check_prime(-5))  # {"isPrime": false, "error": "Input must be an integer"}
print(check_prime(1))   # {"isPrime": false}


