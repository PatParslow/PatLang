let src = read_file("self_hosting/lib/lexer.patlang") + chr(10)
  + read_file("self_hosting/lib/parser.patlang") + chr(10)
  + read_file("self_hosting/lib/lower.patlang") + chr(10)
  + read_file("self_hosting/lib/codegen.patlang") + chr(10)
  + read_file("self_hosting/lib/runtime_rs.patlang") + chr(10)
  + read_file("self_hosting/lib/regex_dsl.patlang") + chr(10)
  + read_file("self_hosting/lib/syntax_dsl.patlang") + chr(10)
  + "let raw = read_file(\"self_hosting/examples/router_dsl_demo.patlang\")" + chr(10)
  + "let expanded = expand_syntax_dsls(raw)" + chr(10)
  + "print(expanded)" + chr(10)

let toks = tokenize(src)
let ast = parse_program(toks)
let ir = lower_program(ast)
let rs = emit_program_rs(ir)
let exe = rustc_build(rs, "agent_work/debug_expand.exe")
print("built: " + exe)
