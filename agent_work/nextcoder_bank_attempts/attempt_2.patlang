make a function called ledger takes action, amount returns result
  let balances = {"Alice": 0, "Bob": 0}
  let errors = {"Alice": false, "Bob": false}

  if action == "deposit" then
    let user = "Alice"
    let balances[user] = balances[user] + amount
  else if action == "withdraw" then
    let user = "Bob"
    if balances[user] >= amount then
      let balances[user] = balances[user] - amount
    else
      let errors[user] = true
      print("Insufficient funds")
    end
  end

  return {"balances": balances, "errors": errors}
end

print(ledger("deposit", 50))
print(ledger("withdraw", 60))


