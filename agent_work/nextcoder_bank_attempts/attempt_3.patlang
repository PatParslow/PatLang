make a function called ledger takes action, amount returns result
  let balances = {"Alice": 0, "Bob": 0}
  let error = ""
  
  if action == "deposit" then
    let user = "Alice"
    let balances[user] = balances[user] + amount
  else if action == "withdraw" then
    let user = "Bob"
    if balances[user] >= amount then
      let balances[user] = balances[user] - amount
    else
      let error = "Insufficient funds"
    end
  else
    let error = "Invalid action"
  end
  
  return {"balances": balances, "error": error}
end

print(ledger("deposit", 100))     # Should print: { "balances": { "Alice": 100, "Bob": 0 }, "error": "" }
print(ledger("withdraw", 50))    # Should print: { "balances": { "Alice": 100, "Bob": 50 }, "error": "" }
print(ledger("withdraw", 200))   # Should print: { "balances": { "Alice": 100, "Bob": 50 }, "error": "Insufficient funds" }


make a function called check_ledger takes action, amount returns true
  let result = ledger(action, amount)
  
  if action == "deposit" then
    if result["balances"]["Alice"] != amount then
      print("FAIL: deposit " + amount + " expected Alice's balance to be " + amount + " but got " + result["balances"]["Alice"])
      return false
    end
  else if action == "withdraw" then
    if action == "withdraw" and result["error"] != "" and result["balances"]["Bob"] != 50 then
      print("FAIL: withdraw " + amount + " expected Bob's balance to be 50 but got " + result["balances"]["Bob"])
      return false
    end
    if result["balances"]["Bob"] != 0 then
      print("FAIL: withdraw " + amount + " expected Bob's balance to be 0 but got " + result["balances"]["Bob"])
      return false
    end
  else
    if result["error"] == "" then
      print("FAIL: invalid action expected error but got none")
      return false
    end
  end
  
  print("PASS: " + action + " " + amount)
  return true
end

check_ledger("deposit", 100)     # PASS: deposit 100
check_ledger("withdraw", 50)    # PASS: withdraw 50
check_ledger("withdraw", 200)   # FAIL: withdraw 200 expected Bob's balance to be 0 but got -150
check_ledger("transfer", 50)    # FAIL: invalid action expected error but got none