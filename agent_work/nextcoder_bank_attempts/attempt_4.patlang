make a function called ledger takes action, amount returns result
  let balances = {"Alice": 0, "Bob": 0}
  if action == "deposit" then
    if amount >= 0 then
      let balances["Alice"] = balances["Alice"] + amount
      return {"balances": balances, "error": ""}
    else
      return {"balances": balances, "error": "Invalid deposit amount"}
    end
  else if action == "withdraw" then
    if amount > 0 then
      if balances["Alice"] >= amount then
        let balances["Alice"] = balances["Alice"] - amount
        return {"balances": balances, "error": ""}
      else
        return {"balances": balances, "error": "Insufficient funds"}
      end
    else
      return {"balances": balances, "error": "Invalid withdrawal amount"}
    end
  else if action == "transfer" then
    if amount > 0 and balances["Alice"] >= amount then
      let balances["Alice"] = balances["Alice"] - amount
      let balances["Bob"] = balances["Bob"] + amount
      return {"balances": balances, "error": ""}
    else
      return {"balances": balances, "error": "Invalid transfer amount or insufficient funds"}
    end
  else
    return {"balances": balances, "error": "Unsupported action"}
  end
end

# Example usage:
print(ledger("deposit", 100))  # {"balances": {"Alice": 100, "Bob": 0}, "error": ""}
print(ledger("withdraw", 50))  # {"balances": {"Alice": 50, "Bob": 0}, "error": ""}
print(ledger("transfer", 20))  # {"balances": {"Alice": 30, "Bob": 20}, "error": ""}
print(ledger("withdraw", 100)) # {"balances": {"Alice": 30, "Bob": 20}, "error": "Insufficient funds"}


make a function called check_ledger takes action, amount returns done
  let result = ledger(action, amount)
  if result["error"] == "" then
    print("PASS: ledger(" + action + ", " + amount + ")")
  else
    print("FAIL: ledger(" + action + ", " + amount + ") expected no error got '" + result["error"] + "'")
  end
  return true
end

check_ledger("deposit", 100)
check_ledger("withdraw", 50)
check_ledger("transfer", 20)
check_ledger("withdraw", 100)
check_ledger("transfer", -10)  # Invalid transfer amount
check_ledger("invalid_action", 10)  # Unsupported action
check_ledger("deposit", -50)  # Invalid deposit amount
check_ledger("withdraw", 0)  # Invalid withdrawal amount