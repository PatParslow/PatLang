make a function called ledger takes action, amount returns result
  let balances = {"Alice": 0, "Bob": 0}
  if action == "deposit" then
    if amount > 0 then
      let current_balance = balances["Alice"]
      let new_balance = current_balance + amount
      let balances["Alice"] = new_balance
    end
  else if action == "withdraw" then
    if amount > 0 and balances["Alice"] >= amount then
      let current_balance = balances["Alice"]
      let new_balance = current_balance - amount
      let balances["Alice"] = new_balance
    else
      print("Insufficient funds")
    end
  end
  return {"balances": balances, "status": "success"}
end

print(ledger("deposit", 100))
print(ledger("withdraw", 50))
print(ledger("withdraw", 200))


make a function called check_ledger takes action, amount returns result
  let balances = {"Alice": 0, "Bob": 0}
  if action == "deposit" then
    if amount > 0 then
      let current_balance = balances["Alice"]
      let new_balance = current_balance + amount
      let balances["Alice"] = new_balance
    end
  else if action == "withdraw" then
    if amount > 0 and balances["Alice"] >= amount then
      let current_balance = balances["Alice"]
      let new_balance = current_balance - amount
      let balances["Alice"] = new_balance
    else
      print("Insufficient funds")
    end
  end
  return {"balances": balances, "status": "success"}
end

print(check_ledger("deposit", 100))
print(check_ledger("withdraw", 50))
print(check_ledger("withdraw", 200))

make a function called test_ledger takes action, amount returns result
  let ledger_result = check_ledger(action, amount)
  if ledger_result["status"] == "success" then
    print("PASS: ledger(" + action + ", " + amount + ")")
  else
    print("FAIL: ledger(" + action + ", " + amount + ") expected success got failure")
  end
  return true
end

test_ledger("deposit", 100)
test_ledger("withdraw", 50)
test_ledger("withdraw", 200)
test_ledger("withdraw", 30)