make a function called ledger takes action, amount returns result
  make a map called balances
  set_map(balances, "Alice", 0)
  set_map(balances, "Bob", 0)

  if action == "deposit" then
    let user = "Alice"
    let new_balance = get_map(balances, user) + amount
    set_map(balances, user, new_balance)
  else if action == "withdraw" then
    let user = "Bob"
    let current_balance = get_map(balances, user)
    if current_balance < amount then
      let result = {}
      set_map(result, "balance", current_balance)
      set_map(result, "error", "Insufficient funds")
      return result
    else
      let new_balance = current_balance - amount
      set_map(balances, user, new_balance)
    end
  end

  make a map called result
  set_map(result, "balance", get_map(balances, "Alice"))
  set_map(result, "status", "success")
  return result
end

print(ledger("deposit", 10))
print(ledger("withdraw", 5))
print(ledger("withdraw", 20))


make a function called check_ledger takes action, amount returns true
  let result = ledger(action, amount)
  if result["error"] != null then
    print("FAIL: " + action + " " + amount + " expected no error got " + result["error"])
  else
    print("PASS: " + action + " " + amount)
  end
end

check_ledger("deposit", 10)
check_ledger("withdraw", 5)
check_ledger("withdraw", 20)
check_ledger("withdraw", 3)