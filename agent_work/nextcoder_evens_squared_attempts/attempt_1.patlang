make a function called processInput takes text returns result
  if text == "" then
    return null
  end

  let tokens = split(text, ",")
  let processedValues = []
  let hasNegativeSquared = false

  for token in tokens do
    if token.match("^[+-]?\d+$") != null then
      let num = abs(token.to_number())
      if num % 2 == 0 then
        list_push(processedValues, num)
      end
    end
  end

  if processedValues.length < 2 then
    return ""
  end

  let resultLines = []
  for value in processedValues do
    if value in tokens and (value > 0 or hasNegativeSquared) then
      list_push(resultLines, "+" + value.to_string())
    else
      list_push(resultLines, value.to_string())
    end
  end

  return join(resultLines, "\n")
end

print(processInput("-4,-2,3,5"))    # Output: ""
print(processInput("6,8,-10,2"))   # Output: "6\n+8\n+10\n2"
print(processInput(""))            # Output: null


make a function called check_processInput takes text, expected returns done  
  let result = processInput(text)  
  if result == expected then  
    print("PASS: processInput(" + text + ")")  
  else  
    print("FAIL: processInput(" + text + ") expected " + expected + " got " + result)  
  end  
  return true  
end  

check_processInput("-4,-2,3,5", "")  
check_processInput("6,8,-10,2", "6\n+8\n+10\n2")  
check_processInput("", null)