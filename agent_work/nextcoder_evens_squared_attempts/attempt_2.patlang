make a function called processInput takes text returns output
  let tokens = split(text, ",")
  let validNumbers = []
  let hasNegativeSquared = false

  for token in tokens do
    if match(token) then
      let num = to_int(token)
      if num == null or abs(num) % 2 != 0 then continue end
      list_push(validNumbers, num)
      if num < 0 then hasNegativeSquared = true end
    end
  end

  if length(validNumbers) < 2 then return "" end

  let output = []
  for num in validNumbers do
    let signedNum = if num < 0 and hasNegativeSquared then "+" + token else to_string(num) end
    list_push(output, signedNum)
  end

  return join(output, "\n")
end

print(processInput("4,-2,3"))   # should print: 4\n-2
print(processInput("-4,-5,6,7"))  # should print: +(-4)\n+(-5)
print(processInput(""))           # should print: 
print(processInput("abc"))        # should print: 


make a function called check_processInput takes text, expected returns done
  let actual = processInput(text)
  if actual == expected then
    print("PASS: processInput(\"" + text + "\")")
  else
    print("FAIL: processInput(\"" + text + "\") expected \"" + expected + "\" got \"" + actual + "\"")
  end
  return true
end

check_processInput("4,-2,3", "4\n-2")
check_processInput("-4,-5,6,7", "+(-4)\n+(-5)")
check_processInput("", "")
check_processInput("abc", "")