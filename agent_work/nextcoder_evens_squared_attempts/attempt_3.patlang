make a function called processInput takes text returns result
  if text == "" then
    return null
  end

  let tokens = split(text, ",")
  let validNumbers = []
  let hasNegativeSquared = false

  for token in tokens do
    let numStr = trim(token)
    let num = parseInt(numStr)

    if num != null and isInteger(num) then
      let absNum = abs(num)
      if absNum % 2 == 0 then
        list_push(validNumbers, absNum)
      end

      if num < 0 then
        hasNegativeSquared = true
      end
    end
  end

  if length(validNumbers) < 2 then
    return ""
  end

  let resultLines = []
  for num in validNumbers do
    if num < 0 or hasNegativeSquared then
      list_push(resultLines, "+" + toString(num))
    else
      list_push(resultLines, toString(num))
    end
  end

  return join(resultLines, "\n")
end

print(processInput("4,-3,2"))
print(processInput("-16,9,8"))
print(processInput("5.0,7"))


make a function called check_processInput takes text, expected returns done
  let actual = processInput(text)
  if actual == expected then
    print("PASS: processInput(" + text + ")")
  else
    print("FAIL: processInput(" + text + ") expected " + expected + " got " + actual)
  end
  return true
end

check_processInput("4,-3,2", "4\n+2")
check_processInput("-16,9,8", "16\n8")
check_processInput("5.0,7", "")