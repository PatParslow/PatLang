make a function called processInput takes text returns result
  if text == "" then
    return null
  end

  let tokens = split(text, ",")
  let evens = []
  let hasNegativeSquared = false

  for token in tokens do
    let num = parse_int(token)
    if num != null and num % 1 == 0 then
      let absNum = abs(num)
      if absNum % 2 == 0 then
        list_push(evens, absNum)
      end
      if num < 0 then
        hasNegativeSquared = true
      end
    end
  end

  if evens.length < 2 then
    return ""
  end

  let result = ""
  for num in evens do
    if hasNegativeSquared or num < 0 then
      result = result + "+" + str(num) + "\n"
    else
      result = result + str(num) + "\n"
    end
  end

  return substring(result, 0, result.length - 1)
end

print(processInput("-4,-2,3,6"))   # "+(-4)\n+(-2)\n6"
print(processInput("5,7.5,8"))     # "8"
print(processInput(""))            # null
print(processInput("abc"))         # ""


make a function called check_processInput takes text, expected returns done
  let actual = processInput(text)
  if actual == expected then
    print("PASS: processInput(\\"" + text + "\\")")
  else
    print("FAIL: processInput(\\"" + text + "\\") expected \\"" + expected + "\\" got \\"" + actual + "\\"")
  end
  return true
end

check_processInput("-4,-2,3,6", "+(-4)\n+(-2)\n6")
check_processInput("5,7.5,8", "8")
check_processInput("", null)
check_processInput("abc", "")
check_processInput("-10, -8, 2, 4", "+(-10)\n+(-8)\n2\n4")
check_processInput("3, 5, 7", "")