make a function called processInput takes text returns result
  if text == "" then
    return null
  end

  let tokens = split(text, ",")
  let validNumbers = []
  let hasNegativeSquares = false

  for token in tokens do
    let trimmedToken = trim(token)
    let num = parse_int(trimmedToken)

    if num != -1 then
      let absNum = num < 0 ? -num : num
      if absNum % 2 == 0 then
        list_push(validNumbers, absNum)
        if num < 0 then
          hasNegativeSquares = true
        end
      end
    end
  end

  if validNumbers.length < 2 then
    return ""
  else
    let output = []
    for num in validNumbers do
      if hasNegativeSquares and (num != -validNumbers[0] or num != -validNumbers[1]) then
        list_push(output, "+" + to_string(num))
      else
        list_push(output, to_string(num))
      end
    end
    return join(output, "\n")
  end
end

# Example usage:
print(processInput("2,3,4,-5"))  # Output: "2\n4"
print(processInput("-2,-3,-4"))  # Output: ""
print(processInput(""))          # Output: null


make a function called check_processInput takes text, expected returns done
  let actual = processInput(text)
  if actual == expected then
    print("PASS: processInput(" + text + ")")
  else
    print("FAIL: processInput(" + text + ") expected " + expected + " got " + actual)
  end
  return true
end

check_processInput("2,3,4,-5", "2\n4")
check_processInput("-2,-3,-4", "")
check_processInput("", null)
check_processInput("1,2.5,-3", "2")
check_processInput("0,-6,8", "0\n8")
check_processInput("10, -12, 14", "10\n-12\n14")
