make a function called processInput takes text returns result
  if text.length == 0 then
    return null
  end

  let tokens = split(text, ",")
  let validNumbers = []
  let hasNegativeSquare = false

  let i = 0
  while i < tokens.length do
    let token = tokens[i]
    let num = parse_int(token)
    if num != -1 then
      let absNum = abs(num)
      if absNum % 2 == 0 then
        list_push(validNumbers, absNum)
        if num < 0 then
          hasNegativeSquare = true
        end
      end
    end
    let i = i + 1
  end

  if validNumbers.length < 2 then
    return ""
  end

  let result = []
  let j = 0
  while j < validNumbers.length do
    let num = validNumbers[j]
    if hasNegativeSquare or (num < 0 and not hasNegativeSquare) then
      list_push(result, "+" + token)
    else
      list_push(result, token)
    end
    let j = j + 1
  end

  return join(result, "\n")
end

print(processInput("2, -4, 5"))
print(processInput("-3.0, 6, -8"))
print(processInput(""))


make a function called check_processInput takes text, expected returns done
  let actual = processInput(text)
  if actual == expected then
    print("PASS: processInput(\"" + text + "\")")
  else
    print("FAIL: processInput(\"" + text + "\") expected \"" + expected + "\" got \"" + actual + "\"")
  end
  return true
end

check_processInput("2, -4, 5", "2\n-4")
check_processInput("-3.0, 6, -8", "+(-8)\n6")
check_processInput("", "")
check_processInput("abc, def", "")
check_processInput("3.5, -7.0", "")