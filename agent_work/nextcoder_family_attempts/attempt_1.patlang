make a function called countDirectDescendants takes dataPairs, queryName returns result
  let result = 0
  
  # Check for edge case: less than two people means no relationships
  if dataPairs.length < 2 then
    return 0
  end

  # Iterate through the data pairs to count direct descendants
  let i = 0
  while i < dataPairs.length do
    if dataPairs[i][1] == queryName then
      # Ensure it's a parent (has at least one child)
      let j = 0
      let foundParent = false
      while j < dataPairs.length do
        if dataPairs[j][0] == queryName then
          let foundParent = true
          break
        end
        let j = j + 1
      end
      
      # Count as descendant if parent is found
      if foundParent then
        result = result + 1
      else
        throw("Error: Query name appears only as a child, not as a parent.")
      end
    end
    let i = i + 1
  end

  return result
end

# Example usage:
let familyTree = [["alice", "bob"], ["alice", "carol"], ["bob", "dana"]]
print(countDirectDescendants(familyTree, "alice")) # Should print 2

let singlePerson = [["john", "doe"]]
print(countDirectDescendants(singlePerson, "john")) # Should return 0

try {
  let invalidCase = [["jane", "smith"], ["anna", "smith"]]
  print(countDirectDescendants(invalidCase, "jane"))
} catch e {
  print(e) # Should print the error message
}


