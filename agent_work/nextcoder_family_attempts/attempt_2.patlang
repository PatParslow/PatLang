make a function called countDirectDescendants takes dataPairs, queryName returns count
  let count = 0
  if dataPairs.length < 2 then
    return 0
  end
  for pair in dataPairs do
    if pair[1] == queryName then
      throw("Error: Query name is not a parent.")
    end
    if pair[0] == queryName then
      let count = count + 1
    end
  end
  return count
end

print(countDirectDescendants([["alice", "bob"], ["alice", "carol"], ["bob", "dana"]], "alice")) # Should print 2
print(countDirectDescendants([["alice", "bob"], ["alice", "carol"], ["bob", "dana"]], "bob"))   # Should throw an error: Query name is not a parent.


make a function called check_count_direct_descendants takes dataPairs, queryName returns done
  let count = countDirectDescendants(dataPairs, queryName)
  if count == 2 then
    print("PASS: countDirectDescendants([["alice", "bob"], ["alice", "carol"], ["bob", "dana"]], "alice")")
  else
    print("FAIL: countDirectDescendants([["alice", "bob"], ["alice", "carol"], ["bob", "dana"]], "alice") expected 2 got " + count)
  end
  return true
end

make a function called check_count_direct_descendants_error takes dataPairs, queryName returns done
  try
    let count = countDirectDescendants(dataPairs, queryName)
    print("FAIL: countDirectDescendants([["alice", "bob"], ["alice", "carol"], ["bob", "dana"]], "bob") did not throw an error")
  catch e
    if e == "Error: Query name is not a parent." then
      print("PASS: countDirectDescendants([["alice", "bob"], ["alice", "carol"], ["bob", "dana"]], "bob") throws an error: Query name is not a parent.")
    else
      print("FAIL: countDirectDescendants([["alice", "bob"], ["alice", "carol"], ["bob", "dana"]], "bob") threw an unexpected error")
    end
  end
  return true
end

check_count_direct_descendants([["alice", "bob"], ["alice", "carol"], ["bob", "dana"]], "alice")
check_count_direct_descendants_error([["alice", "bob"], ["alice", "carol"], ["bob", "dana"]], "bob")
check_count_direct_descendants([], "alice") # Should print 0
check_count_direct_descendants([["alice", "bob"]], "bob") # Should throw an error: Query name is not a parent.
