make a function called countDirectDescendants takes dataPairs, queryName returns result
  let count = 0

  # Early return for edge case: if there's only one person, no descendants possible
  if dataPairs.length < 2 then
    return 0
  end

  # Iterate through the list of pairs to find direct descendants
  let i = 0
  while i < dataPairs.length do
    let pair = dataPairs[i]
    if pair[1] == queryName then
      throw("Error: The given name is only a child and not a parent.")
    else if pair[0] == queryName then
      let count = count + 1
    end
    let i = i + 1
  end

  return count
end

# Example usage:
let dataPairs = [["alice", "bob"], ["alice", "carol"], ["bob", "dana"]]
print(countDirectDescendants(dataPairs, "alice")) # Should print: 2

let singlePersonData = [["alice", "bob"]]
try print(countDirectDescendants(singlePersonData, "alice"))
catch error
  print(error) # Should print: Error: The given name is only a child and not a parent.

let noParentData = [["bob", "dana"]]
try print(countDirectDescendants(noParentData, "alice"))
catch error
  print(error) # Should throw an error as alice does not exist in the dataset.


