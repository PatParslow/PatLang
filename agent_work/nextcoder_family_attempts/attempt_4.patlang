make a function called countDirectDescendants takes dataPairs, queryName returns result
  let result = 0

  if dataPairs.length < 2 then
    return 0  # Edge case: fewer than two people in the dataset
  end

  let i = 0
  while i < dataPairs.length do
    let pair = dataPairs[i]
    if pair[1] == queryName then
      throw Error("Query name appears as a child but not a parent")
    else if pair[0] == queryName then
      let result = result + 1
    end
    let i = i + 1
  end

  return result
end

# Test cases to demonstrate example usage:
let familyTree = [
  ["Alice", "Bob"],
  ["Alice", "Carol"],
  ["Bob", "Dana"]
]

try
  print(countDirectDescendants(familyTree, "Alice"))  # Expected output: 2
catch e
  print(e)

try
  print(countDirectDescendants([["Eve"]], "Eve"))  # Expected output: 0
catch e
  print(e)  # No output expected since there's no child for Eve

try
  print(countDirectDescendants([["Bob", "Charlie"], ["Dana", "Eve"]], "Alice"))  # Should throw an error
catch e
  print(e.message)  # Expected output: Query name appears as a child but not a parent


make a function called check_countDirectDescendants takes dataPairs, queryName expected returns done
  try
    let result = countDirectDescendants(dataPairs, queryName)
    if result == expected then
      print("PASS: countDirectDescendants(" + dataPairs.to_s() + ", " + queryName + ")")
    else
      print("FAIL: countDirectDescendants(" + dataPairs.to_s() + ", " + queryName + ") expected " + expected + " got " + result)
  catch e
    if expected.message == e.message then
      print("PASS: countDirectDescendants(" + dataPairs.to_s() + ", " + queryName + ") threw the expected error")
    else
      print("FAIL: countDirectDescendants(" + dataPairs.to_s() + ", " + queryName + ") threw an unexpected error: " + e.message)
  end
  return true
end

check_countDirectDescendants([["Alice", "Bob"], ["Alice", "Carol"], ["Bob", "Dana"]], "Alice", 2)
check_countDirectDescendants([["Eve"]], "Eve", 0)
check_countDirectDescendants([["Bob", "Charlie"], ["Dana", "Eve"]], "Alice", "Query name appears as a child but not a parent")
check_countDirectDescendants([], "NoOne", 0)  # Edge case: empty list
check_countDirectDescendants([["OnlyPerson"]], "OnlyPerson", 0)  # Edge case: single person with no children