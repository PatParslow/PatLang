make a function called check_countDirectDescendants takes dataPairs, queryName, expected returns done
  try
    let actual = countDirectDescendants(dataPairs, queryName)
    if actual == expected then
      print("PASS: countDirectDescendants(" + dataPairs + ", " + queryName + ")")
    else
      print("FAIL: countDirectDescendants(" + dataPairs + ", " + queryName + ") expected " + expected + " got " + actual)
  catch e
    if e == "Error: Input dataset must contain at least two people." then
      if expected == "Error: Input dataset must contain at least two people." then
        print("PASS: countDirectDescendants(" + dataPairs + ", " + queryName + ")")
      else
        print("FAIL: countDirectDescendants(" + dataPairs + ", " + queryName + ") expected " + expected + " got Error: Input dataset must contain at least two people.")
    elif e == "Error: Query name does not appear in the dataset as a child." then
      if expected == "Error: Query name does not appear in the dataset as a child." then
        print("PASS: countDirectDescendants(" + dataPairs + ", " + queryName + ")")
      else
        print("FAIL: countDirectDescendants(" + dataPairs + ", " + queryName + ") expected " + expected + " got Error: Query name does not appear in the dataset as a child.")
    end
  end
  return true
end

check_countDirectDescendants([["Alice", "Bob"], ["Alice", "Carol"], ["Bob", "Dana"]], "Alice", 2)
check_countDirectDescendants([["Alice", "Bob"], ["Alice", "Carol"], ["Bob", "Dana"]], "Bob", 1)
check_countDirectDescendants([["Alice", "Bob"], ["Alice", "Carol"], ["Bob", "Dana"]], "Carol", 0)
check_countDirectDescendants([["Alice", "Bob"]], "Alice", "Error: Input dataset must contain at least two people.")
check_countDirectDescendants([], "John", "Error: Query name does not appear in the dataset as a child.")
check_countDirectDescendants([["Alice", "Bob"], ["Alice", "Carol"], ["Bob", "Dana"]], "Eve", "Error: Query name does not appear in the dataset as a child.")