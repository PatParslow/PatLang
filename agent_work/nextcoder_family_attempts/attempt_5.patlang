make a function called countDirectDescendants takes dataPairs, queryName returns count or throws Error
  let count = 0
  if dataPairs.length < 2 then
    throw "Error: Input dataset must contain at least two people."
  end

  # Check if queryName is present in the pairs as a child
  let isChildPresent = false
  for pair in dataPairs do
    if pair[1] == queryName then
      isChildPresent = true
    end
  end

  if not isChildPresent then
    throw "Error: Query name does not appear in the dataset as a child."
  end

  # Count direct descendants of queryName
  let i = 0
  while i < dataPairs.length do
    if dataPairs[i][0] == queryName then
      let count = count + 1
    end
    let i = i + 1
  end

  return count
end

