make a function called countDirectDescendants takes dataPairs, queryName returns result
  # Check if there are fewer than two people in the dataset
  if dataPairs.length < 2 then
    return 0
  end

  let result = 0
  
  # Iterate through each pair to find direct descendants of queryName
  let i = 0
  while i < dataPairs.length do
    let parent = dataPairs[i][0]
    let child = dataPairs[i][1]

    if parent == queryName then
      let result = result + 1
    end

    let i = i + 1
  end

  return result
end

# Test cases to demonstrate example usage
let dataPairs = [["alice", "bob"], ["alice", "carol"], ["bob", "dana"]]
print(countDirectDescendants(dataPairs, "alice"))  # Output: 2 (bob and carol are direct descendants of alice)

dataPairs = [["bob", "dana"]]
print(countDirectDescendants(dataPairs, "bob"))  # Output: 1 (dana is the direct descendant of bob)

dataPairs = [["alice", "bob"], ["charlie", "david"]]
try
  print(countDirectDescendants(dataPairs, "eve"))
catch error
  print(error)  # Should raise an error because "eve" does not appear as a parent in the dataPairs

dataPairs = [["alice", "bob"]]
try
  print(countDirectDescendants(dataPairs, "alice"))
catch error
  print(error)  # Should raise an error because "alice" appears only as a child and has no descendants


make a function called check_countDirectDescendants takes dataPairs, queryName, expected returns done
  let actual = countDirectDescendants(dataPairs, queryName)
  if actual == expected then
    print("PASS: countDirectDescendants(" + dataPairs + ", " + queryName + ")")
  else
    print("FAIL: countDirectDescendants(" + dataPairs + ", " + queryName + ") expected " + expected + " got " + actual)
  end
  return true
end

check_countDirectDescendants([["alice", "bob"], ["alice", "carol"], ["bob", "dana"]], "alice", 2)
check_countDirectDescendants([["bob", "dana"]], "bob", 1)
check_countDirectDescendants([["alice", "bob"], ["charlie", "david"]], "eve", "Error: Query name does not appear as a parent in the data")
check_countDirectDescendants([["alice", "bob"]], "alice", "Error: Query name appears only as a child and has no descendants")