make a function called generateFibonacciSequence takes N returns sequence
  if not N then
    let sequence = null
  else
    let sequence = []
    if N < 2 then
      list_push(sequence, 0)
    else
      let a = 0
      let b = 1
      list_push(sequence, a)
      list_push(sequence, b)
      let i = 3
      while i <= N do
        let nextTerm = a + b
        list_push(sequence, nextTerm)
        let a = b
        let b = nextTerm
        let i = i + 1
      end
    end
  end
  return sequence
end

# Example usage:
print(generateFibonacciSequence(5))  # [0, 1, 1, 2, 3, 5]


make a function called check_generateFibonacciSequence takes N, expected returns done
  let actual = generateFibonacciSequence(N)
  if actual == expected then
    print("PASS: generateFibonacciSequence(" + N + ")")
  else
    print("FAIL: generateFibonacciSequence(" + N + ") expected " + expected + " got " + actual)
  end
  return true
end

# Test cases
check_generateFibonacciSequence(5, [0, 1, 1, 2, 3, 5])
check_generateFibonacciSequence(7, [0, 1, 1, 2, 3, 5, 8, 13])
check_generateFibonacciSequence(0, [0])
check_generateFibonacciSequence(1, [0, 1])
check_generateFibonacciSequence(null, null)
check_generateFibonacciSequence(-1, null)
