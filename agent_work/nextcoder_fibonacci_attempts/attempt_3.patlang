make a function called generateFibonacciSequence takes N returns result
  if N < 2 then
    return null
  else
    let result = []
    list_push(result, 0)
    list_push(result, 1)
    let i = 3
    while i <= N do
      let nextTerm = result[i-3] + result[i-4]
      list_push(result, nextTerm)
      let i = i + 1
    end
    return result
  end
end

print(generateFibonacciSequence(5))   # [0, 1, 1, 2, 3, 5]
print(generateFibonacciSequence(7))   # [0, 1, 1, 2, 3, 5, 8, 13]
print(generateFibonacciSequence(0))   # []
print(generateFibonacciSequence(1))   # [0, 1]


make a function called check_generateFibonacciSequence takes N expected returns done
  let result = generateFibonacciSequence(N)
  if result == expected then
    print("PASS: generateFibonacciSequence(" + N + ")")
  else
    print("FAIL: generateFibonacciSequence(" + N + ") expected " + expected + " got " + result)
  end
  return true
end

check_generateFibonacciSequence(5, [0, 1, 1, 2, 3, 5])
check_generateFibonacciSequence(7, [0, 1, 1, 2, 3, 5, 8, 13])
check_generateFibonacciSequence(0, [])
check_generateFibonacciSequence(1, [0, 1])
check_generateFibonacciSequence(-1, null)
check_generateFibonacciSequence(2, [0, 1, 1])
