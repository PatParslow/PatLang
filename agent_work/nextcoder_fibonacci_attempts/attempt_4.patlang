make a function called generateFibonacciSequence takes N returns result
  if N == null then
    return null
  end
  
  let result = []
  
  if N < 2 then
    return null
  end
  
  let current = 0
  let next = 1
  
  list_push(result, current)
  list_push(result, next)
  
  let i = 3
  while i <= N do
    let temp = next
    let next = current + next
    let current = temp
    
    list_push(result, next)
    let i = i + 1
  end
  
  return result
end

print(generateFibonacciSequence(5))
print(generateFibonacciSequence(7))
print(generateFibonacciSequence(0))
print(generateFibonacciSequence(1))
print(generateFibonacciSequence(2))

make a function called check_generateFibonacciSequence takes N, expected returns done
  let actual = generateFibonacciSequence(N)
  if actual == expected then
    print("PASS: generateFibonacciSequence(" + N + ")")
  else
    print("FAIL: generateFibonacciSequence(" + N + ") expected " + expected + " got " + actual)
  end
  return true
end

check_generateFibonacciSequence(5, [0, 1, 1, 2, 3])
check_generateFibonacciSequence(7, [0, 1, 1, 2, 3, 5, 8])
check_generateFibonacciSequence(0, null)
check_generateFibonacciSequence(1, null)
check_generateFibonacciSequence(2, [0, 1, 1])