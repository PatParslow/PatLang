make a function called generateFibonacciSequence takes N returns result
  if N == null or N < 2 then
    return null
  end

  let result = []
  list_push(result, 0)
  if N >= 2 then
    list_push(result, 1)
    let i = 3
    while i <= N do
      let nextTerm = result[i - 3] + result[i - 4]
      list_push(result, nextTerm)
      let i = i + 1
    end
  end

  return result
end

print(generateFibonacciSequence(5))   # [0, 1, 1, 2, 3]
print(generateFibonacciSequence(7))   # [0, 1, 1, 2, 3, 5, 8]
print(generateFibonacciSequence(2))   # [0, 1, 1]

make a function called check_generateFibonacciSequence takes N, expected returns done
  let actual = generateFibonacciSequence(N)
  if actual == expected then
    print("PASS: generateFibonacciSequence(" + N + ")")
  else
    print("FAIL: generateFibonacciSequence(" + N + ") expected " + expected + " got " + actual)
  end
  return true
end

check_generateFibonacciSequence(5, [0, 1, 1, 2, 3])
check_generateFibonacciSequence(7, [0, 1, 1, 2, 3, 5, 8])
check_generateFibonacciSequence(2, [0, 1, 1])
check_generateFibonacciSequence(null, null)
check_generateFibonacciSequence(0, null)
check_generateFibonacciSequence(-3, null)