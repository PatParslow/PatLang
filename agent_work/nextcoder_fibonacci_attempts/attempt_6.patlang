make a function called generateFibonacciSequence takes N returns result
  if N < 2 then
    return null
  else
    let result = []
    list_push(result, 0)
    list_push(result, 1)

    let i = 3
    while i <= N do
      let nextTerm = result[i - 2] + result[i - 3]
      list_push(result, nextTerm)
      let i = i + 1
    end

    return result
  end
end

print(generateFibonacciSequence(5))   # [0, 1, 1, 2, 3]
print(generateFibonacciSequence(7))   # [0, 1, 1, 2, 3, 5, 8]
print(generateFibonacciSequence(2))   # [0, 1]

