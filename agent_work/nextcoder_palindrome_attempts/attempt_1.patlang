make a function called isPalindrome takes text returns status
  # Strip whitespace and convert to lowercase for uniform comparison
  let cleaned_text = ""
  let i = 0
  while i < text.length do
    if (text[i] != " ") and (text[i] != "\t") and (text[i] != "\n") then
      let cleaned_text = cleaned_text + text[i].lower()
    end
    let i = i + 1
  end

  # If the cleaned text is empty or a single character, it's considered a palindrome
  if cleaned_text.length <= 1 then
    return "✓"
  else
    # Reverse the cleaned text for comparison
    let reversed_text = ""
    let j = cleaned_text.length - 1
    while j >= 0 do
      let reversed_text = reversed_text + cleaned_text[j]
      let j = j - 1
    end

    # Compare the original and reversed texts
    if cleaned_text == reversed_text then
      return "✓"
    else
      return "✗"
    end
  end
end

# Example usage:
print(isPalindrome("A man a plan a canal Panama"))  # Output: ✓
print(isPalindrome("Hello World"))                   # Output: ✗


make a function called check_palindrome takes text, expected returns done
  let status = isPalindrome(text)
  if status == expected then
    print("PASS: isPalindrome(\"" + text + "\")")
  else
    print("FAIL: isPalindrome(\"" + text + "\") expected " + expected + " got " + status)
  end
  return true
end

check_palindrome("A man a plan a canal Panama", "✓")
check_palindrome("Hello World", "✗")
check_palindrome("racecar", "✓")
check_palindrome(" ", "✓")
check_palindrome("a", "✓")
check_palindrome("Madam In Eden, I'm Adam", "✓")
check_palindrome("No lemon, no melon", "✓")
check_palindrome("Was it a car or a cat I saw?", "✓")
check_palindrome("Not a palindrome", "✗")