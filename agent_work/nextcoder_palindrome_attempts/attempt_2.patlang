make a function called isPalindrome takes text returns status
  # Strip whitespace and convert to lowercase
  let cleanedText = ""
  let i = 0
  while i < text.length do
    if (text[i] != " ") then
      let cleanedText = cleanedText + text[i].toLowerCase()
    end
    let i = i + 1
  end

  # Check for edge cases: empty or single character strings are considered palindromes
  if cleanedText.length <= 1 then
    return "✓"
  end

  # Reverse the cleaned string
  let reversedText = ""
  let j = cleanedText.length - 1
  while j >= 0 do
    let reversedText = reversedText + cleanedText[j]
    let j = j - 1
  end

  # Compare the reversed string with the original
  if cleanedText == reversedText then
    return "✓"
  else
    return "✗"
  end
end

# Test cases
print(isPalindrome("A man a plan a canal Panama"))  # Should print: ✓
print(isPalindrome("Hello World"))                  # Should print: ✗
print(isPalindrome("racecar"))                      # Should print: ✓
print(isPalindrome(" "))                            # Should print: ✓
print(isPalindrome("a"))                            # Should print: ✓
print(isPalindrome("Madam In Eden, I'm Adam"))      # Should print: ✓
print(isPalindrome("No lemon, no melon"))           # Should print: ✓
print(isPalindrome("Was it a car or a cat I saw?"))  # Should print: ✓
print(isPalindrome("Not a palindrome"))               # Should print: ✗

make a function called check_palindrome takes text returns done
  let actual = isPalindrome(text)
  if actual == "✓" then
    print("PASS: isPalindrome(" + text + ")")
  else
    print("FAIL: isPalindrome(" + text + ") expected ✓ got " + actual)
  end
  return true
end

check_palindrome("A man a plan a canal Panama")
check_palindrome("Hello World")
check_palindrome("racecar")
check_palindrome(" ")
check_palindrome("a")
check_palindrome("Madam In Eden, I'm Adam")
check_palindrome("No lemon, no melon")
check_palindrome("Was it a car or a cat I saw?")
check_palindrome("Not a palindrome")