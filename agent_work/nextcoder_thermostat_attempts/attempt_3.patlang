make a function called control takes temp returns result
  if temp < 65 then
    let result = "HEATING"
  else if temp > 78 then
    let result = "COOLING"
  else
    let result = "OK"
  end
  return result
end

print(control(60))   # HEATING
print(control(79))   # COOLING
print(control(65))   # OK
print(control(78))   # OK


make a function called check_control takes temp, expected returns done
  let actual = control(temp)
  if actual == expected then
    print("PASS: control(" + temp + ")")
  else
    print("FAIL: control(" + temp + ") expected " + expected + " got " + actual)
  end
  return true
end

check_control(60, "HEATING")
check_control(79, "COOLING")
check_control(65, "OK")
check_control(78, "OK")
check_control(64.9, "HEATING")
check_control(78.1, "COOLING")
check_control(65.0, "OK")
check_control(78.0, "OK")
check_control(63, "HEATING")
check_control(80, "COOLING")