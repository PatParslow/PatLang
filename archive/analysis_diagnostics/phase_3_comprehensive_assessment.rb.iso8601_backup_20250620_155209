#!/usr/bin/env ruby
# frozen_string_literal: true

# Phase 3 Comprehensive Assessment Runner
# Validates all Priority 3A fixes and measures cumulative progress

require 'json'
require 'pathname'
require 'timeout'
require 'simplecov'

# Configure SimpleCov for coverage analysis
SimpleCov.start do
  enable_coverage :branch
  add_filter '/test/'
  track_files 'src/**/*.rb'
  
  formatter SimpleCov::Formatter::MultiFormatter.new([
    SimpleCov::Formatter::HTMLFormatter,
    SimpleCov::Formatter::SimpleFormatter
  ])
end

class Phase3AssessmentRunner
  def initialize
    @start_time = Time.now
    @test_results = {
      total_tests: 0,
      passed: 0,
      failed: 0,
      errors: 0,
      skipped: 0,
      timeouts: 0,
      hanging_tests: [],
      infrastructure_failures: [],
      priority_3a_validations: {
        test_helper_redirect: false,
        infrastructure_files_loading: 0,
        function_integration_completion: false,
        ast_serialization_fix: false
      }
    }
    @phase_comparison = {
      original_baseline: { pass_rate: 45.6, description: "Original state" },
      post_priority_1: { pass_rate: nil, description: "After TypeConstraintSystem and Unknown Error fixes" },
      post_priority_2: { pass_rate: 47.4, description: "After Range Constraints and Event System fixes" },
      post_phase_3: { pass_rate: nil, description: "After Priority 3A Infrastructure and Hanging Test fixes" }
    }
  end

  def log_with_timestamp(message, level = :info)
    timestamp = Time.now.strftime("%H:%M:%S.%3N")
    symbol = case level
             when :info then "ℹ️"
             when :success then "✅"
             when :warning then "⚠️"
             when :error then "❌"
             when :progress then "🔄"
             else "📋"
             end
    puts "[#{timestamp}] #{symbol} #{message}"
    STDOUT.flush
  end

  def run_assessment
    log_with_timestamp("=" * 80)
    log_with_timestamp("🚀 PHASE 3 COMPREHENSIVE ASSESSMENT STARTING", :progress)
    log_with_timestamp("=" * 80)
    log_with_timestamp("Validating Priority 3A fixes and measuring cumulative progress")
    log_with_timestamp("Assessment started at: #{@start_time.strftime('%Y-%m-%d %H:%M:%S')}")
    log_with_timestamp("")

    # Step 1: Validate specific Priority 3A fixes
    validate_priority_3a_fixes

    # Step 2: Load test infrastructure
    load_test_infrastructure

    # Step 3: Run comprehensive test suite
    run_comprehensive_tests

    # Step 4: Analyze results and generate reports
    analyze_results_and_generate_reports

    # Step 5: Compare against all previous baselines
    generate_phase_comparison_report

    log_with_timestamp("=" * 80)
    log_with_timestamp("📊 PHASE 3 ASSESSMENT COMPLETED", :success)
    log_with_timestamp("=" * 80)
  end

  private

  def validate_priority_3a_fixes
    log_with_timestamp("🔍 VALIDATING PRIORITY 3A SPECIFIC FIXES", :progress)
    log_with_timestamp("")

    # Validate test_helper redirect
    log_with_timestamp("Checking test_helper.rb redirect...")
    if File.exist?('test/helpers/test_helper.rb')
      @test_results[:priority_3a_validations][:test_helper_redirect] = true
      log_with_timestamp("✅ test_helper.rb redirect working", :success)
    else
      log_with_timestamp("❌ test_helper.rb redirect missing", :error)
    end

    # Check infrastructure files can load
    log_with_timestamp("Validating infrastructure file loading...")
    infrastructure_files = [
      'test/ruby_implementation/test_advanced_goal_strategies.rb',
      'test/ruby_implementation/test_evaluator_edge_cases.rb',
      'test/ruby_implementation/test_evaluator_stress.rb',
      'test/ruby_implementation/test_extended_string_methods.rb',
      'test/ruby_implementation/test_function_evaluator.rb',
      'test/ruby_implementation/test_goal_system.rb',
      'test/ruby_implementation/test_object_model_comprehensive.rb',
      'test/ruby_implementation/test_object_model_edge_cases.rb',
      'test/ruby_implementation/test_object_model_stress.rb',
      'test/ruby_implementation/test_object_model.rb',
      'test/ruby_implementation/test_reasoning_evaluator_integration.rb',
      'test/ruby_implementation/test_string_literals.rb',
      'test/ruby_implementation/test_string_operations.rb',
      'test/ruby_implementation/test_type_constraints_clean.rb'
    ]

    loaded_count = 0
    infrastructure_files.each do |file|
      if File.exist?(file)
        begin
          # Test if file can be required without immediate errors - use absolute path
          absolute_path = File.expand_path(file)
          require absolute_path
          loaded_count += 1
          log_with_timestamp("   ✅ #{File.basename(file)} - loadable", :success)
        rescue => e
          log_with_timestamp("   ❌ #{File.basename(file)} - #{e.message}", :error)
          @test_results[:infrastructure_failures] << { file: file, error: e.message }
        end
      else
        log_with_timestamp("   ⚠️  #{File.basename(file)} - file missing", :warning)
      end
    end

    @test_results[:priority_3a_validations][:infrastructure_files_loading] = loaded_count
    log_with_timestamp("Infrastructure files loading: #{loaded_count}/#{infrastructure_files.length}", 
                      loaded_count == infrastructure_files.length ? :success : :warning)

    # Validate function integration test completion
    log_with_timestamp("Checking function integration test...")
    if File.exist?('test/patlang_language/test_function_integration.rb')
      begin
        test_start = Time.now
        # Load the test file and check if it can complete
        require File.expand_path('test/patlang_language/test_function_integration.rb')
        test_duration = Time.now - test_start
        
        if test_duration < 30 # Should complete in under 30 seconds
          @test_results[:priority_3a_validations][:function_integration_completion] = true
          log_with_timestamp("✅ test_function_integration.rb loads without hanging (#{test_duration.round(2)}s)", :success)
        else
          log_with_timestamp("⚠️  test_function_integration.rb slow but completed (#{test_duration.round(2)}s)", :warning)
        end
      rescue => e
        log_with_timestamp("❌ test_function_integration.rb failed: #{e.message}", :error)
      end
    else
      log_with_timestamp("⚠️  test_function_integration.rb not found", :warning)
    end

    log_with_timestamp("")
  end

  def load_test_infrastructure
    log_with_timestamp("📁 LOADING TEST INFRASTRUCTURE", :progress)
    
    # Load test helper first
    begin
      require File.expand_path('test/helpers/test_helper.rb')
      log_with_timestamp("✅ Test helper loaded successfully", :success)
    rescue => e
      log_with_timestamp("❌ Failed to load test helper: #{e.message}", :error)
      return false
    end

    # Discover all test files
    test_dir = File.join(File.dirname(__FILE__), 'test')
    test_files = Dir.glob(File.join(test_dir, '**', 'test_*.rb')).sort

    # Filter out helper and runner files
    excluded_files = [
      'test_helper.rb',
      'run_all_tests.rb',
      'progress_test_runner.rb',
      'real_time_test_runner.rb'
    ]

    @test_files = test_files.select do |file|
      basename = File.basename(file)
      !excluded_files.include?(basename) && basename.start_with?('test_')
    end

    log_with_timestamp("Discovered #{@test_files.length} test files for assessment")
    log_with_timestamp("")
    
    true
  end

  def run_comprehensive_tests
    log_with_timestamp("🧪 RUNNING COMPREHENSIVE TEST SUITE", :progress)
    log_with_timestamp("")

    # Load minitest
    require 'minitest/autorun'

    # Load test files with timeout protection
    @test_files.each_with_index do |file, index|
      relative_path = Pathname.new(file).relative_path_from(Pathname.new(File.dirname(__FILE__))).to_s
      log_with_timestamp("Loading test #{index + 1}/#{@test_files.length}: #{relative_path}")
      
      begin
        Timeout::timeout(10) do  # 10 second timeout for loading
          require file
        end
      rescue Timeout::Error
        log_with_timestamp("   ⏰ TIMEOUT loading #{relative_path}", :error)
        @test_results[:timeouts] += 1
      rescue => e
        log_with_timestamp("   ❌ ERROR loading #{relative_path}: #{e.message}", :error)
        @test_results[:infrastructure_failures] << { file: relative_path, error: e.message }
      end
    end

    log_with_timestamp("")
    log_with_timestamp("🚀 Executing test suite...")
    
    # Capture Minitest results
    test_start = Time.now
    
    # Override Minitest reporter to capture results
    original_reporter = Minitest.reporter
    collector = TestResultCollector.new
    Minitest.reporter = collector
    
    begin
      Timeout::timeout(300) do  # 5 minute timeout for entire suite
        exit_code = Minitest.run([])
        @test_results.merge!(collector.results)
      end
    rescue Timeout::Error
      log_with_timestamp("❌ ENTIRE TEST SUITE TIMED OUT", :error)
      @test_results[:timeouts] += 1
    ensure
      Minitest.reporter = original_reporter
    end
    
    test_duration = Time.now - test_start
    log_with_timestamp("Test suite completed in #{test_duration.round(2)} seconds")
    log_with_timestamp("")
  end

  def analyze_results_and_generate_reports
    log_with_timestamp("📊 ANALYZING RESULTS AND GENERATING REPORTS", :progress)
    log_with_timestamp("")

    # Calculate pass rate
    total_executed = @test_results[:passed] + @test_results[:failed] + @test_results[:errors]
    pass_rate = total_executed > 0 ? (@test_results[:passed].to_f / total_executed * 100).round(2) : 0
    @phase_comparison[:post_phase_3][:pass_rate] = pass_rate

    # Generate detailed results
    results_summary = {
      assessment_timestamp: @start_time.iso8601,
      execution_duration: (Time.now - @start_time).round(2),
      test_execution_results: @test_results,
      pass_rate_percentage: pass_rate,
      priority_3a_validation_status: @test_results[:priority_3a_validations],
      phase_comparison: @phase_comparison,
      coverage_data: SimpleCov.result.to_hash
    }

    # Write detailed JSON report
    File.write('POST_PHASE_3_ASSESSMENT_RESULTS.json', JSON.pretty_generate(results_summary))
    log_with_timestamp("✅ Detailed results saved to POST_PHASE_3_ASSESSMENT_RESULTS.json", :success)

    # Generate human-readable report
    generate_human_readable_report(results_summary)
    
    log_with_timestamp("")
  end

  def generate_human_readable_report(results)
    report_content = <<~REPORT
    # POST-PHASE-3 COMPREHENSIVE ASSESSMENT REPORT
    
    **Assessment Date:** #{@start_time.strftime('%Y-%m-%d %H:%M:%S')}
    **Total Execution Time:** #{results[:execution_duration]} seconds
    
    ## 🎯 PHASE 3 PRIORITY 3A VALIDATION STATUS
    
    ### Infrastructure Fixes (Priority 3A-1)
    - ✅ **Test Helper Redirect:** #{@test_results[:priority_3a_validations][:test_helper_redirect] ? 'WORKING' : 'FAILED'}
    - 📊 **Infrastructure Files Loading:** #{@test_results[:priority_3a_validations][:infrastructure_files_loading]}/14 files can load
    #{@test_results[:infrastructure_failures].any? ? "- ⚠️  **Infrastructure Failures Found:** #{@test_results[:infrastructure_failures].length}" : "- ✅ **All Infrastructure Files:** Loading successfully"}
    
    ### Performance/Hanging Test Fixes (Priority 3A-2)
    - 🧪 **Function Integration Test:** #{@test_results[:priority_3a_validations][:function_integration_completion] ? 'COMPLETING (no hang)' : 'ISSUES REMAIN'}
    #{@test_results[:hanging_tests].any? ? "- ⚠️  **Hanging Tests Detected:** #{@test_results[:hanging_tests].length}" : "- ✅ **No Hanging Tests:** All tests complete within timeout"}
    
