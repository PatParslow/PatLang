  def generate_phase_comparison_report
    log_with_timestamp("📊 GENERATING COMPREHENSIVE PHASE COMPARISON", :progress)
    
    comparison_data = {
      phases: @phase_comparison,
      cumulative_improvements: {
        total_improvement: @phase_comparison[:post_phase_3][:pass_rate] - @phase_comparison[:original_baseline][:pass_rate],
        phase_3_contribution: @phase_comparison[:post_phase_3][:pass_rate] - @phase_comparison[:post_priority_2][:pass_rate]
      },
      stability_metrics: {
        infrastructure_loading_success_rate: (@test_results[:priority_3a_validations][:infrastructure_files_loading] / 14.0 * 100).round(2),
        timeout_reduction: @test_results[:timeouts] == 0,
        test_helper_functionality: @test_results[:priority_3a_validations][:test_helper_redirect]
      }
    }

    File.write('COMPREHENSIVE_PHASE_COMPARISON.json', JSON.pretty_generate(comparison_data))
    log_with_timestamp("✅ Phase comparison data saved to COMPREHENSIVE_PHASE_COMPARISON.json", :success)
    log_with_timestamp("")
  end

  def assess_overall_success(results)
    success_indicators = [
      @test_results[:priority_3a_validations][:test_helper_redirect],
      @test_results[:priority_3a_validations][:infrastructure_files_loading] >= 12, # At least 12/14 files
      @test_results[:priority_3a_validations][:function_integration_completion],
      @phase_comparison[:post_phase_3][:pass_rate] > @phase_comparison[:post_priority_2][:pass_rate]
    ]
    
    success_count = success_indicators.count(true)
    
    case success_count
    when 4
      "🏆 EXCELLENT - All Priority 3A objectives achieved"
    when 3
      "✅ SUCCESS - Major Priority 3A objectives achieved"
    when 2
      "⚠️  PARTIAL SUCCESS - Some Priority 3A objectives achieved"
    else
      "❌ NEEDS ATTENTION - Priority 3A objectives not fully met"
    end
  end

  def determine_next_phase_readiness(results)
    if @phase_comparison[:post_phase_3][:pass_rate] > 50 && 
       @test_results[:priority_3a_validations][:test_helper_redirect] &&
       @test_results[:priority_3a_validations][:infrastructure_files_loading] >= 12
      "🚀 READY for Priority 3B/3C improvements"
    else
      "⚠️  Consider additional Phase 3A refinements before proceeding"
    end
  end
end

# Helper class to collect test results
class TestResultCollector
  attr_reader :results

  def initialize
    @results = {
      total_tests: 0,
      passed: 0,
      failed: 0,
      errors: 0,
      skipped: 0,
      hanging_tests: []
    }
  end

  def record(result)
    @results[:total_tests] += 1
    
    if result.passed?
      @results[:passed] += 1
    elsif result.skipped?
      @results[:skipped] += 1
    elsif result.failure
      if result.failure.is_a?(Minitest::Assertion)
        @results[:failed] += 1
      else
        @results[:errors] += 1
      end
    end
  end

  def report
    # Final reporting - no additional action needed
  end
end

# Main execution
if __FILE__ == $0
  assessment = Phase3AssessmentRunner.new
  assessment.run_assessment
end