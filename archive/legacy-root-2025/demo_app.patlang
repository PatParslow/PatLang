# PatLang Demo: Goals, Logic Programming, HTML GUI
# =============================================================================

# SECTION 1: LOGIC PROGRAMMING - Knowledge Base
print("Logic DB initial state: " + to_string(all_facts()))
print("Fact count: " + to_string(fact_count()))

# SECTION 2: GOAL-ORIENTED PROGRAMMING
declare_goal("complete_all_tasks", "Complete all tasks prioritized by severity")
declare_goal("generate_report", "Generate HTML report from logic database")
declare_goal("visualize_tasks", "Render interactive HTML/JS dashboard")
pursue("complete_all_tasks")
pursue("generate_report")
pursue("visualize_tasks")

# SECTION 3: HTML/JS GUI - Use available functions
head is style_tag("body{font-family:sans-serif;margin:20px;background:#f5f5f5}.container{max-width:1000px;margin:0 auto;background:white;padding:20px;border-radius:8px;box-shadow:0 2px 10px rgba(0,0,0,.1)}h1{color:#333;border-bottom:2px solid #4a90d9;padding-bottom:10px}table{width:100%;border-collapse:collapse;margin:20px 0}th,td{padding:12px;text-align:left;border-bottom:1px solid #eee}th{background:#4a90d9;color:white}.btn{background:#4a90d9;color:white;border:none;padding:6px 12px;border-radius:4px;cursor:pointer}.btn:hover{background:#357abd}.chart{margin:20px 0;border:1px solid #ddd;border-radius:4px}")

# Table with header row
th_row is tr(th("ID")+th("Title")+th("Priority")+th("Assignee")+th("Status")+th("Action"))

# Table rows
r1 is tr(td("write_docs")+td("Write documentation")+td("HIGH")+td("alice")+td("PENDING")+td(button("Select")))
r2 is tr(td("fix_bug_123")+td("Fix login bug")+td("CRITICAL")+td("bob")+td("IN_PROGRESS")+td(button("Select")))
r3 is tr(td("refactor_api")+td("Refactor REST API")+td("MEDIUM")+td("alice")+td("PENDING")+td(button("Select")))
r4 is tr(td("add_tests")+td("Add unit tests")+td("LOW")+td("charlie")+td("PENDING")+td(button("Select")))
r5 is tr(td("deploy")+td("Deploy to production")+td("HIGH")+td("alice")+td("PENDING")+td(button("Select")))

table is table(th_row+r1+r2+r3+r4+r5)

# Chart - simple div representation (canvas functions return JS, not HTML)
chart is div(h3("Priority Distribution")+div("Chart: Critical=1, High=2, Medium=1, Low=1"))

footer is div("Generated by PatLang - Goals, Logic Programming & HTML GUI")
container is div(h1("PatLang Task Dashboard")+table+chart+footer)
html_output is html_doc_with_head("PatLang Task Dashboard",head+container)
render_to_file("task_dashboard.html",html_output)

# SECTION 4: DEMONSTRATION OUTPUT
print("=== PatLang Demo: Goals, Logic Programming, HTML GUI ===")
print("")
print("--- LOGIC PROGRAMMING ---")
print("Fact count: " + to_string(fact_count()))
print("All facts: " + to_string(all_facts()))
print("")
print("--- GOAL-ORIENTED PROGRAMMING ---")
print("Goals: " + to_string(all_goals()))
plan is execution_plan("generate_report")
print("Plan: " + to_string(plan))
print("")
print("--- HTML GUI ---")
print("HTML saved to task_dashboard.html (" + to_string(string_length(html_output)) + " chars)")
print("")
print("=== DEMO COMPLETE ===")
print("Open task_dashboard.html in a browser!")
print("")
print("Features:")
print(" Logic Programming - Facts, rules, queries")
print(" Goal Programming - Goals, plans, pursuit")
print(" HTML/JS GUI - Table, canvas chart")

html_output