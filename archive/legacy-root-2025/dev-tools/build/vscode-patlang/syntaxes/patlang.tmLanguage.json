{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Patlang",
    "scopeName": "source.patlang",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#types"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#identifiers"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.number-sign.patlang",
                    "begin": "#",
                    "end": "$",
                    "captures": {
                        "0": {
                            "name": "punctuation.definition.comment.patlang"
                        }
                    }
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.patlang",
                    "match": "\\b(if|then|else|elsif|end|while|for|in|do|case|when|break|continue|return)\\b"
                },
                {
                    "name": "keyword.declaration.patlang",
                    "match": "\\b(make|a|called|has|is|takes|returns)\\b"
                },
                {
                    "name": "keyword.other.patlang",
                    "match": "\\b(emit|with|activate|query|try|catch|finally|throw)\\b"
                },
                {
                    "name": "constant.language.boolean.patlang",
                    "match": "\\b(true|false)\\b"
                },
                {
                    "name": "constant.language.null.patlang",
                    "match": "\\b(null|nil)\\b"
                },
                {
                    "name": "keyword.operator.logical.patlang",
                    "match": "\\b(and|or|not)\\b"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "storage.type.patlang",
                    "match": "\\b(number|text|time|email|list|template|function|goal|class|module)\\b"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.patlang",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.patlang",
                            "match": "\\\\."
                        },
                        {
                            "name": "constant.other.placeholder.patlang",
                            "match": "#{[^}]*}"
                        }
                    ]
                },
                {
                    "name": "string.quoted.single.patlang",
                    "begin": "'",
                    "end": "'",
                    "patterns": [
                        {
                            "name": "constant.character.escape.patlang",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.float.patlang",
                    "match": "\\b\\d+\\.\\d+\\b"
                },
                {
                    "name": "constant.numeric.integer.patlang",
                    "match": "\\b\\d+\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.assignment.patlang",
                    "match": "="
                },
                {
                    "name": "keyword.operator.arithmetic.patlang",
                    "match": "[+\\-*/]"
                },
                {
                    "name": "keyword.operator.comparison.patlang",
                    "match": "(==|!=|<=|>=|<|>)"
                },
                {
                    "name": "keyword.operator.logical.patlang",
                    "match": "(&&|\\|\\||!)"
                }
            ]
        },
        "identifiers": {
            "patterns": [
                {
                    "name": "variable.other.patlang",
                    "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
                }
            ]
        }
    }
}
