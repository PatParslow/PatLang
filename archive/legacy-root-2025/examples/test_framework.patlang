# ============================================================================
# PaTLang Test Framework
# ============================================================================
# A comprehensive testing framework for writing and running tests in PaTLang.
# Supports assertions, test suites, setup/teardown, and detailed reporting.
# ============================================================================

# ============================================================================
# Core Test State Management
# ============================================================================

def create_test_suite(name) do
  return {
    "name": name,
    "tests": [],
    "passed": 0,
    "failed": 0,
    "errors": 0,
    "setup": null,
    "teardown": null,
    "current_test": null
  }
end

def create_test(name, test_fn) do
  return {
    "name": name,
    "fn": test_fn,
    "passed": false,
    "failed": false,
    "error": null,
    "assertions": 0,
    "assertions_passed": 0
  }
end

# ============================================================================
# Test Suite Configuration
# ============================================================================

def suite_setup(suite, setup_fn) do
  suite["setup"] = setup_fn
  return suite
end

def suite_teardown(suite, teardown_fn) do
  suite["teardown"] = teardown_fn
  return suite
end

def add_test(suite, name, test_fn) do
  test = create_test(name, test_fn)
  suite["tests"].append(test)
  return suite
end

# ============================================================================
# Assertion Functions
# ============================================================================

def assert_true(condition, message) do
  if !condition do
    return {
      "passed": false,
      "message": message or "Expected true but got false"
    }
  end
  return {
    "passed": true,
    "message": "Assertion passed"
  }
end

def assert_false(condition, message) do
  if condition do
    return {
      "passed": false,
      "message": message or "Expected false but got true"
    }
  end
  return {
    "passed": true,
    "message": "Assertion passed"
  }
end

def assert_equals(actual, expected, message) do
  if actual != expected do
    msg = message or "Expected " + expected.to_string() + " but got " + actual.to_string()
    return {
      "passed": false,
      "message": msg
    }
  end
  return {
    "passed": true,
    "message": "Assertion passed"
  }
end

def assert_not_equals(actual, not_expected, message) do
  if actual == not_expected do
    msg = message or "Expected value not to equal " + not_expected.to_string()
    return {
      "passed": false,
      "message": msg
    }
  end
  return {
    "passed": true,
    "message": "Assertion passed"
  }
end

def assert_nil(value, message) do
  if value != null do
    msg = message or "Expected null but got " + value.to_string()
    return {
      "passed": false,
      "message": msg
    }
  end
  return {
    "passed": true,
    "message": "Assertion passed"
  }
end

def assert_not_nil(value, message) do
  if value == null do
    msg = message or "Expected non-null value"
    return {
      "passed": false,
      "message": msg
    }
  end
  return {
    "passed": true,
    "message": "Assertion passed"
  }
end

def assert_includes(array, value, message) do
  found = false
  array.each() do |item|
    if item == value do
      found = true
      break
    end
  end
  
  if !found do
    msg = message or "Expected array to include " + value.to_string()
    return {
      "passed": false,
      "message": msg
    }
  end
  return {
    "passed": true,
    "message": "Assertion passed"
  }
end

def assert_length(collection, expected_length, message) do
  actual_length = collection.length()
  if actual_length != expected_length do
    msg = message or "Expected length " + expected_length.to_string() + " but got " + actual_length.to_string()
    return {
      "passed": false,
      "message": msg
    }
  end
  return {
    "passed": true,
    "message": "Assertion passed"
  }
end

def assert_throws(fn, message) do
  error_thrown = false
  try do
    fn()
  catch e do
    error_thrown = true
  end
  
  if !error_thrown do
    msg = message or "Expected function to throw error but it succeeded"
    return {
      "passed": false,
      "message": msg
    }
  end
  return {
    "passed": true,
    "message": "Assertion passed"
  }
end

def assert_doesnt_throw(fn, message) do
  error_thrown = false
  error_msg = null
  try do
    fn()
  catch e do
    error_thrown = true
    error_msg = e.to_string()
  end
  
  if error_thrown do
    msg = message or "Expected no error but got: " + error_msg
    return {
      "passed": false,
      "message": msg
    }
  end
  return {
    "passed": true,
    "message": "Assertion passed"
  }
end

# ============================================================================
# Test Execution
# ============================================================================

def run_test(suite, test, test_context) do
  # Run setup if defined
  if suite["setup"] != null do
    try do
      suite["setup"](test_context)
    catch e do
      test["error"] = "Setup failed: " + e.to_string()
      test["failed"] = true
      suite["errors"] = suite["errors"] + 1
      return test
    end
  end
  
  # Run test function
  suite["current_test"] = test
  try do
    test["fn"](test_context)
    test["passed"] = true
  catch e do
    test["error"] = e.to_string()
    test["failed"] = true
    suite["errors"] = suite["errors"] + 1
  end
  
  # Run teardown if defined
  if suite["teardown"] != null do
    try do
      suite["teardown"](test_context)
    catch e do
      if !test["failed"] do
        test["error"] = "Teardown failed: " + e.to_string()
        test["failed"] = true
        suite["errors"] = suite["errors"] + 1
      end
    end
  end
  
  return test
end

def run_suite(suite) do
  return run_suite(suite, {})
end

def run_suite(suite, initial_context) do
  suite["passed"] = 0
  suite["failed"] = 0
  suite["errors"] = 0
  
  suite["tests"].each() do |test|
    run_test(suite, test, initial_context)
    
    if test["passed"] do
      suite["passed"] = suite["passed"] + 1
    else if test["failed"] do
      suite["failed"] = suite["failed"] + 1
    end
  end
  
  return suite
end

# ============================================================================
# Test Reporting
# ============================================================================

def format_test_result(test, index) do
  status = "FAIL"
  if test["passed"] do
    status = "PASS"
  else if test["error"] == null do
    status = "FAIL"
  else
    status = "ERROR"
  end
  
  result = ""
  result = result + "[" + status + "] " + test["name"]
  
  if test["error"] != null do
    result = result + "\n  Error: " + test["error"]
  end
  
  return result
end

def print_suite_report(suite) do
  total = suite["passed"] + suite["failed"] + suite["errors"]
  
  puts ""
  puts "=========================================="
  puts "Test Suite: " + suite["name"]
  puts "=========================================="
  puts ""
  
  suite["tests"].each() do |test, index|
    puts format_test_result(test, index)
  end
  
  puts ""
  puts "=========================================="
  puts "Results: " + suite["passed"].to_string() + "/" + total.to_string() + " passed"
  
  if suite["failed"] > 0 do
    puts "         " + suite["failed"].to_string() + " failed"
  end
  
  if suite["errors"] > 0 do
    puts "         " + suite["errors"].to_string() + " errors"
  end
  
  puts "=========================================="
  puts ""
  
  return suite
end

def get_test_stats(suite) do
  total = suite["passed"] + suite["failed"] + suite["errors"]
  pass_rate = 0
  if total > 0 do
    pass_rate = (suite["passed"] * 100) / total
  end
  
  return {
    "name": suite["name"],
    "total": total,
    "passed": suite["passed"],
    "failed": suite["failed"],
    "errors": suite["errors"],
    "pass_rate": pass_rate
  }
end

# ============================================================================
# Test Context Helper
# ============================================================================

def create_test_context() do
  return {
    "assertions": 0,
    "assertions_passed": 0,
    "data": {}
  }
end

def context_set_data(context, key, value) do
  context["data"][key] = value
  return context
end

def context_get_data(context, key) do
  return context["data"][key]
end

# ============================================================================
# Batch Test Execution
# ============================================================================

def run_multiple_suites(suites) do
  results = []
  total_passed = 0
  total_failed = 0
  total_errors = 0
  
  suites.each() do |suite|
    run_suite(suite)
    print_suite_report(suite)
    
    stats = get_test_stats(suite)
    results.append(stats)
    
    total_passed = total_passed + suite["passed"]
    total_failed = total_failed + suite["failed"]
    total_errors = total_errors + suite["errors"]
  end
  
  # Print overall summary
  puts ""
  puts "=========================================="
  puts "OVERALL SUMMARY"
  puts "=========================================="
  
  results.each() do |stat|
    puts stat["name"] + ": " + stat["passed"].to_string() + "/" + stat["total"].to_string() + " (" + stat["pass_rate"].to_string() + "%)"
  end
  
  puts ""
  total = total_passed + total_failed + total_errors
  overall_rate = 0
  if total > 0 do
    overall_rate = (total_passed * 100) / total
  end
  
  puts "Total: " + total_passed.to_string() + "/" + total.to_string() + " (" + overall_rate.to_string() + "%)"
  puts "=========================================="
  puts ""
  
  return {
    "suites": results,
    "total_passed": total_passed,
    "total_failed": total_failed,
    "total_errors": total_errors,
    "pass_rate": overall_rate
  }
end

# ============================================================================
# Export Test Framework API
# ============================================================================

def export_test_framework() do
  return {
    # Suite management
    "create_suite": create_test_suite,
    "add_test": add_test,
    "suite_setup": suite_setup,
    "suite_teardown": suite_teardown,
    
    # Assertions
    "assert_true": assert_true,
    "assert_false": assert_false,
    "assert_equals": assert_equals,
    "assert_not_equals": assert_not_equals,
    "assert_nil": assert_nil,
    "assert_not_nil": assert_not_nil,
    "assert_includes": assert_includes,
    "assert_length": assert_length,
    "assert_throws": assert_throws,
    "assert_doesnt_throw": assert_doesnt_throw,
    
    # Execution
    "run_suite": run_suite,
    "run_test": run_test,
    "run_multiple_suites": run_multiple_suites,
    
    # Reporting
    "print_suite_report": print_suite_report,
    "get_test_stats": get_test_stats,
    
    # Context helpers
    "create_test_context": create_test_context,
    "context_set_data": context_set_data,
    "context_get_data": context_get_data
  }
end
