# Register a test function
def define_test(name, test_fn) [
  # Store test function for later execution
  let test = [
    name = name
    func = test_fn
    passed = false
    error = nil
  ]
  
  test
]

# Run a test and collect result
def run_test(test) [
  let start = current_time()
  
  let result = try_execute_test(test.func)
  
  let elapsed = current_time() - start
  
  if result.error != nil [
    test.passed = false
    test.error = result.error
  ] else [
    test.passed = true
    test.error = nil
  ]
  
  [
    name = test.name
    passed = test.passed
    error = test.error
    elapsed = elapsed
  ]
]

# Try to execute test with error handling
def try_execute_test(test_fn) [
  let try_result = test_fn()
  
  if try_result == nil || try_result == false [
    return [error = "Test assertion failed", value = nil]
  ]
  
  [error = nil, value = try_result]
]

# Assertion: Value is truthy
def assert(condition, message) [
  if !condition [
    print("  ❌ Assertion failed: " + message)
    return false
  ]
  
  true
]

# Assertion: Values are equal
def assert_equal(expected, actual, message) [
  if expected != actual [
    print("  ❌ Expected " + expected + ", got " + actual + ": " + message)
    return false
  ]
  
  true
]

# Assertion: Value is in list
def assert_includes(list, value, message) [
  let found = false
  list.each(fn(item) [
    if item == value [let found = true]
  ])
  
  if !found [
    print("  ❌ Expected list to include " + value + ": " + message)
    return false
  ]
  
  true
]

# Assertion: Value is nil
def assert_nil(value, message) [
  if value != nil [
    print("  ❌ Expected nil, got " + value + ": " + message)
    return false
  ]
  
  true
]

# Assertion: Value is not nil
def assert_not_nil(value, message) [
  if value == nil [
    print("  ❌ Expected non-nil value: " + message)
    return false
  ]
  
  true
]

# Print test summary
def print_test_summary(runner) [
  let total = runner.tests_run
  let passed = runner.tests_passed
  let failed = runner.tests_failed
  
  print("")
  print("=" * 50)
  print("TEST SUMMARY")
  print("=" * 50)
  print("Total:  " + total)
  print("✅ Passed: " + passed)
  print("❌ Failed: " + failed)
  
  if failed == 0 [
    print("")
    print("🎉 ALL TESTS PASSED!")
  ] else [
    print("")
    print("❌ SOME TESTS FAILED")
  ]
  
  print("=" * 50)
  print("")
]

# Helper: Get current time (milliseconds)
