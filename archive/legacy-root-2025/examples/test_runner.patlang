# Helper: Repeat string
def repeat_string(str, count) [
  let result = ""
  let i = 0
  while i < count [
    result = result + str
    let i = i + 1
  ]
  result
]

# Test coverage report
def generate_coverage_report(runner) [
  print("")
  print("Test Coverage Report:")
  print("=====================")
  
  runner.test_results.each(fn(result) [
    let status_icon = if result.status == "PASS" then "✅" else "❌"
    print(status_icon + " " + result.file)
    print("   Passed: " + result.passed + ", Failed: " + result.failed)
    print("   Time: " + result.elapsed + "ms")
  ])
]

# Performance analysis
def analyze_test_performance(runner) [
  let slowest = nil
  let slowest_time = 0
  
  runner.test_results.each(fn(result) [
    if result.elapsed > slowest_time [
      let slowest = result
      let slowest_time = result.elapsed
    ]
  ])
  
  if slowest != nil [
    print("Slowest test: " + slowest.file + " (" + slowest_time + "ms)")
  ]
]

# Main: Run tests from command line
def main(args) [
  let test_dir = "tests"
  
  if args.length > 0 [
    let test_dir = args[0]
  ]
  
  let runner = run_all_tests(test_dir)
  
  if runner.tests_failed == 0 [
    return 0
  ] else [
    return 1
  ]
]
