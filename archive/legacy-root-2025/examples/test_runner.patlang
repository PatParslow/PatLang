# Phase 4.5: Test Runner - Automated Test Framework
# Discovers and runs PaTLang test files, reports results

def make_test_runner [] [
  let runner = [
    tests_run = 0
    tests_passed = 0
    tests_failed = 0
    test_results = []
    start_time = current_time()
  ]
  runner
]

# Run all tests in a directory
def run_all_tests(test_dir) [
  let runner = make_test_runner()
  
  print("=== PaTLang Test Runner ===")
  print("Scanning for test files in: " + test_dir)
  print("")
  
  let test_files = discover_test_files(test_dir)
  
  if test_files.length == 0 [
    print("No test files found (looking for *_test.patlang)")
    return runner
  ]
  
  print("Found " + test_files.length + " test file(s)")
  print("")
  
  # Run each test file
  test_files.each(fn(file) [
    run_test_file(file, runner)
  ])
  
  print_test_summary(runner)
  
  runner
]

