# Run a single test file
def run_test_file(file_path, runner) [
  print("Running: " + file_path)
  
  let file_start = current_time()
  let result = load_and_run_tests(file_path)
  let file_elapsed = current_time() - file_start
  
  if result.error != nil [
    print("  ❌ Error: " + result.error)
    runner.tests_failed = runner.tests_failed + 1
    runner.test_results.append([
      file = file_path
      passed = 0
      failed = 1
      elapsed = file_elapsed
      status = "ERROR"
    ])
    return
  ]
  
  let passed = result.passed
  let failed = result.failed
  
  runner.tests_run = runner.tests_run + passed + failed
  runner.tests_passed = runner.tests_passed + passed
  runner.tests_failed = runner.tests_failed + failed
  
  if failed == 0 [
    print("  ✅ " + passed + " tests passed (" + file_elapsed + "ms)")
  ] else [
    print("  ❌ " + passed + " passed, " + failed + " failed (" + file_elapsed + "ms)")
  ]
  
  runner.test_results.append([
    file = file_path
    passed = passed
    failed = failed
    elapsed = file_elapsed
    status = if failed == 0 then "PASS" else "FAIL"
  ])
]

