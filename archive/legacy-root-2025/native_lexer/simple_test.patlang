# Simple test of native lexer components
# Test basic functionality without full test suite

# Test token creation
token = create_token("NUMBER", "123", 1, 1, 0)
result1 = token.type = "NUMBER"

# Test character classification
result2 = is_digit("5")
result3 = is_letter("a")

# Test simple number validation
result4 = is_valid_number("123")
result5 = is_valid_number("45.67")

# Test identifier validation
result6 = is_valid_identifier("hello")
result7 = is_valid_identifier("_private")

# Display results
"Token creation: " + result1
"Digit test: " + result2
"Letter test: " + result3
"Number test: " + result4
"Decimal test: " + result5
"Identifier test: " + result6
"Private identifier test: " + result7