# =============================================================================
# NATIVE PATLANG LEXER - CORE TOKEN SYSTEM
# Phase 1: Foundation Components
# =============================================================================

# Token type definitions using PaTLang constraints
# Based on the 87 distinct token types identified in Ruby lexer analysis

# Arithmetic and basic operation tokens
constrain arithmetic_token :: String where 
    arithmetic_token in ["NUMBER", "PLUS", "MINUS", "MULTIPLY", "DIVIDE", "MODULO"]

constrain grouping_token :: String where
    grouping_token in ["LPAREN", "RPAREN", "LBRACE", "RBRACE", "LBRACKET", "RBRACKET"]

# Natural language tokens for PaTLang's unique syntax
constrain natural_language_token :: String where
    natural_language_token in ["MAKE", "A", "FUNCTION", "CALLED", "IS", "TAKES", "RETURNS", "CALL", "WITH"]

# Reasoning system tokens  
constrain reasoning_token :: String where
    reasoning_token in ["REASONING", "MODE", "ON", "OFF", "FACT", "RULE", "GOAL", "PURSUE"]

constrain logic_token :: String where
    logic_token in ["QUERY", "WHERE", "AND", "OR", "NOT"]

constrain constraint_token :: String where
    constraint_token in ["CONSTRAIN", "ASSERT", "PRECONDITION", "POSTCONDITION"]

# Control flow tokens
constrain control_flow_token :: String where
    control_flow_token in ["IF", "THEN", "ELSE", "END", "WHILE", "DO"]

# Data type tokens
constrain data_token :: String where
    data_token in ["STRING", "IDENTIFIER", "TRUE", "FALSE", "DOT"]

# Function and method call tokens
constrain function_call_token :: String where
    function_call_token in ["CALL", "WITH", "DOT"]

# Special tokens
constrain special_token :: String where
    special_token in ["EOF", "UNKNOWN", "AMBIGUOUS", "UNTERMINATED_STRING"]

# =============================================================================
# TOKEN DATA STRUCTURE
# =============================================================================

# Core token structure with position tracking and context
constrain patlang_token :: PaTLangToken where
    patlang_token.type :: String and
    patlang_token.value :: String and
    patlang_token.line :: Number where line >= 1 and
    patlang_token.column :: Number where column >= 1 and
    patlang_token.absolute :: Number where absolute >= 0

# Position tracking structure
constrain position :: Position where
    position.line :: Number where line >= 1 and
    position.column :: Number where column >= 1 and
    position.absolute :: Number where absolute >= 0

# =============================================================================
# TOKEN CREATION FUNCTIONS
# =============================================================================

# Create a basic token with position information
make a function called create_token takes token_type, token_value, pos_line, pos_column, pos_absolute returns token
    token = {
        type: token_type,
        value: token_value,
        line: pos_line,
        column: pos_column,
        absolute: pos_absolute
    }
end

# Create a position object
make a function called create_position takes line_num, col_num, absolute_pos returns position
    position = {
        line: line_num,
        column: col_num,
        absolute: absolute_pos
    }
end

# Create an EOF token
make a function called create_eof_token takes position returns eof_token
    eof_token = create_token("EOF", "", position.line, position.column, position.absolute)
end

# Create an unknown token for unrecognized input
make a function called create_unknown_token takes unknown_text, position returns unknown_token
    unknown_token = create_token("UNKNOWN", unknown_text, position.line, position.column, position.absolute)
end

# =============================================================================
# TOKEN CLASSIFICATION FACTS
# =============================================================================

# Enable reasoning mode for token classification
reasoning mode on

# Token category facts for organization
fact token_category("NUMBER", "literal")
fact token_category("STRING", "literal")
fact token_category("IDENTIFIER", "symbolic")
fact token_category("TRUE", "boolean")
fact token_category("FALSE", "boolean")

fact token_category("PLUS", "arithmetic")
fact token_category("MINUS", "arithmetic") 
fact token_category("MULTIPLY", "arithmetic")
fact token_category("DIVIDE", "arithmetic")
fact token_category("MODULO", "arithmetic")

fact token_category("LPAREN", "grouping")
fact token_category("RPAREN", "grouping")
fact token_category("LBRACE", "grouping")
fact token_category("RBRACE", "grouping")
fact token_category("LBRACKET", "grouping")
fact token_category("RBRACKET", "grouping")

fact token_category("IF", "control_flow")
fact token_category("THEN", "control_flow")
fact token_category("ELSE", "control_flow")
fact token_category("END", "control_flow")
fact token_category("WHILE", "control_flow")
fact token_category("DO", "control_flow")

fact token_category("MAKE", "natural_language")
fact token_category("A", "natural_language")
fact token_category("FUNCTION", "natural_language")
fact token_category("CALLED", "natural_language")
fact token_category("IS", "natural_language")
fact token_category("TAKES", "natural_language")
fact token_category("RETURNS", "natural_language")

fact token_category("REASONING", "meta_control")
fact token_category("MODE", "meta_control")
fact token_category("ON", "meta_control")
fact token_category("OFF", "meta_control")
fact token_category("FACT", "logic_programming")
fact token_category("RULE", "logic_programming")
fact token_category("GOAL", "goal_oriented")
fact token_category("PURSUE", "goal_oriented")

# =============================================================================
# TOKEN VALIDATION RULES
# =============================================================================

# Rule to check if a token type is valid
rule valid_token_type(token_type) :-
    token_category(token_type, _).

# Rule to check if a token is complete
rule token_complete(token) :-
    token.type != nil,
    token.value != nil,
    token.line >= 1,
    token.column >= 1,
    token.absolute >= 0.

# Rule to identify literal tokens
rule is_literal_token(token) :-
    token_category(token.type, "literal").

# Rule to identify operator tokens
rule is_operator_token(token) :-
    token_category(token.type, "arithmetic").

# Rule to identify grouping tokens
rule is_grouping_token(token) :-
    token_category(token.type, "grouping").

# =============================================================================
# TOKEN STREAM MANAGEMENT
# =============================================================================

# Initialize empty token stream
token_stream = []

# Add token to stream
make a function called add_to_stream takes token returns success
    token_stream = token_stream + [token]
    success = true
end

# Get current stream length
make a function called stream_length returns length
    length = token_stream.length
end

# Get token at index
make a function called get_token_at takes index returns token
    if index >= 0 and index < token_stream.length then
        token = token_stream[index]
    else
        token = nil
    end
end