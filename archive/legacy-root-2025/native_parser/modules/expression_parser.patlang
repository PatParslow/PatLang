# Expression Parser - Arithmetic and logical expression parsing
# Precedence-based expression parsing with PaTLang reasoning

# Expression parsing goals
goal parse_expression(tokens, position, context) {
    precondition: position < tokens.length and tokens[position].type in expression_starters,
    postcondition: result.type in expression_types and result.valid == true,
    strategy: precedence_climbing_with_reasoning
}

goal parse_binary_expression(left_expr, operator_token, tokens, position) {
    precondition: left_expr.valid == true and is_binary_operator(operator_token.value),
    postcondition: result.type == "BinaryOperation" and result.left == left_expr,
    strategy: operator_precedence_parsing
}

goal parse_unary_expression(tokens, position) {
    precondition: tokens[position].type in unary_operators,
    postcondition: result.type == "UnaryOperation" and result.operator != null,
    strategy: unary_operator_parsing
}

# Expression type classification
fact expression_starters(["NUMBER", "STRING", "TRUE", "FALSE", "IDENTIFIER", "LPAREN", "NOT", "MINUS"])
fact expression_types(["BinaryOperation", "UnaryOperation", "Literal", "Identifier", "FunctionCall", "ParenthesizedExpression"])
fact binary_operators(["+", "-", "*", "/", "%", "==", "!=", "<", ">", "<=", ">=", "and", "or"])
fact unary_operators(["NOT", "MINUS"])
fact primary_expression_types(["NUMBER", "STRING", "TRUE", "FALSE", "IDENTIFIER"])

# Precedence climbing algorithm implementation
rule parse_expression_with_precedence(tokens, position, min_precedence, result) :-
    parse_primary_expression(tokens, position, primary_result),
    parse_binary_operations_with_precedence(tokens, primary_result.end_position, 
                                           primary_result.ast_node, min_precedence, result).

rule parse_binary_operations_with_precedence(tokens, position, left_expr, min_precedence, result) :-
    position >= tokens.length,
    result = {
        success: true,
        ast_node: left_expr,
        end_position: position
    }.

rule parse_binary_operations_with_precedence(tokens, position, left_expr, min_precedence, result) :-
    position < tokens.length,
    current_token = tokens[position],
    not is_binary_operator(current_token.value),
    result = {
        success: true,
        ast_node: left_expr,
        end_position: position
    }.

rule parse_binary_operations_with_precedence(tokens, position, left_expr, min_precedence, result) :-
    position < tokens.length,
    current_token = tokens[position],
    is_binary_operator(current_token.value),
    operator_precedence(current_token.value, op_precedence),
    op_precedence < min_precedence,
    result = {
        success: true,
        ast_node: left_expr,
        end_position: position
    }.

rule parse_binary_operations_with_precedence(tokens, position, left_expr, min_precedence, result) :-
    position < tokens.length,
    current_token = tokens[position],
    is_binary_operator(current_token.value),
    operator_precedence(current_token.value, op_precedence),
    op_precedence >= min_precedence,
    calculate_right_min_precedence(current_token.value, op_precedence, right_min_prec),
    parse_expression_with_precedence(tokens, position + 1, right_min_prec, right_result),
    create_binary_operation_node(left_expr, current_token, right_result.ast_node, binary_node),
    parse_binary_operations_with_precedence(tokens, right_result.end_position, 
                                           binary_node, min_precedence, result).

# Primary expression parsing
rule parse_primary_expression(tokens, position, result) :-
    position < tokens.length,
    current_token = tokens[position],
    parse_primary_by_type(current_token, tokens, position, result).

rule parse_primary_by_type(token, tokens, position, result) :-
    token.type == "NUMBER",
    create_number_literal_node(token, number_node),
    result = {
        success: true,
        ast_node: number_node,
        end_position: position + 1
    }.

rule parse_primary_by_type(token, tokens, position, result) :-
    token.type == "STRING",
    create_string_literal_node(token, string_node),
    result = {
        success: true,
        ast_node: string_node,
        end_position: position + 1
    }.

rule parse_primary_by_type(token, tokens, position, result) :-
    token.type in ["TRUE", "FALSE"],
    create_boolean_literal_node(token, boolean_node),
    result = {
        success: true,
        ast_node: boolean_node,
        end_position: position + 1
    }.

rule parse_primary_by_type(token, tokens, position, result) :-
    token.type == "IDENTIFIER",
    parse_identifier_or_function_call(tokens, position, result).

rule parse_primary_by_type(token, tokens, position, result) :-
    token.type == "LPAREN",
    parse_parenthesized_expression(tokens, position, result).

rule parse_primary_by_type(token, tokens, position, result) :-
    token.type in unary_operators,
    parse_unary_operation(tokens, position, result).

# Identifier and function call disambiguation
rule parse_identifier_or_function_call(tokens, position, result) :-
    position + 1 < tokens.length,
    tokens[position + 1].type == "LPAREN",
    parse_function_call_expression(tokens, position, result).

rule parse_identifier_or_function_call(tokens, position, result) :-
    position + 1 >= tokens.length,
    create_identifier_node(tokens[position], identifier_node),
    result = {
        success: true,
        ast_node: identifier_node,
        end_position: position + 1
    }.

rule parse_identifier_or_function_call(tokens, position, result) :-
    position + 1 < tokens.length,
    tokens[position + 1].type != "LPAREN",
    create_identifier_node(tokens[position], identifier_node),
    result = {
        success: true,
        ast_node: identifier_node,
        end_position: position + 1
    }.

# Function call expression parsing
rule parse_function_call_expression(tokens, position, result) :-
    function_name_token = tokens[position],
    # Expect LPAREN at position + 1
    parse_argument_list(tokens, position + 2, args_result),
    # Expect RPAREN after arguments
    position + 2 + args_result.tokens_consumed < tokens.length,
    tokens[position + 2 + args_result.tokens_consumed].type == "RPAREN",
    create_function_call_node(function_name_token, args_result.arguments, function_call_node),
    result = {
        success: true,
        ast_node: function_call_node,
        end_position: position + 2 + args_result.tokens_consumed + 1
    }.

rule parse_argument_list(tokens, position, result) :-
    position >= tokens.length,
    result = {
        arguments: [],
        tokens_consumed: 0
    }.

rule parse_argument_list(tokens, position, result) :-
    position < tokens.length,
    tokens[position].type == "RPAREN",
    result = {
        arguments: [],
        tokens_consumed: 0
    }.

rule parse_argument_list(tokens, position, result) :-
    position < tokens.length,
    tokens[position].type != "RPAREN",
    parse_expression_list(tokens, position, expr_list_result),
    result = {
        arguments: expr_list_result.expressions,
        tokens_consumed: expr_list_result.tokens_consumed
    }.

rule parse_expression_list(tokens, position, result) :-
    parse_expression_with_precedence(tokens, position, 0, first_expr),
    parse_remaining_expressions(tokens, first_expr.end_position, [first_expr.ast_node], result).

rule parse_remaining_expressions(tokens, position, accumulated_exprs, result) :-
    position >= tokens.length,
    result = {
        expressions: accumulated_exprs,
        tokens_consumed: position - start_position
    }.

rule parse_remaining_expressions(tokens, position, accumulated_exprs, result) :-
    position < tokens.length,
    tokens[position].type != "COMMA",
    result = {
        expressions: accumulated_exprs,
        tokens_consumed: position - start_position
    }.

rule parse_remaining_expressions(tokens, position, accumulated_exprs, result) :-
    position < tokens.length,
    tokens[position].type == "COMMA",
    parse_expression_with_precedence(tokens, position + 1, 0, next_expr),
    parse_remaining_expressions(tokens, next_expr.end_position, 
                               accumulated_exprs + [next_expr.ast_node], result).

# Parenthesized expression parsing
rule parse_parenthesized_expression(tokens, position, result) :-
    tokens[position].type == "LPAREN",
    parse_expression_with_precedence(tokens, position + 1, 0, inner_expr),
    inner_expr.end_position < tokens.length,
    tokens[inner_expr.end_position].type == "RPAREN",
    create_parenthesized_expression_node(inner_expr.ast_node, paren_node),
    result = {
        success: true,
        ast_node: paren_node,
        end_position: inner_expr.end_position + 1
    }.

# Unary operation parsing
rule parse_unary_operation(tokens, position, result) :-
    operator_token = tokens[position],
    parse_expression_with_precedence(tokens, position + 1, unary_precedence, operand_result),
    create_unary_operation_node(operator_token, operand_result.ast_node, unary_node),
    result = {
        success: true,
        ast_node: unary_node,
        end_position: operand_result.end_position
    }.

# Operator precedence and associativity handling
rule calculate_right_min_precedence(operator, left_precedence, right_min_precedence) :-
    operator_associativity(operator, "left"),
    right_min_precedence = left_precedence + 1.

rule calculate_right_min_precedence(operator, left_precedence, right_min_precedence) :-
    operator_associativity(operator, "right"),
    right_min_precedence = left_precedence.

# Precedence and associativity facts (inherited from grammar_engine)
fact operator_precedence("or", 1)
fact operator_precedence("and", 2)
fact operator_precedence("==", 3)
fact operator_precedence("!=", 3)
fact operator_precedence("<", 4)
fact operator_precedence(">", 4)
fact operator_precedence("<=", 4)
fact operator_precedence(">=", 4)
fact operator_precedence("+", 5)
fact operator_precedence("-", 5)
fact operator_precedence("*", 6)
fact operator_precedence("/", 6)
fact operator_precedence("%", 6)
fact unary_precedence(7)

fact operator_associativity("or", "left")
fact operator_associativity("and", "left")
fact operator_associativity("==", "left")
fact operator_associativity("!=", "left")
fact operator_associativity("<", "left")
fact operator_associativity(">", "left")
fact operator_associativity("<=", "left")
fact operator_associativity(">=", "left")
fact operator_associativity("+", "left")
fact operator_associativity("-", "left")
fact operator_associativity("*", "left")
fact operator_associativity("/", "left")
fact operator_associativity("%", "left")

# AST node creation helpers
rule create_number_literal_node(token, node) :-
    node = {
        type: "Literal",
        literal_type: "Number",
        value: parse_number(token.value),
        source_location: token.position
    }.

rule create_string_literal_node(token, node) :-
    node = {
        type: "Literal",
        literal_type: "String",
        value: token.value,
        source_location: token.position
    }.

rule create_boolean_literal_node(token, node) :-
    node = {
        type: "Literal",
        literal_type: "Boolean",
        value: (token.value == "true"),
        source_location: token.position
    }.

rule create_identifier_node(token, node) :-
    node = {
        type: "Identifier",
        name: token.value,
        source_location: token.position
    }.

rule create_binary_operation_node(left, operator_token, right, node) :-
    node = {
        type: "BinaryOperation",
        operator: operator_token.value,
        left: left,
        right: right,
        source_location: merge_source_locations([left.source_location, right.source_location])
    }.

rule create_unary_operation_node(operator_token, operand, node) :-
    node = {
        type: "UnaryOperation",
        operator: operator_token.value,
        operand: operand,
        source_location: operator_token.position
    }.

rule create_function_call_node(name_token, arguments, node) :-
    node = {
        type: "FunctionCall",
        function_name: name_token.value,
        arguments: arguments,
        source_location: name_token.position
    }.

rule create_parenthesized_expression_node(inner_expression, node) :-
    node = {
        type: "ParenthesizedExpression",
        expression: inner_expression,
        source_location: inner_expression.source_location
    }.

# Expression validation
rule validate_expression_semantics(expr_node, context, validation_result) :-
    expr_node.type == "BinaryOperation",
    validate_binary_operation(expr_node, context, validation_result).

rule validate_expression_semantics(expr_node, context, validation_result) :-
    expr_node.type == "UnaryOperation",
    validate_unary_operation(expr_node, context, validation_result).

rule validate_expression_semantics(expr_node, context, validation_result) :-
    expr_node.type == "FunctionCall",
    validate_function_call(expr_node, context, validation_result).

rule validate_expression_semantics(expr_node, context, validation_result) :-
    expr_node.type == "Identifier",
    validate_identifier_reference(expr_node, context, validation_result).

# Utility predicates
rule is_binary_operator(op) :- op in binary_operators.
rule is_unary_operator(op) :- op in unary_operators.
rule parse_number(number_string, result) :- convert_to_number(number_string, result).

# Missing utility functions for expression parsing
rule merge_source_locations(locations, merged_location) :-
    locations != [],
    first_location = locations[0],
    last_location = locations[locations.length - 1],
    merged_location = {
        line: first_location.line,
        column: first_location.column,
        absolute_position: first_location.absolute_position,
        end_line: last_location.line,
        end_column: last_location.column,
        filename: first_location.filename
    }.

rule convert_to_number(number_string, result) :-
    # Simple number parsing - can be enhanced with proper parsing logic
    result = parse_float(number_string).

# Enhanced validation functions
rule validate_binary_operation(node, context, validation_result) :-
    validate_operand(node.left),
    validate_operand(node.right),
    operator_supports_operands(node.operator, node.left, node.right),
    validation_result = {valid: true, node: node}.

rule validate_unary_operation(node, context, validation_result) :-
    validate_operand(node.operand),
    unary_operator_supports_operand(node.operator, node.operand),
    validation_result = {valid: true, node: node}.

rule validate_function_call(node, context, validation_result) :-
    function_exists_in_context(node.function_name, context, function_info),
    validate_argument_count_match(node.arguments, function_info.parameter_count),
    validation_result = {valid: true, node: node, function_info: function_info}.

rule validate_identifier_reference(node, context, validation_result) :-
    identifier_in_scope(node.name, context),
    validation_result = {valid: true, node: node}.

# Context checking predicates
rule function_exists_in_context(function_name, context, function_info) :-
    context.function_declarations != null,
    member(function_info, context.function_declarations),
    function_info.name == function_name.

rule identifier_in_scope(identifier_name, context) :-
    context.variable_declarations != null,
    member(var_decl, context.variable_declarations),
    var_decl.name == identifier_name.

rule identifier_in_scope(identifier_name, context) :-
    function_exists_in_context(identifier_name, context, _).

rule validate_argument_count_match(arguments, expected_count) :-
    arguments.length == expected_count.

# Operator compatibility checking
rule operator_supports_operands(operator, left_operand, right_operand) :-
    operator in ["+", "-", "*", "/", "%"],
    numeric_compatible(left_operand),
    numeric_compatible(right_operand).

rule operator_supports_operands(operator, left_operand, right_operand) :-
    operator in ["==", "!="],
    # Equality operators work with any compatible types
    true.

rule operator_supports_operands(operator, left_operand, right_operand) :-
    operator in ["<", ">", "<=", ">="],
    comparable_types(left_operand, right_operand).

rule operator_supports_operands(operator, left_operand, right_operand) :-
    operator in ["and", "or"],
    boolean_compatible(left_operand),
    boolean_compatible(right_operand).

rule unary_operator_supports_operand(operator, operand) :-
    operator == "not",
    boolean_compatible(operand).

rule unary_operator_supports_operand(operator, operand) :-
    operator == "-",
    numeric_compatible(operand).

# Type compatibility predicates
rule numeric_compatible(node) :-
    node.type == "Literal",
    node.literal_type in ["Number", "Integer", "Float"].

rule boolean_compatible(node) :-
    node.type == "Literal",
    node.literal_type == "Boolean".

rule comparable_types(left, right) :-
    numeric_compatible(left),
    numeric_compatible(right).

rule comparable_types(left, right) :-
    left.type == "Literal",
    right.type == "Literal",
    left.literal_type == right.literal_type.

# Expression parsing statistics
fact expressions_parsed(0)
fact binary_operations_parsed(0)
fact function_calls_parsed(0)

rule track_expression_parsing(expr_type) :-
    expressions_parsed = expressions_parsed + 1,
    (expr_type == "BinaryOperation" -> binary_operations_parsed = binary_operations_parsed + 1 ; true),
    (expr_type == "FunctionCall" -> function_calls_parsed = function_calls_parsed + 1 ; true).

# Expression parser initialization
initialize_expression_parser() {
    print("Expression Parser initialized"),
    print("Precedence climbing algorithm ready"),
    print("Binary and unary operations supported")
end