# Advanced Control Flow Tests - For loops, Pattern Matching, Try/Catch/Finally, Non-local Returns
print("DIAG: Entering file: advanced_control_flow_tests.patlang")

# Test suite initialization
goal run_advanced_control_flow_tests() {
    precondition: test_environment_ready == true,
    postcondition: all_advanced_tests_completed == true and test_results.recorded == true,
    strategy: advanced_control_flow_testing
}

# --- For Loops ---

rule test_for_loop_basic_iteration() :-
    result = [],
    for i in 1..5 {
        result.append(i)
    },
    assert_equal(result, [1,2,3,4,5]),
    record_test_result("for_loop_basic_iteration", "passed").

rule test_for_loop_variable_scope() :-
    for i in 1..3 {
        inner = i * 2
    },
    assert_undefined(inner),
    record_test_result("for_loop_variable_scope", "passed").

rule test_for_loop_nested() :-
    result = [],
    for i in 1..2 {
        for j in 1..2 {
            result.append(i * 10 + j)
        }
    },
    assert_equal(result, [11,12,21,22]),
    record_test_result("for_loop_nested", "passed").

# --- Pattern Matching ---

rule test_pattern_match_simple() :-
    x = 2,
    match x {
        1 => y = "one",
        2 => y = "two",
        _ => y = "other"
    },
    assert_equal(y, "two"),
    record_test_result("pattern_match_simple", "passed").

rule test_pattern_match_nested() :-
    value = [1, [2, 3]],
    match value {
        [1, [2, x]] => y = x,
        _ => y = 0
    },
    assert_equal(y, 3),
    record_test_result("pattern_match_nested", "passed").

rule test_pattern_match_fallthrough() :-
    x = 3,
    match x {
        1 => y = "one",
        2 => y = "two",
        _ => y = "default"
    },
    assert_equal(y, "default"),
    record_test_result("pattern_match_fallthrough", "passed").

# --- Try/Catch/Finally ---

rule test_try_catch_basic() :-
    x = 0,
    try {
        x = 1 / 0
    } catch e {
        x = "caught"
    },
    assert_equal(x, "caught"),
    record_test_result("try_catch_basic", "passed").

rule test_try_catch_finally_execution() :-
    log = [],
    try {
        log.append("try")
        raise "fail"
    } catch e {
        log.append("catch")
    } finally {
        log.append("finally")
    },
    assert_equal(log, ["try", "catch", "finally"]),
    record_test_result("try_catch_finally_execution", "passed").

rule test_try_finally_without_exception() :-
    x = 1,
    try {
        x = x + 1
    } finally {
        x = x * 10
    },
    assert_equal(x, 20),
    record_test_result("try_finally_without_exception", "passed").

# --- Non-local Returns (break, continue, return) ---

rule test_for_loop_break() :-
    result = [],
    for i in 1..5 {
        if i == 3 {
            break
        }
        result.append(i)
    },
    assert_equal(result, [1,2]),
    record_test_result("for_loop_break", "passed").

rule test_for_loop_continue() :-
    result = [],
    for i in 1..5 {
        if i % 2 == 0 {
            continue
        }
        result.append(i)
    },
    assert_equal(result, [1,3,5]),
    record_test_result("for_loop_continue", "passed").

rule test_return_in_function() :-
    fun foo() {
        return 42
        unreachable = true
    },
    x = foo(),
    assert_equal(x, 42),
    record_test_result("return_in_function", "passed").

rule test_break_outside_loop_error() :-
    try {
        break
    } catch e {
        assert_contains(e.message, "not inside a loop")
    },
    record_test_result("break_outside_loop_error", "passed").