# Event-Driven Programming Tests

event on_data_received(data).
event on_error(error).

handler on_data_received(data) :-
    print("Data received: " + data).

handler on_error(error) :-
    print("Error: " + error).

emit on_data_received("42").
emit on_error("File not found").

# Async event test
event on_async_complete().
handler on_async_complete() :-
    print("Async complete!").

emit on_async_complete().