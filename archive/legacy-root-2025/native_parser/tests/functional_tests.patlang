# Functional Programming Tests

# First-class and higher-order functions
fn add(a, b) { a + b }
fn apply(f, x, y) { f(x, y) }

result1 = apply(add, 2, 3)

# Recursion
fn factorial(n) {
    if n <= 1 { 1 }
    else { n * factorial(n - 1) }
}

result2 = factorial(5)

# Lambdas and closures
fn make_adder(x) {
    fn adder(y) { x + y }
    adder
}

add5 = make_adder(5)
result3 = add5(10)
# Test: Variable assignment in both branches of if/else is visible after the conditional

test "if/else assignment scoping" {
  if true then
    result = 42
  else
    result = 99
  end
  assert(result == 42)
}

test "if/else assignment scoping (else branch)" {
  if false then
    result = 42
  else
    result = 99
  end
  assert(result == 99)
}

test "if/else assignment scoping (different variables)" {
  if true then
    a = 1
  else
    b = 2
  end
  # Both a and b should be defined, but only one assigned
  assert(a == 1 or b == 2)
}