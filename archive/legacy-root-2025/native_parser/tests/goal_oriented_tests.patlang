# Goal-Oriented Programming Tests

goal achieve_target() {
    precondition: true,
    postcondition: target_achieved == true,
    strategy: direct
}

rule achieve_target(result) :-
    print("Goal achieved!"),
    result = { status: "PASSED" }.

goal fallback_goal() {
    precondition: false,
    postcondition: fallback_used == true,
    strategy: fallback
}

rule fallback_goal(result) :-
    print("Fallback goal executed."),
    result = { status: "PASSED" }.