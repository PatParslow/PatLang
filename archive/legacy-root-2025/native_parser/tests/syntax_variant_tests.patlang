# Syntax Variant Tests

# Block delimiters: begin/end
fn sum(a, b) begin
    result = a + b
    return result
end

# Block delimiters: braces
fn product(a, b) {
    result = a * b
    return result
}

# Function definition: arrow syntax
fn double(x) => x * 2

# Comments and whitespace
# This is a comment
fn noop() { }

# Semicolon as statement separator
x = 1; y = 2; z = x + y;