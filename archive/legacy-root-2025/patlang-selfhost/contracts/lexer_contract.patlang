# Contract for Lexer module (method-level)

contract Lexer {
	# Tokenize a full source string into a stream of tokens
	method tokenize(source: String): TokenStream | LexerError {
		requires: source != null
		ensures: (result is TokenStream) xor (result is LexerError)
		ensures: if result is TokenStream then tokens_cover_input(result, source)
		invariant: if result is TokenStream then non_overlapping_ordered_spans(result)
		diagnostics: optional list[Diagnostic]
	}

	# Produce the next token given a lexer state
	method next_token(state: LexerState): (Token | LexerError, LexerState) {
		requires: state.input != null and 0 <= state.pos <= len(state.input)
		ensures: (next is Token) xor (next is LexerError)
		ensures: state'.pos >= state.pos
	}

	# Utility predicates (conceptual; must hold in implementation)
	predicate tokens_cover_input(tokens: TokenStream, source: String): Bool
	predicate non_overlapping_ordered_spans(tokens: TokenStream): Bool
}
