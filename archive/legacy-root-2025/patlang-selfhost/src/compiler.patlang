# Compiler module for Patlang
# Translates IR to executable bytecode/native form, contract-driven

contract Compiler {
  # Bytecode instruction type (compatible with Interpreter)
  datatype BytecodeInstr =
    | BCConst(value: Any)
    | BCLoadLocal(name: String)
    | BCStoreLocal(name: String)
    | BCBinOp(op: BinOpKind)
    | BCUnOp(op: UnOpKind)
    | BCInclude(path: String)
    | BCFunctionDef(name: String, params: List[String], body: List[BytecodeInstr])
    | BCCall(name: String, argc: Number)
    | BCReturn
    # Control flow
    | BCIf(cond: List[BytecodeInstr], then_body: List[BytecodeInstr], else_body: List[BytecodeInstr])
    | BCWhile(cond: List[BytecodeInstr], body: List[BytecodeInstr])
    # Error handling
    | BCThrow(error: Any)
    | BCTryCatch(try_body: List[BytecodeInstr], catch_var: String, catch_body: List[BytecodeInstr])

  # Bytecode is a list of bytecode instructions
  type Bytecode = List[BytecodeInstr]

  # Error type for compilation failures
  datatype CompileError =
    | InvalidIR(reason: String)
    | UnsupportedInstr(instr: Any)
    | InternalCompilerError(msg: String)

  # Compile IR to Bytecode
  method compile(ir: List[Instr]): (Bytecode | CompileError) {
    requires: ir != null and ir_is_well_formed(ir)
    ensures: (result is Bytecode) xor (result is CompileError)
    ensures: if result is Bytecode then bytecode_is_well_formed(result)
  }

  # Bytecode well-formedness predicate
  predicate bytecode_is_well_formed(bc: Bytecode): Bool
}

# Implementation of IR→Bytecode translation
impl Compiler {
  method compile(ir: List[Instr]): (Bytecode | CompileError) {
    if ir == null {
      return InvalidIR("IR is null")
    }
    if not ir_is_well_formed(ir) {
      return InvalidIR("IR is not well-formed")
    }
    let bytecode = []
    for instr in ir {
      match instr {
        Const(value) =>
          bytecode = bytecode ++ [BCConst(value)]
        LoadLocal(name) =>
          bytecode = bytecode ++ [BCLoadLocal(name)]
        StoreLocal(name) =>
          bytecode = bytecode ++ [BCStoreLocal(name)]
        Include(path) =>
          bytecode = bytecode ++ [BCInclude(path)]
        BinOp(op) =>
          bytecode = bytecode ++ [BCBinOp(op)]
        UnOp(op) =>
          bytecode = bytecode ++ [BCUnOp(op)]
        FunctionDef(name, params, body_ir) =>
          let body_bc = compile(body_ir)
          match body_bc {
            Bytecode b =>
              bytecode = bytecode ++ [BCFunctionDef(name, params, b)]
            CompileError err =>
              return err
          }
        Call(name, argc) =>
          bytecode = bytecode ++ [BCCall(name, argc)]
        Return =>
          bytecode = bytecode ++ [BCReturn]
        # Control flow
        If(cond_ir, then_ir, else_ir) =>
          let cond_bc = compile(cond_ir)
          let then_bc = compile(then_ir)
          let else_bc = compile(else_ir)
          match (cond_bc, then_bc, else_bc) {
            (Bytecode c, Bytecode t, Bytecode e) =>
              bytecode = bytecode ++ [BCIf(c, t, e)]
            (CompileError err, _, _) => return err
            (_, CompileError err, _) => return err
            (_, _, CompileError err) => return err
          }
        While(cond_ir, body_ir) =>
          let cond_bc = compile(cond_ir)
          let body_bc = compile(body_ir)
          match (cond_bc, body_bc) {
            (Bytecode c, Bytecode b) =>
              bytecode = bytecode ++ [BCWhile(c, b)]
            (CompileError err, _) => return err
            (_, CompileError err) => return err
          }
        # Error handling
        Throw(error) =>
          bytecode = bytecode ++ [BCThrow(error)]
        TryCatch(try_ir, catch_var, catch_ir) =>
          let try_bc = compile(try_ir)
          let catch_bc = compile(catch_ir)
          match (try_bc, catch_bc) {
            (Bytecode t, Bytecode c) =>
              bytecode = bytecode ++ [BCTryCatch(t, catch_var, c)]
            (CompileError err, _) => return err
            (_, CompileError err) => return err
          }
        _ =>
          return UnsupportedInstr(instr)
      }
    }
    if bytecode_is_well_formed(bytecode) {
      return bytecode
    } else {
      return InternalCompilerError("Generated bytecode is not well-formed")
    }
  }

  predicate bytecode_is_well_formed(bc: Bytecode): Bool {
    # For now, well-formed if all elements are BytecodeInstr
    for instr in bc {
      match instr {
        BCConst(_) | BCLoadLocal(_) | BCStoreLocal(_) | BCBinOp(_) | BCUnOp(_) | BCInclude(_)
        | BCFunctionDef(_, _, _) | BCCall(_, _) | BCReturn
        | BCIf(_, _, _) | BCWhile(_, _) | BCThrow(_) | BCTryCatch(_, _, _) => continue
        _ => return false
      }
    }
    return true
  }
}

# Helper: IR well-formedness predicate (delegates to IR module)
extern predicate ir_is_well_formed(ir: List[Instr]): Bool

# Import IR types for compatibility
extern datatype Instr
extern enum BinOpKind
extern enum UnOpKind