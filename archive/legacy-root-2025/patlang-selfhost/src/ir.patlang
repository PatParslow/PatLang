# IR module for Patlang
# Defines intermediate representation and contract-driven AST→IR translation

contract IR {
  # IR instruction type
  datatype Instr =
    | Const(value: Any)
    | LoadLocal(name: String)
    | StoreLocal(name: String)
    | BinOp(op: BinOpKind)
    | UnOp(op: UnOpKind)
    | FunctionDef(name: String, params: List[String], body: List[Instr])
    | Call(name: String, argc: Number)
    | Return
    # Control flow
    | If(cond: List[Instr], then_body: List[Instr], else_body: List[Instr])
    | While(cond: List[Instr], body: List[Instr])
    # Error handling
    | Throw(error: Any)
    | TryCatch(try_body: List[Instr], catch_var: String, catch_body: List[Instr])

  # Binary operator kinds
  enum BinOpKind {
    Add, Sub, Mul, Div, Mod,
    Eq, Ne, Lt, Le, Gt, Ge,
    And, Or
  }

  # Unary operator kinds
  enum UnOpKind {
    Neg, Not
  }

  # Translate AST node to IR instructions
  # Handles function definitions, calls, returns, control flow, and error handling
  method ast_to_ir(node: AST): (List[Instr] | IRTranslationError) {
    requires: node != null
    ensures: (result is List[Instr]) xor (result is IRTranslationError)
    ensures: if result is List[Instr] then ir_is_well_formed(result)
  }

  # IR well-formedness predicate
  predicate ir_is_well_formed(ir: List[Instr]): Bool

  # Error type for translation failures
  datatype IRTranslationError =
    | UnknownASTNode(node_type: String)
    | UnknownBinaryOperator(op: String)
    | UnknownUnaryOperator(op: String)
    | UnknownFunctionSignature(details: String)
    | UnknownControlFlow(details: String)
    | UnknownErrorHandling(details: String)
}

# Implementation of AST→IR translation
impl IR {
  method ast_to_ir(node: AST): (List[Instr] | IRTranslationError) {
    match node {
      NumberNode(value) =>
        [Const(value)]
      StringNode(value) =>
        [Const(value)]
      IncludeNode(path) =>
        [Include(path)]
      VariableNode(name) =>
        [LoadLocal(name)]
      AssignmentNode(name, expr) =>
        let expr_code = ast_to_ir(expr)
        match expr_code {
          List[Instr] instrs =>
            instrs ++ [StoreLocal(name)]
          IRTranslationError err =>
            err
        }
      BinaryOpNode(left, op, right) =>
        let left_code = ast_to_ir(left)
        let right_code = ast_to_ir(right)
        match (left_code, right_code, binop_to_ir(op)) {
          (List[Instr] l, List[Instr] r, Some(binop)) =>
            l ++ r ++ [BinOp(binop)]
          (_, _, None) =>
            UnknownBinaryOperator(op)
          (IRTranslationError err, _, _) =>
            err
          (_, IRTranslationError err, _) =>
            err
        }
      UnaryOpNode(op, operand) =>
        let operand_code = ast_to_ir(operand)
        match (operand_code, unop_to_ir(op)) {
          (List[Instr] instrs, Some(unop)) =>
            instrs ++ [UnOp(unop)]
          (_, None) =>
            UnknownUnaryOperator(op)
          (IRTranslationError err, _) =>
            err
        }
      _ =>
        UnknownASTNode(type_of(node))
    }
  }

  # Map AST binary operator string to BinOpKind
  method binop_to_ir(op: String): Option[BinOpKind] {
    match op {
      "+" => Some(Add)
      "-" => Some(Sub)
      "*" => Some(Mul)
      "/" => Some(Div)
      "%" => Some(Mod)
      "==" => Some(Eq)
      "!=" => Some(Ne)
      "<" => Some(Lt)
      "<=" => Some(Le)
      ">" => Some(Gt)
      ">=" => Some(Ge)
      "&&" => Some(And)
      "||" => Some(Or)
      _ => None
    }
  }

  # Map AST unary operator string to UnOpKind
  method unop_to_ir(op: String): Option[UnOpKind] {
    match op {
      "-" => Some(Neg)
      "!" => Some(Not)
      _ => None
    }
  }

  # IR well-formedness: all elements must be Instr
  predicate ir_is_well_formed(ir: List[Instr]): Bool {
    forall i in ir: i is Instr
  }
}