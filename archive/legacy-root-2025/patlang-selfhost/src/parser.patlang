# Parser module (scaffold)
# Implements parsing of tokens into AST/IR
# --- AST, Expr, and ParseError Types ---

constrain AST :: {
    type: String,
    body: Array[Expr]
}

constrain Expr :: {
    type: String,
    value: Any,
# --- Parser Implementation ---

object Parser {
    # Parse a full token stream into an AST
    method parse(tokens: TokenStream): (AST | ParseError) {
        # Precondition
        if tokens == null {
            return ParseError.new("TokenStream is null", {line: 0, column: 0, absolute: 0})
        }
        if tokens.tokens == null || tokens.tokens.length == 0 {
            return ParseError.new("TokenStream is empty", {line: 0, column: 0, absolute: 0})
        }

        # Main parsing logic (contract-driven, minimal example)
        let [ast, err] = parse_program(tokens.tokens, 0)
        if err != null {
            return err
        }
        if !ast_is_well_formed(ast) {
            return ParseError.new("AST is not well-formed", {line: 0, column: 0, absolute: 0})
        }
        return ast
    }

    # Parse a single expression (REPL/tests)
    method parse_expression(tokens: TokenStream): (Expr | ParseError, TokenStream) {
        if tokens == null {
            return (ParseError.new("TokenStream is null", {line: 0, column: 0, absolute: 0}), tokens)
        }
        if tokens.tokens == null || tokens.tokens.length == 0 {
            return (ParseError.new("TokenStream is empty", {line: 0, column: 0, absolute: 0}), tokens)
        }
        let [expr, next_idx, err] = parse_expr(tokens.tokens, 0)
        if err != null {
            return (err, tokens)
        }
        let remaining = {tokens: tokens.tokens.slice(next_idx)}
        return (expr, remaining)
    }
}

# --- Helper Functions ---

# Parse a program (sequence of expressions/statements)
function parse_program(tokens: Array[Token], idx: Number): (AST, ParseError) {
    let exprs = []
    let i = idx
    while i < tokens.length && tokens[i].type != "EOF" {
        let [expr, next_idx, err] = parse_expr(tokens, i)
        if err != null {
            return [null, err]
        }
        exprs.push(expr)
        i = next_idx
    }
    return [{type: "Program", body: exprs}, null]
}

# Parse a single expression (stub, extend for grammar)
function parse_expr(tokens: Array[Token], idx: Number): (Expr, Number, ParseError) {
    if idx >= tokens.length {
        return [null, idx, ParseError.new("Unexpected end of input", {line: 0, column: 0, absolute: 0})]
    }
    let token = tokens[idx]
    # Minimal contract support: contract Name { ... }
    if token.type == "IDENTIFIER" && token.value == "contract" {
        # Expect: contract <Identifier> { ... }
        let name_token = tokens[idx + 1]
        if name_token == null || name_token.type != "IDENTIFIER" {
            return [null, idx, ParseError.new("Expected contract name after 'contract'", token.position)]
        }
        # Skip body for minimal support: look for '{' ... '}'
        let body_start = idx + 2
        let brace_token = tokens[body_start]
        let body_end = body_start
        if brace_token != null && brace_token.type == "LBRACE" {
            # Find matching RBRACE (naive, does not handle nested)
            body_end = body_start + 1
            let brace_count = 1
            while body_end < tokens.length && brace_count > 0 {
                if tokens[body_end].type == "LBRACE" { brace_count += 1 }
                if tokens[body_end].type == "RBRACE" { brace_count -= 1 }
                body_end += 1
            }
        }
        return [
            {
                type: "Contract",
            },
            body_end,
            null
        ]
    }
    # --- Add support for include statement ---
    if token.type == "IDENTIFIER" && token.value == "include" {
        let path_token = tokens[idx + 1]
        if path_token == null || path_token.type != "STRING" {
            return [null, idx, ParseError.new("Expected string literal after 'include'", token.position)]
        }
        return [
            {
                type: "Include",
                value: path_token.value
            },
            idx + 2,
            null
        ]
    }
                value: name_token.value,
                children: [] # Minimal: ignore body
            },
            body_end,
            null
        ]
    }
    if token.type == "NUMBER" {
        return [{type: "NumberLiteral", value: token.value, children: []}, idx + 1, null]
    }
    if token.type == "IDENTIFIER" {
        return [{type: "Identifier", value: token.value, children: []}, idx + 1, null]
    }
    # Extend with more grammar rules as needed
    return [null, idx, ParseError.new("Unexpected token: " + token.type, token.position)]
}

# AST well-formedness predicate (stub, extend as needed)
function ast_is_well_formed(ast: AST): Bool {
    return ast != null && ast.type == "Program" && ast.body != null
}

# ParseError constructor
ParseError.new = function(message: String, position: {line: Number, column: Number, absolute: Number}): ParseError {
    return {message: message, position: position}
}
    children: Array[Expr]?
}

constrain ParseError :: {
    message: String,
    position: {
        line: Number,
        column: Number,
        absolute: Number
    }
}
