# FS Stdlib Module
# Contract-driven, host-bridge integrated filesystem module.
# References: [`host_bridge_contract.patlang`](../../contracts/host_bridge_contract.patlang)

# Patlang-native FS stdlib API (host bridge backed)

make function FS_write(path, contents) { return HostBridge.invoke("FS", "write", path, contents) }
make function FS_read(path) { return HostBridge.invoke("FS", "read", path) }
make function FS_exists(path) { return HostBridge.invoke("FS", "exists", path) }
make FS = "FS_SHIM"