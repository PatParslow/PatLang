# Net Stdlib Module
# Implements contract-driven networking via HostBridge fallback.
# References: [`host_bridge_contract.patlang`](../../contracts/host_bridge_contract.patlang)

# Patlang-native Net stdlib API

make function Net_connect(address, port) { return HostBridge.invoke("net", "connect", address, port) }
make function Net_send(socket, data) { return HostBridge.invoke("net", "send", socket, data) }
make function Net_receive(socket) { return HostBridge.invoke("net", "receive", socket) }
make Net = "NET_SHIM"