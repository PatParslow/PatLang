# DebuggerIntrospector Module Initial Tests

include "test_utilities.patlang"

setup {
  # Optionally reload module or reset state if needed
  # In Patlang, re-importing or re-instantiating is typically enough
  # This block runs before each test
}

run_with_setup_teardown("DebuggerIntrospector initializes with default config", {
  let dbg = DebuggerIntrospector.new()
  dbg != nil
})

run_with_setup_teardown("DebuggerIntrospector enforces config contract", {
  let raised = false
  try {
    DebuggerIntrospector.new(42)
  } catch {
    raised = true
  }
  let dbg = DebuggerIntrospector.new({ "mode": "trace" })
  raised && dbg != nil
})

run_with_setup_teardown("set_breakpoint and remove_breakpoint contracts", {
  let dbg = DebuggerIntrospector.new()
  let raised = false
  try {
    dbg.set_breakpoint(nil)
  } catch {
    raised = true
  }
  dbg.set_breakpoint("main:10")
  dbg.remove_breakpoint("main:10")
  raised
})

run_with_setup_teardown("step and continue basic contract", {
  let dbg = DebuggerIntrospector.new()
  dbg.step()
  dbg.continue()
  true
})

run_with_setup_teardown("inspect_variable and inspect_object contracts", {
  let dbg = DebuggerIntrospector.new()
  let raised_var = false
  try {
    dbg.inspect_variable(nil)
  } catch {
    raised_var = true
  }
  let v = dbg.inspect_variable("x")
  let raised_obj = false
  try {
    dbg.inspect_object(nil)
  } catch {
    raised_obj = true
  }
  let o = dbg.inspect_object({ "foo": 1 })
  raised_var && v["name"] == "x" && raised_obj && o["object"]["foo"] == 1
})

run_with_setup_teardown("inspect_memory and get_call_stack contracts", {
  let dbg = DebuggerIntrospector.new()
  let raised = false
  try {
    dbg.inspect_memory(nil)
  } catch {
    raised = true
  }
  let mem = dbg.inspect_memory("0x1000")
  let stack = dbg.get_call_stack()
  raised && mem["address"] == "0x1000" && stack[0] == "main"
})

run_with_setup_teardown("trace_execution and on_event contracts", {
  let dbg = DebuggerIntrospector.new()
  let raised = false
  try {
    dbg.trace_execution()
  } catch {
    raised = true
  }
  dbg.trace_execution { |e| }
  dbg.on_event(:breakpoint_hit) { |e| }
  raised
})