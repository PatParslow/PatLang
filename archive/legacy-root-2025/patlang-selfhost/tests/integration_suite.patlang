# Patlang Integration Suite (Refactored for granular test reporting)
include "../src/stdlib/io.patlang"
include "../src/stdlib/fs.patlang"
include "../src/stdlib/net.patlang"

# Scenario 1: IO - Print and Read
test "IO prints expected string" {
  IO.puts("integration_io_test")
  # Manual verification or capture required
}
test "IO gets returns ok" {
  IO.puts("integration_io_test")
  result = IO.gets()
  assert(result == "ok")
}

# Scenario 2: FS - Write and Read File
test "FS writes file" {
  FS.write("integration_test.txt", "abc")
  # No assertion, but should not error
}
test "FS reads file content" {
  FS.write("integration_test.txt", "abc")
  file_content = FS.read("integration_test.txt")
  assert(file_content == "abc")
}

# Scenario 3: Net - Open Connection (host fallback)
test "Net.connect returns connection or HostFallback" {
  conn = Net.connect("example.com", 80)
  assert(conn != nil)
}

# Scenario 4: Host Fallback - Call host-only method
test "HostBridge.invoke returns 43" {
  host_result = HostBridge.invoke("host_only_method", [42])
  assert(host_result == 43)
}

# Scenario 5: Contract Enforcement - Precondition violation triggers error
test "FS.read empty string raises ContractViolationError" {
  try {
    FS.read("")
    assert(false) # Should not reach here
  } catch (e) {
    assert(e.type == "ContractViolationError")
  }
}

# Scenario 6: Contract Definition and Usage
contract PositiveInput {
  precondition: (x) => x > 0
  postcondition: (result) => result > 0
}
def add_one(x: Int) : Int with PositiveInput {
  return x + 1
}
test "add_one(5) == 6" {
  assert(add_one(5) == 6)
}

# Scenario 7: Contract Precondition Violation
test "add_one(-1) raises ContractViolationError" {
  try {
    add_one(-1)
    assert(false) # Should not reach here
  } catch (e) {
    assert(e.type == "ContractViolationError")
  }
}

# Scenario 8: Contract Postcondition Violation
contract NonZeroResult {
  postcondition: (result) => result != 0
}
def faulty_add_one(x: Int) : Int with NonZeroResult {
  return 0
}
test "faulty_add_one(0) raises ContractViolationError" {
  try {
    faulty_add_one(0)
    assert(false) # Should not reach here
  } catch (e) {
    assert(e.type == "ContractViolationError")
  }
}

# Scenario 9: Contract Invariant Enforcement
contract NonNegative {
  invariant: (self) => self.value >= 0
}
class Counter with NonNegative {
  value: Int
  def dec() {
    self.value = self.value - 1
  }
}
test "Counter dec to zero holds invariant" {
  c = Counter()
  c.value = 1
  c.dec() # value becomes 0, invariant holds
  assert(c.value == 0)
}
test "Counter dec below zero raises ContractViolationError" {
  c = Counter()
  c.value = 1
  c.dec() # value becomes 0
  try {
    c.dec() # value becomes -1, invariant violated
    assert(false) # Should not reach here
  } catch (e) {
    assert(e.type == "ContractViolationError")
  }
}