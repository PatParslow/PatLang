




# Interpreter Control Flow and Error Handling Integration Test
# Tests If, While, Throw, TryCatch using IR, compiler, and interpreter



# Test If: if (1 == 1) { return 42 } else { return 0 }
test "If control flow" {
  let ir_if = [
    If([
      Const(1),
      Const(1),
      BinOp(Eq)
    ], [
      Const(42),
      Return
    ], [
      Const(0),
      Return
    ])
  ]
  let bc_if = Compiler.compile(ir_if)
  assert bc_if != CompileError
  let result_if = Interpreter.run(ir_if, {})
  assert result_if == 42
}

# Test While: let x = 0; while (x < 3) { x = x + 1 }; return x
test "While loop" {
  let ir_while = [
    Const(0),
    StoreLocal("x"),
    While([
      LoadLocal("x"),
      Const(3),
      BinOp(Lt)
    ], [
      LoadLocal("x"),
      Const(1),
      BinOp(Add),
      StoreLocal("x")
    ]),
    LoadLocal("x"),
    Return
  ]
  let bc_while = Compiler.compile(ir_while)
  assert bc_while != CompileError
  let result_while = Interpreter.run(ir_while, {})
  assert result_while == 3
}

# Test Throw/TryCatch: try { throw("err42") } catch (e) { return e }
test "TryCatch and Throw" {
  let ir_trycatch = [
    TryCatch([
      Throw("err42")
    ], "e", [
      LoadLocal("e"),
      Return
    ])
  ]
  let bc_trycatch = Compiler.compile(ir_trycatch)
  assert bc_trycatch != CompileError
  let result_trycatch = Interpreter.run(ir_trycatch, {})
  assert result_trycatch.to_s.include?("err42")
}
