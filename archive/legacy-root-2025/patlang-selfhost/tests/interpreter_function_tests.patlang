# Interpreter Function Integration Test
# Defines and calls a simple function using IR, compiler, and interpreter

import "../src/ir.patlang"
import "../src/compiler.patlang"
import "../src/interpreter.patlang"

# Define IR for: function add(a, b) { return a + b } and call add(2, 3)
let ir = [
  FunctionDef("add", ["a", "b"], [
    LoadLocal("a"),
    LoadLocal("b"),
    BinOp(Add),
    Return
  ]),
  Const(2),
  Const(3),
  Call("add", 2)
]

# Compile IR to bytecode
let bc = Compiler.compile(ir)
assert bc != CompileError

# Run in interpreter
let env = {}
let result = Interpreter.run(ir, env)
assert result == 5
