# IR Round-Trip Tests (Refactored for per-test reporting)

test "simple assignment round-trip" {
  # [AST]
  # assign(x, 42)
  # [IR]
  # assign %x, 42
  # [AST_EXPECTED]
  # assign(x, 42)
  ast = parse_ast("assign(x, 42)")
  ir = to_ir(ast)
  ast2 = from_ir(ir)
  assert(ast2 == ast)
}

test "function definition round-trip" {
  # [AST]
  # fn add(a, b) { return a + b }
  # [IR]
  # fn %add(%a, %b) { return add %a, %b }
  # [AST_EXPECTED]
  # fn add(a, b) { return a + b }
  ast = parse_ast("fn add(a, b) { return a + b }")
  ir = to_ir(ast)
  ast2 = from_ir(ir)
  assert(ast2 == ast)
}

test "nested expression round-trip" {
  # [AST]
  # assign(y, add(1, mul(2, 3)))
  # [IR]
  # assign %y, call %add, 1, call %mul, 2, 3
  # [AST_EXPECTED]
  # assign(y, add(1, mul(2, 3)))
  ast = parse_ast("assign(y, add(1, mul(2, 3)))")
  ir = to_ir(ast)
  ast2 = from_ir(ir)
  assert(ast2 == ast)
}
test "include statement preserves string value" {
  # [AST]
  # include("foo.patlang")
  # [IR]
  # include "foo.patlang"
  ast = parse_ast('include("foo.patlang")')
  ir = to_ir(ast)
  # Expect IR to contain an Include instruction with the correct string
  assert(ir.contains?(Include("foo.patlang")))
}