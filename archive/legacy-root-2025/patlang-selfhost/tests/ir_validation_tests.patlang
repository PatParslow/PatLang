# IR Validation Tests (Refactored for per-test reporting)

test "valid IR assignment" {
  ir = "assign %x, 42"
  assert(validate_ir(ir) == true)
}

test "valid IR function definition" {
  ir = "fn %add(%a, %b) { return add %a, %b }"
  assert(validate_ir(ir) == true)
}

test "invalid IR: undefined variable" {
  ir = "assign %z, %undefined_var"
  assert(validate_ir(ir) == false)
}

test "invalid IR: malformed instruction" {
  ir = "assign 42, %x"
  assert(validate_ir(ir) == false)
}