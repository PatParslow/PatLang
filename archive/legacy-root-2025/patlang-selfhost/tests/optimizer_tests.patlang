# Optimizer Module Initial Tests
include "../src/optimizer.patlang"

test "Optimizer initializes with default config" {
  let opt = Optimizer.new()
  assert opt != nil
}

test "Optimizer enforces config contract" {
  assert_raises { Optimizer.new(42) }
  let opt = Optimizer.new({ "level": 2 })
  assert opt != nil
}

test "analyze_scope enforces precondition" {
  let opt = Optimizer.new()
  assert_raises { opt.analyze_scope(nil) }
  let result = opt.analyze_scope(["scope1"])
  assert result["scopes_analyzed"] == true
}

test "optimize_code applies passes and enforces precondition" {
  let opt = Optimizer.new()
  assert_raises { opt.optimize_code(nil) }
  let ast = { "type": "dummy_ast" }
  let called = false
  opt.register_pass(:test_pass) { |a| called = true; a }
  let optimized = opt.optimize_code(ast)
  assert called == true
  assert optimized == ast
}

test "register_pass enforces contract" {
  let opt = Optimizer.new()
  assert_raises { opt.register_pass(nil) }
  assert_raises { opt.register_pass(:foo) }
}

test "on_event and log_optimization basic contract" {
  let opt = Optimizer.new()
  let called = false
  opt.on_event(:optimization_pass) { |e| called = true }
  opt.log_optimization({ "event": "test" })
  assert opt.instance_variable_get(:@last_log)["event"] == "test"
}