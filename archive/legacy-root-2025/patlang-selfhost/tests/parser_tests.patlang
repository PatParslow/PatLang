# Parser tests (comprehensive, per-test reporting)

test "parse simple assignment" {
  ast = parse("x = 1")
  assert(ast == Assign("x", Number(1)))
}

test "parse arithmetic expression" {
  ast = parse("a + b * 2")
  assert(ast == Add(Var("a"), Mul(Var("b"), Number(2))))
}

test "parse function definition" {
  ast = parse("def add(a, b) { return a + b }")
  assert(ast == FunctionDef("add", ["a", "b"], [Return(Add(Var("a"), Var("b")))]))
}

test "parse if/else statement" {
  ast = parse("if x < 0 { y = -1 } else { y = 1 }")
  assert(ast == If(Lt(Var("x"), Number(0)), [Assign("y", Number(-1))], [Assign("y", Number(1))]))
}

test "parse while loop" {
  ast = parse("while n > 0 { n = n - 1 }")
  assert(ast == While(Gt(Var("n"), Number(0)), [Assign("n", Sub(Var("n"), Number(1)))]))
}

test "parse nested expressions" {
  ast = parse("f(g(1, 2), h(3))")
  assert(ast == Call("f", [Call("g", [Number(1), Number(2)]), Call("h", [Number(3)])]))
}

test "parse empty input" {
  ast = parse("")
  assert(ast == None)
}

test "parse deeply nested" {
  code = "a = (((((((1)))))))"
  ast = parse(code)
  assert(ast == Assign("a", Number(1)))
}

test "parse ambiguous grammar" {
  ast = parse("a = b + c * d")
  assert(ast == Assign("a", Add(Var("b"), Mul(Var("c"), Var("d")))))
}

test "parse incomplete statement error" {
  try {
    parse("def foo(")
    assert(false)
  } catch (e) {
    assert(e.type == "ParseError")
  }
}

test "parse invalid syntax error" {
  try {
    parse("if {")
    assert(false)
  } catch (e) {
    assert(e.type == "ParseError")
  }
}