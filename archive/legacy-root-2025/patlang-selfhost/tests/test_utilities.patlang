# Patlang Test Utilities: Hierarchical Test Support

# Usage:
#   include "test_utilities.patlang"
#   test_block("Parent", all: [
#     { name: "Child1", result: assert(...) },
#     { name: "Child2", result: assert(...) }
#   ])
#
#   test_block("Parent", any: [
#     { name: "Child1", result: assert(...) },
#     { name: "Child2", result: assert(...) }
#   ])

def test_block(name, all: nil, any: nil)
  results = []
  if all != nil
    for sub in all
      results.append(sub[:result])
      if sub[:result]
        print("TEST: #{name}/#{sub[:name]} PASS")
      else
        print("TEST: #{name}/#{sub[:name]} FAIL")
      end
    end
    parent_result = results.all?
    print("TEST: #{name} #{parent_result ? 'PASS' : 'FAIL'}")
    return parent_result
  elsif any != nil
    for sub in any
      results.append(sub[:result])
      if sub[:result]
        print("TEST: #{name}/#{sub[:name]} PASS")
      else
        print("TEST: #{name}/#{sub[:name]} FAIL")
      end
    end
    parent_result = results.any?
    print("TEST: #{name} #{parent_result ? 'PASS' : 'FAIL'}")
    return parent_result
  else
    print("TEST: #{name} FAIL")
    return false
  end
end

def test_case(name, cond)
  if cond
    print("TEST: #{name} PASS")
    return true
  else
    print("TEST: #{name} FAIL")
    return false
  end
end
# --- Setup/Teardown Support ---
$__setup_block = nil
$__teardown_block = nil

def setup(block)
  $__setup_block = block
end

def teardown(block)
  $__teardown_block = block
end

def run_with_setup_teardown(name, block)
  if $__setup_block != nil
    $__setup_block.()
  end
  result = block.()
  if $__teardown_block != nil
    $__teardown_block.()
  end
  test_case(name, result)
end