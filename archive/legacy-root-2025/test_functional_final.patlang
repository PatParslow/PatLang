make a function called double takes: x {
  return x * 2
}

make a function called simple_map takes: list {
  if list.is_empty() then
    return call make_empty_list
  else
    doubled_head = call double with list.head().value
    return call make_list with doubled_head, call simple_map with list.tail()
  end
}

# Create a list and test the functional programming
numbers = call make_list with 1, call make_list with 2, call make_list with 3, call make_empty_list
print("Original numbers:")
print(numbers.to_array())

result = call simple_map with numbers
print("Doubled numbers:")
print(result.to_array())