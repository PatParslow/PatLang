make a function called double takes: x {
  return x * 2
}

print("Testing basic functional programming...")

# Test the double function
result1 = call double with 5
print("Double of 5:")
print(result1)

# Create a simple list
list1 = call make_list with 10, call make_empty_list
print("Created list with 10:")
print(list1.to_array())

# Double the head of the list
doubled_head = call double with list1.head().value
print("Doubled head:")
print(doubled_head)

# Create new list with doubled value
new_list = call make_list with doubled_head, call make_empty_list
print("New list with doubled value:")
print(new_list.to_array())

print("Functional programming concepts working!")