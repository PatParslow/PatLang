#!/usr/bin/env ruby

# PatLang Executable Wrapper
# Simple wrapper script to make PatLang easy to use from command line

require 'pathname'

# Get the project root directory
PATLANG_ROOT = Pathname.new(__FILE__).parent.parent.expand_path
PATLANG_SRC = PATLANG_ROOT.join('src')

# Add src to load path
$LOAD_PATH.unshift(PATLANG_SRC.to_s)

# Load PatLang
require_relative File.join(PATLANG_ROOT, 'src', 'patlang')

def show_help
  puts <<~HELP
    PatLang v0.4.0 - Multi-Paradigm Programming Language
    
    Usage:
      patlang [file.pat]           # Execute a PatLang file
      patlang --repl              # Start interactive REPL
      patlang --demo              # Run demonstration
      patlang --version           # Show version information
      patlang --help              # Show this help
    
    Examples:
      patlang script.pat          # Run script.pat
      patlang examples/hello.pat  # Run example file
      patlang --repl              # Start interactive mode
    
    File Extensions:
      .pat        PatLang source files
      .patlang    PatLang source files (reasoning mode enabled)
    
    For more information, visit: https://github.com/patlang/patlang
  HELP
end

def show_version
  puts "PatLang v0.4.0"
  puts "Multi-Paradigm Programming Language"
  puts "Copyright (c) 2025 PatLang Project"
end

def run_file(filename)
  unless File.exist?(filename)
    puts "Error: File '#{filename}' not found."
    exit 1
  end
  
  # Check file extension
  ext = File.extname(filename)
  unless ['.pat', '.patlang'].include?(ext)
    puts "Warning: File extension '#{ext}' not recognized. Proceeding anyway..."
  end
  
  begin
    Patlang.run_file(filename)
  rescue => e
    puts "Error executing #{filename}: #{e.message}"
    exit 1
  end
end

def start_repl
  puts "Starting PatLang REPL..."
  begin
    Patlang.repl
  rescue Interrupt
    puts "\nGoodbye!"
    exit 0
  rescue => e
    puts "REPL error: #{e.message}"
    exit 1
  end
end

def run_demo
  puts "Running PatLang demonstration..."
  begin
    Patlang.demo
  rescue => e
    puts "Demo error: #{e.message}"
    exit 1
  end
end

# Main execution logic
case ARGV.length
when 0
  # No arguments - show help
  show_help
  
when 1
  arg = ARGV[0]
  
  case arg
  when '--help', '-h'
    show_help
  when '--version', '-v'
    show_version
  when '--repl', '-r'
    start_repl
  when '--demo', '-d'
    run_demo
  else
    # Assume it's a filename
    run_file(arg)
  end
  
else
  # Multiple arguments - show error
  puts "Error: Too many arguments."
  puts "Use 'patlang --help' for usage information."
  exit 1
end