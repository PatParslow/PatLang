# Complex PaTLang Build File Example
# Demonstrates advanced features: parallel builds, conditional logic,
# sophisticated dependency management, and goal-oriented execution

# Project configuration
var :project_name, "PaTLang Advanced Project"
var :version, "2.1.0"
var :src_dir, "src"
var :lib_dir, "lib"
var :test_dir, "test"
var :build_dir, "build"
var :dist_dir, "dist"
var :docs_dir, "docs"

# Environment detection
var :is_ci, ENV['CI'] == 'true'
var :is_production, ENV['RAILS_ENV'] == 'production'
var :parallel_jobs, ENV['PARALLEL_JOBS']&.to_i || 4

# Default build targets
default :full_build

# === CLEANING TARGETS ===

clean :clean_all do
  description "Clean all build artifacts and temporary files"
  remove var(:build_dir), var(:dist_dir), "*.log", ".coverage", "tmp"
end

clean :clean_build do
  description "Clean only build artifacts"
  remove var(:build_dir)
end

# === COMPILATION TARGETS ===

compile :compile_core do
  description "Compile core language components"
  inputs glob("#{var(:src_dir)}/core/**/*.rb")
  outputs ["#{var(:build_dir)}/core.rb"]
  
  parallel_safe true
  
  precondition "Dir.exist?('#{var(:src_dir)}/core')"
  postcondition "File.size('#{var(:build_dir)}/core.rb') > 100"
  
  action do |target, context|
    puts "🔨 Compiling core components..."
    
    # Advanced compilation with optimization
    core_files = target.inputs.sort
    optimized_content = core_files.map do |file|
      content = File.read(file)
      
      # Simulate optimization passes
      if context.get(:optimize)
        content = content.gsub(/\s+/, ' ').strip # Minify whitespace
      end
      
      "# Compiled from #{file}\n#{content}"
    end.join("\n\n")
    
    FileUtils.mkdir_p(var(:build_dir))
    File.write("#{var(:build_dir)}/core.rb", optimized_content)
    
    {
      compiled_files: core_files.length,
      output_size: optimized_content.length,
      optimized: context.get(:optimize) || false
    }
  end
end

compile :compile_parser do
  description "Compile parser components with advanced features"
  inputs glob("#{var(:src_dir)}/parser/**/*.rb")
  outputs ["#{var(:build_dir)}/parser.rb"]
  
  depends_on :compile_core
  parallel_safe true
  
  # Custom incremental check using reasoning
  incremental do |target, context|
    # Check if parser grammar files changed
    grammar_files = Dir.glob("#{var(:src_dir)}/parser/**/*.grammar")
    return true if grammar_files.any? { |f| File.mtime(f) > target.get_last_built_time }
    
    # Check dependencies
    core_result = context.get(:compile_core_result)
    return true if core_result && core_result[:timestamp] > target.get_last_built_time
    
    false
  end
  
  action do |target, context|
    puts "⚙️  Compiling parser with goal-oriented optimizations..."
    
    # Use goal-oriented compilation strategy
    compilation_goal = {
      optimize_for: context.get(:optimize_parser) ? :speed : :size,
      enable_debug: !var(:is_production),
      parallel_parsing: var(:parallel_jobs) > 1
    }
    
    parser_content = target.inputs.map do |file|
      File.read(file)
    end.join("\n\n")
    
    # Apply goal-oriented optimizations
    if compilation_goal[:optimize_for] == :speed
      parser_content += "\n# Speed optimizations enabled"
    else
      parser_content = parser_content.gsub(/^\s*#.*$/, '') # Remove comments for size
    end
    
    File.write("#{var(:build_dir)}/parser.rb", parser_content)
    
    {
      strategy: compilation_goal,
      parser_size: parser_content.length,
      optimizations_applied: compilation_goal[:optimize_for]
    }
  end
end

compile :compile_evaluator do
  description "Compile evaluator with reasoning system integration"
  inputs glob("#{var(:src_dir)}/evaluator/**/*.rb")
  outputs ["#{var(:build_dir)}/evaluator.rb"]
  
  depends_on :compile_core, :compile_parser
  parallel_safe true
  
  action do |target, context|
    puts "🧠 Compiling evaluator with reasoning integration..."
    
    # Sophisticated build using multiple goals
    evaluator_components = target.inputs.group_by do |file|
      case File.basename(file)
      when /arithmetic/ then :arithmetic
      when /reasoning/ then :reasoning  
      when /logic/ then :logic
      else :core
      end
    end
    
    compiled_sections = evaluator_components.map do |section, files|
      section_content = files.map { |f| File.read(f) }.join("\n")
      "# === #{section.upcase} SECTION ===\n#{section_content}"
    end.join("\n\n")
    
    File.write("#{var(:build_dir)}/evaluator.rb", compiled_sections)
    
    {
      sections_compiled: evaluator_components.keys,
      total_components: target.inputs.length,
      reasoning_enabled: evaluator_components.key?(:reasoning)
    }
  end
end

# === LINKING TARGET ===

link :link_application do
  description "Link all compiled components into final application"
  depends_on :compile_core, :compile_parser, :compile_evaluator
  
  inputs [
    "#{var(:build_dir)}/core.rb",
    "#{var(:build_dir)}/parser.rb", 
    "#{var(:build_dir)}/evaluator.rb"
  ]
  outputs ["#{var(:build_dir)}/patlang.rb"]
  
  postcondition "File.exist?('#{var(:build_dir)}/patlang.rb')"
  postcondition "File.size('#{var(:build_dir)}/patlang.rb') > 1000"
  
  action do |target, context|
    puts "🔗 Linking application components..."
    
    # Create main application file
    main_content = <<~RUBY
      #!/usr/bin/env ruby
      # PaTLang Interpreter - Goal-Oriented Build System Output
      # Generated at: #{Time.now}
      # Version: #{var(:version)}
      
      #{target.inputs.map { |f| File.read(f) }.join("\n\n")}
      
      # Main execution
      if __FILE__ == $0
        puts "🚀 PaTLang Interpreter #{var(:version)} ready!"
        puts "🧠 Goal-oriented reasoning: ENABLED"
        puts "⚡ Advanced strategies: LOADED"
      end
    RUBY
    
    File.write("#{var(:build_dir)}/patlang.rb", main_content)
    FileUtils.chmod(0755, "#{var(:build_dir)}/patlang.rb")
    
    {
      linked_components: target.inputs.length,
      executable_size: main_content.length,
      executable_path: "#{var(:build_dir)}/patlang.rb"
    }
  end
end

# === TESTING TARGETS ===

test :unit_tests do
  description "Run comprehensive unit tests with goal verification"
  depends_on :link_application
  inputs glob("#{var(:test_dir)}/**/*_test.rb")
  
  parallel_safe var(:parallel_jobs) > 1
  
  precondition "File.executable?('#{var(:build_dir)}/patlang.rb')"
  
  action do |target, context|
    puts "🧪 Running #{target.inputs.length} unit tests..."
    
    # Simulate comprehensive testing
    test_suites = {
      core_tests: rand(15..25),
      parser_tests: rand(20..30),
      evaluator_tests: rand(10..20),
      reasoning_tests: rand(25..35),
      integration_tests: rand(5..10)
    }
    
    total_tests = test_suites.values.sum
    failed_tests = rand(0..2) # Mostly pass
    
    results = {
      total: total_tests,
      passed: total_tests - failed_tests,
      failed: failed_tests,
      suites: test_suites,
      duration: rand(30..90),
      coverage: rand(85..95)
    }
    
    if results[:failed] == 0
      puts "✅ All #{total_tests} tests passed! Coverage: #{results[:coverage]}%"
    else
      puts "⚠️  #{results[:failed]} test(s) failed out of #{total_tests}"
    end
    
    results
  end
end

test :integration_tests do
  description "Run integration tests with reasoning system"
  depends_on :unit_tests
  
  action do |target, context|
    puts "🔄 Running integration tests with goal-oriented scenarios..."
    
    scenarios = [
      "Goal resolution with backtracking",
      "Parallel strategy execution", 
      "Adaptive problem solving",
      "Complex dependency resolution",
      "Real-time strategy adaptation"
    ]
    
    results = scenarios.map do |scenario|
      success = rand > 0.1 # 90% success rate
      {
        scenario: scenario,
        status: success ? :passed : :failed,
        duration: rand(5..15)
      }
    end
    
    total_passed = results.count { |r| r[:status] == :passed }
    puts "🎯 Integration tests: #{total_passed}/#{scenarios.length} scenarios passed"
    
    {
      scenarios: results,
      overall_status: total_passed == scenarios.length ? :success : :partial,
      reasoning_integration: :verified
    }
  end
end

# === PACKAGING TARGETS ===

package :create_distribution do
  description "Create distribution package with advanced features"
  depends_on :link_application, :integration_tests
  
  inputs ["#{var(:build_dir)}/patlang.rb"]
  outputs ["#{var(:dist_dir)}/patlang-#{var(:version)}.tar.gz"]
  
  # Only package if tests pass
  precondition "context.get(:integration_tests_result)&.dig(:overall_status) == :success"
  
  action do |target, context|
    puts "📦 Creating distribution package..."
    
    FileUtils.mkdir_p(var(:dist_dir))
    
    # Create package structure
    package_dir = "#{var(:dist_dir)}/patlang-#{var(:version)}"
    FileUtils.mkdir_p(package_dir)
    
    # Copy files
    FileUtils.cp("#{var(:build_dir)}/patlang.rb", "#{package_dir}/")
    
    # Create package metadata
    metadata = {
      name: var(:project_name),
      version: var(:version),
      built_at: Time.now.strftime("%Y-%m-%dT%H:%M:%S%z"),
      features: [
        "Goal-oriented programming",
        "Advanced reasoning system", 
        "Parallel strategy execution",
        "Adaptive problem solving"
      ],
      build_info: {
        ci_build: var(:is_ci),
        production: var(:is_production),
        parallel_jobs: var(:parallel_jobs)
      }
    }
    
    File.write("#{package_dir}/metadata.json", JSON.pretty_generate(metadata))
    
    # Create tarball
    system("tar -czf #{target.outputs.first} -C #{var(:dist_dir)} patlang-#{var(:version)}")
    
    {
      package_path: target.outputs.first,
      package_size: File.size(target.outputs.first),
      metadata: metadata
    }
  end
end

# === DEPLOYMENT TARGET ===

target :deploy do
  description "Deploy to production with goal-oriented verification"
  depends_on :create_distribution
  
  # Only deploy in CI or with explicit confirmation
  precondition "var(:is_ci) || context.get(:confirm_deploy)"
  
  action do |target, context|
    puts "🚀 Deploying PaTLang #{var(:version)}..."
    
    deployment_strategy = {
      environment: var(:is_production) ? :production : :staging,
      rollback_enabled: true,
      health_checks: [
        "Basic functionality test",
        "Goal resolution verification", 
        "Reasoning system validation"
      ]
    }
    
    # Simulate deployment
    puts "📋 Deployment strategy: #{deployment_strategy[:environment]}"
    deployment_strategy[:health_checks].each do |check|
      puts "  ✓ #{check}"
    end
    
    {
      deployed_version: var(:version),
      deployment_time: Time.now,
      strategy: deployment_strategy,
      status: :success
    }
  end
end

# === COMPOSITE TARGETS ===

target :full_build do
  description "Complete build pipeline with all validations"
  depends_on :create_distribution
  
  action do |target, context|
    puts "🎉 Full build completed successfully!"
    puts "📊 Build Summary:"
    puts "   • Core components: compiled"
    puts "   • Parser: optimized"  
    puts "   • Evaluator: reasoning-enabled"
    puts "   • Tests: #{context.get(:unit_tests_result)&.dig(:total) || 0} run"
    puts "   • Package: #{var(:dist_dir)}/patlang-#{var(:version)}.tar.gz"
    
    {
      build_complete: true,
      version: var(:version),
      artifacts: ["#{var(:dist_dir)}/patlang-#{var(:version)}.tar.gz"]
    }
  end
end

target :quick_build do
  description "Quick development build for iteration"
  depends_on :link_application
  
  action do |target, context|
    puts "⚡ Quick build ready for development!"
    { status: :ready_for_dev, executable: "#{var(:build_dir)}/patlang.rb" }
  end
end

# === CONDITIONAL TARGETS ===

when_condition var(:is_ci) do
  target :ci_verification do
    description "Additional CI-specific verification"
    depends_on :integration_tests
    
    action do |target, context|
      puts "🔍 Running CI-specific verification..."
      
      {
        ci_checks: [
          "Code quality metrics",
          "Security scan", 
          "Performance benchmarks",
          "Documentation coverage"
        ].map { |check| { check: check, status: :passed } }
      }
    end
  end
  
  # Add CI verification to full build
  target :full_build do
    depends_on :ci_verification
  end
end