# =============================================================================
# Example Build Configuration using Native PaTLang Build Tool
# =============================================================================
#
# This file demonstrates how to use the native PaTLang build tool
# for a typical C/C++ project with testing.
# =============================================================================

# Import the native PaTLang build tool
import "native_patlang_build_tool.patlang"

# Enable reasoning for intelligent build coordination
reasoning mode on

# Create build tool instance
build = call BuildTool.new()

# =============================================================================
# PROJECT BUILD CONFIGURATION
# =============================================================================

# Define source compilation targets (can run in parallel)
call build.target("compile_parser", {
    command: "gcc -c -O2 -Wall src/parser.c -o build/parser.o",
    parallel_safe: true
})

call build.target("compile_lexer", {
    command: "gcc -c -O2 -Wall src/lexer.c -o build/lexer.o", 
    parallel_safe: true
})

call build.target("compile_evaluator", {
    command: "gcc -c -O2 -Wall src/evaluator.c -o build/evaluator.o",
    parallel_safe: true
})

call build.target("compile_main", {
    dependencies: ["compile_parser", "compile_lexer", "compile_evaluator"],
    command: "gcc -c -O2 -Wall src/main.c -o build/main.o",
    parallel_safe: true
})

# Link the final executable
call build.target("link_patlang", {
    dependencies: ["compile_main", "compile_parser", "compile_lexer", "compile_evaluator"],
    command: "gcc build/*.o -o bin/patlang",
    parallel_safe: false
})

# Test compilation targets
call build.target("compile_tests", {
    dependencies: ["link_patlang"],
    command: "gcc -c -Wall test/test_suite.c -o build/test_suite.o",
    parallel_safe: true
})

call build.target("link_tests", {
    dependencies: ["compile_tests"],
    command: "gcc build/test_suite.o build/parser.o build/lexer.o build/evaluator.o -o bin/test_suite",
    parallel_safe: false
})

# Run test suite
call build.target("run_tests", {
    dependencies: ["link_tests"],
    command: "bin/test_suite --verbose",
    parallel_safe: false
})

# Documentation generation
call build.target("generate_docs", {
    command: "doxygen docs/Doxyfile",
    parallel_safe: true
})

# Package creation
call build.target("create_package", {
    dependencies: ["run_tests", "generate_docs"],
    command: "tar -czf patlang-release.tar.gz bin/ docs/html/",
    parallel_safe: false
})

# =============================================================================
# BUILD ANALYSIS AND EXECUTION
# =============================================================================

# Show the dependency graph
print "=== Dependency Analysis ==="
call build.show_dependencies()

# Analyze build for optimization opportunities
print "\n=== Build Optimization Analysis ==="
call build.analyze()

# Query for circular dependencies (should find none)
print "\n=== Circular Dependency Check ==="
?- has_cycle(X)
if reasoning_result != nil then
    print "WARNING: Circular dependency detected: " + reasoning_result
else
    print "✅ No circular dependencies found"
end

# Find all parallelizable targets
print "\n=== Parallel Execution Opportunities ==="
?- parallelizable_group(Groups)
parallel_opportunities = reasoning_result
if parallel_opportunities != nil then
    for group in parallel_opportunities {
        print "Can run in parallel: " + group.join(", ")
    }
end

# =============================================================================
# BUILD EXECUTION GOALS
# =============================================================================

# Goal: Build the complete project
goal build_complete_project {
    precondition: all_targets_defined == true,
    postcondition: package_created == true and tests_passed == true,
    strategy: parallel_optimized
}

# Goal: Quick development build (just compile and link)
goal quick_dev_build {
    precondition: source_files_exist == true,
    postcondition: executable_ready == true,
    strategy: fast_compilation
}

# Goal: Release build with full testing and documentation
goal release_build {
    precondition: all_sources_ready == true,
    postcondition: release_package_ready == true,
    strategy: comprehensive_build
}

# =============================================================================
# INTERACTIVE BUILD COMMANDS
# =============================================================================

# Define build commands that can be executed
make function quick_build() {
    print "=== Quick Development Build ==="
    pursue quick_dev_build
    result = call build.build(["link_patlang"])
    return result
}

make function full_build() {
    print "=== Complete Project Build ==="
    pursue build_complete_project
    result = call build.build(["create_package"])
    return result
}

make function test_only() {
    print "=== Running Tests Only ==="
    result = call build.build(["run_tests"])
    return result
}

make function clean_build() {
    print "=== Clean Build ==="
    call build.clean(build.targets)
    result = call build.build(["create_package"])
    return result
}

# =============================================================================
# EXAMPLE BUILD EXECUTION
# =============================================================================

print "\n" + "=" * 60
print "🚀 STARTING PATLANG BUILD PROCESS"
print "=" * 60

# Demonstrate different build strategies
print "\n1. Quick development build:"
quick_result = call quick_build()
print "Quick build status: " + quick_result.status

print "\n2. Full build with tests and documentation:"
full_result = call full_build()
print "Full build status: " + full_result.status

# Query final build state
print "\n=== Final Build State Analysis ==="
?- build_completed(X)
completed_targets = reasoning_result || []
print "Completed targets: " + completed_targets.join(", ")

?- ready_to_build(X)
ready_targets = reasoning_result || []
if ready_targets.length > 0 then
    print "Targets ready to build: " + ready_targets.join(", ")
else
    print "✅ All targets have been built"
end

reasoning mode off

print "\n🎉 PaTLang native build tool demonstration complete!"
print "This showcases goal-oriented, logic-based build automation."