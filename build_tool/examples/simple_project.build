# Simple PaTLang Build File Example
# Demonstrates basic build targets and dependencies

# Variables
var :src_dir, "src"
var :build_dir, "build"
var :test_dir, "test"

# Default targets
default :build, :test

# Clean target
clean :clean do
  description "Clean all build artifacts"
  remove "#{var(:build_dir)}/*"
  remove "*.log"
end

# Compile source files
compile :compile_sources do
  description "Compile all source files"
  inputs glob("#{var(:src_dir)}/**/*.rb")
  outputs ["#{var(:build_dir)}/app.rb"]
  
  action do |target, context|
    puts "Compiling #{target.inputs.length} source files..."
    
    # Simulate compilation by concatenating files
    output_content = target.inputs.map do |input_file|
      "# From #{input_file}\n" + File.read(input_file)
    end.join("\n\n")
    
    FileUtils.mkdir_p(var(:build_dir))
    File.write("#{var(:build_dir)}/app.rb", output_content)
    
    "Successfully compiled #{target.inputs.length} files"
  end
  
  parallel_safe true
end

# Run tests
test :run_tests do
  description "Run all unit tests"
  depends_on :compile_sources
  inputs glob("#{var(:test_dir)}/**/*test*.rb")
  
  precondition "Dir.exist?('#{var(:build_dir)}')"
  postcondition "test_results[:passed] > 0"
  
  action do |target, context|
    puts "Running #{target.inputs.length} test files..."
    
    # Simulate test execution
    test_results = {
      total: target.inputs.length,
      passed: target.inputs.length - 1,
      failed: 1,
      duration: rand(5..15)
    }
    
    context.set(:test_results, test_results)
    
    if test_results[:failed] > 0
      puts "Tests completed with #{test_results[:failed]} failure(s)"
    else
      puts "All tests passed!"
    end
    
    test_results
  end
end

# Package application
package :build do
  description "Package the compiled application"
  depends_on :compile_sources
  inputs ["#{var(:build_dir)}/app.rb"]
  outputs ["#{var(:build_dir)}/app.tar.gz"]
  
  shell "tar -czf #{var(:build_dir)}/app.tar.gz -C #{var(:build_dir)} app.rb"
  
  postcondition "File.exist?('#{var(:build_dir)}/app.tar.gz')"
end

# Development target - quick iteration
target :dev do
  description "Development build - fast iteration"
  depends_on :compile_sources
  
  # Custom incremental check
  incremental do |target, context|
    # Only rebuild if source files changed in last 5 minutes
    cutoff_time = Time.now - (5 * 60)
    target.inputs.any? { |f| File.mtime(f) > cutoff_time }
  end
  
  action do |target, context|
    puts "Development build completed"
    { status: :dev_ready, message: "Ready for development testing" }
  end
end

# Install target
target :install do
  description "Install the packaged application"
  depends_on :build
  
  precondition "File.exist?('#{var(:build_dir)}/app.tar.gz')"
  
  action do |target, context|
    install_dir = "/usr/local/bin"
    puts "Installing application to #{install_dir}"
    
    # Simulate installation
    {
      installed_to: install_dir,
      version: "1.0.0",
      timestamp: Time.now
    }
  end
end