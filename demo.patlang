# Patlang Demo Program: Core Features & Memory Management

# Variable assignment and arithmetic
x = 10
y = 5
sum = x + y
product = x * y
print("Sum of x and y: " + sum)
print("Product of x and y: " + product)

# String manipulation and concatenation
greeting = "Hello"
name = "Patlang"
message = greeting + ", " + name + "!"
print(message)

# If/else control flow
if sum > 10 {
    print("Sum is greater than 10")
} else {
    print("Sum is 10 or less")
}

# Loop (while supported in most Patlang evaluators)
counter = 0
while counter < 3 {
    print("Counter is: " + counter)
    counter = counter + 1
}

# Variable reuse and shadowing
value = 42
print("Outer value: " + value)
{
    value = "shadowed"
    print("Inner value: " + value)
}
print("After block, value: " + value)