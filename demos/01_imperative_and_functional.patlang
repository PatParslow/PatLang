# Demo 1: imperative and functional PatLang.
#
#   v2_interp.exe 01_imperative_and_functional.patlang
#   v2.exe 01_imperative_and_functional.patlang demo1.exe
#
# Covers: let, while, if/elif/else, functions, recursion, exact numbers,
# strings and string builders, lists as values, pattern matching, closures,
# higher-order functions (map, filter, fold, compose) and apply by name.

# ---- imperative: loops, branches, accumulators ----

# The primes below n, by the sieve of Eratosthenes over a bool array.
make a function called primes_below takes n returns primes
  require n >= 2
  let composite = bool_array_new(n)
  let primes = []
  let i = 2
  while i < n do
    if not bool_array_get(composite, i) then
      let primes = list_push(primes, i)
      let j = i * i
      while j < n do
        bool_array_set(composite, j, true)
        let j = j + i
      end
    end
    let i = i + 1
  end
  ensure list_len(primes) > 0
  return primes
end

make a function called classify takes n returns label
  if n < 0 then
    return "negative"
  elif n == 0 then
    return "zero"
  elif n % 2 == 0 then
    return "even"
  else
    return "odd"
  end
end

# A string built in a loop uses a string builder: s = s + x would copy s
# on every pass.
make a function called join_with takes items, sep returns text
  let b = sb_new()
  let i = 0
  while i < list_len(items) do
    if i > 0 then
      sb_push(b, sep)
    end
    sb_push(b, items[i])
    let i = i + 1
  end
  return sb_str(b)
end

print("== imperative ==")
print("primes below 40: " + join_with(primes_below(40), " "))
print("classify: " + classify(0 - 3) + ", " + classify(0) + ", " + classify(8) + ", " + classify(7))

# ---- exact numbers ----

make a function called factorial takes n returns r
  if n < 2 then
    return 1
  end
  return n * factorial(n - 1)
end

print("== numbers ==")
print("25! = " + factorial(25))
print("type of 25!: " + type_of(factorial(25)))
print("1/3 + 1/6 = " + (1 / 3 + 1 / 6))
print("2^-3 = " + pow(2, 0 - 3))
print("sqrt(2.0) = " + sqrt(2.0))
print("7 mod 5, squared = " + (mod_make(7, 5) * mod_make(7, 5)))
print("flags: " + ((1 shl 4) bor 3) + ", masked: " + (255 band 15))

# ---- lists are values ----

print("== values ==")
let xs = [1, 2, 3]
let ys = list_push(xs, 4)
let zs = list_set(xs, 0, 99)
print("xs " + xs + "  ys " + ys + "  zs " + zs)

# ---- pattern matching ----

make a function called area takes shape returns a
  match shape do
    case ["circle", r] then
      return 3.14159 * r * r
    case ["rect", w, h] then
      return w * h
    case ["square", side] when side > 0 then
      return side * side
    case _ then
      return 0
  end
end

make a function called size_word takes n returns word
  match n do
    case 0 then
      return "none"
    case < 10 then
      return "a few"
    case < 100 then
      return "dozens"
    case _ then
      return "many"
  end
end

print("== match ==")
print("areas: " + area(["rect", 3, 4]) + ", " + area(["square", 5]) + ", " + area(["blob"]))
print("sizes: " + size_word(0) + ", " + size_word(7) + ", " + size_word(42) + ", " + size_word(5000))

# ---- functional: closures and higher-order functions ----

make a function called map takes items, f returns out
  let out = []
  let i = 0
  while i < list_len(items) do
    let out = list_push(out, f(items[i]))
    let i = i + 1
  end
  return out
end

make a function called filter takes items, keep returns out
  let out = []
  let i = 0
  while i < list_len(items) do
    if keep(items[i]) then
      let out = list_push(out, items[i])
    end
    let i = i + 1
  end
  return out
end

make a function called fold takes items, start, step returns acc
  let acc = start
  let i = 0
  while i < list_len(items) do
    let acc = step(acc, items[i])
    let i = i + 1
  end
  return acc
end

# g after f, as one closure. A closure takes a copy of what it reads when it
# is made, so compose keeps f and g whatever happens to those names later.
make a function called compose takes f, g returns h
  return |x| do
    return g(f(x))
  end
end

make a function called adder takes n returns f
  return |x| do
    return x + n
  end
end

make a function called range takes from, to returns out
  let out = []
  let i = from
  while i < to do
    let out = list_push(out, i)
    let i = i + 1
  end
  return out
end

make a function called double takes x returns r
  return x * 2
end

# A last parameter named rest takes any further arguments as a list.
make a function called total takes first, rest returns sum
  return fold(rest, first, |a, b| { return a + b })
end

print("== functional ==")
let square = |x| { return x * x }
let is_even = |x| { return x % 2 == 0 }
let nums = range(1, 11)
print("squares of the evens: " + map(filter(nums, is_even), square))
print("sum of squares: " + fold(map(nums, square), 0, |a, b| { return a + b }))
let add5_then_square = compose(adder(5), square)
print("(3 + 5)^2 = " + add5_then_square(3))
print("apply by name: " + apply("double", 21))
print("total(1, 2, 3, 4) = " + total(1, 2, 3, 4))

# Capture is by snapshot: the closure keeps the n it saw.
let n = 1
let seen = || { return n }
let n = 2
print("closure saw n = " + seen() + ", n is now " + n)

# State that outlives a call lives in a cell with identity (a vec), which a
# closure shares rather than copies.
make a function called counter returns next
  let cell = vec_new()
  vec_push(cell, 0)
  return || do
    vec_set(cell, 0, vec_get(cell, 0) + 1)
    return vec_get(cell, 0)
  end
end

let tick = counter()
tick()
tick()
print("counter after three ticks: " + tick())
