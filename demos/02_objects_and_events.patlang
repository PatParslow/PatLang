# Demo 2: objects and events.
#
# Covers: classes with field defaults, methods, single inheritance, traits,
# operators as methods, named objects, identity semantics, when/emit, methods
# that declare the events they raise, and events raised by built-in operators.

# ---- traits are classes used for their methods ----

class Describable {
  make a function called describe takes self returns text
    return type_of(self) + " " + self.label
  end
}

class Priced {
  make a function called price_with_tax takes self returns p
    return self.price * 6 / 5
  end
}

# ---- a class, its fields and methods ----

class Item {
  field label = "item"
  field price = 0
  traits Describable, Priced
  make a function called rename takes self, to returns r
    self.label = to
    return self
  end
}

# ---- inheritance: Book has Item's fields and methods, and its own ----

class Book inherits Item {
  field pages = 0
  make a function called describe takes self returns text
    return "book '" + self.label + "', " + self.pages + " pages"
  end
}

print("== objects ==")
let mug = new("Item")
mug.label = "mug"
mug.price = 5
print(mug.describe())
print("with tax: " + mug.price_with_tax())

let novel = new("Book")
novel.label = "Persuasion"
novel.price = 10
novel.pages = 249
print(novel.describe())
print("with tax: " + novel.price_with_tax() + " (inherited through Item's trait)")
print("classes: " + type_of(mug) + ", " + type_of(novel))

# An object has identity: both names hold the same object.
let same = novel
same.rename("Emma")
print("renamed through another holder: " + novel.label)
print("same object: " + (same == novel) + ", equal fields but another object: " + (new("Item") == new("Item")))

# ---- operators are methods of the left operand's class ----

class Vec2 {
  field x = 0
  field y = 0
  make a function called + takes self, other returns sum
    return vec2(self.x + other.x, self.y + other.y)
  end
  make a function called * takes self, k returns scaled
    return vec2(self.x * k, self.y * k)
  end
  # < > <= and >= are each sent to the left operand's class, as the method of
  # that name; a class defines the ones it uses. == and != are never sent:
  # two objects are equal only when they are the same object, so equality by
  # content is a named method (and a method named == is refused).
  make a function called < takes self, other returns less
    return (self.x * self.x + self.y * self.y) < (other.x * other.x + other.y * other.y)
  end
  make a function called > takes self, other returns more
    return other < self
  end
  make a function called same_as takes self, other returns same
    return (self.x == other.x) and (self.y == other.y)
  end
  make a function called show takes self returns text
    return "(" + self.x + ", " + self.y + ")"
  end
}

make a function called vec2 takes x, y returns v
  let v = new("Vec2")
  v.x = x
  v.y = y
  return v
end

print("== operators ==")
let a = vec2(1, 2)
let b = vec2(10, 20)
let c = (a + b) * 3
print("(a + b) * 3 = " + c.show())
print("a < b: " + (a < b) + ", a > b: " + (a > b))
print("(a + b) same_as (11, 22): " + (a + b).same_as(vec2(11, 22)) + ", but == says " + ((a + b) == vec2(11, 22)))

# ---- named objects: found by name until object_delete ----

print("== named objects ==")
new("Item", "till")
send("till", "set", "label", "the till")
print(get("till", "label"))
print("deleted: " + object_delete("till") + ", then: " + type_of(get("till", "label")))

# ---- events: when registers a handler, emit raises the event ----

print("== events ==")
let log = vec_new()

when stock_low do
  vec_push(log, event_name + ": " + event_data)
end

when stock_low do
  vec_push(log, "second handler also ran")
end

emit("stock_low", "mugs")
print(vec_to_list(log))

# ---- a method declares the events it raises: the handler receives the
# receiver, the arguments and the result ----

class Account {
  field owner = ""
  field balance = 0
  make a function called deposit takes self, amount returns balance raises deposited
    require amount > 0
    self.balance = self.balance + amount
    return self.balance
  end
  make a function called withdraw takes self, amount returns balance raises withdrawn
    require amount <= self.balance
    self.balance = self.balance - amount
    return self.balance
  end
}

let audit = vec_new()

when deposited do
  vec_push(audit, event_data[0].owner + " +" + event_data[1] + " -> " + event_data[2])
end

when withdrawn do
  vec_push(audit, event_data[0].owner + " -" + event_data[1] + " -> " + event_data[2])
  if event_data[2] < 10 then
    emit("stock_low", event_data[0].owner + "'s balance")
  end
end

let acc = new("Account")
acc.owner = "ada"
acc.deposit(50)
acc.withdraw(45)
print(vec_to_list(audit))
print(vec_get(log, vec_len(log) - 2))

# ---- built-in operators raise events too: int's + raises added ----

let sums = vec_new()
when added do
  vec_push(sums, event_data[0] + " + " + event_data[1] + " = " + event_data[2])
end
let seven = 3 + 4
print(vec_to_list(sums))
