# Demo 5: the virtual file system, and real files.
#
# Covers: vfs_write, vfs_read, vfs_append, vfs_exists, vfs_list, vfs_delete,
# vfs_flush_to_disk; write_file, read_file, file_exists, list_dir,
# write_file_bytes, read_file_bytes, remove_file and path_absolute.
#
# The virtual file system is in memory and works everywhere, the browser
# included. Real files need a native build, or the interpreter, on Windows.
# The demo writes under demo5_out/ in the current directory and removes it.

make a function called in_vfs takes path returns yes
  return vfs_exists(path)
end

# A text's lines, without their line ends. (split_lines is a function of
# self_hosting/lib/includes.patlang, not of the runtime, so the demo has its
# own.)
make a function called text_lines takes text returns lines
  let lines = []
  let cur = sb_new()
  let i = 0
  while i < text.length do
    let c = char_code(text, i)
    if c == 10 then
      let lines = list_push(lines, sb_str(cur))
      let cur = sb_new()
    elif c != 13 then
      sb_push(cur, text[i])
    end
    let i = i + 1
  end
  if sb_len(cur) > 0 then
    let lines = list_push(lines, sb_str(cur))
  end
  return lines
end

make a function called ends_with takes text, suffix returns yes
  return substr(text, text.length - suffix.length, suffix.length) == suffix
end

# ---- a small key-value store on the virtual file system ----

make a function called kv_put takes key, value returns done
  vfs_write("/kv/" + key, value)
  vfs_append("/kv.log", "put " + key + chr(10))
  return true
end

make a function called kv_get takes key, fallback returns value
  if in_vfs("/kv/" + key) then
    return vfs_read("/kv/" + key)
  end
  return fallback
end

make a function called kv_keys returns keys
  let paths = vfs_list("/kv/")
  let keys = []
  let i = 0
  while i < list_len(paths) do
    let keys = list_push(keys, substr(paths[i], 4, paths[i].length - 4))
    let i = i + 1
  end
  return keys
end

print("== virtual file system ==")
kv_put("colour", "teal")
kv_put("size", "large")
kv_put("colour", "amber")
print("colour = " + kv_get("colour", "?") + ", weight = " + kv_get("weight", "(unset)"))
print("keys: " + kv_keys())
print("log has " + list_len(text_lines(vfs_read("/kv.log"))) + " lines")
print("delete size: " + vfs_delete("/kv/size") + ", again: " + vfs_delete("/kv/size"))
print("keys now: " + kv_keys())

# A file's contents can be any value, not only text.
vfs_write("/cache/primes", [2, 3, 5, 7, 11])
print("a list kept as a file: " + vfs_read("/cache/primes") + " (" + type_of(vfs_read("/cache/primes")) + ")")

# ---- real files ----

print("== real files ==")
let dir = "demo5_out"
write_file(dir + "/notes/hello.txt", "first line" + chr(10) + "second line" + chr(10))
print("exists: " + file_exists(dir + "/notes/hello.txt") + ", missing file reads as empty: " + (read_file(dir + "/nope.txt") == ""))
let lines = text_lines(read_file(dir + "/notes/hello.txt"))
print("lines read back: " + lines)

# Bytes, as a list of ints.
write_file_bytes(dir + "/data.bin", [80, 97, 116, 0, 255])
print("bytes 0..3: " + read_file_bytes(dir + "/data.bin", 0, 3) + ", from 3: " + read_file_bytes(dir + "/data.bin", 3, 100))

print("directory: " + list_dir(dir))
print("absolute path ends with the relative one: " + ends_with(path_absolute(dir + "/data.bin"), "demo5_out/data.bin"))

# ---- from memory to disk ----

print("== flush to disk ==")
vfs_write("report/summary.txt", "3 keys written")
vfs_write("report/detail.txt", vfs_read("/kv.log"))
print("files flushed: " + vfs_flush_to_disk("report/", dir))
print("on disk: " + list_dir(dir + "/report") + " -> " + read_file(dir + "/report/summary.txt"))

# ---- tidy up: files first, then the directories that held them ----

let doomed = [dir + "/report/summary.txt", dir + "/report/detail.txt", dir + "/report", dir + "/notes/hello.txt", dir + "/notes", dir + "/data.bin", dir]
let i = 0
let failed = 0
while i < list_len(doomed) do
  if remove_file(doomed[i]) != "OK" then
    let failed = failed + 1
  end
  let i = i + 1
end
print("removed, with " + failed + " failures; still there: " + file_exists(dir))
