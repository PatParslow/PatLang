# Unified Reasoning Syntax Examples for PATLANG
# This file demonstrates all the implemented parser extensions

# ==== TYPE CONSTRAINTS ====

# Basic type constraint
constrain x :: Number

# Type constraint with where condition
constrain age :: Number where age > 0

# Type constraint with complex condition
constrain score :: Number where score >= 0 and score <= 100

# Type constraint with dotted variable (object properties)
constrain user.name :: String
constrain config.timeout :: Number where config.timeout > 1000

# ==== GOAL DECLARATIONS ====

# Simple goal declaration
goal find_maximum(list) {
  postcondition: result > 0
}

# Goal with precondition and postcondition
goal sort_list(items) {
  precondition: items != nil,
  postcondition: sorted == true
}

# Goal with strategy specification
goal solve_puzzle {
  precondition: puzzle != nil,
  postcondition: solved == true,
  strategy: backtrack
}

# Goal with multiple strategies
goal optimize_route(start, end) {
  precondition: start != nil and end != nil,
  postcondition: distance_minimized == true,
  strategies: ["dijkstra", "a_star"]
}

# ==== LOGIC PROGRAMMING ====

# Facts (rules without conditions)
fact parent(john, mary)
fact parent(mary, alice)
fact parent(bob, john)
fact likes(alice, programming)
fact likes(mary, books)

# Rules with 'if' syntax (new unified syntax)
rule grandparent(X, Z) if parent(X, Y) and parent(Y, Z)
rule ancestor(X, Y) if parent(X, Y)
rule ancestor(X, Z) if parent(X, Y) and ancestor(Y, Z)
rule sibling(X, Y) if parent(Z, X) and parent(Z, Y) and X != Y

# Rules with traditional Prolog syntax (also supported)
rule uncle(X, Y) :- parent(Z, Y) and sibling(X, Z)

# ==== QUERIES ====

# Prolog-style queries with ?- prefix
?- parent(john, mary)
?- grandparent(bob, alice)
?- ancestor(X, alice)
?- likes(Who, programming)

# Traditional query syntax (also supported)
query parent(john, Who)
query likes(alice, What)

# ==== GOAL PURSUIT ====

# Pursue goals with parameters
pursue find_maximum([1, 5, 3, 9, 2])
pursue sort_list(unsorted_data)
pursue optimize_route(home, work)

# ==== REASONING MODE CONTROL ====

# Enable reasoning mode
reasoning mode on

# All the above constructs work within reasoning mode
constrain temperature :: Number where temperature > -273.15
goal maintain_temperature { postcondition: stable == true }
fact current_temp(22.5)
rule too_hot(T) if T > 30
?- too_hot(current_temp)

# Disable reasoning mode
reasoning mode off

# ==== COMPLEX COMBINATIONS ====

# Complex goal with multiple constraints and rules
goal balance_load(servers) {
  precondition: servers != nil and servers.length > 0,
  postcondition: balanced == true and max_load < threshold,
  strategy: round_robin
}

# Supporting facts and rules for load balancing
fact server_capacity(server1, 100)
fact server_capacity(server2, 150)
fact current_load(server1, 75)
fact current_load(server2, 80)

rule overloaded(Server) if current_load(Server, Load) and server_capacity(Server, Cap) and Load > Cap * 0.8
rule available(Server) if current_load(Server, Load) and server_capacity(Server, Cap) and Load < Cap * 0.6

# Queries to check system state
?- overloaded(X)
?- available(Y)

# Type constraints for the load balancing system
constrain load :: Number where load >= 0
constrain capacity :: Number where capacity > 0
constrain server.id :: String
constrain threshold :: Number where threshold > 0 and threshold <= 100