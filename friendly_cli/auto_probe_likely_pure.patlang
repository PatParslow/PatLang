# =============================================================================
# Driver: mechanized, subprocess-isolated probing of the wide
# likely_pure candidate pool (patlang_function_discovery.patlang's own
# discovery pass), skipping anything already hand-verified
# (spec_library/patlang_stdlib/) or already auto-probed
# (spec_library/patlang_stdlib_auto/) in an earlier run of this driver.
# See friendly_cli/lib/auto_prober.patlang's own header for the full
# methodology and its honest limits.
# =============================================================================

include "../self_hosting/lib/includes.patlang"
include "../self_hosting/lib/json.patlang"
include "../self_hosting/lib/test.patlang"
include "lib/path_discovery.patlang"
include "lib/patlang_function_discovery.patlang"
include "lib/spec_discovery_patlang.patlang"
include "lib/auto_prober.patlang"

let pat_exe = "rust-runtime/target/release/pat.exe"
let tmp_path = "friendly_cli/spec_scratch/auto_probe_tmp.patlang"

let all_functions = discover_all_patlang_functions()
let total = to_num(list_len(all_functions))
print("total function declarations found: " + ("" + total))

let probed_ok_count = 0
let no_guess_count = 0
let needs_manual_count = 0
let already_done_count = 0
let skipped_side_effecting = 0

let no_guess_log = sb_new()
let needs_manual_log = sb_new()

let i = 0
while i < total do
  let entry = all_functions[i]
  let name = entry[0]
  let params = entry[1]
  let file = entry[2]
  let risk = entry[3]
  let param_count = to_num(list_len(params))
  let qualified_id = qualify_function_id(file, name)

  if risk != "likely_pure" then
    let skipped_side_effecting = skipped_side_effecting + 1
  else
    if (already_has_patlang_spec(qualified_id)) or (auto_probe_already_has_spec(qualified_id)) then
      let already_done_count = already_done_count + 1
    else
      let result = auto_probe_function(pat_exe, name, param_count, file, tmp_path)
      if result[0] == "probed_ok" then
        let pair = result[1]
        auto_probe_write_spec(qualified_id, name, file, param_count, pair[0], pair[1])
        let probed_ok_count = probed_ok_count + 1
      else
        if result[0] == "needs_manual_fixture" then
          let needs_manual_count = needs_manual_count + 1
          sb_push(needs_manual_log, qualified_id + " (" + ("" + param_count) + " params)\n")
        else
          let no_guess_count = no_guess_count + 1
          sb_push(no_guess_log, qualified_id + " (" + ("" + param_count) + " params)\n")
        end
      end
    end
  end

  let i = i + 1
  if (i % 50) == 0 then
    print("... " + ("" + i) + "/" + ("" + total) + " processed (probed_ok=" + ("" + probed_ok_count) + " no_guess=" + ("" + no_guess_count) + " needs_manual=" + ("" + needs_manual_count) + " already_done=" + ("" + already_done_count) + ")")
  end
end

write_file("spec_library/patlang_stdlib_auto/NO_GUESS_WORKED.txt", sb_str(no_guess_log))
write_file("spec_library/patlang_stdlib_auto/NEEDS_MANUAL_FIXTURE.txt", sb_str(needs_manual_log))

print("=== auto-probe pass complete ===")
print("total: " + ("" + total))
print("skipped (side-effecting): " + ("" + skipped_side_effecting))
print("already documented (hand-verified or previously auto-probed): " + ("" + already_done_count))
print("probed_ok (new auto-probed specs written): " + ("" + probed_ok_count))
print("no_guess_worked (logged to NO_GUESS_WORKED.txt): " + ("" + no_guess_count))
print("needs_manual_fixture, >3 params (logged to NEEDS_MANUAL_FIXTURE.txt): " + ("" + needs_manual_count))
