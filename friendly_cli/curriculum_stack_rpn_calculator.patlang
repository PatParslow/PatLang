# Direct response to: "I was actually thinking about pushing values and
# operators onto a stack (list) ... could our system use that and learn
# to do arithmetic?" -- a genuine stack MACHINE (RPN evaluator): push
# numbers, and when an operator token is seen, pop the top two values,
# apply the operator, push the result back. This is a different shape
# from the relational Peano work above -- it's an ITERATIVE ALGORITHM
# (loop over tokens, list push/pop), squarely PatLang's own imperative
# side (lists + loops), not the logic engine.

include "../self_hosting/lib/includes.patlang"
include "../self_hosting/lib/test.patlang"
include "lib/curriculum_engine.patlang"

let pat_exe = "rust-runtime/target/release/pat.exe"
let model = "llama3.2"
let problem_prompt = "Write a PatLang function `eval_rpn` that takes one parameter `tokens` (a list of strings, each either a number like \"3\" or an operator: \"+\", \"-\", \"*\") and evaluates it as Reverse Polish Notation: read tokens left to right, push numbers onto a stack (a list), and when an operator is seen, pop the top two values (b=last pushed, a=second-to-last), compute a OP b, and push the result back. Return the final single value on the stack as a number. eval_rpn([\"3\",\"4\",\"+\"]) is 7. eval_rpn([\"5\",\"1\",\"2\",\"+\",\"4\",\"*\",\"+\",\"3\",\"-\"]) is 14 (this is the classic worked example: 1+2=3, 3*4=12, 5+12=17, 17-3=14)."

print("=== Tier 2/3: eval_rpn (stack-based RPN evaluator) ===")
let attempt = curriculum_try_llm(model, problem_prompt, "", [], "")
let code = attempt[0]
print("--- LLM code ---")
print(code)

let visible_cases = [["[\"3\",\"4\",\"+\"]", "7"], ["[\"5\",\"1\",\"2\",\"+\",\"4\",\"*\",\"+\",\"3\",\"-\"]", "14"]]
let all_visible_ok = true
let i = 0
while i < to_num(list_len(visible_cases)) do
  let case = visible_cases[i]
  let r = curriculum_run_one_check(pat_exe, code, "", "eval_rpn(" + case[0] + ")", case[1])
  print("eval_rpn(" + case[0] + ") expected=" + case[1] + " got=[" + r[1] + "] match=" + ("" + r[0]))
  if not r[0] then
    let all_visible_ok = false
  end
  let i = i + 1
end

let all_blind_ok = false
if all_visible_ok then
  # BLIND: subtraction/multiplication-only expressions never shown as
  # the PRIMARY visible pattern, and a NEGATIVE result -- real edge
  # cases the visible examples don't specifically isolate.
  let blind_cases = [["[\"10\",\"2\",\"-\"]", "8"], ["[\"6\",\"7\",\"*\"]", "42"], ["[\"2\",\"5\",\"-\"]", "-3"]]
  let all_blind_ok = true
  let bi = 0
  while bi < to_num(list_len(blind_cases)) do
    let case = blind_cases[bi]
    let r = curriculum_run_one_check(pat_exe, code, "", "eval_rpn(" + case[0] + ")", case[1])
    print("BLIND eval_rpn(" + case[0] + ") expected=" + case[1] + " got=[" + r[1] + "] match=" + ("" + r[0]))
    if not r[0] then
      let all_blind_ok = false
    end
    let bi = bi + 1
  end
end

if all_visible_ok and all_blind_ok then
  print("=== eval_rpn: LLM SUCCESS -- registering as llm_synthesized_function ===")
  curriculum_write_registry_entry("eval_rpn", "llm_synthesized_function", code,
    "{\"[3,4,+]\": \"7\", \"[5,1,2,+,4,*,+,3,-]\": \"14\"}",
    "{\"[10,2,-]\": \"8\", \"[6,7,*]\": \"42\", \"[2,5,-]\": \"-3\"}", "[]")
else
  print("=== eval_rpn: LLM attempt FAILED -- falling back to hand-authored ===")
  let hand_code = "make a function called eval_rpn takes tokens returns result\n  let stack = []\n  let i = 0\n  while i < to_num(list_len(tokens)) do\n    let tok = tokens[i]\n    if (tok == \"+\") or (tok == \"-\") or (tok == \"*\") then\n      let n = to_num(list_len(stack))\n      let b = stack[n - 1]\n      let a = stack[n - 2]\n      let stack = list_set(stack, n - 2, 0)\n      let new_stack = []\n      let j = 0\n      while j < n - 2 do\n        let new_stack = list_push(new_stack, stack[j])\n        let j = j + 1\n      end\n      let value = 0\n      if tok == \"+\" then\n        let value = a + b\n      end\n      if tok == \"-\" then\n        let value = a - b\n      end\n      if tok == \"*\" then\n        let value = a * b\n      end\n      let stack = list_push(new_stack, value)\n    else\n      let stack = list_push(stack, to_num(tok))\n    end\n    let i = i + 1\n  end\n  return stack[0]\nend\n"
  let hi = 0
  let hand_visible_ok = true
  while hi < to_num(list_len(visible_cases)) do
    let case = visible_cases[hi]
    let r = curriculum_run_one_check(pat_exe, hand_code, "", "eval_rpn(" + case[0] + ")", case[1])
    print("HAND eval_rpn(" + case[0] + ") expected=" + case[1] + " got=[" + r[1] + "] match=" + ("" + r[0]))
    if not r[0] then
      let hand_visible_ok = false
    end
    let hi = hi + 1
  end
  let blind_cases2 = [["[\"10\",\"2\",\"-\"]", "8"], ["[\"6\",\"7\",\"*\"]", "42"], ["[\"2\",\"5\",\"-\"]", "-3"]]
  let hand_blind_ok = true
  let hbi = 0
  while hbi < to_num(list_len(blind_cases2)) do
    let case = blind_cases2[hbi]
    let r = curriculum_run_one_check(pat_exe, hand_code, "", "eval_rpn(" + case[0] + ")", case[1])
    print("HAND BLIND eval_rpn(" + case[0] + ") expected=" + case[1] + " got=[" + r[1] + "] match=" + ("" + r[0]))
    if not r[0] then
      let hand_blind_ok = false
    end
    let hbi = hbi + 1
  end
  if hand_visible_ok and hand_blind_ok then
    print("=== eval_rpn: hand-authored fallback verified -- writing to reference_solutions (NOT the synthesis registry) ===")
    curriculum_write_reference_entry("eval_rpn", "hand_authored_function", hand_code,
      "{\"[3,4,+]\": \"7\", \"[5,1,2,+,4,*,+,3,-]\": \"14\"}",
      "{\"[10,2,-]\": \"8\", \"[6,7,*]\": \"42\", \"[2,5,-]\": \"-3\"}", "[]")
  else
    print("=== eval_rpn: even hand-authored failed?! -- not registering ===")
  end
end
