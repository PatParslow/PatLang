include "../self_hosting/lib/includes.patlang"
include "../self_hosting/lib/test.patlang"
include "lib/curriculum_engine.patlang"

let pat_exe = "rust-runtime/target/release/pat.exe"
let model = "llama3.2"
let problem_prompt = "Write a PatLang function `is_even` that takes one integer parameter `n` and returns true if n is even, false if n is odd. is_even(4) is true. is_even(7) is false. is_even(0) is true."

print("=== Tier 1: is_even ===")
let attempt = curriculum_try_llm(model, problem_prompt, "", [], "")
let code = attempt[0]
print("--- LLM code ---")
print(code)

let visible_cases = [["4", "true"], ["7", "false"], ["0", "true"]]
let all_visible_ok = true
let i = 0
while i < to_num(list_len(visible_cases)) do
  let case = visible_cases[i]
  let r = curriculum_run_one_check(pat_exe, code, "", "is_even(" + case[0] + ")", case[1])
  print("is_even(" + case[0] + ") expected=" + case[1] + " got=[" + r[1] + "] match=" + ("" + r[0]))
  if not r[0] then
    let all_visible_ok = false
  end
  let i = i + 1
end

let all_blind_ok = false
if all_visible_ok then
  let blind_cases = [["-4", "true"], ["-7", "false"]]
  let all_blind_ok = true
  let bi = 0
  while bi < to_num(list_len(blind_cases)) do
    let case = blind_cases[bi]
    let r = curriculum_run_one_check(pat_exe, code, "", "is_even(" + case[0] + ")", case[1])
    print("BLIND is_even(" + case[0] + ") expected=" + case[1] + " got=[" + r[1] + "] match=" + ("" + r[0]))
    if not r[0] then
      let all_blind_ok = false
    end
    let bi = bi + 1
  end
end

if all_visible_ok and all_blind_ok then
  print("=== is_even: LLM SUCCESS -- registering as llm_synthesized_function ===")
  curriculum_write_registry_entry("is_even", "llm_synthesized_function", code,
    "{\"4\": \"true\", \"7\": \"false\", \"0\": \"true\"}",
    "{\"-4\": \"true\", \"-7\": \"false\"}", "[]")
else
  print("=== is_even: LLM attempt FAILED -- falling back to hand-authored ===")
  let hand_code = "make a function called is_even takes n returns result\n  return (n % 2) == 0\nend\n"
  let hi = 0
  let hand_visible_ok = true
  while hi < to_num(list_len(visible_cases)) do
    let case = visible_cases[hi]
    let r = curriculum_run_one_check(pat_exe, hand_code, "", "is_even(" + case[0] + ")", case[1])
    print("HAND is_even(" + case[0] + ") expected=" + case[1] + " got=[" + r[1] + "] match=" + ("" + r[0]))
    if not r[0] then
      let hand_visible_ok = false
    end
    let hi = hi + 1
  end
  let blind_cases2 = [["-4", "true"], ["-7", "false"]]
  let hand_blind_ok = true
  let hbi = 0
  while hbi < to_num(list_len(blind_cases2)) do
    let case = blind_cases2[hbi]
    let r = curriculum_run_one_check(pat_exe, hand_code, "", "is_even(" + case[0] + ")", case[1])
    print("HAND BLIND is_even(" + case[0] + ") expected=" + case[1] + " got=[" + r[1] + "] match=" + ("" + r[0]))
    if not r[0] then
      let hand_blind_ok = false
    end
    let hbi = hbi + 1
  end
  if hand_visible_ok and hand_blind_ok then
    print("=== is_even: hand-authored fallback verified -- registering honestly as hand_authored_function ===")
    curriculum_write_registry_entry("is_even", "hand_authored_function", hand_code,
      "{\"4\": \"true\", \"7\": \"false\", \"0\": \"true\"}",
      "{\"-4\": \"true\", \"-7\": \"false\"}", "[]")
  else
    print("=== is_even: even hand-authored failed?! -- not registering ===")
  end
end
