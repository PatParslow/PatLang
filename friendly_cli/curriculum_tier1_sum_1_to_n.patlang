include "../self_hosting/lib/includes.patlang"
include "../self_hosting/lib/test.patlang"
include "lib/curriculum_engine.patlang"

let pat_exe = "rust-runtime/target/release/pat.exe"
let model = "llama3.2"
let problem_prompt = "Write a PatLang function `sum_1_to_n` that takes one parameter `n` (an integer) and returns the sum of all integers from 1 to n inclusive. sum_1_to_n(1) is 1. sum_1_to_n(5) is 15. sum_1_to_n(0) is 0 (an empty sum)."

print("=== Tier 1: sum_1_to_n ===")
let attempt = curriculum_try_llm(model, problem_prompt, "", [], "")
let code = attempt[0]
print("--- LLM code ---")
print(code)

let visible_cases = [["1", "1"], ["5", "15"], ["0", "0"]]
let all_visible_ok = true
let i = 0
while i < to_num(list_len(visible_cases)) do
  let case = visible_cases[i]
  let r = curriculum_run_one_check(pat_exe, code, "", "sum_1_to_n(" + case[0] + ")", case[1])
  print("sum_1_to_n(" + case[0] + ") expected=" + case[1] + " got=[" + r[1] + "] match=" + ("" + r[0]))
  if not r[0] then
    let all_visible_ok = false
  end
  let i = i + 1
end

let all_blind_ok = false
if all_visible_ok then
  let blind_cases = [["10", "55"], ["100", "5050"]]
  let all_blind_ok = true
  let bi = 0
  while bi < to_num(list_len(blind_cases)) do
    let case = blind_cases[bi]
    let r = curriculum_run_one_check(pat_exe, code, "", "sum_1_to_n(" + case[0] + ")", case[1])
    print("BLIND sum_1_to_n(" + case[0] + ") expected=" + case[1] + " got=[" + r[1] + "] match=" + ("" + r[0]))
    if not r[0] then
      let all_blind_ok = false
    end
    let bi = bi + 1
  end
end

if all_visible_ok and all_blind_ok then
  print("=== sum_1_to_n: LLM SUCCESS, all visible+blind pass -- registering as llm_synthesized_function ===")
  curriculum_write_registry_entry("sum_1_to_n", "llm_synthesized_function", code,
    "{\"1\": \"1\", \"5\": \"15\", \"0\": \"0\"}",
    "{\"10\": \"55\", \"100\": \"5050\"}", "[]")
else
  print("=== sum_1_to_n: LLM attempt FAILED -- falling back to hand-authored ===")
  let hand_code = "make a function called sum_1_to_n takes n returns result\n  let total = 0\n  let i = 1\n  while i <= n do\n    let total = total + i\n    let i = i + 1\n  end\n  return total\nend\n"
  let hi = 0
  let hand_visible_ok = true
  while hi < to_num(list_len(visible_cases)) do
    let case = visible_cases[hi]
    let r = curriculum_run_one_check(pat_exe, hand_code, "", "sum_1_to_n(" + case[0] + ")", case[1])
    print("HAND sum_1_to_n(" + case[0] + ") expected=" + case[1] + " got=[" + r[1] + "] match=" + ("" + r[0]))
    if not r[0] then
      let hand_visible_ok = false
    end
    let hi = hi + 1
  end
  let blind_cases2 = [["10", "55"], ["100", "5050"]]
  let hand_blind_ok = true
  let hbi = 0
  while hbi < to_num(list_len(blind_cases2)) do
    let case = blind_cases2[hbi]
    let r = curriculum_run_one_check(pat_exe, hand_code, "", "sum_1_to_n(" + case[0] + ")", case[1])
    print("HAND BLIND sum_1_to_n(" + case[0] + ") expected=" + case[1] + " got=[" + r[1] + "] match=" + ("" + r[0]))
    if not r[0] then
      let hand_blind_ok = false
    end
    let hbi = hbi + 1
  end
  if hand_visible_ok and hand_blind_ok then
    print("=== sum_1_to_n: hand-authored fallback verified -- writing to reference_solutions (NOT the synthesis registry) ===")
    curriculum_write_reference_entry("sum_1_to_n", "hand_authored_function", hand_code,
      "{\"1\": \"1\", \"5\": \"15\", \"0\": \"0\"}",
      "{\"10\": \"55\", \"100\": \"5050\"}", "[]")
  else
    print("=== sum_1_to_n: even the hand-authored version failed?! something is genuinely wrong, not registering ===")
  end
end
