# =============================================================================
# Driver: discover + verify Gherkin specs for the shell-command allowlist
# (spec-library slice 1). Only ever executes commands that are BOTH
# listed here AND have a hand-written verification probe in
# spec_discovery_engine.patlang -- see is_shell_command_allowlisted.
# =============================================================================

include "../self_hosting/lib/includes.patlang"
include "../self_hosting/lib/test.patlang"
include "../self_hosting/lib/json.patlang"
include "../self_hosting/lib/ollama.patlang"
include "lib/pe_subsystem.patlang"
include "lib/spec_discovery_engine.patlang"
include "lib/spec_manifest.patlang"

# Primary: a small, fast, free, local model (~2GB) -- the 24-27GB models
# on this machine measured well over 90 seconds just loading and don't
# comfortably fit in VRAM alongside anything else running.
let model_name = "llama3.2"

# Fallback (used at most once per command, only when the primary reply
# looks unusable): hermes, pinned to a free model tier rather than the
# paid default, per the user's own listed free options.
let hermes_model_name = "poolside/laguna-xs-2.1:free"

# "compress" isn't a real command on this machine at all (no such
# executable found); "expand"/"path"/"type" resolve either to a
# different tool of the same name (Git's text-reflow "expand", not a
# CAB-decompression tool) or to a cmd.exe BUILTIN with no standalone
# .exe at all (path, type) -- neither is safely drivable via
# exec_capture's direct-process-spawn shape without a shell indirection
# this tool deliberately doesn't add generically (see verify_find's own
# self-heal for why that's a narrow, hand-reviewed exception, not a
# general mechanism). Scoped this list to commands confirmed real,
# standalone, and read-only on this machine instead.
let commands = ["curl"]
let i = 0
while i < to_num(list_len(commands)) do
  let cmd = commands[i]
  let result = discover_shell_command_spec(cmd, model_name, hermes_model_name)
  let status = result[0]
  let source = result[1]
  manifest_upsert_entry(cmd, "shell", cmd + ".feature", source, status)
  let i = i + 1
end

print("[SPEC DISCOVERY] Done. See spec_library/shell/ and spec_library/manifest.json")
