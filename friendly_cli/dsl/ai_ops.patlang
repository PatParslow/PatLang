# =============================================================================
# AI Opinion Natural Syntax DSL for Friendly CLI
# Defines natural DSL syntax rules for requesting AI opinions.
# =============================================================================

syntax AIOpsDSL {
  trigger: Keyword("do_ai");
  tokens {
    Word(w) = regex("[a-zA-Z0-9_.-]+", w);
    StrLit(s) = regex("\"[^\"]*\"", s);
  }

  # Rule 1: get AI opinion on <file> saved to <output>
  rule FileOpinionRule {
    expect Symbol("get");
    expect Symbol("AI");
    expect Symbol("opinion");
    expect Symbol("on");
    let infile = expect StrLit;
    expect Symbol("saved");
    expect Symbol("to");
    let outfile = expect StrLit;
    return get_file_ai_opinion(infile, outfile);
  }

  # Rule 2: ask AI <prompt> saved to <output>
  rule PromptOpinionRule {
    expect Symbol("ask");
    expect Symbol("AI");
    let prompt = expect StrLit;
    expect Symbol("saved");
    expect Symbol("to");
    let outfile = expect StrLit;
    return query_ollama_ai_opinion(prompt, outfile);
  }
}
