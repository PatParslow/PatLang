# =============================================================================
# File Operations Syntax Pack for Friendly CLI
# Defines natural language DSL rules for novice file operations.
# =============================================================================

syntax FileOpsDSL {
  trigger: Keyword("do_files");
  tokens {
    Word(w) = regex("[a-zA-Z0-9_.-]+", w);
    StrLit(s) = regex("\"[^\"]*\"", s);
  }

  # Rule 1: convert all <ext> files in <folder> to <format>
  rule ConvertAllRule {
    expect Symbol("convert");
    expect Symbol("all");
    let ext = expect Word;
    expect Symbol("files");
    expect Symbol("in");
    let folder = expect StrLit;
    expect Symbol("to");
    let target = expect Word;
    return batch_convert_files(ext, folder, target);
  }

  # Rule 2: copy all <ext> files in <src> to <dest>
  rule CopyAllRule {
    expect Symbol("copy");
    expect Symbol("all");
    let ext = expect Word;
    expect Symbol("files");
    expect Symbol("in");
    let src = expect StrLit;
    expect Symbol("to");
    let dest = expect StrLit;
    return batch_copy_files(ext, src, dest);
  }

  # Rule 3: delete all <ext> files in <folder>
  rule DeleteAllRule {
    expect Symbol("delete");
    expect Symbol("all");
    let ext = expect Word;
    expect Symbol("files");
    expect Symbol("in");
    let folder = expect StrLit;
    return batch_delete_files(ext, folder);
  }
}
