# =============================================================================
# Natural Goal Syntax DSL for Friendly CLI
# Defines natural goal phrasing for reasoning engine.
# =============================================================================

syntax GoalOpsDSL {
  trigger: Keyword("do_goals");
  tokens {
    Word(w) = regex("[a-zA-Z0-9_.-]+", w);
    StrLit(s) = regex("\"[^\"]*\"", s);
  }

  # Rule 1: make pdfs from markdown in <folder>
  rule MakePdfsGoal {
    expect Symbol("make");
    expect Symbol("pdfs");
    expect Symbol("from");
    expect Symbol("markdown");
    expect Symbol("in");
    let folder = expect Word;
    return execute_goal_target("make_pdfs");
  }

  # Rule 2: archive the pdfs into <zipfile>
  rule ArchivePdfsGoal {
    expect Symbol("archive");
    expect Symbol("the");
    expect Symbol("pdfs");
    expect Symbol("into");
    let zipfile = expect Word;
    return execute_goal_target("archive_backup");
  }
}
