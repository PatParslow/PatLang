# =============================================================================
# Image Generation Natural Syntax DSL for Friendly CLI
# Defines natural DSL syntax rules for generating images.
# =============================================================================

syntax ImgGenOpsDSL {
  trigger: Keyword("do_imggen");
  tokens {
    Word(w) = regex("[a-zA-Z0-9_.-]+", w);
    StrLit(s) = regex("\"[^\"]*\"", s);
  }

  # Rule: create image of <prompt> saved to <output>
  rule CreateImageRule {
    expect Symbol("create");
    expect Symbol("image");
    expect Symbol("of");
    let prompt = expect StrLit;
    expect Symbol("saved");
    expect Symbol("to");
    let outfile = expect StrLit;
    return generate_image_skill(prompt, outfile);
  }
}
