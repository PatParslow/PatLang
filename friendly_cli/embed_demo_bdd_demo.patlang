# BDD-style verification of friendly_cli/embed_demo.patlang, using the
# existing Gherkin runner in self_hosting/lib/test.patlang. Run as a real
# black-box subprocess (embed_demo.patlang has no interactive input, so
# this just captures its deterministic output), matching
# friendly_cli/terminal_bdd_demo.patlang's approach for its own
# subprocess.

include "../self_hosting/lib/includes.patlang"
include "../self_hosting/lib/proc.patlang"
include "../self_hosting/lib/includes.patlang"
include "../self_hosting/lib/gherkin.patlang"

make a function called ed_pat_exe returns path
  return "rust-runtime/target/release/pat.exe"
end

# ---- step definitions ----

make a function called st_ed_run takes ctx returns done
  let out = exec_capture_io(ed_pat_exe(), ["--ir-run", "friendly_cli/embed_demo.patlang"], "")
  ctx_set(ctx, "ed_stdout", out[0])
  return true
end

make a function called st_ed_no_friendly_cli_dependency_ran takes ctx returns done
  expect(ctx, "the demo announces it has no friendly_cli dependency", contains_text(ctx_get(ctx, "ed_stdout"), "no friendly_cli dependency"), true)
  return true
end

make a function called st_ed_task_marked_done takes ctx returns done
  expect(ctx, "task 0 is marked done after 'done 0'", contains_text(ctx_get(ctx, "ed_stdout"), "[done] write the embeddability demo"), true)
  return true
end

make a function called st_ed_invalid_index_handled_richly takes ctx returns done
  expect(ctx, "an out-of-range index produces a rich ArgumentMismatch event, not a crash", contains_text(ctx_get(ctx, "ed_stdout"), "\"event\":\"error\",\"message\":\"done failed\""), true)
  expect(ctx, "the rich event's detail explains the valid range", contains_text(ctx_get(ctx, "ed_stdout"), "there are 2 task(s), indexed from 0"), true)
  return true
end

make a function called st_ed_agent_mode_events_collected takes ctx returns done
  expect(ctx, "agent-mode json events for ordinary successes are present in the collected transcript", contains_text(ctx_get(ctx, "ed_stdout"), "{\"event\":\"ok\",\"message\":\"help completed\",\"detail\":\"\"}"), true)
  return true
end

make a function called register_embed_demo_steps takes ctx returns done
  step(ctx, "embed_demo.patlang is run as a standalone subprocess", "st_ed_run")
  step(ctx, "it confirms it has no friendly_cli dependency", "st_ed_no_friendly_cli_dependency_ran")
  step(ctx, "the first task ends up marked done", "st_ed_task_marked_done")
  step(ctx, "an out-of-range done index is handled richly, not fatally", "st_ed_invalid_index_handled_richly")
  step(ctx, "agent-mode json events appear in its collected transcript", "st_ed_agent_mode_events_collected")
  return true
end

make a function called embed_demo_feature returns text
  return "Feature: embed_demo proves console.patlang is genuinely embeddable

Scenario: a fixed command batch runs through console_step with no friendly_cli dependency
  Given embed_demo.patlang is run as a standalone subprocess
  Then it confirms it has no friendly_cli dependency
  And the first task ends up marked done
  And an out-of-range done index is handled richly, not fatally
  And agent-mode json events appear in its collected transcript
"
end

make a function called run_embed_demo_bdd takes ctx returns ok
  register_embed_demo_steps(ctx)
  run_feature(ctx, embed_demo_feature())
  ctx_report(ctx)
  return ctx_failed(ctx) == 0
end

let ctx = ctx_new()
run_embed_demo_bdd(ctx)
