# =============================================================================
# Adaptive Compilation Timing Predictor & Regression Engine
# Implements persistent linear regression with gradient descent updates
# to learn compiling startup overhead (bias) and speed (weight) over time.
# =============================================================================

# --- Load Weights from Disk ---
make a function called load_regression_weights returns weights
  let path = "friendly_cli/compile_history.data"
  let exists = file_exists(path) == "1"
  
  if not exists then
    # Defaults: w = 35.0 ms/line, bias = 5000.0 ms startup overhead
    return [35.0, 5000.0]
  end

  let content = read_file(path)
  # Simple parser: content format is "w,b"
  let comma_idx = -1
  let n = content.length
  let i = 0
  while i < n do
    if char_code(content, i) == 44 then # ','
      let comma_idx = i
      let i = n
    end
    let i = i + 1
  end

  if comma_idx < 0 then
    return [35.0, 5000.0]
  end

  let w_str = substr(content, 0, comma_idx)
  let b_str = substr(content, comma_idx + 1, n - comma_idx - 1)
  return [to_num(w_str), to_num(b_str)]
end

# --- Save Weights to Disk ---
make a function called save_regression_weights takes w, b returns ok
  let data_str = "" + w + "," + b
  write_file("friendly_cli/compile_history.data", data_str)
  return true
end

# --- Predict Time: T = (w * Lines) + b ---
make a function called predict_compile_duration takes lines returns ms
  let weights = load_regression_weights()
  let w = weights[0]
  let b = weights[1]
  let estimate = (w * lines) + b
  return estimate
end

# --- Learn via Gradient Descent ---
make a function called update_model_weights takes lines, actual_ms returns ok
  let weights = load_regression_weights()
  let w = weights[0]
  let b = weights[1]

  # Prediction error
  let pred = (w * lines) + b
  let error = pred - actual_ms

  # Learning rate (extremely small to prevent scaling overflow)
  # Since lines are large (1000+), w_step uses tiny learning rate
  let alpha_w = 0.000005
  let alpha_b = 0.05

  # Gradient updates
  let grad_w = error * lines
  let grad_b = error

  # Adjust parameters
  let new_w = w - (alpha_w * grad_w)
  let new_b = b - (alpha_b * grad_b)

  # Enforce sane floors
  if new_w < 1.0 then
    let new_w = 1.0
  end
  if new_b < 500.0 then
    let new_b = 500.0
  end

  print("  [MODEL LEARN] Updated w: " + new_w + " ms/line, Bias: " + new_b + " ms")
  save_regression_weights(new_w, new_b)
  return true
end
