# =============================================================================
# Friendly CLI Ollama AI Opinion Engine
# Invokes local Ollama models with DbC contracts and GOAP action bindings.
# =============================================================================

# --- DbC Contract-Protected Ollama Invoker ---

make a function called query_ollama_ai_opinion takes prompt, out_path returns ok
  let prompt_ok = prompt.length > 0
  require prompt_ok == true

  print("  [OLLAMA AI] Querying local model (tinyllama) for opinion...")
  print("  [PROMPT] " + prompt)

  # Spawns local Ollama model
  let response = exec_capture("ollama", "run", "tinyllama", prompt)
  
  # Save AI opinion result to disk
  write_file(out_path, response)

  # Postcondition contract: verify AI response file created and non-empty
  let file_ok = (file_exists(out_path) == "1") or (file_exists(out_path) == true)
  let content_ok = response.length > 0
  ensure file_ok == true
  ensure content_ok == true

  print("[CONTRACT PASS] AI opinion saved to " + out_path + " (" + response.length + " chars).")
  return true
end

make a function called get_file_ai_opinion takes in_file, out_path returns ok
  let src_ok = (file_exists(in_file) == "1") or (file_exists(in_file) == true)
  require src_ok == true

  let file_text = read_file(in_file)
  let prompt = "Please give a brief 1-sentence opinion on this document content: " + substr(file_text, 0, 200)
  
  return query_ollama_ai_opinion(prompt, out_path)
end

# --- GOAP Action Registration for AI Opinion ---

make a function called register_ai_opinion_actions returns ok
  action_add("act_ai_opinion_doc", 
    [["has_md", ["docs"]]], 
    [["has_ai_opinion", ["docs"]]], 
    [], 1)

  action_bind("act_ai_opinion_doc", |args| {
    print("[SMART GOAP EXECUTING] Step: Querying Ollama AI opinion on Markdown document...")
    return get_file_ai_opinion("friendly_cli/test_src/doc1.md", "friendly_cli/test_dest/doc1_opinion.txt")
  })

  return true
end
