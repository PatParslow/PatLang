# =============================================================================
# Friendly CLI Smart Preprocessor
# Transforms block syntax formats like `goal:\n line1\n line2\n\n` into standard
# `syntax` triggers so novices don't need `{}` or wrapper functions.
# =============================================================================

make a function called str_find_double_newline takes s, from_pos returns idx
  let n = s.length
  let i = from_pos
  while i <= (n - 2) do
    if (char_code(s, i) == 10) and (char_code(s, i + 1) == 10) then
      return i
    end
    let i = i + 1
  end
  return -1
end

make a function called preprocess_friendly_goals takes raw_input returns patlang_src
  # Look for "goal:\n" or "goal:" blocks ended by a double newline \n\n or EOF
  let n = raw_input.length
  let i = 0
  let out = ""
  let in_goal = false
  
  let lines = split_lines(raw_input)
  let num_lines = lines.length
  let line_idx = 0
  let goal_body = ""
  
  while line_idx < num_lines do
    let line = lines[line_idx]
    let trimmed = str_trim(line)
    
    if (trimmed == "goal:") or (trimmed == "goals:") then
      let in_goal = true
      let goal_body = ""
    else
      if in_goal then
        if trimmed == "" then
          # Double newline / empty line signals end of goal block!
          let out = out + "do_goals {\n" + goal_body + "}\n"
          let in_goal = false
          let goal_body = ""
        else
          let goal_body = goal_body + "  " + line + "\n"
        end
      else
        let out = out + line + "\n"
      end
    end
    let line_idx = line_idx + 1
  end
  
  if in_goal then
    let out = out + "do_goals {\n" + goal_body + "}\n"
  end
  
  return out
end
