# Infrastructure for packaging a discovered GOAP loop composition into a
# new reusable action -- see synthesis_experiment_goap_package_loop.
# patlang's header for the full discipline explanation. Each check runs
# in its own FRESH subprocess (RULES/ACTIONS are accumulate-only
# thread_local state, so a growing set of stale counters from earlier
# checks would otherwise add branching factor to later searches within
# the same process -- exactly the failure this file's isolation avoids).

include "../../self_hosting/lib/includes.patlang"
include "../../self_hosting/lib/test.patlang"
include "../../self_hosting/lib/synthesis_recursive.patlang"

make a function called goap_pkg_build_script takes n, use_shortcut returns src
  let sb = sb_new()
  sb_push(sb, "include \"../../self_hosting/lib/includes.patlang\"\n")
  let i = 1
  while i <= 20 do
    sb_push(sb, "rule_add(\"pred1\", [\"" + ("" + i) + "\", \"" + ("" + (i - 1)) + "\"], [])\n")
    let i = i + 1
  end
  sb_push(sb, "action_add(\"decrement\", [[\"counter\", [\"Id\", \"X\"]], [\"pred1\", [\"X\", \"X2\"]]], [[\"counter\", [\"Id\", \"X2\"]]], [[\"counter\", [\"Id\", \"X\"]]], 1)\n")
  if use_shortcut then
    sb_push(sb, "action_add(\"decrement_to_zero\", [[\"counter\", [\"Id\", \"X\"]]], [[\"counter\", [\"Id\", \"0\"]]], [[\"counter\", [\"Id\", \"X\"]]], 1)\n")
  end
  sb_push(sb, "rule_add(\"counter\", [\"t\", \"" + ("" + n) + "\"], [])\n")
  sb_push(sb, "let result = plan([[\"counter\", [\"t\", \"0\"]]])\n")
  sb_push(sb, "print(to_num(list_len(result)))\n")
  sb_push(sb, "print(result)\n")
  return sb_str(sb)
end

make a function called goap_pkg_run takes n, use_shortcut returns lines
  let script = goap_pkg_build_script(n, use_shortcut)
  let tmp_path = "friendly_cli/spec_scratch/_goap_pkg_test.patlang"
  write_file(tmp_path, script)
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", tmp_path)
  return synth2_split_lines(out)
end
