# Generic string-building infrastructure for GOAP -- v2, replacing the
# hardcoded-ASCII-alphabet/full-closure approach after: "I feel that
# defining all the alphabet separately is an annoying and slightly dodgy
# approach, and would be troublesome if we move to unicode. Could we not
# ... (lazily?) generate the alphabet in use and pass that in..."
#
# Two changes from v1:
# 1. ALPHABET IS DERIVED, not hand-picked: collect_alphabet(strings)
#    extracts the deduplicated set of characters actually appearing
#    across whatever strings are in play, using len()/substr() -- both
#    already Unicode-safe (host_len/host_substr iterate by .chars(),
#    i.e. code points, not bytes) -- so this works unchanged for any
#    script, not just ASCII a-z.
# 2. FACTS ARE GENERATED "LAZILY" (targeted, not a full closure):
#    instead of pre-building the whole alphabet^max_len universe (which
#    forced a small alphabet + short bound to stay under hosts.rs's
#    NODE_CAP=5000), emit_targeted_concat_facts only emits concat facts
#    for prefixes actually ALONG the path from start to target, times
#    the FULL alphabet at each step (so real decoys still exist at every
#    state -- a wrong branch just dead-ends one step later, since no
#    further facts extend it). Fact count is linear in
#    (target_len * alphabet_size), not exponential, and needs no
#    hardcoded bound at all.

include "../../self_hosting/lib/includes.patlang"
include "../../self_hosting/lib/test.patlang"

# Generic, Unicode-safe: derive the alphabet actually in use from
# whatever strings are given, rather than hand-picking one.
make a function called collect_alphabet takes strings returns alphabet
  let alphabet = []
  let si = 0
  while si < to_num(list_len(strings)) do
    let s = strings[si]
    let n = to_num(len(s))
    let i = 0
    while i < n do
      let c = substr(s, i, 1)
      let already = false
      let ai = 0
      while ai < to_num(list_len(alphabet)) do
        if alphabet[ai] == c then
          let already = true
        end
        let ai = ai + 1
      end
      if not already then
        let alphabet = list_push(alphabet, c)
      end
      let i = i + 1
    end
    let si = si + 1
  end
  return alphabet
end

# Emits concat(prefix, char, prefix+char) facts ONLY for prefixes along
# the true path from start_prefix to target, branching over the FULL
# derived alphabet at each step (so decoys are genuine -- a wrong char
# choice dead-ends, since nothing extends it further). use_prepend=true
# builds char+prefix instead, for the reversal domain (in which case
# "target" here means the desired FINAL built string, walked back
# through the same consuming order as append -- see the driver for how
# the two are paired).
make a function called emit_targeted_concat_facts takes start_prefix, target, alphabet, use_prepend returns src
  let sb = sb_new()
  let start_len = to_num(len(start_prefix))
  let target_len = to_num(len(target))
  let i = start_len
  while i < target_len do
    let correct_prefix = substr(target, 0, i)
    if use_prepend then
      let correct_prefix = substr(target, target_len - i, i)
    end
    let ai = 0
    while ai < to_num(list_len(alphabet)) do
      let c = alphabet[ai]
      let newval = correct_prefix + c
      if use_prepend then
        let newval = c + correct_prefix
      end
      sb_push(sb, "rule_add(\"concat\", [\"" + correct_prefix + "\", \"" + c + "\", \"" + newval + "\"], [])\n")
      let ai = ai + 1
    end
    let i = i + 1
  end
  return sb_str(sb)
end
