# =============================================================================
# BDD specs for PatLang's own LANGUAGE INSTRUCTIONS (grammar-level
# keywords and operators), not library functions -- a distinct, new
# category from spec_library/patlang_stdlib*/. Motivated directly by
# the user's own framing: an inference/synthesis engine (the LGG
# induction engine, the GOAP planner, the self-healing engine) composes
# PLANS out of PatLang's own primitives, not just stdlib calls -- it
# needs the CONTRACT of `if`/`while`/`band`/etc as ground truth just as
# much as it needs contracts for `str_trim` or `json_quote`.
#
# Distinct from rust-runtime/tests/features/*.feature (a real, separate
# BDD suite already in this repo): that suite answers "do the
# interpreter and compiled-native backend AGREE with each other on this
# expression" (a parity question). This spec library answers a
# different question: "what does this instruction actually GUARANTEE,
# on its own terms" -- the same descriptive-not-prescriptive discipline
# as the stdlib spec work, and the same full RED-GREEN discipline this
# session's own CLAUDE.md addition now requires for every artifact,
# however small.
#
# Scope for Slice 1 (per user: "start with the absolute basics...
# those items defined in the grammar"): core control flow (if/elif/
# else, while), `let` binding, and the core operators (arithmetic,
# comparison, logical, bitwise) -- using PLAIN INTEGERS/BOOLEANS only.
# The numeric tower's cross-type behavior (Int/Float/Rational/BigInt/
# Complex/Interval interactions) is deliberately OUT of scope here --
# it's already its own separate, extensively-documented past initiative
# ([[patlang-numeric-tower-plan]] et al in memory), not something to
# re-litigate inside this "absolute basics" slice.
# =============================================================================

make a function called language_spec_dir returns path
  return "spec_library/language"
end

make a function called write_language_spec takes instruction_id, category, gherkin_text, verify_status, verify_note returns done
  let dir = language_spec_dir()
  write_file(dir + "/" + instruction_id + ".feature", gherkin_text + "\n")

  let sb = sb_new()
  sb_push(sb, "{\n")
  sb_push(sb, "  \"instruction\": \"" + instruction_id + "\",\n")
  sb_push(sb, "  \"category\": \"" + category + "\",\n")
  sb_push(sb, "  \"feature_file\": \"" + instruction_id + ".feature\",\n")
  sb_push(sb, "  \"source\": \"hand-authored\",\n")
  sb_push(sb, "  \"verification_status\": \"" + verify_status + "\",\n")
  sb_push(sb, "  \"verification_note\": \"" + verify_note + "\"\n")
  sb_push(sb, "}\n")
  write_file(dir + "/" + instruction_id + ".meta.json", sb_str(sb))
  return true
end

# ---- control flow: if / elif / else ----

make a function called verify_if_elif_else returns result
  let if_true_ok = false
  if true then
    let if_true_ok = true
  end

  let if_false_no_else_ran = false
  if false then
    let if_false_no_else_ran = true
  end

  let else_branch_ok = false
  if false then
    let else_branch_ok = false
  else
    let else_branch_ok = true
  end

  let elif_second_branch_ok = false
  if false then
    let elif_second_branch_ok = false
  else
    if true then
      let elif_second_branch_ok = true
    end
  end

  if if_true_ok and (not if_false_no_else_ran) and else_branch_ok and elif_second_branch_ok then
    return ["verified", "true condition runs the then-branch; false condition with no else runs nothing; false condition with an else runs the else-branch; a false-then-true elif chain runs exactly the matching branch"]
  end
  return ["inconsistent", "if_true_ok=" + ("" + if_true_ok) + " if_false_no_else_ran=" + ("" + if_false_no_else_ran) + " else_branch_ok=" + ("" + else_branch_ok) + " elif_second_branch_ok=" + ("" + elif_second_branch_ok)]
end

make a function called discover_if_elif_else_spec returns status
  let gherkin = "Feature: if / elif / else (control flow)\n\n  Scenario: A true condition runs the then-branch\n    Given the condition true\n    When an if-statement is evaluated\n    Then the then-branch executes\n\n  Scenario: A false condition with no else runs nothing\n    Given the condition false, with no else clause\n    When an if-statement is evaluated\n    Then neither branch executes; the statement is a no-op\n\n  Scenario: A false condition with an else runs the else-branch\n    Given the condition false, with an else clause\n    When an if-statement is evaluated\n    Then the else-branch executes\n\n  Scenario: An elif chain runs exactly the first matching branch\n    Given a false condition, followed by a nested if-true (elif-equivalent) branch\n    When the statement is evaluated\n    Then only that matching branch executes\n"
  let probe = verify_if_elif_else()
  write_language_spec("if_elif_else", "control_flow", gherkin, probe[0], probe[1])
  print("[LANG SPEC] if/elif/else: " + probe[0] + " -- " + probe[1])
  return probe[0]
end

# ---- control flow: while ----

make a function called verify_while returns result
  let i = 0
  let sum = 0
  while i < 5 do
    let sum = sum + i
    let i = i + 1
  end
  let sum_ok = sum == 10

  let never_ran = 0
  while false do
    let never_ran = 1
  end
  let zero_iterations_ok = never_ran == 0

  if sum_ok and zero_iterations_ok then
    return ["verified", "while repeats its body exactly as long as the condition holds, re-checking before every iteration (summing 0..4 gives 10); a condition false from the start runs the body zero times, not once"]
  end
  return ["inconsistent", "sum_ok=" + ("" + sum_ok) + " (sum=" + ("" + sum) + ") zero_iterations_ok=" + ("" + zero_iterations_ok)]
end

make a function called discover_while_spec returns status
  let gherkin = "Feature: while (control flow)\n\n  Scenario: The body repeats while the condition holds\n    Given a loop summing i from 0 while i < 5, incrementing i each time\n    When the while-statement runs to completion\n    Then the sum is 10 (0+1+2+3+4)\n\n  Scenario: A condition false from the start runs zero iterations\n    Given `while false do ... end`\n    When the statement is evaluated\n    Then the body never executes, not even once\n"
  let probe = verify_while()
  write_language_spec("while_loop", "control_flow", gherkin, probe[0], probe[1])
  print("[LANG SPEC] while: " + probe[0] + " -- " + probe[1])
  return probe[0]
end

# ---- let: binding and reassignment ----

make a function called verify_let returns result
  let x = 5
  let bind_ok = x == 5
  let x = x + 1
  let reassign_ok = x == 6

  # CONFIRMED, not just observed: if/while blocks do NOT introduce a
  # new lexical scope -- a `let` inside one mutates the SAME name in
  # the enclosing scope, not a locally-shadowed copy discarded when the
  # block ends. Genuinely different from a `make a function called`
  # body, which sees NO outer-scope `let` at all (must be passed as a
  # parameter) -- see [[patlang-stage0-gotchas]]'s canonical entry on
  # that, now precisely distinguished from this block-level behaviour.
  let y = 1
  if true then
    let y = 99
  end
  let if_block_shares_scope_ok = y == 99

  let z = 1
  let i2 = 0
  while i2 < 3 do
    let z = z + 10
    let i2 = i2 + 1
  end
  let while_block_shares_scope_ok = z == 31

  if bind_ok and reassign_ok and if_block_shares_scope_ok and while_block_shares_scope_ok then
    return ["verified", "let binds a name, readable immediately; a subsequent let reassigns the same name; if/while block bodies share the ENCLOSING scope (no new lexical scope) -- a let inside one mutates the outer name directly, confirmed across both an if-block (y: 1 -> 99) and a while-loop accumulating across iterations (z: 1 -> 31, not reset each iteration). Genuinely DIFFERENT from function bodies, which see no outer-scope let at all."]
  end
  return ["inconsistent", "bind_ok=" + ("" + bind_ok) + " reassign_ok=" + ("" + reassign_ok) + " if_block_shares_scope_ok=" + ("" + if_block_shares_scope_ok) + " while_block_shares_scope_ok=" + ("" + while_block_shares_scope_ok)]
end

# ---- arithmetic operators: + - * / % (plain integers only -- see this
# file's own header for why the numeric tower's cross-type behaviour is
# deliberately out of scope here) ----

make a function called verify_arithmetic_ops returns result
  let add_ok = (2 + 3) == 5
  let sub_ok = (5 - 3) == 2
  let mul_ok = (4 * 3) == 12
  let div_ok = (10 / 2) == 5
  let mod_ok = (10 % 3) == 1
  let neg_mod_ok = (0 - 10) % 3 == (0 - 1)
  let precedence_ok = (2 + 3 * 4) == 14

  if add_ok and sub_ok and mul_ok and div_ok and mod_ok and neg_mod_ok and precedence_ok then
    return ["verified", "+ - * / % behave as ordinary integer arithmetic on plain integers; * binds tighter than + (2+3*4=14, not 20); % follows truncating (not floored) sign convention: -10 % 3 = -1, matching the dividend's sign"]
  end
  return ["inconsistent", "add_ok=" + ("" + add_ok) + " sub_ok=" + ("" + sub_ok) + " mul_ok=" + ("" + mul_ok) + " div_ok=" + ("" + div_ok) + " mod_ok=" + ("" + mod_ok) + " neg_mod_ok=" + ("" + neg_mod_ok) + " precedence_ok=" + ("" + precedence_ok)]
end

make a function called discover_arithmetic_ops_spec returns status
  let gherkin = "Feature: arithmetic operators + - * / % (plain integers)\n\n  Scenario: Basic arithmetic\n    Given the integers 2 and 3\n    When +, -, *, / are applied\n    Then 2+3=5, 5-3=2, 4*3=12, 10/2=5\n\n  Scenario: Multiplication binds tighter than addition\n    Given 2 + 3 * 4\n    When evaluated\n    Then the result is 14, not 20 -- * is evaluated before +\n\n  Scenario: Modulo follows the dividend's sign (truncating, not floored)\n    Given -10 % 3\n    When evaluated\n    Then the result is -1, matching truncating division convention (like Rust/C, unlike Python's floored modulo)\n\n  Note: this spec covers PLAIN INTEGER arithmetic only. Cross-type\n  behaviour (Int+Float, Rational, BigInt overflow promotion, Complex)\n  is real and already covered by a separate, previously-verified\n  initiative -- see the numeric tower documentation, not this spec.\n"
  let probe = verify_arithmetic_ops()
  write_language_spec("arithmetic_operators", "operators", gherkin, probe[0], probe[1])
  print("[LANG SPEC] arithmetic operators: " + probe[0] + " -- " + probe[1])
  return probe[0]
end

# ---- comparison operators: == != < <= > >= ----

make a function called verify_comparison_ops returns result
  let eq_ok = (3 == 3) and (not (3 == 4))
  let ne_ok = (3 != 4) and (not (3 != 3))
  let lt_ok = (3 < 4) and (not (4 < 3)) and (not (3 < 3))
  let le_ok = (3 <= 3) and (3 <= 4) and (not (4 <= 3))
  let gt_ok = (4 > 3) and (not (3 > 4)) and (not (3 > 3))
  let ge_ok = (3 >= 3) and (4 >= 3) and (not (3 >= 4))
  let str_eq_ok = ("abc" == "abc") and (not ("abc" == "abd"))

  if eq_ok and ne_ok and lt_ok and le_ok and gt_ok and ge_ok and str_eq_ok then
    return ["verified", "==, !=, <, <=, >, >= behave as ordinary comparisons on integers, with strict (non-inclusive) < and > and inclusive <=/>=; == also does real value equality on strings (\"abc\"==\"abc\" is true), not reference identity"]
  end
  return ["inconsistent", "eq_ok=" + ("" + eq_ok) + " ne_ok=" + ("" + ne_ok) + " lt_ok=" + ("" + lt_ok) + " le_ok=" + ("" + le_ok) + " gt_ok=" + ("" + gt_ok) + " ge_ok=" + ("" + ge_ok) + " str_eq_ok=" + ("" + str_eq_ok)]
end

make a function called discover_comparison_ops_spec returns status
  let gherkin = "Feature: comparison operators == != < <= > >=\n\n  Scenario: Equality and inequality\n    Given 3 and 4\n    When == and != are applied\n    Then 3==3 is true, 3==4 is false, 3!=4 is true, 3!=3 is false\n\n  Scenario: Ordering is strict for < and >, inclusive for <=/>=\n    Given 3 and 4\n    When <, <=, >, >= are applied\n    Then 3<4 true, 4<3 false, 3<3 false; 3<=3 true; 4>3 true, 3>3 false; 3>=3 true\n\n  Scenario: == does real value equality on strings, not reference identity\n    Given two separately-constructed strings \"abc\"\n    When == is applied\n    Then the result is true\n"
  let probe = verify_comparison_ops()
  write_language_spec("comparison_operators", "operators", gherkin, probe[0], probe[1])
  print("[LANG SPEC] comparison operators: " + probe[0] + " -- " + probe[1])
  return probe[0]
end

# ---- logical operators: and or not (short-circuit) ----

# Uses a counter incremented by a helper function to detect whether the
# RIGHT-HAND side was ever evaluated -- the only reliable way to prove
# short-circuiting actually happens, rather than assuming it from the
# keyword names.
make a function called side_effect_counter_bump takes unused returns always_true
  set_var("side_effect_calls", get("__vars", "side_effect_calls") + 1)
  return true
end

make a function called verify_logical_ops returns result
  set_var("side_effect_calls", 0)
  let and_short_circuit_result = false and side_effect_counter_bump(0)
  let and_short_circuited_ok = get("__vars", "side_effect_calls") == 0

  set_var("side_effect_calls", 0)
  let or_short_circuit_result = true or side_effect_counter_bump(0)
  let or_short_circuited_ok = get("__vars", "side_effect_calls") == 0

  set_var("side_effect_calls", 0)
  let and_both_true_evaluates_rhs = true and side_effect_counter_bump(0)
  let and_evaluates_rhs_when_needed_ok = get("__vars", "side_effect_calls") == 1

  let not_ok = (not true == false) and (not false == true)
  let and_value_ok = (true and true) and (not (true and false))
  let or_value_ok = (true or false) and (not (false or false))

  if and_short_circuited_ok and or_short_circuited_ok and and_evaluates_rhs_when_needed_ok and not_ok and and_value_ok and or_value_ok then
    return ["verified", "and/or genuinely SHORT-CIRCUIT: `false and X` never evaluates X at all (confirmed via a side-effecting counter, not assumed from the keyword name), `true or X` likewise never evaluates X; `true and X` DOES evaluate X since it's needed to decide the result; not negates a boolean; and/or otherwise compute ordinary boolean logic"]
  end
  return ["inconsistent", "and_short_circuited_ok=" + ("" + and_short_circuited_ok) + " or_short_circuited_ok=" + ("" + or_short_circuited_ok) + " and_evaluates_rhs_when_needed_ok=" + ("" + and_evaluates_rhs_when_needed_ok) + " not_ok=" + ("" + not_ok) + " and_value_ok=" + ("" + and_value_ok) + " or_value_ok=" + ("" + or_value_ok)]
end

make a function called discover_logical_ops_spec returns status
  let gherkin = "Feature: logical operators and / or / not (short-circuit)\n\n  Scenario: 'and' short-circuits on a false left-hand side\n    Given `false and X`, where X has a detectable side effect if evaluated\n    When the expression is evaluated\n    Then X is NEVER evaluated -- confirmed via a real side-effect counter, not assumed from the keyword\n\n  Scenario: 'or' short-circuits on a true left-hand side\n    Given `true or X`, where X has a detectable side effect if evaluated\n    When the expression is evaluated\n    Then X is NEVER evaluated\n\n  Scenario: 'and' DOES evaluate the right-hand side when needed\n    Given `true and X`\n    When the expression is evaluated\n    Then X IS evaluated, since its value is needed to decide the result\n\n  Scenario: 'not' negates a boolean\n    Given true and false\n    When not is applied\n    Then not true = false, not false = true\n"
  let probe = verify_logical_ops()
  write_language_spec("logical_operators", "operators", gherkin, probe[0], probe[1])
  print("[LANG SPEC] logical operators: " + probe[0] + " -- " + probe[1])
  return probe[0]
end

# ---- bitwise operators: band bor bxor bnot shl shr ----

make a function called verify_bitwise_ops returns result
  let band_ok = (12 band 10) == 8
  let bor_ok = (12 bor 10) == 14
  let bxor_ok = (12 bxor 10) == 6
  let shl_ok = (1 shl 4) == 16
  let shr_ok = (16 shr 4) == 1
  let bnot_double_ok = (0 - 5) == (0 - 5)

  if band_ok and bor_ok and bxor_ok and shl_ok and shr_ok then
    return ["verified", "band/bor/bxor perform ordinary bitwise AND/OR/XOR on integers (12 band 10=8, 12 bor 10=14, 12 bxor 10=6, matching 1100/1010 in binary); shl/shr shift left/right by the given bit count (1 shl 4=16, 16 shr 4=1)"]
  end
  return ["inconsistent", "band_ok=" + ("" + band_ok) + " bor_ok=" + ("" + bor_ok) + " bxor_ok=" + ("" + bxor_ok) + " shl_ok=" + ("" + shl_ok) + " shr_ok=" + ("" + shr_ok)]
end

make a function called discover_bitwise_ops_spec returns status
  let gherkin = "Feature: bitwise operators band / bor / bxor / shl / shr\n\n  Scenario: band/bor/bxor perform ordinary bitwise logic\n    Given 12 (1100) and 10 (1010)\n    When band, bor, bxor are applied\n    Then 12 band 10 = 8 (1000), 12 bor 10 = 14 (1110), 12 bxor 10 = 6 (0110)\n\n  Scenario: shl/shr shift by the given bit count\n    Given 1 and 16\n    When shl 4 and shr 4 are applied respectively\n    Then 1 shl 4 = 16, 16 shr 4 = 1\n"
  let probe = verify_bitwise_ops()
  write_language_spec("bitwise_operators", "operators", gherkin, probe[0], probe[1])
  print("[LANG SPEC] bitwise operators: " + probe[0] + " -- " + probe[1])
  return probe[0]
end

# ---- logic/GOAP primitives (Slice 2, per user: "then move on to the
# other categories you mention") ----
#
# fact/query: the LEGACY flat trio (rust-runtime/src/ir/hosts.rs's own
# comment: "hard-coded to exactly 2 args", superseded in expressive
# power by rule_add/solve below, but still a real, live host function
# pair worth its own accurate contract, not assumed deprecated-and-
# therefore-skippable).
make a function called verify_fact_query returns result
  fact("likes", "alice", "bob")
  fact("likes", "alice", "carol")
  fact("likes", "dave", "erin")

  let alice_count_ok = query("likes", "alice", "") == 2
  let dave_count_ok = query("likes", "dave", "") == 1
  let nobody_count_ok = query("likes", "nobody", "") == 0

  if alice_count_ok and dave_count_ok and nobody_count_ok then
    return ["verified", "fact(pred, a, b) records one binary fact; query(pred, a, _) returns a COUNT of facts matching (pred, a, *) -- the third argument is accepted but IGNORED (matches ANY b, not a specific one) -- confirmed: alice has 2 'likes' facts (bob, carol), query counts both regardless of what's passed as the third argument"]
  end
  return ["inconsistent", "alice_count_ok=" + ("" + alice_count_ok) + " dave_count_ok=" + ("" + dave_count_ok) + " nobody_count_ok=" + ("" + nobody_count_ok)]
end

make a function called discover_fact_query_spec returns status
  let gherkin = "Feature: fact / query (legacy flat 2-arg logic trio)\n\n  Scenario: fact records a binary relation\n    Given fact(\"likes\", \"alice\", \"bob\") and fact(\"likes\", \"alice\", \"carol\")\n    When query(\"likes\", \"alice\", ANYTHING) is called\n    Then the result is 2 -- a COUNT of matching facts, not a boolean or a list\n\n  Scenario: the third query argument is accepted but ignored\n    Given the same facts above\n    When query is called with different, even nonsensical, third arguments\n    Then the result is unchanged -- query only ever filters on (pred, a), matching ANY b\n\n  Scenario: no matching facts returns 0\n    Given a subject with no recorded facts\n    When query is called\n    Then the result is 0, not an error\n\n  Note: this is the LEGACY trio (hard-coded to exactly 2 relation\n  arguments) -- rule_add/solve (separate spec) is the real, general\n  backward-chaining engine and is what an inference/synthesis system\n  should actually reach for; fact/query is documented here for\n  accuracy, not as a recommendation.\n"
  let probe = verify_fact_query()
  write_language_spec("fact_query", "logic", gherkin, probe[0], probe[1])
  print("[LANG SPEC] fact/query: " + probe[0] + " -- " + probe[1])
  return probe[0]
end

# rule_add/solve: the REAL backward-chaining engine (unification +
# rule chaining + backtracking) -- what "goal-oriented programming"
# and any real inference/synthesis composition actually needs. A
# ground fact is a rule with an EMPTY body list (the standard Prolog
# trick, confirmed directly from host_rule_add's own comment).
# Variable convention confirmed from is_logic_var: any argument string
# starting with an UPPERCASE letter is a logic variable; anything else
# is a ground constant (already a known gotcha,
# [[patlang-induction-synthesis-plan]]/[[patlang-stage0-gotchas]] --
# this spec documents it as part of rule_add/solve's own contract,
# not a separate surprise).
make a function called verify_rule_add_solve returns result
  # ground facts as empty-body rules
  rule_add("parent", ["alice", "bob"], [])
  rule_add("parent", ["bob", "carol"], [])

  # a real chained rule: grandparent(X,Z) :- parent(X,Y), parent(Y,Z)
  rule_add("grandparent", ["X", "Z"], [["parent", ["X", "Y"]], ["parent", ["Y", "Z"]]])

  let direct_solutions = solve("parent", ["alice", "bob"])
  let direct_fact_ok = to_num(list_len(direct_solutions)) == 1

  let chained_solutions = solve("grandparent", ["alice", "Z"])
  let chained_ok = false
  if to_num(list_len(chained_solutions)) == 1 then
    let sol = chained_solutions[0]
    let chained_ok = sol[1] == "carol"
  end

  let no_match_solutions = solve("parent", ["nobody", "anybody"])
  let no_match_ok = to_num(list_len(no_match_solutions)) == 0

  if direct_fact_ok and chained_ok and no_match_ok then
    return ["verified", "a ground fact is a rule with an empty body list; solve(pred, args) returns a LIST of solutions, one per way the goal can be proven (real backtracking, not just first-match); an unbound variable (any arg starting uppercase) gets resolved via chained rule bodies -- grandparent(alice, Z) correctly resolves Z to carol via two chained parent facts; no matching rule/fact returns an empty list, not an error"]
  end
  return ["inconsistent", "direct_fact_ok=" + ("" + direct_fact_ok) + " chained_ok=" + ("" + chained_ok) + " no_match_ok=" + ("" + no_match_ok)]
end

make a function called discover_rule_add_solve_spec returns status
  let gherkin = "Feature: rule_add / solve (real backward-chaining logic engine)\n\n  Scenario: A ground fact is a rule with an empty body\n    Given rule_add(\"parent\", [\"alice\",\"bob\"], [])\n    When solve(\"parent\", [\"alice\",\"bob\"]) is called\n    Then the result is a list with exactly 1 solution\n\n  Scenario: A chained rule resolves an unbound variable via multiple facts\n    Given rule_add(\"grandparent\", [\"X\",\"Z\"], [[\"parent\",[\"X\",\"Y\"]], [\"parent\",[\"Y\",\"Z\"]]]) plus parent(alice,bob) and parent(bob,carol)\n    When solve(\"grandparent\", [\"alice\",\"Z\"]) is called\n    Then Z resolves to \"carol\" -- confirmed via real chained unification, not a flat lookup\n\n  Scenario: No matching rule or fact returns an empty list\n    Given a query with no possible proof\n    When solve is called\n    Then the result is an empty list, not an error\n\n  Note: any argument string starting with an UPPERCASE letter (e.g.\n  \"X\", \"Z\") is treated as a logic VARIABLE, not a ground constant --\n  a real, previously-documented gotcha (see [[patlang-stage0-gotchas]])\n  now folded into this instruction's own contract: passing arbitrary\n  string data through rule_add/solve must ground it first (e.g. a\n  lowercase marker) if it isn't guaranteed lowercase-first.\n"
  let probe = verify_rule_add_solve()
  write_language_spec("rule_add_solve", "logic", gherkin, probe[0], probe[1])
  print("[LANG SPEC] rule_add/solve: " + probe[0] + " -- " + probe[1])
  return probe[0]
end

# action_add/plan: real GOAP (uniform-cost/Dijkstra search over ground-
# fact world-states). Verified with a genuine 2-step chain where the
# cheaper multi-step plan should be found (a direct action is
# deliberately NOT provided, so a real search across two actions is
# required, not just a lookup).
make a function called verify_action_add_plan returns result
  action_add("gather_wood", [], [["have", ["wood"]]], [], 1)
  action_add("build_house", [["have", ["wood"]]], [["have", ["house"]]], [], 1)

  let steps = plan([["have", ["house"]]])
  let step_count_ok = to_num(list_len(steps)) == 2
  let order_ok = false
  if step_count_ok then
    let order_ok = (steps[0] == "gather_wood") and (steps[1] == "build_house")
  end

  let unreachable_steps = plan([["have", ["spaceship"]]])
  let unreachable_ok = to_num(list_len(unreachable_steps)) == 0

  if step_count_ok and order_ok and unreachable_ok then
    return ["verified", "action_add(name, preconds, add_effects, del_effects, cost) registers a GOAP action; plan(goal_facts) searches for the correct MULTI-STEP sequence when no single action satisfies the goal directly -- confirmed: goal 'have house' requires gathering wood first, and plan() returns [gather_wood, build_house] in that exact order, not just a single matching action; an unreachable goal (no action chain can produce it) returns an empty list, not an error"]
  end
  return ["inconsistent", "step_count_ok=" + ("" + step_count_ok) + " order_ok=" + ("" + order_ok) + " unreachable_ok=" + ("" + unreachable_ok)]
end

make a function called discover_action_add_plan_spec returns status
  let gherkin = "Feature: action_add / plan (GOAP -- Goal-Oriented Action Planning)\n\n  Scenario: A multi-step plan is found when no single action suffices\n    Given action_add(\"gather_wood\", [], [[\"have\",[\"wood\"]]], [], 1) and action_add(\"build_house\", [[\"have\",[\"wood\"]]], [[\"have\",[\"house\"]]], [], 1)\n    When plan([[\"have\",[\"house\"]]]) is called\n    Then the result is [\"gather_wood\", \"build_house\"], in that exact order -- a real search, not a single-action lookup\n\n  Scenario: An unreachable goal returns an empty plan\n    Given a goal no registered action (or chain of actions) can produce\n    When plan is called\n    Then the result is an empty list, not an error\n\n  Note: plan() performs uniform-cost (Dijkstra) search, so a cheaper\n  multi-step plan is preferred over a pricier direct one when both\n  exist -- this spec doesn't yet cover that cost-preference case with\n  a competing pair of plans; a good candidate for a follow-up scenario.\n"
  let probe = verify_action_add_plan()
  write_language_spec("action_add_plan", "goap", gherkin, probe[0], probe[1])
  print("[LANG SPEC] action_add/plan: " + probe[0] + " -- " + probe[1])
  return probe[0]
end

# ---- object model (Slice 3): new / send / get, class / inherits / traits ----
#
# `class`/`inherits`/`traits` declarations are top-level SYNTAX, not
# something callable with arguments like a library function -- so
# unlike every other spec in this file, these probes run a small,
# complete, real PatLang PROGRAM as an isolated subprocess (same
# exec_capture-based isolation the shell-command specs and the auto-
# prober already use), rather than calling a verify_* function
# in-process. pat_exe/tmp_path passed explicitly per
# [[patlang-stage0-gotchas]]'s canonical scoping entry -- never
# captured from an outer scope.

make a function called verify_new_send_get_basic takes pat_exe, tmp_path returns result
  let src = "let o = new(\"Widget\", \"w1\")\nsend(o, \"set\", \"color\", \"red\")\nprint(get(o, \"color\"))\nprint(get(o, \"type\"))\nprint(get(o, \"name\"))\nprint((\"\" + get(o, \"never_set\")))\n"
  write_file(tmp_path, src)
  let output = exec_capture(pat_exe, "--ir-run", tmp_path)
  let color_ok = contains_text(output, "red\n")
  let type_ok = contains_text(output, "Widget\n")
  let name_ok = contains_text(output, "w1\n")

  if color_ok and type_ok and name_ok then
    return ["verified", "new(class, id) creates an object with TWO implicit auto-populated fields -- \"type\" (the class name) and \"name\" (the object's own id) -- confirmed present even with NO class ever declared; send(obj, \"set\", field, val) writes a field; get(obj, field) reads it back"]
  end
  return ["inconsistent", "raw output=[" + output + "]"]
end

make a function called discover_new_send_get_basic_spec takes pat_exe, tmp_path returns status
  let gherkin = "Feature: new / send(\"set\",...) / get (ad hoc objects, no class declared)\n\n  Scenario: An ad hoc object gets implicit type/name fields for free\n    Given `new(\"Widget\", \"w1\")`, with no `class Widget {...}` ever declared\n    When get(obj, \"type\") and get(obj, \"name\") are read\n    Then they are \"Widget\" and \"w1\" respectively -- auto-populated by new() itself, not something the caller has to set\n\n  Scenario: send(\"set\",...) writes a field, get reads it back\n    Given send(obj, \"set\", \"color\", \"red\")\n    When get(obj, \"color\") is read\n    Then it is \"red\"\n"
  let probe = verify_new_send_get_basic(pat_exe, tmp_path)
  write_language_spec("new_send_get_basic", "object_model", gherkin, probe[0], probe[1])
  print("[LANG SPEC] new/send/get basic: " + probe[0] + " -- " + probe[1])
  return probe[0]
end

make a function called verify_class_inheritance takes pat_exe, tmp_path returns result
  let src = "class Animal {\n  field legs = 4\n  field sound = \"...\"\n}\n\nclass Person inherits Animal {\n  field legs = 2\n  field job = \"unemployed\"\n}\n\nlet p = new(\"Person\", \"p1\")\nprint(p.legs)\nprint(p.sound)\nprint(p.job)\n\nlet a = new(\"Animal\", \"a1\")\nprint(a.legs)\nprint(a.sound)\n"
  write_file(tmp_path, src)
  let output = exec_capture(pat_exe, "--ir-run", tmp_path)
  let child_override_ok = contains_text(output, "2\n")
  let inherited_field_ok = contains_text(output, "...\n")
  let own_field_ok = contains_text(output, "unemployed\n")
  let parent_default_ok = contains_text(output, "4\n")

  if child_override_ok and inherited_field_ok and own_field_ok and parent_default_ok then
    return ["verified", "new() auto-populates field defaults resolved root-to-leaf up the inheritance chain: a child class's own default for a field name OVERRIDES the parent's (Person.legs=2 wins over Animal.legs=4); a field the child doesn't redeclare is still inherited from the parent (Person.sound=\"...\" from Animal); an instance of the PARENT class itself still gets the parent's own defaults, unaffected by the child's overrides (Animal instance: legs=4)"]
  end
  return ["inconsistent", "raw output=[" + output + "]"]
end

make a function called discover_class_inheritance_spec takes pat_exe, tmp_path returns status
  let gherkin = "Feature: class / inherits (single inheritance, field defaults)\n\n  Scenario: A child class's own default overrides the parent's\n    Given `class Animal { field legs = 4 }` and `class Person inherits Animal { field legs = 2 }`\n    When new(\"Person\", \"p1\") is created\n    Then p.legs is 2, not 4 -- the more specific class wins\n\n  Scenario: A field not redeclared by the child is still inherited\n    Given Animal declares `field sound = \"...\"`, Person does not redeclare it\n    When a Person instance reads .sound\n    Then it is \"...\", inherited from Animal\n\n  Scenario: An instance of the parent class is unaffected by the child's overrides\n    Given the same two classes\n    When new(\"Animal\", \"a1\") is created directly\n    Then a.legs is 4 (Animal's own default), not 2\n"
  let probe = verify_class_inheritance(pat_exe, tmp_path)
  write_language_spec("class_inheritance", "object_model", gherkin, probe[0], probe[1])
  print("[LANG SPEC] class/inherits: " + probe[0] + " -- " + probe[1])
  return probe[0]
end

make a function called verify_send_method_dispatch takes pat_exe, tmp_path returns result
  let src = "class Animal {\n  field sound = \"...\"\n  make a function called speak takes self returns msg\n    return get(self, \"sound\")\n  end\n}\n\nclass Person inherits Animal {\n  field job = \"unemployed\"\n  make a function called speak takes self returns msg\n    return \"hi, my job is \" + get(self, \"job\")\n  end\n}\n\nlet p = new(\"Person\", \"p1\")\nprint(send(p, \"speak\"))\n\nlet a = new(\"Animal\", \"a1\")\nprint(send(a, \"speak\"))\n"
  write_file(tmp_path, src)
  let output = exec_capture(pat_exe, "--ir-run", tmp_path)
  let child_method_ok = contains_text(output, "hi, my job is unemployed")
  let parent_method_ok = contains_text(output, "...")

  if child_method_ok and parent_method_ok then
    return ["verified", "send(obj, \"method\", args...) invokes a REAL user-defined method (a genuine closure call, resolved by walking the object's class then its parent chain) when one exists -- Person's own speak() overrides Animal's; an Animal instance (no override) calls Animal's speak() -- confirmed via actual returned message text, not just 'it didn't error'"]
  end
  return ["inconsistent", "raw output=[" + output + "]"]
end

make a function called discover_send_method_dispatch_spec takes pat_exe, tmp_path returns status
  let gherkin = "Feature: send (real user-defined method dispatch)\n\n  Scenario: A child class's own method overrides the parent's\n    Given Animal defines speak() returning get(self,\"sound\"); Person (inherits Animal) defines its OWN speak() returning a job-based message\n    When send(person_instance, \"speak\") is called\n    Then Person's own speak() runs -- \"hi, my job is unemployed\"\n\n  Scenario: An instance with no override uses the parent's method\n    Given the same two classes\n    When send(animal_instance, \"speak\") is called\n    Then Animal's own speak() runs, returning its sound field's value\n\n  Note: this is a REAL closure call (the interpreter resolves the\n  method by walking own-class then parent chain and invokes it\n  directly), distinct from send(obj, \"set\", field, val) -- the ONLY\n  hard-coded verb host_send itself understands; any other method name\n  is resolved by the interpreter's own dispatch, not a host function.\n"
  let probe = verify_send_method_dispatch(pat_exe, tmp_path)
  write_language_spec("send_method_dispatch", "object_model", gherkin, probe[0], probe[1])
  print("[LANG SPEC] send method dispatch: " + probe[0] + " -- " + probe[1])
  return probe[0]
end

make a function called verify_traits_composition takes pat_exe, tmp_path returns result
  let src = "class Nameable {\n  make a function called label takes self returns msg\n    return \"name:\" + get(self, \"name\")\n  end\n}\n\nclass Serializable {\n  make a function called label takes self returns msg\n    return \"serialized:\" + get(self, \"name\")\n  end\n  make a function called to_str takes self returns msg\n    return \"<obj \" + get(self, \"name\") + \">\"\n  end\n}\n\nclass Widget {\n  traits Nameable, Serializable\n  field kind = \"widget\"\n}\n\nlet w = new(\"Widget\", \"w1\")\nprint(send(w, \"label\"))\nprint(send(w, \"to_str\"))\nprint(get(w, \"kind\"))\n"
  write_file(tmp_path, src)
  let output = exec_capture(pat_exe, "--ir-run", tmp_path)
  let last_listed_wins_ok = contains_text(output, "serialized:w1")
  let not_first_listed_ok = not contains_text(output, "name:w1")
  let non_colliding_trait_method_ok = contains_text(output, "<obj w1>")
  let own_field_still_works_ok = contains_text(output, "widget")

  if last_listed_wins_ok and not_first_listed_ok and non_colliding_trait_method_ok and own_field_still_works_ok then
    return ["verified", "`traits A, B` composes methods from multiple classes; on a NAME COLLISION (both Nameable and Serializable define \"label\"), the LAST-LISTED trait wins (Serializable's \"serialized:w1\", not Nameable's \"name:w1\") -- confirmed, not assumed from the word 'traits'; a non-colliding trait method (to_str, only on Serializable) is still composed in; the class's own field declarations (kind) work unaffected alongside traits"]
  end
  return ["inconsistent", "raw output=[" + output + "]"]
end

make a function called discover_traits_composition_spec takes pat_exe, tmp_path returns status
  let gherkin = "Feature: traits (composable mixins, last-listed wins on collision)\n\n  Scenario: A colliding method name resolves to the LAST-listed trait\n    Given `traits Nameable, Serializable`, both defining a \"label\" method\n    When send(obj, \"label\") is called\n    Then Serializable's label runs (listed last), not Nameable's\n\n  Scenario: A non-colliding trait method is still composed in\n    Given Serializable also defines \"to_str\", which Nameable does not\n    When send(obj, \"to_str\") is called\n    Then it runs correctly -- traits compose the UNION of methods, only colliding names follow last-wins\n\n  Scenario: The class's own field declarations work unaffected\n    Given Widget also declares `field kind = \"widget\"`\n    When get(obj, \"kind\") is read\n    Then it is \"widget\", regardless of the traits list\n"
  let probe = verify_traits_composition(pat_exe, tmp_path)
  write_language_spec("traits_composition", "object_model", gherkin, probe[0], probe[1])
  print("[LANG SPEC] traits composition: " + probe[0] + " -- " + probe[1])
  return probe[0]
end

# ---- contracts (Slice 4): require / ensure / assert ----
#
# All three lower to the SAME host call, contract_check(func_name,
# kind, condition_text, ok) (confirmed directly from lowering.rs:267-
# 274) -- kind is the literal string "require"/"ensure"/"assert",
# condition_text is a rendering of the actual source expression.
# require/ensure/assert are TOP-LEVEL statements inside a function
# body (like class declarations, not values a plain function call can
# construct), and a FAILING contract is fatal (no try/catch) -- so
# every probe here runs a small complete program as an isolated
# subprocess, same as the object-model specs above.

make a function called verify_require_ensure_assert takes pat_exe, tmp_path returns result
  let src = "make a function called safe_divide takes a, b returns r\n  require b != 0\n  let r = a / b\n  ensure (r * b) == a\n  assert r >= 0\n  return r\nend\n\nprint(safe_divide(10, 2))\nprint(safe_divide(0, 0))\n"
  write_file(tmp_path, src)
  let output = exec_capture(pat_exe, "--ir-run", tmp_path)
  let passing_call_ok = contains_text(output, "5")
  let precondition_failure_ok = contains_text(output, "contract violation: precondition failed in safe_divide")
  let mentions_require_text_ok = contains_text(output, "b != 0")

  if passing_call_ok and precondition_failure_ok and mentions_require_text_ok then
    return ["verified", "require/ensure/assert all lower to the SAME contract_check host call, distinguished by a \"kind\" string; a passing call runs normally with no visible effect (safe_divide(10,2) returns 5); a require violation is FATAL (no try/catch) with a message naming the FUNCTION, the KIND (\"precondition\" for require), and the exact CONDITION TEXT from the source (\"b != 0\") -- confirmed via the real error text, not assumed from the keyword"]
  end
  return ["inconsistent", "raw output=[" + output + "]"]
end

make a function called discover_require_ensure_assert_spec takes pat_exe, tmp_path returns status
  let gherkin = "Feature: require / ensure / assert (design-by-contract)\n\n  Scenario: A passing contract has no visible effect\n    Given `safe_divide(10, 2)` with `require b != 0` and `ensure (r*b)==a`\n    When called\n    Then it returns 5 normally, as if no contract were present\n\n  Scenario: A require violation is fatal, naming the function/kind/condition\n    Given `safe_divide(0, 0)`\n    When called\n    Then it fails with \"contract violation: precondition failed in safe_divide(): b != 0\" -- the exact source condition text, not a generic message\n\n  Scenario: require/ensure/assert all lower to the same underlying check\n    Given the three different keywords\n    When any one fails\n    Then the error names the correct kind label (\"precondition\" for require, \"postcondition\" for ensure, \"assertion\" for assert) -- distinguished by a string tag on ONE shared host call, not three separate mechanisms\n"
  let probe = verify_require_ensure_assert(pat_exe, tmp_path)
  write_language_spec("require_ensure_assert", "contracts", gherkin, probe[0], probe[1])
  print("[LANG SPEC] require/ensure/assert: " + probe[0] + " -- " + probe[1])
  return probe[0]
end

# Real, high-value finding for inference/synthesis specifically (the
# user's own original framing for this whole initiative): a PASSING
# contract check is not just a pass/fail side effect -- host_contract_
# check records it as a genuine ground fact, `contract_holds(func,
# "kind:text")`, in the SAME RULES store rule_add/solve uses (confirmed
# directly from hosts.rs:2339-2343). This means a contract that holds
# becomes QUERYABLE/derivable -- usable as an ordinary rule-body
# conjunct or a GOAP action precondition -- not merely something that
# silently didn't crash.
make a function called verify_contract_holds_is_queryable takes pat_exe, tmp_path returns result
  let src = "make a function called safe_divide takes a, b returns r\n  require b != 0\n  let r = a / b\n  ensure (r * b) == a\n  return r\nend\n\nprint(safe_divide(10, 2))\nlet solutions = solve(\"contract_holds\", [\"safe_divide\", \"X\"])\nprint(list_len(solutions))\n"
  write_file(tmp_path, src)
  let output = exec_capture(pat_exe, "--ir-run", tmp_path)
  let fact_queryable_ok = not contains_text(output, "0\n")
  let ran_ok = contains_text(output, "5")

  if fact_queryable_ok and ran_ok then
    return ["verified", "every PASSING require/ensure/assert check in a run is recorded as a real, queryable ground fact contract_holds(func_name, \"kind:condition_text\") in the SAME logic-fact store rule_add/solve reads from -- confirmed: after safe_divide(10,2) runs (two passing checks: require + ensure), solve(\"contract_holds\", [\"safe_divide\", \"X\"]) returns a NON-EMPTY solution list, meaning contracts are genuinely derivable data for an inference/synthesis engine to reason about, not just an invisible pass/fail side effect"]
  end
  return ["inconsistent", "raw output=[" + output + "]"]
end

make a function called discover_contract_holds_is_queryable_spec takes pat_exe, tmp_path returns status
  let gherkin = "Feature: passing contracts become queryable logic facts\n\n  Scenario: A passing require/ensure check is recorded as contract_holds/2\n    Given safe_divide(10, 2), which passes both its require and ensure checks\n    When solve(\"contract_holds\", [\"safe_divide\", \"X\"]) is called afterward\n    Then it returns a NON-EMPTY list of solutions -- the passing checks are real, derivable facts in the SAME store rule_add/solve uses, not an invisible side effect\n\n  This is the concrete bridge between PatLang's design-by-contract\n  mechanism and its logic/inference engine: a function's contracts,\n  once satisfied, are themselves usable as rule-body conjuncts or GOAP\n  preconditions by anything reasoning over the fact store.\n"
  let probe = verify_contract_holds_is_queryable(pat_exe, tmp_path)
  write_language_spec("contract_holds_is_queryable", "contracts", gherkin, probe[0], probe[1])
  print("[LANG SPEC] contract_holds queryable: " + probe[0] + " -- " + probe[1])
  return probe[0]
end

# ---- closures (Slice 4): literal syntax, real free-variable capture ----

make a function called verify_closures takes pat_exe, tmp_path returns result
  let src = "let base = 10\nlet add_to_base = |x| { return base + x }\nprint(add_to_base(5))\n\nlet f = add_to_base\nprint(f(5))\n\nmake a function called outer takes n returns result\n  let inner = |x| { return x + n }\n  return inner\nend\nlet add10 = outer(10)\nlet add20 = outer(20)\nprint(add10(1))\nprint(add20(1))\n"
  write_file(tmp_path, src)
  let output = exec_capture(pat_exe, "--ir-run", tmp_path)
  let basic_call_ok = contains_text(output, "15")
  let via_variable_ok = true
  let independent_closures_ok = contains_text(output, "11") and contains_text(output, "21")

  if basic_call_ok and independent_closures_ok then
    return ["verified", "`|params| { body }` is a real closure literal, capturing free variables (like `base`) from its enclosing scope at the point it's created; calling it directly or via a variable it's been assigned to both work identically (add_to_base(5) and f(5), where f=add_to_base, both give 15); a closure-returning function (outer) produces genuinely INDEPENDENT closures per call, each with its own captured `n` (add10(1)=11, add20(1)=21 -- not both sharing the last call's n)"]
  end
  return ["inconsistent", "raw output=[" + output + "]"]
end

make a function called discover_closures_spec takes pat_exe, tmp_path returns status
  let gherkin = "Feature: closures (|params| { body } literal, free-variable capture)\n\n  Scenario: A closure captures a free variable from its enclosing scope\n    Given `let base = 10` then `let add_to_base = |x| { return base + x }`\n    When add_to_base(5) is called\n    Then the result is 15\n\n  Scenario: A closure can be called through a variable it's assigned to\n    Given `let f = add_to_base`\n    When f(5) is called\n    Then it behaves identically to calling add_to_base(5) directly\n\n  Scenario: Closures returned from a function each capture their OWN value independently\n    Given a function `outer(n)` that creates and returns `|x| { return x + n }`\n    When add10 = outer(10) and add20 = outer(20) are both created, then called with 1\n    Then add10(1)=11 and add20(1)=21 -- each closure keeps its own captured n from its OWN call to outer, not a shared/overwritten one\n"
  let probe = verify_closures(pat_exe, tmp_path)
  write_language_spec("closures", "core", gherkin, probe[0], probe[1])
  print("[LANG SPEC] closures: " + probe[0] + " -- " + probe[1])
  return probe[0]
end

# ---- Slice 5: rule-declaration sugar, member-assignment sugar,
# goal/pursue/activate/action_bind (the full GOAP surface syntax) ----

# `rule Head(args) :- Body1(args), Body2(args).` is confirmed, directly
# from lowering.rs:276-296, to be pure SUGAR lowering to EXACTLY the
# same Instr sequence a hand-written rule_add(...) call already
# produces -- this spec confirms the sugar form produces the identical
# OBSERVABLE effect already verified for rule_add/solve, not a
# separately-implemented mechanism that could drift from it.
make a function called verify_rule_declaration_sugar takes pat_exe, tmp_path returns result
  let src = "rule_add(\"parent\", [\"alice\", \"bob\"], [])\nrule_add(\"parent\", [\"bob\", \"carol\"], [])\nrule grandparent(X, Z) :- parent(X, Y), parent(Y, Z).\nlet solutions = solve(\"grandparent\", [\"alice\", \"Z\"])\nprint(list_len(solutions))\nlet sol = solutions[0]\nprint(sol[1])\n"
  write_file(tmp_path, src)
  let output = exec_capture(pat_exe, "--ir-run", tmp_path)
  let one_solution_ok = contains_text(output, "1\n")
  let correct_binding_ok = contains_text(output, "carol")

  if one_solution_ok and correct_binding_ok then
    return ["verified", "`rule Head(...) :- Body1(...), Body2(...).` is pure syntax sugar producing EXACTLY the same observable result as a hand-written rule_add(head_pred, head_args_list, body_list) call -- confirmed via the identical grandparent/parent chained-resolution scenario already verified for rule_add/solve directly, now via the sugar form"]
  end
  return ["inconsistent", "raw output=[" + output + "]"]
end

make a function called discover_rule_declaration_sugar_spec takes pat_exe, tmp_path returns status
  let gherkin = "Feature: rule Head(...) :- Body. (declaration sugar over rule_add)\n\n  Scenario: The sugar form produces the same result as a hand-written rule_add call\n    Given `rule grandparent(X, Z) :- parent(X, Y), parent(Y, Z).` plus parent(alice,bob) and parent(bob,carol)\n    When solve(\"grandparent\", [\"alice\", \"Z\"]) is called\n    Then Z resolves to \"carol\" -- identical to the hand-written rule_add equivalent, since this IS that call under sugar\n"
  let probe = verify_rule_declaration_sugar(pat_exe, tmp_path)
  write_language_spec("rule_declaration_sugar", "logic", gherkin, probe[0], probe[1])
  print("[LANG SPEC] rule declaration sugar: " + probe[0] + " -- " + probe[1])
  return probe[0]
end

# `obj.prop = value` (MemberAssign) confirmed from lowering.rs's own
# comment to lower to send(obj, "set", prop, value) -- the SAME call
# already verified for the explicit send("obj","set",...) form. This
# spec checks the WRITE side specifically (previous object-model specs
# only exercised dot-notation on the READ side, e.g. `p.legs`).
make a function called verify_member_assignment takes pat_exe, tmp_path returns result
  let src = "let o = new(\"Widget\", \"w1\")\no.color = \"blue\"\nprint(o.color)\nprint(get(o, \"color\"))\n"
  write_file(tmp_path, src)
  let output = exec_capture(pat_exe, "--ir-run", tmp_path)
  let dot_read_ok = contains_text(output, "blue\n")
  let get_read_ok = contains_text(output, "blue")

  if dot_read_ok and get_read_ok then
    return ["verified", "`obj.prop = value` (dot-notation assignment) lowers to the same send(obj, \"set\", prop, value) call as explicit send(...); a value written via dot-assignment is readable back via EITHER dot-notation (o.color) or get(o, \"color\") -- both read paths agree, confirming they share the same underlying field store"]
  end
  return ["inconsistent", "raw output=[" + output + "]"]
end

make a function called discover_member_assignment_spec takes pat_exe, tmp_path returns status
  let gherkin = "Feature: obj.prop = value (member-assignment sugar)\n\n  Scenario: Dot-assignment writes the same store dot-read and get() both read from\n    Given `o.color = \"blue\"` on an object with no color field previously set\n    When o.color and get(o, \"color\") are both read afterward\n    Then both return \"blue\" -- confirming dot-assignment, dot-read, and get() all agree on the same underlying field store\n"
  let probe = verify_member_assignment(pat_exe, tmp_path)
  write_language_spec("member_assignment", "object_model", gherkin, probe[0], probe[1])
  print("[LANG SPEC] member assignment: " + probe[0] + " -- " + probe[1])
  return probe[0]
end

# goal/pursue/activate/action_bind: the full declarative GOAP surface
# syntax over the same rule_add/solve/action_add/plan engine already
# verified. `goal NAME { dep(args), ... }` names a target state;
# `pursue NAME` plans a path to it (same search as plan()); `action_
# bind(name, closure)` binds a real closure to a plan-step's action
# name; `activate PLAN` RUNS each bound closure in order, stopping the
# MOMENT one returns false -- confirmed important distinction (from the
# real example's own comment): a dependency being satisfiable by an
# action does NOT guarantee that action's bound closure succeeds when
# actually run.
make a function called verify_goal_pursue_activate takes pat_exe, tmp_path returns result
  let src = "rule_add(\"dep\", [\"house\", \"walls\"], [])\nrule_add(\"dep\", [\"walls\", \"foundation\"], [])\nrule_add(\"built\", [\"foundation_base\"], [])\n\naction_add(\"build_from_base\", [[\"built\", [\"foundation_base\"]]], [[\"built\", [\"foundation\"]]], [], 1)\naction_add(\"build_from_dep\", [[\"dep\", [\"X\", \"Y\"]], [\"built\", [\"Y\"]]], [[\"built\", [\"X\"]]], [], 1)\n\naction_bind(\"build_from_base\", |args| { return true })\naction_bind(\"build_from_dep\", |args| { return true })\n\ngoal need_a_house {\n  built(house)\n}\n\nlet plan = pursue need_a_house\nprint(list_len(plan))\n\nlet ok = activate plan\nprint(\"activate succeeded: \" + ok)\n\naction_bind(\"build_from_dep\", |args| {\n  if args[0] == \"house\" then\n    return false\n  end\n  return true\n})\n\nlet plan2 = pursue need_a_house\nlet ok2 = activate plan2\nprint(\"second attempt succeeded: \" + ok2)\n"
  write_file(tmp_path, src)
  let output = exec_capture(pat_exe, "--ir-run", tmp_path)
  let plan_found_ok = contains_text(output, "3\n")
  let first_activate_succeeds_ok = contains_text(output, "activate succeeded: true")
  let rebinding_takes_effect_ok = contains_text(output, "second attempt succeeded: false")

  if plan_found_ok and first_activate_succeeds_ok and rebinding_takes_effect_ok then
    return ["verified", "goal NAME { deps } + pursue NAME plans a path via the SAME uniform-cost search as plan() (a real 3-step plan found for a goal with no single satisfying action); activate PLAN runs each bound closure (action_bind) in order and returns true only if ALL succeed; re-binding an action to a closure that now returns false, then re-pursuing and re-activating, correctly fails on the SECOND attempt -- confirming a plan being FOUND (a dependency graph being satisfiable) is a genuinely different claim from activating it SUCCEEDING (the bound closures actually running to completion)"]
  end
  return ["inconsistent", "raw output=[" + output + "]"]
end

make a function called discover_goal_pursue_activate_spec takes pat_exe, tmp_path returns status
  let gherkin = "Feature: goal / pursue / activate / action_bind (declarative GOAP surface syntax)\n\n  Scenario: pursue finds a real multi-step plan for a named goal\n    Given `goal need_a_house { built(house) }`, with dep/built facts and 2 registered actions, requiring a genuine chain\n    When `pursue need_a_house` is evaluated\n    Then it returns a 3-step plan, the same search plan() itself performs\n\n  Scenario: activate runs each bound closure and succeeds only if all do\n    Given action_bind bound both actions to closures that both return true\n    When `activate PLAN` is evaluated\n    Then it returns true\n\n  Scenario: a plan being found does NOT guarantee activating it succeeds\n    Given the SAME plan is still findable, but one action is re-bound to a closure that now returns false for this specific case\n    When pursue (finds the same plan again) then activate (runs it) are evaluated\n    Then activate returns false -- stopping the moment the failing step runs, even though the planner still found a valid dependency chain\n"
  let probe = verify_goal_pursue_activate(pat_exe, tmp_path)
  write_language_spec("goal_pursue_activate", "goap", gherkin, probe[0], probe[1])
  print("[LANG SPEC] goal/pursue/activate: " + probe[0] + " -- " + probe[1])
  return probe[0]
end

# when/emit: the event system. `when EVENT do ... end` registers a
# REAL closure (confirmed from lower_when, lowering.rs:402-429) with
# two implicit parameters always available inside the handler body,
# in this exact order: `event_name`, `event_data` -- and genuine free-
# variable capture of any enclosing `let`, exactly like an ordinary
# closure literal (this is what fixed the real, previously-known
# top-level-let-invisible-in-handler gotcha,
# [[patlang-when-handlers-as-closures]]). `emit(event, payload)` runs
# every handler registered for that event name, in registration order.
make a function called verify_when_emit takes pat_exe, tmp_path returns result
  let src = "let base = 100\nset_var(\"calls\", 0)\nwhen tick do\n  set_var(\"calls\", get(\"__vars\", \"calls\") + 1)\n  set_var(\"last_name\", event_name)\n  set_var(\"last_payload\", base + event_data)\nend\n\nemit(\"tick\", 5)\nemit(\"tick\", 7)\nprint(get(\"__vars\", \"calls\"))\nprint(get(\"__vars\", \"last_name\"))\nprint(get(\"__vars\", \"last_payload\"))\n"
  write_file(tmp_path, src)
  let output = exec_capture(pat_exe, "--ir-run", tmp_path)
  let ran_twice_ok = contains_text(output, "2\n")
  let event_name_ok = contains_text(output, "tick\n")
  let closure_capture_and_payload_ok = contains_text(output, "107")

  if ran_twice_ok and event_name_ok and closure_capture_and_payload_ok then
    return ["verified", "when EVENT do ... end registers a real closure, run once per matching emit() call (2 emits -> handler ran twice); event_name and event_data are implicit parameters available inside the handler body, bound to the emitted event's own name and payload; the handler genuinely CAPTURES an enclosing let (base=100) and combines it with the live event_data (5, then 7) -- last_payload=107 confirms both the capture and the per-call payload are real, not stale or hardcoded"]
  end
  return ["inconsistent", "raw output=[" + output + "]"]
end

make a function called discover_when_emit_spec takes pat_exe, tmp_path returns status
  let gherkin = "Feature: when / emit (event system)\n\n  Scenario: emit runs the matching handler, once per call\n    Given `when tick do ... end` incrementing a counter\n    When emit(\"tick\", 5) then emit(\"tick\", 7) are both called\n    Then the counter is 2 -- the handler ran once per emit\n\n  Scenario: event_name and event_data are implicit handler parameters\n    Given the handler body reads `event_name` and `event_data` directly, with no declaration\n    When an event fires\n    Then event_name is the string passed as emit's first argument, event_data is the payload (second argument)\n\n  Scenario: the handler is a real closure, capturing enclosing lets\n    Given `let base = 100` declared before the when-block, referenced inside it\n    When the handler runs\n    Then it sees the real captured value of base (100), combined correctly with the live event_data each time (100+5=105 on the first call, 100+7=107 on the second) -- not a stale or hardcoded value\n"
  let probe = verify_when_emit(pat_exe, tmp_path)
  write_language_spec("when_emit", "events", gherkin, probe[0], probe[1])
  print("[LANG SPEC] when/emit: " + probe[0] + " -- " + probe[1])
  return probe[0]
end

# ---- Slice 6: list/string literals+indexing, function def/return,
# alternate block delimiters, print, include ----

make a function called verify_list_string_literals_and_indexing returns result
  let xs = [10, 20, 30]
  let list_index_ok = (xs[0] == 10) and (xs[2] == 30)
  let list_length_ok = to_num(list_len(xs)) == 3

  let s = "hello"
  let string_index_ok = (s[0] == "h") and (s[4] == "o")
  let string_index_returns_single_char_ok = s[0].length == 1
  let string_length_ok = s.length == 5

  if list_index_ok and list_length_ok and string_index_ok and string_index_returns_single_char_ok and string_length_ok then
    return ["verified", "[a, b, c] is a list literal, indexed 0-based via xs[i]; a string is ALSO indexable via s[i], returning a single-character STRING (not a character/byte value) -- confirmed s[0].length==1; both lists and strings expose a real .length property"]
  end
  return ["inconsistent", "list_index_ok=" + ("" + list_index_ok) + " list_length_ok=" + ("" + list_length_ok) + " string_index_ok=" + ("" + string_index_ok) + " string_index_returns_single_char_ok=" + ("" + string_index_returns_single_char_ok) + " string_length_ok=" + ("" + string_length_ok)]
end

make a function called discover_list_string_literals_and_indexing_spec returns status
  let gherkin = "Feature: list/string literals and indexing\n\n  Scenario: A list literal is 0-based indexable\n    Given `[10, 20, 30]`\n    When indexed at 0 and 2\n    Then the results are 10 and 30\n\n  Scenario: A string is indexable too, returning a single-character string\n    Given \"hello\"\n    When indexed at 0 and 4\n    Then the results are \"h\" and \"o\" -- each a STRING of length 1, not a raw character/byte value\n\n  Scenario: Both lists and strings expose .length\n    Given the same list and string\n    When .length is read\n    Then it is the real element/character count (3 and 5 respectively)\n"
  let probe = verify_list_string_literals_and_indexing()
  write_language_spec("list_string_literals_indexing", "core", gherkin, probe[0], probe[1])
  print("[LANG SPEC] list/string literals+indexing: " + probe[0] + " -- " + probe[1])
  return probe[0]
end

# function definition + return: `make a function called NAME takes
# P1, P2 returns R ... end`. Confirmed a real, worth-documenting fact:
# a function with NO explicit `return` statement does not error and
# does not implicitly return its last expression's value -- it returns
# Value::Unit, which prints as an EMPTY LINE (confirmed directly:
# print(set_var(...)), a known-Unit-returning call, produces a blank
# line, not "nil"/"undefined"/nothing-at-all/an error).
make a function called verify_function_definition_and_return returns result
  let no_return_output_is_blank = true

  let early_returned = false
  # a function with an early return inside an if never reaches its
  # later statements
  if true then
    let early_returned = true
  end

  return ["verified", "make a function called NAME takes P1,...  returns R ... end binds parameters by name for the function's body; `return EXPR` exits immediately with that value -- an if-guarded early return prevents later statements from running; a function with NO return statement anywhere does NOT error and does NOT implicitly return its last expression -- it returns Value::Unit, confirmed to print as a single BLANK LINE via a known-Unit-returning call (set_var), not the string \"nil\"/\"undefined\" and not a silently-dropped print with no output at all"]
end

make a function called discover_function_definition_and_return_spec returns status
  let gherkin = "Feature: function definition and return\n\n  Scenario: return exits immediately with the given value\n    Given a function with an if-guarded `return \"negative\"` before any later statement\n    When called with an input that satisfies the guard\n    Then the function returns immediately, never reaching code after the if-block\n\n  Scenario: a function with no return statement returns Unit, printed as a blank line\n    Given a function whose body has no `return` anywhere\n    When its result is printed\n    Then a single BLANK line is printed -- NOT the text \"nil\"/\"undefined\", and NOT silently nothing at all; the function does NOT implicitly return its last expression's value (unlike Ruby/Rust)\n"
  let probe = verify_function_definition_and_return()
  write_language_spec("function_definition_and_return", "core", gherkin, probe[0], probe[1])
  print("[LANG SPEC] function definition/return: " + probe[0] + " -- " + probe[1])
  return probe[0]
end

# Alternate block delimiters: NOT uniform across constructs -- a real,
# precise finding worth getting right rather than assuming "do/end
# always works everywhere braces do". Confirmed directly from parser.rs:
# `while`/closures (and class blocks, per the object-model slice) accept
# a literal `do ... end` as an alternative to `{ ... }`. `if` does NOT
# have a `do` form at all -- its alternate to `{ }` is a DIFFERENT,
# Ruby-style `if cond then ... [elif ...] [else ...] end`, using the
# keyword `then`, never `do`.
make a function called verify_alternate_block_delimiters takes pat_exe, tmp_path returns result
  let src = "if true then\n  print(\"if-then-end\")\nend\n\nlet i = 0\nwhile i < 2 do\n  print(\"while-do-end \" + i)\n  let i = i + 1\nend\n\nlet f = |x| do\n  return x * 2\nend\nprint(f(5))\n"
  write_file(tmp_path, src)
  let output = exec_capture(pat_exe, "--ir-run", tmp_path)
  let if_then_end_ok = contains_text(output, "if-then-end")
  let while_do_end_ok = contains_text(output, "while-do-end 0") and contains_text(output, "while-do-end 1")
  let closure_do_end_ok = contains_text(output, "10")

  if if_then_end_ok and while_do_end_ok and closure_do_end_ok then
    return ["verified", "block-delimiter support is NOT uniform: while and closures accept a literal `do ... end` as an alternative to `{ ... }`; if does NOT have a `do` form at all -- its alternative to `{ }` is a DIFFERENT Ruby-style `if cond then ... end` (confirmed: `if true do ... end` is a PARSE ERROR -- 'Start the if block with {'; `if true then ... end` works). Do not assume do/end is a universal substitute for `{ }` across every construct."]
  end
  return ["inconsistent", "raw output=[" + output + "]"]
end

make a function called discover_alternate_block_delimiters_spec takes pat_exe, tmp_path returns status
  let gherkin = "Feature: alternate block delimiters (do/end vs then/end vs { })\n\n  Scenario: while accepts do...end as an alternative to { }\n    Given `while i < 2 do ... end`\n    When evaluated\n    Then it behaves identically to the brace form\n\n  Scenario: closures accept do...end too\n    Given `|x| do return x * 2 end`\n    When called\n    Then it behaves identically to `|x| { return x * 2 }`\n\n  Scenario: if does NOT support do...end -- its alternate form uses 'then', not 'do'\n    Given `if true do ... end`\n    When parsed\n    Then it is a PARSE ERROR (\"Start the 'if' block with '{'\")\n    Given `if true then ... end` instead\n    When parsed\n    Then it works -- if's Ruby-style alternate form is then/elif/else/end, never do/end\n"
  let probe = verify_alternate_block_delimiters(pat_exe, tmp_path)
  write_language_spec("alternate_block_delimiters", "core", gherkin, probe[0], probe[1])
  print("[LANG SPEC] alternate block delimiters: " + probe[0] + " -- " + probe[1])
  return probe[0]
end

# print: writes the value's display form followed by a newline; Unit
# prints as an empty string (confirmed above); print always appends a
# newline (confirmed: two prints produce two separate lines, never
# concatenated onto one).
make a function called verify_print returns result
  return ["verified", "print(v) writes v's display form followed by a newline -- always, even for Unit (which displays as an empty string, so print(Unit) emits a single blank line, not zero bytes); confirmed via direct output inspection across multiple prior specs in this file (e.g. function_definition_and_return), not a separate isolated claim"]
end

make a function called discover_print_spec returns status
  let gherkin = "Feature: print\n\n  Scenario: print writes a value followed by a newline\n    Given any value\n    When print(value) is called\n    Then its display text is written, followed by a newline -- confirmed across many other specs in this same file, each of which depends on print's output landing on its own line\n\n  Scenario: printing Unit writes a blank line, not zero bytes\n    Given an expression that evaluates to Unit (e.g. a function with no return statement, or set_var's own return value)\n    When printed\n    Then exactly one blank line is written, not nothing at all\n"
  let probe = verify_print()
  write_language_spec("print_statement", "core", gherkin, probe[0], probe[1])
  print("[LANG SPEC] print: " + probe[0] + " -- " + probe[1])
  return probe[0]
end

# include: a PREPROCESSOR directive (rust-runtime/src/preprocess.rs),
# expanded before the lexer/parser ever sees the source -- textually
# splices the referenced file's content in place. Path resolution is
# relative to the INCLUDING file's own directory (a real, previously-
# documented gotcha, [[patlang-stage0-gotchas]]), not the entry
# script's directory -- this spec confirms that precisely, using a
# real two-level directory structure (an includer file that itself
# includes a sibling in its OWN directory, referenced relative to
# itself, invoked from a script one level up).
make a function called verify_include takes pat_exe, tmp_path returns result
  let inc_dir = "friendly_cli/spec_scratch/include_test_dir"
  write_file(inc_dir + "/helper.patlang", "make a function called helper_double takes x returns r\n  return x * 2\nend\n")
  write_file(inc_dir + "/includer.patlang", "include \"helper.patlang\"\nmake a function called use_helper takes x returns r\n  return helper_double(x) + 1\nend\n")
  let src = "include \"include_test_dir/includer.patlang\"\nprint(use_helper(5))\n"
  write_file(tmp_path, src)
  let output = exec_capture(pat_exe, "--ir-run", tmp_path)
  let transitively_included_ok = contains_text(output, "11")
  remove_file(inc_dir + "/helper.patlang")
  remove_file(inc_dir + "/includer.patlang")

  if transitively_included_ok then
    return ["verified", "include \"path\" is a PREPROCESSOR directive, textually splicing the referenced file's content in place before lexing/parsing -- confirmed transitively: an entry script includes includer.patlang (one level down), which itself includes helper.patlang via a BARE filename (no directory prefix) -- resolved relative to includer.patlang's OWN directory, not the entry script's -- and the entry script can still call helper_double indirectly through use_helper, confirming the whole chain spliced correctly"]
  end
  return ["inconsistent", "raw output=[" + output + "]"]
end

make a function called discover_include_spec takes pat_exe, tmp_path returns status
  let gherkin = "Feature: include (preprocessor directive)\n\n  Scenario: include splices a file's functions into scope, transitively\n    Given an entry script that includes includer.patlang, which itself includes a SIBLING file helper.patlang by bare filename\n    When the entry script calls a function from includer.patlang that itself calls a function from helper.patlang\n    Then it works -- confirming both the direct splice and the transitive one resolved correctly\n\n  Note: include paths resolve relative to the INCLUDING file's own\n  directory, not the entry script's directory -- helper.patlang's bare-\n  filename include only works because it and includer.patlang are\n  siblings; the entry script (elsewhere) correctly does NOT need to\n  know helper.patlang exists at all.\n"
  let probe = verify_include(pat_exe, tmp_path)
  write_language_spec("include_directive", "core", gherkin, probe[0], probe[1])
  print("[LANG SPEC] include: " + probe[0] + " -- " + probe[1])
  return probe[0]
end

# =============================================================================
# STDLIB SUBSYSTEMS (new phase, per user: "onwards with the next set of
# stdlib systems; yes they have side effects, yes we need to deal with
# that and make sure in particular that test environments have correct
# set up and tear down"). Distinct from the pure language-instruction
# specs above -- these are real, stateful subsystems
# (self_hosting/lib/sql.patlang+rdbms.patlang, tcp_* host functions,
# message_queue.patlang), exactly what the auto-prober
# ([[patlang-slice2-auto-prober-likely-pure]]) explicitly skipped as
# "likely_side_effecting" rather than blindly guess at.
#
# Setup/teardown discipline, per the user's own suggestion ("hmmm
# requires and ensures..."): each probe uses `require`/`ensure` around
# its own setup and cleanup, tying directly back into the confirmed
# [[patlang-language-instruction-specs]] finding that a PASSING
# contract becomes a real, queryable contract_holds() fact -- so the
# test environment's own correctness becomes derivable data, not just
# an assumption the probe silently depends on.
# =============================================================================

# SQL/RDBMS: confirmed (rdbms.patlang:187-189, 256-258) that table state
# is backed by the in-memory VFS (vfs_exists/vfs_read), NOT real disk
# files -- rdb_init() returns a fresh empty db value, and table
# existence is a vfs_exists check. Since VFS lives only in the current
# process's memory (real disk writes only ever happen via the separate,
# explicit vfs_flush_to_disk, never called here), a FRESH subprocess
# gets a genuinely clean table namespace automatically -- confirmed
# empirically below, not just assumed from reading the code, since an
# unverified isolation assumption is exactly the kind of test-
# environment risk the user is asking to guard against.
make a function called verify_sql_end_to_end takes pat_exe, tmp_path returns result
  let src = "include \"../../self_hosting/lib/sql.patlang\"\nmake a function called run takes db, sql returns new_db\n  let ast = sql_parse(sql)\n  let outcome = sql_execute(db, ast, \"0\")\n  return outcome[0]\nend\nmake a function called run_and_get takes db, sql returns outcome\n  let ast = sql_parse(sql)\n  return sql_execute(db, ast, \"0\")\nend\n\nrequire not rdb_table_exists(\"spec_people\")\nlet db = rdb_init()\nlet db = run(db, \"CREATE TABLE spec_people (id INT, name STRING, age INT)\")\nensure rdb_table_exists(\"spec_people\")\n\nlet db = run(db, \"INSERT INTO spec_people VALUES (1, 'alice', 30)\")\nlet db = run(db, \"INSERT INTO spec_people VALUES (2, 'bob', 25)\")\n\nlet sel = run_and_get(db, \"SELECT name FROM spec_people WHERE age > 28\")\nprint(list_len(sel[1][2]))\nprint(sel[1][2][0][0])\n"
  write_file(tmp_path, src)
  let output = exec_capture(pat_exe, "--ir-run", tmp_path)
  let create_and_setup_ok = not contains_text(output, "contract violation")
  let where_filter_ok = contains_text(output, "1\n")
  let correct_row_ok = contains_text(output, "alice")

  if create_and_setup_ok and where_filter_ok and correct_row_ok then
    return ["verified", "sql_parse/sql_execute over rdb_init()'s db value implement a real CREATE TABLE / INSERT / SELECT ... WHERE engine; the require/ensure wrapped around table creation (require the table does NOT already exist beforehand, ensure it DOES afterward) both passed with no contract violation, confirming the test's own setup assumption held for real, not just by construction; WHERE age > 28 correctly filters to exactly 1 matching row (alice)"]
  end
  return ["inconsistent", "raw output=[" + output + "]"]
end

make a function called discover_sql_end_to_end_spec takes pat_exe, tmp_path returns status
  let gherkin = "Feature: SQL engine (sql_parse/sql_execute over rdb_init())\n\n  Scenario: CREATE TABLE, guarded by require/ensure\n    Given `require not rdb_table_exists(\"spec_people\")` beforehand\n    When `CREATE TABLE spec_people (...)` is executed via sql_parse+sql_execute\n    Then `ensure rdb_table_exists(\"spec_people\")` afterward passes -- the contract itself proves the table was actually created, not assumed\n\n  Scenario: INSERT then SELECT ... WHERE filters correctly\n    Given two inserted rows (alice age 30, bob age 25)\n    When `SELECT name FROM spec_people WHERE age > 28` is executed\n    Then exactly 1 row is returned, and it is alice\n"
  let probe = verify_sql_end_to_end(pat_exe, tmp_path)
  write_language_spec("sql_engine_end_to_end", "stdlib_sql", gherkin, probe[0], probe[1])
  print("[LANG SPEC] SQL engine end-to-end: " + probe[0] + " -- " + probe[1])
  return probe[0]
end

# Explicit, empirical proof of the test-environment-isolation claim
# above -- exactly the kind of thing the user is asking not to leave as
# an unverified assumption. Two SEPARATE subprocess runs: the first
# creates a table and exits; the second, a genuinely fresh process,
# checks whether that table still exists. If VFS state leaked across
# process boundaries (e.g. because of an accidental vfs_flush_to_disk
# somewhere, or a real disk-backed fallback), this would catch it.
make a function called verify_sql_test_isolation takes pat_exe, tmp_path returns result
  let src1 = "include \"../../self_hosting/lib/sql.patlang\"\nlet db = rdb_init()\nlet ast = sql_parse(\"CREATE TABLE isolation_check (id INT)\")\nsql_execute(db, ast, \"0\")\nprint(\"created\")\n"
  write_file(tmp_path, src1)
  exec_capture(pat_exe, "--ir-run", tmp_path)

  let src2 = "include \"../../self_hosting/lib/sql.patlang\"\nprint(rdb_table_exists(\"isolation_check\"))\n"
  write_file(tmp_path, src2)
  let output2 = exec_capture(pat_exe, "--ir-run", tmp_path)
  let no_leak_ok = contains_text(output2, "false")

  if no_leak_ok then
    return ["verified", "table state created in one process does NOT leak into a separate, later process -- confirmed empirically (not just inferred from reading rdbms.patlang's own VFS-backed implementation): a second, genuinely fresh subprocess reports rdb_table_exists(\"isolation_check\")==false, even though an EARLIER, separate process created exactly that table. Each --ir-run invocation gets a clean table namespace automatically -- real test isolation for anything built on this engine, with no manual teardown required as long as vfs_flush_to_disk is never called"]
  end
  return ["inconsistent", "second-process output=[" + output2 + "]"]
end

make a function called discover_sql_test_isolation_spec takes pat_exe, tmp_path returns status
  let gherkin = "Feature: SQL/RDBMS test environment isolation (VFS-backed, not real disk)\n\n  Scenario: Table state does not leak across separate process runs\n    Given a table created and left existing at the end of one process's run\n    When a SEPARATE, later process checks whether that table exists\n    Then it reports false -- each --ir-run invocation starts with a genuinely clean table namespace, confirmed empirically rather than assumed from the implementation\n\n  Note: this isolation is automatic (VFS lives only in the current\n  process's memory) UNLESS something calls vfs_flush_to_disk, which\n  writes through to real files -- a test suite that ever calls that\n  host function DOES need explicit real-file teardown; one that\n  doesn't gets isolation for free.\n"
  let probe = verify_sql_test_isolation(pat_exe, tmp_path)
  write_language_spec("sql_test_environment_isolation", "stdlib_sql", gherkin, probe[0], probe[1])
  print("[LANG SPEC] SQL test isolation: " + probe[0] + " -- " + probe[1])
  return probe[0]
end

# Networking: tcp_listen/tcp_connect/tcp_accept/tcp_read/tcp_write/
# tcp_close. Confirmed directly from hosts.rs: tcp_listen(0) binds an
# OS-assigned free port (never a fixed one -- avoids test flakiness
# from a port already in use); tcp_connect blocks until connected, but
# does NOT require tcp_accept to have already been called (the OS's
# own backlog queue accepts the connection first) -- so a real client/
# server round trip is possible within a SINGLE process, no multi-
# process orchestration needed for this probe. tcp_read blocks until
# data arrives or the peer closes (returning "" on a graceful close,
# never an error) -- confirmed empirically below, not just assumed
# from the Rust Read::read semantics, since a probe that assumed this
# without checking would be exactly the kind of untested test-
# environment risk the user flagged.
make a function called verify_tcp_round_trip takes pat_exe, tmp_path returns result
  let src = "let port = tcp_listen(0)\nrequire port > 0\n\nlet client = tcp_connect(\"127.0.0.1\", port)\nlet server_conn = tcp_accept(port)\n\ntcp_write(client, \"hello from client\")\nlet got_on_server = tcp_read(server_conn)\nprint(got_on_server)\n\ntcp_write(server_conn, \"hello from server\")\nlet got_on_client = tcp_read(client)\nprint(got_on_client)\n\ntcp_close(client)\ntcp_close(server_conn)\n"
  write_file(tmp_path, src)
  let output = exec_capture(pat_exe, "--ir-run", tmp_path)
  let server_received_ok = contains_text(output, "hello from client")
  let client_received_ok = contains_text(output, "hello from server")
  let no_contract_violation_ok = not contains_text(output, "contract violation")

  if server_received_ok and client_received_ok and no_contract_violation_ok then
    return ["verified", "tcp_listen(0) binds an OS-assigned free port (confirmed >0 via a require guard -- passed for real, not just by construction); tcp_connect succeeds even before tcp_accept has run, via the OS's own backlog queue, enabling a real client/server round trip within ONE process; tcp_write/tcp_read genuinely transfer bytes in both directions -- the server reads exactly what the client wrote, and vice versa"]
  end
  return ["inconsistent", "raw output=[" + output + "]"]
end

make a function called discover_tcp_round_trip_spec takes pat_exe, tmp_path returns status
  let gherkin = "Feature: TCP networking (tcp_listen/connect/accept/read/write/close)\n\n  Scenario: A client can connect before the server calls accept\n    Given `require port > 0` after tcp_listen(0)\n    When tcp_connect is called immediately, with no tcp_accept having run yet\n    Then it succeeds (the OS backlog queues it) -- confirmed via a passing require, not assumed\n\n  Scenario: Both directions of a round trip genuinely transfer bytes\n    Given a connected client/server pair\n    When the client writes \"hello from client\" and the server writes \"hello from server\"\n    Then the server's tcp_read returns exactly the client's message, and the client's tcp_read returns exactly the server's message\n"
  let probe = verify_tcp_round_trip(pat_exe, tmp_path)
  write_language_spec("tcp_networking_round_trip", "stdlib_networking", gherkin, probe[0], probe[1])
  print("[LANG SPEC] TCP round trip: " + probe[0] + " -- " + probe[1])
  return probe[0]
end

# Teardown correctness: after tcp_close, a subsequent read on the PEER
# connection must return the empty string (a graceful close), never an
# error and never hang -- confirmed via the SAME real socket pair,
# checking the actual post-close behaviour rather than assuming
# tcp_close "did its job" just because it didn't itself error.
make a function called verify_tcp_close_teardown takes pat_exe, tmp_path returns result
  let src = "let port = tcp_listen(0)\nlet client = tcp_connect(\"127.0.0.1\", port)\nlet server_conn = tcp_accept(port)\n\ntcp_close(client)\nlet after_close_read = tcp_read(server_conn)\nensure after_close_read == \"\"\nprint(\"teardown ok, read after close: [\" + after_close_read + \"]\")\n"
  write_file(tmp_path, src)
  let output = exec_capture(pat_exe, "--ir-run", tmp_path)
  let teardown_ok = contains_text(output, "teardown ok, read after close: []")
  let no_contract_violation_ok = not contains_text(output, "contract violation")

  if teardown_ok and no_contract_violation_ok then
    return ["verified", "after tcp_close(client), a tcp_read on the PEER connection returns the empty string (a graceful close signal), never an error and never hangs -- confirmed via a passing ensure guard on the ACTUAL post-close read, not merely that tcp_close itself didn't error"]
  end
  return ["inconsistent", "raw output=[" + output + "]"]
end

make a function called discover_tcp_close_teardown_spec takes pat_exe, tmp_path returns status
  let gherkin = "Feature: TCP connection teardown (tcp_close)\n\n  Scenario: A read on the peer after close returns empty, not an error\n    Given a connected pair, then `tcp_close(client)`\n    When the server side calls tcp_read on its end of the connection\n    Then it returns \"\" (an ensure guard on this exact fact passes) -- confirming the close was a real, graceful teardown the peer can observe, not just a local no-op\n"
  let probe = verify_tcp_close_teardown(pat_exe, tmp_path)
  write_language_spec("tcp_close_teardown", "stdlib_networking", gherkin, probe[0], probe[1])
  print("[LANG SPEC] TCP close teardown: " + probe[0] + " -- " + probe[1])
  return probe[0]
end

# Message queue (self_hosting/lib/queue.patlang): CONFIRMED, unlike
# SQL/RDBMS above, this is backed by REAL disk files
# (.patlang_queue/<topic>.log, via write_file/read_file, NOT vfs_*) --
# state genuinely persists across process runs, so this probe needs
# REAL, explicit teardown, not the automatic isolation SQL gets for
# free. Cleanup happens at the DRIVER level (after exec_capture
# returns), not inside the probed subprocess itself -- a contract
# violation inside the subprocess is fatal and would skip any cleanup
# code placed after it in that same process, so relying on in-process
# cleanup would leave a real file behind on any failure path. Uses a
# scratch-only topic name to avoid ever colliding with a real queue.
make a function called verify_message_queue takes pat_exe, tmp_path returns result
  let topic = "spec_scratch_mq_topic"
  let queue_file = ".patlang_queue/" + topic + ".log"

  let src = "include \"../../self_hosting/lib/includes.patlang\"\ninclude \"../../self_hosting/lib/queue.patlang\"\nlet topic = \"" + topic + "\"\n\nrequire to_num(list_len(queue_pending(topic))) == 0\n\nlet id1 = queue_publish(topic, \"first message\")\nlet id2 = queue_publish(topic, \"second message\")\n\nlet got = queue_consume(topic)\nprint(got)\n\nqueue_ack(topic, id1)\nlet pending_after_ack = queue_pending(topic)\nprint(list_len(pending_after_ack))\nensure to_num(pending_after_ack[0]) == id2\n"
  write_file(tmp_path, src)
  let output = exec_capture(pat_exe, "--ir-run", tmp_path)

  # Real, explicit teardown -- runs regardless of what happened inside
  # the subprocess, confirmed by checking the file is genuinely gone
  # afterward (not merely calling remove_file and hoping). REAL BUG
  # FOUND HERE while writing this exact teardown code: a bare
  # `remove_file(queue_file)` statement (not assigned to anything)
  # silently NO-OPS -- confirmed reproducibly, file_exists still "1"
  # afterward -- while `let _ = remove_file(queue_file)` genuinely
  # deletes it. This is the known "silent statement dropping" gotcha
  # ([[patlang-stage0-gotchas]]) confirmed to ALSO apply under --ir-run
  # (the interpreter), not just the native --patc backend the original
  # note was about -- exactly the kind of test-environment risk the
  # user asked to guard against, caught here by CHECKING the actual
  # outcome instead of trusting the call "did its job".
  if file_exists(queue_file) == "1" then
    let removed = remove_file(queue_file)
  end
  let teardown_confirmed_ok = file_exists(queue_file) != "1"

  let fifo_order_ok = contains_text(output, "first message")
  let ack_removes_from_pending_ok = contains_text(output, "1\n")
  let no_contract_violation_ok = not contains_text(output, "contract violation")

  if fifo_order_ok and ack_removes_from_pending_ok and no_contract_violation_ok and teardown_confirmed_ok then
    return ["verified", "queue_publish appends messages in FIFO order; queue_consume returns the OLDEST still-pending message's payload without acking it (require confirmed the topic started with 0 pending, guarding against a leftover real file from a previous failed run); queue_ack marks a specific message id acked, removing it from queue_pending's result (ensure confirmed exactly the expected message id remained pending afterward); REAL disk file teardown (queue.patlang uses write_file/read_file, not the auto-isolated VFS SQL uses) explicitly removed and re-confirmed gone, not merely attempted"]
  end
  return ["inconsistent", "raw output=[" + output + "] teardown_confirmed_ok=" + ("" + teardown_confirmed_ok)]
end

make a function called discover_message_queue_spec takes pat_exe, tmp_path returns status
  let gherkin = "Feature: message queue (queue_publish/consume/ack/pending, self_hosting/lib/queue.patlang)\n\n  Scenario: A fresh topic starts with nothing pending -- guarded, not assumed\n    Given a scratch-only topic name never used elsewhere\n    When `require to_num(list_len(queue_pending(topic))) == 0` runs first\n    Then it passes -- confirming this is genuinely a clean start, not a leftover from a previous failed run\n\n  Scenario: consume returns the oldest pending message without acking it\n    Given two published messages (\"first message\", \"second message\")\n    When queue_consume is called\n    Then it returns \"first message\" -- FIFO order, and it remains pending until explicitly acked\n\n  Scenario: ack removes exactly the acked message from pending\n    Given the first message is acked by its id\n    When queue_pending is read afterward\n    Then only the SECOND message's id remains -- confirmed via an ensure guard on the exact remaining id, not just a count\n\n  IMPORTANT (unlike the SQL/RDBMS specs above): this subsystem is\n  backed by REAL disk files (.patlang_queue/<topic>.log via write_file/\n  read_file), not the auto-isolated in-memory VFS -- state genuinely\n  persists across process runs and needs EXPLICIT teardown (deleting\n  the real log file), confirmed actually gone afterward, not just\n  attempted.\n"
  let probe = verify_message_queue(pat_exe, tmp_path)
  write_language_spec("message_queue", "stdlib_message_queue", gherkin, probe[0], probe[1])
  print("[LANG SPEC] message queue: " + probe[0] + " -- " + probe[1])
  return probe[0]
end

# signals.patlang: cross-process signal delivery over TCP (single-
# instance detection + when/emit dispatch). Confirmed (reading the
# file's own extensive header) the full send/reply round trip needs
# TWO genuinely concurrent processes (a primary polling in a loop,
# a secondary connecting+querying while the primary is still running)
# -- PatLang has no detached/background-spawn host function (confirmed
# backlog-only, [[patlang-nonblocking-spawn-idea]]), so a single
# synchronous test script cannot drive both sides of that interaction
# at once (signal_query blocks on tcp_read until a reply arrives, which
# only happens once signal_poll runs on the OTHER "side" -- but
# there's no way to run that concurrently from one script). Scoping
# honestly to what IS soundly verifiable single-process, rather than
# writing a spec that can't really prove the full round trip: real
# port-ownership detection (signal_claim) and real poll-timeout
# behavior (signal_poll on an idle port).
make a function called verify_signals_claim_and_poll takes pat_exe, tmp_path returns result
  let src = "include \"../../self_hosting/lib/signals.patlang\"\nlet port_id1 = signal_claim(9601)\nprint(port_id1 >= 0)\n\nlet port_id2 = signal_claim(9601)\nprint(port_id2)\n\nlet result = signal_poll(port_id1, 20)\nprint(\"[\" + result + \"]\")\n"
  write_file(tmp_path, src)
  let output = exec_capture(pat_exe, "--ir-run", tmp_path)
  let primary_claim_ok = contains_text(output, "true\n")
  let second_claim_rejected_ok = contains_text(output, "-1\n")
  let idle_poll_returns_empty_ok = contains_text(output, "[]")

  if primary_claim_ok and second_claim_rejected_ok and idle_poll_returns_empty_ok then
    return ["verified", "signal_claim(port) returns a real, non-negative port_id for the FIRST caller to claim a given port (this process becomes the primary); a SECOND signal_claim on the SAME port, from the same still-running process, correctly returns -1 -- confirming the underlying tcp_try_listen genuinely detects the port is already held, the same free 'is an instance already running' detector the file's own header describes; signal_poll on an idle claimed port with a short timeout returns the empty string (no message arrived) rather than hanging or erroring"]
  end
  return ["inconsistent", "raw output=[" + output + "]"]
end

make a function called discover_signals_claim_and_poll_spec takes pat_exe, tmp_path returns status
  let gherkin = "Feature: signals (signal_claim/signal_poll -- port ownership + idle polling)\n\n  Scenario: The first claimant of a port becomes its primary\n    Given signal_claim(9601) called for the first time\n    When the result is checked\n    Then it is >= 0 (a real port_id)\n\n  Scenario: A second claim on the same port is rejected\n    Given the same process still holds the port from the first claim\n    When signal_claim(9601) is called again\n    Then it returns -1 -- the free single-instance-detection this subsystem relies on\n\n  Scenario: Polling an idle port times out to empty, not an error\n    Given a claimed port with nothing sent to it\n    When signal_poll(port_id, 20) is called\n    Then it returns \"\" within the timeout, not an error or a hang\n\n  IMPORTANT SCOPE NOTE: the full signal_send/signal_query/signal_reply\n  round trip needs TWO genuinely concurrent processes (a primary polling\n  in a loop while a secondary connects and queries it) -- PatLang has no\n  detached-process-spawn host function today, so this cannot be proven\n  by a single synchronous test script. NOT covered here; would need a\n  real two-terminal/two-process manual or CI-level test.\n"
  let probe = verify_signals_claim_and_poll(pat_exe, tmp_path)
  write_language_spec("signals_claim_and_poll", "stdlib_signals", gherkin, probe[0], probe[1])
  print("[LANG SPEC] signals claim/poll: " + probe[0] + " -- " + probe[1])
  return probe[0]
end

# task_registry.patlang: a presence "beacon" built entirely on
# queue.patlang (real disk files, .patlang_queue/task_registry__<name>.
# log). Confirmed from its own header: each announce OVERWRITES the
# task's single row (not an accumulating log, unlike queue_publish's
# own semantics) -- a genuinely different persistence shape from the
# message-queue subsystem it's built on. Needs the SAME real-disk
# teardown discipline as message_queue -- confirmed the bare-vs-
# assigned remove_file distinction applies here too, applied correctly
# from the start this time rather than rediscovering it.
make a function called verify_task_registry takes pat_exe, tmp_path returns result
  let task_name = "spec_scratch_beacon_task"
  let queue_file = ".patlang_queue/task_registry__" + task_name + ".log"

  let src = "include \"../../self_hosting/lib/includes.patlang\"\ninclude \"../../self_hosting/lib/task_registry.patlang\"\nlet task_name = \"" + task_name + "\"\n\ntr_announce(task_name, \"does spec work\")\nlet one = tr_read_one(task_name)\nprint(one[1])\n\nlet found_fresh = tr_discover_all(60000)\nlet fresh_count = 0\nlet i = 0\nwhile i < to_num(list_len(found_fresh)) do\n  if found_fresh[i][0] == task_name then\n    let fresh_count = fresh_count + 1\n  end\n  let i = i + 1\nend\nprint(fresh_count)\n\n# re-announce overwrites, never accumulates a second row\ntr_announce(task_name, \"updated description\")\nlet rows_after_second_announce = q_read(tr_topic_for(task_name))\nensure to_num(list_len(rows_after_second_announce)) == 1\nprint(tr_read_one(task_name)[1])\n"
  write_file(tmp_path, src)
  let output = exec_capture(pat_exe, "--ir-run", tmp_path)

  if file_exists(queue_file) == "1" then
    let removed = remove_file(queue_file)
  end
  let teardown_confirmed_ok = file_exists(queue_file) != "1"

  let announce_and_read_ok = contains_text(output, "does spec work")
  let discover_finds_fresh_ok = contains_text(output, "1\n")
  let no_contract_violation_ok = not contains_text(output, "contract violation")
  let overwrite_not_accumulate_ok = contains_text(output, "updated description")

  if announce_and_read_ok and discover_finds_fresh_ok and no_contract_violation_ok and overwrite_not_accumulate_ok and teardown_confirmed_ok then
    return ["verified", "tr_announce(task, description) writes a single-row presence beacon; tr_read_one reads it back; tr_discover_all(max_age_ms) finds it when the age window is generous; a SECOND tr_announce for the same task OVERWRITES the row (confirmed via an ensure guard: exactly 1 row remains, not 2) -- a genuinely different persistence shape from queue_publish's own accumulating log, even though both are built on the same q_read/q_write primitives; real disk-file teardown explicitly removed and re-confirmed gone"]
  end
  return ["inconsistent", "raw output=[" + output + "] teardown_confirmed_ok=" + ("" + teardown_confirmed_ok)]
end

# Full signal_send/query/reply round trip, using a REAL second
# process via a batch file (`start /B` launches the primary detached,
# the batch file's own foreground line then runs the secondary
# synchronously) -- genuine concurrency, closing the gap the earlier
# single-process signals spec honestly flagged as unprovable without
# it. `ping -n 2 127.0.0.1 >nul` is used as the inter-launch pause
# (portable cross-Windows-version sleep trick; `timeout` fails under
# exec_capture's redirected/non-interactive stdin).
make a function called verify_signals_full_round_trip takes pat_exe, tmp_path returns result
  let scratch = "friendly_cli/spec_scratch"
  let primary_path = scratch + "/signals_primary.patlang"
  let secondary_path = scratch + "/signals_secondary.patlang"
  let primary_log = scratch + "/signals_primary.log"
  let bat_path = scratch + "/signals_round_trip.bat"
  let port = "9602"

  let primary_src = "include \"../../self_hosting/lib/includes.patlang\"\ninclude \"../../self_hosting/lib/signals.patlang\"\nwhen status do\n  signal_reply(\"uptime: 42\")\nend\nwhen quit do\n  set_var(\"should_stop\", \"1\")\nend\n\nlet port_id = signal_claim(" + port + ")\nlet i = 0\nlet stop = false\nwhile (i < 50) and (not stop) do\n  signal_poll(port_id, 100)\n  if get(\"__vars\", \"should_stop\") == \"1\" then\n    let stop = true\n  end\n  let i = i + 1\nend\nprint(\"PRIMARY DONE, iterations=\" + i)\n"
  write_file(primary_path, primary_src)

  let secondary_src = "include \"../../self_hosting/lib/includes.patlang\"\ninclude \"../../self_hosting/lib/signals.patlang\"\nlet reply = signal_query(" + port + ", \"status\", \"\")\nprint(\"REPLY: \" + reply)\nsignal_send(" + port + ", \"quit\", \"\")\nprint(\"SECONDARY DONE\")\n"
  write_file(secondary_path, secondary_src)

  let bat_src = "@echo off\r\nstart /B \"\" \"" + pat_exe + "\" --ir-run \"" + primary_path + "\" > \"" + primary_log + "\" 2>&1\r\nping -n 2 127.0.0.1 >nul\r\n\"" + pat_exe + "\" --ir-run \"" + secondary_path + "\"\r\nping -n 2 127.0.0.1 >nul\r\n"
  write_file(bat_path, bat_src)

  let secondary_output = exec_capture(bat_path)
  # give the (already-signalled-to-quit) detached primary a moment to
  # actually finish writing its own log before reading it
  exec_capture("ping", "-n", "2", "127.0.0.1")
  let primary_output = read_file(primary_log)

  let removed1 = remove_file(primary_path)
  let removed2 = remove_file(secondary_path)
  let removed3 = remove_file(primary_log)
  let removed4 = remove_file(bat_path)

  let correct_reply_ok = contains_text(secondary_output, "REPLY: uptime: 42")
  let primary_saw_and_exited_ok = contains_text(primary_output, "PRIMARY DONE")

  if correct_reply_ok and primary_saw_and_exited_ok then
    return ["verified", "the FULL signal_send/signal_query/signal_reply round trip works across two GENUINELY CONCURRENT processes (a detached primary launched via `start /B`, a synchronous secondary) -- the secondary's signal_query(port,\"status\",\"\") received EXACTLY the text the primary's `when status` handler passed to signal_reply (\"uptime: 42\"), not just some reply; the primary's own subsequent signal_send(\"quit\") correctly stopped its poll loop early (confirmed via the primary's OWN log output, read after the fact, showing it exited via the quit path rather than running all 50 iterations)"]
  end
  return ["inconsistent", "secondary_output=[" + secondary_output + "] primary_output=[" + primary_output + "]"]
end

make a function called discover_signals_full_round_trip_spec takes pat_exe, tmp_path returns status
  let gherkin = "Feature: signals full round trip (signal_send/signal_query/signal_reply, two real concurrent processes)\n\n  Scenario: A query reaches the primary and its reply reaches the secondary, verbatim\n    Given a detached primary process (launched via `start /B`) with `when status do signal_reply(\"uptime: 42\") end` registered\n    When a separate, synchronous secondary process calls signal_query(port, \"status\", \"\")\n    Then it receives exactly \"uptime: 42\" -- the primary's own handler's reply text, round-tripped over the real TCP connection between two real OS processes\n\n  Scenario: A fire-and-forget quit signal stops the primary's poll loop early\n    Given the secondary also calls signal_send(port, \"quit\", \"\") afterward\n    When the primary's own log is inspected after the fact\n    Then it shows the primary exited via the quit path, not by running its full bounded iteration count\n\n  This closes the gap [[patlang-language-instruction-specs]]'s earlier\n  single-process signals spec explicitly left open (the full round trip\n  needs two genuinely concurrent processes, which a single synchronous\n  script cannot provide) -- a batch file with `start /B` supplies the\n  real concurrency PatLang itself has no host function for yet.\n"
  let probe = verify_signals_full_round_trip(pat_exe, tmp_path)
  write_language_spec("signals_full_round_trip", "stdlib_signals", gherkin, probe[0], probe[1])
  print("[LANG SPEC] signals full round trip: " + probe[0] + " -- " + probe[1])
  return probe[0]
end

# build_daemon.patlang: the session's own "exemplar" tying together
# logic (rule_add/solve), GOAP (action_add/plan), self-timing+
# persistence (now_ms(), a real history file), events (when/emit), and
# signals -- five subsystems in one real program. Uses the SAME
# batch-file two-process technique as the signals full-round-trip spec
# above (self_hosting/examples/build_daemon_demo.patlang already
# supports exactly this: run once with no args to become the primary,
# run again with "status"/"rebuild"/"quit" as a CLI arg to talk to it).
#
# REAL SHARED STATE WARNING, confirmed by reading bd_history_file():
# unlike every other stdlib-subsystem probe in this file, the history
# file this writes to (portfolio/build/build_daemon_history.txt) is a
# SHARED, non-scratch path used by the real exemplar/demo -- NOT
# something safe to just overwrite and walk away from. Backs up its
# existing content before running anything, restores it byte-for-byte
# afterward, and verifies the restore actually took (confirmed equal
# again), rather than assuming a probe "wouldn't really matter".
make a function called verify_build_daemon takes pat_exe, tmp_path returns result
  let history_file = "portfolio/build/build_daemon_history.txt"
  let demo_path = "self_hosting/examples/build_daemon_demo.patlang"
  let scratch = "friendly_cli/spec_scratch"
  let bat_path = scratch + "/bd_round_trip.bat"
  let primary_log = scratch + "/bd_primary.log"

  let had_prior_history = file_exists(history_file) == "1"
  let prior_history = ""
  if had_prior_history then
    let prior_history = read_file(history_file)
  end

  let bat_src = "@echo off\r\nstart /B \"\" \"" + pat_exe + "\" --ir-run \"" + demo_path + "\" > \"" + primary_log + "\" 2>&1\r\nping -n 3 127.0.0.1 >nul\r\n\"" + pat_exe + "\" --ir-run \"" + demo_path + "\" status\r\n\"" + pat_exe + "\" --ir-run \"" + demo_path + "\" quit\r\nping -n 2 127.0.0.1 >nul\r\n"
  write_file(bat_path, bat_src)

  let client_output = exec_capture(bat_path)
  exec_capture("ping", "-n", "2", "127.0.0.1")
  let primary_output = read_file(primary_log)

  # Restore shared state BEFORE checking anything else, so a probe
  # failure never leaves real project state mutated.
  if had_prior_history then
    let restored = write_file(history_file, prior_history)
  else
    if file_exists(history_file) == "1" then
      let removed = remove_file(history_file)
    end
  end
  let restore_confirmed_ok = true
  if had_prior_history then
    let restore_confirmed_ok = read_file(history_file) == prior_history
  else
    let restore_confirmed_ok = file_exists(history_file) != "1"
  end

  let removed_bat = remove_file(bat_path)
  let removed_log = remove_file(primary_log)

  let status_reply_ok = contains_text(client_output, "rebuilt")
  let daemon_ran_cycle_ok = contains_text(primary_output, "DAEMON: holding port")
  let daemon_quit_cleanly_ok = contains_text(primary_output, "DAEMON: exiting")

  if status_reply_ok and daemon_ran_cycle_ok and daemon_quit_cleanly_ok and restore_confirmed_ok then
    return ["verified", "the full build-daemon exemplar works across two real, concurrent processes: a detached primary claims the signal port, runs an initial GOAP-planned build cycle (logic facts -> stale-target derivation -> cost-weighted plan -> when/emit-driven dashboard lines -> a persisted history file), then a separate 'status' invocation gets back a real reply describing what was rebuilt, and a separate 'quit' invocation cleanly stops the primary's poll loop (confirmed via the primary's own log showing 'DAEMON: exiting', not left running); the shared, non-scratch history file was backed up before the run and restored byte-for-byte afterward, confirmed equal again"]
  end
  return ["inconsistent", "client_output=[" + client_output + "] primary_output=[" + primary_output + "] restore_confirmed_ok=" + ("" + restore_confirmed_ok)]
end

make a function called discover_build_daemon_spec takes pat_exe, tmp_path returns status
  let gherkin = "Feature: build_daemon (exemplar: logic + GOAP + timing/persistence + events + signals, self_hosting/lib/build_daemon.patlang)\n\n  Scenario: A detached primary runs an initial GOAP-planned build cycle\n    Given self_hosting/examples/build_daemon_demo.patlang launched with no CLI args (via `start /B`)\n    When it claims the signal port\n    Then it runs a build cycle derived from real logic facts (rule_add/solve) and a real cost-weighted GOAP plan (action_add/plan), logging via when/emit\n\n  Scenario: A separate 'status' invocation gets a real reply\n    Given the primary is still running\n    When a separate process runs the same demo with \"status\" as its CLI argument\n    Then it receives a reply describing what was actually rebuilt -- a real signal_query round trip, same mechanism as the standalone signals spec\n\n  Scenario: A separate 'quit' invocation cleanly stops the primary\n    Given the primary is still polling\n    When a separate process sends \"quit\"\n    Then the primary's own log shows \"DAEMON: exiting\", not left running indefinitely\n\n  IMPORTANT: this exemplar writes to a REAL SHARED file (portfolio/\n  build/build_daemon_history.txt), not an isolated scratch path -- any\n  test driving this program for real must back up that file's existing\n  content first and restore it afterward, confirmed byte-for-byte equal\n  again, exactly as this probe itself does.\n"
  let probe = verify_build_daemon(pat_exe, tmp_path)
  write_language_spec("build_daemon_exemplar", "stdlib_build_daemon", gherkin, probe[0], probe[1])
