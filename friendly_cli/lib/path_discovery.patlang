# =============================================================================
# PATH enumeration + safety classification (spec-library initiative,
# "disciplined exploration of what's on PATH" per the user's own framing
# -- discovering candidates mechanically rather than only ever working
# from a hand-typed list of names someone thought to mention).
#
# This module does NOT call an LLM and does NOT execute anything -- it
# only enumerates real files on PATH and classifies them using the
# safety machinery already built (command_safety.patlang's blacklist
# tiers, pe_subsystem.patlang's GUI detection). Turning a classified
# candidate into an actual Gherkin spec (an LLM call) is a deliberately
# SEPARATE, explicit step -- see discover_shell_specs.patlang -- so that
# walking PATH (which can easily surface several hundred candidates on
# a real machine) never itself triggers hundreds of LLM calls or exec
# attempts. This is a cheap, safe, local REPORT-first step.
# =============================================================================

# Splits PATH on Windows's ";" separator into a list of directories.
make a function called path_directories returns dirs
  let raw = getenv("PATH")
  let dirs = []
  let start = 0
  let i = 0
  while i <= raw.length do
    if (i == raw.length) or (substr(raw, i, 1) == ";") then
      if i > start then
        let dirs = list_push(dirs, substr(raw, start, i - start))
      end
      let start = i + 1
    end
    let i = i + 1
  end
  return dirs
end

# No case-conversion primitive exists anywhere in this codebase yet
# (neither a host function nor a self_hosting/lib one) -- ASCII-only is
# sufficient here, since every real Windows command/extension name this
# module cares about is plain ASCII.
make a function called lower_case takes s returns lowered
  let sb = sb_new()
  let i = 0
  while i < s.length do
    let c = char_code(s, i)
    if (c >= 65) and (c <= 90) then
      sb_push(sb, chr(c + 32))
    else
      sb_push(sb, substr(s, i, 1))
    end
    let i = i + 1
  end
  return sb_str(sb)
end

make a function called ends_with_ci takes s, suffix returns yes
  if suffix.length > s.length then
    return false
  end
  let tail = substr(s, s.length - suffix.length, suffix.length)
  return lower_case(tail) == lower_case(suffix)
end

# Recognised executable extensions -- matches PATHEXT's own usual
# default set, minus VBS/JS/WS (script-host extensions this project has
# no reason to enumerate as "commands" the same way).
make a function called is_executable_filename takes name returns yes
  if ends_with_ci(name, ".exe") then
    return true
  end
  if ends_with_ci(name, ".com") then
    return true
  end
  if ends_with_ci(name, ".bat") then
    return true
  end
  if ends_with_ci(name, ".cmd") then
    return true
  end
  return false
end

make a function called strip_extension takes name returns base
  let dot = -1
  let i = 0
  while i < name.length do
    if substr(name, i, 1) == "." then
      let dot = i
    end
    let i = i + 1
  end
  if dot < 0 then
    return name
  end
  return substr(name, 0, dot)
end

# Enumerates every real executable name findable on PATH, deduped by
# base name (first directory wins, matching real OS PATH-priority
# resolution -- confirmed against this machine's own behavior earlier,
# e.g. Git's usr/bin shadowing System32 for several names). Returns a
# list of [name, full_path] pairs. This can genuinely take a few
# seconds on a PATH with many directories -- it's still purely local
# file-listing, no LLM, no execution.
make a function called discover_path_commands returns candidates
  let dirs = path_directories()
  let seen = []
  let out = []
  let d = 0
  while d < to_num(list_len(dirs)) do
    let dir = dirs[d]
    let norm_dir = dir
    if ends_with_ci(dir, "\\") or ends_with_ci(dir, "/") then
      let norm_dir = substr(dir, 0, dir.length - 1)
    end
    if file_exists(norm_dir) == "1" then
      let entries = list_dir(norm_dir)
      let e = 0
      while e < to_num(list_len(entries)) do
        let entry = entries[e]
        # list_dir suffixes directories with "/" -- skip those, only
        # real files are candidate commands.
        if not ends_with_ci(entry, "/") then
          if is_executable_filename(entry) then
            let base = lower_case(strip_extension(entry))
            if not contains_text_list(seen, base) then
              let seen = list_push(seen, base)
              let out = list_push(out, [base, norm_dir + "/" + entry])
            end
          end
        end
        let e = e + 1
      end
    end
    let d = d + 1
  end
  return out
end

make a function called contains_text_list takes items, target returns yes
  let i = 0
  while i < to_num(list_len(items)) do
    if items[i] == target then
      return true
    end
    let i = i + 1
  end
  return false
end

# Classifies every discovered candidate through the already-built
# safety machinery (no execution, no LLM) and returns a summary report
# string plus the list of candidates that are genuinely worth
# considering for spec generation next -- console-subsystem executables
# not on any blacklist tier.
make a function called classify_discovered_commands takes candidates returns report_and_unclassified
  let counts_no_workaround = 0
  let counts_safe_alias = 0
  let counts_human_confirm = 0
  let counts_gui = 0
  let counts_not_pe = 0
  let counts_console_unclassified = 0
  let unclassified = []

  let i = 0
  while i < to_num(list_len(candidates)) do
    let pair = candidates[i]
    let name = pair[0]
    let path = pair[1]
    let tier = classify_command(name)
    if tier == "no_workaround" then
      let counts_no_workaround = counts_no_workaround + 1
    else
      if tier == "safe_alias" then
        let counts_safe_alias = counts_safe_alias + 1
      else
        if tier == "human_confirm" then
          let counts_human_confirm = counts_human_confirm + 1
        else
          let pe_class = pe_subsystem_classify(path)
          if pe_class == "gui" then
            let counts_gui = counts_gui + 1
          else
            if pe_class == "other" then
              let counts_gui = counts_gui + 1
            else
              if pe_class == "not_pe" then
                let counts_not_pe = counts_not_pe + 1
              else
                let counts_console_unclassified = counts_console_unclassified + 1
                let unclassified = list_push(unclassified, [name, path])
              end
            end
          end
        end
      end
    end
    let i = i + 1
  end

  let sb = sb_new()
  sb_push(sb, "PATH discovery report:\n")
  sb_push(sb, "  total candidates found: " + ("" + to_num(list_len(candidates))) + "\n")
  sb_push(sb, "  no_workaround (never touched, hard blacklist): " + ("" + counts_no_workaround) + "\n")
  sb_push(sb, "  safe_alias (delete-shaped, quarantine-only): " + ("" + counts_safe_alias) + "\n")
  sb_push(sb, "  human_confirm (diagnostic-report-only): " + ("" + counts_human_confirm) + "\n")
  sb_push(sb, "  gui/other subsystem (never executed): " + ("" + counts_gui) + "\n")
  sb_push(sb, "  not a real PE executable (scripts, shims, etc.): " + ("" + counts_not_pe) + "\n")
  sb_push(sb, "  console, unclassified -- candidates for spec generation: " + ("" + counts_console_unclassified) + "\n")
  return [sb_str(sb), unclassified]
end
