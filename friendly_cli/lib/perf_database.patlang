# =============================================================================
# Relational Task Performance Database & Regression Engine
# Generalizes performance prediction across multiple task categories 
# (e.g. compile, zip, pandoc, AI query) and persists metrics.
# =============================================================================

# --- Load Task Model Weights (w, b) ---
make a function called load_task_regression_weights takes task_type returns weights
  let path = "friendly_cli/perf_weights_" + task_type + ".data"
  let exists = file_exists(path) == "1"
  
  if not exists then
    # Defaults: w = 35.0 ms/unit, bias = 2000.0 ms
    return [35.0, 2000.0]
  end

  let content = read_file(path)
  let comma_idx = -1
  let n = content.length
  let i = 0
  while i < n do
    if char_code(content, i) == 44 then
      let comma_idx = i
      let i = n
    end
    let i = i + 1
  end

  if comma_idx < 0 then
    return [35.0, 2000.0]
  end

  let w_str = substr(content, 0, comma_idx)
  let b_str = substr(content, comma_idx + 1, n - comma_idx - 1)
  return [to_num(w_str), to_num(b_str)]
end

# --- Save Task Model Weights ---
make a function called save_task_regression_weights takes task_type, w, b returns ok
  let path = "friendly_cli/perf_weights_" + task_type + ".data"
  let data_str = "" + w + "," + b
  write_file(path, data_str)
  return true
end

# --- Predict Time for Any Task: T = (w * Units) + b ---
make a function called predict_task_duration takes task_type, units returns ms
  let weights = load_task_regression_weights(task_type)
  let w = weights[0]
  let b = weights[1]
  let estimate = (w * units) + b
  return estimate
end

# --- Relational Performance History Logger ---
make a function called log_performance_record takes task_type, units, actual_ms, predicted_ms returns ok
  let path = "friendly_cli/performance_database.sql"
  
  # Format record as SQL insert simulator
  let line = "INSERT INTO performance_metrics (task_type, units, actual_ms, predicted_ms) VALUES ('"
  let line = line + task_type + "', " + units + ", " + actual_ms + ", " + predicted_ms + ");\n"
  
  let existing = ""
  if file_exists(path) == "1" then
    let existing = read_file(path)
  end
  
  write_file(path, existing + line)
  return true
end

# --- Update Task Model Weights via Gradient Descent ---
make a function called update_task_weights takes task_type, units, actual_ms returns ok
  let weights = load_task_regression_weights(task_type)
  let w = weights[0]
  let b = weights[1]

  let pred = (w * units) + b
  let error = pred - actual_ms

  # Tune learning rates dynamically per task type
  let alpha_w = 0.000005
  let alpha_b = 0.05
  if task_type == "zip" then
    let alpha_w = 0.005
    let alpha_b = 0.1
  end

  let grad_w = error * units
  let grad_b = error

  let new_w = w - (alpha_w * grad_w)
  let new_b = b - (alpha_b * grad_b)

  # Boundaries
  if new_w < 0.1 then
    let new_w = 0.1
  end
  if new_b < 100.0 then
    let new_b = 100.0
  end

  print("  [DATABASE UPDATE] Task: " + task_type + " | New w: " + new_w + " ms/unit | Bias: " + new_b + " ms")
  save_task_regression_weights(task_type, new_w, new_b)
  log_performance_record(task_type, units, actual_ms, pred)
  return true
end
