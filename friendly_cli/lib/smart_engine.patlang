# =============================================================================
# Friendly CLI Smart GOAP Engine & DbC Contract Library
# Provides actions, contracts, and automatic goal chaining.
# =============================================================================



# --- Design-by-Contract Helpers ---

make a function called verify_file_contract takes file_path returns ok
  let exists_ok = (file_exists(file_path) == "1") or (file_exists(file_path) == true)
  require exists_ok == true
  ensure exists_ok == true
  print("[CONTRACT PASS] Verified file " + file_path + " exists on disk.")
  return true
end

make a function called zip_files takes src_pattern, dest_zip returns ok
  let has_pdf = (file_exists("friendly_cli/test_src/doc1.pdf") == "1") or (file_exists("friendly_cli/test_src/doc1.pdf") == true)
  require has_pdf == true
  print("  [SYSTEM SHELL] Compressing " + src_pattern + " into " + dest_zip)
  let cmd_out = exec_capture("powershell", "-Command", "Compress-Archive -Path " + src_pattern + " -DestinationPath " + dest_zip + " -Force")
  let zip_ok = (file_exists(dest_zip) == "1") or (file_exists(dest_zip) == true)
  ensure zip_ok == true
  print("[CONTRACT PASS] Real zip archive created by Windows PowerShell: " + dest_zip)
  return true
end

include "perf_database.patlang"

make a function called count_matching_files takes folder, ext returns count
  let files = list_dir(folder)
  let i = 0
  let count = 0
  while i < files.length do
    if str_ends_with(files[i], "." + ext) then
      let count = count + 1
    end
    let i = i + 1
  end
  return count
end

make a function called get_system_time_ms returns ms
  let raw = exec_capture("powershell", "-Command", "[DateTimeOffset]::UtcNow.ToUnixTimeMilliseconds()")
  return to_num(raw)
end

make a function called init_smart_reasoning_engine returns ok
  # Reset/initialize goal actions in knowledge base
  # Format: action_add(name, preconditions, effects, contracts, cost)
  
  # Action 1: Convert Markdown to Word Docx
  action_add("act_md_to_docx", 
    [["has_md", ["docs"]]], 
    [["has_docx", ["docs"]]], 
    [], 1)
    
  # Action 2: Convert Word Docx to PDF
  action_add("act_docx_to_pdf", 
    [["has_docx", ["docs"]]], 
    [["has_pdf", ["docs"]]], 
    [], 1)

  # Action 3: Archive generated PDFs into backup zip
  action_add("act_archive_pdf", 
    [["has_pdf", ["docs"]]], 
    [["archived", ["backup.zip"]]], 
    [], 1)

  # Bind actual execution logic to planned actions with AUTOMATIC TIMING AND LEARNING
  action_bind("act_md_to_docx", |args| {
    let files_count = count_matching_files("friendly_cli/test_src", "md")
    let est = predict_task_duration("pandoc", files_count)
    print("[SMART GOAP EXECUTING] Step 1: Converting " + files_count + " Markdown files (Estimated: " + est + " ms)...")
    
    let start_time = get_system_time_ms()
    batch_convert_files("md", "friendly_cli/test_src", "docx")
    let duration = get_system_time_ms() - start_time
    
    print("  -> Actually took: " + duration + " ms")
    update_task_weights("pandoc", files_count, duration)
    verify_file_contract("friendly_cli/test_src/doc1.docx")
    return true
  })

  action_bind("act_docx_to_pdf", |args| {
    let files_count = count_matching_files("friendly_cli/test_src", "docx")
    let est = predict_task_duration("pandoc", files_count)
    print("[SMART GOAP EXECUTING] Step 2: Converting " + files_count + " Word Docx files (Estimated: " + est + " ms)...")
    
    let start_time = get_system_time_ms()
    batch_convert_files("docx", "friendly_cli/test_src", "pdf")
    let duration = get_system_time_ms() - start_time
    
    print("  -> Actually took: " + duration + " ms")
    update_task_weights("pandoc", files_count, duration)
    verify_file_contract("friendly_cli/test_src/doc1.pdf")
    return true
  })

  action_bind("act_archive_pdf", |args| {
    let files_count = count_matching_files("friendly_cli/test_src", "pdf")
    let est = predict_task_duration("zip", files_count)
    print("[SMART GOAP EXECUTING] Step 3: Archiving " + files_count + " PDFs into zip (Estimated: " + est + " ms)...")
    
    let start_time = get_system_time_ms()
    zip_files("friendly_cli/test_src/*.pdf", "friendly_cli/test_dest/backup.zip")
    let duration = get_system_time_ms() - start_time
    
    print("  -> Actually took: " + duration + " ms")
    update_task_weights("zip", files_count, duration)
    verify_file_contract("friendly_cli/test_dest/backup.zip")
    return true
  })

  # Assert initial state facts
  rule_add("has_md", ["docs"], [])
  return true
end

make a function called execute_goal_target takes target_fact returns ok
  print("[REASONING ENGINE] Solving plan for target goal: " + target_fact)
  
  let target_state = []
  if target_fact == "make_pdfs" then
    let target_state = [["has_pdf", ["docs"]]]
  end
  if target_fact == "archive_backup" then
    let target_state = [["archived", ["backup.zip"]]]
  end

  let planned_steps = plan(target_state)
  print("[REASONING ENGINE] Plan computed with " + list_len(planned_steps) + " step(s):")
  
  let i = 0
  let n = to_num(list_len(planned_steps))
  while i < n do
    print("  " + (i + 1) + ". " + planned_steps[i])
    let i = i + 1
  end

  # Pre-execution total time estimation output
  let total_est = 0
  let files_md = count_matching_files("friendly_cli/test_src", "md")
  if target_fact == "archive_backup" then
    let est_md_docx = predict_task_duration("pandoc", files_md)
    let est_docx_pdf = predict_task_duration("pandoc", files_md)
    let est_zip = predict_task_duration("zip", files_md)
    let total_est = est_md_docx + est_docx_pdf + est_zip
  end
  print("[REASONING ENGINE] Estimated total plan execution time: " + total_est + " ms")

  let start_plan = get_system_time_ms()
  let success = activate planned_steps
  let actual_plan = get_system_time_ms() - start_plan
  
  print("[REASONING ENGINE] Plan execution complete! Result: " + success)
  print("[REASONING ENGINE] Total execution took: " + actual_plan + " ms (Prediction Margin: " + (actual_plan - total_est) + " ms)")
  return success
end
