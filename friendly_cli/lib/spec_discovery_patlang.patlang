make a function called discover_synth5_fact_binary_spec returns status
  let source_file = "self_hosting/lib/synthesis_lgg.patlang"
  let qualified_id = qualify_function_id(source_file, "synth5_fact_binary")
  let gherkin = "Feature: synth5_fact_binary (" + source_file + ")\n\n  Scenario: Builds a [pred, arg1, arg2] triple\n    Given pred=\"dep\", arg1=\"a\", arg2=\"b\"\n    When synth5_fact_binary is applied\n    Then the result is [\"dep\", \"a\", \"b\"]\n"
  let probe = verify_synth5_fact_binary()
  write_patlang_spec(qualified_id, "synth5_fact_binary", source_file, gherkin, probe[0], probe[1])
  print("[SPEC DISCOVERY] synth5_fact_binary: " + probe[0] + " -- " + probe[1])
  return probe[0]
end

# =============================================================================
# Group C, test.patlang's own framework helpers -- originally flagged as
# a "who verifies the verifier" question rather than a technical
# blocker. Resolved by being precise about WHAT is actually being
# verified: not "does check() correctly judge equality" (a deeper,
# genuinely circular question), but t_report's own narrow, observable
# contract -- given known t_pass/t_fail counter VALUES (set directly via
# set_var, bypassing check() entirely so the probe doesn't depend on the
# very thing it would be circular to assume), does t_report report and
# return correctly? That's a plain, non-circular claim.
# =============================================================================

make a function called verify_t_report returns result
  set_var("t_pass", 3)
  set_var("t_fail", 0)
  let all_pass_ok = t_report()

  set_var("t_pass", 2)
  set_var("t_fail", 1)
  let has_fail_ok = not t_report()

  if all_pass_ok and has_fail_ok then
    return ["verified", "reads the t_pass/t_fail counters (set elsewhere, by check()) and returns true only when t_fail is exactly 0 -- a narrow, non-circular claim about t_report's OWN reporting logic; NOT a claim that check() itself correctly judges any given assertion (a separate, genuinely circular question this spec deliberately does not attempt to settle)"]
  end
  return ["inconsistent", "all_pass_ok=" + ("" + all_pass_ok) + " has_fail_ok=" + ("" + has_fail_ok)]
end

make a function called discover_t_report_spec returns status
  let source_file = "self_hosting/lib/test.patlang"
  let qualified_id = qualify_function_id(source_file, "t_report")
  let gherkin = "Feature: t_report (" + source_file + ")\n\n  Background:\n    This spec verifies t_report's OWN narrow contract (reads t_pass/\n    t_fail counters, reports, returns a boolean) by setting those\n    counters directly -- it does NOT verify that check() (which\n    normally sets them) correctly judges any given assertion. That\n    would be a genuinely circular claim (verifying the test framework's\n    own correctness using the test framework), named explicitly here\n    rather than quietly assumed away.\n\n  Scenario: All tests passed\n    Given t_pass=3, t_fail=0\n    When t_report is called\n    Then it returns true\n\n  Scenario: Some tests failed\n    Given t_pass=2, t_fail=1\n    When t_report is called\n    Then it returns false\n"
  let probe = verify_t_report()
  write_patlang_spec(qualified_id, "t_report", source_file, gherkin, probe[0], probe[1])
  print("[SPEC DISCOVERY] t_report: " + probe[0] + " -- " + probe[1])
  return probe[0]
end

# step(text, fname) -- creates a "Step" object (id = the step's own text)
# and stores fname under its "fn" field, via new/send -- real object-
# system side effects, not a pure function. Verified by reading the
# field back the SAME way the framework's own step-dispatch code does
# (get(text, "fn"), confirmed from test.patlang's own line 153 usage) --
# not a guess at the storage convention.
make a function called verify_step returns result
  let ok1 = step("a fresh till", "st_fresh_till")
  let stored_fn = get("a fresh till", "fn")
  let ok2 = stored_fn == "st_fresh_till"

  if ok1 and ok2 then
    return ["verified", "registers a Gherkin step: creates a \"Step\" object keyed by the step's own text, storing the given implementing-function name under its \"fn\" field -- readable back afterward via get(text, \"fn\"), the same access pattern the framework's own step-dispatch code uses"]
  end
  return ["inconsistent", "ok1=" + ("" + ok1) + " ok2=" + ("" + ok2)]
end

make a function called discover_step_spec returns status
  let source_file = "self_hosting/lib/test.patlang"
  let qualified_id = qualify_function_id(source_file, "step")
  let gherkin = "Feature: step (" + source_file + ")\n\n  Scenario: Registers a step's implementing function\n    Given step text \"a fresh till\" and implementing function name \"st_fresh_till\"\n    When step is called\n    Then get(\"a fresh till\", \"fn\") returns \"st_fresh_till\" -- a real object-system side effect (new + send), not a pure computation\n"
  let probe = verify_step()
  write_patlang_spec(qualified_id, "step", source_file, gherkin, probe[0], probe[1])
  print("[SPEC DISCOVERY] step: " + probe[0] + " -- " + probe[1])
  return probe[0]
end

# Group A closeout: char_code, file_exists, sc_code/sc_char,
# rt_print_i64 -- extended friendly_cli/spec_scratch/
# x64_stdlib_probe.patlang with probe lines for each, recompiled via
# `patc1.exe ... --x64`, ran the real .exe, confirmed every value by
# hand: char_code("ABC",0)=65, char_code("ABC",2)=67; rt_print_i64(-42)
# printed "-42"; file_exists of a real file printed "1", a nonexistent
# path printed "0"; sc_code(intern("XYZ"),0)=88, sc_char(...,2)="Z".
# Same one-off-manual-verification method as the first x64_runtime.
# patlang batch (see discover_x64_sb_builder_spec above) -- not an
# automated repeatable in-process probe.

make a function called discover_x64_char_code_spec returns status
  let source_file = "self_hosting/lib/x64_runtime.patlang"
  let qualified_id = qualify_function_id(source_file, "char_code")
  let note = x64_manual_verify_note_text()
  let gherkin = "Feature: char_code (" + source_file + ")\n\n  Scenario: Returns the ASCII code of the byte at idx\n    Given \"ABC\"\n    When char_code is applied with idx 0, then idx 2\n    Then the results are 65 ('A') and 67 ('C')\n"
  write_patlang_spec(qualified_id, "char_code", source_file, gherkin, "verified", note)
  print("[SPEC DISCOVERY] x64 char_code: verified -- " + note)
  return "verified"
end

