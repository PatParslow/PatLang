# =============================================================================
# Group B, lexer/parser internals -- needed purpose-built fixtures (small
# representative source strings + hand-checked expected token/AST
# shapes), not one-line probes. Both directly callable under --ir-run:
# lexer.patlang/parser.patlang use the NATIVE str_intern/sc_len/sc_code/
# sc_char/vec_* host functions, NOT x64_runtime.patlang's tagged-pointer
# versions (confirmed: neither file includes x64_runtime.patlang).
# =============================================================================

# tokenize(src) -> a vec_* HANDLE (not a plain list) of [type, text,
# line] triples, always terminated with an ["EOF", "", line] token even
# for empty input. Types confirmed from source: NUM, IDENT, STR, OP, NL,
# UNK, EOF, COMMENT-lines are consumed silently (never tokenized at all,
# not even as a token type).
make a function called verify_tokenize returns result
  # basic: identifier, op, number, newline, EOF
  let t1 = tokenize("x = 1\n")
  let t1_0 = vec_get(t1, 0)
  let t1_1 = vec_get(t1, 1)
  let t1_2 = vec_get(t1, 2)
  let t1_3 = vec_get(t1, 3)
  let t1_4 = vec_get(t1, 4)
  let t1_ok = (vec_len(t1) == 5)
    and (t1_0[0] == "IDENT") and (t1_0[1] == "x")
    and (t1_1[0] == "OP") and (t1_1[1] == "=")
    and (t1_2[0] == "NUM") and (t1_2[1] == "1")
    and (t1_3[0] == "NL")
    and (t1_4[0] == "EOF")

  # empty input still yields exactly one EOF token
  let t2 = tokenize("")
  let t2_0 = vec_get(t2, 0)
  let t2_ok = (vec_len(t2) == 1) and (t2_0[0] == "EOF")

  # '#' starts a line comment -- consumed silently, produces NO token at all
  let t3 = tokenize("# a comment\nx")
  let t3_0 = vec_get(t3, 0)
  let t3_1 = vec_get(t3, 1)
  let t3_2 = vec_get(t3, 2)
  let t3_ok = (vec_len(t3) == 3)
    and (t3_0[0] == "NL")
    and (t3_1[0] == "IDENT") and (t3_1[1] == "x")
    and (t3_2[0] == "EOF")

  # string literal escapes: \n \t \" all decode to their real bytes
  let t4 = tokenize("\"a\\nb\\t\\\"c\"")
  let t4_0 = vec_get(t4, 0)
  let t4_ok = (vec_len(t4) == 2)
    and (t4_0[0] == "STR")
    and (t4_0[1] == ("a" + chr(10) + "b" + chr(9) + "\"c"))

  # two-char operators: '==' stays one OP token, not two
  let t5 = tokenize("==")
  let t5_0 = vec_get(t5, 0)
  let t5_ok = (vec_len(t5) == 2)
    and (t5_0[0] == "OP") and (t5_0[1] == "==")

  if t1_ok and t2_ok and t3_ok and t4_ok and t5_ok then
    return ["verified", "returns a vec_* handle of [type,text,line] triples, always EOF-terminated (even for empty input); '#' starts a silently-consumed line comment (produces no token); string escapes \\n/\\t/\\\" decode to real bytes; two-char operators like '==' are recognized as one OP token, not split"]
  end
  return ["inconsistent", "t1_ok=" + ("" + t1_ok) + " t2_ok=" + ("" + t2_ok) + " t3_ok=" + ("" + t3_ok) + " t4_ok=" + ("" + t4_ok) + " t5_ok=" + ("" + t5_ok)]
end

make a function called discover_tokenize_spec returns status
  let source_file = "self_hosting/lib/lexer.patlang"
  let qualified_id = qualify_function_id(source_file, "tokenize")
  let gherkin = "Feature: tokenize (" + source_file + ")\n\n  Scenario: A simple assignment tokenizes as expected\n    Given the source \"x = 1\\n\"\n    When tokenize is applied\n    Then the result is [IDENT x][OP =][NUM 1][NL][EOF], as a vec_* handle (use vec_len/vec_get, not list_len/list access)\n\n  Scenario: Empty input still yields an EOF token\n    Given the empty string\n    When tokenize is applied\n    Then the result has exactly one token, EOF\n\n  Scenario: A '#' line comment produces no token at all\n    Given \"# a comment\\nx\"\n    When tokenize is applied\n    Then the comment text is silently consumed -- no COMMENT token exists in this lexer -- only [NL][IDENT x][EOF] remain\n\n  Scenario: String escapes decode to real bytes\n    Given \"\\\"a\\\\nb\\\\t\\\\\\\"c\\\"\"\n    When tokenize is applied\n    Then the STR token's text contains a real newline, tab, and quote byte, not the literal two-character escape sequences\n\n  Scenario: Two-character operators are recognized as one token\n    Given \"==\"\n    When tokenize is applied\n    Then the result is a single OP token with text \"==\", not two separate '=' tokens (same handling applies to !=, <=, >=, and the ':-' rule turnstile)\n"
  let probe = verify_tokenize()
  write_patlang_spec(qualified_id, "tokenize", source_file, gherkin, probe[0], probe[1])
  print("[SPEC DISCOVERY] tokenize: " + probe[0] + " -- " + probe[1])
  return probe[0]
end

# parse_program(toks) -> ["Program", stmts], stmts a PLAIN list (not a
# vec_* handle, unlike tokenize's output -- toks IS a vec_* handle,
# consumed via vec_get, but the AST built from it is ordinary PatLang
# lists throughout). Node shapes confirmed by direct source read:
# `let x = 1` -> ["Let", name, expr, isReassign, isMut]; a bare
# expression statement -> ["Expr", expr]; `x + 1` -> ["Bin", "+",
# ["Var","x"], ["Num","1"]].
make a function called verify_parse_program returns result
  let toks1 = tokenize("let x = 1\n")
  let ast1 = parse_program(toks1)
  let stmts1 = ast1[1]
  let let_stmt = stmts1[0]
  let let_expr = let_stmt[2]
  let p1_ok = (ast1[0] == "Program")
    and (to_num(list_len(stmts1)) == 1)
    and (let_stmt[0] == "Let") and (let_stmt[1] == "x")
    and (let_expr[0] == "Num") and (let_expr[1] == "1")
    and (let_stmt[3] == false) and (let_stmt[4] == false)

  let toks2 = tokenize("x + 1\n")
  let ast2 = parse_program(toks2)
  let stmts2 = ast2[1]
  let expr_stmt = stmts2[0]
  let bin = expr_stmt[1]
  let bin_lhs = bin[2]
  let bin_rhs = bin[3]
  let p2_ok = (expr_stmt[0] == "Expr")
    and (bin[0] == "Bin") and (bin[1] == "+")
    and (bin_lhs[0] == "Var") and (bin_lhs[1] == "x")
    and (bin_rhs[0] == "Num") and (bin_rhs[1] == "1")

  # empty program (EOF only) -> zero statements, not an error
  let toks3 = tokenize("")
  let ast3 = parse_program(toks3)
  let p3_ok = (ast3[0] == "Program") and (to_num(list_len(ast3[1])) == 0)

  if p1_ok and p2_ok and p3_ok then
    return ["verified", "returns [\"Program\", stmts] with stmts a PLAIN list of AST nodes (the input token vec is consumed via vec_get, but the resulting AST uses ordinary PatLang lists throughout); `let NAME = EXPR` parses to [\"Let\", name, expr, false, isMut]; a bare expression statement parses to [\"Expr\", expr]; empty input yields zero statements, not an error"]
  end
  return ["inconsistent", "p1_ok=" + ("" + p1_ok) + " p2_ok=" + ("" + p2_ok) + " p3_ok=" + ("" + p3_ok)]
end

make a function called discover_parse_program_spec returns status
  let source_file = "self_hosting/lib/parser.patlang"
  let qualified_id = qualify_function_id(source_file, "parse_program")
  let gherkin = "Feature: parse_program (" + source_file + ")\n\n  Scenario: A let statement parses correctly\n    Given tokenized \"let x = 1\\n\"\n    When parse_program is applied\n    Then the result is [\"Program\", [[\"Let\", \"x\", [\"Num\",\"1\"], false, false]]]\n\n  Scenario: A bare expression statement parses correctly\n    Given tokenized \"x + 1\\n\"\n    When parse_program is applied\n    Then the result is [\"Program\", [[\"Expr\", [\"Bin\", \"+\", [\"Var\",\"x\"], [\"Num\",\"1\"]]]]]\n\n  Scenario: Empty input yields zero statements\n    Given tokenized \"\" (a single EOF token)\n    When parse_program is applied\n    Then the result is [\"Program\", []], not an error\n\n  Note: the returned AST uses ordinary PatLang lists (list_len/indexing),\n  even though the INPUT token stream from tokenize is a vec_* handle\n  (vec_len/vec_get) -- do not mix up the two access conventions.\n"
  let probe = verify_parse_program()
  write_patlang_spec(qualified_id, "parse_program", source_file, gherkin, probe[0], probe[1])
  print("[SPEC DISCOVERY] parse_program: " + probe[0] + " -- " + probe[1])
  return probe[0]
end

# synth2_ground/synth2_query/synth5_fact_binary -- despite living inside
# the recursive-synthesis/LGG engine (a genuinely complex search system),
# these three specific functions turn out to be trivial constructors on
# direct source read, NOT the search logic itself -- confirmed each is a
# one-line wrapper, no recursion, no domain-specific validation. Revising
# their original Group B ("needs real domain understanding") triage:
# only the SEARCH functions in these files (not probed here) still merit
# that caution.
make a function called verify_synth2_ground returns result
  let ok1 = synth2_ground("X") == "v:X"
  let ok2 = synth2_ground("foo") == "v:foo"
  if ok1 and ok2 then
    return ["verified", "prepends the literal \"v:\" prefix to the given term -- a plain string constructor, no validation that the term looks like a logic variable"]
  end
  return ["inconsistent", "ok1=" + ("" + ok1) + " ok2=" + ("" + ok2)]
end

