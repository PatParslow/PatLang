make a function called verify_tok_is returns result
  let match_ok = tok_is(["IDENT", "foo"], "IDENT", "foo")
  let wrong_type_ok = not tok_is(["IDENT", "foo"], "KEYWORD", "foo")
  let wrong_text_ok = not tok_is(["IDENT", "foo"], "IDENT", "bar")

  if match_ok and wrong_type_ok and wrong_text_ok then
    return ["verified", "true only when BOTH the token's type (index 0) and text (index 1) match the given ty/tx; false if either differs"]
  end
  return ["inconsistent", "match_ok=" + ("" + match_ok) + " wrong_type_ok=" + ("" + wrong_type_ok) + " wrong_text_ok=" + ("" + wrong_text_ok)]
end

