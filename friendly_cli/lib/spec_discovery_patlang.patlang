  let x64_manual_verify_note = x64_manual_verify_note_text()
  let source_file = "self_hosting/lib/x64_runtime.patlang"
  let gherkin = "Feature: vec_new/vec_push/vec_get (x64 backend's own handle-based list, " + source_file + ")\n\n  Scenario: Pushed items are retrievable by index in order\n    Given a fresh handle from vec_new\n    When 10, 20, 30 are pushed via vec_push\n    Then vec_get(h,0)=10, vec_get(h,1)=20, vec_get(h,2)=30\n"
  write_patlang_spec(qualify_function_id(source_file, "vec_new"), "vec_new", source_file, gherkin, "verified", x64_manual_verify_note)
