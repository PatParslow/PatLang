# x64_nl_char (codegen_x64.patlang, NOT x64_runtime.patlang -- this is
# the CODEGEN's own compile-time helper, runs natively during
# compilation, not inside the compiled target program, so no tagged-
# pointer issue applies). Confirmed: `x64_nl_char() == chr(10)`,
# directly callable under --ir-run.
make a function called verify_x64_nl_char returns result
  let ok = x64_nl_char() == chr(10)
  if ok then
    return ["verified", "returns exactly one byte, chr(10) (a newline) -- a codegen-time helper, not a target-program-runtime function, so ordinary native chr() applies directly"]
  end
  return ["inconsistent", "ok=" + ("" + ok)]
end

