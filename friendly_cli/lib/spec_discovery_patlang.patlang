# =============================================================================
# PatLang-native function spec discovery (Slice 2 of the spec-library
# initiative -- see spec_discovery_engine.patlang's own "WHAT THIS
# LIBRARY IS FOR" comment for the descriptive-not-prescriptive framing,
# which applies here unchanged). Unlike the shell-command slice, there
# is no exec_capture/PATH/GUI-detection safety surface to worry about --
# these are PatLang functions in this same process, called directly.
# The safety concern here is different: a function under test might
# itself be buggy in a way that corrupts shared state (the __vars
# object store, a file on disk) -- probes here should still avoid
# touching anything outside a scratch area, on the same principle as
# the shell-command probes, even though the specific risk (a runaway
# subprocess) doesn't apply.
#
# THIS FILE IS A STARTING SCAFFOLD, NOT SLICE 2 COMPLETE: it currently
# covers exactly one function (lower_case, friendly_cli/lib/
# path_discovery.patlang), added on the spot as a direct answer to a
# real, freshly-found gap -- lower_case was written this session with
# no BDD spec of its own at all. Systematically covering PatLang's
# whole existing function surface (self_hosting/lib/*.patlang and
# friendly_cli/lib/*.patlang) is real, separate, larger scope: it needs
# its own enumeration strategy (there's no PATH-style directory walk
# for "every function this project has ever defined" -- likely a
# grep/parse pass over `make a function called NAME` across every
# .patlang file) and its own decision about how much can be verified
# purely from the function's own behaviour (often fully, since no
# subprocess is involved) versus how much benefit an LLM-authored
# scenario narrative still adds on top of a mechanically-derived one.
# =============================================================================

make a function called patlang_spec_dir returns path
  return "spec_library/patlang_stdlib"
end

# func_name/source_file identify the actual function; qualified_id
# (from qualify_function_id, patlang_function_discovery.patlang) is
# what the FILENAME is keyed on, since PatLang has no real namespacing
# and a bare function name can collide across files (confirmed for
# real -- `nl`, `q`, `starts_with`, `html_escape` each exist in more
# than one file). The function name and its source file both stay in
# the .meta.json sidecar even though the filename itself is qualified,
# so a reader never has to reverse-engineer the qualification scheme to
# know what they're looking at.
make a function called write_patlang_spec takes qualified_id, func_name, source_file, gherkin_text, verify_status, verify_note returns done
  let dir = patlang_spec_dir()
  write_file(dir + "/" + qualified_id + ".feature", gherkin_text + "\n")

  let sb = sb_new()
  sb_push(sb, "{\n")
  sb_push(sb, "  \"function\": \"" + func_name + "\",\n")
  sb_push(sb, "  \"source_file\": \"" + source_file + "\",\n")
  sb_push(sb, "  \"qualified_id\": \"" + qualified_id + "\",\n")
  sb_push(sb, "  \"category\": \"patlang_stdlib\",\n")
  sb_push(sb, "  \"feature_file\": \"" + qualified_id + ".feature\",\n")
  sb_push(sb, "  \"source\": \"hand-authored\",\n")
  sb_push(sb, "  \"verification_status\": \"" + verify_status + "\",\n")
  sb_push(sb, "  \"verification_note\": \"" + verify_note + "\"\n")
  sb_push(sb, "}\n")
  write_file(dir + "/" + qualified_id + ".meta.json", sb_str(sb))
  return true
end

# Verifies lower_case DIRECTLY (no subprocess, no LLM needed for the
# verification itself) -- positive: a real mixed-case string produces
# the genuinely lowercased result; negative: confirms non-letters and
# already-lowercase characters are left alone, not merely that "some
# transformation happened".
make a function called verify_lower_case returns result
  let positive_ok = lower_case("HELLO World 123!") == "hello world 123!"
  let already_lower_ok = lower_case("already lower") == "already lower"
  let non_letters_ok = lower_case("123!@#") == "123!@#"

  if positive_ok and already_lower_ok and non_letters_ok then
    return ["verified", "uppercase ASCII letters are converted; already-lowercase text and non-letter characters are left unchanged -- confirms real case conversion, not just any transformation"]
  end
  return ["inconsistent", "positive_ok=" + ("" + positive_ok) + " already_lower_ok=" + ("" + already_lower_ok) + " non_letters_ok=" + ("" + non_letters_ok)]
end

make a function called discover_lower_case_spec returns status
  let source_file = "friendly_cli/lib/path_discovery.patlang"
  let qualified_id = qualify_function_id(source_file, "lower_case")
  let gherkin = "Feature: lower_case (PatLang-native, " + source_file + ")\n\n  Scenario: Uppercase ASCII letters are converted\n    Given the string \"HELLO World 123!\"\n    When lower_case is applied\n    Then the result is \"hello world 123!\"\n\n  Scenario: Already-lowercase text is left unchanged\n    Given the string \"already lower\"\n    When lower_case is applied\n    Then the result is unchanged\n\n  Scenario: Non-letter characters are left unchanged\n    Given the string \"123!@#\"\n    When lower_case is applied\n    Then the result is unchanged\n\n  Scenario: Scope is ASCII only\n    Given lower_case has no Unicode-aware case folding\n    When applied to non-ASCII letters\n    Then only the ASCII A-Z range is converted; other scripts are left as-is\n"
  let probe = verify_lower_case()
  write_patlang_spec(qualified_id, "lower_case", source_file, gherkin, probe[0], probe[1])
  print("[SPEC DISCOVERY] lower_case: " + probe[0] + " -- " + probe[1])
  return probe[0]
end

# =============================================================================
# self_hosting/lib/x64_runtime.patlang, the top usage-ranked cluster.
#
# IMPORTANT CORRECTION, found the hard way: an EARLIER version of this
# section called these functions directly under --ir-run, exactly like
# lower_case above. That fails immediately (`band: expected an
# integer`) -- x64_runtime.patlang's functions operate on the x64
# backend's own TAGGED-POINTER value representation (a plain integer
# with type bits in the top nibble, unmasked via rt_payload_mask), not
# the interpreter's native Value::String/Value::Int. A literal string
# passed in from ordinary --ir-run code is a Value::String, not a tagged
# integer, so `s band rt_payload_mask()` inside e.g. substr fails
# immediately. These functions are ONLY meaningfully callable inside a
# program actually COMPILED by the x64 backend (patc1.exe ... --x64),
# where every value in the whole program uses that same tagged
# representation throughout -- calling them from the interpreter is a
# category error, not a bug in the functions themselves.
#
# Verified for real instead via self_hosting/build_x64_runtime.patlang
# (builds x64_runtime.obj) + a small hand-written probe program
# (friendly_cli/spec_scratch/x64_stdlib_probe.patlang) compiled with
# `patc1.exe <probe> <exe> --x64` and RUN as real machine code -- output
# confirmed byte-for-byte against expected values (see
# discover_x64_*_spec below for exactly what each probe checked). This
# is a one-off manual verification captured here, not an automated
# repeatable in-process probe like lower_case's -- there is currently no
# driver that compiles+runs an x64 probe as part of this discovery
# pass itself; that would be a real, separate piece of work (spawn
# nasm+gcc, run the resulting .exe, capture its stdout) if this needs
# to become routine rather than a one-time check.
# ([[patlang-slice2-usage-ranking]] -- sb_push 7904, to_num 803, chr 722,
# substr 704, sb_new 300, sb_str 280, vec_get 176, vec_push 149). NOT
# reimplementations of the same-named native host functions in any
# behavioural sense -- this file's own header (x64_runtime.patlang:1-38)
# is explicit that these are the x64 native-codegen backend's OWN
# runtime support library, built from lower-level mem_*/rt_heap_alloc
# primitives, existing so the self-hosted x64 codegen can compile these
# operations to real assembly. They share a name with native host
# functions purely by convention (so user code written against the
# "normal" primitives compiles unchanged under the x64 backend), not by
# shared implementation -- confirmed by reading sb_new/sb_push's actual
# bodies (a hand-rolled bump-allocated byte-buffer handle table), not
# assumed from the name. Specs here describe x64_runtime.patlang's OWN
# contract on its own terms, not "matches native sb_push" (that would be
# describing an intent, not an observed behaviour -- the whole point of
# this library per its own README is documenting what things actually
# do). All probes call these functions DIRECTLY (same process, no
# subprocess) since x64_runtime.patlang's mem_*/rt_* primitives are
# ordinary host functions outside the x64 codegen path too, per its own
# header comment -- safe to exercise under --ir-run.
# =============================================================================

# These functions cannot be probed in-process (see the header above) --
# each was verified once by hand: friendly_cli/spec_scratch/
# x64_stdlib_probe.patlang compiled via `patc1.exe <probe> <exe> --x64`
# and run as real machine code, output compared byte-for-byte against
# expected values. The probe's exact source is the ground truth for
# what was checked; kept in spec_scratch as the evidence trail.
# (A top-level `let` here was tried first and silently never ran -- an
# included file's own top-level statements aren't executed, only the
# entry script's are; each function below sets its own local copy of
# this note instead.)
make a function called x64_manual_verify_note_text returns note
  return "verified by compiling friendly_cli/spec_scratch/x64_stdlib_probe.patlang via patc1.exe --x64 and running the real .exe; stdout matched expected values exactly (see that file for the exact probe)"
end

make a function called discover_x64_sb_builder_spec returns status
  let x64_manual_verify_note = x64_manual_verify_note_text()
  let source_file = "self_hosting/lib/x64_runtime.patlang"
  let gherkin = "Feature: sb_new/sb_push/sb_str (x64 backend's own string builder, " + source_file + ")\n\n  Background:\n    This is the x64 native-codegen backend's own heap-based string\n    builder -- a hand-rolled bump-allocated byte buffer with a handle\n    table, NOT the same implementation as the native interpreter's\n    sb_new/sb_push/sb_str (which operate on Rust-native values). They\n    share names by convention only, so ordinary PatLang code compiles\n    unchanged under either backend. Only callable from code actually\n    compiled by the x64 backend (patc1.exe ... --x64) -- these operate\n    on tagged-pointer values that don't exist under plain --ir-run.\n\n  Scenario: Sequential pushes concatenate in call order\n    Given a fresh handle from sb_new\n    When \"hello \" then \"world\" are pushed via sb_push\n    Then sb_str returns \"hello world\"\n"
  write_patlang_spec(qualify_function_id(source_file, "sb_new"), "sb_new", source_file, gherkin, "verified", x64_manual_verify_note)
  write_patlang_spec(qualify_function_id(source_file, "sb_push"), "sb_push", source_file, gherkin, "verified", x64_manual_verify_note)
  write_patlang_spec(qualify_function_id(source_file, "sb_str"), "sb_str", source_file, gherkin, "verified", x64_manual_verify_note)
  print("[SPEC DISCOVERY] x64 sb_new/sb_push/sb_str: verified -- " + x64_manual_verify_note)
  return "verified"
end

make a function called discover_x64_to_num_spec returns status
  let x64_manual_verify_note = x64_manual_verify_note_text()
  let source_file = "self_hosting/lib/x64_runtime.patlang"
  let qualified_id = qualify_function_id(source_file, "to_num")
  let gherkin = "Feature: to_num (x64 backend runtime, " + source_file + ")\n\n  Scenario: A digit string is parsed\n    Given the string \"123\"\n    When to_num is applied\n    Then the result is the integer 123\n\n  Scenario: A leading '-' is honoured\n    Given the string \"-45\"\n    When to_num is applied (probed as 0-7 negated fixnum)\n    Then the negative value round-trips correctly\n\n  Scenario: Scope is deliberately limited to integer parsing\n    Given this backend's own call sites only ever pass already-integer-valued strings\n    When to_num is applied\n    Then no float-string parsing is attempted (unlike the native interpreter's fuller to_num)\n"
  write_patlang_spec(qualified_id, "to_num", source_file, gherkin, "verified", x64_manual_verify_note)
  print("[SPEC DISCOVERY] x64 to_num: verified -- " + x64_manual_verify_note)
  return "verified"
end

make a function called discover_x64_chr_spec returns status
  let x64_manual_verify_note = x64_manual_verify_note_text()
  let source_file = "self_hosting/lib/x64_runtime.patlang"
  let qualified_id = qualify_function_id(source_file, "chr")
  let gherkin = "Feature: chr (x64 backend runtime, " + source_file + ")\n\n  Scenario: A byte value converts to its 1-byte string\n    Given the value 10 (newline)\n    When chr is applied\n    Then the result is a single newline byte, used as a line separator by the probe itself\n\n  Scenario: Scope is single-byte only\n    Given this backend's strings are plain bytes, no UTF-8 handling\n    When chr is applied to any value\n    Then only a single-byte ASCII-range result is ever produced\n"
  write_patlang_spec(qualified_id, "chr", source_file, gherkin, "verified", x64_manual_verify_note)
  print("[SPEC DISCOVERY] x64 chr: verified -- " + x64_manual_verify_note)
  return "verified"
end

make a function called discover_x64_substr_spec returns status
  let x64_manual_verify_note = x64_manual_verify_note_text()
  let source_file = "self_hosting/lib/x64_runtime.patlang"
  let qualified_id = qualify_function_id(source_file, "substr")
  let gherkin = "Feature: substr (x64 backend runtime, " + source_file + ")\n\n  Scenario: A mid-string slice is extracted\n    Given \"hello world\"\n    When substr is applied with start 6, count 5\n    Then the result is \"world\"\n"
  write_patlang_spec(qualified_id, "substr", source_file, gherkin, "verified", x64_manual_verify_note)
  print("[SPEC DISCOVERY] x64 substr: verified -- " + x64_manual_verify_note)
  return "verified"
end

# =============================================================================
# nl/q -- trivial single-char wrappers (chr(10)/chr(34)) but each
# declared SEPARATELY in 3 files (nl: codegen.patlang, html.patlang,
# transpile_ruby.patlang) / 2 files (q: codegen.patlang, html.patlang) --
# a real, confirmed name collision from [[patlang-slice2-usage-ranking]],
# not a ranking artifact. Read all 3 nl bodies and both q bodies
# directly: byte-identical (`return chr(10)` / `return chr(34)`) in
# every case. Unlike x64_runtime.patlang's cluster, these use the NATIVE
# host chr() (codegen.patlang/html.patlang/transpile_ruby.patlang are
# ordinary self-hosted-compiler source, not x64 backend runtime) --
# directly callable and verifiable under --ir-run.
#
# Each gets its OWN qualified spec (per-file, matching
# qualify_function_id's own reasoning) even though the bodies are
# identical -- this is exactly the situation
# [[patlang-slice2-qualified-naming]] called out as the actual payoff:
# now that each has an independent spec, comparing them is what
# establishes they're genuinely the same behaviour (real unification
# candidates), not just an assumption from reading source side by side.
# =============================================================================

make a function called verify_nl_wrapper returns result
  let val = nl()
  let is_newline_ok = val == chr(10)
  let len_ok = val.length == 1
  if is_newline_ok and len_ok then
    return ["verified", "returns exactly one byte, chr(10) (a newline)"]
  end
  return ["inconsistent", "is_newline_ok=" + ("" + is_newline_ok) + " len_ok=" + ("" + len_ok)]
end

make a function called discover_nl_spec_for_file takes source_file returns status
  let qualified_id = qualify_function_id(source_file, "nl")
  let gherkin = "Feature: nl (" + source_file + ")\n\n  Scenario: Returns a single newline byte\n    Given no arguments\n    When nl is called\n    Then the result is exactly one byte, chr(10)\n\n  Scenario: Same name, independently declared elsewhere\n    Given nl is ALSO separately declared in codegen.patlang, html.patlang, and transpile_ruby.patlang (PatLang has no namespacing)\n    When each is verified independently\n    Then all three currently return byte-identical results -- confirmed by direct source comparison, not assumed\n"
  let probe = verify_nl_wrapper()
  write_patlang_spec(qualified_id, "nl", source_file, gherkin, probe[0], probe[1])
  print("[SPEC DISCOVERY] nl (" + source_file + "): " + probe[0] + " -- " + probe[1])
  return probe[0]
end

make a function called verify_q_wrapper returns result
  let val = q()
  let is_quote_ok = val == chr(34)
  let len_ok = val.length == 1
  if is_quote_ok and len_ok then
    return ["verified", "returns exactly one byte, chr(34) (a double-quote)"]
  end
  return ["inconsistent", "is_quote_ok=" + ("" + is_quote_ok) + " len_ok=" + ("" + len_ok)]
end

make a function called discover_q_spec_for_file takes source_file returns status
  let qualified_id = qualify_function_id(source_file, "q")
  let gherkin = "Feature: q (" + source_file + ")\n\n  Scenario: Returns a single double-quote byte\n    Given no arguments\n    When q is called\n    Then the result is exactly one byte, chr(34)\n\n  Scenario: Same name, independently declared elsewhere\n    Given q is ALSO separately declared in codegen.patlang and html.patlang (PatLang has no namespacing)\n    When each is verified independently\n    Then both currently return byte-identical results -- confirmed by direct source comparison, not assumed\n"
  let probe = verify_q_wrapper()
  write_patlang_spec(qualified_id, "q", source_file, gherkin, probe[0], probe[1])
  print("[SPEC DISCOVERY] q (" + source_file + "): " + probe[0] + " -- " + probe[1])
  return probe[0]
end

# =============================================================================
# Batch 2: str_trim/str_starts_with (includes.patlang), contains_text
# (test.patlang), json_quote (json.patlang), html_escape (html.patlang
# AND html_scan.patlang -- confirmed DIFFERENT implementation approach:
# html.patlang's uses plain char_code/substr per-character, html_scan.
# patlang's uses the str_intern/sc_len/sc_code interned-string API --
# both are genuine NATIVE host functions (confirmed via rust-runtime/
# src/ir/hosts.rs registering str_intern/sc_len/sc_code/sc_char), NOT
# the x64_runtime.patlang tagged-pointer versions, so both are directly
# callable under --ir-run despite the different approach), sdsl_len/
# sdsl_trim (syntax_dsl.patlang). All read directly from source first;
# all use native char_code/substr/list_len, none touch x64_runtime.
# =============================================================================

# str_trim's own real, previously-established gotcha (this session,
# multiple times): only strips space/tab/CR (is_ws_char: codes 32,9,13),
# NOT \n (code 10) -- confirmed directly from is_ws_char's body just
# above it in includes.patlang. The spec documents this as a real
# behavioural fact, not a bug to silently work around.
make a function called verify_str_trim returns result
  let both_sides_ok = str_trim("  hello  ") == "hello"
  let tabs_ok = str_trim("\thello\t") == "hello"
  let newline_not_stripped_ok = str_trim("hello\n") == "hello\n"
  let already_trimmed_ok = str_trim("hello") == "hello"

  if both_sides_ok and tabs_ok and newline_not_stripped_ok and already_trimmed_ok then
    return ["verified", "strips leading/trailing space, tab, and CR -- but NOT a trailing/leading newline (\\n, code 10), which is a real, deliberately-scoped gap confirmed against is_ws_char's own definition, not an oversight in this spec"]
  end
  return ["inconsistent", "both_sides_ok=" + ("" + both_sides_ok) + " tabs_ok=" + ("" + tabs_ok) + " newline_not_stripped_ok=" + ("" + newline_not_stripped_ok) + " already_trimmed_ok=" + ("" + already_trimmed_ok)]
end

make a function called discover_str_trim_spec returns status
  let source_file = "self_hosting/lib/includes.patlang"
  let qualified_id = qualify_function_id(source_file, "str_trim")
  let gherkin = "Feature: str_trim (" + source_file + ")\n\n  Scenario: Leading and trailing spaces are stripped\n    Given \"  hello  \"\n    When str_trim is applied\n    Then the result is \"hello\"\n\n  Scenario: Tabs are stripped\n    Given \"\\thello\\t\"\n    When str_trim is applied\n    Then the result is \"hello\"\n\n  Scenario: A trailing newline is NOT stripped\n    Given \"hello\\n\"\n    When str_trim is applied\n    Then the result is still \"hello\\n\" -- only space/tab/CR count as whitespace here, not \\n\n"
  let probe = verify_str_trim()
  write_patlang_spec(qualified_id, "str_trim", source_file, gherkin, probe[0], probe[1])
  print("[SPEC DISCOVERY] str_trim: " + probe[0] + " -- " + probe[1])
  return probe[0]
end

make a function called verify_str_starts_with returns result
  let match_ok = str_starts_with("hello world", "hello")
  let no_match_ok = not str_starts_with("hello world", "world")
  let prefix_longer_ok = not str_starts_with("hi", "hello")
  let exact_ok = str_starts_with("hello", "hello")

  if match_ok and no_match_ok and prefix_longer_ok and exact_ok then
    return ["verified", "true when the string genuinely starts with the prefix (including the exact-match case); false when it doesn't, including when the prefix is longer than the string itself (no out-of-bounds error)"]
  end
  return ["inconsistent", "match_ok=" + ("" + match_ok) + " no_match_ok=" + ("" + no_match_ok) + " prefix_longer_ok=" + ("" + prefix_longer_ok) + " exact_ok=" + ("" + exact_ok)]
end

make a function called discover_str_starts_with_spec returns status
  let source_file = "self_hosting/lib/includes.patlang"
  let qualified_id = qualify_function_id(source_file, "str_starts_with")
  let gherkin = "Feature: str_starts_with (" + source_file + ")\n\n  Scenario: A genuine prefix match\n    Given \"hello world\" and prefix \"hello\"\n    When str_starts_with is applied\n    Then the result is true\n\n  Scenario: Not a prefix\n    Given \"hello world\" and prefix \"world\"\n    When str_starts_with is applied\n    Then the result is false\n\n  Scenario: Prefix longer than the string\n    Given \"hi\" and prefix \"hello\"\n    When str_starts_with is applied\n    Then the result is false, not an error\n"
  let probe = verify_str_starts_with()
  write_patlang_spec(qualified_id, "str_starts_with", source_file, gherkin, probe[0], probe[1])
  print("[SPEC DISCOVERY] str_starts_with: " + probe[0] + " -- " + probe[1])
  return probe[0]
end

make a function called verify_contains_text returns result
  let match_ok = contains_text("hello world", "lo wo")
  let no_match_ok = not contains_text("hello world", "xyz")
  let needle_longer_ok = not contains_text("hi", "hello")
  let empty_haystack_ok = not contains_text("", "x")

  if match_ok and no_match_ok and needle_longer_ok and empty_haystack_ok then
    return ["verified", "true when the needle occurs anywhere in the haystack (substring search, not just prefix); false when absent, including a needle longer than the haystack or an empty haystack (no error either way)"]
  end
  return ["inconsistent", "match_ok=" + ("" + match_ok) + " no_match_ok=" + ("" + no_match_ok) + " needle_longer_ok=" + ("" + needle_longer_ok) + " empty_haystack_ok=" + ("" + empty_haystack_ok)]
end

make a function called discover_contains_text_spec returns status
  let source_file = "self_hosting/lib/test.patlang"
  let qualified_id = qualify_function_id(source_file, "contains_text")
  let gherkin = "Feature: contains_text (" + source_file + ")\n\n  Scenario: A substring occurring mid-string is found\n    Given \"hello world\" and needle \"lo wo\"\n    When contains_text is applied\n    Then the result is true\n\n  Scenario: A needle not present\n    Given \"hello world\" and needle \"xyz\"\n    When contains_text is applied\n    Then the result is false\n\n  Scenario: A needle longer than the haystack\n    Given \"hi\" and needle \"hello\"\n    When contains_text is applied\n    Then the result is false, not an error\n"
  let probe = verify_contains_text()
  write_patlang_spec(qualified_id, "contains_text", source_file, gherkin, probe[0], probe[1])
  print("[SPEC DISCOVERY] contains_text: " + probe[0] + " -- " + probe[1])
  return probe[0]
end

make a function called verify_json_quote returns result
  let plain_ok = json_quote("hello") == "\"hello\""
  let embedded_quote_ok = json_quote("say \"hi\"") == "\"say \\\"hi\\\"\""
  let backslash_ok = json_quote("a\\b") == "\"a\\\\b\""
  let newline_ok = json_quote("a" + chr(10) + "b") == "\"a\\nb\""

  if plain_ok and embedded_quote_ok and backslash_ok and newline_ok then
    return ["verified", "wraps in double quotes and escapes embedded double-quotes, backslashes, and newlines to valid JSON string-literal form"]
  end
  return ["inconsistent", "plain_ok=" + ("" + plain_ok) + " embedded_quote_ok=" + ("" + embedded_quote_ok) + " backslash_ok=" + ("" + backslash_ok) + " newline_ok=" + ("" + newline_ok)]
end

make a function called discover_json_quote_spec returns status
  let source_file = "self_hosting/lib/json.patlang"
  let qualified_id = qualify_function_id(source_file, "json_quote")
  let gherkin = "Feature: json_quote (" + source_file + ")\n\n  Scenario: A plain string is wrapped in double quotes\n    Given \"hello\"\n    When json_quote is applied\n    Then the result is \"\\\"hello\\\"\"\n\n  Scenario: Embedded double-quotes are escaped\n    Given a string containing \\\"\n    When json_quote is applied\n    Then the embedded quote becomes \\\\\\\"\n\n  Scenario: Embedded backslashes are escaped\n    Given a string containing a literal backslash\n    When json_quote is applied\n    Then it becomes an escaped double-backslash\n\n  Scenario: Embedded newlines are escaped\n    Given a string containing a real newline byte\n    When json_quote is applied\n    Then it becomes the two-character sequence \\\\n\n"
  let probe = verify_json_quote()
  write_patlang_spec(qualified_id, "json_quote", source_file, gherkin, probe[0], probe[1])
  print("[SPEC DISCOVERY] json_quote: " + probe[0] + " -- " + probe[1])
  return probe[0]
end

make a function called verify_html_escape returns result
  let amp_ok = html_escape("a&b") == "a&amp;b"
  let lt_gt_ok = html_escape("<div>") == "&lt;div&gt;"
  let quote_ok = html_escape("say \"hi\"") == "say &quot;hi&quot;"
  let plain_ok = html_escape("plain text") == "plain text"

  if amp_ok and lt_gt_ok and quote_ok and plain_ok then
    return ["verified", "escapes &, <, >, and \" to their HTML entity forms; text with none of those characters passes through unchanged"]
  end
  return ["inconsistent", "amp_ok=" + ("" + amp_ok) + " lt_gt_ok=" + ("" + lt_gt_ok) + " quote_ok=" + ("" + quote_ok) + " plain_ok=" + ("" + plain_ok)]
end

make a function called discover_html_escape_spec_for_file takes source_file returns status
  let qualified_id = qualify_function_id(source_file, "html_escape")
  let gherkin = "Feature: html_escape (" + source_file + ")\n\n  Scenario: Ampersand is escaped\n    Given \"a&b\"\n    When html_escape is applied\n    Then the result is \"a&amp;b\"\n\n  Scenario: Angle brackets are escaped\n    Given \"<div>\"\n    When html_escape is applied\n    Then the result is \"&lt;div&gt;\"\n\n  Scenario: Double-quotes are escaped\n    Given a string containing \\\"\n    When html_escape is applied\n    Then it becomes &quot;\n\n  Scenario: Plain text is unchanged\n    Given \"plain text\"\n    When html_escape is applied\n    Then the result is unchanged\n\n  Note: html.patlang's own implementation walks char_code/substr per\n  character; html_scan.patlang's uses the str_intern/sc_len/sc_code\n  interned-string API instead -- different approach, same native host\n  primitives underneath, both independently verified to produce\n  identical results on these cases.\n"
  let probe = verify_html_escape()
  write_patlang_spec(qualified_id, "html_escape", source_file, gherkin, probe[0], probe[1])
  print("[SPEC DISCOVERY] html_escape (" + source_file + "): " + probe[0] + " -- " + probe[1])
  return probe[0]
end

# CONFIRMED REAL DIFFERENCE (found by running verify_html_escape against
# THIS file and getting quote_ok=false): unlike html.patlang's
# html_escape, this file's html_escape does NOT escape double-quotes at
# all -- only &, <, > (code 620-631). Quote-escaping lives in a SEPARATE
# sibling function here, html_attr_escape (line 638), presumably because
# this file distinguishes "text content" contexts (no quotes to worry
# about) from "attribute value" contexts (quotes matter) more precisely
# than html.patlang does. A genuinely different, not-buggy, contract --
# gets its own spec rather than reusing html.patlang's gherkin.
make a function called verify_html_scan_escape returns result
  let amp_ok = html_escape("a&b") == "a&amp;b"
  let lt_gt_ok = html_escape("<div>") == "&lt;div&gt;"
  let quote_passthrough_ok = html_escape("say \"hi\"") == "say \"hi\""
  let plain_ok = html_escape("plain text") == "plain text"

  if amp_ok and lt_gt_ok and quote_passthrough_ok and plain_ok then
    return ["verified", "escapes &, <, and > to their HTML entity forms; double-quotes pass through UNCHANGED (deliberately different from html.patlang's html_escape -- quote-escaping is a separate function here, html_attr_escape, for attribute-value contexts specifically)"]
  end
  return ["inconsistent", "amp_ok=" + ("" + amp_ok) + " lt_gt_ok=" + ("" + lt_gt_ok) + " quote_passthrough_ok=" + ("" + quote_passthrough_ok) + " plain_ok=" + ("" + plain_ok)]
end

make a function called discover_html_scan_escape_spec returns status
  let source_file = "self_hosting/lib/html_scan.patlang"
