  write_patlang_spec(qualify_function_id(source_file, "vec_get"), "vec_get", source_file, gherkin, "verified", x64_manual_verify_note)
  print("[SPEC DISCOVERY] x64 vec_new/vec_push/vec_get: verified -- " + x64_manual_verify_note)
