# Group D closeout: starts_with (markdown.patlang vs test.patlang) --
# confirmed byte-identical bodies by direct source read (both:
# `if s.length < prefix.length then return false end; return
# substr(s,0,prefix.length) == prefix`) -- a genuine name collision with
# no behavioural divergence, unlike html_escape's real one.
make a function called verify_starts_with_wrapper returns result
  let match_ok = starts_with("hello world", "hello")
  let no_match_ok = not starts_with("hello world", "world")
  let prefix_longer_ok = not starts_with("hi", "hello")
  if match_ok and no_match_ok and prefix_longer_ok then
    return ["verified", "true when the string genuinely starts with the prefix; false otherwise, including when the prefix is longer than the string (no error)"]
  end
  return ["inconsistent", "match_ok=" + ("" + match_ok) + " no_match_ok=" + ("" + no_match_ok) + " prefix_longer_ok=" + ("" + prefix_longer_ok)]
end

make a function called discover_starts_with_spec_for_file takes source_file returns status
  let qualified_id = qualify_function_id(source_file, "starts_with")
  let gherkin = "Feature: starts_with (" + source_file + ")\n\n  Scenario: A genuine prefix match\n    Given \"hello world\" and prefix \"hello\"\n    When starts_with is applied\n    Then the result is true\n\n  Scenario: Not a prefix\n    Given \"hello world\" and prefix \"world\"\n    When starts_with is applied\n    Then the result is false\n\n  Scenario: Prefix longer than the string\n    Given \"hi\" and prefix \"hello\"\n    When starts_with is applied\n    Then the result is false, not an error\n\n  Note: markdown.patlang and test.patlang each declare their OWN\n  starts_with (a real name collision, PatLang has no namespacing) --\n  confirmed by direct source comparison to be BYTE-IDENTICAL bodies,\n  unlike html_escape's genuinely different pair -- both independently\n  verified here rather than assumed identical from the collision alone.\n"
  let probe = verify_starts_with_wrapper()
  write_patlang_spec(qualified_id, "starts_with", source_file, gherkin, probe[0], probe[1])
  print("[SPEC DISCOVERY] starts_with (" + source_file + "): " + probe[0] + " -- " + probe[1])
  return probe[0]
end

