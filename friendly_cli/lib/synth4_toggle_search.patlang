# GENERIC extension to the induction search space -- NOT a solution to
# any specific curriculum problem. Directly follows from the user's own
# insight: "can it learn to toggle a truth value; if so it can count in
# twos and should be able to handle the sum of evens...?"
#
# is_even was already induced via exactly this shape (flip a flag each
# step down a chain, base case at the bottom -- see synth2_induce_chain /
# reference_solutions/peano work). This generalizes that to CONDITIONAL
# ACCUMULATION: walk a chain, toggle a flag each step, and only combine
# into the running total when the flag is in the "on" state. That reaches
# "sum of evens from 0 to N" -- a real, different, but related problem to
# the list-based sum_of_evens(xs) in the curriculum spec. It does NOT
# close the separate gap (the relational engine has no list encoding) --
# noted honestly, not overclaimed.
#
# Search space (chain_pred, combine_pred candidate pairs, toggle_pred
# fixed as a background relation, exactly the synth3 discipline):
#   rule target(X,Y,F) :- zero(X), zero(Y), start_flag(F).
#   rule target(X,Y,"v:true")  :- chain(X,X2), toggle("v:true",F2),  target(X2,Y2,F2), combine(Y2,X,Y).
#   rule target(X,Y,"v:false") :- chain(X,X2), toggle("v:false",F2), target(X2,Y2,F2), Y is Y2 (no combine).
#
# PatLang's relational engine has no "is/2" arithmetic-eval builtin and no
# negation -- the "no combine" branch is expressed as an ordinary fact
# copy (plus(Y2,"v:0",Y2)-style identity), not a special primitive.

include "../../self_hosting/lib/includes.patlang"
include "../../self_hosting/lib/test.patlang"
include "../../self_hosting/lib/synthesis_recursive.patlang"

make a function called synth4_clauses_for takes target_pred, chain_pred, combine_pred, start_flag returns src
  let sb = sb_new()
  sb_push(sb, "rule " + target_pred + "(X, Y, \"v:" + start_flag + "\") :- zero(X), zero(Y).\n")
  sb_push(sb, "rule " + target_pred + "(X, Y, \"v:true\") :- " + chain_pred + "(X, X2), toggle(\"v:true\", F2), " + target_pred + "(X2, Y2, F2), " + combine_pred + "(Y2, X, Y).\n")
  sb_push(sb, "rule " + target_pred + "(X, Y, \"v:false\") :- " + chain_pred + "(X, X2), toggle(\"v:false\", F2), " + target_pred + "(X2, Y, F2).\n")
  return sb_str(sb)
end

make a function called synth4_query takes pred, arg1, arg2, arg3, expect returns q
  return [pred, arg1, arg2, arg3, expect]
end

make a function called synth4_build_test_script takes background_src, clause_src, queries returns src
  let sb = sb_new()
  sb_push(sb, background_src)
  sb_push(sb, "\n")
  sb_push(sb, clause_src)
  sb_push(sb, "\n")
  let i = 0
  let n = to_num(list_len(queries))
  while i < n do
    let q = queries[i]
    let pred = q[0]
    let arg1 = q[1]
    let arg2 = q[2]
    let arg3 = q[3]
    let expect = q[4]
    sb_push(sb, "let sols_" + to_str_i(i) + " = solve(\"" + pred + "\", [\"" + synth2_ground(arg1) + "\", \"" + synth2_ground(arg2) + "\", \"" + synth2_ground(arg3) + "\"])\n")
    sb_push(sb, "let provable_" + to_str_i(i) + " = to_num(list_len(sols_" + to_str_i(i) + ")) > 0\n")
    if expect then
      sb_push(sb, "print(provable_" + to_str_i(i) + ")\n")
    else
      sb_push(sb, "print(not provable_" + to_str_i(i) + ")\n")
    end
    let i = i + 1
  end
  return sb_str(sb)
end

make a function called synth4_test_hypothesis takes background_src, clause_src, queries returns ok
  let script = synth4_build_test_script(background_src, clause_src, queries)
  let tmp_path = "friendly_cli/spec_scratch/_synth4_hypothesis.patlang"
  write_file(tmp_path, script)
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", tmp_path)
  return not contains_text(out, "false")
end

make a function called synth4_diagnose_hypothesis takes background_src, clause_src, queries returns results
  let script = synth4_build_test_script(background_src, clause_src, queries)
  let tmp_path = "friendly_cli/spec_scratch/_synth4_diagnose.patlang"
  write_file(tmp_path, script)
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", tmp_path)
  let lines = synth2_split_lines(out)
  let results = []
  let i = 0
  while i < to_num(list_len(lines)) do
    let results = list_push(results, lines[i] == "true")
    let i = i + 1
  end
  return results
end

make a function called synth4_induce_toggle_accumulator takes target_pred, chain_preds, combine_preds, start_flags, background_src, queries returns winner
  let ci = 0
  let cn = to_num(list_len(chain_preds))
  while ci < cn do
    let mi = 0
    let mn = to_num(list_len(combine_preds))
    while mi < mn do
      let si = 0
      let sn = to_num(list_len(start_flags))
      while si < sn do
        let chain_pred = chain_preds[ci]
        let combine_pred = combine_preds[mi]
        let start_flag = start_flags[si]
        let clause_src = synth4_clauses_for(target_pred, chain_pred, combine_pred, start_flag)
        if synth4_test_hypothesis(background_src, clause_src, queries) then
          return [chain_pred, combine_pred, start_flag]
        end
        let si = si + 1
      end
      let mi = mi + 1
    end
    let ci = ci + 1
  end
  return []
end
