# =============================================================================
# Auto-Synthesized PatLang Host Function Wrapper: file_size
# =============================================================================

make a function called get_file_size_synthesized takes file_path returns size
  # Precondition Contract
  let exists_ok = (file_exists(file_path) == "1") or (file_exists(file_path) == true)
  require exists_ok == true

  # Native Windows PowerShell Execution
  print("  [SYNTHESIZED EXEC] Executing PowerShell (Get-Item)... ")
  let raw_out = exec_capture("powershell", "-Command", "(Get-Item '" + file_path + "').Length")
  let size_num = to_num(raw_out)

  # Postcondition Contract
  let valid = size_num > 0
  ensure valid == true
  print("[CONTRACT PASS] Synthesized function file_size returned: " + size_num + " bytes.")
  return size_num
end
