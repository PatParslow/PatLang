# =============================================================================
# Dynamic System Tool Discovery, Source Codegen, and Incremental Catalog Engine
# Scans PATH for native Windows CLI tools, generates source-code wrappers
# with DbC safety contracts, and updates an on-disk `discovered_catalog.patlang`.
# =============================================================================

# --- Contract-Protected Native Executable Invoker ---

make a function called invoke_native_tool_contract takes tool_exe, src_file, dest_file, arg1, arg2 returns ok
  let src_ok = (file_exists(src_file) == "1") or (file_exists(src_file) == true)
  require src_ok == true
  require src_file != dest_file

  print("  [NATIVE FAST EXEC] Executing: " + tool_exe + " " + arg1 + " " + src_file + " " + arg2 + " " + dest_file)
  let cmd_out = exec_capture(tool_exe, arg1, src_file, arg2, dest_file)

  let dest_ok = (file_exists(dest_file) == "1") or (file_exists(dest_file) == true)
  let src_preserved = (file_exists(src_file) == "1") or (file_exists(src_file) == true)
  ensure dest_ok == true
  ensure src_preserved == true

  print("[CONTRACT PASS] Verified native execution of " + tool_exe + " cleanly produced " + dest_file)
  return true
end

# --- PATH Tool Discovery ---

make a function called is_tool_on_path takes tool_name returns found
  let out = exec_capture("where.exe", tool_name)
  let len = out.length
  if len == 0 then
    return false
  end
  let first_char = char_code(out, 0)
  if first_char == 73 then # 'I' (INFO: Could not find...)
    return false
  end
  return true
end

# --- Incremental Source Codegen Engine ---

make a function called discover_and_persist_catalog takes catalog_path returns count
  print("[DISCOVERY CODEGEN] Scanning PATH and updating persistent catalog at '" + catalog_path + "'...")

  let is_update = file_exists(catalog_path) == "1"
  let existing_content = ""
  if is_update then
    let existing_content = read_file(catalog_path)
    print("  [CATALOG FOUND] Updating existing catalog...")
  else
    print("  [CATALOG MISSING] Creating fresh catalog file...")
  end

  let code_out = "# =============================================================================\n"
  let code_out = code_out + "# Auto-Generated PatLang Discovered Tool Catalog\n"
  let code_out = code_out + "# Automatically generated with DbC safety contracts.\n"
  let code_out = code_out + "# =============================================================================\n\n"
  let code_out = code_out + "make a function called register_generated_discovered_tools returns count\n"
  let code_out = code_out + "  let registered = 0\n"

  let new_count = 0

  # Check Tool 1: Pandoc
  if is_tool_on_path("pandoc.exe") or is_tool_on_path("pandoc") then
    print("  -> Tool available on PATH: pandoc")
    let code_out = code_out + "  # Discovered Pandoc Action\n"
    let code_out = code_out + "  action_add(\"discovered_pandoc_md_docx\", [[\"has_md\", [\"docs\"]]], [[\"has_docx\", [\"docs\"]]], [], 1)\n"
    let code_out = code_out + "  action_bind(\"discovered_pandoc_md_docx\", |args| {\n"
    let code_out = code_out + "    return invoke_native_tool_contract(\"pandoc\", \"friendly_cli/test_src/doc1.md\", \"friendly_cli/test_src/doc1.docx\", \"-o\", \"\")\n"
    let code_out = code_out + "  })\n"
    let code_out = code_out + "  let registered = registered + 1\n\n"
    let new_count = new_count + 1
  end

  # Check Tool 2: PowerShell Compress-Archive
  if is_tool_on_path("powershell.exe") or is_tool_on_path("powershell") then
    print("  -> Tool available on PATH: powershell")
    let code_out = code_out + "  # Discovered PowerShell Archiver Action\n"
    let code_out = code_out + "  action_add(\"discovered_powershell_zip\", [[\"has_docx\", [\"docs\"]]], [[\"archived\", [\"backup.zip\"]]], [], 1)\n"
    let code_out = code_out + "  action_bind(\"discovered_powershell_zip\", |args| {\n"
    let code_out = code_out + "    print(\"  [NATIVE FAST EXEC] Executing PowerShell Compress-Archive...\")\n"
    let code_out = code_out + "    let cmd_out = exec_capture(\"powershell\", \"-Command\", \"Compress-Archive -Path friendly_cli/test_src/*.docx -DestinationPath friendly_cli/test_dest/discovered_backup.zip -Force\")\n"
    let code_out = code_out + "    let zip_ok = (file_exists(\"friendly_cli/test_dest/discovered_backup.zip\") == \"1\") or (file_exists(\"friendly_cli/test_dest/discovered_backup.zip\") == true)\n"
    let code_out = code_out + "    ensure zip_ok == true\n"
    let code_out = code_out + "    print(\"[CONTRACT PASS] Verified native PowerShell created archive: friendly_cli/test_dest/discovered_backup.zip\")\n"
    let code_out = code_out + "    return true\n"
    let code_out = code_out + "  })\n"
    let code_out = code_out + "  let registered = registered + 1\n\n"
    let new_count = new_count + 1
  end

  let code_out = code_out + "  return registered\nend\n"

  # Incremental check: Only write if new file or content changed!
  if is_update then
    if existing_content == code_out then
      print("[CATALOG UP-TO-DATE] Catalog content unchanged. Skipping rewrite.")
    else
      write_file(catalog_path, code_out)
      print("[CATALOG UPDATED] Successfully updated catalog on disk: " + catalog_path)
    end
  else
    write_file(catalog_path, code_out)
    print("[CATALOG CREATED] Successfully created catalog on disk: " + catalog_path)
  end

  return new_count
end
