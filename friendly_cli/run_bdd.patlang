# =============================================================================
# Friendly CLI BDD Verification Runner
# Loads the self-hosted preprocessor and executes the BDD test suite.
# =============================================================================

include "../self_hosting/lib/includes.patlang"

let bdd_driver_src = read_file("friendly_cli/test_bdd_spec.patlang")
let expanded = expand_includes(bdd_driver_src, "friendly_cli")

# Save expanded test spec and run via pat
write_file("friendly_cli/test_bdd_expanded.patlang", expanded)
