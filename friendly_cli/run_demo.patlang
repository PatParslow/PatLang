# =============================================================================
# Friendly CLI Driver Demo
# Dynamically loads regex + syntax preprocessor, expands novice DSL syntax,
# and executes the generated PatLang actions live via run_ir.
# =============================================================================

include "../self_hosting/lib/lexer.patlang"
include "../self_hosting/lib/parser.patlang"
include "../self_hosting/lib/lower.patlang"

let regex_src  = read_file("self_hosting/lib/regex_dsl.patlang")
let syntax_src = read_file("self_hosting/lib/syntax_dsl.patlang")
let action_src = read_file("friendly_cli/lib/actions.patlang")
let dsl_pack   = read_file("friendly_cli/dsl/file_ops.patlang")

# Dynamic driver script constructed and run via interpreter
let driver = regex_src + chr(10) + syntax_src + chr(10) + action_src + chr(10)
  + "print(" + chr(34) + "==================================================" + chr(34) + ")" + chr(10)
  + "print(" + chr(34) + "       WELCOME TO FRIENDLY PATLANG CLI            " + chr(34) + ")" + chr(10)
  + "print(" + chr(34) + "==================================================" + chr(34) + ")" + chr(10)
  + "let dsl_code = read_file(" + chr(34) + "friendly_cli/dsl/file_ops.patlang" + chr(34) + ")" + chr(10)
  + "let step1 = expand_syntax_dsls_with(dsl_code, [])" + chr(10)
  + "let dsl_defs = step1[1]" + chr(10)
  + "print(" + chr(34) + "Loaded syntax pack(s)." + chr(34) + ")" + chr(10)
  + "let novice_script = " + chr(34) + "do_files {" + chr(10) + "  convert all md files in " + chr(92) + chr(34) + "docs" + chr(92) + chr(34) + " to docx" + chr(10) + "  copy all txt files in " + chr(92) + chr(34) + "notes" + chr(92) + chr(34) + " to " + chr(92) + chr(34) + "backup" + chr(92) + chr(34) + "" + chr(10) + "  delete all tmp files in " + chr(92) + chr(34) + "cache" + chr(92) + chr(34) + "" + chr(10) + "}" + chr(10) + chr(34) + "" + chr(10)
  + "print(" + chr(34) + "\n--- Novice Script Input ---" + chr(34) + ")" + chr(10)
  + "print(novice_script)" + chr(10)
  + "let step2 = expand_syntax_dsls_with(novice_script, dsl_defs)" + chr(10)
  + "let expanded_patlang = step2[0]" + chr(10)
  + "print(" + chr(34) + "--- Expanded PatLang Statements ---" + chr(34) + ")" + chr(10)
  + "print(expanded_patlang)" + chr(10)
  + "print(" + chr(34) + "--- Executing Expanded Program ---" + chr(34) + ")" + chr(10)
  + "let toks = tokenize(expanded_patlang)" + chr(10)
  + "let ast = parse_program(toks)" + chr(10)
  + "let ir = lower_program(ast)" + chr(10)
  + "run_ir(ir)" + chr(10)
  + "print(" + chr(34) + "==================================================" + chr(34) + ")" + chr(10)
  + "print(" + chr(34) + "Friendly CLI execution finished successfully!" + chr(34) + ")" + chr(10)

let toks = tokenize(driver)
let ast = parse_program(toks)
let ir = lower_program(ast)
run_ir(ir)
