# =============================================================================
# Smart Goal Preprocessor + Spec Runner
# Expands goal: blocks and preprocessor calls before passing to compiler.
# =============================================================================

include "../self_hosting/lib/includes.patlang"

let bdd_driver_src = read_file("friendly_cli/test_smart_bdd_spec.patlang")
let preproc_src    = read_file("friendly_cli/lib/goal_preprocessor.patlang")
let combined       = preproc_src + chr(10) + bdd_driver_src
let expanded       = expand_includes(combined, "friendly_cli")

write_file("friendly_cli/test_smart_bdd_expanded.patlang", expanded)
