# Tier A synthesis experiment #2 (pure logic/GOAP composition, NO LLM):
# "fetch a page from parslow.net", composed via action_add/plan/activate
# rather than one hand-written function.
#
# HONEST, CONFIRMED LIMITATION (checked before writing anything, not
# discovered as a surprise failure): `curl -I http://parslow.net`
# returns a real 301 redirect to https://parslow.net/ -- this site is
# HTTPS-only, and PatLang's own networking (tcp_connect/tcp_read/tcp_
# write) has NO TLS support at all (confirmed: no tls_* host function
# exists anywhere in rust-runtime/src/ir/hosts.rs). So the real,
# achievable goal here is "receive a genuine HTTP response from the
# real external host" (the 301 redirect itself), NOT "retrieve the
# actual page content" -- that would need TLS, a real, separate gap,
# not silently papered over.

include "../self_hosting/lib/includes.patlang"
include "../self_hosting/lib/test.patlang"

action_add("connect_to_host", [], [["connected", ["parslow_net"]]], [], 1)
action_add("send_get_request", [["connected", ["parslow_net"]]], [["have_response", ["parslow_net"]]], [], 1)

action_bind("connect_to_host", |args| {
  let conn = tcp_connect("parslow.net", 80)
  set_var("fetch_conn", conn)
  return true
})

action_bind("send_get_request", |args| {
  let conn = get("__vars", "fetch_conn")
  let req = "GET / HTTP/1.1\r\nHost: parslow.net\r\nConnection: close\r\n\r\n"
  tcp_write(conn, req)
  let raw = ""
  let chunk = tcp_read(conn)
  while chunk != "" do
    let raw = raw + chunk
    let chunk = tcp_read(conn)
  end
  tcp_close(conn)
  set_var("fetch_response", raw)
  return true
})

print("=== Tier A: GOAP-composing a real fetch from parslow.net ===")
goal have_a_page {
  have_response(parslow_net)
}
let plan = pursue have_a_page
print("plan: " + plan)

let activated_ok = activate plan
print("activate succeeded: " + activated_ok)

let response = get("__vars", "fetch_response")

# ---- VISIBLE check: shown as the primary success criterion ----
let got_real_http_response = contains_text(response, "HTTP/1.1")
let got_redirect_status = contains_text(response, "301")
print("VISIBLE check -- real HTTP/1.1 response received: " + got_real_http_response)
print("VISIBLE check -- status is a 301 redirect: " + got_redirect_status)

# ---- BLIND held-back check: the EXACT redirect target, not just "some
# redirect happened" -- a genuinely different, more specific claim,
# checked only after the visible criteria already passed, guarding
# against a vacuous "it said 301 something" pass ----
let got_exact_redirect_target = contains_text(response, "Location: https://parslow.net/")
print("BLIND check -- exact redirect target is https://parslow.net/: " + got_exact_redirect_target)

if activated_ok and got_real_http_response and got_redirect_status and got_exact_redirect_target then
  print("=== RESULT: GOAP-composed fetch succeeded, including the blind exact-target check -- genuinely reached the real external host, not vacuous ===")
else
  print("=== RESULT: FAILED -- see individual checks above ===")
end
