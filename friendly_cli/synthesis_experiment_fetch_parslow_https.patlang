# Tier A synthesis experiment #3: fetch the REAL page over HTTPS, per
# the user's own idea ("surely if we make sure curl is BDD wrapped as
# a command line utility...?") -- closes the TLS gap experiment #2
# (friendly_cli/synthesis_experiment_fetch_parslow.patlang) honestly
# left open, by composing a GOAP action around the newly-verified
# `curl` shell spec (spec_library/shell/curl.feature) instead of
# PatLang's own TLS-less tcp_connect.

include "../self_hosting/lib/includes.patlang"
include "../self_hosting/lib/test.patlang"

action_add("fetch_via_curl", [], [["have_response", ["parslow_page"]]], [], 1)

action_bind("fetch_via_curl", |args| {
  let body = exec_capture("curl", "-s", "https://parslow.net/teaching/learning/se/bdd-retrofitting.html")
  set_var("fetch_response", body)
  return true
})

print("=== Tier A #3: GOAP-composing a REAL HTTPS fetch via curl ===")
goal have_a_real_page {
  have_response(parslow_page)
}
let plan = pursue have_a_real_page
print("plan: " + plan)

let activated_ok = activate plan
print("activate succeeded: " + activated_ok)

let response = get("__vars", "fetch_response")

# ---- VISIBLE check ----
let got_real_html = contains_text(response, "<!DOCTYPE html>")
print("VISIBLE check -- got real page HTML: " + got_real_html)

# ---- BLIND held-back check: specific page CONTENT (a real heading
# from the actual article), not just "some HTML came back" ----
let got_specific_content = contains_text(response, "Retro-fitting BDD")
print("BLIND check -- contains the real article's own title text: " + got_specific_content)

if activated_ok and got_real_html and got_specific_content then
  print("=== RESULT: genuine HTTPS page content fetched via a GOAP-composed curl action, including the blind content check -- closes the TLS gap experiment #2 left open ===")
else
  print("=== RESULT: FAILED -- see individual checks above ===")
end
