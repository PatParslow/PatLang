# Mirror of decrement_to_zero, testing whether the same packaged-loop
# mechanism generalizes to COUNTING UP instead of down. Directly
# requested: "See if it can generalize to counting up instead of down".
#
# Note on why this is "any start -> FIXED target" (mirroring
# decrement_to_zero's "any start -> fixed 0"), not "any start -> ANY
# target": this GOAP engine only binds action variables by unifying
# PRECONDS against the current world state (see hosts.rs's
# ground_action_instances) -- a variable appearing ONLY in an effect,
# never in any precond, cannot be bound from the goal being searched for.
# So an "increment_to(Id,Target)" action with a free Target in its effect
# literally cannot work here; it would just emit a literal, un-substituted
# "Target" string, never matching a concrete goal. This is a genuine
# engine limitation discovered while designing this test, not
# hand-waved -- so the honest, buildable mirror is: fixed target
# (like decrement's fixed 0), arbitrary starting point.

include "../self_hosting/lib/includes.patlang"
include "../self_hosting/lib/test.patlang"
include "../self_hosting/lib/synthesis_recursive.patlang"

make a function called goap_up_build_script takes start, target, use_shortcut returns src
  let sb = sb_new()
  sb_push(sb, "include \"../../self_hosting/lib/includes.patlang\"\n")
  let i = 0
  while i < 20 do
    sb_push(sb, "rule_add(\"succ\", [\"" + ("" + i) + "\", \"" + ("" + (i + 1)) + "\"], [])\n")
    let i = i + 1
  end
  sb_push(sb, "action_add(\"increment\", [[\"counter\", [\"Id\", \"X\"]], [\"succ\", [\"X\", \"X2\"]]], [[\"counter\", [\"Id\", \"X2\"]]], [[\"counter\", [\"Id\", \"X\"]]], 1)\n")
  if use_shortcut then
    sb_push(sb, "action_add(\"increment_to_ten\", [[\"counter\", [\"Id\", \"X\"]]], [[\"counter\", [\"Id\", \"" + target + "\"]]], [[\"counter\", [\"Id\", \"X\"]]], 1)\n")
  end
  sb_push(sb, "rule_add(\"counter\", [\"t\", \"" + start + "\"], [])\n")
  sb_push(sb, "let result = plan([[\"counter\", [\"t\", \"" + target + "\"]]])\n")
  sb_push(sb, "print(to_num(list_len(result)))\n")
  sb_push(sb, "print(result)\n")
  return sb_str(sb)
end

make a function called goap_up_run takes start, target, use_shortcut returns lines
  let script = goap_up_build_script(start, target, use_shortcut)
  let tmp_path = "friendly_cli/spec_scratch/_goap_up_test.patlang"
  write_file(tmp_path, script)
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", tmp_path)
  return synth2_split_lines(out)
end

let target = "10"

print("=== Phase 1: verify raw 'increment' reaches a FIXED target (10) from many distinct starting points (visible) ===")
let visible_starts = [0, 2, 5, 7, 8]
let all_visible_ok = true
let vi = 0
while vi < to_num(list_len(visible_starts)) do
  let s = visible_starts[vi]
  let expected = 10 - s
  let lines = goap_up_run(("" + s), target, false)
  let steps = to_num(lines[0])
  let ok = steps == expected
  print("start=" + ("" + s) + " steps=" + ("" + steps) + " expected=" + ("" + expected) + " match=" + ("" + ok))
  if not ok then
    let all_visible_ok = false
  end
  let vi = vi + 1
end

print("=== Phase 2: BLIND held-back start (never used to derive the shortcut) ===")
let blind_lines = goap_up_run("3", target, false)
let blind_steps = to_num(blind_lines[0])
let blind_ok = blind_steps == 7
print("start=3 (blind) steps=" + ("" + blind_steps) + " expected=7 match=" + ("" + blind_ok))

if all_visible_ok and blind_ok then
  print("=== Phase 3: raw mechanism genuinely generalizes to counting UP -- ACID TEST with the packaged shortcut ===")
  let novel_lines = goap_up_run("1", target, true)
  let novel_len = to_num(novel_lines[0])
  let novel_plan_text = novel_lines[1]
  print("novel start=1 plan: " + novel_plan_text)
  let used_shortcut = (novel_len == 1) and contains_text(novel_plan_text, "increment_to_ten(")
  print("plan length=" + ("" + novel_len) + " used packaged shortcut=" + ("" + used_shortcut))

  if used_shortcut then
    print("=== RESULT: counting UP genuinely generalizes -- symmetric packaged loop (increment_to_ten) found+preferred for an unseen start, not hand-declared ===")
  else
    print("=== RESULT: acid test failed for counting up ===")
  end
else
  print("=== RESULT: raw 'increment' did not generalize across visible/blind starts -- counting up NOT confirmed ===")
end
