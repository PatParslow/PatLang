# Tests the user's own idea: "we need to get [GOAP] to be able to solve
# across multiple simultaneous input set to output set mappings... maybe
# goap operating on a list of lists of inputs?"
#
# plan(goal_facts) already accepts an arbitrary LIST of goal facts and
# searches until ALL are simultaneously satisfied (hosts.rs's plan_facts:
# "goal_facts.iter().all(|g| state.contains(g))"). This tests whether that
# existing capability already generalizes to composing one shared,
# generic action template across several INDEPENDENT input->output
# examples in a SINGLE plan() call, rather than solving each separately --
# i.e. whether GOAP itself already does the multi-example composition the
# induction-search side (synth3/synth4) has to do by hand (test one
# hypothesis against every example).
#
# The only thing authored here is the GENERIC PRIMITIVE action
# "decrement" (parameterized over an id, so it can apply to several
# independent counters at once) -- exactly the same status as pred1/plus
# in the earlier search experiments: a given, verified background
# capability, not a solution to "count down 3 counters to zero
# simultaneously". The composition/interleaving is what's being tested,
# not authored.

include "../self_hosting/lib/includes.patlang"
include "../self_hosting/lib/test.patlang"

# Chain facts, shared across all three counters (id-less; decrement's
# precond ties chain steps to whichever counter value currently matches).
let i = 1
while i <= 10 do
  rule_add("pred1", [("" + i), ("" + (i - 1))], [])
  let i = i + 1
end

# Three INDEPENDENT input sets, each its own "counter" identified by id,
# starting at different values -- a genuine multi-example simultaneous
# input->output test, not one problem run three times.
rule_add("counter", ["a", "3"], [])
rule_add("counter", ["b", "5"], [])
rule_add("counter", ["c", "2"], [])

# ONE generic parameterized action, decrementing whichever counter (by
# id) currently holds a value with a pred1 predecessor.
action_add("decrement",
  [["counter", ["Id", "X"]], ["pred1", ["X", "X2"]]],
  [["counter", ["Id", "X2"]]],
  [["counter", ["Id", "X"]]],
  1)

print("=== Single plan() call, goal = all three counters at 0 simultaneously ===")
let result = plan([["counter", ["a", "0"]], ["counter", ["b", "0"]], ["counter", ["c", "0"]]])
print(result)

let n_steps = to_num(list_len(result))
print("total steps: " + ("" + n_steps))

# Expected: exactly 3+5+2=10 steps total (no combined action does two
# counters' work at once -- this is a genuine interleaved composition,
# not a shortcut), each step being a "decrement(...)" instance, and the
# plan must mention all three ids somewhere.
let all_decrement = true
let mentions_a = false
let mentions_b = false
let mentions_c = false
let k = 0
while k < n_steps do
  let step = result[k]
  if not contains_text(step, "decrement(") then
    let all_decrement = false
  end
  if contains_text(step, "Id=a") then
    let mentions_a = true
  end
  if contains_text(step, "Id=b") then
    let mentions_b = true
  end
  if contains_text(step, "Id=c") then
    let mentions_c = true
  end
  let k = k + 1
end

print("all steps are decrement instances: " + ("" + all_decrement))
print("mentions a/b/c: " + ("" + mentions_a) + "/" + ("" + mentions_b) + "/" + ("" + mentions_c))
print("step count == 10 (3+5+2): " + ("" + (n_steps == 10)))

if all_decrement and mentions_a and mentions_b and mentions_c and (n_steps == 10) then
  print("=== RESULT: GOAP composed ONE shared generic action across 3 simultaneous independent input->output examples, found by search ===")
else
  print("=== RESULT: did not generalize as hoped -- see raw plan above ===")
end
