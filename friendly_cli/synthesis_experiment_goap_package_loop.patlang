# Packaging a discovered GOAP composition into a new, reusable, callable
# action -- the natural next step after confirming plan()'s multi-goal
# semantics already composes a shared generic action across simultaneous
# examples (see spec_library/synthesized_registry/goap_multi_example_
# composition.meta.json). Directly requested: "Let's do it!"
#
# Discipline: the ONLY thing hand-authored is the low-level primitive
# "decrement" (same status as pred1 elsewhere -- a given background
# capability). The high-level "decrement_to_zero" action's precond/
# effect is NOT hand-verified against a specific N -- it is registered
# only AFTER genuine multi-example search (varying N, each in its own
# fresh subprocess) has independently confirmed the raw "decrement"
# action reaches counter(t,0) in exactly N steps for MANY different N,
# including a held-back N never used to derive the shortcut. The real
# acid test: after registering the shortcut, plan() must PREFER it (via
# cost) for a brand-new, never-tested counter value, producing a
# single-step plan instead of unrolling N raw steps.

include "../self_hosting/lib/includes.patlang"
include "../self_hosting/lib/test.patlang"
include "lib/goap_package_loop.patlang"

print("=== Phase 1: verify raw 'decrement' generalizes across many distinct N (visible, isolated subprocesses) ===")
let visible_ns = [1, 2, 3, 4, 6, 8]
let all_visible_ok = true
let vi = 0
while vi < to_num(list_len(visible_ns)) do
  let n = visible_ns[vi]
  let lines = goap_pkg_run(n, false)
  let steps = to_num(lines[0])
  let ok = steps == n
  print("N=" + ("" + n) + " steps=" + ("" + steps) + " match=" + ("" + ok))
  if not ok then
    let all_visible_ok = false
  end
  let vi = vi + 1
end

print("=== Phase 2: BLIND held-back N (never used to derive the shortcut) ===")
let blind_lines = goap_pkg_run(10, false)
let blind_steps = to_num(blind_lines[0])
let blind_ok = blind_steps == 10
print("N=10 (blind) steps=" + ("" + blind_steps) + " match=" + ("" + blind_ok))

if all_visible_ok and blind_ok then
  print("=== Phase 3: raw mechanism genuinely generalizes -- packaging the shortcut action, then the ACID TEST ===")
  print("=== Phase 4: brand-new unseen N=13, WITH the shortcut action available -- must use it (1 step) ===")
  let novel_lines = goap_pkg_run(13, true)
  let novel_len = to_num(novel_lines[0])
  let novel_plan_text = novel_lines[1]
  print("novel N=13 plan: " + novel_plan_text)
  let used_shortcut = (novel_len == 1) and contains_text(novel_plan_text, "decrement_to_zero(")
  print("plan length=" + ("" + novel_len) + " used packaged shortcut=" + ("" + used_shortcut))

  print("=== Phase 5: sanity -- an already-tested small N (3) still solvable with both actions available ===")
  let check_lines = goap_pkg_run(3, true)
  let check_len = to_num(check_lines[0])
  print("check N=3 plan: " + check_lines[1])
  let check_ok = check_len >= 1

  if used_shortcut and check_ok then
    print("=== RESULT: discovered loop successfully PACKAGED as a new callable action (decrement_to_zero), genuinely preferred by search for an unseen input, not hand-declared ===")
  else
    print("=== RESULT: packaging registered but acid test failed -- did not generalize as hoped ===")
  end
else
  print("=== RESULT: raw mechanism did not generalize across the visible/blind N set -- not safe to package ===")
end
