# Tests goap_relevant_actions against a genuinely LARGE, MIXED catalog
# -- combining actions from 3 unrelated past experiments/domains plus
# deliberately irrelevant ones -- to prove the reduction actually
# discriminates, rather than me hand-picking which actions exist for
# a given call the way every earlier Tier A experiment did.

include "../self_hosting/lib/includes.patlang"
include "../self_hosting/lib/test.patlang"
include "lib/goap_relevance.patlang"

# Full catalog: [name, preconds, add_effects, del_effects, cost]
let catalog = [
  # --- house-building domain (from the earlier goal_pursue_activate spec) ---
  ["gather_wood", [], [["have", ["wood"]]], [], 1],
  ["build_house", [["have", ["wood"]]], [["have", ["house"]]], [], 1],
  # --- raw TCP fetch domain (fetch_parslow_redirect experiment) ---
  ["connect_to_host", [], [["connected", ["parslow_net"]]], [], 1],
  ["send_get_request", [["connected", ["parslow_net"]]], [["have_response", ["parslow_net"]]], [], 1],
  # --- curl-based fetch domain (fetch_parslow_https_via_curl experiment) ---
  ["fetch_via_curl", [], [["have_response", ["parslow_page"]]], [], 1],
  # --- deliberately IRRELEVANT actions, unrelated to any goal tested below ---
  ["water_plant", [], [["watered", ["plant1"]]], [], 1],
  ["compile_docs", [["have", ["source"]]], [["built", ["docs"]]], [], 1],
  ["feed_cat", [], [["fed", ["cat1"]]], [], 1]
]

print("=== full catalog size: " + list_len(catalog) + " actions ===")

print("")
print("=== Goal 1: have(house) -- should select ONLY gather_wood + build_house ===")
let kept1 = goap_register_relevant_only(catalog, [["have", ["house"]]])
print("relevant actions selected: " + kept1)
let goal1_correct = (to_num(list_len(kept1)) == 2) and contains_text_list_goap(kept1, "gather_wood") and contains_text_list_goap(kept1, "build_house")
print("correctly excluded curl/tcp/irrelevant actions: " + (not contains_text_list_goap(kept1, "fetch_via_curl")) + " " + (not contains_text_list_goap(kept1, "water_plant")))

let plan1 = plan([["have", ["house"]]])
print("plan found from the REDUCED set: " + plan1)
