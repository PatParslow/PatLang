include "../self_hosting/lib/includes.patlang"
include "../self_hosting/lib/test.patlang"
include "lib/goap_relevance.patlang"

let catalog = [
  ["gather_wood", [], [["have", ["wood"]]], [], 1],
  ["build_house", [["have", ["wood"]]], [["have", ["house"]]], [], 1],
  ["connect_to_host", [], [["connected", ["parslow_net"]]], [], 1],
  ["send_get_request", [["connected", ["parslow_net"]]], [["have_response", ["parslow_net"]]], [], 1],
  ["fetch_via_curl", [], [["have_response", ["parslow_page"]]], [], 1],
  ["water_plant", [], [["watered", ["plant1"]]], [], 1],
  ["compile_docs", [["have", ["source"]]], [["built", ["docs"]]], [], 1],
  ["feed_cat", [], [["fed", ["cat1"]]], [], 1]
]

print("=== Goal 2: have_response(parslow_page) -- should select ONLY fetch_via_curl ===")
let kept2 = goap_register_relevant_only(catalog, [["have_response", ["parslow_page"]]])
print("relevant actions selected: " + kept2)
let goal2_correct = (to_num(list_len(kept2)) == 1) and contains_text_list_goap(kept2, "fetch_via_curl")
print("correctly excluded wood/house/tcp/irrelevant actions: " + (not contains_text_list_goap(kept2, "gather_wood")) + " " + (not contains_text_list_goap(kept2, "connect_to_host")) + " " + (not contains_text_list_goap(kept2, "water_plant")))

let plan2 = plan([["have_response", ["parslow_page"]]])
print("plan found from the REDUCED set: " + plan2)

print("")
print("=== Goal 3: watered(plant1) -- should select ONLY water_plant (not the ambiguous curl action, even though its own name has nothing to do with plants) ===")
let kept3 = goap_register_relevant_only(catalog, [["watered", ["plant1"]]])
print("relevant actions selected (this call only): " + kept3)
