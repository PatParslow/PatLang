# Scaling the GOAP relevance filter up to a genuinely comprehensive
# catalog: every REAL action_add call found across the whole codebase
# (self_hosting/examples, friendly_cli/lib), not synthetic test
# actions -- per the user's own request: "Let's scale the relevance
# filter up to the full registry."
#
# Deliberately includes a REAL name collision found while assembling
# this (self_hosting/examples/paradigm_gallery/functional_goal.patlang
# vs friendly_cli/lib/language_spec_discovery.patlang both define an
# action called "build_house", with GENUINELY DIFFERENT bodies -- one
# has no precondition at all, the other requires "have(wood)" first) --
# the same shape of collision the stdlib spec work already found for
# html_escape. Worth testing on purpose: does the relevance filter's
# name-based dedup silently drop the second one?

include "../self_hosting/lib/includes.patlang"
include "../self_hosting/lib/test.patlang"
include "lib/goap_relevance.patlang"

let catalog = [
  # --- goal_oriented_build_demo.patlang: a real compile/link chain ---
  ["compile_b", [], [["compiled", ["b"]]], [], 5],
  ["compile_a", [["compiled", ["b"]]], [["compiled", ["a"]]], [], 3],
  ["link", [["compiled", ["a"]], ["compiled", ["b"]]], [["shipped", []]], [], 2],
  ["direct_ship", [["compiled", ["b"]]], [["shipped", []]], [], 100],
  # --- goap_parameterized_demo.patlang: parameterized actions ---
  ["build", [["ready", ["X"]]], [["built", ["X"]]], [], 1],
  ["assemble", [["dep", ["X", "Y"]], ["ready", ["Y"]]], [["built", ["X"]]], [], 2],
  # --- goal_pursue_activate_demo.patlang / build_daemon world ---
  ["build_from_base", [["built", ["foundation_base"]]], [["built", ["foundation"]]], [], 1],
  ["build_from_dep", [["dep", ["X", "Y"]], ["built", ["Y"]]], [["built", ["X"]]], [], 1],
  # --- paradigm_gallery demos (chop_wood appears 3x identically -- kept once) ---
  ["chop_wood", [], [["has_wood", ["yard"]]], [], 1],
  # --- REAL NAME COLLISION, deliberately kept: functional_goal.patlang's
  # build_house (no precondition) vs language_spec_discovery.patlang's
  # own build_house (requires wood) -- genuinely different bodies ---
  ["build_house", [], [["built", ["house_fg"]]], [], 1],
  ["register_route_handler", [], [["route_ready", ["true"]]], [], 1],
  # --- my own experiments' actions ---
  ["gather_wood", [], [["have", ["wood"]]], [], 1],
  ["build_house", [["have", ["wood"]]], [["have", ["house"]]], [], 1],
  ["connect_to_host", [], [["connected", ["parslow_net"]]], [], 1],
  ["send_get_request", [["connected", ["parslow_net"]]], [["have_response", ["parslow_net"]]], [], 1],
  ["fetch_via_curl", [], [["have_response", ["parslow_page"]]], [], 1],
  # --- friendly_cli tool-discovery / engine actions (real, from ai_engine.patlang, imggen_engine.patlang, smart_engine.patlang, tool_discovery.patlang) ---
  ["discovered_pandoc_md_docx", [["has_md", ["docs"]]], [["has_docx", ["docs"]]], [], 1],
  ["discovered_powershell_zip", [["has_docx", ["docs"]]], [["archived", ["backup.zip"]]], [], 1],
  ["act_md_to_docx", [["has_md", ["docs"]]], [["has_docx", ["docs"]]], [], 1],
  ["act_docx_to_pdf", [["has_docx", ["docs"]]], [["has_pdf", ["docs"]]], [], 1],
  ["act_archive_pdf", [["has_pdf", ["docs"]]], [["archived", ["backup.zip"]]], [], 1],
  ["act_ai_opinion_doc", [["has_md", ["docs"]]], [["has_ai_opinion", ["docs"]]], [], 1],
  ["act_generate_image", [], [["has_image", ["docs"]]], [], 1]
]

print("=== FULL registry catalog size: " + list_len(catalog) + " real actions, from " + 8 + " distinct source files ===")

print("")
print("=== Goal A: shipped() -- real build/link chain, should pick the CHEAPEST of two competing routes ===")
let keptA = goap_register_relevant_only(catalog, [["shipped", []]])
print("relevant actions selected: " + keptA)
let planA = plan([["shipped", []]])
print("plan found: " + planA)

print("")
print("=== Goal B: has_pdf(docs) -- real document-pipeline chain ===")
let keptB = goap_register_relevant_only(catalog, [["has_pdf", ["docs"]]])
print("relevant actions selected: " + keptB)

print("")
print("=== Goal C: have(house) -- probes the REAL name collision (build_house x2, different bodies) ===")
let keptC = goap_register_relevant_only(catalog, [["have", ["house"]]])
print("relevant actions selected: " + keptC)
print("NOTE: catalog has TWO actions both named build_house (functional_goal.patlang's parameterless one, and language_spec_discovery.patlang's wood-requiring one) -- goap_relevant_actions dedupes by NAME via kept_names, so only ONE survives even though they're genuinely different bodies. Which one depends on catalog ORDER (first match wins), not on which is actually correct for the goal -- a real, worth-flagging precision gap for a same-named-different-body collision, distinct from the earlier argument-matching bug already fixed.")

print("")
print("=== Goal D: a targeted test -- does a goal needing BOTH same-named actions' effects reveal the real collision risk? ===")
let keptD = goap_register_relevant_only(catalog, [["have", ["house"]], ["built", ["house_fg"]]])
print("relevant actions selected: " + keptD)
print("if this list has only ONE 'build_house' entry despite BOTH being genuinely needed here, that confirms the dedup-by-name risk is real, not just theoretical")
