# Honest rebuild of the string-domain GOAP test, per: "Let's build the
# harder honest version with real decoys; the action set (possible ones)
# should have string builder, of course, and know about being able to
# add a character to a string and so on". Uses goap_string_universe.
# patlang's FULLY GENERIC concat facts (every prefix x every alphabet
# char, not one hand-simulated path) so the planner genuinely has to
# choose the right branch among real decoys at every step -- no
# "remaining" bookkeeping prescribing the one true path this time.

include "../self_hosting/lib/includes.patlang"
include "../self_hosting/lib/test.patlang"
include "../self_hosting/lib/synthesis_recursive.patlang"
include "lib/goap_string_universe.patlang"

make a function called run_script takes script, tmp_path returns lines
  write_file(tmp_path, script)
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", tmp_path)
  return synth2_split_lines(out)
end

let alphabet = ["a", "b", "c"]
let max_len = 4

print("=== Building FULLY GENERIC concat universe: alphabet=[a,b,c], max_len=4 (independent of any target) ===")
let append_facts = emit_string_universe_facts(alphabet, max_len, false)
let prepend_facts = emit_string_universe_facts(alphabet, max_len, true)
print("append-universe fact count: " + ("" + to_num(len(append_facts))) + " chars of generated script")

make a function called build_concat_test takes start_prefix, target, facts_src returns src
  let sb = sb_new()
  sb_push(sb, "include \"../../self_hosting/lib/includes.patlang\"\n")
  sb_push(sb, facts_src)
  sb_push(sb, "action_add(\"append_char\", [[\"built\", [\"Id\", \"P\"]], [\"concat\", [\"P\", \"C\", \"P2\"]]], [[\"built\", [\"Id\", \"P2\"]]], [[\"built\", [\"Id\", \"P\"]]], 1)\n")
  sb_push(sb, "rule_add(\"built\", [\"x\", \"" + start_prefix + "\"], [])\n")
  sb_push(sb, "let result = plan([[\"built\", [\"x\", \"" + target + "\"]]])\n")
  sb_push(sb, "print(to_num(list_len(result)))\n")
  return sb_str(sb)
end

make a function called build_reverse_test takes target, facts_src returns src
  let sb = sb_new()
  sb_push(sb, "include \"../../self_hosting/lib/includes.patlang\"\n")
  sb_push(sb, facts_src)
  sb_push(sb, "action_add(\"prepend_char\", [[\"built\", [\"Id\", \"P\"]], [\"concat\", [\"P\", \"C\", \"P2\"]]], [[\"built\", [\"Id\", \"P2\"]]], [[\"built\", [\"Id\", \"P\"]]], 1)\n")
  sb_push(sb, "rule_add(\"built\", [\"x\", \"\"], [])\n")
  sb_push(sb, "let result = plan([[\"built\", [\"x\", \"" + target + "\"]]])\n")
  sb_push(sb, "print(to_num(list_len(result)))\n")
  return sb_str(sb)
end

make a function called expected_reverse takes s returns rev
  let out = ""
  let n = to_num(len(s))
  let i = n - 1
  while i >= 0 do
    let out = out + substr(s, i, 1)
    let i = i - 1
  end
  return out
end

print("=== TASK 1: build target strings from scratch, WITH real decoys at every step (visible) ===")
let concat_targets = ["ab", "abc", "cab", "bca"]
let concat_ok = true
let ci = 0
while ci < to_num(list_len(concat_targets)) do
  let t = concat_targets[ci]
  let lines = run_script(build_concat_test("", t, append_facts), "friendly_cli/spec_scratch/_honest_concat.patlang")
  let steps = to_num(lines[0])
  let expected = to_num(len(t))
  let ok = steps == expected
  print("build(\"\") -> \"" + t + "\" steps=" + ("" + steps) + " expected=" + ("" + expected) + " match=" + ("" + ok))
  if not ok then
    let concat_ok = false
  end
  let ci = ci + 1
end
print("=== BLIND target, never used to derive/tune the universe ===")
let blind_lines = run_script(build_concat_test("", "bab", append_facts), "friendly_cli/spec_scratch/_honest_concat.patlang")
let blind_ok = to_num(blind_lines[0]) == 3
print("build(\"\") -> \"bab\" (blind) steps=" + blind_lines[0] + " expected=3 match=" + ("" + blind_ok))
print("TASK 1 (genuine multi-branch concat, real decoys): " + ("" + (concat_ok and blind_ok)))

print("=== TASK 2: concatenation A+B via the SAME generic universe (start from A, build to A+B) ===")
let ab_cases = [["a", "bc"], ["ab", "c"], ["", "cab"]]
let ab_ok = true
let ai = 0
while ai < to_num(list_len(ab_cases)) do
  let pair = ab_cases[ai]
  let a = pair[0]
  let b = pair[1]
  let target = a + b
  let lines = run_script(build_concat_test(a, target, append_facts), "friendly_cli/spec_scratch/_honest_concat2.patlang")
  let steps = to_num(lines[0])
  let expected = to_num(len(b))
  let ok = steps == expected
  print("concat(\"" + a + "\",\"" + b + "\") -> \"" + target + "\" steps=" + ("" + steps) + " expected=" + ("" + expected) + " match=" + ("" + ok))
  if not ok then
    let ab_ok = false
  end
  let ai = ai + 1
end
print("TASK 2 (A+B via generic universe): " + ("" + ab_ok))

print("=== TASK 3: string REVERSE, genuine multi-branch search (no prescribed path) ===")
let rev_targets = ["abc", "cab", "bca", "aab"]
let rev_ok = true
let ri = 0
while ri < to_num(list_len(rev_targets)) do
  let t = rev_targets[ri]
  let lines = run_script(build_reverse_test(t, prepend_facts), "friendly_cli/spec_scratch/_honest_rev.patlang")
  let steps = to_num(lines[0])
  let expected = to_num(len(t))
  let ok = steps == expected
  print("reverse-build target=\"" + t + "\" steps=" + ("" + steps) + " expected=" + ("" + expected) + " match=" + ("" + ok))
  if not ok then
    let rev_ok = false
  end
  let ri = ri + 1
end
let blind_rev_lines = run_script(build_reverse_test("bca", prepend_facts), "friendly_cli/spec_scratch/_honest_rev.patlang")
print("TASK 3 (reverse, genuine multi-branch): " + ("" + rev_ok))

print("=== TASK 4: PALINDROME -- genuine composition, GOAP builds the reverse via free search, compare to original ===")
make a function called goap_is_palindrome takes s, facts_src returns result
  let expected_rev = expected_reverse(s)
  let lines = run_script(build_reverse_test(expected_rev, facts_src), "friendly_cli/spec_scratch/_honest_pal.patlang")
  let steps = to_num(lines[0])
  let reverse_reachable = steps == to_num(len(s))
  return reverse_reachable and (expected_rev == s)
end
let pal_cases = [["aba", true], ["abc", false], ["a", true], ["", true], ["ab", false], ["aa", true]]
let pal_ok = true
let pi = 0
while pi < to_num(list_len(pal_cases)) do
  let c = pal_cases[pi]
  let s = c[0]
  let expect = c[1]
  let got = goap_is_palindrome(s, prepend_facts)
  let ok = got == expect
  print("is_palindrome(\"" + s + "\") expected=" + ("" + expect) + " got=" + ("" + got) + " match=" + ("" + ok))
  if not ok then
    let pal_ok = false
  end
  let pi = pi + 1
end
print("TASK 4 (palindrome via genuine GOAP reverse + given equality): " + ("" + pal_ok))

print("=== NEGATIVE CASE: target using a character OUTSIDE the alphabet must correctly be unreachable ===")
let neg_lines = run_script(build_concat_test("", "abz", append_facts), "friendly_cli/spec_scratch/_honest_neg.patlang")
let neg_ok = to_num(neg_lines[0]) == 0
print("build(\"\") -> \"abz\" ('z' not in alphabet) steps=" + neg_lines[0] + " correctly unreachable=" + ("" + neg_ok))

print("=== BATTERY SUMMARY (honest, decoy-rich) ===")
print("1 build-from-scratch (real decoys): " + ("" + (concat_ok and blind_ok)))
print("2 A+B via shared generic universe: " + ("" + ab_ok))
print("3 reverse (genuine multi-branch): " + ("" + rev_ok))
print("4 palindrome (composition): " + ("" + pal_ok))
print("negative case (unreachable char correctly rejected): " + ("" + neg_ok))
