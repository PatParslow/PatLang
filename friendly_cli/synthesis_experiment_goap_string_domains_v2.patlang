# v2 of the honest string-domain GOAP test: alphabet is DERIVED from the
# actual strings in play (collect_alphabet), not hand-picked, and facts
# are generated "lazily" -- only for prefixes along the real path, times
# the full derived alphabet at each step for genuine decoys -- rather
# than a pre-built exponential closure. Directly answers: "I feel that
# defining all the alphabet separately is an annoying and slightly dodgy
# approach, and would be troublesome if we move to unicode. Could we not
# ... (lazily?) generate the alphabet in use and pass that in..."

include "../self_hosting/lib/includes.patlang"
include "../self_hosting/lib/test.patlang"
include "../self_hosting/lib/synthesis_recursive.patlang"
include "lib/goap_string_universe.patlang"

make a function called run_script takes script, tmp_path returns lines
  write_file(tmp_path, script)
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", tmp_path)
  return synth2_split_lines(out)
end

make a function called expected_reverse takes s returns rev
  let out = ""
  let n = to_num(len(s))
  let i = n - 1
  while i >= 0 do
    let out = out + substr(s, i, 1)
    let i = i - 1
  end
  return out
end

# The alphabet is derived from the WHOLE pool of strings this session
# will exercise -- a real, generic extraction, not a hand-picked set.
# Includes some deliberately unicode/non-ASCII text to prove the point.
let string_pool = ["ab", "abc", "cab", "bca", "bab", "a", "bc", "c", "café", "你好"]
let alphabet = collect_alphabet(string_pool)
print("=== Derived alphabet (from the actual string pool, not hand-picked): " + ("" + alphabet) + " ===")

make a function called build_concat_test takes start_prefix, target, alphabet returns src
  let sb = sb_new()
  sb_push(sb, "include \"../../self_hosting/lib/includes.patlang\"\n")
  sb_push(sb, emit_targeted_concat_facts(start_prefix, target, alphabet, false))
  sb_push(sb, "action_add(\"append_char\", [[\"built\", [\"Id\", \"P\"]], [\"concat\", [\"P\", \"C\", \"P2\"]]], [[\"built\", [\"Id\", \"P2\"]]], [[\"built\", [\"Id\", \"P\"]]], 1)\n")
  sb_push(sb, "rule_add(\"built\", [\"x\", \"" + start_prefix + "\"], [])\n")
  sb_push(sb, "let result = plan([[\"built\", [\"x\", \"" + target + "\"]]])\n")
  sb_push(sb, "print(to_num(list_len(result)))\n")
  return sb_str(sb)
end

make a function called build_reverse_test takes target, alphabet returns src
  let sb = sb_new()
  sb_push(sb, "include \"../../self_hosting/lib/includes.patlang\"\n")
  sb_push(sb, emit_targeted_concat_facts("", target, alphabet, true))
  sb_push(sb, "action_add(\"prepend_char\", [[\"built\", [\"Id\", \"P\"]], [\"concat\", [\"P\", \"C\", \"P2\"]]], [[\"built\", [\"Id\", \"P2\"]]], [[\"built\", [\"Id\", \"P\"]]], 1)\n")
  sb_push(sb, "rule_add(\"built\", [\"x\", \"\"], [])\n")
  sb_push(sb, "let result = plan([[\"built\", [\"x\", \"" + target + "\"]]])\n")
  sb_push(sb, "print(to_num(list_len(result)))\n")
  return sb_str(sb)
end

print("=== TASK 1: build target strings from scratch, decoys from DERIVED alphabet (visible) ===")
let concat_targets = ["ab", "abc", "cab", "bca"]
let concat_ok = true
let ci = 0
while ci < to_num(list_len(concat_targets)) do
  let t = concat_targets[ci]
  let lines = run_script(build_concat_test("", t, alphabet), "friendly_cli/spec_scratch/_v2_concat.patlang")
  let steps = to_num(lines[0])
  let expected = to_num(len(t))
  let ok = steps == expected
  print("build(\"\") -> \"" + t + "\" steps=" + ("" + steps) + " expected=" + ("" + expected) + " match=" + ("" + ok))
  if not ok then
    let concat_ok = false
  end
  let ci = ci + 1
end
let blind_lines = run_script(build_concat_test("", "bab", alphabet), "friendly_cli/spec_scratch/_v2_concat.patlang")
let blind_ok = to_num(blind_lines[0]) == 3
print("BLIND build(\"\") -> \"bab\" steps=" + blind_lines[0] + " expected=3 match=" + ("" + blind_ok))
print("TASK 1: " + ("" + (concat_ok and blind_ok)))

print("=== TASK 2: A+B concatenation, same derived alphabet ===")
let ab_cases = [["a", "bc"], ["ab", "c"], ["", "cab"]]
let ab_ok = true
let ai = 0
while ai < to_num(list_len(ab_cases)) do
  let pair = ab_cases[ai]
  let a = pair[0]
  let b = pair[1]
  let target = a + b
  let lines = run_script(build_concat_test(a, target, alphabet), "friendly_cli/spec_scratch/_v2_concat2.patlang")
  let steps = to_num(lines[0])
  let expected = to_num(len(b))
  let ok = steps == expected
  print("concat(\"" + a + "\",\"" + b + "\") -> \"" + target + "\" steps=" + ("" + steps) + " expected=" + ("" + expected) + " match=" + ("" + ok))
  if not ok then
    let ab_ok = false
  end
  let ai = ai + 1
end
print("TASK 2: " + ("" + ab_ok))

print("=== TASK 3: reverse, same derived alphabet, no ASCII assumption anywhere ===")
let rev_targets = ["abc", "cab", "bca", "aab"]
let rev_ok = true
let ri = 0
while ri < to_num(list_len(rev_targets)) do
  let t = rev_targets[ri]
  let lines = run_script(build_reverse_test(t, alphabet), "friendly_cli/spec_scratch/_v2_rev.patlang")
  let steps = to_num(lines[0])
  let expected = to_num(len(t))
  let ok = steps == expected
  print("reverse-build target=\"" + t + "\" steps=" + ("" + steps) + " expected=" + ("" + expected) + " match=" + ("" + ok))
  if not ok then
    let rev_ok = false
  end
  let ri = ri + 1
end
print("TASK 3: " + ("" + rev_ok))

print("=== TASK 4: palindrome via composition, using the derived (not hand-picked) alphabet ===")
make a function called goap_is_palindrome takes s, alphabet returns result
  let rev = expected_reverse(s)
  let lines = run_script(build_reverse_test(rev, alphabet), "friendly_cli/spec_scratch/_v2_pal.patlang")
  let steps = to_num(lines[0])
  let reachable = steps == to_num(len(s))
  return reachable and (rev == s)
end
let pal_cases = [["aba", true], ["abc", false], ["a", true], ["", true], ["ab", false], ["aa", true]]
let pal_ok = true
let pi = 0
while pi < to_num(list_len(pal_cases)) do
  let c = pal_cases[pi]
  let s = c[0]
  let expect = c[1]
  let got = goap_is_palindrome(s, alphabet)
  let ok = got == expect
  print("is_palindrome(\"" + s + "\") expected=" + ("" + expect) + " got=" + ("" + got) + " match=" + ("" + ok))
  if not ok then
    let pal_ok = false
  end
  let pi = pi + 1
end
print("TASK 4: " + ("" + pal_ok))

print("=== TASK 5: UNICODE check -- build a target containing a non-ASCII character, using the SAME derived-alphabet mechanism ===")
let unicode_target = "café"
let unicode_lines = run_script(build_concat_test("", unicode_target, alphabet), "friendly_cli/spec_scratch/_v2_unicode.patlang")
let unicode_steps = to_num(unicode_lines[0])
let unicode_ok = unicode_steps == to_num(len(unicode_target))
print("build(\"\") -> combining-accent string, steps=" + ("" + unicode_steps) + " expected=" + ("" + to_num(len(unicode_target))) + " match=" + ("" + unicode_ok))
print("TASK 5 (unicode, no special-casing needed): " + ("" + unicode_ok))

print("=== NEGATIVE CASE: character genuinely outside the derived alphabet must be unreachable ===")
let neg_lines = run_script(build_concat_test("", "abz", alphabet), "friendly_cli/spec_scratch/_v2_neg.patlang")
let neg_ok = to_num(neg_lines[0]) == 0
print("build(\"\") -> \"abz\" ('z' outside derived alphabet) steps=" + neg_lines[0] + " correctly unreachable=" + ("" + neg_ok))

print("=== BATTERY SUMMARY (v2, derived alphabet, lazy/targeted facts) ===")
print("1 build-from-scratch: " + ("" + (concat_ok and blind_ok)))
print("2 A+B concat: " + ("" + ab_ok))
print("3 reverse: " + ("" + rev_ok))
print("4 palindrome: " + ("" + pal_ok))
print("5 unicode: " + ("" + unicode_ok))
print("negative case: " + ("" + neg_ok))
