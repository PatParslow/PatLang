# Broader test of the target_goal-precondition technique (confirmed in
# goap_packaged_loop_arbitrary_target.meta.json) across a RANGE of
# structurally different synthesis tasks, per: "let's test that it works
# across a range of synthesis tasks?" -- one success on 'increment'
# isn't strong evidence the PATTERN generalizes; this tries several
# genuinely different shapes.
#
# Task A: decrement_to_target -- mirrors increment_to_target, confirms
#   the technique works counting DOWN to an arbitrary target too, not
#   just up.
# Task B: THREE simultaneous counters, each with a DIFFERENT arbitrary
#   target (not all 0, not all 10) -- combines goap_multi_example_
#   composition (multiple simultaneous goals in one plan() call) with
#   arbitrary-target binding, the genuine synthesis of both discoveries.
# Task C: a NON-LINEAR chain (doubling, X -> 2X) with arbitrary targets
#   -- tests a structurally different reachability shape (not every
#   target is reachable from every start), including a REAL NEGATIVE
#   CASE the planner must correctly report as unsolvable (empty plan),
#   not just successful cases.

include "../self_hosting/lib/includes.patlang"
include "../self_hosting/lib/test.patlang"
include "../self_hosting/lib/synthesis_recursive.patlang"

make a function called run_script takes script, tmp_path returns lines
  write_file(tmp_path, script)
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", tmp_path)
  return synth2_split_lines(out)
end

print("=== TASK A: decrement_to_target (arbitrary target, counting DOWN) ===")
make a function called task_a_script takes start, target returns src
  let sb = sb_new()
  sb_push(sb, "include \"../../self_hosting/lib/includes.patlang\"\n")
  let i = 1
  while i <= 30 do
    sb_push(sb, "rule_add(\"pred1\", [\"" + ("" + i) + "\", \"" + ("" + (i - 1)) + "\"], [])\n")
    let i = i + 1
  end
  sb_push(sb, "action_add(\"decrement\", [[\"counter\", [\"Id\", \"X\"]], [\"pred1\", [\"X\", \"X2\"]]], [[\"counter\", [\"Id\", \"X2\"]]], [[\"counter\", [\"Id\", \"X\"]]], 1)\n")
  sb_push(sb, "action_add(\"decrement_to_target\", [[\"counter\", [\"Id\", \"X\"]], [\"target_goal\", [\"Id\", \"Target\"]]], [[\"counter\", [\"Id\", \"Target\"]]], [[\"counter\", [\"Id\", \"X\"]]], 1)\n")
  sb_push(sb, "rule_add(\"target_goal\", [\"t\", \"" + target + "\"], [])\n")
  sb_push(sb, "rule_add(\"counter\", [\"t\", \"" + start + "\"], [])\n")
  sb_push(sb, "let result = plan([[\"counter\", [\"t\", \"" + target + "\"]]])\n")
  sb_push(sb, "print(to_num(list_len(result)))\n")
  sb_push(sb, "print(result)\n")
  return sb_str(sb)
end

let a_ok = true
let a_cases = [[20, 5], [15, 0], [10, 3]]
let ai = 0
while ai < to_num(list_len(a_cases)) do
  let c = a_cases[ai]
  let s = c[0]
  let t = c[1]
  let lines = run_script(task_a_script(("" + s), ("" + t)), "friendly_cli/spec_scratch/_battery_a.patlang")
  let steps = to_num(lines[0])
  let expected = s - t
  let ok = steps == expected
  print("start=" + ("" + s) + " target=" + ("" + t) + " steps=" + ("" + steps) + " expected=" + ("" + expected) + " match=" + ("" + ok))
  if not ok then
    let a_ok = false
  end
  let ai = ai + 1
end
print("TASK A blind check:")
let a_blind_lines = run_script(task_a_script("18", "7"), "friendly_cli/spec_scratch/_battery_a.patlang")
let a_blind_ok = to_num(a_blind_lines[0]) == 11
print("start=18 target=7 (blind) steps=" + a_blind_lines[0] + " expected=11 match=" + ("" + a_blind_ok))
if a_ok and a_blind_ok then
  print("TASK A: PASS -- decrement_to_target genuinely generalizes to arbitrary targets")
else
  print("TASK A: FAIL")
end

print("=== TASK B: THREE simultaneous counters, each a DIFFERENT arbitrary target ===")
let b_script = sb_new()
sb_push(b_script, "include \"../../self_hosting/lib/includes.patlang\"\n")
let bi = 0
while bi < 30 do
  sb_push(b_script, "rule_add(\"succ\", [\"" + ("" + bi) + "\", \"" + ("" + (bi + 1)) + "\"], [])\n")
  let bi = bi + 1
end
sb_push(b_script, "action_add(\"increment\", [[\"counter\", [\"Id\", \"X\"]], [\"succ\", [\"X\", \"X2\"]]], [[\"counter\", [\"Id\", \"X2\"]]], [[\"counter\", [\"Id\", \"X\"]]], 1)\n")
sb_push(b_script, "action_add(\"increment_to_target\", [[\"counter\", [\"Id\", \"X\"]], [\"target_goal\", [\"Id\", \"Target\"]]], [[\"counter\", [\"Id\", \"Target\"]]], [[\"counter\", [\"Id\", \"X\"]]], 1)\n")
sb_push(b_script, "rule_add(\"target_goal\", [\"p\", \"6\"], [])\n")
sb_push(b_script, "rule_add(\"target_goal\", [\"q\", \"11\"], [])\n")
sb_push(b_script, "rule_add(\"target_goal\", [\"r\", \"4\"], [])\n")
sb_push(b_script, "rule_add(\"counter\", [\"p\", \"1\"], [])\n")
sb_push(b_script, "rule_add(\"counter\", [\"q\", \"3\"], [])\n")
sb_push(b_script, "rule_add(\"counter\", [\"r\", \"4\"], [])\n")
sb_push(b_script, "let result = plan([[\"counter\", [\"p\", \"6\"]], [\"counter\", [\"q\", \"11\"]], [\"counter\", [\"r\", \"4\"]]])\n")
sb_push(b_script, "print(to_num(list_len(result)))\n")
sb_push(b_script, "print(result)\n")
let b_lines = run_script(sb_str(b_script), "friendly_cli/spec_scratch/_battery_b.patlang")
print("plan: " + b_lines[1])
let b_len = to_num(b_lines[0])
let b_all_shortcut = true
let b_seen_p = false
let b_seen_q = false
let b_seen_r_zero_step_ok = true
if contains_text(b_lines[1], "Id=p") then
  let b_seen_p = true
end
if contains_text(b_lines[1], "Id=q") then
  let b_seen_q = true
end
print("total steps=" + ("" + b_len) + " (expect 2, since p and q need one shortcut each; r already at target=4, needs zero steps)")
let b_ok = (b_len == 2) and b_seen_p and b_seen_q
print("TASK B: " + ("" + b_ok) + " -- one plan() call solved 3 simultaneous DIFFERENT arbitrary targets (p:1->6, q:3->11, r already at 4)")

print("=== TASK C: non-linear 'doubling' chain, arbitrary target, INCLUDING a real unreachable negative case ===")
let c_script = sb_new()
sb_push(c_script, "include \"../../self_hosting/lib/includes.patlang\"\n")
sb_push(c_script, "rule_add(\"double\", [\"1\", \"2\"], [])\n")
sb_push(c_script, "rule_add(\"double\", [\"2\", \"4\"], [])\n")
sb_push(c_script, "rule_add(\"double\", [\"4\", \"8\"], [])\n")
sb_push(c_script, "rule_add(\"double\", [\"8\", \"16\"], [])\n")
sb_push(c_script, "rule_add(\"double\", [\"16\", \"32\"], [])\n")
sb_push(c_script, "action_add(\"apply_double\", [[\"counter\", [\"Id\", \"X\"]], [\"double\", [\"X\", \"X2\"]]], [[\"counter\", [\"Id\", \"X2\"]]], [[\"counter\", [\"Id\", \"X\"]]], 1)\n")
sb_push(c_script, "action_add(\"double_to_target\", [[\"counter\", [\"Id\", \"X\"]], [\"target_goal\", [\"Id\", \"Target\"]]], [[\"counter\", [\"Id\", \"Target\"]]], [[\"counter\", [\"Id\", \"X\"]]], 1)\n")
sb_push(c_script, "rule_add(\"target_goal\", [\"reachable\", \"16\"], [])\n")
sb_push(c_script, "rule_add(\"counter\", [\"reachable\", \"1\"], [])\n")
sb_push(c_script, "rule_add(\"target_goal\", [\"unreachable\", \"6\"], [])\n")
sb_push(c_script, "rule_add(\"counter\", [\"unreachable\", \"1\"], [])\n")
sb_push(c_script, "let ok_plan = plan([[\"counter\", [\"reachable\", \"16\"]]])\n")
sb_push(c_script, "print(to_num(list_len(ok_plan)))\n")
sb_push(c_script, "print(ok_plan)\n")
sb_push(c_script, "let bad_plan = plan([[\"counter\", [\"unreachable\", \"6\"]]])\n")
sb_push(c_script, "print(to_num(list_len(bad_plan)))\n")
let c_lines = run_script(sb_str(c_script), "friendly_cli/spec_scratch/_battery_c.patlang")
print("reachable (1->16 via doubling) plan: " + c_lines[1] + " steps=" + c_lines[0])
print("unreachable (1->6, not a power-of-2 multiple) steps=" + c_lines[2] + " (0 = correctly detected as impossible)")
let c_reachable_ok = to_num(c_lines[0]) == 1
let c_unreachable_ok = to_num(c_lines[2]) == 0
let c_ok = c_reachable_ok and c_unreachable_ok
print("TASK C: " + ("" + c_ok) + " -- doubling generalizes AND correctly reports the unreachable target as unsolvable, not a false positive")

print("=== BATTERY SUMMARY ===")
print("A (decrement_to_target, arbitrary): " + ("" + (a_ok and a_blind_ok)))
print("B (3 simultaneous DIFFERENT arbitrary targets): " + ("" + b_ok))
print("C (non-linear chain + correct unreachability detection): " + ("" + c_ok))
