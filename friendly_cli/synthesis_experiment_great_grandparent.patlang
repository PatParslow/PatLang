# Tier A synthesis experiment (pure logic/GOAP composition, NO LLM):
# can the EXISTING induction engine (synthesis_lgg.patlang) derive a
# correct "great_grandparent(X)" rule (a 3-hop parent chain) from a
# BDD-shaped spec -- Given (background facts) + Then (visible positive/
# negative examples) -- and does the induced rule generalize correctly
# to BLIND held-back examples never shown during induction?
#
# This is a genuinely NEW domain (not yet demonstrated this session or
# in prior memory -- "grandparent" is the existing 2-hop benchmark,
# this is a fresh 3-hop one), used specifically to test the actual
# generalization/anti-vacuity concern the user raised: "keep back some
# additional 'blind' tests to ensure we aren't writing programs to
# satisfy relatively vacuous tests".

include "../self_hosting/lib/includes.patlang"
include "../self_hosting/lib/test.patlang"
include "../self_hosting/lib/synthesis_recursive.patlang"
include "../self_hosting/lib/synthesis_lgg.patlang"

# ---- Given: background facts (a full ancestry graph, including
# structure the VISIBLE examples deliberately never reference) ----
let facts = []
let facts = list_push(facts, synth5_fact_binary("parent", "alice", "bob"))
let facts = list_push(facts, synth5_fact_binary("parent", "bob", "carol"))
let facts = list_push(facts, synth5_fact_binary("parent", "carol", "dave"))
let facts = list_push(facts, synth5_fact_binary("parent", "erin", "frank"))
let facts = list_push(facts, synth5_fact_binary("parent", "frank", "george"))
let facts = list_push(facts, synth5_fact_binary("parent", "george", "helen"))
# BLIND-only chain: never referenced by pos_values or the VISIBLE
# queries below -- only used in the held-back blind check afterward.
let facts = list_push(facts, synth5_fact_binary("parent", "grace", "henry"))
let facts = list_push(facts, synth5_fact_binary("parent", "henry", "irene"))
let facts = list_push(facts, synth5_fact_binary("parent", "irene", "jack"))

# ---- Then (VISIBLE): positive examples shown to the induction engine ----
let pos_values = ["alice", "erin"]

# ---- Then (VISIBLE): verification queries shown to the induction
# engine (used to confirm/reject the induced hypothesis) ----
let visible_queries = [
  synth2_query("great_grandparent", "alice", true),
  synth2_query("great_grandparent", "erin", true),
  synth2_query("great_grandparent", "dave", false)
]

print("=== Tier A: inducing great_grandparent(X) from VISIBLE examples only ===")
let diagnosis = synth5_induce("great_grandparent", pos_values, visible_queries, facts, 5)
print("induction result: " + diagnosis[0])

if diagnosis[0] == "ok" then
  let seq = diagnosis[1]
  let clause_src = synth4_chain_clause("great_grandparent", seq)
  print("induced rule: " + clause_src)

  # ---- BLIND held-back check: "grace" and "bob" were NEVER shown to
  # synth5_induce, neither as a pos_value nor inside visible_queries.
  # If the induced rule is genuinely correct (not just curve-fit to the
  # two chains it was shown), it must ALSO get these right.
  let blind_queries = [
    synth2_query("great_grandparent", "grace", true),
    synth2_query("great_grandparent", "bob", false)
  ]
  let background_src = synth5_facts_to_src(facts)
  let blind_results = synth2_diagnose_hypothesis(background_src, clause_src, blind_queries)

  let i = 0
  let all_blind_ok = true
  while i < to_num(list_len(blind_results)) do
    let q = blind_queries[i]
    let matched_expectation = blind_results[i]
    print("BLIND check: great_grandparent(" + q[1] + ") expected=" + ("" + q[2]) + " matched=" + ("" + matched_expectation))
    if not matched_expectation then
      let all_blind_ok = false
    end
    let i = i + 1
  end

  if all_blind_ok then
    print("=== RESULT: induced rule passes ALL held-back blind checks -- genuinely generalizes, not vacuous ===")
  else
    print("=== RESULT: induced rule FAILED at least one blind check -- would have been a vacuous pass on visible tests alone ===")
  end
else
  print("=== RESULT: induction did not succeed -- diagnosis: " + diagnosis[0])
end
