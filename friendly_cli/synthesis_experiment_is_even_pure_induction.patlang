# Direct response to: "We should do that *without* LLM though really -
# surely if we proceed in small steps the pure induction approach
# should work..." -- correcting an earlier over-broad claim: I'd
# dismissed "pure induction can't do is_even" based on synthesis_lgg.
# patlang's engine (FIXED-depth chains only, used for great_grandparent
# earlier this session) -- but synthesis_recursive.patlang's synth2_
# induce_chain is a DIFFERENT, more powerful mechanism that explicitly
# searches base-case + recursive-chain-step combinations (real
# unbounded recursion, Metagol-style). Framed relationally (a "step
# down by 2 toward zero" successor relation, not arithmetic), this is
# exactly the shape that engine searches over. Testing for real, not
# assuming either way.

include "../self_hosting/lib/includes.patlang"
include "../self_hosting/lib/test.patlang"
include "../self_hosting/lib/synthesis_recursive.patlang"

# Background: zero(0) (the base case fact) + pred2(X,Y) meaning Y=X-2
# (a "step down by 2 toward zero" relation) -- built for numbers 0..12
# so both the visible AND blind held-back queries below are covered.
# synth2_query's own grounding convention prepends "v:" to every query
# argument (synth2_ground -- prevents a plain constant from ever being
# mistaken for an uppercase logic variable). Background facts must use
# the SAME grounded form for their arguments, or nothing unifies --
# confirmed via a direct debug repro: without this, solve() looked for
# "v:0" while the background only ever declared "0".
let background = sb_new()
sb_push(background, "rule zero(\"v:0\").\n")
let i = 2
while i <= 12 do
  sb_push(background, "rule pred2(\"v:" + ("" + i) + "\", \"v:" + ("" + (i - 2)) + "\").\n")
  let i = i + 2
end
let background_src = sb_str(background)
print("=== background facts ===")
print(background_src)

# VISIBLE queries only -- 0, 2, 4 positive; 1, 3 negative. Held back:
# 6/8/10/12 (positive, deeper recursion than any visible example) and
# 5/7/9/11 (negative) -- proving genuine unbounded generalization, not
# curve-fitting to the specific depths shown.
let visible_queries = [
  synth2_query("is_even", "0", true),
  synth2_query("is_even", "2", true),
  synth2_query("is_even", "4", true),
  synth2_query("is_even", "1", false),
  synth2_query("is_even", "3", false)
]

print("=== inducing is_even via synth2_induce_chain (base=zero, chain=pred2) ===")
let winner = synth2_induce_chain("is_even", ["zero"], ["pred2"], background_src, visible_queries)
print("winner: " + winner)

if to_num(list_len(winner)) == 2 then
  let base_pred = winner[0]
  let chain_pred = winner[1]
  let clause_src = synth2_clauses_for("is_even", base_pred, chain_pred)
  print("induced clauses:")
  print(clause_src)

  print("=== BLIND held-back checks (deeper recursion than any visible example) ===")
  let blind_queries = [
    synth2_query("is_even", "8", true),
    synth2_query("is_even", "10", true),
    synth2_query("is_even", "12", true),
    synth2_query("is_even", "7", false),
    synth2_query("is_even", "9", false),
    synth2_query("is_even", "11", false)
  ]
  let blind_results = synth2_diagnose_hypothesis(background_src, clause_src, blind_queries)
  let all_blind_ok = true
  let bi = 0
  while bi < to_num(list_len(blind_results)) do
    let q = blind_queries[bi]
    let matched = blind_results[bi]
    print("BLIND is_even(" + q[1] + ") expected=" + ("" + q[2]) + " matched=" + ("" + matched))
    if not matched then
      let all_blind_ok = false
    end
    let bi = bi + 1
  end

  if all_blind_ok then
    print("=== RESULT: PURE LOGIC INDUCTION solved is_even, NO LLM -- genuinely generalizes to unseen depths ===")
  else
    print("=== RESULT: induction found a hypothesis but it FAILED at least one blind check -- would have been vacuous on visible tests alone ===")
  end
else
  print("=== RESULT: no base+chain combination fit the visible examples -- pure induction did NOT solve this (in this framing) ===")
end
