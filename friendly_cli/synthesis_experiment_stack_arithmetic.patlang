# Direct response to: "presumably even with unary chains we could
# teach it stack based arithmetic?" -- and a real self-correction: the
# earlier Peano experiment generated its pred1 facts using REAL
# SUBTRACTION (i - 1) to build the decimal labels "v:5" etc -- a bit
# circular for "teaching it math from nothing", since it presupposes
# the very arithmetic being bootstrapped. This version represents each
# number as a TALLY STRING (a stack of marks: "" for 0, "|" for 1, "||"
# for 2, ...), built by PURE STRING CONCATENATION only -- no
# subtraction, no native arithmetic at all involved in constructing the
# facts. "predecessor" becomes "one string is the other with exactly
# one mark popped off the end" -- a genuinely structural, non-numeric
# relation.

include "../self_hosting/lib/includes.patlang"
include "../self_hosting/lib/test.patlang"
include "../self_hosting/lib/synthesis_recursive.patlang"

make a function called tally takes n returns s
  let out = ""
  let i = 0
  while i < n do
    let out = out + "|"
    let i = i + 1
  end
  return out
end

# Builds pred1 facts using ONLY string concatenation (tally(i) is
# always tally(i-1) + "|" by construction, but "i-1" here is just a
# LOOP COUNTER decrementing, not applied to the represented VALUE
# itself -- the represented number's "identity" is its tally STRING's
# length, never computed via subtraction on a number).
let background = sb_new()
sb_push(background, "rule zero(\"v:\").\n")
let prev = ""
let i = 1
while i <= 15 do
  let cur = prev + "|"
  sb_push(background, "rule pred1(\"v:" + cur + "\", \"v:" + prev + "\").\n")
  let prev = cur
  let i = i + 1
end
sb_push(background, "rule plus(A, \"v:\", A).\n")
sb_push(background, "rule plus(A, B, C) :- pred1(B, B2), pred1(C, C2), plus(A, B2, C2).\n")
let background_src = sb_str(background)
print("=== tally-string (stack) background, built via string concatenation only ===")
print(background_src)

# VISIBLE: 3+4=7 in tally form
let script1 = background_src + "\nlet r1 = solve(\"plus\", [\"v:" + tally(3) + "\", \"v:" + tally(4) + "\", \"v:" + tally(7) + "\"])\nprint(list_len(r1))\nlet r2 = solve(\"plus\", [\"v:" + tally(3) + "\", \"v:" + tally(4) + "\", \"v:" + tally(8) + "\"])\nprint(list_len(r2))\n"
write_file("friendly_cli/spec_scratch/stack_check1.patlang", script1)
print("=== VISIBLE: tally(3)+tally(4) ===")
print(exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "friendly_cli/spec_scratch/stack_check1.patlang"))

# BLIND: unexercised tally lengths never used above
let script2 = background_src + "\nlet r1 = solve(\"plus\", [\"v:" + tally(6) + "\", \"v:" + tally(5) + "\", \"v:" + tally(11) + "\"])\nprint(list_len(r1))\nlet r2 = solve(\"plus\", [\"v:" + tally(6) + "\", \"v:" + tally(5) + "\", \"v:" + tally(12) + "\"])\nprint(list_len(r2))\n"
write_file("friendly_cli/spec_scratch/stack_check2.patlang", script2)
print("=== BLIND: tally(6)+tally(5) ===")
print(exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "friendly_cli/spec_scratch/stack_check2.patlang"))
