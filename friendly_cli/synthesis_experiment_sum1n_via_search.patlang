# Attempt to get sum_1_to_n found by SEARCH (synth3_induce_accumulator)
# rather than hand-specified -- the direct response to: "let's try
# working out how to get these to work... you can avoid writing any
# code for these curriculum solutions unless it is to verify the
# machine produced one is correct or not."
#
# Background relations (zero/pred1/plus) are the SAME already-verified
# ones from peano_arithmetic -- reused as GIVEN, not re-derived here.
# Candidate pool includes DECOYS (pred2 = step by 2, times = multiply)
# to prove the search genuinely discriminates rather than trivially
# trying the one correct option with nothing to reject.

include "../self_hosting/lib/includes.patlang"
include "../self_hosting/lib/test.patlang"
include "../self_hosting/lib/synthesis_recursive.patlang"
include "lib/synth3_accumulator_search.patlang"

let background = sb_new()
sb_push(background, "rule zero(\"v:0\").\n")
let i = 1
while i <= 60 do
  sb_push(background, "rule pred1(\"v:" + ("" + i) + "\", \"v:" + ("" + (i - 1)) + "\").\n")
  let i = i + 1
end
let j = 2
while j <= 60 do
  sb_push(background, "rule pred2(\"v:" + ("" + j) + "\", \"v:" + ("" + (j - 2)) + "\").\n")
  let j = j + 2
end
sb_push(background, "rule plus(A, \"v:0\", A).\n")
sb_push(background, "rule plus(A, B, C) :- pred1(B, B2), pred1(C, C2), plus(A, B2, C2).\n")
sb_push(background, "rule times(A, \"v:0\", \"v:0\").\n")
sb_push(background, "rule times(A, B, C) :- pred1(B, B2), plus(D, A, C), times(A, B2, D).\n")
let background_src = sb_str(background)

# VISIBLE queries only -- a small set of positive/negative sum1n(N,Total) facts.
let visible_queries = [
  synth3_query("target", "1", "1", true),
  synth3_query("target", "3", "6", true),
  synth3_query("target", "2", "5", false)
]

print("=== SEARCHING for sum_1_to_n's structure (chain,combine candidates: pred1/pred2 x plus/times) ===")
let winner = synth3_induce_accumulator("target", ["pred1", "pred2"], ["plus", "times"], background_src, visible_queries)
print("winner: " + winner)

if to_num(list_len(winner)) == 2 then
  let chain_pred = winner[0]
  let combine_pred = winner[1]
  let clause_src = synth3_clauses_for("target", chain_pred, combine_pred)
  print("found clauses:")
  print(clause_src)

  print("=== BLIND held-back checks (values never shown to the search) ===")
  let blind_queries = [
    synth3_query("target", "5", "15", true),
    synth3_query("target", "10", "55", true),
    synth3_query("target", "10", "56", false),
    synth3_query("target", "7", "27", false)
  ]
  let blind_results = synth3_diagnose_hypothesis(background_src, clause_src, blind_queries)
  let all_blind_ok = true
  let bi = 0
  while bi < to_num(list_len(blind_results)) do
    let q = blind_queries[bi]
    let matched = blind_results[bi]
    print("BLIND target(" + q[1] + "," + q[2] + ") expected=" + ("" + q[3]) + " matched=" + ("" + matched))
    if not matched then
      let all_blind_ok = false
    end
    let bi = bi + 1
  end

  if all_blind_ok then
    print("=== RESULT: sum_1_to_n's structure found by SEARCH (not hand-specified), genuinely generalizes ===")
  else
    print("=== RESULT: search found a hypothesis that passed visible but FAILED blind checks -- vacuous ===")
  end
else
  print("=== RESULT: no candidate (chain,combine) pair in the given search space fit the visible examples ===")
end
