# Direct test of the user's own idea: "can it learn to toggle a truth
# value; if so it can count in twos and should be able to handle the sum
# of evens...?" -- tests whether a generic toggle+conditional-accumulate
# search extension (synth4_toggle_search.patlang) can find "sum of even
# numbers from 0 to N" purely by search, same discipline as sum_1_to_n.
#
# Scope note (told to the user up front, not discovered after the fact):
# this is SUM OF EVENS UP TO N (an integer accumulation), not the
# curriculum's sum_of_evens(list) spec, which needs a separate, still-
# unbuilt list encoding. Reports honestly which piece this closes.

include "../self_hosting/lib/includes.patlang"
include "../self_hosting/lib/test.patlang"
include "../self_hosting/lib/synthesis_recursive.patlang"
include "lib/synth4_toggle_search.patlang"

let background = sb_new()
sb_push(background, "rule zero(\"v:0\").\n")
sb_push(background, "rule toggle(\"v:true\", \"v:false\").\n")
sb_push(background, "rule toggle(\"v:false\", \"v:true\").\n")
let i = 1
while i <= 150 do
  sb_push(background, "rule pred1(\"v:" + ("" + i) + "\", \"v:" + ("" + (i - 1)) + "\").\n")
  let i = i + 1
end
let j = 2
while j <= 150 do
  sb_push(background, "rule pred2(\"v:" + ("" + j) + "\", \"v:" + ("" + (j - 2)) + "\").\n")
  let j = j + 2
end
sb_push(background, "rule plus(A, \"v:0\", A).\n")
sb_push(background, "rule plus(A, B, C) :- pred1(B, B2), pred1(C, C2), plus(A, B2, C2).\n")
sb_push(background, "rule times(A, \"v:0\", \"v:0\").\n")
sb_push(background, "rule times(A, B, C) :- pred1(B, B2), plus(D, A, C), times(A, B2, D).\n")
let background_src = sb_str(background)

make a function called parity_flag takes n returns flag
  if (n % 2) == 0 then
    return "true"
  end
  return "false"
end

# VISIBLE: sum of evens 0..N for a few small N.
# N=4: 0+2+4=6. N=5: 0+2+4=6. N=3: 0+2=2.
let visible_queries = [
  synth4_query("target", "4", "6", parity_flag(4), true),
  synth4_query("target", "5", "6", parity_flag(5), true),
  synth4_query("target", "3", "2", parity_flag(3), true),
  synth4_query("target", "4", "5", parity_flag(4), false)
]

print("=== SEARCHING for sum-of-evens-up-to-N via toggle+conditional-accumulate ===")
let winner = synth4_induce_toggle_accumulator("target", ["pred1", "pred2"], ["plus", "times"], ["true", "false"], background_src, visible_queries)
print("winner: " + winner)

if to_num(list_len(winner)) == 3 then
  let chain_pred = winner[0]
  let combine_pred = winner[1]
  let start_flag = winner[2]
  let clause_src = synth4_clauses_for("target", chain_pred, combine_pred, start_flag)
  print("found clauses:")
  print(clause_src)

  print("=== BLIND held-back checks ===")
  let blind_queries = [
    synth4_query("target", "10", "30", parity_flag(10), true),
    synth4_query("target", "9", "20", parity_flag(9), true),
    synth4_query("target", "20", "110", parity_flag(20), true),
    synth4_query("target", "10", "31", parity_flag(10), false),
    synth4_query("target", "9", "30", parity_flag(9), false)
  ]
  let blind_results = synth4_diagnose_hypothesis(background_src, clause_src, blind_queries)
  let all_blind_ok = true
  let bi = 0
  while bi < to_num(list_len(blind_results)) do
    let q = blind_queries[bi]
    let matched = blind_results[bi]
    print("BLIND target(" + q[1] + "," + q[2] + "," + q[3] + ") expected=" + ("" + q[4]) + " matched=" + ("" + matched))
    if not matched then
      let all_blind_ok = false
    end
    let bi = bi + 1
  end

  if all_blind_ok then
    print("=== RESULT: sum-of-evens-up-to-N found by SEARCH, genuinely generalizes ===")
    print("=== SCOPE: this is sum-of-evens-UP-TO-N (integer accumulation), NOT the list-based sum_of_evens(xs) curriculum spec -- that gap (no list encoding in the relational engine) remains unclosed ===")
  else
    print("=== RESULT: hypothesis passed visible but FAILED blind checks -- vacuous ===")
  end
else
  print("=== RESULT: no candidate (chain,combine,start_flag) triple in the given search space fit the visible examples ===")
end
