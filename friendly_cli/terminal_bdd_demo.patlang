# BDD-style verification of friendly_cli/terminal.patlang, using the
# existing Gherkin runner in self_hosting/lib/test.patlang.
#
# terminal.patlang is a standalone process with a blocking stdin loop --
# tested here as a real black-box subprocess (via proc.patlang's
# run_classified, feeding it a scripted stdin session and checking the
# real captured transcript), not mocked. This is the same "run it for
# real, verify the actual transcript" discipline
# self_healing_engine.patlang's probe_shell_command already established
# for this codebase.

include "../self_hosting/lib/includes.patlang"
include "../self_hosting/lib/proc.patlang"
include "../self_hosting/lib/test.patlang"

make a function called tm_pat_exe returns path
  return "rust-runtime/target/release/pat.exe"
end

make a function called tm_scripted_session returns text
  return "help
status
heal-config
echo hello from embedded terminal
frobnicate
exit
"
end

# ---- step definitions ----

make a function called st_tm_scripted_session_run returns done
  let out = exec_capture_io(tm_pat_exe(), ["--ir-run", "friendly_cli/terminal.patlang"], tm_scripted_session())
  set_var("tm_stdout", out[0])
  return true
end

make a function called st_tm_help_shown returns done
  check("help lists the built-in commands", contains_text(get("__vars", "tm_stdout"), "Built-in commands:"), true)
  return true
end

make a function called st_tm_status_shown returns done
  check("status reports self-healing as not configured by default", contains_text(get("__vars", "tm_stdout"), "self-healing hand-off: not configured"), true)
  return true
end

make a function called st_tm_heal_config_shown returns done
  check("heal-config explains the pluggable hand-off", contains_text(get("__vars", "tm_stdout"), "Self-healing hand-off is pluggable"), true)
  return true
end

make a function called st_tm_real_command_output_shown returns done
  check("a real shelled-out command's output reaches the terminal transcript", contains_text(get("__vars", "tm_stdout"), "hello from embedded terminal"), true)
  return true
end

# frobnicate isn't a built-in, so terminal.patlang's per-line dynamic
# dispatch (tm_dispatch_table_for) routes it to shell_ops_run just like
# any other typed word -- it's tried as a real external command first,
# and diagnosed as CommandNotFound (not a PatLang capability gap) when
# it isn't one. console.patlang's own "unknown command" phrasing is for
# an embedder with a FIXED dispatch_table and no such fallback -- proven
# separately in self_hosting/examples/console_bdd_demo.patlang.
make a function called st_tm_unknown_command_diagnosed returns done
  check("an unrecognized command is diagnosed by name, not crashed past", contains_text(get("__vars", "tm_stdout"), "'frobnicate' was not found on PATH"), true)
  return true
end

make a function called st_tm_exits_cleanly returns done
  check("the session exits cleanly after 'exit'", contains_text(get("__vars", "tm_stdout"), "goodbye."), true)
  return true
end

make a function called register_terminal_steps returns done
  step("a scripted terminal session covering built-ins, a real command, and an unknown command", "st_tm_scripted_session_run")
  step("help output appears in the transcript", "st_tm_help_shown")
  step("status output appears in the transcript", "st_tm_status_shown")
  step("heal-config output appears in the transcript", "st_tm_heal_config_shown")
  step("the echoed command's real output appears in the transcript", "st_tm_real_command_output_shown")
  step("the unknown command is diagnosed in the transcript", "st_tm_unknown_command_diagnosed")
  step("the session exits cleanly", "st_tm_exits_cleanly")
  return true
end

make a function called terminal_feature returns text
  return "Feature: friendly_cli terminal, run as a real subprocess

Scenario: a scripted session exercises built-ins, a real command, and an unknown one
  Given a scripted terminal session covering built-ins, a real command, and an unknown command
  Then help output appears in the transcript
  And status output appears in the transcript
  And heal-config output appears in the transcript
  And the echoed command's real output appears in the transcript
  And the unknown command is diagnosed in the transcript
  And the session exits cleanly
"
end

make a function called run_terminal_bdd returns ok
  t_init()
  register_terminal_steps()
  run_feature(terminal_feature())
  t_report()
  return get("__vars", "t_fail") == 0
end

run_terminal_bdd()
