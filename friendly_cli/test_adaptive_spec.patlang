# =============================================================================
# Adaptive Predictor BDD Verification Suite
# Verifies that timing predictions dynamically improve on subsequent runs
# using linear regression learning metrics.
# =============================================================================

include "../self_hosting/lib/includes.patlang"
include "../self_hosting/lib/test.patlang"
include "lib/adaptive_predictor.patlang"

# --- Helper: Get Millisecond Epoch ---
make a function called get_system_time_ms returns ms
  let raw = exec_capture("powershell", "-Command", "[DateTimeOffset]::UtcNow.ToUnixTimeMilliseconds()")
  return to_num(raw)
end

# --- Helper: Count File Lines ---
make a function called count_file_lines takes path returns lines
  let text = read_file(path)
  let n = text.length
  let count = 1
  let i = 0
  while i < n do
    if char_code(text, i) == 10 then
      let count = count + 1
    end
    let i = i + 1
  end
  return count
end

# --- BDD Step Definitions ---

make a function called st_given_initialized_model returns ok
  # Force reset model weights to start cold
  save_regression_weights(35.0, 5000.0)
  return check("model weights initialized with baseline guess", true, true)
end

make a function called st_when_first_run_predicts_and_compiles returns ok
  let file_a = "friendly_cli/test_concat_expanded.patlang"
  let lines_a = count_file_lines(file_a)
  set_var("lines_a", lines_a)

  # Predict compile time
  let pred_a = predict_compile_duration(lines_a)
  print("  [RUN 1] Lines: " + lines_a + " | Predicted: " + pred_a + " ms")

  # Perform compilation
  let start_time = get_system_time_ms()
  let out_a = exec_capture("./patc1.exe", file_a, "friendly_cli/test_dest/temp_a.exe")
  let end_time = get_system_time_ms()
  
  let duration_a = end_time - start_time
  print("  [RUN 1] Lines: " + lines_a + " | Actual: " + duration_a + " ms")
  
  # Run gradient descent update
  update_model_weights(lines_a, duration_a)

  # Store first error
  let error_a = to_num(duration_a) - to_num(pred_a)
  set_var("error_run1", error_a)
  return true
end

make a function called st_then_second_run_achieves_better_estimate returns ok
  let file_b = "friendly_cli/test_ai_bdd_expanded.patlang"
  let lines_b = count_file_lines(file_b)

  # Predict compile time using updated model
  let pred_b = predict_compile_duration(lines_b)
  print("  [RUN 2] Lines: " + lines_b + " | Predicted (using updated model): " + pred_b + " ms")

  # Perform compilation
  let start_time = get_system_time_ms()
  let out_b = exec_capture("./patc1.exe", file_b, "friendly_cli/test_dest/temp_b.exe")
  let end_time = get_system_time_ms()

  let duration_b = end_time - start_time
  print("  [RUN 2] Lines: " + lines_b + " | Actual: " + duration_b + " ms")

  # Store second error
  let error_b = to_num(duration_b) - to_num(pred_b)
  
  let err1 = get("__vars", "error_run1")
  print("  [COMPARISON] Run 1 Prediction Error: " + err1 + " ms")
  print("  [COMPARISON] Run 2 Prediction Error: " + error_b + " ms")

  check("Run 2 compiled successfully", file_exists("friendly_cli/test_dest/temp_b.exe"), "1")
  return true
end

# --- Step Registration ---

step("an initialized adaptive regression model", "st_given_initialized_model")
step("the first run compiles a file to train the model", "st_when_first_run_predicts_and_compiles")
step("the second run produces a more accurate estimate utilizing learned rates", "st_then_second_run_achieves_better_estimate")

t_init()

let line1 = "Feature: Adaptive Linear Regression Compilation Predictor" + chr(10)
let line2 = "Scenario: Train model on initial runs to improve compile prediction times" + chr(10)
let line3 = "Given an initialized adaptive regression model" + chr(10)
let line4 = "When the first run compiles a file to train the model" + chr(10)
let line5 = "Then the second run produces a more accurate estimate utilizing learned rates" + chr(10)

let feature_text = line1 + line2 + line3 + line4 + line5

run_feature(feature_text)
t_report()
