step("a local running Ollama AI instance with tinyllama", "st_given_local_ollama")
step("the user requests an AI opinion on doc1.md", "st_when_get_ai_opinion_on_file")
step("the AI opinion is saved to doc1_opinion.txt with verified contracts", "st_then_ai_opinion_file_created")
