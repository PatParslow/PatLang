# =============================================================================
# Ollama AI BDD Verification Suite
# Verifies Gherkin BDD scenarios for local Ollama AI query interop,
# including safe document parsing and DbC contract enforcement.
# =============================================================================

include "../self_hosting/lib/includes.patlang"
include "../self_hosting/lib/regex_dsl.patlang"
include "../self_hosting/lib/syntax_dsl.patlang"
include "../self_hosting/lib/test.patlang"
include "lib/actions.patlang"
include "lib/ai_engine.patlang"

# --- Step Definitions ---

make a function called st_given_local_ollama returns ok
  # Assert starting environment
  let md_exists = file_exists("friendly_cli/test_src/doc1.md")
  return check("sample markdown doc1.md exists on disk", md_exists, "1")
end

make a function called st_when_get_ai_opinion_on_file returns ok
  # Dynamic execution of AI opinion function
  let success = get_file_ai_opinion("friendly_cli/test_src/doc1.md", "friendly_cli/test_dest/doc1_opinion.txt")
  set_var("ai_opinion_success", success)
  return check("AI opinion retrieval successfully triggered", success, true)
end

make a function called st_then_ai_opinion_file_created returns ok
  let opinion_exists = file_exists("friendly_cli/test_dest/doc1_opinion.txt")
  check("doc1_opinion.txt exists on disk", opinion_exists, "1")
  
  let content = read_file("friendly_cli/test_dest/doc1_opinion.txt")
  print("=== AI RESPONSE PREVIEW ===")
  print(content)
  return check("AI response contains non-empty content", content.length > 0, true)
end

make a function called st_when_ask_ai_general_prompt returns ok
  let success = query_ollama_ai_opinion("Why is markdown good for documentation?", "friendly_cli/test_dest/q_opinion.txt")
  set_var("general_opinion_success", success)
  return check("general prompt successfully triggered", success, true)
end

make a function called st_then_general_opinion_file_created returns ok
  let opinion_exists = file_exists("friendly_cli/test_dest/q_opinion.txt")
  check("q_opinion.txt exists on disk", opinion_exists, "1")
  
  let content = read_file("friendly_cli/test_dest/q_opinion.txt")
  print("=== AI RESPONSE PREVIEW ===")
  print(content)
  return check("AI response contains non-empty content", content.length > 0, true)
end

# --- Step Registration ---

step("a local running Ollama AI instance with tinyllama", "st_given_local_ollama")
step("the user requests an AI opinion on doc1.md", "st_when_get_ai_opinion_on_file")
step("the AI opinion is saved to doc1_opinion.txt with verified contracts", "st_then_ai_opinion_file_created")
step("the user asks a general prompt to the AI", "st_when_ask_ai_general_prompt")
step("the general AI response is saved to q_opinion.txt with verified contracts", "st_then_general_opinion_file_created")

t_init()

let line1 = "Feature: Local Ollama AI Integration with Design-by-Contract" + chr(10)
let line2 = "Scenario: Retrieve AI opinion on markdown document" + chr(10)
let line3 = "Given a local running Ollama AI instance with tinyllama" + chr(10)
let line4 = "When the user requests an AI opinion on doc1.md" + chr(10)
let line5 = "Then the AI opinion is saved to doc1_opinion.txt with verified contracts" + chr(10)
let line6 = "Scenario: Ask general prompt query to AI" + chr(10)
let line7 = "Given a local running Ollama AI instance with tinyllama" + chr(10)
let line8 = "When the user asks a general prompt to the AI" + chr(10)
let line9 = "Then the general AI response is saved to q_opinion.txt with verified contracts" + chr(10)

let feature_text = line1 + line2 + line3 + line4 + line5 + line6 + line7 + line8 + line9

run_feature(feature_text)
t_report()
