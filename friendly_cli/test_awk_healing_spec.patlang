# =============================================================================
# Self-Healing BDD Driver for Awk Word Count Extraction
# Goal: Synthesize a function to count words using awk
# =============================================================================

include "../self_hosting/lib/includes.patlang"
include "../self_hosting/lib/includes.patlang"
include "../self_hosting/lib/gherkin.patlang"
include "lib/self_healing_engine.patlang"

# --- Step Definitions ---

make a function called st_given_missing_word_count_function takes ctx returns ok
  print("[BDD TEST] Simulating runtime missing function: count_words_awk...")
  return expect(ctx, "missing function trigger initialized", true, true)
end

make a function called st_when_awk_healing_triggered takes ctx returns ok
  # Verify the test file exists
  let file_ok = file_exists("friendly_cli/test_src/doc1.md") == true
  expect(ctx, "test file doc1.md exists", file_ok, true)
  
  # Run the self-healing engine to generate count_words_awk. 
  # Note: expected output for doc1.md ("# Dummy test file 1 \n Markdown sample document...") is 9 words.
  let healed = heal_missing_function(ctx, "count_words_awk", "hermes", "", "friendly_cli/test_src/doc1.md", "friendly_cli/test_src/doc1.md", "9")
  return expect(ctx, "self-healing engine synthesized awk wrapper (RED-GREEN complete)", healed, true)
end

make a function called st_then_awk_function_exists takes ctx returns ok
  # Verify the synthesized function exists
  let file_ok = file_exists("friendly_cli/lib/synthesized_tools.patlang") == true
  expect(ctx, "synthesized_tools.patlang written to disk", file_ok, true)
  
  let spec_ok = file_exists("friendly_cli/test_healing_spec.patlang") == true
  expect(ctx, "test_healing_spec.patlang written to disk", spec_ok, true)
  
  let expanded_ok = file_exists("friendly_cli/test_healing_expanded.patlang") == true
  expect(ctx, "test_healing_expanded.patlang exists", expanded_ok, true)
  
  let exe_ok = file_exists("friendly_cli/test_healing_expanded.exe") == true
  expect(ctx, "test_healing_expanded.exe compiled successfully", exe_ok, true)
  
  return true
end

# --- Step Registration ---

let ctx = ctx_new()
step(ctx, "a missing word count function", "st_given_missing_word_count_function")
step(ctx, "the self-healing engine synthesizes the word count function using awk", "st_when_awk_healing_triggered")
step(ctx, "the synthesized awk tool, spec, and compiled binary are saved and verified", "st_then_awk_function_exists")



let line1 = "Feature: Awk Word Count Self-Healing" + chr(10)
let line2 = "Scenario: Synthesize word count function using awk" + chr(10)
let line3 = "Given a missing word count function" + chr(10)
let line4 = "When the self-healing engine synthesizes the word count function using awk" + chr(10)
let line5 = "Then the synthesized awk tool, spec, and compiled binary are saved and verified" + chr(10)

let feature_text = line1 + line2 + line3 + line4 + line5

run_feature(ctx, feature_text)
ctx_report(ctx)
