include "../self_hosting/lib/includes.patlang"
include "../self_hosting/lib/test.patlang"
include "lib/actions.patlang"

# --- Step Definitions ---

make a function called st_given_source_folder returns ok
  # Verify test_src exists and contains files
  let files = list_dir("friendly_cli/test_src")
  check("source directory test_src exists and contains files", files.length > 0, true)
  return true
end

make a function called st_given_destination_folder returns ok
  let files = list_dir("friendly_cli/test_dest")
  check("destination directory test_dest exists", files.length > 0, true)
  return true
end

make a function called st_when_convert_markdown returns ok
  # Execute batch conversion action as expanded from macro
  let count = batch_convert_files("md", "friendly_cli/test_src", "docx")
  set_var("converted_count", count)
  return true
end

make a function called st_then_markdown_converted returns ok
  let count = get("__vars", "converted_count")
  check("two markdown files were converted", count, 2)
  return true
end

make a function called st_when_copy_txt returns ok
  let count = batch_copy_files("txt", "friendly_cli/test_src", "friendly_cli/test_dest")
  set_var("copied_count", count)
  return true
end

make a function called st_then_txt_copied returns ok
  let count = get("__vars", "copied_count")
  check("one text file was copied to test_dest", count, 1)
  return true
end

make a function called st_when_delete_tmp returns ok
  let count = batch_delete_files("tmp", "friendly_cli/test_src")
  set_var("deleted_count", count)
  return true
end

make a function called st_then_tmp_deleted returns ok
  let count = get("__vars", "deleted_count")
  check("one temporary file was deleted", count, 1)
  return true
end

# --- Step Registration ---

make a function called register_cli_steps returns done
  step("a source directory test_src with files", "st_given_source_folder")
  step("a destination directory test_dest", "st_given_destination_folder")
  step("the user requests to convert all md files in test_src to docx", "st_when_convert_markdown")
  step("all markdown files in test_src are processed into docx format", "st_then_markdown_converted")
  step("the user requests to copy all txt files in test_src to test_dest", "st_when_copy_txt")
  step("all txt files are copied to the destination directory", "st_then_txt_copied")
  step("the user requests to delete all tmp files in test_src", "st_when_delete_tmp")
  step("all tmp files in test_src are removed", "st_then_tmp_deleted")
  return true
end

# --- Gherkin Feature Specification ---

make a function called cli_feature_spec returns spec
  let line1 = "Feature: Friendly CLI Natural Language File Operations" + chr(10)
  let line2 = "Scenario: Convert markdown documents using natural DSL rule" + chr(10)
  let line3 = "  Given a source directory test_src with files" + chr(10)
  let line4 = "  When the user requests to convert all md files in test_src to docx" + chr(10)
  let line5 = "  Then all markdown files in test_src are processed into docx format" + chr(10)
  let line6 = "Scenario: Copy text files to a destination directory" + chr(10)
  let line7 = "  Given a source directory test_src with files" + chr(10)
  let line8 = "  And a destination directory test_dest" + chr(10)
  let line9 = "  When the user requests to copy all txt files in test_src to test_dest" + chr(10)
  let line10 = "  Then all txt files are copied to the destination directory" + chr(10)
  let line11 = "Scenario: Delete temporary files using natural DSL rule" + chr(10)
  let line12 = "  Given a source directory test_src with files" + chr(10)
  let line13 = "  When the user requests to delete all tmp files in test_src" + chr(10)
  let line14 = "  Then all tmp files in test_src are removed" + chr(10)
  return line1 + line2 + line3 + line4 + line5 + line6 + line7 + line8 + line9 + line10 + line11 + line12 + line13 + line14
end

# --- Test Suite Runner ---

make a function called run_friendly_cli_bdd returns ok
  t_init()
  register_cli_steps()
  run_feature(cli_feature_spec())
  t_report()
  return get("__vars", "t_fail") == 0
end

run_friendly_cli_bdd()
