# =============================================================================
# Friendly CLI BDD Verification Spec
# Uses PatLang's native Gherkin BDD framework (lib/test.patlang) to test
# natural syntax macro expansion and batch file operations.
# =============================================================================

include "../self_hosting/lib/includes.patlang"
include "../self_hosting/lib/gherkin.patlang"
include "lib/actions.patlang"

# --- Step Definitions ---

make a function called st_given_source_folder takes ctx returns ok
  let files = list_dir("friendly_cli/test_src")
  return expect(ctx, "source directory test_src exists and contains files", files.length > 0, true)
end

make a function called st_given_destination_folder takes ctx returns ok
  let files = list_dir("friendly_cli/test_dest")
  return expect(ctx, "destination directory test_dest exists", files.length > 0, true)
end

make a function called st_when_convert_markdown takes ctx returns ok
  let count = batch_convert_files("md", "friendly_cli/test_src", "docx")
  ctx_set(ctx, "converted_count", count)
  return true
end

make a function called st_then_markdown_converted takes ctx returns ok
  let count = ctx_get(ctx, "converted_count")
  return expect(ctx, "two markdown files were converted", count, 2)
end

make a function called st_when_copy_txt takes ctx returns ok
  let count = batch_copy_files("txt", "friendly_cli/test_src", "friendly_cli/test_dest")
  ctx_set(ctx, "copied_count", count)
  return true
end

make a function called st_then_txt_copied takes ctx returns ok
  let count = ctx_get(ctx, "copied_count")
  return expect(ctx, "one text file was copied to test_dest", count, 1)
end

make a function called st_when_delete_tmp takes ctx returns ok
  let count = batch_delete_files("tmp", "friendly_cli/test_src")
  ctx_set(ctx, "deleted_count", count)
  return true
end

make a function called st_then_tmp_deleted takes ctx returns ok
  let count = ctx_get(ctx, "deleted_count")
  return expect(ctx, "one temporary file was deleted", count, 1)
end

# --- Step Registration ---

let ctx = ctx_new()
step(ctx, "a source directory test_src with files", "st_given_source_folder")
step(ctx, "a destination directory test_dest", "st_given_destination_folder")
step(ctx, "the user requests to convert all md files in test_src to docx", "st_when_convert_markdown")
step(ctx, "all markdown files in test_src are processed into docx format", "st_then_markdown_converted")
step(ctx, "the user requests to copy all txt files in test_src to test_dest", "st_when_copy_txt")
step(ctx, "all txt files are copied to the destination directory", "st_then_txt_copied")
step(ctx, "the user requests to delete all tmp files in test_src", "st_when_delete_tmp")
step(ctx, "all tmp files in test_src are removed", "st_then_tmp_deleted")



let feature_text = "Feature: Friendly CLI Natural Language File Operations" + chr(10) + "Scenario: Convert markdown documents using natural DSL rule" + chr(10) + "Given a source directory test_src with files" + chr(10) + "When the user requests to convert all md files in test_src to docx" + chr(10) + "Then all markdown files in test_src are processed into docx format" + chr(10) + "Scenario: Copy text files to a destination directory" + chr(10) + "Given a source directory test_src with files" + chr(10) + "And a destination directory test_dest" + chr(10) + "When the user requests to copy all txt files in test_src to test_dest" + chr(10) + "Then all txt files are copied to the destination directory" + chr(10) + "Scenario: Delete temporary files using natural DSL rule" + chr(10) + "Given a source directory test_src with files" + chr(10) + "When the user requests to delete all tmp files in test_src" + chr(10) + "Then all tmp files in test_src are removed" + chr(10)

run_feature(ctx, feature_text)
ctx_report(ctx)
