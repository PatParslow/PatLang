# =============================================================================
# Friendly CLI BDD Verification Spec
# Uses PatLang's native Gherkin BDD framework (lib/test.patlang) to test
# natural syntax macro expansion and batch file operations.
# =============================================================================

include "../self_hosting/lib/test.patlang"
include "lib/actions.patlang"

# --- Step Definitions ---

make a function called st_given_source_folder returns ok
  let files = list_dir("friendly_cli/test_src")
  return check("source directory test_src exists and contains files", files.length > 0, true)
end

make a function called st_given_destination_folder returns ok
  let files = list_dir("friendly_cli/test_dest")
  return check("destination directory test_dest exists", files.length > 0, true)
end

make a function called st_when_convert_markdown returns ok
  let count = batch_convert_files("md", "friendly_cli/test_src", "docx")
  set_var("converted_count", count)
  return true
end

make a function called st_then_markdown_converted returns ok
  let count = get("__vars", "converted_count")
  return check("two markdown files were converted", count, 2)
end

make a function called st_when_copy_txt returns ok
  let count = batch_copy_files("txt", "friendly_cli/test_src", "friendly_cli/test_dest")
  set_var("copied_count", count)
  return true
end

make a function called st_then_txt_copied returns ok
  let count = get("__vars", "copied_count")
  return check("one text file was copied to test_dest", count, 1)
end

make a function called st_when_delete_tmp returns ok
  let count = batch_delete_files("tmp", "friendly_cli/test_src")
  set_var("deleted_count", count)
  return true
end

make a function called st_then_tmp_deleted returns ok
  let count = get("__vars", "deleted_count")
  return check("one temporary file was deleted", count, 1)
end

# --- Step Registration ---

step("a source directory test_src with files", "st_given_source_folder")
step("a destination directory test_dest", "st_given_destination_folder")
step("the user requests to convert all md files in test_src to docx", "st_when_convert_markdown")
step("all markdown files in test_src are processed into docx format", "st_then_markdown_converted")
step("the user requests to copy all txt files in test_src to test_dest", "st_when_copy_txt")
step("all txt files are copied to the destination directory", "st_then_txt_copied")
step("the user requests to delete all tmp files in test_src", "st_when_delete_tmp")
step("all tmp files in test_src are removed", "st_then_tmp_deleted")

t_init()

let feature_text = "Feature: Friendly CLI Natural Language File Operations" + chr(10) + "Scenario: Convert markdown documents using natural DSL rule" + chr(10) + "Given a source directory test_src with files" + chr(10) + "When the user requests to convert all md files in test_src to docx" + chr(10) + "Then all markdown files in test_src are processed into docx format" + chr(10) + "Scenario: Copy text files to a destination directory" + chr(10) + "Given a source directory test_src with files" + chr(10) + "And a destination directory test_dest" + chr(10) + "When the user requests to copy all txt files in test_src to test_dest" + chr(10) + "Then all txt files are copied to the destination directory" + chr(10) + "Scenario: Delete temporary files using natural DSL rule" + chr(10) + "Given a source directory test_src with files" + chr(10) + "When the user requests to delete all tmp files in test_src" + chr(10) + "Then all tmp files in test_src are removed" + chr(10)

run_feature(feature_text)
t_report()
