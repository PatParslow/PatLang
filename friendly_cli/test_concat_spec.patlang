# =============================================================================
# BDD Spec for File Concatenation & Synthesized Size Match Verification
# =============================================================================

include "../self_hosting/lib/includes.patlang"
include "../self_hosting/lib/test.patlang"
include "lib/synthesized_tools.patlang"

# --- Step Definitions ---

make a function called st_given_two_markdown_files returns ok
  let file1 = "friendly_cli/test_src/doc1.md"
  let file2 = "friendly_cli/test_src/doc2.md"
  check("file1 exists", file_exists(file1), "1")
  return check("file2 exists", file_exists(file2), "1")
end

make a function called st_when_sizes_measured_and_files_joined returns ok
  let file1 = "friendly_cli/test_src/doc1.md"
  let file2 = "friendly_cli/test_src/doc2.md"
  let joined = "friendly_cli/test_dest/joined.md"

  # Measure initial file sizes using our synthesized get_file_size_synthesized
  let size1 = get_file_size_synthesized(file1)
  let size2 = get_file_size_synthesized(file2)
  set_var("size1", size1)
  set_var("size2", size2)

  # Concatenate files cleanly (ensuring separator newline to match combined size)
  let content1 = read_file(file1)
  let content2 = read_file(file2)
  let joined_content = content1 + content2
  write_file(joined, joined_content)

  # Measure joined file size
  let size_joined = get_file_size_synthesized(joined)
  set_var("size_joined", size_joined)
  
  return check("joined file exists on disk", file_exists(joined), "1")
end

make a function called st_then_joined_size_matches_sum returns ok
  let size1 = get("__vars", "size1")
  let size2 = get("__vars", "size2")
  let size_joined = get("__vars", "size_joined")

  let sum = size1 + size2
  print("  [VERIFICATION] Size 1: " + size1 + " bytes")
  print("  [VERIFICATION] Size 2: " + size2 + " bytes")
  print("  [VERIFICATION] Combined Sum: " + sum + " bytes")
  print("  [VERIFICATION] Measured Joined Size: " + size_joined + " bytes")

  return check("measured joined size matches sum of parts", size_joined, sum)
end

# --- Step Registration ---

step("two markdown files exist on disk", "st_given_two_markdown_files")
step("their sizes are measured and they are concatenated into a joined file", "st_when_sizes_measured_and_files_joined")
step("the measured size of the joined file matches the sum of the individual sizes", "st_then_joined_size_matches_sum")

t_init()

let line1 = "Feature: File Size Concatenation Match Verification" + chr(10)
let line2 = "Scenario: Measure and concatenate two files and verify combined length" + chr(10)
let line3 = "Given two markdown files exist on disk" + chr(10)
let line4 = "When their sizes are measured and they are concatenated into a joined file" + chr(10)
let line5 = "Then the measured size of the joined file matches the sum of the individual sizes" + chr(10)

let feature_text = line1 + line2 + line3 + line4 + line5

run_feature(feature_text)
t_report()
