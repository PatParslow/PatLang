# =============================================================================
# Dynamic Tool Discovery & Contract BDD Verification Suite
# Verifies system tool discovery, contract wrapping, and GOAP auto-chaining.
# =============================================================================

include "../self_hosting/lib/includes.patlang"
include "../self_hosting/lib/includes.patlang"
include "../self_hosting/lib/gherkin.patlang"
include "lib/actions.patlang"
include "lib/tool_discovery.patlang"

# --- Step Definitions ---

make a function called st_given_discovery_engine takes ctx returns ok
  let count = auto_discover_and_register_tools()
  return expect(ctx, "discovered native CLI tools on system PATH", count > 0, true)
end

make a function called st_when_user_requests_dynamic_goal takes ctx returns ok
  # Assert starting facts
  rule_add("has_md", ["docs"], [])

  # Request goal that requires chaining discovered tools: md -> docx -> zip
  print("[REASONING ENGINE] Solving GOAP plan using dynamically wrapped native tools...")
  let planned_steps = plan([["archived", ["backup.zip"]]])
  
  print("[REASONING ENGINE] Plan computed with " + list_len(planned_steps) + " step(s):")
  let i = 0
  let n = to_num(list_len(planned_steps))
  while i < n do
    print("  " + (i + 1) + ". " + planned_steps[i])
    let i = i + 1
  end

  ctx_set(ctx, "discovery_plan", planned_steps)
  return true
end

make a function called st_then_native_tools_execute_safely takes ctx returns ok
  let planned_steps = ctx_get(ctx, "discovery_plan")
  let success = activate planned_steps
  expect(ctx, "GOAP engine successfully executed dynamic native tool chain", success, true)

  let zip_exists = file_exists("friendly_cli/test_dest/discovered_backup.zip")
  return expect(ctx, "contract-protected native zip archive created", zip_exists, "1")
end

# --- Step Registration ---

let ctx = ctx_new()
step(ctx, "a tool discovery engine scanning system PATH", "st_given_discovery_engine")
step(ctx, "a user specifies a goal requiring discovered system tools", "st_when_user_requests_dynamic_goal")
step(ctx, "contract-protected native tools execute at full speed and achieve the goal", "st_then_native_tools_execute_safely")



let line1 = "Feature: Dynamic System Tool Discovery and Contract Wrapping" + chr(10)
let line2 = "Scenario: Discover native CLI tools on PATH and solve goal safely" + chr(10)
let line3 = "Given a tool discovery engine scanning system PATH" + chr(10)
let line4 = "When a user specifies a goal requiring discovered system tools" + chr(10)
let line5 = "Then contract-protected native tools execute at full speed and achieve the goal" + chr(10)

let feature_text = line1 + line2 + line3 + line4 + line5

run_feature(ctx, feature_text)
ctx_report(ctx)
