# =============================================================================
# Friendly CLI Expansion & Test Script
# Loads the syntax DSL preprocessor and expands novice commands in friendly_cli.
# =============================================================================

include "lib/lexer.patlang"
include "lib/parser.patlang"
include "lib/lower.patlang"

let engine_src       = read_file("self_hosting/lib/regex_dsl.patlang")
let preprocessor_src = read_file("self_hosting/lib/syntax_dsl.patlang")
let dsl_pack_src     = read_file("friendly_cli/dsl/file_ops.patlang")
let novice_code      = read_file("friendly_cli/novice_script.patlang")

let driver = engine_src + chr(10) + preprocessor_src + chr(10)
  + "let dsl_src = read_file(\"friendly_cli/dsl/file_ops.patlang\")" + chr(10)
  + "let nov_src = read_file(\"friendly_cli/novice_script.patlang\")" + chr(10)
  + "let res1 = expand_syntax_dsls_with(dsl_src, [])" + chr(10)
  + "let defs = res1[1]" + chr(10)
  + "let res2 = expand_syntax_dsls_with(nov_src, defs)" + chr(10)
  + "print(\"=== EXPANDED PATLANG CODE ===\")" + chr(10)
  + "print(res2[0])" + chr(10)

let toks = tokenize(driver)
let ast = parse_program(toks)
let stmts = ast[1]
let i = 0
let errs = 0
while i < stmts.length do
  let s = stmts[i]
  if s[0] == "Err" then
    print("parse error: " + s[1])
    let errs = errs + 1
  end
  let i = i + 1
end

if errs == 0 then
  let ir = lower_program(ast)
  run_ir(ir)
end
