# =============================================================================
# Self-Healing BDD Driver for File Size Function
# Goal: Synthesize a function to get file size
# =============================================================================

include "../self_hosting/lib/includes.patlang"
include "../self_hosting/lib/includes.patlang"
include "../self_hosting/lib/gherkin.patlang"
include "lib/self_healing_engine.patlang"

# --- Step Definitions ---

make a function called st_given_missing_file_size_function takes ctx returns ok
  print("[BDD TEST] Simulating runtime missing function: file_size...")
  return expect(ctx, "missing function trigger initialized", true, true)
end

make a function called st_when_self_healing_triggered takes ctx returns ok
  # Verify the test file exists
  let file_ok = file_exists("friendly_cli/test_src/doc1.md") == true
  expect(ctx, "test file doc1.md exists", file_ok, true)
  
  # Run the self-healing engine
  let healed = heal_missing_function(ctx, "file_size", "hermes", "", "friendly_cli/test_src/doc1.md", "friendly_cli/test_src/doc1.md", "70")
  return expect(ctx, "self-healing engine synthesized wrapper (RED-GREEN complete)", healed, true)
end

make a function called st_then_function_exists takes ctx returns ok
  # Verify the synthesized function exists
  let file_ok = file_exists("friendly_cli/lib/synthesized_tools.patlang") == true
  expect(ctx, "synthesized_tools.patlang written to disk", file_ok, true)
  
  let spec_ok = file_exists("friendly_cli/test_healing_spec.patlang") == true
  expect(ctx, "test_healing_spec.patlang written to disk", spec_ok, true)
  
  let expanded_ok = file_exists("friendly_cli/test_healing_expanded.patlang") == true
  expect(ctx, "test_healing_expanded.patlang exists (includes expanded)", expanded_ok, true)
  
  let exe_ok = file_exists("friendly_cli/test_healing_expanded.exe") == true
  expect(ctx, "test_healing_expanded.exe compiled successfully", exe_ok, true)
  
  return true
end

# --- Step Registration ---

let ctx = ctx_new()
step(ctx, "a missing file_size function", "st_given_missing_file_size_function")
step(ctx, "the self-healing engine synthesizes the file_size function", "st_when_self_healing_triggered")
step(ctx, "the synthesized tool, expanded spec, and compiled executable are saved and verified", "st_then_function_exists")



let line1 = "Feature: File Size Self-Healing" + chr(10)
let line2 = "Scenario: Synthesize file_size function" + chr(10)
let line3 = "Given a missing file_size function" + chr(10)
let line4 = "When the self-healing engine synthesizes the file_size function" + chr(10)
let line5 = "Then the synthesized tool, expanded spec, and compiled executable are saved and verified" + chr(10)

let feature_text = line1 + line2 + line3 + line4 + line5

run_feature(ctx, feature_text)
ctx_report(ctx)