# =============================================================================
# Self-Healing BDD Driver & Verification Suite
# Triggers self-healing synthesis for `file_size`, builds BDD spec,
# compiles with patc1.exe, and verifies clean execution.
#
# Verifies RED-GREEN-REFACTOR:
#   RED:   BDD spec written first, implementation does not exist yet.
#   GREEN: Implementation written, BDD spec compiled and all tests pass.
# =============================================================================

include "../self_hosting/lib/includes.patlang"
include "../self_hosting/lib/test.patlang"
include "lib/actions.patlang"
include "lib/self_healing_engine.patlang"

# --- Step Definitions ---

make a function called st_given_missing_function returns ok
  print("[BDD TEST] Simulating runtime missing function event: 'file_size'...")
  return check("missing function trigger initialized", true, true)
end

make a function called st_when_self_healing_triggered returns ok
  let healed = heal_missing_function("file_size", "ollama", "tinyllama")
  return check("self-healing engine synthesized wrapper and BDD spec (RED-GREEN complete)", healed, true)
end

make a function called st_then_synthesized_tools_file_exists returns ok
  let file_ok = file_exists("friendly_cli/lib/synthesized_tools.patlang")
  check("synthesized_tools.patlang written to disk", file_ok, "1")

  let spec_ok = file_exists("friendly_cli/test_healing_spec.patlang")
  check("test_healing_spec.patlang written to disk", spec_ok, "1")

  # GREEN phase artifacts: expanded spec and compiled executable
  let expanded_ok = file_exists("friendly_cli/test_healing_expanded.patlang")
  check("GREEN: test_healing_expanded.patlang exists (includes expanded)", expanded_ok, "1")

  let exe_ok = file_exists("friendly_cli/test_healing_expanded.exe")
  check("GREEN: test_healing_expanded.exe compiled successfully", exe_ok, "1")

  return true
end

# --- Step Registration ---

step("a missing host function event for file_size", "st_given_missing_function")
step("the self-healing engine queries LLM and synthesizes code and BDD spec with RED-GREEN-REFACTOR", "st_when_self_healing_triggered")
step("the synthesized tool, expanded spec, and compiled executable are saved and verified", "st_then_synthesized_tools_file_exists")

t_init()

let line1 = "Feature: Self-Healing Host Function Code Synthesis (RED-GREEN-REFACTOR)" + chr(10)
let line2 = "Scenario: Synthesize missing file_size host function via LLM and DbC" + chr(10)
let line3 = "Given a missing host function event for file_size" + chr(10)
let line4 = "When the self-healing engine queries LLM and synthesizes code and BDD spec with RED-GREEN-REFACTOR" + chr(10)
let line5 = "Then the synthesized tool, expanded spec, and compiled executable are saved and verified" + chr(10)

let feature_text = line1 + line2 + line3 + line4 + line5

run_feature(feature_text)
t_report()
