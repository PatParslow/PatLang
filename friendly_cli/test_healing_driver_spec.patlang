# =============================================================================
# Self-Healing BDD Driver for File Size Function
# Goal: Synthesize a function to get file size
# =============================================================================

include "../self_hosting/lib/includes.patlang"
include "../self_hosting/lib/test.patlang"
include "lib/self_healing_engine.patlang"

# --- Step Definitions ---

make a function called st_given_missing_file_size_function returns ok
  print("[BDD TEST] Simulating runtime missing function: file_size...")
  return check("missing function trigger initialized", true, true)
end

make a function called st_when_self_healing_triggered returns ok
  # Verify the test file exists
  let file_ok = file_exists("friendly_cli/test_src/doc1.md") == "1"
  check("test file doc1.md exists", file_ok, true)
  
  # Run the self-healing engine
  let healed = heal_missing_function("file_size", "hermes", "", "friendly_cli/test_src/doc1.md", "friendly_cli/test_src/doc1.md", "success")
  return check("self-healing engine synthesized wrapper (RED-GREEN complete)", healed, true)
end

make a function called st_then_function_exists returns ok
  # Verify the synthesized function exists
  let file_ok = file_exists("friendly_cli/lib/synthesized_tools.patlang") == "1"
  check("synthesized_tools.patlang written to disk", file_ok, true)
  
  let spec_ok = file_exists("friendly_cli/test_healing_spec.patlang") == "1"
  check("test_healing_spec.patlang written to disk", spec_ok, true)
  
  let expanded_ok = file_exists("friendly_cli/test_healing_expanded.patlang") == "1"
  check("test_healing_expanded.patlang exists (includes expanded)", expanded_ok, true)
  
  let exe_ok = file_exists("friendly_cli/test_healing_expanded.exe") == "1"
  check("test_healing_expanded.exe compiled successfully", exe_ok, true)
  
  return true
end

# --- Step Registration ---

step("a missing file_size function", "st_given_missing_file_size_function")
step("the self-healing engine synthesizes the file_size function", "st_when_self_healing_triggered")
step("the synthesized tool, expanded spec, and compiled executable are saved and verified", "st_then_function_exists")

t_init()

let line1 = "Feature: File Size Self-Healing" + chr(10)
let line2 = "Scenario: Synthesize file_size function" + chr(10)
let line3 = "Given a missing file_size function" + chr(10)
let line4 = "When the self-healing engine synthesizes the file_size function" + chr(10)
let line5 = "Then the synthesized tool, expanded spec, and compiled executable are saved and verified" + chr(10)

let feature_text = line1 + line2 + line3 + line4 + line5

run_feature(feature_text)
t_report()