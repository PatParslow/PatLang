make a function called get_file_extension takes file_path returns result
  print("  [SYNTHESIZED EXEC] get_file_extension...")
  let raw_out = exec_capture("powershell", "-Command", "(Get-Item '" + file_path + "').Extension
")
  let a = 0
  while (a < raw_out.length) and ((char_code(raw_out, a) == 32) or (char_code(raw_out, a) == 9) or (char_code(raw_out, a) == 13) or (char_code(raw_out, a) == 10)) do
    let a = a + 1
  end
  let z = raw_out.length
  while (z > a) and ((char_code(raw_out, z - 1) == 32) or (char_code(raw_out, z - 1) == 9) or (char_code(raw_out, z - 1) == 13) or (char_code(raw_out, z - 1) == 10)) do
    let z = z - 1
  end
  let trimmed = substr(raw_out, a, z - a)
  print("[CONTRACT PASS] Synthesized function get_file_extension returned: " + trimmed)
  return trimmed
end

