include "../self_hosting/lib/includes.patlang"
include "../self_hosting/lib/includes.patlang"
include "../self_hosting/lib/gherkin.patlang"
include "lib/synthesized_tools.patlang"

make a function called st_given_file takes ctx returns ok
  return expect(ctx, "target file exists", file_exists("friendly_cli/test_src/doc1.md"), "1")
end

make a function called st_when_synthesized_invoked takes ctx returns ok
  let res = line_count("friendly_cli/test_src/doc1.md")
  ctx_set(ctx, "synthesized_res", res)
  return expect(ctx, "synthesized function returned result", true, true)
end

make a function called st_then_contract_verified takes ctx returns ok
  let res = ctx_get(ctx, "synthesized_res")
  return expect(ctx, "postcondition verified", ("" + res) == "3", true)
end

let ctx = ctx_new()
step(ctx, "a target test file on disk", "st_given_file")
step(ctx, "the synthesized function is executed", "st_when_synthesized_invoked")
step(ctx, "the contract and output are verified", "st_then_contract_verified")


let feature_text = "Feature: Synthesized Function Verification\nScenario: Validate synthesized tool\nGiven a target test file on disk\nWhen the synthesized function is executed\nThen the contract and output are verified\n"
run_feature(ctx, feature_text)
ctx_report(ctx)
