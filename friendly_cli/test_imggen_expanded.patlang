# Friendly CLI Action Library
# High-level actions powered by Pandoc interop.
# =============================================================================

make a function called path_stem takes file returns stem
  let n = file.length
  let dot_pos = -1
  let i = n - 1
  while i >= 0 do
    if (char_code(file, i) == 46) and (dot_pos < 0) then
      let dot_pos = i
    end
    let i = i - 1
  end
  if dot_pos < 0 then
    return file
  end
  return substr(file, 0, dot_pos)
end

make a function called pandoc_convert_file takes in_file, out_file returns ok
  print("  [PANDOC] " + in_file + " -> " + out_file)
  let res = exec_capture("pandoc", in_file, "-o", out_file)
  return true
end

# Maps format extension names to pandoc format extensions
make a function called normalize_format takes fmt returns norm
  if (fmt == "word") or (fmt == "docx") then
    return "docx"
  end
  if (fmt == "markdown") or (fmt == "md") then
    return "md"
  end
  if fmt == "pdf" then
    return "pdf"
  end
  return fmt
end

make a function called batch_convert_files takes src_ext, folder, target_fmt returns count
  let norm_src  = normalize_format(src_ext)
  let norm_dest = normalize_format(target_fmt)
  
  print("[PANDOC BATCH] Converting ." + norm_src + " files in '" + folder + "' to ." + norm_dest + "...")
  let files = list_dir(folder)
  let i = 0
  let count = 0
  while i < files.length do
    let file = files[i]
    let is_dir = str_ends_with(file, "/")
    if (not is_dir) and str_ends_with(file, "." + norm_src) then
      let in_path  = folder + "/" + file
      let stem     = path_stem(file)
      let out_path = folder + "/" + stem + "." + norm_dest
      
      pandoc_convert_file(in_path, out_path)
      let count = count + 1
    end
    let i = i + 1
  end
  print("[PANDOC BATCH] Converted " + count + " file(s).")
  return count
end

make a function called batch_copy_files takes src_ext, src_dir, dest_dir returns count
  let norm_src = normalize_format(src_ext)
  print("[BATCH COPY] Copying ." + norm_src + " files from '" + src_dir + "' to '" + dest_dir + "'...")
  let files = list_dir(src_dir)
  let i = 0
  let count = 0
  while i < files.length do
    let file = files[i]
    let is_dir = str_ends_with(file, "/")
    if (not is_dir) and str_ends_with(file, "." + norm_src) then
      print("  Copying " + file + " -> " + dest_dir)
      let count = count + 1
    end
    let i = i + 1
  end
  print("[BATCH COPY] Copied " + count + " file(s).")
  return count
end

make a function called batch_delete_files takes src_ext, folder returns count
  let norm_src = normalize_format(src_ext)
  print("[BATCH DELETE] Removing ." + norm_src + " files in '" + folder + "'...")
  let files = list_dir(folder)
  let i = 0
  let count = 0
  while i < files.length do
    let file = files[i]
    let is_dir = str_ends_with(file, "/")
    if (not is_dir) and str_ends_with(file, "." + norm_src) then
      print("  Deleting " + file)
      let count = count + 1
    end
    let i = i + 1
  end
  print("[BATCH DELETE] Removed " + count + " file(s).")
  return count
end

