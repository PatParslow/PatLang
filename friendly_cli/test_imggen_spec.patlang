# =============================================================================
# Image Generation Skill BDD Verification Suite
# Verifies Gherkin BDD scenarios for image generation tool interop,
# including prompt passing, python execution, and DbC contract enforcement.
# =============================================================================

include "../self_hosting/lib/includes.patlang"
include "../self_hosting/lib/regex_dsl.patlang"
include "../self_hosting/lib/syntax_dsl.patlang"
include "../self_hosting/lib/includes.patlang"
include "../self_hosting/lib/gherkin.patlang"
include "lib/actions.patlang"
include "lib/imggen_engine.patlang"

# --- Step Definitions ---

make a function called st_given_image_prompt takes ctx returns ok
  # Delete target if it exists
  let target = "friendly_cli/test_src/rose.png"
  if file_exists(target) == true then
    let del_out = exec_capture("powershell", "-Command", "Remove-Item -Path " + target + " -Force")
  end
  return expect(ctx, "target image path cleared", true, true)
end

make a function called st_when_imggen_skill_triggered returns ok
  let ctx = context_new()
  # Execute the image generation skill wrapper
  let success = generate_image_skill("A beautiful red rose with dew drops", "friendly_cli/test_src/rose.png")
  ctx_set(ctx, "imggen_success", success)
  return expect(ctx, "image generation skill executed", success, true)
end

make a function called st_then_image_generated_successfully takes ctx returns ok
  let exists = file_exists("friendly_cli/test_src/rose.png")
  return expect(ctx, "rose.png image successfully generated on disk", exists, "1")
end

# --- Step Registration ---

let ctx = ctx_new()
step(ctx, "an image generation prompt and cleared target", "st_given_image_prompt")
step(ctx, "the image generation skill is invoked", "st_when_imggen_skill_triggered")
step(ctx, "the target image file is successfully created with verified contracts", "st_then_image_generated_successfully")



let line1 = "Feature: Image Generation Skill Integration" + chr(10)
let line2 = "Scenario: Generate image using python stable diffusion utility" + chr(10)
let line3 = "Given an image generation prompt and cleared target" + chr(10)
let line4 = "When the image generation skill is invoked" + chr(10)
let line5 = "Then the target image file is successfully created with verified contracts" + chr(10)

let feature_text = line1 + line2 + line3 + line4 + line5

run_feature(ctx, feature_text)
ctx_report(ctx)
