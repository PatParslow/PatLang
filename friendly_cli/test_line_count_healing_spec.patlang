# =============================================================================
# Self-Healing BDD Driver for Line Count Function
# Goal: Synthesize a function to count lines in a file -- deliberately
# picked because a pure-PatLang implementation already exists using
# functions this codebase already has (read_file/split_lines/list_len),
# so this scenario exercises the known_patlang_solution path (no shell
# command, no LLM at all) rather than known_shell_solution or the LLM
# fallback the other two healing drivers exercise.
# =============================================================================

include "../self_hosting/lib/includes.patlang"
include "../self_hosting/lib/test.patlang"
include "lib/self_healing_engine.patlang"

# --- Step Definitions ---

make a function called st_given_missing_line_count_function returns ok
  print("[BDD TEST] Simulating runtime missing function: line_count...")
  return check("missing function trigger initialized", true, true)
end

make a function called st_when_line_count_healing_triggered returns ok
  let file_ok = file_exists("friendly_cli/test_src/doc1.md") == "1"
  check("test file doc1.md exists", file_ok, true)

  # engine_type/model_name are irrelevant here -- a known PatLang-native
  # solution exists, so the LLM is never consulted at all.
  let healed = heal_missing_function("line_count", "hermes", "", "friendly_cli/test_src/doc1.md", "friendly_cli/test_src/doc1.md", "3")
  return check("self-healing engine synthesized line_count via known PatLang solution (no LLM)", healed, true)
end

make a function called st_then_line_count_function_exists returns ok
  let file_ok = file_exists("friendly_cli/lib/synthesized_tools.patlang") == "1"
  check("synthesized_tools.patlang written to disk", file_ok, true)

  let spec_ok = file_exists("friendly_cli/test_healing_spec.patlang") == "1"
  check("test_healing_spec.patlang written to disk", spec_ok, true)

  let expanded_ok = file_exists("friendly_cli/test_healing_expanded.patlang") == "1"
  check("test_healing_expanded.patlang exists", expanded_ok, true)

  let exe_ok = file_exists("friendly_cli/test_healing_expanded.exe") == "1"
  check("test_healing_expanded.exe compiled successfully", exe_ok, true)

  return true
end

# --- Step Registration ---

step("a missing line_count function", "st_given_missing_line_count_function")
step("the self-healing engine synthesizes the line_count function", "st_when_line_count_healing_triggered")
step("the synthesized tool, expanded spec, and compiled executable are saved and verified", "st_then_line_count_function_exists")

t_init()

let line1 = "Feature: Line Count Self-Healing via Known PatLang Solution" + chr(10)
let line2 = "Scenario: Synthesize line_count function without any LLM call" + chr(10)
let line3 = "Given a missing line_count function" + chr(10)
let line4 = "When the self-healing engine synthesizes the line_count function" + chr(10)
let line5 = "Then the synthesized tool, expanded spec, and compiled executable are saved and verified" + chr(10)

let feature_text = line1 + line2 + line3 + line4 + line5

run_feature(feature_text)
t_report()
