# =============================================================================
# Pandoc-backed BDD Verification Suite for Friendly CLI
# Verifies md -> docx, docx -> md, and md -> pdf conversions using Pandoc.
# =============================================================================

include "../self_hosting/lib/includes.patlang"
include "../self_hosting/lib/gherkin.patlang"
include "lib/actions.patlang"

# --- Step Definitions ---

make a function called st_given_test_src takes ctx returns ok
  let files = list_dir("friendly_cli/test_src")
  return expect(ctx, "source directory test_src exists", files.length > 0, true)
end

make a function called st_when_convert_md_to_docx takes ctx returns ok
  let count = batch_convert_files("md", "friendly_cli/test_src", "docx")
  ctx_set(ctx, "converted_docx_count", count)
  return true
end

make a function called st_then_docx_created takes ctx returns ok
  let count = ctx_get(ctx, "converted_docx_count")
  expect(ctx, "markdown files converted to docx", count >= 2, true)
  let doc1_exists = file_exists("friendly_cli/test_src/doc1.docx")
  return expect(ctx, "doc1.docx file was created by Pandoc", doc1_exists, "1")
end

make a function called st_when_convert_docx_to_md takes ctx returns ok
  let count = batch_convert_files("docx", "friendly_cli/test_src", "md")
  ctx_set(ctx, "converted_md_count", count)
  return true
end

make a function called st_then_md_created takes ctx returns ok
  let count = ctx_get(ctx, "converted_md_count")
  expect(ctx, "docx files converted back to markdown", count >= 1, true)
  let sample_md_exists = file_exists("friendly_cli/test_src/sample.md")
  return expect(ctx, "sample.md file was created by Pandoc", sample_md_exists, "1")
end

make a function called st_when_convert_md_to_pdf takes ctx returns ok
  let count = batch_convert_files("md", "friendly_cli/test_src", "pdf")
  ctx_set(ctx, "converted_pdf_count", count)
  return true
end

make a function called st_then_pdf_created takes ctx returns ok
  let count = ctx_get(ctx, "converted_pdf_count")
  return expect(ctx, "markdown files converted to PDF", count >= 2, true)
end

# --- Step Registration ---

let ctx = ctx_new()
step(ctx, "a source directory with markdown and docx files", "st_given_test_src")
step(ctx, "the user converts all md files in test_src to docx", "st_when_convert_md_to_docx")
step(ctx, "docx files are generated on disk by Pandoc", "st_then_docx_created")
step(ctx, "the user converts all docx files in test_src to md", "st_when_convert_docx_to_md")
step(ctx, "markdown files are generated from docx by Pandoc", "st_then_md_created")
step(ctx, "the user converts all md files in test_src to pdf", "st_when_convert_md_to_pdf")
step(ctx, "pdf files are generated by Pandoc", "st_then_pdf_created")



let feature_text = "Feature: Pandoc Document Conversion Support" + chr(10) + "Scenario: Convert markdown documents to Word docx" + chr(10) + "Given a source directory with markdown and docx files" + chr(10) + "When the user converts all md files in test_src to docx" + chr(10) + "Then docx files are generated on disk by Pandoc" + chr(10) + "Scenario: Convert Word docx documents to markdown" + chr(10) + "Given a source directory with markdown and docx files" + chr(10) + "When the user converts all docx files in test_src to md" + chr(10) + "Then markdown files are generated from docx by Pandoc" + chr(10) + "Scenario: Convert markdown documents to PDF" + chr(10) + "Given a source directory with markdown and docx files" + chr(10) + "When the user converts all md files in test_src to pdf" + chr(10) + "Then pdf files are generated by Pandoc" + chr(10)

run_feature(ctx, feature_text)
ctx_report(ctx)
