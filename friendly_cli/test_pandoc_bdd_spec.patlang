# =============================================================================
# Pandoc-backed BDD Verification Suite for Friendly CLI
# Verifies md -> docx, docx -> md, and md -> pdf conversions using Pandoc.
# =============================================================================

include "../self_hosting/lib/test.patlang"
include "lib/actions.patlang"

# --- Step Definitions ---

make a function called st_given_test_src returns ok
  let files = list_dir("friendly_cli/test_src")
  return check("source directory test_src exists", files.length > 0, true)
end

make a function called st_when_convert_md_to_docx returns ok
  let count = batch_convert_files("md", "friendly_cli/test_src", "docx")
  set_var("converted_docx_count", count)
  return true
end

make a function called st_then_docx_created returns ok
  let count = get("__vars", "converted_docx_count")
  check("markdown files converted to docx", count >= 2, true)
  let doc1_exists = file_exists("friendly_cli/test_src/doc1.docx")
  return check("doc1.docx file was created by Pandoc", doc1_exists, "1")
end

make a function called st_when_convert_docx_to_md returns ok
  let count = batch_convert_files("docx", "friendly_cli/test_src", "md")
  set_var("converted_md_count", count)
  return true
end

make a function called st_then_md_created returns ok
  let count = get("__vars", "converted_md_count")
  check("docx files converted back to markdown", count >= 1, true)
  let sample_md_exists = file_exists("friendly_cli/test_src/sample.md")
  return check("sample.md file was created by Pandoc", sample_md_exists, "1")
end

make a function called st_when_convert_md_to_pdf returns ok
  let count = batch_convert_files("md", "friendly_cli/test_src", "pdf")
  set_var("converted_pdf_count", count)
  return true
end

make a function called st_then_pdf_created returns ok
  let count = get("__vars", "converted_pdf_count")
  return check("markdown files converted to PDF", count >= 2, true)
end

# --- Step Registration ---

step("a source directory with markdown and docx files", "st_given_test_src")
step("the user converts all md files in test_src to docx", "st_when_convert_md_to_docx")
step("docx files are generated on disk by Pandoc", "st_then_docx_created")
step("the user converts all docx files in test_src to md", "st_when_convert_docx_to_md")
step("markdown files are generated from docx by Pandoc", "st_then_md_created")
step("the user converts all md files in test_src to pdf", "st_when_convert_md_to_pdf")
step("pdf files are generated by Pandoc", "st_then_pdf_created")

t_init()

let feature_text = "Feature: Pandoc Document Conversion Support" + chr(10) + "Scenario: Convert markdown documents to Word docx" + chr(10) + "Given a source directory with markdown and docx files" + chr(10) + "When the user converts all md files in test_src to docx" + chr(10) + "Then docx files are generated on disk by Pandoc" + chr(10) + "Scenario: Convert Word docx documents to markdown" + chr(10) + "Given a source directory with markdown and docx files" + chr(10) + "When the user converts all docx files in test_src to md" + chr(10) + "Then markdown files are generated from docx by Pandoc" + chr(10) + "Scenario: Convert markdown documents to PDF" + chr(10) + "Given a source directory with markdown and docx files" + chr(10) + "When the user converts all md files in test_src to pdf" + chr(10) + "Then pdf files are generated by Pandoc" + chr(10)

run_feature(feature_text)
t_report()
