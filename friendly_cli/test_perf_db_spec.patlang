# =============================================================================
# Relational Performance Database BDD Verification Suite
# Populates multiple data points across separate task categories (patc1 and zip),
# monitors errors, updates metrics, and logs them to the relational database.
# =============================================================================

include "../self_hosting/lib/includes.patlang"
include "../self_hosting/lib/test.patlang"
include "lib/perf_database.patlang"

# --- Helper: Get Millisecond Epoch ---
make a function called get_system_time_ms returns ms
  let raw = exec_capture("powershell", "-Command", "[DateTimeOffset]::UtcNow.ToUnixTimeMilliseconds()")
  return to_num(raw)
end

# --- BDD Step Definitions ---

make a function called st_given_database_reset returns ok
  # Delete database and reset model weights
  if file_exists("friendly_cli/performance_database.sql") == "1" then
    let del_db = exec_capture("powershell", "-Command", "Remove-Item -Path friendly_cli/performance_database.sql -Force")
  end
  save_task_regression_weights("patc1", 35.0, 5000.0)
  save_task_regression_weights("zip", 200.0, 500.0)
  return check("relational database reset and weights initialized", true, true)
end

make a function called st_when_multi_compile_tasks_run returns ok
  # Target 1: size_100.patlang
  let lines_a = 104
  let pred_a = predict_task_duration("patc1", lines_a)
  print("  [TRAINING patc1] Run 1 (100 lines) | Predicted: " + pred_a + " ms")

  let start_a = get_system_time_ms()
  let out_a = exec_capture("./patc1.exe", "friendly_cli/test_src/size_100.patlang", "friendly_cli/test_dest/size_100.exe")
  let duration_a = get_system_time_ms() - start_a
  print("  [TRAINING patc1] Run 1 (100 lines) | Actual: " + duration_a + " ms")
  update_task_weights("patc1", lines_a, duration_a)

  # Target 2: test_concat_expanded.patlang (~450 lines)
  let lines_b = 454
  let pred_b = predict_task_duration("patc1", lines_b)
  print("  [TRAINING patc1] Run 2 (450 lines) | Predicted: " + pred_b + " ms")

  let start_b = get_system_time_ms()
  let out_b = exec_capture("./patc1.exe", "friendly_cli/test_concat_expanded.patlang", "friendly_cli/test_dest/temp_a.exe")
  let duration_b = get_system_time_ms() - start_b
  print("  [TRAINING patc1] Run 2 (450 lines) | Actual: " + duration_b + " ms")
  update_task_weights("patc1", lines_b, duration_b)

  return true
end

make a function called st_when_zip_tasks_run returns ok
  # Simulating compression runs with different numbers of files
  # Run 1: zip 2 files
  let files_run1 = 2
  let pred_zip1 = predict_task_duration("zip", files_run1)
  print("  [TRAINING zip] Run 1 (2 files) | Predicted: " + pred_zip1 + " ms")

  let start_zip1 = get_system_time_ms()
  let zip_out1 = exec_capture("powershell", "-Command", "Compress-Archive -Path friendly_cli/test_src/*.docx -DestinationPath friendly_cli/test_dest/zip_run1.zip -Force")
  let duration_zip1 = get_system_time_ms() - start_zip1
  print("  [TRAINING zip] Run 1 (2 files) | Actual: " + duration_zip1 + " ms")
  update_task_weights("zip", files_run1, duration_zip1)

  return true
end

make a function called st_then_sql_records_verified returns ok
  let db_exists = file_exists("friendly_cli/performance_database.sql")
  check("SQL metrics database written to disk", db_exists, "1")

  let content = read_file("friendly_cli/performance_database.sql")
  print("=== PERFORMANCE SQL FILE PREVIEW ===")
  print(content)

  let contains_patc1 = contains_text(content, "patc1")
  let contains_zip = contains_text(content, "zip")
  check("SQL database logs compile records", contains_patc1, true)
  return check("SQL database logs zip records", contains_zip, true)
end

# --- Step Registration ---

step("a clean relational performance database", "st_given_database_reset")
step("multiple compilation jobs are executed to train the compiler time weights", "st_when_multi_compile_tasks_run")
step("zip compression tasks are executed to train the archiver weights", "st_when_zip_tasks_run")
step("the SQL database catalog is populated and verified", "st_then_sql_records_verified")

t_init()

let line1 = "Feature: Relational Performance Database & Multitask Regression" + chr(10)
let line2 = "Scenario: Record multi-run compile and zip operations and verify SQL log" + chr(10)
let line3 = "Given a clean relational performance database" + chr(10)
let line4 = "When multiple compilation jobs are executed to train the compiler time weights" + chr(10)
let line5 = "And zip compression tasks are executed to train the archiver weights" + chr(10)
let line6 = "Then the SQL database catalog is populated and verified" + chr(10)

let feature_text = line1 + line2 + line3 + line4 + line5 + line6

run_feature(feature_text)
t_report()
