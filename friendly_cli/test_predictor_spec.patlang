# =============================================================================
# Compilation Performance Predictor and Verifier Spec
# Measures compile times, builds linear prediction models based on line counts,
# executes asynchronous native compiles, and reports timing margins.
# =============================================================================

include "../self_hosting/lib/includes.patlang"
include "../self_hosting/lib/includes.patlang"
include "../self_hosting/lib/gherkin.patlang"

# --- Helper: Get Millisecond Epoch ---
make a function called get_system_time_ms returns ms
  let raw = exec_capture("powershell", "-Command", "[DateTimeOffset]::UtcNow.ToUnixTimeMilliseconds()")
  return to_num(raw)
end

# --- Helper: Count File Lines ---
make a function called count_file_lines takes path returns lines
  let text = read_file(path)
  let n = text.length
  let count = 1
  let i = 0
  while i < n do
    if char_code(text, i) == 10 then
      let count = count + 1
    end
    let i = i + 1
  end
  return count
end

# --- BDD Step Definitions ---

make a function called st_given_uncompiled_files takes ctx returns ok
  let file_a = "friendly_cli/test_concat_expanded.patlang"
  let file_b = "friendly_cli/test_ai_bdd_expanded.patlang"
  expect(ctx, "file A exists", file_exists(file_a), "1")
  return expect(ctx, "file B exists", file_exists(file_b), "1")
end

make a function called st_when_file_a_measured_and_file_b_predicted takes ctx returns ok
  let file_a = "friendly_cli/test_concat_expanded.patlang"
  let file_b = "friendly_cli/test_ai_bdd_expanded.patlang"
  
  let lines_a = count_file_lines(file_a)
  let lines_b = count_file_lines(file_b)
  ctx_set(ctx, "lines_a", lines_a)
  ctx_set(ctx, "lines_b", lines_b)

  print("  [PREDICTOR] File A line count: " + lines_a)
  print("  [PREDICTOR] File B line count: " + lines_b)

  # Measure Compile Time of File A
  let start_time = get_system_time_ms()
  let out_a = exec_capture("./patc1.exe", "friendly_cli/test_concat_expanded.patlang", "friendly_cli/test_dest/temp_a.exe")
  let end_time = get_system_time_ms()
  let duration_a = end_time - start_time
  ctx_set(ctx, "duration_a", duration_a)

  print("  [PREDICTOR] File A compiled in: " + duration_a + " ms")

  # Calculate ms_per_line ratio
  let ms_per_line = duration_a / lines_a
  let predicted_duration_b = lines_b * ms_per_line
  ctx_set(ctx, "predicted_duration_b", predicted_duration_b)

  print("  [PREDICTOR] Predicted File B compile duration: " + predicted_duration_b + " ms")
  return true
end

make a function called st_then_file_b_compiled_and_error_calculated takes ctx returns ok
  let file_b = "friendly_cli/test_ai_bdd_expanded.patlang"
  let dest_b = "friendly_cli/test_dest/temp_b.exe"
  
  # Delete target to make check accurate
  if file_exists(dest_b) == true then
    let del_out = exec_capture("powershell", "-Command", "Remove-Item -Path " + dest_b + " -Force")
  end

  print("  [COMPILER] Spawning compilation of File B...")
  let start_time = get_system_time_ms()
  
  # Shell execution to run compiler
  let comp_out = exec_capture("./patc1.exe", file_b, dest_b)
  
  let end_time = get_system_time_ms()
  let duration_b = end_time - start_time
  let predicted = ctx_get(ctx, "predicted_duration_b")
  
  let error_val = to_num(duration_b) - to_num(predicted)

  print("  [RESULT] File B compiled in: " + duration_b + " ms")
  print("  [RESULT] Prediction Error: " + error_val + " ms")

  expect(ctx, "File B compiled successfully", file_exists(dest_b), "1")
  return true
end

# --- Step Registration ---

let ctx = ctx_new()
step(ctx, "two uncompiled PatLang files with different line counts", "st_given_uncompiled_files")
step(ctx, "the first is compiled to measure compile speed and the second compile time is predicted", "st_when_file_a_measured_and_file_b_predicted")
step(ctx, "the second is compiled and the prediction error is logged", "st_then_file_b_compiled_and_error_calculated")



let line1 = "Feature: Compilation Performance Predictor" + chr(10)
let line2 = "Scenario: Measure compile rates and predict subsequent compilation duration" + chr(10)
let line3 = "Given two uncompiled PatLang files with different line counts" + chr(10)
let line4 = "When the first is compiled to measure compile speed and the second compile time is predicted" + chr(10)
let line5 = "Then the second is compiled and the prediction error is logged" + chr(10)

let feature_text = line1 + line2 + line3 + line4 + line5

run_feature(ctx, feature_text)
ctx_report(ctx)
