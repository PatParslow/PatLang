# =============================================================================
# Smart Goal Reasoning BDD Verification Suite
# Verifies natural `goal:` blocks, GOAP auto-chaining, and DbC verification.
# =============================================================================

include "../self_hosting/lib/includes.patlang"
include "../self_hosting/lib/regex_dsl.patlang"
include "../self_hosting/lib/syntax_dsl.patlang"
include "../self_hosting/lib/test.patlang"
include "lib/actions.patlang"
include "lib/smart_engine.patlang"
include "lib/goal_preprocessor.patlang"

# --- Step Definitions ---

make a function called st_given_smart_engine returns ok
  init_smart_reasoning_engine()
  let files = list_dir("friendly_cli/test_src")
  return check("source directory test_src contains markdown files", files.length > 0, true)
end

make a function called st_when_user_specifies_goal returns ok
  # User input with natural `goal:` header and double-newline end!
  let line1 = "goal:" + chr(10)
  let line2 = "  make pdfs from markdown in docs" + chr(10)
  let line3 = "  archive the pdfs into backup.zip" + chr(10) + chr(10)
  let novice_input = line1 + line2 + line3

  # Preprocess natural `goal:` block format
  let preprocessed = preprocess_friendly_goals(novice_input)
  
  # Expand natural goal DSL rules
  let dsl_code = read_file("friendly_cli/dsl/goal_ops.patlang")
  let defs = expand_syntax_dsls_with(dsl_code, [])[1]
  let expanded_patlang = expand_syntax_dsls_with(preprocessed, defs)[0]

  set_var("smart_expanded_code", expanded_patlang)
  return true
end

make a function called st_then_goap_chains_automatically returns ok
  let code = get("__vars", "smart_expanded_code")
  check("natural goal block preprocessed into do_goals DSL wrapper", str_starts_with(str_trim(code), "execute_goal_target"), true)
  
  # Execute the target goal: archive_backup (requires md -> docx -> pdf -> archive)
  let success = execute_goal_target("archive_backup")
  check("GOAP engine automatically solved multi-step chain and executed", success, true)
  
  let zip_created = file_exists("friendly_cli/test_dest/backup.zip")
  return check("backup.zip was generated and verified by DbC contract", zip_created, "1")
end

# --- Step Registration ---

step("a smart reasoning engine with DbC contracts", "st_given_smart_engine")
step("a novice specifies a high-level natural goal block", "st_when_user_specifies_goal")
step("the GOAP engine automatically computes and executes the multi-step chain", "st_then_goap_chains_automatically")

t_init()

let line1 = "Feature: Smart Goal Reasoning and Automatic Action Chaining" + chr(10)
let line2 = "Scenario: Auto-chain markdown to PDF conversion and archiving from goal block" + chr(10)
let line3 = "Given a smart reasoning engine with DbC contracts" + chr(10)
let line4 = "When a novice specifies a high-level natural goal block" + chr(10)
let line5 = "Then the GOAP engine automatically computes and executes the multi-step chain" + chr(10)

let feature_text = line1 + line2 + line3 + line4 + line5

run_feature(feature_text)
t_report()
