# Proves the VFS transaction prototype (friendly_cli/lib/vfs_transaction.
# patlang) actually restores/preserves state correctly -- "test that the
# program state backtracking transactions work in theory."
#
# Case 1: a FAILING candidate modifies an existing file and creates a new
#   one, then signals failure -- rollback must undo BOTH the modification
#   AND the creation, restoring byte-for-byte pre-transaction state.
# Case 2: a SUCCEEDING candidate does the same kind of changes, then
#   signals success -- commit must KEEP both changes untouched.
# Case 3 (negative/robustness): an untouched file, present before AND
#   after a rolled-back transaction, must never even be touched.

include "../self_hosting/lib/includes.patlang"
include "../self_hosting/lib/test.patlang"
include "lib/vfs_transaction.patlang"

print("=== Case 1: FAILING candidate -- rollback must undo everything ===")
vfs_write("a.txt", "original-a")
vfs_write("b.txt", "original-b")

let failing_candidate = || do
  vfs_write("a.txt", "MODIFIED-BY-FAILED-ATTEMPT")
  vfs_write("c.txt", "CREATED-BY-FAILED-ATTEMPT")
  return false
end

let result1 = txn_try("case1", failing_candidate)
print("candidate reported success=" + ("" + result1) + " (expected false)")
print("a.txt after rollback: " + vfs_read("a.txt") + " (expected original-a)")
print("b.txt after rollback: " + vfs_read("b.txt") + " (expected original-b, untouched)")
print("c.txt exists after rollback: " + ("" + vfs_exists("c.txt")) + " (expected 0 -- must be gone)")

let case1_ok = (not result1) and (vfs_read("a.txt") == "original-a") and (vfs_read("b.txt") == "original-b") and (vfs_exists("c.txt") == "0")
print("CASE 1 (rollback undoes modify+create): " + ("" + case1_ok))

print("=== Case 2: SUCCEEDING candidate -- commit must keep everything ===")
let succeeding_candidate = || do
  vfs_write("a.txt", "MODIFIED-BY-SUCCESSFUL-ATTEMPT")
  vfs_write("d.txt", "CREATED-BY-SUCCESSFUL-ATTEMPT")
  return true
end

let result2 = txn_try("case2", succeeding_candidate)
print("candidate reported success=" + ("" + result2) + " (expected true)")
print("a.txt after commit: " + vfs_read("a.txt") + " (expected MODIFIED-BY-SUCCESSFUL-ATTEMPT)")
print("d.txt exists after commit: " + ("" + vfs_exists("d.txt")) + " (expected 1 -- must persist)")

let case2_ok = result2 and (vfs_read("a.txt") == "MODIFIED-BY-SUCCESSFUL-ATTEMPT") and (vfs_exists("d.txt") == "1")
print("CASE 2 (commit keeps modify+create): " + ("" + case2_ok))

print("=== Case 3: backup namespace itself leaves no residue after either outcome ===")
let leftover = vfs_list("__vfs_txn__/")
print("leftover backup entries: " + ("" + to_num(list_len(leftover))) + " (expected 0)")
let case3_ok = to_num(list_len(leftover)) == 0

print("=== SUMMARY ===")
print("case1 (rollback): " + ("" + case1_ok))
print("case2 (commit): " + ("" + case2_ok))
print("case3 (no backup residue): " + ("" + case3_ok))
if case1_ok and case2_ok and case3_ok then
  print("=== RESULT: VFS transaction prototype genuinely restores/preserves state as designed ===")
else
  print("=== RESULT: FAILED -- see cases above ===")
end
