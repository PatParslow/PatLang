#!/usr/bin/env ruby
# =============================================================================
# PaTLang Phase 1 Deployment Setup Script
# Sets up the native CLI for production deployment
# =============================================================================

require 'fileutils'
require 'json'
require 'date'

class Phase1DeploymentSetup
  def initialize
    @project_root = File.expand_path('..', __dir__)
    @deployment_config = {
      version: "1.0.0",
      phase: "Phase 1",
      deployment_date: Time.now.iso8601,
      components: {}
    }
    
    puts "=== PaTLang Phase 1 Deployment Setup ==="
    puts "Project root: #{@project_root}"
  end
  
  def setup_deployment
    puts "\n--- Setting up Phase 1 deployment infrastructure ---"
    
    # Step 1: Validate all required components
    validate_components
    
    # Step 2: Create deployment wrapper
    create_deployment_wrapper
    
    # Step 3: Set up executable permissions
    setup_permissions
    
    # Step 4: Create deployment configuration
    create_deployment_config
    
    # Step 5: Generate deployment documentation
    generate_deployment_docs
    
    # Step 6: Create transition scripts
    create_transition_scripts
    
    puts "\n✅ Phase 1 deployment setup complete!"
  end
  
  def validate_components
    puts "\n--- Validating deployment components ---"
    
    required_components = {
      'Native CLI' => 'bin/patlang.patlang',
      'Ruby Bridge' => 'native_evaluator/ruby_bridge.rb',
      'Function Parser' => 'patlang-core/parser/function_parser.rb',
      'Core Evaluator' => 'patlang-core/evaluator/evaluator.rb',
      'Lexer' => 'patlang-core/lexer/lexer.rb',
      'Parser' => 'patlang-core/parser/parser.rb'
    }
    
    required_components.each do |name, path|
      full_path = File.join(@project_root, path)
      if File.exist?(full_path)
        puts "✓ #{name}: #{path}"
        @deployment_config[:components][name] = {
          path: path,
          status: 'available',
          size: File.size(full_path)
        }
      else
        puts "✗ #{name}: MISSING - #{path}"
        @deployment_config[:components][name] = {
          path: path,
          status: 'missing',
          size: 0
        }
        raise "Required component missing: #{name}"
      end
    end
  end
  
  def create_deployment_wrapper
    puts "\n--- Creating deployment wrapper ---"
    
    wrapper_content = <<~RUBY
      #!/usr/bin/env ruby
      # =============================================================================
      # PaTLang Phase 1 Deployment Wrapper
      # Executes the native PaTLang CLI with proper Ruby bridge integration
      # =============================================================================
      
      require 'fileutils'
      require_relative '../native_evaluator/ruby_bridge.rb'
      
      class PaTLangCLIWrapper
        def initialize
          @project_root = File.expand_path('..', __dir__)
          @native_cli_path = File.join(@project_root, 'bin', 'patlang.patlang')
          @bridge = PaTLangPhase1Bridge.new
        end
        
        def execute(args)
          puts "PaTLang Native CLI v1.0.0 - Phase 1 Self-Hosting"
          
          # Parse command line arguments
          options = parse_arguments(args)
          
          # Handle special commands
          return show_help if options[:help]
          return show_version if options[:version]
          return show_backends if options[:backends]
          
          # Validate input file
          unless options[:file]
            puts "Error: No input file specified"
            show_help
            return 1
          end
          
          unless File.exist?(options[:file])
            puts "Error: File not found: \#{options[:file]}"
            return 1
          end
          
          # Execute file with selected backend
          execute_file(options[:file], options)
        end
        
        private
        
        def parse_arguments(args)
          options = {
            backend: 'ruby',
            verbose: false,
            debug: false,
            timing: false,
            quiet: false,
            compare: false,
            help: false,
            version: false,
            backends: false,
            file: nil
          }
          
          i = 0
          while i < args.length
            case args[i]
            when '-h', '--help'
              options[:help] = true
            when '-v', '--verbose'
              options[:verbose] = true
            when '-d', '--debug'
              options[:debug] = true
            when '-t', '--time'
              options[:timing] = true
            when '-q', '--quiet'
              options[:quiet] = true
            when '-c', '--compare'
              options[:compare] = true
            when '--version'
              options[:version] = true
            when '--backends'
              options[:backends] = true
            when '-b', '--backend'
              i += 1
              options[:backend] = args[i] if i < args.length
            when '-o', '--output'
              i += 1
              options[:output] = args[i] if i < args.length
            else
              options[:file] = args[i] unless args[i].start_with?('-')
            end
            i += 1
          end
          
          options
        end
        
        def execute_file(file_path, options)
          puts "Executing: \#{file_path}" unless options[:quiet]
          puts "Backend: \#{options[:backend]}" if options[:verbose]
          
          start_time = Time.now
          
          begin
            # Read file content
            content = File.read(file_path)
            
            # Determine backend preference
            bridge_options = {
              prefer_patlang: options[:backend] == 'phase1',
              verbose: options[:verbose],
              debug: options[:debug]
            }
            
            # Execute with bridge
            result = @bridge.evaluate(content, bridge_options)
            
            end_time = Time.now
            execution_time = end_time - start_time
            
            # Output results
            if result[:success]
              puts result[:value] unless options[:quiet]
              puts "Execution time: \#{sprintf('%.3f', execution_time)}s" if options[:timing]
              puts "Backend used: \#{result[:evaluator_used]}" if options[:verbose]
              return 0
            else
              puts "Error: \#{result[:error]}"
              return 1
            end
            
          rescue => e
            puts "Error: \#{e.message}"
            return 1
          end
        end
        
        def show_help
          puts <<~HELP
            PaTLang CLI v1.0.0 - Phase 1 Self-Hosting
            
            Usage: patlang [options] <file.pat|file.patlang>
            
            Backend Selection:
              -b, --backend BACKEND    Select backend: ruby (default), phase1
              -c, --compare           Compare results across all available backends
            
            Output Options:
              -o, --output FILE       Save output to file
              -q, --quiet             Suppress non-essential output
            
            Debugging Options:
              -v, --verbose           Enable verbose output
              -d, --debug             Enable debug mode
              -t, --time              Show execution timing
            
            Information:
                  --version           Show version information
              -h, --help              Show this help
                  --backends          List available backends
            
            Examples:
              patlang script.pat                    # Run with default Ruby backend
              patlang --backend phase1 script.pat  # Use Phase 1 self-hosting bridge
              patlang --verbose --time script.pat  # Show detailed output and timing
          HELP
          0
        end
        
        def show_version
          puts "PaTLang CLI v1.0.0"
          puts "Phase 1 Self-Hosting Implementation"
          puts "Copyright (c) 2025 PaTLang Project"
          0
        end
        
        def show_backends
          puts "Available PaTLang Backends:"
          puts "  ruby     Ruby evaluator (default, stable)"
          puts "  phase1   Phase 1 self-hosting bridge (experimental)"
          puts ""
          puts "To use a specific backend:"
          puts "  patlang --backend ruby script.pat"
          puts "  patlang --backend phase1 script.pat"
          0
        end
      end
      
      # Main execution
      if __FILE__ == $0
        wrapper = PaTLangCLIWrapper.new
        exit_code = wrapper.execute(ARGV)
        exit(exit_code)
      end
    RUBY
    
    wrapper_path = File.join(@project_root, 'bin', 'patlang_phase1')
    File.write(wrapper_path, wrapper_content)
    
    puts "✓ Deployment wrapper created: bin/patlang_phase1"
    @deployment_config[:components]['Deployment Wrapper'] = {
      path: 'bin/patlang_phase1',
      status: 'created',
      size: wrapper_content.length
    }
  end
  
  def setup_permissions
    puts "\n--- Setting up executable permissions ---"
    
    executable_files = [
      'bin/patlang_phase1',
      'integration_tests/native_cli_integration_test_suite.rb',
      'integration_tests/phase1_deployment_setup.rb'
    ]
    
    executable_files.each do |file_path|
      full_path = File.join(@project_root, file_path)
      if File.exist?(full_path)
        File.chmod(0755, full_path)
        puts "✓ Made executable: #{file_path}"
      end
    end
  end
  
  def create_deployment_config
    puts "\n--- Creating deployment configuration ---"
    
    config_path = File.join(@project_root, 'deployment_config.json')
    File.write(config_path, JSON.pretty_generate(@deployment_config))
    
    puts "✓ Deployment configuration saved: deployment_config.json"
  end
  
