    docs_path = File.join(@project_root, 'PHASE1_DEPLOYMENT_GUIDE.md')
    File.write(docs_path, deployment_guide)
    
    puts "✓ Deployment guide created: PHASE1_DEPLOYMENT_GUIDE.md"
  end
  
  def create_transition_scripts
    puts "\n--- Creating transition scripts ---"
    
    # Create a simple transition script
    transition_script = <<~BASH
      #!/bin/bash
      # PaTLang Phase 1 Transition Script
      
      echo "=== PaTLang Phase 1 Transition ==="
      echo "Transitioning from Ruby CLI to Native CLI..."
      
      # Check if old CLI exists
      if [ -f "bin/patlang" ]; then
        echo "✓ Ruby CLI found: bin/patlang"
      else
        echo "⚠ Ruby CLI not found (expected for Phase 1)"
      fi
      
      # Check if new CLI exists  
      if [ -f "bin/patlang_phase1" ]; then
        echo "✓ Native CLI wrapper found: bin/patlang_phase1"
      else
        echo "✗ Native CLI wrapper missing!"
        exit 1
      fi
      
      # Test basic functionality
      echo ""
      echo "Testing basic functionality..."
      if bin/patlang_phase1 --version > /dev/null 2>&1; then
        echo "✓ Version check passed"
      else
        echo "✗ Version check failed"
        exit 1
      fi
      
      if bin/patlang_phase1 --help > /dev/null 2>&1; then
        echo "✓ Help display passed"
      else
        echo "✗ Help display failed"
        exit 1
      fi
      
      echo ""
      echo "✅ Phase 1 transition complete!"
      echo "Use 'bin/patlang_phase1' instead of 'bin/patlang'"
      echo ""
      echo "Quick start:"
      echo "  bin/patlang_phase1 examples/object_model_demo.pat"
      echo "  bin/patlang_phase1 --backend phase1 examples/arithmetic_demo.pat"
    BASH
    
    script_path = File.join(@project_root, 'transition_to_phase1.sh')
    File.write(script_path, transition_script)
    File.chmod(0755, script_path)
    
    puts "✓ Transition script created: transition_to_phase1.sh"
  end
end

# Main execution
if __FILE__ == $0
  setup = Phase1DeploymentSetup.new
  
  begin
    setup.setup_deployment
    puts "\n🚀 Phase 1 deployment setup completed successfully!"
    puts "\nNext steps:"
    puts "1. Run integration tests: ruby integration_tests/native_cli_integration_test_suite.rb"
    puts "2. Test transition: ./transition_to_phase1.sh"
    puts "3. Execute PaTLang files: bin/patlang_phase1 examples/object_model_demo.pat"
  rescue => e
    puts "\n❌ Deployment setup failed: #{e.message}"
    exit 1
  end
end