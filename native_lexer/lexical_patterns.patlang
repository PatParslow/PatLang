fact is_whitespace("\r")

# Quote characters
fact is_quote("\"")
fact is_quote("'")

# =============================================================================
# CHARACTER CLASSIFICATION RULES
# =============================================================================

# Rule to check if character is alphanumeric
rule is_alphanumeric(char) :-
    is_letter(char).

rule is_alphanumeric(char) :-
    is_digit(char).

# Rule to check if character can start an identifier
rule can_start_identifier(char) :-
    is_letter(char).

rule can_start_identifier(char) :-
    char = "_".

# Rule to check if character can be in identifier body
rule can_be_in_identifier(char) :-
    is_alphanumeric(char).

rule can_be_in_identifier(char) :-
    char = "_".

# =============================================================================
# BASIC TOKEN PATTERN DEFINITIONS
# =============================================================================

# Single character operator patterns
fact single_char_token("+", "PLUS")
fact single_char_token("-", "MINUS")
fact single_char_token("*", "MULTIPLY")
fact single_char_token("/", "DIVIDE")
fact single_char_token("%", "MODULO")
fact single_char_token("(", "LPAREN")
fact single_char_token(")", "RPAREN")
fact single_char_token("{", "LBRACE")
fact single_char_token("}", "RBRACE")
fact single_char_token("[", "LBRACKET")
fact single_char_token("]", "RBRACKET")
fact single_char_token("=", "EQUALS")

# =============================================================================
# NUMBER PATTERN RECOGNITION
# =============================================================================

# Helper function to check if string is all digits
make a function called all_digits takes text returns is_all_digits
    is_all_digits = true
    i = 0
    while i < text.length and is_all_digits do
        char = text[i]
        if not is_digit(char) then
            is_all_digits = false
        end
        i = i + 1
    end
end

# Helper function to check if string is valid number (with optional decimal)
make a function called is_valid_number takes text returns is_valid
    is_valid = false
    
    # Check for simple integer
    if all_digits(text) then
        is_valid = true
    else
        # Check for decimal number
        dot_count = 0
        valid_parts = true
        i = 0
        
        while i < text.length and valid_parts do
            char = text[i]
            if char = "." then
                dot_count = dot_count + 1
                if dot_count > 1 then
                    valid_parts = false
                end
            else
                if not is_digit(char) then
                    valid_parts = false
                end
            end
            i = i + 1
        end
        
        if valid_parts and dot_count = 1 then
            is_valid = true
        end
    end
end

# Number pattern recognition rule
rule matches_number_pattern(text) :-
    is_valid_number(text) = true.

# =============================================================================
# IDENTIFIER PATTERN RECOGNITION
# =============================================================================

# Helper function to check if string is valid identifier
make a function called is_valid_identifier takes text returns is_valid
    is_valid = false
    
    if text.length > 0 then
        first_char = text[0]
        if can_start_identifier(first_char) then
            is_valid = true
            i = 1
            
            while i < text.length and is_valid do
                char = text[i]
                if not can_be_in_identifier(char) then
                    is_valid = false
                end
                i = i + 1
            end
        end
    end
end

# Identifier pattern recognition rule
rule matches_identifier_pattern(text) :-
    is_valid_identifier(text) = true.

# =============================================================================
# STRING PATTERN RECOGNITION
# =============================================================================

# Helper function to check if string is properly quoted
make a function called is_quoted_string takes text returns is_quoted
    is_quoted = false
    
    if text.length >= 2 then
        first_char = text[0]
        last_char = text[text.length - 1]
        
        if is_quote(first_char) and first_char = last_char then
            is_quoted = true
        end
    end
end

# String pattern recognition rule
rule matches_string_pattern(text) :-
    is_quoted_string(text) = true.

# =============================================================================
# KEYWORD PATTERN DEFINITIONS
# =============================================================================

# PaTLang keyword facts - natural language constructs
fact keyword_pattern("make", "MAKE")
fact keyword_pattern("a", "A")
fact keyword_pattern("function", "FUNCTION")
fact keyword_pattern("called", "CALLED")
fact keyword_pattern("is", "IS")
fact keyword_pattern("takes", "TAKES")
fact keyword_pattern("returns", "RETURNS")
fact keyword_pattern("end", "END")

# Control flow keywords
fact keyword_pattern("if", "IF")
fact keyword_pattern("then", "THEN")
fact keyword_pattern("else", "ELSE")
fact keyword_pattern("while", "WHILE")
fact keyword_pattern("do", "DO")

# Boolean literals
fact keyword_pattern("true", "TRUE")
fact keyword_pattern("false", "FALSE")

# Reasoning mode keywords
fact keyword_pattern("reasoning", "REASONING")
fact keyword_pattern("mode", "MODE")
fact keyword_pattern("on", "ON")
fact keyword_pattern("off", "OFF")

# Logic programming keywords
fact keyword_pattern("fact", "FACT")
fact keyword_pattern("rule", "RULE")
fact keyword_pattern("goal", "GOAL")
fact keyword_pattern("pursue", "PURSUE")

# Type constraint keywords
fact keyword_pattern("constrain", "CONSTRAIN")

# =============================================================================
# PATTERN MATCHING RULES
# =============================================================================

# Rule to resolve token type based on text content
rule resolve_token_type(text, token_type) :-
    single_char_token(text, token_type).

rule resolve_token_type(text, token_type) :-
    keyword_pattern(text, token_type).

rule resolve_token_type(text, "NUMBER") :-
    matches_number_pattern(text).

rule resolve_token_type(text, "STRING") :-
    matches_string_pattern(text).

rule resolve_token_type(text, "IDENTIFIER") :-
    matches_identifier_pattern(text),
    not keyword_pattern(text, _).

# Default rule for unrecognized patterns
rule resolve_token_type(text, "UNKNOWN") :-
    not single_char_token(text, _),
    not keyword_pattern(text, _),
    not matches_number_pattern(text),
    not matches_string_pattern(text),
    not matches_identifier_pattern(text).

# =============================================================================
# AMBIGUITY DETECTION RULES
# =============================================================================

# Rule to detect ambiguous tokens (could be keyword or identifier)
rule is_ambiguous_token(text) :-
    keyword_pattern(text, _),
    matches_identifier_pattern(text).

# Rule to count possible interpretations
rule count_possible_types(text, count) :-
    possible_types = [],
    
    # Check each pattern type
    if single_char_token(text, _) then
        possible_types = possible_types + ["single_char"]
    end,
    
    if keyword_pattern(text, _) then
        possible_types = possible_types + ["keyword"]
    end,
    
    if matches_number_pattern(text) then
        possible_types = possible_types + ["number"]
    end,
    
    if matches_string_pattern(text) then
        possible_types = possible_types + ["string"]
    end,
    
    if matches_identifier_pattern(text) then
        possible_types = possible_types + ["identifier"]
    end,
    
    count = possible_types.length.

# =============================================================================
# HELPER FUNCTIONS FOR PATTERN TESTING
# =============================================================================

# Test if text matches any known pattern
make a function called matches_any_pattern takes text returns matches
    matches = false
    
    if single_char_token(text, _) then
        matches = true
    else
        if keyword_pattern(text, _) then
            matches = true
        else
            if matches_number_pattern(text) then
                matches = true
            else
                if matches_string_pattern(text) then
                    matches = true
                else
                    if matches_identifier_pattern(text) then
                        matches = true
                    end
                end
            end
        end
    end
end

# Get the primary token type for text
make a function called get_primary_token_type takes text returns token_type
    if single_char_token(text, type) then
        token_type = type
    else
        if keyword_pattern(text, type) then
            token_type = type
        else
            if matches_number_pattern(text) then
                token_type = "NUMBER"
            else
                if matches_string_pattern(text) then
                    token_type = "STRING"
                else
                    if matches_identifier_pattern(text) then
                        token_type = "IDENTIFIER"
                    else
                        token_type = "UNKNOWN"
                    end
                end
            end
        end
    end
end