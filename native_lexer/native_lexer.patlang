# =============================================================================
# NATIVE PATLANG LEXER - MAIN LEXER IMPLEMENTATION
# Phase 1: Foundation Components
# =============================================================================

# Goal-oriented lexer implementation using PaTLang's multi-paradigm capabilities
# Follows "Never Fail, Always Token" principle with reasoning-based tokenization

# Enable reasoning mode for intelligent tokenization
reasoning mode on

# =============================================================================
# LEXER STATE MANAGEMENT
# =============================================================================

# Lexer state variables
input_text = ""
current_position = 0
current_line = 1
current_column = 1
tokens = []
lexer_initialized = false

# =============================================================================
# INPUT TEXT HANDLING AND POSITION TRACKING
# =============================================================================

# Initialize lexer with input text
make a function called initialize_lexer takes text returns success
    input_text = text
    current_position = 0
    current_line = 1
    current_column = 1
    tokens = []
    lexer_initialized = true
    success = true
end

# Get current character at position
make a function called current_char returns char
    if current_position < input_text.length then
        char = input_text[current_position]
    else
        char = nil
    end
end

# Peek at next character without advancing
make a function called peek_char takes offset returns char
    peek_pos = current_position + offset
    if peek_pos < input_text.length then
        char = input_text[peek_pos]
    else
        char = nil
    end
end

# Advance position and update line/column tracking
make a function called advance_position returns advanced
    if current_position < input_text.length then
        char = input_text[current_position]
        current_position = current_position + 1
        
        if char = "\n" then
            current_line = current_line + 1
            current_column = 1
        else
            current_column = current_column + 1
        end
        
        advanced = true
    else
        advanced = false
    end
end

# Check if at end of input
make a function called at_end_of_input returns at_end
    at_end = (current_position >= input_text.length)
end

# Get current position info
make a function called get_current_position returns position
    position = create_position(current_line, current_column, current_position)
end

# =============================================================================
# CHARACTER ITERATION AND TEXT EXTRACTION
# =============================================================================

# Skip whitespace characters
make a function called skip_whitespace returns skipped_count
    skipped_count = 0
    char = current_char()
    
    while char != nil and is_whitespace(char) do
        advance_position()
        skipped_count = skipped_count + 1
        char = current_char()
    end
end

# Extract text while condition is true
make a function called extract_while takes condition_func returns extracted_text
    start_pos = current_position
    extracted_text = ""
    char = current_char()
    
    while char != nil and condition_func(char) do
        extracted_text = extracted_text + char
        advance_position()
        char = current_char()
    end
end

# Extract number token text
make a function called extract_number returns number_text
    number_text = ""
    char = current_char()
    dot_seen = false
    
    # Extract digits and optional decimal point
    while char != nil and (is_digit(char) or char = ".") do
        if char = "." then
            if dot_seen then
                # Second dot - stop here
                break
            else
                dot_seen = true
            end
        end
        
        number_text = number_text + char
        advance_position()
        char = current_char()
    end
end

# Extract identifier token text
make a function called extract_identifier returns identifier_text
    identifier_text = ""
    char = current_char()
    
    # First character must be letter or underscore
    if can_start_identifier(char) then
        identifier_text = identifier_text + char
        advance_position()
        char = current_char()
        
        # Continue with alphanumeric and underscore
        while char != nil and can_be_in_identifier(char) do
            identifier_text = identifier_text + char
            advance_position()
            char = current_char()
        end
    end
end

# Extract string token text (including quotes)
make a function called extract_string returns string_text
    string_text = ""
    quote_char = current_char()
    
    if is_quote(quote_char) then
        string_text = string_text + quote_char
        advance_position()
        char = current_char()
        
        # Extract until matching quote or end of input
        while char != nil and char != quote_char do
            string_text = string_text + char
            advance_position()
            char = current_char()
        end
        
        # Add closing quote if found
        if char = quote_char then
            string_text = string_text + char
            advance_position()
        end
    end
end

# =============================================================================
# GOAL-ORIENTED TOKENIZATION FRAMEWORK
# =============================================================================

# Primary tokenization goal
goal tokenize_input_text {
    precondition: lexer_initialized = true and input_text != "",
    postcondition: tokens != [] and tokens[tokens.length - 1].type = "EOF"
}

# Token recognition goals
goal recognize_next_token {
    precondition: not at_end_of_input(),
    postcondition: tokens.length > 0
}

goal handle_end_of_input {
    precondition: at_end_of_input(),
    postcondition: tokens[tokens.length - 1].type = "EOF"
}

# =============================================================================
# BASIC TOKENIZATION IMPLEMENTATION
# =============================================================================

# Main tokenization function
make a function called tokenize takes input returns token_list
    initialize_lexer(input)
    
    # Process all characters
    while not at_end_of_input() do
        skip_whitespace()
        
        if not at_end_of_input() then
            token = recognize_single_token()
            if token != nil then
                tokens = tokens + [token]
            end
        end
    end
    
    # Add EOF token
    eof_token = create_eof_token(get_current_position())
    tokens = tokens + [eof_token]
    
    token_list = tokens
end

# Recognize a single token at current position
make a function called recognize_single_token returns token
    position = get_current_position()
    char = current_char()
    token = nil
    
    if char != nil then
        # Try single character tokens first
        if single_char_token(char, token_type) then
            advance_position()
            token = create_token(token_type, char, position.line, position.column, position.absolute)
        else
            # Try multi-character tokens
            if is_digit(char) then
                token = recognize_number_token()
            else
                if can_start_identifier(char) then
                    token = recognize_identifier_or_keyword_token()
                else
                    if is_quote(char) then
                        token = recognize_string_token()
                    else
                        # Unknown character - create unknown token
                        token = create_unknown_token(char, position)
                        advance_position()
                    end
                end
            end
        end
    end
end

# Recognize number token
make a function called recognize_number_token returns token
    position = get_current_position()
    number_text = extract_number()
    
    if number_text != "" then
        token = create_token("NUMBER", number_text, position.line, position.column, position.absolute)
    else
        token = nil
    end
end

# Recognize identifier or keyword token
make a function called recognize_identifier_or_keyword_token returns token
    position = get_current_position()
    identifier_text = extract_identifier()
    
    if identifier_text != "" then
        # Check if it's a keyword
        if keyword_pattern(identifier_text, keyword_type) then
            token = create_token(keyword_type, identifier_text, position.line, position.column, position.absolute)
        else
            token = create_token("IDENTIFIER", identifier_text, position.line, position.column, position.absolute)
        end
    else
        token = nil
    end
end

# Recognize string token
make a function called recognize_string_token returns token
    position = get_current_position()
    string_text = extract_string()
    
    if string_text != "" then
        # Check if string is properly terminated
        if is_quoted_string(string_text) then
            token = create_token("STRING", string_text, position.line, position.column, position.absolute)
        else
            # Unterminated string
            token = create_token("UNTERMINATED_STRING", string_text, position.line, position.column, position.absolute)
        end
    else
        token = nil
    end
end

# =============================================================================
# ERROR HANDLING - "NEVER FAIL, ALWAYS TOKEN" PRINCIPLE
# =============================================================================

# Error handling goal
goal handle_lexical_error {
    precondition: true,  # Always available
    postcondition: tokens.length > 0  # Always produces a token
}

# Handle unrecognized character gracefully
make a function called handle_unknown_character takes char, position returns token
    # Create unknown token but continue parsing
    token = create_unknown_token(char, position)
    advance_position()  # Skip the problematic character
    token
end

# Handle incomplete tokens gracefully
make a function called handle_incomplete_token takes partial_text, position, expected_type returns token
    if expected_type = "string" then
        token = create_token("UNTERMINATED_STRING", partial_text, position.line, position.column, position.absolute)
    else
        token = create_token("UNKNOWN", partial_text, position.line, position.column, position.absolute)
    end
end

# =============================================================================
# LEXER UTILITY FUNCTIONS
# =============================================================================

# Get total number of tokens produced
make a function called get_token_count returns count
    count = tokens.length
end

# Get token at specific index
make a function called get_token takes index returns token
    if index >= 0 and index < tokens.length then
        token = tokens[index]
    else
        token = nil
    end
end

# Check if tokenization was successful
make a function called tokenization_successful returns success
    success = (tokens.length > 0 and tokens[tokens.length - 1].type = "EOF")
end

# Get lexer statistics
make a function called get_lexer_stats returns stats
    stats = {
        total_tokens: tokens.length,
        lines_processed: current_line,
        characters_processed: current_position,
        unknown_tokens: 0,
        successful: tokenization_successful()
    }
    
    # Count unknown tokens
    i = 0
    while i < tokens.length do
        if tokens[i].type = "UNKNOWN" or tokens[i].type = "UNTERMINATED_STRING" then
            stats.unknown_tokens = stats.unknown_tokens + 1
        end
        i = i + 1
    end
end

# =============================================================================
# DEBUGGING AND INTROSPECTION
# =============================================================================

# Print token for debugging
make a function called print_token takes token returns output
    output = token.type + ": '" + token.value + "' at line " + token.line + ", column " + token.column
end

# Print all tokens for debugging
make a function called print_all_tokens returns output
    output = "Tokens:\n"
    i = 0
    while i < tokens.length do
        token_info = print_token(tokens[i])
        output = output + "  " + token_info + "\n"
        i = i + 1
    end
end

# Get lexer state for debugging
make a function called get_lexer_state returns state
    state = {
        input_length: input_text.length,
        current_position: current_position,
        current_line: current_line,
        current_column: current_column,
        tokens_generated: tokens.length,
        at_end: at_end_of_input(),
        initialized: lexer_initialized
    }
end

# =============================================================================
# MAIN LEXER INTERFACE
# =============================================================================

# Primary interface function - tokenize input text and return tokens
make a function called lex takes source_text returns result
    if source_text = nil or source_text = "" then
        result = {
            success: false,
            tokens: [],
            error: "Empty or nil input text",
            stats: {}
        }
    else
        token_list = tokenize(source_text)
        stats = get_lexer_stats()
        
        result = {
            success: stats.successful,
            tokens: token_list,
            error: nil,
            stats: stats
        }
    end
end