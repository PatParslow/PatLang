# =============================================================================
# NATIVE PATLANG LEXER - TEST SUITE FOUNDATION
# Phase 1: Foundation Components Testing
# =============================================================================

# Comprehensive test suite for validating native PaTLang lexer functionality
# Tests core components: token system, lexical patterns, and basic lexer framework

# Enable reasoning mode for test validation
reasoning mode on

# =============================================================================
# TEST STATE AND RESULTS TRACKING
# =============================================================================

# Test tracking variables
tests_run = 0
tests_passed = 0
tests_failed = 0
test_results = []

# =============================================================================
# TEST UTILITY FUNCTIONS
# =============================================================================

# Initialize test environment
make a function called initialize_tests returns initialized
    tests_run = 0
    tests_passed = 0
    tests_failed = 0
    test_results = []
    initialized = true
end

# Record test result
make a function called record_test takes test_name, passed, details returns recorded
    tests_run = tests_run + 1
    
    if passed then
        tests_passed = tests_passed + 1
    else
        tests_failed = tests_failed + 1
    end
    
    result = {
        name: test_name,
        passed: passed,
        details: details,
        index: tests_run
    }
    
    test_results = test_results + [result]
    recorded = true
end

# Assert equality with detailed reporting
make a function called assert_equals takes expected, actual, test_name returns passed
    passed = (expected = actual)
    
    if passed then
        details = "Expected: " + expected + ", Got: " + actual + " ✓"
    else
        details = "Expected: " + expected + ", Got: " + actual + " ✗"
    end
    
    record_test(test_name, passed, details)
end

# Assert truth with detailed reporting
make a function called assert_true takes condition, test_name returns passed
    passed = (condition = true)
    
    if passed then
        details = "Condition evaluated to true ✓"
    else
        details = "Condition evaluated to false ✗"
    end
    
    record_test(test_name, passed, details)
end

# Assert not nil
make a function called assert_not_nil takes value, test_name returns passed
    passed = (value != nil)
    
    if passed then
        details = "Value is not nil ✓"
    else
        details = "Value is nil ✗"
    end
    
    record_test(test_name, passed, details)
end

# =============================================================================
# TOKEN SYSTEM TESTS
# =============================================================================

# Test basic token creation
make a function called test_token_creation returns success
    # Test creating a simple token
    token = create_token("NUMBER", "123", 1, 5, 4)
    
    assert_equals("NUMBER", token.type, "Token type assignment")
    assert_equals("123", token.value, "Token value assignment")
    assert_equals(1, token.line, "Token line tracking")
    assert_equals(5, token.column, "Token column tracking")
    assert_equals(4, token.absolute, "Token absolute position")
    
    success = true
end

# Test position creation
make a function called test_position_creation returns success
    position = create_position(10, 15, 150)
    
    assert_equals(10, position.line, "Position line assignment")
    assert_equals(15, position.column, "Position column assignment")
    assert_equals(150, position.absolute, "Position absolute assignment")
    
    success = true
end

# Test EOF token creation
make a function called test_eof_token_creation returns success
    position = create_position(5, 1, 50)
    eof_token = create_eof_token(position)
    
    assert_equals("EOF", eof_token.type, "EOF token type")
    assert_equals("", eof_token.value, "EOF token value")
    assert_equals(5, eof_token.line, "EOF token line")
    
    success = true
end

# Test unknown token creation
make a function called test_unknown_token_creation returns success
    position = create_position(3, 7, 25)
    unknown_token = create_unknown_token("@", position)
    
    assert_equals("UNKNOWN", unknown_token.type, "Unknown token type")
    assert_equals("@", unknown_token.value, "Unknown token value")
    assert_equals(3, unknown_token.line, "Unknown token line")
    
    success = true
end

# =============================================================================
# LEXICAL PATTERN TESTS
# =============================================================================

# Test character classification
make a function called test_character_classification returns success
    # Test digit classification
    assert_true(is_digit("5"), "Digit classification - 5")
    assert_true(is_digit("0"), "Digit classification - 0")
    assert_true(is_digit("9"), "Digit classification - 9")
    
    # Test letter classification
    assert_true(is_letter("a"), "Letter classification - a")
    assert_true(is_letter("Z"), "Letter classification - Z")
    assert_true(is_letter("m"), "Letter classification - m")
    
    # Test whitespace classification
    assert_true(is_whitespace(" "), "Whitespace classification - space")
    assert_true(is_whitespace("\n"), "Whitespace classification - newline")
    assert_true(is_whitespace("\t"), "Whitespace classification - tab")
    
    success = true
end

# Test number pattern recognition
make a function called test_number_patterns returns success
    # Test simple integers
    assert_true(is_valid_number("123"), "Simple integer - 123")
    assert_true(is_valid_number("0"), "Single digit - 0")
    assert_true(is_valid_number("999"), "Multiple digits - 999")
    
    # Test decimal numbers
    assert_true(is_valid_number("123.45"), "Decimal number - 123.45")
    assert_true(is_valid_number("0.5"), "Decimal starting with 0 - 0.5")
    assert_true(is_valid_number("99.99"), "Two digit decimal - 99.99")
    
    # Test invalid numbers
    assert_true(not is_valid_number("123.45.67"), "Multiple dots invalid")
    assert_true(not is_valid_number("abc"), "Letters not valid number")
    assert_true(not is_valid_number("12a3"), "Mixed alphanumeric invalid")
    
    success = true
end

# Test identifier pattern recognition
make a function called test_identifier_patterns returns success
    # Test valid identifiers
    assert_true(is_valid_identifier("hello"), "Simple identifier - hello")
    assert_true(is_valid_identifier("_private"), "Underscore start - _private")
    assert_true(is_valid_identifier("var123"), "Alphanumeric - var123")
    assert_true(is_valid_identifier("my_variable"), "With underscore - my_variable")
    
    # Test invalid identifiers
    assert_true(not is_valid_identifier("123abc"), "Starting with digit invalid")
    assert_true(not is_valid_identifier(""), "Empty string invalid")
    assert_true(not is_valid_identifier("hello-world"), "Hyphen invalid")
    
    success = true
end

# Test string pattern recognition
make a function called test_string_patterns returns success
    # Test valid strings
    assert_true(is_quoted_string("\"hello\""), "Double quoted string")
    assert_true(is_quoted_string("'world'"), "Single quoted string")
    assert_true(is_quoted_string("\"\""), "Empty double quoted string")
    assert_true(is_quoted_string("''"), "Empty single quoted string")
    
    # Test invalid strings
    assert_true(not is_quoted_string("hello"), "Unquoted string invalid")
    assert_true(not is_quoted_string("\"hello'"), "Mismatched quotes invalid")
    assert_true(not is_quoted_string("\"hello"), "Unterminated string invalid")
    
    success = true
end

# Test keyword recognition
make a function called test_keyword_recognition returns success
    # Test PaTLang keywords
    assert_true(keyword_pattern("make", "MAKE"), "Make keyword")
    assert_true(keyword_pattern("function", "FUNCTION"), "Function keyword")
    assert_true(keyword_pattern("if", "IF"), "If keyword")
    assert_true(keyword_pattern("end", "END"), "End keyword")
    assert_true(keyword_pattern("reasoning", "REASONING"), "Reasoning keyword")
    
    # Test non-keywords
    assert_true(not keyword_pattern("hello", _), "Regular identifier not keyword")
    assert_true(not keyword_pattern("xyz123", _), "Alphanumeric not keyword")
    
    success = true
end

# =============================================================================
# BASIC LEXER FRAMEWORK TESTS
# =============================================================================

# Test lexer initialization
make a function called test_lexer_initialization returns success
    result = initialize_lexer("test input")
    
    assert_true(result, "Lexer initialization successful")
    assert_equals("test input", input_text, "Input text stored correctly")
    assert_equals(0, current_position, "Position initialized to 0")
    assert_equals(1, current_line, "Line initialized to 1")
    assert_equals(1, current_column, "Column initialized to 1")
    assert_true(lexer_initialized, "Lexer marked as initialized")
    
    success = true
end

# Test position tracking
make a function called test_position_tracking returns success
    initialize_lexer("abc\ndef")
    
    # Test initial position
    assert_equals("a", current_char(), "Initial character correct")
    
    # Test advancing through characters
    advance_position()
    assert_equals("b", current_char(), "Second character correct")
    assert_equals(2, current_column, "Column advanced correctly")
    
    advance_position()
    assert_equals("c", current_char(), "Third character correct")
    
    advance_position()
    assert_equals("\n", current_char(), "Newline character correct")
    
    advance_position()
    assert_equals(2, current_line, "Line advanced after newline")
    assert_equals(1, current_column, "Column reset after newline")
    assert_equals("d", current_char(), "Character after newline correct")
    
    success = true
end

# Test simple tokenization
make a function called test_simple_tokenization returns success
    # Test tokenizing simple arithmetic
    result = lex("123 + 456")
    
    assert_true(result.success, "Simple tokenization successful")
    assert_not_nil(result.tokens, "Tokens array created")
    assert_true(result.tokens.length >= 4, "Expected minimum tokens (NUMBER PLUS NUMBER EOF)")
    
    # Check specific tokens
    if result.tokens.length >= 4 then
        assert_equals("NUMBER", result.tokens[0].type, "First token is NUMBER")
        assert_equals("123", result.tokens[0].value, "First token value correct")
        assert_equals("PLUS", result.tokens[1].type, "Second token is PLUS")
        assert_equals("NUMBER", result.tokens[2].type, "Third token is NUMBER")
        assert_equals("456", result.tokens[2].value, "Third token value correct")
        assert_equals("EOF", result.tokens[result.tokens.length - 1].type, "Last token is EOF")
    end
    
    success = true
end

# Test identifier tokenization
make a function called test_identifier_tokenization returns success
    result = lex("hello world")
    
    assert_true(result.success, "Identifier tokenization successful")
    assert_true(result.tokens.length >= 3, "Expected minimum tokens (IDENTIFIER IDENTIFIER EOF)")
    
    if result.tokens.length >= 3 then
        assert_equals("IDENTIFIER", result.tokens[0].type, "First token is IDENTIFIER")
        assert_equals("hello", result.tokens[0].value, "First identifier correct")
        assert_equals("IDENTIFIER", result.tokens[1].type, "Second token is IDENTIFIER")
        assert_equals("world", result.tokens[1].value, "Second identifier correct")
    end
    
    success = true
end

# Test keyword tokenization
make a function called test_keyword_tokenization returns success
    result = lex("if true then")
    
    assert_true(result.success, "Keyword tokenization successful")
    
    if result.tokens.length >= 4 then
        assert_equals("IF", result.tokens[0].type, "If keyword recognized")
        assert_equals("TRUE", result.tokens[1].type, "True keyword recognized")
        assert_equals("THEN", result.tokens[2].type, "Then keyword recognized")
    end
    
    success = true
end

# Test string tokenization
make a function called test_string_tokenization returns success
    result = lex("\"hello world\"")
    
    assert_true(result.success, "String tokenization successful")
    
    if result.tokens.length >= 2 then
        assert_equals("STRING", result.tokens[0].type, "String token recognized")
        assert_equals("\"hello world\"", result.tokens[0].value, "String value includes quotes")
    end
    
    success = true
end

# Test error handling
make a function called test_error_handling returns success
    # Test with unrecognized characters
    result = lex("123 @ 456")
    
    assert_true(result.success, "Error handling maintains success")
    assert_not_nil(result.tokens, "Tokens still generated with errors")
    
    # Should have NUMBER, UNKNOWN, NUMBER, EOF
    if result.tokens.length >= 4 then
        assert_equals("NUMBER", result.tokens[0].type, "Number before error token")
        assert_equals("UNKNOWN", result.tokens[1].type, "Unknown token created for @")
        assert_equals("@", result.tokens[1].value, "Unknown token value correct")
        assert_equals("NUMBER", result.tokens[2].type, "Number after error token")
    end
    
    success = true
end

# =============================================================================
# TEST RUNNER AND REPORTING
# =============================================================================

# Run all foundation tests
make a function called run_all_tests returns test_summary
    initialize_tests()
    
    # Run token system tests
    test_token_creation()
    test_position_creation()
    test_eof_token_creation()
    test_unknown_token_creation()
    
    # Run lexical pattern tests
    test_character_classification()
    test_number_patterns()
    test_identifier_patterns()
    test_string_patterns()
    test_keyword_recognition()
    
    # Run basic lexer framework tests
    test_lexer_initialization()
    test_position_tracking()
    test_simple_tokenization()
    test_identifier_tokenization()
    test_keyword_tokenization()
    test_string_tokenization()
    test_error_handling()
    
    test_summary = generate_test_report()
end

# Generate comprehensive test report
make a function called generate_test_report returns report
    pass_rate = 0
    if tests_run > 0 then
        pass_rate = (tests_passed * 100) / tests_run
    end
    
    report = {
        total_tests: tests_run,
        tests_passed: tests_passed,
        tests_failed: tests_failed,
        pass_rate: pass_rate,
        success: (tests_failed = 0),
        details: test_results
    }
end

# Print test report
make a function called print_test_report takes report returns output
    output = "=== Native PaTLang Lexer Test Report ===\n"
    output = output + "Total Tests: " + report.total_tests + "\n"
    output = output + "Passed: " + report.tests_passed + "\n"
    output = output + "Failed: " + report.tests_failed + "\n"
    output = output + "Pass Rate: " + report.pass_rate + "%\n"
    output = output + "Overall: " + (if report.success then "SUCCESS" else "FAILURE") + "\n\n"
    
    output = output + "Test Details:\n"
    i = 0
    while i < report.details.length do
        test = report.details[i]
        status = if test.passed then "PASS" else "FAIL"
        output = output + "  " + test.index + ". " + test.name + " - " + status + "\n"
        output = output + "     " + test.details + "\n"
        i = i + 1
    end
end

# =============================================================================
# MAIN TEST EXECUTION
# =============================================================================

# Execute all tests and display results
make a function called main_test_execution returns final_result
    test_summary = run_all_tests()
    test_output = print_test_report(test_summary)
    
    final_result = {
        summary: test_summary,
        output: test_output,
        ready_for_phase_2: test_summary.success
    }
end