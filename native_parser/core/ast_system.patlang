# AST System - Core AST node definitions and factories
# Type-safe AST construction with PaTLang constraints

# AST Node type constraints and definitions
constrain ast_node :: ASTNode where {
    type :: String,
    valid :: Boolean,
    source_location :: Location,
    children :: [ASTNode]
}

constrain expression_node :: ExpressionNode extends ASTNode where {
    expression_type :: String,
    value :: Any
}

constrain statement_node :: StatementNode extends ASTNode where {
    statement_type :: String
}

constrain program_node :: ProgramNode extends ASTNode where {
    statements :: [StatementNode]
}

# Location tracking for source positions
constrain location :: Location where {
    line :: Number,
    column :: Number,
    absolute_position :: Number,
    filename :: String
}

# AST node factory goals
goal create_expression_ast(tokens, context) {
    precondition: tokens != [] and tokens[0].type in expression_tokens,
    postcondition: result.type == "Expression" and result.valid == true,
    strategy: expression_construction
}

goal create_statement_ast(tokens, context) {
    precondition: tokens != [] and tokens[0].type in statement_tokens,
    postcondition: result.type == "Statement" and result.valid == true,
    strategy: statement_construction
}

goal validate_ast_tree(ast_node) {
    precondition: ast_node != null,
    postcondition: validation_result.complete == true,
    strategy: recursive_validation
}

# Core AST node creation rules
rule create_binary_operation_node(left, operator, right, result) :-
    valid_binary_operator(operator),
    validate_operand(left),
    validate_operand(right),
    result = {
        type: "BinaryOperation",
        operator: operator,
        left: left,
        right: right,
        valid: true,
        source_location: merge_locations([left.source_location, right.source_location])
    }.

rule create_unary_operation_node(operator, operand, result) :-
    valid_unary_operator(operator),
    validate_operand(operand),
    result = {
        type: "UnaryOperation",
        operator: operator,
        operand: operand,
        valid: true,
        source_location: operand.source_location
    }.

rule create_literal_node(token, result) :-
    token.type in ["NUMBER", "STRING", "TRUE", "FALSE"],
    result = {
        type: "Literal",
        value: token.value,
        literal_type: token.type,
        valid: true,
        source_location: token.position
    }.

rule create_identifier_node(token, result) :-
    token.type == "IDENTIFIER",
    result = {
        type: "Identifier",
        name: token.value,
        valid: true,
        source_location: token.position
    }.

rule create_function_definition_node(name, parameters, body, result) :-
    validate_identifier(name),
    validate_parameter_list(parameters),
    validate_function_body(body),
    result = {
        type: "FunctionDefinition",
        name: name,
        parameters: parameters,
        body: body,
        valid: true,
        source_location: name.source_location
    }.

rule create_function_call_node(function_name, arguments, result) :-
    validate_identifier(function_name),
    validate_argument_list(arguments),
    result = {
        type: "FunctionCall",
        function: function_name,
        arguments: arguments,
        valid: true,
        source_location: function_name.source_location
    }.

rule create_assignment_node(target, value, result) :-
    validate_assignment_target(target),
    validate_expression(value),
    result = {
        type: "Assignment",
        target: target,
        value: value,
        valid: true,
        source_location: target.source_location
    }.

rule create_conditional_node(condition, then_branch, else_branch, result) :-
    validate_expression(condition),
    validate_statement_block(then_branch),
    (else_branch == null or validate_statement_block(else_branch)),
    result = {
        type: "Conditional",
        condition: condition,
        then_branch: then_branch,
        else_branch: else_branch,
        valid: true,
        source_location: condition.source_location
    }.

rule create_while_loop_node(condition, body, result) :-
    validate_expression(condition),
    validate_statement_block(body),
    result = {
        type: "WhileLoop",
        condition: condition,
        body: body,
        valid: true,
        source_location: condition.source_location
    }.

# Reasoning construct AST nodes
rule create_fact_node(predicate, arguments, result) :-
    validate_predicate(predicate),
    validate_argument_list(arguments),
    result = {
        type: "Fact",
        predicate: predicate,
        arguments: arguments,
        valid: true,
        source_location: predicate.source_location
    }.

rule create_rule_node(head, body, result) :-
    validate_rule_head(head),
    validate_rule_body(body),
    result = {
        type: "Rule",
        head: head,
        body: body,
        valid: true,
        source_location: head.source_location
    }.

rule create_goal_node(name, precondition, postcondition, strategy, result) :-
    validate_identifier(name),
    validate_goal_condition(precondition),
    validate_goal_condition(postcondition),
    result = {
        type: "Goal",
        name: name,
        precondition: precondition,
        postcondition: postcondition,
        strategy: strategy,
        valid: true,
        source_location: name.source_location
    }.

# Type constraint AST nodes
rule create_constraint_node(variable, type_spec, conditions, result) :-
    validate_identifier(variable),
    validate_type_specification(type_spec),
    validate_constraint_conditions(conditions),
    result = {
        type: "TypeConstraint",
        variable: variable,
        type_specification: type_spec,
        conditions: conditions,
        valid: true,
        source_location: variable.source_location
    }.

# AST validation rules
rule validate_node_structure(node) :-
    node.type != "",
    node.valid != null,
    node.source_location != null.

rule validate_node_semantics(node, context) :-
    validate_node_structure(node),
    validate_node_type_specific(node, context).

rule validate_node_type_specific(node, context) :-
    node.type == "BinaryOperation",
    validate_binary_operation_semantics(node, context).

rule validate_node_type_specific(node, context) :-
    node.type == "FunctionCall",
    validate_function_call_semantics(node, context).

rule validate_node_type_specific(node, context) :-
    node.type == "Identifier",
    validate_identifier_semantics(node, context).

# AST utility functions
rule merge_locations(locations, result) :-
    locations != [],
    start_location = locations[0],
    end_location = locations[locations.length - 1],
    result = {
        line: start_location.line,
        column: start_location.column,
        absolute_position: start_location.absolute_position,
        end_line: end_location.line,
        end_column: end_location.column,
        filename: start_location.filename
    }.

rule copy_ast_node(node, copied_node) :-
    copied_node = {
        type: node.type,
        valid: node.valid,
        source_location: node.source_location
    },
    copy_node_specific_fields(node, copied_node).

# Ruby AST compatibility interface
rule convert_to_ruby_ast(patlang_node, ruby_node) :-
    ruby_node = {
        type: map_node_type_to_ruby(patlang_node.type),
        children: convert_children_to_ruby(patlang_node.children),
        source_location: patlang_node.source_location
    }.

rule map_node_type_to_ruby(patlang_type, ruby_type) :-
    node_type_mapping(patlang_type, ruby_type).

# Node type mappings for Ruby compatibility
fact node_type_mapping("BinaryOperation", "BinaryOpNode")
fact node_type_mapping("UnaryOperation", "UnaryOpNode")
fact node_type_mapping("Literal", "LiteralNode")
fact node_type_mapping("Identifier", "IdentifierNode")
fact node_type_mapping("FunctionDefinition", "FunctionDefNode")
fact node_type_mapping("FunctionCall", "FunctionCallNode")
fact node_type_mapping("Assignment", "AssignmentNode")
fact node_type_mapping("Conditional", "ConditionalNode")
fact node_type_mapping("WhileLoop", "WhileLoopNode")

# Validation helper predicates
fact expression_tokens(["NUMBER", "STRING", "IDENTIFIER", "TRUE", "FALSE", "LPAREN"])
fact statement_tokens(["IDENTIFIER", "IF", "WHILE", "MAKE", "FACT", "RULE", "GOAL"])
fact valid_binary_operators(["+", "-", "*", "/", "%", "==", "!=", "<", ">", "<=", ">=", "and", "or"])
fact valid_unary_operators(["-", "not"])

rule valid_binary_operator(op) :- op in valid_binary_operators.
rule valid_unary_operator(op) :- op in valid_unary_operators.

# Enhanced validation predicates for Phase 1 integration
rule validate_operand(operand) :-
    operand != null,
    operand.type in expression_types,
    operand.valid == true.

rule validate_assignment_target(target) :-
    target.type == "Identifier",
    target.name != "",
    target.valid == true.

rule validate_expression(expr) :-
    expr != null,
    expr.type in expression_types,
    expr.valid == true.

rule validate_statement_block(block) :-
    block != null,
    (block.type == "Block" or block.type == "Statement"),
    block.valid == true.

rule validate_identifier(identifier) :-
    identifier.type == "Identifier",
    identifier.name != "",
    identifier.valid == true.

rule validate_parameter_list(params) :-
    params != null,
    all_valid_identifiers(params).

rule validate_function_body(body) :-
    body != null,
    (body.type == "Block" or body.type == "Statement"),
    body.valid == true.

rule validate_argument_list(args) :-
    args != null,
    all_valid_expressions(args).

rule validate_predicate(predicate) :-
    predicate.type == "Identifier",
    predicate.name != "",
    predicate.valid == true.

rule validate_rule_head(head) :-
    head != null,
    head.type in ["Fact", "Predicate"],
    head.valid == true.

rule validate_rule_body(body) :-
    body != null,
    body.type in ["Conjunction", "Disjunction", "Predicate"],
    body.valid == true.

rule validate_goal_condition(condition) :-
    condition != null,
    condition.type in ["Expression", "Predicate", "Conjunction"],
    condition.valid == true.

rule validate_type_specification(type_spec) :-
    type_spec != null,
    type_spec.type == "TypeSpecification",
    type_spec.valid == true.

rule validate_constraint_conditions(conditions) :-
    conditions != null,
    all_valid_expressions(conditions).

# Helper validation predicates
rule all_valid_identifiers([]).
rule all_valid_identifiers([head | tail]) :-
    validate_identifier(head),
    all_valid_identifiers(tail).

rule all_valid_expressions([]).
rule all_valid_expressions([head | tail]) :-
    validate_expression(head),
    all_valid_expressions(tail).

# Semantic validation by node type
rule validate_binary_operation_semantics(node, context) :-
    validate_operand(node.left),
    validate_operand(node.right),
    compatible_operand_types(node.left, node.right, node.operator).

rule validate_function_call_semantics(node, context) :-
    function_declared_in_context(node.function_name, context),
    validate_argument_count(node.function_name, node.arguments, context).

rule validate_identifier_semantics(node, context) :-
    (variable_declared_in_context(node.name, context) or
     function_declared_in_context(node.name, context)).

# Utility functions for node operations
rule copy_node_specific_fields(node, copied_node) :-
    node.type == "BinaryOperation",
    copied_node.operator = node.operator,
    copied_node.left = node.left,
    copied_node.right = node.right.

rule copy_node_specific_fields(node, copied_node) :-
    node.type == "Identifier",
    copied_node.name = node.name.

rule copy_node_specific_fields(node, copied_node) :-
    node.type == "Literal",
    copied_node.value = node.value,
    copied_node.literal_type = node.literal_type.

# AST traversal and transformation utilities
rule traverse_ast_depth_first(node, visitor_function, result) :-
    apply_visitor_to_node(visitor_function, node, node_result),
    traverse_children_depth_first(node.children, visitor_function, children_results),
    combine_traversal_results(node_result, children_results, result).

rule transform_ast_node(node, transformation_rules, transformed_node) :-
    find_applicable_transformation(node, transformation_rules, applicable_rule),
    (applicable_rule != null ->
        apply_transformation_rule(applicable_rule, node, transformed_node)
    ;
        transformed_node = node
    ).

# AST statistics and debugging
fact total_nodes_created(0)
fact validation_failures(0)

rule increment_node_count() :-
    total_nodes_created = total_nodes_created + 1.

rule increment_validation_failures() :-
    validation_failures = validation_failures + 1.

# AST system initialization
initialize_ast_system() {
    print("AST System initialized"),
    print("Type-safe AST construction ready"),
    print("Ruby compatibility interface active")
end