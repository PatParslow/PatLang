# Grammar Engine - Logic-based grammar rule processing
# Complete PaTLang grammar definition using logic programming

# Core grammar rule facts - PaTLang grammar specification
fact grammar_rule("program", ["statement_list"])
fact grammar_rule("statement_list", ["statement", "statement_list"])
fact grammar_rule("statement_list", ["statement"])

# Expression grammar rules
fact grammar_rule("expression", ["logical_or"])
fact grammar_rule("logical_or", ["logical_and", "('or'", "logical_and)*"])
fact grammar_rule("logical_and", ["equality", "('and'", "equality)*"])
fact grammar_rule("equality", ["comparison", "(('==' | '!=') comparison)*"])
fact grammar_rule("comparison", ["term", "(('<' | '>' | '<=' | '>=') term)*"])
fact grammar_rule("term", ["factor", "(('+' | '-') factor)*"])
fact grammar_rule("factor", ["unary", "(('*' | '/' | '%') unary)*"])
fact grammar_rule("unary", ["('not' | '-') unary"])
fact grammar_rule("unary", ["primary"])
fact grammar_rule("primary", ["NUMBER", "|", "STRING", "|", "TRUE", "|", "FALSE", "|", "IDENTIFIER", "|", "function_call", "|", "'(' expression ')'"])

# Statement grammar rules
fact grammar_rule("statement", ["assignment_statement"])
fact grammar_rule("statement", ["expression_statement"])
fact grammar_rule("statement", ["function_definition"])
fact grammar_rule("statement", ["conditional_statement"])
fact grammar_rule("statement", ["while_statement"])
fact grammar_rule("statement", ["reasoning_statement"])
fact grammar_rule("statement", ["constraint_statement"])

# Assignment statement
fact grammar_rule("assignment_statement", ["IDENTIFIER", "'='", "expression"])

# Expression statement
fact grammar_rule("expression_statement", ["expression"])

# Function definition - Natural language syntax
fact grammar_rule("function_definition", ["'make'", "'a'", "'function'", "'called'", "IDENTIFIER", "parameter_clause?", "return_clause?", "function_body", "'end'"])
fact grammar_rule("parameter_clause", ["'takes'", "parameter_list"])
fact grammar_rule("parameter_list", ["IDENTIFIER", "(',' IDENTIFIER)*"])
fact grammar_rule("return_clause", ["'returns'", "expression"])
fact grammar_rule("function_body", ["statement_list"])

# Function call
fact grammar_rule("function_call", ["IDENTIFIER", "'('", "argument_list?", "')'"])
fact grammar_rule("argument_list", ["expression", "(',' expression)*"])

# Conditional statement
fact grammar_rule("conditional_statement", ["'if'", "expression", "'then'", "statement_list", "else_clause?", "'end'"])
fact grammar_rule("else_clause", ["'else'", "statement_list"])

# While loop
fact grammar_rule("while_statement", ["'while'", "expression", "'do'", "statement_list", "'end'"])

# Reasoning constructs
fact grammar_rule("reasoning_statement", ["fact_statement", "|", "rule_statement", "|", "goal_statement", "|", "reasoning_mode_statement"])
fact grammar_rule("fact_statement", ["'fact'", "predicate", "'(' argument_list? ')'"])
fact grammar_rule("rule_statement", ["'rule'", "rule_head", "':-'", "rule_body"])
fact grammar_rule("goal_statement", ["'goal'", "IDENTIFIER", "goal_body"])
fact grammar_rule("reasoning_mode_statement", ["'reasoning'", "'mode'", "('on' | 'off')"])

# Rule components
fact grammar_rule("rule_head", ["predicate", "'(' argument_list? ')'"])
fact grammar_rule("rule_body", ["condition_list"])
fact grammar_rule("condition_list", ["condition", "(',' condition)*"])
fact grammar_rule("condition", ["predicate", "'(' argument_list? ')'"])
fact grammar_rule("predicate", ["IDENTIFIER"])

# Goal components
fact grammar_rule("goal_body", ["'{'", "goal_clauses", "'}'"])
fact grammar_rule("goal_clauses", ["precondition_clause?", "postcondition_clause?", "strategy_clause?"])
fact grammar_rule("precondition_clause", ["'precondition:'", "expression"])
fact grammar_rule("postcondition_clause", ["'postcondition:'", "expression"])
fact grammar_rule("strategy_clause", ["'strategy:'", "IDENTIFIER"])

# Type constraint statements
fact grammar_rule("constraint_statement", ["'constrain'", "constraint_definition"])
fact grammar_rule("constraint_definition", ["IDENTIFIER", "'::'", "type_specification", "constraint_conditions?"])
fact grammar_rule("type_specification", ["type_name", "constraint_modifiers?"])
fact grammar_rule("type_name", ["IDENTIFIER"])
fact grammar_rule("constraint_modifiers", ["'extends'", "IDENTIFIER"])
fact grammar_rule("constraint_conditions", ["'where'", "'{'", "condition_list", "'}'"])

# Operator precedence and associativity definitions
fact operator_precedence("or", 1)
fact operator_precedence("and", 2)
fact operator_precedence("==", 3)
fact operator_precedence("!=", 3)
fact operator_precedence("<", 4)
fact operator_precedence(">", 4)
fact operator_precedence("<=", 4)
fact operator_precedence(">=", 4)
fact operator_precedence("+", 5)
fact operator_precedence("-", 5)
fact operator_precedence("*", 6)
fact operator_precedence("/", 6)
fact operator_precedence("%", 6)
fact operator_precedence("not", 7)
fact operator_precedence("-", 7)  # Unary minus

fact operator_associativity("or", "left")
fact operator_associativity("and", "left")
fact operator_associativity("==", "left")
fact operator_associativity("!=", "left")
fact operator_associativity("<", "left")
fact operator_associativity(">", "left")
fact operator_associativity("<=", "left")
fact operator_associativity(">=", "left")
fact operator_associativity("+", "left")
fact operator_associativity("-", "left")
fact operator_associativity("*", "left")
fact operator_associativity("/", "left")
fact operator_associativity("%", "left")
fact operator_associativity("not", "right")
fact operator_associativity("-", "right")  # Unary minus

# Grammar rule application logic
# ==========================================
# WEEK 1: GRAMMAR ENGINE ACTIVATION SYSTEM
# ==========================================
# Transform static grammar rules into active parsing logic with PaTLang reasoning

# Core grammar activation goals - the primary interface for grammar-driven parsing
goal activate_grammar_rule(rule_name, tokens, position, context) {
    precondition: grammar_rule(rule_name, pattern) and position < tokens.length,
    postcondition: result.ast_node != nil and result.tokens_consumed > 0,
    strategy: recursive_descent_with_reasoning
}

goal apply_rule_with_context(rule_name, tokens, position, context) {
    precondition: grammar_rule(rule_name, pattern) and context.valid == true,
    postcondition: result.success == true and result.grammar_validated == true,
    strategy: context_aware_grammar_application
}

goal match_pattern_with_operators(tokens, position, pattern, context) {
    precondition: pattern != [] and position >= 0,
    postcondition: result.pattern_matched == true and result.ast_construction_valid == true,
    strategy: advanced_pattern_matching_with_backtracking
}

# Advanced rule application system with context awareness
rule activate_grammar_rule(rule_name, tokens, position, context, result) :-
    grammar_rule(rule_name, pattern),
    initialize_rule_context(context, rule_context),
    apply_pattern_with_reasoning(tokens, position, pattern, rule_context, pattern_result),
    construct_grammar_ast(rule_name, pattern_result, context, result).

rule apply_pattern_with_reasoning(tokens, position, pattern, context, result) :-
    validate_pattern_preconditions(tokens, position, pattern, context),
    match_pattern_with_advanced_operators(tokens, position, pattern, context, match_result),
    validate_pattern_postconditions(match_result, context),
    result = enhance_match_with_semantics(match_result, context).

rule initialize_rule_context(base_context, rule_context) :-
    rule_context = {
        parent_context: base_context,
        rule_depth: base_context.rule_depth + 1,
        backtrack_stack: [],
        semantic_annotations: {},
        error_recovery_points: [],
        performance_metrics: {
            start_time: current_time(),
            memory_usage: current_memory()
        }
    }.

# Pattern matching with advanced operators support
rule match_pattern_with_advanced_operators(tokens, position, pattern, context, result) :-
    expand_pattern_operators(pattern, expanded_pattern),
    apply_pattern_matching_strategy(tokens, position, expanded_pattern, context, strategy_result),
    optimize_match_result(strategy_result, context, result).

rule expand_pattern_operators(pattern, expanded_pattern) :-
    process_repetition_operators(pattern, step1_pattern),
    process_optional_operators(step1_pattern, step2_pattern),
    process_choice_operators(step2_pattern, step3_pattern),
    process_lookahead_operators(step3_pattern, expanded_pattern).

# Repetition operators: *, +
rule process_repetition_operators(pattern, processed_pattern) :-
    pattern = [head | tail],
    contains_repetition_operator(head, operator),
    operator == "*",
    base_pattern = extract_base_pattern(head),
    create_zero_or_more_pattern(base_pattern, zero_or_more_pattern),
    process_repetition_operators(tail, processed_tail),
    processed_pattern = [zero_or_more_pattern | processed_tail].

rule process_repetition_operators(pattern, processed_pattern) :-
    pattern = [head | tail],
    contains_repetition_operator(head, operator),
    operator == "+",
    base_pattern = extract_base_pattern(head),
    create_one_or_more_pattern(base_pattern, one_or_more_pattern),
    process_repetition_operators(tail, processed_tail),
    processed_pattern = [one_or_more_pattern | processed_tail].

rule process_repetition_operators(pattern, processed_pattern) :-
    pattern = [head | tail],
    not contains_repetition_operator(head, _),
    process_repetition_operators(tail, processed_tail),
    processed_pattern = [head | processed_tail].

rule process_repetition_operators([], []).

# Optional operators: ?
rule process_optional_operators(pattern, processed_pattern) :-
    pattern = [head | tail],
    contains_optional_operator(head),
    base_pattern = extract_base_pattern(head),
    create_optional_pattern(base_pattern, optional_pattern),
    process_optional_operators(tail, processed_tail),
    processed_pattern = [optional_pattern | processed_tail].

rule process_optional_operators(pattern, processed_pattern) :-
    pattern = [head | tail],
    not contains_optional_operator(head),
    process_optional_operators(tail, processed_tail),
    processed_pattern = [head | processed_tail].

rule process_optional_operators([], []).

# Choice operators: |
rule process_choice_operators(pattern, processed_pattern) :-
    pattern = [head | tail],
    contains_choice_operator(head),
    choice_alternatives = extract_choice_alternatives(head),
    create_choice_pattern(choice_alternatives, choice_pattern),
    process_choice_operators(tail, processed_tail),
    processed_pattern = [choice_pattern | processed_tail].

rule process_choice_operators(pattern, processed_pattern) :-
    pattern = [head | tail],
    not contains_choice_operator(head),
    process_choice_operators(tail, processed_tail),
    processed_pattern = [head | processed_tail].

rule process_choice_operators([], []).

# Advanced pattern matching strategies
rule apply_pattern_matching_strategy(tokens, position, pattern, context, result) :-
    determine_optimal_strategy(pattern, context, strategy),
    strategy == "linear_matching",
    apply_linear_pattern_matching(tokens, position, pattern, context, result).

rule apply_pattern_matching_strategy(tokens, position, pattern, context, result) :-
    determine_optimal_strategy(pattern, context, strategy),
    strategy == "backtracking_required",
    apply_backtracking_pattern_matching(tokens, position, pattern, context, result).

rule apply_pattern_matching_strategy(tokens, position, pattern, context, result) :-
    determine_optimal_strategy(pattern, context, strategy),
    strategy == "memoized_matching",
    apply_memoized_pattern_matching(tokens, position, pattern, context, result).

# Linear pattern matching for simple cases
rule apply_linear_pattern_matching(tokens, position, pattern, context, result) :-
    match_pattern_sequence_optimized(tokens, position, pattern, 0, context, sequence_result),
    validate_linear_match_result(sequence_result, context),
    result = sequence_result.

# Backtracking pattern matching for complex cases
rule apply_backtracking_pattern_matching(tokens, position, pattern, context, result) :-
    initialize_backtrack_state(tokens, position, pattern, context, backtrack_state),
    attempt_pattern_match_with_backtracking(backtrack_state, match_result),
    finalize_backtracking_result(match_result, context, result).

rule attempt_pattern_match_with_backtracking(backtrack_state, result) :-
    try_current_pattern_branch(backtrack_state, branch_result),
    branch_result.success == true,
    result = branch_result.

rule attempt_pattern_match_with_backtracking(backtrack_state, result) :-
    try_current_pattern_branch(backtrack_state, branch_result),
    branch_result.success == false,
    has_alternative_branches(backtrack_state),
    select_next_branch(backtrack_state, next_state),
    attempt_pattern_match_with_backtracking(next_state, result).

# Memoized pattern matching for performance optimization
rule apply_memoized_pattern_matching(tokens, position, pattern, context, result) :-
    generate_memoization_key(tokens, position, pattern, context, memo_key),
    lookup_memoized_result(memo_key, cached_result),
    cached_result != null,
    result = cached_result.

rule apply_memoized_pattern_matching(tokens, position, pattern, context, result) :-
    generate_memoization_key(tokens, position, pattern, context, memo_key),
    lookup_memoized_result(memo_key, cached_result),
    cached_result == null,
    apply_linear_pattern_matching(tokens, position, pattern, context, computed_result),
    store_memoized_result(memo_key, computed_result),
    result = computed_result.

# Enhanced pattern sequence matching with context
rule match_pattern_sequence_optimized(tokens, position, pattern, pattern_index, context, result) :-
    pattern_index >= pattern.length,
    result = {
        success: true,
        matched_tokens: [],
        end_position: position,
        semantic_data: {},
        performance_metrics: compute_performance_metrics(context)
    }.

rule match_pattern_sequence_optimized(tokens, position, pattern, pattern_index, context, result) :-
    pattern_index < pattern.length,
    current_pattern_element = pattern[pattern_index],
    match_pattern_element_enhanced(tokens, position, current_pattern_element, context, element_result),
    element_result.success == true,
    update_context_with_match(context, element_result, updated_context),
    match_pattern_sequence_optimized(tokens, element_result.end_position, pattern, pattern_index + 1, updated_context, next_result),
    combine_match_results(element_result, next_result, result).

rule match_pattern_element_enhanced(tokens, position, pattern_element, context, result) :-
    position < tokens.length,
    current_token = tokens[position],
    classify_pattern_element(pattern_element, element_type),
    apply_element_matching_strategy(current_token, pattern_element, element_type, context, result).

# Pattern element classification and matching strategies
rule classify_pattern_element(pattern_element, element_type) :-
    is_literal_token(pattern_element),
    element_type = "literal".

rule classify_pattern_element(pattern_element, element_type) :-
    is_token_type(pattern_element),
    element_type = "token_type".

rule classify_pattern_element(pattern_element, element_type) :-
    is_grammar_rule_reference(pattern_element),
    element_type = "grammar_rule".

rule classify_pattern_element(pattern_element, element_type) :-
    is_repetition_pattern(pattern_element),
    element_type = "repetition".

rule classify_pattern_element(pattern_element, element_type) :-
    is_optional_pattern(pattern_element),
    element_type = "optional".

rule classify_pattern_element(pattern_element, element_type) :-
    is_choice_pattern(pattern_element),
    element_type = "choice".

# Enhanced element matching with semantic validation
rule apply_element_matching_strategy(token, pattern_element, element_type, context, result) :-
    element_type == "literal",
    match_literal_token_enhanced(token, pattern_element, context, result).

rule apply_element_matching_strategy(token, pattern_element, element_type, context, result) :-
    element_type == "token_type",
    match_token_type_enhanced(token, pattern_element, context, result).

rule apply_element_matching_strategy(token, pattern_element, element_type, context, result) :-
    element_type == "grammar_rule",
    match_grammar_rule_recursive(token, pattern_element, context, result).

rule apply_element_matching_strategy(token, pattern_element, element_type, context, result) :-
    element_type == "repetition",
    match_repetition_pattern_enhanced(token, pattern_element, context, result).

rule apply_element_matching_strategy(token, pattern_element, element_type, context, result) :-
    element_type == "optional",
    match_optional_pattern_enhanced(token, pattern_element, context, result).

rule apply_element_matching_strategy(token, pattern_element, element_type, context, result) :-
    element_type == "choice",
    match_choice_pattern_enhanced(token, pattern_element, context, result).

# Literal token matching with context validation
rule match_literal_token_enhanced(token, pattern_element, context, result) :-
    extract_literal_value(pattern_element, expected_value),
    token.value == expected_value,
    validate_literal_in_context(token, expected_value, context, validation_result),
    validation_result.valid == true,
    result = {
        success: true,
        matched_token: token,
        end_position: context.current_position + 1,
        semantic_data: {
            literal_value: expected_value,
            context_validation: validation_result
        }
    }.

rule match_literal_token_enhanced(token, pattern_element, context, result) :-
    extract_literal_value(pattern_element, expected_value),
    (token.value != expected_value or
     not validate_literal_in_context(token, expected_value, context, validation_result) or
     validation_result.valid == false),
    result = {
        success: false,
        error: "Enhanced literal token mismatch",
        expected: expected_value,
        actual: token.value,
        context_info: context.semantic_annotations,
        recovery_suggestions: generate_literal_recovery_suggestions(token, expected_value, context)
    }.

# Token type matching with semantic enhancement
rule match_token_type_enhanced(token, pattern_element, context, result) :-
    token.type == pattern_element,
    validate_token_type_in_context(token, pattern_element, context, validation_result),
    validation_result.valid == true,
    result = {
        success: true,
        matched_token: token,
        end_position: context.current_position + 1,
        semantic_data: {
            token_type: pattern_element,
            token_value: token.value,
            context_validation: validation_result
        }
    }.

# Grammar rule recursive matching
rule match_grammar_rule_recursive(tokens, pattern_element, context, result) :-
    grammar_rule(pattern_element, rule_pattern),
    create_recursive_context(context, pattern_element, recursive_context),
    activate_grammar_rule(pattern_element, tokens, context.current_position, recursive_context, recursive_result),
    integrate_recursive_result(recursive_result, context, result).

# Repetition pattern matching with enhanced semantics
rule match_repetition_pattern_enhanced(tokens, pattern_element, context, result) :-
    extract_repetition_info(pattern_element, base_pattern, operator, min_count, max_count),
    match_repetition_with_bounds(tokens, context.current_position, base_pattern, min_count, max_count, context, repetition_result),
    result = enhance_repetition_result(repetition_result, operator, context).

rule match_repetition_with_bounds(tokens, position, base_pattern, min_count, max_count, context, result) :-
    attempt_repetition_matches(tokens, position, base_pattern, 0, min_count, max_count, context, [], matches),
    length(matches) >= min_count,
    result = {
        success: true,
        matched_elements: matches,
        repetition_count: length(matches),
        end_position: calculate_end_position(matches)
    }.

rule attempt_repetition_matches(tokens, position, base_pattern, current_count, min_count, max_count, context, acc_matches, final_matches) :-
    current_count >= max_count,
    final_matches = acc_matches.

rule attempt_repetition_matches(tokens, position, base_pattern, current_count, min_count, max_count, context, acc_matches, final_matches) :-
    current_count < max_count,
    position < tokens.length,
    match_pattern_element_enhanced(tokens, position, base_pattern, context, element_result),
    element_result.success == true,
    new_acc_matches = acc_matches + [element_result],
    attempt_repetition_matches(tokens, element_result.end_position, base_pattern, current_count + 1, min_count, max_count, context, new_acc_matches, final_matches).

rule attempt_repetition_matches(tokens, position, base_pattern, current_count, min_count, max_count, context, acc_matches, final_matches) :-
    current_count < max_count,
    (position >= tokens.length or
     not match_pattern_element_enhanced(tokens, position, base_pattern, context, element_result) or
     element_result.success == false),
    final_matches = acc_matches.

# Optional pattern matching
rule match_optional_pattern_enhanced(tokens, pattern_element, context, result) :-
    extract_optional_base_pattern(pattern_element, base_pattern),
    match_pattern_element_enhanced(tokens, context.current_position, base_pattern, context, element_result),
    element_result.success == true,
    result = {
        success: true,
        matched_token: element_result.matched_token,
        end_position: element_result.end_position,
        optional_matched: true,
        semantic_data: element_result.semantic_data
    }.

rule match_optional_pattern_enhanced(tokens, pattern_element, context, result) :-
    extract_optional_base_pattern(pattern_element, base_pattern),
    (not match_pattern_element_enhanced(tokens, context.current_position, base_pattern, context, element_result) or
     element_result.success == false),
    result = {
        success: true,
        matched_token: null,
        end_position: context.current_position,
        optional_matched: false,
        semantic_data: {}
    }.

# Choice pattern matching with backtracking
rule match_choice_pattern_enhanced(tokens, pattern_element, context, result) :-
    extract_choice_alternatives(pattern_element, alternatives),
    try_choice_alternatives_with_backtracking(tokens, context.current_position, alternatives, context, result).

rule try_choice_alternatives_with_backtracking(tokens, position, alternatives, context, result) :-
    alternatives = [first_alt | remaining_alts],
    match_pattern_element_enhanced(tokens, position, first_alt, context, alt_result),
    alt_result.success == true,
    result = enhance_choice_result(alt_result, first_alt, context).

rule try_choice_alternatives_with_backtracking(tokens, position, alternatives, context, result) :-
    alternatives = [first_alt | remaining_alts],
    (not match_pattern_element_enhanced(tokens, position, first_alt, context, alt_result) or
     alt_result.success == false),
    remaining_alts != [],
    try_choice_alternatives_with_backtracking(tokens, position, remaining_alts, context, result).

rule try_choice_alternatives_with_backtracking(tokens, position, alternatives, context, result) :-
    alternatives = [first_alt | remaining_alts],
    (not match_pattern_element_enhanced(tokens, position, first_alt, context, alt_result) or
     alt_result.success == false),
    remaining_alts == [],
    result = {
        success: false,
        error: "No choice alternative matched",
        tried_alternatives: alternatives,
        context_info: context.semantic_annotations
    }.

# ==========================================
# AST CONSTRUCTION AND GOAL INTEGRATION
# ==========================================

# Grammar-driven AST construction with semantic enhancement
rule construct_grammar_ast(rule_name, pattern_result, context, result) :-
    validate_pattern_result(pattern_result, context),
    determine_ast_node_type(rule_name, pattern_result, context, node_type),
    create_semantic_ast_node(node_type, pattern_result, context, ast_node),
    validate_ast_consistency(ast_node, context),
    result = {
        success: true,
        ast_node: ast_node,
        tokens_consumed: pattern_result.tokens_consumed,
        semantic_data: pattern_result.semantic_data,
        grammar_context: context
    }.

rule determine_ast_node_type(rule_name, pattern_result, context, node_type) :-
    grammar_ast_mapping(rule_name, mapped_type),
    node_type = mapped_type.

rule determine_ast_node_type(rule_name, pattern_result, context, node_type) :-
    not grammar_ast_mapping(rule_name, _),
    infer_ast_node_type_from_context(rule_name, pattern_result, context, node_type).

# Grammar to AST node type mappings
fact grammar_ast_mapping("program", "ProgramNode")
fact grammar_ast_mapping("statement_list", "StatementListNode")
fact grammar_ast_mapping("assignment_statement", "AssignmentNode")
fact grammar_ast_mapping("expression_statement", "ExpressionStatementNode")
fact grammar_ast_mapping("function_definition", "FunctionDefinitionNode")
fact grammar_ast_mapping("function_call", "FunctionCallNode")
fact grammar_ast_mapping("conditional_statement", "ConditionalNode")
fact grammar_ast_mapping("while_statement", "WhileLoopNode")
fact grammar_ast_mapping("fact_statement", "FactNode")
fact grammar_ast_mapping("rule_statement", "RuleNode")
fact grammar_ast_mapping("goal_statement", "GoalNode")
fact grammar_ast_mapping("constraint_statement", "ConstraintNode")

# Enhanced AST node creation with semantic validation
rule create_semantic_ast_node(node_type, pattern_result, context, ast_node) :-
    node_type == "ProgramNode",
    create_program_node(pattern_result, context, ast_node).

rule create_semantic_ast_node(node_type, pattern_result, context, ast_node) :-
    node_type == "AssignmentNode",
    create_assignment_node(pattern_result, context, ast_node).

rule create_semantic_ast_node(node_type, pattern_result, context, ast_node) :-
    node_type == "FunctionDefinitionNode",
    create_function_definition_node(pattern_result, context, ast_node).

rule create_semantic_ast_node(node_type, pattern_result, context, ast_node) :-
    node_type == "ConditionalNode",
    create_conditional_node(pattern_result, context, ast_node).

rule create_semantic_ast_node(node_type, pattern_result, context, ast_node) :-
    node_type == "ExpressionNode",
    create_expression_node(pattern_result, context, ast_node).

# Specific AST node constructors
rule create_program_node(pattern_result, context, ast_node) :-
    extract_statements_from_pattern(pattern_result, statements),
    validate_program_structure(statements, context),
    ast_node = {
        type: "Program",
        statements: statements,
        source_location: create_source_location(pattern_result, context),
        semantic_annotations: {
            total_statements: length(statements),
            program_complexity: calculate_program_complexity(statements),
            grammar_validation: true
        },
        children: statements,
        valid: true
    }.

rule create_assignment_node(pattern_result, context, ast_node) :-
    extract_assignment_components(pattern_result, target, operator, value),
    validate_assignment_semantics(target, operator, value, context),
    ast_node = {
        type: "Assignment",
        target: target,
        operator: operator,
        value: value,
        source_location: create_source_location(pattern_result, context),
        semantic_annotations: {
            assignment_type: classify_assignment_type(target, value),
            type_compatibility: check_type_compatibility(target, value, context),
            grammar_validation: true
        },
        children: [target, value],
        valid: true
    }.

rule create_function_definition_node(pattern_result, context, ast_node) :-
    extract_function_components(pattern_result, name, parameters, return_clause, body),
    validate_function_definition_semantics(name, parameters, return_clause, body, context),
    ast_node = {
        type: "FunctionDefinition",
        name: name,
        parameters: parameters,
        return_clause: return_clause,
        body: body,
        source_location: create_source_location(pattern_result, context),
        semantic_annotations: {
            function_signature: create_function_signature(name, parameters, return_clause),
            natural_language_syntax: true,
            parameter_count: length(parameters),
            grammar_validation: true
        },
        children: [name, parameters, return_clause, body],
        valid: true
    }.

rule create_conditional_node(pattern_result, context, ast_node) :-
    extract_conditional_components(pattern_result, condition, then_branch, else_branch),
    validate_conditional_semantics(condition, then_branch, else_branch, context),
    ast_node = {
        type: "Conditional",
        condition: condition,
        then_branch: then_branch,
        else_branch: else_branch,
        source_location: create_source_location(pattern_result, context),
        semantic_annotations: {
            condition_type: classify_condition_type(condition),
            branch_complexity: calculate_branch_complexity(then_branch, else_branch),
            has_else_clause: else_branch != null,
            grammar_validation: true
        },
        children: filter_null([condition, then_branch, else_branch]),
        valid: true
    }.

# ==========================================
# GOAL SYSTEM INTEGRATION WITH GRAMMAR
# ==========================================

# Grammar-driven goal generation and coordination
goal coordinate_grammar_with_parse_goals(rule_name, tokens, position, context) {
    precondition: grammar_rule(rule_name, pattern) and parse_goal_exists(rule_name),
    postcondition: result.grammar_goal_coordination == true and result.parse_success == true,
    strategy: integrated_grammar_goal_coordination
}

rule coordinate_grammar_with_parse_goals(rule_name, tokens, position, context, result) :-
    lookup_corresponding_parse_goal(rule_name, parse_goal),
    create_goal_grammar_context(context, parse_goal, goal_context),
    activate_grammar_rule(rule_name, tokens, position, goal_context, grammar_result),
    validate_goal_postconditions(grammar_result, parse_goal, goal_context),
    result = integrate_goal_grammar_result(grammar_result, parse_goal, goal_context).

rule lookup_corresponding_parse_goal(rule_name, parse_goal) :-
    grammar_goal_mapping(rule_name, goal_name),
    parse_goal_definition(goal_name, parse_goal).

# Grammar rule to parse goal mappings
fact grammar_goal_mapping("program", "parse_program")
fact grammar_goal_mapping("statement", "parse_statement")
fact grammar_goal_mapping("expression", "parse_expression")
fact grammar_goal_mapping("function_definition", "parse_function_definition")
fact grammar_goal_mapping("conditional_statement", "parse_control_flow")
fact grammar_goal_mapping("while_statement", "parse_control_flow")
fact grammar_goal_mapping("fact_statement", "parse_reasoning_construct")
fact grammar_goal_mapping("rule_statement", "parse_reasoning_construct")
fact grammar_goal_mapping("goal_statement", "parse_reasoning_construct")
fact grammar_goal_mapping("constraint_statement", "parse_type_constraint")

rule create_goal_grammar_context(base_context, parse_goal, goal_context) :-
    goal_context = {
        base_context: base_context,
        parse_goal: parse_goal,
        goal_preconditions: parse_goal.preconditions,
        goal_postconditions: parse_goal.postconditions,
        goal_strategy: parse_goal.strategy,
        grammar_coordination_mode: "active",
        performance_tracking: {
            goal_start_time: current_time(),
            grammar_activation_count: 0
        }
    }.

rule validate_goal_postconditions(grammar_result, parse_goal, goal_context) :-
    grammar_result.success == true,
    check_all_postconditions(grammar_result, parse_goal.postconditions, goal_context).

rule check_all_postconditions(grammar_result, postconditions, goal_context) :-
    postconditions.all(postcondition ->
        evaluate_postcondition(postcondition, grammar_result, goal_context)).

# ==========================================
# ENHANCED PRECEDENCE HANDLING INTEGRATION
# ==========================================

# Grammar-aware precedence handling with reasoning support
goal handle_expression_precedence_via_grammar(tokens, position, context) {
    precondition: tokens[position].type in expression_tokens,
    postcondition: result.precedence_respected == true and result.grammar_validated == true,
    strategy: grammar_integrated_precedence_climbing
}

rule handle_expression_precedence_via_grammar(tokens, position, context, result) :-
    initialize_precedence_context(context, precedence_context),
    parse_expression_with_grammar_precedence(tokens, position, 0, precedence_context, expression_result),
    validate_precedence_result(expression_result, precedence_context),
    result = enhance_precedence_result(expression_result, precedence_context).

rule parse_expression_with_grammar_precedence(tokens, position, min_precedence, context, result) :-
    parse_primary_expression_via_grammar(tokens, position, context, left_expr),
    parse_binary_operations_with_grammar(tokens, left_expr.end_position, left_expr.ast_node, min_precedence, context, result).

rule parse_primary_expression_via_grammar(tokens, position, context, result) :-
    current_token = tokens[position],
    determine_primary_expression_rule(current_token, context, rule_name),
    activate_grammar_rule(rule_name, tokens, position, context, grammar_result),
    result = {
        success: grammar_result.success,
# ==========================================
# PERFORMANCE OPTIMIZATION AND MONITORING
# ==========================================

# Performance-optimized grammar rule evaluation
goal optimize_grammar_performance(rule_name, tokens, position, context) {
    precondition: grammar_rule(rule_name, pattern) and context.performance_tracking == true,
    postcondition: result.performance_optimized == true and result.execution_time_acceptable == true,
    strategy: intelligent_performance_optimization
}

rule optimize_grammar_performance(rule_name, tokens, position, context, result) :-
    analyze_rule_complexity(rule_name, tokens, position, context, complexity_analysis),
    select_optimization_strategy(complexity_analysis, optimization_strategy),
    apply_performance_optimization(rule_name, tokens, position, context, optimization_strategy, optimized_result),
    monitor_performance_metrics(optimized_result, context, performance_metrics),
    result = enhance_result_with_performance_data(optimized_result, performance_metrics).

rule analyze_rule_complexity(rule_name, tokens, position, context, complexity_analysis) :-
    grammar_rule(rule_name, pattern),
    calculate_pattern_complexity(pattern, pattern_complexity),
    estimate_token_consumption(tokens, position, pattern, token_estimate),
    analyze_backtracking_potential(pattern, backtrack_potential),
    complexity_analysis = {
        pattern_complexity: pattern_complexity,
        token_estimate: token_estimate,
        backtrack_potential: backtrack_potential,
        rule_depth: context.rule_depth,
        total_complexity_score: calculate_total_complexity(pattern_complexity, token_estimate, backtrack_potential)
    }.

rule select_optimization_strategy(complexity_analysis, optimization_strategy) :-
    complexity_analysis.total_complexity_score < 10,
    optimization_strategy = "direct_execution".

rule select_optimization_strategy(complexity_analysis, optimization_strategy) :-
    complexity_analysis.total_complexity_score >= 10,
    complexity_analysis.total_complexity_score < 50,
    optimization_strategy = "memoized_execution".

rule select_optimization_strategy(complexity_analysis, optimization_strategy) :-
    complexity_analysis.total_complexity_score >= 50,
    complexity_analysis.backtrack_potential > 0.7,
    optimization_strategy = "guided_backtracking".

rule select_optimization_strategy(complexity_analysis, optimization_strategy) :-
    complexity_analysis.total_complexity_score >= 50,
    complexity_analysis.backtrack_potential <= 0.7,
    optimization_strategy = "parallel_evaluation".

# Grammar-specific memoization system
rule apply_memoization_to_grammar_rule(rule_name, tokens, position, context, result) :-
    generate_grammar_memoization_key(rule_name, tokens, position, context, memo_key),
    lookup_grammar_memoized_result(memo_key, cached_result),
    cached_result != null,
    validate_cached_result_freshness(cached_result, context),
    result = adapt_cached_result_to_context(cached_result, context).

rule apply_memoization_to_grammar_rule(rule_name, tokens, position, context, result) :-
    generate_grammar_memoization_key(rule_name, tokens, position, context, memo_key),
    (lookup_grammar_memoized_result(memo_key, cached_result) == null or
     not validate_cached_result_freshness(cached_result, context)),
    execute_grammar_rule_with_monitoring(rule_name, tokens, position, context, fresh_result),
    store_grammar_memoized_result(memo_key, fresh_result, context),
    result = fresh_result.

# Intelligent backtracking guidance
rule apply_guided_backtracking(rule_name, tokens, position, context, result) :-
    grammar_rule(rule_name, pattern),
    analyze_backtracking_decision_points(pattern, decision_points),
    create_backtracking_guidance_map(decision_points, tokens, position, context, guidance_map),
    execute_guided_backtracking_parse(pattern, tokens, position, context, guidance_map, result).

rule create_backtracking_guidance_map(decision_points, tokens, position, context, guidance_map) :-
    decision_points.map(point -> {
        decision_point: point,
        lookahead_analysis: analyze_lookahead_at_point(tokens, position, point, context),
        probability_score: calculate_success_probability(point, tokens, position, context),
        backtrack_cost: estimate_backtrack_cost(point, context)
    }, guidance_entries),
    guidance_map = sort_by_probability_score(guidance_entries).

# Performance monitoring and metrics
rule monitor_grammar_performance(rule_name, execution_context, performance_metrics) :-
    execution_context.performance_tracking == true,
    calculate_execution_time(execution_context, execution_time),
    calculate_memory_usage(execution_context, memory_usage),
    calculate_backtrack_count(execution_context, backtrack_count),
    analyze_cache_efficiency(execution_context, cache_efficiency),
    performance_metrics = {
        rule_name: rule_name,
        execution_time: execution_time,
        memory_usage: memory_usage,
        backtrack_count: backtrack_count,
        cache_hit_ratio: cache_efficiency.hit_ratio,
        tokens_processed: execution_context.tokens_processed,
        performance_grade: calculate_performance_grade(execution_time, memory_usage, backtrack_count)
    }.

# Performance optimization feedback loop
rule update_optimization_strategies(performance_metrics, updated_strategies) :-
    analyze_performance_patterns(performance_metrics, patterns),
    identify_optimization_opportunities(patterns, opportunities),
    generate_optimization_recommendations(opportunities, recommendations),
    apply_optimization_updates(recommendations, updated_strategies).

# ==========================================
# GRAMMAR-AWARE ERROR RECOVERY SYSTEM
# ==========================================

# Enhanced error recovery with grammar context
goal recover_from_grammar_error(error_context, recovery_result) {
    precondition: error_context.error_type != null and error_context.grammar_context != null,
    postcondition: recovery_result.recovery_successful == true and recovery_result.ast_consistency_maintained == true,
    strategy: grammar_context_aware_error_recovery
}

rule recover_from_grammar_error(error_context, recovery_result) :-
    classify_grammar_error_type(error_context, error_classification),
    determine_recovery_strategy(error_classification, error_context, recovery_strategy),
    apply_grammar_recovery_strategy(recovery_strategy, error_context, recovery_action),
    validate_recovery_action(recovery_action, error_context, validation_result),
    recovery_result = finalize_recovery_result(recovery_action, validation_result, error_context).

rule classify_grammar_error_type(error_context, error_classification) :-
    error_context.error_type == "token_mismatch",
    analyze_expected_vs_actual_tokens(error_context, token_analysis),
    error_classification = {
        primary_type: "token_mismatch",
        severity: determine_token_mismatch_severity(token_analysis),
        recovery_complexity: estimate_token_recovery_complexity(token_analysis),
        grammar_impact: assess_grammar_rule_impact(error_context, token_analysis)
    }.

rule classify_grammar_error_type(error_context, error_classification) :-
    error_context.error_type == "rule_failure",
    analyze_failed_rule_context(error_context, rule_analysis),
    error_classification = {
        primary_type: "rule_failure",
        severity: determine_rule_failure_severity(rule_analysis),
        recovery_complexity: estimate_rule_recovery_complexity(rule_analysis),
        grammar_impact: assess_rule_failure_impact(error_context, rule_analysis)
    }.

rule classify_grammar_error_type(error_context, error_classification) :-
    error_context.error_type == "pattern_mismatch",
    analyze_pattern_mismatch_context(error_context, pattern_analysis),
    error_classification = {
        primary_type: "pattern_mismatch",
        severity: determine_pattern_mismatch_severity(pattern_analysis),
        recovery_complexity: estimate_pattern_recovery_complexity(pattern_analysis),
        grammar_impact: assess_pattern_mismatch_impact(error_context, pattern_analysis)
    }.

# Sophisticated recovery strategy selection
rule determine_recovery_strategy(error_classification, error_context, recovery_strategy) :-
    error_classification.primary_type == "token_mismatch",
    error_classification.severity == "low",
    recovery_strategy = "token_insertion_or_substitution".

rule determine_recovery_strategy(error_classification, error_context, recovery_strategy) :-
    error_classification.primary_type == "token_mismatch",
    error_classification.severity == "medium",
    recovery_strategy = "synchronization_point_recovery".

rule determine_recovery_strategy(error_classification, error_context, recovery_strategy) :-
    error_classification.primary_type == "rule_failure",
    error_classification.recovery_complexity == "low",
    recovery_strategy = "alternative_rule_attempt".

rule determine_recovery_strategy(error_classification, error_context, recovery_strategy) :-
    error_classification.primary_type == "rule_failure",
    error_classification.recovery_complexity == "high",
    recovery_strategy = "error_node_creation_with_skip".

rule determine_recovery_strategy(error_classification, error_context, recovery_strategy) :-
    error_classification.primary_type == "pattern_mismatch",
    has_alternative_patterns(error_context),
    recovery_strategy = "pattern_alternative_exploration".

rule determine_recovery_strategy(error_classification, error_context, recovery_strategy) :-
    error_classification.primary_type == "pattern_mismatch",
    not has_alternative_patterns(error_context),
    recovery_strategy = "pattern_repair_and_continuation".

# Advanced recovery action implementation
rule apply_grammar_recovery_strategy(recovery_strategy, error_context, recovery_action) :-
    recovery_strategy == "token_insertion_or_substitution",
    identify_missing_or_incorrect_token(error_context, token_issue),
    generate_token_correction(token_issue, error_context, token_correction),
    recovery_action = {
        type: "token_correction",
        correction: token_correction,
        impact: "local",
        ast_modifications: generate_ast_modifications_for_token_correction(token_correction)
    }.

rule apply_grammar_recovery_strategy(recovery_strategy, error_context, recovery_action) :-
    recovery_strategy == "synchronization_point_recovery",
    identify_synchronization_points(error_context, sync_points),
    select_optimal_synchronization_point(sync_points, error_context, selected_sync_point),
    recovery_action = {
        type: "synchronization",
        sync_point: selected_sync_point,
        tokens_to_skip: calculate_tokens_to_skip(error_context, selected_sync_point),
        impact: "regional",
        ast_modifications: generate_ast_modifications_for_sync_recovery(selected_sync_point)
    }.

rule apply_grammar_recovery_strategy(recovery_strategy, error_context, recovery_action) :-
    recovery_strategy == "alternative_rule_attempt",
    identify_alternative_rules(error_context, alternative_rules),
    evaluate_alternative_rule_viability(alternative_rules, error_context, viable_alternatives),
    select_best_alternative_rule(viable_alternatives, error_context, selected_alternative),
    recovery_action = {
        type: "rule_alternative",
        alternative_rule: selected_alternative,
        impact: "structural",
        ast_modifications: generate_ast_modifications_for_rule_alternative(selected_alternative)
    }.

# Recovery validation and quality assurance
rule validate_recovery_action(recovery_action, error_context, validation_result) :-
    check_recovery_action_consistency(recovery_action, error_context, consistency_check),
    verify_ast_structure_integrity(recovery_action, error_context, structure_check),
    assess_recovery_action_impact(recovery_action, error_context, impact_assessment),
    validation_result = {
        consistency_valid: consistency_check.valid,
        structure_valid: structure_check.valid,
        impact_acceptable: impact_assessment.acceptable,
        overall_valid: (consistency_check.valid and structure_check.valid and impact_assessment.acceptable),
        validation_details: {
            consistency: consistency_check,
            structure: structure_check,
            impact: impact_assessment
        }
    }.

# Intelligent error suggestion system
rule generate_error_suggestions(error_context, suggestions) :-
    analyze_error_context_patterns(error_context, context_patterns),
    lookup_similar_error_resolutions(context_patterns, similar_resolutions),
    generate_contextual_suggestions(error_context, similar_resolutions, contextual_suggestions),
    rank_suggestions_by_likelihood(contextual_suggestions, error_context, ranked_suggestions),
    suggestions = select_top_suggestions(ranked_suggestions, 5).

rule generate_contextual_suggestions(error_context, similar_resolutions, suggestions) :-
    error_context.error_type == "token_mismatch",
    generate_token_mismatch_suggestions(error_context, similar_resolutions, suggestions).

rule generate_contextual_suggestions(error_context, similar_resolutions, suggestions) :-
    error_context.error_type == "rule_failure",
    generate_rule_failure_suggestions(error_context, similar_resolutions, suggestions).

rule generate_contextual_suggestions(error_context, similar_resolutions, suggestions) :-
    error_context.error_type == "pattern_mismatch",
    generate_pattern_mismatch_suggestions(error_context, similar_resolutions, suggestions).

# ==========================================
# RUBY COMPATIBILITY AND INTEGRATION BRIDGE
# ==========================================

# Ruby AST compatibility validation and transformation
goal ensure_ruby_compatibility(grammar_ast, ruby_compatible_ast) {
    precondition: grammar_ast.type != null and grammar_ast.valid == true,
    postcondition: ruby_compatible_ast.ruby_evaluator_compatible == true,
    strategy: grammar_to_ruby_ast_transformation
}

rule ensure_ruby_compatibility(grammar_ast, ruby_compatible_ast) :-
    validate_grammar_ast_for_ruby_compatibility(grammar_ast, validation_result),
    validation_result.compatible == true,
    ruby_compatible_ast = grammar_ast.

rule ensure_ruby_compatibility(grammar_ast, ruby_compatible_ast) :-
    validate_grammar_ast_for_ruby_compatibility(grammar_ast, validation_result),
    validation_result.compatible == false,
    transform_grammar_ast_to_ruby_compatible(grammar_ast, validation_result, ruby_compatible_ast).

rule validate_grammar_ast_for_ruby_compatibility(grammar_ast, validation_result) :-
    check_ast_node_types_compatibility(grammar_ast, type_compatibility),
    check_ast_structure_compatibility(grammar_ast, structure_compatibility),
    check_semantic_annotations_compatibility(grammar_ast, annotations_compatibility),
    validation_result = {
        compatible: (type_compatibility.compatible and structure_compatibility.compatible and annotations_compatibility.compatible),
        type_issues: type_compatibility.issues,
        structure_issues: structure_compatibility.issues,
        annotation_issues: annotations_compatibility.issues
    }.

rule transform_grammar_ast_to_ruby_compatible(grammar_ast, validation_result, ruby_compatible_ast) :-
    apply_type_compatibility_transformations(grammar_ast, validation_result.type_issues, type_transformed_ast),
    apply_structure_compatibility_transformations(type_transformed_ast, validation_result.structure_issues, structure_transformed_ast),
    apply_annotation_compatibility_transformations(structure_transformed_ast, validation_result.annotation_issues, annotation_transformed_ast),
    validate_final_ruby_compatibility(annotation_transformed_ast, final_validation),
    final_validation.compatible == true,
    ruby_compatible_ast = annotation_transformed_ast.

# Grammar engine integration with Ruby evaluator interface
rule integrate_with_ruby_evaluator(grammar_engine_result, ruby_evaluator_input) :-
    extract_ast_from_grammar_result(grammar_engine_result, grammar_ast),
    ensure_ruby_compatibility(grammar_ast, ruby_compatible_ast),
    create_evaluator_context(grammar_engine_result, evaluator_context),
    ruby_evaluator_input = {
        ast: ruby_compatible_ast,
        context: evaluator_context,
        metadata: {
            grammar_engine_version: get_grammar_engine_version(),
            parsing_strategy: grammar_engine_result.strategy_used,
            performance_metrics: grammar_engine_result.performance_metrics
        }
    }.
        ast_node: grammar_result.ast_node,
        end_position: grammar_result.end_position,
        semantic_data: grammar_result.semantic_data
    }.

rule parse_binary_operations_with_grammar(tokens, position, left_expr, min_precedence, context, result) :-
    position >= tokens.length,
    result = {
        success: true,
        ast_node: left_expr,
        end_position: position,
        precedence_complete: true
    }.

rule parse_binary_operations_with_grammar(tokens, position, left_expr, min_precedence, context, result) :-
    position < tokens.length,
    current_token = tokens[position],
    is_binary_operator(current_token.value),
    operator_precedence(current_token.value, op_precedence),
    op_precedence >= min_precedence,
    determine_right_associativity(current_token.value, op_precedence, right_min_precedence),
    parse_expression_with_grammar_precedence(tokens, position + 1, right_min_precedence, context, right_result),
    create_binary_operation_ast_via_grammar(left_expr, current_token, right_result.ast_node, context, combined_expr),
    parse_binary_operations_with_grammar(tokens, right_result.end_position, combined_expr, min_precedence, context, result).

rule determine_right_associativity(operator, op_precedence, right_min_precedence) :-
    operator_associativity(operator, "right"),
    right_min_precedence = op_precedence.

rule determine_right_associativity(operator, op_precedence, right_min_precedence) :-
    operator_associativity(operator, "left"),
    right_min_precedence = op_precedence + 1.

rule create_binary_operation_ast_via_grammar(left_expr, operator_token, right_expr, context, result) :-
    validate_binary_operation_semantics(left_expr, operator_token, right_expr, context),
    determine_result_type(left_expr, operator_token, right_expr, result_type),
    result = {
        type: "BinaryOperation",
        operator: operator_token.value,
        left: left_expr,
        right: right_expr,
        result_type: result_type,
        source_location: create_operator_source_location(operator_token, context),
        semantic_annotations: {
            operator_precedence: get_operator_precedence(operator_token.value),
            operator_associativity: get_operator_associativity(operator_token.value),
            type_compatibility: check_operand_type_compatibility(left_expr, right_expr),
            grammar_validation: true
        },
        children: [left_expr, right_expr],
        valid: true
    }.

# Grammar validation and consistency checking
rule validate_grammar_consistency(rules) :-
    check_all_rules_have_definitions(rules),
    check_no_circular_dependencies(rules),
    check_terminal_reachability(rules).

rule detect_grammar_conflicts(rules, conflicts) :-
    find_left_recursion(rules, left_recursion_conflicts),
    find_ambiguous_rules(rules, ambiguity_conflicts),
    conflicts = left_recursion_conflicts + ambiguity_conflicts.

rule find_left_recursion(rules, conflicts) :-
    find_all_left_recursive_rules(rules, conflicts).

rule find_ambiguous_rules(rules, conflicts) :-
    find_all_ambiguous_rule_pairs(rules, conflicts).

# Grammar transformation rules for optimization
rule eliminate_left_recursion(original_rule, transformed_rules) :-
    is_left_recursive(original_rule),
    apply_left_recursion_elimination(original_rule, transformed_rules).

rule factor_common_prefixes(rules, factored_rules) :-
    identify_common_prefixes(rules, common_prefixes),
    apply_left_factoring(rules, common_prefixes, factored_rules).

# Grammar extension support
rule add_new_grammar_rule(rule_name, rule_pattern) :-
    not grammar_rule(rule_name, _),
    validate_new_rule(rule_name, rule_pattern),
    assert_new_rule(rule_name, rule_pattern).

rule extend_existing_rule(rule_name, additional_pattern) :-
    grammar_rule(rule_name, existing_pattern),
    validate_rule_extension(existing_pattern, additional_pattern),
    create_extended_rule(rule_name, existing_pattern, additional_pattern).

# Performance optimization for grammar processing
rule optimize_grammar_for_performance(rules, optimized_rules) :-
    eliminate_unnecessary_recursion(rules, step1_rules),
    optimize_choice_ordering(step1_rules, step2_rules),
    add_memoization_hints(step2_rules, optimized_rules).

# Grammar statistics and analysis
fact grammar_rules_count(0)
fact terminal_symbols_count(0)
fact non_terminal_symbols_count(0)

rule count_grammar_elements() :-
    count_all_rules(rules_count),
    count_terminal_symbols(terminals_count),
    count_non_terminal_symbols(non_terminals_count),
    grammar_rules_count = rules_count,
    terminal_symbols_count = terminals_count,
    non_terminal_symbols_count = non_terminals_count.

# Error handling for grammar processing
rule handle_grammar_parse_error(error_type, tokens, position, recovery_action) :-
    grammar_error_recovery_strategy(error_type, strategy),
    apply_grammar_recovery_strategy(strategy, tokens, position, recovery_action).

fact grammar_error_recovery_strategy("missing_terminal", "insert_expected_token")
fact grammar_error_recovery_strategy("unexpected_token", "skip_to_synchronization_point")
fact grammar_error_recovery_strategy("rule_not_found", "create_error_node")

# ==========================================
# ENHANCED GRAMMAR SYSTEM INITIALIZATION
# ==========================================

# Comprehensive grammar engine initialization with full Week 1 capabilities
initialize_grammar_engine() {
    print("🚀 Initializing Enhanced Grammar Engine - Phase 2 Week 1"),
    
    # Core system initialization
    count_grammar_elements(),
    validate_grammar_consistency(all_grammar_rules()),
    initialize_performance_monitoring(),
    initialize_memoization_cache(),
    initialize_error_recovery_system(),
    
    # Advanced features initialization
    initialize_pattern_operator_support(),
    initialize_backtracking_system(),
    initialize_goal_integration_system(),
    initialize_ruby_compatibility_bridge(),
    
    # System validation
    validate_enhanced_grammar_system(),
    
    # Report initialization results
    print("✅ Grammar Engine Phase 2 Week 1 Initialization Complete"),
    print("📊 Core Statistics:"),
    print("   • Total grammar rules: " + grammar_rules_count),
    print("   • Terminal symbols: " + terminal_symbols_count),
    print("   • Non-terminal symbols: " + non_terminal_symbols_count),
    print("   • Advanced pattern operators: ENABLED"),
    print("   • Backtracking support: ENABLED"),
    print("   • Performance optimization: ENABLED"),
    print("   • Error recovery: ENHANCED"),
    print("   • Goal system integration: ACTIVE"),
    print("   • Ruby compatibility: VALIDATED"),
    print("🎯 Grammar Engine ready for production parsing with reasoning-based rule activation")
end

rule initialize_performance_monitoring() :-
    create_performance_metrics_store(),
    initialize_complexity_analysis_system(),
    setup_optimization_strategy_cache(),
    print("   ✓ Performance monitoring system initialized").

rule initialize_memoization_cache() :-
    create_grammar_memoization_cache(),
    setup_cache_invalidation_policies(),
    initialize_cache_efficiency_tracking(),
    print("   ✓ Advanced memoization system initialized").

rule initialize_error_recovery_system() :-
    load_error_recovery_strategies(),
    initialize_synchronization_point_database(),
    setup_error_suggestion_engine(),
    print("   ✓ Grammar-aware error recovery system initialized").

rule initialize_pattern_operator_support() :-
    validate_repetition_operators(),
    validate_optional_operators(),
    validate_choice_operators(),
    validate_lookahead_operators(),
    print("   ✓ Advanced pattern operators validated and active").

rule initialize_backtracking_system() :-
    create_backtracking_guidance_maps(),
    initialize_decision_point_analysis(),
    setup_backtrack_cost_estimation(),
    print("   ✓ Intelligent backtracking system initialized").

rule initialize_goal_integration_system() :-
    validate_grammar_goal_mappings(),
    initialize_goal_coordination_contexts(),
    setup_postcondition_validation_system(),
    print("   ✓ Goal system integration initialized").

rule initialize_ruby_compatibility_bridge() :-
    validate_ast_transformation_mappings(),
    initialize_compatibility_validators(),
    setup_evaluator_interface_bridge(),
    print("   ✓ Ruby compatibility bridge initialized").

rule validate_enhanced_grammar_system() :-
    run_system_integration_tests(),
    validate_performance_benchmarks(),
    check_error_recovery_coverage(),
    validate_ruby_compatibility_comprehensive(),
    print("   ✓ Enhanced grammar system validation complete").

# ==========================================
# WEEK 1 GRAMMAR ENGINE TESTING FRAMEWORK
# ==========================================

# Comprehensive test suite for Week 1 grammar engine implementation
goal test_week1_grammar_engine_implementation() {
    precondition: grammar_engine_initialized == true,
    postcondition: all_week1_tests_passed == true and coverage >= 90,
    strategy: comprehensive_week1_validation
}

rule test_week1_grammar_engine_implementation(test_results) :-
    print("🧪 Running Week 1 Grammar Engine Comprehensive Test Suite"),
    
    # Core functionality tests
    run_grammar_activation_tests(activation_results),
    run_pattern_matching_tests(pattern_results),
    run_ast_construction_tests(ast_results),
    run_goal_integration_tests(goal_results),
    
    # Advanced feature tests
    run_performance_optimization_tests(performance_results),
    run_error_recovery_tests(error_results),
    run_ruby_compatibility_tests(compatibility_results),
    
    # Integration tests
    run_end_to_end_parsing_tests(e2e_results),
    
    # Aggregate results
    aggregate_test_results([
        activation_results,
        pattern_results,
        ast_results,
        goal_results,
        performance_results,
        error_results,
        compatibility_results,
        e2e_results
    ], test_results),
    
    report_test_results(test_results).

rule report_test_results(test_results) :-
    total_tests = test_results.map(r -> r.tests_run).sum(),
    total_passed = test_results.map(r -> r.tests_passed).sum(),
    success_rate = (total_passed / total_tests) * 100,
    
    print("📋 Week 1 Grammar Engine Test Results Summary:"),
    print("   • Total tests executed: " + total_tests),
    print("   • Tests passed: " + total_passed),
    print("   • Success rate: " + success_rate + "%"),
    print("   • Test coverage: " + calculate_test_coverage(test_results) + "%"),
    
    (success_rate >= 90 ->
        print("✅ Week 1 Grammar Engine implementation SUCCESSFUL")
    ;
        print("❌ Week 1 Grammar Engine implementation needs attention")
    ).