# Explicit Output Expressions - Each result is printed

print(2 + 3)
print(5 * 4)
print(10 - 7)
print(8 / 2)
print(15 % 4)

print((2 + 3) * 4)
print(2 + (3 * 4))
print(((5 + 2) * 3) - 1)

print(true)
print(false)
print(not true)
print(true and false)
print(true or false)

print(5 > 3)
print(10 <= 15)

print("hello")
print("world")
print("hello world")
print("")

# Only defined expressions are printed; undefined functions/vars omitted