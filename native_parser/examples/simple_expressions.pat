# Simple Expression Examples - Basic parsing demonstrations
# These examples showcase the native parser's expression handling capabilities

# Basic arithmetic expressions
2 + 3
5 * 4
10 - 7
8 / 2
15 % 4

# Expressions with parentheses
(2 + 3) * 4
2 + (3 * 4)
((5 + 2) * 3) - 1

# Boolean expressions
true
false
not true
true and false
true or false

# Comparison expressions
5 > 3
10 <= 15
x == y
a != b

# Variable references
x
my_variable
_private_var

# String literals
"hello"
"world"
"hello world"
""

# Mixed expressions
x + 5
"hello" + " world"
count > 0 and active == true

# Function calls
add(2, 3)
multiply(x, y)
print("hello")
calculate(a, b, c)

# Nested function calls
add(multiply(2, 3), subtract(10, 5))
max(min(x, y), z)

# Complex expressions combining multiple elements
(x + y) * 2 > threshold and status == "active"
calculate_result(data.length, config.max_size) <= limit