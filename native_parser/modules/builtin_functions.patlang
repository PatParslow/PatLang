# Built-in Functions Module - Core language built-ins including list functionality
# Provides essential functions like make_empty_list, make_list, and other core utilities

# ==== BUILT-IN FUNCTION REGISTRY ====

fact builtin_functions([
    "make_empty_list",
    "make_list", 
    "print",
    "length",
    "type_of",
    "to_string",
    "to_number"
])

fact list_functions([
    "make_empty_list",
    "make_list"
])

fact utility_functions([
    "print",
    "length", 
    "type_of",
    "to_string",
    "to_number"
])

# ==== BUILT-IN FUNCTION DEFINITIONS ====

goal define_builtin_functions(context) {
    precondition: context.initialized == true,
    postcondition: context.builtins_loaded == true,
    strategy: register_all_builtin_functions
}

rule define_builtin_functions_impl(context, result) :-
    register_list_functions(context, list_context),
    register_utility_functions(list_context, utility_context),
    register_io_functions(utility_context, final_context),
    result = final_context.merge({builtins_loaded: true}).

# ==== LIST FUNCTION DEFINITIONS ====

rule register_list_functions(context, result) :-
    define_make_empty_list_function(context, empty_list_context),
    define_make_list_function(empty_list_context, result).

goal define_make_empty_list_function(context) {
    precondition: context.initialized == true,
    postcondition: context.functions["make_empty_list"] != null,
    strategy: builtin_function_registration
}

rule define_make_empty_list_function_impl(context, result) :-
    create_builtin_function_definition("make_empty_list", [], "List", 
        {
            type: "BuiltinFunction",
            implementation: "native_make_empty_list",
            description: "Creates an empty list",
            parameters: [],
            return_type: {base_type: "List", constraints: []},
            side_effects: [],
            memory_allocation: 32,
            execution_time: 0.001
        }, function_def),
    register_function(context, "make_empty_list", function_def, result).

goal define_make_list_function(context) {
    precondition: context.initialized == true,
    postcondition: context.functions["make_list"] != null,
    strategy: builtin_function_registration
}

rule define_make_list_function_impl(context, result) :-
    create_builtin_function_definition("make_list", 
        [
            {name: "head", type: "Any", required: true},
            {name: "tail", type: "List", required: false, default: "empty_list"}
        ], 
        "List",
        {
            type: "BuiltinFunction", 
            implementation: "native_make_list",
            description: "Creates a list with the given head and tail",
            parameters: [
                {name: "head", type: {base_type: "Any", constraints: []}},
                {name: "tail", type: {base_type: "List", constraints: []}, optional: true}
            ],
            return_type: {base_type: "List", constraints: []},
            side_effects: [],
            memory_allocation: 64,
            execution_time: 0.002
        }, function_def),
    register_function(context, "make_list", function_def, result).

# ==== UTILITY FUNCTION DEFINITIONS ====

rule register_utility_functions(context, result) :-
    define_length_function(context, length_context),
    define_type_of_function(length_context, type_context),
    define_to_string_function(type_context, string_context),
    define_to_number_function(string_context, result).

goal define_length_function(context) {
    precondition: context.initialized == true,
    postcondition: context.functions["length"] != null,
    strategy: builtin_function_registration
}

rule define_length_function_impl(context, result) :-
    create_builtin_function_definition("length", 
        [{name: "collection", type: "Any", required: true}], 
        "Number",
        {
            type: "BuiltinFunction",
            implementation: "native_length",
            description: "Returns the length of a collection (list, string, array)",
            parameters: [{name: "collection", type: {base_type: "Any", constraints: []}}],
            return_type: {base_type: "Number", constraints: []},
            side_effects: [],
            memory_allocation: 8,
            execution_time: 0.001
        }, function_def),
    register_function(context, "length", function_def, result).

goal define_type_of_function(context) {
    precondition: context.initialized == true,
    postcondition: context.functions["type_of"] != null,
    strategy: builtin_function_registration
}

rule define_type_of_function_impl(context, result) :-
    create_builtin_function_definition("type_of", 
        [{name: "value", type: "Any", required: true}], 
        "String",
        {
            type: "BuiltinFunction",
            implementation: "native_type_of",
            description: "Returns the type of a value as a string",
            parameters: [{name: "value", type: {base_type: "Any", constraints: []}}],
            return_type: {base_type: "String", constraints: []},
            side_effects: [],
            memory_allocation: 32,
            execution_time: 0.001
        }, function_def),
    register_function(context, "type_of", function_def, result).

# ==== I/O FUNCTION DEFINITIONS ====

rule register_io_functions(context, result) :-
    define_print_function(context, result).

goal define_print_function(context) {
    precondition: context.initialized == true,
    postcondition: context.functions["print"] != null,
    strategy: builtin_function_registration
}

rule define_print_function_impl(context, result) :-
    create_builtin_function_definition("print", 
        [{name: "value", type: "Any", required: true}], 
        "Void",
        {
            type: "BuiltinFunction",
            implementation: "native_print",
            description: "Prints a value to standard output",
            parameters: [{name: "value", type: {base_type: "Any", constraints: []}}],
            return_type: {base_type: "Void", constraints: []},
            side_effects: [{type: "output", target: "stdout"}],
            memory_allocation: 0,
            execution_time: 0.005
        }, function_def),
    register_function(context, "print", function_def, result).

# ==== BUILT-IN FUNCTION CALL DETECTION ====

goal is_builtin_function_call(function_name) {
    precondition: function_name != null,
    postcondition: result == true or result == false,
    strategy: builtin_registry_lookup
}

rule is_builtin_function_call_impl(function_name, true) :-
    member(function_name, builtin_functions(_)).

rule is_builtin_function_call_impl(function_name, false) :-
    not member(function_name, builtin_functions(_)).

# ==== BUILT-IN FUNCTION PARSING INTEGRATION ====

goal parse_builtin_function_call(tokens, position) {
    precondition: tokens[position].type == "CALL" and 
                  position + 1 < tokens.length and 
                  tokens[position + 1].type == "IDENTIFIER",
    postcondition: result.type == "FunctionCall" and result.builtin == true,
    strategy: builtin_function_call_parsing
}

rule parse_builtin_function_call_impl(tokens, position, result) :-
    # Parse "call function_name"
    expect_token(tokens, position, "CALL", call_result),
    parse_identifier(tokens, call_result.end_position, name_result),
    is_builtin_function_call(name_result.value, true),
    
    # Parse "with arguments" if present
    parse_optional_function_arguments(tokens, name_result.end_position, args_result),
    
    # Create builtin function call node
    create_function_call_node(name_result.value, args_result.arguments, {builtin: true}, result).

rule parse_optional_function_arguments(tokens, position, result) :-
    position < tokens.length,
    tokens[position].type == "WITH",
    expect_token(tokens, position, "WITH", with_result),
    parse_argument_list(tokens, with_result.end_position, result).

rule parse_optional_function_arguments(tokens, position, result) :-
    (position >= tokens.length or tokens[position].type != "WITH"),
    result = {arguments: [], end_position: position}.

# ==== UNIVERSAL OBJECT NEXT FIELD SUPPORT ====

constrain enhanced_object :: Object where {
    data :: Any,
    type :: Type,
    next :: Optional[Object],  # Universal next field for list functionality
    metadata :: Map[String, Any],
    ref_count :: Number,
    gc_mark :: Boolean
}

goal add_next_field_to_object(object, next_object) {
    precondition: object != null,
    postcondition: result.next == next_object,
    strategy: object_field_enhancement
}

rule add_next_field_to_object_impl(object, next_object, result) :-
    result = object.merge({next: next_object}).

# ==== METHOD CALL SUPPORT FOR LISTS ====

goal parse_list_method_call(tokens, position) {
    precondition: position >= 2 and 
                  tokens[position - 2].type == "IDENTIFIER" and 
                  tokens[position - 1].type == "DOT" and
                  tokens[position].type == "IDENTIFIER",
    postcondition: result.type == "MethodCall" and result.object_type == "List",
    strategy: list_method_parsing
}

fact list_methods(["is_empty", "head", "tail", "to_array", "length"])

rule parse_list_method_call_impl(tokens, position, result) :-
    # Get object identifier (position - 2)
    object_name = tokens[position - 2].value,
    
    # Get method name (position)
    method_name = tokens[position].value,
    member(method_name, list_methods(_)),
    
    # Parse method call arguments if present
    parse_optional_method_arguments(tokens, position + 1, args_result),
    
    # Create method call node
    create_method_call_node(object_name, method_name, args_result.arguments, 
        {object_type: "List", builtin_method: true}, result).

rule parse_optional_method_arguments(tokens, position, result) :-
    position < tokens.length,
    tokens[position].type == "LPAREN",
    parse_parenthesized_argument_list(tokens, position, result).

rule parse_optional_method_arguments(tokens, position, result) :-
    (position >= tokens.length or tokens[position].type != "LPAREN"),
    result = {arguments: [], end_position: position}.