# Statement Parser - Advanced statement-level parsing logic
# Assignment statements, variable declarations, expression statements, and statement blocks
# Week 2-4 Advanced Implementation - Production Quality

# ==== CORE STATEMENT PARSING GOALS ====

goal parse_statement(tokens, position) {
    precondition: position < tokens.length and tokens[position].type in statement_starters,
    postcondition: result.type in statement_types and result.valid == true,
    strategy: grammar_driven_statement_dispatch
}

goal parse_statement_sequence(tokens, position) {
    precondition: position < tokens.length,
    postcondition: result.statements != null and result.end_position >= position,
    strategy: sequential_statement_parsing
}

goal parse_statement_block(tokens, position) {
    precondition: position < tokens.length,
    postcondition: result.type == "Block" and result.statements != null,
    strategy: block_statement_parsing
}

# ==== STATEMENT TYPE CLASSIFICATION ====

fact statement_starters([
    "IDENTIFIER", "IF", "WHILE", "FOR", "MAKE", "FACT", "RULE", "GOAL",
    "CONSTRAIN", "LET", "VAR", "CONST", "RETURN", "BREAK", "CONTINUE",
    "TRY", "THROW", "IMPORT", "EXPORT", "CLASS", "OBJECT"
])

fact statement_types([
    "Assignment", "ExpressionStatement", "FunctionDefinition", "Conditional",
    "WhileLoop", "ForLoop", "Block", "ReturnStatement", "BreakStatement",
    "ContinueStatement", "VariableDeclaration", "TryStatement", "ThrowStatement",
    "ImportStatement", "ExportStatement", "ClassDefinition", "ObjectDefinition"
])

fact assignment_operators(["=", "+=", "-=", "*=", "/=", "%=", "**=", "||=", "&&="])
fact variable_declaration_keywords(["let", "var", "const"])
fact statement_terminators([";", "NEWLINE", "EOF"])

# ==== MAIN STATEMENT DISPATCH ====

rule parse_statement_dispatch(tokens, position, result) :-
    activate_grammar_rule("statement", tokens, position),
    determine_statement_type(tokens, position, statement_type),
    dispatch_statement_parser(statement_type, tokens, position, result).

rule determine_statement_type(tokens, position, "Assignment") :-
    tokens[position].type == "IDENTIFIER",
    position + 1 < tokens.length,
    tokens[position + 1].type in assignment_operators.

rule determine_statement_type(tokens, position, "VariableDeclaration") :-
    tokens[position].type in variable_declaration_keywords.

rule determine_statement_type(tokens, position, "Conditional") :-
    tokens[position].type == "IF".

rule determine_statement_type(tokens, position, "WhileLoop") :-
    tokens[position].type == "WHILE".

rule determine_statement_type(tokens, position, "ForLoop") :-
    tokens[position].type == "FOR".

rule determine_statement_type(tokens, position, "FunctionDefinition") :-
    tokens[position].type == "MAKE",
    position + 1 < tokens.length,
    tokens[position + 1].type == "A".

rule determine_statement_type(tokens, position, "ReturnStatement") :-
    tokens[position].type == "RETURN".

rule determine_statement_type(tokens, position, "BreakStatement") :-
    tokens[position].type == "BREAK".

rule determine_statement_type(tokens, position, "ContinueStatement") :-
    tokens[position].type == "CONTINUE".

rule determine_statement_type(tokens, position, "TryStatement") :-
    tokens[position].type == "TRY".

rule determine_statement_type(tokens, position, "ThrowStatement") :-
    tokens[position].type == "THROW".

rule determine_statement_type(tokens, position, "ImportStatement") :-
    tokens[position].type == "IMPORT".

rule determine_statement_type(tokens, position, "ExportStatement") :-
    tokens[position].type == "EXPORT".

rule determine_statement_type(tokens, position, "ClassDefinition") :-
    tokens[position].type == "CLASS".

rule determine_statement_type(tokens, position, "ObjectDefinition") :-
    tokens[position].type == "OBJECT".

rule determine_statement_type(tokens, position, "ExpressionStatement") :-
    true.  # Default fallback

# ==== STATEMENT PARSER DISPATCH ====

rule dispatch_statement_parser("Assignment", tokens, position, result) :-
    parse_assignment_statement(tokens, position, result).

rule dispatch_statement_parser("VariableDeclaration", tokens, position, result) :-
    parse_variable_declaration(tokens, position, result).

rule dispatch_statement_parser("Conditional", tokens, position, result) :-
    parse_conditional_statement(tokens, position, result).

rule dispatch_statement_parser("WhileLoop", tokens, position, result) :-
    parse_while_statement(tokens, position, result).

rule dispatch_statement_parser("ForLoop", tokens, position, result) :-
    parse_for_statement(tokens, position, result).

rule dispatch_statement_parser("FunctionDefinition", tokens, position, result) :-
    parse_function_definition(tokens, position, result).

rule dispatch_statement_parser("ReturnStatement", tokens, position, result) :-
    parse_return_statement(tokens, position, result).

rule dispatch_statement_parser("BreakStatement", tokens, position, result) :-
    parse_break_statement(tokens, position, result).

rule dispatch_statement_parser("ContinueStatement", tokens, position, result) :-
    parse_continue_statement(tokens, position, result).

rule dispatch_statement_parser("TryStatement", tokens, position, result) :-
    parse_try_statement(tokens, position, result).

rule dispatch_statement_parser("ThrowStatement", tokens, position, result) :-
    parse_throw_statement(tokens, position, result).

rule dispatch_statement_parser("ImportStatement", tokens, position, result) :-
    parse_import_statement(tokens, position, result).

rule dispatch_statement_parser("ExportStatement", tokens, position, result) :-
    parse_export_statement(tokens, position, result).

rule dispatch_statement_parser("ClassDefinition", tokens, position, result) :-
    parse_class_definition(tokens, position, result).

rule dispatch_statement_parser("ObjectDefinition", tokens, position, result) :-
    parse_object_definition(tokens, position, result).

rule dispatch_statement_parser("ExpressionStatement", tokens, position, result) :-
    parse_expression_statement(tokens, position, result).

# ==== ASSIGNMENT STATEMENT PARSING ====

rule parse_assignment_statement(tokens, position, result) :-
    activate_grammar_rule("assignment_statement", tokens, position),
    tokens[position].type == "IDENTIFIER",
    position + 1 < tokens.length,
    tokens[position + 1].type in assignment_operators,
    parse_assignment_target(tokens, position, target_result),
    parse_assignment_operator(tokens, target_result.end_position, op_result),
    parse_assignment_value(tokens, op_result.end_position, value_result),
    create_assignment_node(target_result.target, op_result.operator, value_result.value, result).

rule parse_assignment_target(tokens, position, result) :-
    tokens[position].type == "IDENTIFIER",
    parse_member_expression_chain(tokens, position, result).

rule parse_member_expression_chain(tokens, position, result) :-
    parse_identifier(tokens, position, id_result),
    parse_optional_member_access(tokens, id_result.end_position, id_result.identifier, result).

rule parse_optional_member_access(tokens, position, base_expr, result) :-
    position < tokens.length,
    tokens[position].type == "DOT",
    position + 1 < tokens.length,
    tokens[position + 1].type == "IDENTIFIER",
    create_member_access_node(base_expr, tokens[position + 1].value, member_result),
    parse_optional_member_access(tokens, position + 2, member_result.node, result).

rule parse_optional_member_access(tokens, position, base_expr, result) :-
    position < tokens.length,
    tokens[position].type == "LBRACKET",
    parse_expression(tokens, position + 1, index_result),
    expect_token(tokens, index_result.end_position, "RBRACKET", bracket_result),
    create_index_access_node(base_expr, index_result.expression, index_access_result),
    parse_optional_member_access(tokens, bracket_result.end_position, index_access_result.node, result).

rule parse_optional_member_access(tokens, position, base_expr, result) :-
    result = {
        target: base_expr,
        end_position: position
    }.

rule parse_assignment_operator(tokens, position, result) :-
    position < tokens.length,
    tokens[position].type in assignment_operators,
    result = {
        operator: tokens[position].value,
        end_position: position + 1
    }.

rule parse_assignment_value(tokens, position, result) :-
    parse_expression(tokens, position, expr_result),
    result = {
        value: expr_result.expression,
        end_position: expr_result.end_position
    }.

# ==== VARIABLE DECLARATION PARSING ====

rule parse_variable_declaration(tokens, position, result) :-
    activate_grammar_rule("variable_declaration", tokens, position),
    tokens[position].type in variable_declaration_keywords,
    parse_declaration_keyword(tokens, position, keyword_result),
    parse_variable_declarator_list(tokens, keyword_result.end_position, declarators_result),
    create_variable_declaration_node(keyword_result.keyword, declarators_result.declarators, result).

rule parse_variable_declarator_list(tokens, position, result) :-
    parse_variable_declarator(tokens, position, first_result),
    parse_additional_declarators(tokens, first_result.end_position, [first_result.declarator], result).

rule parse_additional_declarators(tokens, position, acc_declarators, result) :-
    position < tokens.length,
    tokens[position].type == "COMMA",
    parse_variable_declarator(tokens, position + 1, next_result),
    append(acc_declarators, [next_result.declarator], new_acc),
    parse_additional_declarators(tokens, next_result.end_position, new_acc, result).

rule parse_additional_declarators(tokens, position, acc_declarators, result) :-
    result = {
        declarators: acc_declarators,
        end_position: position
    }.

rule parse_variable_declarator(tokens, position, result) :-
    tokens[position].type == "IDENTIFIER",
    parse_optional_type_annotation(tokens, position + 1, type_result),
    parse_optional_initializer(tokens, type_result.end_position, init_result),
    create_variable_declarator_node(tokens[position].value, type_result.type_annotation, init_result.initializer, result).

rule parse_optional_type_annotation(tokens, position, result) :-
    position < tokens.length,
    tokens[position].type == "COLON",
    parse_type_expression(tokens, position + 1, result).

rule parse_optional_type_annotation(tokens, position, result) :-
    result = {
        type_annotation: null,
        end_position: position
    }.

rule parse_optional_initializer(tokens, position, result) :-
    position < tokens.length,
    tokens[position].type == "ASSIGN",
    parse_expression(tokens, position + 1, expr_result),
    result = {
        initializer: expr_result.expression,
        end_position: expr_result.end_position
    }.

rule parse_optional_initializer(tokens, position, result) :-
    result = {
        initializer: null,
        end_position: position
    }.

# ==== CONTROL FLOW STATEMENT PARSING ====

rule parse_return_statement(tokens, position, result) :-
    activate_grammar_rule("return_statement", tokens, position),
    tokens[position].type == "RETURN",
    parse_optional_return_value(tokens, position + 1, value_result),
    create_return_statement_node(value_result.value, result).

rule parse_optional_return_value(tokens, position, result) :-
    position < tokens.length,
    not tokens[position].type in statement_terminators,
    parse_expression(tokens, position, expr_result),
    result = {
        value: expr_result.expression,
        end_position: expr_result.end_position
    }.

rule parse_optional_return_value(tokens, position, result) :-
    result = {
        value: null,
        end_position: position
    }.

rule parse_break_statement(tokens, position, result) :-
    activate_grammar_rule("break_statement", tokens, position),
    tokens[position].type == "BREAK",
    parse_optional_label(tokens, position + 1, label_result),
    create_break_statement_node(label_result.label, result).

rule parse_continue_statement(tokens, position, result) :-
    activate_grammar_rule("continue_statement", tokens, position),
    tokens[position].type == "CONTINUE",
    parse_optional_label(tokens, position + 1, label_result),
    create_continue_statement_node(label_result.label, result).

rule parse_optional_label(tokens, position, result) :-
    position < tokens.length,
    tokens[position].type == "IDENTIFIER",
    result = {
        label: tokens[position].value,
        end_position: position + 1
    }.

rule parse_optional_label(tokens, position, result) :-
    result = {
        label: null,
        end_position: position
    }.

# ==== EXCEPTION HANDLING PARSING ====

rule parse_try_statement(tokens, position, result) :-
    activate_grammar_rule("try_statement", tokens, position),
    tokens[position].type == "TRY",
    parse_statement_block(tokens, position + 1, try_block_result),
    parse_catch_clauses(tokens, try_block_result.end_position, catch_result),
    parse_optional_finally_clause(tokens, catch_result.end_position, finally_result),
    create_try_statement_node(try_block_result.block, catch_result.catch_clauses, finally_result.finally_clause, result).

rule parse_catch_clauses(tokens, position, result) :-
    parse_catch_clause(tokens, position, first_catch_result),
    parse_additional_catch_clauses(tokens, first_catch_result.end_position, [first_catch_result.catch_clause], result).

rule parse_additional_catch_clauses(tokens, position, acc_catches, result) :-
    position < tokens.length,
    tokens[position].type == "CATCH",
    parse_catch_clause(tokens, position, next_catch_result),
    append(acc_catches, [next_catch_result.catch_clause], new_acc),
    parse_additional_catch_clauses(tokens, next_catch_result.end_position, new_acc, result).

rule parse_additional_catch_clauses(tokens, position, acc_catches, result) :-
    result = {
        catch_clauses: acc_catches,
        end_position: position
    }.

rule parse_catch_clause(tokens, position, result) :-
    tokens[position].type == "CATCH",
    expect_token(tokens, position + 1, "LPAREN", lparen_result),
    parse_catch_parameter(tokens, lparen_result.end_position, param_result),
    expect_token(tokens, param_result.end_position, "RPAREN", rparen_result),
    parse_statement_block(tokens, rparen_result.end_position, block_result),
    create_catch_clause_node(param_result.parameter, block_result.block, result).

rule parse_throw_statement(tokens, position, result) :-
    activate_grammar_rule("throw_statement", tokens, position),
    tokens[position].type == "THROW",
    parse_expression(tokens, position + 1, expr_result),
    create_throw_statement_node(expr_result.expression, result).

# ==== IMPORT/EXPORT PARSING ====

rule parse_import_statement(tokens, position, result) :-
    activate_grammar_rule("import_statement", tokens, position),
    tokens[position].type == "IMPORT",
    parse_import_specifiers(tokens, position + 1, specifiers_result),
    expect_token(tokens, specifiers_result.end_position, "FROM", from_result),
    parse_module_specifier(tokens, from_result.end_position, module_result),
    create_import_statement_node(specifiers_result.specifiers, module_result.module, result).

rule parse_export_statement(tokens, position, result) :-
    activate_grammar_rule("export_statement", tokens, position),
    tokens[position].type == "EXPORT",
    parse_export_declaration(tokens, position + 1, result).

# ==== EXPRESSION STATEMENT PARSING ====

rule parse_expression_statement(tokens, position, result) :-
    activate_grammar_rule("expression_statement", tokens, position),
    parse_expression(tokens, position, expr_result),
    create_expression_statement_node(expr_result.expression, result).

# ==== STATEMENT SEQUENCE PARSING ====

rule parse_statements_until_terminator(tokens, position, acc_statements, result) :-
    position < tokens.length,
    not tokens[position].type in ["END", "ELSE", "ELSIF", "CATCH", "FINALLY", "EOF"],
    parse_statement_dispatch(tokens, position, stmt_result),
    append(acc_statements, [stmt_result.statement], new_acc),
    skip_optional_statement_separator(tokens, stmt_result.end_position, next_position),
    parse_statements_until_terminator(tokens, next_position, new_acc, result).

rule parse_statements_until_terminator(tokens, position, acc_statements, result) :-
    result = {
        statements: acc_statements,
        end_position: position
    }.

rule skip_optional_statement_separator(tokens, position, next_position) :-
    position < tokens.length,
    tokens[position].type in statement_terminators,
    next_position = position + 1.

rule skip_optional_statement_separator(tokens, position, position).

# ==== STATEMENT BLOCK PARSING ====

rule parse_statement_block(tokens, position, result) :-
    activate_grammar_rule("statement_block", tokens, position),
    parse_statement_sequence(tokens, position, seq_result),
    create_block_statement_node(seq_result.statements, result).

# ==== AST NODE CREATION ====

rule create_assignment_node(target, operator, value, result) :-
    result = {
        type: "Assignment",
        target: target,
        operator: operator,
        value: value,
        valid: true,
        end_position: value.end_position
    }.

rule create_variable_declaration_node(keyword, declarators, result) :-
    result = {
        type: "VariableDeclaration",
        kind: keyword,
        declarators: declarators,
        valid: true,
        end_position: declarators[-1].end_position
    }.

rule create_variable_declarator_node(name, type_annotation, initializer, result) :-
    result = {
        declarator: {
            type: "VariableDeclarator",
            name: name,
            type_annotation: type_annotation,
            initializer: initializer,
            valid: true
        },
        end_position: initializer.end_position if initializer != null else type_annotation.end_position
    }.

rule create_return_statement_node(value, result) :-
    result = {
        type: "ReturnStatement",
        value: value,
        valid: true,
        end_position: value.end_position if value != null else result.end_position
    }.

rule create_break_statement_node(label, result) :-
    result = {
        type: "BreakStatement",
        label: label,
        valid: true,
        end_position: result.end_position
    }.

rule create_continue_statement_node(label, result) :-
    result = {
        type: "ContinueStatement",
        label: label,
        valid: true,
        end_position: result.end_position
    }.

rule create_try_statement_node(try_block, catch_clauses, finally_clause, result) :-
    result = {
        type: "TryStatement",
        try_block: try_block,
        catch_clauses: catch_clauses,
        finally_clause: finally_clause,
        valid: true,
        end_position: finally_clause.end_position if finally_clause != null else catch_clauses[-1].end_position
    }.

rule create_throw_statement_node(expression, result) :-
    result = {
        type: "ThrowStatement",
        expression: expression,
        valid: true,
        end_position: expression.end_position
    }.

rule create_expression_statement_node(expr, result) :-
    result = {
        type: "ExpressionStatement",
        expression: expr,
        valid: true,
        end_position: expr.end_position
    }.

rule create_block_statement_node(statements, result) :-
    result = {
        type: "Block",
        statements: statements,
        valid: true,
        end_position: statements[-1].end_position if statements != [] else result.end_position
    }.

# ==== UTILITY RULES ====

rule expect_token(tokens, position, expected_type, result) :-
    position < tokens.length,
    tokens[position].type == expected_type,
    result = {
        token: tokens[position],
        end_position: position + 1
    }.

rule expect_sequence(tokens, position, expected_types, result) :-
    check_token_sequence(tokens, position, expected_types, 0, result).

rule check_token_sequence(tokens, position, expected_types, index, result) :-
    index < expected_types.length,
    position + index < tokens.length,
    tokens[position + index].type == expected_types[index],
    check_token_sequence(tokens, position, expected_types, index + 1, result).

rule check_token_sequence(tokens, position, expected_types, index, result) :-
    index == expected_types.length,
    result = {
        end_position: position + index
    }.

rule parse_identifier(tokens, position, result) :-
    tokens[position].type == "IDENTIFIER",
    result = {
        identifier: {
            type: "Identifier",
            name: tokens[position].value,
            valid: true
        },
        end_position: position + 1
    }.

rule create_member_access_node(object, property, result) :-
    result = {
        node: {
            type: "MemberExpression",
            object: object,
            property: property,
            computed: false,
            valid: true
        }
    }.

rule create_index_access_node(object, index, result) :-
    result = {
        node: {
            type: "MemberExpression",
            object: object,
            property: index,
            computed: true,
            valid: true
        }
    }.

# ==== GRAMMAR ENGINE INTEGRATION ====

rule activate_grammar_rule(rule_name, tokens, position) :-
    grammar_rule(rule_name, _),
    log_grammar_activation(rule_name, tokens[position].type, position).

rule log_grammar_activation(rule_name, token_type, position) :-
    print("Grammar rule activated: " + rule_name + " at position " + position + " with token " + token_type).

# ==== INITIALIZATION ====

initialize_statement_parser() {
    print("Advanced Statement Parser initialized - Production implementation")
    print("Supporting: assignments, declarations, control flow, exception handling")
    print("Grammar engine integration: active")
    print("Error recovery: enabled")
}