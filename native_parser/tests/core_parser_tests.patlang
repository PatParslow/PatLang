# Core Parser Tests - Validation of core parser components
# Comprehensive testing of AST system, parse goals, grammar engine, and error recovery

# Test suite initialization
goal run_core_parser_tests() {
    precondition: test_environment_ready == true,
    postcondition: all_tests_completed == true and test_results.recorded == true,
    strategy: comprehensive_core_testing
}

# AST System Tests
rule test_ast_node_creation() :-
    test_binary_operation_node_creation(),
    test_literal_node_creation(),
    test_function_definition_node_creation(),
    test_identifier_node_creation().

rule test_binary_operation_node_creation() :-
    left_node = create_test_literal_node("5"),
    right_node = create_test_literal_node("3"),
    operator_token = create_test_token("PLUS", "+"),
    create_binary_operation_node(left_node, operator_token, right_node, result),
    assert_node_valid(result),
    assert_node_type(result, "BinaryOperation"),
    record_test_result("binary_operation_node_creation", "passed").

rule test_literal_node_creation() :-
    number_token = create_test_token("NUMBER", "42"),
    create_literal_node(number_token, result),
    assert_node_valid(result),
    assert_node_type(result, "Literal"),
    assert_node_value(result, 42),
    record_test_result("literal_node_creation", "passed").

# Parse Goals Tests
rule test_parse_goal_execution() :-
    test_expression_parsing_goal(),
    test_statement_parsing_goal(),
    test_function_definition_goal().

rule test_expression_parsing_goal() :-
    test_tokens = create_test_token_sequence(["NUMBER:5", "PLUS:+", "NUMBER:3"]),
    execute_parsing_goal("parse_expression", test_tokens, result),
    assert_goal_success(result),
    record_test_result("expression_parsing_goal", "passed").

# Grammar Engine Tests
rule test_grammar_rule_application() :-
    test_basic_grammar_matching(),
    test_precedence_handling(),
    test_grammar_validation().

rule test_basic_grammar_matching() :-
    test_tokens = create_test_token_sequence(["NUMBER:42"]),
    apply_grammar_rule("primary", test_tokens, 0, result),
    assert_rule_match_success(result),
    record_test_result("basic_grammar_matching", "passed").

rule test_precedence_handling() :-
    test_tokens = create_test_token_sequence(["NUMBER:2", "PLUS:+", "NUMBER:3", "MULTIPLY:*", "NUMBER:4"]),
    handle_operator_precedence(test_tokens, 0, result),
    # Should parse as: 2 + (3 * 4)
    assert_precedence_correct(result),
    record_test_result("precedence_handling", "passed").

# Error Recovery Tests
rule test_error_recovery_mechanisms() :-
    test_unexpected_token_recovery(),
    test_missing_token_recovery(),
    test_error_message_generation().

rule test_unexpected_token_recovery() :-
    # Test with unexpected token in expression
    test_tokens = create_test_token_sequence(["NUMBER:5", "UNKNOWN:@", "NUMBER:3"]),
    error_context = create_error_context("unexpected_token", test_tokens, 1),
    recover_from_parse_error(error_context, recovery_result),
    assert_recovery_success(recovery_result),
    record_test_result("unexpected_token_recovery", "passed").

rule test_missing_token_recovery() :-
    # Test with missing closing parenthesis
    test_tokens = create_test_token_sequence(["LPAREN:(", "NUMBER:5", "PLUS:+", "NUMBER:3"]),
    error_context = create_error_context("missing_required_token", test_tokens, 4),
    recover_from_parse_error(error_context, recovery_result),
    assert_recovery_success(recovery_result),
    record_test_result("missing_token_recovery", "passed").

# Integration Tests for Core Components
rule test_core_component_integration() :-
    test_ast_grammar_integration(),
    test_goal_error_recovery_integration(),
    test_complete_parsing_pipeline().

rule test_ast_grammar_integration() :-
    # Test that grammar engine properly creates AST nodes
    test_tokens = create_test_token_sequence(["IF:if", "TRUE:true", "THEN:then", "NUMBER:1", "END:end"]),
    apply_grammar_rule("conditional_statement", test_tokens, 0, grammar_result),
    create_conditional_node(grammar_result.condition, grammar_result.then_branch, 
                           grammar_result.else_branch, ast_result),
    assert_node_valid(ast_result),
    record_test_result("ast_grammar_integration", "passed").

# Test utilities and helpers
rule create_test_token(token_type, token_value) :-
    token = {
        type: token_type,
        value: token_value,
        position: {
            line: 1,
            column: 1,
            absolute_position: 0
        }
    }.

rule create_test_token_sequence(token_specs) :-
    create_tokens_from_specs(token_specs, 0, []).

rule create_tokens_from_specs([], position, accumulated_tokens) :-
    accumulated_tokens.

rule create_tokens_from_specs([spec | remaining_specs], position, accumulated_tokens) :-
    parse_token_spec(spec, token_type, token_value),
    create_test_token(token_type, token_value, token),
    token.position.absolute_position = position,
    create_tokens_from_specs(remaining_specs, position + 1, accumulated_tokens + [token]).

rule parse_token_spec(spec, token_type, token_value) :-
    split_by_colon(spec, [token_type, token_value]).

rule create_test_literal_node(value) :-
    token = create_test_token("NUMBER", value),
    create_literal_node(token).

rule create_error_context(error_type, tokens, position) :-
    context = {
        error_type: error_type,
        tokens: tokens,
        position: position,
        expected: ["RPAREN", "END", "SEMICOLON"]
    }.

# Test assertions
rule assert_node_valid(node) :-
    node.valid == true,
    node.type != null.

rule assert_node_type(node, expected_type) :-
    node.type == expected_type.

rule assert_node_value(node, expected_value) :-
    node.value == expected_value.

rule assert_goal_success(result) :-
    result.success == true.

rule assert_rule_match_success(result) :-
    result.success == true,
    result.matched_tokens != [].

rule assert_precedence_correct(result) :-
    # Verify that multiplication binds tighter than addition
    result.ast_node.type == "BinaryOperation",
    result.ast_node.operator == "+",
    result.ast_node.right.type == "BinaryOperation",
    result.ast_node.right.operator == "*".

rule assert_recovery_success(result) :-
    result.can_continue == true,
    result.recovery_action != null.

# Test result tracking
fact test_results([])
fact tests_passed(0)
fact tests_failed(0)

rule record_test_result(test_name, result) :-
    test_record = {
        name: test_name,
        result: result,
        timestamp: current_timestamp()
    },
    test_results = test_results + [test_record],
    (result == "passed" -> tests_passed = tests_passed + 1 ; tests_failed = tests_failed + 1).

# Test suite execution
run_all_core_tests() {
    print("Running Core Parser Tests..."),
    test_ast_node_creation(),
    test_parse_goal_execution(),
    test_grammar_rule_application(),
    test_error_recovery_mechanisms(),
    test_core_component_integration(),
    print("Core Parser Tests completed"),
    print("Tests passed: " + tests_passed),
    print("Tests failed: " + tests_failed)
}

initialize_core_parser_tests() {
    print("Core Parser Tests initialized - placeholder implementation")
}