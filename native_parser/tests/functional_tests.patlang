# Functional Programming Tests

# First-class and higher-order functions
fn add(a, b) { a + b }
fn apply(f, x, y) { f(x, y) }

result1 = apply(add, 2, 3)

# Recursion
fn factorial(n) {
    if n <= 1 { 1 }
    else { n * factorial(n - 1) }
}

result2 = factorial(5)

# Lambdas and closures
fn make_adder(x) {
    fn adder(y) { x + y }
    adder
}

add5 = make_adder(5)
result3 = add5(10)