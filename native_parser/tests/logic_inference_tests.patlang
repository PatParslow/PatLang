# Logic Inference and Reasoning Tests

fact parent(john, mary).
fact parent(mary, alice).

rule ancestor(X, Y) :-
    parent(X, Y).

rule ancestor(X, Y) :-
    parent(X, Z),
    ancestor(Z, Y).

query ancestor(john, alice).

# Contradiction test
fact mortal(socrates).
fact immortal(socrates).

query mortal(socrates).
query immortal(socrates).