# Phase 1 Core Parser Framework Tests
# Validates implementation of the core parsing components

# Test framework initialization
goal run_phase1_tests() {
    precondition: parser_system_initialized == true,
    postcondition: all_core_tests_passed == true and test_report_generated == true,
    strategy: comprehensive_core_testing
}

# Core Parser Tests
goal test_main_parser_initialization() {
    precondition: true,
    postcondition: parser_created == true and parser_valid == true,
    strategy: initialization_testing
}

rule test_create_native_parser() :-
    test_tokens = create_test_token_stream(),
    parser = create_native_parser(test_tokens),
    validate_parser_structure(parser, validation_result),
    assert_test_result("create_native_parser", validation_result.valid).

rule create_test_token_stream() :-
    [
        {type: "NUMBER", value: "42", position: {line: 1, column: 1, absolute_position: 0}},
        {type: "PLUS", value: "+", position: {line: 1, column: 4, absolute_position: 3}},
        {type: "NUMBER", value: "3", position: {line: 1, column: 6, absolute_position: 5}},
        {type: "EOF", value: "", position: {line: 1, column: 7, absolute_position: 6}}
    ].

rule validate_parser_structure(parser, validation_result) :-
    parser.state != null,
    parser.parse != null,
    parser.advance != null,
    parser.error_count != null,
    validation_result = {valid: true, parser: parser}.

# AST System Tests
goal test_ast_system() {
    precondition: ast_system_initialized == true,
    postcondition: ast_creation_tests_passed == true,
    strategy: ast_system_testing
}

rule test_binary_operation_ast_creation() :-
    left_operand = {type: "Literal", literal_type: "Number", value: 42, source_location: test_location()},
    right_operand = {type: "Literal", literal_type: "Number", value: 3, source_location: test_location()},
    operator_token = {type: "PLUS", value: "+", position: test_location()},
    create_binary_operation_node(left_operand, operator_token, right_operand, result),
    validate_binary_operation_node(result, validation_result),
    assert_test_result("binary_operation_ast_creation", validation_result.valid).

rule test_literal_node_creation() :-
    number_token = {type: "NUMBER", value: "42", position: test_location()},
    create_literal_node(number_token, result),
    validate_literal_node(result, validation_result),
    assert_test_result("literal_node_creation", validation_result.valid).

rule test_identifier_node_creation() :-
    identifier_token = {type: "IDENTIFIER", value: "my_variable", position: test_location()},
    create_identifier_node(identifier_token, result),
    validate_identifier_node(result, validation_result),
    assert_test_result("identifier_node_creation", validation_result.valid).

rule validate_binary_operation_node(node, validation_result) :-
    node.type == "BinaryOperation",
    node.operator != null,
    node.left != null,
    node.right != null,
    node.valid == true,
    validation_result = {valid: true, node: node}.

rule validate_literal_node(node, validation_result) :-
    node.type == "Literal",
    node.value != null,
    node.literal_type != null,
    node.valid == true,
    validation_result = {valid: true, node: node}.

rule validate_identifier_node(node, validation_result) :-
    node.type == "Identifier",
    node.name != null,
    node.valid == true,
    validation_result = {valid: true, node: node}.

# Parse Goals Tests
goal test_parse_goals_system() {
    precondition: parse_goals_initialized == true,
    postcondition: goal_execution_tests_passed == true,
    strategy: parse_goals_testing
}

rule test_expression_parsing_goal() :-
    test_context = create_expression_test_context(),
    execute_parsing_goal("parse_expression", test_context, result),
    validate_goal_execution_result(result, validation_result),
    assert_test_result("expression_parsing_goal", validation_result.valid).

rule test_statement_parsing_goal() :-
    test_context = create_statement_test_context(),
    execute_parsing_goal("parse_statement", test_context, result),
    validate_goal_execution_result(result, validation_result),
    assert_test_result("statement_parsing_goal", validation_result.valid).

rule create_expression_test_context() :-
    {
        tokens: create_expression_token_stream(),
        position: 0,
        selected_strategy: "precedence_climbing_with_reasoning"
    }.

rule create_statement_test_context() :-
    {
        tokens: create_assignment_token_stream(),
        position: 0,
        selected_strategy: "context_aware_statement_parsing"
    }.

rule create_expression_token_stream() :-
    [
        {type: "NUMBER", value: "2", position: test_location()},
        {type: "PLUS", value: "+", position: test_location()},
        {type: "NUMBER", value: "3", position: test_location()},
        {type: "MULTIPLY", value: "*", position: test_location()},
        {type: "NUMBER", value: "4", position: test_location()},
        {type: "EOF", value: "", position: test_location()}
    ].

rule create_assignment_token_stream() :-
    [
        {type: "IDENTIFIER", value: "x", position: test_location()},
        {type: "ASSIGN", value: "=", position: test_location()},
        {type: "NUMBER", value: "5", position: test_location()},
        {type: "EOF", value: "", position: test_location()}
    ].

rule validate_goal_execution_result(result, validation_result) :-
    result.success == true,
    result.result != null,
    validation_result = {valid: true, result: result}.

# Error Recovery Tests
goal test_error_recovery_system() {
    precondition: error_recovery_initialized == true,
    postcondition: error_recovery_tests_passed == true,
    strategy: error_recovery_testing
}

rule test_unexpected_token_recovery() :-
    error_context = create_unexpected_token_error_context(),
    select_optimal_recovery_strategy(error_context, recovery_strategy),
    apply_recovery_strategy(recovery_strategy, error_context, recovery_result),
    validate_recovery_result(recovery_result, validation_result),
    assert_test_result("unexpected_token_recovery", validation_result.valid).

rule test_missing_token_recovery() :-
    error_context = create_missing_token_error_context(),
    select_optimal_recovery_strategy(error_context, recovery_strategy),
    apply_recovery_strategy(recovery_strategy, error_context, recovery_result),
    validate_recovery_result(recovery_result, validation_result),
    assert_test_result("missing_token_recovery", validation_result.valid).

rule create_unexpected_token_error_context() :-
    {
        error_type: "unexpected_token",
        token: {type: "SEMICOLON", value: ";", position: test_location()},
        expected: ["NUMBER", "IDENTIFIER"],
        position: test_location(),
        context: create_test_parsing_context()
    }.

rule create_missing_token_error_context() :-
    {
        error_type: "missing_required_token",
        expected: ["RPAREN"],
        position: test_location(),
        context: create_test_parsing_context()
    }.

rule validate_recovery_result(result, validation_result) :-
    result.can_continue == true,
    result.recovery_action != null,
    validation_result = {valid: true, result: result}.

# Integration Tests
goal test_lexer_integration() {
    precondition: lexer_interface_initialized == true,
    postcondition: integration_tests_passed == true,
    strategy: integration_testing
}

rule test_token_stream_processing() :-
    mock_lexer = create_mock_lexer(),
    process_lexer_token_stream(mock_lexer, token_stream),
    validate_token_stream(token_stream, validation_result),
    assert_test_result("token_stream_processing", validation_result.valid).

rule test_token_format_conversion() :-
    native_token = create_mock_native_token(),
    convert_token_format(native_token, parser_token),
    validate_converted_token(parser_token, validation_result),
    assert_test_result("token_format_conversion", validation_result.valid).

rule create_mock_lexer() :-
    {
        tokens: [
            {type: "IDENTIFIER", value: "x", line: 1, column: 1, absolute_pos: 0},
            {type: "ASSIGN", value: "=", line: 1, column: 3, absolute_pos: 2},
            {type: "NUMBER", value: "42", line: 1, column: 5, absolute_pos: 4}
        ],
        position: 0,
        has_more_tokens: lambda() -> this.position < this.tokens.length,
        next_token: lambda(token) -> {
            if (this.position < this.tokens.length) {
                token = this.tokens[this.position],
                this.position = this.position + 1
            }
        }
    }.

rule create_mock_native_token() :-
    {
        type: "NUMBER",
        value: "42",
        line: 1,
        column: 1,
        absolute_pos: 0,
        confidence: 1.0
    }.

rule validate_token_stream(stream, validation_result) :-
    stream != [],
    stream[stream.length - 1].type == "EOF",
    all_tokens_have_positions(stream),
    validation_result = {valid: true, stream: stream}.

rule validate_converted_token(token, validation_result) :-
    token.type != null,
    token.value != null,
    token.position != null,
    token.position.line != null,
    token.position.column != null,
    validation_result = {valid: true, token: token}.

rule all_tokens_have_positions([]).
rule all_tokens_have_positions([token | rest]) :-
    token.position != null,
    all_tokens_have_positions(rest).

# Expression Parser Tests
goal test_expression_parser() {
    precondition: expression_parser_initialized == true,
    postcondition: expression_parsing_tests_passed == true,
    strategy: expression_parser_testing
}

rule test_arithmetic_expression_parsing() :-
    test_tokens = create_arithmetic_expression_tokens(),
    parse_expression_with_precedence(test_tokens, 0, 0, result),
    validate_expression_parse_result(result, validation_result),
    assert_test_result("arithmetic_expression_parsing", validation_result.valid).

rule test_function_call_parsing() :-
    test_tokens = create_function_call_tokens(),
    parse_function_call_expression(test_tokens, 0, result),
    validate_function_call_result(result, validation_result),
    assert_test_result("function_call_parsing", validation_result.valid).

rule create_arithmetic_expression_tokens() :-
    [
        {type: "NUMBER", value: "2", position: test_location()},
        {type: "PLUS", value: "+", position: test_location()},
        {type: "NUMBER", value: "3", position: test_location()},
        {type: "MULTIPLY", value: "*", position: test_location()},
        {type: "NUMBER", value: "4", position: test_location()}
    ].

rule create_function_call_tokens() :-
    [
        {type: "IDENTIFIER", value: "add", position: test_location()},
        {type: "LPAREN", value: "(", position: test_location()},
        {type: "NUMBER", value: "2", position: test_location()},
        {type: "COMMA", value: ",", position: test_location()},
        {type: "NUMBER", value: "3", position: test_location()},
        {type: "RPAREN", value: ")", position: test_location()}
    ].

rule validate_expression_parse_result(result, validation_result) :-
    result.success == true,
    result.ast_node != null,
    result.ast_node.type == "BinaryOperation",
    validation_result = {valid: true, result: result}.

rule validate_function_call_result(result, validation_result) :-
    result.success == true,
    result.ast_node != null,
    result.ast_node.type == "FunctionCall",
    result.ast_node.function_name == "add",
    result.ast_node.arguments.length == 2,
    validation_result = {valid: true, result: result}.

# Utility functions for testing
rule test_location() :-
    {line: 1, column: 1, absolute_position: 0, filename: "test.patlang"}.

rule create_test_parsing_context() :-
    {
        scope_stack: ["global"],
        variable_declarations: [],
        function_declarations: [],
        reasoning_mode: false
    }.

# Test execution framework
fact test_results([])
fact tests_run(0)
fact tests_passed(0)
fact tests_failed(0)

rule assert_test_result(test_name, success) :-
    tests_run = tests_run + 1,
    (success == true ->
        tests_passed = tests_passed + 1
    ;
        tests_failed = tests_failed + 1
    ),
    test_result = {name: test_name, success: success, timestamp: current_timestamp()},
    test_results = test_results + [test_result],
    log_test_result(test_name, success).

rule log_test_result(test_name, success) :-
    success == true,
    print("✓ " + test_name + " PASSED").

rule log_test_result(test_name, success) :-
    success == false,
    print("✗ " + test_name + " FAILED").

# Master test runner
rule run_all_phase1_tests() :-
    print("Running Phase 1 Core Parser Framework Tests..."),
    print(""),
    
    # Core Parser Tests
    test_create_native_parser(),
    
    # AST System Tests
    test_binary_operation_ast_creation(),
    test_literal_node_creation(),
    test_identifier_node_creation(),
    
    # Parse Goals Tests
    test_expression_parsing_goal(),
    test_statement_parsing_goal(),
    
    # Error Recovery Tests
    test_unexpected_token_recovery(),
    test_missing_token_recovery(),
    
    # Integration Tests
    test_token_stream_processing(),
    test_token_format_conversion(),
    
    # Expression Parser Tests
    test_arithmetic_expression_parsing(),
    test_function_call_parsing(),
    
    # Generate test report
    generate_test_report().

rule generate_test_report() :-
    print(""),
    print("=== Phase 1 Core Parser Framework Test Report ==="),
    print("Tests Run: " + tests_run),
    print("Passed: " + tests_passed),
    print("Failed: " + tests_failed),
    success_rate = (tests_passed / tests_run) * 100,
    print("Success Rate: " + success_rate + "%"),
    print(""),
    (tests_failed == 0 ->
        print("🎉 All Phase 1 core tests PASSED! Core framework is ready.")
    ;
        print("⚠️  Some tests failed. Review implementation before proceeding to Phase 2.")
    ).

# Test initialization
initialize_phase1_testing() {
    print("Phase 1 Core Parser Framework Testing initialized"),
    print("Ready to validate core parsing components")
}