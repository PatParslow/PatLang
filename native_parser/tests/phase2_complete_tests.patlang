# ==== TEST DATA AND MOCK FUNCTIONS ====

# Mock parsing functions for testing
rule test_parse_assignment(code, result) :-
    tokenize(code, tokens),
    parse_assignment_statement(tokens, 0, result).

rule test_parse_declaration(code, result) :-
    tokenize(code, tokens),
    parse_variable_declaration(tokens, 0, result).

rule test_parse_function(code, result) :-
    tokenize(code, tokens),
    parse_function_definition(tokens, 0, result).

rule test_parse_control_flow(code, result) :-
    tokenize(code, tokens),
    parse_control_flow_dispatch(tokens, 0, result).

rule test_parse_reasoning(code, result) :-
    tokenize(code, tokens),
    parse_reasoning_dispatch(tokens, 0, result).

# Mock tokenizer for testing
rule tokenize(code, tokens) :-
    # This would integrate with the actual lexer
    # For testing purposes, assume tokenization works
    mock_tokenize(code, tokens).

rule mock_tokenize(code, tokens) :-
    # Simplified mock tokenization
    split_into_tokens(code, tokens).

