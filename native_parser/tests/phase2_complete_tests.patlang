rule test_conditional_statements() :-
    print("Testing conditional statements..."),
    
    # Simple if statement
    test_parse_control_flow("if x > 0 then print('positive') end", simple_if_result),
    assert_conditional(simple_if_result, "if", 1, 0, 0),
    
    # If-else statement
    test_parse_control_flow("if x > 0 then print('positive') else print('non-positive') end", if_else_result),
    assert_conditional(if_else_result, "if", 1, 0, 1),
    
    # If-elsif-else statement
    test_parse_complex_conditional(if_elsif_else_result),
    assert_conditional(if_elsif_else_result, "if", 1, 2, 1),
    
    # Unless statement
    test_parse_control_flow("unless x == 0 then print('non-zero') end", unless_result),
    assert_conditional(unless_result, "unless", 1, 0, 0),
    
    print("Conditional statements: PASSED").

rule test_loop_statements() :-
    print("Testing loop statements..."),
    
    # While loop
    test_parse_control_flow("while i < 10 do i = i + 1 end", while_result),
    assert_while_loop(while_result),
    
    # For-in loop
    test_parse_control_flow("for item in collection do print(item) end", for_in_result),
    assert_for_in_loop(for_in_result),
    
    # Until loop
    test_parse_control_flow("until done do work() end", until_result),
    assert_until_loop(until_result),
    
    # Infinite loop
    test_parse_control_flow("loop do work() if should_break then break end end", infinite_result),
    assert_infinite_loop(infinite_result),
    
    print("Loop statements: PASSED").

rule test_complex_conditions() :-
    print("Testing complex conditions..."),
    
    # Logical AND condition
    test_parse_condition("x > 0 and y < 10", and_condition_result),
    assert_binary_condition(and_condition_result, "AND"),
    
    # Logical OR condition
    test_parse_condition("x == 0 or y == 0", or_condition_result),
    assert_binary_condition(or_condition_result, "OR"),
    
    # Negated condition
    test_parse_condition("not finished", not_condition_result),
    assert_unary_condition(not_condition_result, "NOT"),
    
    # Complex nested condition
    test_parse_condition("(x > 0 and y > 0) or (x < 0 and y < 0)", complex_condition_result),
    assert_complex_nested_condition(complex_condition_result),
    
    print("Complex conditions: PASSED").

rule test_nested_control_structures() :-
    print("Testing nested control structures..."),
    
    # Nested if statements
    test_parse_nested_control_flow(nested_if_result),
    assert_nested_structure(nested_if_result, 2),
    
    # Loop with conditional inside
    test_parse_loop_with_conditional(loop_conditional_result),
    assert_loop_with_conditional(loop_conditional_result),
    
