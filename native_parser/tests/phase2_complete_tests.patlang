# ==== TEST EXECUTION AND REPORTING ====

run_all_phase2_tests() {
    print("🚀 RUNNING PHASE 2 COMPLETE TEST SUITE"),
    print("=" * 60),
    
    initialize_phase2_test_suite(),
    
    # Run all test categories
    test_statement_parser_comprehensive(),
    test_function_parser_comprehensive(),
    test_control_flow_parser_comprehensive(),
    test_reasoning_parser_comprehensive(),
    test_parser_integration(),
    test_ruby_compatibility(),
    
    # Generate test report
    generate_test_report(),
    
    print("=" * 60),
    print("🎯 PHASE 2 COMPLETE TEST SUITE FINISHED")
end

rule generate_test_report() :-
    test_statistics(passed: P, failed: F, total: T, errors: E),
    print("📊 TEST RESULTS SUMMARY:"),
    print("  Total Tests: " + T),
    print("  Passed: " + P),
    print("  Failed: " + F),
    Success_Rate = (P * 100) / T,
    print("  Success Rate: " + Success_Rate + "%"),
    
    (F > 0 -> 
        (print("❌ FAILED TESTS:"), report_failed_tests(E)) ;
        print("✅ ALL TESTS PASSED!")),
    
    (Success_Rate >= 95 -> 
        print("🏆 EXCELLENT: Phase 2 implementation ready for production") ;
    Success_Rate >= 90 -> 
        print("👍 GOOD: Phase 2 implementation largely complete") ;
        print("⚠️  NEEDS WORK: Phase 2 implementation requires fixes")).

rule report_failed_tests([]).
rule report_failed_tests([Error | Rest]) :-
    print("  - " + Error),
    report_failed_tests(Rest).

# ==== ASSERTION HELPERS ====

rule assert_assignment_node(result, target, operator, value) :-
    result.type == "Assignment",
    result.target == target,
    result.operator == operator,
    result.value.value == value,
    update_test_statistics("PASS").

rule assert_assignment_node(result, target, operator, value) :-
    update_test_statistics("FAIL: Assignment assertion failed").

rule assert_variable_declaration(result, kind, name, value) :-
    result.type == "VariableDeclaration",
    result.kind == kind,
    result.declarators[0].name == name,
    result.declarators[0].initializer.value == value,
    update_test_statistics("PASS").

rule assert_variable_declaration(result, kind, name, value) :-
    update_test_statistics("FAIL: Variable declaration assertion failed").

rule assert_natural_language_function(result, name, param_count) :-
    result.type == "FunctionDefinition",
    result.syntax_type == "natural_language",
    result.name == name,
    length(result.parameters, param_count),
    update_test_statistics("PASS").

rule assert_natural_language_function(result, name, param_count) :-
    update_test_statistics("FAIL: Natural language function assertion failed").

rule assert_conditional(result, cond_type, then_count, elsif_count, else_count) :-
    result.type == "Conditional",
    result.conditional_type == cond_type,
    length(result.then_branch, then_count),
    length(result.elsif_clauses, elsif_count),
    (else_count == 0 -> result.else_branch == null ; length(result.else_branch, else_count)),
    update_test_statistics("PASS").

rule assert_conditional(result, cond_type, then_count, elsif_count, else_count) :-
    update_test_statistics("FAIL: Conditional assertion failed").

rule assert_fact(result, predicate, arity) :-
    result.type == "Fact",
    result.predicate == predicate,
    length(result.arguments, arity),
    update_test_statistics("PASS").

rule assert_fact(result, predicate, arity) :-
    update_test_statistics("FAIL: Fact assertion failed").

rule assert_rule(result, head_predicate, head_arity) :-
    result.type == "Rule",
    result.head.predicate == head_predicate,
    length(result.head.arguments, head_arity),
    update_test_statistics("PASS").

rule assert_rule(result, head_predicate, head_arity) :-
    update_test_statistics("FAIL: Rule assertion failed").

