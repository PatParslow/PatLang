rule test_natural_language_functions() :-
    print("Testing natural language functions..."),
    
    # Basic natural language function
    test_parse_function("make a function called add takes x, y returns x + y end", basic_nl_result),
    assert_natural_language_function(basic_nl_result, "add", 2),
    
    # Function without parameters
    test_parse_function("make a function called hello print('Hello') end", no_params_result),
    assert_natural_language_function(no_params_result, "hello", 0),
    
    # Function with complex body
    test_parse_complex_natural_function(complex_nl_result),
    assert_complex_function_body(complex_nl_result),
    
    print("Natural language functions: PASSED").

rule test_traditional_functions() :-
    print("Testing traditional functions..."),
    
    # Traditional function syntax
    test_parse_function("function add(x, y) { return x + y }", traditional_result),
    assert_traditional_function(traditional_result, "add", 2),
    
    # Short form function
    test_parse_function("def multiply(a, b) a * b end", short_form_result),
    assert_short_form_function(short_form_result, "multiply", 2),
    
    print("Traditional functions: PASSED").

rule test_function_parameters() :-
    print("Testing function parameters..."),
    
    # Required parameters
    test_parse_function_parameters("(a, b, c)", required_params_result),
    assert_parameter_types(required_params_result, ["required", "required", "required"]),
    
    # Optional parameters
    test_parse_function_parameters("(a, b = 10, c = 20)", optional_params_result),
    assert_parameter_types(optional_params_result, ["required", "optional", "optional"]),
    
    # Rest parameters
    test_parse_function_parameters("(first, *rest)", rest_params_result),
    assert_parameter_types(rest_params_result, ["required", "rest"]),
    
    # Keyword parameters
    test_parse_function_parameters("(a, b:, c: = 42)", keyword_params_result),
    assert_parameter_types(keyword_params_result, ["required", "keyword", "keyword"]),
    
    # Mixed parameter types
    test_parse_function_parameters("(req, opt = 1, *rest, kw:, kw_opt: = 2)", mixed_params_result),
    assert_mixed_parameter_types(mixed_params_result),
    
    print("Function parameters: PASSED").

rule test_lambda_and_proc_functions() :-
    print("Testing lambda and proc functions..."),
    
    # Lambda function
    test_parse_function("lambda(x, y) { x + y }", lambda_result),
    assert_lambda_function(lambda_result, 2),
    
    # Lambda with expression body
    test_parse_function("lambda(x) x * 2", lambda_expr_result),
    assert_lambda_expression_body(lambda_expr_result),
    
    # Proc function
    test_parse_function("proc { puts 'Hello from proc' }", proc_result),
    assert_proc_function(proc_result),
    
    print("Lambda and proc functions: PASSED").

rule test_function_calls() :-
    print("Testing function calls..."),
    
    # Simple function call
    test_parse_function_call("add(1, 2)", simple_call_result),
    assert_function_call(simple_call_result, "add", 2),
    
    # Function call with keyword arguments
    test_parse_function_call("create_user(name: 'John', age: 30)", keyword_call_result),
    assert_keyword_arguments(keyword_call_result),
    
    # Function call with block
    test_parse_function_call("each_item(arr) { |item| print(item) }", block_call_result),
    assert_block_argument(block_call_result),
    
    print("Function calls: PASSED").

