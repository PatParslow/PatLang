# Phase 2 Complete Tests - Comprehensive test coverage for advanced parsers
# Tests all Week 2-4 parser components with integration validation
# Complete test suite for production-quality parser implementation

# ==== TEST FRAMEWORK INITIALIZATION ====

initialize_phase2_test_suite() {
    print("Phase 2 Complete Test Suite - Advanced Parser Testing")
    print("Testing: Statement, Function, Control Flow, and Reasoning Parsers")
    print("Coverage: Production implementations, integration, performance")
    reset_test_statistics()
}

# Test statistics tracking
fact test_statistics(passed: 0, failed: 0, total: 0, errors: [])

rule reset_test_statistics() :-
    retract_all(test_statistics(_)),
    assert(test_statistics(passed: 0, failed: 0, total: 0, errors: [])).

rule update_test_statistics(result) :-
    test_statistics(passed: P, failed: F, total: T, errors: E),
    retract(test_statistics(passed: P, failed: F, total: T, errors: E)),
    (result == "PASS" -> 
        assert(test_statistics(passed: P + 1, failed: F, total: T + 1, errors: E)) ;
        assert(test_statistics(passed: P, failed: F + 1, total: T + 1, errors: [result | E]))).

# ==== STATEMENT PARSER TESTS ====

test_statement_parser_comprehensive() {
    print("=== STATEMENT PARSER COMPREHENSIVE TESTS ===")
    
    # Test assignment statements
    test_assignment_statements(),
    
    # Test variable declarations
    test_variable_declarations(),
    
    # Test expression statements
    test_expression_statements(),
    
    # Test control flow statements
    test_control_flow_integration(),
    
    # Test exception handling
    test_exception_handling_statements(),
    
    # Test import/export statements
    test_import_export_statements(),
    
    print("Statement parser tests completed")
}

rule test_assignment_statements() :-
    print("Testing assignment statements..."),
    
    # Simple assignment
    test_parse_assignment("x = 42", simple_assignment_result),
    assert_assignment_node(simple_assignment_result, "x", "=", "42"),
    
    # Complex assignment with member access
    test_parse_assignment("obj.property = getValue()", member_assignment_result),
    assert_member_assignment(member_assignment_result),
    
    # Array index assignment
    test_parse_assignment("arr[0] = value", index_assignment_result),
    assert_index_assignment(index_assignment_result),
    
    # Compound assignment operators
    test_parse_assignment("counter += 1", compound_assignment_result),
    assert_compound_assignment(compound_assignment_result, "+="),
    
    # Multiple assignment types
    test_multiple_assignment_operators(),
    
    print("Assignment statements: PASSED").

rule test_variable_declarations() :-
    print("Testing variable declarations..."),
    
    # Let declaration
    test_parse_declaration("let x = 42", let_result),
    assert_variable_declaration(let_result, "let", "x", "42"),
    
    # Const declaration
    test_parse_declaration("const PI = 3.14159", const_result),
    assert_variable_declaration(const_result, "const", "PI", "3.14159"),
    
    # Variable with type annotation
    test_parse_declaration("let count: Number = 0", typed_result),
    assert_typed_variable_declaration(typed_result),
    
    # Multiple declarators
    test_parse_declaration("let a = 1, b = 2, c = 3", multiple_result),
    assert_multiple_declarators(multiple_result, 3),
    
    print("Variable declarations: PASSED").

rule test_expression_statements() :-
    print("Testing expression statements..."),
    
    # Function call as statement
    test_parse_expression_statement("print('Hello World')", call_result),
    assert_expression_statement(call_result, "FunctionCall"),
    
    # Method call as statement
    test_parse_expression_statement("obj.method()", method_result),
    assert_expression_statement(method_result, "MethodCall"),
    
    # Complex expression
    test_parse_expression_statement("Math.sqrt(x * x + y * y)", complex_result),
    assert_complex_expression_statement(complex_result),
    
    print("Expression statements: PASSED").

rule test_control_flow_integration() :-
    print("Testing control flow integration..."),
    
    # Return statements
    test_parse_statement("return 42", return_result),
    assert_return_statement(return_result, "42"),
    
    # Break and continue
    test_parse_statement("break", break_result),
    assert_break_statement(break_result),
    
    test_parse_statement("continue", continue_result),
    assert_continue_statement(continue_result),
    
    print("Control flow integration: PASSED").

rule test_exception_handling_statements() :-
    print("Testing exception handling..."),
    
    # Try-catch statement
    test_parse_try_catch_statement(try_catch_result),
    assert_try_catch_structure(try_catch_result),
    
    # Throw statement
    test_parse_statement("throw new Error('Test error')", throw_result),
    assert_throw_statement(throw_result),
    
    print("Exception handling: PASSED").

# ==== FUNCTION PARSER TESTS ====

test_function_parser_comprehensive() {
    print("=== FUNCTION PARSER COMPREHENSIVE TESTS ===")
    
    # Test natural language functions
    test_natural_language_functions(),
    
    # Test traditional function syntax
