# Setup/Teardown and Contract Enforcement Tests

test "setup and teardown run in order" {
  setup {
    x = 1
    print("SETUP: x = " + x)
  }
  x = x + 1
  print("BODY: x = " + x)
  teardown {
    print("TEARDOWN: x = " + x)
  }
}

test "contract enforcement: setup not a block" {
  setup 42
  print("This should not run")
}

test "goal-oriented requirement" {
  goal increment_goal() {
    precondition: x == 2,
    postcondition: x == 3
  }
  setup {
    x = 2
  }
  x = x + 1
  assert increment_goal()
}