# Test Utilities - Shared testing utilities and helpers
# Common functions for all test suites

# Test environment setup
rule setup_test_environment() :-
    initialize_test_data(),
    configure_test_settings(),
    prepare_mock_components().

# Test data generation
rule generate_test_tokens(count, token_list) :-
    create_token_sequence(count, 0, [], token_list).

rule create_token_sequence(0, position, accumulated, accumulated).
rule create_token_sequence(count, position, accumulated, result) :-
    count > 0,
    create_test_token_at_position(position, token),
    create_token_sequence(count - 1, position + 1, accumulated + [token], result).

# Mock component creation
rule create_mock_lexer(mock_lexer) :-
    mock_lexer = {
        type: "MockLexer",
        initialized: true,
        has_more_tokens: mock_has_more_tokens,
        get_next_token: mock_get_next_token
    }.

# Test assertion helpers
rule assert_equals(actual, expected) :-
    actual == expected.

rule assert_not_null(value) :-
    value != null.

rule assert_true(condition) :-
    condition == true.

# Test result reporting
rule generate_test_report(test_results, report) :-
    calculate_test_statistics(test_results, stats),
    format_test_report(stats, report).

initialize_test_utilities() {
    print("Test Utilities initialized")
}