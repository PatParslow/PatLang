# CRC-32 (ISO-HDLC, the one zip, gzip and PNG use; reflected polynomial
# 0xEDB88320) and Adler-32 (RFC 1950 section 8.2) over lists of bytes.
#
#   crc32_bytes(bytes)                     the CRC-32 of a whole list
#   crc32_update(crc, table, bytes, lo, hi) a running CRC-32 over bytes[lo..hi-1]
#   adler32_bytes(bytes)                   the Adler-32 of a whole list
#
# Each is one pass over the bytes, O(1) per byte.

# The 256-entry table for the reflected polynomial.
make a function called crc32_table returns t
  let out = []
  let n = 0
  while n < 256 do
    let c = n
    let k = 0
    while k < 8 do
      if (c band 1) == 1 then
        let c = 3988292384 bxor (c shr 1)
      else
        let c = c shr 1
      end
      let k = k + 1
    end
    let out = list_push(out, c)
    let n = n + 1
  end
  let t = out
  ensure (list_len(t) == 256) and (t[1] == 1996959894)
  return t
end

# crc is a finished CRC-32 (0 to start), so updates chain.
make a function called crc32_update takes crc, table, bytes, lo, hi returns c
  require (crc >= 0) and (crc <= 4294967295) and (list_len(table) == 256)
  require (lo >= 0) and (lo <= hi) and (hi <= list_len(bytes))
  let x = crc bxor 4294967295
  let i = lo
  while i < hi do
    let x = table[(x bxor bytes[i]) band 255] bxor (x shr 8)
    let i = i + 1
  end
  let c = x bxor 4294967295
  ensure (c >= 0) and (c <= 4294967295)
  return c
end

make a function called crc32_bytes takes bytes returns c
  require value_class(bytes) == 9
  let c = crc32_update(0, crc32_table(), bytes, 0, list_len(bytes))
  ensure (c >= 0) and (c <= 4294967295)
  return c
end

# Sums are reduced mod 65521 every 5552 bytes, the most that cannot
# overflow 32 bits (RFC 1950's NMAX); PatLang integers do not overflow,
# but staying small keeps them fixnums.
make a function called adler32_update takes adler, bytes, lo, hi returns a
  require (adler >= 0) and (adler <= 4294967295)
  require (lo >= 0) and (lo <= hi) and (hi <= list_len(bytes))
  let s1 = adler band 65535
  let s2 = adler shr 16
  let i = lo
  while i < hi do
    let stop = i + 5552
    if stop > hi then
      let stop = hi
    end
    while i < stop do
      let s1 = s1 + bytes[i]
      let s2 = s2 + s1
      let i = i + 1
    end
    let s1 = s1 % 65521
    let s2 = s2 % 65521
  end
  let a = (s2 shl 16) bor s1
  ensure (a >= 0) and (a <= 4294967295)
  return a
end

make a function called adler32_bytes takes bytes returns a
  require value_class(bytes) == 9
  let a = adler32_update(1, bytes, 0, list_len(bytes))
  ensure (a >= 0) and (a <= 4294967295)
  return a
end
