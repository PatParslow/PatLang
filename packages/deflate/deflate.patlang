# deflate package: DEFLATE (RFC 1951) inflate and deflate, the zlib
# wrapper (RFC 1950), Adler-32 and CRC-32, over lists of bytes (List<Int>,
# each 0..255).
#
#   inflate_raw(bytes, start)   -> ["ok", bytes, end] | ["err", message, at]
#   deflate_raw(bytes, mode)    -> bytes; mode "stored", "fixed" or "dynamic"
#   zlib_compress(bytes, mode)  -> bytes
#   zlib_decompress(bytes)      -> ["ok", bytes] | ["err", message]
#   crc32_bytes(bytes), crc32_update(crc, table, bytes, lo, hi), crc32_table()
#   adler32_bytes(bytes), adler32_update(adler, bytes, lo, hi)
#   pkg_read_bytes(path)        -> a file's bytes
#
# Write bytes to a file with the runtime's write_file_bytes(path, bytes).
include "checksums.patlang"
include "inflate.patlang"
include "compress.patlang"
include "zlib.patlang"
