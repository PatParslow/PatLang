# Scaling benchmark for inflate and deflate, from the repository root, after
# the data files are made (see "Running a package's specs" in packages/README.md):
#
#   ./self_hosting/build/v2.exe packages/deflate/spec/bench.patlang packages/deflate/build/bench.exe --workers 2
#   ./packages/deflate/build/bench.exe
#
# For each kind of data and each of four doubling sizes: milliseconds to
# deflate in each mode, to inflate PatLang's dynamic stream, and to inflate
# Python's level-6 stream; each output is checked against the input.
include "../deflate.patlang"

make a function called bench_one takes kind, n returns line
  require n > 0
  let stem = "packages/deflate/build/bench_" + kind + "_" + n
  let data = pkg_read_bytes(stem + ".bin")
  let pyz = pkg_read_bytes(stem + ".z")
  let b = sb_new()
  sb_push(b, kind + " " + n + ":")
  let modes = ["stored", "fixed", "dynamic"]
  let dyn = []
  let i = 0
  while i < list_len(modes) do
    let t0 = now_ms()
    let z = zlib_compress(data, modes[i])
    let t1 = now_ms()
    sb_push(b, " deflate-" + modes[i] + " " + (t1 - t0) + " ms (" + list_len(z) + " B)")
    if modes[i] == "dynamic" then
      let dyn = z
    end
    let i = i + 1
  end
  let t0 = now_ms()
  let r = zlib_decompress(dyn)
  let t1 = now_ms()
  let ok1 = (r[0] == "ok") and (list_len(r[1]) == n)
  sb_push(b, ", inflate-own " + (t1 - t0) + " ms")
  let t0 = now_ms()
  let r2 = zlib_decompress(pyz)
  let t1 = now_ms()
  let ok2 = (r2[0] == "ok") and (list_len(r2[1]) == n)
  sb_push(b, ", inflate-python " + (t1 - t0) + " ms")
  if not (ok1 and ok2) then
    sb_push(b, " CHECK FAILED")
  end
  let line = sb_str(b)
  ensure value_class(line) == 8
  return line
end

let kinds = ["text", "random", "repetitive"]
let sizes = [262144, 524288, 1048576, 2097152]
let k = 0
while k < list_len(kinds) do
  let s = 0
  while s < list_len(sizes) do
    print(bench_one(kinds[k], sizes[s]))
    let s = s + 1
  end
  let k = k + 1
end
