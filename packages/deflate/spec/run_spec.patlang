# Runs packages/deflate/spec/deflate.feature, from the repository root:
#
#   ./self_hosting/build/v2.exe packages/deflate/spec/run_spec.patlang packages/deflate/build/run_spec.exe --workers 2
#   ./packages/deflate/build/run_spec.exe [feature file]
#
# Python's zlib (spec/oracle.py, run as `py -3 -I`) is the reference.
# Scratch files go to packages/deflate/build/.
include "../../../self_hosting/lib/includes.patlang"
include "../../../self_hosting/lib/gherkin.patlang"
include "../deflate.patlang"

make a function called ds_dir returns d
  let d = "packages/deflate/build/"
  ensure d.length > 0
  return d
end

# One line from the oracle, trimmed.
make a function called ds_py takes a returns out
  require list_len(a) > 0
  # exec_capture's arguments are its call's own, so one call per count.
  let o = "packages/deflate/spec/oracle.py"
  let n = list_len(a)
  let raw = ""
  if n == 1 then
    let raw = exec_capture("py", "-3", "-I", o, a[0])
  elif n == 2 then
    let raw = exec_capture("py", "-3", "-I", o, a[0], a[1])
  elif n == 3 then
    let raw = exec_capture("py", "-3", "-I", o, a[0], a[1], a[2])
  elif n == 4 then
    let raw = exec_capture("py", "-3", "-I", o, a[0], a[1], a[2], a[3])
  else
    let raw = exec_capture("py", "-3", "-I", o, a[0], a[1], a[2], a[3], a[4])
  end
  let out = str_trim(raw)
  ensure value_class(out) == 8
  return out
end

# The first index where two byte lists differ, or -1 when they are equal.
make a function called ds_first_difference takes a, b returns at
  require (value_class(a) == 9) and (value_class(b) == 9)
  let n = list_len(a)
  if list_len(b) < n then
    let n = list_len(b)
  end
  let i = 0
  while i < n do
    if a[i] != b[i] then
      let at = i
      ensure at >= 0
      return at
    end
    let i = i + 1
  end
  let at = 0 - 1
  if list_len(a) != list_len(b) then
    let at = n
  end
  ensure at >= (0 - 1)
  return at
end

make a function called ds_same_label takes a, b returns label
  require (value_class(a) == 9) and (value_class(b) == 9)
  let d = ds_first_difference(a, b)
  let label = "same"
  if d >= 0 then
    let label = "differ at " + d + " (" + list_len(a) + " vs " + list_len(b) + " bytes)"
  end
  ensure value_class(label) == 8
  return label
end

make a function called ds_text_bytes takes text returns bytes
  require value_class(text) == 8
  let out = []
  let i = 0
  while i < text.length do
    let out = list_push(out, char_code(text, i))
    let i = i + 1
  end
  let bytes = out
  ensure list_len(bytes) == text.length
  return bytes
end

# ---- steps ----

make a function called st_ds_text takes ctx returns ok
  ctx_set(ctx, "data", ds_text_bytes(step_arg(ctx, "text")))
  return true
end

make a function called st_ds_data takes ctx returns ok
  let path = ds_dir() + "data.bin"
  let r = ds_py(["gen", step_arg(ctx, "kind"), step_arg(ctx, "n"), path])
  ctx_set(ctx, "data", pkg_read_bytes(path))
  return expect(ctx, "test data " + step_arg(ctx, "kind") + " of " + step_arg(ctx, "n") + " bytes", r + " " + list_len(ctx_get(ctx, "data")), "ok " + step_arg(ctx, "n"))
end

make a function called st_ds_crc takes ctx returns ok
  return expect(ctx, "CRC-32", to_s(crc32_bytes(ctx_get(ctx, "data"))), step_arg(ctx, "n"))
end

make a function called st_ds_adler takes ctx returns ok
  return expect(ctx, "Adler-32", to_s(adler32_bytes(ctx_get(ctx, "data"))), step_arg(ctx, "n"))
end

make a function called st_ds_crc_py takes ctx returns ok
  return expect(ctx, "CRC-32 as Python's", to_s(crc32_bytes(ctx_get(ctx, "data"))), ds_py(["crc32", ds_dir() + "data.bin"]))
end

make a function called st_ds_adler_py takes ctx returns ok
  return expect(ctx, "Adler-32 as Python's", to_s(adler32_bytes(ctx_get(ctx, "data"))), ds_py(["adler32", ds_dir() + "data.bin"]))
end

make a function called ds_py_compress takes ctx, args, raw returns ok
  require list_len(args) > 0
  let r = ds_py(args)
  ctx_set(ctx, "comp", pkg_read_bytes(ds_dir() + "py.z"))
  ctx_set(ctx, "comp_raw", raw)
  let ok = expect(ctx, "Python compressed it", r, "ok")
  ensure value_class(ok) == 1
  return ok
end

make a function called st_ds_py_level takes ctx returns ok
  return ds_py_compress(ctx, ["zcompress", ds_dir() + "data.bin", ds_dir() + "py.z", step_arg(ctx, "level"), "default"], false)
end

make a function called st_ds_py_fixed takes ctx returns ok
  return ds_py_compress(ctx, ["zcompress", ds_dir() + "data.bin", ds_dir() + "py.z", "6", "fixed"], false)
end

make a function called st_ds_py_raw takes ctx returns ok
  return ds_py_compress(ctx, ["rawcompress", ds_dir() + "data.bin", ds_dir() + "py.z", step_arg(ctx, "level")], true)
end

make a function called ds_btype_name takes t returns name
  require (t >= 0) and (t <= 3)
  let names = ["stored", "fixed", "dynamic", "reserved"]
  let name = names[t]
  ensure value_class(name) == 8
  return name
end

make a function called st_ds_first_block takes ctx returns ok
  let comp = ctx_get(ctx, "comp")
  let at = 2
  if ctx_get(ctx, "comp_raw") then
    let at = 0
  end
  let got = "no block"
  if list_len(comp) > at then
    let got = ds_btype_name((comp[at] shr 1) band 3)
  end
  return expect(ctx, "first block type", got, step_arg(ctx, "btype"))
end

make a function called st_ds_pl_zlib_same takes ctx returns ok
  let r = zlib_decompress(ctx_get(ctx, "comp"))
  if r[0] != "ok" then
    return expect(ctx, "PatLang zlib-decompresses it", r[0] + ": " + r[1], "ok")
  end
  return expect(ctx, "PatLang zlib-decompresses it to the same bytes", ds_same_label(r[1], ctx_get(ctx, "data")), "same")
end

make a function called st_ds_pl_raw_same takes ctx returns ok
  let r = inflate_raw(ctx_get(ctx, "comp"), 0)
  if r[0] != "ok" then
    return expect(ctx, "PatLang raw-inflates it", r[0] + ": " + r[1], "ok")
  end
  let ok1 = expect(ctx, "the stream ends at its last byte", r[2], list_len(ctx_get(ctx, "comp")))
  return expect(ctx, "PatLang raw-inflates it to the same bytes", ds_same_label(r[1], ctx_get(ctx, "data")), "same")
end

make a function called ds_pl_compress takes ctx, mode, raw returns comp
  require value_class(mode) == 8
  let comp = []
  if raw then
    let comp = deflate_raw(ctx_get(ctx, "data"), mode)
  else
    let comp = zlib_compress(ctx_get(ctx, "data"), mode)
  end
  write_file_bytes(ds_dir() + "pl.z", comp)
  ctx_set(ctx, "comp", comp)
  ctx_set(ctx, "comp_raw", raw)
  ensure value_class(comp) == 9
  return comp
end

make a function called st_ds_pl_compress takes ctx returns ok
  ds_pl_compress(ctx, step_arg(ctx, "mode"), false)
  return true
end

make a function called st_ds_pl_compress_raw takes ctx returns ok
  ds_pl_compress(ctx, step_arg(ctx, "mode"), true)
  return true
end

make a function called ds_py_inflates_same takes ctx, cmd returns ok
  require value_class(cmd) == 8
  let n = list_len(ctx_get(ctx, "data"))
  let r = ds_py([cmd, ds_dir() + "pl.z", ds_dir() + "pl.out"])
  let ok = expect(ctx, "Python " + cmd + " of PatLang's stream", r, "ok " + n)
  if ok then
    let ok = expect(ctx, "Python's output is the same bytes", ds_py(["same", ds_dir() + "data.bin", ds_dir() + "pl.out"]), "same")
  end
  ensure value_class(ok) == 1
  return ok
end

make a function called st_ds_py_zlib_same takes ctx returns ok
  return ds_py_inflates_same(ctx, "zdecompress")
end

make a function called st_ds_py_raw_same takes ctx returns ok
  return ds_py_inflates_same(ctx, "rawdecompress")
end

make a function called st_ds_every_mode takes ctx returns ok
  let modes = ["stored", "fixed", "dynamic"]
  let i = 0
  while i < list_len(modes) do
    print("  mode " + modes[i])
    let comp = ds_pl_compress(ctx, modes[i], false)
    ds_py_inflates_same(ctx, "zdecompress")
    st_ds_pl_zlib_same(ctx)
    let i = i + 1
  end
  return true
end

make a function called st_ds_size_pct takes ctx returns ok
  let c = list_len(ctx_get(ctx, "comp"))
  let n = list_len(ctx_get(ctx, "data"))
  let pct = to_num(step_arg(ctx, "pct"))
  return expect(ctx, "compressed " + n + " bytes to " + c + ", at most " + pct + " percent", c * 100 <= pct * n, true)
end

make a function called st_ds_smaller takes ctx returns ok
  let a = list_len(ds_pl_compress(ctx, step_arg(ctx, "a"), false))
  let b = list_len(ds_pl_compress(ctx, step_arg(ctx, "b"), false))
  return expect(ctx, step_arg(ctx, "a") + " " + a + " bytes, " + step_arg(ctx, "b") + " " + b + " bytes", a < b, true)
end

make a function called st_ds_change_last takes ctx returns ok
  let comp = ctx_get(ctx, "comp")
  let k = list_len(comp) - 1
  ctx_set(ctx, "comp", list_set(comp, k, comp[k] bxor 1))
  return true
end

make a function called st_ds_cut_half takes ctx returns ok
  let comp = ctx_get(ctx, "comp")
  let out = []
  let i = 0
  while i < (list_len(comp) shr 1) do
    let out = list_push(out, comp[i])
    let i = i + 1
  end
  ctx_set(ctx, "comp", out)
  return true
end

make a function called st_ds_zlib_fails takes ctx returns ok
  let r = zlib_decompress(ctx_get(ctx, "comp"))
  let got = r[0]
  if r[0] == "err" then
    let got = "err " + contains_text(r[1], step_arg(ctx, "msg")) + " (" + r[1] + ")"
  end
  return expect(ctx, "fails with " + step_arg(ctx, "msg"), starts_with(got, "err true"), true)
end

make a function called st_ds_stream_bytes takes ctx returns ok
  let parts = str_split_spaces(step_arg(ctx, "list"))
  let out = []
  let i = 0
  while i < list_len(parts) do
    let out = list_push(out, to_num(parts[i]))
    let i = i + 1
  end
  ctx_set(ctx, "comp", out)
  ctx_set(ctx, "comp_raw", false)
  return true
end

make a function called str_split_spaces takes text returns parts
  require value_class(text) == 8
  let out = []
  let cur = sb_new()
  let i = 0
  while i < text.length do
    let c = char_code(text, i)
    if c == 32 then
      if sb_len(cur) > 0 then
        let out = list_push(out, sb_str(cur))
      end
      let cur = sb_new()
    else
      sb_push(cur, chr(c))
    end
    let i = i + 1
  end
  if sb_len(cur) > 0 then
    let out = list_push(out, sb_str(cur))
  end
  let parts = out
  ensure value_class(parts) == 9
  return parts
end

make a function called register_deflate_steps takes ctx returns ok
  step(ctx, "the text \"{text}\"", "st_ds_text")
  step(ctx, "test data \"{kind}\" of {n} bytes", "st_ds_data")
  step(ctx, "its CRC-32 is the one Python's zlib gives", "st_ds_crc_py")
  step(ctx, "its Adler-32 is the one Python's zlib gives", "st_ds_adler_py")
  step(ctx, "its CRC-32 is {n}", "st_ds_crc")
  step(ctx, "its Adler-32 is {n}", "st_ds_adler")
  step(ctx, "Python compresses it with the fixed-Huffman strategy", "st_ds_py_fixed")
  step(ctx, "Python compresses it with zlib at level {level}", "st_ds_py_level")
  step(ctx, "Python compresses it as raw DEFLATE at level {level}", "st_ds_py_raw")
  step(ctx, "its first block is \"{btype}\"", "st_ds_first_block")
  step(ctx, "PatLang zlib-decompresses it to the same bytes", "st_ds_pl_zlib_same")
  step(ctx, "PatLang raw-inflates it to the same bytes", "st_ds_pl_raw_same")
  step(ctx, "PatLang compresses it with zlib in \"{mode}\" mode", "st_ds_pl_compress")
  step(ctx, "PatLang compresses it as raw DEFLATE in \"{mode}\" mode", "st_ds_pl_compress_raw")
  step(ctx, "Python zlib-decompresses it to the same bytes", "st_ds_py_zlib_same")
  step(ctx, "Python raw-inflates it to the same bytes", "st_ds_py_raw_same")
  step(ctx, "in every mode PatLang's zlib stream decompresses in Python and in PatLang to the same bytes", "st_ds_every_mode")
  step(ctx, "the compressed size is at most {pct} percent of the input", "st_ds_size_pct")
  step(ctx, "the \"{a}\" stream is smaller than the \"{b}\" one", "st_ds_smaller")
  step(ctx, "its last byte is changed", "st_ds_change_last")
  step(ctx, "it is cut to half its length", "st_ds_cut_half")
  step(ctx, "PatLang zlib-decompression fails with \"{msg}\"", "st_ds_zlib_fails")
  step(ctx, "the zlib stream bytes {list}", "st_ds_stream_bytes")
  return true
end

let ctx = ctx_new()
register_deflate_steps(ctx)
let only = argv()
if list_len(only) > 0 then
  run_feature_file(ctx, only[0])
else
  run_feature_file(ctx, "packages/deflate/spec/deflate.feature")
end
ctx_report(ctx)
