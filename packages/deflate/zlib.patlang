# The zlib wrapper (RFC 1950) around DEFLATE, reading whole files, and the
# helpers the package's byte handling shares. Input may be a bytes or a list
# of ints from 0 to 255; output is a bytes.
#
#   zlib_compress(bytes, mode) -> the zlib stream (mode as deflate_raw's)
#   zlib_decompress(bytes)     -> ["ok", bytes] | ["err", message]
#   pkg_read_bytes(path)       -> a file's bytes (none when it cannot be read)

# Whether x can be read as bytes: a bytes, or a list (of ints from 0 to 255).
make a function called pkg_byte_source takes x returns yes
  let yes = (value_class(x) == 18) or (value_class(x) == 9)
  ensure value_class(yes) == 1
  return yes
end

# n bytes of src from lo appended to out, a bytes: copied whole from a bytes,
# one at a time from a list.
make a function called pkg_append_range takes out, src, lo, n returns ok
  require (value_class(out) == 18) and pkg_byte_source(src)
  require (lo >= 0) and (n >= 0) and (lo + n <= list_len(src))
  let before = bytes_len(out)
  if value_class(src) == 18 then
    bytes_extend(out, bytes_slice(src, lo, n))
  else
    let i = lo
    while i < lo + n do
      bytes_push(out, src[i])
      let i = i + 1
    end
  end
  let ok = true
  ensure bytes_len(out) == before + n
  return ok
end

make a function called zlib_compress takes bytes, mode returns z
  require pkg_byte_source(bytes)
  # CMF 0x78: method 8, 32 KB window; FLG 0x9C: default level, check bits.
  let z = bytes_new(0)
  bytes_push(z, 120)
  bytes_push(z, 156)
  def_stream(z, bytes, mode)
  let a = adler32_bytes(bytes)
  bytes_push(z, (a shr 24) band 255)
  bytes_push(z, (a shr 16) band 255)
  bytes_push(z, (a shr 8) band 255)
  bytes_push(z, a band 255)
  ensure (value_class(z) == 18) and (bytes_len(z) >= 7)
  return z
end

make a function called zlib_decompress takes bytes returns r
  require pkg_byte_source(bytes)
  let n = list_len(bytes)
  if n < 2 then
    let r = ["err", "truncated: no zlib header"]
    ensure list_len(r) == 2
    return r
  end
  let cmf = bytes[0]
  let flg = bytes[1]
  if ((cmf band 15) != 8) or ((cmf shr 4) > 7) or (((cmf * 256 + flg) % 31) != 0) then
    let r = ["err", "bad zlib header"]
    ensure list_len(r) == 2
    return r
  end
  if (flg band 32) != 0 then
    let r = ["err", "bad zlib header: a preset dictionary is not supported"]
    ensure list_len(r) == 2
    return r
  end
  let inf = inflate_raw(bytes, 2)
  if inf[0] != "ok" then
    let r = ["err", inf[1]]
    ensure list_len(r) == 2
    return r
  end
  let at = inf[2]
  if at + 4 > n then
    let r = ["err", "truncated: no Adler-32 trailer"]
    ensure list_len(r) == 2
    return r
  end
  let want = (bytes[at] shl 24) bor (bytes[at + 1] shl 16) bor (bytes[at + 2] shl 8) bor bytes[at + 3]
  if adler32_bytes(inf[1]) != want then
    let r = ["err", "adler32 mismatch"]
    ensure list_len(r) == 2
    return r
  end
  let r = ["ok", inf[1]]
  ensure list_len(r) == 2
  return r
end

# A file's bytes, read whole.
make a function called pkg_read_bytes takes path returns bytes
  require value_class(path) == 8
  let bytes = read_file_raw(path)
  ensure value_class(bytes) == 18
  return bytes
end
