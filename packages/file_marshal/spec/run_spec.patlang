# Runs packages/file_marshal/spec/edits.feature and history.feature, from the
# repository root:
#
#   ./self_hosting/build/v2_interp.exe packages/file_marshal/spec/run_spec.patlang [feature file]
#
# A history's store and file are under spec_out(), in a directory of the
# scenario's own. The exit code is 0 when every check passes, 1 otherwise.
include "../../../self_hosting/lib/includes.patlang"
include "../../../self_hosting/lib/gherkin.patlang"
include "../../../self_hosting/lib/v2_engines.patlang"
include "../service.patlang"

make a function called fe_text takes ctx returns text
  return bytes_to_str(ctx_get(ctx, "bytes"))
end

make a function called fe_apply takes ctx, e returns ok
  let r = fm_apply(ctx_get(ctx, "bytes"), e)
  ctx_set(ctx, "result", r)
  if r[0] == "ok" then
    ctx_set(ctx, "bytes", r[1])
    ctx_set(ctx, "shift", r[2])
  end
  return true
end

make a function called st_fe_text takes ctx returns ok
  ctx_set(ctx, "bytes", bytes_from_str(step_arg(ctx, "text")))
  return true
end

make a function called st_fe_between takes ctx returns ok
  return fe_apply(ctx, fm_edit(step_arg(ctx, "p"), step_arg(ctx, "s"), step_arg(ctx, "z")))
end

make a function called st_fe_between_old takes ctx returns ok
  return fe_apply(ctx, fm_with_old(fm_edit(step_arg(ctx, "p"), step_arg(ctx, "s"), step_arg(ctx, "z")), step_arg(ctx, "x")))
end

# an empty S: a pattern step cannot capture "", so this one is exact
make a function called st_fe_bird takes ctx returns ok
  return fe_apply(ctx, fm_edit(", a ", "", "bird"))
end

make a function called st_fe_text_is takes ctx returns ok
  let a = expect(ctx, "the edit applies", ctx_get(ctx, "result")[0], "ok")
  let b = expect(ctx, "the text", fe_text(ctx), step_arg(ctx, "text"))
  return a and b
end

make a function called st_fe_shift_is takes ctx returns ok
  return expect(ctx, "the shift", ctx_get(ctx, "shift"), [to_num(step_arg(ctx, "o")), to_num(step_arg(ctx, "a")), to_num(step_arg(ctx, "b"))])
end

make a function called fe_refused takes ctx, reason returns ok
  return expect(ctx, "the refusal", ctx_get(ctx, "result"), ["refused", reason])
end

make a function called st_fe_refused_part takes ctx returns ok
  return fe_refused(ctx, "the part between is " + chr(34) + step_arg(ctx, "was") + chr(34) + ", not " + chr(34) + step_arg(ctx, "x") + chr(34))
end

make a function called st_fe_refused_missing takes ctx returns ok
  return fe_refused(ctx, "its context is not found")
end

make a function called st_fe_refused_twice takes ctx returns ok
  return fe_refused(ctx, "its context is found 2 times, at " + step_arg(ctx, "a") + " and " + step_arg(ctx, "b"))
end

# 4096 bytes of 200, with 1 2 3 4 5 6 7 8 9 at 100 and at 3000
make a function called st_fe_binary takes ctx returns ok
  let b = bytes_new(4096)
  let i = 0
  while i < 4096 do
    bytes_set(b, i, 200)
    let i = i + 1
  end
  let i = 0
  while i < 9 do
    bytes_set(b, 100 + i, i + 1)
    bytes_set(b, 3000 + i, i + 1)
    let i = i + 1
  end
  ctx_set(ctx, "bytes", b)
  ctx_set(ctx, "original", bytes_slice(b, 0, 4096))
  return true
end

make a function called st_fe_binary_near takes ctx returns ok
  return fe_apply(ctx, fm_near(fm_edit([1, 2, 3], [7, 8, 9], [0, 0]), 2990, 64))
end

make a function called st_fe_binary_result takes ctx returns ok
  let b = ctx_get(ctx, "bytes")
  let a = expect(ctx, "the edit applies", ctx_get(ctx, "result")[0], "ok")
  let c = expect(ctx, "the bytes at 3000", bytes_to_list(bytes_slice(b, 3000, 8)), [1, 2, 3, 0, 0, 7, 8, 9])
  let d = expect(ctx, "the bytes at 100", bytes_to_list(bytes_slice(b, 100, 9)), [1, 2, 3, 4, 5, 6, 7, 8, 9])
  return a and c and d
end

make a function called st_fe_binary_anywhere takes ctx returns ok
  ctx_set(ctx, "bytes", ctx_get(ctx, "original"))
  return fe_apply(ctx, fm_edit([1, 2, 3], [7, 8, 9], [0, 0]))
end

make a function called st_fe_shifts takes ctx returns ok
  ctx_set(ctx, "shifts", [[10, 6, 5], [2, 0, 4]])
  return true
end

make a function called st_fe_positions takes ctx returns ok
  let s = ctx_get(ctx, "shifts")
  return expect(ctx, "positions 3, 20 and 0 carried past both", [fm_map_position(3, s), fm_map_position(20, s), fm_map_position(0, s)], [["at", 7], ["at", 23], ["at", 0]])
end

make a function called st_fe_inside takes ctx returns ok
  return expect(ctx, "position 12", fm_map_position(12, ctx_get(ctx, "shifts")), ["inside", 1])
end

make a function called st_fe_batch takes ctx returns ok
  let ten = [11, 11, 11, 11, 11, 11, 11, 11, 11, 11]
  let first = fm_near(fm_edit([1, 2, 3], [4, 5, 6], ten), 100, 4)
  let second = fm_near(fm_with_old(fm_edit([1, 2, 3], [7, 8, 9], [0]), [4, 5, 6]), 3000, 4)
  ctx_set(ctx, "batch", fm_apply_batch(ctx_get(ctx, "bytes"), [first, second]))
  return true
end

make a function called st_fe_batch_both takes ctx returns ok
  let r = ctx_get(ctx, "batch")
  let a = expect(ctx, "the batch applies", r[0], "ok")
  let b = expect(ctx, "the shifts: the insert at 103, then the change at 3013", r[2], [[103, 0, 10], [3013, 3, 1]])
  return a and b
end

make a function called st_fe_batch_bad takes ctx returns ok
  let good = fm_near(fm_edit([1, 2, 3], [4, 5, 6], [11]), 100, 4)
  let bad = fm_edit([1, 2, 3], [99], [0])
  ctx_set(ctx, "batch", fm_apply_batch(ctx_get(ctx, "bytes"), [good, bad]))
  return true
end

make a function called st_fe_batch_refused takes ctx returns ok
  let a = expect(ctx, "the batch is refused at its second edit", ctx_get(ctx, "batch"), ["refused", 2, "its context is not found"])
  let b = expect(ctx, "the bytes are as they were", bytes_eq(ctx_get(ctx, "bytes"), ctx_get(ctx, "original")), true)
  return a and b
end

make a function called st_fe_large takes ctx returns ok
  let b = sb_new()
  sb_push(b, "first: here" + chr(10))
  let line = "a line of text that is the same as every other line of filler" + chr(10)
  let i = 0
  while i < 17000 do
    sb_push(b, line)
    let i = i + 1
  end
  sb_push(b, "last: here" + chr(10))
  let text = bytes_from_str(sb_str(b))
  ctx_set(ctx, "large", text)
  return expect(ctx, "the text is over 1 MB", bytes_len(text) > 1048576, true)
end

make a function called fe_time takes b, e returns ms
  let best = 0 - 1
  let k = 0
  while k < 3 do
    let t0 = clock_ms()
    let r = fm_apply(b, e)
    let t = clock_ms() - t0
    if r[0] != "ok" then
      return 0 - 1
    end
    if (best < 0) or (t < best) then
      let best = t
    end
    let k = k + 1
  end
  return best
end

make a function called st_fe_large_cost takes ctx returns ok
  let b = ctx_get(ctx, "large")
  let n = bytes_len(b)
  let start = fe_time(b, fm_near(fm_with_old(fm_edit("first: ", chr(10), "there"), "here"), 0, 0 - 1))
  let finish = fe_time(b, fm_near(fm_with_old(fm_edit("last: ", chr(10), "there"), "here"), n - 11, 0 - 1))
  let a = expect(ctx, "both edits apply", (start >= 0) and (finish >= 0), true)
  let c = expect(ctx, "near the end " + finish + " ms, near the start " + start + " ms", finish <= 3 * start + 10, true)
  return a and c
end

# ---- history ----

make a function called fh_text takes got returns text
  if got[0] != "ok" then
    return "(" + got[0] + ": " + got[1] + ")"
  end
  return bytes_to_str(got[1])
end

# A history begun from text: a file of its own and a store, under spec_out()
make a function called st_fh_begun takes ctx returns ok
  let tag = random_bytes(4)
  let dir = spec_out() + "/fm_history_" + tag[0] + "_" + tag[1] + "_" + tag[2] + "_" + tag[3]
  let path = dir + "/file.txt"
  write_file(path, step_arg(ctx, "text"))
  let store = dir + "/store"
  let h = fh_open(store, path)
  let r = fh_recover(h, path, "spec")
  ctx_set(ctx, "path", path)
  ctx_set(ctx, "store", store)
  ctx_set(ctx, "h", h)
  return expect(ctx, "the history begins with the file as version 1", r, ["started", 1])
end

# an edit recorded and, unless keep_file, the file replaced
make a function called fh_do_edits takes ctx, edits, replace returns v
  let h = ctx_get(ctx, "h")
  let path = ctx_get(ctx, "path")
  let r = fm_apply_batch(read_file_raw(path), edits)
  assert r[0] == "ok"
  let v = fh_record(h, "edits", "spec", r[1], edits, r[2])
  if replace then
    fh_replace(path, r[1])
  end
  return v
end

make a function called fh_do_append takes ctx, text returns v
  let path = ctx_get(ctx, "path")
  let after = read_file_raw(path)
  let more = bytes_from_str(text)
  bytes_extend(after, more)
  let v = fh_record(ctx_get(ctx, "h"), "append", "spec", after, more, [])
  fh_replace(path, after)
  return v
end

make a function called fh_do_write takes ctx, text returns v
  let content = bytes_from_str(text)
  let v = fh_record(ctx_get(ctx, "h"), "write", "spec", content, false, [])
  fh_replace(ctx_get(ctx, "path"), content)
  return v
end

make a function called st_fh_three takes ctx returns ok
  let a = fh_do_edits(ctx, [fm_with_old(fm_edit("the curly ", " dog", "furry"), "haired")], true)
  let b = fh_do_append(ctx, " sat")
  let c = fh_do_write(ctx, "a new text")
  return expect(ctx, "versions 2, 3 and 4 recorded", [a, b, c], [2, 3, 4])
end

make a function called fh_four takes h returns texts
  return [fh_text(fh_content_at(h, 1)), fh_text(fh_content_at(h, 2)), fh_text(fh_content_at(h, 3)), fh_text(fh_content_at(h, 4))]
end

make a function called st_fh_four_back takes ctx returns ok
  return expect(ctx, "versions 1 to 4", fh_four(ctx_get(ctx, "h")), ["the curly haired dog", "the curly furry dog", "the curly furry dog sat", "a new text"])
end

make a function called st_fh_reopened takes ctx returns ok
  let h = fh_open(ctx_get(ctx, "store"), ctx_get(ctx, "path"))
  let a = expect(ctx, "opened again: versions", [fh_first(h), fh_last(h), h.torn], [1, 4, false])
  let b = expect(ctx, "and each reads back", fh_four(h), fh_four(ctx_get(ctx, "h")))
  return a and b
end

make a function called st_fh_shifts takes ctx returns ok
  return expect(ctx, "the shifts since version 1", fh_shifts_since(ctx_get(ctx, "h"), 1), ["rewritten", 4, [[10, 6, 5], [19, 0, 4]]])
end

make a function called st_fh_carry takes ctx returns ok
  let got = fh_shifts_since(ctx_get(ctx, "h"), 1)
  return expect(ctx, "position 17 carried past them", fm_map_position(17, got[2]), ["at", 16])
end

make a function called st_fh_counts takes ctx returns ok
  let n = 0
  while n < 130 do
    fh_do_edits(ctx, [fm_with_old(fm_edit("count: ", "", "" + (n + 1)), "" + n)], true)
    let n = n + 1
  end
  return expect(ctx, "131 versions", fh_last(ctx_get(ctx, "h")), 131)
end

make a function called st_fh_copies takes ctx returns ok
  let h = ctx_get(ctx, "h")
  let a = expect(ctx, "version 131", fh_text(fh_content_at(h, 131)), "count: 130")
  let with = []
  let v = 1
  while v <= 131 do
    if file_exists(fh_copy_path(h, v)) then
      let with = list_push(with, v)
    end
    let v = v + 1
  end
  let b = expect(ctx, "the versions with whole copies", with, [1, 64, 128])
  return a and b
end

make a function called st_fh_clear takes ctx returns ok
  return expect(ctx, "records kept", fh_clear(ctx_get(ctx, "h"), 3), 3)
end

make a function called st_fh_cleared takes ctx returns ok
  let h = ctx_get(ctx, "h")
  let a = expect(ctx, "versions 129 to 131", [fh_text(fh_content_at(h, 129)), fh_text(fh_content_at(h, 130)), fh_text(fh_content_at(h, 131))], ["count: 128", "count: 129", "count: 130"])
  let b = expect(ctx, "version 128", fh_content_at(h, 128)[0], "gone")
  let reread = fh_open(ctx_get(ctx, "store"), ctx_get(ctx, "path"))
  let c = expect(ctx, "the log's records", list_len(reread.records), 3)
  return a and b and c
end

make a function called st_fh_after_clear takes ctx returns ok
  let v = fh_do_edits(ctx, [fm_with_old(fm_edit("count: ", "", "131"), "130")], true)
  let a = expect(ctx, "the next version", v, 132)
  let h = fh_open(ctx_get(ctx, "store"), ctx_get(ctx, "path"))
  let b = expect(ctx, "opened again, it starts at", [fh_first(h), fh_last(h), fh_text(fh_content_at(h, 132))], [129, 132, "count: 131"])
  return a and b
end

make a function called st_fh_one_edit takes ctx returns ok
  fh_do_edits(ctx, [fm_with_old(fm_edit("the curly ", " dog", "furry"), "haired")], true)
  return true
end

make a function called st_fh_one_edit_kept takes ctx returns ok
  fh_do_edits(ctx, [fm_with_old(fm_edit("the curly ", " dog", "furry"), "haired")], false)
  return true
end

make a function called st_fh_torn takes ctx returns ok
  let whole = fh_encode([3, "append", 0, "spec", 30, 0, bytes_from_str("lost"), []])
  append_file_bytes(fh_log(ctx_get(ctx, "h")), bytes_slice(whole, 0, bytes_len(whole) / 2))
  return true
end

make a function called st_fh_torn_read takes ctx returns ok
  let h = fh_open(ctx_get(ctx, "store"), ctx_get(ctx, "path"))
  let a = expect(ctx, "versions, and torn", [fh_last(h), h.torn], [2, true])
  let b = expect(ctx, "both read back", [fh_text(fh_content_at(h, 1)), fh_text(fh_content_at(h, 2))], ["the curly haired dog", "the curly furry dog"])
  return a and b
end

make a function called st_fh_completes takes ctx returns ok
  let r = fh_recover(ctx_get(ctx, "h"), ctx_get(ctx, "path"), "spec")
  let a = expect(ctx, "recovering", r, ["completed", 2])
  let b = expect(ctx, "the file", read_file(ctx_get(ctx, "path")), "the curly furry dog")
  return a and b
end

make a function called st_fh_outside_change takes ctx returns ok
  write_file(ctx_get(ctx, "path"), "a cat")
  return true
end

make a function called st_fh_outside takes ctx returns ok
  let h = ctx_get(ctx, "h")
  let r = fh_recover(h, ctx_get(ctx, "path"), "spec")
  let a = expect(ctx, "recovering", r, ["outside", 3])
  let b = expect(ctx, "version 3", fh_text(fh_content_at(h, 3)), "a cat")
  return a and b
end

make a function called fh_time_record takes ctx returns ms
  let best = 0 - 1
  let k = 0
  while k < 5 do
    let t0 = clock_ms()
    fh_do_edits(ctx, [fm_with_old(fm_edit("count: ", "", "x" + k), false)], false)
    let t = clock_ms() - t0
    if (best < 0) or (t < best) then
      let best = t
    end
    let k = k + 1
  end
  return best
end

make a function called st_fh_cost takes ctx returns ok
  let h = ctx_get(ctx, "h")
  let content = bytes_from_str("count: 0")
  while fh_last(h) < 10 do
    fh_record(h, "edits", "spec", content, [], [])
  end
  let early = fh_time_record(ctx)
  while fh_last(h) < 1000 do
    fh_record(h, "edits", "spec", content, [], [])
  end
  let late = fh_time_record(ctx)
  return expect(ctx, "after 1000 " + late + " ms, after 10 " + early + " ms", late <= 3 * early + 5, true)
end

# ---- undo ----

# x after a space, made into z: " " + x + "" names it, if it is the only x
# after a space
make a function called fu_word takes x, z returns e
  return fm_with_old(fm_edit(" ", "", z), x)
end

make a function called st_fu_edit takes ctx returns ok
  fh_do_edits(ctx, [fu_word(step_arg(ctx, "x"), step_arg(ctx, "z"))], true)
  return true
end

make a function called st_fu_batch takes ctx returns ok
  fh_do_edits(ctx, [fm_with_old(fm_edit(" ", " ", "straight"), "curly"), fu_word("mat", "rug")], true)
  return true
end

make a function called st_fu_append takes ctx returns ok
  fh_do_append(ctx, step_arg(ctx, "text"))
  return true
end

make a function called st_fu_write takes ctx returns ok
  fh_do_write(ctx, step_arg(ctx, "text"))
  return true
end

make a function called st_fu_undo takes ctx returns ok
  ctx_set(ctx, "undo", fh_undo_file(ctx_get(ctx, "h"), ctx_get(ctx, "path"), to_num(step_arg(ctx, "k")), "spec"))
  return true
end

make a function called st_fu_revert takes ctx returns ok
  ctx_set(ctx, "undo", fh_revert_file(ctx_get(ctx, "h"), ctx_get(ctx, "path"), to_num(step_arg(ctx, "v")), "spec"))
  return true
end

make a function called st_fu_reads takes ctx returns ok
  return expect(ctx, "the file", read_file(ctx_get(ctx, "path")), step_arg(ctx, "text"))
end

make a function called st_fu_reads_as takes ctx returns ok
  let h = ctx_get(ctx, "h")
  let v = to_num(step_arg(ctx, "v"))
  let a = expect(ctx, "the file", read_file(ctx_get(ctx, "path")), step_arg(ctx, "text"))
  let b = expect(ctx, "the result", ctx_get(ctx, "undo"), ["ok", v])
  let r = fh_record_of(h, v)
  let kind = "none"
  if r != false then
    let kind = r[1]
  end
  let c = expect(ctx, "version " + v + "'s kind", kind, step_arg(ctx, "kind"))
  let d = expect(ctx, "and it reads back from the history", fh_text(fh_content_at(h, v)), step_arg(ctx, "text"))
  return a and b and c and d
end

make a function called st_fu_shifts_2 takes ctx returns ok
  return expect(ctx, "the shifts since version 2", fh_shifts_since(ctx_get(ctx, "h"), 2), ["ok", [[10, 5, 6]]])
end

make a function called st_fu_refused_fluffy takes ctx returns ok
  let r = ctx_get(ctx, "undo")
  let a = expect(ctx, "the undo is refused", r[0], "refused")
  let b = expect(ctx, "saying why: " + r[1], contains_text(r[1], "the part between is " + chr(34) + "fluffy" + chr(34) + ", not " + chr(34) + "furry" + chr(34)), true)
  let c = expect(ctx, "the file", read_file(ctx_get(ctx, "path")), "the curly fluffy dog sat on the mat")
  return a and b and c
end

make a function called st_fu_refused_whole takes ctx returns ok
  let r = ctx_get(ctx, "undo")
  let a = expect(ctx, "the undo is refused", r[0], "refused")
  let b = expect(ctx, "saying why: " + r[1], contains_text(r[1], "version 3 replaced the whole content"), true)
  return a and b
end

# ---- the service ----

# one request from a client of its own: the reply
make a function called fs_ask takes mport, req returns reply
  let c = fs_connect_at(mport, "files")
  if c[0] < 0 then
    return ["error", c[1]]
  end
  let got = fs_call(c, req)
  tcp_close(c[0])
  return got[0]
end

make a function called fs_stop_previous takes ctx returns done
  if (ctx_get(ctx, "fs_thread") != false) and (not ctx_get(ctx, "fs_quit")) then
    fs_ask(ctx_get(ctx, "pm_port"), ["quit", ctx_get(ctx, "fs").token])
    thread_result(ctx_get(ctx, "fs_thread"))
  end
  if ctx_get(ctx, "pm_thread") != false then
    pm_quit_at(ctx_get(ctx, "pm_port"))
    thread_result(ctx_get(ctx, "pm_thread"))
  end
  return true
end

make a function called st_fs_background takes ctx returns ok
  fs_stop_previous(ctx)
  let tag = random_bytes(4)
  let dir = spec_out() + "/fm_service_" + tag[0] + "_" + tag[1] + "_" + tag[2] + "_" + tag[3]
  let root = dir + "/root"
  write_file(root + "/notes.txt", "the curly haired dog sat on the mat")
  let mport = tcp_listen(0)
  let m = pm_start(mport)
  let mt = thread_spawn(|mm| do
    return pm_status_line(pm_loop(mm, 2000))
  end, m)
  let sport = tcp_listen(0)
  let s = fs_start(sport, root, dir + "/store")
  let st = thread_spawn(|ss, p| do
    return fs_loop(ss, p).operations
  end, s, sport)
  ctx_set(ctx, "pm_port", mport)
  ctx_set(ctx, "pm_thread", mt)
  ctx_set(ctx, "fs", s)
  ctx_set(ctx, "fs_thread", st)
  ctx_set(ctx, "fs_quit", false)
  ctx_set(ctx, "root", root)
  ctx_set(ctx, "store", dir + "/store")
  let a = expect(ctx, "the service is registered as files", pm_register_at(mport, "files", sport), "OK")
  # the service's history of notes.txt begins now, as version 1
  let r = fs_ask(mport, ["read", "notes.txt"])
  let b = expect(ctx, "notes.txt is version 1", r[0] == "ok" and r[1] == 1, true)
  return a and b
end

make a function called st_fs_file takes ctx returns ok
  write_file(ctx_get(ctx, "root") + "/" + step_arg(ctx, "name"), step_arg(ctx, "text"))
  return true
end

make a function called st_fs_read takes ctx returns ok
  ctx_set(ctx, "read", fs_ask(ctx_get(ctx, "pm_port"), ["read", "notes.txt"]))
  return true
end

make a function called st_fs_got takes ctx returns ok
  let r = ctx_get(ctx, "read")
  return expect(ctx, "the read", [r[0], r[1], bytes_to_str(r[2])], ["ok", to_num(step_arg(ctx, "v")), step_arg(ctx, "text")])
end

make a function called st_fs_edit takes ctx returns ok
  let e = fu_word(step_arg(ctx, "x"), step_arg(ctx, "z"))
  ctx_set(ctx, "edit", fs_ask(ctx_get(ctx, "pm_port"), ["edit", "notes.txt", to_num(step_arg(ctx, "v")), [e], "spec"]))
  return true
end

make a function called st_fs_edit_is takes ctx returns ok
  let r = ctx_get(ctx, "edit")
  let a = expect(ctx, "the edit's version", [r[0], r[1]], ["ok", to_num(step_arg(ctx, "v"))])
  let b = expect(ctx, "notes.txt on the disk", read_file(ctx_get(ctx, "root") + "/notes.txt"), step_arg(ctx, "text"))
  return a and b
end

# n edits to counts.txt, each making name's count one more, each from the
# version the client last saw
make a function called fs_counter takes mport, name, after, n returns ok
  let c = fs_connect_at(mport, "files")
  if c[0] < 0 then
    return false
  end
  let base = 1
  let k = 0
  let ok = true
  while k < n do
    let e = fm_with_old(fm_edit(name + "=", after, "" + (k + 1)), "" + k)
    let got = fs_call(c, ["edit", "counts.txt", base, [e], name])
    let c = got[1]
    if got[0][0] == "ok" then
      let base = got[0][1]
    else
      let ok = false
    end
    let k = k + 1
  end
  tcp_close(c[0])
  return ok
end

make a function called st_fs_counters takes ctx returns ok
  let mport = ctx_get(ctx, "pm_port")
  let a = thread_spawn(|p| do
    return fs_counter(p, "a", " ", 25)
  end, mport)
  let b = thread_spawn(|p| do
    return fs_counter(p, "b", "", 25)
  end, mport)
  return expect(ctx, "every edit applied", [thread_result(a), thread_result(b)], [true, true])
end

make a function called st_fs_counts_are takes ctx returns ok
  let r = fs_ask(ctx_get(ctx, "pm_port"), ["read", "counts.txt"])
  return expect(ctx, "counts.txt and its versions", [bytes_to_str(r[2]), r[1]], ["a=25 b=25", 51])
end

make a function called st_fs_binary takes ctx returns ok
  let b = bytes_new(4096)
  let i = 0
  while i < 4096 do
    bytes_set(b, i, 200)
    let i = i + 1
  end
  let i = 0
  while i < 9 do
    bytes_set(b, 100 + i, i + 1)
    bytes_set(b, 3000 + i, i + 1)
    let i = i + 1
  end
  write_file_bytes(ctx_get(ctx, "root") + "/data.bin", b)
  return true
end

make a function called st_fs_stale_setup takes ctx returns ok
  let mport = ctx_get(ctx, "pm_port")
  let r = fs_ask(mport, ["read", "data.bin"])
  ctx_set(ctx, "seen", r[1])
  let ten = [11, 11, 11, 11, 11, 11, 11, 11, 11, 11]
  let ins = fm_near(fm_with_old(fm_edit([200], [1, 2, 3], ten), []), 99, 2)
  let w = fs_ask(mport, ["edit", "data.bin", r[1], [ins], "other"])
  return expect(ctx, "the other client's insert", [w[0], w[2]], ["ok", [[100, 0, 10]]])
end

make a function called st_fs_stale_edit takes ctx returns ok
  let e = fm_near(fm_with_old(fm_edit([1, 2, 3], [7, 8, 9], [0]), [4, 5, 6]), 3000, 4)
  ctx_set(ctx, "edit", fs_ask(ctx_get(ctx, "pm_port"), ["edit", "data.bin", ctx_get(ctx, "seen"), [e], "first"]))
  return true
end

make a function called st_fs_stale_applied takes ctx returns ok
  let r = ctx_get(ctx, "edit")
  return expect(ctx, "the change", [r[0], r[2]], ["ok", [[3013, 3, 1]]])
end

make a function called st_fs_write_if takes ctx returns ok
  ctx_set(ctx, "write", fs_ask(ctx_get(ctx, "pm_port"), ["write", "notes.txt", to_num(step_arg(ctx, "v")), bytes_from_str(step_arg(ctx, "text")), "first"]))
  return true
end

make a function called st_fs_other_edit takes ctx returns ok
  return st_fs_edit(ctx)
end

make a function called st_fs_write_refused takes ctx returns ok
  let r = ctx_get(ctx, "write")
  return expect(ctx, "the write", [r[0], r[2]], ["refused", to_num(step_arg(ctx, "v"))])
end

make a function called st_fs_write_is takes ctx returns ok
  return expect(ctx, "the write", ctx_get(ctx, "write"), ["ok", to_num(step_arg(ctx, "v"))])
end

make a function called st_fs_outside takes ctx returns ok
  write_file(ctx_get(ctx, "root") + "/notes.txt", step_arg(ctx, "text"))
  return true
end

make a function called st_fs_outside_kind takes ctx returns ok
  let h = fh_open(ctx_get(ctx, "store"), "notes.txt")
  let r = fh_record_of(h, 2)
  return expect(ctx, "version 2's kind", r[1], "outside")
end

make a function called st_fs_paths takes ctx returns ok
  let mport = ctx_get(ctx, "pm_port")
  let paths = ["../outside.txt", "/etc/passwd", "a//b", "c:/x", "a" + chr(92) + "b"]
  let got = []
  let k = 0
  while k < list_len(paths) do
    let got = list_push(got, fs_ask(mport, ["read", paths[k]])[0])
    let k = k + 1
  end
  return expect(ctx, "each read", got, ["refused", "refused", "refused", "refused", "refused"])
end

make a function called fs_appender takes mport, w returns ok
  let c = fs_connect_at(mport, "files")
  if c[0] < 0 then
    return false
  end
  let ok = true
  let i = 0
  while i < 20 do
    let got = fs_call(c, ["append", "log.txt", bytes_from_str("client " + w + " line " + i + " of twenty" + chr(10)), "client " + w])
    let c = got[1]
    if got[0][0] != "ok" then
      let ok = false
    end
    let i = i + 1
  end
  tcp_close(c[0])
  return ok
end

make a function called st_fs_appends takes ctx returns ok
  let mport = ctx_get(ctx, "pm_port")
  let ts = []
  let w = 1
  while w <= 4 do
    let ts = list_push(ts, thread_spawn(|p, n| do
      return fs_appender(p, n)
    end, mport, w))
    let w = w + 1
  end
  let rs = []
  let k = 0
  while k < 4 do
    let rs = list_push(rs, thread_result(ts[k]))
    let k = k + 1
  end
  return expect(ctx, "every append applied", rs, [true, true, true, true])
end

make a function called st_fs_log_whole takes ctx returns ok
  let r = fs_ask(ctx_get(ctx, "pm_port"), ["read", "log.txt"])
  let lines = pm_lines(bytes_to_str(r[2]))
  let whole = 0
  let k = 0
  while k < list_len(lines) do
    if str_contains(lines[k], " of twenty") then
      let whole = whole + 1
    end
    let k = k + 1
  end
  return expect(ctx, "lines, whole lines, versions", [list_len(lines), whole, r[1]], [80, 80, 81])
end

make a function called st_fs_empty_log takes ctx returns ok
  write_file(ctx_get(ctx, "root") + "/log.txt", "")
  return true
end

make a function called st_fs_client_edit takes ctx returns ok
  return st_fs_edit(ctx)
end

make a function called st_fs_undo takes ctx returns ok
  ctx_set(ctx, "undo", fs_ask(ctx_get(ctx, "pm_port"), ["undo", "notes.txt", to_num(step_arg(ctx, "k")), "spec"]))
  return expect(ctx, "the undo", ctx_get(ctx, "undo")[0], "ok")
end

make a function called st_fs_says_again takes ctx returns ok
  return expect(ctx, "notes.txt", read_file(ctx_get(ctx, "root") + "/notes.txt"), step_arg(ctx, "text"))
end

make a function called st_fs_status takes ctx returns ok
  let r = fs_ask(ctx_get(ctx, "pm_port"), ["status"])
  return expect(ctx, "status: " + r, [r[0], r[1], r[2] >= 2], ["ok", 1, true])
end

make a function called st_fs_quit takes ctx returns ok
  let mport = ctx_get(ctx, "pm_port")
  let a = expect(ctx, "quit with a wrong token", fs_ask(mport, ["quit", "0123456789abcdef0123456789abcdef"])[0], "refused")
  let b = expect(ctx, "quit with the token", fs_ask(mport, ["quit", ctx_get(ctx, "fs").token]), ["ok"])
  let n = thread_result(ctx_get(ctx, "fs_thread"))
  ctx_set(ctx, "fs_quit", true)
  let c = expect(ctx, "the service ended, having done some operations", n >= 3, true)
  return a and b and c
end

let ctx = ctx_new()
step(ctx, "a marshaller and a file service registered as \"files\", over a root holding notes.txt saying \"the curly haired dog sat on the mat\"", "st_fs_background")
step(ctx, "a client reads notes.txt", "st_fs_read")
step(ctx, "it gets version {v} and \"{text}\"", "st_fs_got")
step(ctx, "it edits notes.txt from version {v}, making \"{x}\" into \"{z}\"", "st_fs_edit")
step(ctx, "another client edits notes.txt from version {v}, making \"{x}\" into \"{z}\"", "st_fs_other_edit")
step(ctx, "a client edits notes.txt from version {v}, making \"{x}\" into \"{z}\"", "st_fs_client_edit")
step(ctx, "the edit is version {v}, and notes.txt on the disk says \"{text}\"", "st_fs_edit_is")
step(ctx, "a file log.txt saying \"\"", "st_fs_empty_log")
step(ctx, "a file {name} saying \"{text}\"", "st_fs_file")
step(ctx, "one client makes a 25 times one more, and another makes b 25 times one more, at once", "st_fs_counters")
step(ctx, "counts.txt says \"a=25 b=25\", and its history has 51 versions", "st_fs_counts_are")
step(ctx, "a file data.bin of 4096 bytes in which the bytes 1 2 3 and 7 8 9 come at 100 and again at 3000, with 4 5 6 between them", "st_fs_binary")
step(ctx, "one client reads data.bin, and another then inserts 10 bytes before the first 1 2 3", "st_fs_stale_setup")
step(ctx, "the first client, from the version it read, changes the 4 5 6 near 3000, within 4, to 0", "st_fs_stale_edit")
step(ctx, "the change applies at 3013, where the bytes now are", "st_fs_stale_applied")
step(ctx, "the first client writes \"{text}\" to notes.txt if it is still at version {v}", "st_fs_write_if")
step(ctx, "the first client writes \"{text}\" to notes.txt if it is at version {v}", "st_fs_write_if")
step(ctx, "the write is refused, saying the file is at version {v}", "st_fs_write_refused")
step(ctx, "the write is version {v}", "st_fs_write_is")
step(ctx, "notes.txt is changed on the disk to \"{text}\"", "st_fs_outside")
step(ctx, "version 2 in the history is an outside change", "st_fs_outside_kind")
step(ctx, "reading \"../outside.txt\", \"/etc/passwd\", \"a//b\", \"c:/x\" and \"a\\b\" are each refused, and no file outside the root is read", "st_fs_paths")
step(ctx, "4 clients each append 20 lines to log.txt at once", "st_fs_appends")
step(ctx, "log.txt holds the 80 lines, each whole, and its history has 81 versions", "st_fs_log_whole")
step(ctx, "it undoes version {k} of notes.txt", "st_fs_undo")
step(ctx, "notes.txt says \"{text}\" again", "st_fs_says_again")
step(ctx, "a status query says 1 file and at least 2 operations", "st_fs_status")
step(ctx, "quit with a wrong token is refused, and quit with the service's token ends it", "st_fs_quit")
step(ctx, "it records an edit making \"haired\" into \"furry\"", "st_fh_one_edit")
step(ctx, "it records an edit making \"{x}\" into \"{z}\"", "st_fu_edit")
step(ctx, "it records one batch making \"curly\" into \"straight\" and \"mat\" into \"rug\"", "st_fu_batch")
step(ctx, "it records an append of \"{text}\"", "st_fu_append")
step(ctx, "it records a write of \"{text}\"", "st_fu_write")
step(ctx, "version {k} is undone", "st_fu_undo")
step(ctx, "the file is reverted to version {v}", "st_fu_revert")
step(ctx, "the file reads \"{text}\", recorded as version {v}, an {kind}", "st_fu_reads_as")
step(ctx, "the file reads \"{text}\", recorded as version {v}, a {kind}", "st_fu_reads_as")
step(ctx, "the file reads \"{text}\"", "st_fu_reads")
step(ctx, "the shifts since version 2 are [[10, 5, 6]]", "st_fu_shifts_2")
step(ctx, "the undo is refused, saying the part between is \"fluffy\", not \"furry\", and the file still reads \"the curly fluffy dog sat on the mat\"", "st_fu_refused_fluffy")
step(ctx, "the undo is refused, saying version 3 replaced the whole content", "st_fu_refused_whole")
step(ctx, "a history begun from the text \"{text}\"", "st_fh_begun")
step(ctx, "it records an edit making \"haired\" into \"furry\", an append of \" sat\", and a write of \"a new text\"", "st_fh_three")
step(ctx, "versions 1 to 4 read back as \"the curly haired dog\", \"the curly furry dog\", \"the curly furry dog sat\" and \"a new text\"", "st_fh_four_back")
step(ctx, "opened again from the disk, it has the same 4 versions, and each reads back the same", "st_fh_reopened")
step(ctx, "the shifts since version 1 are those of the edit and the append until version 4, which rewrote the whole content", "st_fh_shifts")
step(ctx, "the shifts since version 1 carry position 17, the d of dog, to 16", "st_fh_carry")
step(ctx, "it records 130 edits, each making the count one more", "st_fh_counts")
step(ctx, "version 131 reads back as \"count: 130\", and whole copies are kept for versions 1, 64 and 128 only", "st_fh_copies")
step(ctx, "the history is cleared down to its last 3 versions", "st_fh_clear")
step(ctx, "versions 129 to 131 read back, version 128 is gone, and the log holds 3 records", "st_fh_cleared")
step(ctx, "the next version recorded is 132, and opened again the history starts at 129", "st_fh_after_clear")
step(ctx, "it records an edit making \"haired\" into \"furry\" without the file being replaced", "st_fh_one_edit_kept")
step(ctx, "half a record is appended to its log, as a crash while appending would leave it", "st_fh_torn")
step(ctx, "opened again, it has 2 versions and says its log was torn, and both read back", "st_fh_torn_read")
step(ctx, "recovering the file writes version 2's content into it, saying it completed version 2", "st_fh_completes")
step(ctx, "the file is changed by something else to \"a cat\"", "st_fh_outside_change")
step(ctx, "recovering it records version 3 as an outside change, and version 3 reads back as \"a cat\"", "st_fh_outside")
step(ctx, "recording a version after 1000 takes at most three times as long as recording one after 10, the cheapest of five each", "st_fh_cost")
step(ctx, "the text \"{text}\"", "st_fe_text")
step(ctx, "the part between \", a \" and \"\" becomes \"bird\"", "st_fe_bird")
step(ctx, "the part between \"{p}\" and \"{s}\" becomes \"{z}\"", "st_fe_between")
step(ctx, "the part \"{x}\" between \"{p}\" and \"{s}\" becomes \"{z}\"", "st_fe_between_old")
step(ctx, "the text is \"{text}\"", "st_fe_text_is")
step(ctx, "the shift is at {o}, {a} bytes removed and {b} inserted", "st_fe_shift_is")
step(ctx, "the edit is refused, saying the part between is \"{was}\", not \"{x}\"", "st_fe_refused_part")
step(ctx, "the edit is refused, saying its context is not found", "st_fe_refused_missing")
step(ctx, "the edit is refused, saying its context is found 2 times, at {a} and {b}", "st_fe_refused_twice")
step(ctx, "4096 bytes in which the bytes 1 2 3 and 7 8 9 come at 100 and again at 3000, with 4 5 6 between them", "st_fe_binary")
step(ctx, "the bytes between 1 2 3 and 7 8 9 near 2990, within 64, become 0 0", "st_fe_binary_near")
step(ctx, "the bytes at 3000 are 1 2 3 0 0 7 8 9, and those at 100 are as they were", "st_fe_binary_result")
step(ctx, "the bytes between 1 2 3 and 7 8 9 are changed with no position", "st_fe_binary_anywhere")
step(ctx, "the shifts [10, 6, 5] and then [2, 0, 4]", "st_fe_shifts")
step(ctx, "position 3 becomes 7, position 20 becomes 23, and position 0 stays 0", "st_fe_positions")
step(ctx, "position 12 is inside the first edit", "st_fe_inside")
step(ctx, "a batch inserts 10 bytes after the first 1 2 3, then changes the 4 5 6 near 3000, within 4, to 0", "st_fe_batch")
step(ctx, "both apply, the second found at 3013 because its hint was moved by 10", "st_fe_batch_both")
step(ctx, "a batch makes a good edit and then one whose context is not found", "st_fe_batch_bad")
step(ctx, "the batch is refused, naming the second edit, and the bytes are as they were", "st_fe_batch_refused")
step(ctx, "a text of 1 MB with one line near its start and one near its end that each say \"here\"", "st_fe_large")
step(ctx, "changing the one near the end, with its position given, takes at most three times as long as changing the one near the start, the cheapest of three runs each", "st_fe_large_cost")
# --list names the feature files (the gates run each); a failure exits 1
run_suite(ctx, ["packages/file_marshal/spec/edits.feature", "packages/file_marshal/spec/history.feature", "packages/file_marshal/spec/undo.feature", "packages/file_marshal/spec/service.feature"], argv())
