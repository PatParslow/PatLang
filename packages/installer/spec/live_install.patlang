# sources.feature's https case, a Linux build run under WSL in WORKDIR (which
# holds source.zip): serves WORKDIR with openssl s_server -WWW and the tls
# package's test PKI, installs zip from https://localhost:PORT/source.zip into
# WORKDIR/project, trusting the test root and with the repository's shipped
# pins, and prints ["ok", [the packages installed, in order]] or the refusal.
#
#   live_install WORKDIR CERTDIR PINS
#
# s_server exits after two connections (the readiness probe and the fetch)
# or 600 seconds (60 was too short on a loaded machine).
include "../installer.patlang"

let a = argv()
let work = a[0]
let certs = a[1]
let port = 47100 + (now_ms() % 800)
let pid = spawn("timeout", "600", "openssl", "s_server", "-tls1_3", "-accept", "" + port, "-naccept", "2", "-cert", certs + "/leaf_ec.pem", "-key", certs + "/leaf_ec.key", "-cert_chain", certs + "/chain_ec.pem", "-WWW")
let conn = 0 - 1
let tries = 0
while (conn < 0) and (tries < 150) do
  let conn = tcp_try_connect("localhost", port)
  if conn < 0 then
    sleep_ms(100)
  end
  let tries = tries + 1
end
if conn < 0 then
  print(["no server", port])
else
  tcp_close(conn)
  let st = trust_store_open(work + "/store")
  let shipped = trust_read_pins(bytes_to_list(read_file_raw(a[2])))[1]
  let root = bytes_to_list(read_file_raw(certs + "/root.der"))
  make_directory(work + "/project")
  let r = in_install(work + "/project", st, shipped, "zip", "any", ["https://localhost:" + port + "/source.zip"], [false, false, "", [root]])
  if r[0] == "ok" then
    let names = []
    let k = 0
    while k < list_len(r[1]) do
      let names = list_push(names, r[1][k][0])
      let k = k + 1
    end
    print([r[0], names])
  else
    print(r)
  end
end
