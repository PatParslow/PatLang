# The port marshaller as a program:
#
#   v2_interp.exe packages/port_marshal/marshal.patlang [--port N] [--drain-ms MS]
#
# It listens on port N (9400 by default) and serves until a QUIT with its
# token (pm_quit_at, port_marshal.patlang), then lets the open pairs finish for
# at most MS milliseconds (5000 by default). It answers STATUS on the same port
# at any time, so a busy marshaller can be asked what it is doing; it claims no
# second port for signals, since the one it has is the one every client
# already knows. It exits 1 when the port is taken.
include "port_marshal.patlang"

make a function called mr_option takes args, name, default returns v
  let k = 0
  while k + 1 < list_len(args) do
    if args[k] == name then
      return to_num(args[k + 1])
    end
    let k = k + 1
  end
  return default
end

let args = argv()
let port = mr_option(args, "--port", pm_default_port())
let drain = mr_option(args, "--drain-ms", 5000)
let got = tcp_try_listen(port)
if got < 0 then
  print("port_marshal: port " + port + " is taken")
  exit_with(1)
end
print("port_marshal: listening on " + got)
let m = pm_loop(pm_start(got), drain)
print("port_marshal: " + pm_status_line(m))
