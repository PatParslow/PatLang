# Reading manifest.pkg (format: packages/README.md) into a manifest value:
#
#   [name, version, summary, entry, includes, files, depends]
#
# includes a list of paths, files a list of [path, lowercase hex], depends a
# list of [package, [[op, bound], ...]], each in manifest order. A manifest
# that breaks the format gives ["error", line, message], line 0 meaning the
# manifest as a whole (for a line it lacks).
include "versions.patlang"

make a function called rs_m_name takes m returns s
  require list_len(m) == 7
  let s = m[0]
  ensure value_class(s) == 8
  return s
end

make a function called rs_m_version takes m returns s
  require list_len(m) == 7
  let s = m[1]
  ensure value_class(s) == 8
  return s
end

make a function called rs_m_summary takes m returns s
  require list_len(m) == 7
  let s = m[2]
  ensure value_class(s) == 8
  return s
end

make a function called rs_m_entry takes m returns s
  require list_len(m) == 7
  let s = m[3]
  ensure value_class(s) == 8
  return s
end

make a function called rs_m_includes takes m returns s
  require list_len(m) == 7
  let s = m[4]
  ensure value_class(s) == 9
  return s
end

make a function called rs_m_files takes m returns s
  require list_len(m) == 7
  let s = m[5]
  ensure value_class(s) == 9
  return s
end

make a function called rs_m_depends takes m returns s
  require list_len(m) == 7
  let s = m[6]
  ensure value_class(s) == 9
  return s
end

# A package name: lower case letters, digits and _, at least one. (A name
# can then never start with a capital, which solve would take for a logic
# variable.)
make a function called rs_is_name takes text returns yes
  require value_class(text) == 8
  let h = str_intern(text)
  let n = sc_len(h)
  let yes = n > 0
  let i = 0
  while yes and (i < n) do
    let c = sc_code(h, i)
    let yes = ((c >= 97) and (c <= 122)) or ((c >= 48) and (c <= 57)) or (c == 95)
    let i = i + 1
  end
  ensure value_class(yes) == 1
  return yes
end

make a function called rs_is_hex64 takes text returns yes
  require value_class(text) == 8
  let h = str_intern(text)
  let yes = sc_len(h) == 64
  let i = 0
  while yes and (i < 64) do
    let c = sc_code(h, i)
    let yes = ((c >= 48) and (c <= 57)) or ((c >= 97) and (c <= 102)) or ((c >= 65) and (c <= 70))
    let i = i + 1
  end
  ensure value_class(yes) == 1
  return yes
end

make a function called rs_is_key takes key returns yes
  require value_class(key) == 8
  let yes = (key == "package") or (key == "version") or (key == "summary") or (key == "entry") or (key == "include") or (key == "depends") or (key == "file")
  ensure value_class(yes) == 1
  return yes
end

# A trimmed line's key (its first word) and value (the rest, trimmed).
make a function called rs_key_value takes line returns kv
  require value_class(line) == 8
  let h = str_intern(line)
  let n = sc_len(h)
  let i = 0
  while (i < n) and (sc_code(h, i) != 32) and (sc_code(h, i) != 9) do
    let i = i + 1
  end
  let kv = [sc_substr(h, 0, i), rs_trim(sc_substr(h, i, n - i))]
  ensure list_len(kv) == 2
  return kv
end

# A depends value, "<name> <constraint>[, <constraint>...]":
# ["ok", name, [[op, bound], ...]] or ["error", message].
make a function called rs_parse_depends takes value returns r
  require value_class(value) == 8
  let kv = rs_key_value(value)
  let name = kv[0]
  if not rs_is_name(name) then
    let r = ["error", "'" + name + "' is not a package name"]
  elif kv[1] == "" then
    let r = ["error", "depends '" + name + "' gives no constraint"]
  else
    let c = rs_parse_constraints("depends '" + name + "'", kv[1])
    if c[0] == "error" then
      let r = c
    else
      let r = ["ok", name, c[1]]
    end
  end
  ensure (r[0] == "ok") or (r[0] == "error")
  return r
end

# The first of a list of [line, message] errors by line, or [] for none.
make a function called rs_first_error takes errs returns e
  require value_class(errs) == 9
  let e = []
  let i = 0
  while i < list_len(errs) do
    if (list_len(e) == 0) or (errs[i][0] < e[0]) then
      let e = errs[i]
    end
    let i = i + 1
  end
  ensure (list_len(e) == 0) or (list_len(e) == 2)
  return e
end

# The errors between lines: a path given twice, an include without a file
# line, a file line that is not an include. includes are [path, line] and
# files [path, hex, line].
make a function called rs_path_errors takes includes, files returns errs
  require (value_class(includes) == 9) and (value_class(files) == 9)
  let a = rs_sort(includes, "first")
  let b = rs_sort(files, "first")
  let out = []
  let i = 1
  while i < list_len(a) do
    if a[i][0] == a[i - 1][0] then
      let out = list_push(out, [a[i][1], "include '" + a[i][0] + "' is given twice (first at line " + a[i - 1][1] + ")"])
    end
    let i = i + 1
  end
  let i = 1
  while i < list_len(b) do
    if b[i][0] == b[i - 1][0] then
      let out = list_push(out, [b[i][2], "file '" + b[i][0] + "' is given twice (first at line " + b[i - 1][2] + ")"])
    end
    let i = i + 1
  end
  # Both sorted by path: walk them together.
  let i = 0
  let j = 0
  while (i < list_len(a)) or (j < list_len(b)) do
    if (j >= list_len(b)) or ((i < list_len(a)) and (str_cmp(a[i][0], b[j][0]) < 0)) then
      let out = list_push(out, [a[i][1], "include '" + a[i][0] + "' has no file line"])
      let i = i + 1
    elif (i >= list_len(a)) or (str_cmp(a[i][0], b[j][0]) > 0) then
      let out = list_push(out, [b[j][2], "file '" + b[j][0] + "' is not an include"])
      let j = j + 1
    else
      let i = i + 1
      let j = j + 1
    end
  end
  let errs = out
  ensure value_class(errs) == 9
  return errs
end

# A manifest from its lines: ["ok", manifest] or ["error", line, message].
# A fault within one line is reported at the first such line; then a missing
# line (at line 0); then the first fault between lines.
make a function called rs_manifest_parse takes lines returns r
  require value_class(lines) == 9
  let name = ""
  let name_at = 0
  let version = ""
  let version_at = 0
  let summary = ""
  let summary_at = 0
  let entry = ""
  let entry_at = 0
  let includes = []
  let files = []
  let deps = []
  let err = ""
  let err_at = 0
  let i = 0
  while (i < list_len(lines)) and (err == "") do
    let at = i + 1
    let t = rs_trim(lines[i])
    if (t != "") and (not rs_starts_with(t, "#")) then
      let kv = rs_key_value(t)
      let key = kv[0]
      let value = kv[1]
      if not rs_is_key(key) then
        let err = "unknown key '" + key + "'"
      elif value == "" then
        let err = "key '" + key + "' has no value"
      elif key == "package" then
        if name_at > 0 then
          let err = "second package line (first at line " + name_at + ")"
        elif not rs_is_name(value) then
          let err = "'" + value + "' is not a package name"
        else
          let name = value
          let name_at = at
        end
      elif key == "version" then
        if version_at > 0 then
          let err = "second version line (first at line " + version_at + ")"
        elif list_len(rs_version_parse(value)) != 3 then
          let err = "version '" + value + "' is not MAJOR.MINOR.PATCH"
        else
          let version = value
          let version_at = at
        end
      elif key == "summary" then
        if summary_at > 0 then
          let err = "second summary line (first at line " + summary_at + ")"
        else
          let summary = value
          let summary_at = at
        end
      elif key == "entry" then
        if entry_at > 0 then
          let err = "second entry line (first at line " + entry_at + ")"
        else
          let entry = value
          let entry_at = at
        end
      elif key == "include" then
        let includes = list_push(includes, [value, at])
      elif key == "depends" then
        let d = rs_parse_depends(value)
        if d[0] == "error" then
          let err = d[1]
        else
          let deps = list_push(deps, [d[1], d[2], at])
        end
      else
        let w = rs_words(value)
        if (list_len(w) != 3) or (w[1] != "sha256") or (not rs_is_hex64(w[2])) then
          let err = "file line is not '<path> sha256 <64 hex digits>'"
        else
          let files = list_push(files, [w[0], rs_lower(w[2]), at])
        end
      end
      if err != "" then
        let err_at = at
      end
    end
    let i = i + 1
  end
  if err == "" then
    if name_at == 0 then
      let err = "no 'package' line"
    elif version_at == 0 then
      let err = "no 'version' line"
    elif entry_at == 0 then
      let err = "no 'entry' line"
    elif list_len(includes) == 0 then
      let err = "no 'include' line"
    elif list_len(files) == 0 then
      let err = "no 'file' line"
    end
  end
  if err == "" then
    let errs = rs_path_errors(includes, files)
    let found = false
    let k = 0
    while k < list_len(includes) do
      if includes[k][0] == entry then
        let found = true
      end
      let k = k + 1
    end
    if not found then
      let errs = list_push(errs, [entry_at, "entry '" + entry + "' is not an include"])
    end
    let k = 0
    while k < list_len(deps) do
      if deps[k][0] == name then
        let errs = list_push(errs, [deps[k][2], "package '" + name + "' depends on itself"])
      end
      let k = k + 1
    end
    # One depends line per package: its constraints all go on that line.
    let sd = rs_sort(deps, "first")
    let k = 1
    while k < list_len(sd) do
      if sd[k][0] == sd[k - 1][0] then
        let errs = list_push(errs, [sd[k][2], "second depends line for '" + sd[k][0] + "' (first at line " + sd[k - 1][2] + ")"])
      end
      let k = k + 1
    end
    let e = rs_first_error(errs)
    if list_len(e) == 2 then
      let err_at = e[0]
      let err = e[1]
    end
  end
  if err != "" then
    let r = ["error", err_at, err]
    ensure (r[0] == "error") and (list_len(r) == 3)
    return r
  end
  let paths = []
  let k = 0
  while k < list_len(includes) do
    let paths = list_push(paths, includes[k][0])
    let k = k + 1
  end
  let hashes = []
  let k = 0
  while k < list_len(files) do
    let hashes = list_push(hashes, [files[k][0], files[k][1]])
    let k = k + 1
  end
  let ds = []
  let k = 0
  while k < list_len(deps) do
    let ds = list_push(ds, [deps[k][0], deps[k][1]])
    let k = k + 1
  end
  let r = ["ok", [name, version, summary, entry, paths, hashes, ds]]
  ensure (r[0] == "ok") and (list_len(r[1]) == 7)
  return r
end

# A manifest file: ["ok", manifest] or ["error", line, message].
make a function called rs_manifest_read takes path returns r
  require value_class(path) == 8
  if not file_exists(path) then
    let r = ["error", 0, "cannot read '" + path + "'"]
    ensure list_len(r) == 3
    return r
  end
  let r = rs_manifest_parse(rs_byte_lines(read_file_bytes(path, 0, 16777216)))
  ensure (r[0] == "ok") or (list_len(r) == 3)
  return r
end

# Dependencies as text: "deflate >= 0.1.0, < 0.2.0; zip = 0.1.0".
make a function called rs_depends_text takes deps returns text
  require value_class(deps) == 9
  let b = sb_new()
  let i = 0
  while i < list_len(deps) do
    if i > 0 then
      sb_push(b, "; ")
    end
    sb_push(b, deps[i][0])
    sb_push(b, " ")
    sb_push(b, rs_constraints_text(deps[i][1]))
    let i = i + 1
  end
  let text = sb_str(b)
  ensure value_class(text) == 8
  return text
end
