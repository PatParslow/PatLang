# The resolve package: choosing one version of each package from manifests,
# with PatLang's logic engine (docs/plans/package-manager.md, "Resolution").
#
#   rs_universe_read(paths)       manifests from files and directories
#   rs_resolve(manifests, req)    asserts the facts and rules, then chooses
#   rs_cli_resolve, rs_cli_facts  the same, as text and an exit code
#
# Manifests become facts:
#
#   pkg_available(Name, Ver)
#   pkg_requires(Pkg, PVer, Dep, Op, Bound)       Op one of eq ge gt le lt
#   version_order(A, B, lt|eq|gt)                 every pair of known versions
#
# and two rules over them, satisfies and dep_candidate. The request is a
# requirer like any package, named "@request" (no package name can start
# with @), version "0.0.0"; a request without a constraint is >= 0.0.0.
#
# The rule store is one per process, and rule_add has no inverse, so a
# process resolves once: rs_resolve and rs_cli_facts both assert the whole
# universe, and a second call in the same process would see both sets of
# facts. rs_assert_facts is the only function here that calls rule_add.
include "manifest.patlang"

# ---- universes ----

# The manifest files a path names: itself if it ends in .pkg, else the
# directory's manifest.pkg if it has one, else every .pkg file in it.
make a function called rs_manifest_paths takes path returns paths
  require value_class(path) == 8
  let base = path
  if rs_ends_with(path, "/") then
    let base = sc_substr(str_intern(path), 0, path.length - 1)
  end
  if rs_ends_with(base, ".pkg") then
    let paths = [base]
    ensure list_len(paths) == 1
    return paths
  end
  if file_exists(base + "/manifest.pkg") then
    let paths = [base + "/manifest.pkg"]
    ensure list_len(paths) == 1
    return paths
  end
  let out = []
  let names = list_dir(base)
  let i = 0
  while i < list_len(names) do
    if rs_ends_with(names[i], ".pkg") then
      let out = list_push(out, base + "/" + names[i])
    end
    let i = i + 1
  end
  let paths = out
  ensure value_class(paths) == 9
  return paths
end

# Every manifest the paths name: ["ok", manifests] or ["error", path, line,
# message]. One package version may be given once only.
make a function called rs_universe_read takes paths returns r
  require value_class(paths) == 9
  let ms = []
  let keys = []
  let i = 0
  while i < list_len(paths) do
    # list_dir gives [] for a missing path, as for an empty directory, so ask first.
    if not file_exists(paths[i]) then
      let r = ["error", paths[i], 0, "no such file or directory"]
      ensure list_len(r) == 4
      return r
    end
    let files = rs_manifest_paths(paths[i])
    let k = 0
    while k < list_len(files) do
      let m = rs_manifest_read(files[k])
      if m[0] == "error" then
        let r = ["error", files[k], m[1], m[2]]
        ensure list_len(r) == 4
        return r
      end
      let keys = list_push(keys, [rs_m_name(m[1]) + " " + rs_m_version(m[1]), files[k]])
      let ms = list_push(ms, m[1])
      let k = k + 1
    end
    let i = i + 1
  end
  let sorted = rs_sort(keys, "first")
  let i = 1
  while i < list_len(sorted) do
    if sorted[i][0] == sorted[i - 1][0] then
      let r = ["error", sorted[i][1], 0, sorted[i][0] + " is given twice"]
      ensure list_len(r) == 4
      return r
    end
    let i = i + 1
  end
  let r = ["ok", ms]
  ensure (r[0] == "ok") and (list_len(r[1]) == list_len(ms))
  return r
end

# ---- facts ----

# Every version and bound the manifests and the request name, once each,
# in order: [fields, text] each.
make a function called rs_known_versions takes ms, request returns known
  require (value_class(ms) == 9) and (value_class(request) == 9)
  let all = []
  let i = 0
  while i < list_len(ms) do
    let v = rs_m_version(ms[i])
    let all = list_push(all, [rs_version_parse(v), v])
    let deps = rs_m_depends(ms[i])
    let k = 0
    while k < list_len(deps) do
      let cs = deps[k][1]
      let j = 0
      while j < list_len(cs) do
        let all = list_push(all, [rs_version_parse(cs[j][1]), cs[j][1]])
        let j = j + 1
      end
      let k = k + 1
    end
    let i = i + 1
  end
  if list_len(request) == 2 then
    let cs = request[1]
    let j = 0
    while j < list_len(cs) do
      let all = list_push(all, [rs_version_parse(cs[j][1]), cs[j][1]])
      let j = j + 1
    end
  end
  # Versions are canonical (no leading zeros), so equal ones are equal texts.
  let sorted = rs_sort(all, "version")
  let out = []
  let i = 0
  while i < list_len(sorted) do
    if (i == 0) or (sorted[i][1] != sorted[i - 1][1]) then
      let out = list_push(out, sorted[i])
    end
    let i = i + 1
  end
  let known = out
  ensure list_len(known) <= list_len(all)
  return known
end

# Asserts the universe's facts, the request's (when request is [name,
# constraints] rather than []) and the rules. Gives [pkg_available count,
# pkg_requires count, versions known, version_order count].
make a function called rs_assert_facts takes ms, request returns counts
  require (value_class(ms) == 9) and (value_class(request) == 9)
  let avail = 0
  let reqs = 0
  let i = 0
  while i < list_len(ms) do
    let name = rs_m_name(ms[i])
    let ver = rs_m_version(ms[i])
    rule_add("pkg_available", [name, ver], [])
    let avail = avail + 1
    let deps = rs_m_depends(ms[i])
    let k = 0
    while k < list_len(deps) do
      let cs = deps[k][1]
      let j = 0
      while j < list_len(cs) do
        rule_add("pkg_requires", [name, ver, deps[k][0], cs[j][0], cs[j][1]], [])
        let reqs = reqs + 1
        let j = j + 1
      end
      let k = k + 1
    end
    let i = i + 1
  end
  if list_len(request) == 2 then
    let cs = request[1]
    let j = 0
    while j < list_len(cs) do
      rule_add("pkg_requires", ["@request", "0.0.0", request[0], cs[j][0], cs[j][1]], [])
      let reqs = reqs + 1
      let j = j + 1
    end
  end
  let known = rs_known_versions(ms, request)
  let i = 0
  while i < list_len(known) do
    let j = 0
    while j < list_len(known) do
      rule_add("version_order", [known[i][1], known[j][1], rs_fields_order(known[i][0], known[j][0])], [])
      let j = j + 1
    end
    let i = i + 1
  end
  rule satisfies(V, ge, Min) :- version_order(V, Min, gt).
  rule satisfies(V, ge, Min) :- version_order(V, Min, eq).
  rule satisfies(V, gt, Min) :- version_order(V, Min, gt).
  rule satisfies(V, le, Max) :- version_order(V, Max, lt).
  rule satisfies(V, le, Max) :- version_order(V, Max, eq).
  rule satisfies(V, lt, Max) :- version_order(V, Max, lt).
  rule satisfies(V, eq, W) :- version_order(V, W, eq).
  rule dep_candidate(Pkg, PVer, Dep, DVer) :-
      pkg_requires(Pkg, PVer, Dep, Op, Bound),
      pkg_available(Dep, DVer),
      satisfies(DVer, Op, Bound).
  let counts = [avail, reqs, list_len(known), list_len(known) * list_len(known)]
  ensure list_len(counts) == 4
  return counts
end

# ---- a mutable stack: a vec whose slot 0 holds how many items it has ----

make a function called rs_stack_new takes first returns s
  require value_live(first)
  let s = vec_new()
  vec_push(s, 0)
  ensure value_class(s) == 12
  return s
end

make a function called rs_stack_len takes s returns n
  require value_class(s) == 12
  let n = vec_get(s, 0)
  ensure n >= 0
  return n
end

make a function called rs_stack_get takes s, i returns x
  require (value_class(s) == 12) and (i >= 0) and (i < vec_get(s, 0))
  let x = vec_get(s, i + 1)
  ensure value_live(x)
  return x
end

make a function called rs_stack_push takes s, x returns n
  require (value_class(s) == 12) and value_live(x)
  let n = vec_get(s, 0) + 1
  if n < vec_len(s) then
    vec_set(s, n, x)
  else
    vec_push(s, x)
  end
  vec_set(s, 0, n)
  ensure n == vec_get(s, 0)
  return n
end

make a function called rs_stack_cut takes s, n returns done
  require (value_class(s) == 12) and (n >= 0) and (n <= vec_get(s, 0))
  vec_set(s, 0, n)
  let done = true
  ensure vec_get(s, 0) == n
  return done
end

make a function called rs_vec_filled takes n, x returns v
  require (n >= 0) and value_live(x)
  let v = vec_new()
  let i = 0
  while i < n do
    vec_push(v, x)
    let i = i + 1
  end
  ensure vec_len(v) == n
  return v
end

# ---- choosing ----
#
# The search state is a list of:
#   0 names        every available package, sorted (an id is an index here)
#   1 versions     per id, its versions newest first (a version index is an
#                  index here)
#   2 offsets      per id, where its versions start in the memo
#   3 assigned     vec: per id, the version index chosen, or -1
#   4 queued       vec: per id, whether it is on the agenda
#   5 requirers    vec: per id, [package, version, accepted version indices]
#                  for each chosen package (or the request) needing it
#   6 agenda       stack of ids, in the order they were first needed
#   7 trail        stack of what to undo on backtracking
#   8 memo         vec: per package version, its dependencies once asked
#   9 conflict     vec: slot 0 the first conflict met, or []
#  10 tried        vec: slot 0 how many versions were tried

# A sorted list's index of a text, or -1 (binary search).
make a function called rs_name_id takes names, name returns id
  require (value_class(names) == 9) and (value_class(name) == 8)
  let lo = 0
  let hi = list_len(names)
  while lo < hi do
    let mid = floor((lo + hi) / 2)
    let c = str_cmp(names[mid], name)
    if c == 0 then
      ensure (mid >= 0) and (names[mid] == name)
      return mid
    elif c < 0 then
      let lo = mid + 1
    else
      let hi = mid
    end
  end
  let id = 0 - 1
  ensure id == 0 - 1
  return id
end

# The state for a search, from the pkg_available facts.
make a function called rs_state_new takes unused returns st
  require value_live(unused)
  let avail = rs_sort(solve("pkg_available", ["Name", "Ver"]), "first")
  let names = []
  let versions = []
  let offsets = []
  let total = 0
  let i = 0
  while i < list_len(avail) do
    let group = []
    let j = i
    while (j < list_len(avail)) and (avail[j][0] == avail[i][0]) do
      let group = list_push(group, [rs_version_parse(avail[j][1]), avail[j][1]])
      let j = j + 1
    end
    let up = rs_sort(group, "version")
    let down = []
    let k = list_len(up) - 1
    while k >= 0 do
      let down = list_push(down, up[k][1])
      let k = k - 1
    end
    let names = list_push(names, avail[i][0])
    let versions = list_push(versions, down)
    let offsets = list_push(offsets, total)
    let total = total + list_len(down)
    let i = j
  end
  let n = list_len(names)
  let conflict = vec_new()
  vec_push(conflict, [])
  let tried = vec_new()
  vec_push(tried, 0)
  let st = [names, versions, offsets, rs_vec_filled(n, 0 - 1), rs_vec_filled(n, false), rs_vec_filled(n, []), rs_stack_new(0), rs_stack_new(0), rs_vec_filled(total, []), conflict, tried]
  ensure list_len(st) == 11
  return st
end

# The index of an item in a list, or -1.
make a function called rs_index_of takes items, x returns k
  require value_class(items) == 9
  let k = 0
  while k < list_len(items) do
    if items[k] == x then
      ensure k >= 0
      return k
    end
    let k = k + 1
  end
  let k = 0 - 1
  ensure k == 0 - 1
  return k
end

# A package version's dependencies, from the facts: [dep, id (-1 when no
# version of it is available), accepted version indices] each, in the order
# of its pkg_requires facts.
#
# The every-constraint check: dep_candidate(P, V, D, DV) has one proof for
# each of P's constraints on D that DV meets (each satisfies rule for an
# operator has at most one true body, and each fact is asserted once), so DV
# meets them all exactly when it has as many solutions as P has constraints
# on D.
make a function called rs_dep_info takes st, pname, pver returns info
  require (list_len(st) == 11) and (value_class(pname) == 8) and (value_class(pver) == 8)
  let names = st[0]
  let versions = st[1]
  let reqs = solve("pkg_requires", [pname, pver, "Dep", "Op", "Bound"])
  let deps = []
  let counts = []
  let i = 0
  while i < list_len(reqs) do
    let k = rs_index_of(deps, reqs[i][2])
    if k < 0 then
      let deps = list_push(deps, reqs[i][2])
      let counts = list_push(counts, 1)
    else
      let counts = list_set(counts, k, counts[k] + 1)
    end
    let i = i + 1
  end
  let ids = []
  let bases = []
  let total = 0
  let k = 0
  while k < list_len(deps) do
    let id = rs_name_id(names, deps[k])
    let ids = list_push(ids, id)
    let bases = list_push(bases, total)
    if id >= 0 then
      let total = total + list_len(versions[id])
    end
    let k = k + 1
  end
  let tally = rs_vec_filled(total, 0)
  let cands = solve("dep_candidate", [pname, pver, "Dep", "DVer"])
  let i = 0
  while i < list_len(cands) do
    let k = rs_index_of(deps, cands[i][2])
    let vi = rs_index_of(versions[ids[k]], cands[i][3])
    vec_set(tally, bases[k] + vi, vec_get(tally, bases[k] + vi) + 1)
    let i = i + 1
  end
  let out = []
  let k = 0
  while k < list_len(deps) do
    let ok = []
    if ids[k] >= 0 then
      let vi = 0
      while vi < list_len(versions[ids[k]]) do
        if vec_get(tally, bases[k] + vi) == counts[k] then
          let ok = list_push(ok, vi)
        end
        let vi = vi + 1
      end
    end
    let out = list_push(out, [deps[k], ids[k], ok])
    let k = k + 1
  end
  let info = out
  ensure list_len(info) == list_len(deps)
  return info
end

# rs_dep_info for a chosen version, asked of the facts once.
make a function called rs_dep_info_of takes st, id, vi returns info
  require (list_len(st) == 11) and (id >= 0) and (vi >= 0)
  let slot = st[2][id] + vi
  let info = vec_get(st[8], slot)
  if value_class(info) != 9 then
    let info = []
  end
  if (list_len(info) == 0) or (info[0] != "known") then
    let info = ["known", rs_dep_info(st, st[0][id], st[1][id][vi])]
    vec_set(st[8], slot, info)
  end
  let info = info[1]
  ensure value_class(info) == 9
  return info
end

# Keeps the first conflict met: the package, and its requirers as
# [package, version] pairs.
make a function called rs_note_conflict takes st, dep, requirers returns done
  require (list_len(st) == 11) and (value_class(dep) == 8) and (value_class(requirers) == 9)
  if list_len(vec_get(st[9], 0)) == 0 then
    vec_set(st[9], 0, [dep, requirers])
  end
  let done = true
  ensure list_len(vec_get(st[9], 0)) == 2
  return done
end

make a function called rs_requirer_pairs takes rq returns pairs
  require value_class(rq) == 9
  let out = []
  let i = 0
  while i < list_len(rq) do
    let out = list_push(out, [rq[i][0], rq[i][1]])
    let i = i + 1
  end
  let pairs = out
  ensure list_len(pairs) == list_len(rq)
  return pairs
end

# The items in both of two ascending lists of integers.
make a function called rs_intersect takes a, b returns both
  require (value_class(a) == 9) and (value_class(b) == 9)
  let out = []
  let i = 0
  let j = 0
  while (i < list_len(a)) and (j < list_len(b)) do
    if a[i] == b[j] then
      let out = list_push(out, a[i])
      let i = i + 1
      let j = j + 1
    elif a[i] < b[j] then
      let i = i + 1
    else
      let j = j + 1
    end
  end
  let both = out
  ensure list_len(both) <= min(list_len(a), list_len(b))
  return both
end

# The version indices of a package every requirer accepts, newest first.
make a function called rs_candidates takes st, id returns cands
  require (list_len(st) == 11) and (id >= 0)
  let all = []
  let vi = 0
  while vi < list_len(st[1][id]) do
    let all = list_push(all, vi)
    let vi = vi + 1
  end
  let rq = vec_get(st[5], id)
  let i = 0
  while i < list_len(rq) do
    let all = rs_intersect(all, rq[i][2])
    let i = i + 1
  end
  let cands = all
  ensure value_class(cands) == 9
  return cands
end

# Records a chosen package version (or the request) as a requirer of each of
# its dependencies, queueing those not yet needed. Whether every dependency
# is still possible: false when one has no version available, or is chosen
# already at a version this requirer does not accept.
make a function called rs_add_deps takes st, pname, pver, info returns ok
  require (list_len(st) == 11) and (value_class(info) == 9)
  let k = 0
  while k < list_len(info) do
    let dep = info[k][0]
    let id = info[k][1]
    if id < 0 then
      rs_note_conflict(st, dep, [[pname, pver]])
      let ok = false
      ensure ok == false
      return ok
    end
    let old = vec_get(st[5], id)
    vec_set(st[5], id, list_push(old, [pname, pver, info[k][2]]))
    rs_stack_push(st[7], ["requirers", id, old])
    let a = vec_get(st[3], id)
    if a >= 0 then
      if rs_index_of(info[k][2], a) < 0 then
        rs_note_conflict(st, dep, rs_requirer_pairs(vec_get(st[5], id)))
        let ok = false
        ensure ok == false
        return ok
      end
    elif not vec_get(st[4], id) then
      vec_set(st[4], id, true)
      rs_stack_push(st[7], ["queued", id, 0])
      rs_stack_push(st[6], id)
    end
    let k = k + 1
  end
  let ok = true
  ensure ok
  return ok
end

# Undoes the trail back to length n and the agenda back to length a.
make a function called rs_undo takes st, n, a returns done
  require (list_len(st) == 11) and (n >= 0) and (a >= 0)
  let t = rs_stack_len(st[7])
  while t > n do
    let e = rs_stack_get(st[7], t - 1)
    if e[0] == "requirers" then
      vec_set(st[5], e[1], e[2])
    elif e[0] == "queued" then
      vec_set(st[4], e[1], false)
    else
      vec_set(st[3], e[1], 0 - 1)
    end
    let t = t - 1
  end
  rs_stack_cut(st[7], n)
  rs_stack_cut(st[6], a)
  let done = true
  ensure rs_stack_len(st[7]) == n
  return done
end

# Chooses a version for every package on the agenda from position pos on,
# newest first, backtracking when a choice leaves a later package without
# one. Whether it found a choice for all of them.
make a function called rs_search takes st, pos returns found
  require (list_len(st) == 11) and (pos >= 0)
  if pos >= rs_stack_len(st[6]) then
    let found = true
    ensure found
    return found
  end
  let id = rs_stack_get(st[6], pos)
  let cands = rs_candidates(st, id)
  if list_len(cands) == 0 then
    rs_note_conflict(st, st[0][id], rs_requirer_pairs(vec_get(st[5], id)))
    let found = false
    ensure found == false
    return found
  end
  let c = 0
  while c < list_len(cands) do
    let vi = cands[c]
    let n = rs_stack_len(st[7])
    let a = rs_stack_len(st[6])
    vec_set(st[3], id, vi)
    rs_stack_push(st[7], ["assigned", id, 0])
    vec_set(st[10], 0, vec_get(st[10], 0) + 1)
    if rs_add_deps(st, st[0][id], st[1][id][vi], rs_dep_info_of(st, id, vi)) then
      if rs_search(st, pos + 1) then
        let found = true
        ensure found
        return found
      end
    end
    rs_undo(st, n, a)
    let c = c + 1
  end
  let found = false
  ensure found == false
  return found
end

# A requirer's constraints on a package, from the pkg_requires facts.
make a function called rs_constraints_of takes pname, pver, dep returns cs
  require (value_class(pname) == 8) and (value_class(pver) == 8) and (value_class(dep) == 8)
  let sols = solve("pkg_requires", [pname, pver, dep, "Op", "Bound"])
  let out = []
  let i = 0
  while i < list_len(sols) do
    let out = list_push(out, [sols[i][3], sols[i][4]])
    let i = i + 1
  end
  let cs = out
  ensure list_len(cs) == list_len(sols)
  return cs
end

# Chooses, from the facts already asserted, a version of the requested
# package and of everything it needs. Gives
#   ["ok", [[name, version], ...] by name, versions tried]
#   ["conflict", package, [[requirer, version, constraints], ...],
#    available versions newest first, versions tried]
make a function called rs_choose takes request returns result
  require (value_class(request) == 9) and (list_len(request) == 2)
  let st = rs_state_new(0)
  let found = rs_add_deps(st, "@request", "0.0.0", rs_dep_info(st, "@request", "0.0.0"))
  if found then
    let found = rs_search(st, 0)
  end
  let tried = vec_get(st[10], 0)
  if found then
    let chosen = []
    let id = 0
    while id < list_len(st[0]) do
      let vi = vec_get(st[3], id)
      if vi >= 0 then
        let chosen = list_push(chosen, [st[0][id], st[1][id][vi]])
      end
      let id = id + 1
    end
    let result = ["ok", chosen, tried]
    ensure result[0] == "ok"
    return result
  end
  let c = vec_get(st[9], 0)
  let dep = c[0]
  let who = []
  let i = 0
  while i < list_len(c[1]) do
    let p = c[1][i]
    let who = list_push(who, [p[0], p[1], rs_constraints_of(p[0], p[1], dep)])
    let i = i + 1
  end
  let available = []
  let id = rs_name_id(st[0], dep)
  if id >= 0 then
    let available = st[1][id]
  end
  let result = ["conflict", dep, who, available, tried]
  ensure result[0] == "conflict"
  return result
end

# Resolves a request [name, constraints] over a universe's manifests. Call
# once per process: see the head of this file.
make a function called rs_resolve takes ms, request returns result
  require (value_class(ms) == 9) and (value_class(request) == 9) and (list_len(request) == 2)
  rs_assert_facts(ms, request)
  let result = rs_choose(request)
  ensure (result[0] == "ok") or (result[0] == "conflict")
  return result
end

# ---- as text ----

make a function called rs_result_text takes result returns text
  require (result[0] == "ok") or (result[0] == "conflict")
  let b = sb_new()
  if result[0] == "ok" then
    sb_push(b, "resolved ")
    let i = 0
    while i < list_len(result[1]) do
      if i > 0 then
        sb_push(b, ", ")
      end
      sb_push(b, result[1][i][0] + " " + result[1][i][1])
      let i = i + 1
    end
  else
    sb_push(b, "conflict " + result[1])
    let i = 0
    while i < list_len(result[2]) do
      let w = result[2][i]
      sb_push(b, "\nrequirer ")
      if w[0] == "@request" then
        sb_push(b, "the request")
      else
        sb_push(b, w[0] + " " + w[1])
      end
      sb_push(b, ": " + rs_constraints_text(w[2]))
      let i = i + 1
    end
    sb_push(b, "\navailable ")
    if list_len(result[3]) == 0 then
      sb_push(b, "none")
    else
      sb_push(b, rs_join(result[3], ", "))
    end
  end
  let text = sb_str(b)
  ensure value_class(text) == 8
  return text
end

# A request's name and constraint text ("any" for none) as [name,
# constraints], or ["error", message].
make a function called rs_request takes name, cons returns req
  require (value_class(name) == 8) and (value_class(cons) == 8)
  if not rs_is_name(name) then
    let req = ["error", "'" + name + "' is not a package name"]
  elif cons == "any" then
    let req = [name, [["ge", "0.0.0"]]]
  else
    let c = rs_parse_constraints("the request", cons)
    if c[0] == "error" then
      let req = c
    else
      let req = [name, c[1]]
    end
  end
  ensure list_len(req) == 2
  return req
end

make a function called rs_universe_error_text takes u returns text
  require (u[0] == "error") and (list_len(u) == 4)
  let text = "error " + u[1] + " line " + u[2] + ": " + u[3]
  ensure value_class(text) == 8
  return text
end

# [exit code, text]: 0 and "resolved ..." when a choice is found, 1 and the
# conflict when none is, 2 and "error ..." when the request or a manifest is
# malformed.
make a function called rs_cli_resolve takes name, cons, paths returns r
  require (value_class(name) == 8) and (value_class(cons) == 8) and (value_class(paths) == 9)
  let req = rs_request(name, cons)
  if req[0] == "error" then
    let r = [2, "error request: " + req[1]]
    ensure list_len(r) == 2
    return r
  end
  let u = rs_universe_read(paths)
  if u[0] == "error" then
    let r = [2, rs_universe_error_text(u)]
    ensure list_len(r) == 2
    return r
  end
  let result = rs_resolve(u[1], req)
  let code = 0
  if result[0] == "conflict" then
    let code = 1
  end
  let r = [code, rs_result_text(result)]
  ensure list_len(r) == 2
  return r
end

make a function called rs_solutions_text takes b, pred, query returns n
  require (value_class(pred) == 8) and (value_class(query) == 9)
  let sols = solve(pred, query)
  let i = 0
  while i < list_len(sols) do
    sb_push(b, pred)
    let j = 0
    while j < list_len(sols[i]) do
      sb_push(b, " ")
      sb_push(b, sols[i][j])
      let j = j + 1
    end
    sb_push(b, "\n")
    let i = i + 1
  end
  let n = list_len(sols)
  ensure n >= 0
  return n
end

# [exit code, text]: a universe's facts and what the rules derive from them,
# one per line ("version_order 0.1.0 0.2.0 lt"), with no request.
make a function called rs_cli_facts takes paths returns r
  require value_class(paths) == 9
  let u = rs_universe_read(paths)
  if u[0] == "error" then
    let r = [2, rs_universe_error_text(u)]
    ensure list_len(r) == 2
    return r
  end
  rs_assert_facts(u[1], [])
  let b = sb_new()
  rs_solutions_text(b, "pkg_available", ["Name", "Ver"])
  rs_solutions_text(b, "pkg_requires", ["Pkg", "PVer", "Dep", "Op", "Bound"])
  rs_solutions_text(b, "version_order", ["A", "B", "Order"])
  rs_solutions_text(b, "satisfies", ["V", "Op", "Bound"])
  rs_solutions_text(b, "dep_candidate", ["Pkg", "PVer", "Dep", "DVer"])
  let r = [0, rs_trim(sb_str(b))]
  ensure list_len(r) == 2
  return r
end
