# Times the resolver, one universe per run (the rule store is one per
# process). From the repository root:
#
#   ./self_hosting/build/v2.exe packages/resolve/spec/bench.patlang packages/resolve/build/bench.exe --workers 2
#   py -3 -I packages/resolve/spec/oracle.py gen N 1 packages/resolve/build/gen_N_1
#   ./packages/resolve/build/bench.exe resolve packages/resolve/build/gen_N_1 pN-1
#   ./packages/resolve/build/bench.exe order D
#
# "resolve" prints the time to read the manifests, to assert the facts and
# rules, and to choose, with the fact counts and the versions tried.
# "order" asserts the version_order facts for D versions 0.0.0 .. 0.0.D-1
# (D*D facts) and prints how long that took.
include "../resolve.patlang"

make a function called bench_resolve takes dir, name returns code
  require (value_class(dir) == 8) and (value_class(name) == 8)
  let t0 = now_ms()
  let u = rs_universe_read([dir])
  let t1 = now_ms()
  if u[0] == "error" then
    print(rs_universe_error_text(u))
    let code = 2
    ensure code == 2
    return code
  end
  let req = rs_request(name, "any")
  let counts = rs_assert_facts(u[1], req)
  let t2 = now_ms()
  let result = rs_choose(req)
  let t3 = now_ms()
  let chosen = 0
  if result[0] == "ok" then
    let chosen = list_len(result[1])
  end
  print("manifests " + list_len(u[1]) + " pkg_available " + counts[0] + " pkg_requires " + counts[1] + " versions " + counts[2] + " version_order " + counts[3])
  print("read_ms " + (t1 - t0) + " assert_ms " + (t2 - t1) + " choose_ms " + (t3 - t2) + " total_ms " + (t3 - t0))
  print("result " + result[0] + " chosen " + chosen + " tried " + result[list_len(result) - 1])
  # What one goal costs against the store as it now is.
  let held = list_len(solve("contract_holds", ["F", "C"]))
  let m = u[1][list_len(u[1]) - 1]
  let t4 = now_ms()
  let k = 0
  while k < 20 do
    let s = solve("version_order", ["0.0.0", rs_m_version(m), "O"])
    let k = k + 1
  end
  let t5 = now_ms()
  let k = 0
  while k < 20 do
    let s = solve("dep_candidate", [rs_m_name(m), rs_m_version(m), "Dep", "DVer"])
    let k = k + 1
  end
  let t6 = now_ms()
  print("rules " + (counts[0] + counts[1] + counts[3] + 8 + held) + " of which contract_holds " + held + "; one version_order goal " + ((t5 - t4) / 20.0) + " ms; one dep_candidate query for " + rs_m_name(m) + " " + rs_m_version(m) + " (" + list_len(s) + " solutions) " + ((t6 - t5) / 20.0) + " ms")
  let code = 0
  ensure code == 0
  return code
end

make a function called bench_order takes d returns code
  require d >= 1
  let ms = []
  let i = 0
  while i < d do
    let ms = list_push(ms, ["v", "0.0." + i, "", "v.patlang", ["v.patlang"], [], []])
    let i = i + 1
  end
  let t0 = now_ms()
  let counts = rs_assert_facts(ms, [])
  let t1 = now_ms()
  let s = solve("version_order", ["0.0.0", "0.0.1", "O"])
  let t2 = now_ms()
  print("versions " + counts[2] + " version_order " + counts[3] + " assert_ms " + (t1 - t0) + " one_solve_ms " + (t2 - t1) + " answer " + s[0][2])
  let code = 0
  ensure code == 0
  return code
end

make a function called bench_main takes args returns code
  require value_class(args) == 9
  if (list_len(args) == 3) and (args[0] == "resolve") then
    let code = bench_resolve(args[1], args[2])
  elif (list_len(args) == 2) and (args[0] == "order") then
    let code = bench_order(to_num(args[1]))
  else
    print("usage: bench resolve <dir> <name> | bench order <count>")
    let code = 2
  end
  ensure value_class(code) == 2
  return code
end

let code = bench_main(argv())
if code != 0 then
  exit_with(code)
end
