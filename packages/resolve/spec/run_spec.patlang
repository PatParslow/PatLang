# ---- generated universes ----

make a function called rr_generate takes ctx, n, seed, tight returns ok
  require (value_class(n) == 8) and (value_class(seed) == 8) and (value_class(tight) == 1)
  if tight then
    let dir = rr_build("gen_" + n + "_" + seed + "_tight")
    let r = rr_py(["gen", n, seed, dir, "tight"])
  else
    let dir = rr_build("gen_" + n + "_" + seed)
    let r = rr_py(["gen", n, seed, dir])
  end
  ctx_set(ctx, "gen", dir)
  let ok = expect(ctx, "generated " + dir, r, "ok")
  ensure value_class(ok) == 1
  return ok
end

make a function called st_rr_gen takes ctx returns ok
  require value_live(ctx)
  let ok = rr_generate(ctx, step_arg(ctx, "n"), step_arg(ctx, "s"), false)
  ensure value_class(ok) == 1
  return ok
end

make a function called st_rr_gen_tight takes ctx returns ok
  require value_live(ctx)
  let ok = rr_generate(ctx, step_arg(ctx, "n"), step_arg(ctx, "s"), true)
  ensure value_class(ok) == 1
  return ok
end

make a function called st_rr_as_oracle takes ctx returns ok
  require value_live(ctx)
  let a = ctx_get(ctx, "resolve_args")
  # Python writes CRLF line ends on Windows: compare the lines.
  let want = rs_join(rs_text_lines(rr_py(["resolve", a[2][0], a[0], a[1]])), "\n")
  let got = rs_join(rs_text_lines(ctx_get(ctx, "out")), "\n")
  let ok = expect(ctx, "output against the oracle's", got, want)
  ensure value_class(ok) == 1
  return ok
end

make a function called st_rr_consistent takes ctx returns ok
  require value_live(ctx)
  let a = ctx_get(ctx, "resolve_args")
  let path = rr_build("out.txt")
  write_file(path, ctx_get(ctx, "out") + "\n")
  let ok = expect(ctx, "the oracle's check", rr_py(["check", a[2][0], a[0], path]), "ok")
  ensure value_class(ok) == 1
  return ok
end

make a function called st_rr_gen_facts takes ctx returns ok
  require value_live(ctx)
  ctx_set(ctx, "out", rr_child(["--facts", ctx_get(ctx, "gen")]))
  let ok = true
  ensure value_class(ok) == 1
  return ok
end

make a function called st_rr_orders_right takes ctx returns ok
  require value_live(ctx)
  let path = rr_build("facts.txt")
  write_file(path, ctx_get(ctx, "out") + "\n")
  let r = rr_py(["orders", ctx_get(ctx, "gen"), path])
  let ok = expect(ctx, "the oracle's version_order check " + r, rs_starts_with(r, "ok "), true)
  ensure value_class(ok) == 1
  return ok
end

# Where two patterns could both match a text, the longer comes first: a
# placeholder may take in a quote.
make a function called register_resolve_steps takes ctx returns ok
  require value_live(ctx)
  step(ctx, "the manifest \"{path}\"", "st_rr_manifest")
  step(ctx, "it is read", "st_rr_read")
  step(ctx, "it reads as package \"{name}\" version \"{ver}\"", "st_rr_reads_as")
  step(ctx, "its entry is \"{e}\"", "st_rr_entry")
  step(ctx, "its summary is \"{s}\"", "st_rr_summary")
  step(ctx, "it has {n} include and {m} file", "st_rr_counts")
  step(ctx, "it has {n} includes and {m} files", "st_rr_counts")
  step(ctx, "its dependencies are \"\"", "st_rr_no_deps")
  step(ctx, "its dependencies are \"{deps}\"", "st_rr_deps")
  step(ctx, "the hash of its file \"{p}\" is in lower case", "st_rr_hash_lower")
  step(ctx, "the manifest \"{rel}\" fails at line {n} with \"{msg}\"", "st_rr_fails_at")
  step(ctx, "reading the universe \"{u}\" fails with \"{msg}\"", "st_rr_universe_fails")
  step(ctx, "version \"{a}\" compares {o} to \"{b}\"", "st_rr_compares")
  step(ctx, "\"{t}\" is not a version", "st_rr_not_version")
  step(ctx, "\"{t}\" is a version", "st_rr_is_version")
  step(ctx, "the universe \"{u}\"", "st_rr_universe")
  step(ctx, "its facts are listed", "st_rr_facts")
  step(ctx, "there are {n} \"{pred}\" facts", "st_rr_fact_count")
  step(ctx, "the facts include \"{line}\" {n} times", "st_rr_fact_times")
  step(ctx, "the facts include \"{line}\"", "st_rr_fact_in")
  step(ctx, "the facts do not include \"{line}\"", "st_rr_fact_not_in")
  step(ctx, "resolving \"{name}\" \"{cons}\" from the real packages", "st_rr_resolve_real_cons")
  step(ctx, "resolving \"{name}\" from the real packages", "st_rr_resolve_real")
  step(ctx, "resolving \"{name}\" from the generated universe", "st_rr_resolve_gen")
  step(ctx, "resolving \"{name}\" \"{cons}\" from \"{u}\"", "st_rr_resolve_cons")
  step(ctx, "resolving \"{name}\" from \"{u}\"", "st_rr_resolve")
  step(ctx, "the choice is \"{c}\"", "st_rr_choice")
  step(ctx, "resolution fails on \"{d}\"", "st_rr_fails_on")
  step(ctx, "the conflict has {n} requirers", "st_rr_requirers")
  step(ctx, "the conflict has {n} requirer", "st_rr_requirers")
  step(ctx, "the conflict lists \"{line}\"", "st_rr_lists")
  step(ctx, "the output is the one the oracle gives", "st_rr_as_oracle")
  step(ctx, "the output starts with \"{text}\"", "st_rr_output_starts")
  step(ctx, "the output is \"{text}\"", "st_rr_output_is")
  step(ctx, "a tight generated universe of {n} packages from seed {s}", "st_rr_gen_tight")
  step(ctx, "a generated universe of {n} packages from seed {s}", "st_rr_gen")
  step(ctx, "the oracle finds the choice consistent", "st_rr_consistent")
  step(ctx, "the generated universe's facts are listed", "st_rr_gen_facts")
  step(ctx, "the oracle finds every version_order fact right", "st_rr_orders_right")
  let ok = true
  ensure value_class(ok) == 1
  return ok
end

make a function called rr_run_features takes only returns ok
  require value_class(only) == 9
  let ctx = ctx_new()
  register_resolve_steps(ctx)
  if list_len(only) > 0 then
    run_feature_file(ctx, only[0])
  else
    run_feature_file(ctx, "packages/resolve/spec/manifest.feature")
    run_feature_file(ctx, "packages/resolve/spec/versions.feature")
    run_feature_file(ctx, "packages/resolve/spec/resolve.feature")
    run_feature_file(ctx, "packages/resolve/spec/oracle.feature")
  end
  let ok = ctx_report(ctx)
  ensure value_class(ok) == 1
  return ok
end

# The child modes print the library's text and exit with its code.
make a function called rr_main takes args returns code
  require value_class(args) == 9
  let code = 0
  if (list_len(args) >= 4) and (args[0] == "--resolve") then
    let r = rs_cli_resolve(args[1], args[2], rs_list_from(args, 3))
    print(r[1])
    let code = r[0]
  elif (list_len(args) >= 2) and (args[0] == "--facts") then
    let r = rs_cli_facts(rs_list_from(args, 1))
    print(r[1])
    let code = r[0]
  elif not rr_run_features(args) then
    let code = 1
  end
  ensure value_class(code) == 2
  return code
end

let code = rr_main(argv())
if code != 0 then
  exit_with(code)
end
