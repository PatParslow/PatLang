# Runs packages/resolve/spec/*.feature, from the repository root:
#
#   ./self_hosting/build/v2.exe packages/resolve/spec/run_spec.patlang packages/resolve/build/run_spec.exe --workers 2
#   ./packages/resolve/build/run_spec.exe [feature file]
#
# The rule store rule_add writes to is one per process and has no retraction,
# so every step that asserts facts runs this same program again as a child,
# in one of its two other modes, and reads what it prints:
#
#   run_spec.exe --resolve <name> <constraint or "any"> <manifest or directory>...
#   run_spec.exe --facts <manifest or directory>...
#
# spec/oracle.py (run as `py -3 -I`) generates universes and is the
# reference for them. Scratch files go to packages/resolve/build/. The exit
# code is 0 when every check passes, 1 otherwise.
include "../../../self_hosting/lib/includes.patlang"
include "../../../self_hosting/lib/gherkin.patlang"
include "../resolve.patlang"

make a function called rr_self takes unused returns path
  require value_live(unused)
  let path = "./packages/resolve/build/run_spec.exe"
  ensure path.length > 0
  return path
end

make a function called rr_fixture takes rel returns path
  require value_class(rel) == 8
  let path = "packages/resolve/spec/fixtures/" + rel
  ensure path.length > rel.length
  return path
end

make a function called rr_build takes rel returns path
  require value_class(rel) == 8
  let path = "packages/resolve/build/" + rel
  ensure path.length > rel.length
  return path
end

# The oracle's printed answer, trimmed; one call per argument count, since
# exec_capture's arguments are its call's own.
make a function called rr_py takes a returns out
  require (value_class(a) == 9) and (list_len(a) >= 2) and (list_len(a) <= 5)
  let o = "packages/resolve/spec/oracle.py"
  let n = list_len(a)
  let raw = ""
  if n == 2 then
    let raw = exec_capture("py", "-3", "-I", o, a[0], a[1])
  elif n == 3 then
    let raw = exec_capture("py", "-3", "-I", o, a[0], a[1], a[2])
  elif n == 4 then
    let raw = exec_capture("py", "-3", "-I", o, a[0], a[1], a[2], a[3])
  else
    let raw = exec_capture("py", "-3", "-I", o, a[0], a[1], a[2], a[3], a[4])
  end
  let out = rs_trim(raw)
  ensure value_class(out) == 8
  return out
end

# What a child run of this program prints, trimmed.
make a function called rr_child takes a returns out
  require (value_class(a) == 9) and (list_len(a) >= 2) and (list_len(a) <= 6)
  let me = rr_self(0)
  let n = list_len(a)
  let raw = ""
  if n == 2 then
    let raw = exec_capture(me, a[0], a[1])
  elif n == 3 then
    let raw = exec_capture(me, a[0], a[1], a[2])
  elif n == 4 then
    let raw = exec_capture(me, a[0], a[1], a[2], a[3])
  elif n == 5 then
    let raw = exec_capture(me, a[0], a[1], a[2], a[3], a[4])
  else
    let raw = exec_capture(me, a[0], a[1], a[2], a[3], a[4], a[5])
  end
  let out = rs_trim(raw)
  ensure value_class(out) == 8
  return out
end

# How many of a text's lines are exactly `line`, or start with it when
# `prefix` is true.
make a function called rr_count_lines takes text, line, prefix returns n
  require (value_class(text) == 8) and (value_class(line) == 8) and (value_class(prefix) == 1)
  let lines = rs_text_lines(text)
  let n = 0
  let i = 0
  while i < list_len(lines) do
    if prefix then
      if rs_starts_with(lines[i], line) then
        let n = n + 1
      end
    elif lines[i] == line then
      let n = n + 1
    end
    let i = i + 1
  end
  ensure n >= 0
  return n
end

make a function called rr_first_line takes text returns line
  require value_class(text) == 8
  let lines = rs_text_lines(text)
  let line = ""
  if list_len(lines) > 0 then
    let line = lines[0]
  end
  ensure value_class(line) == 8
  return line
end

# ---- manifests ----

make a function called st_rr_manifest takes ctx returns ok
  require value_live(ctx)
  ctx_set(ctx, "path", step_arg(ctx, "path"))
  let ok = true
  ensure value_class(ok) == 1
  return ok
end

make a function called st_rr_read takes ctx returns ok
  require value_live(ctx)
  ctx_set(ctx, "read", rs_manifest_read(ctx_get(ctx, "path")))
  let ok = true
  ensure value_class(ok) == 1
  return ok
end

# The manifest read, or [] after reporting why there is none.
make a function called rr_manifest takes ctx returns m
  require value_live(ctx)
  let r = ctx_get(ctx, "read")
  let m = []
  if r[0] == "ok" then
    let m = r[1]
  else
    expect(ctx, "reading " + ctx_get(ctx, "path"), "error line " + r[1] + ": " + r[2], "ok")
  end
  ensure value_class(m) == 9
  return m
end

make a function called st_rr_reads_as takes ctx returns ok
  require value_live(ctx)
  let m = rr_manifest(ctx)
  if list_len(m) == 0 then
    let ok = false
    ensure value_class(ok) == 1
    return ok
  end
  let ok = expect(ctx, "package and version", rs_m_name(m) + " " + rs_m_version(m), step_arg(ctx, "name") + " " + step_arg(ctx, "ver"))
  ensure value_class(ok) == 1
  return ok
end

