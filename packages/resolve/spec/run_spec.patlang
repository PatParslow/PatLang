# ---- resolving ----

make a function called rr_resolve takes ctx, name, cons, dirs returns ok
  require (value_class(name) == 8) and (value_class(cons) == 8) and (value_class(dirs) == 9)
  let a = ["--resolve", name, cons]
  let i = 0
  while i < list_len(dirs) do
    let a = list_push(a, dirs[i])
    let i = i + 1
  end
  ctx_set(ctx, "resolve_args", [name, cons, dirs])
  ctx_set(ctx, "out", rr_child(a))
  let ok = true
  ensure ok
  return ok
end

make a function called rr_real_packages takes unused returns dirs
  require value_live(unused)
  let dirs = ["packages/deflate", "packages/zip", "packages/sha256"]
  ensure list_len(dirs) == 3
  return dirs
end

