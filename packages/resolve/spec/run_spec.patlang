make a function called st_rr_hash_lower takes ctx returns ok
  require value_live(ctx)
  let m = rr_manifest(ctx)
  if list_len(m) == 0 then
    let ok = false
    ensure value_class(ok) == 1
    return ok
  end
  let files = rs_m_files(m)
  let hex = "no such file line"
  let i = 0
  while i < list_len(files) do
    if files[i][0] == step_arg(ctx, "p") then
      let hex = files[i][1]
    end
    let i = i + 1
  end
  let ok = expect(ctx, "hash in lower case", hex, rs_lower(hex))
  ensure value_class(ok) == 1
  return ok
end

make a function called st_rr_fails_at takes ctx returns ok
  require value_live(ctx)
  let r = rs_manifest_read(rr_fixture(step_arg(ctx, "rel")))
  let got = "read without error"
  if r[0] == "error" then
    let got = "line " + r[1] + ": " + r[2]
  end
  let ok = expect(ctx, step_arg(ctx, "rel"), got, "line " + step_arg(ctx, "n") + ": " + step_arg(ctx, "msg"))
  ensure value_class(ok) == 1
  return ok
end

make a function called st_rr_universe_fails takes ctx returns ok
  require value_live(ctx)
  let r = rs_universe_read([rr_fixture(step_arg(ctx, "u"))])
  let got = "read without error"
  if r[0] == "error" then
    let got = r[3]
  end
  let ok = expect(ctx, "universe " + step_arg(ctx, "u"), got, step_arg(ctx, "msg"))
  ensure value_class(ok) == 1
  return ok
end

# ---- versions ----

make a function called st_rr_compares takes ctx returns ok
  require value_live(ctx)
  let a = step_arg(ctx, "a")
  let b = step_arg(ctx, "b")
  let o = step_arg(ctx, "o")
  let back = "eq"
  if o == "lt" then
    let back = "gt"
  elif o == "gt" then
    let back = "lt"
  end
  let ok1 = expect(ctx, a + " against " + b, rs_version_order(a, b), o)
  let ok2 = expect(ctx, b + " against " + a, rs_version_order(b, a), back)
  let ok = ok1 and ok2
  ensure value_class(ok) == 1
  return ok
end

make a function called st_rr_not_version takes ctx returns ok
  require value_live(ctx)
  let ok = expect(ctx, "fields of " + step_arg(ctx, "t"), list_len(rs_version_parse(step_arg(ctx, "t"))), 0)
  ensure value_class(ok) == 1
  return ok
end

make a function called st_rr_is_version takes ctx returns ok
  require value_live(ctx)
  let ok = expect(ctx, "fields of " + step_arg(ctx, "t"), list_len(rs_version_parse(step_arg(ctx, "t"))), 3)
  ensure value_class(ok) == 1
  return ok
end

