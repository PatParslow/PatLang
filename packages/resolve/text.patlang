# Text helpers for the resolve package. Every scan goes through a
# str_intern cursor (sc_len, sc_code, sc_substr), which indexes in O(1);
# results are built with sb_new/sb_push/sb_str.

make a function called rs_is_space takes c returns yes
  require value_class(c) == 2
  let yes = (c == 32) or (c == 9) or (c == 13) or (c == 10)
  ensure value_class(yes) == 1
  return yes
end

# The text without leading and trailing spaces, tabs and line ends.
make a function called rs_trim takes text returns out
  require value_class(text) == 8
  let h = str_intern(text)
  let n = sc_len(h)
  let lo = 0
  while (lo < n) and rs_is_space(sc_code(h, lo)) do
    let lo = lo + 1
  end
  let hi = n
  while (hi > lo) and rs_is_space(sc_code(h, hi - 1)) do
    let hi = hi - 1
  end
  let out = sc_substr(h, lo, hi - lo)
  ensure out.length <= text.length
  return out
end

# A text's lines, without their line ends (LF or CRLF); a last line without
# a line end counts, an empty one after the last line end does not.
make a function called rs_text_lines takes text returns lines
  require value_class(text) == 8
  let h = str_intern(text)
  let n = sc_len(h)
  let out = []
  let start = 0
  let i = 0
  while i < n do
    if sc_code(h, i) == 10 then
      let len = i - start
      if (len > 0) and (sc_code(h, i - 1) == 13) then
        let len = len - 1
      end
      let out = list_push(out, sc_substr(h, start, len))
      let start = i + 1
    end
    let i = i + 1
  end
  if start < n then
    let out = list_push(out, sc_substr(h, start, n - start))
  end
  let lines = out
  ensure value_class(lines) == 9
  return lines
end

# A file's lines from its bytes (ASCII or UTF-8; each line is built from its
# bytes, never by indexing a large String).
make a function called rs_byte_lines takes bytes returns lines
  require value_class(bytes) == 9
  let out = []
  let cur = sb_new()
  let i = 0
  while i < list_len(bytes) do
    let c = bytes[i]
    if c == 10 then
      let out = list_push(out, sb_str(cur))
      let cur = sb_new()
    elif c != 13 then
      sb_push(cur, chr(c))
    end
    let i = i + 1
  end
  if sb_len(cur) > 0 then
    let out = list_push(out, sb_str(cur))
  end
  let lines = out
  ensure value_class(lines) == 9
  return lines
end

make a function called rs_starts_with takes text, prefix returns yes
  require (value_class(text) == 8) and (value_class(prefix) == 8)
  let yes = false
  if prefix.length <= text.length then
    let yes = sc_substr(str_intern(text), 0, prefix.length) == prefix
  end
  ensure value_class(yes) == 1
  return yes
end

make a function called rs_ends_with takes text, suffix returns yes
  require (value_class(text) == 8) and (value_class(suffix) == 8)
  let yes = false
  if suffix.length <= text.length then
    let yes = sc_substr(str_intern(text), text.length - suffix.length, suffix.length) == suffix
  end
  ensure value_class(yes) == 1
  return yes
end

# A text with A-Z made a-z.
make a function called rs_lower takes text returns low
  require value_class(text) == 8
  let h = str_intern(text)
  let n = sc_len(h)
  let b = sb_new()
  let i = 0
  while i < n do
    let c = sc_code(h, i)
    if (c >= 65) and (c <= 90) then
      let c = c + 32
    end
    sb_push(b, chr(c))
    let i = i + 1
  end
  let low = sb_str(b)
  ensure low.length == text.length
  return low
end

# The text's space-or-tab separated words.
make a function called rs_words takes text returns words
  require value_class(text) == 8
  let h = str_intern(text)
  let n = sc_len(h)
  let out = []
  let start = 0 - 1
  let i = 0
  while i <= n do
    let c = sc_code(h, i)
    if (i == n) or (c == 32) or (c == 9) then
      if start >= 0 then
        let out = list_push(out, sc_substr(h, start, i - start))
      end
      let start = 0 - 1
    elif start < 0 then
      let start = i
    end
    let i = i + 1
  end
  let words = out
  ensure value_class(words) == 9
  return words
end

# The text split at every comma, each part trimmed (so "a, b," gives
# ["a", "b", ""]).
make a function called rs_split_commas takes text returns parts
  require value_class(text) == 8
  let h = str_intern(text)
  let n = sc_len(h)
  let out = []
  let start = 0
  let i = 0
  while i <= n do
    if (i == n) or (sc_code(h, i) == 44) then
      let out = list_push(out, rs_trim(sc_substr(h, start, i - start)))
      let start = i + 1
    end
    let i = i + 1
  end
  let parts = out
  ensure list_len(parts) >= 1
  return parts
end

# The items of a list from index k on.
make a function called rs_list_from takes items, k returns out
  require (value_class(items) == 9) and (k >= 0)
  let r = []
  let i = k
  while i < list_len(items) do
    let r = list_push(r, items[i])
    let i = i + 1
  end
  let out = r
  ensure value_class(out) == 9
  return out
end

# Texts joined with a separator.
make a function called rs_join takes items, sep returns text
  require (value_class(items) == 9) and (value_class(sep) == 8)
  let b = sb_new()
  let i = 0
  while i < list_len(items) do
    if i > 0 then
      sb_push(b, sep)
    end
    sb_push(b, to_s(items[i]))
    let i = i + 1
  end
  let text = sb_str(b)
  ensure value_class(text) == 8
  return text
end
