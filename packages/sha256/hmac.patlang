# HMAC-SHA-256 (RFC 2104, with SHA-256 as the hash; test vectors RFC 4231).
#
#   hmac_sha256(key, data)      -> the 32-byte MAC of data (both byte lists)
#   hmac_sha256_hex(key, data)  -> the MAC in lowercase hex
#
# A key longer than SHA-256's 64-byte block is hashed first; a shorter one
# is padded with zeros to the block.
include "sha256_core.patlang"
include "text.patlang"

make a function called hmac_sha256 takes key, data returns mac
  require (value_class(key) == 9) and (value_class(data) == 9)
  let k = key
  if list_len(k) > 64 then
    let k = sha256_bytes(key)
  end
  let ipad = []
  let opad = []
  let i = 0
  while i < 64 do
    let kb = 0
    if i < list_len(k) then
      let kb = k[i]
    end
    let ipad = list_push(ipad, kb bxor 54)
    let opad = list_push(opad, kb bxor 92)
    let i = i + 1
  end
  let inner = sha256_new()
  sha256_update(inner, ipad)
  sha256_update(inner, data)
  let outer = sha256_new()
  sha256_update(outer, opad)
  sha256_update(outer, sha256_finish(inner))
  let mac = sha256_finish(outer)
  ensure list_len(mac) == 32
  return mac
end

make a function called hmac_sha256_hex takes key, data returns hex
  require (value_class(key) == 9) and (value_class(data) == 9)
  let hex = bytes_to_hex(hmac_sha256(key, data))
  ensure hex.length == 64
  return hex
end
