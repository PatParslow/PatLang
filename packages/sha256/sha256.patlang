# sha256 package: SHA-256 (FIPS 180-4) and HMAC-SHA-256 (RFC 2104) over
# lists of bytes (List<Int>, each 0..255).
#
#   sha256_new()                -> a hash in progress (changed in place)
#   sha256_update(h, bytes)     -> true; false once h is finished
#   sha256_finish(h)            -> the 32-byte digest (again: the same digest)
#   sha256_bytes(bytes)         -> the 32-byte digest of a list
#   sha256_hex(bytes)           -> the digest of a list, 64 lowercase hex digits
#   sha256_string(text)         -> the digest of a String's UTF-8 bytes
#   sha256_string_hex(text)     -> the same, in hex
#   sha256_file(path)           -> ["ok", digest] | ["err", message]
#   sha256_file_hex(path)       -> a file's digest in hex, "" when unreadable
#   hmac_sha256(key, data)      -> the 32-byte HMAC-SHA-256 of data
#   hmac_sha256_hex(key, data)  -> the same, in hex
#   bytes_to_hex(bytes), hex_to_bytes(text), utf8_encode(text)
#   digest_equal(a, b)          -> byte lists equal, every byte compared
include "sha256_core.patlang"
include "text.patlang"
include "hmac.patlang"

make a function called sha256_string takes text returns digest
  require value_class(text) == 8
  let digest = sha256_bytes(utf8_encode(text))
  ensure list_len(digest) == 32
  return digest
end

make a function called sha256_string_hex takes text returns hex
  require value_class(text) == 8
  let hex = bytes_to_hex(sha256_string(text))
  ensure hex.length == 64
  return hex
end
