# SHA-256 (FIPS 180-4) over lists of bytes (List<Int>, each 0..255).
#
#   sha256_new()             -> a hash in progress (a vec, changed in place)
#   sha256_update(h, bytes)  -> true; false (and no change) once h is finished
#   sha256_finish(h)         -> the 32-byte digest; h is then finished, and
#                               finishing it again gives the same digest
#   sha256_bytes(bytes)      -> the 32-byte digest of a whole list
#   sha256_hex(bytes)        -> the digest of a whole list, 64 lowercase hex digits
#   sha256_file(path)        -> ["ok", digest] | ["err", message]; the file is
#                               read 1 MB at a time, so it need not fit in memory
#   sha256_file_hex(path)    -> the file's digest in hex, "" when it cannot be read
#
# Words are kept below 2^32: every sum is masked with band 4294967295, and a
# rotation moves the low bits up only after masking them, so no value ever
# leaves the fixnum range and nothing becomes a bigint.

# The round constants: the first 32 bits of the fractional parts of the cube
# roots of the first 64 primes.
make a function called sha256_k returns k
  let k = [1116352408, 1899447441, 3049323471, 3921009573, 961987163, 1508970993, 2453635748, 2870763221, 3624381080, 310598401, 607225278, 1426881987, 1925078388, 2162078206, 2614888103, 3248222580, 3835390401, 4022224774, 264347078, 604807628, 770255983, 1249150122, 1555081692, 1996064986, 2554220882, 2821834349, 2952996808, 3210313671, 3336571891, 3584528711, 113926993, 338241895, 666307205, 773529912, 1294757372, 1396182291, 1695183700, 1986661051, 2177026350, 2456956037, 2730485921, 2820302411, 3259730800, 3345764771, 3516065817, 3600352804, 4094571909, 275423344, 430227734, 506948616, 659060556, 883997877, 958139571, 1322822218, 1537002063, 1747873779, 1955562222, 2024104815, 2227730452, 2361852424, 2428436474, 2756734187, 3204031479, 3329325298]
  ensure (list_len(k) == 64) and (k[0] == 1116352408) and (k[63] == 3329325298)
  return k
end

# The initial hash value: the first 32 bits of the fractional parts of the
# square roots of the first 8 primes.
make a function called sha256_h0 returns h
  let h = [1779033703, 3144134277, 1013904242, 2773480762, 1359893119, 2600822924, 528734635, 1541459225]
  ensure list_len(h) == 8
  return h
end

# The hash value after nblocks 64-byte blocks of bytes starting at lo.
# hv is not changed; the result is a new list of 8 words.
make a function called sha256_blocks takes hv, k, bytes, lo, nblocks returns out
  require (list_len(hv) == 8) and (list_len(k) == 64)
  require (lo >= 0) and (nblocks >= 0) and (lo + 64 * nblocks <= list_len(bytes))
  let m = 4294967295
  let h0 = hv[0]
  let h1 = hv[1]
  let h2 = hv[2]
  let h3 = hv[3]
  let h4 = hv[4]
  let h5 = hv[5]
  let h6 = hv[6]
  let h7 = hv[7]
  # The message schedule, made once and overwritten in place for each block.
  let w = []
  let t = 0
  while t < 64 do
    let w = list_push(w, 0)
    let t = t + 1
  end
  let blk = 0
  while blk < nblocks do
    let p = lo + 64 * blk
    let t = 0
    while t < 16 do
      let j = p + 4 * t
      let w = list_set(w, t, (bytes[j] shl 24) bor (bytes[j + 1] shl 16) bor (bytes[j + 2] shl 8) bor bytes[j + 3])
      let t = t + 1
    end
    while t < 64 do
      let x = w[t - 15]
      let s0 = (((x shr 7) bor ((x band 127) shl 25)) bxor ((x shr 18) bor ((x band 262143) shl 14))) bxor (x shr 3)
      let y = w[t - 2]
      let s1 = (((y shr 17) bor ((y band 131071) shl 15)) bxor ((y shr 19) bor ((y band 524287) shl 13))) bxor (y shr 10)
      let w = list_set(w, t, (w[t - 16] + s0 + w[t - 7] + s1) band m)
      let t = t + 1
    end
    let va = h0
    let vb = h1
    let vc = h2
    let vd = h3
    let ve = h4
    let vf = h5
    let vg = h6
    let vh = h7
    let t = 0
    while t < 64 do
      let bs1 = (((ve shr 6) bor ((ve band 63) shl 26)) bxor ((ve shr 11) bor ((ve band 2047) shl 21))) bxor ((ve shr 25) bor ((ve band 33554431) shl 7))
      let ch = (ve band vf) bxor ((ve bxor m) band vg)
      let t1 = (vh + bs1 + ch + k[t] + w[t]) band m
      let bs0 = (((va shr 2) bor ((va band 3) shl 30)) bxor ((va shr 13) bor ((va band 8191) shl 19))) bxor ((va shr 22) bor ((va band 4194303) shl 10))
      let maj = ((va band vb) bxor (va band vc)) bxor (vb band vc)
      let t2 = bs0 + maj
      let vh = vg
      let vg = vf
      let vf = ve
      let ve = (vd + t1) band m
      let vd = vc
      let vc = vb
      let vb = va
      let va = (t1 + t2) band m
      let t = t + 1
    end
    let h0 = (h0 + va) band m
    let h1 = (h1 + vb) band m
    let h2 = (h2 + vc) band m
    let h3 = (h3 + vd) band m
    let h4 = (h4 + ve) band m
    let h5 = (h5 + vf) band m
    let h6 = (h6 + vg) band m
    let h7 = (h7 + vh) band m
    let blk = blk + 1
  end
  let out = [h0, h1, h2, h3, h4, h5, h6, h7]
  ensure list_len(out) == 8
  return out
end

# A hash in progress is a vec:
#   0 the hash value (8 words)    1 pending bytes, fewer than 64
#   2 bytes taken so far          3 the round constants
#   4 the digest once finished, else false
make a function called sha256_new returns h
  let h = vec_new()
  vec_push(h, sha256_h0())
  vec_push(h, [])
  vec_push(h, 0)
  vec_push(h, sha256_k())
  vec_push(h, false)
  ensure (value_class(h) == 12) and (vec_len(h) == 5)
  return h
end

make a function called sha256_update takes h, bytes returns ok
  require (value_class(h) == 12) and (vec_len(h) == 5) and (value_class(bytes) == 9)
  if value_class(vec_get(h, 4)) == 9 then
    let ok = false
    ensure ok == false
    return ok
  end
  let n = list_len(bytes)
  let k = vec_get(h, 3)
  let hv = vec_get(h, 0)
  # Take the pending list out of the vec so it is the only reference and
  # list_push extends it in place.
  let pend = vec_get(h, 1)
  vec_set(h, 1, [])
  let i = 0
  if list_len(pend) > 0 then
    while (list_len(pend) < 64) and (i < n) do
      let pend = list_push(pend, bytes[i])
      let i = i + 1
    end
    if list_len(pend) == 64 then
      let hv = sha256_blocks(hv, k, pend, 0, 1)
      let pend = []
    end
  end
  # Whole blocks straight from the input, without copying.
  let whole = (n - i) shr 6
  if whole > 0 then
    let hv = sha256_blocks(hv, k, bytes, i, whole)
    let i = i + 64 * whole
  end
  while i < n do
    let pend = list_push(pend, bytes[i])
    let i = i + 1
  end
  vec_set(h, 0, hv)
  vec_set(h, 1, pend)
  vec_set(h, 2, vec_get(h, 2) + n)
  let ok = true
  ensure (ok == true) and (list_len(vec_get(h, 1)) < 64)
  return ok
end

# The words of a hash value as 32 big-endian bytes.
make a function called sha256_word_bytes takes hv returns out
  require list_len(hv) == 8
  let r = []
  let i = 0
  while i < 8 do
    let x = hv[i]
    let r = list_push(r, (x shr 24) band 255)
    let r = list_push(r, (x shr 16) band 255)
    let r = list_push(r, (x shr 8) band 255)
    let r = list_push(r, x band 255)
    let i = i + 1
  end
  let out = r
  ensure list_len(out) == 32
  return out
end

# Padding: a 1 bit, zeros to 56 mod 64 bytes, then the message length in
# bits as 64 bits big-endian.
make a function called sha256_finish takes h returns digest
  require (value_class(h) == 12) and (vec_len(h) == 5)
  if value_class(vec_get(h, 4)) == 9 then
    let digest = vec_get(h, 4)
    ensure list_len(digest) == 32
    return digest
  end
  let pend = vec_get(h, 1)
  vec_set(h, 1, [])
  let pend = list_push(pend, 128)
  while (list_len(pend) % 64) != 56 do
    let pend = list_push(pend, 0)
  end
  let bits = vec_get(h, 2) * 8
  let s = 56
  while s >= 0 do
    let pend = list_push(pend, (bits shr s) band 255)
    let s = s - 8
  end
  let hv = sha256_blocks(vec_get(h, 0), vec_get(h, 3), pend, 0, list_len(pend) shr 6)
  let digest = sha256_word_bytes(hv)
  vec_set(h, 0, hv)
  vec_set(h, 4, digest)
  ensure list_len(digest) == 32
  return digest
end

make a function called sha256_bytes takes bytes returns digest
  require value_class(bytes) == 9
  let h = sha256_new()
  sha256_update(h, bytes)
  let digest = sha256_finish(h)
  ensure list_len(digest) == 32
  return digest
end

make a function called sha256_hex takes bytes returns hex
  require value_class(bytes) == 9
  let hex = bytes_to_hex(sha256_bytes(bytes))
  ensure hex.length == 64
  return hex
end

# A file's digest, read 1 MB at a time with read_file_bytes (the runtime's
# reads take the file size from GetFileSize's low word, so files must be
# under 4 GB).
make a function called sha256_file takes path returns r
  require value_class(path) == 8
  if not file_exists(path) then
    let r = ["err", "cannot read " + path]
    ensure list_len(r) == 2
    return r
  end
  let window = 1048576
  let h = sha256_new()
  let offset = 0
  let more = true
  while more do
    let part = read_file_bytes(path, offset, window)
    sha256_update(h, part)
    let offset = offset + list_len(part)
    let more = list_len(part) == window
  end
  let r = ["ok", sha256_finish(h)]
  ensure list_len(r) == 2
  return r
end

make a function called sha256_file_hex takes path returns hex
  require value_class(path) == 8
  let r = sha256_file(path)
  let hex = ""
  if r[0] == "ok" then
    let hex = bytes_to_hex(r[1])
  end
  ensure (hex.length == 64) or (hex.length == 0)
  return hex
end
