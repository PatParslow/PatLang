# Scaling benchmark for SHA-256, from the repository root:
#
#   ./self_hosting/build/v2.exe packages/sha256/spec/bench.patlang packages/sha256/build/bench.exe --workers 2
#   ./packages/sha256/build/bench.exe
#
# For four doubling sizes: the oracle (spec/oracle.py) writes random data to
# packages/sha256/build/bench_N.bin; then, timed, the fastest of three
# one-shot hashes of the bytes in memory and of three file hashes. Each
# digest is checked against Python's, outside the timed part.
include "../../../self_hosting/lib/includes.patlang"
include "../sha256.patlang"

make a function called bench_py takes a, b, c returns out
  require value_class(a) == 8
  let o = "packages/sha256/spec/oracle.py"
  let raw = ""
  if c == "" then
    let raw = exec_capture("py", "-3", "-I", o, a, b)
  else
    let raw = exec_capture("py", "-3", "-I", o, a, b, c)
  end
  let out = str_trim(raw)
  ensure value_class(out) == 8
  return out
end

make a function called bench_one takes n returns line
  require n > 0
  let path = "packages/sha256/build/bench_" + n + ".bin"
  bench_py("gen", to_s(n), path)
  let want = bench_py("sha256", path, "")
  let data = read_file_bytes(path, 0, n)
  let best = 0 - 1
  let hex = ""
  let r = 0
  while r < 3 do
    let t0 = now_ms()
    let hex = sha256_hex(data)
    let ms = now_ms() - t0
    if (best < 0) or (ms < best) then
      let best = ms
    end
    let r = r + 1
  end
  let fbest = 0 - 1
  let fhex = ""
  let r = 0
  while r < 3 do
    let t0 = now_ms()
    let fhex = sha256_file_hex(path)
    let ms = now_ms() - t0
    if (fbest < 0) or (ms < fbest) then
      let fbest = ms
    end
    let r = r + 1
  end
  let b = sb_new()
  sb_push(b, to_s(n) + " bytes: one-shot " + best + " ms")
  if best > 0 then
    sb_push(b, " (" + floor(n * 1000 / (best * 1024)) + " KB/s)")
  end
  sb_push(b, ", file " + fbest + " ms")
  if (hex == want) and (fhex == want) then
    sb_push(b, ", digests match Python")
  else
    sb_push(b, ", CHECK FAILED (" + hex + " / " + fhex + " / " + want + ")")
  end
  let line = sb_str(b)
  ensure value_class(line) == 8
  return line
end

let sizes = [262144, 524288, 1048576, 2097152]
let s = 0
while s < list_len(sizes) do
  print(bench_one(sizes[s]))
  let s = s + 1
end
