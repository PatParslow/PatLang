# Runs packages/sha256/spec/sha256.feature, from the repository root:
#
#   ./self_hosting/build/v2.exe packages/sha256/spec/run_spec.patlang packages/sha256/build/run_spec.exe --workers 2
#   ./packages/sha256/build/run_spec.exe [feature file]
#
# Python's hashlib and hmac (spec/oracle.py, run as `py -3 -I`) and
# sha256sum are the references. Scratch files go to packages/sha256/build/.
# The exit code is 0 when every check passes, 1 otherwise.
include "../../../self_hosting/lib/includes.patlang"
include "../../../self_hosting/lib/gherkin.patlang"
include "../sha256.patlang"

make a function called sh_dir returns d
  let d = "packages/sha256/build/"
  ensure d.length > 0
  return d
end

make a function called sh_data_path returns p
  let p = sh_dir() + "data.bin"
  ensure p.length > 0
  return p
end

# One line from the oracle, trimmed.
make a function called sh_py takes a returns out
  require list_len(a) > 0
  # exec_capture's arguments are its call's own, so one call per count.
  let o = "packages/sha256/spec/oracle.py"
  let n = list_len(a)
  let raw = ""
  if n == 1 then
    let raw = exec_capture("py", "-3", "-I", o, a[0])
  elif n == 2 then
    let raw = exec_capture("py", "-3", "-I", o, a[0], a[1])
  else
    let raw = exec_capture("py", "-3", "-I", o, a[0], a[1], a[2])
  end
  let out = str_trim(raw)
  ensure value_class(out) == 8
  return out
end

# An ASCII text's bytes (the feature file is ASCII).
make a function called sh_text_bytes takes text returns bytes
  require value_class(text) == 8
  let out = []
  let i = 0
  while i < text.length do
    let out = list_push(out, char_code(text, i))
    let i = i + 1
  end
  let bytes = out
  ensure list_len(bytes) == text.length
  return bytes
end

make a function called sh_run_of takes n, b returns bytes
  require (n >= 0) and (b >= 0) and (b < 256)
  let out = []
  let i = 0
  while i < n do
    let out = list_push(out, b)
    let i = i + 1
  end
  let bytes = out
  ensure list_len(bytes) == n
  return bytes
end

# Space-separated decimal numbers.
make a function called sh_numbers takes text returns nums
  require value_class(text) == 8
  let out = []
  let cur = 0
  let have = false
  let i = 0
  while i < text.length do
    let c = char_code(text, i)
    if (c >= 48) and (c <= 57) then
      let cur = cur * 10 + (c - 48)
      let have = true
    else
      if have then
        let out = list_push(out, cur)
      end
      let cur = 0
      let have = false
    end
    let i = i + 1
  end
  if have then
    let out = list_push(out, cur)
  end
  let nums = out
  ensure value_class(nums) == 9
  return nums
end

make a function called sh_codes_text takes codes returns text
  require value_class(codes) == 9
  let b = sb_new()
  let i = 0
  while i < list_len(codes) do
    sb_push(b, chr(codes[i]))
    let i = i + 1
  end
  let text = sb_str(b)
  ensure value_class(text) == 8
  return text
end

make a function called sh_codes_csv takes codes returns text
  require value_class(codes) == 9
  let b = sb_new()
  let i = 0
  while i < list_len(codes) do
    if i > 0 then
      sb_push(b, ",")
    end
    sb_push(b, to_s(codes[i]))
    let i = i + 1
  end
  let text = sb_str(b)
  ensure value_class(text) == 8
  return text
end

# The bytes lo..hi-1 of a list.
make a function called sh_slice takes bytes, lo, hi returns out
  require (lo >= 0) and (lo <= hi) and (hi <= list_len(bytes))
  let r = []
  let i = lo
  while i < hi do
    let r = list_push(r, bytes[i])
    let i = i + 1
  end
  let out = r
  ensure list_len(out) == hi - lo
  return out
end

# The digest of bytes fed through update in the pieces that cuts (ascending
# offsets) makes, then the rest.
make a function called sh_pieces_hex takes bytes, cuts returns hex
  require (value_class(bytes) == 9) and (value_class(cuts) == 9)
  let h = sha256_new()
  let at = 0
  let i = 0
  while i < list_len(cuts) do
    sha256_update(h, sh_slice(bytes, at, cuts[i]))
    let at = cuts[i]
    let i = i + 1
  end
  sha256_update(h, sh_slice(bytes, at, list_len(bytes)))
  let hex = bytes_to_hex(sha256_finish(h))
  ensure value_class(hex) == 8
  return hex
end

# ---- steps ----

make a function called st_sh_text takes ctx returns ok
  ctx_set(ctx, "data", sh_text_bytes(step_arg(ctx, "text")))
  return true
end

make a function called st_sh_empty takes ctx returns ok
  ctx_set(ctx, "data", [])
  return true
end

make a function called st_sh_hex_bytes takes ctx returns ok
  ctx_set(ctx, "data", hex_to_bytes(step_arg(ctx, "hex")))
  return true
end

make a function called st_sh_run takes ctx returns ok
  ctx_set(ctx, "data", sh_run_of(to_num(step_arg(ctx, "n")), to_num(step_arg(ctx, "b"))))
  return true
end

make a function called st_sh_data takes ctx returns ok
  let n = step_arg(ctx, "n")
  let r = sh_py(["gen", n, sh_data_path()])
  ctx_set(ctx, "data", read_file_bytes(sh_data_path(), 0, to_num(n) + 1))
  return expect(ctx, "test data of " + n + " bytes", r + " " + list_len(ctx_get(ctx, "data")), "ok " + n + " " + n)
end

make a function called st_sh_key_text takes ctx returns ok
  ctx_set(ctx, "key", sh_text_bytes(step_arg(ctx, "text")))
  return true
end

make a function called st_sh_key_hex takes ctx returns ok
  ctx_set(ctx, "key", hex_to_bytes(step_arg(ctx, "hex")))
  return true
end

make a function called st_sh_key_run takes ctx returns ok
  ctx_set(ctx, "key", sh_run_of(to_num(step_arg(ctx, "n")), to_num(step_arg(ctx, "b"))))
  return true
end

make a function called st_sh_digest_is takes ctx returns ok
  return expect(ctx, "SHA-256", sha256_hex(ctx_get(ctx, "data")), step_arg(ctx, "hex"))
end

make a function called st_sh_digest_py takes ctx returns ok
  return expect(ctx, "SHA-256 of " + list_len(ctx_get(ctx, "data")) + " bytes as Python's", sha256_hex(ctx_get(ctx, "data")), sh_py(["sha256", sh_data_path()]))
end

make a function called st_sh_digest_shape takes ctx returns ok
  let d = sha256_bytes(ctx_get(ctx, "data"))
  let good = list_len(d) == 32
  let i = 0
  while i < list_len(d) do
    if (value_class(d[i]) != 2) or (d[i] < 0) or (d[i] > 255) then
      let good = false
    end
    let i = i + 1
  end
  return expect(ctx, "digest of " + list_len(d) + " bytes, each 0..255", good, true)
end

make a function called st_sh_pieces takes ctx returns ok
  let data = ctx_get(ctx, "data")
  let k = to_num(step_arg(ctx, "k"))
  let cuts = []
  let at = k
  while at < list_len(data) do
    let cuts = list_push(cuts, at)
    let at = at + k
  end
  return expect(ctx, "fed in pieces of " + k, sh_pieces_hex(data, cuts), sha256_hex(data))
end

make a function called st_sh_split takes ctx returns ok
  let data = ctx_get(ctx, "data")
  return expect(ctx, "fed in pieces split at " + step_arg(ctx, "list"), sh_pieces_hex(data, sh_numbers(step_arg(ctx, "list"))), sha256_hex(data))
end

make a function called st_sh_finished takes ctx returns ok
  let h = sha256_new()
  sha256_update(h, ctx_get(ctx, "data"))
  let first = bytes_to_hex(sha256_finish(h))
  let refused = sha256_update(h, [1, 2, 3])
  let again = bytes_to_hex(sha256_finish(h))
  let ok1 = expect(ctx, "update after finish returns false", refused, false)
  return expect(ctx, "finish again gives the same digest", again, first)
end

make a function called sh_file_hex takes path returns hex
  require value_class(path) == 8
  let r = sha256_file(path)
  let hex = "missing"
  if r[0] == "ok" then
    let hex = bytes_to_hex(r[1])
  end
  ensure value_class(hex) == 8
  return hex
end

make a function called st_sh_file_sum takes ctx returns ok
  # sha256sum prints "<hex> *<path>" or "<hex>  <path>": the first 64 characters.
  let line = str_trim(exec_capture("sha256sum", sh_data_path()))
  return expect(ctx, "file SHA-256 as sha256sum's", sh_file_hex(sh_data_path()), substr(line, 0, 64))
end

make a function called st_sh_file_py takes ctx returns ok
  return expect(ctx, "file SHA-256 as Python's", sh_file_hex(sh_data_path()), sh_py(["sha256", sh_data_path()]))
end

make a function called st_sh_file_one_shot takes ctx returns ok
  return expect(ctx, "file SHA-256 as the one-shot", sh_file_hex(sh_data_path()), sha256_hex(ctx_get(ctx, "data")))
end

make a function called st_sh_file_named takes ctx returns ok
  return expect(ctx, "file SHA-256 of " + step_arg(ctx, "path"), sh_file_hex(step_arg(ctx, "path")), step_arg(ctx, "hex"))
end

make a function called st_sh_string_py takes ctx returns ok
  let codes = sh_numbers(step_arg(ctx, "list"))
  let got = bytes_to_hex(sha256_string(sh_codes_text(codes)))
  return expect(ctx, "SHA-256 of the string of codes " + step_arg(ctx, "list"), got, sh_py(["utf8", sh_codes_csv(codes)]))
end

make a function called st_sh_utf8_widths takes ctx returns ok
  let codes = sh_numbers(step_arg(ctx, "list"))
  let b = sb_new()
  let i = 0
  while i < list_len(codes) do
    if i > 0 then
      sb_push(b, " ")
    end
    sb_push(b, to_s(list_len(utf8_encode(chr(codes[i])))))
    let i = i + 1
  end
  return expect(ctx, "UTF-8 widths of " + step_arg(ctx, "list"), sb_str(b), step_arg(ctx, "widths"))
end

make a function called st_sh_hmac_is takes ctx returns ok
  return expect(ctx, "HMAC-SHA-256", bytes_to_hex(hmac_sha256(ctx_get(ctx, "key"), ctx_get(ctx, "data"))), step_arg(ctx, "hex"))
end

make a function called st_sh_hmac_py takes ctx returns ok
  let key = ctx_get(ctx, "key")
  let data = ctx_get(ctx, "data")
  return expect(ctx, "HMAC-SHA-256 as Python's", bytes_to_hex(hmac_sha256(key, data)), sh_py(["hmac", bytes_to_hex(key), bytes_to_hex(data)]))
end

make a function called st_sh_lower_hex takes ctx returns ok
  return expect(ctx, "hex", bytes_to_hex(ctx_get(ctx, "data")), step_arg(ctx, "hex"))
end

# The first matching pattern wins, so the "the key is" steps come before
# the bare "{n} bytes each {b}".
make a function called register_sha256_steps takes ctx returns ok
  step(ctx, "the key is the text \"{text}\"", "st_sh_key_text")
  step(ctx, "the key is the hex bytes \"{hex}\"", "st_sh_key_hex")
  step(ctx, "the key is {n} bytes each {b}", "st_sh_key_run")
  # A placeholder does not match an empty text, so "" is a step of its own.
  step(ctx, "the text \"\"", "st_sh_empty")
  step(ctx, "the text \"{text}\"", "st_sh_text")
  step(ctx, "the hex bytes \"{hex}\"", "st_sh_hex_bytes")
  step(ctx, "test data of {n} bytes", "st_sh_data")
  step(ctx, "{n} bytes each {b}", "st_sh_run")
  step(ctx, "its SHA-256 is \"{hex}\"", "st_sh_digest_is")
  step(ctx, "its SHA-256 is the one Python's hashlib gives", "st_sh_digest_py")
  step(ctx, "its digest has 32 bytes, each from 0 to 255", "st_sh_digest_shape")
  step(ctx, "fed in pieces of {k} bytes its SHA-256 is the one-shot digest", "st_sh_pieces")
  step(ctx, "fed in pieces split at {list} its SHA-256 is the one-shot digest", "st_sh_split")
  step(ctx, "updating a finished hash is refused", "st_sh_finished")
  step(ctx, "its file SHA-256 is the one sha256sum gives", "st_sh_file_sum")
  step(ctx, "its file SHA-256 is the one Python's hashlib gives", "st_sh_file_py")
  step(ctx, "its file SHA-256 is its one-shot SHA-256", "st_sh_file_one_shot")
  step(ctx, "the file SHA-256 of \"{path}\" is \"{hex}\"", "st_sh_file_named")
  step(ctx, "the SHA-256 of the string of character codes {list} is the one Python's hashlib gives", "st_sh_string_py")
  step(ctx, "the string of character codes {list} encodes to {widths} bytes", "st_sh_utf8_widths")
  step(ctx, "its HMAC-SHA-256 is \"{hex}\"", "st_sh_hmac_is")
  step(ctx, "its HMAC-SHA-256 is the one Python's hmac gives", "st_sh_hmac_py")
  step(ctx, "its lowercase hex is \"{hex}\"", "st_sh_lower_hex")
  return true
end

let ctx = ctx_new()
register_sha256_steps(ctx)
let only = argv()
if list_len(only) > 0 then
  run_feature_file(ctx, only[0])
else
  run_feature_file(ctx, "packages/sha256/spec/sha256.feature")
end
if not ctx_report(ctx) then
  exit_with(1)
end
