# Byte and text conversions the sha256 package uses and offers.
#
#   bytes_to_hex(bytes)  -> two lowercase hex digits a byte
#   hex_to_bytes(text)   -> the bytes of an even-length hex text (either
#                           case); false when the text is not valid hex
#   utf8_encode(text)    -> a String's UTF-8 bytes
#   digest_equal(a, b)   -> true when two byte lists are equal, looking at
#                           every byte whatever the first difference
#
# PatLang has no built-in that gives a String's UTF-8 bytes, so utf8_encode
# encodes its character codes. It walks the string through the runtime's
# string cursor (str_intern / sc_code), which is O(1) a character for an
# ASCII string and a single O(n) decode for any other, so encoding is O(n)
# either way (char_code on a non-ASCII string is O(i) a call).

make a function called sha256_hex_digit takes n returns c
  require (n >= 0) and (n < 16)
  let c = chr(48 + n)
  if n >= 10 then
    let c = chr(87 + n)
  end
  ensure c.length == 1
  return c
end

make a function called bytes_to_hex takes bytes returns hex
  require value_class(bytes) == 9
  let b = sb_new()
  let i = 0
  while i < list_len(bytes) do
    let x = bytes[i]
    sb_push(b, sha256_hex_digit((x shr 4) band 15))
    sb_push(b, sha256_hex_digit(x band 15))
    let i = i + 1
  end
  let hex = sb_str(b)
  ensure hex.length == 2 * list_len(bytes)
  return hex
end

# A hex digit's value, or -1.
make a function called sha256_hex_value takes c returns v
  require value_class(c) == 2
  let v = 0 - 1
  if (c >= 48) and (c <= 57) then
    let v = c - 48
  elif (c >= 97) and (c <= 102) then
    let v = c - 87
  elif (c >= 65) and (c <= 70) then
    let v = c - 55
  end
  ensure (v >= 0 - 1) and (v < 16)
  return v
end

make a function called hex_to_bytes takes text returns bytes
  require value_class(text) == 8
  let cur = str_intern(text)
  let n = sc_len(cur)
  if (n % 2) != 0 then
    let bytes = false
    ensure bytes == false
    return bytes
  end
  let out = []
  let i = 0
  while i < n do
    let hi = sha256_hex_value(sc_code(cur, i))
    let lo = sha256_hex_value(sc_code(cur, i + 1))
    if (hi < 0) or (lo < 0) then
      let bytes = false
      ensure bytes == false
      return bytes
    end
    let out = list_push(out, (hi shl 4) bor lo)
    let i = i + 2
  end
  let bytes = out
  ensure list_len(bytes) == (n shr 1)
  return bytes
end

make a function called utf8_encode takes text returns bytes
  require value_class(text) == 8
  # A string is held as its UTF-8 bytes (spec 1.10), copied out whole: a
  # quarter of the cost of encoding it a character at a time.
  let bytes = bytes_to_list(bytes_from_str(text))
  ensure list_len(bytes) == str_len(text)
  return bytes
end

make a function called digest_equal takes a, b returns same
  require (value_class(a) == 9) and (value_class(b) == 9)
  if list_len(a) != list_len(b) then
    let same = false
    ensure same == false
    return same
  end
  let diff = 0
  let i = 0
  while i < list_len(a) do
    let diff = diff bor (a[i] bxor b[i])
    let i = i + 1
  end
  let same = diff == 0
  ensure value_class(same) == 1
  return same
end
