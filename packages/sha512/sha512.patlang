# SHA-512 (FIPS 180-4) on 64-bit words, each a modint modulo 2^64 (spec 1.14).
# A message is a list of bytes, each a modint modulo 256, and so is a digest:
# the words and the bytes are secret, and only the message's length decides
# how many steps the hash takes.

make a function called sha512_k returns ks
  let ks = [4794697086780616226, 8158064640168781261, 13096744586834688815, 16840607885511220156, 4131703408338449720, 6480981068601479193, 10538285296894168987, 12329834152419229976, 15566598209576043074, 1334009975649890238, 2608012711638119052, 6128411473006802146, 8268148722764581231, 9286055187155687089, 11230858885718282805, 13951009754708518548, 16472876342353939154, 17275323862435702243, 1135362057144423861, 2597628984639134821, 3308224258029322869, 5365058923640841347, 6679025012923562964, 8573033837759648693, 10970295158949994411, 12119686244451234320, 12683024718118986047, 13788192230050041572, 14330467153632333762, 15395433587784984357, 489312712824947311, 1452737877330783856, 2861767655752347644, 3322285676063803686, 5560940570517711597, 5996557281743188959, 7280758554555802590, 8532644243296465576, 9350256976987008742, 10552545826968843579, 11727347734174303076, 12113106623233404929, 14000437183269869457, 14369950271660146224, 15101387698204529176, 15463397548674623760, 17586052441742319658, 1182934255886127544, 1847814050463011016, 2177327727835720531, 2830643537854262169, 3796741975233480872, 4115178125766777443, 5681478168544905931, 6601373596472566643, 7507060721942968483, 8399075790359081724, 8693463985226723168, 9568029438360202098, 10144078919501101548, 10430055236837252648, 11840083180663258601, 13761210420658862357, 14299343276471374635, 14566680578165727644, 15097957966210449927, 16922976911328602910, 17689382322260857208, 500013540394364858, 748580250866718886, 1242879168328830382, 1977374033974150939, 2944078676154940804, 3659926193048069267, 4368137639120453308, 4836135668995329356, 5532061633213252278, 6448918945643986474, 6902733635092675308, 7801388544844847127]
  ensure list_len(ks) == 80
  return ks
end

make a function called sha512_word takes x returns w
  require (type_of(x) == "int") or (type_of(x) == "bigint") or (type_of(x) == "modint")
  let w = mod_make(x, 18446744073709551616)
  ensure mod_modulus(w) == 18446744073709551616
  return w
end

make a function called sha512_byte takes x returns b
  require (type_of(x) == "int") or (type_of(x) == "bigint") or (type_of(x) == "modint")
  let b = mod_make(x, 256)
  ensure mod_modulus(b) == 256
  return b
end

# The message's bytes, padded to a whole number of 128-byte blocks: a 1 bit,
# zeros, and the length in bits as a 128-bit number.
make a function called sha512_pad takes bytes returns padded
  require type_of(bytes) == "list"
  let n = list_len(bytes)
  let padded = vec_new()
  let i = 0
  while i < n do
    vec_push(padded, bytes[i])
    let i = i + 1
  end
  vec_push(padded, sha512_byte(128))
  while vec_len(padded) % 128 != 112 do
    vec_push(padded, sha512_byte(0))
  end
  let bits = n * 8
  let shift = 120
  while shift >= 0 do
    # a message is far shorter than 2^64 bits, so the top eight bytes are 0
    if shift >= 64 then
      vec_push(padded, sha512_byte(0))
    else
      vec_push(padded, sha512_byte((bits shr shift) band 255))
    end
    let shift = shift - 8
  end
  ensure vec_len(padded) % 128 == 0
  return padded
end

# Element i of a list or vec of words, made a word modulo the modulus of shape:
# the check knows an element only as some value, and mod_make settles that it
# is a modint before any arithmetic picks an operation by its class.
make a function called sha512_at takes words, i, shape returns w
  require (i >= 0) and (mod_modulus(shape) == 18446744073709551616)
  if type_of(words) == "list" then
    let w = mod_make(words[i], shape)
  else
    let w = mod_make(vec_get(words, i), shape)
  end
  ensure mod_modulus(w) == 18446744073709551616
  return w
end

# The big-endian word of the eight bytes from at, made modulo the modulus of
# the word shape.
make a function called sha512_load takes padded, at, shape returns w
  require (at >= 0) and (at + 8 <= vec_len(padded)) and (mod_modulus(shape) == 18446744073709551616)
  let w = mod_make(vec_get(padded, at), shape)
  let j = 1
  while j < 8 do
    let w = (w shl 8) bor mod_make(vec_get(padded, at + j), shape)
    let j = j + 1
  end
  ensure mod_modulus(w) == 18446744073709551616
  return w
end

make a function called sha512 takes bytes returns digest
  require type_of(bytes) == "list"
  let ks = sha512_k()
  let h = [7640891576956012808, 13503953896175478587, 4354685564936845355, 11912009170470909681, 5840696475078001361, 11170449401992604703, 2270897969802886507, 6620516959819538809]
  let hw = []
  let i = 0
  while i < 8 do
    let hw = list_push(hw, sha512_word(h[i]))
    let i = i + 1
  end
  let padded = sha512_pad(bytes)
  let shape = sha512_word(0)
  let block = 0
  while block < vec_len(padded) do
    let w = vec_new()
    let t = 0
    while t < 16 do
      vec_push(w, sha512_load(padded, block + 8 * t, shape))
      let t = t + 1
    end
    while t < 80 do
      let x = sha512_at(w, t - 15, shape)
      let y = sha512_at(w, t - 2, shape)
      let s0 = rotr(x, 1) bxor rotr(x, 8) bxor (x shr 7)
      let s1 = rotr(y, 19) bxor rotr(y, 61) bxor (y shr 6)
      vec_push(w, sha512_at(w, t - 16, shape) + s0 + sha512_at(w, t - 7, shape) + s1)
      let t = t + 1
    end
    let a = sha512_at(hw, 0, shape)
    let b = sha512_at(hw, 1, shape)
    let c = sha512_at(hw, 2, shape)
    let d = sha512_at(hw, 3, shape)
    let e = sha512_at(hw, 4, shape)
    let f = sha512_at(hw, 5, shape)
    let g = sha512_at(hw, 6, shape)
    let hh = sha512_at(hw, 7, shape)
    let t = 0
    while t < 80 do
      let big1 = rotr(e, 14) bxor rotr(e, 18) bxor rotr(e, 41)
      let ch = (e band f) bxor ((bnot e) band g)
      let t1 = hh + big1 + ch + sha512_at(ks, t, shape) + sha512_at(w, t, shape)
      let big0 = rotr(a, 28) bxor rotr(a, 34) bxor rotr(a, 39)
      let maj = (a band b) bxor (a band c) bxor (b band c)
      let t2 = big0 + maj
      let hh = g
      let g = f
      let f = e
      let e = d + t1
      let d = c
      let c = b
      let b = a
      let a = t1 + t2
      let t = t + 1
    end
    let hw = [sha512_at(hw, 0, shape) + a, sha512_at(hw, 1, shape) + b, sha512_at(hw, 2, shape) + c, sha512_at(hw, 3, shape) + d, sha512_at(hw, 4, shape) + e, sha512_at(hw, 5, shape) + f, sha512_at(hw, 6, shape) + g, sha512_at(hw, 7, shape) + hh]
    let block = block + 128
  end
  let byte = sha512_byte(0)
  let digest = []
  let i = 0
  while i < 8 do
    let shift = 56
    while shift >= 0 do
      let digest = list_push(digest, mod_make(sha512_at(hw, i, shape) shr shift, byte))
      let shift = shift - 8
    end
    let i = i + 1
  end
  ensure list_len(digest) == 64
  return digest
end
