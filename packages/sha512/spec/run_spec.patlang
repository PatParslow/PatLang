# Runs packages/sha512/spec/sha512.feature, from the repository root:
#
#   ./self_hosting/build/v2_interp.exe packages/sha512/spec/run_spec.patlang [feature file]
#
# The vectors are FIPS 180-4's. The exit code is 0 when every check passes,
# 1 otherwise.
include "../../../self_hosting/lib/includes.patlang"
include "../../../self_hosting/lib/gherkin.patlang"
include "../sha512.patlang"

# An ASCII text's bytes, each a modint modulo 256.
make a function called s5_text_bytes takes text returns bytes
  require value_class(text) == 8
  let bytes = []
  let i = 0
  while i < text.length do
    let bytes = list_push(bytes, sha512_byte(char_code(text, i)))
    let i = i + 1
  end
  ensure list_len(bytes) == text.length
  return bytes
end

# Lowercase hex of bytes that are modints modulo 256 (their values are
# public here: the vectors are known answers).
make a function called s5_hex takes bytes returns text
  require type_of(bytes) == "list"
  let digits = "0123456789abcdef"
  let b = sb_new()
  let i = 0
  while i < list_len(bytes) do
    let v = mod_value(bytes[i])
    sb_push(b, digits[v shr 4])
    sb_push(b, digits[v band 15])
    let i = i + 1
  end
  let text = sb_str(b)
  ensure text.length == 2 * list_len(bytes)
  return text
end

make a function called st_s5_text takes ctx returns ok
  ctx_set(ctx, "data", s5_text_bytes(step_arg(ctx, "text")))
  return true
end

make a function called st_s5_empty takes ctx returns ok
  ctx_set(ctx, "data", [])
  return true
end

make a function called st_s5_digest_is takes ctx returns ok
  return expect(ctx, "SHA-512", s5_hex(sha512(ctx_get(ctx, "data"))), step_arg(ctx, "hex"))
end

make a function called st_s5_384_is takes ctx returns ok
  return expect(ctx, "SHA-384", s5_hex(sha384(ctx_get(ctx, "data"))), step_arg(ctx, "hex"))
end

make a function called st_s5_shape takes ctx returns ok
  let d = sha512(ctx_get(ctx, "data"))
  let good = list_len(d) == 64
  let i = 0
  while i < list_len(d) do
    if (type_of(d[i]) != "modint") or (mod_modulus(d[i]) != 256) then
      let good = false
    end
    let i = i + 1
  end
  return expect(ctx, "a digest of " + list_len(d) + " bytes, each a modint modulo 256", good, true)
end

make a function called register_sha512_steps takes ctx returns ok
  step(ctx, "the empty text", "st_s5_empty")
  step(ctx, "the text \"{text}\"", "st_s5_text")
  step(ctx, "its SHA-512 is \"{hex}\"", "st_s5_digest_is")
  step(ctx, "its SHA-384 is \"{hex}\"", "st_s5_384_is")
  step(ctx, "its digest has 64 bytes, each a modint modulo 256", "st_s5_shape")
  return true
end

let ctx = ctx_new()
register_sha512_steps(ctx)
# --list names the feature files (the gates run each); a failure exits 1
run_suite(ctx, ["packages/sha512/spec/sha512.feature"], argv())
