# text_structure Gherkin: a feature file's units.
#
# Feature (level 1), Rule (2), Background, Scenario, Scenario Outline and
# Scenario Template, Example (3) and Examples or Scenarios (4) are headings, so
# each starts a section of its level, titled by what follows its keyword, the
# keyword and the tags above it in the heading's attrs. A step (Given, When,
# Then, And, But, *) is a "step" with its keyword and its text; a doc string
# (between lines of """ or ```) is "code", a run of | lines a "table", a line
# starting with # a "comment", and description lines paragraphs, with their
# sentences.
#
#   let tree = ts_gherkin(ts_structurer(), bytes)
include "structure.patlang"

make a function called tg_starts takes text, t, word returns yes
  let w = bytes_from_str(word)
  let n = bytes_len(w)
  if t[1] - t[0] < n then
    return false
  end
  let k = 0
  while k < n do
    if bytes_get(text, t[0] + k) != bytes_get(w, k) then
      return false
    end
    let k = k + 1
  end
  return true
end

# a heading's [keyword, level], or false
make a function called tg_heading_kind takes text, t returns hk
  let kinds = [["Scenario Outline:", 3], ["Scenario Template:", 3], ["Feature:", 1], ["Rule:", 2], ["Background:", 3], ["Scenario:", 3], ["Example:", 3], ["Examples:", 4], ["Scenarios:", 4]]
  let k = 0
  while k < list_len(kinds) do
    if tg_starts(text, t, kinds[k][0]) then
      return kinds[k]
    end
    let k = k + 1
  end
  return false
end

# a step's keyword, or false
make a function called tg_step_kind takes text, t returns kw
  let kws = ["Given ", "When ", "Then ", "And ", "But ", "* "]
  let k = 0
  while k < list_len(kws) do
    if tg_starts(text, t, kws[k]) then
      return ts_line_text(text, [t[0], t[0] + bytes_len(bytes_from_str(kws[k])) - 1])
    end
    let k = k + 1
  end
  return false
end

# whether a line opens or closes a doc string
make a function called tg_doc_fence takes text, t returns yes
  return tg_starts(text, t, chr(34) + chr(34) + chr(34)) or tg_starts(text, t, chr(96) + chr(96) + chr(96))
end

make a function called ts_gherkin takes st, text returns tree
  let nested = ts_nest(gherkin_blocks(st, text, ts_lines(text)), 0, 0, bytes_len(text))
  return ts_unit("document", 0, bytes_len(text), [["format", "gherkin"]], nested[0])
end

# The blocks of some of a feature file's lines.
make a function called gherkin_blocks takes st, text, lines returns blocks
  let n = list_len(lines)
  let blocks = []
  let run = []
  let tags = ""
  let i = 0
  while i < n do
    let line = lines[i]
    let t = ts_trim_line(text, line)
    let hk = tg_heading_kind(text, t)
    let kw = tg_step_kind(text, t)
    let other = (t[0] == t[1]) or (hk != false) or (kw != false) or tg_doc_fence(text, t) or tg_starts(text, t, "|") or tg_starts(text, t, "#") or tg_starts(text, t, "@")
    # tags are the next heading's only with nothing but blank lines,
    # comments and more tags between: any other line drops them
    if (t[0] != t[1]) and (hk == false) and (not tg_starts(text, t, "#")) and (not tg_starts(text, t, "@")) then
      let tags = ""
    end
    if other and (list_len(run) > 0) then
      let blocks = list_push(blocks, ts_paragraph(st, text, run, "paragraph"))
      let run = []
    end
    if t[0] == t[1] then
      let i = i + 1
    elif hk != false then
      let title_at = t[0] + bytes_len(bytes_from_str(hk[0]))
      let blocks = list_push(blocks, ts_unit("heading", t[0], t[1], [["title", ts_line_text(text, [title_at, t[1]])], ["level", hk[1]], ["keyword", ts_line_text(text, [t[0], title_at - 1])], ["tags", tags]], []))
      let tags = ""
      let i = i + 1
    elif kw != false then
      let blocks = list_push(blocks, ts_unit("step", t[0], t[1], [["keyword", kw], ["text", ts_line_text(text, [t[0] + bytes_len(bytes_from_str(kw)) + 1, t[1]])]], []))
      let i = i + 1
    elif tg_doc_fence(text, t) then
      let j = i + 1
      while (j < n) and (not tg_doc_fence(text, ts_trim_line(text, lines[j]))) do
        let j = j + 1
      end
      let last = j
      if last >= n then
        let last = n - 1
      end
      let blocks = list_push(blocks, ts_unit("code", t[0], ts_trim_line(text, lines[last])[1], [["lang", ""]], []))
      let i = last + 1
    elif tg_starts(text, t, "|") then
      let j = i
      while (j < n) and tg_starts(text, ts_trim_line(text, lines[j]), "|") do
        let j = j + 1
      end
      let blocks = list_push(blocks, ts_unit("table", t[0], ts_trim_line(text, lines[j - 1])[1], [], []))
      let i = j
    elif tg_starts(text, t, "#") then
      let blocks = list_push(blocks, ts_unit("comment", t[0], t[1], [], []))
      let i = i + 1
    elif tg_starts(text, t, "@") then
      # the tags belong to the heading after them, in its attrs: a unit of
      # their own would fall in the section before
      let tags = ts_line_text(text, t)
      let i = i + 1
    else
      let run = list_push(run, line)
      let i = i + 1
    end
  end
  if list_len(run) > 0 then
    let blocks = list_push(blocks, ts_paragraph(st, text, run, "paragraph"))
  end
  return blocks
end
