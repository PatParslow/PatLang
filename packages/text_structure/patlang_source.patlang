# text_structure PatLang source: a program's units.
#
# A comment line "# ---- name ----" is a heading (level 2), so the program's
# own section comments make sections. "make a function called NAME" up to the
# "end" at its own indentation is a "function" titled NAME; "class NAME {" up
# to the "}" at its indentation a "class" titled NAME; a run of other comment
# lines a "comment" whose sentences are the comment's text without its #s; any
# other line at the top a "statement". A function or class whose end does not
# come is "open" in its attrs and runs to the last line read, so ts_update reads
# on to the text's end when it meets one (an end added or taken away changes
# everything after it).
#
#   let tree = ts_patlang(ts_structurer(), bytes)
include "structure.patlang"

make a function called tp_starts takes text, t, word returns yes
  let w = bytes_from_str(word)
  let n = bytes_len(w)
  if t[1] - t[0] < n then
    return false
  end
  let k = 0
  while k < n do
    if bytes_get(text, t[0] + k) != bytes_get(w, k) then
      return false
    end
    let k = k + 1
  end
  return true
end

make a function called tp_is takes text, t, word returns yes
  return (t[1] - t[0] == bytes_len(bytes_from_str(word))) and tp_starts(text, t, word)
end

# the name after a prefix, up to a space, a { or the line's end
make a function called tp_name_after takes text, t, prefix returns name
  let a = t[0] + bytes_len(bytes_from_str(prefix))
  let b = a
  while (b < t[1]) and (bytes_get(text, b) != 32) and (bytes_get(text, b) != 123) do
    let b = b + 1
  end
  return bytes_to_str(bytes_slice(text, a, b - a))
end

# a "# ---- name ----" line's name, or false
make a function called tp_section_title takes text, t returns title
  if not tp_starts(text, t, "# ----") then
    return false
  end
  let b = t[1]
  while (b > t[0]) and ((bytes_get(text, b - 1) == 45) or (bytes_get(text, b - 1) == 32)) do
    let b = b - 1
  end
  let a = t[0] + 6
  if b <= a then
    return ""
  end
  return ts_line_text(text, [a, b])
end

# the line where a block opened at indent i ends (a line closing at that
# indent), or -1
make a function called tp_close takes text, lines, from, indent, word returns at
  let j = from
  while j < list_len(lines) do
    let t = ts_trim_line(text, lines[j])
    if (ts_indent(text, lines[j]) == indent) and tp_is(text, t, word) then
      return j
    end
    let j = j + 1
  end
  return 0 - 1
end

# a comment's text view: each line without its # and one space after it
make a function called tp_comment_view takes text, run returns view
  let view = []
  let k = 0
  while k < list_len(run) do
    let t = ts_trim_line(text, run[k])
    let a = t[0] + 1
    if (a < t[1]) and (bytes_get(text, a) == 32) then
      let a = a + 1
    end
    if a < t[1] then
      let view = list_push(view, [a, t[1]])
    end
    let k = k + 1
  end
  return view
end

make a function called ts_patlang takes st, text returns tree
  let nested = ts_nest(patlang_blocks(st, text, ts_lines(text)), 0, 0, bytes_len(text))
  return ts_unit("document", 0, bytes_len(text), [["format", "patlang"]], nested[0])
end

make a function called patlang_blocks takes st, text, lines returns blocks
  let n = list_len(lines)
  let blocks = []
  let run = []
  let i = 0
  while i <= n do
    let t = [0, 0]
    let plain_comment = false
    if i < n then
      let t = ts_trim_line(text, lines[i])
      let plain_comment = tp_starts(text, t, "#") and (tp_section_title(text, t) == false)
    end
    if (list_len(run) > 0) and (not plain_comment) then
      let first = ts_trim_line(text, run[0])
      let last = ts_trim_line(text, run[list_len(run) - 1])
      let blocks = list_push(blocks, ts_unit("comment", first[0], last[1], [], ts_sentences(st, text, tp_comment_view(text, run))))
      let run = []
    end
    if i == n then
      let i = i + 1
    elif t[0] == t[1] then
      let i = i + 1
    elif plain_comment then
      let run = list_push(run, lines[i])
      let i = i + 1
    elif tp_section_title(text, t) != false then
      let blocks = list_push(blocks, ts_unit("heading", t[0], t[1], [["title", tp_section_title(text, t)], ["level", 2]], []))
      let i = i + 1
    elif tp_starts(text, t, "make a function called ") or tp_starts(text, t, "class ") then
      let is_class = tp_starts(text, t, "class ")
      let kind = "function"
      let name = ""
      let word = "end"
      if is_class then
        let kind = "class"
        let name = tp_name_after(text, t, "class ")
        let word = "}"
      else
        let name = tp_name_after(text, t, "make a function called ")
      end
      let closing = tp_close(text, lines, i + 1, ts_indent(text, lines[i]), word)
      let open = closing < 0
      let last = closing
      if open then
        let last = n - 1
      end
      let lt = ts_trim_line(text, lines[last])
      let blocks = list_push(blocks, ts_unit(kind, t[0], lt[1], [["title", name], ["open", open]], []))
      let i = last + 1
    else
      let blocks = list_push(blocks, ts_unit("statement", t[0], t[1], [], []))
      let i = i + 1
    end
  end
  return blocks
end
