# text_structure plain text: paragraphs at blank lines, and sections where a
# line is underlined with = (a title, level 1) or - (level 2), each line of at
# least 3 of them. A text with no titles is one section's worth of paragraphs
# in the document itself.
#
#   let st = ts_structurer()
#   let tree = ts_plain(st, bytes)
include "structure.patlang"

make a function called ts_plain takes st, text returns tree
  let nested = ts_nest(plain_blocks(st, text, ts_lines(text)), 0, 0, bytes_len(text))
  return ts_unit("document", 0, bytes_len(text), [["format", "plain"]], nested[0])
end

# The blocks of some of a text's lines: titles (as headings) and paragraphs.
make a function called plain_blocks takes st, text, lines returns blocks
  let blocks = []
  let run = []
  let i = 0
  while i <= list_len(lines) do
    let end_run = false
    let heading = false
    if i == list_len(lines) then
      let end_run = true
    elif ts_blank(text, lines[i]) then
      let end_run = true
    elif (list_len(run) == 1) and (ts_rule_of(text, lines[i], 61) or ts_rule_of(text, lines[i], 45)) then
      let heading = true
    end
    if heading then
      let level = 2
      if ts_rule_of(text, lines[i], 61) then
        let level = 1
      end
      let title_line = run[0]
      let t = ts_trim_line(text, title_line)
      let blocks = list_push(blocks, ts_unit("heading", t[0], lines[i][1], [["title", ts_line_text(text, title_line)], ["level", level]], []))
      let run = []
    elif end_run then
      if list_len(run) > 0 then
        let blocks = list_push(blocks, ts_paragraph(st, text, run, "paragraph"))
      end
      let run = []
    else
      let run = list_push(run, lines[i])
    end
    let i = i + 1
  end
  return blocks
end
