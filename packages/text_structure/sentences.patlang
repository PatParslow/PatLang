# text_structure sentences: Unicode's sentence boundaries (UAX #29, section 5,
# Unicode 18.0), over Sentence_Break values from Unicode's data
# (sentence_table.patlang, made from data/SentenceBreakProperty.txt).
#
#   let seg = ts_segmenter()            the table, made once
#   ts_sentence_breaks(seg, cps)        the break positions in a list of code
#                                       points, 0 and its length among them
#
# The rules are SB1 to SB998 as the standard gives them. SB5 (Extend and
# Format are ignored, except after the start, a paragraph separator, or within
# CR LF) is applied by reading each rule's characters as their bases: an
# Extend or Format character belongs to the character before it, unless that
# is a paragraph separator or there is none, when it stands alone. The test
# that this is right is Unicode's own, data/SentenceBreakTest.txt, every line.
include "sentence_table.patlang"

class Segmenter {
  field ranges = []
}

make a function called ts_segmenter returns seg
  let seg = new("Segmenter")
  seg.ranges = ts_sb_ranges()
  return seg
end

# the classes, by number (as ts_sb_class_names lists them)
make a function called sb_other returns c
  return 0
end
make a function called sb_cr returns c
  return 1
end
make a function called sb_lf returns c
  return 2
end
make a function called sb_extend returns c
  return 3
end
make a function called sb_sep returns c
  return 4
end
make a function called sb_format returns c
  return 5
end
make a function called sb_sp returns c
  return 6
end
make a function called sb_lower returns c
  return 7
end
make a function called sb_upper returns c
  return 8
end
make a function called sb_oletter returns c
  return 9
end
make a function called sb_numeric returns c
  return 10
end
make a function called sb_aterm returns c
  return 11
end
make a function called sb_scontinue returns c
  return 12
end
make a function called sb_sterm returns c
  return 13
end
make a function called sb_close returns c
  return 14
end

# a code point's class: a bisection over the ranges
make a function called ts_sb_class takes seg, cp returns c
  return ts_sb_class_in(seg.ranges, cp)
end

# the same over the ranges list itself, for a loop that reads the field once
make a function called ts_sb_class_in takes r, cp returns c
  let lo = 0
  let hi = list_len(r) / 3 - 1
  while lo <= hi do
    let mid = word_shr(lo + hi, 1)
    let a = r[mid * 3]
    if cp < a then
      let hi = mid - 1
    elif cp > r[mid * 3 + 1] then
      let lo = mid + 1
    else
      return r[mid * 3 + 2]
    end
  end
  return 0
end

# The code points of UTF-8 bytes, and where each starts: [cps, offsets], the
# offsets one longer, ending with the bytes' length. A byte that does not start
# a well-formed sequence is U+FFFD on its own.
make a function called ts_decode takes b returns got
  let n = bytes_len(b)
  let cps = []
  let offs = []
  let i = 0
  while i < n do
    let c = bytes_get(b, i)
    let len = 1
    let cp = 65533
    if c < 128 then
      let cp = c
    elif (c >= 194) and (c <= 223) then
      let len = 2
      let cp = c - 192
    elif (c >= 224) and (c <= 239) then
      let len = 3
      let cp = c - 224
    elif (c >= 240) and (c <= 244) then
      let len = 4
      let cp = c - 240
    end
    if len > 1 then
      let ok = i + len <= n
      let k = 1
      while ok and (k < len) do
        let d = bytes_get(b, i + k)
        if (d < 128) or (d > 191) then
          let ok = false
        else
          let cp = cp * 64 + d - 128
        end
        let k = k + 1
      end
      if (not ok) or ((len == 3) and (cp < 2048)) or ((len == 4) and ((cp < 65536) or (cp > 1114111))) or ((cp >= 55296) and (cp <= 57343)) then
        let cp = 65533
        let len = 1
      end
    end
    let cps = list_push(cps, cp)
    let offs = list_push(offs, i)
    let i = i + len
  end
  let offs = list_push(offs, n)
  return [cps, offs]
end

make a function called ts_classes takes seg, cps returns cls
  let r = seg.ranges
  let out = []
  let k = 0
  while k < list_len(cps) do
    let out = list_push(out, ts_sb_class_in(r, cps[k]))
    let k = k + 1
  end
  return out
end

make a function called sb_parasep takes c returns yes
  return (c == 4) or (c == 1) or (c == 2)
end

make a function called sb_ignorable takes c returns yes
  return (c == 3) or (c == 5)
end

# The base of the character at j: j itself, or, for an Extend or Format that
# belongs to the character before it, that character. -1 before the start.
make a function called sb_base takes cls, j returns b
  let k = j
  while (k > 0) and sb_ignorable(cls[k]) do
    if sb_parasep(cls[k - 1]) then
      return k
    end
    let k = k - 1
  end
  return k
end

# The base of the character before the base at j: -1 at the start.
make a function called sb_prev takes cls, j returns b
  if j <= 0 then
    return 0 - 1
  end
  return sb_base(cls, j - 1)
end

# The next character after j that is not an Extend or Format belonging to the
# one before it: its index, or the length at the end.
make a function called sb_next takes cls, j returns k
  let n = list_len(cls)
  let k = j + 1
  while (k < n) and sb_ignorable(cls[k]) and (not sb_parasep(cls[k - 1])) do
    let k = k + 1
  end
  return k
end

# Reading left from the base at j over Sp* (when sp allows them) and then
# Close*: the class of the character there, if it is ATerm or STerm, else -1.
make a function called sb_term_before takes cls, j, sp returns t
  let k = j
  if sp then
    while (k >= 0) and (cls[k] == 6) do
      let k = sb_prev(cls, k)
    end
  end
  while (k >= 0) and (cls[k] == 14) do
    let k = sb_prev(cls, k)
  end
  if k < 0 then
    return 0 - 1
  end
  if (cls[k] == 11) or (cls[k] == 13) then
    return cls[k]
  end
  return 0 - 1
end

# Whether there is a break between the characters at i - 1 and i (0 < i < n).
make a function called sb_breaks_before takes cls, i returns yes
  let n = list_len(cls)
  let before = cls[i - 1]
  let here = cls[i]
  # SB3, SB4
  if (before == 1) and (here == 2) then
    return false
  end
  if sb_parasep(before) then
    return true
  end
  # SB5: an Extend or Format belongs to what is before it
  if sb_ignorable(here) then
    return false
  end
  let l = sb_base(cls, i - 1)
  let lc = cls[l]
  # SB6
  if (lc == 11) and (here == 10) then
    return false
  end
  # SB7
  if (lc == 11) and (here == 8) then
    let p = sb_prev(cls, l)
    if (p >= 0) and ((cls[p] == 8) or (cls[p] == 7)) then
      return false
    end
  end
  # SB8: ATerm Close* Sp* x (not OLetter, Upper, Lower, ParaSep or SATerm)* Lower
  if sb_term_before(cls, l, true) == 11 then
    let k = i
    let more = true
    while more and (k < n) do
      let c = cls[k]
      if (c == 9) or (c == 8) or (c == 7) or sb_parasep(c) or (c == 11) or (c == 13) then
        let more = false
      else
        let k = sb_next(cls, k)
      end
    end
    if (k < n) and (cls[k] == 7) then
      return false
    end
  end
  let term = sb_term_before(cls, l, true)
  if term >= 0 then
    # SB8a
    if (here == 12) or (here == 11) or (here == 13) then
      return false
    end
    # SB9: SATerm Close* x (Close | Sp | ParaSep)
    if sb_term_before(cls, l, false) >= 0 then
      if (here == 14) or (here == 6) or sb_parasep(here) then
        return false
      end
    end
    # SB10: SATerm Close* Sp* x (Sp | ParaSep)
    if (here == 6) or sb_parasep(here) then
      return false
    end
    # SB11
    return true
  end
  # SB998
  return false
end

# The breaks in a list of code points: positions from 0 to its length, both
# there (SB1, SB2) unless the list is empty.
make a function called ts_sentence_breaks takes seg, cps returns breaks
  let n = list_len(cps)
  if n == 0 then
    return []
  end
  let cls = ts_classes(seg, cps)
  let out = [0]
  let i = 1
  while i < n do
    if sb_breaks_before(cls, i) then
      let out = list_push(out, i)
    end
    let i = i + 1
  end
  return list_push(out, n)
end
