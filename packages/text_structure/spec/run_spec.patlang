# Runs packages/text_structure/spec/*.feature, from the repository root:
#
#   ./self_hosting/build/v2_interp.exe packages/text_structure/spec/run_spec.patlang [feature file]
#
# Unicode's conformance test is read from packages/text_structure/data. The exit
# code is 0 when every check passes, 1 otherwise.
include "../../../self_hosting/lib/includes.patlang"
include "../../../self_hosting/lib/gherkin.patlang"
include "../plain.patlang"
include "../goals.patlang"
include "../../file_marshal/service.patlang"
include "../../../self_hosting/lib/v2_engines.patlang"

make a function called tt_lines takes b returns lines
  let out = []
  let start = 0
  let k = 0
  let n = bytes_len(b)
  while k <= n do
    if (k == n) or (bytes_get(b, k) == 10) then
      let e = k
      if (e > start) and (bytes_get(b, e - 1) == 13) then
        let e = e - 1
      end
      let out = list_push(out, bytes_slice(b, start, e - start))
      let start = k + 1
    end
    let k = k + 1
  end
  return out
end

make a function called tt_hex takes b returns n
  let n = 0
  let i = 0
  while i < bytes_len(b) do
    let c = bytes_get(b, i)
    if (c >= 48) and (c <= 57) then
      let n = n * 16 + c - 48
    elif (c >= 65) and (c <= 70) then
      let n = n * 16 + c - 55
    end
    let i = i + 1
  end
  return n
end

# One test line, before its "#": [code points, the breaks it marks], or false
# for a comment. "÷" is the bytes 195 183 and "×" 195 151.
make a function called tt_case takes line returns c
  let n = bytes_len(line)
  if (n == 0) or (bytes_get(line, 0) == 35) then
    return false
  end
  let cps = []
  let breaks = []
  let i = 0
  let more = true
  while more and (i < n) do
    let ch = bytes_get(line, i)
    if ch == 35 then
      let more = false
    elif ch == 32 or ch == 9 then
      let i = i + 1
    elif (ch == 195) and (i + 1 < n) then
      if bytes_get(line, i + 1) == 183 then
        let breaks = list_push(breaks, list_len(cps))
      end
      let i = i + 2
    else
      let j = i
      while (j < n) and (bytes_get(line, j) != 32) and (bytes_get(line, j) != 9) do
        let j = j + 1
      end
      let cps = list_push(cps, tt_hex(bytes_slice(line, i, j - i)))
      let i = j
    end
  end
  return [cps, breaks]
end

make a function called st_tt_table takes ctx returns ok
  ctx_set(ctx, "seg", ts_segmenter())
  return true
end

make a function called st_tt_version takes ctx returns ok
  let text = read_file("packages/text_structure/sentence_table.patlang")
  return expect(ctx, "the table names its data file", str_contains(text, "SentenceBreakProperty-18.0.0.txt"), true)
end

make a function called st_tt_classes takes ctx returns ok
  let seg = ctx_get(ctx, "seg")
  let names = ts_sb_class_names()
  let cps = [46, 63, 44, 97, 65, 53, 32, 10, 160, 1488, 776, 1114111]
  let got = []
  let k = 0
  while k < list_len(cps) do
    let got = list_push(got, names[ts_sb_class(seg, cps[k])])
    let k = k + 1
  end
  return expect(ctx, "the classes", got, ["ATerm", "STerm", "SContinue", "Lower", "Upper", "Numeric", "Sp", "LF", "Sp", "OLetter", "Extend", "Other"])
end

make a function called st_tt_lines takes ctx returns ok
  let lines = tt_lines(read_file_raw("packages/text_structure/data/SentenceBreakTest.txt"))
  let cases = []
  let k = 0
  while k < list_len(lines) do
    let c = tt_case(lines[k])
    if c != false then
      let cases = list_push(cases, [k + 1, c])
    end
    let k = k + 1
  end
  ctx_set(ctx, "cases", cases)
  if ctx_get(ctx, "seg") == false then
    ctx_set(ctx, "seg", ts_segmenter())
  end
  return true
end

make a function called st_tt_conform takes ctx returns ok
  let seg = ctx_get(ctx, "seg")
  let cases = ctx_get(ctx, "cases")
  let failed = 0
  let k = 0
  while k < list_len(cases) do
    let c = cases[k][1]
    let got = ts_sentence_breaks(seg, c[0])
    if got != c[1] then
      if failed < 10 then
        print("  line " + cases[k][0] + ": " + c[0] + " breaks at " + got + ", the test marks " + c[1])
      end
      let failed = failed + 1
    end
    let k = k + 1
  end
  let a = expect(ctx, "the test's lines", list_len(cases), 512)
  let b = expect(ctx, "lines whose breaks differ", failed, 0)
  return a and b
end

make a function called st_tt_bytes takes ctx returns ok
  return true
end

make a function called st_tt_decoded takes ctx returns ok
  let a = ts_decode(bytes_from_str("é—a"))
  let b = ts_decode(bytes_from_list([255, 65, 226, 130]))
  let x = expect(ctx, "é—a", a, [[233, 8212, 97], [0, 2, 5, 6]])
  let y = expect(ctx, "the bad bytes", b[0], [65533, 65, 65533, 65533])
  return x and y
end

# ---- structure ----

# a step's text with \n as a line feed
make a function called tt_unescape takes s returns out
  let b = bytes_from_str(s)
  let out = bytes_new(0)
  let k = 0
  while k < bytes_len(b) do
    let c = bytes_get(b, k)
    if (c == 92) and (k + 1 < bytes_len(b)) and (bytes_get(b, k + 1) == 110) then
      bytes_push(out, 10)
      let k = k + 2
    else
      bytes_push(out, c)
      let k = k + 1
    end
  end
  return bytes_to_str(out)
end

make a function called tt_st takes ctx returns st
  let st = ctx_get(ctx, "st")
  if st == false then
    let st = ts_structurer()
    ctx_set(ctx, "st", st)
  end
  return st
end

# the doc string without its last line feed's twin: the text as the scenario shows it
make a function called tt_set_text takes ctx, text, format returns done
  ctx_set(ctx, "format", format)
  ctx_set(ctx, "text", bytes_from_str(text))
  return tt_restructure(ctx)
end

make a function called tt_restructure takes ctx returns done
  let text = ctx_get(ctx, "text")
  if ctx_get(ctx, "format") == "plain" then
    ctx_set(ctx, "tree", ts_plain(tt_st(ctx), text))
  elif ctx_get(ctx, "format") == "gherkin" then
    ctx_set(ctx, "tree", ts_gherkin(tt_st(ctx), text))
  elif ctx_get(ctx, "format") == "patlang" then
    ctx_set(ctx, "tree", ts_patlang(tt_st(ctx), text))
  elif ctx_get(ctx, "format") == "html" then
    let got = ts_html(tt_st(ctx), text)
    ctx_set(ctx, "tree", got[0])
    ctx_set(ctx, "dom", got[1])
  else
    ctx_set(ctx, "tree", ts_markdown(tt_st(ctx), text))
  end
  return true
end

make a function called tt_of takes ctx, u returns s
  return bytes_to_str(ts_bytes_of(ctx_get(ctx, "text"), u))
end

make a function called tt_texts takes ctx, units returns texts
  let out = []
  let k = 0
  while k < list_len(units) do
    let out = list_push(out, tt_of(ctx, units[k]))
    let k = k + 1
  end
  return out
end

make a function called st_tt_plain takes ctx returns ok
  return tt_set_text(ctx, step_doc(ctx), "plain")
end

make a function called st_tt_markdown takes ctx returns ok
  return tt_set_text(ctx, step_doc(ctx), "markdown")
end

