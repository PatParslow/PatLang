# Runs packages/text_structure/spec/*.feature, from the repository root:
#
#   ./self_hosting/build/v2_interp.exe packages/text_structure/spec/run_spec.patlang [feature file]
#
# Unicode's conformance test is read from packages/text_structure/data. The exit
# code is 0 when every check passes, 1 otherwise.
include "../../../self_hosting/lib/includes.patlang"
include "../../../self_hosting/lib/gherkin.patlang"
include "../plain.patlang"
include "../markdown.patlang"

make a function called tt_lines takes b returns lines
  let out = []
  let start = 0
  let k = 0
  let n = bytes_len(b)
  while k <= n do
    if (k == n) or (bytes_get(b, k) == 10) then
      let e = k
      if (e > start) and (bytes_get(b, e - 1) == 13) then
        let e = e - 1
      end
      let out = list_push(out, bytes_slice(b, start, e - start))
      let start = k + 1
    end
    let k = k + 1
  end
  return out
end

make a function called tt_hex takes b returns n
  let n = 0
  let i = 0
  while i < bytes_len(b) do
    let c = bytes_get(b, i)
    if (c >= 48) and (c <= 57) then
      let n = n * 16 + c - 48
    elif (c >= 65) and (c <= 70) then
      let n = n * 16 + c - 55
    end
    let i = i + 1
  end
  return n
end

# One test line, before its "#": [code points, the breaks it marks], or false
# for a comment. "÷" is the bytes 195 183 and "×" 195 151.
make a function called tt_case takes line returns c
  let n = bytes_len(line)
  if (n == 0) or (bytes_get(line, 0) == 35) then
    return false
  end
  let cps = []
  let breaks = []
  let i = 0
  let more = true
  while more and (i < n) do
    let ch = bytes_get(line, i)
    if ch == 35 then
      let more = false
    elif ch == 32 or ch == 9 then
      let i = i + 1
    elif (ch == 195) and (i + 1 < n) then
      if bytes_get(line, i + 1) == 183 then
        let breaks = list_push(breaks, list_len(cps))
      end
      let i = i + 2
    else
      let j = i
      while (j < n) and (bytes_get(line, j) != 32) and (bytes_get(line, j) != 9) do
        let j = j + 1
      end
      let cps = list_push(cps, tt_hex(bytes_slice(line, i, j - i)))
      let i = j
    end
  end
  return [cps, breaks]
end

make a function called st_tt_table takes ctx returns ok
  ctx_set(ctx, "seg", ts_segmenter())
  return true
end

make a function called st_tt_version takes ctx returns ok
  let text = read_file("packages/text_structure/sentence_table.patlang")
  return expect(ctx, "the table names its data file", str_contains(text, "SentenceBreakProperty-18.0.0.txt"), true)
end

make a function called st_tt_classes takes ctx returns ok
  let seg = ctx_get(ctx, "seg")
  let names = ts_sb_class_names()
  let cps = [46, 63, 44, 97, 65, 53, 32, 10, 160, 1488, 776, 1114111]
  let got = []
  let k = 0
  while k < list_len(cps) do
    let got = list_push(got, names[ts_sb_class(seg, cps[k])])
    let k = k + 1
  end
  return expect(ctx, "the classes", got, ["ATerm", "STerm", "SContinue", "Lower", "Upper", "Numeric", "Sp", "LF", "Sp", "OLetter", "Extend", "Other"])
end

make a function called st_tt_lines takes ctx returns ok
  let lines = tt_lines(read_file_raw("packages/text_structure/data/SentenceBreakTest.txt"))
  let cases = []
  let k = 0
  while k < list_len(lines) do
    let c = tt_case(lines[k])
    if c != false then
      let cases = list_push(cases, [k + 1, c])
    end
    let k = k + 1
  end
  ctx_set(ctx, "cases", cases)
  if ctx_get(ctx, "seg") == false then
    ctx_set(ctx, "seg", ts_segmenter())
  end
  return true
end

make a function called st_tt_conform takes ctx returns ok
  let seg = ctx_get(ctx, "seg")
  let cases = ctx_get(ctx, "cases")
  let failed = 0
  let k = 0
  while k < list_len(cases) do
    let c = cases[k][1]
    let got = ts_sentence_breaks(seg, c[0])
    if got != c[1] then
      if failed < 10 then
        print("  line " + cases[k][0] + ": " + c[0] + " breaks at " + got + ", the test marks " + c[1])
      end
      let failed = failed + 1
    end
    let k = k + 1
  end
  let a = expect(ctx, "the test's lines", list_len(cases), 512)
  let b = expect(ctx, "lines whose breaks differ", failed, 0)
  return a and b
end

make a function called st_tt_bytes takes ctx returns ok
  return true
end

make a function called st_tt_decoded takes ctx returns ok
  let a = ts_decode(bytes_from_str("é—a"))
  let b = ts_decode(bytes_from_list([255, 65, 226, 130]))
  let x = expect(ctx, "é—a", a, [[233, 8212, 97], [0, 2, 5, 6]])
  let y = expect(ctx, "the bad bytes", b[0], [65533, 65, 65533, 65533])
  return x and y
end

# ---- structure ----

# a step's text with \n as a line feed
make a function called tt_unescape takes s returns out
  let b = bytes_from_str(s)
  let out = bytes_new(0)
  let k = 0
  while k < bytes_len(b) do
    let c = bytes_get(b, k)
    if (c == 92) and (k + 1 < bytes_len(b)) and (bytes_get(b, k + 1) == 110) then
      bytes_push(out, 10)
      let k = k + 2
    else
      bytes_push(out, c)
      let k = k + 1
    end
  end
  return bytes_to_str(out)
end

make a function called tt_st takes ctx returns st
  let st = ctx_get(ctx, "st")
  if st == false then
    let st = ts_structurer()
    ctx_set(ctx, "st", st)
  end
  return st
end

# the doc string without its last line feed's twin: the text as the scenario shows it
make a function called tt_set_text takes ctx, text, format returns done
  ctx_set(ctx, "format", format)
  ctx_set(ctx, "text", bytes_from_str(text))
  return tt_restructure(ctx)
end

make a function called tt_restructure takes ctx returns done
  let text = ctx_get(ctx, "text")
  if ctx_get(ctx, "format") == "plain" then
    ctx_set(ctx, "tree", ts_plain(tt_st(ctx), text))
  else
    ctx_set(ctx, "tree", ts_markdown(tt_st(ctx), text))
  end
  return true
end

make a function called tt_of takes ctx, u returns s
  return bytes_to_str(ts_bytes_of(ctx_get(ctx, "text"), u))
end

make a function called tt_texts takes ctx, units returns texts
  let out = []
  let k = 0
  while k < list_len(units) do
    let out = list_push(out, tt_of(ctx, units[k]))
    let k = k + 1
  end
  return out
end

make a function called st_tt_plain takes ctx returns ok
  return tt_set_text(ctx, step_doc(ctx), "plain")
end

make a function called st_tt_markdown takes ctx returns ok
  return tt_set_text(ctx, step_doc(ctx), "markdown")
end

make a function called st_tt_two_paras takes ctx returns ok
  let ps = ts_all(ctx_get(ctx, "tree"), "paragraph")
  let a = expect(ctx, "paragraphs", list_len(ps), 2)
  let b = expect(ctx, "the first's sentences", tt_texts(ctx, ts_children(ps[0])), [tt_unescape(step_arg(ctx, "a")), tt_unescape(step_arg(ctx, "b"))])
  return a and b
end

make a function called st_tt_one_para takes ctx returns ok
  let ps = ts_all(ctx_get(ctx, "tree"), "paragraph")
  let a = expect(ctx, "paragraphs", list_len(ps), 1)
  let b = expect(ctx, "its sentences", tt_texts(ctx, ts_children(ps[0])), [step_arg(ctx, "a"), step_arg(ctx, "b")])
  return a and b
end

make a function called st_tt_one_para3 takes ctx returns ok
  let ps = ts_all(ctx_get(ctx, "tree"), "paragraph")
  let a = expect(ctx, "paragraphs", list_len(ps), 1)
  let b = expect(ctx, "its sentences", tt_texts(ctx, ts_children(ps[0])), [step_arg(ctx, "a"), step_arg(ctx, "b"), step_arg(ctx, "c")])
  return a and b
end

make a function called st_tt_add_dr takes ctx returns ok
  ts_add_suppressions(tt_st(ctx), [step_arg(ctx, "s")])
  return tt_restructure(ctx)
end

make a function called st_tt_titles takes ctx returns ok
  let tree = ctx_get(ctx, "tree")
  let notes = ts_find(tree, [["section", "Notes"]])
  let details = ts_find(tree, [["section", "Notes"], ["section", "Details"]])
  let a = expect(ctx, "the sections", [notes[0], details[0]], ["ok", "ok"])
  let kinds = []
  let k = 0
  while k < list_len(ts_children(notes[1])) do
    let kinds = list_push(kinds, ts_kind(ts_children(notes[1])[k]))
    let k = k + 1
  end
  let b = expect(ctx, "Notes holds", kinds, ["heading", "paragraph", "section"])
  let dp = ts_find(details[1], [["paragraph", 1]])
  let c = expect(ctx, "Details' paragraph's sentences", list_len(ts_children(dp[1])), 2)
  return a and b and c
end

make a function called tt_outline_into takes u, depth, b returns done
  let k = 0
  while k < depth do
    sb_push(b, "  ")
    let k = k + 1
  end
  sb_push(b, ts_kind(u))
  if ts_kind(u) == "section" then
    sb_push(b, " " + ts_attr(u, "title"))
  end
  if ts_kind(u) == "code" then
    if ts_attr(u, "lang") != "" then
      sb_push(b, " " + ts_attr(u, "lang"))
    end
  end
  let kids = ts_children(u)
  if (list_len(kids) > 0) and (ts_kind(kids[0]) == "sentence") then
    let n = list_len(kids)
    if n == 1 then
      sb_push(b, ": 1 sentence")
    else
      sb_push(b, ": " + n + " sentences")
    end
    sb_push(b, chr(10))
    return true
  end
  sb_push(b, chr(10))
  let k = 0
  while k < list_len(kids) do
    tt_outline_into(kids[k], depth + 1, b)
    let k = k + 1
  end
  return true
end

make a function called st_tt_outline takes ctx returns ok
  let b = sb_new()
  tt_outline_into(ctx_get(ctx, "tree"), 0, b)
  return expect(ctx, "the outline", sb_str(b), step_doc(ctx))
end

make a function called tt_install_s2 returns a
  return [["section", "Guide"], ["section", "Install"], ["paragraph", 1], ["sentence", 2]]
end

make a function called st_tt_address takes ctx returns ok
  let got = ts_find(ctx_get(ctx, "tree"), tt_install_s2())
  let a = expect(ctx, "found", got[0], "ok")
  if got[0] != "ok" then
    return false
  end
  return expect(ctx, "the sentence", tt_of(ctx, got[1]), step_arg(ctx, "text"))
end

make a function called st_tt_not_found takes ctx returns ok
  let got = ts_find(ctx_get(ctx, "tree"), [["section", "Guide"], ["paragraph", 3]])
  return expect(ctx, "not found", got, ["none", "step 2: no paragraph 3"])
end

make a function called st_tt_walk takes ctx returns ok
  let w = ts_walk(ctx_get(ctx, "tree"), "sentence")
  let first = ts_walk_next(w)
  let n = 1
  while ts_walk_next(w) != false do
    let n = n + 1
  end
  let a = expect(ctx, "the first sentence", tt_of(ctx, first), step_arg(ctx, "text"))
  let b = expect(ctx, "the sentences walked", n, 5)
  return a and b
end

make a function called tt_apply takes ctx, edits returns ok
  let r = fm_apply_batch(ctx_get(ctx, "text"), edits)
  if r[0] != "ok" then
    print("  (the batch is refused: " + r + ")")
    return false
  end
  ctx_set(ctx, "text", r[1])
  tt_restructure(ctx)
  return true
end

make a function called st_tt_make_into takes ctx returns ok
  let got = ts_find(ctx_get(ctx, "tree"), tt_install_s2())
  return expect(ctx, "the edit applies", tt_apply(ctx, [ts_edit_for(ctx_get(ctx, "text"), got[1], step_arg(ctx, "text"))]), true)
end

make a function called st_tt_ends takes ctx returns ok
  let want = tt_unescape(step_arg(ctx, "text"))
  let text = bytes_to_str(ctx_get(ctx, "text"))
  return expect(ctx, "the text ends " + want, str_len(text) >= str_len(want) and (bytes_to_str(bytes_slice(ctx_get(ctx, "text"), str_len(text) - str_len(want), str_len(want))) == want), true)
end

make a function called st_tt_stale_edit takes ctx returns ok
  let text = ctx_get(ctx, "text")
  let tree = ctx_get(ctx, "tree")
  let w = ts_walk(tree, "sentence")
  let u = ts_walk_next(w)
  while (u != false) and (tt_of(ctx, u) != "Run it.") do
    let u = ts_walk_next(w)
  end
  let e = ts_edit_for(text, u, "Run it now.")
  let heading = ts_all(tree, "heading")[0]
  let a = expect(ctx, "the heading changes", tt_apply(ctx, [ts_edit_for(text, heading, "# The guide")]), true)
  ctx_set(ctx, "stale", e)
  return a
end

make a function called st_tt_stale_applies takes ctx returns ok
  let a = expect(ctx, "the edit made before still applies", tt_apply(ctx, [ctx_get(ctx, "stale")]), true)
  let b = expect(ctx, "the text", bytes_to_str(ctx_get(ctx, "text")), tt_unescape(step_arg(ctx, "text")))
  return a and b
end

make a function called st_tt_move takes ctx returns ok
  let tree = ctx_get(ctx, "tree")
  let u = ts_find(tree, [["section", "The guide"], ["section", "Install"], ["paragraph", 1]])
  let target = ts_find(tree, [["section", "The guide"], ["paragraph", 1]])
  let a = expect(ctx, "both found", [u[0], target[0]], ["ok", "ok"])
  let b = expect(ctx, "the move applies", tt_apply(ctx, ts_move(ctx_get(ctx, "text"), u[1], target[1], false, chr(10) + chr(10))), true)
  return a and b
end

make a function called st_tt_order takes ctx returns ok
  let ps = ts_all(ctx_get(ctx, "tree"), "paragraph")
  return expect(ctx, "the paragraphs", tt_texts(ctx, ps), [step_arg(ctx, "a"), step_arg(ctx, "b")])
end

let ctx = ctx_new()
step(ctx, "the plain text", "st_tt_plain")
step(ctx, "the Markdown", "st_tt_markdown")
step(ctx, "it has 2 paragraphs, the first with the sentences \"{a}\" and \"{b}\"", "st_tt_two_paras")
step(ctx, "it has 1 paragraph, with the sentences \"{a}\", \"{b}\" and \"{c}\"", "st_tt_one_para3")
step(ctx, "it has 1 paragraph, with the sentences \"{a}\" and \"{b}\"", "st_tt_one_para")
step(ctx, "\"{s}\" is added to the suppressions", "st_tt_add_dr")
step(ctx, "it has a section \"Notes\" holding a paragraph and a section \"Details\", whose paragraph has 2 sentences", "st_tt_titles")
step(ctx, "its outline is", "st_tt_outline")
step(ctx, "the address section \"Guide\" / section \"Install\" / paragraph 1 / sentence 2 is \"{text}\"", "st_tt_address")
step(ctx, "the address section \"Guide\" / paragraph 3 is not found, saying there is no paragraph 3", "st_tt_not_found")
step(ctx, "a walk over sentences gives \"{text}\" first, and stops after 5", "st_tt_walk")
step(ctx, "the address section \"Guide\" / section \"Install\" / paragraph 1 / sentence 2 is made into \"{text}\"", "st_tt_make_into")
step(ctx, "the text ends \"{text}\"", "st_tt_ends")
step(ctx, "an edit making \"Run it.\" into \"Run it now.\" is made, and then the heading \"# Guide\" becomes \"# The guide\" before it is applied", "st_tt_stale_edit")
step(ctx, "the edit still applies, and the text is \"{text}\"", "st_tt_stale_applies")
step(ctx, "the paragraph under \"Install\" is moved to before the first paragraph", "st_tt_move")
step(ctx, "the paragraphs read, in order, \"{a}\" and \"{b}\"", "st_tt_order")
step(ctx, "the sentence-break table", "st_tt_table")
step(ctx, "it says it was made from SentenceBreakProperty-18.0.0.txt", "st_tt_version")
step(ctx, "full stop is ATerm, question mark STerm, comma SContinue, \"a\" Lower, \"A\" Upper, \"5\" Numeric, a space Sp, a line feed LF, a no-break space Sp, the Hebrew letter alef OLetter, U+0308 Extend, and U+10FFFF Other", "st_tt_classes")
step(ctx, "the lines of SentenceBreakTest.txt", "st_tt_lines")
step(ctx, "each gives exactly the breaks it marks, all 512 of them", "st_tt_conform")
step(ctx, "the bytes of \"é—a\" and the bytes 255, 65 and 226, 130", "st_tt_bytes")
step(ctx, "they read as 233, 8212, 97 at 0, 2, 5, and as 65533, 65, 65533, 65533", "st_tt_decoded")
run_suite(ctx, ["packages/text_structure/spec/sentences.feature", "packages/text_structure/spec/structure.feature"], argv())
