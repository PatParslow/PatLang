  let ps = ts_all(ctx_get(ctx, "tree"), "paragraph")
  let a = expect(ctx, "paragraphs", list_len(ps), 1)
  let b = expect(ctx, "its sentences", tt_texts(ctx, ts_children(ps[0])), [step_arg(ctx, "a"), step_arg(ctx, "b")])
  return a and b
