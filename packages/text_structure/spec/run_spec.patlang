  return expect(ctx, "not found", got, ["none", "step 2: no paragraph 3"])
end

make a function called st_tt_walk takes ctx returns ok
  let w = ts_walk(ctx_get(ctx, "tree"), "sentence")
  let first = ts_walk_next(w)
  let n = 1
  while ts_walk_next(w) != false do
    let n = n + 1
  end
  let a = expect(ctx, "the first sentence", tt_of(ctx, first), step_arg(ctx, "text"))
  let b = expect(ctx, "the sentences walked", n, 5)
  return a and b
end

make a function called tt_apply takes ctx, edits returns ok
  let r = fm_apply_batch(ctx_get(ctx, "text"), edits)
  if r[0] != "ok" then
    print("  (the batch is refused: " + r + ")")
    return false
  end
  ctx_set(ctx, "text", r[1])
  tt_restructure(ctx)
  return true
end

make a function called st_tt_make_into takes ctx returns ok
  let got = ts_find(ctx_get(ctx, "tree"), tt_install_s2())
  return expect(ctx, "the edit applies", tt_apply(ctx, [ts_edit_for(ctx_get(ctx, "text"), got[1], step_arg(ctx, "text"))]), true)
end

make a function called st_tt_ends takes ctx returns ok
  let want = tt_unescape(step_arg(ctx, "text"))
  let text = bytes_to_str(ctx_get(ctx, "text"))
  return expect(ctx, "the text ends " + want, str_len(text) >= str_len(want) and (bytes_to_str(bytes_slice(ctx_get(ctx, "text"), str_len(text) - str_len(want), str_len(want))) == want), true)
end

make a function called st_tt_stale_edit takes ctx returns ok
  let text = ctx_get(ctx, "text")
  let tree = ctx_get(ctx, "tree")
  let w = ts_walk(tree, "sentence")
  let u = ts_walk_next(w)
  while (u != false) and (tt_of(ctx, u) != "Run it.") do
    let u = ts_walk_next(w)
  end
  let e = ts_edit_for(text, u, "Run it now.")
  let heading = ts_all(tree, "heading")[0]
  let a = expect(ctx, "the heading changes", tt_apply(ctx, [ts_edit_for(text, heading, "# The guide")]), true)
  ctx_set(ctx, "stale", e)
  return a
end

make a function called st_tt_stale_applies takes ctx returns ok
  let a = expect(ctx, "the edit made before still applies", tt_apply(ctx, [ctx_get(ctx, "stale")]), true)
  let b = expect(ctx, "the text", bytes_to_str(ctx_get(ctx, "text")), tt_unescape(step_arg(ctx, "text")))
  return a and b
end

make a function called st_tt_move takes ctx returns ok
  let tree = ctx_get(ctx, "tree")
  let u = ts_find(tree, [["section", "The guide"], ["section", "Install"], ["paragraph", 1]])
  let target = ts_find(tree, [["section", "The guide"], ["paragraph", 1]])
  let a = expect(ctx, "both found", [u[0], target[0]], ["ok", "ok"])
  let b = expect(ctx, "the move applies", tt_apply(ctx, ts_move(ctx_get(ctx, "text"), u[1], target[1], false, chr(10) + chr(10))), true)
  return a and b
end

make a function called st_tt_order takes ctx returns ok
  let ps = ts_all(ctx_get(ctx, "tree"), "paragraph")
  return expect(ctx, "the paragraphs", tt_texts(ctx, ps), [step_arg(ctx, "a"), step_arg(ctx, "b")])
end

