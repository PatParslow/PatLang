make a function called st_tt_titles takes ctx returns ok
  let tree = ctx_get(ctx, "tree")
  let notes = ts_find(tree, [["section", "Notes"]])
  let details = ts_find(tree, [["section", "Notes"], ["section", "Details"]])
  let a = expect(ctx, "the sections", [notes[0], details[0]], ["ok", "ok"])
  let kinds = []
  let k = 0
  while k < list_len(ts_children(notes[1])) do
    let kinds = list_push(kinds, ts_kind(ts_children(notes[1])[k]))
    let k = k + 1
  end
  let b = expect(ctx, "Notes holds", kinds, ["heading", "paragraph", "section"])
  let dp = ts_find(details[1], [["paragraph", 1]])
  let c = expect(ctx, "Details' paragraph's sentences", list_len(ts_children(dp[1])), 2)
  return a and b and c
end

make a function called tt_outline_into takes u, depth, b returns done
  let k = 0
  while k < depth do
    sb_push(b, "  ")
    let k = k + 1
  end
  sb_push(b, ts_kind(u))
  if (ts_kind(u) == "section") and (ts_attr(u, "title") != "") then
    sb_push(b, " " + ts_attr(u, "title"))
  end
  if ts_kind(u) == "code" then
    if ts_attr(u, "lang") != "" then
      sb_push(b, " " + ts_attr(u, "lang"))
    end
  end
  if ts_kind(u) == "step" then
    sb_push(b, " " + ts_attr(u, "keyword"))
  end
  let kids = ts_children(u)
  if (list_len(kids) > 0) and (ts_kind(kids[0]) == "sentence") then
    let n = list_len(kids)
    if n == 1 then
      sb_push(b, ": 1 sentence")
    else
      sb_push(b, ": " + n + " sentences")
    end
    sb_push(b, chr(10))
    return true
  end
  sb_push(b, chr(10))
  let k = 0
  while k < list_len(kids) do
    tt_outline_into(kids[k], depth + 1, b)
    let k = k + 1
  end
  return true
end

make a function called st_tt_outline takes ctx returns ok
  let b = sb_new()
  tt_outline_into(ctx_get(ctx, "tree"), 0, b)
  return expect(ctx, "the outline", sb_str(b), step_doc(ctx))
end

