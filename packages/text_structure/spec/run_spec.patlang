make a function called tu_sample_md returns text
  let nl = chr(10)
  let f = chr(96) + chr(96) + chr(96)
  return "# Title" + nl + nl + "First paragraph. It has two sentences." + nl + "And a wrapped line." + nl + nl + "## Part" + nl + nl + "- one item. More." + nl + "- two" + nl + "  continued" + nl + nl + "> quoted. Text." + nl + "> more" + nl + nl + f + "sh" + nl + "code. here" + nl + f + nl + nl + "| a | b |" + nl + "|---|---|" + nl + nl + "Setext" + nl + "------" + nl + nl + "Last paragraph here. End." + nl
end

