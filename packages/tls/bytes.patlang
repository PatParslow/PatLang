# Bytes as text, for keys, vectors and logs: hex of public bytes, or of
# modint bytes whose values are to be shown (a test's known answer).
#
#   tls_hex_bytes(text) -> the bytes the hex text spells, as ints
#   tls_hex(bytes)      -> lowercase hex of ints or modints modulo 256
#   tls_text_bytes(s)   -> the bytes of an ASCII text, as ints

make a function called tls_hex_digit takes c returns v
  require ((c >= 48) and (c <= 57)) or ((c >= 97) and (c <= 102)) or ((c >= 65) and (c <= 70))
  if c >= 97 then
    return c - 87
  end
  if c >= 65 then
    return c - 55
  end
  return c - 48
end

make a function called tls_hex_bytes takes text returns bytes
  require (type_of(text) == "string") and (str_len(text) % 2 == 0)
  let bytes = []
  let i = 0
  while i < str_len(text) do
    let bytes = list_push(bytes, tls_hex_digit(char_code(text, i)) * 16 + tls_hex_digit(char_code(text, i + 1)))
    let i = i + 2
  end
  ensure list_len(bytes) * 2 == str_len(text)
  return bytes
end

make a function called tls_hex takes bytes returns text
  require type_of(bytes) == "list"
  let digits = "0123456789abcdef"
  let b = sb_new()
  let i = 0
  while i < list_len(bytes) do
    let v = bytes[i]
    if type_of(v) == "modint" then
      let v = mod_value(v)
    end
    sb_push(b, digits[v shr 4])
    sb_push(b, digits[v band 15])
    let i = i + 1
  end
  let text = sb_str(b)
  ensure str_len(text) == 2 * list_len(bytes)
  return text
end

make a function called tls_text_bytes takes s returns bytes
  require type_of(s) == "string"
  let bytes = []
  let i = 0
  while i < str_len(s) do
    let bytes = list_push(bytes, char_code(s, i))
    let i = i + 1
  end
  ensure list_len(bytes) == str_len(s)
  return bytes
end
