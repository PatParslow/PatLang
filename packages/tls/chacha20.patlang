# ChaCha20 (RFC 8439 sections 2.3 and 2.4) on 32-bit words, each a modint
# modulo 2^32 (spec 1.14). Keys, nonces, data and keystream are lists of bytes;
# a byte given as an int is taken as public, and every byte made here is a
# modint modulo 256, so the constant-time check (spec 2.7) follows the key
# and the data as secret. Only the data's length decides how many steps run.
#
#   chacha20_block(key, counter, nonce) -> the 64 keystream bytes of a block
#   chacha20_xor(key, counter, nonce, data) -> data xor the keystream from
#                                              block counter on

make a function called cc_word takes x returns w
  require (type_of(x) == "int") or (type_of(x) == "modint")
  let w = mod_make(x, 4294967296)
  ensure mod_modulus(w) == 4294967296
  return w
end

make a function called cc_byte takes x returns b
  require (type_of(x) == "int") or (type_of(x) == "modint")
  let b = mod_make(x, 256)
  ensure mod_modulus(b) == 256
  return b
end

# The little-endian word of the four bytes at i.
make a function called cc_le32 takes bytes, i returns w
  require (i >= 0) and (i + 4 <= list_len(bytes))
  let w = cc_word(bytes[i]) bor (cc_word(bytes[i + 1]) shl 8) bor (cc_word(bytes[i + 2]) shl 16) bor (cc_word(bytes[i + 3]) shl 24)
  ensure mod_modulus(w) == 4294967296
  return w
end

# RFC 8439 2.3: the block for a 32-byte key, a block counter (a public int)
# and a 12-byte nonce, as 64 bytes. The state is sixteen words in variables,
# each quarter round (2.1) written out, so the rounds are additions, XORs and
# rotations of two 32-bit modints, which the compiler does inline. (Held in a
# list, each quarter round re-made its four words with mod_make and set them
# back one at a time: about 9 million cycles a block, 2026-11-24.)
make a function called chacha20_block takes key, counter, nonce returns bytes
  require (list_len(key) == 32) and (list_len(nonce) == 12)
  require (type_of(counter) == "int") and (counter >= 0) and (counter < 4294967296)
  let s = [cc_word(1634760805), cc_word(857760878), cc_word(2036477234), cc_word(1797285236)]
  let i = 0
  while i < 8 do
    let s = list_push(s, cc_le32(key, 4 * i))
    let i = i + 1
  end
  let s = list_push(s, cc_word(counter))
  let i = 0
  while i < 3 do
    let s = list_push(s, cc_le32(nonce, 4 * i))
    let i = i + 1
  end
  let x0 = cc_word(s[0])
  let x1 = cc_word(s[1])
  let x2 = cc_word(s[2])
  let x3 = cc_word(s[3])
  let x4 = cc_word(s[4])
  let x5 = cc_word(s[5])
  let x6 = cc_word(s[6])
  let x7 = cc_word(s[7])
  let x8 = cc_word(s[8])
  let x9 = cc_word(s[9])
  let x10 = cc_word(s[10])
  let x11 = cc_word(s[11])
  let x12 = cc_word(s[12])
  let x13 = cc_word(s[13])
  let x14 = cc_word(s[14])
  let x15 = cc_word(s[15])
  let round = 0
  while round < 10 do
    # the quarter round on 0, 4, 8, 12
    let x0 = x0 + x4
    let x12 = rotl(x12 bxor x0, 16)
    let x8 = x8 + x12
    let x4 = rotl(x4 bxor x8, 12)
    let x0 = x0 + x4
    let x12 = rotl(x12 bxor x0, 8)
    let x8 = x8 + x12
    let x4 = rotl(x4 bxor x8, 7)
    # the quarter round on 1, 5, 9, 13
    let x1 = x1 + x5
    let x13 = rotl(x13 bxor x1, 16)
    let x9 = x9 + x13
    let x5 = rotl(x5 bxor x9, 12)
    let x1 = x1 + x5
    let x13 = rotl(x13 bxor x1, 8)
    let x9 = x9 + x13
    let x5 = rotl(x5 bxor x9, 7)
    # the quarter round on 2, 6, 10, 14
    let x2 = x2 + x6
    let x14 = rotl(x14 bxor x2, 16)
    let x10 = x10 + x14
    let x6 = rotl(x6 bxor x10, 12)
    let x2 = x2 + x6
    let x14 = rotl(x14 bxor x2, 8)
    let x10 = x10 + x14
    let x6 = rotl(x6 bxor x10, 7)
    # the quarter round on 3, 7, 11, 15
    let x3 = x3 + x7
    let x15 = rotl(x15 bxor x3, 16)
    let x11 = x11 + x15
    let x7 = rotl(x7 bxor x11, 12)
    let x3 = x3 + x7
    let x15 = rotl(x15 bxor x3, 8)
    let x11 = x11 + x15
    let x7 = rotl(x7 bxor x11, 7)
    # the quarter round on 0, 5, 10, 15
    let x0 = x0 + x5
    let x15 = rotl(x15 bxor x0, 16)
    let x10 = x10 + x15
    let x5 = rotl(x5 bxor x10, 12)
    let x0 = x0 + x5
    let x15 = rotl(x15 bxor x0, 8)
    let x10 = x10 + x15
    let x5 = rotl(x5 bxor x10, 7)
    # the quarter round on 1, 6, 11, 12
    let x1 = x1 + x6
    let x12 = rotl(x12 bxor x1, 16)
    let x11 = x11 + x12
    let x6 = rotl(x6 bxor x11, 12)
    let x1 = x1 + x6
    let x12 = rotl(x12 bxor x1, 8)
    let x11 = x11 + x12
    let x6 = rotl(x6 bxor x11, 7)
    # the quarter round on 2, 7, 8, 13
    let x2 = x2 + x7
    let x13 = rotl(x13 bxor x2, 16)
    let x8 = x8 + x13
    let x7 = rotl(x7 bxor x8, 12)
    let x2 = x2 + x7
    let x13 = rotl(x13 bxor x2, 8)
    let x8 = x8 + x13
    let x7 = rotl(x7 bxor x8, 7)
    # the quarter round on 3, 4, 9, 14
    let x3 = x3 + x4
    let x14 = rotl(x14 bxor x3, 16)
    let x9 = x9 + x14
    let x4 = rotl(x4 bxor x9, 12)
    let x3 = x3 + x4
    let x14 = rotl(x14 bxor x3, 8)
    let x9 = x9 + x14
    let x4 = rotl(x4 bxor x9, 7)
    let round = round + 1
  end
  let x = [x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15]
  let bytes = []
  let i = 0
  while i < 16 do
    let w = cc_word(x[i]) + cc_word(s[i])
    let bytes = list_push(bytes, cc_byte(w))
    let bytes = list_push(bytes, cc_byte(w shr 8))
    let bytes = list_push(bytes, cc_byte(w shr 16))
    let bytes = list_push(bytes, cc_byte(w shr 24))
    let i = i + 1
  end
  ensure list_len(bytes) == 64
  return bytes
end

# RFC 8439 2.4: data xor the keystream of the blocks counter, counter + 1, ...
make a function called chacha20_xor takes key, counter, nonce, data returns out
  require (list_len(key) == 32) and (list_len(nonce) == 12) and (type_of(data) == "list")
  require (type_of(counter) == "int") and (counter >= 0)
  require counter + (list_len(data) + 63) / 64 <= 4294967296
  let out = []
  let n = list_len(data)
  let at = 0
  let block = counter
  while at < n do
    let ks = chacha20_block(key, block, nonce)
    let j = 0
    while (j < 64) and (at + j < n) do
      let out = list_push(out, cc_byte(data[at + j]) bxor ks[j])
      let j = j + 1
    end
    let at = at + 64
    let block = block + 1
  end
  ensure list_len(out) == n
  return out
end
