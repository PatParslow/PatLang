# The tls package's manifest (format: packages/README.md).
package tls
version 0.2.2
summary a TLS 1.3 client (RFC 8446) and its cryptography on modints: ChaCha20-Poly1305 (RFC 8439) and AES-128-GCM with a computed S-box, SHA-256 and SHA-384, HMAC and HKDF with TLS 1.3's labels, x25519 and P-256 key shares, RSA PKCS#1 v1.5 and PSS and ECDSA P-256 and P-384 checks, X.509 certificates and chains to the system's roots, and a GET over HTTPS for packages (tls_https_get); the secrets' paths pass the constant-time check (spec 2.7); depends on sha512 and curve25519
entry tls.patlang
include tls.patlang
include bytes.patlang
include chacha20.patlang
include poly1305.patlang
include aead.patlang
include aes.patlang
include sha256m.patlang
include kdf.patlang
include sig.patlang
include ecdh.patlang
include x509.patlang
include tls13.patlang
include https.patlang
depends sha512 >= 0.1.2, < 0.2.0
depends curve25519 >= 0.1.1, < 0.2.0
