# The tls package: the cryptography of a TLS 1.3 client, on modints so the
# constant-time check (spec 2.7) follows its secrets (docs/plans/http-tls.md,
# stage 2). So far: ChaCha20, Poly1305 and AEAD_CHACHA20_POLY1305 (RFC 8439).

include "bytes.patlang"
include "chacha20.patlang"
include "poly1305.patlang"
include "aead.patlang"
include "aes.patlang"
include "kdf.patlang"
include "sig.patlang"
include "ecdh.patlang"
include "x509.patlang"
include "tls13.patlang"
include "https.patlang"
