# The trust checks' signature verifier, in PatLang: Ed25519 from the
# curve25519 package, which passes all of RFC 8032 section 7.1's vectors and
# Wycheproof's Ed25519 set (packages/curve25519/spec), so no check calls out
# to the operating system or another language (docs/plans/package-trust.md,
# decision 4).
#
#   let verify = trust_ed25519_verifier()
#   trust_verify_package(dir, pin, verify)
#
# verify(alg, public key hex, message hex, signature hex) gives true only for
# alg "ed25519", a 32-byte key, a 64-byte signature, all lowercase hex, and a
# signature that verifies; anything else gives false. Verification uses no
# secret, so it needs no constant-time guarantee.
include "../curve25519/curve25519.patlang"

# hex as bytes (modints modulo 256, as the curve25519 package takes them), or
# false when it is not whole bytes of lowercase hex
make a function called tr_hex_or_false takes text returns bytes
  if type_of(text) != "string" then
    return false
  end
  let n = str_len(text)
  if n % 2 != 0 then
    return false
  end
  let k = 0
  while k < n do
    let c = char_code(text, k)
    if not (((c >= 48) and (c <= 57)) or ((c >= 97) and (c <= 102))) then
      return false
    end
    let k = k + 1
  end
  return cv_hex_bytes(text)
end

make a function called trust_ed25519_check takes alg, pub, msg, sig returns ok
  if alg != "ed25519" then
    return false
  end
  let p = tr_hex_or_false(pub)
  let m = tr_hex_or_false(msg)
  let s = tr_hex_or_false(sig)
  if (p == false) or (m == false) or (s == false) then
    return false
  end
  if (list_len(p) != 32) or (list_len(s) != 64) then
    return false
  end
  return ed25519_verify(p, m, s)
end

make a function called trust_ed25519_verifier returns verify
  return |alg, pub, msg, sig| {
    return trust_ed25519_check(alg, pub, msg, sig)
  }
end
