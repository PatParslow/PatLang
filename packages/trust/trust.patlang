# trust package: the records and checks of PatLang package trust
# (docs/plans/package-trust.md, phase T1). Shared with the ensemble
# design's milestone M0 (docs/plans/ensemble-membership.md).
#
# Records (records.patlang): readers give ["ok", record] or a failure
# ["err", code, stage, detail], never stopping the program; writers give
# ["ok", bytes] and refuse what a reader would.
#
#   trust_read_view(bytes)  trust_read_genesis(bytes)  trust_read_transition(bytes)
#   trust_read_release(bytes)  trust_read_withdraw(bytes)  trust_read_sigs(bytes)
#   trust_write_view(group, epoch, quorum, members)
#   trust_write_genesis(package, view, created)
#   trust_write_transition(group, from_epoch, from_view, to_epoch, to_view,
#                          reason, subject, evidence, revoke_from)
#   trust_write_release(group, epoch, view, package, version, manifest, created)
#   trust_write_withdraw(group, epoch, view, package, version, reason)
#   trust_write_sigs([[slot, signature hex]])
#   trust_fields(bytes), trust_fields_bytes(pairs)   a record's raw fields
#
# Checks (checks.patlang, verify.patlang). verify is a function value
# verify(alg, public key hex, message hex, signature hex) -> true | false;
# the message is always a record's hash. Pass a closure literal bound in
# the calling scope.
#
#   trust_quorum_need(view, excluding)
#   trust_check_cert(view, hash, sigs, verify, excluded slot or -1, stage)
#   trust_check_genesis(genesis, sigs, view, pin, verify) -> ["ok", state]
#   trust_check_transition(state, transition, sigs, view, verify, n)
#   trust_check_log(dir, pin, verify)                    -> ["ok", state]
#   trust_check_release(state, manifest, release, sigs, verify)
#   trust_check_withdrawal(state, release, withdrawal, sigs, verify)
#   trust_check_revocations(state, release, signers)
#   trust_verify_package(dir, pin, verify)
#       -> ["ok", [package, version, highest epoch, signers]]
#   trust_state_epoch(state), trust_state_view(state, epoch)
include "../sha256/sha256.patlang"
include "records.patlang"
include "checks.patlang"
include "verify.patlang"

# ---- accessors ----

make a function called trust_rec_hash takes rec returns h
  require value_class(rec) == 9
  let h = rec[1]
  ensure h.length == 64
  return h
end

make a function called trust_view_epoch takes v returns e
  require v[0] == "view"
  let e = v[3]
  ensure e >= 0
  return e
end

make a function called trust_view_group takes v returns g
  require v[0] == "view"
  let g = v[2]
  ensure value_class(g) == 8
  return g
end

# 0 for a majority, else the count.
make a function called trust_view_quorum takes v returns q
  require v[0] == "view"
  let q = v[4]
  ensure q >= 0
  return q
end

# [[slot, alg, key hex]] in increasing slot order.
make a function called trust_view_members takes v returns ms
  require v[0] == "view"
  let ms = v[5]
  ensure list_len(ms) >= 1
  return ms
end

make a function called trust_release_epoch takes r returns e
  require r[0] == "release"
  let e = r[3]
  ensure e >= 0
  return e
end

make a function called trust_release_package takes r returns p
  require r[0] == "release"
  let p = r[5]
  ensure value_class(p) == 8
  return p
end

make a function called trust_release_version takes r returns v
  require r[0] == "release"
  let v = r[6]
  ensure value_class(v) == 8
  return v
end

make a function called trust_release_manifest takes r returns m
  require r[0] == "release"
  let m = r[7]
  ensure m.length == 64
  return m
end
