# patc_native: minimal native path using tiny parser -> lower_and_compile
# Usage:
#   - Stage 0:  pat ./patc_native.patlang <input.patlang> [--out path]
#   - Native:   patc_bootstrap.exe <input.patlang> [--out path]

let argv = get_argv()
let argc = list_len(argv)

if argc == "0" then
  print("usage: <compiler> <input.patlang> [--out path]")
else
  # Assume script name is present at argv[0]
  let input = list_get(argv, 1)
  let flag = list_get(argv, 2)
  let out = ""
  if flag == "--out" then
    let out = list_get(argv, 3)
  end
  let prog = parse_tiny_source(input)
  print("CALL")
  if out == "" then
    let built = lower_and_compile(prog)
    print(built)
    print("EXISTS_AFTER " + file_exists(built))
  else
    print("TOUCH " + touch_file(out))
    print("EXISTS_BEFORE " + file_exists(out))
    let built = lower_and_compile(prog, out)
    print(built)
    print("EXISTS_AFTER " + file_exists(out))
  end
  print("RET")
end
