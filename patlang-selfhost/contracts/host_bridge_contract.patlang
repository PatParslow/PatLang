# Contract for host fallback bridge (Rust/Ruby)

contract HostBridge {
  # Generic invocation for host-provided services
  method invoke(namespace: Symbol, method: Symbol, args: List[Any], ctx: HostContext): (Value | HostError | NotImplemented) {
    ensures: (result is Value) xor (result is HostError) xor (result is NotImplemented)
  }

  # Capability discovery
  method supports(namespace: Symbol, method: Symbol): Bool
}
