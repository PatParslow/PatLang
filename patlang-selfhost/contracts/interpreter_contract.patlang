# Contract for Interpreter module (method-level)

contract Interpreter {
  # Execute an AST/program with an initial environment
  method run(program: AST, env: Env): (Value | RuntimeError) {
    requires: program != null
    ensures: (result is Value) xor (result is RuntimeError)
  }

  # Dynamic dispatch with method_missing fallback
  method dispatch(receiver: Any, method: Symbol, args: List[Any], env: Env): (Value | MethodMissing) {
    ensures: (result is Value) xor (result is MethodMissing)
  }

  # Event hook invoked when a method is missing
  event method_missing(receiver: Any, method: Symbol, args: List[Any], env: Env): (Value | HostFallback | NoHandler) {
    # Implementations may handle, request host fallback, or decline
  }
}
