# Contract for Parser module (method-level)

contract Parser {
	# Parse a full token stream into an AST
	method parse(tokens: TokenStream): (AST | ParseError) {
		requires: tokens != null
		ensures: (result is AST) xor (result is ParseError)
		ensures: if result is AST then ast_is_well_formed(result)
	}

	# Parse a single expression (useful for REPL and tests)
	method parse_expression(tokens: TokenStream): (Expr | ParseError, TokenStream) {
		requires: tokens != null
		ensures: (node is Expr) xor (node is ParseError)
		ensures: remaining.tokens_consumed >= 0
	}

	predicate ast_is_well_formed(ast: AST): Bool
}
