# Minimal Patlang self-host build file

target :compiler do
  inputs "compiler.patlang",
         "lexer.patlang",
         "parser.patlang",
         "interpreter.patlang",
         "ir.patlang",
         "optimizer.patlang",
         "debugger_introspector.patlang",
         "host_bridge.patlang"
  inputs Dir["stdlib/*.patlang"]
  outputs "compiler_selfhosted.bin"
end