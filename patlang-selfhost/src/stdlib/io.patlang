# IO Stdlib Module
# Implements contract-driven IO operations via HostBridge.
# References: [`host_bridge_contract.patlang`](../../contracts/host_bridge_contract.patlang)

# Patlang-native IO stdlib API (host-bridge backed)

# Simplified APIs directly invoking HostBridge (parser-friendly)
make function IO_puts(s) { return HostBridge.invoke("IO", "puts", s) }
make function IO_gets() { return HostBridge.invoke("IO", "gets") }

# Simple sentinel variable for evaluator legacy interception (IO.puts style)
make IO = "IO_SHIM"
make FS = "FS_SHIM"
make Net = "NET_SHIM"