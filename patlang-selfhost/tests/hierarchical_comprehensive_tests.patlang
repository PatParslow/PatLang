# Hierarchical Comprehensive Patlang Tests
include "../src/stdlib/io.patlang"

# Event Handling
test "EventHandling" {
  puts "Testing Event Handling"
  test "EmitEvent" {
    event on_custom_event(data).
    handler on_custom_event(data) :- print("Event: " + data).
    emit on_custom_event("42")
    assert(true)
  }
  test "HandlerEdgeCase" {
    event on_custom_event(data).
    handler on_custom_event(data) :- print("Event: " + data).
    emit on_custom_event("")
    assert(true)
  }
}

# Goal-Oriented
test "GoalOriented" {
  test "SimpleGoal" {
    goal x = 5
    assert(x == 5)
  }
  test "UnreachableGoal" {
    goal y = 0 where y > 1
    assert(y == 0)
  }
}

# Logic-Based
test "LogicBased" {
  test "AndLogic" {
    assert((true and true) == true)
  }
  test "OrLogic" {
    assert((false or true) == true)
  }
  test "NotLogic" {
    assert((not false) == true)
  }
  test "EdgeCase" {
    assert((true and false) == false)
  }

  # Logical Inferencing Tests
  test "FactAssertion" {
    fact human(socrates).
    assert(human(socrates))
  }
  test "RuleApplication" {
    fact human(socrates).
    rule mortal(X) :- human(X).
    assert(mortal(socrates))
  }
  test "SimpleQuery" {
    fact bird(tweety).
    rule can_fly(X) :- bird(X).
    assert(can_fly(tweety))
  }
  test "InferenceChain" {
    fact a.
    rule b :- a.
    rule c :- b.
    assert(c)
  }
  test "NonTrivialReasoning" {
    fact parent(alice, bob).
    fact parent(bob, carol).
    rule grandparent(X, Y) :- parent(X, Z), parent(Z, Y).
    assert(grandparent(alice, carol))
  }
}

# Functional
test "Functional" {
  test "Map" {
    assert([1,2,3].map(x => x+1) == [2,3,4])
  }
  test "Reduce" {
    assert([1,2,3].reduce((a,b)=>a+b,0) == 6)
  }
  test "EdgeCaseEmpty" {
    assert([].map(x=>x*2) == [])
  }
}

# Object-Oriented
test "OO" {
  test "ClassInstance" {
    class Foo { def bar() = 42 }
    f = Foo()
    assert(f.bar() == 42)
  }
  test "Inheritance" {
    class A { def x() = 1 }
    class B < A { def y() = 2 }
    b = B()
    assert(b.x() == 1 and b.y() == 2)
  }
}

# Contracts
test "Contracts" {
  test "Precondition" {
    def f(x) precondition x > 0 = x*2
    assert(f(2) == 4)
  }
  test "Postcondition" {
    def g(x) postcondition result > 0 = x+1
    assert(g(1) == 2)
  }
  test "FailingPrecondition" {
    try { def h(x) precondition x < 0 = x } catch { assert(true) }
  }
}

# Hierarchical: All paradigms must pass
test "AllParadigms" {
  test "Event" {
    test "EmitEvent" {
      event on_custom_event(data).
      handler on_custom_event(data) :- print("Event: " + data).
      emit on_custom_event("42")
      assert(true)
    }
    test "HandlerEdgeCase" {
      event on_custom_event(data).
      handler on_custom_event(data) :- print("Event: " + data).
      emit on_custom_event("")
      assert(true)
    }
  }
  test "Goal" {
    test "SimpleGoal" {
      goal x = 5
      assert(x == 5)
    }
    test "UnreachableGoal" {
      goal y = 0 where y > 1
      assert(y == 0)
    }
  }
  test "Logic" {
    test "AndLogic" {
      assert((true and true) == true)
    }
    test "OrLogic" {
      assert((false or true) == true)
    }
    test "NotLogic" {
      assert((not false) == true)
    }
    test "EdgeCase" {
      assert((true and false) == false)
    }

    # Logical Inferencing Tests
    test "FactAssertion" {
    test "InferFunctionAsFact" {
      fact returns_incrementer(incr) :- incr = (x) => x + 1.
      returns_incrementer(f)
      assert(f(5) == 6)
    }
    test "InferFunctionFromRule" {
      rule make_multiplier(n, fn) :- fn = (x) => x * n.
      make_multiplier(3, triple)
      assert(triple(4) == 12)
    }
    test "FunctionReturnedAndInvoked" {
      rule choose_op(name, fn) :- name == "inc" -> fn = (x) => x + 1; name == "dec" -> fn = (x) => x - 1.
      choose_op("dec", dec_fn)
      assert(dec_fn(10) == 9)
    }
      fact human(socrates).
      assert(human(socrates))
    }
    test "RuleApplication" {
      fact human(socrates).
      rule mortal(X) :- human(X).
      assert(mortal(socrates))
    }
    test "SimpleQuery" {
      fact bird(tweety).
      rule can_fly(X) :- bird(X).
      assert(can_fly(tweety))
    }
    test "InferenceChain" {
      fact a.
      rule b :- a.
      rule c :- b.
      assert(c)
    }
    test "NonTrivialReasoning" {
      fact parent(alice, bob).
      fact parent(bob, carol).
      rule grandparent(X, Y) :- parent(X, Z), parent(Z, Y).
      assert(grandparent(alice, carol))
    }
  }
  test "Functional" {
    test "Map" {
      assert([1,2,3].map(x => x+1) == [2,3,4])
    }
    test "Reduce" {
      assert([1,2,3].reduce((a,b)=>a+b,0) == 6)
    }
    test "EdgeCaseEmpty" {
      assert([].map(x=>x*2) == [])
    }
  }
  test "OO" {
    test "ClassInstance" {
      class Foo { def bar() = 42 }
      f = Foo()
      assert(f.bar() == 42)
    }
    test "Inheritance" {
      class A { def x() = 1 }
      class B < A { def y() = 2 }
      b = B()
      assert(b.x() == 1 and b.y() == 2)
    }
  }
  test "Contracts" {
    test "Precondition" {
      def f(x) precondition x > 0 = x*2
      assert(f(2) == 4)
    }
    test "Postcondition" {
      def g(x) postcondition result > 0 = x+1
      assert(g(1) == 2)
    }
    test "FailingPrecondition" {
      try { def h(x) precondition x < 0 = x } catch { assert(true) }
    }
  }
}