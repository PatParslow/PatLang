# Patlang Full Pipeline Integration Tests (Refactored for per-test reporting)

#include "../src/interpreter.patlang"
#main {}

# If eval is not globally available, define a stub that raises NotImplementedError
#if not defined(eval) {
#  def eval(_) { raise("NotImplementedError: eval not implemented in test context") }
#}
#puts "[TEST RUNNER DIAG] Running integration tests..."

test "if/else branch assignment: variable is always defined after conditional"
  let x = 10
  if x > 5
    result = "greater"
  else
    # no assignment to result here
  end
  assert(result != nil)
  assert(result == "greater")
end
# Scenario 1: Arithmetic and Assignment
test "arithmetic assignment: x == 42" {
  x = 42
  assert(x == 42)
}
test "arithmetic assignment: y == 43" {
  x = 42
  y = x + 1
  assert(y == 43)
}

# Scenario 2: Control Flow - If/Else
test "if/else: result == 'yes'" {
  if 1 < 2 then {
    result = "yes"
  } else {
    result = "no"
  }
  assert(result == "yes")
}

# Scenario 3: While Loop
test "while loop: sum == 10" {
  sum = 0
  i = 1
  while i <= 4 {
    sum = sum + i
    i = i + 1
  }
  assert(sum == 10)
}

# Scenario 4: Function Definition and Call
test "function call: add(2,3) == 5" {
  def add(a, b) {
    return a + b
  }
  assert(add(2, 3) == 5)
}

# Scenario 5: Recursion - Factorial
test "recursion: factorial(5) == 120" {
  def factorial(n) {
    if n <= 1 {
      return 1
    } else {
      return n * factorial(n - 1)
    }
  }
  assert(factorial(5) == 120)
}

# Scenario 6: Empty Input
test "empty input: no error" {
  # No code, should not error
}

# Scenario 7: Invalid Syntax
test "invalid syntax: SyntaxError is raised" {
  try {
    eval("let = = 5")
    assert(false)
  } catch (e) {
    assert(e.type == "SyntaxError")
  }
}

# Scenario 8: Type Error
test "type error: TypeError is raised" {
  try {
    eval("1 + 'a'")
    assert(false)
  } catch (e) {
    assert(e.type == "TypeError")
  }
}