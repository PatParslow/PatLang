# Interpreter method_missing tests (Refactored for per-test reporting)
include "../src/host_bridge.patlang"

test "missing method on object triggers host fallback" {
  # expect: HostBridge.invoke called with (:IO, :puts, ["hi"], ctx) returns Value("ok")
  # Simulate missing method call and assert host fallback
  result = HostBridge.invoke(:IO, :puts, ["hi"], ctx)
  assert(result == Value("ok"))
}

test "missing method with no host support raises MethodMissing error" {
  # Simulate missing method call with no host support
  try {
    some_obj = Object.new()
    some_obj.nonexistent_method()
    assert(false)
  } catch (e) {
    assert(e.type == "MethodMissing")
  }
}