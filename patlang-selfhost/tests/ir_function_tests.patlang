# IR Function Support Tests
# Tests for FunctionDef, Call, and Return IR instructions and translation

import "../src/ir.patlang"

# Test: FunctionDef IR instruction is well-formed
assert ir_is_well_formed([
  FunctionDef("f", ["x", "y"], [Const(1), Return])
])

# Test: Call IR instruction is well-formed
assert ir_is_well_formed([
  Call("f", 2)
])

# Test: Return IR instruction is well-formed
assert ir_is_well_formed([
  Return
])

# Test: AST→IR translation for a simple function definition
let ast = FunctionNode("add", ["a", "b"], [
  ReturnNode(BinaryOpNode(VariableNode("a"), "+", VariableNode("b")))
])
let ir = ast_to_ir(ast)
assert ir == [FunctionDef("add", ["a", "b"], [LoadLocal("a"), LoadLocal("b"), BinOp(Add), Return])]

# Test: AST→IR translation for a function call
let ast_call = CallNode("add", [NumberNode(2), NumberNode(3)])
let ir_call = ast_to_ir(ast_call)
assert ir_call == [Const(2), Const(3), Call("add", 2)]
