# Lexer tests (comprehensive, per-test reporting)

# --- Test Imports and Helpers ---
include "../src/lexer.patlang"

def lex(src) {
  result = tokenize(src)
  if result is TokenStream {
    return result.tokens
  } else {
    raise("Lexing failed: " + result.message)
  }
}

def IDENT(val)   { {type: "IDENTIFIER", value: val} }
def NUMBER(val)  { {type: "NUMBER", value: val} }
def STRING(val)  { {type: "STRING", value: val} }
def KEYWORD(val) { {type: "KEYWORD", value: val} }
def OP(val)      { {type: "OP", value: val} }
def LPAREN()     { {type: "LPAREN", value: "("} }

# Add main block if required by test runner
main {}

test "identifier token" {
  tokens = lex("foo")
  assert(tokens == [IDENT("foo")])
}

test "number token" {
  tokens = lex("123")
  assert(tokens == [NUMBER("123")])
}

test "string token" {
  tokens = lex('"abc"')
  assert(tokens == [STRING("abc")])
}

test "operator token" {
  tokens = lex("+")
  assert(tokens == [OP("+")])
}

test "delimiter token" {
  tokens = lex("(")
  assert(tokens == [LPAREN()])
}

test "keyword token" {
  tokens = lex("if")
  assert(tokens == [KEYWORD("if")])
}

test "comment ignored" {
  tokens = lex("# this is a comment")
  assert(tokens == [])
}

test "whitespace ignored" {
  tokens = lex("   \t\n")
  assert(tokens == [])
}

test "empty input" {
  tokens = lex("")
  assert(tokens == [])
}

test "unicode identifier" {
  tokens = lex("π")
  assert(tokens == [IDENT("π")])
}

test "long identifier" {
  tokens = lex("a".repeat(100))
  assert(tokens == [IDENT("a".repeat(100))])
}

test "unterminated string error" {
  try {
    lex('"abc')
    assert(false)
  } catch (e) {
    assert(e.type == "LexError")
  }
}

test "invalid character error" {
  try {
    lex("@")
    assert(false)
  } catch (e) {
    assert(e.type == "LexError")
  }
}

test "malformed number error" {
  try {
    lex("12.34.56")
    assert(false)
  } catch (e) {
    assert(e.type == "LexError")
  }
}