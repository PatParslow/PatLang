# OO + Logic + Goals: Person class-like object using built-ins

# Define inference for parent(A, X): both are Person
infer_type_for("parent", 0, "Person")
infer_type_for("parent", 1, "Person")

# Create people
let alice = new("Person", "alice")
let bob = new("Person", "bob")
let carol = new("Person", "carol")

# Set ages
alice.set("age", 35)
bob.set("age", 16)
carol.set("age", 60)

# Facts: parent relationships
fact("parent", alice, bob)
fact("parent", bob, carol)

# Goals (family tree expressed as goals)
goal("ancestor", alice, carol)
goal("ancestor", bob, carol)

# Inferences: set flags via logic/attributes
alice.infer_is_adult()
bob.infer_is_adult()
carol.infer_is_adult()

# Infer if each has a parent using logic facts
bob.infer_relations()
carol.infer_relations()

# Queries for sanity
query("parent", alice, X)
query("parent", bob, X)

# Output something final
print("ready")
