# Demonstrate logical type inference and simple contracts

# Define inference: for parent(A, X), both A and X are Person
infer_type_for("parent", 0, "Person")
infer_type_for("parent", 1, "Person")

# Create a known person via generic constructor and facts, infer that unknowns are also persons
let alice = new("Person", "alice")

# parent facts
fact("parent", alice, bob)
fact("parent", bob, carol)

# Queries to infer X values and promote them to Person objects
query("parent", alice, X)  # infers bob is a Person
query("parent", bob, X)    # infers carol is a Person

# Define a contract for Person.set: (string, number)
contract("Person.set", "string", "number")

# Now the following should be allowed by the contract and use inferred persons
bob.set("age", 20)
carol.set("age", 55)

# This should violate the contract (expects number) and be ignored
bob.set("age", "not-a-number")

print("ok")
