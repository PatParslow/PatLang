# OO + Logic mix example for Patlang

fn Person(name) { return name }

let alice = "alice"
let bob = "bob"
let carol = "carol"

# Facts
fact("parent", alice, bob)
fact("parent", bob, carol)

# Queries (the test harness will process these)
query("parent", alice, X)
query("parent", bob, X)

print("done")
