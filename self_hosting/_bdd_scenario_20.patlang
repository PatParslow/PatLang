
make a function called fib takes n returns r
  if n < 2 then
    return n
  else
    return fib(n - 1) + fib(n - 2)
  end
end
new("Counter", "c1")
send("c1", "set", "v", 0)
let i = 0
while i < 5 do
  send("c1", "set", "v", get("c1", "v") + fib(i))
  let i = i + 1
end
print(get("c1", "v"))
print(10 / 4)
print(sqrt(2) * sqrt(2))
