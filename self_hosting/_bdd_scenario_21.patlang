include "lib/utf8.patlang"
include "lib/lean_lexer.patlang"
include "lib/lean_parser.patlang"
include "lib/lean_emit.patlang"

# lean_selftest.patlang -- BDD-wired selftest for the Lean 4 PatLang library.
# Run via: pat --ir-run self_hosting/lean_selftest.patlang
#
# Outputs "ALL TESTS PASSED\n0 failed" on success.

let pass = 0
let fail = 0

make a function called check takes label, got, expected returns r
  if got == expected then
    let pass = pass + 1
  else
    print("FAIL: " + label)
    print("  expected: " + to_str(expected))
    print("  got:      " + to_str(got))
    let fail = fail + 1
  end
end

make a function called check_contains takes label, haystack, needle returns r
  let found = false
  let i = 0
  while i <= (haystack.length - needle.length) do
    if substr(haystack, i, needle.length) == needle then
      let found = true
    end
    let i = i + 1
  end
  if found then
    let pass = pass + 1
  else
    print("FAIL: " + label + " -- needle not found in haystack")
    print("  needle:   " + needle)
    print("  haystack: " + haystack)
    let fail = fail + 1
  end
end

# ============================================================
# 1. Lexer tests
# ============================================================

let src1 = "import Mathlib"
let toks1 = lean_tokenize(src1)
check("lex import: tok count >= 2", vec_len(toks1) >= 2, true)
check("lex import: tok0 type", (vec_get(toks1, 0))[0], "KEYWORD")
check("lex import: tok0 text", (vec_get(toks1, 0))[1], "import")
check("lex import: tok1 type", (vec_get(toks1, 1))[0], "IDENT")
check("lex import: tok1 text", (vec_get(toks1, 1))[1], "Mathlib")

let src2 = "def foo : Nat := 42"
let toks2 = lean_tokenize(src2)
check("lex def: kw", (vec_get(toks2, 0))[1], "def")
check("lex def: name", (vec_get(toks2, 1))[1], "foo")
check("lex def: colon", (vec_get(toks2, 2))[1], ":")
check("lex def: type", (vec_get(toks2, 3))[1], "Nat")
check("lex def: assign", (vec_get(toks2, 4))[1], ":=")
check("lex def: num", (vec_get(toks2, 5))[1], "42")

# line comment
let src3 = "-- this is a comment\ndef bar := 1"
let toks3 = lean_tokenize(src3)
let first3 = (vec_get(toks3, 0))[0]
check("lex line comment type", first3, "LINE_COMMENT")

# numeric literal
let src4 = "42 3.14 0xFF"
let toks4 = lean_tokenize(src4)
check("lex num int",   (vec_get(toks4, 0))[1], "42")
check("lex num float", (vec_get(toks4, 1))[1], "3.14")
check("lex num hex",   (vec_get(toks4, 2))[1], "0xFF")

# string literal
let src5 = "\"hello world\""
let toks5 = lean_tokenize(src5)
check("lex str type", (vec_get(toks5, 0))[0], "STR")
check("lex str text", (vec_get(toks5, 0))[1], "\"hello world\"")

# multi-char ops
let src6 = ":= := <;"
let toks6 = lean_tokenize(src6)
check("lex op :=", (vec_get(toks6, 0))[1], ":=")

# Unicode ident (alpha = U+03B1, UTF-8: 0xCE 0xB1)
let alpha_str = utf8_encode(945)
let src7 = alpha_str + " : Nat"
let toks7 = lean_tokenize(src7)
check("lex unicode ident type", (vec_get(toks7, 0))[0], "IDENT")
check("lex unicode ident text", (vec_get(toks7, 0))[1], alpha_str)

# block comment
let src8 = "/- this is a block comment -/ def x := 1"
let toks8 = lean_tokenize(src8)
check("lex block comment type", (vec_get(toks8, 0))[0], "BLOCK_COMMENT")

# EOF always present
check("lex EOF at end", (vec_get(toks1, vec_len(toks1) - 1))[0], "EOF")

# ============================================================
# 2. Parser tests
# ============================================================

# import
let p_src1 = "import Mathlib"
let p_ast1 = lean_parse(lean_tokenize(p_src1))
check("parse file tag", p_ast1[0], "file")
let p_cmds1 = p_ast1[1]
check("parse import cmd", p_cmds1[0][0], "import")
check("parse import path", p_cmds1[0][1], "Mathlib")

# multiple imports
let p_src2 = "import Mathlib\nimport Lean"
let p_ast2 = lean_parse(lean_tokenize(p_src2))
let p_imports = lean_file_imports(p_ast2)
check("parse imports count", to_num(list_len(p_imports)), 2)
check("parse imports[0]", p_imports[0], "Mathlib")
check("parse imports[1]", p_imports[1], "Lean")

# set_option
let p_src3 = "set_option maxHeartbeats 800000"
let p_ast3 = lean_parse(lean_tokenize(p_src3))
let p_opt = lean_set_option_val(p_ast3, "maxHeartbeats")
check("parse set_option", p_opt, "800000")

# open
let p_src4 = "open Filter MeasureTheory"
let p_ast4 = lean_parse(lean_tokenize(p_src4))
let p_open = lean_find_command(p_ast4, "open")
check("parse open tag", p_open[0], "open")
check("parse open names count", to_num(list_len(p_open[1])), 2)

# def
let p_src5 = "def myDef : Nat := 42"
let p_ast5 = lean_parse(lean_tokenize(p_src5))
let p_def = lean_find_command(p_ast5, "def")
check("parse def tag", p_def[0], "def")
check("parse def name", p_def[2], "myDef")

# theorem
let p_src6 = "theorem myThm : 1 = 1 := by rfl"
let p_ast6 = lean_parse(lean_tokenize(p_src6))
let p_thm = lean_find_command(p_ast6, "theorem")
check("parse theorem tag", p_thm[0], "theorem")
check("parse theorem name", p_thm[2], "myThm")

# lean_file_theorems
let p_src7 = "theorem t1 : True := trivial\ntheorem t2 : True := trivial"
let p_ast7 = lean_parse(lean_tokenize(p_src7))
let p_thms = lean_file_theorems(p_ast7)
check("parse theorems count", to_num(list_len(p_thms)), 2)
check("parse theorems[0] name", p_thms[0][0], "t1")
check("parse theorems[1] name", p_thms[1][0], "t2")

# namespace
let p_src8 = "namespace MyNS\ndef foo := 1\nend MyNS"
let p_ast8 = lean_parse(lean_tokenize(p_src8))
let p_ns = lean_find_command(p_ast8, "namespace")
check("parse namespace tag", p_ns[0], "namespace")
check("parse namespace name", p_ns[1], "MyNS")
check("parse namespace inner count", to_num(list_len(p_ns[2])) >= 1, true)

# noncomputable def
let p_src9 = "noncomputable def myNc : Real := 0"
let p_ast9 = lean_parse(lean_tokenize(p_src9))
let p_nc = lean_find_command(p_ast9, "def")
check("parse noncomputable def tag", p_nc[0], "def")
check("parse noncomputable def mods", p_nc[1][0], "noncomputable")

# ============================================================
# 3. Emitter tests
# ============================================================

# import round-trip
let e_ast1 = ["file", [["import", "Mathlib"]]]
let e_out1 = lean_emit(e_ast1)
check_contains("emit import", e_out1, "import Mathlib")

# set_option round-trip
let e_ast2 = ["file", [["set_option", "maxHeartbeats", "800000"]]]
let e_out2 = lean_emit(e_ast2)
check_contains("emit set_option", e_out2, "set_option maxHeartbeats 800000")

# open round-trip
let e_ast3 = ["file", [["open", ["Filter", "MeasureTheory"], false]]]
let e_out3 = lean_emit(e_ast3)
check_contains("emit open", e_out3, "open Filter MeasureTheory")

# def round-trip
let e_ast4 = ["file", [["def", [], "myDef", null, ["ident", "Nat"], ["num", "42"]]]]
let e_out4 = lean_emit(e_ast4)
check_contains("emit def name", e_out4, "def myDef")
check_contains("emit def type", e_out4, ": Nat")

# parse → emit preserves import
let e_src5 = "import Mathlib\nimport Lean\n"
let e_ast5 = lean_parse(lean_tokenize(e_src5))
let e_out5 = lean_emit(e_ast5)
check_contains("round-trip imports Mathlib", e_out5, "import Mathlib")
check_contains("round-trip imports Lean", e_out5, "import Lean")

# parse → emit preserves set_option
let e_src6 = "set_option maxHeartbeats 800000\n"
let e_ast6 = lean_parse(lean_tokenize(e_src6))
let e_out6 = lean_emit(e_ast6)
check_contains("round-trip set_option", e_out6, "set_option maxHeartbeats 800000")

# ============================================================
# 4. Multi-feature snippet (mirrors SpherePacking.lean header)
# ============================================================

let big_src = "import Mathlib\n\nnamespace CohnElkies\n\nset_option maxHeartbeats 800000\n\nopen Filter MeasureTheory\n\nnoncomputable def unitBallVolume (d : Nat) : Real :=\n  0\n\nend CohnElkies\n"
let big_ast = lean_parse(lean_tokenize(big_src))
check("big: file tag", big_ast[0], "file")
let big_imports = lean_file_imports(big_ast)
check("big: import Mathlib", big_imports[0], "Mathlib")

# ============================================================
# Summary
# ============================================================

if fail == 0 then
  print("ALL TESTS PASSED")
  print("0 failed")
else
  print(to_str(fail) + " FAILED")
  print("passed: " + to_str(pass))
end
