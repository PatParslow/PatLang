# Compiles both bench_*_x64.patlang benchmarks through the x64 backend
# to standalone .exe files, for the interpreter-vs-rustc-vs-x64 timing
# comparison. Run from the repo root:
#   rust-runtime/target/release/pat --ir-run self_hosting/bench_x64_driver.patlang

include "lib/lexer.patlang"
include "lib/parser.patlang"
include "lib/lower.patlang"
include "lib/codegen_x64.patlang"

let rt = read_file("self_hosting/lib/x64_runtime.patlang")

let src1 = rt + chr(10) + read_file("self_hosting/examples/bench_loop_x64.patlang")
let toks1 = tokenize(src1)
let ast1 = parse_program(toks1)
let ir1 = lower_program(ast1)
let asm1 = emit_program_x64(ir1, true, [])
write_file("self_hosting/build/bench_loop_x64.asm", asm1)
print("wrote bench_loop_x64.asm")

let src2 = rt + chr(10) + read_file("self_hosting/examples/bench_fib_x64.patlang")
let toks2 = tokenize(src2)
let ast2 = parse_program(toks2)
let ir2 = lower_program(ast2)
let asm2 = emit_program_x64(ir2, true, [])
write_file("self_hosting/build/bench_fib_x64.asm", asm2)
print("wrote bench_fib_x64.asm")
