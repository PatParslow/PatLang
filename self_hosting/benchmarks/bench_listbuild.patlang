# Uses the mutable vec_* handle API (vec_new/vec_push/vec_get/vec_len), not
# list_push -- list_push returns a NEW list on every call (copy-on-append),
# which would make building a 500,000-element list O(n^2). vec_* is the
# idiomatic, O(1)-amortized-append way to build a large collection.
let v = vec_new()
let i = 0
while i < 2000000 do
  vec_push(v, i)
  let i = i + 1
end

let total = 0
let j = 0
let n = vec_len(v)
while j < n do
  let total = total + vec_get(v, j)
  let j = j + 1
end
print(total)
