# Create N objects, register one event handler, fire N events (one per
# object), each event bumping that object's "v" property by 1, then sum all
# "v" properties. Rust baseline: benches_src/oo_events_rust.rs.
make a function called obj_name takes i returns name
  return "obj" + i
end

let n = 50000
let i = 0
while i < n do
  new("Counter", obj_name(i))
  send(obj_name(i), "set", "v", i)
  let i = i + 1
end

when bump do
  let name = "obj" + event_data
  let cur = get(name, "v")
  send(name, "set", "v", cur + 1)
end

let j = 0
while j < n do
  emit("bump", j)
  let j = j + 1
end

let total = 0
let k = 0
while k < n do
  let total = total + get(obj_name(k), "v")
  let k = k + 1
end
print(total)
