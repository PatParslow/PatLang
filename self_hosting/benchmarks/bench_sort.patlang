# Manual quicksort on a vec_* handle (mutable, in-place swaps via
# vec_get/vec_set), matching the Rust baseline's manual quicksort (not
# Vec::sort_unstable) -- an algorithm-implementation comparison, not a
# "Rust's std library is fast" comparison.
make a function called quicksort takes v, lo, hi returns done
  if lo < hi then
    let pivot = vec_get(v, hi)
    let i = lo - 1
    let j = lo
    while j < hi do
      if vec_get(v, j) < pivot then
        let i = i + 1
        let tmp = vec_get(v, i)
        vec_set(v, i, vec_get(v, j))
        vec_set(v, j, tmp)
      end
      let j = j + 1
    end
    let tmp2 = vec_get(v, i + 1)
    vec_set(v, i + 1, vec_get(v, hi))
    vec_set(v, hi, tmp2)
    let p = i + 1
    quicksort(v, lo, p - 1)
    quicksort(v, p + 1, hi)
  end
  return true
end

let n = 50000
let v = vec_new()
let i = 0
while i < n do
  # Deterministic pseudo-shuffle (Knuth multiplicative hash), so both
  # languages sort identical data without needing true randomness.
  let val = (i * 2654435761) % 1000000
  vec_push(v, val)
  let i = i + 1
end

quicksort(v, 0, n - 1)
print(vec_get(v, 0) + " " + vec_get(v, n - 1))
