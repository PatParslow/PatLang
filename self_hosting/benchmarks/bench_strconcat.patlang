# PatLang has no mutable string-builder primitive -- `+` is the only way to
# build a string incrementally, so this IS the idiomatic PatLang path
# (unlike the Rust baseline, which uses String::push_str, its own idiomatic
# path). The comparison is deliberately asymmetric: each language's actual
# idiomatic approach to "build a big string a piece at a time".
let s = ""
let i = 0
while i < 400000 do
  let s = s + "x"
  let i = i + 1
end
print(s.length)
