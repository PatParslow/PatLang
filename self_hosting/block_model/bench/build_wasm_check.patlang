# Block Ownership Model: checks the same block/jump mechanism Phase 9
# proved for the self-hosted x64 backend (self_hosting/lib/
# codegen_x64.patlang) ALSO works through the completely separate
# Rust-source-generation backend (self_hosting/lib/codegen.patlang's own
# emit_program_rs, mirroring rust-runtime/src/ir/codegen.rs), which is
# what actually compiles to WASM (via rustc --target wasm32-wasip1) --
# checked directly, not assumed: PatLang's WASM story is NOT the
# self-hosted x64 backend targeting wasm somehow, it's an entirely
# different code generator.
#
# Reuses native_codegen.patlang's own bm_to_real_funcir UNCHANGED for the
# actual block-model translation (concatenate blocks, expand JumpBlock,
# fix up jump targets) -- only the print_op parameter differs from the
# x64 driver, since the two backends disagree about whether `print` is
# an ordinary Call (x64_runtime.patlang defines it as a real PatLang
# function) or a genuine CallHost (codegen.patlang's own host_chunk_of
# maps "print" to its "io_misc" chunk) -- found by checking each
# backend's own source, not assumed uniform.
#
# Usage: rust-runtime/target/release/pat.exe --ir-run
#        self_hosting/block_model/bench/build_wasm_check.patlang <source.patlang> <out.wasm>

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../../lib/codegen.patlang"
include "../../lib/runtime_rs.patlang"
include "../lower.patlang"
include "../native_codegen.patlang"

# NOT `include "../../lib/x64_runtime.patlang"` for rustc_build/
# rt_rustc_run -- found, not assumed, that it can't be included directly
# into an ordinary --ir-run script at all: it has a parameter named a
# real reserved keyword ("class" or "rule") in the OUTER native Rust
# parser used for ordinary driver scripts, fine only because it's
# normally consumed exclusively via patc1.exe's own internal self-hosted
# lexer/parser pipeline (a different, older dialect), never included
# directly like this. Confirmed in isolation
# (self_hosting/block_model/bench/diag_x64rt_only.patlang) before
# concluding it wasn't something this driver's own combination caused.
# rt_rustc_run's own logic is small enough to just inline here instead.
make a function called bm_rustc_build takes rust_src, out_path, target returns code
  let src_path = out_path + ".rs"
  write_file(src_path, rust_src)
  let pid = spawn("rustc", src_path, "--crate-name", "bm_wasm_check", "-C", "opt-level=z", "-C", "strip=symbols", "-o", out_path, "--target", target)
  return wait(pid)
end

let args = argv()
let src_path = list_get(args, 0)
let out_path = list_get(args, 1)

let bm_src = read_file(src_path)
let bm_toks = tokenize(bm_src)
let bm_ast = parse_program(bm_toks)
let bm_prog = bm_lower_program(bm_ast)
let main_funcir = bm_to_real_funcir(bm_prog, "CallHost")

let program_ir = ["ProgramIR", "main", [main_funcir], []]
let rust_src = emit_program_rs(program_ir)

let code = bm_rustc_build(rust_src, out_path, "wasm32-wasip1")
print("rustc exit code: " + code)
