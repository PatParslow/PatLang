# Exploration-scaling benchmark (GitHub issue #179). Explores a bounded counter
# schema whose reachable state count is exactly K + 1 (n runs 0..K, Inc and Dec)
# at K = 100, 200, 400, 800 and prints "<K> <ms>" pairs, one number per line
# (K, then ms). Linear exploration makes ms roughly double as K doubles; a
# quadratic visited set would make it about quadruple. The same file runs under
# `pat --ir-run` and through the block-model engine:
#   rust-runtime/target/release/pat.exe --ir-run self_hosting/block_model/bench/explore_scaling.patlang
#   rust-runtime/target/release/pat.exe --ir-run self_hosting/block_model/spec_fixtures/selftest_under_block_model.patlang self_hosting/block_model/bench/explore_scaling.patlang

include "../../lib/zs_explore.patlang"

make a function called counter_text takes k returns text
  return "schema Counter
state n
init n = 0
invariant n >= 0 and n <= " + k + "
operation Inc()
  require n < " + k + "
  ensure n' == n + 1
end
operation Dec()
  require n > 0
  ensure n' == n - 1
end
"
end

make a function called explore_ms takes k returns ms
  zs_load(counter_text(k))
  let t0 = now_ms()
  let d = zs_explore("Counter", 100000)
  let t1 = now_ms()
  if d[0] != "ok" then
    print("exploration did not come back clean at K=" + k)
  end
  return t1 - t0
end

let ks = [100, 200, 400, 800]
let ki = 0
while ki < list_len(ks) do
  let k = list_get(ks, ki)
  print(k)
  print(explore_ms(k))
  let ki = ki + 1
end
