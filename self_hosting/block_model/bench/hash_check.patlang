make a function called bm_op_hash takes s returns h
  let hash = 5381
  let n = s.length
  let i = 0
  while i < n do
    let hash = (hash * 33 + char_code(s, i)) % 1000003
    let i = i + 1
  end
  return hash
end

let names = ["Const", "Load", "Store", "Bin", "Un", "JumpIfFalse", "Jump", "Print",
  "BoxNew", "BoxGet", "BoxSet", "BoxSetUnchecked", "BoxShare", "ContractFail",
  "GlobalGet", "GlobalSet", "HandlerNew", "HandlerRegister", "HandlerLookup", "JumpBlock",
  "Emit", "FiberYield",
  "+", "-", "*", "/", "%", "==", "!=", "<", "<=", ">", ">=", "not"]

let seen = []
let collision = false
let i = 0
while i < list_len(names) do
  let name = list_get(names, i)
  let h = bm_op_hash(name)
  print(name + " -> " + h)
  if list_len(seen) > 0 then
    let j = 0
    while j < list_len(seen) do
      if list_get(list_get(seen, j), 1) == h then
        print("COLLISION: " + name + " and " + list_get(list_get(seen, j), 0))
        let collision = true
      end
      let j = j + 1
    end
  end
  let seen = list_push(seen, [name, h])
  let i = i + 1
end
print("collision found: " + collision)
