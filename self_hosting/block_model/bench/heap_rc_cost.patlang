# Cost of the atomic refcount (issue #176, option (a)) on the SINGLE-threaded
# path: ten million inc/dec pairs on one block, timed. Native only.
# Usage: ./patc1.exe self_hosting/block_model/bench/heap_rc_cost.patlang out.exe --x64
include "../heap.patlang"

bm_heap_init()
let p = bm_alloc(8)
let n = 10000000
let t0 = now_ms()
let i = 0
while i < n do
  bm_rc_inc(p)
  bm_rc_dec(p, 8)
  let i = i + 1
end
print(now_ms() - t0)
print(bm_rc_get(p))
