# Cost of persistent lists on the native x64 backend (GitHub #145). Prints
# milliseconds for: 2,000,000 accumulating pushes; 2,000,000 indexed reads of the
# result; 1,000,000 in-place-pattern list_set calls on a 100,000-element list.
# Usage: ./patc1.exe self_hosting/block_model/bench/list_native_cost.patlang out.exe --x64
let t0 = now_ms()
let a = []
let i = 0
while i < 2000000 do
  let a = list_push(a, i)
  let i = i + 1
end
print(now_ms() - t0)
let t1 = now_ms()
let s = 0
let j = 0
while j < 2000000 do
  let s = s + a[j]
  let j = j + 1
end
print(now_ms() - t1)
let b = []
let k = 0
while k < 100000 do
  let b = list_push(b, 0)
  let k = k + 1
end
let t2 = now_ms()
let m = 0
while m < 1000000 do
  let b = list_set(b, m % 100000, m)
  let m = m + 1
end
print(now_ms() - t2)
print(s)
