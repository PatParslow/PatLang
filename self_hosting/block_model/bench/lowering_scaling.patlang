# Lowering-scaling benchmark (GitHub issue #156). For each statement shape it
# lowers a source of N statements at N = 2000 and 8000 and prints three lines per
# shape: the shape name, the ms at 2000, the ms at 8000. Only bm_lower_program is timed;
# lexing and parsing are done first. Linear lowering makes the second number
# about 4x the first; quadratic makes it about 16x. Sources are built with
# sb_new/sb_push, never `s = s + ...`.
#
# Usage: rust-runtime/target/release/pat.exe --ir-run self_hosting/block_model/bench/lowering_scaling.patlang

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"

make a function called scaling_source takes shape, n returns src
  let b = sb_new()
  if shape == "many_functions" then
    let i = 0
    while i < n do
      sb_push(b, "make a function called f" + i + " takes x returns r\n  return x + " + i + "\nend\n")
      let i = i + 1
    end
    sb_push(b, "make a function called start returns r\n  return f0(1)\nend\n")
    return sb_str(b)
  end
  sb_push(b, "make a function called start returns r\n  let acc = 0\n")
  if shape == "if_branch" then
    sb_push(b, "  if acc == 0 then\n")
  end
  let i = 0
  while i < n do
    if shape == "prints" then
      sb_push(b, "  print(" + i + ")\n")
    elif shape == "lets" then
      sb_push(b, "  let v" + (i % 20) + " = " + i + "\n")
    elif shape == "if_branch" then
      sb_push(b, "    print(" + i + ")\n")
    elif shape == "sequential_ifs" then
      sb_push(b, "  if acc == " + i + " then\n    print(" + i + ")\n  end\n")
    end
    let i = i + 1
  end
  if shape == "if_branch" then
    sb_push(b, "  end\n")
  end
  sb_push(b, "  return acc\nend\n")
  return sb_str(b)
end

make a function called scaling_time_ms takes shape, n returns ms
  let ast = parse_program(tokenize(scaling_source(shape, n)))
  let t0 = now_ms()
  let ir = bm_lower_program(ast)
  return now_ms() - t0
end

let shapes = ["prints", "lets", "if_branch", "sequential_ifs", "many_functions"]
let si = 0
while si < list_len(shapes) do
  let shape = list_get(shapes, si)
  print(shape)
  print(scaling_time_ms(shape, 2000))
  print(scaling_time_ms(shape, 8000))
  let si = si + 1
end
