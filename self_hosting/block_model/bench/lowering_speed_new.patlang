# Compilation-speed report, NEW side: the SAME source, SAME iteration
# count, through self_hosting/block_model/lower.patlang's own
# bm_lower_program (which itself includes free_vars.patlang and
# flight_check.patlang -- real analysis work, not a stub) instead of the
# real lower_program.

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"

let src = read_file("self_hosting/block_model/bench/new_sum_loop_100000.patlang")
let iters = 2000
let t0 = now_ms()
let i = 0
while i < iters do
  let toks = tokenize(src)
  let ast = parse_program(toks)
  let ir = bm_lower_program(ast)
  let i = i + 1
end
let total_ms = now_ms() - t0
print("NEW self-hosted lex+parse+bm_lower: " + iters + " iters, " + total_ms + " ms total")
