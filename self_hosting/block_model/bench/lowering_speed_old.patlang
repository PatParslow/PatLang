# Compilation-speed report, OLD side: the real, unedited self-hosted
# lex+parse+lower pipeline (self_hosting/lib/{lexer,parser,lower}
# .patlang), timed over many iterations of the SAME small source
# (bench/new_sum_loop_100000.patlang -- restricted-subset-compatible so
# the NEW side can lower the identical text) to amortize scheduler
# noise on what would otherwise be a near-instant single measurement.
# Necessarily a SMALL program: this is the largest common ground the
# NEW engine's own restricted lowerer can express (a real, disclosed
# limit on this whole comparison, not chosen for the OLD system's own
# sake -- it would happily lower something far larger).

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../../lib/lower.patlang"

let src = read_file("self_hosting/block_model/bench/new_sum_loop_100000.patlang")
let iters = 2000
let t0 = now_ms()
let i = 0
while i < iters do
  let toks = tokenize(src)
  let ast = parse_program(toks)
  let ir = lower_program(ast)
  let i = i + 1
end
let total_ms = now_ms() - t0
print("OLD self-hosted lex+parse+lower: " + iters + " iters, " + total_ms + " ms total")
