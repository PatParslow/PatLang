# Native-compiled driver for the NEW engine: bundles the whole new
# engine's own source (lexer/parser are the REAL, unedited ones; lower/
# interp are the new, self-hosted ones) into ONE compiled .exe that
# reads, lowers, and runs new_sum_loop_800000.patlang at RUNTIME -- the
# native half of "still interprets the block IR" (Phase 9, native codegen
# for the block-model IR itself, is deliberately deferred).

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let src = read_file("self_hosting/block_model/bench/new_sum_loop_800000.patlang")
let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)
bi_run(prog)
