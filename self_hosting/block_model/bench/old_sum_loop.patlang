# Benchmark source for the OLD (existing) pipeline: a plain PatLang
# program, N taken from argv so ONE build (native) or ONE file
# (interpreted) covers every scale point without recompiling.
#
# Deliberately restricted to constructs the NEW block-model engine's own
# restricted subset can ALSO express (arithmetic, while, print) for the
# runtime-shape comparison to be apples-to-apples -- only the N-via-argv
# plumbing differs, because self_hosting/block_model/lower.patlang has no
# argv/Index support at all (a real, disclosed gap, not an oversight).

let n = to_num(argv()[0])
let sum = 0
let i = 0
while i < n do
  let sum = sum + i
  let i = i + 1
end
print(sum)
