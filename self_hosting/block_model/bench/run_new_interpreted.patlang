# Runs a block-model-compatible source file (path given via argv) through
# tokenize/parse_program/bm_lower_program/bi_run. This wrapper itself is
# ordinary PatLang (argv/read_file are fine here -- it's not going
# through the restricted lowerer, only the FILE IT LOADS is).

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let path = argv()[0]
let src = read_file(path)
let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)
bi_run(prog)
