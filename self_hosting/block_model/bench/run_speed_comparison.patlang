# Block Ownership Model: speed comparison against the existing pipeline.
# Two reports: compilation/lowering speed, and runtime speed (interpreted
# scaling curve + a native snapshot). Run from the repo root:
#   rust-runtime/target/release/pat.exe --ir-run self_hosting/block_model/bench/run_speed_comparison.patlang
#
# Methodology notes (read before trusting any single number here):
# - All process-level timings are wall-clock via now_ms() wrapping
#   exec_capture, so they include process-startup overhead -- real for
#   small N, increasingly negligible as N grows, which is why the runtime
#   report uses large N (100k-800k) rather than trivial loop counts.
# - The OLD system's benchmark source uses argv() for N (one file, one
#   build, every scale point); the NEW system's restricted lowerer has no
#   argv/Index support at all (a real, disclosed gap -- self_hosting/
#   block_model/lower.patlang's own header), so N is baked into
#   per-size source files instead (bench/new_sum_loop_<N>.patlang).
# - "NEW interpreted" is DOUBLE interpretation: the Rust interpreter
#   running self_hosting/block_model/{lower,interp}.patlang's OWN PatLang
#   code, which itself interprets the block-model IR. "OLD interpreted"
#   is the Rust interpreter running the program DIRECTLY -- ONE layer.
#   This asymmetry is real and expected: Phase 9 (native codegen for the
#   block-model engine) was deliberately deferred, so there is currently
#   no way to avoid that second layer. The numbers below should be read
#   as measuring exactly that gap, not as a verdict on the design.

let pat_exe = "rust-runtime/target/release/pat.exe"
let patc1_exe = "./patc1.exe"

print("=========================================================")
print("REPORT 1: compilation / lowering speed")
print("=========================================================")

print("")
print("-- self-hosted lex+parse+lower, run via --ir-run (no process-spawn overhead, in-process now_ms()) --")
print(exec_capture(pat_exe, "--ir-run", "self_hosting/block_model/bench/lowering_speed_old.patlang"))
print(exec_capture(pat_exe, "--ir-run", "self_hosting/block_model/bench/lowering_speed_new.patlang"))

print("")
print("-- native (patc1.exe --x64) full build wall-clock, one representative program --")
let t0 = now_ms()
exec_capture(patc1_exe, "self_hosting/block_model/bench/old_sum_loop.patlang", "self_hosting/build/bench_old_native.exe", "--x64")
let old_build_ms = now_ms() - t0
print("OLD native build: " + old_build_ms + " ms")

let t1 = now_ms()
exec_capture(patc1_exe, "self_hosting/block_model/bench/new_native_driver.patlang", "self_hosting/build/bench_new_native.exe", "--x64")
let new_build_ms = now_ms() - t1
print("NEW native build: " + new_build_ms + " ms")

print("")
print("=========================================================")
print("REPORT 2: runtime speed")
print("=========================================================")

print("")
print("-- interpreted scaling curve (wall-clock, includes process startup) --")
let sizes = [100000, 200000, 400000, 800000]
let i = 0
while i < list_len(sizes) do
  let n = list_get(sizes, i)
  let t2 = now_ms()
  exec_capture(pat_exe, "--ir-run", "self_hosting/block_model/bench/old_sum_loop.patlang", "" + n)
  let old_ms = now_ms() - t2

  let new_file = "self_hosting/block_model/bench/new_sum_loop_" + n + ".patlang"
  let t3 = now_ms()
  exec_capture(pat_exe, "--ir-run", "self_hosting/block_model/bench/run_new_interpreted.patlang", new_file)
  let new_ms = now_ms() - t3

  print("N=" + n + "   OLD interpreted=" + old_ms + "ms   NEW interpreted (double)=" + new_ms + "ms")
  let i = i + 1
end

print("")
print("-- native snapshot at N=800000 (already built above) --")
let t4 = now_ms()
exec_capture("self_hosting/build/bench_old_native.exe", "800000")
let old_native_ms = now_ms() - t4
print("OLD native: " + old_native_ms + " ms")

let t5 = now_ms()
exec_capture("self_hosting/build/bench_new_native.exe")
let new_native_ms = now_ms() - t5
print("NEW native (bi_run compiled, still interprets the block IR): " + new_native_ms + " ms")
