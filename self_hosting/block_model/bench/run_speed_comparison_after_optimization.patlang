# Re-measurement after the opcode-hash-dispatch optimization
# (block_ir.patlang's bm_op_hash + lower.patlang's bm_hash_rewrite_instrs
# + interp.patlang's own dispatch chain now comparing integer hashes
# instead of opcode strings). A first attempt at this same goal --
# slot-indexed locals -- was tried first, measured to make the native
# case slightly WORSE (added wrapper indirection cost exceeded the
# saved comparison cost, since this benchmark only has 2-3 locals per
# block), and reverted; see docs/reports/block-ownership-model-speed-
# comparison.md for that full account. Same methodology, same
# benchmark, same sizes as run_speed_comparison.patlang (the original
# report) -- only the NEW engine changed, so only NEW numbers are
# re-measured here.

let pat_exe = "rust-runtime/target/release/pat.exe"
let patc1_exe = "./patc1.exe"

print("-- interpreted scaling curve, NEW only --")
let sizes = [100000, 200000, 400000, 800000]
let i = 0
while i < list_len(sizes) do
  let n = list_get(sizes, i)
  let new_file = "self_hosting/block_model/bench/new_sum_loop_" + n + ".patlang"
  let t0 = now_ms()
  exec_capture(pat_exe, "--ir-run", "self_hosting/block_model/bench/run_new_interpreted.patlang", new_file)
  let new_ms = now_ms() - t0
  print("N=" + n + "   NEW interpreted (double, hash-dispatch)=" + new_ms + "ms")
  let i = i + 1
end

print("")
print("-- native rebuild + snapshot at N=800000 --")
let t1 = now_ms()
exec_capture(patc1_exe, "self_hosting/block_model/bench/new_native_driver.patlang", "self_hosting/build/bench_new_native.exe", "--x64")
let build_ms = now_ms() - t1
print("NEW native build (hash-dispatch): " + build_ms + " ms")

let t2 = now_ms()
exec_capture("self_hosting/build/bench_new_native.exe")
let run_ms = now_ms() - t2
print("NEW native run (bi_run compiled, hash-dispatch): " + run_ms + " ms")
