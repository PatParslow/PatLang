# The block-model engine's boxes on v2's own allocator (docs/spec/values-and-memory.md).
#
# heap.patlang built boxes over the old native runtime's raw bump heap, with
# its own free lists. v2's rt_alloc already gives a block with a count word
# and keeps freed blocks on per-thread lists, so a box is one such block:
# [count:8][size:8][value:16]. A box pointer is the block's address, an int,
# and its value is held with a reference of its own (mem_init_value), so a
# box can hold any value, not only a machine word.
#
# The engine (interp.patlang) uses bm_heap_init, bm_alloc, bm_box_read,
# bm_box_write, bm_rc_inc and bm_rc_touch_for_mutation; bm_rc_get and
# bm_rc_dec complete the set.

# Nothing to set up: rt_alloc's lists belong to the runtime.
make a function called bm_heap_init returns done
  let done = true
  ensure done == true
  return done
end

# A box's block, its count 1 and its value unit.
make a function called bm_alloc takes payload_size returns ptr
  require payload_size == 8
  let ptr = rt_alloc(16)
  mem_init_value(ptr, 16, unit)
  ensure (ptr != 0) and (mem_load(ptr, 0) == 1)
  return ptr
end

make a function called bm_rc_get takes ptr returns n
  require ptr != 0
  let n = mem_load(ptr, 0)
  ensure n >= 0
  return n
end

make a function called bm_rc_inc takes ptr returns n
  require (ptr != 0) and (mem_load(ptr, 0) >= 1)
  let n = atomic_add(ptr, 1) + 1
  ensure n >= 2
  return n
end

# The box's value goes with its last reference.
make a function called bm_rc_dec takes ptr, payload_size returns n
  require (ptr != 0) and (payload_size == 8)
  let n = atomic_add(ptr, 0 - 1) - 1
  if n < 0 then
    print("bm_rc_dec: reference count below zero (a block released twice)")
    exit_with(95)
  end
  if n == 0 then
    let old = mem_take_value(ptr, 16)
    rt_free(ptr)
  end
  ensure n >= 0
  return n
end

make a function called bm_box_read takes ptr returns v
  require (ptr != 0) and (mem_load(ptr, 0) >= 1)
  let v = mem_load_value(ptr, 16)
  ensure true
  return v
end

make a function called bm_box_write takes ptr, v returns done
  require (ptr != 0) and (mem_load(ptr, 0) >= 1)
  mem_store_value(ptr, 16, v)
  let done = true
  ensure done == true
  return done
end

# 1 ("in place") when this is the only reference, 0 ("clone first") otherwise.
make a function called bm_rc_touch_for_mutation takes ptr returns mode
  require ptr != 0
  let mode = 0
  if mem_load(ptr, 0) == 1 then
    let mode = 1
  end
  ensure (mode == 0) or (mode == 1)
  return mode
end
