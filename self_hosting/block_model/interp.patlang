# Block Ownership Model, Phase 2 (Fork A): an interpreter for block_ir
# .patlang's BlockProgramIR/BlockIR shape. Self-hosted (an ordinary PatLang
# program, run via `pat.exe --ir-run`, not compiled to native x64 -- Phase
# 9 is the native codegen half of Fork A's "front to back", deliberately
# deferred until this self-hosted path has proven the design).
#
# The one property this file exists to prove, structurally, not just by
# convention: there is no call stack anywhere in here. bi_run's own loop is
# flat -- every "jump" a block ends with is handled by returning to that
# SAME loop with a brand-new locals set, never by this interpreter calling
# itself recursively to enter a block. A block's own bi_run_block call
# frame is gone the instant it returns "jump", before the next block even
# starts -- exactly "a jump and a pointer swap" (design doc section 3.1),
# not a nested call needing unwinding.
#
# locals/the value stack are both plain PatLang lists here (of [name,
# value] pairs for locals; of plain values for the stack), walked linearly
# by bm_loc_get/bm_loc_set/bm_st_pop -- O(depth) per op, not O(input size):
# fine for a prototype interpreter whose stack/locals depth is bounded by
# one block's own expression complexity, never by program input.
#
# Phase 10 adds Emit (event dispatch) -- the ONE place in this file that
# calls bi_run_block recursively rather than returning a "jump" outcome to
# bi_run's own flat loop. This is a deliberate, narrowly-scoped exception
# to this file's own "no call stack anywhere" claim above, not a quiet
# reintroduction of general calls: lower.patlang's own Phase 10 note
# guarantees a handler body can never itself contain a JumpBlock (its
# block_names/blocks_by_name are lowered as empty on purpose), so a
# recursive bi_run_block call for a handler is guaranteed to return
# ["halt", ...] and nothing else -- there is no nested jump to unwind, so
# no real call-stack growth risk despite the recursion. See block_ir
# .patlang's own Phase 10 note for why this doesn't fully match the real
# engine's runtime, closure-based `when` semantics (a v1 restriction,
# named plainly).
#
# Phase 3 adds Box*/ContractFail (section 3.4/3.5, Fork D wired in for
# real) via heap.patlang -- and heap.patlang's own functions are, in turn,
# native-x64-only (they call mem_peek_qword/mem_poke_qword/rt_heap_alloc,
# none of which self_hosting/lib/interp.patlang or rust-runtime/src/ir/
# hosts.rs implement, checked directly, same as Phase 1's own finding).
# `include`-ing heap.patlang here is harmless under --ir-run by itself
# (just function definitions, never executed unless called); Phase 2's own
# fixtures (which never use box_new/box_set) keep working unchanged under
# the interpreter. Only a program that actually uses a Box instruction
# needs native compilation -- bm_ensure_heap_ready's own lazy init (rather
# than an unconditional call in bi_run) is what keeps that boundary real
# instead of accidentally breaking Phase 2's suite the moment this file
# was extended.

include "block_ir.patlang"
include "heap.patlang"
# Phase 18: reuses self_hosting/lib/interp.patlang's own interp_call_host
# (name, args) dispatcher AS-IS for BuildList/CallHost's generic host-
# function calls, rather than reinventing a second one -- checked
# directly (a throwaway include-both-files smoke test) for name
# collisions with this file's own bm_-/bi_-prefixed functions before
# relying on it: none found. That file's own header describes it as
# "feature complete" for every stateless utility chunk (core,
# strings_ext, collections_handles, files, io_misc, math) -- real
# functions like `list_get`/`hash_string`/`char_code`, not this file's
# own block-model-specific opcodes.
include "../lib/interp.patlang"

# Issue #159: this engine's OWN host-function extension table, consulted by
# CallHost only when self_hosting/lib/interp.patlang's shared
# interp_call_host has no answer. That file is one of the four the plan's
# Phase 20 rule protects ("nothing in self_hosting/lib/{lower,codegen_x64,
# x64_runtime,interp}.patlang is touched until the cutover is explicitly
# authorized"), so a host function it lacks is added HERE, keeping this
# engine fully parallel. Each entry is a passthrough to the real host
# function of the same name, the same shape as interp_call_host's own
# sc_len/sc_code/sc_char siblings. Grows only on evidence -- a host function
# some real library actually calls under block-model -- never speculatively.
# Returns ["Ok", value], or ["Unhandled"] for any name it does not own.
make a function called bi_call_host_extension takes name, args returns result
  if name == "budget_check" then
    # Issue #176: yields the current fiber when its budgeted deadline is
    # near; a no-op outside any fiber. Injected on `while` back-edges inside
    # a budgeted block by lower.patlang.
    budget_check()
    return ["Ok", true]
  end
  if name == "object_delete" then
    # Issue #179: drops a named object from the registry (named_objects.feature).
    # zs_explore's breadth-first search creates a named Dict for its visited set
    # and deletes it on the way out.
    return ["Ok", object_delete(list_get(args, 0))]
  end
  if name == "sc_substr" then
    return ["Ok", sc_substr(list_get(args, 0), list_get(args, 1), list_get(args, 2))]
  end
  # Issue #177: the logic/GOAP host functions. The shared table documents
  # "oo/logic/contracts" as its own exclusions, so they are served here.
  # Arities are the real host functions' own (rust-runtime/src/ir/hosts.rs):
  # rule_add 3, goal_def 2, solve 2, plan 1, pursue 1, action_add 5. Like
  # fact/query (Phase 15), the rule/goal/action stores behind them are
  # process-wide thread-locals OUTSIDE __globals -- the gap Phase 15
  # recorded, unchanged by this.
  if name == "rule_add" then
    return ["Ok", rule_add(list_get(args, 0), list_get(args, 1), list_get(args, 2))]
  end
  if name == "goal_def" then
    return ["Ok", goal_def(list_get(args, 0), list_get(args, 1))]
  end
  if name == "solve" then
    return ["Ok", solve(list_get(args, 0), list_get(args, 1))]
  end
  if name == "plan" then
    return ["Ok", plan(list_get(args, 0))]
  end
  if name == "pursue" then
    return ["Ok", pursue(list_get(args, 0))]
  end
  if name == "action_add" then
    return ["Ok", action_add(list_get(args, 0), list_get(args, 1), list_get(args, 2), list_get(args, 3), list_get(args, 4))]
  end
  if name == "action_bind" then
    return ["Ok", action_bind(list_get(args, 0), list_get(args, 1))]
  end
  if name == "action_lookup" then
    return ["Ok", action_lookup(list_get(args, 0))]
  end
  if name == "action_base_name" then
    return ["Ok", action_base_name(list_get(args, 0))]
  end
  if name == "action_label_args" then
    return ["Ok", action_label_args(list_get(args, 0))]
  end
  return ["Unhandled"]
end

# Issue #176: `budgeted(ms, handle) { body }`. args = [ms, closure, existing,
# globals]; `closure` is the body lowered as a zero-parameter closure value
# ["__closure", block_name, [captured...]]. Runs it through the REAL
# budgeted_run host function, whose fiber entry is bi_budget_entry below --
# a declared function of this very program, since every driver includes this
# file. Returns ["done", value] or ["paused", handle], the real engine's own
# shape. On resume (`existing` is a handle) the host ignores the entry
# argument: the fiber's own call stack is the saved state.
make a function called bi_budgeted_run takes prog, args returns result
  let closure = list_get(args, 1)
  return budgeted_run(list_get(args, 0), "bi_budget_entry", [prog, list_get(closure, 1), list_get(closure, 2), list_get(args, 3)], list_get(args, 2))
end

# The fiber body: run the closure block with its captured list and the
# enclosing __globals, and hand back the body's own value. Its final globals
# are discarded (documented limit in budgeted.feature).
make a function called bi_budget_entry takes arg returns value
  let prog = list_get(arg, 0)
  let blk = bi_find_block(prog, list_get(arg, 1))
  let locs = bm_loc_set(bm_loc_new(), list_get(bi_block_params(blk), 0), list_get(arg, 2))
  let locs = bm_loc_set(locs, "__globals", list_get(arg, 3))
  return list_get(bi_run_from(prog, blk, locs), 0)
end

# Issue #176 (threads half): `parallel_map(items, "fn")`. The real host runs
# a declared function by name on real OS threads, but `fn` here is a
# block-model block, unknown to that host -- so each item is wrapped as
# [prog, block_name, item] and the real host maps bi_pmap_entry (a declared
# function of this very program) instead. Workers share nothing but the
# immutable program and their own item: a worker's __globals starts empty and
# its changes are not written back (documented in parallel_map.feature). A
# Box-using worker is NOT supported: the refcounted heap is ambient state that
# is not thread-safe (the deferred design question in Phase 14).
make a function called bi_parallel_map takes prog, args returns result
  let items = list_get(args, 0)
  let fname = list_get(args, 1)
  if bi_find_block(prog, fname) == false then
    contract_check("bm_interp", "assert", "parallel_map: no declared function named '" + fname + "'", false)
  end
  let wrapped = []
  let n = list_len(items)
  let i = 0
  while i < n do
    let wrapped = list_push(wrapped, [prog, fname, list_get(items, i)])
    let i = i + 1
  end
  return parallel_map(wrapped, "bi_pmap_entry")
end

make a function called bi_pmap_entry takes arg returns value
  let prog = list_get(arg, 0)
  let blk = bi_find_block(prog, list_get(arg, 1))
  let locs = bm_loc_set(bm_loc_new(), list_get(bi_block_params(blk), 0), list_get(arg, 2))
  let locs = bm_loc_set(locs, "__globals", [])
  return list_get(bi_run_from(prog, blk, locs), 0)
end

# Phase 7 (Fork C): a counter of how many times the RUNTIME refcount
# check (BoxSet, not BoxSetUnchecked) actually fired -- the concrete,
# measurable form of "most mutations should be proven safe before this
# code ever runs" (design doc section 3.5). Seeded in bi_run, alongside
# bm_heap_ready.
make a function called bm_note_runtime_check_performed returns done
  set_var("bm_runtime_check_count", get("__vars", "bm_runtime_check_count") + 1)
  return true
end

make a function called bm_get_runtime_check_count returns n
  return get("__vars", "bm_runtime_check_count")
end

make a function called bm_ensure_heap_ready returns done
  if get("__vars", "bm_heap_ready") == false then
    bm_heap_init()
    set_var("bm_heap_ready", true)
  end
  return true
end

# Phase 4 (Fork B): a plain assoc-list, walked linearly -- the SAME shape
# and cost profile as bm_loc_get/bm_loc_set above, just operating on a
# runtime VALUE (the "__globals" pointer itself) rather than the
# interpreter's own locals. No refcounted heap involved: a globals value
# is ordinary program state threaded explicitly, not a mutation-
# exclusivity concern (that's Box's own job).
make a function called bm_rt_assoc_get takes assoc, key returns v
  let n = list_len(assoc)
  let i = 0
  while i < n do
    let entry = list_get(assoc, i)
    if list_get(entry, 0) == key then
      return list_get(entry, 1)
    end
    let i = i + 1
  end
  return false
end

make a function called bm_rt_assoc_set takes assoc, key, v returns out
  # Phase 13 found this needed reworking while debugging why a cloned-on-
  # alias object still showed the mutated value through BOTH references:
  # `list_set` mutates shared native x64 storage IN PLACE when the
  # underlying block has spare capacity (issue #145, already filed and
  # confirmed elsewhere in this project) -- so the in-place `list_set`
  # this used to do here could corrupt the ORIGINAL assoc-list's own
  # backing storage before BoxSet's own clone-vs-mutate decision ever
  # matters, independent of whether that decision picks "clone" or
  # "in place". Rebuilding via list_push only (never list_set) avoids
  # relying on a primitive with a known, already-filed native-x64
  # aliasing bug, rather than reaching for a compensating workaround.
  # This same fix benefits GlobalSet too (also built on this function) --
  # its own existing tests never exercised setting the SAME key twice, so
  # this exact bug was latent there as well, just not yet caught.
  let n = list_len(assoc)
  let out = []
  let replaced = false
  let i = 0
  while i < n do
    let entry = list_get(assoc, i)
    if list_get(entry, 0) == key then
      let out = list_push(out, [key, v])
      let replaced = true
    else
      let out = list_push(out, entry)
    end
    let i = i + 1
  end
  if replaced then
    return out
  end
  return list_push(out, [key, v])
end


make a function called bm_loc_new returns locs
  return []
end

make a function called bm_loc_has takes locs, name returns yes
  let n = list_len(locs)
  let i = 0
  while i < n do
    if list_get(list_get(locs, i), 0) == name then
      return true
    end
    let i = i + 1
  end
  return false
end

make a function called bm_loc_get takes locs, name returns v
  let n = list_len(locs)
  let i = 0
  while i < n do
    let entry = list_get(locs, i)
    if list_get(entry, 0) == name then
      return list_get(entry, 1)
    end
    let i = i + 1
  end
  # Structural enforcement of section 3.2's own guarantee: a block sees
  # ONLY what its incoming jump explicitly handed it (bi_run's fresh
  # bm_loc_new() per jump, below), so any other name is a genuine,
  # guaranteed-fail contract violation here, not a silent default.
  contract_check("bm_interp", "assert", "unbound in this block's own pointer: " + name, false)
  return false
end

make a function called bm_loc_set takes locs, name, v returns out
  let n = list_len(locs)
  let i = 0
  while i < n do
    if list_get(list_get(locs, i), 0) == name then
      return list_set(locs, i, [name, v])
    end
    let i = i + 1
  end
  return list_push(locs, [name, v])
end

make a function called bm_st_push takes stack, v returns out
  return list_push(stack, v)
end

make a function called bm_st_pop takes stack returns out
  let n = list_len(stack)
  let v = list_get(stack, n - 1)
  let rest = []
  let i = 0
  while i < n - 1 do
    let rest = list_push(rest, list_get(stack, i))
    let i = i + 1
  end
  return [v, rest]
end

# Phase 18: pops `n` values, returning them as [values_in_ORIGINAL_
# push_order, remaining_stack] -- needed by BuildList/CallHost, whose
# own args were pushed in WRITTEN order (first arg pushed first, so
# it's the DEEPEST of the n popped values, not the top). Popped one at a
# time via bm_st_pop (top-to-bottom = REVERSE of push order), collected,
# then reversed back -- the exact technique self_hosting/lib/interp
# .patlang's own stack_pop_n already uses for the SAME reason, not a new
# invention.
make a function called bm_st_pop_n takes stack, n returns pair
  let vals_rev = []
  let cur = stack
  let i = 0
  while i < n do
    let popped = bm_st_pop(cur)
    let vals_rev = list_push(vals_rev, list_get(popped, 0))
    let cur = list_get(popped, 1)
    let i = i + 1
  end
  let vals = []
  let j = n - 1
  while j >= 0 do
    let vals = list_push(vals, list_get(vals_rev, j))
    let j = j - 1
  end
  return [vals, cur]
end

# Optimization (post-Phase-8): op is now bm_op_hash("+") etc. (an
# integer, computed once at lowering time by lower.patlang's own
# bm_hash_rewrite_instrs), not the literal operator string -- see
# block_ir.patlang's own header on bm_op_hash for why a custom small
# hash rather than x64_runtime.patlang's hash_string. Each branch is
# commented with the string it corresponds to; the literal integers
# themselves came from running self_hosting/block_model/bench/
# hash_check.patlang once (collision-checked there against every
# opcode/operator string this engine uses) and are hardcoded here
# rather than computed at dispatch time, which would cost as much as
# the string comparison being avoided.
make a function called bm_apply_bin takes op, l, r returns v
  if op == 177616 then # "+"
    return l + r
  elif op == 177618 then # "-"
    return l - r
  elif op == 177615 then # "*"
    return l * r
  elif op == 177620 then # "/"
    return l / r
  elif op == 177610 then # "%"
    return l % r
  elif op == 861968 then # "=="
    return l == r
  elif op == 861044 then # "!="
    return l != r
  elif op == 177633 then # "<"
    return l < r
  elif op == 861935 then # "<="
    return l <= r
  elif op == 177635 then # ">"
    return l > r
  elif op == 862001 then # ">="
    return l >= r
  end
  contract_check("bm_interp", "assert", "unknown Bin op hash: " + op, false)
  return false
end

make a function called bm_apply_un takes op, v returns out
  if op == 499987 then # "not"
    return not v
  elif op == 177618 then # "-"
    return 0 - v
  end
  contract_check("bm_interp", "assert", "unknown Un op hash: " + op, false)
  return false
end

# Runs one block from pc 0 until it either falls off the end (the whole
# program halts) or executes a JumpBlock (control transfers to a
# freshly-populated pointer at another block, handled by bi_run's own
# loop -- this function never calls itself to do that).
# Optimization (post-Phase-8, measured in docs/reports/block-ownership-
# model-speed-comparison.md): `op` here is bm_op_hash of the original
# opcode string (an integer), not the string itself -- lower.patlang's
# own bm_hash_rewrite_instrs computes it once, at lowering time, for
# every instruction in every block, unconditionally (a pure relabeling
# of the dispatch tag, safe regardless of block shape -- unlike the
# slot-indexing attempt this replaced after measuring it made the
# native case slightly WORSE, this one never touches a Load/Store's own
# name or any value, only the tag used to select which branch runs).
# Each branch below is commented with the string its hash represents;
# see block_ir.patlang's own header on bm_op_hash and hash_check.patlang
# for how these literals were derived and collision-checked.
make a function called bi_run_block takes prog, blk, locs returns outcome
  let instrs = bi_block_instrs(blk)
  let n = list_len(instrs)
  let pc = 0
  let stack = []
  while pc < n do
    let instr = list_get(instrs, pc)
    let op = list_get(instr, 0)
    if op == 487138 then # "Const"
      let kind = list_get(instr, 1)
      let text = list_get(instr, 2)
      if kind == "num" then
        let stack = bm_st_push(stack, to_num(text))
      elif kind == "bool" then
        let stack = bm_st_push(stack, text == "true")
      else
        let stack = bm_st_push(stack, text)
      end
      let pc = pc + 1
    elif op == 277141 then # "Load"
      let name = list_get(instr, 1)
      let stack = bm_st_push(stack, bm_loc_get(locs, name))
      let pc = pc + 1
    elif op == 642543 then # "Store"
      let name = list_get(instr, 1)
      let popped = bm_st_pop(stack)
      let locs = bm_loc_set(locs, name, list_get(popped, 0))
      let stack = list_get(popped, 1)
      let pc = pc + 1
    elif op == 451867 then # "Bin"
      let popped_r = bm_st_pop(stack)
      let r = list_get(popped_r, 0)
      let popped_l = bm_st_pop(list_get(popped_r, 1))
      let l = list_get(popped_l, 0)
      let stack = bm_st_push(list_get(popped_l, 1), bm_apply_bin(list_get(instr, 1), l, r))
      let pc = pc + 1
    elif op == 862809 then # "Un"
      let popped = bm_st_pop(stack)
      let stack = bm_st_push(list_get(popped, 1), bm_apply_un(list_get(instr, 1), list_get(popped, 0)))
      let pc = pc + 1
    elif op == 34716 then # "JumpIfFalse"
      let popped = bm_st_pop(stack)
      let stack = list_get(popped, 1)
      # Issue #154: the host language's OWN truthiness (`not v`, the same
      # primitive "Un not" already uses), not a strict `== false` -- the
      # strict test made "", 0 and [] count as TRUE here where the real
      # engine treats them as false, so `if x` and `not x` disagreed with
      # each other and a real library (test.patlang's `if filter then`,
      # filter == "") took the wrong branch.
      if not list_get(popped, 0) then
        let pc = list_get(instr, 1)
      else
        let pc = pc + 1
      end
    elif op == 212209 then # "Jump"
      let pc = list_get(instr, 1)
    elif op == 6264 then # "Print"
      let popped = bm_st_pop(stack)
      let stack = list_get(popped, 1)
      print(list_get(popped, 0))
      let pc = pc + 1
    elif op == 258931 then # "BoxNew"
      bm_ensure_heap_ready()
      let popped = bm_st_pop(stack)
      let ptr = bm_alloc(8)
      bm_box_write(ptr, list_get(popped, 0))
      let stack = bm_st_push(list_get(popped, 1), ptr)
      let pc = pc + 1
    elif op == 251305 then # "BoxGet"
      let popped = bm_st_pop(stack)
      let stack = bm_st_push(list_get(popped, 1), bm_box_read(list_get(popped, 0)))
      let pc = pc + 1
    elif op == 264373 then # "BoxSet"
      # Pops (value, ptr) -- value was pushed AFTER ptr at the lowering
      # site (block_ir.patlang's own header), so it's on top and pops
      # first. section 3.5's actual ownership check: refcount 1 mutates
      # this SAME cell in place; anything higher clones into a fresh cell
      # and pushes THAT pointer instead, leaving the original (and
      # whoever else holds it) untouched -- the caller must re-Store the
      # result, exactly like list_set's own "reassign to the result"
      # convention elsewhere in this codebase.
      let popped_v = bm_st_pop(stack)
      let v = list_get(popped_v, 0)
      let popped_p = bm_st_pop(list_get(popped_v, 1))
      let ptr = list_get(popped_p, 0)
      let stack = list_get(popped_p, 1)
      bm_note_runtime_check_performed()
      if bm_rc_touch_for_mutation(ptr) == 1 then
        bm_box_write(ptr, v)
        let stack = bm_st_push(stack, ptr)
      else
        let newptr = bm_alloc(8)
        bm_box_write(newptr, v)
        let stack = bm_st_push(stack, newptr)
      end
      let pc = pc + 1
    elif op == 902425 then # "BoxSetUnchecked"
      # Only ever emitted by lower.patlang's own flight check
      # (flight_check.patlang) at a call site it has PROVEN statically
      # can only ever see refcount 1 -- skips bm_rc_touch_for_mutation
      # and bm_note_runtime_check_performed entirely, always mutating in
      # place. Same pop order as BoxSet.
      let popped_v = bm_st_pop(stack)
      let v = list_get(popped_v, 0)
      let popped_p = bm_st_pop(list_get(popped_v, 1))
      let ptr = list_get(popped_p, 0)
      let stack = list_get(popped_p, 1)
      bm_box_write(ptr, v)
      let stack = bm_st_push(stack, ptr)
      let pc = pc + 1
    elif op == 992319 then # "BoxShare"
      let popped = bm_st_pop(stack)
      let ptr = list_get(popped, 0)
      bm_rc_inc(ptr)
      let stack = bm_st_push(list_get(popped, 1), ptr)
      let pc = pc + 1
    elif op == 296907 then # "ContractFail"
      contract_check("bm_block", "assert", list_get(instr, 1), false)
      let pc = pc + 1
    elif op == 695659 then # "GlobalGet"
      let popped_g = bm_st_pop(stack)
      let globals_val = list_get(popped_g, 0)
      let popped_k = bm_st_pop(list_get(popped_g, 1))
      let stack = bm_st_push(list_get(popped_k, 1), bm_rt_assoc_get(globals_val, list_get(popped_k, 0)))
      let pc = pc + 1
    elif op == 708727 then # "GlobalSet"
      # Writes "__globals" directly (no push) -- see lower.patlang's own
      # header on why this is what makes set_global(...) read like an
      # ordinary ambient call at the source level.
      let popped_g = bm_st_pop(stack)
      let globals_val = list_get(popped_g, 0)
      let popped_k = bm_st_pop(list_get(popped_g, 1))
      let key = list_get(popped_k, 0)
      let popped_v = bm_st_pop(list_get(popped_k, 1))
      let stack = list_get(popped_v, 1)
      let locs = bm_loc_set(locs, "__globals", bm_rt_assoc_set(globals_val, key, list_get(popped_v, 0)))
      let pc = pc + 1
    elif op == 54830 then # "HandlerNew"
      let stack = bm_st_push(stack, [])
      let pc = pc + 1
    elif op == 40752 then # "HandlerRegister"
      # Phase 13 found a real, pre-existing Phase 4 bug here while
      # debugging object field writes: this used a bare list_push (always
      # APPEND), never checking for an existing entry under the same key.
      # object_handler.feature never caught it because it only ever
      # registered two DIFFERENT names ("alice"/"bob"); re-registering the
      # SAME key (e.g. writing the same object field twice) left a stale
      # duplicate entry, and HandlerLookup's own bm_rt_assoc_get scans
      # forward and returns the FIRST match, so every later write silently
      # never became visible. Fixed by reusing bm_rt_assoc_set (already
      # defined above for GlobalSet's own use) -- a real check-and-replace,
      # not a fudge: a Handler is meant to be a key/value map, and
      # `list_push`-only was never a correct implementation of one.
      let popped_h = bm_st_pop(stack)
      let handler = list_get(popped_h, 0)
      let popped_n = bm_st_pop(list_get(popped_h, 1))
      let popped_r = bm_st_pop(list_get(popped_n, 1))
      let stack = bm_st_push(list_get(popped_r, 1), bm_rt_assoc_set(handler, list_get(popped_n, 0), list_get(popped_r, 0)))
      let pc = pc + 1
    elif op == 841425 then # "HandlerLookup"
      let popped_h = bm_st_pop(stack)
      let handler = list_get(popped_h, 0)
      let popped_n = bm_st_pop(list_get(popped_h, 1))
      let stack = bm_st_push(list_get(popped_n, 1), bm_rt_assoc_get(handler, list_get(popped_n, 0)))
      let pc = pc + 1
    elif op == 289875 then # "TypeOf"
      let popped = bm_st_pop(stack)
      let stack = bm_st_push(list_get(popped, 1), type_of(list_get(popped, 0)))
      let pc = pc + 1
    elif op == 229241 then # "ReadFile"
      let popped = bm_st_pop(stack)
      let stack = bm_st_push(list_get(popped, 1), read_file(list_get(popped, 0)))
      let pc = pc + 1
    elif op == 36537 then # "WriteFile"
      # Pops (contents, path) -- contents pushed after path at the
      # lowering site, so it's on top and pops first, matching every
      # other two-arg instruction's own convention in this file.
      let popped_c = bm_st_pop(stack)
      let contents = list_get(popped_c, 0)
      let popped_p = bm_st_pop(list_get(popped_c, 1))
      let path = list_get(popped_p, 0)
      let stack = list_get(popped_p, 1)
      let stack = bm_st_push(stack, write_file(path, contents))
      let pc = pc + 1
    elif op == 46355 then # "Fact"
      # Calls the REAL fact() host function directly, same pattern as
      # Print/FiberYield -- fact's own backing store is process-ambient
      # (thread_local! in hosts.rs), entirely outside this engine's own
      # __globals threading (see lower.patlang's own Phase 15 note).
      let popped_b = bm_st_pop(stack)
      let b = list_get(popped_b, 0)
      let popped_a = bm_st_pop(list_get(popped_b, 1))
      let a = list_get(popped_a, 0)
      let popped_p = bm_st_pop(list_get(popped_a, 1))
      let pred = list_get(popped_p, 0)
      let stack = list_get(popped_p, 1)
      fact(pred, a, b)
      let pc = pc + 1
    elif op == 295774 then # "Query"
      let popped_b = bm_st_pop(stack)
      let b = list_get(popped_b, 0)
      let popped_a = bm_st_pop(list_get(popped_b, 1))
      let a = list_get(popped_a, 0)
      let popped_p = bm_st_pop(list_get(popped_a, 1))
      let pred = list_get(popped_p, 0)
      let stack = list_get(popped_p, 1)
      let stack = bm_st_push(stack, query(pred, a, b))
      let pc = pc + 1
    elif op == 876321 then # "FiberYield"
      # Pops the value to yield, calls the REAL fiber_yield host function
      # directly (an ordinary PatLang call, exactly like Print calls the
      # real print()) -- fiber_yield returns whatever the corresponding
      # fiber_resume passed in, pushed back for the block to consume.
      # Whichever OS-thread-mapped fiber is CURRENTLY running this
      # bi_run_block call is the one that actually pauses -- ambient, not
      # something this instruction needs to know about explicitly, the
      # same way bi_debug_run (Phase 8) calls it with no fiber handle in
      # sight.
      let popped = bm_st_pop(stack)
      let stack = bm_st_push(list_get(popped, 1), fiber_yield(list_get(popped, 0)))
      let pc = pc + 1
    elif op == 23684 then # "Emit"
      # Pops (globals, event_name, payload) -- same push order as
      # lower.patlang's own bm_lower_stmt "emit" case (payload, then
      # event_name, then __globals), so globals pops first. Runs every
      # registered handler for event_name, in registration order, as a
      # bounded sub-execution via a RECURSIVE bi_run_block call (see this
      # file's own Phase 10 header for why that's safe here specifically),
      # threading each handler's own resulting "__globals" into the next
      # one's incoming pointer, then writing the final result back into
      # THIS block's own "__globals" local before falling through --
      # genuinely returning control, unlike every other jump in this file.
      let popped_g = bm_st_pop(stack)
      let globals_val = list_get(popped_g, 0)
      let popped_e = bm_st_pop(list_get(popped_g, 1))
      let event_name = list_get(popped_e, 0)
      let popped_p = bm_st_pop(list_get(popped_e, 1))
      let payload = list_get(popped_p, 0)
      let stack = list_get(popped_p, 1)
      let handler_names = bm_rt_assoc_get(bi_program_events(prog), event_name)
      if handler_names == false then
        let handler_names = []
      end
      let hn = list_len(handler_names)
      let hi = 0
      let cur_globals = globals_val
      while hi < hn do
        let handler_name = list_get(handler_names, hi)
        let handler_blk = bi_find_block(prog, handler_name)
        let handler_locs = bm_loc_new()
        let handler_locs = bm_loc_set(handler_locs, "event_name", event_name)
        let handler_locs = bm_loc_set(handler_locs, "event_data", payload)
        let handler_locs = bm_loc_set(handler_locs, "__globals", cur_globals)
        # Phase 21: bi_run_from (not a single bare bi_run_block call)
        # so a handler's own internal `while` loop -- which JumpBlocks to
        # its own synthesized head/exit blocks, returning "jump", not
        # "halt", on its very first iteration -- actually runs to
        # completion instead of being rejected as "attempted to jump to
        # another block". A real, previously-shipped bug, found by
        # testing lower.patlang's own "for free" claim directly rather
        # than trusting it: this exact call used to be a single bare
        # bi_run_block, which errored on that first "jump" outcome. Fixed
        # here, at the source, rather than special-cased around.
        let handler_outcome = bi_run_from(prog, handler_blk, handler_locs)
        let final_handler_locs = list_get(handler_outcome, 1)
        let cur_globals = bm_loc_get(final_handler_locs, "__globals")
        let hi = hi + 1
      end
      let locs = bm_loc_set(locs, "__globals", cur_globals)
      let pc = pc + 1
    elif op == 974555 then # "JumpBlock"
      let target_name = list_get(instr, 1)
      let param_names = list_get(instr, 2)
      let pn = list_len(param_names)
      # Params were pushed onto the stack in declared order, so popping
      # yields them in REVERSE; collect then assign back in forward order.
      let reversed = []
      let i = 0
      while i < pn do
        let popped = bm_st_pop(stack)
        let stack = list_get(popped, 1)
        let reversed = list_push(reversed, list_get(popped, 0))
        let i = i + 1
      end
      let new_locs = bm_loc_new()
      let i = 0
      while i < pn do
        let name = list_get(param_names, i)
        let v = list_get(reversed, pn - 1 - i)
        let new_locs = bm_loc_set(new_locs, name, v)
        let i = i + 1
      end
      let target_blk = bi_find_block(prog, target_name)
      return ["jump", target_blk, new_locs]
    elif op == 550066 then # "BuildList"
      # A literal `[a, b, c]` -- pops instr[1] values (already pushed in
      # WRITTEN order by lower.patlang's own "List" case) via bm_st_pop_n,
      # which restores that original order, then pushes the resulting
      # List directly -- matches self_hosting/lib/interp.patlang's own
      # "BuildList" case exactly (stack_pop_n's own `popped[0]` IS already
      # the reconstructed list, nothing further needed).
      let popped = bm_st_pop_n(stack, list_get(instr, 1))
      let stack = bm_st_push(list_get(popped, 1), list_get(popped, 0))
      let pc = pc + 1
    elif op == 700058 then # "CallHost"
      # Phase 17/18's own named-but-deferred generic host-function
      # dispatch, now filled in: pops instr[2] args (written order,
      # restored by bm_st_pop_n) and dispatches by NAME through self_
      # hosting/lib/interp.patlang's own interp_call_host -- reused
      # as-is (see this file's own include comment above), not
      # reimplemented. On "Err" (unknown name, wrong arity, etc.), raises
      # a guaranteed-fail contract violation naming the real cause,
      # matching this engine's own established convention for every
      # other unrecoverable condition (ContractFail, bm_lower_unsupported)
      # rather than silently pushing a placeholder value.
      let popped = bm_st_pop_n(stack, list_get(instr, 2))
      if list_get(instr, 1) == "bm_budgeted_run" then
        # Issue #176: needs the RUNNING PROGRAM (the fiber entry function
        # re-enters this interpreter on a closure block), which a host
        # function's `(name, args)` signature cannot carry -- so it is
        # handled here, where `prog` is in scope.
        let call_result = ["Ok", bi_budgeted_run(prog, list_get(popped, 0))]
      elif list_get(instr, 1) == "parallel_map" then
        # Issue #176 (threads half): same reason -- see bi_parallel_map.
        let call_result = ["Ok", bi_parallel_map(prog, list_get(popped, 0))]
      else
        let call_result = interp_call_host(list_get(instr, 1), list_get(popped, 0))
      end
      if list_get(call_result, 0) == "Err" then
        # Issue #159: the shared dispatcher (lib/interp.patlang, protected
        # by the plan's Phase 20 rule) has no answer -- try this engine's
        # OWN extension table before failing. Tried only AFTER an "Err" so
        # the common success path pays nothing for it.
        let ext_result = bi_call_host_extension(list_get(instr, 1), list_get(popped, 0))
        if list_get(ext_result, 0) == "Ok" then
          let call_result = ext_result
        end
      end
      if list_get(call_result, 0) == "Err" then
        contract_check("bm_interp", "assert", "CallHost '" + list_get(instr, 1) + "' failed: " + list_get(call_result, 1), false)
      end
      let stack = bm_st_push(list_get(popped, 1), list_get(call_result, 1))
      let pc = pc + 1
    elif op == 131889 then # "ReturnValue"
      # Phase 21: `return EXPR` for any EXPR that ISN'T itself a call to
      # a declared block (bm_lower_stmt's own "Return" case falls back
      # to this instead of bm_lower_unsupported). Pops the one value
      # EXPR evaluated to and ends THIS bi_run_block call immediately
      # with it -- exactly the same "halt" outcome shape every other
      # natural end-of-block already produces, just reachable mid-body
      # (including nested inside if/else) rather than only at the
      # textual end of a block's own instrs. No new outcome kind needed:
      # a value-returning function's own caller (the new "Call"
      # instruction, below) already expects a "halt" outcome, the same
      # as bi_run_from's own loop already handles for every other block.
      let popped = bm_st_pop(stack)
      return ["halt", list_get(popped, 0), locs]
    elif op == 938836 then # "Call"
      # Phase 21: a declared function called AS A VALUE (bm_lower_expr's
      # own "Call" case, when the callee is in block_names) -- distinct
      # from JumpBlock, which remains exactly as it always was for every
      # EXISTING tail-call site (`return F(...)`, a bare `F(...)`
      # statement), left completely unchanged. Pops instr[2] values
      # (written order, restored by bm_st_pop_n: the callee's own args,
      # then the CURRENT __globals, matching JumpBlock's own "args, then
      # an implicit __globals push" convention exactly -- see lower
      # .patlang's own bm_lower_jump_call), binds them by name into a
      # FRESH locals set (the callee's own declared params, found via
      # bi_block_params -- already includes "__globals" last, the same
      # hidden-param convention every block already has), and recurses
      # via bi_run_from (not bi_run_block directly) so the callee's own
      # internal `while` loops run to completion correctly -- the SAME
      # fix Emit's own handler dispatch just got, generalized. Pushes
      # the callee's own returned value onto THIS caller's stack, and
      # updates THIS caller's own "__globals" local to the callee's
      # final one -- Fork B's threading, preserved across a REAL call
      # boundary, not just a flat jump. Recursion (direct or mutual)
      # between functions called this way works for free: this is an
      # ordinary recursive PatLang call, handled by the HOST
      # interpreter's own real call stack, the same as Emit's own
      # pre-existing recursion into a handler already relied on --  a
      # genuine, incidental capability gain over JumpBlock's own flat
      # model, which cannot express recursion at all.
      let callee_name = list_get(instr, 1)
      let popped = bm_st_pop_n(stack, list_get(instr, 2))
      let args = list_get(popped, 0)
      let stack = list_get(popped, 1)
      let callee_blk = bi_find_block(prog, callee_name)
      let param_names = bi_block_params(callee_blk)
      let pn = list_len(param_names)
      let callee_locs = bm_loc_new()
      let pi = 0
      while pi < pn do
        let callee_locs = bm_loc_set(callee_locs, list_get(param_names, pi), list_get(args, pi))
        let pi = pi + 1
      end
      let call_outcome = bi_run_from(prog, callee_blk, callee_locs)
      let stack = bm_st_push(stack, list_get(call_outcome, 0))
      let locs = bm_loc_set(locs, "__globals", bm_loc_get(list_get(call_outcome, 1), "__globals"))
      let pc = pc + 1
    elif op == 915129 then # "CallDynamic"
      # `apply(fname, a1, ..., an)` -- see lower.patlang's own
      # bm_lower_apply for the full rationale. instr[1] is n, the count
      # of extra args (issue #153; was always zero before). Pops
      # __globals first, then the callee-name, then the n args (written
      # order restored by bm_st_pop_n), matching every other "args then
      # an implicit __globals push" convention in this file. The args
      # bind positionally to the resolved callee's OWN declared params
      # (bi_block_params, "__globals" last, exactly as Call does).
      # bi_find_block returns `false` for an unknown name rather than
      # raising -- an earlier version of this comment claimed it raised
      # its own error, which was wrong -- so both that case and an
      # over-supplied argument list are checked and reported explicitly
      # here, by name, rather than failing obscurely on `false`.
      let n_extra = list_get(instr, 1)
      let popped_g = bm_st_pop(stack)
      let globals_val = list_get(popped_g, 0)
      let popped_f = bm_st_pop(list_get(popped_g, 1))
      let fname = list_get(popped_f, 0)
      let popped_a = bm_st_pop_n(list_get(popped_f, 1), n_extra)
      let call_args = list_get(popped_a, 0)
      let stack = list_get(popped_a, 1)
      let callee_blk = bi_find_block(prog, fname)
      if callee_blk == false then
        contract_check("bm_interp", "assert", "apply: no declared function named '" + fname + "'", false)
      end
      let callee_params = bi_block_params(callee_blk)
      let declared_count = list_len(callee_params) - 1
      if n_extra > declared_count then
        contract_check("bm_interp", "assert", "apply: '" + fname + "' declares " + declared_count + " parameter(s) but was called with " + n_extra + " argument(s)", false)
      end
      let callee_locs = bm_loc_set(bm_loc_new(), "__globals", globals_val)
      let bi = 0
      while bi < n_extra do
        let callee_locs = bm_loc_set(callee_locs, list_get(callee_params, bi), list_get(call_args, bi))
        let bi = bi + 1
      end
      let call_outcome = bi_run_from(prog, callee_blk, callee_locs)
      let stack = bm_st_push(stack, list_get(call_outcome, 0))
      let locs = bm_loc_set(locs, "__globals", bm_loc_get(list_get(call_outcome, 1), "__globals"))
      let pc = pc + 1
    else
      # Names WHERE it happened (block, pc, the instruction itself): a bare
      # hash gave no location, and finding which block produced a malformed
      # instruction (#157) needed a separate dump harness.
      contract_check("bm_interp", "assert", "unknown block-model instruction: " + op + " at pc=" + pc + " in block " + bi_block_name(blk) + " instr=" + instr, false)
    end
  end
  # Phase 10: a 3rd element (this block's own final locs) is appended here
  # now, purely additive -- bi_run/bi_debug_run's own consumption of a
  # "halt" outcome only ever reads elements 0/1, unchanged. Emit's own
  # recursive bi_run_block call is the one real consumer of element 2: it
  # needs a handler's own final "__globals" value, which only a "halt"
  # outcome (guaranteed for a handler body, per lower.patlang's own Phase
  # 10 note) can expose.
  return ["halt", "unit", locs]
end

# Phase 21: the reusable "run to completion" loop -- generalizes what
# bi_run's own top-level loop already was (see this file's own header
# for why THAT loop being flat, not recursive, is what Fork A's "no call
# stack" claim actually rests on) to start from an ARBITRARY block/locs
# pair, not just the program's entry, and to return BOTH the final value
# AND the final locs (bi_run itself only ever needed the value, so it
# never had to). This is the ONE new piece of machinery Phase 21's whole
# call-with-return mechanism needs: a value-returning `Call` just
# recurses into this function (an ordinary, HOST-interpreter-native
# recursive PatLang call -- Rust's own real call stack handles it, the
# same way Emit's own pre-existing recursive bi_run_block call already
# relied on host recursion, just now generalized past a single call).
#
# A real, previously-shipped bug was found and fixed proving this, not
# designed around in advance: Emit's own handler dispatch (Phase 19)
# used to make exactly ONE bi_run_block call and reject anything other
# than an immediate "halt" outcome as unsupported -- but lower.patlang's
# own header claims a `while` loop is reachable inside a handler body
# "for free" (true at lowering time; the bug was purely in this file's
# own execution of it). Checked directly: a handler containing a
# `while` loop hits its own loop's first JumpBlock (the back-edge) and
# returns a "jump" outcome, which the old single-call code rejected.
# This function fixes that (see bi_run/Emit's own rewiring onto it
# below) by doing what bi_run's own loop always did -- follow "jump"
# outcomes to completion -- rather than assuming one call suffices.
make a function called bi_run_from takes prog, block, locs returns pair
  let cur = block
  let locs = locs
  while true do
    let outcome = bi_run_block(prog, cur, locs)
    if list_get(outcome, 0) == "halt" then
      return [list_get(outcome, 1), list_get(outcome, 2)]
    end
    let cur = list_get(outcome, 1)
    let locs = list_get(outcome, 2)
  end
end

# The whole engine's own top-level loop -- flat, not recursive: this is
# where Fork A's "no call stack" claim actually lives. Each iteration
# starts a block completely fresh (bm_loc_new()), so nothing from a
# previous block can leak forward except what a JumpBlock instruction
# explicitly named. Now a thin wrapper over bi_run_from (Phase 21) --
# purely an internal refactor, not a behavior change: bi_run never
# needed the final locs bi_run_from also returns, so it simply discards
# them.
make a function called bi_run takes prog returns result
  bi_init_run_state()
  let cur = bi_find_block(prog, bi_program_entry(prog))
  # The entry block never has anything jumped INTO it, so the very first
  # pointer's own globals-view section (section 3.2/3.3) is seeded here,
  # once, as the program's true starting state -- every later block gets
  # it purely by JumpBlock forwarding (lower.patlang's own doing), never
  # by re-seeding.
  let locs = bm_loc_set(bm_loc_new(), "__globals", [])
  let outcome = bi_run_from(prog, cur, locs)
  return list_get(outcome, 0)
end

make a function called bi_init_run_state returns done
  set_var("bm_heap_ready", false)
  set_var("bm_runtime_check_count", 0)
  return true
end

# Phase 8 (Fork A's own one identified real gap): a jump-history trail,
# replacing the call-stack view a real call stack gives for free in
# today's model -- there is no call stack here at all (this file's own
# header). Bounded, not a growing log: bm_trail_push drops the oldest
# entry past bi_trail_max(), the concrete, small-scale form of Fork D
# making "keep this bounded and free old entries" a straightforward thing
# to build (design doc, Fork A's own reasoning) rather than another
# unbounded log.
make a function called bi_trail_max returns n
  return 5
end

make a function called bm_trail_push takes trail, name returns out
  let trail = list_push(trail, name)
  if list_len(trail) > bi_trail_max() then
    let n = list_len(trail)
    let out = []
    let i = 1
    while i < n do
      let out = list_push(out, list_get(trail, i))
      let i = i + 1
    end
    return out
  end
  return trail
end

# The SAME execution loop as bi_run, but runnable as a fiber body
# (fiber_new("bi_debug_run")) so an external caller can genuinely pause
# it and query "how did we get here" mid-execution via fiber_resume,
# rather than only ever seeing a finished result. Checked directly
# (self_hosting/examples/fiber_demo.patlang, run via --ir-run): fiber_new/
# fiber_yield/fiber_resume/fiber_alive are special-cased in the Rust
# interpreter's own instruction dispatch (rust-runtime/src/ir/
# interpreter.rs), not something only the native backend provides --
# representation-agnostic, exactly Fork A's own finding about the real
# debugger's pause/resume mechanism carrying over unchanged. This is a
# second, parallel entry point rather than a flag on bi_run itself,
# since fiber_new needs a plain top-level function name to spawn.
make a function called bi_debug_run takes prog returns result
  bi_init_run_state()
  let cur = bi_find_block(prog, bi_program_entry(prog))
  let locs = bm_loc_set(bm_loc_new(), "__globals", [])
  let trail = []
  while true do
    let trail = bm_trail_push(trail, bi_block_name(cur))
    fiber_yield(trail)
    let outcome = bi_run_block(prog, cur, locs)
    if list_get(outcome, 0) == "halt" then
      return list_get(outcome, 1)
    end
    let cur = list_get(outcome, 1)
    let locs = list_get(outcome, 2)
  end
  return "unit"
end
