# Block Ownership Model, Phase 2 (Fork A): lowers a RESTRICTED subset of
# ordinary PatLang source into block_ir.patlang's BlockProgramIR shape.
# Reuses self_hosting/lib/lexer.patlang and lib/parser.patlang UNCHANGED --
# only lowering and execution are new here, matching Fork A's own scope
# (a new execution engine, not new source syntax).
#
# What's supported, and why the cut is drawn here rather than further out:
# a program is a flat sequence of top-level `make a function called X
# takes ... returns ... ... end` declarations. Each one becomes exactly one
# BlockIR, named after the function. A function's body may contain:
#   - Let name = EXPR, where EXPR is Num/Str/Bool/Var/Bin/Un (arithmetic,
#     comparison, boolean)
#   - If/else (recursively, over the same restricted statement set)
#   - print(EXPR)                       -> a Print instruction
#   - Return CALL_TO_ANOTHER_FUNCTION(args...), or a bare
#     CALL_TO_ANOTHER_FUNCTION(args...) statement -> a JumpBlock
#     instruction, since Fork A replaces calls between these blocks with
#     jumps, never a call-with-return
#
# Explicitly NOT supported yet (a real gap, not silently mishandled --
# bm_lower_unsupported below raises a guaranteed-fail contract_check
# naming exactly what wasn't recognized): `while` loops (Phase 5's own
# job, needing an `inherited` section this phase deliberately doesn't
# build), closures (Phase 6), `Return EXPR` where EXPR is not a call to
# another declared block (there is no call stack to return a value up
# through yet -- see interp.patlang's own header on why), and calling
# anything that isn't either `print`/`box_new`/`box_get`/`box_set`/
# `box_share` or another function declared in this same program (no
# general host-function dispatch in this phase).
#
# Phase 3 adds box_new(v)/box_get(ptr)/box_set(ptr, v)/box_share(ptr) as
# recognized Call expressions (section 3.4/3.5, Fork D wired in for real --
# see block_ir.patlang's own header for the instructions and the `mut_`
# parameter-name convention standing in for real `mut` param syntax).
# box_set's own mut-check is deliberately narrow, matching section 3.4's
# literal scope ("extend mut... to parameter declarations"): calling
# box_set on a bare reference to one of THIS block's own declared
# parameters is checked against that parameter's mut_-prefix; calling it
# on an ordinary `let`-bound local, or on any other expression shape,
# is always allowed (this phase's guarantee is about a block's incoming
# pointer, not general alias tracking through arbitrary local reassignment --
# that's the flight check's own, later job, Phase 7).
#
# Phase 4 adds Fork B's full elimination of ambient state, for real:
#
#   - set_global(name, value)/get_global(name) look, from the SOURCE's own
#     point of view, exactly like today's ambient set_var/get -- but
#     `__globals` is a HIDDEN parameter this lowerer appends to EVERY
#     function's own param list (bm_lower_program, below) and to EVERY
#     JumpBlock's own forwarded fields (bm_lower_jump_call, below), never
#     written by the program itself. That's section 3.3's actual claim
#     ("the PatLang source someone actually wrote... never changes")
#     realized directly, not just described: a program using these two
#     calls reads exactly like it always ambiently could, while every
#     block boundary in between structurally carries the pointer, matching
#     section 3.2's "everything reachable is in the one pointer, or is
#     global" with globals now literally IN that one pointer.
#
#   - handler_new()/handler_register(h, name, ref)/handler_lookup(h, name)
#     realize the OTHER half of Fork B: `new`/`send`'s deliberate-naming
#     minority (docs/plans/block-ownership-model.md, section 6, Fork B).
#     A handler is an ORDINARY value (an assoc-list, no refcounted heap
#     involved) passed around EXPLICITLY like any other parameter --
#     `handler_register` returns an UPDATED handler the caller re-Stores,
#     the same "reassign to the result" convention as box_set/list_set.
#     The ephemeral majority of that same fork (`new("Dict", "prefix_" +
#     counter)`-style workarounds) has NOTHING further to build here: this
#     engine's own Box (Phase 1-3) was designed from the start with no
#     name parameter at all, so two independently created boxes are
#     already, unconditionally, independent objects -- there was never a
#     collision risk to demonstrate fixing, only to note the connection.
#
# Phase 5 adds `while` (section 4.1/4.2): a loop body becomes its own
# synthesized block, entered by a genuine back edge -- the model's own
# core mechanic (section 3.1-3.2) applied where the "next" block happens
# to be the current one, exactly as section 4.1 describes. A synthesized
# `__loop_exit_N` block, holding whatever textually followed the `while`
# in source, is what makes this correct without a call stack: "continuing
# after the loop" is exactly the same kind of jump target as "continuing
# after a function call" was in Phase 2, so `while` is deliberately only
# supported as the point a function's OWN body reaches, never nested
# inside an if/else here -- bm_lower_top_level_stmt_list (the only place
# that knows how to split a block at a `while`) is never called
# recursively for an if-branch's own then/else lists, which still go
# through the ORIGINAL bm_lower_stmt_list/bm_lower_stmt (unchanged) --
# a `while` reached that way hits bm_lower_unsupported, named plainly, not
# silently dropped.
#
# The loop's own `inherited` section (its synthesized block's own declared
# params) was WHOLESALE capture in this phase originally -- every name
# known to be bound in the enclosing function body BEFORE the `while` is
# reached (known_locals, threaded alongside pending through
# bm_lower_top_level_stmt_list). Phase 6 (Fork E, free_vars.patlang) has
# since replaced this with real free-variable analysis, intersected
# against known_locals: bm_lower_while's own captured set is now only the
# names the loop body ACTUALLY references, not everything merely in
# scope. known_locals itself is still tracked the same way -- ONLY at a
# function's own top level, not descended into if-branches, so a `let`
# introduced inside an if/else before a later top-level `while` is
# unreachable to either the old wholesale set or the new precise one, a
# narrower base than the real lower_closure_literal's own full tracking,
# but sufficient to prove section 4.1's actual claim.
#
# section 4.2's own claim is enforced as a natural consequence, not a
# special case: a scratch `let` declared INSIDE the loop body extends
# body_result's own known_locals for lowering the REST of that same
# iteration's body, but the back-edge JumpBlock only ever forwards the
# ORIGINAL captured set computed before the loop started -- so it can
# never survive into the next iteration unless it was already part of
# what's captured.
#
# Phase 6 adds (section 6, Fork E, wired in for real): see
# free_vars.patlang's own header for the analysis itself and its one
# disclosed scope note (this engine never built closures, so there is
# only one real consumer of it here, bm_lower_while -- nothing about the
# analysis is closure-specific, but nothing here calls it for one either).
#
# Phase 17 adds a representative slice of system integration:
# `read_file(path)`/`write_file(path, contents)`, both genuine, fixed-
# arity host functions (checked directly against rust-runtime/src/ir/
# hosts.rs), following the exact same "call the real host function
# directly" pattern as Print/FiberYield/Fact/Query/TypeOf.
#
# Deliberately NOT covering the rest of this phase's own planned scope
# this pass, named plainly rather than silently narrowed: `spawn`/
# `exec_capture` take a VARIADIC argument list (checked directly), which
# this engine's fixed-arity recognized-call pattern doesn't accommodate
# without real design work (an argc-carrying instruction, mirroring how
# JumpBlock's own param count already varies per call site -- a next-step
# extension, not attempted here); `queue_publish`/`consume`/`ack` turned
# out NOT to be Rust host functions at all (checked directly) but ordinary
# PatLang library functions (self_hosting/lib/queue.patlang) -- callable
# the same way once that file is `include`d, but a real library
# dependency this pass doesn't pull in. `signal_*` is deferred for the
# same reason. Each is a real, separable follow-up, not solved by
# assuming the fixed-arity pattern already covers it.
#
# Phase 16 adds `type_of(x)` -- not new mechanism, verification tooling.
# Checked directly (a probe run under --ir-run) before writing anything
# else for this phase: the numeric tower needs NO new work here at all.
# The self-hosted parser.patlang produces a single "Num" tag for every
# numeric literal (int/bigint/float alike -- no separate BigNumber/Float
# AST shape exists at all, confirmed by grep), carrying only the raw
# decimal TEXT; bm_lower_expr's own "Num" case already passes that text
# straight through to a Const instruction, and interp.patlang's own
# "Const" case evaluates it via the REAL `to_num`, which already performs
# the full int/bigint/rational/float/complex auto-promotion the real
# language defines. bm_apply_bin's own `l + r` etc. are genuine PatLang
# operators too, inheriting the same promotion for free. `type_of(x)` is
# added purely so this claim is independently CHECKABLE from within a
# block-model program's own output, not left as an unverified inference.
#
# Phase 15 adds the logic-programming/GOAP primitive at the bottom of
# that paradigm's stack: `fact(pred, a, b)`/`query(pred, a, b)` -- checked
# directly (rust-runtime/src/ir/hosts.rs) rather than assumed: both take
# exactly 3 SCALAR args, not a list, so neither needs this engine's
# missing list-literal/BuildList support at all, unlike `rule`/`goal`
# declarative sugar (RuleDecl/GoalDecl), which DO build compound
# [pred,[args]] lists and are explicitly deferred alongside Phase 17's own
# generic host-call/list-literal work, named here rather than attempted
# with half the needed machinery.
#
# A genuine finding, not assumed uniform with Fork B's own globals
# elimination: `fact`/`query`'s own backing store (FACTS in hosts.rs) is
# a `thread_local!` HashMap, entirely outside PatLang's `__vars`/
# `set_var`/`get` mechanism and therefore outside this engine's own
# `__globals` threading (Phase 4) entirely -- a fact asserted in one
# block is visible from any other block NOT because __globals carried it
# there, but because it was never scoped by this design's own mechanism
# to begin with. The design doc's own Fork B never named this ambient
# mechanism (it only covers `set_var`/`get` and `new`/`send`) -- recorded
# here as a real gap in that document's own coverage, not silently
# treated as already-handled.
#
# Phase 14 adds cooperative yielding, scoped deliberately to fiber_yield
# alone -- checked before writing code: self_hosting/examples/
# fiber_demo.patlang's own header says fibers are "implemented on real OS
# threads under the hood... but never actually running concurrently...
# distinct from parallel_map, which IS real parallelism" -- so no
# refcount-thread-safety design question applies here at all. Real
# OS-thread parallelism (thread_spawn/parallel_map) is explicitly
# deferred: Box is native-x64-only, so it can't be exercised under the
# self-hosted interpreter this phase (and this whole plan's backend
# cadence) is scoped to until Phase 19's native codegen exists.
# `fiber_yield(x)` lowers as a bare statement (mirrors `emit`'s own
# lowering exactly) to a MID-BLOCK FiberYield instruction -- never ends
# the block, since a block-model program needs to keep running its own
# next statement once resumed, the same reasoning as Emit's own header.
#
# Phase 13 adds object orientation, scoped deliberately to FIELDS ONLY --
# checked before writing code, not discovered as a gap afterward: real
# methods need genuine call-with-return dispatch into user code (this
# engine's only call-with-return mechanism, Phase 10's Emit, is
# deliberately too narrow -- a handler can never itself call another
# block), and real methods-as-closures need first-class closures, which
# this engine has never built (see event_dispatch.feature's own note). A
# `ClassDecl` declaring `inherits`/methods/traits is rejected plainly via
# bm_lower_unsupported, not silently mishandled.
#
# An object is represented as a Box (Phase 1/3) wrapping a Handler-shaped
# assoc-list (Phase 4) of field name/value pairs -- NOT a new heap layout.
# This is a deliberate design choice, not a shortcut: it answers the plan's
# own flagged "does mut extend to field writes" question directly (yes,
# via the SAME box_set refcount-checked mutate-in-place-vs-clone mechanism
# Phase 3 already proved, since writing a field literally IS calling
# box_set on the object's own whole record), and it means Phase 13 needed
# ZERO new heap/runtime primitives. `new("ClassName")` is resolved entirely
# at LOWERING time against a compile-time class registry (bm_class_
# registry, below) -- deliberately NOT the real engine's own runtime
# `new`/`class_def`/OBJECTS-registry mechanism (a name-keyed global store
# the design doc's own Fork B explicitly wants to move AWAY from, see
# block-ownership-model.md section 6) -- so Phase 13's `new(...)` only
# ever takes a single literal class-name string, no extra constructor args
# and no compatibility with the OLDER `new("Class", "instance_name", ...)`
# form.
#
# Since Box is native-x64-only (checked directly: `host fn 'rt_heap_alloc'
# not found` under --ir-run, same finding Phase 1 already made), EVERY
# scenario that actually constructs an object needs native x64 compilation
# (the same `./patc1.exe ... --x64` two-step Phase 3/7 already established)
# -- but the inherits/methods/traits REJECTION happens purely at lowering
# time, before any Box instruction is ever emitted, so those fixtures run
# fine under the plain interpreter.
make a function called bm_class_registry_set takes registry, name, fields returns out
  let n = list_len(registry)
  let i = 0
  while i < n do
    if list_get(list_get(registry, i), 0) == name then
      return list_set(registry, i, [name, fields])
    end
    let i = i + 1
  end
  return list_push(registry, [name, fields])
end

make a function called bm_class_fields takes class_name returns fields
  return bm_assoc_get(get("__vars", "bm_class_registry"), class_name)
end

# Phase 12 adds `require`/`ensure`/`assert` (design-by-contract). The real
# self-hosted lower.patlang lowers all three identically to a single
# contract_check(func_name, kind, text, ok) host call -- this engine has
# no generic host-function-call expression support yet (Phase 17's own
# job), so this phase reuses the existing ContractFail instruction
# (already used for immutable-reassignment and no-arm-matched failures)
# behind a JumpIfFalse instead: same OBSERVABLE behaviour (aborts with a
# named message when false, silently continues when true), not yet the
# same host-call shape.
#
# Checked directly, not assumed: this is entirely independent of the
# flight check (Fork C, Phase 7) -- that check's own bounded points-to/
# shape analysis is sized to proving box_set mutation-exclusivity
# specifically (see flight_check.patlang's own header) and has nothing to
# say about an arbitrary boolean expression. A require/ensure/assert is
# never subsumed by it, not "not yet wired up" -- see
# spec_library/block_model/contracts.feature's own header for the same
# note stated for the record.
#
# Phase 11 adds `match`/`case` (section 4.1's own "forks don't need their
# own boundary" finding, verified there only for if/else -- this phase
# checks it against Match too). Reuses the real self-hosted
# self_hosting/lib/lower.patlang's own compile_pattern/lower_match exactly
# as the template (same [testNode, letStmts] desugaring, same
# bindings-before-guard ordering, same JumpIfFalse-chain-per-arm shape,
# same guaranteed-fail tail when no arm matches) -- not a new pattern-
# compilation scheme invented for this engine.
#
# Deliberately scoped to PWild/PBind/PLit/PCmp -- the four pattern kinds
# expressible with bm_lower_expr's existing Const/Var/Bin support. PGlob
# (needs a generic host-function-call expression, glob_match) and PList
# (needs Member/Index expression support plus real List values) are
# explicitly NOT supported here -- checked before writing this, not
# discovered as a gap afterward: bm_lower_expr has neither Member/Index
# nor generic host-function-call support today (Phase 17's own job, per
# docs/plans/block-ownership-model-full-language-plan.md). A PGlob/PList
# pattern hits bm_lower_unsupported, named plainly.
#
# Phase 10 adds event dispatch (section 8's own claim, checked directly
# against the real Rust interpreter and found narrower than stated -- see
# block_ir.patlang's own Phase 10 note for the full finding): a top-level
# `["When", event_name, body, line]` node lowers to its own synthesized,
# non-jump-callable BlockIR, registered in the program's own compile-time
# event table (bi_program_events) rather than block_names/blocks_by_name --
# deliberately excluded from both, so a handler can NEVER be reached via
# an ordinary JumpBlock/Call, only through Emit's own table lookup. Its
# body is lowered with block_names/blocks_by_name passed as EMPTY lists on
# purpose: this phase's Emit instruction runs a handler as a bounded,
# non-tail sub-execution with no call stack to unwind through a nested
# jump (interp.patlang's own header), so a handler calling another
# declared function is out of scope here, not silently allowed -- it hits
# bm_lower_unsupported exactly like any other unrecognized call shape. A
# `while` loop IS still reachable inside a handler body for free (nothing
# about bm_lower_top_level_stmt_list's own While handling depends on
# block_names), since a loop's own JumpBlock targets are always its own
# synthesized head/exit blocks, never a user-declared function. This
# claim was correct at LOWERING time but Emit's own EXECUTION of it was
# not, for several sessions: interp.patlang's own Emit case used to make
# a single bare bi_run_block call and reject the loop's own first
# "jump" outcome as unsupported -- found and fixed in Phase 21 (see
# interp.patlang's own bi_run_from header), not caught here since this
# comment only ever described lowering, not execution.
#
# `emit(event, payload)` lowers as a bare statement (bm_lower_stmt's own
# "Expr" arm) to a MID-BLOCK ["Emit"] instruction, never a JumpBlock --
# see block_ir.patlang's own header for exactly why (it returns control,
# unlike everything else this engine's blocks end with).
#
# Phase 7 adds (section 6, Fork C, wired in for real): flight_check
# .patlang's own `fresh` tracking, threaded through
# bm_lower_top_level_stmt_list (see its own Let-handling below), decides
# whether a box_set call site is patched from BoxSet (Phase 3's runtime
# refcount check) to BoxSetUnchecked (skip it -- proven safe statically).
# See flight_check.patlang's own header for exactly how narrow that
# proof is kept (a straight line of top-level statements only; anything
# else -- if/else, while, a jump-call -- invalidates the whole set rather
# than being reasoned through). `fresh` is deliberately NOT threaded into
# bm_lower_expr's own signature for this: since only ONE call shape
# (`let X = box_set(Y, ...)`) is ever eligible, patching the single
# instruction bm_lower_stmt already emitted (always immediately before
# the Store it also emits) is simpler and less error-prone than adding a
# parameter to every one of bm_lower_expr's ~20 call sites for a decision
# only one of them needs.

include "block_ir.patlang"
include "free_vars.patlang"
include "flight_check.patlang"

make a function called bm_is_mut_param_name takes name returns yes
  if name.length < 4 then
    return false
  end
  return substr(name, 0, 4) == "mut_"
end

make a function called bm_list_contains takes xs, v returns yes
  let n = list_len(xs)
  let i = 0
  while i < n do
    if list_get(xs, i) == v then
      return true
    end
    let i = i + 1
  end
  return false
end

make a function called bm_lower_unsupported takes what returns nothing
  contract_check("bm_lower", "assert", "block-model Phase 2's restricted subset does not support: " + what, false)
  return false
end

# Issue #182: first-class closures.
#
# A closure is the list ["__closure", <block name>, [captured values...]],
# built with BuildList. `|params| { body }` synthesizes a function block
# `__closure_N` whose parameters are (__captured, params..., __globals); its
# prologue unpacks each captured name out of __captured with list_get. The
# captured set is the body's free variables (bm_fv_*, so an enclosing loop
# forwards a variable used only inside a closure) intersected with the names
# the ENCLOSING function binds -- by-value capture at creation, which is what
# the real engine does (checked: a later rebinding is not seen) and what
# Fork B's value semantics already give.
#
# An expression cannot hand a new block back to its caller, so synthesized
# closure blocks are collected in a compile-time registry that
# bm_lower_program drains into the program, the same pattern bm_class_registry
# already uses. The compile-time blocks_by_name is stashed the same way so a
# closure body can tail-call declared functions.

# Issue #177: `activate PLAN`. Mirrors self_hosting/lib/lower.patlang's
# lower_activate_stmt (which mirrors the native lowerer's lower_activate):
# host functions cannot call back into the interpreter to run a closure, so
# `activate` is not a host call at all but ordinary control-flow AST --
# Let/While/If/Call -- that walks the plan, looks up each step's bound closure
# (action_lookup), and calls it THROUGH A VARIABLE with the step's bound
# argument values as a single list, stopping at the first step that returns
# false. Here it is an AST -> AST rewrite applied to a function body BEFORE
# lowering, so the synthesized lets are seen by the bound-name analysis and
# the closure-call path (#182) handles `fn(args)` like any other closure call.
# Only the two statement shapes the real lowerer recognizes are expanded:
# `let x = activate(P)` and a bare `activate(P)`.
make a function called bm_activate_synth takes plan_node, n returns synth
  let plan_var = n + "_plan"
  let i_var = n + "_i"
  let ok_var = n + "_ok"
  let label_var = n + "_label"
  let fn_var = n + "_fn"
  let args_var = n + "_args"
  let r_var = n + "_r"
  return [
    ["Let", plan_var, plan_node, false, false],
    ["Let", i_var, ["Num", "0"], false, true],
    ["Let", ok_var, ["Bool", "true"], false, true],
    ["While",
      ["Bin", "and",
        ["Var", ok_var],
        ["Bin", "<", ["Var", i_var], ["Call", "to_num", [["Call", "list_len", [["Var", plan_var]]]]]]
      ],
      [
        ["Let", label_var, ["Index", ["Var", plan_var], ["Var", i_var]], false, false],
        ["Let", fn_var, ["Call", "action_lookup", [["Call", "action_base_name", [["Var", label_var]]]]], false, false],
        ["Let", args_var, ["Call", "action_label_args", [["Var", label_var]]], false, false],
        ["Let", r_var, ["Call", fn_var, [["Var", args_var]]], false, false],
        ["If", ["Bin", "==", ["Var", r_var], ["Bool", "false"]],
          [["Let", ok_var, ["Bool", "false"], true, false]],
          []
        ],
        ["Let", i_var, ["Bin", "+", ["Var", i_var], ["Num", "1"]], true, false]
      ]
    ]
  ]
end

make a function called bm_is_activate_call takes e returns yes
  if list_get(e, 0) != "Call" then
    return false
  end
  return (list_get(e, 1) == "activate") and (list_len(list_get(e, 2)) == 1)
end

make a function called bm_expand_activate_list takes stmts returns out
  let out = []
  let n = list_len(stmts)
  let i = 0
  while i < n do
    let s = list_get(stmts, i)
    let ty = list_get(s, 0)
    if (ty == "Let") and bm_is_activate_call(list_get(s, 2)) then
      let base = bm_next_synth_name("__act")
      let synth = bm_activate_synth(list_get(list_get(list_get(s, 2), 2), 0), base)
      let k = 0
      while k < list_len(synth) do
        let out = list_push(out, list_get(synth, k))
        let k = k + 1
      end
      let out = list_push(out, list_set(s, 2, ["Var", base + "_ok"]))
    elif (ty == "Expr") and bm_is_activate_call(list_get(s, 1)) then
      let base = bm_next_synth_name("__act")
      let synth = bm_activate_synth(list_get(list_get(list_get(s, 1), 2), 0), base)
      let k = 0
      while k < list_len(synth) do
        let out = list_push(out, list_get(synth, k))
        let k = k + 1
      end
    elif ty == "If" then
      let s2 = list_set(s, 2, bm_expand_activate_list(list_get(s, 2)))
      let out = list_push(out, list_set(s2, 3, bm_expand_activate_list(list_get(s, 3))))
    elif ty == "While" then
      let out = list_push(out, list_set(s, 2, bm_expand_activate_list(list_get(s, 2))))
    elif ty == "Match" then
      let arms = list_get(s, 2)
      let new_arms = []
      let ai = 0
      while ai < list_len(arms) do
        let arm = list_get(arms, ai)
        let new_arms = list_push(new_arms, list_set(arm, 2, bm_expand_activate_list(list_get(arm, 2))))
        let ai = ai + 1
      end
      let out = list_push(out, list_set(s, 2, new_arms))
    else
      let out = list_push(out, s)
    end
    let i = i + 1
  end
  return out
end

# Every name a function body binds: its parameters plus every `let`, at any
# depth of if/while/match, NOT descending into closure literals (a closure is
# its own scope). Used to recognize `f(x)` as a call through a variable.
make a function called bm_bound_names_of takes params, body returns names
  let names = []
  let pn = list_len(params)
  let pi = 0
  while pi < pn do
    let names = bm_union_preserving_order(names, [list_get(params, pi)])
    let pi = pi + 1
  end
  return bm_collect_let_names(body, names)
end

make a function called bm_collect_let_names takes stmts, names returns out
  let n = list_len(stmts)
  let i = 0
  while i < n do
    let s = list_get(stmts, i)
    let ty = list_get(s, 0)
    if ty == "Let" then
      # Issue #156: check and push INLINE -- passing `names` to
      # bm_union_preserving_order would make its push copy the whole list
      # (the caller still holds it), once per `let`.
      if not bm_list_contains(names, list_get(s, 1)) then
        let names = list_push(names, list_get(s, 1))
      end
    elif ty == "If" then
      let names = bm_collect_let_names(list_get(s, 2), names)
      let names = bm_collect_let_names(list_get(s, 3), names)
    elif ty == "While" then
      let names = bm_collect_let_names(list_get(s, 2), names)
    elif ty == "Match" then
      let arms = list_get(s, 2)
      let an = list_len(arms)
      let ai = 0
      while ai < an do
        let names = bm_collect_let_names(list_get(list_get(arms, ai), 2), names)
        let ai = ai + 1
      end
    end
    let i = i + 1
  end
  return names
end

make a function called bm_is_fn_bound_name takes name returns yes
  let bound = get("__vars", "bm_fn_bound_names")
  if type_of(bound) != "list" then
    return false
  end
  return bm_list_contains(bound, name)
end

make a function called bm_lower_closure_expr takes node, instrs, block_names, immut_params returns out
  let params = list_get(node, 1)
  let body = bm_expand_activate_list(list_get(node, 2))
  let outer_bound = get("__vars", "bm_fn_bound_names")
  let free = list_get(bm_fv_stmt_list(body, params, []), 1)
  let captured = bm_intersect_preserving_order(outer_bound, free)
  let name = bm_next_synth_name("__closure")
  # The closure body's own scope: __captured, its params, every captured
  # name, and whatever its body binds.
  let inner_names = bm_bound_names_of(bm_union_preserving_order(["__captured"], bm_union_preserving_order(params, captured)), body)
  set_var("bm_fn_bound_names", inner_names)
  let prologue = []
  let cn = list_len(captured)
  let ci = 0
  while ci < cn do
    let prologue = list_push(prologue, ["Load", "__captured"])
    let prologue = list_push(prologue, ["Const", "num", "" + ci])
    let prologue = list_push(prologue, ["CallHost", "list_get", 2])
    let prologue = list_push(prologue, ["Store", list_get(captured, ci)])
    let ci = ci + 1
  end
  let inner_immut = []
  let pn = list_len(params)
  let pi = 0
  while pi < pn do
    if not bm_is_mut_param_name(list_get(params, pi)) then
      let inner_immut = list_push(inner_immut, list_get(params, pi))
    end
    let pi = pi + 1
  end
  let known = bm_union_preserving_order(captured, params)
  let top = bm_lower_top_level_stmt_list(body, 0, prologue, block_names, get("__vars", "bm_ct_blocks_by_name"), inner_immut, known, [], [], ["none"])
  set_var("bm_fn_bound_names", outer_bound)
  let closure_params = list_push(bm_union_preserving_order(["__captured"], params), "__globals")
  let registry = get("__vars", "bm_closure_blocks")
  let registry = list_push(registry, ["BlockIR", name, closure_params, bm_hash_rewrite_instrs(list_get(top, 0))])
  let sn = list_len(list_get(top, 1))
  let si = 0
  while si < sn do
    let registry = list_push(registry, list_get(list_get(top, 1), si))
    let si = si + 1
  end
  set_var("bm_closure_blocks", registry)
  # Creation site: ["__closure", name, [captured...]].
  let instrs = list_push(instrs, ["Const", "str", "__closure"])
  let instrs = list_push(instrs, ["Const", "str", name])
  let ci = 0
  while ci < cn do
    let instrs = list_push(instrs, ["Load", list_get(captured, ci)])
    let ci = ci + 1
  end
  let instrs = list_push(instrs, ["BuildList", cn])
  return list_push(instrs, ["BuildList", 3])
end

# `f(a1..an)` where f is bound in the current function: unpack the closure
# value and dispatch through CallDynamic (#153) with the captured list as the
# first extra argument. Stack for CallDynamic: extra args, callee name,
# __globals.
make a function called bm_lower_closure_call takes name, args, instrs, block_names, immut_params returns out
  let instrs = list_push(instrs, ["Load", name])
  let instrs = list_push(instrs, ["Const", "num", "2"])
  let instrs = list_push(instrs, ["CallHost", "list_get", 2])
  let an = list_len(args)
  let ai = 0
  while ai < an do
    let instrs = bm_lower_expr(list_get(args, ai), instrs, block_names, immut_params)
    let ai = ai + 1
  end
  let instrs = list_push(instrs, ["Load", name])
  let instrs = list_push(instrs, ["Const", "num", "1"])
  let instrs = list_push(instrs, ["CallHost", "list_get", 2])
  let instrs = list_push(instrs, ["Load", "__globals"])
  return list_push(instrs, ["CallDynamic", an + 1])
end

# Issue #153: `apply(fname, a1, ..., an)` -- emits a1..an in written order
# (deepest on the stack), then the callee-name expression, then the
# current __globals, then ["CallDynamic", n]. interp.patlang's own case
# pops globals, name, then n args (restoring written order via
# bm_st_pop_n), binds them positionally to the resolved callee block's
# own declared parameters, and leaves the callee's return value on the
# caller's stack. Shared by bm_lower_expr (value context, result kept) and
# bm_lower_stmt (bare statement, result discarded by its own caller).
make a function called bm_lower_apply takes call_args, instrs, block_names, immut_params returns out
  let total = list_len(call_args)
  let extra = total - 1
  let ai = 1
  while ai < total do
    let instrs = bm_lower_expr(list_get(call_args, ai), instrs, block_names, immut_params)
    let ai = ai + 1
  end
  let instrs = bm_lower_expr(list_get(call_args, 0), instrs, block_names, immut_params)
  let instrs = list_push(instrs, ["Load", "__globals"])
  return list_push(instrs, ["CallDynamic", extra])
end

make a function called bm_lower_expr takes node, instrs, block_names, immut_params returns out
  let ty = list_get(node, 0)
  if ty == "Num" then
    return list_push(instrs, ["Const", "num", list_get(node, 1)])
  elif ty == "Str" then
    return list_push(instrs, ["Const", "str", list_get(node, 1)])
  elif ty == "Bool" then
    return list_push(instrs, ["Const", "bool", list_get(node, 1)])
  elif ty == "Var" then
    return list_push(instrs, ["Load", list_get(node, 1)])
  elif ty == "Bin" then
    let op = list_get(node, 1)
    if op == "and" then
      # Phase 22, third correction: "and"/"or" were being lowered like
      # every other Bin op -- eagerly evaluating BOTH sides, then a plain
      # "Bin" instruction -- which interp.patlang's own bm_apply_bin has
      # no case for at all ("unknown Bin op hash"), and is doubly wrong
      # regardless: real PatLang short-circuits (self_hosting/lib/lower
      # .patlang's own "Bin" case, `node[1] == "and"`/`"or"` arms), so
      # eagerly evaluating the RHS can run code that should never have
      # run at all (confirmed via a minimal repro: `(x == 0) or (10 / x
      # > 1)` crashed with a genuine division-by-zero from the RHS, not
      # just the missing-op error, when x == 0 should have short-
      # circuited "or" before ever evaluating it). Found while
      # re-attempting Phase 18's own checkpoint one level further out
      # (self_hosting/lib/test.patlang's own run_feature uses `(c == 10)
      # or (c == -1)`). Mirrors lower.patlang's own "and" arm exactly,
      # using this engine's own existing JumpIfFalse/Jump/Un/Const
      # instructions -- no new bytecode needed.
      let instrs = bm_lower_expr(list_get(node, 2), instrs, block_names, immut_params)
      let instrs = list_push(instrs, ["Un", "not"])
      let jif_pos = list_len(instrs)
      let instrs = list_push(instrs, ["JumpIfFalse", 0])
      let instrs = list_push(instrs, ["Const", "bool", "false"])
      let jmp_pos = list_len(instrs)
      let instrs = list_push(instrs, ["Jump", 0])
      let instrs = list_set(instrs, jif_pos, ["JumpIfFalse", list_len(instrs)])
      let instrs = bm_lower_expr(list_get(node, 3), instrs, block_names, immut_params)
      let instrs = list_push(instrs, ["Un", "not"])
      let instrs = list_push(instrs, ["Un", "not"])
      let instrs = list_set(instrs, jmp_pos, ["Jump", list_len(instrs)])
      return instrs
    elif op == "or" then
      # Mirrors lower.patlang's own "or" arm exactly -- see the "and"
      # case just above for the full rationale.
      let instrs = bm_lower_expr(list_get(node, 2), instrs, block_names, immut_params)
      let instrs = list_push(instrs, ["Un", "not"])
      let jif_pos = list_len(instrs)
      let instrs = list_push(instrs, ["JumpIfFalse", 0])
      let instrs = bm_lower_expr(list_get(node, 3), instrs, block_names, immut_params)
      let instrs = list_push(instrs, ["Un", "not"])
      let instrs = list_push(instrs, ["Un", "not"])
      let jmp_pos = list_len(instrs)
      let instrs = list_push(instrs, ["Jump", 0])
      let instrs = list_set(instrs, jif_pos, ["JumpIfFalse", list_len(instrs)])
      let instrs = list_push(instrs, ["Const", "bool", "true"])
      let instrs = list_set(instrs, jmp_pos, ["Jump", list_len(instrs)])
      return instrs
    end
    let instrs = bm_lower_expr(list_get(node, 2), instrs, block_names, immut_params)
    let instrs = bm_lower_expr(list_get(node, 3), instrs, block_names, immut_params)
    return list_push(instrs, ["Bin", op])
  elif ty == "Un" then
    let instrs = bm_lower_expr(list_get(node, 2), instrs, block_names, immut_params)
    return list_push(instrs, ["Un", list_get(node, 1)])
  elif ty == "Budgeted" then
    # Issue #176: ["Budgeted", ms, existing, body]. Lowered as a call to the
    # interpreter-intercepted `bm_budgeted_run(ms, closure, existing,
    # __globals)`, where the body is a zero-parameter closure (#182) lowered
    # with the budget depth raised, so every `while` back-edge inside it gets
    # a `budget_check` (see bm_lower_while).
    let instrs = bm_lower_expr(list_get(node, 1), instrs, block_names, immut_params)
    set_var("bm_budgeted_depth", get("__vars", "bm_budgeted_depth") + 1)
    let instrs = bm_lower_closure_expr(["Closure", [], list_get(node, 3)], instrs, block_names, immut_params)
    set_var("bm_budgeted_depth", get("__vars", "bm_budgeted_depth") - 1)
    let instrs = bm_lower_expr(list_get(node, 2), instrs, block_names, immut_params)
    let instrs = list_push(instrs, ["Load", "__globals"])
    return list_push(instrs, ["CallHost", "bm_budgeted_run", 4])
  elif ty == "Closure" then
    # Issue #182: see bm_lower_closure_expr.
    return bm_lower_closure_expr(node, instrs, block_names, immut_params)
  elif ty == "Member" then
    let obj_node = list_get(node, 1)
    let prop = list_get(node, 2)
    if (prop == "length") or (prop == "len") then
      # Phase 22: `.length`/`.len` on an ordinary String or List -- NOT
      # Box+Handler object-field access. Mirrors self_hosting/lib/lower
      # .patlang's own Member case exactly (that file's `ty == "Member"`
      # arm): a genuine, already-"feature complete" host function,
      # CallHost "len", that works correctly under BOTH backends --
      # unlike BoxGet, which is native-x64-only (heap.patlang's own
      # bm_box_read calls mem_peek_qword directly, not implemented under
      # the interpreter at all -- confirmed via a direct repro,
      # `let s = "hello"; print(s.length)`, crashing with "host fn
      # 'mem_peek_qword' not found" before this fix).
      let instrs = bm_lower_expr(obj_node, instrs, block_names, immut_params)
      return list_push(instrs, ["CallHost", "len", 1])
    end
    # obj.prop (read), any OTHER property name -- reuses HandlerLookup
    # exactly: an object's own payload (once BoxGet'd) IS a Handler-shaped
    # assoc-list (Phase 13's own header note above). Pop order matches
    # handler_lookup's own Call case below: name pushed first (bottom),
    # handler pushed second (top).
    let instrs = list_push(instrs, ["Const", "str", prop])
    let instrs = bm_lower_expr(obj_node, instrs, block_names, immut_params)
    let instrs = list_push(instrs, ["BoxGet"])
    return list_push(instrs, ["HandlerLookup"])
  elif ty == "List" then
    # Phase 18: a literal `[a, b, c]` -- lower each item (in written
    # order, matching the real self-hosted lower.patlang's own "List"
    # case exactly: self_hosting/lib/lower.patlang's lower_expr, `ty ==
    # "List"` arm) then a new BuildList instruction (Phase 17/18's own
    # named-but-deferred gap, now filled in): pops `n` values and pushes
    # a fresh List built from them, in the SAME order pushed -- see
    # interp.patlang's own "BuildList" case and bm_st_pop_n's header for
    # why order is preserved despite popping from a stack.
    let items = list_get(node, 1)
    let n = list_len(items)
    let ii = 0
    while ii < n do
      let instrs = bm_lower_expr(list_get(items, ii), instrs, block_names, immut_params)
      let ii = ii + 1
    end
    return list_push(instrs, ["BuildList", n])
  elif ty == "Index" then
    # Phase 18: `lst[i]` -- mirrors the real self-hosted lower.patlang's
    # own "Index" case exactly (lower_expr's `ty == "Index"` arm): lower
    # the list expression then the index expression (in that written
    # order), then dispatch to the genuine host function `list_get`
    # through the SAME generic CallHost mechanism this phase adds for
    # the "Call" case below -- not a new Handler*-style engine primitive,
    # since indexing an ordinary List has nothing to do with this
    # engine's own Box/Handler object representation (Phase 13's header).
    let instrs = bm_lower_expr(list_get(node, 1), instrs, block_names, immut_params)
    let instrs = bm_lower_expr(list_get(node, 2), instrs, block_names, immut_params)
    return list_push(instrs, ["CallHost", "list_get", 2])
  elif ty == "Call" then
    let name = list_get(node, 1)
    let args = list_get(node, 2)
    if name == "new" then
      # Phase 13: new("ClassName") only -- see this file's own header for
      # why this deliberately doesn't match the real engine's own runtime
      # new/class_def/OBJECTS-registry mechanism.
      let class_name_node = list_get(args, 0)
      if list_get(class_name_node, 0) != "Str" then
        bm_lower_unsupported("new(...) with a non-literal class name (Phase 13 requires new(\"ClassName\") with a literal string)")
        return instrs
      end
      let class_name = list_get(class_name_node, 1)
      let fields = bm_class_fields(class_name)
      if fields == false then
        bm_lower_unsupported("new(\"" + class_name + "\") -- no class named '" + class_name + "' was declared with `class " + class_name + " do ... end` (Phase 13 does not support the older name-registry new(...) form)")
        return instrs
      end
      let tmp = bm_next_synth_name("__newobj")
      let instrs = list_push(instrs, ["HandlerNew"])
      let instrs = list_push(instrs, ["Store", tmp])
      let flds_n = list_len(fields)
      let fi = 0
      while fi < flds_n do
        let fld = list_get(fields, fi)
        let instrs = bm_lower_expr(list_get(fld, 1), instrs, block_names, immut_params)
        let instrs = list_push(instrs, ["Const", "str", list_get(fld, 0)])
        let instrs = list_push(instrs, ["Load", tmp])
        let instrs = list_push(instrs, ["HandlerRegister"])
        let instrs = list_push(instrs, ["Store", tmp])
        let fi = fi + 1
      end
      let instrs = list_push(instrs, ["Load", tmp])
      return list_push(instrs, ["BoxNew"])
    elif name == "type_of" then
      let instrs = bm_lower_expr(list_get(args, 0), instrs, block_names, immut_params)
      return list_push(instrs, ["TypeOf"])
    elif name == "read_file" then
      let instrs = bm_lower_expr(list_get(args, 0), instrs, block_names, immut_params)
      return list_push(instrs, ["ReadFile"])
    elif name == "write_file" then
      let instrs = bm_lower_expr(list_get(args, 0), instrs, block_names, immut_params)
      let instrs = bm_lower_expr(list_get(args, 1), instrs, block_names, immut_params)
      return list_push(instrs, ["WriteFile"])
    elif name == "query" then
      let instrs = bm_lower_expr(list_get(args, 0), instrs, block_names, immut_params)
      let instrs = bm_lower_expr(list_get(args, 1), instrs, block_names, immut_params)
      let instrs = bm_lower_expr(list_get(args, 2), instrs, block_names, immut_params)
      return list_push(instrs, ["Query"])
    elif name == "box_new" then
      let instrs = bm_lower_expr(list_get(args, 0), instrs, block_names, immut_params)
      return list_push(instrs, ["BoxNew"])
    elif name == "box_get" then
      let instrs = bm_lower_expr(list_get(args, 0), instrs, block_names, immut_params)
      return list_push(instrs, ["BoxGet"])
    elif name == "box_share" then
      let instrs = bm_lower_expr(list_get(args, 0), instrs, block_names, immut_params)
      return list_push(instrs, ["BoxShare"])
    elif name == "box_set" then
      let target = list_get(args, 0)
      if (list_get(target, 0) == "Var") and bm_list_contains(immut_params, list_get(target, 1)) then
        # Matches section 3.4's own original template exactly: a RUNTIME
        # guaranteed-fail check at the violation point (only fails when
        # this line actually executes), not a compile-time reject --
        # consistent with how self_hosting/lib/lower.patlang's own
        # immutable-reassignment check works (see that file's `Let` arm).
        return list_push(instrs, ["ContractFail", "box_set on read-only parameter '" + list_get(target, 1) + "' (declare it `mut_" + list_get(target, 1) + "` to allow mutation)"])
      end
      let instrs = bm_lower_expr(target, instrs, block_names, immut_params)
      let instrs = bm_lower_expr(list_get(args, 1), instrs, block_names, immut_params)
      return list_push(instrs, ["BoxSet"])
    elif name == "get_global" then
      let instrs = bm_lower_expr(list_get(args, 0), instrs, block_names, immut_params)
      let instrs = list_push(instrs, ["Load", "__globals"])
      return list_push(instrs, ["GlobalGet"])
    elif name == "handler_new" then
      return list_push(instrs, ["HandlerNew"])
    elif name == "handler_register" then
      let instrs = bm_lower_expr(list_get(args, 2), instrs, block_names, immut_params)
      let instrs = bm_lower_expr(list_get(args, 1), instrs, block_names, immut_params)
      let instrs = bm_lower_expr(list_get(args, 0), instrs, block_names, immut_params)
      return list_push(instrs, ["HandlerRegister"])
    elif name == "handler_lookup" then
      let instrs = bm_lower_expr(list_get(args, 1), instrs, block_names, immut_params)
      let instrs = bm_lower_expr(list_get(args, 0), instrs, block_names, immut_params)
      return list_push(instrs, ["HandlerLookup"])
    elif name == "apply" then
      # Issue #153: value-context apply(fname, a1, ..., an) -- the callee's
      # return value stays on the stack for the surrounding expression.
      return bm_lower_apply(args, instrs, block_names, immut_params)
    elif bm_is_fn_bound_name(name) then
      # Issue #182: `f(a, b)` where f is a parameter or `let` of the current
      # function -- a call through a closure value. A local shadows a
      # declared function of the same name, as in the real engine.
      return bm_lower_closure_call(name, args, instrs, block_names, immut_params)
    elif bm_list_contains(block_names, name) then
      # Phase 21: a call to another DECLARED block-model function, used
      # as a SUB-EXPRESSION (NOT in tail/return position) -- the real
      # gap Phase 18 found and this phase fills in. Distinct from
      # JumpBlock (bm_lower_jump_call): JumpBlock is a one-way transfer
      # with no return, correct for and unchanged at every EXISTING
      # tail-call site; this is a genuine call WITH return, via the new
      # "Call" instruction (interp.patlang's own case, which recurses
      # through bi_run_from -- see that function's own header for why
      # this needs no classification/flattening distinction at all on
      # the interpreter side, unlike native x64's own later, separate
      # design). Same "args, then an implicit __globals push" convention
      # as bm_lower_jump_call, so the callee's own params (which already
      # end in "__globals", bm_lower_program's own doing) bind correctly.
      let ai = 0
      let an = list_len(args)
      while ai < an do
        let instrs = bm_lower_expr(list_get(args, ai), instrs, block_names, immut_params)
        let ai = ai + 1
      end
      let instrs = list_push(instrs, ["Load", "__globals"])
      return list_push(instrs, ["Call", name, an + 1])
    elif bm_lower_is_ambient_state_name(name) then
      # Phase 21: a real, previously-undisclosed leak in the generic
      # CallHost fallback just below, found while working on zs_schema
      # .patlang's own `new("Dict", ...)`-based registry: `set_var`/`get`/
      # `send` are genuine, real host functions (interp_call_host already
      # supports all three), so the generic fallback would otherwise
      # dispatch them straight through to the REAL, PROCESS-WIDE ambient
      # `__vars`/OBJECTS store -- completely bypassing Fork B's own
      # stated "full elimination of ambient globals" guarantee for any
      # block-model program that calls them directly instead of the
      # blessed `set_global`/`get_global`/`handler_*` sugar. `new` is
      # already blocked separately (Phase 13's own class-registry
      # interception, checked first, above), but `get`/`send` were not,
      # and neither was `set_var` when called in VALUE context (a bare
      # statement already failed for an unrelated reason -- bm_lower_stmt
      # 's own separate Call dispatch never got a generic fallback at
      # all -- but that's an accident of that dispatch chain's own scope,
      # not a deliberate block, so relying on it would have been fragile).
      # Confirmed as a real, exploitable gap via a direct repro (`let x =
      # set_var("key", 42)` then reading it back through `get`) before
      # fixing it here, not assumed from reasoning alone.
      bm_lower_unsupported("calling '" + name + "' directly -- this reaches genuine, process-wide ambient state (self_hosting/lib/interp.patlang's own interp_call_host), which Fork B's own design (docs/plans/block-ownership-model.md section 6) deliberately eliminates from this engine; use set_global/get_global or handler_new/handler_register/handler_lookup instead")
      return instrs
    else
      # Phase 17/18's own named-but-deferred generic host-call fallback,
      # now filled in: any name not individually recognized above, not a
      # declared block-model function either, and not one of the ambient-
      # state names rejected just above, is assumed a genuine, STATELESS
      # host function -- pushes args in WRITTEN order (matching every
      # other Call/CallHost convention in this file) then a CallHost
      # instruction, dispatched at runtime via interp_call_host (self_
      # hosting/lib/interp.patlang's own real, already-"feature complete"
      # host-function-by-name dispatcher, reused as-is rather than
      # reinvented -- confirmed no name collisions with this file's own
      # bm_-prefixed/bi_-prefixed functions before including it). Mirrors
      # the REAL self-hosted lower.patlang's own "Call" case exactly
      # (lower_expr's final `else`, when callee is neither a declared fn
      # nor a local closure variable -- this engine has no local closure
      # variables at all, so that middle case never applies here).
      let ai = 0
      let an = list_len(args)
      while ai < an do
        let instrs = bm_lower_expr(list_get(args, ai), instrs, block_names, immut_params)
        let ai = ai + 1
      end
      return list_push(instrs, ["CallHost", name, an])
    end
  end
  bm_lower_unsupported("expression shape '" + ty + "'")
  return instrs
end

# Phase 21: names that reach genuine, process-wide ambient state through
# interp_call_host, blocked from the generic CallHost fallback above --
# see that call site's own comment for the full rationale. A narrow,
# specifically-verified list (each one directly confirmed reachable and
# exploitable, not a guess at every possible ambient host function) --
# `new` is NOT included here since it's already intercepted separately,
# earlier in this same dispatch chain (Phase 13's own class-registry
# check).
make a function called bm_lower_is_ambient_state_name takes name returns yes
  if name == "set_var" then
    return true
  end
  if name == "get" then
    return true
  end
  if name == "send" then
    return true
  end
  return false
end

# A Call to another declared block: lowers its args (each pushed, in
# order) then a single JumpBlock naming the callee's OWN param list --
# JumpBlock's own contract (block_ir.patlang) is "pop one value per
# param_name, in that order", so the callee's declared parameter names
# double as the field names the jump populates, matching section 3.2's
# "populated by name when the jump happens" exactly.
# A Call to another declared block: lowers its args (each pushed, in
# order), then an implicit extra push of the CURRENT "__globals" value
# (never written at the source call site -- section 3.3's threading,
# automatic here), then a single JumpBlock naming the callee's OWN param
# list, which bm_lower_program has already appended "__globals" onto.
make a function called bm_lower_jump_call takes call_node, instrs, block_names, blocks_by_name, immut_params returns out
  let target = list_get(call_node, 1)
  let args = list_get(call_node, 2)
  let target_blk = bm_assoc_get(blocks_by_name, target)
  let params = bi_block_params(target_blk)
  let n = list_len(args)
  let instrs = instrs
  let i = 0
  while i < n do
    let instrs = bm_lower_expr(list_get(args, i), instrs, block_names, immut_params)
    let i = i + 1
  end
  let instrs = list_push(instrs, ["Load", "__globals"])
  return list_push(instrs, ["JumpBlock", target, params])
end

# Phase 11: mirrors self_hosting/lib/lower.patlang's own compile_pattern
# exactly, restricted to the four pattern kinds this engine's expression
# lowering can actually handle (see this file's own Phase 11 header note
# for PGlob/PList's real, checked-not-assumed exclusion).
make a function called bm_compile_pattern takes pattern, scrutinee_node returns r
  let tag = list_get(pattern, 0)
  if tag == "PWild" then
    return [["Bool", "true"], []]
  elif tag == "PBind" then
    return [["Bool", "true"], [["Let", list_get(pattern, 1), scrutinee_node, false, false]]]
  elif tag == "PLit" then
    return [["Bin", "==", scrutinee_node, list_get(pattern, 1)], []]
  elif tag == "PCmp" then
    return [["Bin", list_get(pattern, 1), scrutinee_node, list_get(pattern, 2)], []]
  end
  bm_lower_unsupported("match pattern kind '" + tag + "' (Phase 11 supports PWild/PBind/PLit/PCmp only)")
  return [["Bool", "false"], []]
end

# Phase 12: a small pretty-printer for this engine's own restricted
# expression shapes, mirroring what ast_to_source_text gives the real
# contract_check its own diagnostic text from -- scoped to exactly the
# expression kinds bm_lower_expr already understands (Num/Str/Bool/Var/
# Bin/Un), not a general unparser.
make a function called bm_expr_to_text takes node returns s
  let ty = list_get(node, 0)
  if ty == "Num" then
    return "" + list_get(node, 1)
  elif ty == "Str" then
    return "\"" + list_get(node, 1) + "\""
  elif ty == "Bool" then
    return "" + list_get(node, 1)
  elif ty == "Var" then
    return list_get(node, 1)
  elif ty == "Bin" then
    return bm_expr_to_text(list_get(node, 2)) + " " + list_get(node, 1) + " " + bm_expr_to_text(list_get(node, 3))
  elif ty == "Un" then
    return list_get(node, 1) + bm_expr_to_text(list_get(node, 2))
  end
  return "<expr>"
end

make a function called bm_lower_stmt takes node, instrs, block_names, blocks_by_name, immut_params returns out
  let ty = list_get(node, 0)
  if ty == "Let" then
    let instrs = bm_lower_expr(list_get(node, 2), instrs, block_names, immut_params)
    return list_push(instrs, ["Store", list_get(node, 1)])
  elif ty == "RuleDecl" then
    # Issue #177: `rule head(A, B) :- goal1(..), goal2(..).` -- sugar that
    # lowers to EXACTLY the instruction sequence a hand-written
    # rule_add(head_pred, [head_args...], [[pred, [args...]], ...]) call
    # already produces, mirroring self_hosting/lib/lower.patlang's own
    # "RuleDecl" arm. Every argument is a compile-time string TOKEN (a bare
    # rule-head `X` is a logic-variable NAME, not a local to evaluate).
    # Phase 15 deferred this because it builds compound lists; BuildList
    # (Phase 18) is what makes it expressible. The host function is reached
    # through the generic CallHost path (rule_add is in this engine's own
    # host extension table, since the shared table excludes logic).
    let head_args = list_get(node, 2)
    let body = list_get(node, 3)
    let instrs = list_push(instrs, ["Const", "str", list_get(node, 1)])
    let hn = list_len(head_args)
    let hi = 0
    while hi < hn do
      let instrs = list_push(instrs, ["Const", "str", list_get(list_get(head_args, hi), 1)])
      let hi = hi + 1
    end
    let instrs = list_push(instrs, ["BuildList", hn])
    let bn = list_len(body)
    let bi = 0
    while bi < bn do
      let bodygoal = list_get(body, bi)
      let bargs = list_get(bodygoal, 1)
      let instrs = list_push(instrs, ["Const", "str", list_get(bodygoal, 0)])
      let an = list_len(bargs)
      let ai = 0
      while ai < an do
        let instrs = list_push(instrs, ["Const", "str", list_get(list_get(bargs, ai), 1)])
        let ai = ai + 1
      end
      let instrs = list_push(instrs, ["BuildList", an])
      let instrs = list_push(instrs, ["BuildList", 2])
      let bi = bi + 1
    end
    let instrs = list_push(instrs, ["BuildList", bn])
    let instrs = list_push(instrs, ["CallHost", "rule_add", 3])
    return list_push(instrs, ["Store", "__bm_discard"])
  elif ty == "GoalDecl" then
    # Issue #177: `goal NAME { dep1(..), dep2(..) }` -- lowers to the
    # instruction sequence a hand-written goal_def(NAME, [[pred, [args...]],
    # ...]) call produces, mirroring the real lowerer's "GoalDecl" arm; dep
    # args are compile-time string tokens too.
    let deps = list_get(node, 2)
    let instrs = list_push(instrs, ["Const", "str", list_get(node, 1)])
    let dn = list_len(deps)
    let di = 0
    while di < dn do
      let depgoal = list_get(deps, di)
      let dargs = list_get(depgoal, 1)
      let instrs = list_push(instrs, ["Const", "str", list_get(depgoal, 0)])
      let an = list_len(dargs)
      let ai = 0
      while ai < an do
        let instrs = list_push(instrs, ["Const", "str", list_get(list_get(dargs, ai), 1)])
        let ai = ai + 1
      end
      let instrs = list_push(instrs, ["BuildList", an])
      let instrs = list_push(instrs, ["BuildList", 2])
      let di = di + 1
    end
    let instrs = list_push(instrs, ["BuildList", dn])
    let instrs = list_push(instrs, ["CallHost", "goal_def", 2])
    return list_push(instrs, ["Store", "__bm_discard"])
  elif ty == "Assert" then
    # require/ensure/assert -- kind is one of those three literal strings
    # (see parser.patlang's own parse_stmt: `["Assert", tx, e[0]]`).
    # `cond true` -> fall through; `cond false` -> ContractFail naming the
    # kind and the condition's own source text, matching contract_check's
    # own diagnostic shape as closely as this engine's instructions allow.
    let kind = list_get(node, 1)
    let cond = list_get(node, 2)
    let instrs = bm_lower_expr(cond, instrs, block_names, immut_params)
    let instrs = list_push(instrs, ["JumpIfFalse", 0])
    let jif_pos = list_len(instrs) - 1
    let instrs = list_push(instrs, ["Jump", 0])
    let jmp_pos = list_len(instrs) - 1
    let instrs = list_set(instrs, jif_pos, ["JumpIfFalse", list_len(instrs)])
    let instrs = list_push(instrs, ["ContractFail", kind + " failed: " + bm_expr_to_text(cond)])
    let instrs = list_set(instrs, jmp_pos, ["Jump", list_len(instrs)])
    return instrs
  elif ty == "MemberAssign" then
    # obj.prop = value -- reuses box_set's OWN mut-check and refcount
    # mutate-in-place-vs-clone mechanism unmodified (Phase 13's own header
    # note: writing a field literally IS calling box_set on the object's
    # whole record). The mut-check runs FIRST, before anything else is
    # lowered, matching box_set's own established style (the Call-expr
    # case above) rather than lowering everything then discarding it.
    let obj_node = list_get(node, 1)
    let prop = list_get(node, 2)
    let value_node = list_get(node, 3)
    if (list_get(obj_node, 0) == "Var") and bm_list_contains(immut_params, list_get(obj_node, 1)) then
      return list_push(instrs, ["ContractFail", "field write on read-only parameter '" + list_get(obj_node, 1) + "' (declare it `mut_" + list_get(obj_node, 1) + "` to allow mutation)"])
    end
    # Store obj into a fresh temp ONCE (never re-evaluate a possibly
    # side-effecting object expression twice, the same reasoning
    # compile_pattern's own scrutinee-caching comment gives). Build the
    # updated assoc-list via HandlerRegister (ref, then name, then the
    # CURRENT handler read back via BoxGet each time -- same pop order as
    # the handler_register Call-expr case above) into a SECOND temp, since
    # box_set's own pop order is (ptr pushed first/bottom, value pushed
    # second/top, per the box_set Call-expr case above) -- the opposite of
    # what falls out of computing the updated record right before BoxSet
    # would give, so it's computed first and reloaded in the right order
    # rather than pushed in the wrong order (a real bug caught here via a
    # genuine segfault, not assumed correct from the shape alone).
    let tmp = bm_next_synth_name("__objref")
    let tmp2 = bm_next_synth_name("__objnewval")
    let instrs = bm_lower_expr(obj_node, instrs, block_names, immut_params)
    let instrs = list_push(instrs, ["Store", tmp])
    let instrs = bm_lower_expr(value_node, instrs, block_names, immut_params)
    let instrs = list_push(instrs, ["Const", "str", prop])
    let instrs = list_push(instrs, ["Load", tmp])
    let instrs = list_push(instrs, ["BoxGet"])
    let instrs = list_push(instrs, ["HandlerRegister"])
    let instrs = list_push(instrs, ["Store", tmp2])
    let instrs = list_push(instrs, ["Load", tmp])
    let instrs = list_push(instrs, ["Load", tmp2])
    let instrs = list_push(instrs, ["BoxSet"])
    # box_set may return a DIFFERENT pointer (clone-on-alias, Phase 3) --
    # if obj_node is a bare Var, re-Store the result into that SAME
    # source-level name so this block's own later reads see the write,
    # exactly matching box_set's own "reassign to the result" convention,
    # just automated here since MemberAssign gives source no place to
    # write an explicit reassignment. When obj_node isn't a bare Var,
    # there's no name to re-point -- discarded, a real, named, narrow gap
    # (mutating through a non-Var object expression won't observe its own
    # post-clone update within the same block), not silently papered over.
    if list_get(obj_node, 0) == "Var" then
      return list_push(instrs, ["Store", list_get(obj_node, 1)])
    end
    return list_push(instrs, ["Store", bm_next_synth_name("__discard")])
  elif ty == "Match" then
    # Mirrors the real lower_match's own shape exactly: store the
    # scrutinee once (re-evaluating a side-effecting expression per arm
    # would be a real correctness bug, matching that file's own reasoning
    # verbatim), then a JumpIfFalse-chained sequence of (pattern test,
    # bindings, optional guard, body) per arm, ending in a guaranteed-fail
    # ContractFail if nothing matched -- PatLang has no static
    # exhaustiveness check, so an unmatched scrutinee is a genuine runtime
    # bug, not a silent no-op (the real engine's own issue #44 decision).
    let scrutinee_node = list_get(node, 1)
    let arms = list_get(node, 2)
    let tmp = bm_next_synth_name("__match")
    let instrs = bm_lower_expr(scrutinee_node, instrs, block_names, immut_params)
    let instrs = list_push(instrs, ["Store", tmp])
    let scrutinee_var = ["Var", tmp]
    let end_jumps = []
    let an = list_len(arms)
    let ai = 0
    while ai < an do
      let arm = list_get(arms, ai)
      let pattern = list_get(arm, 0)
      let guard = list_get(arm, 1)
      let body = list_get(arm, 2)
      let comp = bm_compile_pattern(pattern, scrutinee_var)
      let test_node = list_get(comp, 0)
      let let_stmts = list_get(comp, 1)
      let instrs = bm_lower_expr(test_node, instrs, block_names, immut_params)
      let instrs = list_push(instrs, ["JumpIfFalse", 0])
      let jif_pattern_pos = list_len(instrs) - 1
      # Bindings a pattern introduced (PBind) must exist before the guard
      # runs -- a guard referencing that binding (`case n when n > 100`)
      # would otherwise read an unbound name, exactly the real
      # lower_match's own documented reasoning for this ordering.
      let ln = list_len(let_stmts)
      let li = 0
      while li < ln do
        let instrs = bm_lower_stmt(list_get(let_stmts, li), instrs, block_names, blocks_by_name, immut_params)
        let li = li + 1
      end
      let jif_guard_pos = 0 - 1
      if guard != false then
        let instrs = bm_lower_expr(guard, instrs, block_names, immut_params)
        let instrs = list_push(instrs, ["JumpIfFalse", 0])
        let jif_guard_pos = list_len(instrs) - 1
      end
      let instrs = bm_lower_stmt_list(body, instrs, block_names, blocks_by_name, immut_params)
      let instrs = list_push(instrs, ["Jump", 0])
      let end_jumps = list_push(end_jumps, list_len(instrs) - 1)
      let next_arm_pc = list_len(instrs)
      let instrs = list_set(instrs, jif_pattern_pos, ["JumpIfFalse", next_arm_pc])
      if jif_guard_pos >= 0 then
        let instrs = list_set(instrs, jif_guard_pos, ["JumpIfFalse", next_arm_pc])
      end
      let ai = ai + 1
    end
    let instrs = list_push(instrs, ["ContractFail", "match: no arm matched"])
    let end_pos = list_len(instrs)
    let en = list_len(end_jumps)
    let ei = 0
    while ei < en do
      let instrs = list_set(instrs, list_get(end_jumps, ei), ["Jump", end_pos])
      let ei = ei + 1
    end
    return instrs
  elif ty == "If" then
    let cond = list_get(node, 1)
    let then_stmts = list_get(node, 2)
    let else_stmts = list_get(node, 3)
    let instrs = bm_lower_expr(cond, instrs, block_names, immut_params)
    let instrs = list_push(instrs, ["JumpIfFalse", 0])
    let jif_pos = list_len(instrs) - 1
    let instrs = bm_lower_stmt_list(then_stmts, instrs, block_names, blocks_by_name, immut_params)
    let instrs = list_push(instrs, ["Jump", 0])
    let jmp_pos = list_len(instrs) - 1
    let instrs = list_set(instrs, jif_pos, ["JumpIfFalse", list_len(instrs)])
    let instrs = bm_lower_stmt_list(else_stmts, instrs, block_names, blocks_by_name, immut_params)
    let instrs = list_set(instrs, jmp_pos, ["Jump", list_len(instrs)])
    return instrs
  elif ty == "Expr" then
    let call = list_get(node, 1)
    if list_get(call, 0) == "Call" then
      let name = list_get(call, 1)
      let call_args = list_get(call, 2)
      if name == "print" then
        let instrs = bm_lower_expr(list_get(call_args, 0), instrs, block_names, immut_params)
        return list_push(instrs, ["Print"])
      elif name == "set_global" then
        # Statement-only (unlike get_global): auto-writes "__globals"
        # directly, so it never leaves a value on the stack to consume --
        # exactly matching how the real ambient set_var(...) is used
        # today (a bare statement, never an expression).
        let instrs = bm_lower_expr(list_get(call_args, 1), instrs, block_names, immut_params)
        let instrs = bm_lower_expr(list_get(call_args, 0), instrs, block_names, immut_params)
        let instrs = list_push(instrs, ["Load", "__globals"])
        return list_push(instrs, ["GlobalSet"])
      elif (name == "box_set") or (name == "box_share") or (name == "box_new") or (name == "box_get") or (name == "get_global") or (name == "handler_new") or (name == "handler_register") or (name == "handler_lookup") or (name == "type_of") or (name == "read_file") or (name == "write_file") or (name == "query") then
        # Phase 19 found a real, latent bug here while debugging a native
        # build: EVERY one of these is an expression (pushes a real
        # result), but this delegation used to return bm_lower_expr's own
        # output UNCHANGED when called as a bare statement -- leaving that
        # result sitting on the stack, unconsumed, corrupting whatever
        # this block does next (checked directly: a fixture chaining
        # fact()/write_file() as bare statements before further calls
        # printed garbage from the resulting misalignment). The real
        # lower.patlang's own established convention is exactly this:
        # `if wants_value == false then Store "__discard" end` after an
        # unconsumed Call -- applied here now, at this ONE shared
        # delegation point rather than patched per name, since all twelve
        # names funnel through it. Never previously exercised because no
        # earlier fixture chained two of these bare-statement calls (or
        # one plus anything else) in the same block.
        let instrs = bm_lower_expr(call, instrs, block_names, immut_params)
        return list_push(instrs, ["Store", "__bm_discard"])
      elif name == "fact" then
        # Bare statement, matching print/emit's own convention -- fact()
        # returns Unit in the real host function too, never consumed.
        let instrs = bm_lower_expr(list_get(call_args, 0), instrs, block_names, immut_params)
        let instrs = bm_lower_expr(list_get(call_args, 1), instrs, block_names, immut_params)
        let instrs = bm_lower_expr(list_get(call_args, 2), instrs, block_names, immut_params)
        return list_push(instrs, ["Fact"])
      elif name == "fiber_yield" then
        # Mid-block, same reasoning as emit's own lowering: fiber_yield
        # returns whatever the corresponding fiber_resume passed, and this
        # engine's programs need to keep running afterward, not jump away
        # permanently.
        let instrs = bm_lower_expr(list_get(call_args, 0), instrs, block_names, immut_params)
        return list_push(instrs, ["FiberYield"])
      elif name == "emit" then
        # Mid-block, unlike everything else emitted here (JumpBlock always
        # ends the block; Emit never does) -- see block_ir.patlang's own
        # Phase 10 header for why: emit() genuinely returns control to the
        # statement after it, matching the real interpreter's own
        # call-with-return semantics, not a jump-and-never-return one.
        let instrs = bm_lower_expr(list_get(call_args, 1), instrs, block_names, immut_params)
        let instrs = bm_lower_expr(list_get(call_args, 0), instrs, block_names, immut_params)
        let instrs = list_push(instrs, ["Load", "__globals"])
        return list_push(instrs, ["Emit"])
      elif name == "apply" then
        # apply(fname): a REAL host function (rust-runtime/src/ir/
        # interpreter.rs's own "apply" arm) that dispatches to a
        # DECLARED PatLang function BY NAME, dynamically -- a genuinely
        # new capability this engine never had any way to express before
        # (JumpBlock and Phase 21's own "Call" both need the callee's
        # own name to be a fixed, compile-time literal baked into the
        # instruction itself; here it's a runtime STRING VALUE, which
        # neither can express at all). Found needed while re-attempting
        # Phase 18's own checkpoint one level further out: self_hosting/
        # lib/test.patlang's own Gherkin step dispatcher calls
        # `apply(fname)` to invoke whichever step function matched, by
        # name, at runtime -- exactly the kind of higher-order,
        # map/filter-over-named-functions use `apply` exists for.
        # `interp_call_host` does NOT support it either (confirmed
        # directly -- oo/logic/contracts are its own file's own
        # documented exclusions), so this needed a genuinely new
        # mechanism, not just another name added to an existing fallback.
        #
        # Issue #153: now supports extra arguments too, `apply(name, a1,
        # ..., an)` -- the original narrow zero-argument scoping (checked
        # against only test.patlang's own call sites) missed
        # schema_bdd.patlang's own apply(fn, state, inputs) calls. Shared
        # with bm_lower_expr's value-context "apply" case via
        # bm_lower_apply, so the two contexts cannot drift apart.
        let instrs = bm_lower_apply(call_args, instrs, block_names, immut_params)
        return list_push(instrs, ["Store", "__bm_discard"])
      elif bm_is_fn_bound_name(name) then
        # Issue #182: a call through a closure value used as a statement.
        let instrs = bm_lower_closure_call(name, call_args, instrs, block_names, immut_params)
        return list_push(instrs, ["Store", "__bm_discard"])
      elif bm_list_contains(block_names, name) then
        # Phase 22: a real, previously-undisclosed, confirmed correctness
        # bug -- this used to ALWAYS lower via bm_lower_jump_call
        # (JumpBlock), a one-way, non-returning transfer. That's only
        # safe when this bare call is genuinely the very last thing that
        # ever runs (bm_lower_top_level_stmt_list's own special case just
        # above handles that ONE safe shape via JumpBlock directly,
        # before a statement ever reaches this dispatch at all).
        # Anywhere else -- more statements after it in the same list, OR
        # inside an ordinary if/else branch (bm_lower_stmt_list, used for
        # every If without a nested while, threads NO continuation
        # information at all) -- JumpBlock silently discarded every
        # statement written after it, with no error. Confirmed via a
        # minimal repro: `a(); b(); print(999)` (a/b two trivial declared
        # functions) printed only a()'s own output; b() and print(999)
        # never ran. Fixed by using the same Call+discard convention as
        # apply()/the generic CallHost fallback above -- correct in every
        # position, at the cost of native x64 support (deferred, same as
        # every other Call use since Phase 21; checked directly that no
        # currently-passing native_codegen_check.sh fixture relies on the
        # bug this removes).
        let ai = 0
        let an = list_len(call_args)
        while ai < an do
          let instrs = bm_lower_expr(list_get(call_args, ai), instrs, block_names, immut_params)
          let ai = ai + 1
        end
        let instrs = list_push(instrs, ["Load", "__globals"])
        let instrs = list_push(instrs, ["Call", name, an + 1])
        return list_push(instrs, ["Store", "__bm_discard"])
      elif bm_lower_is_ambient_state_name(name) then
        # Same rejection bm_lower_expr's own generic fallback already
        # has, reached here too now that bare statements get a generic
        # fallback of their own -- see that check's own comment for the
        # full rationale (Fork B's own ambient-state elimination).
        bm_lower_unsupported("calling '" + name + "' directly -- this reaches genuine, process-wide ambient state (self_hosting/lib/interp.patlang's own interp_call_host), which Fork B's own design (docs/plans/block-ownership-model.md section 6) deliberately eliminates from this engine; use set_global/get_global or handler_new/handler_register/handler_lookup instead")
        return instrs
      else
        # Phase 22: the bare-statement twin of bm_lower_expr's own
        # generic CallHost fallback (Phase 17/18) -- found missing while
        # re-attempting Phase 18's own zs_schema.patlang checkpoint
        # (self_hosting/lib/zs_schema.patlang's own zs_lines() calls
        # sb_push(...) as a bare statement, a genuine, real, stateless
        # host function never individually recognized by name here).
        # Pushes args in written order, then CallHost, then discards the
        # (always present, from a REAL Call's own convention) return
        # value -- same "Store __bm_discard" convention this file's own
        # bare-statement Fact/box_*/etc. cases above already use, for
        # the identical reason (a bare statement's own result is never
        # consumed by anything).
        let ai = 0
        let an = list_len(call_args)
        while ai < an do
          let instrs = bm_lower_expr(list_get(call_args, ai), instrs, block_names, immut_params)
          let ai = ai + 1
        end
        let instrs = list_push(instrs, ["CallHost", name, an])
        return list_push(instrs, ["Store", "__bm_discard"])
      end
    end
    bm_lower_unsupported("a call to anything other than print, a box_*/global/handler builtin, or a declared block")
    return instrs
  elif ty == "Return" then
    let e = list_get(node, 1)
    if list_get(e, 0) == "Call" then
      let name = list_get(e, 1)
      if bm_list_contains(block_names, name) then
        return bm_lower_jump_call(e, instrs, block_names, blocks_by_name, immut_params)
      end
    end
    # Phase 21: any other EXPR shape (not itself a TAIL call to a
    # declared block) -- lower it as an ordinary expression, then a new
    # ReturnValue instruction (interp.patlang's own case), ending this
    # bi_run_block call immediately with that value. This is what makes
    # calling a declared function AS A VALUE meaningful in the first
    # place (bm_lower_expr's own new "Call" case, below): `return n * 2`
    # only matters to a caller that actually reads the result. This
    # supersedes the earlier, narrower restriction here (kept in this
    # file's own history/commit log, not restated) that only accepted a
    # tail call as EXPR at all.
    let instrs = bm_lower_expr(e, instrs, block_names, immut_params)
    return list_push(instrs, ["ReturnValue"])
  end
  bm_lower_unsupported("statement shape '" + ty + "'")
  return instrs
end

# Issue #156: `frag` was lowered starting from an EMPTY instruction list, so
# every JumpIfFalse/Jump target in it is relative to the fragment's own start.
# Returns a copy with those targets shifted by `base`, the length of the list
# the fragment is about to be appended to. Costs O(len(frag)) -- the caller's
# accumulated list is never passed in, which is the whole point: any callee
# that pushes onto a list its caller still holds copies it.
make a function called bm_relocate_jumps takes frag, base returns out
  if base == 0 then
    return frag
  end
  let n = list_len(frag)
  let out = []
  let i = 0
  while i < n do
    let ins = list_get(frag, i)
    let op = list_get(ins, 0)
    if (op == "JumpIfFalse") or (op == "Jump") then
      let ins = [op, list_get(ins, 1) + base]
    end
    let out = list_push(out, ins)
    let i = i + 1
  end
  return out
end

make a function called bm_lower_stmt_list takes stmts, instrs, block_names, blocks_by_name, immut_params returns out
  let n = list_len(stmts)
  let i = 0
  while i < n do
    # Issue #156: lower into a fresh fragment and append it inline, rather
    # than handing the growing `instrs` to a callee (which would copy it on
    # every statement: O(n^2) in the body's statement count).
    let frag = bm_relocate_jumps(bm_lower_stmt(list_get(stmts, i), [], block_names, blocks_by_name, immut_params), list_len(instrs))
    let frag_n = list_len(frag)
    let fi = 0
    while fi < frag_n do
      let instrs = list_push(instrs, list_get(frag, fi))
      let fi = fi + 1
    end
    let i = i + 1
  end
  return instrs
end

make a function called bm_next_synth_name takes prefix returns name
  let n = get("__vars", "bm_synth_counter")
  set_var("bm_synth_counter", n + 1)
  return prefix + "_" + n
end

make a function called bm_push_loads takes instrs, names returns out
  let n = list_len(names)
  let i = 0
  while i < n do
    let instrs = list_push(instrs, ["Load", list_get(names, i)])
    let i = i + 1
  end
  return instrs
end

# Phase 22: does `stmts` contain a `while` ANYWHERE reachable without
# crossing a function boundary -- directly, or nested inside an `if`'s
# own then/else (recursively, to arbitrary depth)? Does NOT need to
# recurse into a `while`'s OWN body: a while found there already means
# "yes" via the direct check at that position, and this function is only
# ever asked about an if-BRANCH's own statement list, never about
# reaching inside an unrelated nested loop's own interior. Used to decide
# whether an `if` needs the "must split" treatment below (bm_lower_if_
# with_nested_while) or can keep using bm_lower_stmt's own original,
# non-splitting If lowering unchanged.
make a function called bm_stmt_list_contains_while takes stmts returns yes
  let n = list_len(stmts)
  let i = 0
  while i < n do
    let stmt = list_get(stmts, i)
    let ty = list_get(stmt, 0)
    if ty == "While" then
      return true
    elif ty == "If" then
      if bm_stmt_list_contains_while(list_get(stmt, 2)) then
        return true
      end
      if bm_stmt_list_contains_while(list_get(stmt, 3)) then
        return true
      end
    end
    let i = i + 1
  end
  return false
end

# Phase 22 correction, same day, before this was ever committed: the
# version immediately below this note (kept for the record) had a real,
# confirmed bug, found by testing it directly rather than trusting the
# design. `bm_lower_top_level_stmt_list`'s own "natural end of this
# statement list" case always just returned `[instrs, pending]` as-is --
# fine for a FUNCTION's own top level (there's genuinely nothing further
# to do), but WRONG the moment this same function is used one level
# deeper: a while LOOP's own body reaching the natural end of ITS OWN
# statement list must append the loop's own BACK-EDGE, not just stop --
# and the ORIGINAL code only ever appended that back-edge in
# `bm_lower_while`'s own caller-side code, AFTER its call into
# `bm_lower_top_level_stmt_list` returned. That works fine when the body
# has no nested split of its own (the call returns normally, back-edge
# appended by the caller as always) -- but the INSTANT the body's last
# reachable statement is itself a `while` (or, now, an `if` containing
# one), `bm_lower_top_level_stmt_list` returns EARLY via `bm_lower_while`
# /`bm_lower_if_with_nested_while` directly, and the caller-side code
# that was meant to append the back-edge never runs at all -- silently
# losing the loop's own back-edge entirely. Confirmed as a REAL,
# PRE-EXISTING bug, not something this phase's own new "if" case
# introduced: a plain `while` nested directly inside another `while`
# (with any statement after the inner one), no `if` involved anywhere,
# already crashed with "unbound in this block's own pointer" before this
# fix -- checked directly with a minimal repro, not assumed.
#
# The fix: `bm_lower_top_level_stmt_list` now takes an explicit
# CONTINUATION parameter `k` -- a tagged value (`["none"]` or `["jump",
# target_name, captured, jump_params]`), not a closure (this file's own
# established style is tagged-list dispatch throughout, not first-class
# functions, so a data-shaped continuation is used instead of a real
# closure literal, even though the language itself would support one).
# Applied via `bm_apply_continuation` at the ACTUAL natural-end point,
# wherever that turns out to be -- correctly threading "what happens
# next" through however many levels of nested while/if a body actually
# has, not just one. A function's own top-level body (and a handler's)
# still passes `["none"]` (nothing further, matching today's unchanged
# behavior there); a loop's own body passes a `["jump", head_name, ...]`
# continuation (the back-edge); an if-with-nested-while's own then/else
# branches pass a `["jump", after_name, ...]` continuation; and BOTH of
# those cases still hand their OWN exit/after block the CALLER's own
# `k` (not a fresh `["none"]`), so the propagation is genuinely correct
# to arbitrary nesting depth, not just one level.
make a function called bm_apply_continuation takes k, instrs, pending returns out
  let kind = list_get(k, 0)
  if kind == "none" then
    return [instrs, pending]
  elif kind == "jump" then
    let target_name = list_get(k, 1)
    let captured = list_get(k, 2)
    let jump_params = list_get(k, 3)
    if list_len(k) > 4 then
      # Issue #176: a loop back-edge inside a budgeted block.
      let instrs = list_push(instrs, ["CallHost", "budget_check", 0])
      let instrs = list_push(instrs, ["Store", "__bm_discard"])
    end
    let instrs = bm_push_loads(instrs, captured)
    let instrs = list_push(instrs, ["Load", "__globals"])
    let instrs = list_push(instrs, ["JumpBlock", target_name, jump_params])
    return [instrs, pending]
  end
  bm_lower_unsupported("unknown continuation kind '" + kind + "'")
  return [instrs, pending]
end

# Whatever names a "jump" continuation itself needs forwarded, or []
# for "none" -- used so a block that must apply `k` at its own natural
# end can be sure it captured everything `k` will go on to need, not
# just what ITS OWN body/tail happens to reference.
make a function called bm_continuation_captured takes k returns names
  if list_get(k, 0) == "jump" then
    return list_get(k, 2)
  end
  return []
end

# A plain sub-list, xs[start_idx..] -- used to run free-variable
# analysis (bm_free_vars_of_body, which expects an ordinary statement
# list) over "whatever textually follows a given point", not the whole
# original list.
make a function called bm_list_slice_from takes xs, start_idx returns out
  let n = list_len(xs)
  let out = []
  let i = start_idx
  while i < n do
    let out = list_push(out, list_get(xs, i))
    let i = i + 1
  end
  return out
end

# Sibling to free_vars.patlang's own bm_intersect_preserving_order:
# `base`'s own order is kept, then any name in `extra` not already
# present is appended (also in `extra`'s own order) -- a plain ordered
# set union, not otherwise available in that file (which only ever
# needed intersection until now).
make a function called bm_union_preserving_order takes base, extra returns out
  let out = base
  let n = list_len(extra)
  let i = 0
  while i < n do
    let name = list_get(extra, i)
    if not bm_fv_list_contains(out, name) then
      let out = list_push(out, name)
    end
    let i = i + 1
  end
  return out
end

# Phase 22: an `if` whose then/else branch contains a `while` (found via
# bm_stmt_list_contains_while above) needs a REAL block split, the same
# way a top-level `while` always has -- this engine's own control-flow
# model has no way to jump backwards WITHIN one block's own instruction
# stream at all (Fork A's own design), only via a JumpBlock creating a
# fresh block invocation, so a nested loop's own back-edge needs a real
# target block regardless of how deep the nesting is. Generalizes bm_
# lower_while's own "hand the code after the loop to a synthesized exit
# block" pattern to `if` instead of `while`: the code AFTER this `if`
# (stmts[idx+1..]) becomes its own synthesized "after" block, reached by
# an UNCONDITIONAL JumpBlock at the end of BOTH branches -- safe even
# when a branch already ended in a Return/JumpBlock of its own (the
# extra JumpBlock is then simply dead code, never reached, the identical
# reasoning bm_lower_while's own exit-block construction already relies
# on for this same class of case). The AFTER block's own natural end
# uses the CALLER's own continuation `k`, not a fresh `["none"]` -- see
# this file's own correction note just above for why that distinction
# is exactly what fixes the real bug found here.
#
# `captured` is deliberately just `known_locals` UNCHANGED here, not a
# fresh, more precise free-variable analysis of "after" specifically
# (unlike bm_lower_while, which at least intersects with the loop BODY's
# own free vars) -- a disclosed, correctness-first simplification for
# this first cut: every name in known_locals is, by definition, already
# bound in the enclosing scope, so forwarding all of them is SOUND
# (nothing is ever under-captured), just not minimal (some forwarded
# names may go unused by the after-block). Tightening this to genuine
# free-variable precision is real, separate follow-up work, not
# attempted in this same pass.
make a function called bm_lower_if_with_nested_while takes stmt, stmts, idx, instrs, block_names, blocks_by_name, immut_params, known_locals, pending, k returns out
  let cond = list_get(stmt, 1)
  let then_stmts = list_get(stmt, 2)
  let else_stmts = list_get(stmt, 3)
  let after_name = bm_next_synth_name("__if_after")
  let captured = known_locals
  let jump_params = list_push(captured, "__globals")
  let after_k = ["jump", after_name, captured, jump_params]

  let instrs = bm_lower_expr(cond, instrs, block_names, immut_params)
  let instrs = list_push(instrs, ["JumpIfFalse", 0])
  let jif_pos = list_len(instrs) - 1

  let then_result = bm_lower_top_level_stmt_list(then_stmts, 0, instrs, block_names, blocks_by_name, immut_params, captured, pending, [], after_k)
  let instrs = list_get(then_result, 0)
  let pending = list_get(then_result, 1)

  let instrs = list_set(instrs, jif_pos, ["JumpIfFalse", list_len(instrs)])

  let else_result = bm_lower_top_level_stmt_list(else_stmts, 0, instrs, block_names, blocks_by_name, immut_params, captured, pending, [], after_k)
  let instrs = list_get(else_result, 0)
  let pending = list_get(else_result, 1)

  let after_result = bm_lower_top_level_stmt_list(stmts, idx + 1, [], block_names, blocks_by_name, immut_params, captured, pending, [], k)
  let after_instrs = list_get(after_result, 0)
  let pending = list_get(after_result, 1)
  let pending = list_push(pending, ["BlockIR", after_name, jump_params, bm_hash_rewrite_instrs(after_instrs)])

  return [instrs, pending]
end

# The ONLY place a `while` is recognized -- a function's own top level
# (see this file's own header on why). Every non-While statement here
# delegates straight to the ORIGINAL bm_lower_stmt (unchanged), so
# everything Phases 2-4 already support keeps working identically; only
# `let` additionally extends known_locals for a LATER while's own capture
# set, and `while` itself hands off the statements after it to a
# synthesized exit block rather than continuing this same loop.
#
# Phase 22 adds one more case: an `if` whose then/else branch contains a
# nested `while` (checked via bm_stmt_list_contains_while) is handed off
# to bm_lower_if_with_nested_while, above, which needs the SAME
# splitting treatment `while` itself already gets -- every OTHER `if`
# (the overwhelming common case) is entirely unaffected, still lowered
# by bm_lower_stmt's own original, non-splitting If case exactly as
# before.
# true only for `stmt` shaped exactly like `["Expr", ["Call", name, args,
# ...], ...]` where `name` is a DECLARED block-model function -- the one
# shape bm_lower_top_level_stmt_list's own tail-position special case
# above may safely lower via JumpBlock instead of Call+discard.
make a function called bm_is_tail_safe_bare_call takes stmt, block_names returns yes
  if list_get(stmt, 0) != "Expr" then
    return false
  end
  let call = list_get(stmt, 1)
  if list_get(call, 0) != "Call" then
    return false
  end
  return bm_list_contains(block_names, list_get(call, 1))
end

make a function called bm_lower_top_level_stmt_list takes stmts, start_idx, instrs, block_names, blocks_by_name, immut_params, known_locals, pending, fresh, k returns out
  let n = list_len(stmts)
  let i = start_idx
  while i < n do
    let stmt = list_get(stmts, i)
    let ty = list_get(stmt, 0)
    if ty == "While" then
      return bm_lower_while(stmt, stmts, i, instrs, block_names, blocks_by_name, immut_params, known_locals, pending, k)
    elif ty == "Let" then
      let val_node = list_get(stmt, 2)
      # Issue #156: lower into a fresh fragment (patched and relocated below)
      # and append it inline -- see bm_relocate_jumps.
      let frag = bm_lower_stmt(stmt, [], block_names, blocks_by_name, immut_params)
      # Issue #156: a set of names, so a rebinding does not grow it.
      if not bm_list_contains(known_locals, list_get(stmt, 1)) then
        let known_locals = list_push(known_locals, list_get(stmt, 1))
      end
      # Phase 7 (Fork C): if this Let's value was box_set(TARGET, ...) and
      # TARGET is provably unique right now (flight_check.patlang's own
      # `fresh` tracking), patch the BoxSet bm_lower_stmt just emitted
      # (always the instruction right before the Store it also emitted)
      # into BoxSetUnchecked -- simpler and far less error-prone than
      # threading `fresh` through bm_lower_expr's entire recursive
      # signature for the sake of this one call shape.
      if (list_get(val_node, 0) == "Call") and (list_get(val_node, 1) == "box_set") then
        let target_node = list_get(list_get(val_node, 2), 0)
        if (list_get(target_node, 0) == "Var") and bm_fc_is_provably_unique(fresh, list_get(target_node, 1)) then
          let boxset_pos = list_len(frag) - 2
          let frag = list_set(frag, boxset_pos, ["BoxSetUnchecked"])
        end
      end
      let frag = bm_relocate_jumps(frag, list_len(instrs))
      let frag_n = list_len(frag)
      let fi = 0
      while fi < frag_n do
        let instrs = list_push(instrs, list_get(frag, fi))
        let fi = fi + 1
      end
      let fresh = bm_fc_after_let(fresh, list_get(stmt, 1), val_node)
      let i = i + 1
    elif (ty == "If") and (bm_stmt_list_contains_while(list_get(stmt, 2)) or bm_stmt_list_contains_while(list_get(stmt, 3))) then
      # Phase 22: this If's own then/else contains a nested while --
      # needs the real block split above, not the ordinary in-place
      # If lowering the `else` branch below still uses for every other
      # If. Own dispatch case (not folded into the `else` below) so it's
      # checked BEFORE falling through to the unconditional, ordinary
      # If handling.
      return bm_lower_if_with_nested_while(stmt, stmts, i, instrs, block_names, blocks_by_name, immut_params, known_locals, pending, k)
    elif (i == n - 1) and (list_get(k, 0) == "none") and bm_is_tail_safe_bare_call(stmt, block_names) then
      # Phase 22: a bare statement call to a declared block-model
      # function is a genuinely safe, one-way JumpBlock tail call ONLY
      # here -- truly the LAST statement of this top-level list, with no
      # enclosing continuation waiting to run afterward either (k ==
      # "none"). Everywhere else a bare call reaches bm_lower_stmt's own
      # dispatch, which now always uses Call+discard instead (see that
      # case's own header for the real, confirmed bug this fixes: a bare
      # call anywhere else previously used JumpBlock too, silently
      # dropping every statement written after it -- including inside an
      # ordinary if/else branch, which bm_lower_stmt_list doesn't thread
      # continuations through at all). Kept as a real, deliberate
      # optimization (native x64 can only compile JumpBlock, not Call,
      # today) rather than folded away for uniformity, since checking
      # every currently-passing native_codegen_check.sh fixture found
      # none relies on the bug this fix removes.
      let call = list_get(stmt, 1)
      # Issue #157: this function's contract is to return [instrs, pending]
      # on EVERY path (see bm_apply_continuation at the bottom). This
      # branch used to return the bare instruction list, so its caller read
      # the first instruction as `instrs` and the second as the synthesized
      # block list -- a regression from #149's fix that no fixture reached.
      return [bm_lower_jump_call(call, instrs, block_names, blocks_by_name, immut_params), pending]
    else
      # If/Return/Expr (including a bare jump-call): conservatively
      # invalidate `fresh` entirely -- this narrow, straight-line-only
      # analysis doesn't reason through any of these (flight_check
      # .patlang's own header).
      let frag = bm_relocate_jumps(bm_lower_stmt(stmt, [], block_names, blocks_by_name, immut_params), list_len(instrs))
      let frag_n = list_len(frag)
      let fi = 0
      while fi < frag_n do
        let instrs = list_push(instrs, list_get(frag, fi))
        let fi = fi + 1
      end
      let fresh = []
      let i = i + 1
    end
  end
  return bm_apply_continuation(k, instrs, pending)
end

make a function called bm_lower_while takes stmt, stmts, idx, instrs, block_names, blocks_by_name, immut_params, known_locals, pending, k returns out
  let cond = list_get(stmt, 1)
  let body_stmts = list_get(stmt, 2)
  let head_name = bm_next_synth_name("__loop_head")
  let exit_name = bm_next_synth_name("__loop_exit")
  # Phase 6 (Fork E): real free-variable analysis over the loop body,
  # intersected with known_locals (a name free in the body but not bound
  # anywhere in the enclosing scope is a genuine unbound-variable bug,
  # left for bm_loc_get's existing runtime check to catch, not silently
  # absorbed here) -- replaces Phase 5's own `captured = known_locals`
  # wholesale placeholder.
  #
  # Phase 22 correction: the body's own free variables ALONE are not
  # enough. The loop's own false-path/exit-transfer code lives, textually,
  # INSIDE the head block's own scope (see step 2's own comment below --
  # "the SAME shape as an ordinary if/else", so the false branch shares
  # the head's own declared params) -- so the head block ALSO needs
  # whatever the code AFTER the loop needs, and whatever the ENCLOSING
  # continuation `k` itself needs, or the exit path could try to forward
  # a name that was never actually bound within the head block at all. A
  # real, confirmed, pre-existing bug, found by testing a shape neither
  # existing fixture happened to exercise (a value read only AFTER a
  # loop, never inside its own body): `unbound in this block's own
  # pointer` the moment such code ran. Verified this UNION still
  # correctly excludes a truly-never-referenced local (self_hosting/
  # block_model/spec_fixtures/free_var_capture_precise.patlang's own
  # `unused_big`, referenced neither inside the body nor after it) --
  # free_variable_capture.feature's own existing guarantee is unaffected,
  # confirmed by re-running it, not merely reasoned about.
  # Phase 22, second correction: the loop's own CONDITION is re-evaluated
  # in the head block on every single iteration (that's what a while
  # loop's head block IS) -- a variable referenced ONLY in `cond`,
  # never inside body_stmts itself (e.g. `let n = ...` before the loop,
  # then `while i < n do ... end` where the body never re-mentions `n`),
  # was missing from the head block's own forwarded params entirely,
  # since body_free only ever scanned body_stmts. A real, confirmed,
  # pre-existing bug -- found via self_hosting/lib/test.patlang's own
  # run_feature (`let n = sc_len(h); while i <= n do ... end`, `n` never
  # referenced again inside the loop body) while re-attempting Phase
  # 18's own checkpoint one level further out. Confirmed via a minimal,
  # standalone repro independent of that file: `let n = 3; let i = 0;
  # while i < n do print(i); let i = i + 1 end` crashed identically
  # before this fix.
  let cond_free = bm_intersect_preserving_order(known_locals, bm_fv_expr(cond, [], []))
  let body_free = bm_intersect_preserving_order(known_locals, bm_free_vars_of_body(body_stmts))
  let after_stmts = bm_list_slice_from(stmts, idx + 1)
  let after_free = bm_intersect_preserving_order(known_locals, bm_free_vars_of_body(after_stmts))
  let k_captured = bm_continuation_captured(k)
  let captured = bm_union_preserving_order(cond_free, bm_union_preserving_order(body_free, bm_union_preserving_order(after_free, k_captured)))
  let jump_params = list_push(captured, "__globals")

  # 1) At the current point in the CALLING block: enter the loop head for
  #    the first time, forwarding captured's own current values.
  let instrs = bm_push_loads(instrs, captured)
  let instrs = list_push(instrs, ["Load", "__globals"])
  let instrs = list_push(instrs, ["JumpBlock", head_name, jump_params])

  # 2) The loop head block itself: cond; JumpIfFalse to the false-path
  #    tail (position fixed up once known); the body; an unconditional
  #    back edge to head_name; then the false-path tail (forward captured,
  #    jump to exit_name) -- the SAME shape as an ordinary if/else with an
  #    always-taken true branch (section 4.1: nothing new invented here).
  #
  # Phase 22 correction: the body's own back-edge is now threaded in as
  # a CONTINUATION (bm_apply_continuation's own header has the full
  # story) rather than appended here unconditionally right after the
  # call -- the latter silently never ran at all whenever the body's own
  # last reachable statement was itself a further split (a nested while,
  # or now an if containing one), a real, confirmed, pre-existing bug
  # fixed as part of this same phase, not merely worked around for the
  # NEW if-with-nested-while case this phase also adds.
  let back_edge_k = ["jump", head_name, captured, jump_params]
  if get("__vars", "bm_budgeted_depth") > 0 then
    # Issue #176: lexically inside a budgeted block -- the back-edge yields
    # when the deadline is near (bm_apply_continuation reads the 5th slot).
    let back_edge_k = list_push(back_edge_k, true)
  end
  let head_instrs = bm_lower_expr(cond, [], block_names, immut_params)
  let head_instrs = list_push(head_instrs, ["JumpIfFalse", 0])
  let jif_pos = list_len(head_instrs) - 1
  let body_result = bm_lower_top_level_stmt_list(body_stmts, 0, head_instrs, block_names, blocks_by_name, immut_params, captured, pending, [], back_edge_k)
  let head_instrs = list_get(body_result, 0)
  let pending = list_get(body_result, 1)
  let head_instrs = list_set(head_instrs, jif_pos, ["JumpIfFalse", list_len(head_instrs)])
  let head_instrs = bm_push_loads(head_instrs, captured)
  let head_instrs = list_push(head_instrs, ["Load", "__globals"])
  let head_instrs = list_push(head_instrs, ["JumpBlock", exit_name, jump_params])
  let pending = list_push(pending, ["BlockIR", head_name, jump_params, bm_hash_rewrite_instrs(head_instrs)])

  # 3) The loop exit block: same captured params, body = whatever
  #    statements textually followed the while in the enclosing function,
  #    ending in the CALLER's own continuation `k` (not a fresh
  #    `["none"]`) -- so a while nested inside yet another construct
  #    still correctly reaches whatever THAT construct needs once this
  #    whole while (and everything after it) is finally done.
  let exit_result = bm_lower_top_level_stmt_list(stmts, idx + 1, [], block_names, blocks_by_name, immut_params, captured, pending, [], k)
  let exit_instrs = list_get(exit_result, 0)
  let pending = list_get(exit_result, 1)
  let pending = list_push(pending, ["BlockIR", exit_name, jump_params, bm_hash_rewrite_instrs(exit_instrs)])

  return [instrs, pending]
end

# Phase 10: registers handler_name against event_name in registration
# order, appending to that event's own handler list if it's already seen
# (the "multiple handlers for the same event" case) rather than
# overwriting -- unlike bm_rt_assoc_set (interp.patlang), which always
# replaces a single value, since an event key maps to a GROWING list here.
make a function called bm_events_register takes events, event_name, handler_name returns out
  let n = list_len(events)
  let i = 0
  while i < n do
    let entry = list_get(events, i)
    if list_get(entry, 0) == event_name then
      return list_set(events, i, [event_name, list_push(list_get(entry, 1), handler_name)])
    end
    let i = i + 1
  end
  return list_push(events, [event_name, [handler_name]])
end

make a function called bm_assoc_get takes assoc, key returns v
  let n = list_len(assoc)
  let i = 0
  while i < n do
    let entry = list_get(assoc, i)
    if list_get(entry, 0) == key then
      return list_get(entry, 1)
    end
    let i = i + 1
  end
  return false
end

# Optimization (post-Phase-8): unconditionally replaces every
# instruction's own opcode string (element 0) with block_ir.patlang's
# bm_op_hash of it -- a pure relabeling, safe for EVERY block regardless
# of shape (unlike the slot-indexing attempt this replaced after
# measuring a net regression: hashing touches only the dispatch TAG,
# never a name/value Load/Store actually reads or writes, so there is no
# "if this block has an if-branch, skip it" caveat needed here at all).
# "Bin"/"Un" ALSO get their own second element (the operator, e.g. "+")
# hashed, since bm_apply_bin/bm_apply_un dispatch on THAT string too.
make a function called bm_hash_rewrite_instrs takes instrs returns out
  let n = list_len(instrs)
  let out = []
  let i = 0
  while i < n do
    let instr = list_get(instrs, i)
    let op = list_get(instr, 0)
    if (op == "Bin") or (op == "Un") then
      let out = list_push(out, [bm_op_hash(op), bm_op_hash(list_get(instr, 1))])
    elif op == "Const" then
      let out = list_push(out, [bm_op_hash(op), list_get(instr, 1), list_get(instr, 2)])
    elif op == "JumpIfFalse" then
      let out = list_push(out, [bm_op_hash(op), list_get(instr, 1)])
    elif op == "Jump" then
      let out = list_push(out, [bm_op_hash(op), list_get(instr, 1)])
    elif op == "Load" then
      let out = list_push(out, [bm_op_hash(op), list_get(instr, 1)])
    elif op == "Store" then
      let out = list_push(out, [bm_op_hash(op), list_get(instr, 1)])
    elif op == "ContractFail" then
      let out = list_push(out, [bm_op_hash(op), list_get(instr, 1)])
    elif op == "JumpBlock" then
      let out = list_push(out, [bm_op_hash(op), list_get(instr, 1), list_get(instr, 2)])
    elif op == "BuildList" then
      # Phase 18: a real, found-before-shipping bug if left out -- this
      # function's own "else" branch below assumes NO operand at all, so
      # BuildList's own item count would silently be DROPPED (not just
      # wrong, gone) had this case not been added explicitly.
      let out = list_push(out, [bm_op_hash(op), list_get(instr, 1)])
    elif op == "CallHost" then
      # Same class of bug, same fix -- CallHost carries TWO operands
      # (the callee name, the arg count), both needed at dispatch time.
      let out = list_push(out, [bm_op_hash(op), list_get(instr, 1), list_get(instr, 2)])
    elif op == "Call" then
      # Phase 21: same shape as CallHost (callee name + arg count), same
      # reason -- both operands are needed at dispatch time and would be
      # silently dropped by the generic "no operand" else branch.
      let out = list_push(out, [bm_op_hash(op), list_get(instr, 1), list_get(instr, 2)])
    elif op == "CallDynamic" then
      # Issue #153: carries ONE operand now -- the count of extra
      # arguments (below the callee name and __globals) apply() passed
      # through. Same operand-dropping bug class as BuildList/CallHost/
      # Call above, caught here before it shipped.
      let out = list_push(out, [bm_op_hash(op), list_get(instr, 1)])
    else
      # Print/BoxNew/BoxGet/BoxSet/BoxSetUnchecked/BoxShare/GlobalGet/
      # GlobalSet/HandlerNew/HandlerRegister/HandlerLookup/Emit/
      # FiberYield/Fact/Query/TypeOf/ReadFile/WriteFile/ReturnValue: no
      # operand beyond the opcode itself.
      let out = list_push(out, [bm_op_hash(op)])
    end
    let i = i + 1
  end
  return out
end

# Found needed while re-verifying zs_schema.patlang's own "lowers
# completely" claim WITH its own real includes properly expanded (self_
# hosting/lib/includes.patlang's own expand_includes -- the self-hosted
# lexer/parser this whole file's own tests use has NO include-expansion
# of its own at all, confirmed directly, so testing a file's own
# UNEXPANDED source, as this project's own earlier verification passes
# had been doing, silently never exercises its own transitive includes'
# content at all -- a real methodology gap, not a claim about the
# engine itself, caught and corrected here before trusting the earlier
# claim further).
#
# self_hosting/lib/block_model_compat.patlang's own get_global/
# set_global/handler_*  functions are real-function IMPLEMENTATIONS
# meant only for the REAL engine (their own bodies necessarily use raw
# ambient set_var/get -- that IS their whole purpose) -- but bm_lower_
# program processes every "Func" node in the fully-expanded source
# UNCONDITIONALLY, so their own bodies would otherwise be lowered too,
# hitting the ambient-state denylist their OWN call sites are supposed
# to be exempt from (since every REAL call site is always intercepted
# by name, earlier, before any declared-function lookup ever runs --
# these functions are provably NEVER actually invoked as ordinary
# declared functions under block-model at all). Excluded from BOTH
# passes below so their bodies are never even attempted -- confirmed
# genuinely dead code under block-model, not assumed.
make a function called bm_lower_is_compat_shim_name takes name returns yes
  if name == "get_global" then
    return true
  end
  if name == "set_global" then
    return true
  end
  if name == "handler_new" then
    return true
  end
  if name == "handler_register" then
    return true
  end
  if name == "handler_lookup" then
    return true
  end
  return false
end

# Issue #155: script-style programs. Every top-level statement that is NOT
# a declaration (Func / When / ClassDecl) is collected, in source order,
# into a synthesized zero-parameter function `__main`, which is placed FIRST
# so it becomes the program's entry (bm_lower_program picks the first
# declared Func as entry) and is then lowered exactly like any other
# function body by the passes below -- so `let`, bare calls, `if`, `while`
# and their nesting reuse the existing machinery with no special cases.
# When there are no such statements the list is returned UNCHANGED, so a
# functions-only program still enters at its first function exactly as
# before (every earlier fixture relies on that).
#
# Before this, every non-declaration top-level statement was silently
# ignored -- and most of this repo's real programs (all the selftests of
# the libraries Phase 18 ported) are script-style, so under block-model
# they ran nothing and exited cleanly: a silent false pass. Anything at top
# level that cannot be lowered now fails LOUDLY through the normal
# unsupported-construct path. An un-expanded `include "x"` line (which the
# self-hosted parser turns into a bare `include` expression plus a stray
# string) gets its own explicit message, since it was the real-world way
# top-level content used to vanish unnoticed.
make a function called bm_collect_toplevel_main takes stmts returns out
  let main_stmts = []
  let decl_stmts = []
  let n = list_len(stmts)
  let i = 0
  while i < n do
    let s = list_get(stmts, i)
    let ty = list_get(s, 0)
    if (ty == "Func") or (ty == "When") or (ty == "ClassDecl") then
      let decl_stmts = list_push(decl_stmts, s)
    else
      if ty == "Expr" then
        let e = list_get(s, 1)
        if (list_get(e, 0) == "Var") and (list_get(e, 1) == "include") then
          bm_lower_unsupported("a top-level `include` directive that was never expanded -- run the source through expand_includes (self_hosting/lib/includes.patlang) before lowering; the self-hosted lexer/parser has no include handling of its own")
        end
      end
      let main_stmts = list_push(main_stmts, s)
    end
    let i = i + 1
  end
  if list_len(main_stmts) == 0 then
    return stmts
  end
  let out = [["Func", "__main", [], main_stmts, "r"]]
  let j = 0
  let dn = list_len(decl_stmts)
  while j < dn do
    let out = list_push(out, list_get(decl_stmts, j))
    let j = j + 1
  end
  return out
end

make a function called bm_lower_program takes ast returns prog
  set_var("bm_synth_counter", 0)
  set_var("bm_closure_blocks", [])
  set_var("bm_budgeted_depth", 0)
  set_var("bm_fn_bound_names", [])
  set_var("bm_ct_blocks_by_name", [])
  let stmts = bm_collect_toplevel_main(list_get(ast, 1))
  let n = list_len(stmts)

  # Pass 0 (Phase 13): a compile-time-only class registry (name -> field
  # defaults), scanned before Pass 1 so a `new("ClassName")` call site can
  # resolve regardless of source order, same reasoning as Pass 1's own
  # forward-reference support for ordinary functions. A ClassDecl
  # declaring `inherits`/methods/traits is rejected here, plainly, before
  # any of its fields are even registered -- see this file's own Phase 13
  # header note for exactly why those three are out of scope.
  set_var("bm_class_registry", [])
  let i = 0
  while i < n do
    let stmt = list_get(stmts, i)
    if list_get(stmt, 0) == "ClassDecl" then
      let cname = list_get(stmt, 1)
      let cparent = list_get(stmt, 2)
      let cfields = list_get(stmt, 3)
      let cmethods = list_get(stmt, 4)
      let ctraits = list_get(stmt, 5)
      if cparent != "" then
        bm_lower_unsupported("class '" + cname + "' declares `inherits " + cparent + "` -- Phase 13's restricted subset supports fields only, no inheritance yet")
      end
      if list_len(cmethods) > 0 then
        bm_lower_unsupported("class '" + cname + "' declares a method -- Phase 13's restricted subset supports fields only, no method dispatch yet")
      end
      if list_len(ctraits) > 0 then
        bm_lower_unsupported("class '" + cname + "' declares traits -- Phase 13's restricted subset supports fields only, no traits yet")
      end
      set_var("bm_class_registry", bm_class_registry_set(get("__vars", "bm_class_registry"), cname, cfields))
    end
    let i = i + 1
  end

  # Pass 1: every declared function name, and its own empty-bodied BlockIR
  # (params only) -- built first so a jump to a function declared LATER in
  # source order still resolves during pass 2's actual body lowering.
  # "__globals" is appended to EVERY block's own param list here, hidden
  # from the source program entirely (section 3.3/Fork B) -- both passes
  # append it identically so a block's own declared param list (used for
  # box_set's mut-check, immut_params below) never includes it, while
  # JumpBlock's field-name list (bi_block_params) always does.
  let block_names = []
  let blocks_by_name = []
  let i = 0
  while i < n do
    let stmt = list_get(stmts, i)
    if (list_get(stmt, 0) == "Func") and (bm_lower_is_compat_shim_name(list_get(stmt, 1)) == false) then
      let name = list_get(stmt, 1)
      let params = list_push(list_get(stmt, 2), "__globals")
      let block_names = list_push(block_names, name)
      let blocks_by_name = list_push(blocks_by_name, [name, ["BlockIR", name, params, []]])
    end
    let i = i + 1
  end

  # Pass 2: lower each function's real body now that every target name is
  # known, replacing each placeholder's empty instrs. Each function's own
  # immut_params (its declared params WITHOUT the `mut_` prefix) is
  # recomputed here, per block -- box_set's mut-check only ever looks at
  # THIS block's own parameter list, never a caller's or callee's.
  set_var("bm_ct_blocks_by_name", blocks_by_name)
  let blocks = []
  let events = []
  let entry = false
  let i = 0
  while i < n do
    let stmt = list_get(stmts, i)
    if (list_get(stmt, 0) == "Func") and (bm_lower_is_compat_shim_name(list_get(stmt, 1)) == false) then
      let name = list_get(stmt, 1)
      let declared_params = list_get(stmt, 2)
      let params = list_push(declared_params, "__globals")
      let body = bm_expand_activate_list(list_get(stmt, 3))
      if entry == false then
        let entry = name
      end
      # immut_params is computed from declared_params ONLY -- "__globals"
      # is never a user-facing mut/immut target, just plumbing.
      let immut_params = []
      let pn = list_len(declared_params)
      let pi = 0
      while pi < pn do
        let pname = list_get(declared_params, pi)
        if not bm_is_mut_param_name(pname) then
          let immut_params = list_push(immut_params, pname)
        end
        let pi = pi + 1
      end
      set_var("bm_fn_bound_names", bm_bound_names_of(declared_params, body))
      let top_result = bm_lower_top_level_stmt_list(body, 0, [], block_names, blocks_by_name, immut_params, declared_params, [], [], ["none"])
      let instrs = list_get(top_result, 0)
      let synthesized = list_get(top_result, 1)
      let blocks = list_push(blocks, ["BlockIR", name, params, bm_hash_rewrite_instrs(instrs)])
      let sn = list_len(synthesized)
      let si = 0
      while si < sn do
        let blocks = list_push(blocks, list_get(synthesized, si))
        let si = si + 1
      end
    elif list_get(stmt, 0) == "When" then
      # Phase 10: see this file's own header above for why block_names/
      # blocks_by_name are EMPTY here (a handler can't JumpBlock to a
      # declared function) and why this handler is never added to the
      # program's own block_names -- it's reachable only through `events`.
      let event_name = list_get(stmt, 1)
      let body = bm_expand_activate_list(list_get(stmt, 2))
      let handler_name = bm_next_synth_name("__on_" + event_name)
      let handler_params = ["event_name", "event_data", "__globals"]
      let handler_immut_params = ["event_name", "event_data"]
      let handler_known_locals = ["event_name", "event_data"]
      set_var("bm_fn_bound_names", bm_bound_names_of(["event_name", "event_data"], body))
      let top_result = bm_lower_top_level_stmt_list(body, 0, [], [], [], handler_immut_params, handler_known_locals, [], [], ["none"])
      let handler_instrs = list_get(top_result, 0)
      let handler_synth = list_get(top_result, 1)
      let blocks = list_push(blocks, ["BlockIR", handler_name, handler_params, bm_hash_rewrite_instrs(handler_instrs)])
      let hs = list_len(handler_synth)
      let hi = 0
      while hi < hs do
        let blocks = list_push(blocks, list_get(handler_synth, hi))
        let hi = hi + 1
      end
      let events = bm_events_register(events, event_name, handler_name)
    end
    let i = i + 1
  end
  # Issue #182: drain the closure blocks synthesized while lowering expressions.
  let closure_blocks = get("__vars", "bm_closure_blocks")
  let cbi = 0
  while cbi < list_len(closure_blocks) do
    let blocks = list_push(blocks, list_get(closure_blocks, cbi))
    let cbi = cbi + 1
  end
  return ["BlockProgramIR", entry, blocks, events]
end
