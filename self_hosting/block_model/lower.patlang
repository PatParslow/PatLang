# Block Ownership Model, Phase 2 (Fork A): lowers a RESTRICTED subset of
# ordinary PatLang source into block_ir.patlang's BlockProgramIR shape.
# Reuses self_hosting/lib/lexer.patlang and lib/parser.patlang UNCHANGED --
# only lowering and execution are new here, matching Fork A's own scope
# (a new execution engine, not new source syntax).
#
# What's supported, and why the cut is drawn here rather than further out:
# a program is a flat sequence of top-level `make a function called X
# takes ... returns ... ... end` declarations. Each one becomes exactly one
# BlockIR, named after the function. A function's body may contain:
#   - Let name = EXPR, where EXPR is Num/Str/Bool/Var/Bin/Un (arithmetic,
#     comparison, boolean)
#   - If/else (recursively, over the same restricted statement set)
#   - print(EXPR)                       -> a Print instruction
#   - Return CALL_TO_ANOTHER_FUNCTION(args...), or a bare
#     CALL_TO_ANOTHER_FUNCTION(args...) statement -> a JumpBlock
#     instruction, since Fork A replaces calls between these blocks with
#     jumps, never a call-with-return
#
# Explicitly NOT supported yet (a real gap, not silently mishandled --
# bm_lower_unsupported below raises a guaranteed-fail contract_check
# naming exactly what wasn't recognized): `while` loops (Phase 5's own
# job, needing an `inherited` section this phase deliberately doesn't
# build), closures (Phase 6), `Return EXPR` where EXPR is not a call to
# another declared block (there is no call stack to return a value up
# through yet -- see interp.patlang's own header on why), and calling
# anything that isn't either `print`/`box_new`/`box_get`/`box_set`/
# `box_share` or another function declared in this same program (no
# general host-function dispatch in this phase).
#
# Phase 3 adds box_new(v)/box_get(ptr)/box_set(ptr, v)/box_share(ptr) as
# recognized Call expressions (section 3.4/3.5, Fork D wired in for real --
# see block_ir.patlang's own header for the instructions and the `mut_`
# parameter-name convention standing in for real `mut` param syntax).
# box_set's own mut-check is deliberately narrow, matching section 3.4's
# literal scope ("extend mut... to parameter declarations"): calling
# box_set on a bare reference to one of THIS block's own declared
# parameters is checked against that parameter's mut_-prefix; calling it
# on an ordinary `let`-bound local, or on any other expression shape,
# is always allowed (this phase's guarantee is about a block's incoming
# pointer, not general alias tracking through arbitrary local reassignment --
# that's the flight check's own, later job, Phase 7).
#
# Phase 4 adds Fork B's full elimination of ambient state, for real:
#
#   - set_global(name, value)/get_global(name) look, from the SOURCE's own
#     point of view, exactly like today's ambient set_var/get -- but
#     `__globals` is a HIDDEN parameter this lowerer appends to EVERY
#     function's own param list (bm_lower_program, below) and to EVERY
#     JumpBlock's own forwarded fields (bm_lower_jump_call, below), never
#     written by the program itself. That's section 3.3's actual claim
#     ("the PatLang source someone actually wrote... never changes")
#     realized directly, not just described: a program using these two
#     calls reads exactly like it always ambiently could, while every
#     block boundary in between structurally carries the pointer, matching
#     section 3.2's "everything reachable is in the one pointer, or is
#     global" with globals now literally IN that one pointer.
#
#   - handler_new()/handler_register(h, name, ref)/handler_lookup(h, name)
#     realize the OTHER half of Fork B: `new`/`send`'s deliberate-naming
#     minority (docs/plans/block-ownership-model.md, section 6, Fork B).
#     A handler is an ORDINARY value (an assoc-list, no refcounted heap
#     involved) passed around EXPLICITLY like any other parameter --
#     `handler_register` returns an UPDATED handler the caller re-Stores,
#     the same "reassign to the result" convention as box_set/list_set.
#     The ephemeral majority of that same fork (`new("Dict", "prefix_" +
#     counter)`-style workarounds) has NOTHING further to build here: this
#     engine's own Box (Phase 1-3) was designed from the start with no
#     name parameter at all, so two independently created boxes are
#     already, unconditionally, independent objects -- there was never a
#     collision risk to demonstrate fixing, only to note the connection.
#
# Phase 5 adds `while` (section 4.1/4.2): a loop body becomes its own
# synthesized block, entered by a genuine back edge -- the model's own
# core mechanic (section 3.1-3.2) applied where the "next" block happens
# to be the current one, exactly as section 4.1 describes. A synthesized
# `__loop_exit_N` block, holding whatever textually followed the `while`
# in source, is what makes this correct without a call stack: "continuing
# after the loop" is exactly the same kind of jump target as "continuing
# after a function call" was in Phase 2, so `while` is deliberately only
# supported as the point a function's OWN body reaches, never nested
# inside an if/else here -- bm_lower_top_level_stmt_list (the only place
# that knows how to split a block at a `while`) is never called
# recursively for an if-branch's own then/else lists, which still go
# through the ORIGINAL bm_lower_stmt_list/bm_lower_stmt (unchanged) --
# a `while` reached that way hits bm_lower_unsupported, named plainly, not
# silently dropped.
#
# The loop's own `inherited` section (its synthesized block's own declared
# params) was WHOLESALE capture in this phase originally -- every name
# known to be bound in the enclosing function body BEFORE the `while` is
# reached (known_locals, threaded alongside pending through
# bm_lower_top_level_stmt_list). Phase 6 (Fork E, free_vars.patlang) has
# since replaced this with real free-variable analysis, intersected
# against known_locals: bm_lower_while's own captured set is now only the
# names the loop body ACTUALLY references, not everything merely in
# scope. known_locals itself is still tracked the same way -- ONLY at a
# function's own top level, not descended into if-branches, so a `let`
# introduced inside an if/else before a later top-level `while` is
# unreachable to either the old wholesale set or the new precise one, a
# narrower base than the real lower_closure_literal's own full tracking,
# but sufficient to prove section 4.1's actual claim.
#
# section 4.2's own claim is enforced as a natural consequence, not a
# special case: a scratch `let` declared INSIDE the loop body extends
# body_result's own known_locals for lowering the REST of that same
# iteration's body, but the back-edge JumpBlock only ever forwards the
# ORIGINAL captured set computed before the loop started -- so it can
# never survive into the next iteration unless it was already part of
# what's captured.
#
# Phase 6 adds (section 6, Fork E, wired in for real): see
# free_vars.patlang's own header for the analysis itself and its one
# disclosed scope note (this engine never built closures, so there is
# only one real consumer of it here, bm_lower_while -- nothing about the
# analysis is closure-specific, but nothing here calls it for one either).
#
# Phase 17 adds a representative slice of system integration:
# `read_file(path)`/`write_file(path, contents)`, both genuine, fixed-
# arity host functions (checked directly against rust-runtime/src/ir/
# hosts.rs), following the exact same "call the real host function
# directly" pattern as Print/FiberYield/Fact/Query/TypeOf.
#
# Deliberately NOT covering the rest of this phase's own planned scope
# this pass, named plainly rather than silently narrowed: `spawn`/
# `exec_capture` take a VARIADIC argument list (checked directly), which
# this engine's fixed-arity recognized-call pattern doesn't accommodate
# without real design work (an argc-carrying instruction, mirroring how
# JumpBlock's own param count already varies per call site -- a next-step
# extension, not attempted here); `queue_publish`/`consume`/`ack` turned
# out NOT to be Rust host functions at all (checked directly) but ordinary
# PatLang library functions (self_hosting/lib/queue.patlang) -- callable
# the same way once that file is `include`d, but a real library
# dependency this pass doesn't pull in. `signal_*` is deferred for the
# same reason. Each is a real, separable follow-up, not solved by
# assuming the fixed-arity pattern already covers it.
#
# Phase 16 adds `type_of(x)` -- not new mechanism, verification tooling.
# Checked directly (a probe run under --ir-run) before writing anything
# else for this phase: the numeric tower needs NO new work here at all.
# The self-hosted parser.patlang produces a single "Num" tag for every
# numeric literal (int/bigint/float alike -- no separate BigNumber/Float
# AST shape exists at all, confirmed by grep), carrying only the raw
# decimal TEXT; bm_lower_expr's own "Num" case already passes that text
# straight through to a Const instruction, and interp.patlang's own
# "Const" case evaluates it via the REAL `to_num`, which already performs
# the full int/bigint/rational/float/complex auto-promotion the real
# language defines. bm_apply_bin's own `l + r` etc. are genuine PatLang
# operators too, inheriting the same promotion for free. `type_of(x)` is
# added purely so this claim is independently CHECKABLE from within a
# block-model program's own output, not left as an unverified inference.
#
# Phase 15 adds the logic-programming/GOAP primitive at the bottom of
# that paradigm's stack: `fact(pred, a, b)`/`query(pred, a, b)` -- checked
# directly (rust-runtime/src/ir/hosts.rs) rather than assumed: both take
# exactly 3 SCALAR args, not a list, so neither needs this engine's
# missing list-literal/BuildList support at all, unlike `rule`/`goal`
# declarative sugar (RuleDecl/GoalDecl), which DO build compound
# [pred,[args]] lists and are explicitly deferred alongside Phase 17's own
# generic host-call/list-literal work, named here rather than attempted
# with half the needed machinery.
#
# A genuine finding, not assumed uniform with Fork B's own globals
# elimination: `fact`/`query`'s own backing store (FACTS in hosts.rs) is
# a `thread_local!` HashMap, entirely outside PatLang's `__vars`/
# `set_var`/`get` mechanism and therefore outside this engine's own
# `__globals` threading (Phase 4) entirely -- a fact asserted in one
# block is visible from any other block NOT because __globals carried it
# there, but because it was never scoped by this design's own mechanism
# to begin with. The design doc's own Fork B never named this ambient
# mechanism (it only covers `set_var`/`get` and `new`/`send`) -- recorded
# here as a real gap in that document's own coverage, not silently
# treated as already-handled.
#
# Phase 14 adds cooperative yielding, scoped deliberately to fiber_yield
# alone -- checked before writing code: self_hosting/examples/
# fiber_demo.patlang's own header says fibers are "implemented on real OS
# threads under the hood... but never actually running concurrently...
# distinct from parallel_map, which IS real parallelism" -- so no
# refcount-thread-safety design question applies here at all. Real
# OS-thread parallelism (thread_spawn/parallel_map) is explicitly
# deferred: Box is native-x64-only, so it can't be exercised under the
# self-hosted interpreter this phase (and this whole plan's backend
# cadence) is scoped to until Phase 19's native codegen exists.
# `fiber_yield(x)` lowers as a bare statement (mirrors `emit`'s own
# lowering exactly) to a MID-BLOCK FiberYield instruction -- never ends
# the block, since a block-model program needs to keep running its own
# next statement once resumed, the same reasoning as Emit's own header.
#
# Phase 13 adds object orientation, scoped deliberately to FIELDS ONLY --
# checked before writing code, not discovered as a gap afterward: real
# methods need genuine call-with-return dispatch into user code (this
# engine's only call-with-return mechanism, Phase 10's Emit, is
# deliberately too narrow -- a handler can never itself call another
# block), and real methods-as-closures need first-class closures, which
# this engine has never built (see event_dispatch.feature's own note). A
# `ClassDecl` declaring `inherits`/methods/traits is rejected plainly via
# bm_lower_unsupported, not silently mishandled.
#
# An object is represented as a Box (Phase 1/3) wrapping a Handler-shaped
# assoc-list (Phase 4) of field name/value pairs -- NOT a new heap layout.
# This is a deliberate design choice, not a shortcut: it answers the plan's
# own flagged "does mut extend to field writes" question directly (yes,
# via the SAME box_set refcount-checked mutate-in-place-vs-clone mechanism
# Phase 3 already proved, since writing a field literally IS calling
# box_set on the object's own whole record), and it means Phase 13 needed
# ZERO new heap/runtime primitives. `new("ClassName")` is resolved entirely
# at LOWERING time against a compile-time class registry (bm_class_
# registry, below) -- deliberately NOT the real engine's own runtime
# `new`/`class_def`/OBJECTS-registry mechanism (a name-keyed global store
# the design doc's own Fork B explicitly wants to move AWAY from, see
# block-ownership-model.md section 6) -- so Phase 13's `new(...)` only
# ever takes a single literal class-name string, no extra constructor args
# and no compatibility with the OLDER `new("Class", "instance_name", ...)`
# form.
#
# Since Box is native-x64-only (checked directly: `host fn 'rt_heap_alloc'
# not found` under --ir-run, same finding Phase 1 already made), EVERY
# scenario that actually constructs an object needs native x64 compilation
# (the same `./patc1.exe ... --x64` two-step Phase 3/7 already established)
# -- but the inherits/methods/traits REJECTION happens purely at lowering
# time, before any Box instruction is ever emitted, so those fixtures run
# fine under the plain interpreter.
make a function called bm_class_registry_set takes registry, name, fields returns out
  let n = list_len(registry)
  let i = 0
  while i < n do
    if list_get(list_get(registry, i), 0) == name then
      return list_set(registry, i, [name, fields])
    end
    let i = i + 1
  end
  return list_push(registry, [name, fields])
end

make a function called bm_class_fields takes class_name returns fields
  return bm_assoc_get(get("__vars", "bm_class_registry"), class_name)
end

# Phase 12 adds `require`/`ensure`/`assert` (design-by-contract). The real
# self-hosted lower.patlang lowers all three identically to a single
# contract_check(func_name, kind, text, ok) host call -- this engine has
# no generic host-function-call expression support yet (Phase 17's own
# job), so this phase reuses the existing ContractFail instruction
# (already used for immutable-reassignment and no-arm-matched failures)
# behind a JumpIfFalse instead: same OBSERVABLE behaviour (aborts with a
# named message when false, silently continues when true), not yet the
# same host-call shape.
#
# Checked directly, not assumed: this is entirely independent of the
# flight check (Fork C, Phase 7) -- that check's own bounded points-to/
# shape analysis is sized to proving box_set mutation-exclusivity
# specifically (see flight_check.patlang's own header) and has nothing to
# say about an arbitrary boolean expression. A require/ensure/assert is
# never subsumed by it, not "not yet wired up" -- see
# spec_library/block_model/contracts.feature's own header for the same
# note stated for the record.
#
# Phase 11 adds `match`/`case` (section 4.1's own "forks don't need their
# own boundary" finding, verified there only for if/else -- this phase
# checks it against Match too). Reuses the real self-hosted
# self_hosting/lib/lower.patlang's own compile_pattern/lower_match exactly
# as the template (same [testNode, letStmts] desugaring, same
# bindings-before-guard ordering, same JumpIfFalse-chain-per-arm shape,
# same guaranteed-fail tail when no arm matches) -- not a new pattern-
# compilation scheme invented for this engine.
#
# Deliberately scoped to PWild/PBind/PLit/PCmp -- the four pattern kinds
# expressible with bm_lower_expr's existing Const/Var/Bin support. PGlob
# (needs a generic host-function-call expression, glob_match) and PList
# (needs Member/Index expression support plus real List values) are
# explicitly NOT supported here -- checked before writing this, not
# discovered as a gap afterward: bm_lower_expr has neither Member/Index
# nor generic host-function-call support today (Phase 17's own job, per
# docs/plans/block-ownership-model-full-language-plan.md). A PGlob/PList
# pattern hits bm_lower_unsupported, named plainly.
#
# Phase 10 adds event dispatch (section 8's own claim, checked directly
# against the real Rust interpreter and found narrower than stated -- see
# block_ir.patlang's own Phase 10 note for the full finding): a top-level
# `["When", event_name, body, line]` node lowers to its own synthesized,
# non-jump-callable BlockIR, registered in the program's own compile-time
# event table (bi_program_events) rather than block_names/blocks_by_name --
# deliberately excluded from both, so a handler can NEVER be reached via
# an ordinary JumpBlock/Call, only through Emit's own table lookup. Its
# body is lowered with block_names/blocks_by_name passed as EMPTY lists on
# purpose: this phase's Emit instruction runs a handler as a bounded,
# non-tail sub-execution with no call stack to unwind through a nested
# jump (interp.patlang's own header), so a handler calling another
# declared function is out of scope here, not silently allowed -- it hits
# bm_lower_unsupported exactly like any other unrecognized call shape. A
# `while` loop IS still reachable inside a handler body for free (nothing
# about bm_lower_top_level_stmt_list's own While handling depends on
# block_names), since a loop's own JumpBlock targets are always its own
# synthesized head/exit blocks, never a user-declared function.
#
# `emit(event, payload)` lowers as a bare statement (bm_lower_stmt's own
# "Expr" arm) to a MID-BLOCK ["Emit"] instruction, never a JumpBlock --
# see block_ir.patlang's own header for exactly why (it returns control,
# unlike everything else this engine's blocks end with).
#
# Phase 7 adds (section 6, Fork C, wired in for real): flight_check
# .patlang's own `fresh` tracking, threaded through
# bm_lower_top_level_stmt_list (see its own Let-handling below), decides
# whether a box_set call site is patched from BoxSet (Phase 3's runtime
# refcount check) to BoxSetUnchecked (skip it -- proven safe statically).
# See flight_check.patlang's own header for exactly how narrow that
# proof is kept (a straight line of top-level statements only; anything
# else -- if/else, while, a jump-call -- invalidates the whole set rather
# than being reasoned through). `fresh` is deliberately NOT threaded into
# bm_lower_expr's own signature for this: since only ONE call shape
# (`let X = box_set(Y, ...)`) is ever eligible, patching the single
# instruction bm_lower_stmt already emitted (always immediately before
# the Store it also emits) is simpler and less error-prone than adding a
# parameter to every one of bm_lower_expr's ~20 call sites for a decision
# only one of them needs.

include "block_ir.patlang"
include "free_vars.patlang"
include "flight_check.patlang"

make a function called bm_is_mut_param_name takes name returns yes
  if name.length < 4 then
    return false
  end
  return substr(name, 0, 4) == "mut_"
end

make a function called bm_list_contains takes xs, v returns yes
  let n = list_len(xs)
  let i = 0
  while i < n do
    if list_get(xs, i) == v then
      return true
    end
    let i = i + 1
  end
  return false
end

make a function called bm_lower_unsupported takes what returns nothing
  contract_check("bm_lower", "assert", "block-model Phase 2's restricted subset does not support: " + what, false)
  return false
end

make a function called bm_lower_expr takes node, instrs, block_names, immut_params returns out
  let ty = list_get(node, 0)
  if ty == "Num" then
    return list_push(instrs, ["Const", "num", list_get(node, 1)])
  elif ty == "Str" then
    return list_push(instrs, ["Const", "str", list_get(node, 1)])
  elif ty == "Bool" then
    return list_push(instrs, ["Const", "bool", list_get(node, 1)])
  elif ty == "Var" then
    return list_push(instrs, ["Load", list_get(node, 1)])
  elif ty == "Bin" then
    let instrs = bm_lower_expr(list_get(node, 2), instrs, block_names, immut_params)
    let instrs = bm_lower_expr(list_get(node, 3), instrs, block_names, immut_params)
    return list_push(instrs, ["Bin", list_get(node, 1)])
  elif ty == "Un" then
    let instrs = bm_lower_expr(list_get(node, 2), instrs, block_names, immut_params)
    return list_push(instrs, ["Un", list_get(node, 1)])
  elif ty == "Member" then
    # obj.prop (read) -- reuses HandlerLookup exactly: an object's own
    # payload (once BoxGet'd) IS a Handler-shaped assoc-list (Phase 13's
    # own header note above). Pop order matches handler_lookup's own Call
    # case below: name pushed first (bottom), handler pushed second (top).
    let obj_node = list_get(node, 1)
    let prop = list_get(node, 2)
    let instrs = list_push(instrs, ["Const", "str", prop])
    let instrs = bm_lower_expr(obj_node, instrs, block_names, immut_params)
    let instrs = list_push(instrs, ["BoxGet"])
    return list_push(instrs, ["HandlerLookup"])
  elif ty == "Call" then
    let name = list_get(node, 1)
    let args = list_get(node, 2)
    if name == "new" then
      # Phase 13: new("ClassName") only -- see this file's own header for
      # why this deliberately doesn't match the real engine's own runtime
      # new/class_def/OBJECTS-registry mechanism.
      let class_name_node = list_get(args, 0)
      if list_get(class_name_node, 0) != "Str" then
        bm_lower_unsupported("new(...) with a non-literal class name (Phase 13 requires new(\"ClassName\") with a literal string)")
        return instrs
      end
      let class_name = list_get(class_name_node, 1)
      let fields = bm_class_fields(class_name)
      if fields == false then
        bm_lower_unsupported("new(\"" + class_name + "\") -- no class named '" + class_name + "' was declared with `class " + class_name + " do ... end` (Phase 13 does not support the older name-registry new(...) form)")
        return instrs
      end
      let tmp = bm_next_synth_name("__newobj")
      let instrs = list_push(instrs, ["HandlerNew"])
      let instrs = list_push(instrs, ["Store", tmp])
      let flds_n = list_len(fields)
      let fi = 0
      while fi < flds_n do
        let fld = list_get(fields, fi)
        let instrs = bm_lower_expr(list_get(fld, 1), instrs, block_names, immut_params)
        let instrs = list_push(instrs, ["Const", "str", list_get(fld, 0)])
        let instrs = list_push(instrs, ["Load", tmp])
        let instrs = list_push(instrs, ["HandlerRegister"])
        let instrs = list_push(instrs, ["Store", tmp])
        let fi = fi + 1
      end
      let instrs = list_push(instrs, ["Load", tmp])
      return list_push(instrs, ["BoxNew"])
    elif name == "type_of" then
      let instrs = bm_lower_expr(list_get(args, 0), instrs, block_names, immut_params)
      return list_push(instrs, ["TypeOf"])
    elif name == "read_file" then
      let instrs = bm_lower_expr(list_get(args, 0), instrs, block_names, immut_params)
      return list_push(instrs, ["ReadFile"])
    elif name == "write_file" then
      let instrs = bm_lower_expr(list_get(args, 0), instrs, block_names, immut_params)
      let instrs = bm_lower_expr(list_get(args, 1), instrs, block_names, immut_params)
      return list_push(instrs, ["WriteFile"])
    elif name == "query" then
      let instrs = bm_lower_expr(list_get(args, 0), instrs, block_names, immut_params)
      let instrs = bm_lower_expr(list_get(args, 1), instrs, block_names, immut_params)
      let instrs = bm_lower_expr(list_get(args, 2), instrs, block_names, immut_params)
      return list_push(instrs, ["Query"])
    elif name == "box_new" then
      let instrs = bm_lower_expr(list_get(args, 0), instrs, block_names, immut_params)
      return list_push(instrs, ["BoxNew"])
    elif name == "box_get" then
      let instrs = bm_lower_expr(list_get(args, 0), instrs, block_names, immut_params)
      return list_push(instrs, ["BoxGet"])
    elif name == "box_share" then
      let instrs = bm_lower_expr(list_get(args, 0), instrs, block_names, immut_params)
      return list_push(instrs, ["BoxShare"])
    elif name == "box_set" then
      let target = list_get(args, 0)
      if (list_get(target, 0) == "Var") and bm_list_contains(immut_params, list_get(target, 1)) then
        # Matches section 3.4's own original template exactly: a RUNTIME
        # guaranteed-fail check at the violation point (only fails when
        # this line actually executes), not a compile-time reject --
        # consistent with how self_hosting/lib/lower.patlang's own
        # immutable-reassignment check works (see that file's `Let` arm).
        return list_push(instrs, ["ContractFail", "box_set on read-only parameter '" + list_get(target, 1) + "' (declare it `mut_" + list_get(target, 1) + "` to allow mutation)"])
      end
      let instrs = bm_lower_expr(target, instrs, block_names, immut_params)
      let instrs = bm_lower_expr(list_get(args, 1), instrs, block_names, immut_params)
      return list_push(instrs, ["BoxSet"])
    elif name == "get_global" then
      let instrs = bm_lower_expr(list_get(args, 0), instrs, block_names, immut_params)
      let instrs = list_push(instrs, ["Load", "__globals"])
      return list_push(instrs, ["GlobalGet"])
    elif name == "handler_new" then
      return list_push(instrs, ["HandlerNew"])
    elif name == "handler_register" then
      let instrs = bm_lower_expr(list_get(args, 2), instrs, block_names, immut_params)
      let instrs = bm_lower_expr(list_get(args, 1), instrs, block_names, immut_params)
      let instrs = bm_lower_expr(list_get(args, 0), instrs, block_names, immut_params)
      return list_push(instrs, ["HandlerRegister"])
    elif name == "handler_lookup" then
      let instrs = bm_lower_expr(list_get(args, 1), instrs, block_names, immut_params)
      let instrs = bm_lower_expr(list_get(args, 0), instrs, block_names, immut_params)
      return list_push(instrs, ["HandlerLookup"])
    end
  end
  bm_lower_unsupported("expression shape '" + ty + "'")
  return instrs
end

# A Call to another declared block: lowers its args (each pushed, in
# order) then a single JumpBlock naming the callee's OWN param list --
# JumpBlock's own contract (block_ir.patlang) is "pop one value per
# param_name, in that order", so the callee's declared parameter names
# double as the field names the jump populates, matching section 3.2's
# "populated by name when the jump happens" exactly.
# A Call to another declared block: lowers its args (each pushed, in
# order), then an implicit extra push of the CURRENT "__globals" value
# (never written at the source call site -- section 3.3's threading,
# automatic here), then a single JumpBlock naming the callee's OWN param
# list, which bm_lower_program has already appended "__globals" onto.
make a function called bm_lower_jump_call takes call_node, instrs, block_names, blocks_by_name, immut_params returns out
  let target = list_get(call_node, 1)
  let args = list_get(call_node, 2)
  let target_blk = bm_assoc_get(blocks_by_name, target)
  let params = bi_block_params(target_blk)
  let n = list_len(args)
  let instrs = instrs
  let i = 0
  while i < n do
    let instrs = bm_lower_expr(list_get(args, i), instrs, block_names, immut_params)
    let i = i + 1
  end
  let instrs = list_push(instrs, ["Load", "__globals"])
  return list_push(instrs, ["JumpBlock", target, params])
end

# Phase 11: mirrors self_hosting/lib/lower.patlang's own compile_pattern
# exactly, restricted to the four pattern kinds this engine's expression
# lowering can actually handle (see this file's own Phase 11 header note
# for PGlob/PList's real, checked-not-assumed exclusion).
make a function called bm_compile_pattern takes pattern, scrutinee_node returns r
  let tag = list_get(pattern, 0)
  if tag == "PWild" then
    return [["Bool", "true"], []]
  elif tag == "PBind" then
    return [["Bool", "true"], [["Let", list_get(pattern, 1), scrutinee_node, false, false]]]
  elif tag == "PLit" then
    return [["Bin", "==", scrutinee_node, list_get(pattern, 1)], []]
  elif tag == "PCmp" then
    return [["Bin", list_get(pattern, 1), scrutinee_node, list_get(pattern, 2)], []]
  end
  bm_lower_unsupported("match pattern kind '" + tag + "' (Phase 11 supports PWild/PBind/PLit/PCmp only)")
  return [["Bool", "false"], []]
end

# Phase 12: a small pretty-printer for this engine's own restricted
# expression shapes, mirroring what ast_to_source_text gives the real
# contract_check its own diagnostic text from -- scoped to exactly the
# expression kinds bm_lower_expr already understands (Num/Str/Bool/Var/
# Bin/Un), not a general unparser.
make a function called bm_expr_to_text takes node returns s
  let ty = list_get(node, 0)
  if ty == "Num" then
    return "" + list_get(node, 1)
  elif ty == "Str" then
    return "\"" + list_get(node, 1) + "\""
  elif ty == "Bool" then
    return "" + list_get(node, 1)
  elif ty == "Var" then
    return list_get(node, 1)
  elif ty == "Bin" then
    return bm_expr_to_text(list_get(node, 2)) + " " + list_get(node, 1) + " " + bm_expr_to_text(list_get(node, 3))
  elif ty == "Un" then
    return list_get(node, 1) + bm_expr_to_text(list_get(node, 2))
  end
  return "<expr>"
end

make a function called bm_lower_stmt takes node, instrs, block_names, blocks_by_name, immut_params returns out
  let ty = list_get(node, 0)
  if ty == "Let" then
    let instrs = bm_lower_expr(list_get(node, 2), instrs, block_names, immut_params)
    return list_push(instrs, ["Store", list_get(node, 1)])
  elif ty == "Assert" then
    # require/ensure/assert -- kind is one of those three literal strings
    # (see parser.patlang's own parse_stmt: `["Assert", tx, e[0]]`).
    # `cond true` -> fall through; `cond false` -> ContractFail naming the
    # kind and the condition's own source text, matching contract_check's
    # own diagnostic shape as closely as this engine's instructions allow.
    let kind = list_get(node, 1)
    let cond = list_get(node, 2)
    let instrs = bm_lower_expr(cond, instrs, block_names, immut_params)
    let instrs = list_push(instrs, ["JumpIfFalse", 0])
    let jif_pos = list_len(instrs) - 1
    let instrs = list_push(instrs, ["Jump", 0])
    let jmp_pos = list_len(instrs) - 1
    let instrs = list_set(instrs, jif_pos, ["JumpIfFalse", list_len(instrs)])
    let instrs = list_push(instrs, ["ContractFail", kind + " failed: " + bm_expr_to_text(cond)])
    let instrs = list_set(instrs, jmp_pos, ["Jump", list_len(instrs)])
    return instrs
  elif ty == "MemberAssign" then
    # obj.prop = value -- reuses box_set's OWN mut-check and refcount
    # mutate-in-place-vs-clone mechanism unmodified (Phase 13's own header
    # note: writing a field literally IS calling box_set on the object's
    # whole record). The mut-check runs FIRST, before anything else is
    # lowered, matching box_set's own established style (the Call-expr
    # case above) rather than lowering everything then discarding it.
    let obj_node = list_get(node, 1)
    let prop = list_get(node, 2)
    let value_node = list_get(node, 3)
    if (list_get(obj_node, 0) == "Var") and bm_list_contains(immut_params, list_get(obj_node, 1)) then
      return list_push(instrs, ["ContractFail", "field write on read-only parameter '" + list_get(obj_node, 1) + "' (declare it `mut_" + list_get(obj_node, 1) + "` to allow mutation)"])
    end
    # Store obj into a fresh temp ONCE (never re-evaluate a possibly
    # side-effecting object expression twice, the same reasoning
    # compile_pattern's own scrutinee-caching comment gives). Build the
    # updated assoc-list via HandlerRegister (ref, then name, then the
    # CURRENT handler read back via BoxGet each time -- same pop order as
    # the handler_register Call-expr case above) into a SECOND temp, since
    # box_set's own pop order is (ptr pushed first/bottom, value pushed
    # second/top, per the box_set Call-expr case above) -- the opposite of
    # what falls out of computing the updated record right before BoxSet
    # would give, so it's computed first and reloaded in the right order
    # rather than pushed in the wrong order (a real bug caught here via a
    # genuine segfault, not assumed correct from the shape alone).
    let tmp = bm_next_synth_name("__objref")
    let tmp2 = bm_next_synth_name("__objnewval")
    let instrs = bm_lower_expr(obj_node, instrs, block_names, immut_params)
    let instrs = list_push(instrs, ["Store", tmp])
    let instrs = bm_lower_expr(value_node, instrs, block_names, immut_params)
    let instrs = list_push(instrs, ["Const", "str", prop])
    let instrs = list_push(instrs, ["Load", tmp])
    let instrs = list_push(instrs, ["BoxGet"])
    let instrs = list_push(instrs, ["HandlerRegister"])
    let instrs = list_push(instrs, ["Store", tmp2])
    let instrs = list_push(instrs, ["Load", tmp])
    let instrs = list_push(instrs, ["Load", tmp2])
    let instrs = list_push(instrs, ["BoxSet"])
    # box_set may return a DIFFERENT pointer (clone-on-alias, Phase 3) --
    # if obj_node is a bare Var, re-Store the result into that SAME
    # source-level name so this block's own later reads see the write,
    # exactly matching box_set's own "reassign to the result" convention,
    # just automated here since MemberAssign gives source no place to
    # write an explicit reassignment. When obj_node isn't a bare Var,
    # there's no name to re-point -- discarded, a real, named, narrow gap
    # (mutating through a non-Var object expression won't observe its own
    # post-clone update within the same block), not silently papered over.
    if list_get(obj_node, 0) == "Var" then
      return list_push(instrs, ["Store", list_get(obj_node, 1)])
    end
    return list_push(instrs, ["Store", bm_next_synth_name("__discard")])
  elif ty == "Match" then
    # Mirrors the real lower_match's own shape exactly: store the
    # scrutinee once (re-evaluating a side-effecting expression per arm
    # would be a real correctness bug, matching that file's own reasoning
    # verbatim), then a JumpIfFalse-chained sequence of (pattern test,
    # bindings, optional guard, body) per arm, ending in a guaranteed-fail
    # ContractFail if nothing matched -- PatLang has no static
    # exhaustiveness check, so an unmatched scrutinee is a genuine runtime
    # bug, not a silent no-op (the real engine's own issue #44 decision).
    let scrutinee_node = list_get(node, 1)
    let arms = list_get(node, 2)
    let tmp = bm_next_synth_name("__match")
    let instrs = bm_lower_expr(scrutinee_node, instrs, block_names, immut_params)
    let instrs = list_push(instrs, ["Store", tmp])
    let scrutinee_var = ["Var", tmp]
    let end_jumps = []
    let an = list_len(arms)
    let ai = 0
    while ai < an do
      let arm = list_get(arms, ai)
      let pattern = list_get(arm, 0)
      let guard = list_get(arm, 1)
      let body = list_get(arm, 2)
      let comp = bm_compile_pattern(pattern, scrutinee_var)
      let test_node = list_get(comp, 0)
      let let_stmts = list_get(comp, 1)
      let instrs = bm_lower_expr(test_node, instrs, block_names, immut_params)
      let instrs = list_push(instrs, ["JumpIfFalse", 0])
      let jif_pattern_pos = list_len(instrs) - 1
      # Bindings a pattern introduced (PBind) must exist before the guard
      # runs -- a guard referencing that binding (`case n when n > 100`)
      # would otherwise read an unbound name, exactly the real
      # lower_match's own documented reasoning for this ordering.
      let ln = list_len(let_stmts)
      let li = 0
      while li < ln do
        let instrs = bm_lower_stmt(list_get(let_stmts, li), instrs, block_names, blocks_by_name, immut_params)
        let li = li + 1
      end
      let jif_guard_pos = 0 - 1
      if guard != false then
        let instrs = bm_lower_expr(guard, instrs, block_names, immut_params)
        let instrs = list_push(instrs, ["JumpIfFalse", 0])
        let jif_guard_pos = list_len(instrs) - 1
      end
      let instrs = bm_lower_stmt_list(body, instrs, block_names, blocks_by_name, immut_params)
      let instrs = list_push(instrs, ["Jump", 0])
      let end_jumps = list_push(end_jumps, list_len(instrs) - 1)
      let next_arm_pc = list_len(instrs)
      let instrs = list_set(instrs, jif_pattern_pos, ["JumpIfFalse", next_arm_pc])
      if jif_guard_pos >= 0 then
        let instrs = list_set(instrs, jif_guard_pos, ["JumpIfFalse", next_arm_pc])
      end
      let ai = ai + 1
    end
    let instrs = list_push(instrs, ["ContractFail", "match: no arm matched"])
    let end_pos = list_len(instrs)
    let en = list_len(end_jumps)
    let ei = 0
    while ei < en do
      let instrs = list_set(instrs, list_get(end_jumps, ei), ["Jump", end_pos])
      let ei = ei + 1
    end
    return instrs
  elif ty == "If" then
    let cond = list_get(node, 1)
    let then_stmts = list_get(node, 2)
    let else_stmts = list_get(node, 3)
    let instrs = bm_lower_expr(cond, instrs, block_names, immut_params)
    let instrs = list_push(instrs, ["JumpIfFalse", 0])
    let jif_pos = list_len(instrs) - 1
    let instrs = bm_lower_stmt_list(then_stmts, instrs, block_names, blocks_by_name, immut_params)
    let instrs = list_push(instrs, ["Jump", 0])
    let jmp_pos = list_len(instrs) - 1
    let instrs = list_set(instrs, jif_pos, ["JumpIfFalse", list_len(instrs)])
    let instrs = bm_lower_stmt_list(else_stmts, instrs, block_names, blocks_by_name, immut_params)
    let instrs = list_set(instrs, jmp_pos, ["Jump", list_len(instrs)])
    return instrs
  elif ty == "Expr" then
    let call = list_get(node, 1)
    if list_get(call, 0) == "Call" then
      let name = list_get(call, 1)
      let call_args = list_get(call, 2)
      if name == "print" then
        let instrs = bm_lower_expr(list_get(call_args, 0), instrs, block_names, immut_params)
        return list_push(instrs, ["Print"])
      elif name == "set_global" then
        # Statement-only (unlike get_global): auto-writes "__globals"
        # directly, so it never leaves a value on the stack to consume --
        # exactly matching how the real ambient set_var(...) is used
        # today (a bare statement, never an expression).
        let instrs = bm_lower_expr(list_get(call_args, 1), instrs, block_names, immut_params)
        let instrs = bm_lower_expr(list_get(call_args, 0), instrs, block_names, immut_params)
        let instrs = list_push(instrs, ["Load", "__globals"])
        return list_push(instrs, ["GlobalSet"])
      elif (name == "box_set") or (name == "box_share") or (name == "box_new") or (name == "box_get") or (name == "get_global") or (name == "handler_new") or (name == "handler_register") or (name == "handler_lookup") or (name == "type_of") or (name == "read_file") or (name == "write_file") or (name == "query") then
        # Phase 19 found a real, latent bug here while debugging a native
        # build: EVERY one of these is an expression (pushes a real
        # result), but this delegation used to return bm_lower_expr's own
        # output UNCHANGED when called as a bare statement -- leaving that
        # result sitting on the stack, unconsumed, corrupting whatever
        # this block does next (checked directly: a fixture chaining
        # fact()/write_file() as bare statements before further calls
        # printed garbage from the resulting misalignment). The real
        # lower.patlang's own established convention is exactly this:
        # `if wants_value == false then Store "__discard" end` after an
        # unconsumed Call -- applied here now, at this ONE shared
        # delegation point rather than patched per name, since all twelve
        # names funnel through it. Never previously exercised because no
        # earlier fixture chained two of these bare-statement calls (or
        # one plus anything else) in the same block.
        let instrs = bm_lower_expr(call, instrs, block_names, immut_params)
        return list_push(instrs, ["Store", "__bm_discard"])
      elif name == "fact" then
        # Bare statement, matching print/emit's own convention -- fact()
        # returns Unit in the real host function too, never consumed.
        let instrs = bm_lower_expr(list_get(call_args, 0), instrs, block_names, immut_params)
        let instrs = bm_lower_expr(list_get(call_args, 1), instrs, block_names, immut_params)
        let instrs = bm_lower_expr(list_get(call_args, 2), instrs, block_names, immut_params)
        return list_push(instrs, ["Fact"])
      elif name == "fiber_yield" then
        # Mid-block, same reasoning as emit's own lowering: fiber_yield
        # returns whatever the corresponding fiber_resume passed, and this
        # engine's programs need to keep running afterward, not jump away
        # permanently.
        let instrs = bm_lower_expr(list_get(call_args, 0), instrs, block_names, immut_params)
        return list_push(instrs, ["FiberYield"])
      elif name == "emit" then
        # Mid-block, unlike everything else emitted here (JumpBlock always
        # ends the block; Emit never does) -- see block_ir.patlang's own
        # Phase 10 header for why: emit() genuinely returns control to the
        # statement after it, matching the real interpreter's own
        # call-with-return semantics, not a jump-and-never-return one.
        let instrs = bm_lower_expr(list_get(call_args, 1), instrs, block_names, immut_params)
        let instrs = bm_lower_expr(list_get(call_args, 0), instrs, block_names, immut_params)
        let instrs = list_push(instrs, ["Load", "__globals"])
        return list_push(instrs, ["Emit"])
      elif bm_list_contains(block_names, name) then
        return bm_lower_jump_call(call, instrs, block_names, blocks_by_name, immut_params)
      end
    end
    bm_lower_unsupported("a call to anything other than print, a box_*/global/handler builtin, or a declared block")
    return instrs
  elif ty == "Return" then
    let e = list_get(node, 1)
    if list_get(e, 0) == "Call" then
      let name = list_get(e, 1)
      if bm_list_contains(block_names, name) then
        return bm_lower_jump_call(e, instrs, block_names, blocks_by_name, immut_params)
      end
    end
    bm_lower_unsupported("`return EXPR` where EXPR isn't a call to a declared block (no call stack to return a value up through yet)")
    return instrs
  end
  bm_lower_unsupported("statement shape '" + ty + "'")
  return instrs
end

make a function called bm_lower_stmt_list takes stmts, instrs, block_names, blocks_by_name, immut_params returns out
  let n = list_len(stmts)
  let i = 0
  while i < n do
    let instrs = bm_lower_stmt(list_get(stmts, i), instrs, block_names, blocks_by_name, immut_params)
    let i = i + 1
  end
  return instrs
end

make a function called bm_next_synth_name takes prefix returns name
  let n = get("__vars", "bm_synth_counter")
  set_var("bm_synth_counter", n + 1)
  return prefix + "_" + n
end

make a function called bm_push_loads takes instrs, names returns out
  let n = list_len(names)
  let i = 0
  while i < n do
    let instrs = list_push(instrs, ["Load", list_get(names, i)])
    let i = i + 1
  end
  return instrs
end

# The ONLY place a `while` is recognized -- a function's own top level
# (see this file's own header on why). Every non-While statement here
# delegates straight to the ORIGINAL bm_lower_stmt (unchanged), so
# everything Phases 2-4 already support keeps working identically; only
# `let` additionally extends known_locals for a LATER while's own capture
# set, and `while` itself hands off the statements after it to a
# synthesized exit block rather than continuing this same loop.
make a function called bm_lower_top_level_stmt_list takes stmts, start_idx, instrs, block_names, blocks_by_name, immut_params, known_locals, pending, fresh returns out
  let n = list_len(stmts)
  let i = start_idx
  while i < n do
    let stmt = list_get(stmts, i)
    let ty = list_get(stmt, 0)
    if ty == "While" then
      return bm_lower_while(stmt, stmts, i, instrs, block_names, blocks_by_name, immut_params, known_locals, pending)
    elif ty == "Let" then
      let val_node = list_get(stmt, 2)
      let instrs = bm_lower_stmt(stmt, instrs, block_names, blocks_by_name, immut_params)
      let known_locals = list_push(known_locals, list_get(stmt, 1))
      # Phase 7 (Fork C): if this Let's value was box_set(TARGET, ...) and
      # TARGET is provably unique right now (flight_check.patlang's own
      # `fresh` tracking), patch the BoxSet bm_lower_stmt just emitted
      # (always the instruction right before the Store it also emitted)
      # into BoxSetUnchecked -- simpler and far less error-prone than
      # threading `fresh` through bm_lower_expr's entire recursive
      # signature for the sake of this one call shape.
      if (list_get(val_node, 0) == "Call") and (list_get(val_node, 1) == "box_set") then
        let target_node = list_get(list_get(val_node, 2), 0)
        if (list_get(target_node, 0) == "Var") and bm_fc_is_provably_unique(fresh, list_get(target_node, 1)) then
          let boxset_pos = list_len(instrs) - 2
          let instrs = list_set(instrs, boxset_pos, ["BoxSetUnchecked"])
        end
      end
      let fresh = bm_fc_after_let(fresh, list_get(stmt, 1), val_node)
      let i = i + 1
    else
      # If/Return/Expr (including a bare jump-call): conservatively
      # invalidate `fresh` entirely -- this narrow, straight-line-only
      # analysis doesn't reason through any of these (flight_check
      # .patlang's own header).
      let instrs = bm_lower_stmt(stmt, instrs, block_names, blocks_by_name, immut_params)
      let fresh = []
      let i = i + 1
    end
  end
  return [instrs, pending]
end

make a function called bm_lower_while takes stmt, stmts, idx, instrs, block_names, blocks_by_name, immut_params, known_locals, pending returns out
  let cond = list_get(stmt, 1)
  let body_stmts = list_get(stmt, 2)
  let head_name = bm_next_synth_name("__loop_head")
  let exit_name = bm_next_synth_name("__loop_exit")
  # Phase 6 (Fork E): real free-variable analysis over the loop body,
  # intersected with known_locals (a name free in the body but not bound
  # anywhere in the enclosing scope is a genuine unbound-variable bug,
  # left for bm_loc_get's existing runtime check to catch, not silently
  # absorbed here) -- replaces Phase 5's own `captured = known_locals`
  # wholesale placeholder.
  let free = bm_free_vars_of_body(body_stmts)
  let captured = bm_intersect_preserving_order(known_locals, free)
  let jump_params = list_push(captured, "__globals")

  # 1) At the current point in the CALLING block: enter the loop head for
  #    the first time, forwarding captured's own current values.
  let instrs = bm_push_loads(instrs, captured)
  let instrs = list_push(instrs, ["Load", "__globals"])
  let instrs = list_push(instrs, ["JumpBlock", head_name, jump_params])

  # 2) The loop head block itself: cond; JumpIfFalse to the false-path
  #    tail (position fixed up once known); the body; an unconditional
  #    back edge to head_name; then the false-path tail (forward captured,
  #    jump to exit_name) -- the SAME shape as an ordinary if/else with an
  #    always-taken true branch (section 4.1: nothing new invented here).
  let head_instrs = bm_lower_expr(cond, [], block_names, immut_params)
  let head_instrs = list_push(head_instrs, ["JumpIfFalse", 0])
  let jif_pos = list_len(head_instrs) - 1
  let body_result = bm_lower_top_level_stmt_list(body_stmts, 0, head_instrs, block_names, blocks_by_name, immut_params, captured, pending, [])
  let head_instrs = list_get(body_result, 0)
  let pending = list_get(body_result, 1)
  let head_instrs = bm_push_loads(head_instrs, captured)
  let head_instrs = list_push(head_instrs, ["Load", "__globals"])
  let head_instrs = list_push(head_instrs, ["JumpBlock", head_name, jump_params])
  let head_instrs = list_set(head_instrs, jif_pos, ["JumpIfFalse", list_len(head_instrs)])
  let head_instrs = bm_push_loads(head_instrs, captured)
  let head_instrs = list_push(head_instrs, ["Load", "__globals"])
  let head_instrs = list_push(head_instrs, ["JumpBlock", exit_name, jump_params])
  let pending = list_push(pending, ["BlockIR", head_name, jump_params, bm_hash_rewrite_instrs(head_instrs)])

  # 3) The loop exit block: same captured params, body = whatever
  #    statements textually followed the while in the enclosing function.
  let exit_result = bm_lower_top_level_stmt_list(stmts, idx + 1, [], block_names, blocks_by_name, immut_params, captured, pending, [])
  let exit_instrs = list_get(exit_result, 0)
  let pending = list_get(exit_result, 1)
  let pending = list_push(pending, ["BlockIR", exit_name, jump_params, bm_hash_rewrite_instrs(exit_instrs)])

  return [instrs, pending]
end

# Phase 10: registers handler_name against event_name in registration
# order, appending to that event's own handler list if it's already seen
# (the "multiple handlers for the same event" case) rather than
# overwriting -- unlike bm_rt_assoc_set (interp.patlang), which always
# replaces a single value, since an event key maps to a GROWING list here.
make a function called bm_events_register takes events, event_name, handler_name returns out
  let n = list_len(events)
  let i = 0
  while i < n do
    let entry = list_get(events, i)
    if list_get(entry, 0) == event_name then
      return list_set(events, i, [event_name, list_push(list_get(entry, 1), handler_name)])
    end
    let i = i + 1
  end
  return list_push(events, [event_name, [handler_name]])
end

make a function called bm_assoc_get takes assoc, key returns v
  let n = list_len(assoc)
  let i = 0
  while i < n do
    let entry = list_get(assoc, i)
    if list_get(entry, 0) == key then
      return list_get(entry, 1)
    end
    let i = i + 1
  end
  return false
end

# Optimization (post-Phase-8): unconditionally replaces every
# instruction's own opcode string (element 0) with block_ir.patlang's
# bm_op_hash of it -- a pure relabeling, safe for EVERY block regardless
# of shape (unlike the slot-indexing attempt this replaced after
# measuring a net regression: hashing touches only the dispatch TAG,
# never a name/value Load/Store actually reads or writes, so there is no
# "if this block has an if-branch, skip it" caveat needed here at all).
# "Bin"/"Un" ALSO get their own second element (the operator, e.g. "+")
# hashed, since bm_apply_bin/bm_apply_un dispatch on THAT string too.
make a function called bm_hash_rewrite_instrs takes instrs returns out
  let n = list_len(instrs)
  let out = []
  let i = 0
  while i < n do
    let instr = list_get(instrs, i)
    let op = list_get(instr, 0)
    if (op == "Bin") or (op == "Un") then
      let out = list_push(out, [bm_op_hash(op), bm_op_hash(list_get(instr, 1))])
    elif op == "Const" then
      let out = list_push(out, [bm_op_hash(op), list_get(instr, 1), list_get(instr, 2)])
    elif op == "JumpIfFalse" then
      let out = list_push(out, [bm_op_hash(op), list_get(instr, 1)])
    elif op == "Jump" then
      let out = list_push(out, [bm_op_hash(op), list_get(instr, 1)])
    elif op == "Load" then
      let out = list_push(out, [bm_op_hash(op), list_get(instr, 1)])
    elif op == "Store" then
      let out = list_push(out, [bm_op_hash(op), list_get(instr, 1)])
    elif op == "ContractFail" then
      let out = list_push(out, [bm_op_hash(op), list_get(instr, 1)])
    elif op == "JumpBlock" then
      let out = list_push(out, [bm_op_hash(op), list_get(instr, 1), list_get(instr, 2)])
    else
      # Print/BoxNew/BoxGet/BoxSet/BoxSetUnchecked/BoxShare/GlobalGet/
      # GlobalSet/HandlerNew/HandlerRegister/HandlerLookup/Emit/
      # FiberYield/Fact/Query/TypeOf/ReadFile/WriteFile: no operand beyond
      # the opcode itself.
      let out = list_push(out, [bm_op_hash(op)])
    end
    let i = i + 1
  end
  return out
end

make a function called bm_lower_program takes ast returns prog
  set_var("bm_synth_counter", 0)
  let stmts = list_get(ast, 1)
  let n = list_len(stmts)

  # Pass 0 (Phase 13): a compile-time-only class registry (name -> field
  # defaults), scanned before Pass 1 so a `new("ClassName")` call site can
  # resolve regardless of source order, same reasoning as Pass 1's own
  # forward-reference support for ordinary functions. A ClassDecl
  # declaring `inherits`/methods/traits is rejected here, plainly, before
  # any of its fields are even registered -- see this file's own Phase 13
  # header note for exactly why those three are out of scope.
  set_var("bm_class_registry", [])
  let i = 0
  while i < n do
    let stmt = list_get(stmts, i)
    if list_get(stmt, 0) == "ClassDecl" then
      let cname = list_get(stmt, 1)
      let cparent = list_get(stmt, 2)
      let cfields = list_get(stmt, 3)
      let cmethods = list_get(stmt, 4)
      let ctraits = list_get(stmt, 5)
      if cparent != "" then
        bm_lower_unsupported("class '" + cname + "' declares `inherits " + cparent + "` -- Phase 13's restricted subset supports fields only, no inheritance yet")
      end
      if list_len(cmethods) > 0 then
        bm_lower_unsupported("class '" + cname + "' declares a method -- Phase 13's restricted subset supports fields only, no method dispatch yet")
      end
      if list_len(ctraits) > 0 then
        bm_lower_unsupported("class '" + cname + "' declares traits -- Phase 13's restricted subset supports fields only, no traits yet")
      end
      set_var("bm_class_registry", bm_class_registry_set(get("__vars", "bm_class_registry"), cname, cfields))
    end
    let i = i + 1
  end

  # Pass 1: every declared function name, and its own empty-bodied BlockIR
  # (params only) -- built first so a jump to a function declared LATER in
  # source order still resolves during pass 2's actual body lowering.
  # "__globals" is appended to EVERY block's own param list here, hidden
  # from the source program entirely (section 3.3/Fork B) -- both passes
  # append it identically so a block's own declared param list (used for
  # box_set's mut-check, immut_params below) never includes it, while
  # JumpBlock's field-name list (bi_block_params) always does.
  let block_names = []
  let blocks_by_name = []
  let i = 0
  while i < n do
    let stmt = list_get(stmts, i)
    if list_get(stmt, 0) == "Func" then
      let name = list_get(stmt, 1)
      let params = list_push(list_get(stmt, 2), "__globals")
      let block_names = list_push(block_names, name)
      let blocks_by_name = list_push(blocks_by_name, [name, ["BlockIR", name, params, []]])
    end
    let i = i + 1
  end

  # Pass 2: lower each function's real body now that every target name is
  # known, replacing each placeholder's empty instrs. Each function's own
  # immut_params (its declared params WITHOUT the `mut_` prefix) is
  # recomputed here, per block -- box_set's mut-check only ever looks at
  # THIS block's own parameter list, never a caller's or callee's.
  let blocks = []
  let events = []
  let entry = false
  let i = 0
  while i < n do
    let stmt = list_get(stmts, i)
    if list_get(stmt, 0) == "Func" then
      let name = list_get(stmt, 1)
      let declared_params = list_get(stmt, 2)
      let params = list_push(declared_params, "__globals")
      let body = list_get(stmt, 3)
      if entry == false then
        let entry = name
      end
      # immut_params is computed from declared_params ONLY -- "__globals"
      # is never a user-facing mut/immut target, just plumbing.
      let immut_params = []
      let pn = list_len(declared_params)
      let pi = 0
      while pi < pn do
        let pname = list_get(declared_params, pi)
        if not bm_is_mut_param_name(pname) then
          let immut_params = list_push(immut_params, pname)
        end
        let pi = pi + 1
      end
      let top_result = bm_lower_top_level_stmt_list(body, 0, [], block_names, blocks_by_name, immut_params, declared_params, [], [])
      let instrs = list_get(top_result, 0)
      let synthesized = list_get(top_result, 1)
      let blocks = list_push(blocks, ["BlockIR", name, params, bm_hash_rewrite_instrs(instrs)])
      let sn = list_len(synthesized)
      let si = 0
      while si < sn do
        let blocks = list_push(blocks, list_get(synthesized, si))
        let si = si + 1
      end
    elif list_get(stmt, 0) == "When" then
      # Phase 10: see this file's own header above for why block_names/
      # blocks_by_name are EMPTY here (a handler can't JumpBlock to a
      # declared function) and why this handler is never added to the
      # program's own block_names -- it's reachable only through `events`.
      let event_name = list_get(stmt, 1)
      let body = list_get(stmt, 2)
      let handler_name = bm_next_synth_name("__on_" + event_name)
      let handler_params = ["event_name", "event_data", "__globals"]
      let handler_immut_params = ["event_name", "event_data"]
      let handler_known_locals = ["event_name", "event_data"]
      let top_result = bm_lower_top_level_stmt_list(body, 0, [], [], [], handler_immut_params, handler_known_locals, [], [])
      let handler_instrs = list_get(top_result, 0)
      let handler_synth = list_get(top_result, 1)
      let blocks = list_push(blocks, ["BlockIR", handler_name, handler_params, bm_hash_rewrite_instrs(handler_instrs)])
      let hs = list_len(handler_synth)
      let hi = 0
      while hi < hs do
        let blocks = list_push(blocks, list_get(handler_synth, hi))
        let hi = hi + 1
      end
      let events = bm_events_register(events, event_name, handler_name)
    end
    let i = i + 1
  end
  return ["BlockProgramIR", entry, blocks, events]
end
