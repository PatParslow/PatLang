      let out = list_push(out, ["Call", "fact", 3])
      let out = list_push(out, ["Store", bm_nc_prefix(block_name, "__bm_discard")])
    elif op == 295774 then # "Query"
      let out = list_push(out, ["Call", "query", 3])
    elif op == 289875 then # "TypeOf"
      # type_of(v) -- confirmed a real, already-compiled x64_runtime
      # .patlang function (line 6305), NOT missing as this plan document
