# pati: the native PatLang interpreter (docs/plans/native-interpreter.md).
#
# Runs a PatLang source file with the compiler's own front end -- the same
# include and syntax-DSL expansion, lexer, parser and block lowering
# `patc1 --x64` uses -- and executes the resulting block IR with
# interp.patlang. Built with `patc1 --x64` (tools/build_pati.sh), so it runs on
# x64_runtime.patlang, the runtime compiled programs use.
#
# Usage: pati <file.patlang> [args...]
include "../lib/lexer.patlang"
include "../lib/parser.patlang"
include "../lib/includes.patlang"
include "../lib/regex_dsl.patlang"
include "../lib/syntax_dsl.patlang"
include "lower.patlang"
include "interp.patlang"

make a function called pati_run_file takes path returns code
  let raw = read_file(path)
  let source = expand_syntax_dsls(expand_includes_native(raw, path_dirname(path)))
  let ast = parse_program(tokenize(source))
  let err = parse_find_error(ast[1])
  if err[0] != "" then
    print(format_parse_error(err[0], err[1], source))
    return 1
  end
  let prog = bm_lower_program(ast)
  let unused = bi_run(prog)
  return 0
end

let pati_args = argv()
if list_len(pati_args) < 1 then
  print("usage: pati <file.patlang> [args...]")
  exit_with(2)
end
let pati_code = pati_run_file(pati_args[0])
if pati_code != 0 then
  exit_with(pati_code)
end
