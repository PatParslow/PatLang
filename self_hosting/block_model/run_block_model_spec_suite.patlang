# Block Ownership Model: runner for spec_library/block_model/*.feature,
# through the real executable Gherkin runner (self_hosting/lib/test.patlang) --
# mirrors self_hosting/tools/run_language_spec_suite.patlang's own pattern
# (include the framework, register steps, run each feature file, t_report()
# at the end), applied to this design's own parallel spec suite instead.
#
# Deliberately separate from run_language_spec_suite.patlang and its
# standing gate: see spec_steps_block_model.patlang's header for why.
#
# Usage: rust-runtime/target/release/pat.exe --ir-run
#        self_hosting/block_model/run_block_model_spec_suite.patlang
#
# Phase 1 (Fork D, the refcounted heap) verifies through a separate native-
# only mechanism instead (self_hosting/block_model/refcounted_heap_native_
# check.sh) -- these primitives don't exist under the interpreter this
# suite runs on, checked directly; see that check's own header. Each later
# phase adds its own register_*_steps() call and lists its .feature path
# below as it lands -- see docs/plans/block-ownership-model-implementation-
# plan.md for the phase breakdown this suite tracks.

include "../lib/test.patlang"
include "spec_steps_block_model.patlang"

t_init()
register_block_dispatch_steps()
register_mut_parameters_steps()
register_globals_elimination_steps()
register_object_handler_steps()
register_loop_blocks_steps()
register_free_variable_capture_steps()

let features = [
  "spec_library/block_model/block_dispatch.feature",
  "spec_library/block_model/mut_parameters.feature",
  "spec_library/block_model/globals_elimination.feature",
  "spec_library/block_model/object_handler.feature",
  "spec_library/block_model/loop_blocks.feature",
  "spec_library/block_model/free_variable_capture.feature"
]

let i = 0
let n = to_num(list_len(features))
while i < n do
  run_feature_file(list_get(features, i))
  let i = i + 1
end

t_report()
