# Block Ownership Model: runner for spec_library/block_model/*.feature,
# through the real executable Gherkin runner (self_hosting/lib/gherkin.patlang) --
# mirrors self_hosting/tools/run_language_spec_suite.patlang's own pattern
# (include the framework, register steps, run each feature file, t_report()
# at the end), applied to this design's own parallel spec suite instead.
#
# Deliberately separate from run_language_spec_suite.patlang and its
# standing gate: see spec_steps_block_model.patlang's header for why.
#
# Usage: rust-runtime/target/release/pat.exe --ir-run
#        self_hosting/block_model/run_block_model_spec_suite.patlang
#
# Phase 1 (Fork D, the refcounted heap) verifies through a separate native-
# only mechanism instead (self_hosting/block_model/refcounted_heap_native_
# check.sh) -- these primitives don't exist under the interpreter this
# suite runs on, checked directly; see that check's own header. Each later
# phase adds its own register_*_steps() call and lists its .feature path
# below as it lands -- see docs/plans/block-ownership-model-implementation-
# plan.md for the phase breakdown this suite tracks.

include "../lib/includes.patlang"
include "../lib/gherkin.patlang"
include "spec_steps_block_model.patlang"

let ctx = ctx_new()
register_block_dispatch_steps(ctx)
register_mut_parameters_steps(ctx)
register_globals_elimination_steps(ctx)
register_object_handler_steps(ctx)
register_loop_blocks_steps(ctx)
register_free_variable_capture_steps(ctx)
register_flight_check_steps(ctx)
register_debugger_parity_steps(ctx)
register_event_dispatch_steps(ctx)
register_pattern_matching_steps(ctx)
register_contracts_steps(ctx)
register_contract_facts_steps(ctx)
register_object_orientation_steps(ctx)
register_concurrency_steps(ctx)
register_goap_steps(ctx)
register_numeric_tower_steps(ctx)
register_system_integration_steps(ctx)
register_library_parity_steps(ctx)
register_call_with_return_steps(ctx)
register_apply_dynamic_dispatch_steps(ctx)
register_toplevel_statements_steps(ctx)
register_library_selftest_parity_steps(ctx)
register_free_variable_capture_while_steps(ctx)
register_issue_157_159_steps(ctx)
register_goap_rules_goals_steps(ctx)
register_closures_steps(ctx)
register_budgeted_steps(ctx)
register_parallel_map_steps(ctx)
register_lowering_scaling_steps(ctx)
register_named_objects_steps(ctx)
register_named_objects_delete_steps(ctx)
register_event_handler_calls_steps(ctx)
register_two_process_signals_steps(ctx)
register_exploration_scaling_steps(ctx)
register_class_methods_steps(ctx)
register_class_members_steps(ctx)
register_class_field_defaults_steps(ctx)
register_method_call_ad_hoc_steps(ctx)
register_match_list_patterns_steps(ctx)
register_goap_activate_steps(ctx)

let features = [
  "spec_library/block_model/block_dispatch.feature",
  "spec_library/block_model/mut_parameters.feature",
  "spec_library/block_model/globals_elimination.feature",
  "spec_library/block_model/object_handler.feature",
  "spec_library/block_model/loop_blocks.feature",
  "spec_library/block_model/free_variable_capture.feature",
  "spec_library/block_model/flight_check.feature",
  "spec_library/block_model/debugger_parity.feature",
  "spec_library/block_model/event_dispatch.feature",
  "spec_library/block_model/pattern_matching.feature",
  "spec_library/block_model/contracts.feature",
  "spec_library/block_model/object_orientation.feature",
  "spec_library/block_model/concurrency.feature",
  "spec_library/block_model/goap.feature",
  "spec_library/block_model/numeric_tower.feature",
  "spec_library/block_model/system_integration.feature",
  "spec_library/block_model/library_parity.feature",
  "spec_library/block_model/call_with_return.feature",
  "spec_library/block_model/apply_dynamic_dispatch.feature",
  "spec_library/block_model/toplevel_statements.feature",
  "spec_library/block_model/library_selftest_parity.feature",
  "spec_library/block_model/closures.feature",
  "spec_library/block_model/budgeted.feature",
  "spec_library/block_model/parallel_map.feature",
  "spec_library/block_model/lowering_scaling.feature",
  "spec_library/block_model/named_objects.feature",
  "spec_library/block_model/two_process_signals.feature",
  "spec_library/block_model/exploration_scaling.feature",
  "spec_library/block_model/class_methods.feature",
  "spec_library/block_model/goap_activate.feature"
]

let i = 0
let n = to_num(list_len(features))
while i < n do
  run_feature_file(ctx, list_get(features, i))
  let i = i + 1
end

ctx_report(ctx)
