# Runs ONE block-model feature file through the same real Gherkin runner and
# step registrations as run_block_model_spec_suite.patlang, for fast
# per-issue verification while the full suite (about 35 minutes, mostly
# native x64 compiles) is reserved for the pre-commit regression gate.
#
# Usage (from the repo root):
#   rust-runtime/target/release/pat.exe --ir-run \
#     self_hosting/block_model/run_one_feature.patlang \
#     spec_library/block_model/<name>.feature <register_fn>[,<register_fn>...]
#
# The register function name(s) are passed explicitly because registrations
# are per-feature (e.g. register_apply_dynamic_dispatch_steps); several may be
# given, comma-separated, for a feature whose scenarios were extended by later
# issues. Each is dispatched through apply() -- the same mechanism the
# Gherkin runner itself uses for step functions.

include "../lib/test.patlang"
include "spec_steps_block_model.patlang"

t_init()
let args = argv()
let feature_path = list_get(args, 0)
let register_list = list_get(args, 1)

# Split the comma-separated list (short, bounded input) and apply each.
let start = 0
let i = 0
let n = register_list.length
while i <= n do
  if (i == n) or (char_code(register_list, i) == 44) then
    if i > start then
      apply(substr(register_list, start, i - start))
    end
    let start = i + 1
  end
  let i = i + 1
end

run_feature_file(feature_path)
t_report()
