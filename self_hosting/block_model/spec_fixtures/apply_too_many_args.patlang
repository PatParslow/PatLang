# Driver fixture for spec_library/block_model/apply_dynamic_dispatch.feature
# (issue #153): apply() called with MORE arguments than the resolved
# callee declares must be a guaranteed contract failure that names the
# callee and both counts -- never a silent drop of the extra argument.
# `start` declared first (bm_lower_program's first-Func entry).

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let src = "make a function called start returns r
  print(1)
  apply(\"one_param\", 10, 20)
  print(999)
end

make a function called one_param takes a returns r
  print(a)
  return true
end
"

let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)
bi_run(prog)
