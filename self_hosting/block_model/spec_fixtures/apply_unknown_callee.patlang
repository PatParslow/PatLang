# Driver fixture for spec_library/block_model/apply_dynamic_dispatch.feature
# (issue #153): apply() with a runtime-computed name that matches no
# declared function must be a guaranteed contract failure naming the
# missing function -- bi_find_block returns `false` for an unknown name
# (it does not raise on its own), which used to fail obscurely.

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let src = "make a function called start returns r
  print(1)
  apply(\"no_such_function\")
  print(999)
end
"

let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)
bi_run(prog)
