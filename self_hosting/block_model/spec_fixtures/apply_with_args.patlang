# Driver fixture for spec_library/block_model/apply_dynamic_dispatch.feature
# (issue #153): apply(fn_name, arg1, ..., argN) -- dynamic dispatch to a
# declared function by a runtime-computed name, WITH arguments, in both
# value context and bare-statement context. CallDynamic (commit 5b22750)
# only supported the zero-argument bare-statement form.
# `start` is declared FIRST (bm_lower_program picks the first declared
# Func as the entry).

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let src = "make a function called start returns r
  let sum = apply(\"add2\", 3, 4)
  print(sum)
  apply(\"show3\", 10, 20, 30)
  print(apply(\"zero\"))
  if apply(\"is_pos\", 5) == true then
    print(1)
  else
    print(0)
  end
  print(999)
end

make a function called add2 takes x, y returns r
  return x + y
end

make a function called show3 takes a, b, c returns r
  print(a)
  print(b)
  print(c)
  return true
end

make a function called zero returns r
  return 0
end

make a function called is_pos takes n returns r
  return n > 0
end
"

let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)
bi_run(prog)
