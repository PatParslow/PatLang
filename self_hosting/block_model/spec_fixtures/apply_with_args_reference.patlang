# Reference for spec_library/block_model/apply_dynamic_dispatch.feature
# (issue #153): the SAME source as apply_with_args.patlang's own inner
# `src`, run directly as an ordinary PatLang program (no block model) --
# what pat --ir-run's real interpreter produces for it.

make a function called start returns r
  let sum = apply("add2", 3, 4)
  print(sum)
  apply("show3", 10, 20, 30)
  print(apply("zero"))
  if apply("is_pos", 5) == true then
    print(1)
  else
    print(0)
  end
  print(999)
end

make a function called add2 takes x, y returns r
  return x + y
end

make a function called show3 takes a, b, c returns r
  print(a)
  print(b)
  print(c)
  return true
end

make a function called zero returns r
  return 0
end

make a function called is_pos takes n returns r
  return n > 0
end

start()
