# Driver fixture for spec_library/block_model/call_with_return.feature
# (Phase 22): the deeper manifestation of the same bug
# bare_call_sequential.patlang covers -- a bare-statement call to a
# declared function as the LAST statement of an ORDINARY if/else branch
# (no nested while, so bm_lower_stmt_list's own plain, non-continuation-
# threading path lowers it), with code AFTER the whole if statement in
# the SAME block. bm_lower_stmt_list has no notion of "is this the last
# statement" at all -- every statement inside an if/else branch reaches
# bm_lower_stmt's own bare-call dispatch the same way a top-level one
# does, so the same JumpBlock-always bug applied here too, silently
# skipping the print(999) that follows the whole if statement.

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let src = "make a function called start returns r
  if true then
    helper()
  end
  print(999)
end

make a function called helper returns r
  print(1)
  return true
end
"

let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)
bi_run(prog)
