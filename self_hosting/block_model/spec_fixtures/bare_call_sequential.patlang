# Driver fixture for spec_library/block_model/call_with_return.feature
# (Phase 22, third finding): a bare-statement call to a declared function,
# FOLLOWED BY MORE CODE in the same function body -- found while
# re-attempting Phase 18's own checkpoint one level further out
# (self_hosting/schema_bdd_selftest.patlang's own run_schema_bdd_selftest
# calls t_init(), register_library_loans_schema(), etc. as bare
# statements in sequence, each expected to run in turn).
#
# bm_lower_stmt's own bare-statement dispatch for a call to a declared
# block-model function ALWAYS lowered via JumpBlock -- a one-way,
# non-returning transfer -- correct only when that call is truly the
# LAST thing that ever runs. Reached in ANY other position (more
# statements after it, or inside an ordinary if/else branch, which
# bm_lower_stmt_list threads no continuation through at all), it
# silently discarded every statement written after it, with no error at
# all. Confirmed via this exact minimal repro before the fix: only `a`'s
# own print (1) appeared; `b`'s print (2) and the trailing print(999)
# never ran.

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let src = "make a function called start returns r
  a()
  b()
  print(999)
end

make a function called a returns r
  print(1)
  return true
end

make a function called b returns r
  print(2)
  return true
end
"

let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)
bi_run(prog)
