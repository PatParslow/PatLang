# Reference for spec_library/block_model/call_with_return.feature (Phase
# 22): the SAME source as bare_call_sequential.patlang's own inner `src`,
# run directly as an ordinary PatLang program (no block model at all) --
# what pat --ir-run's own real interpreter produces for it, cross-checked
# against the block-model engine's own output for the identical source.

make a function called start returns r
  a()
  b()
  print(999)
end

make a function called a returns r
  print(1)
  return true
end

make a function called b returns r
  print(2)
  return true
end

start()
