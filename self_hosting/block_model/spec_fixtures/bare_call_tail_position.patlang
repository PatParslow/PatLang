# Driver fixture for spec_library/block_model/call_with_return.feature
# (GitHub issue filed with this fixture): a bare-statement call to a
# declared function that is the LAST statement of its function -- the one
# shape commit 6ab8efe (issue #149) deliberately kept lowering via
# JumpBlock. That special case in bm_lower_top_level_stmt_list returned
# the bare instruction list, not the [instrs, pending] pair every other
# return path in that function returns, and NO fixture ever exercised it
# (every earlier fixture's bare call was followed by another statement, or
# was `return F()`, a different code path). It surfaced the first time a
# real program ended a body with a bare call: a script-style selftest's
# closing `t_report()`.

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let src = "make a function called start returns r
  print(1)
  helper()
end

make a function called helper returns r
  print(2)
end
"

let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)
bi_run(prog)
