# Reference for spec_library/block_model/library_parity.feature (Phase
# 22): the SAME source as bin_and_or_shortcircuit.patlang's own inner
# `src`, run directly as an ordinary PatLang program (no block model at
# all).

make a function called start returns r
  let x = 0
  if (x == 0) or (10 / x > 1) then
    print(1)
  end
  if (x != 0) and (10 / x > 1) then
    print(2)
  else
    print(3)
  end
end

start()
