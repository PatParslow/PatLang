# Reference for spec_library/block_model/budgeted.feature (GitHub issue #176,
# budgeted half): `budgeted(ms[, handle]) { body }` run directly under the real
# engine. Covers a block that finishes inside a generous budget, and a zero
# budget that pauses at every while back-edge and is resumed by handing the
# returned handle back until it reports done.

make a function called start returns r
  let n = 5
  let r1 = budgeted(1000000) {
    let t = 0
    let i = 0
    while i < n do
      let t = t + i
      let i = i + 1
    end
    return t
  }
  print(r1[0])
  print(r1[1])
  let h = false
  let pauses = 0
  let fin = false
  let out = 0
  while not fin do
    let r2 = budgeted(0, h) {
      let t = 0
      let i = 0
      while i < n do
        let t = t + i
        let i = i + 1
      end
      return t
    }
    if r2[0] == r1[0] then
      let fin = true
      let out = r2[1]
    else
      let h = r2[1]
      let pauses = pauses + 1
    end
  end
  print(out)
  print(pauses)
end

start()
