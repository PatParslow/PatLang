# Driver fixture for spec_library/block_model/call_with_return.feature
# (Phase 21): a declared function called AS A VALUE (`let x = helper(5)
# + 1`) -- the real blocker Phase 18 found and named -- plus direct
# recursion (`fact`), both previously impossible under Fork A's own
# flat, no-call-stack model. `start` is declared FIRST (bm_lower_program
# picks the first declared Func as the program's own entry), matching
# every other fixture in this tree.

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let src = "make a function called start returns r
  let x = double(5) + 1
  print(x)
  print(fact_r(5))
end

make a function called double takes n returns r
  return n * 2
end

make a function called fact_r takes n returns r
  if n <= 1 then
    return 1
  end
  return n * fact_r(n - 1)
end
"

let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)
bi_run(prog)
