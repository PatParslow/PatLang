# Reference for spec_library/block_model/call_with_return.feature
# (Phase 21): the SAME source as call_with_return.patlang's own inner
# `src`, run directly as an ordinary PatLang program (no block model at
# all) -- what pat --ir-run's own real interpreter produces for it,
# cross-checked against the block-model engine's own output for the
# identical source.

make a function called start returns r
  let x = double(5) + 1
  print(x)
  print(fact_r(5))
end

make a function called double takes n returns r
  return n * 2
end

make a function called fact_r takes n returns r
  if n <= 1 then
    return 1
  end
  return n * fact_r(n - 1)
end

start()
