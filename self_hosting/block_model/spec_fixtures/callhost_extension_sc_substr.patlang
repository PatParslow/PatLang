# Driver fixture for spec_library/block_model/library_parity.feature
# (GitHub issue #159): sc_substr through CallHost. interp_call_host (the
# shared self-hosted dispatcher, protected by the plan's Phase 20 rule)
# has sc_len/sc_code/sc_char but not sc_substr, which
# self_hosting/lib/step_match.patlang's own sm_match calls. Resolved by a
# block-model-local extension table tried when the shared table has no
# answer. Both an ASCII and a non-ASCII string: the real host takes a
# different path for each (bytes vs. chars).

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let src = "make a function called start returns r
  let h = str_intern(\"hello world\")
  print(sc_substr(h, 6, 5))
  let g = str_intern(\"héllo wörld\")
  print(sc_substr(g, 1, 4))
  print(no_such_host_function_xyz(1))
end
"

let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)
bi_run(prog)
