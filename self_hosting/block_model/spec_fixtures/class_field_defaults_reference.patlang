# Given classes with field defaults of every kind -- a fields-only class and
#   one with a method --
# When objects are made with new(class, name), at the top level and in a
#   function,
# Then each field reads back its declared default, as under the real engine.
# A class with only fields was never registered with class_def (only one
# with methods, a parent or traits was), so its objects had no defaults:
# natively every field read 0, and the block-model interpreter read blanks.
class Cfg {
  field ms = 50
  field name = "x"
  field on = true
  field l = [1, 2]
  field f = 1.5
}
class Counter {
  field n = 3
  make a function called bump takes self returns r
    self.n = self.n + 1
    return self.n
  end
}
make a function called in_function returns r
  new("Cfg", "d")
  return get("d", "ms") + 1
end
new("Cfg", "c")
print(get("c", "ms"))
print(get("c", "name"))
print(get("c", "on"))
print(get("c", "l"))
print(get("c", "f"))
print(in_function())
new("Counter", "k")
print(send("k", "bump"))
