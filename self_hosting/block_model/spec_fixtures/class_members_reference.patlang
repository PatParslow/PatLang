# Reference for spec_library/block_model/class_methods.feature (GitHub #175):
# member reads and writes on NAMED objects held in variables, from inside a
# method (self.field) and from outside (obj.field), next to the get/send forms
# they mean. Run unchanged under the real engine and through the block-model
# engine.

class Counter {
  field n = 0
  field label = "c"
  make a function called bump takes self, by returns r
    send(self, "set", "n", get(self, "n") + by)
    return self.n
  end
  make a function called reset takes self returns r
    self.n = 0
    return self.n
  end
}

make a function called start returns r
  new("Counter", "c1")
  let c = "c1"
  print(c.n)
  print(c.bump(2))
  print(c.bump(3))
  c.n = 10
  print(c.n)
  print(get("c1", "n"))
  c.label = "renamed"
  print(c.label)
  print(c.reset())
  print(send("c1", "bump", 1))
end

start()
