# Reference for spec_library/block_model/class_methods.feature (GitHub #175): classes
# with methods, single inheritance and traits, called through send() and the
# obj.method() form, on named objects. Run unchanged under the real engine and
# through the block-model engine; the printed lines must match.

class Animal {
  field name = "x"
  field sound = "..."
  make a function called speak takes self returns r
    return get(self, "sound")
  end
  make a function called describe takes self, suffix returns r
    return get(self, "name") + " says " + self.speak() + suffix
  end
}
class Dog inherits Animal {
  field sound = "woof"
}
class Loud {
  make a function called speak takes self returns r
    return "LOUD"
  end
}
class Puppy inherits Dog {
  traits Loud
}

make a function called start returns r
  new("Animal", "a1")
  new("Dog", "d1")
  new("Puppy", "p1")
  send("d1", "set", "name", "Rex")
  print(send("a1", "speak"))
  print(send("d1", "speak"))
  print(send("d1", "describe", "!"))
  print(send("p1", "speak"))
  print(send("p1", "describe", "?"))
  print(get("d1", "type"))
  print(get("p1", "sound"))
  let who = "d1"
  print(send(who, "speak"))
  print(who.speak())
end

start()
