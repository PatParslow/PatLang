# Driver fixture for spec_library/block_model/closures.feature (GitHub issue
# #175's foundation): first-class closures through the block-model engine.
# `start` is declared FIRST (bm_lower_program's first-Func entry rule does not
# apply here only because there are no top-level statements).

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let src = "make a function called start returns r
  let base = 10
  let add = |x| { return x + base }
  print(add(5))
  let mk = make_adder(3)
  print(mk(4))
  print(apply_twice(add, 1))
  let snap = 100
  let show = |u| { return snap }
  let snap = 200
  print(show(0))
  let inc = |a| { return a + 1 }
  let inc2 = |a| { return inc(inc(a)) }
  print(inc2(5))
end

make a function called make_adder takes n returns r
  return |x| { return x + n }
end

make a function called apply_twice takes f, v returns r
  return f(f(v))
end
"

let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)
bi_run(prog)
