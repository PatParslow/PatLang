# Reference for spec_library/block_model/closures.feature (GitHub issue
# #175's foundation): first-class closures run directly under the real
# engine. Covers: capture of an enclosing local, a closure RETURNED from a
# function (capturing that function's parameter), a closure PASSED as a
# parameter and called there, snapshot-by-value capture (a later change to the
# captured variable is NOT seen), and a closure calling a closure.

make a function called start returns r
  let base = 10
  let add = |x| { return x + base }
  print(add(5))
  let mk = make_adder(3)
  print(mk(4))
  print(apply_twice(add, 1))
  let snap = 100
  let show = |u| { return snap }
  let snap = 200
  print(show(0))
  let inc = |a| { return a + 1 }
  let inc2 = |a| { return inc(inc(a)) }
  print(inc2(5))
end

make a function called make_adder takes n returns r
  return |x| { return x + n }
end

make a function called apply_twice takes f, v returns r
  return f(f(v))
end

start()
