# Driver fixture for closures.feature (issue #182): closures and loops; see
# closures_in_loops_reference.patlang for what each variable is and the
# expected total (309).

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let src = "make a function called start returns r
  let k = 100
  let f = |x| { return x + 1 }
  let i = 0
  let total = 0
  while i < 3 do
    let g = |y| { return y + k }
    let total = total + g(i) + f(i)
    let i = i + 1
  end
  print(total)
end
"

let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)
bi_run(prog)
