# Reference for closures.feature (issue #182): closures and loops.
# `k` is used ONLY inside a closure created in the loop body; `f` is used ONLY
# as a callee inside the loop. Neither is mentioned any other way, so an
# enclosing loop must capture them through the free-variable analysis.
# Expected total: (100+1) + (101+2) + (102+3) = 309.

make a function called start returns r
  let k = 100
  let f = |x| { return x + 1 }
  let i = 0
  let total = 0
  while i < 3 do
    let g = |y| { return y + k }
    let total = total + g(i) + f(i)
    let i = i + 1
  end
  print(total)
end

start()
