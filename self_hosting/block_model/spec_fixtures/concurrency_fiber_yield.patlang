# Driver fixture for spec_library/block_model/concurrency.feature (Phase
# 14). `count_loop` yields its own progress value on each jump-chained
# step (0, 1, 2) before finally printing 999 and finishing -- an ordinary
# Phase 2 jump-chain, not a `while` loop, so no new lowering mechanism is
# needed beyond FiberYield itself. The OUTSIDE driver (this file's own
# top level) wraps running the WHOLE block-model program in a fiber, so
# it can resume it one step at a time from outside, exactly mirroring
# Phase 8's own bi_debug_run pattern but driven by the PROGRAM's own
# fiber_yield calls instead of the debugger's.

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

make a function called run_it takes unused returns r
  let src = "make a function called start returns r
  return count_loop(0)
end

make a function called count_loop takes n returns r
  if n < 3 then
    fiber_yield(n)
    return count_loop(n + 1)
  end
  print(999)
end
"
  let toks = tokenize(src)
  let ast = parse_program(toks)
  let prog = bm_lower_program(ast)
  return bi_run(prog)
end

let gen = fiber_new("run_it")
print("pause1: " + fiber_resume(gen, 0))
print("pause2: " + fiber_resume(gen, 0))
print("pause3: " + fiber_resume(gen, 0))
print("final: " + fiber_resume(gen, 0))
print("still alive: " + fiber_alive(gen))
