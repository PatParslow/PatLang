# Driver fixture for spec_library/block_model/library_parity.feature
# (GitHub issue #154): the truthiness of a NON-boolean value used directly
# as an if/while condition. interp.patlang's JumpIfFalse tested
# `== false` strictly, so "" / 0 / [] all counted as TRUE under
# block-model, where the real engine treats them as false. Found because
# self_hosting/lib/test.patlang's run_feature (`if filter then`, with
# filter == "") printed "Scenario: X  []" under block-model and
# "Scenario: X" under pat --ir-run for the identical feature file.
#
# Each line prints "T" or "F" for the branch taken.

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let src = "make a function called start returns r
  let empty_str = \"\"
  let zero = 0
  let empty_list = []
  let full_str = \"a\"
  let one = 1
  let full_list = [1]
  let yes = true
  let no = false
  if empty_str then print(\"T\") else print(\"F\") end
  if zero then print(\"T\") else print(\"F\") end
  if empty_list then print(\"T\") else print(\"F\") end
  if full_str then print(\"T\") else print(\"F\") end
  if one then print(\"T\") else print(\"F\") end
  if full_list then print(\"T\") else print(\"F\") end
  if yes then print(\"T\") else print(\"F\") end
  if no then print(\"T\") else print(\"F\") end
  let n = 0
  let hold = []
  while hold do
    let n = n + 1
    let hold = list_get([[], [], [], false], n)
  end
  print(n)
end
"

let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)
bi_run(prog)
