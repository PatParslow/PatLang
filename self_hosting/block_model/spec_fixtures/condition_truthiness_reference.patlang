# Reference for spec_library/block_model/library_parity.feature (issue
# #154): the SAME source as condition_truthiness.patlang's own inner
# `src`, run directly as an ordinary PatLang program -- the real engine's
# own truthiness for each value.

make a function called start returns r
  let empty_str = ""
  let zero = 0
  let empty_list = []
  let full_str = "a"
  let one = 1
  let full_list = [1]
  let yes = true
  let no = false
  if empty_str then print("T") else print("F") end
  if zero then print("T") else print("F") end
  if empty_list then print("T") else print("F") end
  if full_str then print("T") else print("F") end
  if one then print("T") else print("F") end
  if full_list then print("T") else print("F") end
  if yes then print("T") else print("F") end
  if no then print("T") else print("F") end
  let n = 0
  let hold = []
  while hold do
    let n = n + 1
    let hold = list_get([[], [], [], false], n)
  end
  print(n)
end

start()
