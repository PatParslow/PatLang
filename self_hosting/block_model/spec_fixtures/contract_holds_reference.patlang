# Reference for spec_library/block_model/contracts.feature (GitHub #180): a passing
# require and a passing ensure each record a `contract_holds` fact that solve()
# can query. Run unchanged under the real engine and through the block-model
# engine; the number of solutions must match.

make a function called half takes n returns result
  require n >= 0
  let result = n / 2
  ensure result >= 0
  return result
end
let h = half(10)
let sols = solve("contract_holds", ["half", "X"])
print(sols.length)
