# Driver fixture for spec_library/block_model/contracts.feature (Phase
# 12), scenario 3: the block's own body runs (prints 1) first, THEN a
# failing ensure aborts before the jump to `next` -- next's own body
# (which would print 2) must never run.

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let src = "make a function called start returns r
  print(1)
  ensure 5 > 9
  return next_block()
end

make a function called next_block returns r
  print(777)
end
"

let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)
bi_run(prog)
