# Driver fixture for spec_library/block_model/debugger_parity.feature.
# A program that jumps through three distinct blocks before finishing.
# bi_debug_run is spawned as a real fiber; each fiber_resume advances
# exactly one block and returns the trail as it stands at that pause
# point -- a genuinely changing answer at each step, not a canned one,
# proving pause/resume actually works against this engine rather than
# just asserting it does. Runs entirely under the interpreter (fiber_new/
# fiber_yield/fiber_resume are representation-agnostic, checked directly
# against self_hosting/examples/fiber_demo.patlang first).

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let src = "make a function called start returns r
  return blockB()
end

make a function called blockB returns r
  return blockC()
end

make a function called blockC returns r
  print(42)
end
"

let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)

let fib = fiber_new("bi_debug_run")
let trail1 = fiber_resume(fib, prog)
print(trail1)
let trail2 = fiber_resume(fib, 0)
print(trail2)
let trail3 = fiber_resume(fib, 0)
print(trail3)
print(fiber_alive(fib))
let final_result = fiber_resume(fib, 0)
print(final_result)
print(fiber_alive(fib))
