# Driver fixture for spec_library/block_model/debugger_parity.feature.
# Eight blocks chained together -- more than bi_trail_max()'s own cap of
# 5 -- to prove the trail genuinely drops old entries rather than growing
# without bound (Fork D's own point applied to this specific trail).

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let src = "make a function called b0 returns r
  return b1()
end
make a function called b1 returns r
  return b2()
end
make a function called b2 returns r
  return b3()
end
make a function called b3 returns r
  return b4()
end
make a function called b4 returns r
  return b5()
end
make a function called b5 returns r
  return b6()
end
make a function called b6 returns r
  return b7()
end
make a function called b7 returns r
  print(999)
end
"

let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)

let fib = fiber_new("bi_debug_run")
let i = 0
let last_trail = []
while i < 8 do
  let last_trail = fiber_resume(fib, prog)
  let i = i + 1
end
print(list_len(last_trail))
print(last_trail)
