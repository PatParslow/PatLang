# Driver fixture for spec_library/block_model/event_dispatch.feature (Phase
# 10), scenario 5: a handler's own set_global must be visible to the
# EMITTING block immediately after the emit() call returns -- proving
# Emit propagates the handler's own updated "__globals" pointer back into
# the caller's locals, not just discarding it when the handler's bounded
# sub-execution ends.

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let src = "when set_it do
  set_global(\"counter\", 41)
end

make a function called start returns r
  emit(\"set_it\", 0)
  let c = get_global(\"counter\")
  print(c + 1)
end
"

let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)
bi_run(prog)
