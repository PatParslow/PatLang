# Driver fixture for spec_library/block_model/event_dispatch.feature (GitHub
# issue #178). Same program as event_handler_calls_reference.patlang.

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let src = "

make a function called start returns r
  emit(\"ping\", \"hello\")
  emit(\"pong\", \"\")
  print(\"after\")
end

make a function called shout takes s returns r
  print(s)
  return 41
end

when pong do
  shout(\"tail\")
end

when ping do
  let n = shout(\"got \" + event_data)
  shout(\"bare\")
  print(n + 1)
end

"

let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)
bi_run(prog)

