# Reference for spec_library/block_model/event_dispatch.feature (GitHub issue
# #178): a `when` handler that calls declared functions, once as a value and
# once as a bare statement, then uses the value. Run directly under the real
# engine.

make a function called start returns r
  emit("ping", "hello")
  emit("pong", "")
  print("after")
end

make a function called shout takes s returns r
  print(s)
  return 41
end

when pong do
  shout("tail")
end

when ping do
  let n = shout("got " + event_data)
  shout("bare")
  print(n + 1)
end

start()

