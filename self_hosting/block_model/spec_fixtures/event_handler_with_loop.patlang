# Driver fixture for spec_library/block_model/event_dispatch.feature
# (Phase 10, regression scenario added in Phase 21): a `when` handler
# containing a `while` loop actually runs to completion. A real,
# previously-shipped bug (Phase 19's own Emit implementation) made a
# single bare bi_run_block call and rejected the loop's own first
# JumpBlock (the back-edge) as "attempted to jump to another block" --
# contradicting lower.patlang's own header claim that a loop is
# reachable inside a handler body "for free". Fixed in Phase 21 by
# rewiring Emit's own handler dispatch onto bi_run_from (interp.patlang),
# which follows "jump" outcomes to completion instead of assuming one
# call suffices.

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let src = "when tick do
  let i = 0
  while i < 3 do
    print(i)
    let i = i + 1
  end
  print(99)
end

make a function called start returns r
  emit(\"tick\", 0)
end
"

let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)
bi_run(prog)
