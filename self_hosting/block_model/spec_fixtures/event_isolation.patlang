# Driver fixture for spec_library/block_model/event_dispatch.feature (Phase
# 10), scenario 2: a handler that references a name only the EMITTING
# block declared (never one of its own two auto-bound params) must fail
# with the same guaranteed unbound-variable error every other block
# boundary already gives (block_dispatch.feature, Phase 2) -- proving a
# `when` handler's own isolation is real, not merely by convention.

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let src = "when tick do
  print(hidden)
end

make a function called start returns r
  let hidden = 12345
  emit(\"tick\", 0)
  return finish()
end

make a function called finish returns r
  print(1)
end
"

let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)
bi_run(prog)
