# Driver fixture for spec_library/block_model/event_dispatch.feature (Phase
# 10), scenario 3: two separate `when ping` blocks both fire on one emit,
# in the order they were declared -- checked via the exact contiguous
# "100\n200" substring (host_print's own emit_out always appends a
# newline, confirmed in rust-runtime/src/ir/hosts.rs before relying on it
# here), not just presence of each number independently.

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let src = "when ping do
  print(100)
end

when ping do
  print(200)
end

make a function called start returns r
  emit(\"ping\", 0)
  return finish()
end

make a function called finish returns r
  print(999)
end
"

let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)
bi_run(prog)
