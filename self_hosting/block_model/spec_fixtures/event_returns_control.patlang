# Driver fixture for spec_library/block_model/event_dispatch.feature (Phase
# 10), scenario 4: emit() is a MID-BLOCK instruction, not a JumpBlock --
# the statement right after it in source must still run, proving Emit
# genuinely returns control to the emitting block rather than transferring
# away from it for good the way every other jump in this engine does.

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let src = "when beep do
  print(1)
end

make a function called start returns r
  emit(\"beep\", 0)
  print(2)
  return finish()
end

make a function called finish returns r
  print(3)
end
"

let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)
bi_run(prog)
