# Driver fixture for spec_library/block_model/flight_check.feature.
# `mut_b` ARRIVES as a parameter -- flight_check.patlang's own `fresh`
# tracking never includes a parameter (a caller's own aliasing state is
# invisible to this block's local analysis, named plainly in that file's
# own header), so box_set on it always falls back to the CHECKED path
# (BoxSet, Phase 3's runtime refcount check). The counter must be > 0.
#
# Native x64 only: compile with
#   ./patc1.exe self_hosting/block_model/spec_fixtures/flight_check_fallback.patlang self_hosting/build/bm_flight_check_fallback.exe --x64

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let src = "make a function called start returns r
  let b = box_new(10)
  return use_mut(b)
end

make a function called use_mut takes mut_b returns r
  let mut_b = box_set(mut_b, 99)
  print(box_get(mut_b))
end
"

let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)
bi_run(prog)
print(bm_get_runtime_check_count())
