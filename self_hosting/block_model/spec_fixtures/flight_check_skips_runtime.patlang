# Driver fixture for spec_library/block_model/flight_check.feature.
# `b` is bound via box_new, then re-bound via box_set twice, all in a
# straight line -- flight_check.patlang's own `fresh` tracking proves
# each box_set target unique statically, so BOTH get patched to
# BoxSetUnchecked at lowering time. The runtime-check counter must stay
# at 0 -- not "low", exactly zero -- despite two real mutations having
# happened, both giving the correct final value.
#
# Native x64 only: compile with
#   ./patc1.exe self_hosting/block_model/spec_fixtures/flight_check_skips_runtime.patlang self_hosting/build/bm_flight_check_skips_runtime.exe --x64

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let src = "make a function called start returns r
  let b = box_new(10)
  let b = box_set(b, 20)
  let b = box_set(b, 30)
  print(box_get(b))
end
"

let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)
bi_run(prog)
# bm_get_runtime_check_count() is inspected from the DRIVER's own
# ordinary PatLang code, not from within the restricted program itself --
# this engine's restricted subset has no general host-function dispatch
# to call it through (lower.patlang's own header).
print(bm_get_runtime_check_count())
