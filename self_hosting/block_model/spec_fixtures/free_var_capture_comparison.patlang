# Driver fixture for spec_library/block_model/free_variable_capture.feature.
# A direct, decisive before/after comparison: Phase 5's own wholesale set
# (every name known before the `while`) vs. Phase 6's real free-variable
# analysis, on the SAME loop body -- not just "it still works", the actual
# size and membership difference the design doc's own Fork E table
# predicted (docs/plans/block-ownership-model.md, section 6).

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"

let src = "make a function called start returns r
  let total = 0
  let i = 0
  let unused_big = 999
  while i < 5 do
    let total = total + i
    let i = i + 1
  end
  print(total)
end
"

let toks = tokenize(src)
let ast = parse_program(toks)
let stmts = list_get(ast, 1)
let start_fn = list_get(stmts, 0)
let body = list_get(start_fn, 3)
let while_stmt = list_get(body, 3)
let while_body = list_get(while_stmt, 2)

let wholesale = ["total", "i", "unused_big"]
let free = bm_free_vars_of_body(while_body)
let precise = bm_intersect_preserving_order(wholesale, free)

print(list_len(wholesale))
print(list_len(precise))
print(precise)
