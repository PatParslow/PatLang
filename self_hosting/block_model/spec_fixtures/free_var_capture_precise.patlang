# Driver fixture for spec_library/block_model/free_variable_capture.feature.
# `unused_big` is bound before the loop but never referenced by its body --
# under Phase 5's own wholesale placeholder it would have been part of the
# loop head's own declared params regardless; under Phase 6's real
# free-variable analysis it must NOT be. Checked by inspecting the
# compiled loop head block's own param list directly (the `inherited`
# section's real field list), not just by running the program and
# checking output.

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let src = "make a function called start returns r
  let total = 0
  let i = 0
  let unused_big = 999
  while i < 5 do
    let total = total + i
    let i = i + 1
  end
  print(total)
end
"

let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)

let blocks = bi_program_blocks(prog)
let n = list_len(blocks)
let i = 0
while i < n do
  let blk = list_get(blocks, i)
  let bname = bi_block_name(blk)
  if (bname.length >= 11) and (substr(bname, 0, 11) == "__loop_head") then
    print(bi_block_params(blk))
  end
  let i = i + 1
end

bi_run(prog)
