# Driver fixture for spec_library/block_model/free_variable_capture
# .feature (Phase 22, seventh finding): `bm_fv_expr` (self_hosting/
# block_model/free_vars.patlang) had no case at all for "Index"
# (`obj[idx]`) or "List" (`[a, b, c]`) AST nodes -- both silently fell
# through to "no free references", meaning a loop-body variable
# referenced ONLY via indexing or ONLY inside a list literal was
# invisibly missing from EVERY caller's own captured-variable set, not
# just bm_lower_while's. Found chained through a real checkpoint:
# self_hosting/lib/list_copy.patlang's own `list_copy` (`l[i]`, `l`
# never referenced any other way in the loop body) and self_hosting/lib/
# pmap.patlang's own `pmap_put` (`list_push(out, [key, value])`,
# `value` never referenced any other way). Confirmed via minimal,
# standalone repros of both shapes, independent of either real file,
# before fixing.

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let src = "make a function called start returns r
  let xs = [10, 20, 30]
  let ys = list_copy(xs)
  print(ys[0])
  print(ys[1])
  print(ys[2])

  let m = []
  let m2 = my_put(m, \"a\", 42)
  print(my_get(m2, \"a\"))
end

make a function called list_copy takes l returns out
  let out = []
  let i = 0
  let n = to_num(list_len(l))
  while i < n do
    let out = list_push(out, l[i])
    let i = i + 1
  end
  return out
end

make a function called my_put takes m, key, value returns m2
  let out = list_copy(m)
  return list_push(out, [key, value])
end

make a function called my_get takes m, key returns v
  let i = 0
  let n = to_num(list_len(m))
  while i < n do
    if m[i][0] == key then
      return m[i][1]
    end
    let i = i + 1
  end
  return false
end
"

let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)
bi_run(prog)
