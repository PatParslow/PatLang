# Reference for spec_library/block_model/free_variable_capture.feature
# (Phase 22): the SAME source as freevar_index_and_list_literal.patlang's
# own inner `src`, run directly as an ordinary PatLang program (no block
# model at all).

make a function called start returns r
  let xs = [10, 20, 30]
  let ys = list_copy(xs)
  print(ys[0])
  print(ys[1])
  print(ys[2])

  let m = []
  let m2 = my_put(m, "a", 42)
  print(my_get(m2, "a"))
end

make a function called list_copy takes l returns out
  let out = []
  let i = 0
  let n = to_num(list_len(l))
  while i < n do
    let out = list_push(out, l[i])
    let i = i + 1
  end
  return out
end

make a function called my_put takes m, key, value returns m2
  let out = list_copy(m)
  return list_push(out, [key, value])
end

make a function called my_get takes m, key returns v
  let i = 0
  let n = to_num(list_len(m))
  while i < n do
    if m[i][0] == key then
      return m[i][1]
    end
    let i = i + 1
  end
  return false
end

start()
