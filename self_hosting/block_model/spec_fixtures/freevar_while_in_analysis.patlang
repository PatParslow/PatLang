# Driver fixture for spec_library/block_model/free_variable_capture.feature
# (GitHub issue filed with this fixture): the free-variable analysis
# (free_vars.patlang's bm_fv_stmt) had no case for a nested/later `while`
# STATEMENT (nor Assert, Match, MemberAssign), so a variable referenced only
# inside such a statement was invisible to every capture computation that
# walks past it -- "everything after this loop" and "this loop's own body"
# both skip over an inner or following while entirely.
#
# Shape A (sequential): b and rn are used only by the THIRD loop, never by
#   the first or second -- exactly self_hosting/lib/zs_expr.patlang's own
#   ze_msort merge (`while (a<ln) and (b<rn)`, `while a<ln`, `while b<rn`).
# Shape B (nested): m is used only by the INNER loop's condition, never
#   directly in the outer loop's body.

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let src = "make a function called start returns r
  seq()
  nested()
  print(777)
end

make a function called seq returns r
  let a = 0
  let b = 0
  let ln = 2
  let rn = 3
  while a < ln do
    print(a)
    let a = a + 1
  end
  while b < rn do
    print(10 + b)
    let b = b + 1
  end
  print(999)
end

make a function called nested returns r
  let m = 2
  let i = 0
  while i < 2 do
    let j = 0
    while j < m do
      print(100 * i + j)
      let j = j + 1
    end
    let i = i + 1
  end
end
"

let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)
bi_run(prog)
