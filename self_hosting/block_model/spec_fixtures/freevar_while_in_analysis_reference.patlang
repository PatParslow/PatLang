# Reference for spec_library/block_model/free_variable_capture.feature: the
# SAME source as freevar_while_in_analysis.patlang's inner `src`, run
# directly as an ordinary PatLang program.

make a function called start returns r
  seq()
  nested()
  print(777)
end

make a function called seq returns r
  let a = 0
  let b = 0
  let ln = 2
  let rn = 3
  while a < ln do
    print(a)
    let a = a + 1
  end
  while b < rn do
    print(10 + b)
    let b = b + 1
  end
  print(999)
end

make a function called nested returns r
  let m = 2
  let i = 0
  while i < 2 do
    let j = 0
    while j < m do
      print(100 * i + j)
      let j = j + 1
    end
    let i = i + 1
  end
end

start()
