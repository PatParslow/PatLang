# Driver fixture for spec_library/block_model/globals_elimination.feature.
# `start` sets a global, jumps to `middle` (which never mentions the
# global at all in its own params/body -- just passes through to `finish`),
# which reads it back. No source-level plumbing carries "__globals"
# between them -- lower.patlang's own hidden threading does it. Runs
# entirely under the interpreter: set_global/get_global never touch
# heap.patlang's native-only functions.

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let src = "make a function called start returns r
  set_global(\"counter\", 41)
  return middle()
end

make a function called middle returns r
  return finish()
end

make a function called finish returns r
  let c = get_global(\"counter\")
  print(c + 1)
end
"

let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)
bi_run(prog)
