# Reference for goap.feature (issue #177, second slice): `activate`, which runs
# the closures bound to a plan's steps, under the real engine. Patterned on
# spec_library/language/goal_pursue_activate.feature. Expected: true, then
# false (one action re-bound to fail for a specific step; activate stops there
# even though the planner still finds the same plan).

make a function called start returns r
  rule_add("bma_dep", ["bma_house", "bma_walls"], [])
  rule_add("bma_dep", ["bma_walls", "bma_foundation"], [])
  rule_add("bma_built", ["bma_foundation_base"], [])
  action_add("bma_build_from_base", [["bma_built", ["bma_foundation_base"]]], [["bma_built", ["bma_foundation"]]], [], 1)
  action_add("bma_build_from_dep", [["bma_dep", ["X", "Y"]], ["bma_built", ["Y"]]], [["bma_built", ["X"]]], [], 1)
  action_bind("bma_build_from_base", |args| { return true })
  action_bind("bma_build_from_dep", |args| { return true })
  goal bma_need_a_house {
    bma_built(bma_house)
  }
  let p = pursue bma_need_a_house
  let ok = activate p
  print(ok)
  action_bind("bma_build_from_dep", |args| {
    if args[0] == "bma_house" then
      return false
    end
    return true
  })
  let p2 = pursue bma_need_a_house
  let ok2 = activate p2
  print(ok2)
end

start()
