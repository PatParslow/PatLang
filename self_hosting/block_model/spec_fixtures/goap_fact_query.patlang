# Driver fixture for spec_library/block_model/goap.feature (Phase 15),
# scenario 1: `start` asserts a fact, then jumps to `check` (a totally
# separate block, receiving nothing about the fact through the jump) --
# `check` still finds it, since fact's own backing store is process-
# ambient, not carried by this engine's __globals threading at all.

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let src = "make a function called start returns r
  fact(\"likes\", \"alice\", \"bob\")
  return check()
end

make a function called check returns r
  print(query(\"likes\", \"alice\", \"x\"))
end
"

let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)
bi_run(prog)
