# Driver fixture for spec_library/block_model/goap.feature (GitHub issue
# #177): `rule` and `goal` DECLARATIONS plus solve/plan/pursue, through the
# block-model engine. Phase 15 (#166) covered only fact/query because rule and
# goal sugar builds compound [pred, [args...]] lists that this engine could not
# yet express; BuildList has existed since Phase 18.
#
# Deliberately NOT covered: `activate` and `action_bind`, which run CLOSURES
# bound to actions -- they need first-class closures (#175).
#
# Uses the real language's own syntax, exactly as
# spec_library/language/rule_declaration_sugar.feature and
# goal_pursue_activate.feature write it. Names are prefixed so they cannot
# collide with the language spec suite's own facts/rules/goals.

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let src = "make a function called start returns r
  rule_add(\"bmg_parent\", [\"alice\", \"bob\"], [])
  rule_add(\"bmg_parent\", [\"bob\", \"carol\"], [])
  rule bmg_grandparent(X, Z) :- bmg_parent(X, Y), bmg_parent(Y, Z).
  let sol = solve(\"bmg_grandparent\", [\"alice\", \"Z\"])
  print(list_len(sol))
  print(sol[0][1])
  rule_add(\"bmg_dep\", [\"bmg_house\", \"bmg_walls\"], [])
  rule_add(\"bmg_dep\", [\"bmg_walls\", \"bmg_foundation\"], [])
  rule_add(\"bmg_built\", [\"bmg_foundation_base\"], [])
  action_add(\"bmg_build_from_base\", [[\"bmg_built\", [\"bmg_foundation_base\"]]], [[\"bmg_built\", [\"bmg_foundation\"]]], [], 1)
  action_add(\"bmg_build_from_dep\", [[\"bmg_dep\", [\"X\", \"Y\"]], [\"bmg_built\", [\"Y\"]]], [[\"bmg_built\", [\"X\"]]], [], 1)
  goal bmg_need_a_house {
    bmg_built(bmg_house)
  }
  let p = pursue bmg_need_a_house
  print(list_len(p))
end
"

let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)
bi_run(prog)
