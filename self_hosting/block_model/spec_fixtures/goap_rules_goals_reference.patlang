# Reference for goap.feature (issue #177): the same program run directly under
# the real engine.

make a function called start returns r
  rule_add("bmg_parent", ["alice", "bob"], [])
  rule_add("bmg_parent", ["bob", "carol"], [])
  rule bmg_grandparent(X, Z) :- bmg_parent(X, Y), bmg_parent(Y, Z).
  let sol = solve("bmg_grandparent", ["alice", "Z"])
  print(list_len(sol))
  print(sol[0][1])
  rule_add("bmg_dep", ["bmg_house", "bmg_walls"], [])
  rule_add("bmg_dep", ["bmg_walls", "bmg_foundation"], [])
  rule_add("bmg_built", ["bmg_foundation_base"], [])
  action_add("bmg_build_from_base", [["bmg_built", ["bmg_foundation_base"]]], [["bmg_built", ["bmg_foundation"]]], [], 1)
  action_add("bmg_build_from_dep", [["bmg_dep", ["X", "Y"]], ["bmg_built", ["Y"]]], [["bmg_built", ["X"]]], [], 1)
  goal bmg_need_a_house {
    bmg_built(bmg_house)
  }
  let p = pursue bmg_need_a_house
  print(list_len(p))
end

start()
