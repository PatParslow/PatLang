# Driver fixture for spec_library/block_model/mut_parameters.feature.
# `b` (no `mut_` prefix) is read-only: box_set on it must be a guaranteed-
# fail contract violation at the point it's reached, matching section
# 3.4's own original template (a runtime check, not a compile-time
# reject -- see lower.patlang's own header on box_set's mut-check).
#
# Native x64 only: compile with
#   ./patc1.exe self_hosting/block_model/spec_fixtures/immut_param_rejected.patlang self_hosting/build/bm_immut_param_rejected.exe --x64

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let src = "make a function called start returns r
  let b = box_new(10)
  return use_immut(b)
end

make a function called use_immut takes b returns r
  let b = box_set(b, 99)
  print(box_get(b))
end
"

let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)
bi_run(prog)
