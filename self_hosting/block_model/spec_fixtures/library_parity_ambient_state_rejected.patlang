# Driver fixture for spec_library/block_model/library_parity.feature
# (Phase 18, regression added while porting zs_schema.patlang off
# new("Dict", ...) in Phase 21/22's own investigation): `set_var`/`get`/
# `send`, called in VALUE context, reach genuine, process-wide ambient
# state via the generic CallHost fallback's own interp_call_host
# dispatcher -- a real, previously-undisclosed leak, since Fork B's own
# design (docs/plans/block-ownership-model.md section 6) eliminates
# ambient state from this engine entirely. Confirmed exploitable via a
# direct repro before fixing it, not assumed. This fixture is expected
# to FAIL with a guaranteed contract violation, not run to completion.

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let src = "make a function called start returns r
  let x = set_var(\"leaked_ambient_key\", 42)
  print(get(\"__vars\", \"leaked_ambient_key\"))
end
"

let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)
bi_run(prog)
