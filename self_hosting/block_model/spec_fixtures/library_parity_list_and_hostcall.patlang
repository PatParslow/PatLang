# Driver fixture for spec_library/block_model/library_parity.feature
# (Phase 18): a List literal, indexing, list_len/list_push (never
# individually recognized by name anywhere in lower.patlang), and
# hash_string (a genuine stateless-chunk host function) all run through
# bm_lower_program/bi_run -- the two named-but-deferred Phase 17 gaps
# ("generic host-call dispatch" and "list-literal/BuildList support")
# this phase fills in.

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let src = "make a function called start returns r
  let xs = [10, 20, 30]
  print(xs[1])
  print(list_len(xs))
  let ys = list_push(xs, 40)
  print(list_len(ys))
  print(hash_string(\"abc\"))
end
"

let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)
bi_run(prog)
