# Driver fixture for spec_library/block_model/library_parity.feature:
# Phase 18's own original checkpoint, as far as LOWERING goes.
# self_hosting/lib/zs_schema.patlang -- real, unmodified library code (after
# the get_global/set_global/handler_* port, verified against zero regressions
# in every real-engine suite that exercises it) -- lowers completely through
# bm_lower_program, with no unsupported construct left anywhere in it.
#
# WITH ITS INCLUDES EXPANDED. An earlier version of this fixture lowered the
# raw file, whose `include "..."` lines the self-hosted parser turns into a
# bare `include` expression plus a stray string and bm_lower_program silently
# dropped -- so "zs_schema.patlang lowers completely" never exercised a single
# line of the libraries it includes (zs_expr, pset, pmap, list_copy,
# block_model_compat, ...). The claim was true of the file's own text and
# nothing more. Top-level statement support (issue #155) turned that silence
# into a loud failure, which is how this was found; the fixture now expands
# the includes first (self_hosting/lib/includes.patlang's own expand_includes,
# resolving relative to the including file's directory, exactly as
# preprocess.rs does), so the claim covers the whole include closure.

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../../lib/includes.patlang"
include "../lower.patlang"

let raw = read_file("self_hosting/lib/zs_schema.patlang")
let src = expand_includes(raw, "self_hosting/lib")
let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)
print("zs_schema.patlang lowered completely")
