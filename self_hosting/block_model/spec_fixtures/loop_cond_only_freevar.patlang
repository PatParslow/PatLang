# Driver fixture for spec_library/block_model/loop_blocks.feature (Phase
# 22, fifth finding): a variable referenced ONLY in a while loop's own
# CONDITION, never inside the loop's own body -- `bm_lower_while`'s own
# captured-variable computation only ever scanned body_stmts
# (bm_free_vars_of_body(body_stmts)), never the condition expression
# itself, even though the head block re-evaluates that condition on
# EVERY iteration. Found while re-attempting Phase 18's own checkpoint
# one level further out (self_hosting/lib/test.patlang's own run_feature:
# `let n = sc_len(h); while i <= n do ... end`, `n` never referenced
# again inside the loop body). Confirmed via this minimal, standalone
# repro before fixing: crashed with "unbound in this block's own
# pointer: n".

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let src = "make a function called start returns r
  let n = 3
  let i = 0
  while i < n do
    print(i)
    let i = i + 1
  end
  print(999)
end
"

let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)
bi_run(prog)
