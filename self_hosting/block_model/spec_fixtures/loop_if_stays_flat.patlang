# Driver fixture for spec_library/block_model/loop_blocks.feature.
# An ordinary if/else inside a loop body needs no extra block boundary
# (section 4.1) -- this just confirms Phase 2's own already-flat if/else
# handling keeps working unchanged when nested inside a synthesized loop
# head block instead of an ordinary function block.

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let src = "make a function called start returns r
  let i = 0
  let evens = 0
  while i < 6 do
    if i % 2 == 0 then
      let evens = evens + 1
    end
    let i = i + 1
  end
  print(evens)
end
"

let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)
bi_run(prog)
