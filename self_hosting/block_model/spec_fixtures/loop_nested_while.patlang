# Driver fixture for spec_library/block_model/loop_blocks.feature
# (regression added in Phase 22): a `while` nested inside an `if`,
# itself inside another `while` -- block-model's own Phase 5 only ever
# supported `while` at a function's own top level; a nested one used to
# hit "does not support: statement shape 'While'" outright.
#
# Also exercises the real, pre-existing bug found and fixed proving this
# (unrelated to the new `if`-nesting case): a value referenced only
# AFTER a loop, never inside its own body (here, `total`, read by
# `print(total)` once the outer loop finishes, but only ever WRITTEN
# inside the nested inner while) -- the outer loop's own exit path used
# to be built from the loop BODY's own free variables alone, which never
# included anything used only afterward, crashing with "unbound in this
# block's own pointer" the moment such a value was actually read.

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let src = "make a function called start returns r
  let i = 0
  let total = 0
  while i < 5 do
    if i > 2 then
      let j = 0
      while j < i do
        let total = total + 1
        let j = j + 1
      end
    end
    let i = i + 1
  end
  print(total)
end
"

let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)
bi_run(prog)
