# Driver fixture for spec_library/block_model/loop_blocks.feature.
# `bonus` is set before the loop and never reassigned by it -- not part of
# the loop's own "accumulator" (total/i), but still visible on every
# iteration via wholesale capture (section 4.1). Runs under the
# interpreter (no Box involved).

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let src = "make a function called start returns r
  let total = 0
  let i = 0
  let bonus = 100
  while i < 5 do
    let total = total + i + bonus
    let i = i + 1
  end
  print(total)
end
"

let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)
bi_run(prog)
