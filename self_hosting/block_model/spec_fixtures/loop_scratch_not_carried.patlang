# Driver fixture for spec_library/block_model/loop_blocks.feature.
# `scratch` is declared INSIDE the loop body, so it is NOT part of the
# wholesale-captured set (only names known before the `while` are) -- a
# fresh, empty locals set on every jump back into the loop head means it
# genuinely cannot survive to the next iteration (section 4.2), not just
# by convention. If it wrongly persisted and accumulated instead, this
# would print 6, not 3.

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let src = "make a function called start returns r
  let count = 0
  let seen_flag = 0
  while count < 3 do
    let scratch = 0
    let scratch = scratch + 1
    let seen_flag = seen_flag + scratch
    let count = count + 1
  end
  print(seen_flag)
end
"

let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)
bi_run(prog)
