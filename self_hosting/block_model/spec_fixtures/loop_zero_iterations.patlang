# Edge-case check for the loop-lowering restructure: a condition false
# from the very first check must jump straight to the exit block without
# ever running the body once.

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let src = "make a function called start returns r
  let count = 0
  while count > 100 do
    let count = count + 1
  end
  print(count)
end
"

let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)
bi_run(prog)
