# Driver fixture for spec_library/block_model/pattern_matching.feature
# (Phase 11), scenario 4: a bind-and-guard arm ("case n when n > 100 then
# ...") whose guard fails must fall through to the plain bind fallback
# arm, not run its own body -- proving pattern bindings are available to
# the guard expression (n is bound before the guard is evaluated) and that
# a false guard genuinely continues to the NEXT arm rather than aborting.

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let src = "make a function called start returns r
  let x = 5
  match x do
  case n when n > 100 then
    print(999)
  case n then
    print(n + 1)
  end
end
"

let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)
bi_run(prog)
