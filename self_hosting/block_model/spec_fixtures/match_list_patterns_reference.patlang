# Reference for spec_library/block_model/pattern_matching.feature (GitHub #180): list
# patterns in match/case -- an empty list, a list with a literal and a binding, a
# list with a literal and two bindings -- and the arms that fall through. Run
# unchanged under the real engine and through the block-model engine.

make a function called classify takes v returns r
  match v do
    case [] then
      return "empty"
    case [1, x] then
      return "one-then-" + x
    case ["a", b, c] then
      return "abc:" + b + c
    case "hi*" then
      return "glob-hi"
    case _ then
      return "other"
  end
end
print(classify([]))
print(classify([1, "z"]))
print(classify(["a", 8, 9]))
print(classify("hello"))
print(classify("hi there"))
print(classify(42))
