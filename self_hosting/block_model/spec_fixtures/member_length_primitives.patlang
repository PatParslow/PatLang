# Driver fixture for spec_library/block_model/library_parity.feature
# (Phase 22, second finding): `.length`/`.len` on an ordinary String or
# List value -- found crashing while re-verifying self_hosting/lib/
# schema_bdd_selftest.patlang with real include expansion. bm_lower_expr's
# own "Member" case (obj.prop) unconditionally assumed the receiver is a
# Box-wrapped Handler-shaped object (Phase 13's own class-field-access
# representation), routing EVERY `.prop` through BoxGet+HandlerLookup --
# wrong for a raw String/List, and BoxGet is native-x64-only besides
# (heap.patlang's own bm_box_read calls mem_peek_qword directly, not
# implemented under the interpreter at all). Fixed by mirroring the REAL
# self-hosted lower.patlang's own Member case exactly (that file's own
# lower_expr, `ty == "Member"` arm): `.length`/`.len` lowers straight to
# `CallHost "len"` -- a genuine, already-"feature complete" host function
# that works correctly under BOTH backends -- with BoxGet+HandlerLookup
# reserved for every OTHER property name (genuine object field access).

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let src = "make a function called start returns r
  let s = \"hello\"
  print(s.length)
  let xs = [10, 20, 30]
  print(xs.length)
end
"

let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)
bi_run(prog)
