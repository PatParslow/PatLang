# Reference for spec_library/block_model/class_methods.feature (GitHub #180):
# method-call syntax on an ad hoc named object (no class declared) and on a
# value with a built-in method, once as an expression and once as a statement.
# Run unchanged under the real engine and through the block-model engine.

new("Thing", "t1")
let t = "t1"
t.set("k", 7)
print(get("t1", "k"))
print(t.to_s())
t.set("k", 8)
print(get("t1", "k"))
