# Driver fixture for spec_library/block_model/mut_parameters.feature.
# box_share makes `alias` a second live reference to the SAME cell as
# `mut_b` (refcount 2). box_set on mut_b at refcount 2 must clone rather
# than mutate in place -- checked three ways: the result pointer differs
# from the original, the alias still reads the ORIGINAL value, and mut_b
# itself reads the NEW value.
#
# Native x64 only: compile with
#   ./patc1.exe self_hosting/block_model/spec_fixtures/mut_param_clone_on_alias.patlang self_hosting/build/bm_mut_param_clone_on_alias.exe --x64

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let src = "make a function called start returns r
  let b = box_new(10)
  return use_alias(b)
end

make a function called use_alias takes mut_b returns r
  let alias = box_share(mut_b)
  let mut_b = box_set(mut_b, 99)
  print(mut_b == alias)
  print(box_get(alias))
  print(box_get(mut_b))
end
"

let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)
bi_run(prog)
