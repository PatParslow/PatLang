# Driver fixture for spec_library/block_model/named_objects.feature (GitHub
# issue #178). Same program as named_objects_reference.patlang.

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let src = "
make a function called start returns r
  new(\"SignalProxy\", \"george\")
  send(\"george\", \"set\", \"port\", 8080)
  send(\"george\", \"set\", \"actions\", [\"status\", \"quit\"])
  print(get(\"george\", \"port\"))
  print(get(\"george\", \"actions\"))
  set_var(\"greeting\", \"hello\")
  print(get(\"__vars\", \"greeting\"))
  new(\"SignalProxy\", \"harriet\")
  send(\"harriet\", \"set\", \"port\", 9090)
  print(get(\"george\", \"port\") + get(\"harriet\", \"port\"))
  print(type_of(get(\"george\", \"never_set\")))
end
"

let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)
bi_run(prog)
