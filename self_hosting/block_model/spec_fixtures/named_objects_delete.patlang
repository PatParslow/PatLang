# Driver fixture for spec_library/block_model/named_objects.feature (GitHub
# issue #179). Same program as named_objects_delete_reference.patlang.

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let src = "
make a function called start returns r
  new(\"Dict\", \"scratch_set\")
  send(\"scratch_set\", \"set\", \"k\", 1)
  print(get(\"scratch_set\", \"k\"))
  print(object_delete(\"scratch_set\"))
  print(type_of(get(\"scratch_set\", \"k\")))
end
"

let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)
bi_run(prog)
