# Given every binary operator the parser produces (+ - * / % == != < <= > >=
#   band bor bxor shl shr) and every unary one (- not bnot), applied to
#   function parameters so nothing is folded at compile time,
# When the program is run by pati and built natively,
# Then both print what pat --ir-run prints. The operators are named by one
# table (block_ir.patlang's bm_bin_op_name/bm_un_op_name), so neither
# pathway can lack one the other has, or quietly treat an unknown one as `+`.
make a function called bins takes a, b returns xs
  return [a + b, a - b, a * b, a / b, a % b, a == b, a != b, a < b, a <= b, a > b, a >= b, a band b, a bor b, a bxor b, a shl b, a shr b]
end
make a function called uns takes a, t returns xs
  return [0 - a, -a, not t, bnot a]
end
print(bins(7, 2))
print(bins(-12, 3))
print(uns(5, true))
