# Given arguments holding embedded double quotes, backslashes, spaces and
# an empty argument,
# When built natively and run with them,
# Then argv() returns each one intact, as interpreted -- Windows passes one
# command line, and argv() must undo its quoting by the standard rules
# (2n backslashes + quote: n backslashes and a quote mark; 2n+1: n and a
# literal quote; other backslashes literal). A plain quote-to-quote scan
# split 'x "q" y' into three broken pieces.
let a = argv()
let k = 0
while k < a.length do
  print("[" + a[k] + "]")
  let k = k + 1
end
