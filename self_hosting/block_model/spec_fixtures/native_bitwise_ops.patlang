# Fixture for native_codegen.feature (GitHub #180): the bitwise Bin operators
# (band, bor, bxor, shl, shr) parse to plain Bin nodes, same as +/-, but were
# missing from bm_nc_bin_op_string's hash table. Expected: 8, 14, 6, 48, 6.

let a = 12
let b = 10
print(a band b)
print(a bor b)
print(a bxor b)
print(a shl 2)
print(a shr 1)
