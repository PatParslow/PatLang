# Given a list built from elements read out of another list (`[c[0], c[2]]`,
# `list_push(ys, c[1])`), and the old list then released (replaced in a vec
# by vec_set, or reassigned),
# When it is built natively and run,
# Then the new list's elements are still intact, as interpreted: an element
# read with list_get is a borrow, and storing it in a new list takes a
# reference of its own (raytrace scene_build's camera row lost its points).
make a function called mk takes n returns xs
  let xs = []
  let k = 0
  while k < n do
    let xs = list_push(xs, [k, k + 1])
    let k = k + 1
  end
  return xs
end

make a function called via_vec_set returns r
  let ctx = vec_new(2)
  vec_push(ctx, mk(3))
  let c = vec_get(ctx, 0)
  vec_set(ctx, 0, [c[0], c[2], 9])
  let junk = mk(5)
  return vec_get(ctx, 0)
end

make a function called via_push returns r
  let ctx = vec_new(2)
  vec_push(ctx, mk(3))
  let c = vec_get(ctx, 0)
  let ys = list_push([], c[1])
  vec_set(ctx, 0, 0)
  let junk = mk(5)
  return ys
end

print(via_vec_set())
print(via_push())
