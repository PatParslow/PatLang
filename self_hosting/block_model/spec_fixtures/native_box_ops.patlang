# Fixture for spec_library/block_model/native_codegen.feature (Phase 19).
# BoxNew/BoxGet/BoxSet/BoxShare round-trip through REAL native codegen,
# linked against the new heap_chunk.obj third chunk (see
# tools/build_heap_chunk.patlang). Mirrors flight_check's own interpreted
# fixtures (spec_fixtures/flight_check_*.patlang) but through the native
# x64 path instead of bi_run.

make a function called start returns r
  # Straight-line box_set chain: lower.patlang's own flight check proves
  # both mutations statically unique (b is never shared), patching BOTH
  # to BoxSetUnchecked -- exercises bm_nc_emit_box_set's own
  # unchecked=true branch (always mutate in place, no
  # bm_rc_touch_for_mutation call at all).
  let b = box_new(10)
  let b = box_set(b, 20)
  let b = box_set(b, 30)
  print(box_get(b))

  # box_share makes a second live reference, invalidating flight_check's
  # own freshness proof for the very next box_set on d -- exercises
  # bm_nc_emit_box_set's own unchecked=false (checked) branch for real,
  # taking the CLONE path since the refcount is now 2: mutating d must
  # NOT be visible through e, matching Fork C/3.5's own COW contract.
  let d = box_new(100)
  let e = box_share(d)
  let d = box_set(d, 999)
  print(box_get(d))
  print(box_get(e))
end
