# Fixture for native_codegen.feature: box_new/box_get/box_set now work
# through the ORDINARY ./patc1.exe --x64 CLI path, not just block-model's
# own test tooling (build_native.patlang/build_and_run_native.sh). Before
# docs/plans/general-refcounting.md's own Phase 1 prerequisite, this
# failed outright with "LINK ERROR: undefined symbol 'bm_heap_init'" --
# heap.patlang's own functions were never linked into an ordinary --x64
# build at all. Folding heap.patlang's source into build_x64_runtime.
# patlang's own compile (so bm_alloc/bm_rc_*/bm_heap_init become part of
# x64_runtime.obj, already linked into every program) fixed this for
# free. Built directly with `./patc1.exe <this file> <out>.exe --x64`,
# unlike this directory's other fixtures (which go through build_and_
# run_native.sh specifically to exercise block-model's own separate
# lowering/codegen path) -- the CLI path itself is exactly what's under
# test here.

let b = box_new(0)
let n = 200000
let i = 0
while i < n do
  let b = box_set(b, box_get(b) + 1)
  let i = i + 1
end
print("final=" + box_get(b))
