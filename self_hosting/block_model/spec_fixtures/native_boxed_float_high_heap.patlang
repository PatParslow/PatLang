# Given a heap grown past 0x150000000 (a 268MB string, built by doubling),
# When floor() and a bitwise op meet a boxed Float allocated there,
# Then they read it as the Float it is, as interpreted. The check that a
# tagged word's payload is a real pointer before unboxing it (the shift and
# mask coercion, #102) accepted [0x140000000, 0x150000000) as the image and
# skipped the heap test for anything above it, so a box allocated past
# 0x150000000 was taken for an int: floor's tag test read the bare Float tag,
# and unboxing that dereferenced address 0 (raytrace ch34, a large tree).
make a function called half takes x returns y
  return x / 2.0
end
let b = sb_new()
sb_push(b, "ab")
let k = 0
while k < 27 do
  sb_push(b, sb_str(b))
  let k = k + 1
end
print(sb_str(b).length)
let v = half(7)
print(floor(v))
print(v band 255)
