# Given a loop whose if/elif branches each store a fresh result in a local
# of their own (raytrace's interval evaluator, fa_run: `let m = ia_mul(...)`
# in one branch, `let m = ia_pow(...)` in another),
# When built natively and run,
# Then the sums are the interpreter's and the heap stays flat. A store in
# one branch dominates no exit of the loop body, so the value was never
# released; the local now starts at 0 on entry to the body, so every exit
# and every reassignment sees a value the body owns.
make a function called hu returns n
  return mem_peek_qword(mem_heap_state_addr(), 0)
end
make a function called pair takes a, b returns p
  return [a, b]
end
make a function called run takes n returns total
  let total = 0
  let i = 0
  while i < n do
    let op = i % 3
    if op == 0 then
      let m = pair(i, 1)
      let total = total + m[0]
    elif op == 1 then
      let m = pair(i, 2)
      let total = total + m[1]
    else
      let w = pair(1, i)
      let total = total + w[1]
    end
    let i = i + 1
  end
  return total
end
let warm = run(90)
let h = hu()
print(run(30000))
print("branch locals bytes/iter under 8: " + (((hu() - h) / 30000) < 8))
