# Given a `budgeted(ms) { ... }` block that finishes inside a generous
#   budget, and one with a zero budget resumed from its handle until done,
#   in a function and at the top level,
# When built natively,
# Then it prints what the interpreter prints: the first block is "done"
#   with its value, the zero-budget block gives the same value after
#   pausing once per loop iteration, and the top-level block's value
#   reaches an object field.
# The native backend had no bm_budgeted_run, so any program using
# budgeted() failed to build ("unsupported primitive: bm_budgeted_run").
class Tally {
  field total = 0
}

make a function called start returns r
  let n = 5
  let r1 = budgeted(1000000) {
    let t = 0
    let i = 0
    while i < n do
      let t = t + i
      let i = i + 1
    end
    return t
  }
  print(r1[0])
  print(r1[1])
  let h = false
  let pauses = 0
  let fin = false
  let out = 0
  while not fin do
    let r2 = budgeted(0, h) {
      let t = 0
      let i = 0
      while i < n do
        let t = t + i
        let i = i + 1
      end
      return t
    }
    if r2[0] == "done" then
      let fin = true
      let out = r2[1]
    else
      let h = r2[1]
      let pauses = pauses + 1
    end
  end
  print(out)
  print(pauses)
  return out
end

start()
new("Tally", "tally")
let r3 = budgeted(1000000) {
  let k = 0
  while k < 4 do
    send("tally", "set", "total", get("tally", "total") + k)
    let k = k + 1
  end
  return k
}
print(r3[0] + " " + r3[1] + " " + get("tally", "total"))
