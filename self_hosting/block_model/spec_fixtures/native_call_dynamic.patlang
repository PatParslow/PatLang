# Fixture for native_codegen.feature (issue #173): apply() with a
# runtime-computed callee name and arguments, in value and bare-statement
# context, dispatched by a native rt_str_eq chain. Expected: 7, then 10 20
# (the bare-statement call), then 0 (zero-argument, value context).

make a function called start returns r
  let sum = apply("add2", 3, 4)
  print(sum)
  apply("show2", 10, 20)
  print(apply("zero"))
end

make a function called add2 takes x, y returns r
  return x + y
end

make a function called show2 takes a, b returns r
  print(a)
  print(b)
  return true
end

make a function called zero returns r
  return 0
end
