# Closure calls through the shared per-arity dispatcher: one and two
# supplied arguments, a closure declaring more parameters than a call
# supplies (the extra is passed as unit and never read), a captured value,
# continuation-passing recursion, and a closure call made from main, from
# a loop body and from a function.
fn apply1(k, x) {
  return k(x)
}

fn apply2(k, x, y) {
  return k(x, y)
}

fn count_down(n, k) {
  if n == 0 {
    return k(0)
  }
  return count_down(n - 1, |acc| { return k(acc + n) })
}

let offset = 100
let add_offset = |v| { return v + offset }
let mul = |a, b| { return a * b }
let first_only = |a, unused| { return a + 1 }

print("a=" + apply1(add_offset, 5))
print("b=" + apply2(mul, 6, 7))
print("c=" + apply1(first_only, 41))
print("d=" + count_down(10, |r| { return r }))
let mut total = 0
let mut i = 0
while i < 5 {
  total = total + mul(i, 2)
  i = i + 1
}
print("e=" + total)
