# Fixture for native_codegen.feature (issue #173): the callee's own final
# __globals must come back through the native Call and become the CALLER's
# globals -- Fork B's threading across a real call boundary. Expected: 101
# then 42 (counter 40, bumped by 2 inside the callee).

make a function called start returns r
  set_global("counter", 40)
  let v = bump(1)
  print(v)
  print(get_global("counter"))
end

make a function called bump takes n returns r
  set_global("counter", get_global("counter") + 2)
  return n + 100
end
