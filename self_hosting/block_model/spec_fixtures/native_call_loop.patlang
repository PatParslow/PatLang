# Fixture for native_codegen.feature (issue #173): a callee containing a
# while loop, so its `return t` executes in a SYNTHESIZED loop-exit block,
# not the function's entry block -- the returned globals must come from
# THAT block's own locals, and every block in the callee must end with an
# explicit halt rather than falling into the next block of the flattened
# array. Expected: 10 (0+1+2+3+4) then 99.

make a function called start returns r
  print(sum_to(5))
  print(99)
end

make a function called sum_to takes n returns r
  let t = 0
  let i = 0
  while i < n do
    let t = t + i
    let i = i + 1
  end
  return t
end
