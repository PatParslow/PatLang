# Fixture for native_codegen.feature: distinguishes functions that never
# touch __globals (should compile through a fast call path with no
# [value, globals] heap-list wrap/unpack at all) from ones that do
# (correctness-preserving fallback, unchanged). Covers the transitive
# case too: `relay` never touches a global directly, but calls `bumper`,
# which does -- `relay` must be classified impure right along with it,
# not treated as pure just because its OWN body looks clean.
#
# Expected output: 8 (double(3)+2), 120 (fact_r(5)), 142 (relay(1): bumper
# sets counter to 40+1=41 and returns 41, relay returns 1+100+41=142),
# then 41 (the global, confirming relay's call to the impure bumper
# still threaded __globals correctly).

make a function called start returns r
  print(double(3) + 2)
  print(fact_r(5))
  set_global("counter", 40)
  print(relay(1))
  print(get_global("counter"))
end

# Pure: no global access anywhere in its own body or anything it calls.
make a function called double takes n returns r
  return n * 2
end

# Pure, recursive: same reasoning, one level of self-recursion.
make a function called fact_r takes n returns r
  if n <= 1 then
    return 1
  end
  return n * fact_r(n - 1)
end

# Looks pure in its OWN body, but calls bumper -- must be classified
# impure transitively, not just by its own direct instructions.
make a function called relay takes n returns r
  let b = bumper(n)
  return n + 100 + b
end

# Genuinely impure: touches __globals directly.
make a function called bumper takes n returns r
  set_global("counter", get_global("counter") + 1)
  return get_global("counter")
end
