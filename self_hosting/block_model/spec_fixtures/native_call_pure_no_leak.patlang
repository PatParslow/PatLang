# Fixture for native_codegen.feature, issue #216 (follow-up to #215): a
# single-block pure function (no if/while of its own, so no internal
# JumpBlock exists to ever thread __globals between) must compile with NO
# per-call heap allocation at all -- the entry seed ([BuildList, 0] +
# [Store, ..._globals]) that #215's own fix unconditionally injected for
# every pure function was dead weight here (nothing inside a single-block
# closure can ever reference it), and was costing a REAL, unreclaimed
# rt_heap_alloc(64) on every single call. Found verifying
# docs/plans/general-refcounting.md's own foundational assumption that the
# existing refcounted heap's "many alloc+drop cycles stay flat" guarantee
# (self_hosting/block_model/refcounted_heap_native_check.patlang) still
# held -- it didn't, and this is why.
#
# bump(n) is deliberately branch-free (no if/while), so it has exactly one
# block in its own closure -- the provably-dead case this fix targets.
# Calling it LOOP_COUNT times and checking the real heap's own bump-pointer
# high-water mark (mem_heap_state_addr(), the same raw signal
# heap.patlang's own bm_bytes_bumped() reads) stays EXACTLY flat is a
# direct, zero-tolerance proof -- not "much smaller," genuinely zero.

make a function called bump takes n returns r
  let r = n + 1
  return r
end

let loop_count = 2000
let before = mem_peek_qword(mem_heap_state_addr(), 0)
let i = 0
let total = 0
while i < loop_count do
  let total = bump(total)
  let i = i + 1
end
let after = mem_peek_qword(mem_heap_state_addr(), 0)

print("total= " + total + " growth= " + (after - before))
