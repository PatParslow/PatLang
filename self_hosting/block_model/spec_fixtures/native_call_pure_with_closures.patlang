# Given a program with pure functions that also has closures and an event
#   handler,
# When it is built natively,
# Then its pure functions are still called without the globals wrapper,
#   from top-level code, from closure bodies, from a handler and through
#   apply.
# Closures and events used to switch the pure-function analysis off for the
# whole program, so every call paid for threading __globals.
#
# Expected output: 8 16 120 18 22 10. The check script also requires every
# `call bm_fn_double` in the generated asm to pop exactly one argument (no
# __globals).

make a function called double takes n returns r
  return n * 2
end

make a function called fact_r takes n returns r
  if n <= 1 then
    return 1
  end
  return n * fact_r(n - 1)
end

when ping do
  print(double(event_data))
end

print(double(3) + 2)
let twice = |x| do
  return double(double(x))
end
print(twice(4))
print(fact_r(5))
let add = |a, b| do
  return double(a) + b
end
print(add(7, 4))
print(apply("double", 11))
emit("ping", 5)
