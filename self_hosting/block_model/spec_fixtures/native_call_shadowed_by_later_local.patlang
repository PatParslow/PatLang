# Given a function that calls the top-level function `world()` and later
# in the same body declares a local named `world`,
# When it is built natively and run,
# Then `world()` calls the function, as interpreted, rather than calling
# through the not-yet-assigned local of the same name (the raytrace scene
# language's scene_build_lines segfaulted on exactly this).
make a function called world returns w
  return [[], false, true]
end

make a function called build takes n returns result
  let w0 = world()
  let world = [n, w0[2]]
  return world
end

print(build(5))
print(build(6)[0])
