# Fixture for spec_library/block_model/native_codegen.feature (issue #173):
# a declared function called AS A VALUE, including direct recursion, built
# through the REAL native path (tools/build_and_run_native.sh) -- the
# native twin of call_with_return.patlang's interpreter scenarios.
# Expected: 11 then 120.

make a function called start returns r
  let x = double(5) + 1
  print(x)
  print(fact_r(5))
end

make a function called double takes n returns r
  return n * 2
end

make a function called fact_r takes n returns r
  if n <= 1 then
    return 1
  end
  return n * fact_r(n - 1)
end
