# Given a loop that slices a string into one-character pieces, in a program
#   that also contains an unrelated closure literal,
# When it is built natively and called 2000 times,
# Then the heap does not grow. The family ownership pass used to be skipped
# for every function of a program with any closure in it, so this loop kept
# each piece (2880 bytes a call), and the native interpreter, which is full
# of closures, used 29 GB writing out the compiler's source bundle.
make a function called hu returns n
  return mem_peek_qword(mem_heap_state_addr(), 0)
end
make a function called scan takes s returns n
  let n = 0
  let i = 0
  while i < s.length do
    let c = substr(s, i, 1)
    let parts = [c, i]
    if c == "a" then
      let n = n + 1
    end
    let i = i + 1
  end
  return n
end
let s = "banana bandana " + "abcabcabc"
let w = scan(s)
let h = hu()
let k = 0
let tot = 0
while k < 2000 do
  let tot = tot + scan(s)
  let k = k + 1
end
print(tot)
print("bytes/iter " + ((hu() - h) / 2000))
let clo = |x| do
  return x
end
print(clo(1))
