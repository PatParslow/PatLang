# Given a string joined with an int, a float, a bool, a list, a rational and
#   Unit, on either side,
# When built natively,
# Then each result is the interpreter's, and 2000 rounds of joining a
#   string with an int leave the heap where it was.
# "+" turns the non-string operand into text before concatenating; that
# text was never released, so every `"..." + n` kept its number's text
# (24 bytes a call).
make a function called hu returns n
  return mem_peek_qword(mem_heap_state_addr(), 0)
end
make a function called mk takes i returns n
  let t = "v" + i
  let u = i + "w"
  return t.length + u.length
end
print("n=" + 42 + " " + 7 + "=n")
print("f=" + 1.5)
print("b=" + true + " " + false + "=b")
print("l=" + [1, 2] + " " + [3] + "=l")
print("r=" + (1 / 3))
print("u=" + print("") + "=u")
let w = mk(0)
let h = hu()
let k = 0
let tot = 0
while k < 2000 do
  let tot = tot + mk(k)
  let k = k + 1
end
print(tot)
print("bytes/iter under 8: " + (((hu() - h) / 2000) < 8))
