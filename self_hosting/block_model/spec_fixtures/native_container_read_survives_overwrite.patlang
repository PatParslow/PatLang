# Given a string read out of a vec slot (vec_get) or a __vars slot (get),
# When built natively and that slot is overwritten, the heap is reused, and
# the string read is used (or stored back),
# Then it is still the string it was, as interpreted. The slot gave up its
# reference on overwrite but the read never took one, so the string was
# freed under the local still naming it (raytrace ch37: a scene's directory,
# saved across an include, read back empty and its textures were not found).
make a function called dir_of takes path returns dir
  let last = -1
  let k = 0
  while k < path.length do
    let c = char_code(path, k)
    if c == 47 or c == 92 then
      let last = k
    end
    let k = k + 1
  end
  if last < 0 then
    return ""
  end
  let sb = sb_new()
  let k = 0
  while k < last do
    sb_push(sb, chr(char_code(path, k)))
    let k = k + 1
  end
  return sb_str(sb)
end
make a function called nest takes ctx, name returns done
  let here = vec_get(ctx, 0)
  let path = here + "/" + name
  vec_set(ctx, 0, dir_of(path))
  let junk = []
  let k = 0
  while k < 50 do
    let junk = list_push(junk, "s" + k)
    let k = k + 1
  end
  vec_set(ctx, 0, here)
  return true
end
let ctx = vec_new()
vec_push(ctx, dir_of("scenes/pond_garden.scene"))
print("[" + vec_get(ctx, 0) + "]")
nest(ctx, "parts/tree_parts.scene")
print("[" + vec_get(ctx, 0) + "]")
set_var("k", dir_of("a/b/c"))
let x = get("__vars", "k")
set_var("k", dir_of("zz/y"))
let junk = []
let j = 0
while j < 50 do
  let junk = list_push(junk, "t" + j)
  let j = j + 1
end
print("[" + x + "]")
