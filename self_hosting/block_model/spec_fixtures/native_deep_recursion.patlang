# Given a function that recurses 100000 calls deep, not as a tail call,
#   with a few locals per frame and a global read (so it is not pure),
# When built natively,
# Then it returns the interpreter's answer instead of overflowing the stack.
# Native executables reserved a 1 MB stack, where the interpreter and the
# Rust-built compiler run on 256 MB; the native compiler overflowed
# lowering one 118-branch elif chain while compiling itself.
class Cfg {
  field step = 0
}
make a function called depth takes n, acc returns r
  if n == 0 then
    return acc
  end
  let a = n % 7
  let b = acc + a + get("cfg", "step")
  let r = depth(n - 1, b)
  return r + 0
end
new("Cfg", "cfg")
print(depth(100000, 0))
