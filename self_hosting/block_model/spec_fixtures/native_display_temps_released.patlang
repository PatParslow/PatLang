# Given a loop that turns a list into text with `+`, pushes a list into a
#   string builder, formats a number into a string, and runs exec_capture,
# When it runs 2000 times natively,
# Then every result matches the interpreter's and the heap does not grow
#   with the number of runs.
# The runtime made each display string, command line and argument array as
# a temporary of its own and kept them: it was compiled without the
# ownership passes (docs/plans/general-refcounting.md, Phase 7), so a list
# shown as text left 168 bytes behind and an exec_capture 960.
make a function called hu returns n
  return mem_peek_qword(mem_heap_state_addr(), 0)
end

make a function called show takes k returns out
  let b = sb_new()
  sb_push(b, [k, k + 1])
  sb_push(b, " ")
  return sb_str(b) + " " + ("" + [k, "s"]) + " " + (k / 3)
end

make a function called run takes n returns last
  let last = ""
  let i = 0
  while i < n do
    let last = show(i)
    let i = i + 1
  end
  return last
end

make a function called runx takes n returns last
  let last = ""
  let i = 0
  while i < n do
    let last = exec_capture("cmd", "/c", "echo " + i)
    let i = i + 1
  end
  return last
end

print(show(7))
let warm = run(50)
let h = hu()
print(run(2000))
print("display bytes/run under 8: " + (((hu() - h) / 2000) < 8))
let warmx = runx(5)
let hx = hu()
print(runx(200))
print("exec_capture bytes/run under 8: " + (((hu() - hx) / 200) < 8))
