# Fixture for native_codegen.feature (GitHub #180): a function defined twice,
# byte for byte, as `include` produces when a file is reached by two paths. The
# first definition must win and the program must build. count_to has an early
# return inside a loop, the shape whose flattening broke with two same-named
# blocks. Expected: 3, then 2.

make a function called count_to takes n returns r
  let k = 0
  while k < n do
    if k == 3 then
      return k
    end
    let k = k + 1
  end
  return n
end

make a function called count_to takes n returns r
  let k = 0
  while k < n do
    if k == 3 then
      return k
    end
    let k = k + 1
  end
  return n
end

print(count_to(10))
print(count_to(2))
