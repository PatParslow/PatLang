# Fixture for spec_library/block_model/native_codegen.feature (Phase 19).
# Emit/event dispatch through REAL native codegen -- combines what
# event_multi_handler.patlang, event_global_visible.patlang, and
# event_returns_control.patlang each prove separately under the
# interpreter into one native fixture: two handlers registered for the
# SAME event both fire, in declaration order; a handler's own
# set_global is visible in the emitting block immediately after emit()
# returns; and emit() genuinely returns control (the statements after it
# keep running), proven twice (once per emit() call site).

when ping do
  print(100)
end

when ping do
  print(200)
end

when set_it do
  set_global("counter", 41)
end

make a function called start returns r
  emit("ping", 0)
  emit("set_it", 0)
  let c = get_global("counter")
  print(c + 1)
  print(2)
  return finish()
end

make a function called finish returns r
  print(3)
end
