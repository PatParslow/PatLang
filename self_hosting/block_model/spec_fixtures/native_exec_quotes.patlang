# Given self_hosting/build/native_argv_quotes.exe (native_argv_quotes.patlang),
# When a native build passes it arguments holding quotes, backslashes,
# spaces and an empty string through exec_capture,
# Then the child prints each one back intact, as when interpreted -- the
# command line is quoted the way Rust's Command::args quotes it.
let out = exec_capture("./self_hosting/build/native_argv_quotes.exe", "x \"q\" y", "p q", "b\s", "e\\\"", "", "tail\\")
print(out)
