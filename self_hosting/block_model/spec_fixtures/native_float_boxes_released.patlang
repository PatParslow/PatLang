# Given lists of floats built and dropped in a loop (raytrace colours,
# tuples and interval bounds),
# When built natively and run,
# Then the sums are the interpreter's and the heap stays flat: a boxed
# Float is counted like a rational, so releasing a list releases the floats
# in it. Float boxes were never freed (16 bytes for every float stored).
make a function called hu returns n
  return mem_peek_qword(mem_heap_state_addr(), 0)
end
make a function called triple takes x returns t
  return [x * 0.5, x * 0.25, x + 1.5]
end
make a function called run takes n returns total
  let total = 0.0
  let i = 0
  while i < n do
    let t = triple(i * 1.0)
    let total = total + t[0] + t[2]
    let i = i + 1
  end
  return total
end
let warm = run(50)
let h = hu()
print(run(5000))
print("float boxes bytes/iter under 16: " + (((hu() - h) / 5000) < 16))
