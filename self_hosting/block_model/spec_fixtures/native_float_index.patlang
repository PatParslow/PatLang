# Given an index that is a Float (floor() of a float returns a Float, as
# interpreted), into vec_get, vec_set and list indexing,
# When built natively and run,
# Then the index is truncated to an Int, as interpreted (ops.rs as_index).
# The boxed Float's tagged word was used as the index, giving garbage
# (raytrace ch22's pixel_at(img, floor(fx), floor(fy))).
make a function called pick takes xs, i returns v
  return xs[i]
end

let fy = 1.5
let y0 = floor(fy)
let store = vec_new(4)
vec_push(store, 10)
vec_push(store, 11)
vec_push(store, 12)
print(vec_get(store, y0))
let i = (y0 * 1 + 0) * 2
print(vec_get(store, i))
vec_set(store, y0, 21)
print(vec_get(store, 1))
let xs = [30, 31, 32]
print(xs[y0])
print(pick(xs, 2.75))
