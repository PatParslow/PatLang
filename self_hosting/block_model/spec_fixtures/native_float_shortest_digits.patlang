# Given non-integral floats whose shortest round-trip decimal needs 1 to 17
# significant digits, from 2^-1074 up to 1e15-scale magnitudes,
# When they are printed natively,
# Then the text is exactly what pat --ir-run prints (Rust's f64 Display: the
# shortest digits that read back as the same double, in plain notation).
# The native printer used to extract a fixed 16 fractional digits by
# repeated float multiply-by-10, losing digits on small values and
# carrying rounding error (raytrace ch11).
make a function called halvings takes n returns x
  let x = 1.0
  let k = 0
  while k < n do
    let x = x / 2.0
    let k = k + 1
  end
  return x
end

print(0.1 + 0.2)
print(1.0 / 3.0)
print(2.0 / 3.0)
print(100.0 / 7.0)
print(0.0 - 0.1)
print(1.0 / 1000000.0)
print(1000000000000000.0 + 0.3)
print(halvings(30))
print(halvings(1022) * 3.0)
print(halvings(1074))
print((0.0 - 1.0) / 7000000.0)
print("in text " + (1.0 / 3.0))
