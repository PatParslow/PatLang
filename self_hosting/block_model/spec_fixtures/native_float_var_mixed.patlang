# Scenario: a variable assigned both a raw float and a dynamically
# computed value keeps its value natively
#   Given v = 0.0 then v = v * t + c[k] in a loop (Horner's scheme, t and c
#     passed in), a single such step, and a parameter rescaled by a float
#   When run natively
#   Then each result matches pat --ir-run
make a function called horner takes c, t returns v
  let v = 0.0
  let k = c.length - 1
  while k >= 0 do
    let v = v * t + c[k]
    let k = k - 1
  end
  return v
end
make a function called one_step takes c, t returns v
  let v = 0.0
  let v = v * t + c[0]
  return v
end
make a function called rescale takes t returns t
  let t = t * 0.5
  let t = t + 1
  return t
end
print(one_step([5], 3))
print(horner([1, 2], 3))
print(horner([-6, 11, -6, 1], 0.5))
print(horner([1, (1/2)], 2))
print(rescale(3))
print(rescale((1/2)))
