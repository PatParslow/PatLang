# Scenario: a float mixed with the result of integer arithmetic natively
#   Given 0.1 - (1/10) at top level, a local small = (1/4) times cos(0.0),
#     a loop counter times 0.7, 2^47 * 4 (a BigInt natively) times 0.5,
#     and that BigInt divided by 3 and by 0.5, and a BigInt-sized literal
#     held in a local times 0.5
#   When run natively
#   Then each result matches pat --ir-run (the Rational/BigInt is not read
#     as a raw int)
make a function called swept returns s
  let small = (1/4)
  let s = small * cos(0.0)
  let ia = 0
  while ia < 3 do
    let s = s + ia * 0.7
    let ia = ia + 1
  end
  return s
end
make a function called big_half returns h
  let b = 140737488355328 * 4
  return b * 0.5
end
make a function called big_literal_half returns h
  let b = 562949953421312
  return b * 0.5
end
print(0.1 - (1/10))
print(swept())
print(big_half())
print((1/4) + 0.5)
print((140737488355328 * 4) / 3)
print((140737488355328 * 4) / 0.5)
print(big_literal_half())
