# Given user functions whose names contain "rt_" or "mem_" (sort_numbers,
# check_mem_ok), comparing and adding ints, rationals and floats,
# When they are built natively and run,
# Then the arithmetic and comparisons are numeric, as interpreted. The
# backend excluded any name CONTAINING "rt_"/"mem_" from tagged dispatch,
# meant for x64_runtime.patlang's own raw-word rt_*/mem_* functions, so
# `7 < 1/10` compared the rational's tagged pointer bits (raytrace ch17's
# insertion sort put 7 ahead of 1/10).
make a function called sort_numbers takes xs returns out
  let out = []
  let k = 0
  while k < xs.length do
    let v = xs[k]
    let placed = []
    let inserted = false
    let j = 0
    while j < out.length do
      if not inserted and v < out[j] then
        let placed = list_push(placed, v)
        let inserted = true
      end
      let placed = list_push(placed, out[j])
      let j = j + 1
    end
    if not inserted then
      let placed = list_push(placed, v)
    end
    let out = placed
    let k = k + 1
  end
  return out
end

make a function called check_mem_ok takes a, b returns r
  return [a < b, a + b, a * b]
end

print(sort_numbers([-1, (1/10), (11/10), 7]))
print(check_mem_ok(7, (1/10)))
print(check_mem_ok(2, 0.5))
