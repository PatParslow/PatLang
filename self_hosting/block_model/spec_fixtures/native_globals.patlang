# Fixture for spec_library/block_model/native_codegen.feature (Phase 19).
# A global set in one block is visible several jumps later, through REAL
# native codegen -- GlobalGet/GlobalSet translate to a hand-emitted
# assoc-list walk (rt_list_get/rt_list_len/rt_str_eq/rt_list_push), no
# heap.patlang/interp.patlang bundling needed.

make a function called start returns r
  set_global("counter", 41)
  return middle()
end

make a function called middle returns r
  return finish()
end

make a function called finish returns r
  let c = get_global("counter")
  print(c + 1)
end
