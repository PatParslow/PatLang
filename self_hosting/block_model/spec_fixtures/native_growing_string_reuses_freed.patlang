# Given a string grown a character at a time, each version replacing the last,
# When it is built to 4000 characters natively,
# Then the heap grows by a few times the final string's size, not by the sum
#   of every intermediate string.
# Every intermediate was released, but the free list kept only the first 64
# exact block sizes it saw and dropped every freed block of any other size, so
# past 512 bytes each version stayed allocated: about 970 heap bytes per
# character at 2000 characters, and the sum grows with the square of the length
# (docs/plans/general-refcounting.md, 6d).
make a function called hu returns n
  return mem_peek_qword(mem_heap_state_addr(), 0)
end

make a function called grow takes n returns s
  let s = ""
  let i = 0
  while i < n do
    let s = s + "x"
    let i = i + 1
  end
  return s
end

let warm = grow(100)
let h = hu()
let s = grow(4000)
print(s.length)
print("heap bytes per character under 40: " + (((hu() - h) / 4000) < 40))
