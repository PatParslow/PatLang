# Fixture for spec_library/block_model/native_codegen.feature (Phase 19).
# Two names registered in the same handler resolve independently,
# through REAL native codegen.

make a function called start returns r
  let h = handler_new()
  let h = handler_register(h, "alice", 111)
  let h = handler_register(h, "bob", 222)
  print(handler_lookup(h, "alice"))
  print(handler_lookup(h, "bob"))
end
