# Given impure functions -- they read a global table, as raytrace's
# ga_product reads the GA sign table -- that return a fresh list, their own
# parameter, or a list_set of a fresh list (ga_blade's
# `list_set(ga_zero(), mask, coeff)`),
# When their results are kept, discarded, and passed on in a loop, built
# natively,
# Then the values are the interpreter's and the heap stays flat: an impure
# callee hands back one reference to its value, the caller owns it and
# releases the [value, globals] pair it came in, a fresh list passed into an
# impure call is released once its value is stored (as raytrace's
# `let w = ga_outer(w, mat_col(m, c))`, w reassigned in a loop), and a fresh list given to list_set is
# released once list_set has made the new version. Before, every
# call left its result, its pair, and the zero list behind. (A list operand
# whose sibling operands contain a loop or branch -- an inlined get_global
# written inline -- is not walked back to, so is still left.)
make a function called hu returns n
  return mem_peek_qword(mem_heap_state_addr(), 0)
end
make a function called zero returns z
  return [0, 0, 0, 0]
end
make a function called blade takes k, v returns b
  let o = get_global("offset")
  return list_set(zero(), k, v + o)
end
make a function called same takes r returns s
  let t = get_global("offset")
  return r
end
make a function called run takes n, keep returns total
  let total = 0
  let acc = same(zero())
  let i = 0
  while i < n do
    let acc = same(zero())
    let b = blade(i % 4, i)
    blade(1, i)
    let s = same(keep)
    let z = same(zero())
    let total = total + b[i % 4] + s[0] + z[1]
    let i = i + 1
  end
  return total + acc[0]
end
set_global("offset", 1)
let keep = [7, 8]
let warm = run(100, keep)
let h = hu()
print(run(20000, keep))
print(keep)
print("impure results bytes/iter under 8: " + (((hu() - h) / 20000) < 8))
