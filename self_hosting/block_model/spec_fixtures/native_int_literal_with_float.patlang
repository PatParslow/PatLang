# Given an integer literal combined with a local float (`1 - v`, `2 * v`,
# `(1 - v) * (h - 1)`), at top level and inside a function,
# When built natively and run,
# Then the literal's value takes part, as interpreted. The literal was
# converted twice -- re-encoded as the bits of 1.0 AND then converted with
# cvtsi2sd as if those bits were an integer -- giving about 4.6e18
# (raytrace ch22's texture lookup, (1 - v) * (h - 1)).
make a function called g returns r
  let v = 0.25
  let h = 5
  return [1 - v, (1 - v) * (h - 1), v * 4]
end

let v = 0.5
let h = 4
print(1 - v)
print((1 - v) * (h - 1))
print(2 * v)
print(v - 1)
print(3 + v)
print(g())
