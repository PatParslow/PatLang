# Given sin and cos of pi/4 (0.7853981633974483),
# When built natively and run,
# Then they print what the interpreter prints. The native math functions
# came from MSVCRT.DLL, whose sin(pi/4) is 0.7071067811865475, one ulp below
# the 0.7071067811865476 of UCRTBASE.DLL, the C runtime Rust's std calls --
# an ulp raytrace's rotations carried into printed results (ch11, ch19).
let q = 0.7853981633974483
print(sin(q))
print(cos(q))
print(sin(q) * sin(q) + cos(q) * cos(q))
