# Scenario: a list displays each element the way print shows it alone
#   Given a list holding an int, a rational, a float, a BigInt, a complex,
#     a string, a bool and a nested list with a rational in it
#   When it is printed natively
#   Then the text matches pat --ir-run, element for element
make a function called kinds takes r returns xs
  return [1, r, 2.5, 123456789012345678901234567890, sqrt(-4), "s", true, [(1/3), -2]]
end
print(kinds((5/2)))
print("" + [(7/4)])
