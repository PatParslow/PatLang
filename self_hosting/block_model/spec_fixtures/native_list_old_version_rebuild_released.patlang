# Given a list kept alive while newer versions of it are made with list_set,
# When its elements are set and read back 3000 times natively,
# Then every result is the interpreter's and the heap does not grow with the
#   number of iterations.
# Changing an older version of a list rebuilds it from the newest one,
# following each version's record of what it changed; rt_list_materialize
# kept that chain of versions in a scratch array it never freed
# (docs/plans/general-refcounting.md, 6d).
make a function called hu returns n
  return mem_peek_qword(mem_heap_state_addr(), 0)
end

make a function called churn takes n returns total
  let a = [1, 2, 3, 4, 5, 6, 7, 8]
  let total = 0
  let i = 0
  while i < n do
    let b = list_set(a, 0, i)
    let c = list_set(b, 1, i)
    let d = list_set(a, 2, i)
    let total = total + list_get(a, 1) + list_get(c, 1) + list_get(d, 2)
    let i = i + 1
  end
  return total
end

let w = churn(20)
let h = hu()
print(churn(3000))
print("bytes/iteration under 8: " + (((hu() - h) / 3000) < 8))
