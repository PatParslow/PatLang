# Given a program with closures (so every call returns a [value, globals]
# pair that the caller unpacks), and a function returning a list literal
# whose first operand is a local list and whose second is a call,
# When it is built natively and run,
# Then the local keeps its own reference as an element of the returned
# list, so it survives the function's release of its locals, as
# interpreted (the operand scan used to stop at the call's unpack and miss
# the local; raytrace's implicit() returned a freed gradient).
make a function called pieces takes n returns ps
  let ps = []
  let k = 0
  while k < n do
    let ps = list_push(ps, [k, k * k])
    let k = k + 1
  end
  return ps
end

make a function called count takes xs returns n
  return xs.length
end

make a function called pack takes n returns s
  let g = [pieces(n), pieces(n + 1), pieces(n + 2)]
  return [g, count(g)]
end

let ident = |x| do return x end
print(ident("closures present"))
let a = pack(2)
let b = pack(3)
print(a)
print(b[0][2])
