# Fixture for native_codegen.feature: docs/plans/general-refcounting.md
# Phase 3a (list/dict-element refcounting foundation): list nodes and
# buffers are reclaimed through bm_alloc's free list.
#
# Given: a fresh list of plain integers, built via a literal and rebound
#   every iteration of a top-level loop.
# When: repeated 50000 times.
# Then: the heap's own high-water mark stays flat -- each cycle's node
#   and buffer are genuinely reclaimed and reused, not merely bumped
#   forever.
#
# This used to release each list by hand (rt_list_node_rc_dec), proving
# the runtime half before any compiler pass released a list local. main
# now gets the ownership pass functions get, which releases the rebound
# local itself; the hand release on top of it released the block twice.

let loop_count = 50000
let warm = [1, 2, 3]
let before = mem_peek_qword(mem_heap_state_addr(), 0)
let i = 0
while i < loop_count do
  let lst = [i, i + 1, i + 2]
  let i = i + 1
end
let after = mem_peek_qword(mem_heap_state_addr(), 0)
print("growth= " + (after - before))
