# Fixture for native_codegen.feature: docs/plans/general-refcounting.md
# Phase 3a (list/dict-element refcounting foundation). Proves the
# allocator mechanism directly, via explicit rt_list_node_rc_inc/dec
# calls -- exactly how Phase 1's own refcounted_heap_native_check.
# patlang proved bm_alloc/bm_rc_inc/bm_rc_dec before any compiler pass
# (Phase 2) ever called them automatically. No compiler pass decides
# when to decrement a list local yet (that's Phase 3b) -- this fixture
# exercises the RUNTIME mechanism only.
#
# Given: a fresh list of plain integers, built via a literal, explicitly
#   rc_dec'd once. Plain integers deliberately, not strings: Phase 3a
#   only reclaims the list's OWN node/buffer, never cascades into
#   string/list elements (that's Phase 3c) -- a string element would
#   leak independently and mask whether the LIST itself was reclaimed.
# When: repeated 50000 times, each cycle building a 3-element list and
#   immediately releasing it.
# Then: the heap's own high-water mark stays flat -- each cycle's node
#   and buffer are genuinely reclaimed and reused via bm_alloc's
#   existing free-list, not merely bumped forever.

let loop_count = 50000
let warm = [1, 2, 3]
rt_list_node_rc_dec(warm band rt_payload_mask())
let before = mem_peek_qword(mem_heap_state_addr(), 0)
let i = 0
while i < loop_count do
  let lst = [i, i + 1, i + 2]
  rt_list_node_rc_dec(lst band rt_payload_mask())
  let i = i + 1
end
let after = mem_peek_qword(mem_heap_state_addr(), 0)
print("growth= " + (after - before))
