# Fixture for native_codegen.feature: docs/plans/general-refcounting.md
# Phase 4c -- the actual "list/dict-element storage" feature as
# originally named. When a list's own buffer dies (refcount reaches
# zero), every element it holds that is itself a String or List is now
# cascade-decremented too (rt_list_buf_rc_dec, x64_runtime.patlang),
# not just bump-allocated forever the way Phase 3a/4b left it.
#
# Given: a function that builds a one-element list wrapping a freshly
#   built, UNNAMED string (chr(...) fed directly into the list literal,
#   never stored to its own local first), then discards the whole list.
# When: called 50000 times.
# Then: the heap's own high-water mark stays flat -- both the list's
#   own node/buffer (Phase 3a/4b, already proven) AND the string
#   element it cascades into (Phase 4c, this fixture's own point) are
#   genuinely reclaimed. Before Phase 4c's own fixes landed, in order:
#   (1) no cascade into elements at all leaked the string every call;
#   (2) a first attempt at cascading leaked a fixed `len * 8` bytes per
#   cascade from a scratch buffer that itself was never freed; (3) a
#   second attempt correctly freed that scratch buffer but could still
#   read past a doubling-grown buffer's own logical length into
#   uninitialized padding. This fixture's own unnamed-temp shape never
#   exercises (3) directly (see native_list_rc_retire_chain.patlang for
#   that), but does exercise (1) and (2) directly -- confirmed via real
#   heap growth at each stage, not assumed.
make a function called make_list_with_string takes n returns r
  let lst = [chr(n % 26 + 65)]
  return 0
end

let loop_count = 50000

make_list_with_string(0)
let before = mem_peek_qword(mem_heap_state_addr(), 0)
let i = 0
while i < loop_count do
  make_list_with_string(i)
  let i = i + 1
end
let after = mem_peek_qword(mem_heap_state_addr(), 0)
print("growth= " + (after - before))
