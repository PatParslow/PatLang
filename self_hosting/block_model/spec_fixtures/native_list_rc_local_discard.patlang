# Fixture for native_codegen.feature: docs/plans/general-refcounting.md
# Phase 4b -- the dominance-based single-block decrement pass
# (native_codegen.patlang's bm_nc_reassignable_eligible_names/bm_nc_
# insert_string_rc_decs/bm_nc_insert_reassignment_decs), generalized
# from strings-only to also recognize BuildList as a producer, so a
# LIST local gets the exact same automatic treatment a string local
# already did. No explicit rt_list_rc_dec call anywhere in this file --
# that is the whole point: the compiler inserts it, the same way it
# already does for a discarded string.
#
# Given (case 1): a list built via a literal, stored in a local, never
#   returned or otherwise escaped (never passed into another BuildList/
#   list_push/list_set call) -- just discarded.
# When: called 50000 times.
# Then: the heap's own high-water mark stays flat -- the node and
#   buffer are decremented automatically at the function's own
#   terminal, exactly where bm_nc_rc_dec_count_at_terminal decides.
#
# Given (case 2): a local reassigned from two separate list literals,
#   mirroring the reassigned-locals increment already proven for
#   strings.
# When: called 50000 times.
# Then: the heap's own high-water mark stays flat -- the overwritten
#   first list is decremented at the reassignment point (job 1), the
#   final one at the terminal (job 2).

make a function called build_and_discard_list takes n returns r
  let xs = [n, n + 1, n + 2]
  return n
end

make a function called reassign_list_twice takes n returns r
  let xs = [n, n + 1]
  let xs = [n + 2, n + 3, n + 4]
  return n
end

let loop_count = 50000

build_and_discard_list(0)
let before1 = mem_peek_qword(mem_heap_state_addr(), 0)
let i = 0
let total1 = 0
while i < loop_count do
  let total1 = build_and_discard_list(i)
  let i = i + 1
end
let after1 = mem_peek_qword(mem_heap_state_addr(), 0)

reassign_list_twice(0)
let before2 = mem_peek_qword(mem_heap_state_addr(), 0)
let j = 0
while j < loop_count do
  reassign_list_twice(j)
  let j = j + 1
end
let after2 = mem_peek_qword(mem_heap_state_addr(), 0)

print("total1= " + total1 + " growth1= " + (after1 - before1) + " growth2= " + (after2 - before2))
