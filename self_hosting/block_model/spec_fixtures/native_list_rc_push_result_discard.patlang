# Fixture for native_codegen.feature: docs/plans/general-refcounting.md
# Phase 4b. Covers what native_list_rc_local_discard.patlang's own
# BuildList-only scenario never touches: a list_push RESULT, stored in
# a local and discarded, also gets automatically decremented -- list_
# push is recognized as a producer the same way a BuildList literal is
# (bm_nc_is_list_producer_call, native_codegen.patlang).
#
# `base` is a stable, already-built list passed in as a PARAMETER (not
# built fresh inside push_and_discard) and reused across every call,
# deliberately: base's own node starts "not retired" and the doubling
# path never retires its input (see heap.patlang's own header on
# rt_list_push), so base stays valid and reusable call after call --
# isolating `ys`'s own reclaiming with nothing else in flight.
#
# Given: ys = list_push(base, n), stored, never returned or otherwise
#   used again.
# When: called 50000 times with the same base.
# Then: the heap's own high-water mark stays flat.

make a function called push_and_discard takes base, n returns r
  let ys = list_push(base, n)
  return n
end

let loop_count = 50000
let base = [1, 2, 3, 4, 5, 6, 7, 8]
push_and_discard(base, 0)
let before = mem_peek_qword(mem_heap_state_addr(), 0)
let i = 0
let total = 0
while i < loop_count do
  let total = push_and_discard(base, i)
  let i = i + 1
end
let after = mem_peek_qword(mem_heap_state_addr(), 0)
print("total= " + total + " growth= " + (after - before))
