# Given list_set storing the value already there -- raytrace's group_frame,
# `list_set(list_set(g, 6, [[], false]), 7, false)`, on a group whose
# parent (element 7) is already false --
# When the inner result is a temporary the caller releases, built natively,
# Then the frame is intact (prints 0 and the shape). list_set hands back
# the same list when nothing changes; it gave no reference with it, so
# releasing the temporary freed the frame itself (raytrace ch37: a shape's
# parent chain looped and world_to_object overflowed the stack). It now
# takes the reference its caller owns, as when it makes a new version.
make a function called group_frame takes g returns f
  return list_set(list_set(g, 6, [[], false]), 7, false)
end
make a function called run takes n returns bad
  let bad = 0
  let i = 0
  while i < n do
    let g = ["group", 1, 2, 3, 4, 5, [[7], true], false]
    let f = group_frame(g)
    let junk = [i, [i, i], [i, i, i]]
    if f[0] != "group" or f[6][1] != false or f[7] != false or g[6][1] != true then
      let bad = bad + 1
    end
    let i = i + 1
  end
  return bad
end
print(run(500))
print(group_frame(["group", 1, 2, 3, 4, 5, [[7], true], false]))
