# Given a fresh list in one local copied into another (`let out = placed`),
# in a straight-line function and in a loop body,
# When it is built natively and run,
# Then the copy still holds the list after the original's scope ends, as
# interpreted: releasing `placed` used to free what `out` held, so `return
# out` handed back freed memory (raytrace ch17's insertion sort).
make a function called one takes v returns out
  let placed = list_push([], v)
  let out = placed
  let junk = list_push([], 99)
  return out
end

make a function called looped takes xs returns out
  let out = []
  let k = 0
  while k < xs.length do
    let placed = list_push(out, xs[k])
    let out = placed
    let junk = [list_push([], 98), 5, 6]
    let k = k + 1
  end
  return out
end

print(one(7))
print(looped([-1, (1/10), 7]))
