# Given a function that computes products into locals and copies them into
# other locals (`let lo = p1`, then `if p2 < lo then let lo = p2 end`), as
# raytrace's interval multiply ia_mul does, on floats and on lists,
# When it is called in a loop, built natively,
# Then the values are the interpreter's and the heap stays flat: a copy takes
# its own reference, so both the copied local and the copy are released.
# Before, a local copied into another was owned by neither, and every
# product's float box leaked (hundreds of MB per raytrace render of a
# function surface).
make a function called hu returns n
  return mem_peek_qword(mem_heap_state_addr(), 0)
end
make a function called lo_hi takes a, b, c returns iv
  let p1 = a * b
  let p2 = a * c
  let p3 = b * c
  let lo = p1
  let hi = p1
  if p2 < lo then
    let lo = p2
  end
  if p3 < lo then
    let lo = p3
  end
  if p2 > hi then
    let hi = p2
  end
  if p3 > hi then
    let hi = p3
  end
  return [lo, hi]
end
make a function called pick takes n returns l
  let a = [n, n]
  let b = a
  let c = [1, 2]
  if n % 2 == 0 then
    let b = c
  end
  return b
end
make a function called run takes n returns total
  let total = 0
  let i = 0
  while i < n do
    let x = i * 0.5
    let iv = lo_hi(x, 0.0 - x, 2.5)
    let pk = pick(i)
    let total = total + iv[1] - iv[0] + pk[0]
    let i = i + 1
  end
  return total
end
let warm = run(100)
let h = hu()
print(run(20000))
print("local copies bytes/iter under 8: " + (((hu() - h) / 20000) < 8))
