# Given a loop that pushes list literals and can return early, returning
# [list, count] from the loop's exit block,
# When built natively and run,
# Then the list comes back whole, as interpreted. The increment protecting
# `st` as an operand of the returned literal was skipped by the jump into
# the exit block (the jump landed past it), and with `st` now released at
# that exit the list was freed under the caller (raytrace's scene parser,
# ch36: every scene read back as "line : unknown statement ''").
make a function called f takes n returns r
  let st = []
  let i = 0
  while i < n do
    let t = [i, "a"]
    if i > 100 then
      return [st, i]
    end
    let st = list_push(st, [i, t])
    let i = i + 1
  end
  return [st, i]
end
print(f(3))
