# Given a function that builds a 100000-element list with
# `let st = list_push(st, k)` in a loop, and the same with a string
# accumulator and a list literal reassigned each time round,
# When built natively and run,
# Then the heap grows by what the final values need, not by every value the
# loop superseded. A local carried round a loop was never released, so
# each push kept its old node (about 77 bytes an element) and raytrace's
# picture reader, 3 million pushes a picture, ran past 8GB (ch36).
make a function called used returns n
  return mem_peek_qword(mem_heap_state_addr(), 0)
end
make a function called build takes n returns st
  let st = []
  let k = 0
  while k < n do
    let st = list_push(st, k)
    let k = k + 1
  end
  return st
end
make a function called pairs takes n returns last
  let last = [0, 0]
  let k = 0
  while k < n do
    let last = [k, k + 1]
    let k = k + 1
  end
  return last
end
let n = 100000
let u0 = used()
let a = build(n)
let u1 = used()
let per = (u1 - u0) / n
print("list_push bytes/elem under 32: " + (per < 32))
let p = pairs(n)
let u2 = used()
print("reassigned literal bytes/iter under 8: " + (((u2 - u1) / n) < 8))
print(a.length + " " + a[n - 1] + " " + p)
