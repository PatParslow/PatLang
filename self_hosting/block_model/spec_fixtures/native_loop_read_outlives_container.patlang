# Given a loop that pops a pair off a stack with a pure function and keeps
# reading the rest of the stack out of that pair (the block-model
# interpreter's `let popped = bm_st_pop(stack)` / `let stack =
# list_get(popped, 1)`),
# When built natively and run,
# Then it reverses the stack as interpreted (prints [[5], [4], [3], [2], [1]] []).
# The pair is released at the loop's back edge; `stack` only borrowed its
# second element, so the next iteration popped from freed memory (with
# release checking: "reference count below zero"). A read stored into an
# owned local now takes a reference of its own.
make a function called st_pop takes stack returns out
  let n = list_len(stack)
  let v = list_get(stack, n - 1)
  let rest = []
  let i = 0
  while i < n - 1 do
    let rest = list_push(rest, list_get(stack, i))
    let i = i + 1
  end
  return [v, rest]
end
make a function called reverse_all takes stack, pn returns out
  let reversed = []
  let i = 0
  while i < pn do
    let popped = st_pop(stack)
    let stack = list_get(popped, 1)
    let reversed = list_push(reversed, list_get(popped, 0))
    let junk = [i, i, i]
    let i = i + 1
  end
  return [reversed, stack]
end
let r = reverse_all([[1], [2], [3], [4], [5]], 5)
print(r[0])
print(r[1])
