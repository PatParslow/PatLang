# Given a top-level while loop and a `when` handler's while loop, each
#   rebinding a local to a freshly built nested list every iteration,
# When built natively,
# Then the output is the interpreter's, and neither loop grows the heap
#   with the number of iterations.
# Functions have been through the block-family ownership pass for a while;
# main and handlers only got the single-block one, so any loop at the top
# level or in a handler kept every value it rebound (184 bytes an
# iteration for `[[name, true]]`).
make a function called hu returns n
  return mem_peek_qword(mem_heap_state_addr(), 0)
end
make a function called pair_set takes map, name, flag returns out
  let n = to_num(list_len(map))
  let out = []
  let found = false
  let i = 0
  while i < n do
    if map[i][0] == name then
      let out = list_push(out, [name, flag])
      let found = true
    else
      let out = list_push(out, map[i])
    end
    let i = i + 1
  end
  if not found then
    let out = list_push(out, [name, flag])
  end
  return out
end
make a function called build takes k returns map
  let map = []
  let map = pair_set(map, "a", true)
  let map = pair_set(map, "b", false)
  let map = pair_set(map, "c", k % 2 == 0)
  let map = pair_set(map, "b", true)
  return map
end
when tick do
  let j = 0
  let last = []
  while j < 2000 do
    let last = [[event_data, j]]
    let j = j + 1
  end
  print(last)
end
print(build(3))
let w = build(0)
emit("tick", "warm")
let h = hu()
let k = 0
let t = 0
while k < 2000 do
  let m = build(k)
  if m[2][1] then
    let t = t + 1
  end
  let k = k + 1
end
print(t)
print("main bytes/iter under 8: " + (((hu() - h) / 2000) < 8))
let h = hu()
emit("tick", "x")
print("handler bytes/iter under 8: " + (((hu() - h) / 2000) < 8))
