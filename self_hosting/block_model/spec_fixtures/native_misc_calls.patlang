# Fixture for spec_library/block_model/native_codegen.feature (Phase 19).
# Exercises fact/query/type_of/write_file/read_file through REAL native
# codegen -- all backed by genuine, already-compiled x64_runtime.patlang
# functions (confirmed present in self_hosting/build/x64_runtime.funcs),
# translated as ordinary Call instructions, no new runtime primitives
# needed at all.

make a function called start returns r
  fact("likes", "alice", "bob")
  print(query("likes", "alice", "x"))
  print(type_of(42))
  write_file("self_hosting/build/bm_native_misc_scratch.txt", "native round trip")
  print(read_file("self_hosting/build/bm_native_misc_scratch.txt"))
end
