# Given a named object created, filled with a string field, a list field
#   pushed to, and a number field, then deleted with object_delete,
# When that cycle runs 2000 times in a function, natively,
# Then the heap does not grow with the number of cycles, and a value read
#   out of an object before deleting it stays intact.
# object_delete used to unlink the name only: the object's key table and
# every value it held stayed allocated, so the assembler's per-chunk state
# objects (and everything they held) lived for the whole compile.
make a function called hu returns n
  return mem_peek_qword(mem_heap_state_addr(), 0)
end

make a function called cycle takes k returns kept
  let name = "tmp_obj_" + k
  let o = new("Dict", name)
  send(o, "set", "label", "label_" + k)
  send(o, "set", "items", [])
  let i = 0
  while i < 20 do
    send(o, "push", "items", "item_" + i)
    let i = i + 1
  end
  send(o, "set", "count", k)
  let kept = get(o, "label")
  object_delete(name)
  return kept
end

let warm = cycle(0)
let h = hu()
let k = 1
let last = ""
while k <= 2000 do
  let last = cycle(k)
  let k = k + 1
end
let grown = hu() - h
print(last)
print("bytes/cycle under 64: " + ((grown / 2000) < 64))
