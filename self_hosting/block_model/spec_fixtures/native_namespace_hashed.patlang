# Fixture for native_codegen.feature: object fields and set_var/get go
# through one process-wide table of stores (one per object, plus
# "__vars"). Natively that table was a list scanned with a string compare
# on every get/set/send, so each access cost time in proportion to the
# number of objects ever created, and a cold patc1_x64 compile, whose
# assembler makes objects per unit, became quadratic in units.
#
# Given: 3000 objects, each with two fields, and 500 set_var keys.
# When: every field and key is read back, every other object is deleted
#   and then recreated with new values, and a list field is pushed to.
# Then: every read returns what was stored, and reading one field 20000
#   times costs about the same with 3000 objects alive as with 30.
make a function called time_reads takes obj, reps returns ms
  let t0 = now_ms()
  let sum = 0
  let i = 0
  while i < reps do
    let sum = sum + get(obj, "a")
    let i = i + 1
  end
  return now_ms() - t0
end

let reps = 20000
let i = 0
while i < 30 do
  let o = new("Dict", "few_" + i)
  send(o, "set", "a", i)
  let i = i + 1
end
let few_ms = time_reads("few_29", reps)

let n = 3000
let i = 0
while i < n do
  let o = new("Dict", "obj_" + i)
  send(o, "set", "a", i)
  send(o, "set", "name", "n_" + i)
  let i = i + 1
end
let i = 0
while i < 500 do
  set_var("k_" + i, i * 3)
  let i = i + 1
end
let many_ms = time_reads("obj_" + (n - 1), reps)

let bad = 0
let i = 0
while i < n do
  if get("obj_" + i, "a") != i then
    let bad = bad + 1
  end
  if get("obj_" + i, "name") != ("n_" + i) then
    let bad = bad + 1
  end
  let i = i + 1
end
let i = 0
while i < 500 do
  if get("__vars", "k_" + i) != (i * 3) then
    let bad = bad + 1
  end
  let i = i + 1
end

let i = 0
while i < n do
  object_delete("obj_" + i)
  let i = i + 2
end
let i = 0
while i < n do
  let o = new("Dict", "obj_" + i)
  send(o, "set", "a", i + 1000000)
  let i = i + 2
end
let i = 0
while i < n do
  let want = i
  if (i % 2) == 0 then
    let want = i + 1000000
  end
  if get("obj_" + i, "a") != want then
    let bad = bad + 1
  end
  let i = i + 1
end

send("obj_1", "set", "items", [])
let i = 0
while i < 100 do
  send("obj_1", "push", "items", i)
  let i = i + 1
end
let items = get("obj_1", "items")
print("bad= " + bad + " items= " + list_len(items) + " last= " + items[99])
print("lookup cost with 3000 objects under 3x that with 30: " + (many_ms < (3 * few_ms + 5)))
