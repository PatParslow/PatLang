# Given an outer loop counter times a float literal, used inside an inner
# loop, at top level and inside a function,
# When built natively and run,
# Then the products are as interpreted. The inner loop's body is laid out
# before the stores that feed its copy of the counter, and the float
# analysis decided "opaque"/"proven int" from the stores it had seen so
# far in one linear pass -- none -- so i's int bits were read as a double
# (raytrace ch29's grid check, abs(o[0] - i * 2.5)).
make a function called grid returns out
  let out = []
  let i = 0
  while i <= 2 do
    let j = 0
    while j <= 1 do
      let out = list_push(out, i * 2.5 + j)
      let j = j + 1
    end
    let i = i + 1
  end
  return out
end

let i = 0
while i <= 2 do
  let j = 0
  while j <= 1 do
    print(i * 2.5)
    let j = j + 1
  end
  let i = i + 1
end
print(grid())
