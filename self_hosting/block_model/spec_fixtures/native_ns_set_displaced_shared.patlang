# Fixture for native_codegen.feature: GitHub #223's second bug, the one
# that kept a natively-compiled patc2.exe from linking anything
# ("undefined symbol 'rt_str_eq'"). Mirrors x64_asm.patlang's own
# xa_process_line/xa_declare_symbol shape exactly: a label name built by
# substr is pushed into an object's "syms" list inside a helper, then
# stored into the same object's "cur" field via send(..., "set", ...),
# and the NEXT label's own "set" displaces it.
#
# rt_ns_set used to store `value` WITHOUT taking its own reference, yet
# release one (rt_rc_dec_if_refcounted) on the displaced old value. The
# name's single reference was therefore shared by the syms tuple and
# "cur"; displacing "cur" freed a string the syms list still pointed at,
# and the next allocation reused it.
#
# Given: on_label(d, line) derives a name via substr, pushes [name, 7]
#   onto d's "syms" via a helper, then sets d's "cur" to the same name.
# When: called for 2000 distinct labels, with an unrelated string
#   allocation after each to reuse any wrongly-freed block.
# Then: every syms entry still holds its own original name.
make a function called declare takes d, name returns ok
  send(d, "push", "syms", [name, 7])
  return true
end

make a function called on_label takes d, line returns ok
  let name = substr(line, 0, line.length - 1)
  declare(d, name)
  send(d, "set", "cur", name)
  return true
end

let d = new("Dict", "ns_set_displaced_fixture")
send(d, "set", "syms", [])
send(d, "set", "cur", "")
let count = 2000
let junk = []
let i = 0
while i < count do
  on_label(d, "lbl_" + i + ":")
  let junk = list_push(junk, "junk_" + i)
  let i = i + 1
end
let syms = get(d, "syms")
let mismatches = 0
let k = 0
while k < count do
  let entry = syms[k]
  if entry[0] != ("lbl_" + k) then
    let mismatches = mismatches + 1
  end
  let k = k + 1
end
print("mismatches= " + mismatches)
