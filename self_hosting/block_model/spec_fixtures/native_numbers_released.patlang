# Given loops whose numbers live on the heap -- a total past 2^47 (a BigInt),
#   BigInt division and remainder, a rational whose parts are BigInts, and a
#   complex number -- each value replacing the last,
# When they run natively,
# Then every result is the interpreter's and none of the loops grows the
#   heap with the number of iterations.
# A BigInt, Complex or Interval came from a raw allocation that was never
# freed, and a Rational's parts were not counted: bench_sumloop's 25 million
# additions past 2^47 took 533 MB (docs/plans/general-refcounting.md, 6d).
make a function called hu returns n
  return mem_peek_qword(mem_heap_state_addr(), 0)
end

make a function called sum_big takes n returns total
  let total = 140737488355000
  let i = 0
  while i < n do
    let total = total + i
    let i = i + 1
  end
  return total
end

make a function called divide_big takes n returns last
  let big = 123456789012345678901234567890
  let last = 0
  let i = 1
  while i <= n do
    let last = (big / i) + (big % (i + 7))
    let i = i + 1
  end
  return last
end

make a function called rational_big takes n returns r
  let r = 1 / 3
  let i = 0
  while i < n do
    let r = (r * 1000000007) / 1000000007 + (1 / 123456789012345)
    let i = i + 1
  end
  return r
end

make a function called complex_loop takes n returns z
  let z = 1 + sqrt(0 - 4)
  let unit = sqrt(0 - 1)
  let i = 0
  while i < n do
    let z = z * unit
    let i = i + 1
  end
  return z
end

let w = sum_big(100)
let h = hu()
print(sum_big(20000))
print("bigint sum bytes/iteration under 8: " + (((hu() - h) / 20000) < 8))

let w2 = divide_big(10)
let h2 = hu()
print(divide_big(2000))
print("bigint division bytes/iteration under 8: " + (((hu() - h2) / 2000) < 8))

let w3 = rational_big(10)
let h3 = hu()
print(rational_big(2000))
print("rational bytes/iteration under 8: " + (((hu() - h3) / 2000) < 8))

let w4 = complex_loop(10)
let h4 = hu()
print(complex_loop(20000))
print("complex bytes/iteration under 8: " + (((hu() - h4) / 20000) < 8))
