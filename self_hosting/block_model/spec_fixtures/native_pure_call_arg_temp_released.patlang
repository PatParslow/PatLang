# Given fresh values passed straight into pure calls -- a pure call's result
# (`first_of(fa_num(i))`, raytrace's `ga_outer(w, mat_col(m, c))`) and a
# list literal (`first_of([i, i])`) --
# When built natively and run in a loop,
# Then the results are the interpreter's and the heap stays flat: each
# temporary is released once the call that borrowed it returns. Before, every
# one leaked (96 bytes an iteration here; hundreds of MB per raytrace scene).
make a function called hu returns n
  return mem_peek_qword(mem_heap_state_addr(), 0)
end
make a function called fa_num takes v returns a
  return ["num", v]
end
make a function called first_of takes r returns v
  return r[1]
end
make a function called run takes n returns total
  let total = 0
  let i = 0
  while i < n do
    let total = total + first_of(fa_num(i)) + first_of([i, i])
    let i = i + 1
  end
  return total
end
let warm = run(100)
let h = hu()
let total = run(20000)
print(total)
print("arg temps bytes/iter under 8: " + (((hu() - h) / 20000) < 8))
