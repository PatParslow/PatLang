# Given a pure function whose tail call `return pattern_at(p, x + 0)` is
# inlined, and pattern_at returns an element of its argument (`p[1]`) after
# a branch, with a local (`kind`) released at that exit,
# When it is called in a loop that keeps allocating, built natively,
# Then every colour read back is the pattern's own (prints 0 mismatches).
# A pure call's caller now owns its result, so the callee must retain a
# borrowed element it returns. The exit's release of `kind` sat between the
# list_get and the Return, hiding it from the retain, so the caller
# released the pattern's own colour (raytrace ch10: colours read back as
# other values; with release checking, "reference count below zero").
make a function called evec takes x, y, z returns mv
  return [0, x, y, 0, z, 0, 0, 0]
end
make a function called color takes r, g, b returns c
  return evec(r, g, b)
end
make a function called white returns c
  return color(1, 1, 1)
end
make a function called black returns c
  return color(0, 0, 0)
end
make a function called stripe_pattern takes a, b returns p
  return ["stripe", a, b, 0, 7]
end
make a function called set_t takes p, m returns q
  return list_set(p, 4, m)
end
make a function called pattern_at takes p, x returns c
  let kind = p[0]
  let parity = 0
  if kind == "stripe" then
    let parity = x % 2
  end
  if parity == 0 then
    return p[1]
  end
  return p[2]
end
make a function called pattern_at_shape takes p, x returns c
  return pattern_at(p, x + 0)
end
make a function called oracle takes x returns c
  if x % 2 == 0 then
    return white()
  end
  return black()
end
make a function called same takes a, b returns yes
  return a[1] == b[1] and a[2] == b[2] and a[4] == b[4]
end
make a function called run returns bad
  let bad = 0
  let k = 0
  while k < 3 do
    let pat = set_t(stripe_pattern(white(), black()), [k])
    let i = 0
    while i < 50 do
      let got = pattern_at_shape(pat, i)
      let want = oracle(i)
      let junk = [9, 9, 9, 9, 9, 9, 9, 9]
      let junk2 = color(5, 5, 5)
      if not same(got, want) then
        let bad = bad + 1
      end
      let i = i + 1
    end
    let k = k + 1
  end
  return bad
end
print(run())
