# Given a pure function returning a list literal of its own parameters
# (raytrace's `ray(origin, direction)`: `return [origin, direction]`),
# When a caller in a loop makes one from lists it keeps, lets it go, and
# keeps allocating,
# Then the caller's own lists are intact (prints [1, 2, 3] [4, 5, 6] 0).
# A BuildList right before Return was taken for the [value, globals] return
# pack, so its elements got no reference of their own; once a pure call's
# caller released the result, that released the caller's origin and
# direction too (raytrace ch10's shadow test read the wrong colour).
make a function called ray takes origin, direction returns r
  return [origin, direction]
end
make a function called first takes r returns v
  return r[0][0]
end
make a function called run takes o, d returns bad
  let bad = 0
  let i = 0
  while i < 200 do
    let r = ray(o, d)
    let junk = [i, i, i]
    if first(r) != 1 then
      let bad = bad + 1
    end
    let i = i + 1
  end
  return bad
end
let o = [1, 2, 3]
let d = [4, 5, 6]
let bad = run(o, d)
print(o)
print(d)
print(bad)
