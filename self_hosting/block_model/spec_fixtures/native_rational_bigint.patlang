# Rationals keep exact numerators and denominators however large they get,
# promoting to BigInt parts as the interpreter does (native Rationals used to
# hold raw i64 parts that silently wrapped: raytrace's distance_between gave
# -1168242959227/949111625728 for an exact -3124900001/20000000000).
fn dot(a, b, c, d) {
  return a * c - b * d
}

let a = -7500099999 / 20000000000
let b = 12499900001 / 20000000000
let c = -15 / 32
let d = 17 / 32
print("dot " + dot(a, b, c, d))
let mut x = 1 / 3
let mut i = 0
while i < 6 {
  x = x * x
  i = i + 1
}
print("x " + x)
print("x+1 " + (x + 1) + " " + type_of(x + 1))
print("cmp " + (x < 1) + " " + (x > 0) + " " + (x * 3 == x + x + x))
let y = x * 3486784401
print("y " + y)
print("z " + (y / y) + " " + type_of(y / y))
print("f " + floor(1000000 / 3 + x) + " " + (x - x))
