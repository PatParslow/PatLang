# Given multivectors of exact rationals built and dropped in a loop
# (raytrace's ga_scale / ga_product over 32 components, every transform a
# scene builds),
# When built natively and run,
# Then the sums are exact and the heap stays flat: a rational is counted
# like a string or a list, so releasing a list releases the rationals in
# it. Rationals were never freed at all (about 16 KB for each translation,
# over a gigabyte for one raytrace scene).
make a function called hu returns n
  return mem_peek_qword(mem_heap_state_addr(), 0)
end
make a function called scale takes a, s returns r
  let r = []
  let i = 0
  while i < a.length do
    let r = list_push(r, a[i] * s)
    let i = i + 1
  end
  return r
end
make a function called run takes n returns total
  let base = [(1/3), (2/3), (5/7), 1, 2, 3, (9/11), (4/5)]
  let total = 0
  let i = 0
  while i < n do
    let v = scale(base, (1/2))
    let w = scale(v, 3)
    let total = total + w[0] + w[7]
    let i = i + 1
  end
  return total
end
let warm = run(50)
let h = hu()
print(run(5000))
print("rationals bytes/iter under 16: " + (((hu() - h) / 5000) < 16))
