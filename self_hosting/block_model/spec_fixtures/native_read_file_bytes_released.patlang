# Given a file read back in slices in a loop (raytrace's PPM reader reads a
# picture row by row with read_file_bytes),
# When built natively and run,
# Then each slice is right and the heap stays flat: the runtime hands back
# its read buffer, and the caller releases each slice it is done with. Before,
# both stayed (the buffer and the list: about 9 KB a 1000-byte read).
make a function called hu returns n
  return mem_peek_qword(mem_heap_state_addr(), 0)
end
make a function called sum_reads takes path, n returns total
  let total = 0
  let i = 0
  while i < n do
    let row = read_file_bytes(path, (i % 3) * 1000, 1000)
    let total = total + row[0] + row.length
    let i = i + 1
  end
  return total
end
let sb = sb_new()
let k = 0
while k < 3000 do
  sb_push(sb, chr(65 + (k - k % 1000) / 1000))
  let k = k + 1
end
let path = "self_hosting/build/native_read_file_bytes_released.bin"
write_file(path, sb_str(sb))
let warm = sum_reads(path, 30)
let h = hu()
print(sum_reads(path, 2000))
print("read slices bytes/iter under 16: " + (((hu() - h) / 2000) < 16))
