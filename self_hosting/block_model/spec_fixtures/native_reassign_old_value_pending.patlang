# GitHub #228: `let out = list_push(out, [..., f(...)])` in a single-block
# function. The old `out` is still a pending operand of list_push when its
# reassignment is processed, so it must only be released after the Store.
# Decrementing it first freed the node, its buffer, and the elements, before
# list_push read them. The closure makes dynamic dispatch present, so callees
# use the packed return as in the compiler itself.
fn tag(a, b) {
  return a + "_" + b
}

fn add_four(out, name) {
  let out = list_push(out, ["Const", "num", "1"])
  let out = list_push(out, ["CallHost", "list_get", 2])
  let out = list_push(out, ["Store", tag(name, "globals")])
  let out = list_push(out, ["Load", tag(name, "r")])
  return out
}

let ident = |z| { return z }
print(ident("closures present"))
let mut out = []
let mut i = 0
while i < 500 {
  out = add_four(out, "b" + i)
  let junk = [substr("zzzzzzzz" + i, 0, 6), [i, i], ["x", "y"]]
  i = i + 1
}
let mut bad = 0
let mut j = 0
while j < 500 {
  let a = out[j * 4]
  let b = out[j * 4 + 1]
  let c = out[j * 4 + 2]
  let d = out[j * 4 + 3]
  if a[0] != "Const" {
    bad = bad + 1
  }
  if b[0] != "CallHost" {
    bad = bad + 1
  }
  if c[1] != ("b" + j + "_globals") {
    bad = bad + 1
  }
  if d[1] != ("b" + j + "_r") {
    bad = bad + 1
  }
  j = j + 1
}
print("bad= " + bad + " len= " + list_len(out))
