# Given a local reassigned to list_set of the value already in place (so
# list_set hands back the same list, with a reference of its own),
# When it is done in a function called in a loop, built natively,
# Then the results are right and the heap stays flat: the old reference is
# released even though the new value is the same list. Releasing the old
# value used to be skipped whenever the two were the same word, which left
# that reference behind and the list with it, on every call.
make a function called hu returns n
  return mem_peek_qword(mem_heap_state_addr(), 0)
end
make a function called touch takes n returns total
  let l = [n, n + 1, [n]]
  let k = 0
  while k < 3 do
    let l = list_set(l, 0, l[0])
    let k = k + 1
  end
  return l[0] + l[1] + l.length
end
make a function called run takes n returns total
  let total = 0
  let i = 0
  while i < n do
    let total = total + touch(i)
    let i = i + 1
  end
  return total
end
let warm = run(100)
let h = hu()
print(run(20000))
print("same-value reassignment bytes/iter under 8: " + (((hu() - h) / 20000) < 8))
