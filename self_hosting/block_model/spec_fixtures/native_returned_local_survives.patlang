# GitHub #228: a single-block function returning a list or string it produced
# itself must not decrement it at its own packed return ([value, globals]).
# The closure makes dynamic dispatch present, so callees use the packed
# return rather than the pure-function bare return.
# Given single-block functions that return a locally produced string and list,
# When their results are kept while 2000 unrelated allocations follow each call,
# Then every kept result still reads back intact (bad counts 0).
fn mk_str(a) {
  let s = substr(a, 0, 5)
  return s
}
fn mk_list(x) {
  let out = list_push([], x)
  let out = list_push(out, x + 1)
  return out
}
let ident = |z| { return z }
print(ident("closures present"))
let mut strs = []
let mut lists = []
let mut i = 0
while i < 2000 {
  strs = list_push(strs, mk_str("abcdefgh" + i))
  lists = list_push(lists, mk_list(i))
  let junk = [substr("zzzzzzzz" + i, 0, 6), [i, i]]
  i = i + 1
}
let mut bad_s = 0
let mut bad_l = 0
let mut j = 0
while j < 2000 {
  if strs[j] != "abcde" {
    bad_s = bad_s + 1
  }
  let l = lists[j]
  if l[0] != j {
    bad_l = bad_l + 1
  }
  j = j + 1
}
print("bad_s= " + bad_s + " bad_l= " + bad_l)
