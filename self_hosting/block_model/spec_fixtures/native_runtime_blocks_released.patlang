# Given loops that write a file from a byte list, grow a bool array, build an
#   object holding strings, and run exec_capture_io, each result replacing
#   the last,
# When they run natively,
# Then every result is right and none of the loops grows the heap.
# Each of these made its block with a raw allocation that was never freed:
# write_file_bytes' byte buffer, every bool array and the copy it grows
# into, every rt_object_new object (docs/plans/general-refcounting.md, 6d).
make a function called hu returns n
  return mem_peek_qword(mem_heap_state_addr(), 0)
end

make a function called write_bytes takes n returns ok
  let path = "self_hosting/build/native_runtime_blocks_released.bin"
  let ok = 0
  let i = 0
  while i < n do
    let ok = write_file_bytes(path, [80, 76, 33, i % 10 + 48])
    let i = i + 1
  end
  return ok
end

make a function called grow_bools takes n returns count
  let count = 0
  let i = 0
  while i < n do
    let b = bool_array_new(0)
    let j = 0
    while j < 100 do
      let b = bool_array_push(b, (j % 3) == 0)
      let j = j + 1
    end
    let count = count + bool_array_len(b)
    let i = i + 1
  end
  return count
end

make a function called objects takes n returns last
  let last = ""
  let i = 0
  while i < n do
    let o = rt_object_new(7, 2)
    rt_object_set(o, 0, "field " + i)
    rt_object_set(o, 1, [i, i + 1])
    let last = rt_object_get(o, 0)
    let i = i + 1
  end
  return last
end

make a function called capture_io takes n returns last
  let last = []
  let i = 0
  while i < n do
    let last = exec_capture_io("cmd", ["/c", "echo " + i], "", 0)
    let i = i + 1
  end
  return last
end

let w1 = write_bytes(5)
let h1 = hu()
print(write_bytes(2000))
print(read_file("self_hosting/build/native_runtime_blocks_released.bin"))
print("write_file_bytes bytes/run under 8: " + (((hu() - h1) / 2000) < 8))

let w2 = grow_bools(5)
let h2 = hu()
print(grow_bools(500))
print("bool array bytes/run under 8: " + (((hu() - h2) / 500) < 8))

let w3 = objects(5)
let h3 = hu()
print(objects(2000))
print("object bytes/run under 8: " + (((hu() - h3) / 2000) < 8))

let w4 = capture_io(3)
let h4 = hu()
print(list_get(capture_io(100), 0))
print("exec_capture_io bytes/run under 8: " + (((hu() - h4) / 100) < 8))
