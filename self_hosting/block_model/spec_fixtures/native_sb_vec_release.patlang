# Given a function that builds a string builder past several doublings,
#   reads it part-way, pushes a number, and a vec it pushes freshly built
#   strings to, sets, extends, and snapshots with vec_to_list before
#   changing it again,
# When it runs 2000 times natively,
# Then every result matches the interpreter's, the snapshot keeps the
#   contents it had when taken, and the heap does not grow with the
#   number of runs.
# A builder and a vec were indexes into tables that only grew, with every
# outgrown builder buffer and the final one left allocated; they are now
# counted cells the compiler releases like any other value.
make a function called hu returns n
  return mem_peek_qword(mem_heap_state_addr(), 0)
end

make a function called build takes k returns out
  let b = sb_new()
  let i = 0
  while i < 30 do
    sb_push(b, "line_" + i + ";")
    let i = i + 1
  end
  let early = sb_str(b)
  sb_push(b, k)
  let v = vec_new()
  vec_push(v, "a_" + k)
  vec_push(v, "b_" + k)
  let snap = vec_to_list(v)
  vec_set(v, 0, "c_" + k)
  vec_extend(v, ["d", "e_" + k])
  let all = vec_to_list(v)
  return [early.length, sb_str(b).length, snap, all, vec_len(v), vec_get(v, 3)]
end

print(build(7))
let h = hu()
let k = 0
let last = []
while k < 2000 do
  let last = build(k)
  let k = k + 1
end
print(last[2])
print("bytes/run under 64: " + (((hu() - h) / 2000) < 64))
