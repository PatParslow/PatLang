# Fixture for native_codegen.feature (GitHub #180): two sequential, sibling while
# loops at the top level (not nested). The first loop's own exit block is a
# trampoline into the second loop's head, and bm_lower_while pushes it to
# `pending` AFTER the second loop's real exit block, so their physical order in
# the flattened array does not match execution order. Expected: 0 1 2 100 101
# 102 done.

let a = 0
while a < 3 do
  print(a)
  let a = a + 1
end
let b = 0
while b < 3 do
  print(100 + b)
  let b = b + 1
end
print("done")
