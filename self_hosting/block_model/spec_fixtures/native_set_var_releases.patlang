# Given loops that store a fresh list, then a fresh string, under one
#   __vars key 2000 times,
# When built natively,
# Then the heap does not grow per iteration and the last values read back.
# set_var keeps its own reference to what it stores (rt_ns_set), so the
# caller's fresh value must be released after the call; it was not, and
# every set_var of a fresh value stayed on the heap (104 bytes a list,
# 48 a string here; gigabytes in a native compile of a large program).
make a function called hu returns n
  return mem_peek_qword(mem_heap_state_addr(), 0)
end
make a function called store_one takes i returns ok
  set_var("k", [i, i + 1, i + 2])
  return true
end
make a function called store_str takes i returns ok
  set_var("s", "v" + i)
  return true
end
let w = store_one(0)
let w = store_str(0)
let h = hu()
let k = 0
while k < 2000 do
  let w = store_one(k)
  let k = k + 1
end
print("list bytes/iter under 8: " + (((hu() - h) / 2000) < 8))
let h = hu()
let k = 0
while k < 2000 do
  let w = store_str(k)
  let k = k + 1
end
print("string bytes/iter under 8: " + (((hu() - h) / 2000) < 8))
print(get("__vars", "k"))
print(get("__vars", "s"))
