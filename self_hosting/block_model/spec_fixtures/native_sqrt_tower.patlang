# GitHub #229 and #211: sqrt, and float division and rational-float
# arithmetic, follow the numeric tower natively, as the interpreter
# does -- exact for perfect squares (Int and Rational), Float otherwise --
# including when its argument or result crosses a function call.
fn root(x) {
  return sqrt(x)
}

fn mag(a, b) {
  return sqrt(a * a + b * b)
}

let a = sqrt(1)
print("a=" + a + " " + type_of(a) + " " + (a == 1))
let b = root(16)
print("b=" + b + " " + type_of(b))
let c = root(1 / 4)
print("c=" + c + " " + type_of(c))
let d = sqrt(2.25)
print("d=" + d + " " + type_of(d))
let e = root(2)
print("e=" + e + " " + type_of(e) + " " + (e > 1.41) + " " + (e < 1.42))
let f = mag(3, 4)
print("f=" + f + " " + type_of(f))
let g = 1 / root(4)
print("g=" + g + " " + type_of(g))

fn per(p, n) {
  return p / to_num(n)
}

fn scale(t, k) {
  return t * k
}

let h = per(0.3, 2000)
print("h=" + h + " " + type_of(h))
let k = 1 / root(2)
print("k=" + k + " " + type_of(k))
let m = scale(43 / 10, k)
print("m=" + m + " " + type_of(m))

fn ipow(b, e) {
  return pow(b, e)
}

print("pow " + pow(2, 10) + " " + ipow(2, -1) + " " + ipow(1 / 2, 2) + " " + pow(10.0, 3) + " " + ipow(2, 0.5) + " " + type_of(ipow(3, 2)))
