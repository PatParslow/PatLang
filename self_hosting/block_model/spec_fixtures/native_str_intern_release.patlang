# Given a function that interns a freshly built string and reads it with
# sc_len, sc_code, sc_char and sc_substr,
# When it runs 2000 times natively,
# Then every read is the interpreter's and the heap does not grow with the
# number of runs. str_intern handed out the string's bare address, a
# reference nobody counted, so the fresh string was never released.
make a function called hu returns n
  return mem_peek_qword(mem_heap_state_addr(), 0)
end

make a function called scan takes k returns out
  let h = str_intern("token_" + k + "_end")
  return [sc_len(h), sc_code(h, 0), sc_char(h, 1), sc_substr(h, 6, 3)]
end

print(scan(123))
let h = hu()
let k = 0
let last = []
while k < 2000 do
  let last = scan(k)
  let k = k + 1
end
print(last)
print("bytes/run under 64: " + (((hu() - h) / 2000) < 64))
