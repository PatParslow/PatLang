# Given strings made by each runtime string producer -- read_file, indexing
#   a string, getenv, cwd, exec_capture --
# When their reference counts are read, and when they are stored in lists
#   and released many times,
# Then each starts with a count of exactly 1 and the heap stays consistent.
#
# A string-tagged word in the heap is reference-counted: its count sits in
# the word before the payload. Producers that allocated with rt_heap_alloc
# returned strings with no count word, so a retain or release changed the
# end of whatever block came before. The native interpreter crashed on
# its very first read_file this way, but only for some memory layouts.
make a function called rc takes s returns n
  return bm_rc_get(s band rt_payload_mask())
end
make a function called churn takes p, n returns total
  let total = 0
  let i = 0
  while i < n do
    let l = [read_file(p), "abc"[1], getenv("PATH"), cwd()]
    let total = total + list_len(l[0]) + list_len(l[1])
    let i = i + 1
  end
  return total
end
let p = "self_hosting/build/native_string_producers_counted.txt"
write_file(p, "abc")
print("read_file " + rc(read_file(p)))
print("index " + rc("xyz"[1]))
print("getenv " + rc(getenv("PATH")))
print("cwd " + rc(cwd()))
print("exec_capture " + rc(exec_capture("cmd", ["/c", "echo hi"])))
print("churn " + churn(p, 3000))
