# Fixture for native_codegen.feature: docs/plans/general-refcounting.md's
# retrofit of the single-block pass to per-terminal dominance
# (bm_nc_flat_index_dominates, native_codegen.patlang), generalizing the
# raw/loop pass's own bm_nc_raw_block_index_dominates fix to the
# flat-level pass that runs on every OTHER (non-loop) function.
#
# branch_guard creates its string ONLY on the path that does NOT take the
# early return -- a case the pre-retrofit uniform "dominates EVERY
# terminal" check unconditionally rejected (the early-return terminal's
# own index sits before s's own Store, so that check saw a terminal "at
# or before p" and excluded s from every terminal, including the one it
# actually dominates): s leaked on every fall-through call. After this
# retrofit, s's own creation point correctly dominates the SECOND
# terminal (nothing reaches it without already taking the fall-through
# path, which always creates s first) even though it does not dominate
# the early-return terminal (unreachable by construction -- that path
# never creates s at all, so there is nothing to decrement there either
# way).
#
# The warm-up call below must itself take the fall-through path (cond=0),
# not the early return -- confirmed directly: an earlier version of this
# fixture warmed up via the early-return path instead, leaving the
# string's own free-list size class never primed, so the growth check
# showed a small constant (24 bytes, two cold allocations) rather than
# zero -- not a logic bug in the pass, a fixture-warmup gap, the same
# "warm the exact path being measured" requirement native_string_rc_dec_
# early_return.patlang's own warm-up call already follows.

make a function called branch_guard takes cond, n returns r
  if cond > 0 then
    return 0
  end
  let s = chr(n)
  return n
end

let loop_count = 50000
let warm = branch_guard(0, 0)
let before = mem_peek_qword(mem_heap_state_addr(), 0)
let i = 0
let total = 0
while i < loop_count do
  let total = branch_guard(i % 2, i)
  let i = i + 1
end
let after = mem_peek_qword(mem_heap_state_addr(), 0)

print("total= " + total + " growth= " + (after - before))
