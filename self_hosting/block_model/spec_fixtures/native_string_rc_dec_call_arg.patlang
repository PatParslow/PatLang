# Fixture for native_codegen.feature: docs/plans/general-refcounting.md
# Phase 2's own narrowest-slice detection was never designed to
# disqualify a candidate for being PASSED as an argument to some OTHER
# function in between its creation and its eventual decrement point --
# bm_nc_insert_string_rc_decs only ever special-cases the instruction
# immediately before a terminal (is it the value being returned there),
# never anything else a local gets used for. This fixture makes that
# explicit and proven, not just assumed from the absence of a
# disqualifying check: build_and_print creates a string, passes it to
# print() (an ordinary external call, ordinary argument-passing, well
# before the eventual decrement), then returns something else entirely.
# If the decrement were somehow happening too early (before print's own
# use), the printed character would be corrupted; if too late, the heap
# would grow. Checked both ways in the same run: the real heap's own
# bump-pointer stays flat after warm-up, AND a handful of printed
# characters match pat --ir-run exactly.

make a function called build_and_print takes n returns r
  let s = chr(n)
  print(s)
  return n
end

let warm = build_and_print(65)
let before = mem_peek_qword(mem_heap_state_addr(), 0)
let i = 0
while i < 20 do
  let r = build_and_print(65 + (i % 10))
  let i = i + 1
end
let after = mem_peek_qword(mem_heap_state_addr(), 0)
print("growth= " + (after - before))
