# Fixture for native_codegen.feature: generalizes this plan's own
# second increment to a genuine early return -- a function with
# MULTIPLE reachable exit points, not just one. build_guard creates a
# string unconditionally before any branching at all, then has an early
# return; since the string's own creation dominates every terminal
# (nothing can reach ANY exit without having created it first),
# bm_nc_local_dominates_all_terminals (native_codegen.patlang)
# correctly allows a decrement at EACH of them, not just one.

make a function called build_guard takes n, cond returns r
  let s = chr(n)
  if cond > 0 then
    return 0
  end
  return n
end

let loop_count = 50000
let warm = build_guard(0, 1)
let before = mem_peek_qword(mem_heap_state_addr(), 0)
let i = 0
let total = 0
while i < loop_count do
  let total = build_guard(total, i % 2)
  let i = i + 1
end
let after = mem_peek_qword(mem_heap_state_addr(), 0)

print("total= " + total + " growth= " + (after - before))
