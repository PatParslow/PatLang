# Fixture for native_codegen.feature: docs/plans/general-refcounting.md
# Phase 2's own loop increment -- the single biggest real-world win
# this whole plan has targeted (strings built and discarded inside a
# while loop is the original motivating case for refcounting at all).
#
# sum_lens is a multi-block closure (a while loop is ALWAYS modeled
# this way: a head block, here combined with the body, connected to
# itself via a back-edge JumpBlock and to an exit block via another).
# `s` is created fresh each iteration, used for nothing, discarded. Its
# own creation point dominates the BACK-EDGE exit (reached only by
# running the loop body, which always creates s first) but NOT the
# LOOP-EXIT path (reached directly by the condition's own JumpIfFalse,
# which skips the body -- and s's own creation -- entirely when the
# loop is about to end) -- bm_nc_raw_block_index_dominates
# (native_codegen.patlang) decides this per exit, independently, not
# once for the whole function the way the single-block passes do.
#
# Built through the ordinary --x64 CLI (build_native.patlang's own
# separate harness has its own, now-fixed issue #219, unrelated to this
# feature, worked around the same way earlier fixtures in this
# directory already do). Loop count large enough that any growth-per-
# iteration, however small, would be unmistakable against the flat
# baseline this claim actually makes.

make a function called sum_lens takes n returns r
  let total = 0
  let i = 0
  while i < n do
    let s = chr(i)
    let total = total + 1
    let i = i + 1
  end
  return total
end

let warm = sum_lens(1)
let before = mem_peek_qword(mem_heap_state_addr(), 0)
let result = sum_lens(50000)
let after = mem_peek_qword(mem_heap_state_addr(), 0)
print("result= " + result + " growth= " + (after - before))
