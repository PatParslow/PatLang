# Fixture for native_codegen.feature: generalizes native_string_rc_dec_
# no_leak.patlang's own claim beyond branch-free functions. build_merge
# has internal Jump/JumpIfFalse (a merging if/else that conditionally
# recomputes `extra`, never re-touching `s`), but still has exactly one
# reachable terminal -- every jump target lands before it, not at or
# past it, unlike a genuine early return. bm_nc_closure_has_unambiguous_
# single_terminal (native_codegen.patlang) now recognizes this shape as
# eligible; the earlier, stricter version of this check (zero internal
# Jump/JumpIfFalse at all) would have rejected it outright, missing a
# common, safe-to-handle real-world shape.

make a function called build_merge takes n, cond returns r
  let extra = 0
  let s = chr(n)
  if cond > 0 then
    let extra = 1
  end
  return n
end

let loop_count = 50000
let warm = build_merge(0, 1)
let before = mem_peek_qword(mem_heap_state_addr(), 0)
let i = 0
let total = 0
while i < loop_count do
  let total = build_merge(total, i % 2)
  let i = i + 1
end
let after = mem_peek_qword(mem_heap_state_addr(), 0)

print("total= " + total + " growth= " + (after - before))
