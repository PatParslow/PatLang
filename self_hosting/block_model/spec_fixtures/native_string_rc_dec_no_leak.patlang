# Fixture for native_codegen.feature, docs/plans/general-refcounting.md
# Phase 2's own first real increment. build_and_discard is deliberately
# branch-free (one block, so bm_nc_closure_is_branch_free's own
# eligibility check applies): it builds a string via chr (one of the 8
# known producers) into a local never reassigned/returned/captured,
# then returns something else entirely -- exactly the shape bm_nc_
# insert_string_rc_decs targets. Calling it LOOP_COUNT times and
# checking the real heap's own bump-pointer high-water mark stays
# EXACTLY flat is a direct, zero-tolerance proof that the inserted
# rt_string_rc_dec call genuinely reclaims the memory, not just that
# strings allocate through bm_alloc (confirmed separately and earlier
# in this same plan, native_call_pure_no_leak.patlang) -- that alone
# does NOT reclaim anything without an actual decrement call.

make a function called build_and_discard takes n returns r
  let s = chr(n)
  return n
end

let loop_count = 50000
let warm = build_and_discard(0)
let before = mem_peek_qword(mem_heap_state_addr(), 0)
let i = 0
let total = 0
while i < loop_count do
  let total = build_and_discard(total)
  let i = i + 1
end
let after = mem_peek_qword(mem_heap_state_addr(), 0)

print("total= " + total + " growth= " + (after - before))
