# Fixture for native_codegen.feature: docs/plans/general-refcounting.md's
# "reassigned locals" increment (deferred item from Phase 2's single-block
# dominance retrofit). A local reassigned from TWO SEPARATE string-producer
# calls -- `let s = chr(n); ...; let s = chr(n + 1); ...` -- was previously
# excluded entirely from the decrement pass (store_count == 1 gate), so
# BOTH the original value (overwritten, never decremented) and the final
# value (discarded, never returned) leaked on every call.
#
# Given: reassign_twice(n) builds a string via chr(n), reassigns the SAME
#   local to a second string via chr(n + 1), and never returns or otherwise
#   uses either string value.
# When: called many times in a warm loop.
# Then: heap growth is exactly zero -- both the overwritten first value
#   (decremented at the reassignment point) and the final discarded value
#   (decremented at the terminal, since the local's FIRST store dominates
#   it) are reclaimed.

make a function called reassign_twice takes n returns r
  let s = chr(n % 26 + 65)
  let s = chr((n + 1) % 26 + 65)
  return n
end

let loop_count = 50000
let warm = reassign_twice(0)
let before = mem_peek_qword(mem_heap_state_addr(), 0)
let i = 0
let total = 0
while i < loop_count do
  let total = reassign_twice(i)
  let i = i + 1
end
let after = mem_peek_qword(mem_heap_state_addr(), 0)

print("total= " + total + " growth= " + (after - before))
