# Given functions whose last statement is a tail call -- `return f(g(), h())`
# with fresh lists made in the argument list, and `return f(g(), v)` passing a
# local that holds a fresh list -- as raytrace's
# `return versor_matrix(cga_translator(x, y, z))` and
# `return ga_sub(ga_scalar(1), ga_scale(v_einf, 1/2))`,
# When they are called in a loop, built natively,
# Then the values are the interpreter's and the heap stays flat: a tail call
# hands its fresh arguments on to the callee's parameters, which own them and
# release them at the callee's exits. Before, a tail call whose arguments were
# not plain loads left every argument behind (about 1 KB per translation()
# call in raytrace, most of ch37's 16 GB).
make a function called hu returns n
  return mem_peek_qword(mem_heap_state_addr(), 0)
end
make a function called mk takes x returns l
  return [x, x, x, x, x, x, x, x]
end
make a function called sum2 takes a, b returns l
  let r = []
  let i = 0
  while i < 8 do
    let r = list_push(r, a[i] + b[i])
    let i = i + 1
  end
  return r
end
make a function called first_of takes a, b returns v
  return a[0] + b[0]
end
make a function called tail_fresh takes x returns l
  return sum2(mk(x), mk(2))
end
make a function called tail_local takes x returns l
  let v = mk(x)
  return sum2(mk(1), v)
end
make a function called tail_mixed takes x, keep returns v
  return first_of(keep, mk(x))
end
make a function called run takes n, keep returns total
  let total = 0
  let i = 0
  while i < n do
    let a = tail_fresh(i)
    let b = tail_local(i)
    let total = total + a[0] + b[7] + tail_mixed(i, keep)
    let i = i + 1
  end
  return total
end
let keep = [5, 6]
let warm = run(100, keep)
let h = hu()
print(run(20000, keep))
print(keep)
print("tail call args bytes/iter under 8: " + (((hu() - h) / 20000) < 8))
