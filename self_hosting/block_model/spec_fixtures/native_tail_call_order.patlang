# Fixture for native_codegen.feature (GitHub #180): a function whose body is a tail
# call to a function declared EARLIER in the source. The flattened body used to
# start in the callee, so the caller ran the callee with the wrong arguments.
# Expected: [A], then [B], then [x, C].

make a function called lc takes l returns out
  let out = []
  let n = list_len(l)
  let i = 0
  while i < n do
    let out = list_push(out, l[i])
    let i = i + 1
  end
  return out
end
make a function called app takes l, v returns out
  let out = lc(l)
  return list_push(out, v)
end
make a function called tailapp takes l, v returns out
  return app(l, v)
end
print(app([], "A"))
print(tailapp([], "B"))
print(tailapp(["x"], "C"))
