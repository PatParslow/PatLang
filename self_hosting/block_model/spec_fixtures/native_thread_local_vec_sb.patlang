# Given parallel_map workers that each build a vec and a string builder at
# the same time,
# When built natively and run,
# Then each worker's vec and builder are its own values, as interpreted,
# and no worker sees another's pushes: eight distinct vecs come back. The
# native tables were one process-wide slot each, so workers raced on them
# (raytrace ch37). A vec and a builder are values now, not handles into a
# table (docs/plans/general-refcounting.md, 6e/6f).
make a function called work takes item returns r
  let h = vec_new()
  let b = sb_new()
  let k = 0
  while k < 2000 do
    vec_push(h, item * 10000 + k)
    sb_push(b, "x")
    let k = k + 1
  end
  let sum = 0
  let k = 0
  while k < vec_len(h) do
    let sum = sum + vec_get(h, k) - item * 10000
    let k = k + 1
  end
  return [h, vec_len(h), sum, sb_str(b).length]
end
let rs = parallel_map([1, 2, 3, 4, 5, 6, 7, 8], "work")
let ok = 0
let distinct = 0
let k = 0
while k < rs.length do
  if (rs[k][1] == 2000) and (rs[k][2] == 1999000) and (rs[k][3] == 2000) then
    let ok = ok + 1
  end
  let same = 0
  let j = 0
  while j < rs.length do
    if rs[j][0] == rs[k][0] then
      let same = same + 1
    end
    let j = j + 1
  end
  if (same == 1) and (type_of(rs[k][0]) == "vec") then
    let distinct = distinct + 1
  end
  let k = k + 1
end
print("ok " + ok + " of " + rs.length)
print("distinct vecs " + distinct)
