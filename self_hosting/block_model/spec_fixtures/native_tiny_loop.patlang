# Fixture for spec_library/block_model/native_codegen.feature (Phase 9).
# Small on purpose: this exact 3-iteration shape is what caught a real
# infinite-loop bug in native_codegen.patlang's own JumpIfFalse target
# fixup (see that file's own header) -- a small loop hangs fast and
# obviously, where a large one just looks like it's "still running" for
# a while before eventually crashing from unbounded bigint growth.

make a function called start returns r
  let sum = 0
  let i = 0
  while i < 3 do
    let sum = sum + i
    let i = i + 1
  end
  print(sum)
end
