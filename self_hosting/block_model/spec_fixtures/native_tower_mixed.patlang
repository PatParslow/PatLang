# GitHub #229 follow-ups: numeric-tower values in block-model code, natively,
# as the interpreter has them -- negating a Rational, a raw float literal
# stored in a list and read back, string + float, sb_push of non-strings,
# comparing a boxed float
# with an int and with a float literal, and comparing parameters.
fn plus(a, b) {
  return a + b
}

fn gt(a, b) {
  return a > b
}

fn root(x) {
  return sqrt(x)
}

let x = plus(1, -(1/2))
print("x=" + x + " " + type_of(x))
let ss = [2, -3, (1/3), 0.7]
let s = ss[3] + 5
print("s=" + s)
let d = 2.25
print("d=" + d)
let e = root(2)
print("cmp " + gt(e, 2) + " " + gt(e, 1) + " " + gt(2, e) + " " + (e > 1.41) + " " + (e < 1.42))
print("rat " + gt(1/2, 1/3) + " " + (plus(1/2, 1/2) == 1))
let sb = sb_new()
sb_push(sb, 42)
sb_push(sb, ",")
sb_push(sb, 1/2)
sb_push(sb, ",")
sb_push(sb, s)
print("sb " + sb_str(sb))
fn huge() {
  return pow(10.0, 308) * 10
}
print("inf " + huge() + " " + (0.0 - huge()) + " " + (huge() > 1) + " " + pow(10.0, 308))
fn modf(a, b) {
  return a % b
}
print("floor " + floor(root(2)) + " " + type_of(floor(root(2))) + " " + floor(7 / 2) + " mod " + modf(3.5, 2) + " " + modf(-3.5, 2) + " " + modf(7, 2.5))
print("mm " + max(3, 1/2) + " " + min(1/2, 3/10) + " " + type_of(max(1, 2)))
