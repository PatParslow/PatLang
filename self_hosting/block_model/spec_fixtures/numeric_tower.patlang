# Driver fixture for spec_library/block_model/numeric_tower.feature
# (Phase 16): each block computes one arithmetic result and prints its
# own type_of, proving auto-promotion round-trips correctly through this
# engine's Const/Bin instructions with no special-casing needed.

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let src = "make a function called start returns r
  let overflowed = 9223372036854775807 + 1
  print(type_of(overflowed))
  let divided = 1 / 3
  print(type_of(divided))
  let plain = 2 + 3
  print(type_of(plain))
  let mixed = 2.5 + 1
  print(type_of(mixed))
end
"

let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)
bi_run(prog)
