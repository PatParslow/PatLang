# Driver fixture for spec_library/block_model/object_handler.feature.
# `h` is an ORDINARY value (unlike "__globals", never auto-threaded) --
# `start` builds it and passes it EXPLICITLY to `use_handler` as an actual
# declared parameter, demonstrating Fork B's other resolution: a
# deliberate name lives in a plain, explicitly-scoped value, not something
# ambient. Two names registered in the SAME handler resolve independently.
# Runs entirely under the interpreter.

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let src = "make a function called start returns r
  let h = handler_new()
  let h = handler_register(h, \"alice\", 111)
  let h = handler_register(h, \"bob\", 222)
  return use_handler(h)
end

make a function called use_handler takes h returns r
  print(handler_lookup(h, \"alice\"))
  print(handler_lookup(h, \"bob\"))
end
"

let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)
bi_run(prog)
