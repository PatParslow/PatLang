# Driver fixture for spec_library/block_model/object_orientation.feature
# (Phase 13), scenario 1: field defaults are applied at construction.
#
# Native x64 only (like Phase 3/7): an object here is a Box wrapping a
# Handler-shaped assoc-list, and Box's own functions (heap.patlang) are
# native-x64-only -- confirmed directly (host fn 'rt_heap_alloc' not
# found under --ir-run) before assuming otherwise, same finding Phase 1
# already made for Box in general.
#
#   ./patc1.exe self_hosting/block_model/spec_fixtures/oo_field_defaults.patlang self_hosting/build/bm_oo_field_defaults.exe --x64

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let src = "class Point do
  field x = 10
  field y = 20
end

make a function called start returns r
  let p = new(\"Point\")
  print(p.x)
  print(p.y)
end
"

let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)
bi_run(prog)
