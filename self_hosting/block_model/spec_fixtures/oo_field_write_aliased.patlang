# Driver fixture for spec_library/block_model/object_orientation.feature
# (Phase 13), scenario 3: a field write through an ALIASED mut reference
# (refcount 2, via box_share -- the object IS a Box, so this is the exact
# same aliasing mechanism Phase 3 already proved for a plain box_new(10))
# clones rather than mutating in place -- the mut reference's own local is
# automatically re-pointed at the clone (this engine's own answer to the
# plan's flagged "does mut extend to field writes" question), while the
# other alias keeps reading the ORIGINAL object, untouched.
#
#   ./patc1.exe self_hosting/block_model/spec_fixtures/oo_field_write_aliased.patlang self_hosting/build/bm_oo_field_write_aliased.exe --x64

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let src = "class Counter do
  field n = 0
end

make a function called start returns r
  let c = new(\"Counter\")
  return use_alias(c)
end

make a function called use_alias takes mut_c returns r
  let alias = box_share(mut_c)
  mut_c.n = 99
  print(alias.n)
  print(mut_c.n)
end
"

let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)
bi_run(prog)
