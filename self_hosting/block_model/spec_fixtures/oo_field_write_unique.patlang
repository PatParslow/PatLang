# Driver fixture for spec_library/block_model/object_orientation.feature
# (Phase 13), scenario 2: a field write through a uniquely-owned mut
# reference mutates in place, and the new value is visible on the next
# read (from a DIFFERENT block, reached via a jump carrying the object
# forward -- the same jump-chain-carries-data pattern every earlier phase
# already uses, since this engine has no call-with-return for ordinary
# functions, only for Emit's own bounded exception, Phase 10).
#
#   ./patc1.exe self_hosting/block_model/spec_fixtures/oo_field_write_unique.patlang self_hosting/build/bm_oo_field_write_unique.exe --x64

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let src = "make a function called start returns r
  let c = new(\"Counter\")
  return bump(c)
end

make a function called bump takes mut_c returns r
  mut_c.n = 99
  return show(mut_c)
end

make a function called show takes c returns r
  print(c.n)
end

class Counter do
  field n = 0
end
"

let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)
bi_run(prog)
