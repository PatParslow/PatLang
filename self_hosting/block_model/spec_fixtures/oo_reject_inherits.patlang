# Driver fixture for spec_library/block_model/object_orientation.feature
# (Phase 13), scenario 4a: a class declaring `inherits` is rejected
# plainly at LOWERING time -- before any Box instruction is ever emitted,
# so this runs fine under the plain interpreter, no native x64 needed.

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let src = "class Base do
  field x = 1
end

class Derived inherits Base do
  field y = 2
end

make a function called start returns r
  print(1)
end
"

let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)
bi_run(prog)
