# Reference for spec_library/block_model/parallel_map.feature (GitHub issue
# #176, threads half): parallel_map(items, "fn") run directly under the real
# engine. The worker is a declared function taking one item.

make a function called start returns r
  let sq = parallel_map([1, 2, 3, 4, 5], "square")
  print(sq)
  let words = parallel_map(["a", "bb", "ccc"], "measure")
  print(words)
  let none = parallel_map([], "square")
  print(list_len(none))
end

make a function called square takes x returns r
  return x * x
end

make a function called measure takes s returns r
  return s.length + 100
end

start()
