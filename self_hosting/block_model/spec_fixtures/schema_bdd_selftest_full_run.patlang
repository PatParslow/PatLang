# Driver fixture (Phase 22, third checkpoint attempt): the REAL, unmodified
# self_hosting/schema_bdd_selftest.patlang, with real `include` expansion
# applied (self_hosting/lib/includes.patlang's own expand_includes --
# see this project's plan doc, Phase 22's methodology finding: the
# self-hosted lexer/parser has NO include-handling of its own), lowered
# through bm_lower_program and actually RUN via bi_run_from -- not just
# lowered. This is Phase 18's own original checkpoint, re-attempted with
# every fix landed so far (nested-while, ambient-state ports, apply()/
# CallDynamic, the compat-shim exclusion, and now .length).
#
# Reads t_pass/t_fail out of the RETURNED final __globals (via
# bm_rt_assoc_get), not by calling get_global() from this driver's own
# scope -- get_global under block-model compiles to GlobalGet against the
# program's own internal __globals List threaded through locs, a
# completely separate store from this driver's own ambient set_var/get
# (the mistake that produced the earlier t_pass=0/t_fail=0 false positive
# before this was understood).

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../../lib/includes.patlang"
include "../lower.patlang"
include "../interp.patlang"

let raw = read_file("self_hosting/schema_bdd_selftest.patlang")
let src = expand_includes(raw, "self_hosting")
let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)

# The real file's own entry point is its trailing bare statement
# `run_schema_bdd_selftest()`, not its first declared Func -- bm_lower_
# program only recognizes top-level "Func"/"When" statements (a named,
# not-yet-fixed engine gap), so that bare call is silently never invoked
# by bi_program_entry's own "first declared Func" convention. Named
# directly here instead, matching every other block-model test harness's
# established workaround for this same gap.
bi_init_run_state()
let entry = bi_find_block(prog, "run_schema_bdd_selftest")
let locs = bm_loc_set(bm_loc_new(), "__globals", [])
let outcome = bi_run_from(prog, entry, locs)
let final_globals = bm_loc_get(list_get(outcome, 1), "__globals")
print("---")
print("t_pass=" + bm_rt_assoc_get(final_globals, "t_pass"))
print("t_fail=" + bm_rt_assoc_get(final_globals, "t_fail"))
