# Generic driver for spec_library/block_model/library_selftest_parity.feature
# (Phase 18's checkpoint, generalized): runs ONE real, unmodified selftest
# program through bm_lower_program / bi_run_from -- with real `include`
# expansion (the self-hosted lexer/parser has none of its own) -- and
# prints exactly what the program itself prints, then a "---" line and the
# pass/fail counts read out of the run's OWN final __globals.
#
# The counts are read from the returned globals, never via get_global() in
# this driver's own scope: under block-model those live in a separate store
# from the driver's ambient one, and reading the wrong one produced an
# earlier vacuous t_pass=0 / t_fail=0 that looked like success.
#
# Usage (from the repo root):
#   pat --ir-run self_hosting/block_model/spec_fixtures/selftest_under_block_model.patlang <path to selftest>

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../../lib/includes.patlang"
include "../lower.patlang"
include "../interp.patlang"

let args = argv()
let path = list_get(args, 0)
let raw = read_file(path)
let src = expand_includes(raw, "self_hosting")
let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)
bi_init_run_state()
let entry = bi_find_block(prog, bi_program_entry(prog))
let locs = bm_loc_set(bm_loc_new(), "__globals", [])
let outcome = bi_run_from(prog, entry, locs)
let final_globals = bm_loc_get(list_get(outcome, 1), "__globals")
print("---")
print("t_pass=" + bm_rt_assoc_get(final_globals, "t_pass"))
print("t_fail=" + bm_rt_assoc_get(final_globals, "t_fail"))
