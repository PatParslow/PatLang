# Driver fixture for spec_library/block_model/system_integration.feature
# (Phase 17): `start` writes a string to a scratch file, then jumps to
# `read_it` (a completely separate block), which reads it back --
# confirming the round-trip through this engine's own ReadFile/WriteFile
# instructions, which just call the real host functions directly.

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let src = "make a function called start returns r
  write_file(\"self_hosting/build/bm_system_integration_scratch.txt\", \"hello from the block model\")
  return read_it()
end

make a function called read_it returns r
  print(read_file(\"self_hosting/build/bm_system_integration_scratch.txt\"))
end
"

let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)
bi_run(prog)
