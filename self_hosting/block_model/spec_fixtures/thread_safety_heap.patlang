# Native-only fixture for spec_library/block_model/thread_safety.feature
# (GitHub issue #176, thread-safety half). Real OS threads hammer the
# refcounted heap (heap.patlang) directly. Phase one: four threads each do
# 200000 inc/dec pairs on ONE shared block that the main thread also holds,
# so its count must come back to exactly 1. Phase two: four threads each
# allocate, write their own tag, spin briefly, read it back, and free, 20000
# times; a block handed to two threads at once shows up as a wrong read-back.
# Prints the final count, then the total number of wrong read-backs.
#
# Worker bodies use only heap.patlang and raw memory intrinsics, never
# set_var/get: the runtime documents that a spawned closure must not.

include "../heap.patlang"

make a function called ts_rc_worker takes p, n returns r
  let i = 0
  while i < n do
    bm_rc_inc(p)
    bm_rc_dec(p, 8)
    let i = i + 1
  end
  return 1
end

make a function called ts_alloc_worker takes tag, n returns bad
  let bad = 0
  let i = 0
  while i < n do
    let q = bm_alloc(8)
    bm_box_write(q, tag)
    let j = 0
    while j < 30 do
      let j = j + 1
    end
    if bm_box_read(q) != tag then
      let bad = bad + 1
    end
    bm_rc_dec(q, 8)
    let i = i + 1
  end
  return bad
end

bm_heap_init()
let p = bm_alloc(8)
bm_box_write(p, 7)
let n = 200000
let a1 = thread_spawn(|| { ts_rc_worker(p, n) })
let a2 = thread_spawn(|| { ts_rc_worker(p, n) })
let a3 = thread_spawn(|| { ts_rc_worker(p, n) })
let a4 = thread_spawn(|| { ts_rc_worker(p, n) })
while not (thread_poll(a1) and thread_poll(a2) and thread_poll(a3) and thread_poll(a4)) do
  let spin = 0
end
print(bm_rc_get(p))

let m = 20000
let b1 = thread_spawn(|| { ts_alloc_worker(1001, m) })
let b2 = thread_spawn(|| { ts_alloc_worker(1002, m) })
let b3 = thread_spawn(|| { ts_alloc_worker(1003, m) })
let b4 = thread_spawn(|| { ts_alloc_worker(1004, m) })
while not (thread_poll(b1) and thread_poll(b2) and thread_poll(b3) and thread_poll(b4)) do
  let spin = 0
end
print(thread_result(b1) + thread_result(b2) + thread_result(b3) + thread_result(b4))
