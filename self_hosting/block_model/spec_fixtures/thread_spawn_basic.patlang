# RED/GREEN fixture for GitHub #184: thread_spawn/thread_poll/thread_result
# written in block-model SOURCE (not calling the x64 runtime's thread_spawn
# directly, as spec_fixtures/thread_safety_heap.patlang already does).
#
# Given: a block-model program whose `main` spawns a thread running a
#   zero-param closure that captures a value and returns a computed result.
# When: compiled via patc1.exe <src> <out> --x64 (native only -- thread_spawn
#   has no interpreter equivalent in the real engine either, so this is not
#   compared against pat --ir-run).
# Then: polling until done, thread_result returns the closure's own value.

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let src = "
make a function called start returns r
  let x = 21
  let f = || do
    return x * 2
  end
  let id = thread_spawn(f)
  let done = false
  while not done do
    let done = thread_poll(id)
  end
  return thread_result(id)
end
"

let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)
bi_run(prog)
