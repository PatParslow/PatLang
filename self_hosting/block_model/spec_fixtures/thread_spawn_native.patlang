# Native-only fixture for spec_library/block_model/thread_spawn.feature
# (GitHub issue #184). thread_spawn/thread_poll/thread_result written in
# block-model SOURCE, not calling the x64 runtime's thread_spawn directly
# the way spec_fixtures/thread_safety_heap.patlang does.
#
# Spawns a thread running a zero-param closure that captures `x` and
# computes a value, polls until done, then reads the result back and
# prints it. Prints "ok" afterward too, so the shell check (below) can
# tell "correct result but then crashed on the way out" apart from a
# genuinely clean exit -- real distinction this feature's own
# implementation hit (a stack-imbalance bug surfaced only after the
# result printed correctly, during program teardown).

make a function called start returns r
  let x = 21
  let f = || do
    return x * 2
  end
  let id = thread_spawn(f)
  let done = false
  while not done do
    let done = thread_poll(id)
  end
  print(thread_result(id))
  print("ok")
  return 0
end
