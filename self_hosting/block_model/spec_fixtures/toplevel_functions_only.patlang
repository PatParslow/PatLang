# Driver fixture for spec_library/block_model/toplevel_statements.feature
# (issue #155): regression guard -- a program with ONLY function
# declarations (no top-level statements) must still enter at its FIRST
# declared function, exactly as before top-level statement support. Every
# earlier fixture in this tree relies on this rule.

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let src = "make a function called start returns r
  print(1)
  return second()
end

make a function called second returns r
  print(2)
end

make a function called never_entered returns r
  print(999)
end
"

let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)
bi_run(prog)
