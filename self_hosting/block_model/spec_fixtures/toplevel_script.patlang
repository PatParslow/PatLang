# Driver fixture for spec_library/block_model/toplevel_statements.feature
# (GitHub issue #155): a SCRIPT-STYLE program -- top-level `let`, bare
# calls to declared functions, `if` and `while` -- with the declared
# function placed FIRST, so the old "entry = first declared function"
# rule would run `double_print` with no argument bound instead of the
# script's own body.

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let src = "make a function called double_print takes x returns r
  print(x * 2)
  return true
end

let a = 5
double_print(a)
let b = a + 1
double_print(b)
if b > 5 then
  print(100)
else
  print(200)
end
let i = 0
while i < 3 do
  double_print(i)
  let i = i + 1
end
print(999)
"

let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)
bi_run(prog)
