# Reference for spec_library/block_model/toplevel_statements.feature
# (issue #155): the SAME source as toplevel_script.patlang's own inner
# `src`, run directly as an ordinary PatLang program.

make a function called double_print takes x returns r
  print(x * 2)
  return true
end

let a = 5
double_print(a)
let b = a + 1
double_print(b)
if b > 5 then
  print(100)
else
  print(200)
end
let i = 0
while i < 3 do
  double_print(i)
  let i = i + 1
end
print(999)
