# Driver fixture for spec_library/block_model/toplevel_statements.feature
# (issue #155): a top-level construct the lowerer does not support must
# fail LOUDLY, not vanish. An un-expanded `include "x.patlang"` line is the
# real-world case: the self-hosted parser turns it into a bare `include`
# expression plus a stray string literal, which used to be dropped
# silently -- the root of an earlier methodology gap where "X lowers
# completely" claims never exercised X's own includes.

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let src = "include \"some_library.patlang\"

make a function called start returns r
  print(1)
end
"

let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)
bi_run(prog)
