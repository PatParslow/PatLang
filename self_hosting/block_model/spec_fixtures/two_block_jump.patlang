# Driver fixture for spec_library/block_model/block_dispatch.feature.
# Two blocks: `start` computes two locals and jumps to `combine`, handing
# them across by name; `combine` uses ONLY what the jump gave it. Run via
# exec_capture (self_hosting/lib/spec_steps_language.patlang's own
# established pattern) rather than in-process, matching every other
# guaranteed-fail-capable scenario in this repo's spec suites.

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let src = "make a function called start returns r
  let x = 10
  let y = 20
  return combine(x, y)
end

make a function called combine takes a, b returns r
  let s = a + b
  print(s)
end
"

let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)
bi_run(prog)
