# Driver fixture for spec_library/block_model/block_dispatch.feature.
# `reveal` takes NO params, so the jump from `start` hands it an entirely
# empty pointer -- `hidden` is a real local of `start`'s, never part of
# what reveal() was jumped with, so referencing it inside `reveal` must be
# a guaranteed-fail unbound-variable error (section 3.2's own guarantee),
# not silent access to `start`'s leftover state.

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../lower.patlang"
include "../interp.patlang"

let src = "make a function called start returns r
  let hidden = 99
  return reveal()
end

make a function called reveal returns r
  print(hidden)
end
"

let toks = tokenize(src)
let ast = parse_program(toks)
let prog = bm_lower_program(ast)
bi_run(prog)
