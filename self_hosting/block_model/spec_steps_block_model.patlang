# Step registrations for spec_library/block_model/*.feature, run through
# self_hosting/lib/test.patlang's real Gherkin runner (the same framework
# self_hosting/lib/spec_steps_language.patlang uses for the standing
# language-spec gate) -- never a separate, ad hoc runner.
#
# This suite is deliberately NOT wired into
# self_hosting/tools/run_language_spec_suite.patlang or its standing gate:
# the Block Ownership Model (docs/plans/block-ownership-model.md) is a
# fresh, separate execution path that changes nothing about today's
# language semantics unless and until it's merged. See
# self_hosting/block_model/run_block_model_spec_suite.patlang for this
# suite's own runner.
#
# One register_*_steps() function per phase, added as each phase's RED step
# is written -- never retrofitted after the fact.

make a function called st_noop returns done
  return true
end

# ---- Phase 2: block_dispatch.feature ----
# exec_capture on dedicated fixtures (self_hosting/block_model/spec_fixtures/),
# not in-process calls -- one scenario is a genuine guaranteed-fail
# contract_check violation (fatal, out of process), matching
# require_ensure_assert.feature's own established pattern
# (self_hosting/lib/spec_steps_language.patlang).

make a function called register_block_dispatch_steps returns done
  step("a program with two blocks joined by one jump carrying two values", "st_noop")
  step("the program runs", "st_noop")
  step("the second block computes the correct result using only what the jump handed it", "st_block_jump_values_arrive")
  step("a program where the second block references a name only the first block has", "st_noop")
  step("it fails with a guaranteed unbound-variable error naming that variable", "st_block_jump_unbound_fails")
  return true
end

make a function called register_mut_parameters_steps returns done
  step("a block with a mut parameter holding the only reference to a box", "st_noop")
  step("it mutates that box", "st_noop")
  step("the same box is mutated in place, not cloned", "st_mut_in_place")
  step("a block with a read-only parameter holding a reference to a box", "st_noop")
  step("it attempts to mutate that box", "st_noop")
  step("it fails with a guaranteed error naming that parameter", "st_immut_rejected")
  step("a block with a mut parameter holding one of two live references to the same box", "st_noop")
  step("a fresh box is produced and the other reference's own value is untouched", "st_mut_clone_on_alias")
  return true
end

make a function called st_block_jump_values_arrive returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/two_block_jump.patlang")
  return check("combine(10, 20) prints 30", contains_text(out, "30"), true)
end

make a function called st_block_jump_unbound_fails returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/unbound_variable.patlang")
  let a = check("names the unbound variable \"hidden\"", contains_text(out, "unbound in this block's own pointer: hidden"), true)
  let b = check("never reaches printing hidden's value 99 (the violation is caught before it prints)", contains_text(out, "99"), false)
  return a and b
end

# ---- Phase 3: mut_parameters.feature ----
# Native x64 only, like Phase 1 -- heap.patlang's functions don't exist
# under the interpreter (checked directly). exec_capture("./patc1.exe",
# fixture, exe_path, "--x64") to build, then exec_capture(exe_path) to run
# and check its own printed output, mirroring the existing
# x64_tag_collision_prevention_sweep.feature's own established two-step
# pattern (self_hosting/lib/spec_steps_language.patlang).

make a function called st_mut_in_place returns ok
  exec_capture("./patc1.exe", "self_hosting/block_model/spec_fixtures/mut_param_in_place.patlang", "self_hosting/build/bm_mut_param_in_place.exe", "--x64")
  let out = exec_capture("self_hosting/build/bm_mut_param_in_place.exe")
  let a = check("box_set on a refcount-1 mut param returns the SAME pointer (mutated in place)", contains_text(out, "true"), true)
  let b = check("the mutated box now reads 99", contains_text(out, "99"), true)
  return a and b
end

make a function called st_immut_rejected returns ok
  exec_capture("./patc1.exe", "self_hosting/block_model/spec_fixtures/immut_param_rejected.patlang", "self_hosting/build/bm_immut_param_rejected.exe", "--x64")
  let out = exec_capture("self_hosting/build/bm_immut_param_rejected.exe")
  let a = check("names the read-only parameter \"b\"", contains_text(out, "box_set on read-only parameter 'b'"), true)
  let b = check("never reaches printing the mutated value 99 (the violation is caught before it prints)", contains_text(out, "99"), false)
  return a and b
end

make a function called st_mut_clone_on_alias returns ok
  exec_capture("./patc1.exe", "self_hosting/block_model/spec_fixtures/mut_param_clone_on_alias.patlang", "self_hosting/build/bm_mut_param_clone_on_alias.exe", "--x64")
  let out = exec_capture("self_hosting/build/bm_mut_param_clone_on_alias.exe")
  let a = check("the mutated box's pointer now differs from the alias's own pointer", contains_text(out, "false"), true)
  let b = check("the alias still reads the ORIGINAL value 10", contains_text(out, "10"), true)
  let c = check("the mutated box reads the NEW value 99", contains_text(out, "99"), true)
  return a and b and c
end

# ---- Phase 4: globals_elimination.feature / object_handler.feature ----
# Both run entirely under the interpreter (in-process, not exec_capture) --
# unlike Phase 3's Box scenarios, neither set_global/get_global nor the
# handler builtins touch heap.patlang's native-only functions.

make a function called register_globals_elimination_steps returns done
  step("a block that sets a global, then jumps through a block that never mentions it", "st_noop")
  step("a much later block reads that global back", "st_noop")
  step("it sees the value the first block set, unchanged in between", "st_globals_threaded")
  return true
end

make a function called st_globals_threaded returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/globals_threaded.patlang")
  return check("the third block, two jumps later, reads 41 back and prints 42", contains_text(out, "42"), true)
end

make a function called register_object_handler_steps returns done
  step("a handler with two different names registered to two different values", "st_noop")
  step("both names are looked up, after the handler was passed to another block explicitly", "st_noop")
  step("each name resolves to its own value, not the other's", "st_object_handler_lookups")
  return true
end

make a function called st_object_handler_lookups returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/object_handler.patlang")
  let a = check("\"alice\" resolves to 111", contains_text(out, "111"), true)
  let b = check("\"bob\" resolves to 222", contains_text(out, "222"), true)
  return a and b
end

# ---- Phase 5: loop_blocks.feature ----
# All run entirely under the interpreter (no Box involved).

make a function called register_loop_blocks_steps returns done
  step("a loop whose body reads a local set once before the loop started", "st_noop")
  step("the loop runs several iterations", "st_noop")
  step("every iteration sees that outer local's value correctly", "st_loop_outer_reads")
  step("a loop whose body declares and increments a scratch local from scratch each time", "st_noop")
  step("the scratch local never carries a value forward from the previous iteration", "st_loop_scratch_not_carried")
  step("a loop body containing an ordinary if/else", "st_noop")
  step("the loop runs to completion", "st_noop")
  step("the if/else behaves exactly as it would outside a loop", "st_loop_if_stays_flat")
  step("a loop whose body contains an if with its own nested while", "st_noop")
  step("the nested loop's own effect is counted correctly across every outer iteration that reaches it", "st_loop_nested_while")
  step("a while loop whose condition alone references a variable set before the loop, never mentioned again inside the body", "st_noop")
  step("the loop runs to completion, matching exactly what pat --ir-run produces for the identical source", "st_loop_cond_only_freevar")
  return true
end

make a function called st_loop_nested_while returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/loop_nested_while.patlang")
  return check("i=3 contributes 3, i=4 contributes 4, total is 7", contains_text(out, "7"), true)
end

make a function called st_loop_outer_reads returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/loop_outer_reads.patlang")
  return check("5 iterations of total += i + bonus(100) yields 510", contains_text(out, "510"), true)
end

make a function called st_loop_scratch_not_carried returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/loop_scratch_not_carried.patlang")
  let a = check("prints 3 (scratch reset to 0+1 every iteration), not 6 (which would mean it wrongly persisted)", contains_text(out, "3"), true)
  let b = check("never wrongly accumulates to 6", contains_text(out, "6"), false)
  return a and b
end

make a function called st_loop_if_stays_flat returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/loop_if_stays_flat.patlang")
  return check("counts 3 even numbers in 0..5 (0, 2, 4)", contains_text(out, "3"), true)
end

make a function called st_loop_cond_only_freevar returns ok
  let block_model_out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/loop_cond_only_freevar.patlang")
  let reference_out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/loop_cond_only_freevar_reference.patlang")
  let a = check("prints 0, 1, 2 (the loop body)", contains_text(block_model_out, "0") and contains_text(block_model_out, "1") and contains_text(block_model_out, "2"), true)
  let b = check("prints 999 after the loop -- the loop actually terminated instead of crashing", contains_text(block_model_out, "999"), true)
  let c = check("matches the real interpreter exactly", contains_text(reference_out, "999"), true)
  return a and b and c
end

# ---- Phase 6: free_variable_capture.feature ----
# Both run entirely under the interpreter.

make a function called register_free_variable_capture_steps returns done
  step("a loop preceded by an outer local the loop body never reads", "st_noop")
  step("the loop is lowered", "st_noop")
  step("the loop head block's own declared params do not include that unreferenced local", "st_free_var_precise_excludes_unused")
  step("the same loop body analyzed both ways on purpose", "st_noop")
  step("the wholesale set and the free-variable-analyzed set are compared directly", "st_noop")
  step("the free-variable set is strictly smaller and excludes exactly the unreferenced local", "st_free_var_comparison")
  return true
end

make a function called st_free_var_precise_excludes_unused returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/free_var_capture_precise.patlang")
  let a = check("the loop head's own param list never mentions unused_big", contains_text(out, "unused_big"), false)
  let b = check("total, i, and __globals are still all present", contains_text(out, "total") and contains_text(out, "i") and contains_text(out, "__globals"), true)
  let c = check("the program still computes the correct total (10)", contains_text(out, "10"), true)
  return a and b and c
end

make a function called st_free_var_comparison returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/free_var_capture_comparison.patlang")
  let a = check("wholesale set has 3 members", contains_text(out, "3"), true)
  let b = check("precise set has 2 members", contains_text(out, "2"), true)
  let c = check("precise set is exactly [total, i]", contains_text(out, "[total, i]"), true)
  return a and b and c
end

# ---- Phase 7: flight_check.feature ----
# Native x64 only, like Phase 3.

make a function called register_flight_check_steps returns done
  step("a box created and mutated twice in the same straight-line block", "st_noop")
  step("the program runs", "st_noop")
  step("the runtime-check counter stays at exactly zero and both mutations still produce the correct value", "st_flight_check_skips_runtime")
  step("a box mutated through a parameter reference", "st_noop")
  step("the runtime-check counter is greater than zero and the mutation still produces the correct value", "st_flight_check_fallback")
  return true
end

make a function called st_flight_check_skips_runtime returns ok
  exec_capture("./patc1.exe", "self_hosting/block_model/spec_fixtures/flight_check_skips_runtime.patlang", "self_hosting/build/bm_flight_check_skips_runtime.exe", "--x64")
  let out = exec_capture("self_hosting/build/bm_flight_check_skips_runtime.exe")
  let a = check("the final box value is 30", contains_text(out, "30"), true)
  let b = check("the runtime-check counter is exactly 0", contains_text(out, "0"), true)
  return a and b
end

make a function called st_flight_check_fallback returns ok
  exec_capture("./patc1.exe", "self_hosting/block_model/spec_fixtures/flight_check_fallback.patlang", "self_hosting/build/bm_flight_check_fallback.exe", "--x64")
  let out = exec_capture("self_hosting/build/bm_flight_check_fallback.exe")
  let a = check("the mutated value is 99", contains_text(out, "99"), true)
  let b = check("the runtime-check counter is at least 1 (contains a nonzero digit)", contains_text(out, "1"), true)
  return a and b
end

# ---- Phase 8: debugger_parity.feature ----
# Both run entirely under the interpreter.

make a function called register_debugger_parity_steps returns done
  step("a program that jumps through three distinct blocks before finishing", "st_noop")
  step("it is resumed one block at a time via a real fiber", "st_noop")
  step("each pause returns a longer, genuinely different trail than the last, ending with the correct final result", "st_debugger_trail_grows")
  step("a program chaining more blocks than the trail's own cap", "st_noop")
  step("it runs to completion one block at a time", "st_noop")
  step("the trail never exceeds its cap and always shows the most recent blocks", "st_debugger_trail_bounded")
  return true
end

make a function called st_debugger_trail_grows returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/debugger_jump_trail.patlang")
  let a = check("first pause: [start]", contains_text(out, "[start]"), true)
  let b = check("second pause: [start, blockB]", contains_text(out, "[start, blockB]"), true)
  let c = check("third pause: [start, blockB, blockC]", contains_text(out, "[start, blockB, blockC]"), true)
  let d = check("finishes and prints 42", contains_text(out, "42"), true)
  let e = check("the fiber is no longer alive after finishing", contains_text(out, "false"), true)
  return a and b and c and d and e
end

make a function called st_debugger_trail_bounded returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/debugger_jump_trail_bounded.patlang")
  let a = check("the trail length stays at exactly 5, not 8", contains_text(out, "5"), true)
  let b = check("the trail shows the most recent 5 blocks (b3..b7), not the earliest", contains_text(out, "[b3, b4, b5, b6, b7]"), true)
  return a and b
end

# ---- Phase 10: event_dispatch.feature ----
# All run entirely under the interpreter (no Box involved).

make a function called register_event_dispatch_steps returns done
  step("a program that emits an event carrying a payload", "st_noop")
  step("it is lowered and run", "st_noop")
  step("the handler prints the event name and the payload it declared", "st_event_basic_payload")
  step("a handler block that references a name only the emitting block declared", "st_noop")
  step("the event is emitted", "st_noop")
  step("it fails with a guaranteed unbound-variable error naming that name, never printing its value", "st_event_isolation")
  step("a program with two separate when blocks for the same event", "st_noop")
  step("the event is emitted once", "st_noop")
  step("both handlers run, in the order they were declared", "st_event_multi_handler_order")
  step("a program that emits an event in the middle of a block, with more statements after it", "st_noop")
  step("it runs", "st_noop")
  step("the statements after the emit call still execute, in the correct order", "st_event_returns_control")
  step("a handler that sets a global", "st_noop")
  step("the event that triggers it is emitted", "st_noop")
  step("the block that emitted it reads the updated global right after the emit call", "st_event_global_visible")
  step("a when handler whose body contains a while loop", "st_noop")
  step("the loop runs to completion and the handler's own statements after it also run", "st_event_handler_with_loop")
  return true
end

make a function called st_event_handler_with_loop returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/event_handler_with_loop.patlang")
  let a = check("the loop prints 0, 1, 2", contains_text(out, "0") and contains_text(out, "1") and contains_text(out, "2"), true)
  let b = check("the handler's own statement after the loop (99) also runs", contains_text(out, "99"), true)
  return a and b
end

make a function called st_event_basic_payload returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/event_basic.patlang")
  let a = check("the handler prints the event name \"greet\"", contains_text(out, "greet"), true)
  let b = check("the handler prints the payload 7", contains_text(out, "7"), true)
  let c = check("finish() still runs afterward, printing 99", contains_text(out, "99"), true)
  return a and b and c
end

make a function called st_event_isolation returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/event_isolation.patlang")
  let a = check("names the unbound variable \"hidden\"", contains_text(out, "unbound in this block's own pointer: hidden"), true)
  let b = check("never reaches printing hidden's value 12345", contains_text(out, "12345"), false)
  return a and b
end

make a function called st_event_multi_handler_order returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/event_multi_handler.patlang")
  let a = check("the first-declared handler's 100 prints before the second-declared handler's 200", contains_text(out, "100\n200"), true)
  let b = check("finish() still runs afterward, printing 999", contains_text(out, "999"), true)
  return a and b
end

make a function called st_event_returns_control returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/event_returns_control.patlang")
  return check("prints 1 (handler), then 2 (right after emit), then 3 (finish) in order", contains_text(out, "1\n2\n3"), true)
end

make a function called st_event_global_visible returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/event_global_visible.patlang")
  return check("reads the handler's own set_global(\"counter\", 41) back and prints 42", contains_text(out, "42"), true)
end

# ---- Phase 11: pattern_matching.feature ----
# All run entirely under the interpreter (no Box involved).

make a function called register_pattern_matching_steps returns done
  step("a match with a literal arm that doesn't match, followed by a wildcard arm", "st_noop")
  step("it runs", "st_noop")
  step("the wildcard arm's body runs", "st_match_wildcard")
  step("a match whose only arm binds the scrutinee to a new name", "st_noop")
  step("the arm body can use that name and sees the scrutinee's own value", "st_match_bind")
  step("a match with two literal arms and a wildcard fallback", "st_noop")
  step("the scrutinee equals the second literal arm's value", "st_noop")
  step("exactly that arm's body runs, not the first literal arm's or the wildcard's", "st_match_literal")
  step("a match with a bind-and-guard arm (\"case n when n > 100 then ...\") followed by a plain bind fallback", "st_noop")
  step("the scrutinee fails the guard", "st_noop")
  step("control falls through to the fallback arm, not the guarded one", "st_match_guard_fallthrough")
  step("a match with only literal arms and no wildcard, run against a scrutinee none of them match", "st_noop")
  step("it fails with a guaranteed error naming that no arm matched", "st_match_no_arm_fails")
  return true
end

make a function called st_match_wildcard returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/match_wildcard.patlang")
  let a = check("the wildcard arm prints 2", contains_text(out, "2"), true)
  let b = check("the non-matching literal arm never prints 1", contains_text(out, "1"), false)
  return a and b
end

make a function called st_match_bind returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/match_bind.patlang")
  return check("prints 8 (bound n=7, then n+1)", contains_text(out, "8"), true)
end

make a function called st_match_literal returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/match_literal.patlang")
  let a = check("the matching second literal arm prints 200", contains_text(out, "200"), true)
  let b = check("the non-matching first literal arm never prints 100", contains_text(out, "100"), false)
  let c = check("the wildcard never runs (300 never prints)", contains_text(out, "300"), false)
  return a and b and c
end

make a function called st_match_guard_fallthrough returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/match_guard_fallthrough.patlang")
  let a = check("the guarded arm never runs (999 never prints)", contains_text(out, "999"), false)
  let b = check("the fallback arm runs instead, printing 6 (n=5, n+1)", contains_text(out, "6"), true)
  return a and b
end

make a function called st_match_no_arm_fails returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/match_no_arm_fails.patlang")
  let a = check("names the failure as no arm matched", contains_text(out, "match: no arm matched"), true)
  let b = check("neither literal arm's body ever runs (100 never prints)", contains_text(out, "100"), false)
  let c = check("neither literal arm's body ever runs (200 never prints)", contains_text(out, "200"), false)
  return a and b and c
end

# ---- Phase 12: contracts.feature ----
# All run entirely under the interpreter.

make a function called register_contracts_steps returns done
  step("a block whose require, ensure, and assert conditions are all true", "st_noop")
  step("it runs", "st_noop")
  step("the program continues past every one of them and produces its normal result", "st_contracts_all_pass")
  step("a block whose first statement is a require that evaluates to false", "st_noop")
  step("it fails with a guaranteed error naming the require, and no later statement in the body ever runs", "st_contracts_require_fails")
  step("a block that runs its own body, then hits a failing ensure, then would jump to another block", "st_noop")
  step("the block's own body already ran, the failure is reported, and the next block's own body never runs", "st_contracts_ensure_fails")
  step("a block with a statement before a failing assert and a statement after it", "st_noop")
  step("the statement before the assert already ran and the statement after it never does", "st_contracts_assert_fails_mid_body")
  return true
end

make a function called st_contracts_all_pass returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/contracts_all_pass.patlang")
  return check("all three contracts pass and the program prints 42", contains_text(out, "42"), true)
end

make a function called st_contracts_require_fails returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/contracts_require_fails.patlang")
  let a = check("names the failing require", contains_text(out, "require failed"), true)
  let b = check("never reaches the later print(999)", contains_text(out, "999"), false)
  return a and b
end

make a function called st_contracts_ensure_fails returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/contracts_ensure_fails.patlang")
  let a = check("the block's own body already ran, printing 1", contains_text(out, "1"), true)
  let b = check("names the failing ensure", contains_text(out, "ensure failed"), true)
  let c = check("next_block's own print(777) never runs", contains_text(out, "777"), false)
  return a and b and c
end

make a function called st_contracts_assert_fails_mid_body returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/contracts_assert_fails_mid_body.patlang")
  let a = check("the statement before the assert already ran, printing 1", contains_text(out, "1"), true)
  let b = check("names the failing assert", contains_text(out, "assert failed"), true)
  let c = check("the statement after the assert never runs (777 never prints)", contains_text(out, "777"), false)
  return a and b and c
end

# ---- Phase 13: object_orientation.feature ----
# Field-defaults/write/alias scenarios are native x64 only (like Phase
# 3/7 -- an object is a Box, and Box is native-x64-only, checked
# directly). The inherits/methods/traits rejection scenario runs under
# the plain interpreter -- it fails at lowering time, before any Box
# instruction is ever emitted.

make a function called register_object_orientation_steps returns done
  step("a class with two fields and their own default expressions", "st_noop")
  step("an instance is constructed with no further arguments", "st_noop")
  step("reading each field back returns its own declared default", "st_oo_field_defaults")
  step("a freshly-constructed object referenced from exactly one place", "st_noop")
  step("one of its fields is written through a mut parameter", "st_noop")
  step("reading that field back afterward returns the new value", "st_oo_field_write_unique")
  step("two live references to the same object, one of them mut", "st_noop")
  step("a field is written through the mut reference", "st_noop")
  step("the mut reference's own local sees the new value while the other alias still sees the original", "st_oo_field_write_aliased")
  step("a class declaration that uses inherits, or declares a method, or declares traits", "st_noop")
  step("the program is lowered", "st_noop")
  step("it fails with a guaranteed error naming exactly which unsupported feature was used", "st_oo_reject_unsupported")
  return true
end

make a function called st_oo_field_defaults returns ok
  exec_capture("./patc1.exe", "self_hosting/block_model/spec_fixtures/oo_field_defaults.patlang", "self_hosting/build/bm_oo_field_defaults.exe", "--x64")
  let out = exec_capture("self_hosting/build/bm_oo_field_defaults.exe")
  let a = check("field x defaults to 10", contains_text(out, "10"), true)
  let b = check("field y defaults to 20", contains_text(out, "20"), true)
  return a and b
end

make a function called st_oo_field_write_unique returns ok
  exec_capture("./patc1.exe", "self_hosting/block_model/spec_fixtures/oo_field_write_unique.patlang", "self_hosting/build/bm_oo_field_write_unique.exe", "--x64")
  let out = exec_capture("self_hosting/build/bm_oo_field_write_unique.exe")
  return check("the uniquely-owned write is visible on the next read (99)", contains_text(out, "99"), true)
end

make a function called st_oo_field_write_aliased returns ok
  exec_capture("./patc1.exe", "self_hosting/block_model/spec_fixtures/oo_field_write_aliased.patlang", "self_hosting/build/bm_oo_field_write_aliased.exe", "--x64")
  let out = exec_capture("self_hosting/build/bm_oo_field_write_aliased.exe")
  let a = check("the other alias still reads the ORIGINAL value 0", contains_text(out, "0"), true)
  let b = check("the mut reference reads the NEW value 99", contains_text(out, "99"), true)
  return a and b
end

make a function called st_oo_reject_unsupported returns ok
  let out1 = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/oo_reject_inherits.patlang")
  let a = check("names the class and 'inherits' specifically", contains_text(out1, "declares `inherits Base`"), true)
