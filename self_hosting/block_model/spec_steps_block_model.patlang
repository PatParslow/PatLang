# ---- issue #176 (budgeted half): budgeted.feature ----

make a function called register_budgeted_steps returns done
  step("a function whose budgeted block sums 0..4 with a generous budget, then again with a zero budget driven by a caller loop that hands the returned handle back", "st_noop")
  step("it runs through bm_lower_program/bi_run", "st_noop")
  step("it prints done, 10, then 10 and a nonzero pause count, exactly as pat --ir-run does for the identical source", "st_budgeted_basic")
  return true
end

make a function called st_budgeted_basic returns ok
  let block_model_out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/budgeted_basic.patlang")
  let reference_out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/budgeted_basic_reference.patlang")
  # done + 10 (finished inside the budget); then 10 (the resumed zero-budget
  # run reaches the same sum) and 5 pauses -- one per while back-edge, as the
  # deadline has already passed at the first check of every timeslice.
  let expected = ["done", "10", "10", "5"]
  let a = check("the real engine prints done 10 10 5", st_first_lines_equal(split_lines(reference_out), expected, 4), true)
  let b = check("block-model prints the same four values (previously: unsupported expression shape Budgeted)", st_first_lines_equal(split_lines(block_model_out), expected, 4), true)
  return a and b
end

