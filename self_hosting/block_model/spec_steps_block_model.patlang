# Step registrations for spec_library/block_model/*.feature, run through
# self_hosting/lib/gherkin.patlang's real Gherkin runner (the same framework
# self_hosting/lib/spec_steps_language.patlang uses for the standing
# language-spec gate) -- never a separate, ad hoc runner.
#
# This suite is deliberately NOT wired into
# self_hosting/tools/run_language_spec_suite.patlang or its standing gate:
# the Block Ownership Model (docs/plans/block-ownership-model.md) is a
# fresh, separate execution path that changes nothing about today's
# language semantics unless and until it's merged. See
# self_hosting/block_model/run_block_model_spec_suite.patlang for this
# suite's own runner.
#
# One register_*_steps() function per phase, added as each phase's RED step
# is written -- never retrofitted after the fact.

make a function called st_noop takes ctx returns done
  return true
end

# ---- Phase 2: block_dispatch.feature ----
# exec_capture on dedicated fixtures (self_hosting/block_model/spec_fixtures/),
# not in-process calls -- one scenario is a genuine guaranteed-fail
# contract_check violation (fatal, out of process), matching
# require_ensure_assert.feature's own established pattern
# (self_hosting/lib/spec_steps_language.patlang).

make a function called register_block_dispatch_steps takes ctx returns done
  step(ctx, "a program with two blocks joined by one jump carrying two values", "st_noop")
  step(ctx, "the program runs", "st_noop")
  step(ctx, "the second block computes the correct result using only what the jump handed it", "st_block_jump_values_arrive")
  step(ctx, "a program where the second block references a name only the first block has", "st_noop")
  step(ctx, "it fails with a guaranteed unbound-variable error naming that variable", "st_block_jump_unbound_fails")
  return true
end

make a function called register_mut_parameters_steps takes ctx returns done
  step(ctx, "a block with a mut parameter holding the only reference to a box", "st_noop")
  step(ctx, "it mutates that box", "st_noop")
  step(ctx, "the same box is mutated in place, not cloned", "st_mut_in_place")
  step(ctx, "a block with a read-only parameter holding a reference to a box", "st_noop")
  step(ctx, "it attempts to mutate that box", "st_noop")
  step(ctx, "it fails with a guaranteed error naming that parameter", "st_immut_rejected")
  step(ctx, "a block with a mut parameter holding one of two live references to the same box", "st_noop")
  step(ctx, "a fresh box is produced and the other reference's own value is untouched", "st_mut_clone_on_alias")
  return true
end

make a function called st_block_jump_values_arrive takes ctx returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/two_block_jump.patlang")
  return expect(ctx, "combine(10, 20) prints 30", contains_text(out, "30"), true)
end

make a function called st_block_jump_unbound_fails takes ctx returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/unbound_variable.patlang")
  let a = expect(ctx, "names the unbound variable \"hidden\"", contains_text(out, "unbound in this block's own pointer: hidden"), true)
  let b = expect(ctx, "never reaches printing hidden's value 99 (the violation is caught before it prints)", contains_text(out, "99"), false)
  return a and b
end

# ---- Phase 3: mut_parameters.feature ----
# Native x64 only, like Phase 1 -- heap.patlang's functions don't exist
# under the interpreter (checked directly). exec_capture("./patc1.exe",
# fixture, exe_path, "--x64") to build, then exec_capture(exe_path) to run
# and check its own printed output, mirroring the existing
# x64_tag_collision_prevention_sweep.feature's own established two-step
# pattern (self_hosting/lib/spec_steps_language.patlang).

make a function called st_mut_in_place takes ctx returns ok
  exec_capture("./patc1.exe", "self_hosting/block_model/spec_fixtures/mut_param_in_place.patlang", "self_hosting/build/bm_mut_param_in_place.exe", "--x64")
  let out = exec_capture("self_hosting/build/bm_mut_param_in_place.exe")
  let a = expect(ctx, "box_set on a refcount-1 mut param returns the SAME pointer (mutated in place)", contains_text(out, "true"), true)
  let b = expect(ctx, "the mutated box now reads 99", contains_text(out, "99"), true)
  return a and b
end

make a function called st_immut_rejected takes ctx returns ok
  exec_capture("./patc1.exe", "self_hosting/block_model/spec_fixtures/immut_param_rejected.patlang", "self_hosting/build/bm_immut_param_rejected.exe", "--x64")
  let out = exec_capture("self_hosting/build/bm_immut_param_rejected.exe")
  let a = expect(ctx, "names the read-only parameter \"b\"", contains_text(out, "box_set on read-only parameter 'b'"), true)
  let b = expect(ctx, "never reaches printing the mutated value 99 (the violation is caught before it prints)", contains_text(out, "99"), false)
  return a and b
end

make a function called st_mut_clone_on_alias takes ctx returns ok
  exec_capture("./patc1.exe", "self_hosting/block_model/spec_fixtures/mut_param_clone_on_alias.patlang", "self_hosting/build/bm_mut_param_clone_on_alias.exe", "--x64")
  let out = exec_capture("self_hosting/build/bm_mut_param_clone_on_alias.exe")
  let a = expect(ctx, "the mutated box's pointer now differs from the alias's own pointer", contains_text(out, "false"), true)
  let b = expect(ctx, "the alias still reads the ORIGINAL value 10", contains_text(out, "10"), true)
  let c = expect(ctx, "the mutated box reads the NEW value 99", contains_text(out, "99"), true)
  return a and b and c
end

# ---- Phase 4: globals_elimination.feature / object_handler.feature ----
# Both run entirely under the interpreter (in-process, not exec_capture) --
# unlike Phase 3's Box scenarios, neither set_global/get_global nor the
# handler builtins touch heap.patlang's native-only functions.

make a function called register_globals_elimination_steps takes ctx returns done
  step(ctx, "a block that sets a global, then jumps through a block that never mentions it", "st_noop")
  step(ctx, "a much later block reads that global back", "st_noop")
  step(ctx, "it sees the value the first block set, unchanged in between", "st_globals_threaded")
  return true
end

make a function called st_globals_threaded takes ctx returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/globals_threaded.patlang")
  return expect(ctx, "the third block, two jumps later, reads 41 back and prints 42", contains_text(out, "42"), true)
end

make a function called register_object_handler_steps takes ctx returns done
  step(ctx, "a handler with two different names registered to two different values", "st_noop")
  step(ctx, "both names are looked up, after the handler was passed to another block explicitly", "st_noop")
  step(ctx, "each name resolves to its own value, not the other's", "st_object_handler_lookups")
  return true
end

make a function called st_object_handler_lookups takes ctx returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/object_handler.patlang")
  let a = expect(ctx, "\"alice\" resolves to 111", contains_text(out, "111"), true)
  let b = expect(ctx, "\"bob\" resolves to 222", contains_text(out, "222"), true)
  return a and b
end

# ---- Phase 5: loop_blocks.feature ----
# All run entirely under the interpreter (no Box involved).

make a function called register_loop_blocks_steps takes ctx returns done
  step(ctx, "a loop whose body reads a local set once before the loop started", "st_noop")
  step(ctx, "the loop runs several iterations", "st_noop")
  step(ctx, "every iteration sees that outer local's value correctly", "st_loop_outer_reads")
  step(ctx, "a loop whose body declares and increments a scratch local from scratch each time", "st_noop")
  step(ctx, "the scratch local never carries a value forward from the previous iteration", "st_loop_scratch_not_carried")
  step(ctx, "a loop body containing an ordinary if/else", "st_noop")
  step(ctx, "the loop runs to completion", "st_noop")
  step(ctx, "the if/else behaves exactly as it would outside a loop", "st_loop_if_stays_flat")
  step(ctx, "a loop whose body contains an if with its own nested while", "st_noop")
  step(ctx, "the nested loop's own effect is counted correctly across every outer iteration that reaches it", "st_loop_nested_while")
  step(ctx, "a while loop whose condition alone references a variable set before the loop, never mentioned again inside the body", "st_noop")
  step(ctx, "the loop runs to completion, matching exactly what pat --ir-run produces for the identical source", "st_loop_cond_only_freevar")
  return true
end

make a function called st_loop_nested_while takes ctx returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/loop_nested_while.patlang")
  return expect(ctx, "i=3 contributes 3, i=4 contributes 4, total is 7", contains_text(out, "7"), true)
end

make a function called st_loop_outer_reads takes ctx returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/loop_outer_reads.patlang")
  return expect(ctx, "5 iterations of total += i + bonus(100) yields 510", contains_text(out, "510"), true)
end

make a function called st_loop_scratch_not_carried takes ctx returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/loop_scratch_not_carried.patlang")
  let a = expect(ctx, "prints 3 (scratch reset to 0+1 every iteration), not 6 (which would mean it wrongly persisted)", contains_text(out, "3"), true)
  let b = expect(ctx, "never wrongly accumulates to 6", contains_text(out, "6"), false)
  return a and b
end

make a function called st_loop_if_stays_flat takes ctx returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/loop_if_stays_flat.patlang")
  return expect(ctx, "counts 3 even numbers in 0..5 (0, 2, 4)", contains_text(out, "3"), true)
end

make a function called st_loop_cond_only_freevar takes ctx returns ok
  let block_model_out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/loop_cond_only_freevar.patlang")
  let reference_out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/loop_cond_only_freevar_reference.patlang")
  let a = expect(ctx, "prints 0, 1, 2 (the loop body)", contains_text(block_model_out, "0") and contains_text(block_model_out, "1") and contains_text(block_model_out, "2"), true)
  let b = expect(ctx, "prints 999 after the loop -- the loop actually terminated instead of crashing", contains_text(block_model_out, "999"), true)
  let c = expect(ctx, "matches the real interpreter exactly", contains_text(reference_out, "999"), true)
  return a and b and c
end

# ---- Phase 6: free_variable_capture.feature ----
# Both run entirely under the interpreter.

make a function called register_free_variable_capture_steps takes ctx returns done
  step(ctx, "a loop preceded by an outer local the loop body never reads", "st_noop")
  step(ctx, "the loop is lowered", "st_noop")
  step(ctx, "the loop head block's own declared params do not include that unreferenced local", "st_free_var_precise_excludes_unused")
  step(ctx, "the same loop body analyzed both ways on purpose", "st_noop")
  step(ctx, "the wholesale set and the free-variable-analyzed set are compared directly", "st_noop")
  step(ctx, "the free-variable set is strictly smaller and excludes exactly the unreferenced local", "st_free_var_comparison")
  return true
end

make a function called st_free_var_precise_excludes_unused takes ctx returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/free_var_capture_precise.patlang")
  let a = expect(ctx, "the loop head's own param list never mentions unused_big", contains_text(out, "unused_big"), false)
  let b = expect(ctx, "total, i, and __globals are still all present", contains_text(out, "total") and contains_text(out, "i") and contains_text(out, "__globals"), true)
  let c = expect(ctx, "the program still computes the correct total (10)", contains_text(out, "10"), true)
  return a and b and c
end

make a function called st_free_var_comparison takes ctx returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/free_var_capture_comparison.patlang")
  let a = expect(ctx, "wholesale set has 3 members", contains_text(out, "3"), true)
  let b = expect(ctx, "precise set has 2 members", contains_text(out, "2"), true)
  let c = expect(ctx, "precise set is exactly [total, i]", contains_text(out, "[total, i]"), true)
  return a and b and c
end

# ---- Phase 7: flight_check.feature ----
# Native x64 only, like Phase 3.

make a function called register_flight_check_steps takes ctx returns done
  step(ctx, "a box created and mutated twice in the same straight-line block", "st_noop")
  step(ctx, "the program runs", "st_noop")
  step(ctx, "the runtime-check counter stays at exactly zero and both mutations still produce the correct value", "st_flight_check_skips_runtime")
  step(ctx, "a box mutated through a parameter reference", "st_noop")
  step(ctx, "the runtime-check counter is greater than zero and the mutation still produces the correct value", "st_flight_check_fallback")
  return true
end

make a function called st_flight_check_skips_runtime takes ctx returns ok
  exec_capture("./patc1.exe", "self_hosting/block_model/spec_fixtures/flight_check_skips_runtime.patlang", "self_hosting/build/bm_flight_check_skips_runtime.exe", "--x64")
  let out = exec_capture("self_hosting/build/bm_flight_check_skips_runtime.exe")
  let a = expect(ctx, "the final box value is 30", contains_text(out, "30"), true)
  let b = expect(ctx, "the runtime-check counter is exactly 0", contains_text(out, "0"), true)
  return a and b
end

make a function called st_flight_check_fallback takes ctx returns ok
  exec_capture("./patc1.exe", "self_hosting/block_model/spec_fixtures/flight_check_fallback.patlang", "self_hosting/build/bm_flight_check_fallback.exe", "--x64")
  let out = exec_capture("self_hosting/build/bm_flight_check_fallback.exe")
  let a = expect(ctx, "the mutated value is 99", contains_text(out, "99"), true)
  let b = expect(ctx, "the runtime-check counter is at least 1 (contains a nonzero digit)", contains_text(out, "1"), true)
  return a and b
end

# ---- Phase 8: debugger_parity.feature ----
# Both run entirely under the interpreter.

make a function called register_debugger_parity_steps takes ctx returns done
  step(ctx, "a program that jumps through three distinct blocks before finishing", "st_noop")
  step(ctx, "it is resumed one block at a time via a real fiber", "st_noop")
  step(ctx, "each pause returns a longer, genuinely different trail than the last, ending with the correct final result", "st_debugger_trail_grows")
  step(ctx, "a program chaining more blocks than the trail's own cap", "st_noop")
  step(ctx, "it runs to completion one block at a time", "st_noop")
  step(ctx, "the trail never exceeds its cap and always shows the most recent blocks", "st_debugger_trail_bounded")
  return true
end

make a function called st_debugger_trail_grows takes ctx returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/debugger_jump_trail.patlang")
  let a = expect(ctx, "first pause: [start]", contains_text(out, "[start]"), true)
  let b = expect(ctx, "second pause: [start, blockB]", contains_text(out, "[start, blockB]"), true)
  let c = expect(ctx, "third pause: [start, blockB, blockC]", contains_text(out, "[start, blockB, blockC]"), true)
  let d = expect(ctx, "finishes and prints 42", contains_text(out, "42"), true)
  let e = expect(ctx, "the fiber is no longer alive after finishing", contains_text(out, "false"), true)
  return a and b and c and d and e
end

make a function called st_debugger_trail_bounded takes ctx returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/debugger_jump_trail_bounded.patlang")
  let a = expect(ctx, "the trail length stays at exactly 5, not 8", contains_text(out, "5"), true)
  let b = expect(ctx, "the trail shows the most recent 5 blocks (b3..b7), not the earliest", contains_text(out, "[b3, b4, b5, b6, b7]"), true)
  return a and b
end

# ---- Phase 10: event_dispatch.feature ----
# All run entirely under the interpreter (no Box involved).

make a function called register_event_dispatch_steps takes ctx returns done
  step(ctx, "a program that emits an event carrying a payload", "st_noop")
  step(ctx, "it is lowered and run", "st_noop")
  step(ctx, "the handler prints the event name and the payload it declared", "st_event_basic_payload")
  step(ctx, "a handler block that references a name only the emitting block declared", "st_noop")
  step(ctx, "the event is emitted", "st_noop")
  step(ctx, "it fails with a guaranteed unbound-variable error naming that name, never printing its value", "st_event_isolation")
  step(ctx, "a program with two separate when blocks for the same event", "st_noop")
  step(ctx, "the event is emitted once", "st_noop")
  step(ctx, "both handlers run, in the order they were declared", "st_event_multi_handler_order")
  step(ctx, "a program that emits an event in the middle of a block, with more statements after it", "st_noop")
  step(ctx, "it runs", "st_noop")
  step(ctx, "the statements after the emit call still execute, in the correct order", "st_event_returns_control")
  step(ctx, "a handler that sets a global", "st_noop")
  step(ctx, "the event that triggers it is emitted", "st_noop")
  step(ctx, "the block that emitted it reads the updated global right after the emit call", "st_event_global_visible")
  step(ctx, "a when handler whose body contains a while loop", "st_noop")
  step(ctx, "the loop runs to completion and the handler's own statements after it also run", "st_event_handler_with_loop")
  return true
end

make a function called st_event_handler_with_loop takes ctx returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/event_handler_with_loop.patlang")
  let a = expect(ctx, "the loop prints 0, 1, 2", contains_text(out, "0") and contains_text(out, "1") and contains_text(out, "2"), true)
  let b = expect(ctx, "the handler's own statement after the loop (99) also runs", contains_text(out, "99"), true)
  return a and b
end

make a function called st_event_basic_payload takes ctx returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/event_basic.patlang")
  let a = expect(ctx, "the handler prints the event name \"greet\"", contains_text(out, "greet"), true)
  let b = expect(ctx, "the handler prints the payload 7", contains_text(out, "7"), true)
  let c = expect(ctx, "finish() still runs afterward, printing 99", contains_text(out, "99"), true)
  return a and b and c
end

make a function called st_event_isolation takes ctx returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/event_isolation.patlang")
  let a = expect(ctx, "names the unbound variable \"hidden\"", contains_text(out, "unbound in this block's own pointer: hidden"), true)
  let b = expect(ctx, "never reaches printing hidden's value 12345", contains_text(out, "12345"), false)
  return a and b
end

make a function called st_event_multi_handler_order takes ctx returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/event_multi_handler.patlang")
  let a = expect(ctx, "the first-declared handler's 100 prints before the second-declared handler's 200", contains_text(out, "100\n200"), true)
  let b = expect(ctx, "finish() still runs afterward, printing 999", contains_text(out, "999"), true)
  return a and b
end

make a function called st_event_returns_control takes ctx returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/event_returns_control.patlang")
  return expect(ctx, "prints 1 (handler), then 2 (right after emit), then 3 (finish) in order", contains_text(out, "1\n2\n3"), true)
end

make a function called st_event_global_visible takes ctx returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/event_global_visible.patlang")
  return expect(ctx, "reads the handler's own set_global(\"counter\", 41) back and prints 42", contains_text(out, "42"), true)
end

# ---- Phase 11: pattern_matching.feature ----
# All run entirely under the interpreter (no Box involved).

make a function called register_pattern_matching_steps takes ctx returns done
  step(ctx, "a match with a literal arm that doesn't match, followed by a wildcard arm", "st_noop")
  step(ctx, "it runs", "st_noop")
  step(ctx, "the wildcard arm's body runs", "st_match_wildcard")
  step(ctx, "a match whose only arm binds the scrutinee to a new name", "st_noop")
  step(ctx, "the arm body can use that name and sees the scrutinee's own value", "st_match_bind")
  step(ctx, "a match with two literal arms and a wildcard fallback", "st_noop")
  step(ctx, "the scrutinee equals the second literal arm's value", "st_noop")
  step(ctx, "exactly that arm's body runs, not the first literal arm's or the wildcard's", "st_match_literal")
  step(ctx, "a match with a bind-and-guard arm (\"case n when n > 100 then ...\") followed by a plain bind fallback", "st_noop")
  step(ctx, "the scrutinee fails the guard", "st_noop")
  step(ctx, "control falls through to the fallback arm, not the guarded one", "st_match_guard_fallthrough")
  step(ctx, "a match with only literal arms and no wildcard, run against a scrutinee none of them match", "st_noop")
  step(ctx, "it fails with a guaranteed error naming that no arm matched", "st_match_no_arm_fails")
  return true
end

make a function called st_match_wildcard takes ctx returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/match_wildcard.patlang")
  let a = expect(ctx, "the wildcard arm prints 2", contains_text(out, "2"), true)
  let b = expect(ctx, "the non-matching literal arm never prints 1", contains_text(out, "1"), false)
  return a and b
end

make a function called st_match_bind takes ctx returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/match_bind.patlang")
  return expect(ctx, "prints 8 (bound n=7, then n+1)", contains_text(out, "8"), true)
end

make a function called st_match_literal takes ctx returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/match_literal.patlang")
  let a = expect(ctx, "the matching second literal arm prints 200", contains_text(out, "200"), true)
  let b = expect(ctx, "the non-matching first literal arm never prints 100", contains_text(out, "100"), false)
  let c = expect(ctx, "the wildcard never runs (300 never prints)", contains_text(out, "300"), false)
  return a and b and c
end

make a function called st_match_guard_fallthrough takes ctx returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/match_guard_fallthrough.patlang")
  let a = expect(ctx, "the guarded arm never runs (999 never prints)", contains_text(out, "999"), false)
  let b = expect(ctx, "the fallback arm runs instead, printing 6 (n=5, n+1)", contains_text(out, "6"), true)
  return a and b
end

make a function called st_match_no_arm_fails takes ctx returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/match_no_arm_fails.patlang")
  let a = expect(ctx, "names the failure as no arm matched", contains_text(out, "match: no arm matched"), true)
  let b = expect(ctx, "neither literal arm's body ever runs (100 never prints)", contains_text(out, "100"), false)
  let c = expect(ctx, "neither literal arm's body ever runs (200 never prints)", contains_text(out, "200"), false)
  return a and b and c
end

# ---- Phase 12: contracts.feature ----
# All run entirely under the interpreter.

make a function called register_contracts_steps takes ctx returns done
  step(ctx, "a block whose require, ensure, and assert conditions are all true", "st_noop")
  step(ctx, "it runs", "st_noop")
  step(ctx, "the program continues past every one of them and produces its normal result", "st_contracts_all_pass")
  step(ctx, "a block whose first statement is a require that evaluates to false", "st_noop")
  step(ctx, "it fails with a guaranteed error naming the require, and no later statement in the body ever runs", "st_contracts_require_fails")
  step(ctx, "a block that runs its own body, then hits a failing ensure, then would jump to another block", "st_noop")
  step(ctx, "the block's own body already ran, the failure is reported, and the next block's own body never runs", "st_contracts_ensure_fails")
  step(ctx, "a block with a statement before a failing assert and a statement after it", "st_noop")
  step(ctx, "the statement before the assert already ran and the statement after it never does", "st_contracts_assert_fails_mid_body")
  return true
end

make a function called st_contracts_all_pass takes ctx returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/contracts_all_pass.patlang")
  return expect(ctx, "all three contracts pass and the program prints 42", contains_text(out, "42"), true)
end

make a function called st_contracts_require_fails takes ctx returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/contracts_require_fails.patlang")
  let a = expect(ctx, "names the failing require (the real engine's precondition wording and text)", contains_text(out, "precondition failed in start(): 1 > 2"), true)
  let b = expect(ctx, "never reaches the later print(999)", contains_text(out, "999"), false)
  return a and b
end

make a function called st_contracts_ensure_fails takes ctx returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/contracts_ensure_fails.patlang")
  let a = expect(ctx, "the block's own body already ran, printing 1", contains_text(out, "1"), true)
  let b = expect(ctx, "names the failing ensure", contains_text(out, "postcondition failed in start(): 5 > 9"), true)
  let c = expect(ctx, "next_block's own print(777) never runs", contains_text(out, "777"), false)
  return a and b and c
end

make a function called st_contracts_assert_fails_mid_body takes ctx returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/contracts_assert_fails_mid_body.patlang")
  let a = expect(ctx, "the statement before the assert already ran, printing 1", contains_text(out, "1"), true)
  let b = expect(ctx, "names the failing assert", contains_text(out, "assertion failed in start(): 5 == 9"), true)
  let c = expect(ctx, "the statement after the assert never runs (777 never prints)", contains_text(out, "777"), false)
  return a and b and c
end

# ---- Phase 13: object_orientation.feature ----
# Field-defaults/write/alias scenarios are native x64 only (like Phase
# 3/7 -- an object is a Box, and Box is native-x64-only, checked
# directly). The inherits/methods/traits rejection scenario runs under
# the plain interpreter -- it fails at lowering time, before any Box
# instruction is ever emitted.

make a function called register_object_orientation_steps takes ctx returns done
  step(ctx, "a class with two fields and their own default expressions", "st_noop")
  step(ctx, "an instance is constructed with no further arguments", "st_noop")
  step(ctx, "reading each field back returns its own declared default", "st_oo_field_defaults")
  step(ctx, "a freshly-constructed object referenced from exactly one place", "st_noop")
  step(ctx, "one of its fields is written through a mut parameter", "st_noop")
  step(ctx, "reading that field back afterward returns the new value", "st_oo_field_write_unique")
  step(ctx, "two live references to the same object, one of them mut", "st_noop")
  step(ctx, "a field is written through the mut reference", "st_noop")
  step(ctx, "the mut reference's own local sees the new value while the other alias still sees the original", "st_oo_field_write_aliased")
  step(ctx, "a class declaration that uses inherits, or declares a method, or declares traits", "st_noop")
  step(ctx, "the program is lowered", "st_noop")
  step(ctx, "it lowers without error: inheritance, methods and traits are supported (issue #175)", "st_oo_reject_unsupported")
  return true
end

make a function called st_oo_field_defaults takes ctx returns ok
  exec_capture("./patc1.exe", "self_hosting/block_model/spec_fixtures/oo_field_defaults.patlang", "self_hosting/build/bm_oo_field_defaults.exe", "--x64")
  let out = exec_capture("self_hosting/build/bm_oo_field_defaults.exe")
  let a = expect(ctx, "field x defaults to 10", contains_text(out, "10"), true)
  let b = expect(ctx, "field y defaults to 20", contains_text(out, "20"), true)
  return a and b
end

make a function called st_oo_field_write_unique takes ctx returns ok
  exec_capture("./patc1.exe", "self_hosting/block_model/spec_fixtures/oo_field_write_unique.patlang", "self_hosting/build/bm_oo_field_write_unique.exe", "--x64")
  let out = exec_capture("self_hosting/build/bm_oo_field_write_unique.exe")
  return expect(ctx, "the uniquely-owned write is visible on the next read (99)", contains_text(out, "99"), true)
end

make a function called st_oo_field_write_aliased takes ctx returns ok
  exec_capture("./patc1.exe", "self_hosting/block_model/spec_fixtures/oo_field_write_aliased.patlang", "self_hosting/build/bm_oo_field_write_aliased.exe", "--x64")
  let out = exec_capture("self_hosting/build/bm_oo_field_write_aliased.exe")
  let a = expect(ctx, "the other alias still reads the ORIGINAL value 0", contains_text(out, "0"), true)
  let b = expect(ctx, "the mut reference reads the NEW value 99", contains_text(out, "99"), true)
  return a and b
end

make a function called st_oo_reject_unsupported takes ctx returns ok
  let out1 = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/oo_reject_inherits.patlang")
  let a = expect(ctx, "a class that inherits is accepted, not rejected as a Phase 13 restriction", contains_text(out1, "restricted subset"), false)
  let out2 = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/oo_reject_methods.patlang")
  let b = expect(ctx, "a class that declares a method is accepted", contains_text(out2, "restricted subset"), false)
  let out3 = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/oo_reject_traits.patlang")
  let c = expect(ctx, "a class that declares traits is accepted", contains_text(out3, "restricted subset"), false)
  return a and b and c
end

# ---- Phase 14: concurrency.feature ----
# Runs entirely under the interpreter (no Box involved) -- fiber_yield is
# an ordinary host function, not native-x64-only.

make a function called register_concurrency_steps takes ctx returns done
  step(ctx, "a block-model program that yields its own progress value on each of several jump-chained steps", "st_noop")
  step(ctx, "an outside driver wraps running it in a fiber and resumes it one step at a time", "st_noop")
  step(ctx, "each resume returns the correct, changing progress value in order", "st_concurrency_fiber_yield_progress")
  step(ctx, "the same program, resumed past its last yield", "st_noop")
  step(ctx, "the final resume runs", "st_noop")
  step(ctx, "the program's own remaining work completes (its own final print still happens) and the fiber is no longer alive", "st_concurrency_fiber_yield_completion")
  return true
end

make a function called st_concurrency_fiber_yield_progress takes ctx returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/concurrency_fiber_yield.patlang")
  let a = expect(ctx, "pause1 yields 0", contains_text(out, "pause1: 0"), true)
  let b = expect(ctx, "pause2 yields 1", contains_text(out, "pause2: 1"), true)
  let c = expect(ctx, "pause3 yields 2", contains_text(out, "pause3: 2"), true)
  return a and b and c
end

make a function called st_concurrency_fiber_yield_completion takes ctx returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/concurrency_fiber_yield.patlang")
  let a = expect(ctx, "the program's own final print(999) still runs", contains_text(out, "999"), true)
  let b = expect(ctx, "the fiber reports it is no longer alive", contains_text(out, "still alive: false"), true)
  return a and b
end

# ---- Phase 15: goap.feature ----
# Runs entirely under the interpreter (fact/query are ordinary host
# functions, not native-x64-only).

make a function called register_goap_steps takes ctx returns done
  step(ctx, "a block that asserts a fact, then jumps to a different block", "st_noop")
  step(ctx, "that different block queries for the same fact", "st_noop")
  step(ctx, "it finds it, with no globals-view section involved at all", "st_goap_fact_query")
  step(ctx, "a block that queries a predicate no fact was ever asserted under", "st_noop")
  step(ctx, "it runs", "st_noop")
  step(ctx, "the query reports zero matches", "st_goap_query_no_match")
  return true
end

make a function called st_goap_fact_query takes ctx returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/goap_fact_query.patlang")
  return expect(ctx, "the fact asserted in start is found by check, a different block (1 match)", contains_text(out, "1"), true)
end

make a function called st_goap_query_no_match takes ctx returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/goap_query_no_match.patlang")
  return expect(ctx, "querying an unasserted predicate reports 0 matches", contains_text(out, "0"), true)
end

# ---- Phase 16: numeric_tower.feature ----
# Runs entirely under the interpreter -- type_of and ordinary arithmetic
# are not native-x64-only.

make a function called register_numeric_tower_steps takes ctx returns done
  step(ctx, "an addition whose result overflows a plain integer", "st_noop")
  step(ctx, "it runs", "st_noop")
  step(ctx, "the result's own type is bigint, not a silently wrapped or truncated integer", "st_numeric_tower_bigint")
  step(ctx, "a division whose result isn't a whole number", "st_noop")
  step(ctx, "the result's own type is rational", "st_numeric_tower_rational")
  step(ctx, "an addition that neither overflows nor divides", "st_noop")
  step(ctx, "the result's own type is int, not silently promoted to bigint", "st_numeric_tower_int")
  step(ctx, "an addition between a float and an int", "st_noop")
  step(ctx, "the result's own type is float", "st_numeric_tower_float")
  return true
end

make a function called st_numeric_tower_bigint takes ctx returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/numeric_tower.patlang")
  return expect(ctx, "overflow promotes to bigint", contains_text(out, "bigint"), true)
end

make a function called st_numeric_tower_rational takes ctx returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/numeric_tower.patlang")
  return expect(ctx, "uneven division promotes to rational", contains_text(out, "rational"), true)
end

make a function called st_numeric_tower_int takes ctx returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/numeric_tower.patlang")
  return expect(ctx, "plain addition stays int (own line, not part of a longer word)", contains_text(out, "\nint\n"), true)
end

make a function called st_numeric_tower_float takes ctx returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/numeric_tower.patlang")
  return expect(ctx, "mixing in a float produces float", contains_text(out, "float"), true)
