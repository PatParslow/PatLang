# ---- Phase 14: concurrency.feature ----
# Runs entirely under the interpreter (no Box involved) -- fiber_yield is
# an ordinary host function, not native-x64-only.

make a function called register_concurrency_steps returns done
  step("a block-model program that yields its own progress value on each of several jump-chained steps", "st_noop")
  step("an outside driver wraps running it in a fiber and resumes it one step at a time", "st_noop")
  step("each resume returns the correct, changing progress value in order", "st_concurrency_fiber_yield_progress")
  step("the same program, resumed past its last yield", "st_noop")
  step("the final resume runs", "st_noop")
  step("the program's own remaining work completes (its own final print still happens) and the fiber is no longer alive", "st_concurrency_fiber_yield_completion")
  return true
end

make a function called st_concurrency_fiber_yield_progress returns ok
