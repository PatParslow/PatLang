  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/library_parity_bare_statement_hostcall.patlang")
  return expect(ctx, "sb_push as a bare statement builds \"hello world\" correctly", contains_text(out, "hello world"), true)
end

