  let b = expect(ctx, "apply(\"show3\", 10, 20, 30) as a bare statement prints all three", contains_text(block_model_out, "10") and contains_text(block_model_out, "20") and contains_text(block_model_out, "30"), true)
  let c = expect(ctx, "zero-argument apply in value context returns 0 and the program reaches the end (999)", contains_text(block_model_out, "999"), true)
  let d = expect(ctx, "matches the real interpreter's own output", contains_text(reference_out, "7") and contains_text(reference_out, "30") and contains_text(reference_out, "999"), true)
  return a and b and c and d
end

make a function called st_apply_too_many_args takes ctx returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/apply_too_many_args.patlang")
  let a = expect(ctx, "names the callee and both counts", contains_text(out, "'one_param' declares 1 parameter(s) but was called with 2 argument(s)"), true)
  let b = expect(ctx, "never runs the statement after the failing call (999)", contains_text(out, "999"), false)
  return a and b
end

