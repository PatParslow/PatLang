# ---- library_parity.feature, later scenarios (issues #153/#154, checkpoint) ----

# True when the first `count` lines of a and b are identical, line by line.
make a function called st_first_lines_equal takes a, b, count returns ok
  if (list_len(a) < count) or (list_len(b) < count) then
    return false
  end
  let i = 0
  while i < count do
    if list_get(a, i) != list_get(b, i) then
      return false
    end
    let i = i + 1
  end
  return true
end

make a function called st_library_parity_truthiness returns ok
  let block_model_out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/condition_truthiness.patlang")
  let reference_out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/condition_truthiness_reference.patlang")
  let bm_lines = split_lines(block_model_out)
  let ref_lines = split_lines(reference_out)
  # 8 if-condition branches (F F F T T T T F), then the bounded while's count (0)
  let a = check("the real engine takes F F F T T T T F then runs the while 0 times", st_first_lines_equal(ref_lines, ["F", "F", "F", "T", "T", "T", "T", "F", "0"], 9), true)
  let b = check("block-model's branches and while count match the real engine's, line for line", st_first_lines_equal(bm_lines, ref_lines, 9), true)
  return a and b
end

make a function called st_library_parity_schema_bdd_selftest returns ok
  let block_model_out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/schema_bdd_selftest_full_run.patlang")
  let reference_out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/schema_bdd_selftest.patlang")
  let a = check("the Gherkin runner reports 5 passed, 0 failed under block-model", contains_text(block_model_out, "tests: 5 passed, 0 failed"), true)
  let b = check("the counts read from the run's own returned __globals agree: t_pass=5", contains_text(block_model_out, "t_pass=5"), true)
  let c = check("...and t_fail=0", contains_text(block_model_out, "t_fail=0"), true)
  let d = check("no stray tag suffix on Scenario lines (the issue #154 truthiness regression)", contains_text(block_model_out, "  []"), false)
  # Every reference line except its trailing `true` (the file's own final
  # expression value) must appear identically, in order, at the start of
  # the block-model output: Feature/Scenario lines, every ok:, the totals.
  let ref_lines = split_lines(reference_out)
  let compare_count = list_len(ref_lines) - 1
  let e = check("Feature/Scenario/ok lines and totals are identical to pat --ir-run's own, line for line", st_first_lines_equal(split_lines(block_model_out), ref_lines, compare_count), true)
  return a and b and c and d and e
end

# ---- Issue #155: toplevel_statements.feature ----
# Runs entirely under the interpreter.

make a function called register_toplevel_statements_steps returns done
  step("it runs through bm_lower_program/bi_run", "st_noop")
  step("a program whose main body is top-level let, calls, an if and a while, with its only function declared first", "st_noop")
  step("every printed value of the script matches exactly what pat --ir-run produces for the identical source", "st_toplevel_script")
  step("a program with three functions and no top-level statements", "st_noop")
  step("only the first function and what it calls run, exactly as before", "st_toplevel_functions_only")
  step("a program whose first line is an include directive that was never expanded", "st_noop")
  step("it is lowered through bm_lower_program", "st_noop")
  step("it fails with a contract violation saying the include was never expanded, before anything runs", "st_toplevel_unexpanded_include")
  return true
end

make a function called st_toplevel_script returns ok
  let block_model_out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/toplevel_script.patlang")
  let reference_out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/toplevel_script_reference.patlang")
  let bm_lines = split_lines(block_model_out)
  let ref_lines = split_lines(reference_out)
  # 10 12 100 0 2 4 999 -- seven printed values
  let a = check("the real engine prints 10 12 100 0 2 4 999", st_first_lines_equal(ref_lines, ["10", "12", "100", "0", "2", "4", "999"], 7), true)
  let b = check("block-model's top-level body prints the same seven values in the same order", st_first_lines_equal(bm_lines, ref_lines, 7), true)
  return a and b
end

make a function called st_toplevel_functions_only returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/toplevel_functions_only.patlang")
  let a = check("enters at the first function: prints 1 then 2", st_first_lines_equal(split_lines(out), ["1", "2"], 2), true)
  let b = check("never enters a later function it was not asked to call (999)", contains_text(out, "999"), false)
  return a and b
end

make a function called st_toplevel_unexpanded_include returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/toplevel_unsupported_loud.patlang")
  let a = check("says the include directive was never expanded", contains_text(out, "never expanded"), true)
  let b = check("fails before anything runs (start's own print(1) never happens)", st_first_lines_equal(split_lines(out), ["1"], 1), false)
  return a and b
end

# ---- library_selftest_parity.feature (Phase 18's checkpoint, generalized) ----
# One parametrized step serves every scenario: the Given and Then steps
# carry the selftest's own name as a {name} capture (step_arg("name")).

make a function called register_library_selftest_parity_steps returns done
  step("self_hosting/{name}.patlang, real and unmodified", "st_noop")
  step("it runs under block-model with real include expansion", "st_noop")
  step("the output and counts of {name} match what pat --ir-run produces", "st_selftest_parity")
  return true
end

# The number in a `tests: N passed, M failed` line ("" if there is none).
make a function called st_passed_count takes lines returns count
  let n = list_len(lines)
  let i = 0
  while i < n do
    let line = list_get(lines, i)
    if starts_with(line, "tests: ") then
      let rest = substr(line, 7, line.length - 7)
      let j = 0
      while (j < rest.length) and (char_code(rest, j) != 32) do
        let j = j + 1
      end
      return substr(rest, 0, j)
    end
    let i = i + 1
  end
  return ""
end

make a function called st_selftest_parity returns ok
  let name = step_arg("name")
  let path = "self_hosting/" + name + ".patlang"
  let real_out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", path)
  let bm_out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/selftest_under_block_model.patlang", path)
  let real_lines = split_lines(real_out)
  let bm_lines = split_lines(bm_out)
  let rn = list_len(real_lines)
  let real_count = st_passed_count(real_lines)
  # The real engine's last line is the script's own final expression value
  # (t_report()'s `true`); block-model has no such trailing print, so it is
  # excluded from the line-for-line comparison -- but asserted, not assumed.
  let a = check(name + ": the real engine ends with its own final value (true), so dropping that one line is sound", list_get(real_lines, rn - 1), "true")
  let b = check(name + ": every line the real engine prints appears identically, in order, at the start of block-model's output", st_first_lines_equal(bm_lines, real_lines, rn - 1), true)
  let c = check(name + ": the run's own final globals report t_fail=0", st_has_line(bm_lines, "t_fail=0"), true)
  let d = check(name + ": ...and t_pass equals the real engine's own count (" + real_count + ")", st_has_line(bm_lines, "t_pass=" + real_count), true)
  return a and b and c and d
end

# True when some line of `lines` is exactly `text`.
make a function called st_has_line takes lines, text returns yes
  let n = list_len(lines)
  let i = 0
  while i < n do
    if list_get(lines, i) == text then
      return true
    end
    let i = i + 1
  end
  return false
end

