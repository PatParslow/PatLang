# ---- Issue #153: apply_dynamic_dispatch.feature ----
# Runs entirely under the interpreter -- CallDynamic is not native-x64
# supported (deferred, same as Call/ReturnValue since Phase 21).

make a function called register_apply_dynamic_dispatch_steps takes ctx returns done
  step(ctx, "a program calling apply with 0, 1, 2 and 3 arguments, in value context and as a bare statement", "st_noop")
  step(ctx, "it runs through bm_lower_program/bi_run", "st_noop")
  step(ctx, "every printed value matches exactly what pat --ir-run produces for the identical source", "st_apply_with_args")
  step(ctx, "a program calling apply on a one-parameter function with two arguments", "st_noop")
  step(ctx, "it fails with a contract violation naming the callee and both counts, and never runs the statement after the call", "st_apply_too_many_args")
  step(ctx, "a program calling apply with a name no declared function has", "st_noop")
  step(ctx, "it fails with a contract violation naming the missing function, and never runs the statement after the call", "st_apply_unknown_callee")
  return true
end

make a function called st_apply_with_args takes ctx returns ok
  let block_model_out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/apply_with_args.patlang")
