# Step registrations for spec_library/block_model/*.feature, run through
# self_hosting/lib/test.patlang's real Gherkin runner (the same framework
# self_hosting/lib/spec_steps_language.patlang uses for the standing
# language-spec gate) -- never a separate, ad hoc runner.
#
# This suite is deliberately NOT wired into
# self_hosting/tools/run_language_spec_suite.patlang or its standing gate:
# the Block Ownership Model (docs/plans/block-ownership-model.md) is a
# fresh, separate execution path that changes nothing about today's
# language semantics unless and until it's merged. See
# self_hosting/block_model/run_block_model_spec_suite.patlang for this
# suite's own runner.
#
# One register_*_steps() function per phase, added as each phase's RED step
# is written -- never retrofitted after the fact.

make a function called st_noop returns done
  return true
end

# ---- Phase 0: _smoke.feature (scaffolding only; deleted once Phase 1 lands) ----

make a function called register_block_model_smoke_steps returns done
  step("the block-model spec harness", "st_noop")
  step("a trivial step is dispatched", "st_noop")
  step("it reports a pass", "st_smoke_reports_pass")
  return true
end

make a function called st_smoke_reports_pass returns ok
  return check("block-model harness dispatches and reports", true, true)
end
