  let c = expect(ctx, "matches the real interpreter exactly", contains_text(reference_out, "42"), true)
  return a and b and c
end

# ---- Phase 21: call_with_return.feature ----
# Runs entirely under the interpreter -- Call/ReturnValue are not
# native-x64-only (native codegen for them is explicitly deferred, see
# that feature file's own header).

make a function called register_call_with_return_steps takes ctx returns done
  step(ctx, "a function that returns a computed value, called from inside a larger expression", "st_noop")
  step(ctx, "it runs through bm_lower_program/bi_run", "st_noop")
  step(ctx, "the result matches exactly what pat --ir-run produces for the identical source", "st_call_with_return_value")
  step(ctx, "a recursive function computing a factorial", "st_noop")
  step(ctx, "it computes the correct result", "st_call_with_return_recursion")
  step(ctx, "a function that calls two other declared functions as bare statements, then prints a value of its own", "st_noop")
  step(ctx, "all three effects happen in order, matching exactly what pat --ir-run produces for the identical source", "st_call_with_return_bare_sequential")
  step(ctx, "an if branch whose only statement is a bare call to a declared function, followed by a print after the if", "st_noop")
  step(ctx, "the print after the if still runs, matching exactly what pat --ir-run produces for the identical source", "st_call_with_return_bare_in_if")
  return true
end

