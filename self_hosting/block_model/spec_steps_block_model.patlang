# ---- issue #179: exploration_scaling.feature ----

make a function called register_exploration_scaling_steps takes ctx returns done
  step(ctx, "a bounded counter explored at 100, 200, 400 and 800 states", "st_noop")
  step(ctx, "it runs under block-model and under the real engine", "st_noop")
  step(ctx, "each engine's K=800 time is under 24 times its K=100 time", "st_exploration_scaling")
  return true
end

# The benchmark prints K then milliseconds, one number per line: its times at
# 100 and 800 states, [small, large].
make a function called st_exploration_times takes lines returns times
  let small = 0
  let large = 0
  let i = 0
  while i + 1 < list_len(lines) do
    if list_get(lines, i) == "100" then
      let small = to_num(list_get(lines, i + 1))
    end
    if list_get(lines, i) == "800" then
      let large = to_num(list_get(lines, i + 1))
    end
    let i = i + 1
  end
  return [small, large]
end

make a function called st_exploration_ratio_ok takes ctx, label, small, large returns ok
  let floor_small = small
  if small < 1 then
    let floor_small = 1
  end
  return expect(ctx, label + ": " + large + " ms at 800 states vs " + small + " ms at 100 (ratio under 24)", large < floor_small * 24, true)
end

make a function called st_exploration_scaling takes ctx returns ok
  let bench = "self_hosting/block_model/bench/explore_scaling.patlang"
  # The real engine's times are a few milliseconds, so one run measures the
  # machine's load as much as the algorithm: the fastest of five at each size.
  let real = st_exploration_times(split_lines(exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", bench)))
  let k = 1
  while k < 5 do
    let again = st_exploration_times(split_lines(exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", bench)))
    if again[0] < real[0] then
      let real = [again[0], real[1]]
    end
    if again[1] < real[1] then
      let real = [real[0], again[1]]
    end
    let k = k + 1
  end
  let bm = st_exploration_times(split_lines(exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/selftest_under_block_model.patlang", bench)))
  let a = st_exploration_ratio_ok(ctx, "real engine", real[0], real[1])
  let b = st_exploration_ratio_ok(ctx, "block-model", bm[0], bm[1])
  return a and b
end

