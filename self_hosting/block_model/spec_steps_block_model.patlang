# ---- Phase 18: library_parity.feature ----
# Runs entirely under the interpreter -- List/generic-CallHost are not
# native-x64-only (unlike Box*).

make a function called register_library_parity_steps returns done
  step("a program that builds a List literal, indexes into it, calls list_len/list_push (never individually recognized by name in lower.patlang), and calls hash_string (a genuine stateless-chunk host function)", "st_noop")
  step("it runs through bm_lower_program/bi_run", "st_noop")
  step("every value matches exactly what the real interpreter (pat --ir-run) produces for the identical source", "st_library_parity_list_and_hostcall")
  step("a program that calls set_var/get in value context", "st_noop")
  step("it is lowered", "st_noop")
  step("it fails with a guaranteed contract violation naming the ambient-state rationale, not a silent CallHost dispatch", "st_library_parity_ambient_state_rejected")
  step("a program that calls sb_push as a bare statement, its own return value never consumed", "st_noop")
  step("it produces exactly what pat --ir-run produces for the identical source", "st_library_parity_bare_statement_hostcall")
  step("self_hosting/lib/zs_schema.patlang, real and unmodified", "st_noop")
  step("it is lowered through bm_lower_program", "st_noop")
  step("it lowers completely, with no unsupported construct left anywhere in it", "st_library_parity_zs_schema_lowers")
  step("a program that takes the .length of a String and of a List, never a Box-wrapped object", "st_noop")
  step("it runs through bm_lower_program/bi_run under the interpreter", "st_noop")
  step("both lengths match exactly what pat --ir-run produces for the identical source", "st_library_parity_member_length")
  step("an or whose left side alone determines the result, with a right side that would crash if evaluated", "st_noop")
  step("the right side never runs, matching exactly what pat --ir-run produces for the identical source", "st_library_parity_and_or_shortcircuit")
  step("a function using list_copy's own l[i] idiom and pmap_put's own [key, value] idiom, each inside its own while loop", "st_noop")
  step("every value matches exactly what pat --ir-run produces for the identical source", "st_library_parity_freevar_index_list")
  step("a program using \"\", 0, [], non-empty values, true and false directly as if conditions, and an empty list as a while condition", "st_noop")
  step("every branch taken matches exactly what pat --ir-run produces for the identical source", "st_library_parity_truthiness")
  step("self_hosting/schema_bdd_selftest.patlang, real and unmodified, with its includes expanded", "st_noop")
  step("it is lowered through bm_lower_program and run to completion", "st_noop")
  step("all five of its checks pass, its Gherkin output has no stray tag suffix, and its counts are read from the run's own final globals", "st_library_parity_schema_bdd_selftest")
  return true
end

