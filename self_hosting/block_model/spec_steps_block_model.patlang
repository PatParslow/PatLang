make a function called st_two_process_signals takes ctx returns ok
  let path = "self_hosting/tools/spec_fixtures/signal_secondary.patlang"
  let real_out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", path)
  let bm_out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/spec_fixtures/selftest_under_block_model.patlang", path)
  let expected = ["reply: uptime: 42", "child: exited via quit path"]
  let a = expect(ctx, "the real engine prints the child's reply and its quit-path log", st_first_lines_equal(split_lines(real_out), expected, 2), true)
  let b = expect(ctx, "block-model prints the same two lines (previously: calling 'set_var' directly rejected as ambient state)", st_first_lines_equal(split_lines(bm_out), expected, 2), true)
  return a and b
end

