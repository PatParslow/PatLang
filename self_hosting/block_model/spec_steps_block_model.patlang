# ---- issue #156: lowering_scaling.feature ----

make a function called register_lowering_scaling_steps takes ctx returns done
  step(ctx, "function bodies of bare calls, lets, an if-branch of calls, sequential ifs, and many small functions", "st_noop")
  step(ctx, "each is lowered by bm_lower_program at 2000 and at 8000 statements", "st_noop")
  step(ctx, "every 8000-statement time is under 8 times its 2000-statement time", "st_lowering_scaling")
  return true
end

make a function called st_lowering_scaling takes ctx returns ok
  let lines = split_lines(exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/block_model/bench/lowering_scaling.patlang"))
  let ok_all = true
  let i = 0
  let shapes = 0
  while i + 2 < list_len(lines) do
    let shape = list_get(lines, i)
    if (shape == "prints") or (shape == "lets") or (shape == "if_branch") or (shape == "sequential_ifs") or (shape == "many_functions") then
      let small = to_num(list_get(lines, i + 1))
      let large = to_num(list_get(lines, i + 2))
      # A floor of 1ms on the small time keeps a sub-millisecond reading
      # from turning the ratio into noise.
      let floor_small = small
      if small < 1 then
        let floor_small = 1
      end
      let good = expect(ctx, shape + ": " + large + " ms at 8000 vs " + small + " ms at 2000 (ratio under 8)", large < floor_small * 8, true)
      let ok_all = ok_all and good
      let shapes = shapes + 1
      let i = i + 3
    else
      let i = i + 1
    end
  end
  let counted = expect(ctx, "all five statement shapes were measured", shapes, 5)
  return ok_all and counted
end

