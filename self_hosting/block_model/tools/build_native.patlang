# Block Ownership Model, Phase 9: general-purpose driver. Lowers a
# block-model-compatible source file through bm_lower_program, translates
# it via native_codegen.patlang's own bm_to_real_funcir into a real,
# flat FuncIR, and emits two asm files (the program chunk and its own
# apply table) linked against the already-built self_hosting/build/
# x64_runtime.obj -- see native_codegen.patlang's own header for the
# two-chunk design and why a single bundled-source chunk was tried and
# abandoned.
#
# Usage: rust-runtime/target/release/pat.exe --ir-run
#        self_hosting/block_model/tools/build_native.patlang <source.patlang> <out_prefix>
# Writes <out_prefix>.asm and <out_prefix>_apply.asm; assembling/linking
# is a separate step (self_hosting/block_model/tools/
# build_and_run_native.sh does both together).

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../../lib/includes.patlang"
include "../../lib/codegen_x64.patlang"
include "../lower.patlang"
include "../native_codegen.patlang"

let args = argv()
let src_path = list_get(args, 0)
let out_prefix = list_get(args, 1)

let bm_src = read_file(src_path)
let bm_toks = tokenize(bm_src)
let bm_ast = parse_program(bm_toks)
let bm_prog = bm_lower_program(bm_ast)
let main_funcir = bm_to_real_funcir(bm_prog, "Call")

let rt_names_raw = split_lines(read_file("self_hosting/build/x64_runtime.funcs"))
let rt_names = []
let ni = 0
while ni < list_len(rt_names_raw) do
  let nm = list_get(rt_names_raw, ni)
  if nm != "" then
    let rt_names = list_push(rt_names, nm)
  end
  let ni = ni + 1
end

let program_ir = ["ProgramIR", "main", [main_funcir], []]
let asm = emit_program_x64(program_ir, false, rt_names)
write_file(out_prefix + ".asm", asm)

let table_funcs = [main_funcir]
let rti = 0
while rti < list_len(rt_names) do
  let table_funcs = list_push(table_funcs, ["FuncIR", list_get(rt_names, rti), [], [], []])
  let rti = rti + 1
end
let apply_asm = x64_emit_apply_table_asm(table_funcs)
write_file(out_prefix + "_apply.asm", apply_asm)

print("wrote " + out_prefix + ".asm and " + out_prefix + "_apply.asm (" + list_len(rt_names) + " externed runtime names)")
