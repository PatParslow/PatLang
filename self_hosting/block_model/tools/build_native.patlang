# Block Ownership Model, Phase 9 (extended in Phase 19 for Box*/Emit
# support): general-purpose driver. Lowers a block-model-compatible
# source file through bm_lower_program, translates it via
# native_codegen.patlang's own bm_to_real_funcir into a real, flat
# "main" FuncIR plus one separate FuncIR per event handler (Phase 19's
# own Emit design -- see native_codegen.patlang's own header), and emits
# two asm files (the program chunk and its own apply table) linked
# against the already-built self_hosting/build/{x64_runtime,heap_chunk}
# .obj -- see native_codegen.patlang's own header for the multi-chunk
# design and why a single bundled-source chunk was tried and abandoned,
# and tools/build_heap_chunk.patlang's own header for heap_chunk.obj's
# own build (a THIRD such chunk, needed for Box* instructions to call
# into heap.patlang's own bm_alloc/bm_box_read/etc).
#
# Usage: rust-runtime/target/release/pat.exe --ir-run
#        self_hosting/block_model/tools/build_native.patlang <source.patlang> <out_prefix>
# Writes <out_prefix>.asm and <out_prefix>_apply.asm; assembling/linking
# is a separate step (self_hosting/block_model/tools/
# build_and_run_native.sh does both together).

include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../../lib/includes.patlang"
include "../../lib/codegen_x64.patlang"
include "../lower.patlang"
include "../native_codegen.patlang"
include "../patc_backend.patlang"

# bm_patc_resolve_instrs (patc_backend.patlang) calls x64_name_in_list,
# which is only ever defined in patc1_main.patlang itself (not a
# library file) -- that file is never included here (it has its own
# top-level CLI argument-parsing that would conflict with this script's
# own), so this tiny, stable helper is copied directly instead, same
# workaround needed when exercising patc_backend.patlang standalone for
# any other reason.
make a function called x64_name_in_list takes names, name returns yes
  let n = names.length
  let i = 0
  while i < n do
    if names[i] == name then
      return true
    end
    let i = i + 1
  end
  return false
end

let args = argv()
let src_path = list_get(args, 0)
let out_prefix = list_get(args, 1)

let bm_src = read_file(src_path)
let bm_toks = tokenize(bm_src)
let bm_ast = parse_program(bm_toks)
let bm_prog = bm_lower_program(bm_ast)
# Phase 19 (Emit): bm_to_real_funcir now returns a LIST of FuncIRs --
# "main" plus one real, separate FuncIR per event handler (see its own
# header in native_codegen.patlang) -- not a single FuncIR as it did
# before Emit existed.
let funcirs_unresolved = bm_to_real_funcir(bm_prog, "Call")

make a function called bm_nc_read_names_file takes path returns names
  let raw = split_lines(read_file(path))
  let names = []
  let i = 0
  while i < list_len(raw) do
    let nm = list_get(raw, i)
    if nm != "" then
      let names = list_push(names, nm)
    end
    let i = i + 1
  end
  return names
end

# docs/plans/general-refcounting.md, Phase 1 prerequisite: heap.patlang's
# own functions are now folded into x64_runtime.obj's own build (see
# build_x64_runtime.patlang's own header), so x64_runtime.funcs already
# names every one of them -- reading heap_chunk.funcs too would just
# duplicate every entry in extern_names.
let rt_names = bm_nc_read_names_file("self_hosting/build/x64_runtime.funcs")
let extern_names = rt_names

# Issue #219: this harness used to skip bm_patc_resolve_runtime_calls,
# the step bm_patc_lower (the ordinary --x64 CLI's own path) always
# applies -- a CallHost whose name the runtime actually defines becomes
# a Call, with the same argument count and stack layout (see that
# function's own header in patc_backend.patlang). Every existing
# fixture through this harness happened to never call an external
# runtime function directly by name, so the gap went unnoticed until
# docs/plans/general-refcounting.md's own loop-handling increment
# started inserting real rt_string_rc_dec calls into ordinary block-
# model test fixtures (tailapp, issue #180) -- confirmed directly: that
# fixture failed with "codegen_x64: unsupported primitive... not in the
# OS-boundary allowlist: rt_string_rc_dec" before this fix, the exact
# symptom this issue predicted.
let funcirs = bm_patc_resolve_runtime_calls(funcirs_unresolved, rt_names)

let program_ir = ["ProgramIR", "main", funcirs, []]
let asm = emit_program_x64(program_ir, false, extern_names)
write_file(out_prefix + ".asm", asm)

let table_funcs = funcirs
let rti = 0
while rti < list_len(extern_names) do
  let table_funcs = list_push(table_funcs, ["FuncIR", list_get(extern_names, rti), [], [], []])
  let rti = rti + 1
end
let apply_asm = x64_emit_apply_table_asm(table_funcs)
write_file(out_prefix + "_apply.asm", apply_asm)

print("wrote " + out_prefix + ".asm and " + out_prefix + "_apply.asm (" + list_len(extern_names) + " externed names, including heap.patlang's own)")
