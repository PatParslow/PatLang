# Given every block of a real program lowered by bm_lower_program,
# When dominance is asked for each pair of (store or exit or 0) and
#   (store or exit) in a block,
# Then bm_fam_dominates (dominator tree) gives the same answer as
#   bm_nc_raw_block_index_dominates (the walk) every time.
include "../../lib/context.patlang"
include "../../lib/lexer.patlang"
include "../../lib/parser.patlang"
include "../../lib/includes.patlang"
include "../../lib/regex_dsl.patlang"
include "../../lib/syntax_dsl.patlang"
include "../../lib/codegen_x64.patlang"
include "../lower.patlang"
include "../native_codegen.patlang"

let args = argv()
let path = list_get(args, 0)
let src = expand_syntax_dsls(expand_includes_native(read_file(path), path_dirname(path)))
let prog = bm_lower_program(parse_program(tokenize(src)))
let blocks = bi_program_blocks(prog)
let checked = 0
let bad = 0
let fallback = 0
let biggest = 0
let bi = 0
let ctx = context_new()
while bi < list_len(blocks) do
  let info = bm_fam_block_info(ctx, list_get(blocks, bi))
  let instrs = list_get(info, 2)
  if list_len(instrs) > biggest then
    let biggest = list_len(instrs)
  end
  if list_get(info, 8) == false then
    let fallback = fallback + 1
  end
  let pts = [0, list_len(instrs) + 3]
  let sl = list_get(info, 5)
  let k = 0
  while k < list_len(sl) do
    let ss = list_get(sl, k)
    let j = 0
    while j < list_len(ss) do
      let pts = list_push(pts, list_get(ss, j))
      let j = j + 1
    end
    let k = k + 1
  end
  let ex = list_get(info, 7)
  let j = 0
  while j < list_len(ex) do
    let pts = list_push(pts, list_get(ex, j))
    let j = j + 1
  end
  # cap the work on huge blocks: every 1 in `step` points
  let step = 1
  if list_len(pts) > 60 then
    let step = list_len(pts) / 60
    let step = floor(step) + 1
  end
  let a = 0
  while a < list_len(pts) do
    let b = 0
    while b < list_len(pts) do
      let p = list_get(pts, a)
      let e = list_get(pts, b)
      let want = bm_nc_raw_block_index_dominates(ctx, instrs, p, e)
      let got = bm_fam_dominates(ctx, info, p, e)
      let checked = checked + 1
      if want != got then
        let bad = bad + 1
        if bad <= 5 then
          print("MISMATCH block " + bi_block_name(list_get(blocks, bi)) + " p=" + p + " e=" + e + " walk=" + want + " tree=" + got)
        end
      end
      let b = b + step
    end
    let a = a + step
  end
  let bi = bi + 1
end
print("blocks " + list_len(blocks) + " biggest " + biggest + " pairs " + checked + " mismatches " + bad + " fallback " + fallback)
