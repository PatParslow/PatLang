# =============================================================================
# Generation A build: compile the self-hosted compiler itself.
#
# Concatenates the compiler sources (lexer + parser + lowerer + codegen +
# driver) into one Stage 1 program, writes it out for later self-compilation,
# then compiles it to a native patc1.exe using the all-PatLang stage 4
# pipeline under the interpreter.
#
# Idempotent/cheap when nothing changed: hashes the concatenated source
# (the same lib files rustc would otherwise recompile from) against a
# stamp file and skips the rebuild -- and the rustc invocation it implies
# -- when unchanged, so callers (build_portfolio.patlang, ad hoc dev use)
# can run this unconditionally before using patc1.exe, the same way
# build_portfolio.patlang's own per-demo cache_valid already works.
#
# Run from the repo root:
#   rust-runtime/target/debug/pat --ir-run self_hosting/build_patc1.patlang
# Then the fixpoint:
#   ./patc1.exe self_hosting/build/patc1_all.patlang patc2.exe   (Gen B/C)
# =============================================================================

include "lib/lexer.patlang"
include "lib/parser.patlang"
include "lib/lower.patlang"
include "lib/codegen.patlang"
include "lib/runtime_rs.patlang"
include "lib/includes.patlang"
include "lib/codegen_x64.patlang"
include "lib/x64_build.patlang"
include "lib/json.patlang"
include "lib/ir_io.patlang"
include "lib/x64_obj_cache.patlang"
include "lib/build_progress.patlang"
include "lib/signals.patlang"
include "lib/x64_compile_unit.patlang"
include "lib/interp.patlang"
include "lib/regex_dsl.patlang"
include "lib/syntax_dsl.patlang"

# The bundle, as DATA rather than as eighteen near-identical hand-edited
# lines. Adding or removing a module is now a one-line edit here plus the
# matching `include` above, instead of two edits that silently drift --
# and they HAVE drifted: an audit found the include list naming 16 lib
# files against 18 in the old concatenation (x64_asm and x64_pe_link
# appeared only in the concatenation, reaching the include list
# transitively via x64_build).
#
# The `include` list above genuinely cannot be derived from this one:
# includes are resolved at parse time, so they must be literal
# statements and cannot be generated from a runtime list. The two lists
# therefore still have to agree by hand -- but only one of them is now a
# place where a copy-paste slip can go unnoticed, and the check below
# turns a missing file into a named error instead of a mystery.
#
# Order here is NOT load-bearing for call resolution: the whole bundle is
# one compilation unit, and a function may call one defined later in the
# file (x64_asm.patlang calls into build_progress.patlang and resolves
# fine regardless of position). It is kept in dependency order anyway,
# for readability -- leaf modules first.
let bundle = [
  "self_hosting/lib/lexer.patlang",
  "self_hosting/lib/parser.patlang",
  "self_hosting/lib/lower.patlang",
  "self_hosting/lib/codegen.patlang",
  "self_hosting/lib/runtime_rs.patlang",
  "self_hosting/lib/includes.patlang",
  "self_hosting/lib/signals.patlang",
  "self_hosting/lib/build_progress.patlang",
  "self_hosting/lib/codegen_x64.patlang",
  "self_hosting/lib/x64_asm.patlang",
  "self_hosting/lib/x64_pe_link.patlang",
  "self_hosting/lib/x64_build.patlang",
  "self_hosting/lib/json.patlang",
  "self_hosting/lib/ir_io.patlang",
  "self_hosting/lib/x64_obj_cache.patlang",
  "self_hosting/lib/x64_compile_unit.patlang",
  "self_hosting/lib/interp.patlang",
  "self_hosting/lib/regex_dsl.patlang",
  "self_hosting/lib/syntax_dsl.patlang",
  "self_hosting/patc1_main.patlang"
]

let src = ""
let bi = 0
let bn = to_num(list_len(bundle))
while bi < bn do
  let path = bundle[bi]
  if file_exists(path) != "1" then
    print("build_patc1: bundle file missing: " + path)
  end
  if bi == 0 then
    let src = read_file(path)
  else
    let src = src + chr(10) + read_file(path)
  end
  let bi = bi + 1
end

let fingerprint_file = "self_hosting/build/patc1.fingerprint"
let fingerprint = hash_string(src)
let up_to_date = false
if (file_exists(fingerprint_file) == "1") and (file_exists("./patc1.exe") == "1") then
  if read_file(fingerprint_file) == fingerprint then
    let up_to_date = true
  end
end

if up_to_date then
  print("[cache] patc1.exe unchanged, skipping rebuild")
else
  write_file("self_hosting/build/patc1_all.patlang", src)
  print("combined source: " + src.length + " chars")

  let toks = tokenize(src)
  print("TOKENS: " + vec_len(toks))
  let ast = parse_program(toks)
  print("STMTS: " + ast[1].length)
  let ir = lower_program(ast)
  print("FUNCS: " + ir[2].length)
  # Stage 40 (patlang-patc-prelude-chunk-linking-investigation): route
  # through the chunk-precompile-and-link mechanism instead of the old
  # monolithic emit_program_rs -- the PRELUDE_* chunk text (the bulk of
  # what used to blow up rustc's optimizer) is now precompiled ONCE into
  # cached rlibs shared across every compile, native or self-hosted; only
  # this program's own (much smaller) build_program()/call_dispatch/main
  # text gets freshly compiled and linked against them.
  let chunks = required_chunks(ir)
  print("CHUNKS: " + join_csv(chunks))
  let rs = emit_program_rs_chunked(ir)
  print("RUST CHARS (program only): " + rs.length)
  # opt-level 0 for the FINAL LINK step only (chunk rlibs still build at
  # the default -O -- proven safe at that level, see
  # build_chunked_native_opt's doc comment): rustc's optimizer has been
  # observed to blow up to 30GB+ RAM (and separately, to hang indefinitely
  # burning CPU with no progress at opt-level 1) specifically on this
  # ~1.6MB generated interpreter source when compiled MONOLITHICALLY --
  # kept as a safety margin here since the chunked program-only text for
  # patc1_all.patlang (201 functions) is still sizeable even without the
  # prelude. patc1.exe's own runtime speed isn't perf-critical the way
  # compiled user programs are; correctness and a working build matter far
  # more here.
  let exe = rustc_build_chunked(rs, join_csv(chunks), "./patc1.exe", "0")
  write_file(fingerprint_file, fingerprint)
  print("GEN A: " + exe)
end
