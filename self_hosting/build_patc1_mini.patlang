# Trimmed "mini Gen B" bundle for fast native-compiler iteration (built
# while chasing GitHub #223): same bundle as build_patc1.patlang minus
# regex_dsl.patlang/syntax_dsl.patlang (replaced by a no-op
# expand_syntax_dsls stub, tools/stub_syntax_dsl.patlang, so the result
# only compiles plain programs with no custom DSL syntax) -- regex_dsl.patlang's two ~70K-instruction
# closure-dispatch functions dominate full Gen B build time and aren't
# needed here. Still exercises the REAL pipeline end to end: lexer/
# parser/bm_patc_lower/native_codegen/codegen_x64/x64_compile_unit's real
# parallel_map batch assembly/x64_asm/x64_pe_link, at self-hosted scale.
#
# Run: rust-runtime/target/release/pat --ir-run self_hosting/build_patc1_mini.patlang
# Then: ./patc1.exe self_hosting/build/patc1_mini_all.patlang <out>.exe --x64

include "lib/lexer.patlang"
include "lib/parser.patlang"
include "lib/lower.patlang"
include "lib/codegen.patlang"
include "lib/runtime_rs.patlang"
include "lib/includes.patlang"
include "lib/codegen_x64.patlang"
include "lib/x64_build.patlang"
include "lib/json.patlang"
include "lib/ir_io.patlang"
include "lib/x64_obj_cache.patlang"
include "lib/build_progress.patlang"
include "lib/signals.patlang"
include "lib/x64_compile_unit.patlang"

let bundle = [
  "self_hosting/lib/lexer.patlang",
  "self_hosting/lib/parser.patlang",
  "self_hosting/lib/lower.patlang",
  "self_hosting/lib/codegen.patlang",
  "self_hosting/lib/runtime_rs.patlang",
  "self_hosting/lib/includes.patlang",
  "self_hosting/lib/signals.patlang",
  "self_hosting/lib/build_progress.patlang",
  "self_hosting/lib/codegen_x64.patlang",
  "self_hosting/lib/x64_asm.patlang",
  "self_hosting/lib/x64_pe_link.patlang",
  "self_hosting/lib/x64_build.patlang",
  "self_hosting/lib/json.patlang",
  "self_hosting/lib/ir_io.patlang",
  "self_hosting/lib/x64_obj_cache.patlang",
  "self_hosting/lib/x64_compile_unit.patlang",
  "self_hosting/lib/interp.patlang",
  "self_hosting/lib/world_native.patlang",
  "self_hosting/tools/stub_syntax_dsl.patlang",
  "self_hosting/block_model/block_ir.patlang",
  "self_hosting/block_model/free_vars.patlang",
  "self_hosting/block_model/flight_check.patlang",
  "self_hosting/block_model/classes.patlang",
  "self_hosting/block_model/lower.patlang",
  "self_hosting/block_model/native_codegen.patlang",
  "self_hosting/block_model/patc_backend.patlang",
  "self_hosting/patc1_main.patlang"
]

let sb = sb_new()
let bi = 0
let bn = to_num(list_len(bundle))
while bi < bn do
  let path = bundle[bi]
  if file_exists(path) != true then
    print("build_patc1_mini: bundle file missing: " + path)
  end
  let piece = expand_includes(read_file(path), path_dirname(path))
  if bi > 0 then
    sb_push(sb, chr(10))
  end
  sb_push(sb, piece)
  let bi = bi + 1
end

let src = sb_str(sb)
write_file("self_hosting/build/patc1_mini_all.patlang", src)
print("mini combined source: " + src.length + " chars")
print("WROTE_BUNDLE_DONE")
