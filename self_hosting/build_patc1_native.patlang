# Writes self_hosting/build/patc1_all.patlang, the self-hosted compiler as one
# program, for a native build of patc1 (docs/plans/native-interpreter.md,
# phase 7). Run by pati, not the Rust interpreter; the compile itself is
# `./patc1.exe self_hosting/build/patc1_all.patlang <out.exe> --x64`
# (block_model/tools/build_patc1_native.sh does both).
include "lib/includes.patlang"
include "patc1_bundle.patlang"

let src = patc1_bundle_source()
write_file("self_hosting/build/patc1_all.patlang", src)
print("patc1_all.patlang: " + src.length + " chars")
