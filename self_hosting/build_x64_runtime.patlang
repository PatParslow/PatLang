# build_x64_runtime.patlang -- compiles x64_runtime.patlang ALONE into
# a cached runtime.obj, the "chunk link" fix for the demo-compile
# slowdown that came from x64_runtime.patlang being textually
# concatenated into EVERY --x64 compile and re-codegen'd from scratch
# every time (see emit_program_x64's own header in codegen_x64.patlang
# for the owns_globals/extern_names split this depends on, and
# patlang-x64-primitive-gap-closure memory for the growth that made
# this pay off). Mirrors build_patc1.patlang's own fingerprint-cache
# pattern exactly: hash the runtime source, skip the whole lex/parse/
# lower/codegen/nasm pass when unchanged and the cached .obj already
# exists.
#
# Run from the repo root:
#   rust-runtime/target/release/pat --ir-run self_hosting/build_x64_runtime.patlang
# Produces self_hosting/build/x64_runtime.obj, which patc1_main.patlang's
# --x64 path then links against every program chunk's own .obj.

include "lib/lexer.patlang"
include "lib/parser.patlang"
include "lib/codegen_x64.patlang"
include "block_model/lower.patlang"
include "block_model/native_codegen.patlang"
include "lib/x64_build.patlang"
include "lib/json.patlang"
include "lib/ir_io.patlang"
include "lib/build_progress.patlang"
include "lib/x64_obj_cache.patlang"
include "lib/x64_compile_unit.patlang"

# docs/plans/general-refcounting.md, Phase 1 prerequisite: heap.patlang's
# own refcounting mechanism (bm_alloc/bm_rc_inc/bm_rc_dec/bm_rc_touch_for_
# mutation/the free list) is already fully general (Phase 1's own
# checkpoint), but the ordinary --x64 CLI never links heap_chunk.obj --
# only block-model's own test tooling (build_native.patlang) does, so
# box_new fails to link ("undefined symbol 'bm_heap_init'") outside that
# test suite, and nothing outside it could ever use bm_alloc either.
# Concatenating heap.patlang's own source into what gets compiled here
# makes every one of its functions part of x64_runtime.obj -- already
# linked into every native program -- with ZERO changes to either file's
# own content: heap.patlang itself stays exactly as interp.patlang's own
# `include "heap.patlang"` (the INTERPRETER's path, source-level
# inclusion, not link-time resolution) needs it to remain. Only this
# build script's own input changes.
let rt_src = read_file("self_hosting/lib/x64_runtime.patlang") + chr(10) + read_file("self_hosting/block_model/heap.patlang")
let fingerprint_file = "self_hosting/build/x64_runtime.fingerprint"
let obj_path = "self_hosting/build/x64_runtime.obj"
# x64_runtime_source_fingerprint (lib/x64_build.patlang) is the ONE
# computation of "what this is built from" -- shared with patc1_main.
# patlang's own independent re-check before every --x64 compile, after
# two separately-maintained copies of this exact hash drifted out of
# sync for real (see that function's own header for what happened).
let fingerprint = x64_runtime_source_fingerprint()
let up_to_date = false
if (file_exists(fingerprint_file) == true) and (file_exists(obj_path) == true) then
  if read_file(fingerprint_file) == fingerprint then
    let up_to_date = true
  end
end

let ctx = context_new()
if up_to_date then
  print("[cache] x64_runtime.obj unchanged, skipping rebuild")
else
  let toks = tokenize(rt_src)
  let ast = parse_program(toks)
  let err = parse_find_error(ast[1])
  if err[0] != "" then
    print(format_parse_error(err[0], err[1], rt_src))
  else
    # docs/plans/general-refcounting.md, Phase 7: the block-model lowering,
    # as for programs, in library mode (bm_to_library_funcirs): one FuncIR
    # per runtime function under its own name, and no `main`, which the
    # program chunk defines.
    let rt_funcs = bm_to_library_funcirs(ctx, bm_lower_library_program(ast), true)
    let rt_ir = ["ProgramIR", "main", rt_funcs, []]
    # The value functions (bm_nc_library_value_fns), for programs to know
    # which runtime results they own, and the two lists to review by hand
    # whenever they change.
    let value_fns = ctx_get(ctx, "bm_library_value_fns")
    let values_sb = sb_new()
    let vi = 0
    while vi < value_fns.length do
      sb_push(values_sb, value_fns[vi])
      sb_push(values_sb, chr(10))
      let vi = vi + 1
    end
    let review = "value functions also returning arithmetic or a raw read: " + ctx_text(ctx, "bm_library_value_mixed") + chr(10) + "raw functions returning a parameter: " + ctx_text(ctx, "bm_library_raw_param_returns") + chr(10)
    write_file("self_hosting/build/x64_runtime.value_review.txt", review)
    # A runtime function the passes take for a producer of an owned value
    # must be one (it retains what it returns), or a program would release
    # a reference it never got.
    let owned_names = bm_nc_owned_runtime_producer_names()
    let not_values = []
    let oi = 0
    while oi < owned_names.length do
      let on = owned_names[oi]
      if (on != "rt_rc_retain") and (ctx_get(ctx, "bm_lib_root__" + on) == true) and (not bm_nc_is_value_fn(ctx, on)) then
        let not_values = list_push(not_values, on)
      end
      let oi = oi + 1
    end
    # g_apply_table/g_apply_table_count: NOT part of the standard
    # owns_globals shared-.bss list (g_scratch etc) -- they're
    # regenerated fresh PER FINAL PROGRAM by X64UnitLinker.build
    # (x64_compile_unit.patlang), since the table's contents depend on
    # that program's own function set. This runtime object (built once,
    # standalone, reused by every future --x64 program) must therefore
    # `extern` them rather than own them -- apply() (x64_runtime.patlang)
    # references them directly. Found missing here directly: without
    # this, apply()'s own compiled body fails to assemble at all
    # ("symbol 'g_apply_table' not defined"), since this build's own
    # extern_names list was empty.
    #
    # GitHub #192's own build-side fix: this used to emit the WHOLE
    # runtime as one giant asm text (one emit_program_x64 call over
    # every rt_func) and hand it to ONE nasm invocation -- confirmed via
    # `nasm -Ov` that this was already sitting at NASM's own `-Ox`
    # convergence cap (323 of its own internal pass limit on the
    # unmodified source), so the smallest new function broke it
    # outright. This matters even though x64_build_use_native_toolchain()
    # always routes ordinary --x64 compiles through the self-hosted
    # assembler (never nasm) for the .obj's own CONTENT: patc1_main.
    # patlang's own staleness gate still refuses to compile anything
    # under --x64 unless THIS script reports success and writes a fresh
    # fingerprint, so a failed nasm step here blocked every --x64
    # compile, not just the (otherwise unused) nasm/gcc .obj itself.
    #
    # Fixed in two independent halves:
    # (1) self_hosting/build/x64_runtime.asm -- the text build_native
    # (x64_compile_unit.patlang) actually reads at compile time -- is
    # now written directly, with NO nasm invocation on it at all, so it
    # can never be blocked by nasm's own pass cap.
    # (2) self_hosting/build/x64_runtime.obj (the nasm/gcc path's own
    # artifact, kept for whatever still expects it to exist, and for
    # the staleness gate's own `file_exists(obj_path)` check) is built
    # from the SAME per-function CompileUnit/ObjCache units the program
    # side already uses -- each its own tiny nasm invocation, nowhere
    # near the pass cap, cached by content hash -- then combined into
    # ONE relocatable object via `ld -r` (x64_link_objs_relocatable,
    # x64_build.patlang). The globals (g_scratch, the extern list, etc.)
    # still need exactly ONE owning unit: a function-less emit_program_x64
    # call (owns_globals=true, empty func list) emits just the
    # .bss/extern declarations and no code at all.
    let asm = emit_program_x64(rt_ir, true, ["g_apply_table", "g_apply_table_count"])
    let asm_path = "self_hosting/build/x64_runtime.asm"
    write_file(asm_path, asm)
    let globals_asm = emit_program_x64(["ProgramIR", "main", [], []], true, ["g_apply_table", "g_apply_table_count"])
    let globals_asm_path = "self_hosting/build/x64_runtime_globals.asm"
    let globals_obj_path = "self_hosting/build/x64_runtime_globals.obj"
    let globals_result = x64_assemble(globals_asm, globals_asm_path, globals_obj_path)
    if x64_build_contains(globals_result, "NASM ERROR:") then
      let result = globals_result
    else
      # Each unit sees which of the runtime's functions return raw floats
      # (as patc1_main.patlang does for a program); compiled alone it
      # mistyped every call to another one, which garbled float printing.
      let unit_env = x64_unit_env(rt_funcs, "")
      let cache = new("ObjCache", "runtime_obj_cache")
      cache.cache_dir = "self_hosting/build/x64_obj_cache"
      let units = []
      let ui = 0
      let u_count = rt_funcs.length
      while ui < u_count do
        let unit = x64_make_compile_unit(rt_funcs[ui], unit_env)
        # rt_names="" (empty): every rt_func is already covered by
        # x64_extern_names_for's own "every OTHER entry in funcs" loop
        # below -- there is no SEPARATE "other runtime" layer here, this
        # function list IS the whole runtime.
        let extern_names = x64_extern_names_for(rt_funcs, ui, [])
        send(unit, "prepare", cache, extern_names)
        let units = list_push(units, unit)
        let ui = ui + 1
      end
      let unit_objs = []
      let link_err = ""
      let fi2 = 0
      while fi2 < u_count do
        let obj_or_err = send(units[fi2], "finish", cache)
        if x64_build_contains(obj_or_err, "NASM ERROR:") then
          let link_err = obj_or_err
        else
          let unit_objs = list_push(unit_objs, obj_or_err)
        end
        let fi2 = fi2 + 1
      end
      if link_err != "" then
        let result = link_err
      else
        let all_objs = list_push(unit_objs, globals_obj_path)
        let result = x64_link_objs_relocatable(all_objs, obj_path)
      end
    end
    if not_values.length > 0 then
      let result = "LINK ERROR: runtime functions the ownership passes take for owned producers return no reference: " + not_values
    end
    if x64_build_contains(result, "LINK ERROR:") or x64_build_contains(result, "NASM ERROR:") then
      print(result)
    else
      write_file("self_hosting/build/x64_runtime.values", sb_str(values_sb))
      write_file(fingerprint_file, fingerprint)
      # Cached function-name manifest, one per line -- lets
      # patc1_main.patlang's --x64 path skip re-lexing/parsing/
      # lowering x64_runtime.patlang a SECOND time (once combined with
      # the program for correct Call/CallHost resolution is
      # unavoidable, but a second standalone pass just to recover this
      # same name list was pure redundant cost, and turned out to
      # dominate a small demo's whole compile time).
      let names_sb = sb_new()
      let ni = 0
      let n_count = rt_funcs.length
      while ni < n_count do
        sb_push(names_sb, rt_funcs[ni][1])
        sb_push(names_sb, chr(10))
        let ni = ni + 1
      end
      write_file("self_hosting/build/x64_runtime.funcs", sb_str(names_sb))
      print("[build] x64_runtime.obj: " + obj_path)
    end
  end
end
