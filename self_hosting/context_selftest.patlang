# lib/context.patlang: Given a new context, When names are set and read, Then each
# gives the value last set, an unset name gives false, two contexts share nothing,
# and the store still answers once it has grown far past its first buckets.
include "lib/context.patlang"

let fails = 0
let a = context_new()
let b = context_new()
ctx_set(a, "x", 1)
ctx_set(a, "x", 2)
ctx_set(b, "x", [3])
if ctx_get(a, "x") != 2 then
  let fails = fails + 1
  print("FAIL: last value set")
end
if ctx_get(b, "x") != [3] then
  let fails = fails + 1
  print("FAIL: contexts share nothing")
end
if ctx_get(a, "y") != false then
  let fails = fails + 1
  print("FAIL: unset name gives false")
end
if ctx_has(a, "y") or (not ctx_has(a, "x")) then
  let fails = fails + 1
  print("FAIL: ctx_has")
end
let i = 0
while i < 5000 do
  ctx_set(a, "key__" + i, i * 2)
  let i = i + 1
end
let i = 0
while i < 5000 do
  if ctx_get(a, "key__" + i) != i * 2 then
    let fails = fails + 1
    print("FAIL: key__" + i)
  end
  let i = i + 1
end
if ctx_get(a, "x") != 2 then
  let fails = fails + 1
  print("FAIL: survives growth")
end
print("failures: " + fails)
