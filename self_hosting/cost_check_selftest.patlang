# Selftest for lib/cost_check.patlang's cheapest_cycles.
#
# Given two readers that return scripted readings and log each call,
# when cheapest_cycles runs them for 3 rounds,
# then each runs once first and that reading is dropped, even when it is the
# cheapest (a process's first reading ran about twice as fast as the rest,
# #284); then they run in turn, a then b, three times; and the result is the
# cheapest of each one's three kept readings, in the readers' order.

include "lib/includes.patlang"
include "lib/gherkin.patlang"
include "lib/cost_check.patlang"

let ctx = ctx_new()
let log = vec_new()
let a_script = [1, 50, 40, 45]
let b_script = [2, 300, 320, 310]
let a = || do
  let i = 0
  let k = 0
  while k < vec_len(log) do
    if vec_get(log, k) == "a" then
      let i = i + 1
    end
    let k = k + 1
  end
  vec_push(log, "a")
  return a_script[i]
end
let b = || do
  let i = 0
  let k = 0
  while k < vec_len(log) do
    if vec_get(log, k) == "b" then
      let i = i + 1
    end
    let k = k + 1
  end
  vec_push(log, "b")
  return b_script[i]
end

let best = cheapest_cycles([a, b], 3)
expect(ctx, "the first readings are dropped, and the cheapest of the rest kept", best, [40, 300])
expect(ctx, "each runs once first, then in turn", vec_to_list(log), ["a", "b", "a", "b", "a", "b", "a", "b"])
expect(ctx, "a check takes five rounds", cost_rounds(), 5)
ctx_report(ctx)
