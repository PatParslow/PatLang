# Arithmetic that naturally overflows the fixnum range via ordinary
# operators (no explicit BigInt-constructor calls) -- exercises whichever
# numeric-tower promotion path each backend actually has for everyday
# syntax like `let big = a * b`, not the internal rt_bigint_* primitives.
#
# NOTE for the harness: if the x64 result here diverges from the
# interpreter's, that is itself real, useful information (a backend that
# silently wraps instead of promoting to BigInt on plain `*` overflow,
# outside of the explicit-constructor-triggered dynamic-mode path) --
# report it plainly rather than assuming it's expected the way the float
# printing gap in bench_float_arith.patlang is.

let a = 20000000
let b = 20000000
let big = a * b
print(big)

let bigger = big * 3
print(bigger)

let i = 0
let acc = 1
while i < 20 do
  let acc = acc * 3
  let i = i + 1
end
print(acc)

let c = 123456789012345
let d = 987654321098765
print(c + d)
print(d - c)
print(c < d)
print(d > c)
print(c == c)
