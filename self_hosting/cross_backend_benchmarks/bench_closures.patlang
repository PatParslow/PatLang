# Closures created and invoked repeatedly -- exercises capture-by-value
# semantics (each closure snapshots its captured variable at creation
# time) and closure-call overhead, both via direct calls and passed as
# higher-order arguments.

make a function called make_adder takes n returns r
  return |x| { return x + n }
end

let i = 0
let acc = 0
while i < 5000 do
  let adder = make_adder(i)
  let acc = acc + adder(1)
  let i = i + 1
end
print(acc)

make a function called apply_twice takes f, x returns yes
  return f(f(x))
end

let double = |x| { return x * 2 }
print(apply_twice(double, 5))

let add_five = |x| { return x + 5 }
print(add_five(10))

let j = 0
let total = 0
while j < 5000 do
  let total = total + add_five(j)
  let j = j + 1
end
print(total)
