# Nested if/elif/else and while loops -- exercises branch/jump codegen
# and comparison-heavy control flow under real iteration counts.

let i = 0
let a_count = 0
let b_count = 0
let c_count = 0
while i < 100000 do
  if i % 3 == 0 then
    let a_count = a_count + 1
  elif i % 3 == 1 then
    let b_count = b_count + 1
  else
    let c_count = c_count + 1
  end
  let i = i + 1
end
print(a_count)
print(b_count)
print(c_count)

let n = 0
let depth = 0
let max_depth = 0
while n < 50000 do
  if n % 2 == 0 then
    if n % 4 == 0 then
      let depth = depth + 1
    else
      let depth = depth - 1
      if depth < 0 then
        let depth = 0
      end
    end
  else
    if depth > max_depth then
      let max_depth = depth
    end
  end
  let n = n + 1
end
print(depth)
print(max_depth)
