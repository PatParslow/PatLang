# Float arithmetic: +, -, *, /, %, comparisons, in a loop.
#
# KNOWN, expected x64 divergence: the x64 backend has never implemented
# float PRINTING (decimal formatting) -- it shows a "<value>" placeholder
# for any float value reaching print() (documented in codegen_x64.patlang's
# own x64_binop_asm_float header). This benchmark's x64 run is therefore
# EXPECTED to disagree with the interpreter/--patc output on every printed
# line here -- that is a pre-existing, already-known limitation being
# exercised on purpose, not a new bug for the harness to flag as
# mysterious. The ARITHMETIC itself (loop timing, correctness of +/-/*/%
# via internal computation) is still exercised and timed identically.

let i = 0
let acc = 0.0
while i < 100000 do
  let acc = acc + 1.5
  let acc = acc - 0.5
  let acc = acc * 2.0
  let acc = acc / 2.0
  let i = i + 1
end
print(acc)

let x = 7.5
let y = 2.0
print(x + y)
print(x - y)
print(x * y)
print(x / y)
print(x % y)
print(x == y)
print(x != y)
print(x < y)
print(x >= y)

let neg = 0.0 - 3.25
print(neg)
