# Plain integer arithmetic: +, -, *, /, %, comparisons, in a tight loop.
# Deliberately stays within the 48-bit fixnum range (no BigInt promotion)
# so this exercises the "fast path" every backend is expected to handle.

let i = 0
let acc = 0
while i < 200000 do
  let acc = acc + i
  let acc = acc - 1
  let acc = acc * 2
  let acc = acc / 2
  let acc = acc % 1000003
  let i = i + 1
end
print(acc)

# a/b deliberately divides evenly (6/3=2) -- an inexact integer
# division (e.g. 7/3) is a genuinely different, tower-only feature
# (promotes to a Rational in the interpreter) that the x64 backend's
# plain/static path doesn't implement at all; that's a known, separate
# limitation, not something this cross-backend comparison benchmark
# should trip over.
let a = 6
let b = 3
print(a + b)
print(a - b)
print(a * b)
print(a / b)
print(a % b)
print(a == b)
print(a != b)
print(a < b)
print(a >= b)
