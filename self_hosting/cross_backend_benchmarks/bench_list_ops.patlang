# List construction (list_push, growable), indexing, length, and a
# linear scan/accumulation loop over the built list.

let lst = []
let i = 0
while i < 20000 do
  let lst = list_push(lst, i)
  let i = i + 1
end
print(lst.length)
print(lst[0])
print(lst[19999])

let acc = 0
let j = 0
while j < lst.length do
  let acc = acc + lst[j]
  let j = j + 1
end
print(acc)

let small = [1, 2, 3, 4, 5]
print(small.length)
print(small[2])
let small = list_push(small, 6)
print(small.length)
print(small[5])
