# GitHub #29: isolates the exact shape that made bench_string_ops and
# bench_bigint_arith run SLOWER on --x64 than the plain interpreter --
# one small string build living in the SAME function as a large,
# entirely unrelated plain-int counting loop. Before the per-instruction
# dynamic-mode fix, x64_func_is_dynamic flagged the WHOLE function
# dynamic because of the one string literal, so every Bin in the loop
# below (including the loop counter's own `i = i + 1`) paid the
# tag-checking dynamic dispatch tax despite never touching a string.

let greeting = "hello" + " " + "world"
print(greeting)

let i = 0
let acc = 0
while i < 200000 do
  let acc = acc + i
  let i = i + 1
end
print(acc)
