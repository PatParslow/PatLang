# Recursive function calls (no memoization) -- exercises call/return
# overhead and stack-frame handling under real recursion depth.

make a function called fib takes n returns yes
  if n < 2 then
    return n
  end
  return fib(n - 1) + fib(n - 2)
end

print(fib(24))

# Named "factorial", not "fact" -- "fact" collides with x64_runtime.
# patlang's own shadowing primitive of the same name (the legacy
# fact/query/goal logic-engine trio), which silently discarded this
# function's own body under --x64 before that collision was made a
# loud compile error instead (see patc1_main.patlang's own fix).
make a function called factorial takes n returns yes
  if n < 2 then
    return 1
  end
  return n * factorial(n - 1)
end

print(factorial(15))
