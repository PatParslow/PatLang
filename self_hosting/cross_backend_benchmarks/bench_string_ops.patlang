# String building (via sb_new/sb_push/sb_str, the O(n) idiom), plain `+`
# concatenation, comparisons, and length, exercising both the loop-heavy
# accumulation path and ordinary user-facing `+`/comparison operators.

let sb = sb_new()
let i = 0
while i < 20000 do
  sb_push(sb, "x")
  let i = i + 1
end
let big_str = sb_str(sb)
print(big_str.length)

let a = "hello"
let b = "world"
let c = a + " " + b
print(c)
print(c.length)

print(a == a)
print(a == b)
print(a != b)
print(a < b)
print(b > a)

let words = ["alpha", "beta", "gamma"]
let acc = ""
let j = 0
while j < words.length do
  let acc = acc + words[j]
  let j = j + 1
end
print(acc)
