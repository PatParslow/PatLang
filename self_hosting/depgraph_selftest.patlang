# Selftest for self_hosting/lib/depgraph.patlang. Standalone (includes its
# own deps, same convention as lint_selftest.patlang), pointed at a small
# checked-in fixture directory (depgraph_selftest_fixture/) rather than
# the real codebase, so cycle detection can be proven against a case
# that's deliberately, verifiably circular.
#
# Fixture layout: a -> b -> c -> b (a deliberate 2-node cycle between b
# and c, reached via a but not itself part of the cycle), and d, a
# standalone leaf included by nothing.
#
# Run from the repo root:
#   rust-runtime/target/release/pat --ir-run self_hosting/depgraph_selftest.patlang

include "lib/test.patlang"
include "lib/includes.patlang"
include "lib/depgraph.patlang"

t_init()

let graph = depgraph_build(["self_hosting/depgraph_selftest_fixture"])
let files = graph[0]

check("collects all 4 fixture files", to_num(list_len(files)), 4)

let a_inc = depgraph_direct_includes(graph, "self_hosting/depgraph_selftest_fixture/a.patlang")
check("a.patlang directly includes exactly b.patlang", to_num(list_len(a_inc)), 1)
check("a.patlang's include is b.patlang", a_inc[0], "self_hosting/depgraph_selftest_fixture/b.patlang")

let b_by = depgraph_included_by(graph, "self_hosting/depgraph_selftest_fixture/b.patlang")
# b is included by both a (a -> b) and c (c -> b, part of the cycle)
check("b.patlang is included by exactly 2 files (a and c)", to_num(list_len(b_by)), 2)

let d_inc = depgraph_direct_includes(graph, "self_hosting/depgraph_selftest_fixture/d.patlang")
check("d.patlang (standalone leaf) has zero includes", to_num(list_len(d_inc)), 0)
let d_by = depgraph_included_by(graph, "self_hosting/depgraph_selftest_fixture/d.patlang")
check("d.patlang is included by nothing", to_num(list_len(d_by)), 0)

let cycles = depgraph_find_cycles(graph)
check("exactly one cycle detected", to_num(list_len(cycles)), 1)
if to_num(list_len(cycles)) > 0 then
  let cyc = cycles[0]
  # the cycle starts and ends on the same node (b or c, whichever DFS
  # order reaches first) -- check that property rather than a fixed order,
  # since DFS visit order over the file list is what determines which of
  # b/c is the reported start.
  let cyc_n = to_num(list_len(cyc))
  check("reported cycle starts and ends on the same file", cyc[0], cyc[cyc_n - 1])
  check("reported cycle involves both b.patlang and c.patlang", (depgraph_list_contains(cyc, "self_hosting/depgraph_selftest_fixture/b.patlang")) and (depgraph_list_contains(cyc, "self_hosting/depgraph_selftest_fixture/c.patlang")), true)
  check("reported cycle does NOT involve a.patlang (a reaches the cycle but isn't part of it)", depgraph_list_contains(cyc, "self_hosting/depgraph_selftest_fixture/a.patlang"), false)
end

t_report()
