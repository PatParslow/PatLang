# Selftest for self_hosting/lib/engine_fuzz.patlang: programs made from seeds,
# each run interpreted and compiled, print the same (review, test-suite
# recommendation 3). The programs call named functions, closures held in
# variables and passed as parameters, a function ending in rest, one that
# shadows the runtime's max, a recursive one, and `let x = f(x, ...)`.
#
#   self_hosting/build/v2_interp.exe self_hosting/engine_fuzz_selftest.patlang
include "lib/gherkin.patlang"
include "lib/v2_engines.patlang"
include "lib/program_run.patlang"
include "lib/engine_fuzz.patlang"

let ctx = ctx_new()
let dir = spec_out() + "/engine_fuzz"
write_file(dir + "/.keep", "")

# the same seed makes the same program, and two seeds two programs
expect(ctx, "a seed's program is the same each time", ef_program(5) == ef_program(5), true)
expect(ctx, "two seeds make two programs", ef_program(5) == ef_program(6), false)

let seeds = 12
let s = 1
while s <= seeds do
  let r = ef_check(dir, s)
  if r[0] == "same" then
    expect(ctx, "seed " + s + " prints the same on both engines", true, true)
  else
    expect(ctx, "seed " + s + " prints the same on both engines (" + r[1] + ": " + r[2] + ")", false, true)
  end
  let s = s + 1
end
ctx_report(ctx)
