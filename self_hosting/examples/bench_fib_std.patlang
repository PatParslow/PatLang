# interpreter/rustc-backend entry point for the recursive-fibonacci
# benchmark -- same logic as bench_fib_x64.patlang, only the final
# print() call differs.

make a function called bench_fib takes n returns result
  if n < 2 then
    return n
  else
    return bench_fib(n - 1) + bench_fib(n - 2)
  end
end

print(bench_fib(32))
