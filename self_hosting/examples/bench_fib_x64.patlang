# x64-backend entry point for the recursive-fibonacci benchmark (see
# bench_fib_core.patlang for the shared logic). n=32 chosen to keep
# even the interpreter path in the low single-digit seconds.

make a function called bench_fib takes n returns result
  if n < 2 then
    return n
  else
    return bench_fib(n - 1) + bench_fib(n - 2)
  end
end

rt_print_i64(bench_fib(32))
