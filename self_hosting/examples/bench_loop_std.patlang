# interpreter/rustc-backend entry point for the loop benchmark -- same
# logic as bench_loop_x64.patlang, only the final print() call differs
# (this path's built-in print, not the x64 backend's rt_print_i64).

make a function called bench_loop takes n returns total
  let i = 0
  let total = 0
  while i < n do
    let total = total + (i * 3 - (i % 7))
    let i = i + 1
  end
  return total
end

print(bench_loop(20000000))
