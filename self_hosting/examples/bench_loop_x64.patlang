# x64-backend entry point for the loop benchmark (see
# bench_loop_core.patlang for the shared logic and why print differs
# per backend). N chosen to run in low single-digit seconds under the
# slowest path (the interpreter) so all three are comparable without
# an excessive wait.

make a function called bench_loop takes n returns total
  let i = 0
  let total = 0
  while i < n do
    let total = total + (i * 3 - (i % 7))
    let i = i + 1
  end
  return total
end

rt_print_i64(bench_loop(20000000))
