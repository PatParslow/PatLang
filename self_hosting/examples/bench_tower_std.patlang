# interpreter/rustc-backend entry point for the tower benchmark -- same
# logic as bench_tower_x64.patlang, only the final print() call differs
# (this path's built-in print, not rt_print_str/rt_bigint_to_string).
# The interpreter/rustc numeric tower auto-promotes plain ints to
# BigInt on overflow already; here acc STARTS large enough that every
# `+ 1` is already firmly in BigInt territory throughout.

make a function called bench_tower takes n returns result
  let acc = 100000000000000
  let i = 0
  while i < n do
    let acc = acc + 1
    let i = i + 1
  end
  return acc
end

print(bench_tower(200000))
