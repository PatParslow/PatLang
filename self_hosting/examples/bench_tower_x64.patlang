# Full-tower benchmark: bench_loop/bench_fib deliberately never touch
# the numeric tower (that's what proved the speed advantage is
# preserved for ordinary code). This one measures the OTHER side: real
# cost of genuinely-dynamic dispatch, when a program actually needs
# it. acc starts already BigInt-tagged and stays BigInt-tagged for
# the whole loop (each += 1 keeps it a small, roughly-constant digit
# count -- avoids unbounded growth exhausting the 16MB bump-allocator
# heap, which never frees). N=200000 -> ~8MB of BigInt block
# allocations, safe within the 16MB reservation.

make a function called bench_tower takes n returns result
  let acc = rt_bigint_from_i64(100000000000000)
  let i = 0
  while i < n do
    let acc = acc + 1
    let i = i + 1
  end
  return acc
end

rt_print_str(rt_bigint_to_string(bench_tower(200000)))
