syntax Loopy {
    trigger: Keyword("loopy");

    tokens {
        WhileKw = "while";
        PrintKw = "print";
        SwitchKw = "switch";
        CaseKw = "case";
        Num(n) = regex("[0-9]+", n);
    }

    rule WhileLine {
        expect WhileKw;
        let cond = expect Num;
        let body = expect Block;
        return let loopy_i = 0
while loopy_i < ${cond} do
${body}
let loopy_i = loopy_i + 1
end;
    }

    rule PrintLine {
        expect PrintKw;
        let val = expect Num;
        return print(${val});
    }

    rule CaseClause {
        expect CaseKw;
        let value = expect Num;
        expect Symbol(":");
        let body = expect Block;
        return if switch_val == ${value} then ${body} end;
    }

    rule SwitchLine {
        expect SwitchKw;
        let val = expect Num;
        expect Symbol("{");
        let cases = expect Many(CaseClause);
        expect Symbol("}");
        return let switch_val = ${val}
${cases};
    }
}

loopy {
    while 3 {
        print 1
        print 2
    }
    switch 7 {
        case 1: {
            print 10
        }
        case 7: {
            print 70
            print 71
        }
    }
}
