# A self-hosted build daemon: run this program once to start it as the
# primary (it does an initial build cycle, then holds a signal port and
# waits), then run it again from a separate invocation with "status",
# "rebuild", or "quit" as an argument.
#
#   self_hosting/build/v2_interp.exe self_hosting/examples/build_daemon_demo.patlang &
#   self_hosting/build/v2_interp.exe self_hosting/examples/build_daemon_demo.patlang status
#   self_hosting/build/v2_interp.exe self_hosting/examples/build_daemon_demo.patlang rebuild
#   self_hosting/build/v2_interp.exe self_hosting/examples/build_daemon_demo.patlang quit
#
# Started with --idle-ms N, the primary also stops by itself, with exit code
# 3, once no signal has reached it for N ms; a quit gives exit code 0. A test
# starts it so, and a quit that is lost cannot leave it holding the port.
#
# Once it holds its port it announces itself as "build_daemon"
# (self_hosting/lib/signal_discovery.patlang), so another program can find
# the port and its actions without being told them.
#
# Five PatLang capabilities working together here, all in
# self_hosting/lib/build_daemon.patlang (this file is just the driver):
# logic (rule_add/solve, "which targets are stale"), goal-seeking
# (action_add/plan, GOAP, "what order to build in, weighted by real
# historical cost"), self-timing + persistence (now_ms(), a history file
# that survives between runs), events (when/emit, driving the dashboard
# below), and runtime signals (this file's own status/rebuild/quit
# handling, via self_hosting/lib/signals.patlang).

include "../lib/context.patlang"
include "../lib/build_daemon.patlang"
include "../lib/signal_discovery.patlang"

let BD_PORT = 9410

let ctx = context_new()
context_hold(ctx)

when bd_job_started do
  let ctx = context_held()
  let colon = find_substr_signals(event_data, ":")
  let target = substr(event_data, 0, colon)
  let est = substr(event_data, colon + 1, event_data.length - colon - 1)
  let done = ctx_get(ctx, "bd_done_count")
  let total = ctx_get(ctx, "bd_plan_len")
  print("[" + (done + 1) + "/" + total + "] " + target + ": building (est. " + est + "ms)")
end

when bd_job_finished do
  let ctx = context_held()
  let colon = find_substr_signals(event_data, ":")
  let target = substr(event_data, 0, colon)
  let actual = substr(event_data, colon + 1, event_data.length - colon - 1)
  let done = ctx_get(ctx, "bd_done_count")
  let total = ctx_get(ctx, "bd_plan_len")
  print("[" + done + "/" + total + "] " + target + ": done (" + actual + "ms actual)")
end

when status do
  let ctx = context_held()
  let total = ctx_get(ctx, "bd_plan_len")
  let done = ctx_get(ctx, "bd_done_count")
  let eta = ctx_get(ctx, "bd_eta_total_ms")
  signal_reply("build daemon: last cycle rebuilt " + done + "/" + total + " target(s), estimated " + eta + "ms total")
end

when rebuild do
  let ctx = context_held()
  print("DAEMON: rebuild requested")
  ctx_set(ctx, "bd_rebuild_requested", "1")
end

when quit do
  let ctx = context_held()
  print("DAEMON: quit requested, shutting down")
  ctx_set(ctx, "bd_should_stop", "1")
end

# --idle-ms N first, if given; what follows is the client's signal name
let cli_args = argv()
let idle_ms = 0
if (cli_args.length >= 2) and (cli_args[0] == "--idle-ms") then
  let idle_ms = to_num(cli_args[1])
  let rest = []
  let ai = 2
  while ai < cli_args.length do
    let rest = list_push(rest, cli_args[ai])
    let ai = ai + 1
  end
  let cli_args = rest
end

let port_id = signal_claim(BD_PORT)
signal_allow(["status", "rebuild", "quit"])
if port_id >= 0 then
  signal_announce("build_daemon", BD_PORT, [["status", "how far the last build cycle got"], ["rebuild", "run another build cycle"], ["quit", "stop the daemon"]])
  print("DAEMON: holding port " + BD_PORT + ", running initial build cycle")
  bd_run_cycle(ctx)
  print("DAEMON: initial cycle done, watching for signals (status / rebuild / quit)")
  ctx_set(ctx, "bd_should_stop", "0")
  ctx_set(ctx, "bd_rebuild_requested", "0")
  let last_signal = now_ms()
  let idled = false
  while (ctx_get(ctx, "bd_should_stop") == "0") and (not idled) do
    let got = signal_poll(port_id, 200)
    if got != "" then
      let last_signal = now_ms()
    end
    if ctx_get(ctx, "bd_rebuild_requested") == "1" then
      ctx_set(ctx, "bd_rebuild_requested", "0")
      bd_run_cycle(ctx)
      let last_signal = now_ms()
    end
    if (idle_ms > 0) and (now_ms() - last_signal > idle_ms) then
      let idled = true
    end
  end
  if idled then
    print("DAEMON: no signal for " + idle_ms + " ms, exiting")
    exit_with(3)
  end
  print("DAEMON: exiting")
else
  let sig_name = "status"
  if cli_args.length > 0 then
    let sig_name = cli_args[0]
  end
  if sig_name == "status" then
    let reply = signal_query(BD_PORT, "status", "")
    print("CLIENT: " + reply)
  else
    signal_send(BD_PORT, sig_name, "")
    print("CLIENT: sent '" + sig_name + "' to the daemon")
  end
end
