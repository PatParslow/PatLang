# BDD-style verification of self_hosting/lib/cli.patlang, using the
# existing Gherkin runner in self_hosting/lib/gherkin.patlang.

include "../lib/includes.patlang"
include "../lib/cli.patlang"
include "../lib/includes.patlang"
include "../lib/gherkin.patlang"

# ---- step definitions ----

make a function called st_cli_short_args takes ctx returns done
  ctx_set(ctx, "cli_args", ["only-one"])
  return true
end

make a function called st_cli_check_requires_two takes ctx returns done
  let args = ctx_get(ctx, "cli_args")
  let ok = require_args(args, 2, "usage: thing <a> <b>")
  ctx_set(ctx, "cli_require_result", ok)
  return true
end

make a function called st_cli_require_result_is_false takes ctx returns done
  expect(ctx, "require_args returns false when args are short", ctx_get(ctx, "cli_require_result"), false)
  return true
end

make a function called st_cli_full_args takes ctx returns done
  ctx_set(ctx, "cli_args", ["first", "second"])
  return true
end

make a function called st_cli_check_requires_two_again takes ctx returns done
  let args = ctx_get(ctx, "cli_args")
  let ok = require_args(args, 2, "usage: thing <a> <b>")
  ctx_set(ctx, "cli_require_result", ok)
  return true
end

make a function called st_cli_require_result_is_true takes ctx returns done
  expect(ctx, "require_args returns true when args are sufficient", ctx_get(ctx, "cli_require_result"), true)
  return true
end

make a function called st_cli_present_index takes ctx returns done
  let args = ctx_get(ctx, "cli_args")
  ctx_set(ctx, "cli_default_result", arg_or_default(args, 1, "fallback"))
  return true
end

make a function called st_cli_default_matches_present_value takes ctx returns done
  expect(ctx, "arg_or_default returns the actual value when present", ctx_get(ctx, "cli_default_result"), "second")
  return true
end

make a function called st_cli_missing_index takes ctx returns done
  let args = ctx_get(ctx, "cli_args")
  ctx_set(ctx, "cli_default_result", arg_or_default(args, 5, "fallback"))
  return true
end

make a function called st_cli_default_matches_fallback takes ctx returns done
  expect(ctx, "arg_or_default returns the default when the index is missing", ctx_get(ctx, "cli_default_result"), "fallback")
  return true
end

make a function called register_cli_steps takes ctx returns done
  step(ctx, "too few args for a two-arg command", "st_cli_short_args")
  step(ctx, "require_args is checked against a two-arg minimum", "st_cli_check_requires_two")
  step(ctx, "it reports the args as insufficient", "st_cli_require_result_is_false")
  step(ctx, "enough args for a two-arg command", "st_cli_full_args")
  step(ctx, "require_args is checked again against a two-arg minimum", "st_cli_check_requires_two_again")
  step(ctx, "it reports the args as sufficient", "st_cli_require_result_is_true")
  step(ctx, "a present positional index is requested with a fallback", "st_cli_present_index")
  step(ctx, "it returns the actual argument, not the fallback", "st_cli_default_matches_present_value")
  step(ctx, "a missing positional index is requested with a fallback", "st_cli_missing_index")
  step(ctx, "it returns the fallback", "st_cli_default_matches_fallback")
  return true
end

make a function called cli_feature returns text
  return "Feature: argv helpers

Scenario: require_args rejects too few arguments
  Given too few args for a two-arg command
  When require_args is checked against a two-arg minimum
  Then it reports the args as insufficient

Scenario: require_args accepts enough arguments
  Given enough args for a two-arg command
  When require_args is checked again against a two-arg minimum
  Then it reports the args as sufficient

Scenario: arg_or_default returns the real value when present
  Given enough args for a two-arg command
  When a present positional index is requested with a fallback
  Then it returns the actual argument, not the fallback

Scenario: arg_or_default falls back when the index is missing
  Given enough args for a two-arg command
  When a missing positional index is requested with a fallback
  Then it returns the fallback
"
end

make a function called run_cli_bdd takes ctx returns ok
  let ctx = ctx_new()
  register_cli_steps(ctx)
  run_feature(ctx, cli_feature())
  ctx_report(ctx)
  return ctx_failed(ctx) == 0
end

let ctx = ctx_new()
run_cli_bdd(ctx)
