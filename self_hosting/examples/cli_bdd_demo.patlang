# BDD-style verification of self_hosting/lib/cli.patlang, using the
# existing Gherkin runner in self_hosting/lib/test.patlang.

include "../lib/includes.patlang"
include "../lib/cli.patlang"
include "../lib/test.patlang"

# ---- step definitions ----

make a function called st_cli_short_args returns done
  set_var("cli_args", ["only-one"])
  return true
end

make a function called st_cli_check_requires_two returns done
  let args = get("__vars", "cli_args")
  let ok = require_args(args, 2, "usage: thing <a> <b>")
  set_var("cli_require_result", ok)
  return true
end

make a function called st_cli_require_result_is_false returns done
  check("require_args returns false when args are short", get("__vars", "cli_require_result"), false)
  return true
end

make a function called st_cli_full_args returns done
  set_var("cli_args", ["first", "second"])
  return true
end

make a function called st_cli_check_requires_two_again returns done
  let args = get("__vars", "cli_args")
  let ok = require_args(args, 2, "usage: thing <a> <b>")
  set_var("cli_require_result", ok)
  return true
end

make a function called st_cli_require_result_is_true returns done
  check("require_args returns true when args are sufficient", get("__vars", "cli_require_result"), true)
  return true
end

make a function called st_cli_present_index returns done
  let args = get("__vars", "cli_args")
  set_var("cli_default_result", arg_or_default(args, 1, "fallback"))
  return true
end

make a function called st_cli_default_matches_present_value returns done
  check("arg_or_default returns the actual value when present", get("__vars", "cli_default_result"), "second")
  return true
end

make a function called st_cli_missing_index returns done
  let args = get("__vars", "cli_args")
  set_var("cli_default_result", arg_or_default(args, 5, "fallback"))
  return true
end

make a function called st_cli_default_matches_fallback returns done
  check("arg_or_default returns the default when the index is missing", get("__vars", "cli_default_result"), "fallback")
  return true
end

make a function called register_cli_steps returns done
  step("too few args for a two-arg command", "st_cli_short_args")
  step("require_args is checked against a two-arg minimum", "st_cli_check_requires_two")
  step("it reports the args as insufficient", "st_cli_require_result_is_false")
  step("enough args for a two-arg command", "st_cli_full_args")
  step("require_args is checked again against a two-arg minimum", "st_cli_check_requires_two_again")
  step("it reports the args as sufficient", "st_cli_require_result_is_true")
  step("a present positional index is requested with a fallback", "st_cli_present_index")
  step("it returns the actual argument, not the fallback", "st_cli_default_matches_present_value")
  step("a missing positional index is requested with a fallback", "st_cli_missing_index")
  step("it returns the fallback", "st_cli_default_matches_fallback")
  return true
end

make a function called cli_feature returns text
  return "Feature: argv helpers

Scenario: require_args rejects too few arguments
  Given too few args for a two-arg command
  When require_args is checked against a two-arg minimum
  Then it reports the args as insufficient

Scenario: require_args accepts enough arguments
  Given enough args for a two-arg command
  When require_args is checked again against a two-arg minimum
  Then it reports the args as sufficient

Scenario: arg_or_default returns the real value when present
  Given enough args for a two-arg command
  When a present positional index is requested with a fallback
  Then it returns the actual argument, not the fallback

Scenario: arg_or_default falls back when the index is missing
  Given enough args for a two-arg command
  When a missing positional index is requested with a fallback
  Then it returns the fallback
"
end

make a function called run_cli_bdd returns ok
  t_init()
  register_cli_steps()
  run_feature(cli_feature())
  t_report()
  return get("__vars", "t_fail") == 0
end

run_cli_bdd()
