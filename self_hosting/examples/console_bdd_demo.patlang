# BDD-style verification of self_hosting/lib/console.patlang, using the
# existing Gherkin runner in self_hosting/lib/gherkin.patlang.
#
# Covers: empty input is a no-op, a registered handler's success/failure
# paths (plain bool vs. a handler-supplied rich proc.patlang result), an
# unrecognized command with no self-healing configured, and the pluggable
# self-healing hand-off itself (both a synthesis success and a synthesis
# failure) -- using fake heal_fn step functions standing in for
# friendly_cli's own adapter, proving the hand-off is genuinely pluggable
# (this spec never includes self_healing_engine.patlang at all).

include "../lib/includes.patlang"
include "../lib/console.patlang"
include "../lib/includes.patlang"
include "../lib/gherkin.patlang"

# ---- fake handlers under test ----

make a function called ts_handler_ok takes ctx returns ok
  let args = ctx_get(ctx, "console_args")
  ctx_set(ctx, "ts_seen_args", args)
  return true
end

make a function called ts_handler_fail_plain takes ctx returns ok
  return false
end

make a function called ts_handler_fail_rich takes ctx returns ok
  ctx_set(ctx, "console_last_proc_result", ["1", "", "boom", "CommandNotFound", "try installing boom"])
  ctx_set(ctx, "console_last_proc_result_set", true)
  return false
end

# ---- fake heal_fn adapters under test ----

make a function called ts_heal_success takes ctx returns healed
  ctx_set(ctx, "ts_heal_was_called_with", ctx_get(ctx, "console_heal_command_name"))
  return true
end

make a function called ts_heal_failure takes ctx returns healed
  ctx_set(ctx, "ts_heal_was_called_with", ctx_get(ctx, "console_heal_command_name"))
  return false
end

# ---- shared fixture ----

make a function called ts_dispatch_table returns table
  return [
    ["greet", "ts_handler_ok"],
    ["breakplain", "ts_handler_fail_plain"],
    ["breakrich", "ts_handler_fail_rich"]
  ]
end

# ---- step definitions ----

make a function called st_console_empty_input takes ctx returns done
  let state = console_new_state("interactive")
  let result = console_step(ctx, state, "   ", ts_dispatch_table())
  ctx_set(ctx, "console_result", result)
  return true
end

make a function called st_console_empty_is_noop takes ctx returns done
  let result = ctx_get(ctx, "console_result")
  expect(ctx, "empty input reports ok", cs_result_ok(result), true)
  expect(ctx, "empty input produces no output event", cs_result_output(result), "")
  return true
end

make a function called st_console_known_command takes ctx returns done
  let state = console_new_state("interactive")
  let result = console_step(ctx, state, "greet world again", ts_dispatch_table())
  ctx_set(ctx, "console_result", result)
  return true
end

make a function called st_console_known_command_succeeds takes ctx returns done
  let result = ctx_get(ctx, "console_result")
  expect(ctx, "a known command reports ok", cs_result_ok(result), true)
  expect(ctx, "the handler saw the args after the command name", ctx_get(ctx, "ts_seen_args"), ["world", "again"])
  return true
end

make a function called st_console_plain_failure takes ctx returns done
  let state = console_new_state("interactive")
  let result = console_step(ctx, state, "breakplain", ts_dispatch_table())
  ctx_set(ctx, "console_result", result)
  return true
end

make a function called st_console_plain_failure_is_generic takes ctx returns done
  let result = ctx_get(ctx, "console_result")
  expect(ctx, "a plain handler failure reports not-ok", cs_result_ok(result), false)
  expect(ctx, "a plain handler failure is not treated as healed", cs_result_healed_command(result), "")
  return true
end

make a function called st_console_rich_failure takes ctx returns done
  let state = console_new_state("interactive")
  let result = console_step(ctx, state, "breakrich extra", ts_dispatch_table())
  ctx_set(ctx, "console_result", result)
  return true
end

make a function called st_console_rich_failure_carries_hint takes ctx returns done
  let result = ctx_get(ctx, "console_result")
  expect(ctx, "a rich handler failure reports not-ok", cs_result_ok(result), false)
  expect(ctx, "a rich handler failure's diagnostic hint reaches the output event", contains_text(cs_result_output(result), "try installing boom"), true)
  return true
end

make a function called st_console_unknown_no_healer takes ctx returns done
  let state = console_new_state("interactive")
  let result = console_step(ctx, state, "frobnicate", ts_dispatch_table())
  ctx_set(ctx, "console_result", result)
  return true
end

make a function called st_console_unknown_no_healer_reports_error takes ctx returns done
  let result = ctx_get(ctx, "console_result")
  expect(ctx, "an unrecognized command with no healer reports not-ok", cs_result_ok(result), false)
  expect(ctx, "an unrecognized command with no healer is not marked healed", cs_result_healed_command(result), "")
  expect(ctx, "an unrecognized command's diagnostic mentions the command name", contains_text(cs_result_output(result), "frobnicate"), true)
  return true
end

make a function called st_console_unknown_with_successful_healer takes ctx returns done
  let state = console_with_heal_fn(console_new_state("interactive"), "ts_heal_success")
  let result = console_step(ctx, state, "frobnicate now", ts_dispatch_table())
  ctx_set(ctx, "console_result", result)
  return true
end

make a function called st_console_healed_command_reported takes ctx returns done
  let result = ctx_get(ctx, "console_result")
  expect(ctx, "a successfully healed command reports ok", cs_result_ok(result), true)
  expect(ctx, "a successfully healed command names itself as healed_command", cs_result_healed_command(result), "frobnicate")
  expect(ctx, "the heal_fn was handed the unrecognized command name", ctx_get(ctx, "ts_heal_was_called_with"), "frobnicate")
  return true
end

make a function called st_console_unknown_with_failing_healer takes ctx returns done
  let state = console_with_heal_fn(console_new_state("interactive"), "ts_heal_failure")
  let result = console_step(ctx, state, "wobblenate", ts_dispatch_table())
  ctx_set(ctx, "console_result", result)
  return true
end

make a function called st_console_failed_heal_falls_back_to_diagnostic takes ctx returns done
  let result = ctx_get(ctx, "console_result")
  expect(ctx, "a failed heal attempt still reports not-ok", cs_result_ok(result), false)
  expect(ctx, "a failed heal attempt is not marked healed", cs_result_healed_command(result), "")
  return true
end

make a function called st_console_agent_mode_command takes ctx returns done
  let state = console_new_state("agent")
  let result = console_step(ctx, state, "breakrich", ts_dispatch_table())
  ctx_set(ctx, "console_result", result)
  return true
end

make a function called st_console_agent_mode_output_is_json takes ctx returns done
  let result = ctx_get(ctx, "console_result")
  expect(ctx, "agent mode renders the output event starting with a json brace", str_starts_with(cs_result_output(result), "{"), true)
  expect(ctx, "agent mode json carries the command name", contains_text(cs_result_output(result), "\"message\":\"breakrich failed\""), true)
  return true
end

make a function called register_console_steps takes ctx returns done
  step(ctx, "an empty (whitespace-only) input line", "st_console_empty_input")
  step(ctx, "it is stepped through the console core", "st_console_empty_is_noop")
  step(ctx, "a line invoking a known, successful command with arguments", "st_console_known_command")
  step(ctx, "the handler runs successfully", "st_console_known_command_succeeds")
  step(ctx, "a line invoking a command whose handler fails plainly", "st_console_plain_failure")
  step(ctx, "it reports a generic failure", "st_console_plain_failure_is_generic")
  step(ctx, "a line invoking a command whose handler fails with a rich proc result", "st_console_rich_failure")
  step(ctx, "the diagnostic hint from that result reaches the output", "st_console_rich_failure_carries_hint")
  step(ctx, "a line invoking an unrecognized command with no healer configured", "st_console_unknown_no_healer")
  step(ctx, "it reports an unknown-command error naming the command", "st_console_unknown_no_healer_reports_error")
  step(ctx, "a line invoking an unrecognized command with a healer that succeeds", "st_console_unknown_with_successful_healer")
  step(ctx, "it reports the command as healed", "st_console_healed_command_reported")
  step(ctx, "a line invoking an unrecognized command with a healer that fails", "st_console_unknown_with_failing_healer")
  step(ctx, "it falls back to an ordinary diagnostic, not marked healed", "st_console_failed_heal_falls_back_to_diagnostic")
  step(ctx, "a line invoking a failing command in agent mode", "st_console_agent_mode_command")
  step(ctx, "the output event is rendered as json", "st_console_agent_mode_output_is_json")
  return true
end

make a function called console_feature returns text
  return "Feature: embeddable console core

Scenario: empty input is a no-op
  Given an empty (whitespace-only) input line
  When it is stepped through the console core
  Then it is stepped through the console core

Scenario: a known command dispatches with its arguments
  Given a line invoking a known, successful command with arguments
  When the handler runs successfully
  Then the handler runs successfully

Scenario: a plain handler failure reports a generic error
  Given a line invoking a command whose handler fails plainly
  When it reports a generic failure
  Then it reports a generic failure

Scenario: a rich handler failure surfaces its diagnostic hint
  Given a line invoking a command whose handler fails with a rich proc result
  When the diagnostic hint from that result reaches the output
  Then the diagnostic hint from that result reaches the output

Scenario: an unrecognized command with no healer reports an error
  Given a line invoking an unrecognized command with no healer configured
  When it reports an unknown-command error naming the command
  Then it reports an unknown-command error naming the command

Scenario: an unrecognized command is healed when a healer succeeds
  Given a line invoking an unrecognized command with a healer that succeeds
  When it reports the command as healed
  Then it reports the command as healed

Scenario: a failed healing attempt falls back to an ordinary diagnostic
  Given a line invoking an unrecognized command with a healer that fails
  When it falls back to an ordinary diagnostic, not marked healed
  Then it falls back to an ordinary diagnostic, not marked healed

Scenario: agent mode renders output events as json
  Given a line invoking a failing command in agent mode
  When the output event is rendered as json
  Then the output event is rendered as json
"
end

make a function called run_console_bdd takes ctx returns ok
  let ctx = ctx_new()
  register_console_steps(ctx)
  run_feature(ctx, console_feature())
  ctx_report(ctx)
  return ctx_failed(ctx) == 0
end

let ctx = ctx_new()
run_console_bdd(ctx)
