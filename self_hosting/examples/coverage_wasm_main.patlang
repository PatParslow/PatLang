# Compiled driver for the browser coverage page (self_hosting/tools/
# build_portfolio.patlang's coverage_page). Takes source text as argv[0]
# (already fully expanded -- no include lines), instruments it, and prints
# the catalog followed by the instrumented source, separated by a literal
# marker line the browser JS splits on -- same shape as the other browser
# drivers this session built (hexrts_main.patlang, sql_console_main.patlang).
# The browser then runs the INSTRUMENTED source through the existing shared
# "playground" wasm module (the same one the REPL uses) to actually collect
# coverage -- this module's only job is the static instrument step, not
# running anything itself.

include "../lib/coverage.patlang"

let args = argv()
let source = ""
if args.length >= 1 then
  let source = args[0]
end

let result = cov_instrument(source)
let instrumented = result[0]
let catalog = result[1]

let i = 0
let n = to_num(list_len(catalog))
while i < n do
  let entry = catalog[i]
  print("BRANCH:" + entry[0] + "," + entry[1] + "," + entry[2] + "," + entry[4])
  print("COND:" + entry[3])
  let i = i + 1
end
print("===INSTRUMENTED===")
print(instrumented)
