# Minimal HTTP echo server in the Stage 1 self-hosted language.
# Listens on an OS-assigned port, prints "PORT: <n>", serves exactly two
# requests (echoing the first request line back in the body), then exits.
# Compiled natively via the PatLang front-end (see pipeline_stage2 flow).

make a function called crlf returns s
  return chr(13) + chr(10)
end

make a function called first_line takes text returns line
  let line = ""
  let i = 0
  let scanning = true
  while (i < text.length) and scanning do
    let c = char_code(text, i)
    if (c == 13) or (c == 10) then
      let scanning = false
    else
      let line = line + text[i]
      let i = i + 1
    end
  end
  return line
end

make a function called serve_one takes port returns done
  let conn = tcp_accept(port)
  let request = tcp_read(conn)
  let reqline = first_line(request)
  let body = "echo: " + reqline
  let response = "HTTP/1.1 200 OK" + crlf() + "Content-Length: " + body.length + crlf() + "Connection: close" + crlf() + crlf() + body
  tcp_write(conn, response)
  tcp_close(conn)
  print("SERVED: " + reqline)
  return true
end

let port = tcp_listen(0)
print("PORT: " + port)
serve_one(port)
serve_one(port)
print("DONE")
