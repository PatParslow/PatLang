# Event loop with closure callbacks (Stage 1 self-hosted language).
# Compare with examples/event_loop_server.patlang, which uses when/emit +
# set_var/get: here, callbacks are ordinary closures registered on the loop,
# each closing over whatever state it needs instead of going through a
# global event-name dispatch and a shared __vars namespace.

make a function called first_line takes text returns line
  let b = sb_new()
  let i = 0
  let scanning = true
  while (i < text.length) and scanning do
    let c = char_code(text, i)
    if (c == 13) or (c == 10) then
      let scanning = false
    else
      sb_push(b, text[i])
      let i = i + 1
    end
  end
  return sb_str(b)
end

make a function called eld_contains takes hay, needle returns found
  let hn = hay.length
  let nn = needle.length
  let found = false
  let i = 0
  while (i <= hn - nn) and (not found) do
    if substr(hay, i, nn) == needle then
      let found = true
    end
    let i = i + 1
  end
  return found
end

# tcp_read(conn) is a single, possibly-partial read (TCP is a byte
# stream -- the OS can legitimately deliver one client write() across
# more than one server read(), especially under scheduler load; see
# self_hosting/examples/echo_server.patlang's identical helper for the
# real, reproduced flake this fixes). Loop accumulating chunks until the
# full header block has arrived or the peer closes early.
make a function called read_http_request takes conn returns text
  let text = tcp_read(conn)
  let looping = true
  while looping do
    if eld_contains(text, chr(13) + chr(10) + chr(13) + chr(10)) then
      let looping = false
    else
      let more = tcp_read(conn)
      if more == "" then
        let looping = false
      else
        let text = text + more
      end
    end
  end
  return text
end

let loop = event_loop_new()
new("Stats", "stats")
send("stats", "set", "served", 0)
send("stats", "set", "ticks", 0)

let on_tick = || do
  send("stats", "set", "ticks", get("stats", "ticks") + 1)
end
event_loop_on_tick(loop, on_tick)

let on_request = |conn| do
  let request = read_http_request(conn)
  let reqline = first_line(request)
  let served = get("stats", "served") + 1
  send("stats", "set", "served", served)
  let body = "handled by event loop (closures): " + reqline + "\n" + "ticks so far: " + get("stats", "ticks")
  let sep = chr(13) + chr(10)
  let response = "HTTP/1.1 200 OK" + sep + "Content-Length: " + body.length + sep + "Connection: close" + sep + sep + body
  tcp_write(conn, response)
  tcp_close(conn)
  print("SERVED: " + reqline)
  if served >= 2 then
    event_loop_stop(loop)
  end
end
event_loop_listen(loop, tcp_listen(0), on_request)

print("PORT: " + get(loop, "port"))
event_loop_run(loop, 50)
print("DONE after " + get("stats", "ticks") + " ticks")
