# Event-driven server in the Stage 1 self-hosted language.
# A single-threaded event loop (like JS/Node) dispatches events to `when`
# handlers: incoming connections become "request" events, and idle passes
# emit periodic "tick" events. Shared state lives in the object store via
# set_var / get. Serves two requests, then exits.

make a function called first_line takes text returns line
  let b = sb_new()
  let i = 0
  let scanning = true
  while (i < text.length) and scanning do
    let c = char_code(text, i)
    if (c == 13) or (c == 10) then
      let scanning = false
    else
      sb_push(b, text[i])
      let i = i + 1
    end
  end
  return sb_str(b)
end

make a function called els_contains takes hay, needle returns found
  let hn = hay.length
  let nn = needle.length
  let found = false
  let i = 0
  while (i <= hn - nn) and (not found) do
    if substr(hay, i, nn) == needle then
      let found = true
    end
    let i = i + 1
  end
  return found
end

# tcp_read(conn) is a single, possibly-partial read (TCP is a byte
# stream -- the OS can legitimately deliver one client write() across
# more than one server read(), especially under scheduler load; see
# self_hosting/examples/echo_server.patlang's identical helper for the
# real, reproduced flake this fixes). Loop accumulating chunks until the
# full header block has arrived or the peer closes early.
make a function called read_http_request takes conn returns text
  let text = tcp_read(conn)
  let looping = true
  while looping do
    if els_contains(text, chr(13) + chr(10) + chr(13) + chr(10)) then
      let looping = false
    else
      let more = tcp_read(conn)
      if more == "" then
        let looping = false
      else
        let text = text + more
      end
    end
  end
  return text
end

when request do
  # event_data is the connection id
  let request_text = read_http_request(event_data)
  let reqline = first_line(request_text)
  let body = "handled by event loop: " + reqline + "\n" + "ticks so far: " + get("__vars", "ticks")
  let sep = "\r\n"
  let response = "HTTP/1.1 200 OK" + sep + "Content-Length: " + body.length + sep + "Connection: close" + sep + sep + body
  tcp_write(event_data, response)
  tcp_close(event_data)
  set_var("served", get("__vars", "served") + 1)
  print("SERVED: " + reqline)
end

when tick do
  set_var("ticks", get("__vars", "ticks") + 1)
end

set_var("served", 0)
set_var("ticks", 0)
let port = tcp_listen(0)
print("PORT: " + port)

# ---- the event loop ----
while get("__vars", "served") < 2 do
  let conn = tcp_accept_timeout(port, 50)
  if conn >= 0 then
    emit("request", conn)
  else
    emit("tick", 0)
  end
end
print("DONE after " + get("__vars", "ticks") + " ticks")
