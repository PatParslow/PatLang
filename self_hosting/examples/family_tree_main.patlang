# Compiled driver for the browser family-tree page (self_hosting/tools/
# build_portfolio.patlang's family_tree_page). Same "recompute full state
# from a snapshot every call" model as hexrts_main.patlang -- this is a
# normal compiled program (argv in, print out), not a persistent process,
# so the ENTIRE edge set is rebuilt from argv[0] every call, not just the
# newest edge.
#
#   argv[0] = every recorded "child,parent" edge, one per line
#   argv[1] = query kind: "" (no query), "ancestors", "descendants", or
#             "siblings"
#   argv[2] = query subject id (ignored if argv[1] is "")
#
# Prints, one line each:
#   NODE:<id>,<level>              -- every individual, for layout
#   EDGE:<child>,<parent>          -- every recorded edge, for drawing
#   HILITE:<id>                    -- one per id in the query result set
#   REPORT:<line>                  -- family_tree_report(subject), reformatted
#                                      one REPORT: line per line of the report
# (skips the SQL layer entirely -- see ../lib/family_tree.patlang's own
# note on why the durable/indexed SQL version exists; a single browser
# tab's tree, rebuilt fresh every tick, has no persistence need and no
# scale need that would justify it here.)

include "../lib/family_tree.patlang"

make a function called parse_edges takes text returns done
  let lines = split_lines(text)
  let n = to_num(list_len(lines))
  let i = 0
  while i < n do
    let line = str_trim(lines[i])
    if line != "" then
      let fields = rdb_split_comma(line)
      if to_num(list_len(fields)) == 2 then
        record_parent(fields[0], fields[1])
      end
    end
    let i = i + 1
  end
  return true
end

let args = argv()
let edges_text = ""
let query_kind = ""
let query_subject = ""
if args.length >= 1 then
  let edges_text = args[0]
end
if args.length >= 2 then
  let query_kind = args[1]
end
if args.length >= 3 then
  let query_subject = args[2]
end

family_init()
parse_edges(edges_text)

let ids = all_individuals()
let n_ids = to_num(list_len(ids))
let i = 0
while i < n_ids do
  let id = ids[i]
  print("NODE:" + id + "," + individual_level(id))
  let ps = parents_of(id)
  let n_ps = to_num(list_len(ps))
  let j = 0
  while j < n_ps do
    print("EDGE:" + id + "," + ps[j])
    let j = j + 1
  end
  let i = i + 1
end

if query_kind == "ancestors" then
  let hits = ancestors_of(query_subject)
  let n_hits = to_num(list_len(hits))
  let k = 0
  while k < n_hits do
    print("HILITE:" + hits[k])
    let k = k + 1
  end
end
if query_kind == "descendants" then
  let hits = descendants_of(query_subject)
  let n_hits = to_num(list_len(hits))
  let k = 0
  while k < n_hits do
    print("HILITE:" + hits[k])
    let k = k + 1
  end
end
if query_kind == "siblings" then
  let hits = siblings_of(query_subject)
  let n_hits = to_num(list_len(hits))
  let k = 0
  while k < n_hits do
    print("HILITE:" + hits[k])
    let k = k + 1
  end
end
if query_kind != "" then
  let report = family_tree_report(query_subject)
  let report_lines = split_lines(report)
  let n_lines = to_num(list_len(report_lines))
  let m = 0
  while m < n_lines do
    if str_trim(report_lines[m]) != "" then
      print("REPORT:" + report_lines[m])
    end
    let m = m + 1
  end
end
