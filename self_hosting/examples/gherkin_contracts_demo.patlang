# Gherkin-driven compile-time contracts for GOAP synthesis (GitHub issue
# #12) -- a worked, narrated demonstration, distinct from the automated
# test coverage in self_hosting/examples/goap_contract_bdd_demo.patlang
# (which uses the check()/t_report() test framework and is meant to run
# quietly as part of the regression suite, not to be read as a story).
#
# The idea: a Gherkin .feature scenario can carry inline contract clauses
# --
#   And require x < 10
#   And ensure x < 20
# -- checked as real preconditions/postconditions, WITHOUT paying for a
# runtime assertion in the final program. This file walks that mechanism
# directly, in three acts: a plain hand-written function, a genuinely
# GOAP-synthesized action, and a deliberately broken one so you can see
# the rejection actually happen rather than take it on faith.

include "../lib/includes.patlang"
include "../lib/test.patlang"
include "../lib/gherkin_contracts.patlang"

print("=== Act 1: a require/ensure clause checked against a hand-written function ===")
print("")
print("Feature text:")
print("  Given an integer x")
print("  And require x < 10")
print("  When I do something brilliant")
print("  Then it returns 2*x")
print("  And ensure x < 20")
print("")

# "Given an integer x" -- an ordinary Given step binds the global x.
set_var("x", 5)
print("Given step ran: x = 5")

# "And require x < 10" -- handle_contract_step parses the clause and,
# since x is ALREADY bound, evaluates it immediately (the same shape a
# hand-written `require x < 10` statement inside an ordinary function
# body would have -- just triggered from a Gherkin step instead).
handle_contract_step("require", "x < 10")

# "When I do something brilliant" -- the actual transformation. Note this
# function has no idea a contract clause exists; the check happened
# entirely outside it.
let x = get("__vars", "x")
let result = x * 2
print("When step ran: result = x * 2 = " + result)

# "And ensure x < 20" -- checked the same way, against the value that
# already exists.
handle_contract_step("ensure", "x < 20")

print("")
print("=== Act 2: the same clauses checked against a GENUINELY GOAP-synthesized action ===")
print("")
print("Feature text:")
print("  Given a scalable input of 5")
print("  And require X < 10")
print("  When a scale action is synthesized for that input")
print("  And ensure X < 20")
print("  Then the plan satisfies its contract clauses")
print("")

# A real GOAP action template: scale(X) requires input(X), produces
# scaled(X) -- the same parameterized-action shape as
# self_hosting/examples/goap_parameterized_demo.patlang's build(X).
action_add("scale", [["input", ["X"]]], [["scaled", ["X"]]], [], 1)
rule_add("input", ["5"], [])
print("Registered action scale(X): requires input(X), produces scaled(X)")

# The require/ensure clauses reference "X" -- but nothing has bound X to
# anything yet at this point (no GOAP search has run), so
# handle_contract_step DEFERS them instead of evaluating immediately --
# stashed for later, once a real candidate exists to check them against.
handle_contract_step("require", "X < 10")
handle_contract_step("ensure", "X < 20")

# Now the actual synthesis: plan() searches for a sequence of actions
# reaching the goal "scaled(5)". It finds exactly one: scale(X=5).
let labels = plan([["scaled", ["5"]]])
print("plan([[\"scaled\", [\"5\"]]]) synthesized: " + labels[0])

# goap_verify_contracts parses "X=5" directly out of that label string --
# NOT a GOAP GroundFact, since "X < 10" isn't a unifiable ground
# predicate the way action_add's own preconditions are -- and evaluates
# the deferred clauses against it, BEFORE this candidate would be
# accepted or any code generated for it.
let pending = get("__vars", "t_pending_contracts")
let ok = goap_verify_contracts(pending, labels)
set_var("t_pending_contracts", [])
print("Contract check on synthesized candidate scale(X=5): " + ok)

print("")
print("=== Act 3: a synthesized candidate that VIOLATES its contract -- watch it get rejected ===")
print("")
print("Feature text:")
print("  Given a scalable input of 15")
print("  And require X < 10")
print("  When a scale action is synthesized for that input")
print("  Then the plan violates its contract clauses")
print("")

rule_add("input", ["15"], [])
handle_contract_step("require", "X < 10")
let labels2 = plan([["scaled", ["15"]]])
print("plan([[\"scaled\", [\"15\"]]]) synthesized: " + labels2[0])

let pending2 = get("__vars", "t_pending_contracts")
let ok2 = goap_verify_contracts(pending2, labels2)
set_var("t_pending_contracts", [])
print("Contract check on synthesized candidate scale(X=15): " + ok2)
print("(X=15 violates require X < 10 -- correctly detected and reported, not silently accepted)")

print("")
print("=== Act 4: the contract-checking mechanism itself is genuinely assertion-free ===")
print("")
let src = read_file("self_hosting/lib/gherkin_contracts.patlang")
let has_contract_check = gc_find_substr(src, "contract_check(") >= 0
print("Does gherkin_contracts.patlang call the runtime contract_check(...) primitive?  " + has_contract_check)
print("(false is the whole point: the guard runs separately from, and before, whatever code would use the checked value for real)")

print("")
print("DONE")
