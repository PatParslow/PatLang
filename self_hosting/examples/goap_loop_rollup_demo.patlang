# Rebuttal-by-construction of "GOAP + code-synthesis can't discover
# solutions which need loops": the STRIPS search itself places no
# restriction on reusing the same action TEMPLATE multiple times with
# different bindings -- a "count down to zero" domain (a decrementing
# relation pre-enumerated as ground facts) is discovered as a genuine,
# correct, flat plan that repeats the same base action several times
# in a row with a monotonically changing bound argument. That IS an
# unrolled loop, found by ordinary search; there's just no loop AST
# node in plan()'s own output vocabulary to name it as one.
#
# This demo (1) proves the flat repeated-action plan is really
# discovered, (2) rolls it up into a REAL loop via the new
# goap_loop_rollup.patlang pass, and (3) actually RUNS both the flat
# and rolled-up versions and confirms they produce identical output --
# not just eyeballed, a genuine behavioral-equivalence check.

include "../lib/goap_loop_rollup.patlang"

# ---- domain: a decrementing relation, pre-enumerated (the planner
# does pure fact-unification, no arithmetic) -- see goap_loop_rollup.
# patlang's own header for why this table has to exist ahead of time.

rule_add("count", ["3"], [])
rule_add("dec", ["3", "2"], [])
rule_add("dec", ["2", "1"], [])
rule_add("dec", ["1", "0"], [])

action_add("chop_wood", [["count", ["N"]], ["dec", ["N", "N1"]]], [["count", ["N1"]], ["chopped", ["N"]]], [["count", ["N"]]], 1)

let plan1 = plan([["count", ["0"]]])
print("---- discovered plan (flat, repeated-action) ----")
print(plan1)

# ---- flat vs. rolled-up synthesis against the SAME plan ----

let flat_dict = new("Dict", "flat_chop")
send(flat_dict, "set", "chop_wood", "print(\"chop wood #\" + \"{ARG0}\")\n")

let loop_dict = new("Dict", "loop_chop")
send(loop_dict, "set", "chop_wood", "let n = {ARG0}\nwhile n > {ARG1} do\n  print(\"chop wood #\" + n)\n  let n = n - 1\nend\n")

let flat_synth = synthesize_program(plan1, flat_dict, [])
let rollup_synth = synthesize_program_with_rollup(plan1, flat_dict, loop_dict, [])
print("flat synthesis: " + flat_synth[0])
print("rollup synthesis: " + rollup_synth[0])

print("---- flat (unrolled) synthesized source ----")
print(flat_synth[1])
print("---- rolled-up (real loop) synthesized source ----")
print(rollup_synth[1])

# ---- run BOTH for real and compare their actual output ----

let flat_path = "self_hosting/build/goap_loop_rollup_flat.patlang"
let rollup_path = "self_hosting/build/goap_loop_rollup_rolled.patlang"
write_file(flat_path, flat_synth[1])
write_file(rollup_path, rollup_synth[1])

let flat_out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", flat_path)
let rollup_out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", rollup_path)

print("---- flat program's real output ----")
print(flat_out)
print("---- rolled-up program's real output ----")
print(rollup_out)
print("outputs match: " + (flat_out == rollup_out))
