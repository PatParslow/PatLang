# Re-derives the SAME countdown-to-zero plan self_hosting/examples/
# goap_loop_rollup_demo.patlang already proved (commit 044fb5e), but
# via genuine arithmetic fluents (fluent_set/action_add_numeric/
# plan_numeric) instead of a pre-enumerated dec(N,N1) fact table -- the
# capability gap identified in this session's own "PDDL 2.1-style
# numeric fluents" design conversation. The resulting flat plan is fed
# through the EXISTING, completely unmodified goap_loop_rollup.patlang
# pass, proving "how you got the flat plan" (pre-enumeration vs. real
# arithmetic) and "how you roll it into a loop" are fully independent
# and interchangeable.
#
# One real, understood difference from the pre-enumerated version:
# action_label_args("chop_wood") is EMPTY here -- unlike the dec(N,N1)
# version, the countdown value lives in a FLUENT, not in a bound
# propositional variable exposed on the plan step's own label. So the
# loop template below keys off the RUN'S LENGTH ({ARG2}) rather than a
# start/end value pulled from the label -- an honest adaptation, not a
# workaround for a bug.

include "../lib/goap_loop_rollup.patlang"

fluent_set("count", 3)
action_add_numeric("chop_wood", [], [["count", ">=", "1"]], [], [], [["count", "-=", "1"]], 1)

let plan1 = plan_numeric([], [["count", "==", "0"]])
print("---- discovered plan (genuine arithmetic, zero pre-enumerated facts) ----")
print(plan1)

let flat_dict = new("Dict", "flat_chop_numeric")
send(flat_dict, "set", "chop_wood", "print(\"chop wood\")\n")

let loop_dict = new("Dict", "loop_chop_numeric")
send(loop_dict, "set", "chop_wood", "let n = {ARG2}\nwhile n > 0 do\n  print(\"chop wood\")\n  let n = n - 1\nend\n")

let flat_synth = synthesize_program(plan1, flat_dict, [])
let rollup_synth = synthesize_program_with_rollup(plan1, flat_dict, loop_dict, [])
print("flat synthesis: " + flat_synth[0])
print("rollup synthesis: " + rollup_synth[0])

print("---- rolled-up (real loop) synthesized source ----")
print(rollup_synth[1])

let flat_path = "self_hosting/build/goap_numeric_fluent_flat.patlang"
let rollup_path = "self_hosting/build/goap_numeric_fluent_rolled.patlang"
write_file(flat_path, flat_synth[1])
write_file(rollup_path, rollup_synth[1])

let flat_out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", flat_path)
let rollup_out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", rollup_path)

print("---- flat program's real output ----")
print(flat_out)
print("---- rolled-up program's real output ----")
print(rollup_out)
print("outputs match: " + (flat_out == rollup_out))

# ---- and the genuinely new capability: an inequality goal, provably
# inexpressible via the old pre-enumerated-fact-table approach. Run in
# a FRESH process (a separate script, exec_capture'd) so this domain's
# own chop_wood_big action can't get mixed in with chop_wood above --
# planner state (ACTIONS/FLUENTS) persists for the lifetime of one
# process, there's no reset_world() exposed to PatLang scripts.

let inequality_src = "fluent_set(\"count\", 5)\naction_add_numeric(\"chop_wood_big\", [], [[\"count\", \">\", \"0\"]], [], [], [[\"count\", \"-=\", \"2\"]], 1)\nlet p_ineq = plan_numeric([], [[\"count\", \"<=\", \"0\"]])\nprint(\"count<=0 plan length: \" + list_len(p_ineq))\nlet p_exact = plan_numeric([], [[\"count\", \"==\", \"0\"]])\nprint(\"count==0 plan length: \" + list_len(p_exact))\n"
let inequality_path = "self_hosting/build/goap_numeric_fluent_inequality.patlang"
write_file(inequality_path, inequality_src)
let inequality_out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", inequality_path)
print("---- inequality goal (count <= 0, starting from 5, step -2, lands on -1) vs. the SAME domain's exact-match goal (count == 0, never lands exactly) ----")
print(inequality_out)
