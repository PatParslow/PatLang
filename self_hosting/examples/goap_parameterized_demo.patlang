# GOAP with parameterized actions: a single action TEMPLATE, `build(X)`,
# grounds into a separate instantiation per matching target, rather than
# needing one hand-written action per target the way v1's ground-only GOAP
# required. Preconditions can use the same `^[A-Z]` logic-variable
# convention A1's rule_add/solve already uses -- the planner unifies an
# action's preconditions against the current world state, conjunctively (a
# variable bound by one precondition carries into later ones), reusing A1's
# own unification machinery rather than a separate mechanism. A fully
# ground action (no variables at all, v1's only supported form) still
# grounds to exactly one instantiation, so this is a strict superset of the
# old behavior, not a breaking change.

# ---- two independently-ready targets ----
rule_add("ready", ["target_a"], [])
rule_add("ready", ["target_b"], [])

# One action template instead of two hand-written ones: build(X) requires
# ready(X), produces built(X). The planner must ground it twice -- once per
# target -- to reach a goal that needs both built.
action_add("build", [["ready", ["X"]]], [["built", ["X"]]], [], 1)

let plan_both = plan([["built", ["target_a"]], ["built", ["target_b"]]])
print("plan for building both targets (should be 2 steps, one build(X) instantiation per target):")
let mut i = 0
let n = to_num(list_len(plan_both))
while i < n do
  print("  step " + (i + 1) + ": " + plan_both[i])
  i = i + 1
end

# ---- a variable shared across two preconditions ----
# dep(target, base): target depends on base. ready(base): base is ready.
# build(X) now needs BOTH dep(X, Y) and ready(Y) to hold under the SAME
# binding of Y -- proving the conjunctive match threads a binding from the
# first precondition into the second, not just checking each in isolation.
rule_add("dep", ["final", "base"], [])
rule_add("ready", ["base"], [])
action_add("assemble", [["dep", ["X", "Y"]], ["ready", ["Y"]]], [["built", ["X"]]], [], 2)

let plan_shared = plan([["built", ["final"]]])
print("plan using a variable shared across two preconditions (dep(X,Y), ready(Y)):")
let mut j = 0
let m = to_num(list_len(plan_shared))
while j < m do
  print("  step " + (j + 1) + ": " + plan_shared[j])
  j = j + 1
end

print("DONE")
