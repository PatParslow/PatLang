# Browser GUI backed by a native PatLang server (Stage 1 dialect).
# Serves an interactive page whose JS fetches live data from the same
# PatLang process: GET / -> HTML+JS page, GET /data -> JSON computed live.
# Serves three requests then exits (page + data + one refetch).

make a function called fib takes n returns r
  if n < 2 then
    return n
  else
    return fib(n - 1) + fib(n - 2)
  end
end

make a function called data_json returns out
  let b = sb_new()
  sb_push(b, "{ 'source': 'native patlang', 'fib':")
  sb_push(b, " [")
  let i = 0
  while i < 12 do
    if i > 0 then
      sb_push(b, ", ")
    end
    sb_push(b, "" + fib(i))
    let i = i + 1
  end
  sb_push(b, "] }")
  # JSON needs double quotes: swap the single quotes we could type directly
  let s = sb_str(b)
  let fixed = sb_new()
  let k = 0
  while k < s.length do
    if char_code(s, k) == 39 then
      sb_push(fixed, q())
    else
      sb_push(fixed, s[k])
    end
    let k = k + 1
  end
  return sb_str(fixed)
end

make a function called page_script returns out
  let b = sb_new()
  sb_push(b, "async function load() {" + nl())
  sb_push(b, "  const r = await fetch('/data');" + nl())
  sb_push(b, "  const d = await r.json();" + nl())
  sb_push(b, "  document.getElementById('src').textContent = d.source;" + nl())
  sb_push(b, "  document.getElementById('out').textContent = d.fib.join(', ');" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "document.getElementById('go').addEventListener('click', load);" + nl())
  sb_push(b, "load();" + nl())
  return sb_str(b)
end

make a function called page_body returns out
  let b = sb_new()
  sb_push(b, "<h1>Live PatLang backend</h1>" + nl())
  sb_push(b, "<div class='card'>" + nl())
  sb_push(b, "<p>Data source: <strong id='src'>loading...</strong></p>" + nl())
  sb_push(b, "<p id='out'></p>" + nl())
  sb_push(b, "<button id='go'>Refetch from PatLang</button>" + nl())
  sb_push(b, "</div>" + nl())
  return sb_str(b)
end

make a function called gsvr_contains takes hay, needle returns found
  let hn = hay.length
  let nn = needle.length
  let found = false
  let i = 0
  while (i <= hn - nn) and (not found) do
    if substr(hay, i, nn) == needle then
      let found = true
    end
    let i = i + 1
  end
  return found
end

# tcp_read(conn) is a single, possibly-partial read (TCP is a byte
# stream -- the OS can legitimately deliver one client write() across
# more than one server read(), especially under scheduler load; see
# self_hosting/examples/echo_server.patlang's identical helper for the
# real, reproduced flake this fixes). Loop accumulating chunks until the
# full header block has arrived or the peer closes early.
make a function called read_http_request takes conn returns text
  let text = tcp_read(conn)
  let looping = true
  while looping do
    if gsvr_contains(text, chr(13) + chr(10) + chr(13) + chr(10)) then
      let looping = false
    else
      let more = tcp_read(conn)
      if more == "" then
        let looping = false
      else
        let text = text + more
      end
    end
  end
  return text
end

make a function called request_path takes request returns path
  # extract the path from 'GET /path HTTP/1.1'
  let b = sb_new()
  let i = 4
  let scanning = true
  while (i < request.length) and scanning do
    let c = char_code(request, i)
    if (c == 32) or (c == 13) or (c == 10) then
      let scanning = false
    else
      sb_push(b, request[i])
      let i = i + 1
    end
  end
  return sb_str(b)
end

make a function called serve_one takes port returns done
  let conn = tcp_accept(port)
  let request = read_http_request(conn)
  let path = request_path(request)
  if path == "/data" then
    tcp_write(conn, http_ok("application/json", data_json()))
  else
    let page = html_page("PatLang Live GUI", page_body(), page_script())
    tcp_write(conn, http_ok("text/html", page))
  end
  tcp_close(conn)
  print("SERVED: " + path)
  return true
end

let port = tcp_listen(0)
print("PORT: " + port)
serve_one(port)
serve_one(port)
serve_one(port)
print("DONE")
