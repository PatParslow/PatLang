# Compiled driver for the browser hex-RTS page (self_hosting/tools/
# build_portfolio.patlang's hexrts_page). Unlike the REPL's playground
# module, this does NOT recompile source text each call -- it's a normal
# compiled PatLang program (argv in, print out), called once per tick with
# the current state text and this tick's new orders text, printing the next
# state. See self_hosting/lib/hexrts.patlang for the actual simulation.
#
#   argv[0] == "INIT" -> print the fresh starting state, ignore argv[1]
#   otherwise         -> argv[0] is the current state, argv[1] is this
#                        tick's orders (one per line); prints the next state

include "../lib/hexrts.patlang"

let args = argv()
let state_text = ""
let orders_text = ""
if args.length >= 1 then
  let state_text = args[0]
end
if args.length >= 2 then
  let orders_text = args[1]
end

if state_text == "INIT" then
  print(rts_render(rts_init()))
else
  let state = rts_parse_state(state_text)
  let orders = rts_parse_orders(orders_text)
  let new_state = rts_step(state, orders)
  print(rts_render(new_state))
end
