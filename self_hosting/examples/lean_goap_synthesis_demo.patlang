# "Clever" cross-feature demo: a GOAP-planned action sequence
# synthesized directly into REAL Lean 4 source, verified two
# independent ways -- run through the actual `lean` binary AND
# re-parsed by this project's own self-hosted Lean frontend -- closing
# a loop from planning through synthesis through two separate genuine
# confirmations of correctness, not just eyeballed text.
#
# Precursor to the eventual "write a Lean system in native PatLang"
# goal, not that goal itself: this exercises the pieces that already
# exist together (the GOAP planner, the polyglot snippet-synthesis
# machinery from #21, and the Lean 4 support merged in PR #60/fixed
# this session) rather than building anything new toward that goal.
#
# Requires `lean` on PATH (self_hosting/lib/lean_run.patlang's
# lean_run_file shells out to it) -- see self_hosting/lean_goap_
# synthesis_selftest.patlang for the assertion-based version of this
# same demo.

include "../lib/goap_snippet_synthesis.patlang"
include "../lib/utf8.patlang"
include "../lib/lean_lexer.patlang"
include "../lib/lean_parser.patlang"
include "../lib/lean_run.patlang"

# ---- 1. Plan a two-step sequence via ordinary GOAP ----

action_add("gather_wood", [], [["have", ["wood"]]], [], 1)
action_add("build_house", [["have", ["wood"]]], [["have", ["house"]]], [], 1)
let plan1 = plan([["have", ["house"]]])
print("plan: " + plan1)

# ---- 2. Synthesize the SAME plan against three different target
# languages, proving the design is genuinely polyglot ----

let synth_patlang = synthesize_program(plan1, snippet_dict_patlang(), [])
let synth_python = synthesize_program(plan1, snippet_dict_python(), [])
let synth_lean = synthesize_program(plan1, snippet_dict_lean(), [])
print("PatLang synthesis: " + synth_patlang[0])
print("Python synthesis: " + synth_python[0])
print("Lean synthesis: " + synth_lean[0])

let lean_src = synth_lean[1]
print("---- synthesized Lean 4 source ----")
print(lean_src)

# ---- 3. Confirmation #1: the REAL `lean` binary actually runs it ----

let lean_path = "self_hosting/build/lean_goap_synthesis_demo.lean"
write_file(lean_path, lean_src)
let run_result = lean_run_file(lean_path)
print("---- real `lean` binary's own verdict ----")
print(run_result[0])
print(run_result[1])

# ---- 4. Confirmation #2: this project's OWN self-hosted Lean
# frontend independently agrees the generated text is real, well-
# formed Lean -- finds both `def` commands by name, structurally, not
# just "the file exists" ----

let lean_ast = lean_parse(lean_tokenize(lean_src))
let def_wood = lean_find_command(lean_ast, "def")
print("---- self-hosted Lean parser's own verdict ----")
print("first def command's name: " + def_wood[2])
