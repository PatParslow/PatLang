# BDD-style verification of self_hosting/lib/line_edit.patlang's
# completion-matching LOGIC (le_matches, le_common_prefix,
# le_last_word_start), using the existing Gherkin runner in
# self_hosting/lib/test.patlang.
#
# Deliberately does NOT test line_edit_read or le_apply_tab themselves
# here -- both call the raw-mode console primitives (console_raw_enable
# etc.), which only exist in the --x64 NATIVE backend, not under the
# interpreter this spec runs under (pat.exe --ir-run). The functions
# tested here are the pure, portable part -- the actual matching
# algorithm behind Tab completion -- and are exactly as real a
# regression check on that logic as any other spec in this suite. See
# friendly_cli/terminal_native_bdd_demo.patlang for what CAN be verified
# about the raw-mode path by automation (the graceful non-console
# fallback), and the session notes on why live keystroke capture itself
# needs a human at a real terminal to confirm.

include "../lib/includes.patlang"
include "../lib/line_edit.patlang"
include "../lib/test.patlang"

# ---- step definitions ----

make a function called st_le_candidates returns done
  set_var("le_candidates", ["help", "history", "heal-config", "status"])
  return true
end

make a function called st_le_match_unique_prefix returns done
  set_var("le_result", le_matches(get("__vars", "le_candidates"), "sta"))
  return true
end

make a function called st_le_unique_match_found returns done
  check("a unique prefix matches exactly one candidate", get("__vars", "le_result"), ["status"])
  return true
end

make a function called st_le_match_ambiguous_prefix returns done
  set_var("le_result", le_matches(get("__vars", "le_candidates"), "he"))
  return true
end

make a function called st_le_ambiguous_matches_found returns done
  check("an ambiguous prefix matches every candidate that starts with it", get("__vars", "le_result"), ["help", "heal-config"])
  return true
end

make a function called st_le_common_prefix_of_ambiguous returns done
  set_var("le_prefix", le_common_prefix(["help", "heal-config"]))
  return true
end

make a function called st_le_common_prefix_is_he returns done
  check("the shared prefix of help/heal-config is 'he'", get("__vars", "le_prefix"), "he")
  return true
end

make a function called st_le_no_match_prefix returns done
  set_var("le_result", le_matches(get("__vars", "le_candidates"), "zz"))
  return true
end

make a function called st_le_no_match_found returns done
  check("a prefix matching nothing returns an empty list", get("__vars", "le_result").length, 0)
  return true
end

make a function called st_le_word_start_no_space returns done
  set_var("le_word_start", le_last_word_start("frobnic"))
  return true
end

make a function called st_le_word_start_is_zero returns done
  check("with no space in the buffer, the current word starts at 0", get("__vars", "le_word_start"), 0)
  return true
end

make a function called st_le_word_start_with_arg returns done
  set_var("le_word_start", le_last_word_start("taskkill note"))
  return true
end

make a function called st_le_word_start_after_space returns done
  check("with an argument already typed, the current word starts after the last space", get("__vars", "le_word_start"), 9)
  return true
end

# UTF-8-aware backspace: "ab" + an em-dash (U+2014, UTF-8 bytes
# 0xE2 0x80 0x94) + "c" -- built from raw byte values via chr(), no
# reliance on this source file's own encoding.
make a function called st_le_buffer_with_multibyte_char returns done
  let em_dash = chr(226) + chr(128) + chr(148)
  set_var("le_mb_buf", "ab" + em_dash + "c")
  return true
end

make a function called st_le_backspace_over_ascii returns done
  set_var("le_bs_len", le_utf8_backspace_len(get("__vars", "le_mb_buf")))
  return true
end

make a function called st_le_backspace_over_ascii_is_one returns done
  check("backspacing over a trailing ASCII byte removes exactly 1 byte", get("__vars", "le_bs_len"), 1)
  return true
end

make a function called st_le_buffer_ending_in_multibyte_char returns done
  let em_dash = chr(226) + chr(128) + chr(148)
  set_var("le_mb_buf2", "ab" + em_dash)
  return true
end

make a function called st_le_backspace_over_multibyte returns done
  set_var("le_bs_len2", le_utf8_backspace_len(get("__vars", "le_mb_buf2")))
  return true
end

make a function called st_le_backspace_over_multibyte_is_three returns done
  check("backspacing over a trailing 3-byte UTF-8 character removes all 3 bytes, not 1", get("__vars", "le_bs_len2"), 3)
  return true
end

# ---- filename-completion path-splitting logic (pure string ops,
# portable -- le_filename_candidates itself needs list_dir, native-only,
# so it isn't tested here; see friendly_cli/terminal_native_bdd_demo.patlang
# for what CAN be verified about the real filesystem-completion path) ----

make a function called st_le_split_no_separator returns done
  set_var("le_split_result", le_path_split("hel"))
  return true
end

make a function called st_le_split_no_separator_is_dot_prefix returns done
  check("a prefix with no separator splits into ['.', prefix]", get("__vars", "le_split_result"), [".", "hel"])
  return true
end

make a function called st_le_split_with_separator returns done
  set_var("le_split_result", le_path_split("self_hosting/build/_pro"))
  return true
end

make a function called st_le_split_with_separator_is_dir_and_name returns done
  check("a nested prefix splits into its directory and partial filename", get("__vars", "le_split_result"), ["self_hosting/build", "_pro"])
  return true
end

make a function called st_le_join_no_dir returns done
  set_var("le_join_result", le_join_dir_name(".", "help.txt"))
  return true
end

make a function called st_le_join_no_dir_is_bare_name returns done
  check("joining with dir '.' returns just the name, no './' prefix", get("__vars", "le_join_result"), "help.txt")
  return true
end

make a function called st_le_join_real_dir returns done
  set_var("le_join_result", le_join_dir_name("self_hosting/build", "output.txt"))
  return true
end

make a function called st_le_join_real_dir_is_full_path returns done
  check("joining with a real directory reconstructs the full path", get("__vars", "le_join_result"), "self_hosting/build/output.txt")
  return true
end

make a function called register_line_edit_steps returns done
  step("a candidate list of built-in command names", "st_le_candidates")
  step("matching it against a prefix only one candidate starts with", "st_le_match_unique_prefix")
  step("exactly that one candidate is returned", "st_le_unique_match_found")
  step("matching it against a prefix several candidates start with", "st_le_match_ambiguous_prefix")
  step("every matching candidate is returned", "st_le_ambiguous_matches_found")
  step("the shared prefix of those matches is computed", "st_le_common_prefix_of_ambiguous")
  step("it is the longest string they all start with", "st_le_common_prefix_is_he")
  step("matching it against a prefix nothing starts with", "st_le_no_match_prefix")
  step("no candidates are returned", "st_le_no_match_found")
  step("a buffer with no space in it yet", "st_le_word_start_no_space")
  step("the current word is the whole buffer", "st_le_word_start_is_zero")
  step("a buffer with a command and a partial argument", "st_le_word_start_with_arg")
  step("the current word starts right after the space", "st_le_word_start_after_space")
  step("a buffer ending in an ordinary ASCII byte", "st_le_buffer_with_multibyte_char")
  step("its backspace length is computed", "st_le_backspace_over_ascii")
  step("it is exactly one byte", "st_le_backspace_over_ascii_is_one")
  step("a buffer ending in a 3-byte UTF-8 character", "st_le_buffer_ending_in_multibyte_char")
  step("its backspace length is computed again", "st_le_backspace_over_multibyte")
  step("it is all three bytes of that character, not one", "st_le_backspace_over_multibyte_is_three")
  step("a partial filename with no directory separator", "st_le_split_no_separator")
  step("it splits with a '.' directory and the whole prefix as the name", "st_le_split_no_separator_is_dot_prefix")
  step("a partial filename nested inside a directory", "st_le_split_with_separator")
  step("it splits into the real directory and the partial filename", "st_le_split_with_separator_is_dir_and_name")
  step("joining a name with the '.' directory", "st_le_join_no_dir")
  step("it returns just the bare name", "st_le_join_no_dir_is_bare_name")
  step("joining a name with a real directory", "st_le_join_real_dir")
  step("it reconstructs the full path", "st_le_join_real_dir_is_full_path")
  return true
end

make a function called line_edit_feature returns text
  return "Feature: tab-completion matching logic

Scenario: a unique prefix completes to one candidate
  Given a candidate list of built-in command names
  When matching it against a prefix only one candidate starts with
  Then exactly that one candidate is returned

Scenario: an ambiguous prefix returns every match
  Given a candidate list of built-in command names
  When matching it against a prefix several candidates start with
  Then every matching candidate is returned

Scenario: ambiguous matches still share a completable common prefix
  Given a candidate list of built-in command names
  When the shared prefix of those matches is computed
  Then it is the longest string they all start with

Scenario: a prefix matching nothing returns no candidates
  Given a candidate list of built-in command names
  When matching it against a prefix nothing starts with
  Then no candidates are returned

Scenario: completion targets the word under the cursor, not the whole line
  Given a buffer with no space in it yet
  Then the current word is the whole buffer

Scenario: completion targets an argument after the command name
  Given a buffer with a command and a partial argument
  Then the current word starts right after the space

Scenario: backspace over an ordinary ASCII byte removes just one byte
  Given a buffer ending in an ordinary ASCII byte
  When its backspace length is computed
  Then it is exactly one byte

Scenario: backspace over a multi-byte UTF-8 character removes the whole thing
  Given a buffer ending in a 3-byte UTF-8 character
  When its backspace length is computed again
  Then it is all three bytes of that character, not one

Scenario: splitting a partial filename with no directory separator
  Given a partial filename with no directory separator
  When it splits with a '.' directory and the whole prefix as the name
  Then it splits with a '.' directory and the whole prefix as the name

Scenario: splitting a partial filename nested inside a directory
  Given a partial filename nested inside a directory
  When it splits into the real directory and the partial filename
  Then it splits into the real directory and the partial filename

Scenario: joining a bare name with no real directory
  Given joining a name with the '.' directory
  Then it returns just the bare name

Scenario: joining a name with a real directory reconstructs the path
  Given joining a name with a real directory
  Then it reconstructs the full path
"
end

make a function called run_line_edit_bdd returns ok
  t_init()
  register_line_edit_steps()
  run_feature(line_edit_feature())
  t_report()
  return get("__vars", "t_fail") == 0
end

run_line_edit_bdd()
