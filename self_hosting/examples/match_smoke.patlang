include "../lib/regex.patlang"

fn classify(x) {
    match x do
      case 0 then
        return "zero"
      case "hi" then
        return "greeting"
      case > 10 then
        return "big"
      case n then
        return "small:" + n
    end
}

fn describe(pair) {
    match pair do
      case ["Ok", v] then
        return "ok:" + v
      case ["Err", ["Nested", m]] then
        return "nested-err:" + m
      case _ then
        return "unknown"
    end
}

fn tag_glob(s) {
    match s do
      case *fred* then
        return "has-fred"
      case case_ban* then
        return "starts-ban"
      case _ then
        return "no-match"
    end
}

print(classify(0))
print(classify("hi"))
print(classify(20))
print(classify(3))
print(describe(["Ok", 5]))
print(describe(["Err", ["Nested", "boom"]]))
print(describe(["Err", "flat"]))
print(tag_glob("alfred smith"))
print(tag_glob("case_bandit"))
print(tag_glob("nothing"))
