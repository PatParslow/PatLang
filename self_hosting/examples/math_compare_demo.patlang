# Stage 39 -- minimal --compare-safe demo: bignum promotion through a
# self-hosted library function (factorial), and Complex construction/printing
# via sqrt of a negative number, matching between interpreter and compiled
# paths.
#
# NOTE: `--compare` (rust-runtime/src/main.rs) compares the *interpreter's
# final returned value* (only the last print's text) against the *compiled
# binary's full captured stdout* -- a pre-existing quirk (reproducible on
# fib_bench.patlang, untouched by this task) that makes it unsuitable for
# multi-print programs. A single concatenated print sidesteps it.
include "../lib/math.patlang"

let line1 = "factorial(25) = " + factorial(25)
let line2 = "sqrt(-4) = " + sqrt(-4)
let line3 = "is_prime(97) = " + is_prime(97)
let line4 = "gcd(48, 18) = " + gcd(48, 18)
print(line1 + " | " + line2 + " | " + line3 + " | " + line4)
