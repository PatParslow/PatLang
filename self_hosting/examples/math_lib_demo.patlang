# Stage 39 -- exercises self_hosting/lib/math.patlang's PatLang-level
# functions (factorial/is_prime/hypot/gcd/lcm/clamp/sign/mean), run through
# both the interpreter and a real compiled binary via --compare.
include "../lib/math.patlang"

print("hypot(3, 4) = " + hypot(3, 4))
print("factorial(5) = " + factorial(5))
print("factorial(25) = " + factorial(25))
print("gcd(48, 18) = " + gcd(48, 18))
print("lcm(4, 6) = " + lcm(4, 6))
print("clamp(15, 0, 10) = " + clamp(15, 0, 10))
print("clamp(-5, 0, 10) = " + clamp(-5, 0, 10))
print("sign(-7) = " + sign(-7))
print("sign(0) = " + sign(0))
print("sign(7) = " + sign(7))
print("is_prime(97) = " + is_prime(97))
print("is_prime(100) = " + is_prime(100))
print("mean([1, 2, 3, 4]) = " + mean([1, 2, 3, 4]))
print("sqrt(-4) = " + sqrt(-4))
