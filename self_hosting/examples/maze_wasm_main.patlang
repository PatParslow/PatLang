# Maze wasm driver (concatenate after lib/lexer + lib/parser + lib/lower +
# lib/maze). Two modes, both no rustc once this module is built:
#   maze generate <w> <h> <seed>  -> prints the generated grid, one row per line
#   maze solve <grid-text>        -> prints: visited-order trace (;-joined),
#                                    then the final path (;-joined), then a
#                                    one-line message
# The IDE/maze page in the portfolio drives this to animate the solve.

let args = argv()
let mode = ""
if args.length >= 1 then
  let mode = args[0]
end

if mode == "generate" then
  let w = to_num(args[1])
  let h = to_num(args[2])
  let seed = to_num(args[3])
  let lines = generate_maze(w, h, seed)
  let i = 0
  while i < lines.length do
    print(lines[i])
    let i = i + 1
  end
else
  if mode == "solve" then
    let lines = split_lines(args[1])
    let path = solve_maze(lines)
    print(get("__vars", "mz_trace"))
    print(join_semi(path))
    if path.length > 0 then
      print(path.length + " steps from S to E.")
    else
      print("no path found.")
    end
  else
    print("usage: maze generate <w> <h> <seed> | maze solve <grid-text>")
  end
end
