# BDD-style verification of self_hosting/lib/output.patlang, using the
# existing Gherkin runner in self_hosting/lib/gherkin.patlang.

include "../lib/includes.patlang"
include "../lib/output.patlang"
include "../lib/includes.patlang"
include "../lib/gherkin.patlang"

# ---- step definitions ----

make a function called st_out_given_no_detail takes ctx returns done
  ctx_set(ctx, "out_kind", "info")
  ctx_set(ctx, "out_msg", "build finished")
  ctx_set(ctx, "out_detail", "")
  return true
end

make a function called st_out_given_with_detail takes ctx returns done
  ctx_set(ctx, "out_kind", "error")
  ctx_set(ctx, "out_msg", "command failed")
  ctx_set(ctx, "out_detail", "exit code 1")
  return true
end

make a function called st_out_when_rendered_human takes ctx returns done
  let text = render_human(ctx_get(ctx, "out_kind"), ctx_get(ctx, "out_msg"), ctx_get(ctx, "out_detail"))
  ctx_set(ctx, "out_result", text)
  return true
end

make a function called st_out_when_rendered_json takes ctx returns done
  let text = render_json(ctx_get(ctx, "out_kind"), ctx_get(ctx, "out_msg"), ctx_get(ctx, "out_detail"))
  ctx_set(ctx, "out_result", text)
  return true
end

make a function called st_out_then_no_detail_form takes ctx returns done
  expect(ctx, "human rendering with no detail has no trailing separator", ctx_get(ctx, "out_result"), "[info] build finished")
  return true
end

make a function called st_out_then_with_detail_form takes ctx returns done
  expect(ctx, "human rendering with a detail appends it after a separator", ctx_get(ctx, "out_result"), "[error] command failed -- exit code 1")
  return true
end

make a function called st_out_then_json_form takes ctx returns done
  expect(ctx, "json rendering produces a structured object with the same fields", ctx_get(ctx, "out_result"), "{\"event\":\"error\",\"message\":\"command failed\",\"detail\":\"exit code 1\"}")
  return true
end

make a function called register_output_steps takes ctx returns done
  step(ctx, "an info event with no detail", "st_out_given_no_detail")
  step(ctx, "an error event with a detail", "st_out_given_with_detail")
  step(ctx, "it is rendered for a human", "st_out_when_rendered_human")
  step(ctx, "it is rendered as json", "st_out_when_rendered_json")
  step(ctx, "the rendering has no trailing separator", "st_out_then_no_detail_form")
  step(ctx, "the rendering appends the detail after a separator", "st_out_then_with_detail_form")
  step(ctx, "the rendering is a well-formed json object with matching fields", "st_out_then_json_form")
  return true
end

make a function called output_feature returns text
  return "Feature: dual-mode event output

Scenario: human rendering omits the separator when there is no detail
  Given an info event with no detail
  When it is rendered for a human
  Then the rendering has no trailing separator

Scenario: human rendering appends the detail when present
  Given an error event with a detail
  When it is rendered for a human
  Then the rendering appends the detail after a separator

Scenario: json rendering carries the same fields as structured data
  Given an error event with a detail
  When it is rendered as json
  Then the rendering is a well-formed json object with matching fields
"
end

make a function called run_output_bdd takes ctx returns ok
  let ctx = ctx_new()
  register_output_steps(ctx)
  run_feature(ctx, output_feature())
  ctx_report(ctx)
  return ctx_failed(ctx) == 0
end

let ctx = ctx_new()
run_output_bdd(ctx)
