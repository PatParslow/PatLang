# BDD-style verification of self_hosting/lib/output.patlang, using the
# existing Gherkin runner in self_hosting/lib/test.patlang.

include "../lib/includes.patlang"
include "../lib/output.patlang"
include "../lib/test.patlang"

# ---- step definitions ----

make a function called st_out_given_no_detail returns done
  set_var("out_kind", "info")
  set_var("out_msg", "build finished")
  set_var("out_detail", "")
  return true
end

make a function called st_out_given_with_detail returns done
  set_var("out_kind", "error")
  set_var("out_msg", "command failed")
  set_var("out_detail", "exit code 1")
  return true
end

make a function called st_out_when_rendered_human returns done
  let text = render_human(get("__vars", "out_kind"), get("__vars", "out_msg"), get("__vars", "out_detail"))
  set_var("out_result", text)
  return true
end

make a function called st_out_when_rendered_json returns done
  let text = render_json(get("__vars", "out_kind"), get("__vars", "out_msg"), get("__vars", "out_detail"))
  set_var("out_result", text)
  return true
end

make a function called st_out_then_no_detail_form returns done
  check("human rendering with no detail has no trailing separator", get("__vars", "out_result"), "[info] build finished")
  return true
end

make a function called st_out_then_with_detail_form returns done
  check("human rendering with a detail appends it after a separator", get("__vars", "out_result"), "[error] command failed -- exit code 1")
  return true
end

make a function called st_out_then_json_form returns done
  check("json rendering produces a structured object with the same fields", get("__vars", "out_result"), "{\"event\":\"error\",\"message\":\"command failed\",\"detail\":\"exit code 1\"}")
  return true
end

make a function called register_output_steps returns done
  step("an info event with no detail", "st_out_given_no_detail")
  step("an error event with a detail", "st_out_given_with_detail")
  step("it is rendered for a human", "st_out_when_rendered_human")
  step("it is rendered as json", "st_out_when_rendered_json")
  step("the rendering has no trailing separator", "st_out_then_no_detail_form")
  step("the rendering appends the detail after a separator", "st_out_then_with_detail_form")
  step("the rendering is a well-formed json object with matching fields", "st_out_then_json_form")
  return true
end

make a function called output_feature returns text
  return "Feature: dual-mode event output

Scenario: human rendering omits the separator when there is no detail
  Given an info event with no detail
  When it is rendered for a human
  Then the rendering has no trailing separator

Scenario: human rendering appends the detail when present
  Given an error event with a detail
  When it is rendered for a human
  Then the rendering appends the detail after a separator

Scenario: json rendering carries the same fields as structured data
  Given an error event with a detail
  When it is rendered as json
  Then the rendering is a well-formed json object with matching fields
"
end

make a function called run_output_bdd returns ok
  t_init()
  register_output_steps()
  run_feature(output_feature())
  t_report()
  return get("__vars", "t_fail") == 0
end

run_output_bdd()
