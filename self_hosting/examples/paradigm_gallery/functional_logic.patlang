# Functional + logic: facts store only raw data (age); the classifying
# FUNCTION itself is applied lazily, at query time, once per person
# pulled back out of the logic engine -- not baked in when the fact was
# asserted. This demonstrates the functional side more directly than
# pre-computing the label up front: the same `classify` closure gets
# called fresh for each solved binding.
#
# Caveat: this is PatLang code deciding when to call `classify`, not the
# rule/solve engine itself invoking it -- rule bodies only unify (plus a
# special-cased `neq`), there's no way to embed an arbitrary function
# call inside a rule body itself.
make a function called classify takes age returns label
  if age < 18 then
    return "minor"
  end
  return "adult"
end

rule person(alice).
rule age(alice, 30).
rule person(bob).
rule age(bob, 15).

let people = solve("person", ["X"])
let n = to_num(list_len(people))
let i = 0
while i < n do
  let name = people[i][0]
  let age_sols = solve("age", [name, "A"])
  let age = to_num(age_sols[0][1])
  if classify(age) == "adult" then
    print(name)
  end
  let i = i + 1
end
