# Functional + logic: a pure function computes a classification, and
# the RESULT (not the computation itself) becomes a fact the rule/solve
# engine can genuinely unify against -- the two paradigms meet at the
# point where a functional value becomes declarative data. (The engine's
# rule bodies only unify; there's no arithmetic predicate like "A >= 18",
# so the age threshold has to be decided once, in PatLang code, at the
# point each person's age is recorded -- not re-derived per query.)
make a function called classify takes age returns label
  if age < 18 then
    return "minor"
  end
  return "adult"
end

rule person(alice).
rule person(bob).
rule_add(classify(30), ["alice"], [])
rule_add(classify(15), ["bob"], [])

let adults = solve("adult", ["X"])
print(list_len(adults))
print(adults)
