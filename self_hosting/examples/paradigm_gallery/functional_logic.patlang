# Functional + logic: a pure function computes a classification, and
# the RESULT (not the computation itself) becomes a fact the logic
# engine can be queried against -- the two paradigms meet at the point
# where a functional value becomes declarative data.
make a function called classify takes age returns label
  if age < 18 then
    return "minor"
  end
  return "adult"
end

fact(classify(30), "alice", "is")
fact(classify(15), "bob", "is")
print(query("adult", "alice", 0))
print(query("adult", "bob", 0))
