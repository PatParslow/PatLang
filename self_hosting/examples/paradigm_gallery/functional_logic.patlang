# Functional + logic: facts store only raw data (each person's age).
# `classify` is genuinely PASSED AS A VALUE into `map_list`/`filter_list`
# -- mapped across the people pulled back out of the logic engine via
# `solve`, rather than baked into the fact or applied via a hand-written
# loop at the call site. That's the functional side made literal: the
# same function value flows through `map`/`filter`, the way it would in
# any functional-first language.
#
# Gotcha: a plain named function (`classify`) is NOT itself a first-class
# value in PatLang -- passing it bare into another function silently does
# nothing. It has to be wrapped in a closure literal (`|age| {
# classify(age) }`) to be passed as data; that's what `classify_fn` and
# `is_adult` are below.
#
# Also still true: the rule/solve engine itself can't take a function as
# an argument -- its bodies only unify (plus a special-cased `neq`), so
# there's no way to hand `classify` INTO `solve` itself and have the
# engine call it mid-resolution. The map/filter happens in ordinary
# PatLang code, over solve's results, not inside the engine.
make a function called classify takes age returns label
  if age < 18 then
    return "minor"
  end
  return "adult"
end

make a function called map_list takes items, f returns out
  let out = []
  let i = 0
  let n = to_num(list_len(items))
  while i < n do
    let out = list_push(out, f(items[i]))
    let i = i + 1
  end
  return out
end

make a function called filter_list takes items, pred returns out
  let out = []
  let i = 0
  let n = to_num(list_len(items))
  while i < n do
    if pred(items[i]) then
      let out = list_push(out, items[i])
    end
    let i = i + 1
  end
  return out
end

rule person(alice).
rule age(alice, 30).
rule person(bob).
rule age(bob, 15).

let people = solve("person", ["X"])
let name_of = |p| { p[0] }
let names = map_list(people, name_of)

let age_of = |name| { to_num(solve("age", [name, "A"])[0][1]) }
let ages = map_list(names, age_of)

let classify_fn = |age| { classify(age) }
print(map_list(ages, classify_fn))

let is_adult = |name| { classify(age_of(name)) == "adult" }
print(filter_list(names, is_adult))
