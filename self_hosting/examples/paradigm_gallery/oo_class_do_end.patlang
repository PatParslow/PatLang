# OO: Slice 5 -- `do ... end` (and `begin ... end`) as alternatives to
# `{ }` for the class block, matching every other dual-form construct
# in the language (while-loops, closures, budgeted(...)).
class Animal do
  field legs = 4
  make a function called speak takes self returns msg
    return "generic animal noise"
  end
end

class Person inherits Animal begin
  field legs = 2
  make a function called speak takes self returns msg
    return "hello"
  end
end

let a = new("Animal", "a1")
print(get(a, "legs"))
print(send(a, "speak"))

let p = new("Person", "p1")
print(get(p, "legs"))
print(send(p, "speak"))
