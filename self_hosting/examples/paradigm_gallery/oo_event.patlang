# OO + event: the event handler is where these two paradigms actually
# meet -- `increment` doesn't know or care who raises it, but when it
# fires, it mutates a genuine, persistent object's state via send/get.
new("Counter", "c1")
send("c1", "set", "count", 0)

when increment {
  send("c1", "set", "count", get("c1", "count") + 1)
}

emit("increment")
emit("increment")
emit("increment")
print(get("c1", "count"))
