# OO + event: the event handler is where these two paradigms actually
# meet -- `increment` doesn't know or care who raises it, but when it
# fires, it mutates a genuine, persistent object's state via dot
# notation. `when` handlers are now real closures (lowering.rs's
# lower_when), so this handler captures the outer `c1` directly --
# no need to re-declare it inside the handler body anymore, the
# workaround this exact gotcha used to require.
new("Counter", "c1")
let c1 = "c1"
c1.count = 0

when increment {
  c1.count = c1.count + 1
}

emit("increment")
emit("increment")
emit("increment")
print(c1.count)
