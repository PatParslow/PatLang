# OO: single inheritance with field defaults (Slice 1 of the classes/
# traits/inheritance feature). A formal `class NAME [inherits PARENT] {
# field NAME = EXPR ... }` block is entirely OPTIONAL, not a requirement
# -- the existing ad hoc `new("Literal","id")` convention (see oo.
# patlang) keeps working exactly as before for any class name that was
# never declared this way. When a class IS declared, `new(...)` auto-
# populates field defaults resolved root-to-leaf up the (single)
# inheritance chain, with the more specific class's own default
# overriding an inherited one on the same field name.
class Animal {
  field legs = 4
  field sound = "..."
}

class Person inherits Animal {
  field legs = 2
  field job = "unemployed"
}

let p = new("Person", "p1")
print(p.legs)
print(p.sound)
print(p.job)

let a = new("Animal", "a1")
print(a.legs)
print(a.sound)
