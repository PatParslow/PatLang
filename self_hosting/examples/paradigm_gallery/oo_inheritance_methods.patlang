# OO: Slice 2 -- methods + real send() dispatch.
class Animal {
  field legs = 4
  field sound = "..."
  make a function called speak takes self returns msg
    return get(self, "sound")
  end
}

class Person inherits Animal {
  field legs = 2
  field job = "unemployed"
  make a function called speak takes self returns msg
    return "hi, my job is " + get(self, "job")
  end
}

let p = new("Person", "p1")
print(send(p, "speak"))

let a = new("Animal", "a1")
print(send(a, "speak"))
