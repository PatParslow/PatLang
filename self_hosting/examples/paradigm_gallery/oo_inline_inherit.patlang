# OO: Slice 4 -- inline inheritance/traits via new(...), no `class` block
# required at all. new(class, name, "inherits", PARENT, "traits", [T,...])
# registers/extends a lightweight ClassDef on the fly.
class Animal {
  field legs = 4
  make a function called speak takes self returns msg
    return "generic animal noise"
  end
}

class Nameable {
  make a function called label takes self returns msg
    return "name:" + get(self, "name")
  end
}

let p = new("Person", "p1", "inherits", "Animal", "traits", ["Nameable"])
print(get(p, "legs"))
print(send(p, "speak"))
print(send(p, "label"))

# A second new(...) call for the SAME class extends the same registry
# entry -- calling it again without the keyword args should behave
# identically (registration persists).
let p2 = new("Person", "p2")
print(get(p2, "legs"))
print(send(p2, "label"))
