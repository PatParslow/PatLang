# OO: Slice 3 -- composable traits/mixins, last-listed wins on collision.
class Nameable {
  make a function called label takes self returns msg
    return "name:" + get(self, "name")
  end
}

class Serializable {
  make a function called label takes self returns msg
    return "serialized:" + get(self, "name")
  end
  make a function called to_str takes self returns msg
    return "<obj " + get(self, "name") + ">"
  end
}

# Serializable listed last -- its "label" should win over Nameable's.
class Widget {
  traits Nameable, Serializable
  field kind = "widget"
}

let w = new("Widget", "w1")
print(send(w, "label"))
print(send(w, "to_str"))
print(get(w, "kind"))
