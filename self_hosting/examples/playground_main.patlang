# Playground driver (concatenate after lib/lexer + lib/parser + lib/lower).
# Takes PatLang source as its first argument, and an optional mode as its
# second ("run" default, "tokens", or "ast"), so the same in-browser wasm
# module that runs code can also show the compiler's own intermediate
# representations - no rustc needed either way, so this works compiled to
# WASM in the browser (the PatLang IDE page uses this for its inspector tabs).

let args = argv()
let src = ""
if args.length >= 1 then
  let src = args[0]
end
let mode = "run"
if args.length >= 2 then
  let mode = args[1]
end

if src == "" then
  print("[playground] usage: playground <source> [run|tokens|ast]")
else
  let toks = tokenize(src)
  if mode == "tokens" then
    let n = vec_len(toks)
    let i = 0
    while i < n do
      let t = vec_get(toks, i)
      print(t[0] + chr(9) + t[1] + chr(9) + "line " + t[2])
      let i = i + 1
    end
  else
    let ast = parse_program(toks)
    let stmts = ast[1]
    let i = 0
    let errs = 0
    while i < stmts.length do
      let s = stmts[i]
      if s[0] == "Err" then
        print("parse error: " + s[1])
        let errs = errs + 1
      end
      let i = i + 1
    end
    if mode == "ast" then
      let i = 0
      while i < stmts.length do
        print(ast_to_str(stmts[i]))
        let i = i + 1
      end
    else
      if errs == 0 then
        let ir = lower_program(ast)
        run_ir(ir)
      end
    end
  end
end
