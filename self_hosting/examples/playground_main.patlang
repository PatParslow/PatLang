# Playground driver (concatenate after lib/lexer + lib/parser + lib/lower +
# lib/regex_dsl + lib/syntax_dsl). Takes PatLang source as its first
# argument, and an optional mode as its second ("run" default, "tokens", or
# "ast"), so the same in-browser wasm module that runs code can also show
# the compiler's own intermediate representations - no rustc needed either
# way, so this works compiled to WASM in the browser (the PatLang IDE page
# uses this for its inspector tabs).
#
# Source is first passed through expand_syntax_dsls, so user-defined
# `syntax NAME { ... }` DSL blocks (and their triggered `<keyword> { ... }`
# usage blocks) are expanded to plain PatLang before tokenizing/parsing -
# matching what compile_native/compile_both do for the native + wasm
# Portfolio builds (see self_hosting/tools/build_portfolio.patlang). A
# source with no `syntax { ... }` blocks passes through unchanged.
#
# Error detection below renders each top-level statement with ast_to_str
# (which has an explicit "Err(message)" case and recurses into every
# statement/expression shape it knows) and scans for that marker, rather
# than only checking whether the top-level statement node ITSELF is an
# Err -- a top-level Let/If/etc whose Err is nested in its own value/
# condition (e.g. `let z = (((`) is a real Err the parser produced, just
# not sitting at the very top of that statement's node. Found and fixed
# 2026-07-13 while building the live REPL (self_hosting/tools/repl.patlang,
# build_portfolio.patlang's repl_page): a nested Err going undetected here
# meant the REPL's browser side silently treated a broken entry as
# successful and persisted it into its session buffer.

make a function called pg_find_err_marker takes s returns idx
  let n = s.length
  let needle_len = 4
  let i = 0
  while i <= n - needle_len do
    if substr(s, i, needle_len) == "Err(" then
      return i
    end
    let i = i + 1
  end
  return -1
end

let args = argv()
let src = ""
if args.length >= 1 then
  let src = args[0]
end
let mode = "run"
if args.length >= 2 then
  let mode = args[1]
end

if src == "" then
  print("[playground] usage: playground <source> [run|tokens|ast]")
else
  let src = expand_syntax_dsls(src)
  let toks = tokenize(src)
  if mode == "tokens" then
    let n = vec_len(toks)
    let i = 0
    while i < n do
      let t = vec_get(toks, i)
      print(t[0] + chr(9) + t[1] + chr(9) + "line " + t[2])
      let i = i + 1
    end
  else
    let ast = parse_program(toks)
    let stmts = ast[1]
    let i = 0
    let errs = 0
    while i < stmts.length do
      let s = stmts[i]
      let rendered = ast_to_str(s)
      let err_at = pg_find_err_marker(rendered)
      if err_at >= 0 then
        print("parse error: " + substr(rendered, err_at + 4, rendered.length - err_at - 4))
        let errs = errs + 1
      end
      let i = i + 1
    end
    if mode == "ast" then
      let i = 0
      while i < stmts.length do
        print(ast_to_str(stmts[i]))
        let i = i + 1
      end
    else
      if errs == 0 then
        let ir = lower_program(ast)
        run_ir(ir)
      end
    end
  end
end
