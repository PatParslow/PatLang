# Playground driver (concatenate after lib/lexer + lib/parser + lib/lower).
# Takes PatLang source as its first argument, compiles it with the
# self-hosted front end, and executes the IR via run_ir — no rustc needed,
# so this works compiled to WASM in the browser.

let args = argv()
let src = ""
if args.length >= 1 then
  let src = args[0]
end
if src == "" then
  print("[playground] usage: playground <source>")
else
  let toks = tokenize(src)
  let ast = parse_program(toks)
  let stmts = ast[1]
  let i = 0
  let errs = 0
  while i < stmts.length do
    let s = stmts[i]
    if s[0] == "Err" then
      print("parse error: " + s[1])
      let errs = errs + 1
    end
    let i = i + 1
  end
  if errs == 0 then
    let ir = lower_program(ast)
    run_ir(ir)
  end
end
