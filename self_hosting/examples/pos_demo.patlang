# Point-of-sale demo driver (concatenate after lib/pos.patlang).
# A checkout session as a stream of events.

pos_setup()
print("scanning...")
emit("scan", "apple")
emit("scan", "apple")
emit("scan", "banana")
emit("scan", "milk")
emit("scan", "unobtainium")
emit("pay", 500)
print("till session complete")
