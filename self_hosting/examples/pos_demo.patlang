# Point-of-sale demo driver (concatenate after lib/pos.patlang).
# A checkout session as a stream of events.

# lib/pos.patlang holds the till's context, where its scan handler finds it
pos_setup(context_held())
print("scanning...")
emit("scan", "apple")
emit("scan", "apple")
emit("scan", "banana")
emit("scan", "milk")
emit("scan", "unobtainium")
emit("pay", 500)
print("till session complete")
