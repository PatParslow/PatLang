# Test suite for the point-of-sale library (concatenate after lib/test.patlang
# and lib/pos.patlang). Shows unit tests, event-driven integration tests, and
# a Gherkin feature exercising the same code.

# the tests' context (lib/gherkin.patlang), and the till's, which
# lib/pos.patlang holds for its scan handler
let ctx = ctx_new()
let till = context_held()

# ---- unit tests ----
print("unit: catalog and pricing")
pos_setup(till)
expect(ctx, "apple price", get("apple", "price"), 30)
expect(ctx, "milk is dairy", query("dairy", "milk", 0), 1)
expect(ctx, "banana is not dairy", query("dairy", "banana", 0), 0)
expect(ctx, "scan returns discounted dairy price", pos_scan(till, "milk"), 108)
expect(ctx, "scan returns full price", pos_scan(till, "banana"), 25)
expect(ctx, "running total", pos_total(till), 133)

# ---- integration test: the same flow through events ----
print("integration: checkout via events")
pos_setup(till)
emit("scan", "apple")
emit("scan", "apple")
emit("scan", "milk")
expect(ctx, "event-driven total", pos_total(till), 168)
expect(ctx, "change from 2 pounds", pos_pay(till, 200), 32)

# ---- Gherkin feature ----

make a function called st_fresh_till takes ctx returns done
  pos_setup(context_held())
  return true
end

make a function called st_scan_two_apples takes ctx returns done
  emit("scan", "apple")
  emit("scan", "apple")
  return true
end

make a function called st_scan_milk takes ctx returns done
  emit("scan", "milk")
  return true
end

make a function called st_total_is_168 takes ctx returns done
  return expect(ctx, "the total is 168p", pos_total(context_held()), 168)
end

make a function called st_dairy_discount_applied takes ctx returns done
  return expect(ctx, "dairy discount applied", get("milk", "price") - 12, 108)
end

step(ctx, "a fresh till", "st_fresh_till")
step(ctx, "the customer buys two apples", "st_scan_two_apples")
step(ctx, "the customer buys a bottle of milk", "st_scan_milk")
step(ctx, "the total is 168 pence", "st_total_is_168")
step(ctx, "the dairy discount was applied", "st_dairy_discount_applied")

let feature = "Feature: checkout
@smoke @till
Scenario: apples and discounted milk
Given a fresh till
When the customer buys two apples
And the customer buys a bottle of milk
Then the total is 168 pence
And the dairy discount was applied
@audit
Scenario: nightly stock audit
Given a fresh till
Then the total is 168 pence
"
# run only @smoke scenarios: the @audit scenario (which would fail) is skipped
run_feature_tagged(ctx, feature, "@smoke")

ctx_report(ctx)
