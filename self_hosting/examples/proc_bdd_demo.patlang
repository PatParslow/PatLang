# BDD-style verification of self_hosting/lib/proc.patlang, using the
# existing Gherkin runner in self_hosting/lib/gherkin.patlang.
#
# Mixes real end-to-end subprocess runs (run_classified against a real
# command and a real nonexistent one -- proving the crash found and fixed
# while building proc.patlang stays fixed) with direct classify_failure
# checks against synthetic stderr text (covering tiers real commands on
# this machine don't conveniently trigger, e.g. permission-denied).

include "../lib/includes.patlang"
include "../lib/proc.patlang"
include "../lib/includes.patlang"
include "../lib/gherkin.patlang"

# ---- step definitions: real end-to-end runs ----

make a function called st_proc_run_real_command takes ctx returns done
  let result = run_classified("echo", ["hello", "from", "proc"])
  ctx_set(ctx, "proc_result", result)
  return true
end

make a function called st_proc_real_command_succeeds takes ctx returns done
  let result = ctx_get(ctx, "proc_result")
  expect(ctx, "a real command reports exit_code 0", pr_exit_code(result), 0)
  expect(ctx, "a real command classifies as Ok", pr_classification(result), "Ok")
  expect(ctx, "a real command's stdout is captured", contains_text(pr_stdout(result), "hello from proc"), true)
  return true
end

make a function called st_proc_run_missing_command takes ctx returns done
  let result = run_classified("definitely_not_a_real_command_xyz123", [])
  ctx_set(ctx, "proc_result", result)
  return true
end

make a function called st_proc_missing_command_does_not_crash takes ctx returns done
  let result = ctx_get(ctx, "proc_result")
  expect(ctx, "a missing command reports exit_code 1, not a crash", pr_exit_code(result), 1)
  expect(ctx, "a missing command classifies as CommandNotFound (not a PatLang call)", pr_classification(result), "CommandNotFound")
  expect(ctx, "a missing command gets a non-empty diagnostic hint", pr_hint(result) != "", true)
  return true
end

# ---- step definitions: classify_failure tier checks against synthetic
# stderr text, for tiers a real command on this machine can't
# conveniently be made to trigger on demand ----

make a function called st_proc_missing_capability_stderr takes ctx returns done
  ctx_set(ctx, "proc_tier", classify_failure(1, "is not recognized as an internal or external command", true))
  return true
end

make a function called st_proc_tier_is_missing_capability takes ctx returns done
  expect(ctx, "a not-found failure from a PatLang call classifies as MissingCapability", ctx_get(ctx, "proc_tier"), "MissingCapability")
  return true
end

make a function called st_proc_permission_stderr takes ctx returns done
  ctx_set(ctx, "proc_tier", classify_failure(1, "Access is denied.", false))
  return true
end

make a function called st_proc_tier_is_permission_denied takes ctx returns done
  expect(ctx, "an access-denied stderr classifies as PermissionDenied", ctx_get(ctx, "proc_tier"), "PermissionDenied")
  return true
end

make a function called st_proc_path_stderr_lowered takes ctx returns done
  ctx_set(ctx, "proc_tier", classify_failure(1, "cannot find the path specified.", false))
  return true
end

make a function called st_proc_tier_is_path_resolution takes ctx returns done
  expect(ctx, "a cannot-find-path stderr classifies as PathResolutionError", ctx_get(ctx, "proc_tier"), "PathResolutionError")
  return true
end

make a function called st_proc_success_exit takes ctx returns done
  ctx_set(ctx, "proc_tier", classify_failure(0, "", false))
  return true
end

make a function called st_proc_tier_is_ok takes ctx returns done
  expect(ctx, "a zero exit_code classifies as Ok regardless of stderr", ctx_get(ctx, "proc_tier"), "Ok")
  return true
end

make a function called register_proc_steps takes ctx returns done
  step(ctx, "a real command is run through run_classified", "st_proc_run_real_command")
  step(ctx, "it succeeds with captured output", "st_proc_real_command_succeeds")
  step(ctx, "a nonexistent command is run through run_classified", "st_proc_run_missing_command")
  step(ctx, "it fails gracefully instead of crashing the script", "st_proc_missing_command_does_not_crash")
  step(ctx, "a not-found stderr from a PatLang capability lookup", "st_proc_missing_capability_stderr")
  step(ctx, "classify_failure is asked to classify it", "st_proc_tier_is_missing_capability")
  step(ctx, "an access-denied stderr", "st_proc_permission_stderr")
  step(ctx, "classify_failure is asked to classify it as permission", "st_proc_tier_is_permission_denied")
  step(ctx, "a cannot-find-path stderr", "st_proc_path_stderr_lowered")
  step(ctx, "classify_failure is asked to classify it as a path error", "st_proc_tier_is_path_resolution")
  step(ctx, "a zero exit code with no stderr", "st_proc_success_exit")
  step(ctx, "classify_failure is asked to classify it as ok", "st_proc_tier_is_ok")
  return true
end

make a function called proc_feature returns text
  return "Feature: subprocess execution with graceful failure classification

Scenario: a real command runs and succeeds
  Given a real command is run through run_classified
  Then it succeeds with captured output

Scenario: a nonexistent command fails gracefully, not fatally
  Given a nonexistent command is run through run_classified
  Then it fails gracefully instead of crashing the script

Scenario: a not-found failure from a PatLang capability lookup is MissingCapability
  Given a not-found stderr from a PatLang capability lookup
  Then classify_failure is asked to classify it

Scenario: an access-denied stderr is PermissionDenied
  Given an access-denied stderr
  Then classify_failure is asked to classify it as permission

Scenario: a cannot-find-path stderr is PathResolutionError
  Given a cannot-find-path stderr
  Then classify_failure is asked to classify it as a path error

Scenario: a zero exit code is always Ok
  Given a zero exit code with no stderr
  Then classify_failure is asked to classify it as ok
"
end

make a function called run_proc_bdd takes ctx returns ok
  let ctx = ctx_new()
  register_proc_steps(ctx)
  run_feature(ctx, proc_feature())
  ctx_report(ctx)
  return ctx_failed(ctx) == 0
end

let ctx = ctx_new()
run_proc_bdd(ctx)
