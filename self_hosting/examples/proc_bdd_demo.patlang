# BDD-style verification of self_hosting/lib/proc.patlang, using the
# existing Gherkin runner in self_hosting/lib/test.patlang.
#
# Mixes real end-to-end subprocess runs (run_classified against a real
# command and a real nonexistent one -- proving the crash found and fixed
# while building proc.patlang stays fixed) with direct classify_failure
# checks against synthetic stderr text (covering tiers real commands on
# this machine don't conveniently trigger, e.g. permission-denied).

include "../lib/includes.patlang"
include "../lib/proc.patlang"
include "../lib/test.patlang"

# ---- step definitions: real end-to-end runs ----

make a function called st_proc_run_real_command returns done
  let result = run_classified("echo", ["hello", "from", "proc"])
  set_var("proc_result", result)
  return true
end

make a function called st_proc_real_command_succeeds returns done
  let result = get("__vars", "proc_result")
  check("a real command reports exit_code 0", pr_exit_code(result), 0)
  check("a real command classifies as Ok", pr_classification(result), "Ok")
  check("a real command's stdout is captured", contains_text(pr_stdout(result), "hello from proc"), true)
  return true
end

make a function called st_proc_run_missing_command returns done
  let result = run_classified("definitely_not_a_real_command_xyz123", [])
  set_var("proc_result", result)
  return true
end

make a function called st_proc_missing_command_does_not_crash returns done
  let result = get("__vars", "proc_result")
  check("a missing command reports exit_code 1, not a crash", pr_exit_code(result), 1)
  check("a missing command classifies as CommandNotFound (not a PatLang call)", pr_classification(result), "CommandNotFound")
  check("a missing command gets a non-empty diagnostic hint", pr_hint(result) != "", true)
  return true
end

# ---- step definitions: classify_failure tier checks against synthetic
# stderr text, for tiers a real command on this machine can't
# conveniently be made to trigger on demand ----

make a function called st_proc_missing_capability_stderr returns done
  set_var("proc_tier", classify_failure(1, "is not recognized as an internal or external command", true))
  return true
end

make a function called st_proc_tier_is_missing_capability returns done
  check("a not-found failure from a PatLang call classifies as MissingCapability", get("__vars", "proc_tier"), "MissingCapability")
  return true
end

make a function called st_proc_permission_stderr returns done
  set_var("proc_tier", classify_failure(1, "Access is denied.", false))
  return true
end

make a function called st_proc_tier_is_permission_denied returns done
  check("an access-denied stderr classifies as PermissionDenied", get("__vars", "proc_tier"), "PermissionDenied")
  return true
end

make a function called st_proc_path_stderr_lowered returns done
  set_var("proc_tier", classify_failure(1, "cannot find the path specified.", false))
  return true
end

make a function called st_proc_tier_is_path_resolution returns done
  check("a cannot-find-path stderr classifies as PathResolutionError", get("__vars", "proc_tier"), "PathResolutionError")
  return true
end

make a function called st_proc_success_exit returns done
  set_var("proc_tier", classify_failure(0, "", false))
  return true
end

make a function called st_proc_tier_is_ok returns done
  check("a zero exit_code classifies as Ok regardless of stderr", get("__vars", "proc_tier"), "Ok")
  return true
end

make a function called register_proc_steps returns done
  step("a real command is run through run_classified", "st_proc_run_real_command")
  step("it succeeds with captured output", "st_proc_real_command_succeeds")
  step("a nonexistent command is run through run_classified", "st_proc_run_missing_command")
  step("it fails gracefully instead of crashing the script", "st_proc_missing_command_does_not_crash")
  step("a not-found stderr from a PatLang capability lookup", "st_proc_missing_capability_stderr")
  step("classify_failure is asked to classify it", "st_proc_tier_is_missing_capability")
  step("an access-denied stderr", "st_proc_permission_stderr")
  step("classify_failure is asked to classify it as permission", "st_proc_tier_is_permission_denied")
  step("a cannot-find-path stderr", "st_proc_path_stderr_lowered")
  step("classify_failure is asked to classify it as a path error", "st_proc_tier_is_path_resolution")
  step("a zero exit code with no stderr", "st_proc_success_exit")
  step("classify_failure is asked to classify it as ok", "st_proc_tier_is_ok")
  return true
end

make a function called proc_feature returns text
  return "Feature: subprocess execution with graceful failure classification

Scenario: a real command runs and succeeds
  Given a real command is run through run_classified
  Then it succeeds with captured output

Scenario: a nonexistent command fails gracefully, not fatally
  Given a nonexistent command is run through run_classified
  Then it fails gracefully instead of crashing the script

Scenario: a not-found failure from a PatLang capability lookup is MissingCapability
  Given a not-found stderr from a PatLang capability lookup
  Then classify_failure is asked to classify it

Scenario: an access-denied stderr is PermissionDenied
  Given an access-denied stderr
  Then classify_failure is asked to classify it as permission

Scenario: a cannot-find-path stderr is PathResolutionError
  Given a cannot-find-path stderr
  Then classify_failure is asked to classify it as a path error

Scenario: a zero exit code is always Ok
  Given a zero exit code with no stderr
  Then classify_failure is asked to classify it as ok
"
end

make a function called run_proc_bdd returns ok
  t_init()
  register_proc_steps()
  run_feature(proc_feature())
  t_report()
  return get("__vars", "t_fail") == 0
end

run_proc_bdd()
