# Verifies self_hosting/lib/queue.patlang: a durable, file-backed message
# queue with no new Rust host functions. Exercises publish/consume/ack/
# pending, and the queue_attempt saga wrapper.

include "../lib/includes.patlang"
include "../lib/queue.patlang"
include "../lib/includes.patlang"
include "../lib/gherkin.patlang"

make a function called qd_topic returns t
  return "queue_demo_topic"
end

# check() uses ==, which doesn't do deep list comparison -- render a list
# of ids as a comma-joined string first so equality is meaningful.
make a function called qd_ids_str takes ids returns s
  let b = sb_new()
  let i = 0
  let n = to_num(list_len(ids))
  while i < n do
    if i > 0 then
      sb_push(b, ",")
    end
    sb_push(b, "" + ids[i])
    let i = i + 1
  end
  return sb_str(b)
end

make a function called qd_cleanup returns done
  queue_remove_topic(qd_topic())
  return true
end

make a function called run_queue_tests takes ctx returns ok
  let ctx = ctx_new()
  qd_cleanup()

  let topic = qd_topic()

  expect(ctx, "empty queue has no pending", qd_ids_str(queue_pending(topic)), "")
  expect(ctx, "consume on empty queue is empty string", queue_consume(topic), "")

  let id0 = queue_publish(topic, "first message")
  let id1 = queue_publish(topic, "second message")
  expect(ctx, "first id is 0", id0, 0)
  expect(ctx, "second id is 1", id1, 1)
  expect(ctx, "pending after two publishes", qd_ids_str(queue_pending(topic)), "0,1")
  expect(ctx, "consume returns oldest pending", queue_consume(topic), "first message")

  queue_ack(topic, id0)
  expect(ctx, "pending after ack drops acked id", qd_ids_str(queue_pending(topic)), "1")
  expect(ctx, "consume now returns second message", queue_consume(topic), "second message")

  queue_ack(topic, id1)
  expect(ctx, "pending empty after both acked", qd_ids_str(queue_pending(topic)), "")
  expect(ctx, "consume empty after both acked", queue_consume(topic), "")

  # queue_attempt: successful attempt acks automatically
  let attempt_topic = "queue_demo_attempt"
  queue_remove_topic(attempt_topic)
  let ok_fn = || do
    return "did the thing"
  end
  let result = queue_attempt(attempt_topic, "risky op payload", ok_fn)
  expect(ctx, "queue_attempt returns fn's result", result, "did the thing")
  expect(ctx, "queue_attempt acks on success", qd_ids_str(queue_pending(attempt_topic)), "")

  # multi-topic reads: one topic per writer, avoiding a shared-file race by
  # construction rather than by locking
  let w1 = queue_writer_topic("qd_multi", "writer_1")
  let w2 = queue_writer_topic("qd_multi", "writer_2")
  expect(ctx, "writer topic naming is base__writer_id", w1, "qd_multi__writer_1")
  queue_remove_topic(w1)
  queue_remove_topic(w2)

  let topics = [w1, w2]
  expect(ctx, "pending_multi empty before any publish", to_num(list_len(queue_pending_multi(topics))), 0)

  queue_publish(w2, "from writer 2")
  queue_publish(w1, "from writer 1")

  let pending = queue_pending_multi(topics)
  expect(ctx, "pending_multi sees both writers", to_num(list_len(pending)), 2)
  expect(ctx, "pending_multi lists writer 1's topic first (topic order, not publish order)", pending[0][0], w1)
  expect(ctx, "pending_multi lists writer 2's topic second", pending[1][0], w2)

  let consumed = queue_consume_multi(topics)
  expect(ctx, "consume_multi returns first topic with a pending message", consumed[0], w1)
  expect(ctx, "consume_multi returns that topic's oldest payload", consumed[1], "from writer 1")

  queue_ack(w1, queue_pending(w1)[0])
  let consumed2 = queue_consume_multi(topics)
  expect(ctx, "consume_multi moves on to the next topic once the first is drained", consumed2[0], w2)
  expect(ctx, "consume_multi returns writer 2's payload", consumed2[1], "from writer 2")

  queue_ack(w2, queue_pending(w2)[0])
  let consumed3 = queue_consume_multi(topics)
  expect(ctx, "consume_multi returns empty pair once all topics are drained", consumed3[0], "")

  ctx_report(ctx)
  return ctx_failed(ctx) == 0
end

let ctx = ctx_new()
run_queue_tests(ctx)
