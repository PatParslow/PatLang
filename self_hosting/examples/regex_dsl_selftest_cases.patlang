# Self-test cases for lib/regex_dsl.patlang (concatenated after it and run
# through the self-hosted lexer/parser/lower/run_ir pipeline — see
# ../regex_dsl_selftest.patlang). Each line prints "<label>: <actual>" so a
# human (or a script comparing output) can check it against the expected
# value noted in the label.

print("literal match (expect 4): " + regex_match_string_at("abc", "xabcx", 1))
print("literal no match (expect -1): " + regex_match_string_at("abc", "xabxx", 1))
print("dot star (expect 4): " + regex_match_string_at("a.*b", "aXYb", 0))
print("star zero (expect 3): " + regex_match_string_at("a*", "aaab", 0))
print("class plus (expect 5): " + regex_match_string_at("[a-z]+", "hello123", 0))
print("class plus offset (expect 8): " + regex_match_string_at("[0-9]+", "hello123", 5))
print("negated class (expect 3): " + regex_match_string_at("[^0-9]+", "abc123", 0))
print("alternation GET (expect 3): " + regex_match_string_at("(GET|POST|PUT|DELETE)", "GET /users", 0))
print("alternation POST (expect 4): " + regex_match_string_at("(GET|POST|PUT|DELETE)", "POST /x", 0))
print("alternation none (expect -1): " + regex_match_string_at("(GET|POST|PUT|DELETE)", "PATCH /x", 0))
print("word boundary verb (expect 3): " + regex_match_string_at("\b(GET|POST|PUT|DELETE)\b", "GET /users", 0))
print("word boundary fail (expect -1): " + regex_match_string_at("\b(GET|POST|PUT|DELETE)\b", "GETX /users", 0))
print("url path (expect 15): " + regex_match_string_at("/[a-zA-Z0-9_/:-]*", "/users/:id/edit -> X", 0))
print("optional missing (expect 5): " + regex_match_string_at("colou?r", "color", 0))
print("optional present (expect 6): " + regex_match_string_at("colou?r", "colour", 0))
print("anchors match (expect 3): " + regex_match_string_at("^abc$", "abc", 0))
print("anchors fail (expect -1): " + regex_match_string_at("^abc$", "abcd", 0))
