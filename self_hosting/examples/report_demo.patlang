# Project report writer: goal-oriented programming as the primary paradigm
# (with logic, OO, and events woven in, PatLang-style). Writing the abstract
# requires every other section to exist first, and several of those sections
# have their own prerequisites in turn - a real dependency DAG, not just a
# linear chain (lit_review and discussion are each required twice). Achieving
# a goal means: check whether it's already done (a fact), recurse into any
# unmet requirements first, then do the work and announce it.

make a function called section takes name, requires returns done
  new("Section", name)
  send(name, "set", "requires", requires)
  send(name, "set", "status", "pending")
  return true
end

make a function called is_done takes name returns yes
  return get(name, "status") == "done"
end

make a function called write_section takes name returns done
  if is_done(name) then
    return true
  end
  goal("write", name)
  let reqs = get(name, "requires")
  let i = 0
  while i < reqs.length do
    write_section(reqs[i])
    let i = i + 1
  end
  send(name, "set", "status", "done")
  fact("written", name, "1")
  emit("section_done", name)
  return true
end

set_var("report_count", 0)
when section_done do
  set_var("report_count", get("__vars", "report_count") + 1)
  print("[report] finished: " + event_data)
end

section("background", [])
section("intro", ["background"])
section("lit_review", ["background"])
section("methodology", ["intro", "lit_review"])
section("design", ["methodology"])
section("implementation", ["design"])
section("results", ["implementation"])
section("analysis", ["results"])
section("discussion", ["analysis", "lit_review"])
section("limitations", ["discussion"])
section("conclusion", ["discussion", "limitations"])
section("abstract", ["background", "intro", "lit_review", "methodology", "design", "implementation", "results", "analysis", "discussion", "limitations", "conclusion"])

print("Goal: complete the report (the abstract summarizes everything, so it can only be written last).")
goal("report", "abstract")
write_section("abstract")

print("")
print(get("__vars", "report_count") + " sections written, " + query("written", "lit_review", 0) + " write of lit_review (shared by methodology and discussion, done once).")
