# Report simulator wasm driver (concatenate after lib/report.patlang).
# Runs the fixed task graph and prints the full event log so the browser
# can replay it as an animated timeline - no rustc once this module is
# built. Each log line: <virtual-ms>,<phase>,<task>,<worker>
# phase is one of: start, work_done, review_start, review_done

report_reset()

task("background", "researcher", 400, [])
task("intro", "writer", 300, ["background"])
task("lit_review", "researcher", 600, ["background"])
task("methodology", "architect", 400, ["intro", "lit_review"])
task("design", "architect", 500, ["methodology"])
task("implementation", "developer", 900, ["design"])
task("experiments", "researcher", 700, ["implementation"])
task("data_gathering", "researcher", 500, ["experiments"])
task("data_analysis", "analyst", 800, ["data_gathering"])
task("results", "analyst", 300, ["data_analysis"])
task("discussion", "writer", 600, ["results", "lit_review"])
task("limitations", "writer", 300, ["discussion"])
task("conclusion", "writer", 300, ["discussion", "limitations"])
task("abstract", "writer", 400, ["background", "intro", "lit_review", "methodology", "design", "implementation", "experiments", "data_gathering", "data_analysis", "results", "discussion", "limitations", "conclusion"])

achieve("abstract")

print(vclock())
print(get("__vars", "report_log"))
