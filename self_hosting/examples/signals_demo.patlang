# Runtime signals, worked example: run this program multiple times,
# concurrently. The first invocation claims the signal port and becomes
# the "primary" -- it holds the port and waits, dispatching whatever
# signal arrives to a `when <name> do ... end` handler, same as any other
# PatLang event. Every later invocation finds the port already claimed and
# becomes a "sender" instead, delivering one signal to the primary, then
# exiting immediately.
#
# Three signals are demonstrated:
#   ping   -- fire-and-forget, just proves delivery works
#   status -- request/response: the primary reports live state back
#   quit   -- fire-and-forget, triggers a graceful shutdown
#
#   pat --ir-run self_hosting/examples/signals_demo.patlang &
#   pat --ir-run self_hosting/examples/signals_demo.patlang ping hello
#   pat --ir-run self_hosting/examples/signals_demo.patlang status
#   pat --ir-run self_hosting/examples/signals_demo.patlang quit
#
# See self_hosting/lib/signals.patlang for the mechanism itself.

include "../lib/context.patlang"
include "../lib/signals.patlang"

let SIGNAL_PORT = 9401

let ctx = context_new()
context_hold(ctx)

when ping do
  let ctx = context_held()
  ctx_set(ctx, "pings_received", ctx_num(ctx, "pings_received") + 1)
  print("PRIMARY: received signal 'ping' with payload: " + event_data)
end

# status is a request/response signal, not fire-and-forget: the sender
# gets an actual reply back (via signal_query), built live from state this
# process has been tracking the whole time it's been running as primary --
# not just a static "I'm alive" string.
when status do
  let ctx = context_held()
  let uptime_ms = now_ms() - ctx_num(ctx, "started_at")
  signal_reply("PRIMARY status: alive for " + uptime_ms + "ms, received " + ctx_text(ctx, "pings_received") + " ping(s) so far")
end

when quit do
  let ctx = context_held()
  print("PRIMARY: received signal 'quit' -- shutting down")
  ctx_set(ctx, "should_stop", "1")
end

let cli_args = argv()

let port_id = signal_claim(SIGNAL_PORT)
if port_id >= 0 then
  print("PRIMARY: holding port " + SIGNAL_PORT + ", waiting for signals (Ctrl-C to stop, or send 'quit')")
  ctx_set(ctx, "should_stop", "0")
  ctx_set(ctx, "pings_received", 0)
  ctx_set(ctx, "started_at", now_ms())
  while ctx_get(ctx, "should_stop") == "0" do
    signal_poll(port_id, 200)
  end
  print("PRIMARY: exiting")
else
  # SECONDARY: a primary already holds the port. Send whatever this
  # invocation's own argv said to send -- "ping" with a message by
  # default, "status" for a live reply, or "quit" to shut the primary down.
  let sig_name = "ping"
  let sig_payload = "hello from a second invocation"
  if cli_args.length > 0 then
    let sig_name = cli_args[0]
  end
  if cli_args.length > 1 then
    let sig_payload = cli_args[1]
  end
  if sig_name == "status" then
    let reply = signal_query(SIGNAL_PORT, sig_name, sig_payload)
    print("SECONDARY: queried 'status', primary replied: " + reply)
  else
    signal_send(SIGNAL_PORT, sig_name, sig_payload)
    print("SECONDARY: sent signal '" + sig_name + "' to the primary, exiting")
  end
end
