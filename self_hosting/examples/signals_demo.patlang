# Runtime signals, worked example: run this program twice, concurrently.
# The first invocation claims the signal port and becomes the "primary" --
# it holds the port and waits, printing whatever signal arrives. Any later
# invocation finds the port already claimed and becomes a "sender" instead,
# delivering one signal to the primary, then exiting immediately.
#
#   pat --ir-run self_hosting/examples/signals_demo.patlang &
#   pat --ir-run self_hosting/examples/signals_demo.patlang ping hello
#
# See self_hosting/lib/signals.patlang for the mechanism itself.

include "../lib/signals.patlang"

let SIGNAL_PORT = 9401

when ping do
  print("PRIMARY: received signal 'ping' with payload: " + event_data)
end

when quit do
  print("PRIMARY: received signal 'quit' -- shutting down")
  set_var("should_stop", "1")
end

let cli_args = argv()

let port_id = signal_claim(SIGNAL_PORT)
if port_id >= 0 then
  print("PRIMARY: holding port " + SIGNAL_PORT + ", waiting for signals (Ctrl-C to stop, or send 'quit')")
  set_var("should_stop", "0")
  while get("__vars", "should_stop") == "0" do
    signal_poll(port_id, 200)
  end
  print("PRIMARY: exiting")
else
  # SECONDARY: a primary already holds the port. Send whatever this
  # invocation's own argv said to send -- "ping" with a message by
  # default, or "quit" if that's the first arg.
  let sig_name = "ping"
  let sig_payload = "hello from a second invocation"
  if cli_args.length > 0 then
    let sig_name = cli_args[0]
  end
  if cli_args.length > 1 then
    let sig_payload = cli_args[1]
  end
  signal_send(SIGNAL_PORT, sig_name, sig_payload)
  print("SECONDARY: sent signal '" + sig_name + "' to the primary, exiting")
end
