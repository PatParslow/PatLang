# Child half of spawn_readiness_demo.patlang: claims a signals port,
# announces itself via the beacon the moment it's actually listening
# (the readiness confirmation the parent is polling for), then serves
# one "ping" signal and exits.

include "../lib/signal_discovery.patlang"

when ping do
  signal_reply("pong")
end

let port_id = signal_claim(0)
if port_id >= 0 then
  signal_announce("readiness_demo_child", port_id, [["ping", "replies pong"]])
  let stop = false
  while not stop do
    let sig = signal_poll(port_id, 500)
    if sig == "ping" then
      let stop = true
    end
  end
end
