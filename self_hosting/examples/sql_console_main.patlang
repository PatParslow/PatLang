# Compiled driver for the browser SQL console (self_hosting/tools/
# build_portfolio.patlang's sql_console_page). Same shape as
# hexrts_main.patlang: a normal compiled program (argv in, print out),
# called once per statement with the current database snapshot and the
# statement to run, not a meta-circular compiler-in-wasm.
#
#   argv[0] == "INIT" -> a fresh empty database, argv[1] ignored
#   otherwise         -> argv[0] is the current database blob (from a
#                        previous call's output), argv[1] is one SQL
#                        statement to execute
#
# Output has two sections, separated by a literal "===STATE===" line (so
# JS can split the captured stdout on it): a human-readable RESULT section
# (OK/ERROR/ROWS+columns+row data) for immediate display, then the
# database's own serialized state for the caller to carry forward into the
# next call. is_native (argv[2], "1" or "0") controls whether COMMIT also
# flushes to real disk -- there's no real filesystem to flush to under WASM.

include "../lib/sql.patlang"

let args = argv()
let db_text = ""
let sql_text = ""
let is_native = "0"
if args.length >= 1 then
  let db_text = args[0]
end
if args.length >= 2 then
  let sql_text = args[1]
end
if args.length >= 3 then
  let is_native = args[2]
end

let db = rdb_init()
if db_text != "INIT" then
  let db = rdb_deserialize(db_text)
end

if sql_text.length > 0 then
  let ast = sql_parse(sql_text)
  let outcome = sql_execute(db, ast, is_native)
  let db = outcome[0]
  let result = outcome[1]
  if result[0] == "ok" then
    print("RESULT:OK:" + result[1])
  else
    if result[0] == "error" then
      print("RESULT:ERROR:" + result[1])
    else
      let cols = result[1]
      let rows = result[2]
      print("RESULT:ROWS:" + to_num(list_len(rows)))
      let i = 0
      let n = to_num(list_len(cols))
      while i < n do
        print("COL:" + cols[i])
        let i = i + 1
      end
      let r = 0
      let rn = to_num(list_len(rows))
      while r < rn do
        let b = sb_new()
        let row = rows[r]
        let k = 0
        let kn = to_num(list_len(row))
        while k < kn do
          if k > 0 then
            sb_push(b, ",")
          end
          sb_push(b, "" + row[k])
          let k = k + 1
        end
        print("ROW:" + sb_str(b))
        let r = r + 1
      end
    end
  end
else
  print("RESULT:OK:ready")
end

print("===STATE===")
print(rdb_serialize(db))
