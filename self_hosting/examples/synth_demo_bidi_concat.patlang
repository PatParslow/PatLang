# Phase 1 proof-of-concept for the bidirectional (meet-in-the-middle)
# witness-function design at
# C:\Users\p\.claude\plans\yes-design-it-bidirectional-witness.md
# (issue #69's markdown scaling wall).
#
# Stress case: a 4-way string concatenation ("<div..><span..>" + inner
# + "</span></div>", needing 3 nested concat calls) with 24 decoy
# string constants of similar length/shape cluttering the string-typed
# candidate pool at every level -- real clutter a plain forward search
# has to pair up combinatorially (every candidate string times every
# other candidate string, at every level), that a witness-driven
# backward split just scans past by exact value.
#
# Run safely under the interpreter's own memory watchdog (rust-runtime/
# src/main.rs, added specifically after this comparison's own plain-
# forward run genuinely exhausted memory during development): the plain
# side is NOT run by default here, since it is a confirmed, real
# resource hog, not just slow -- see run_synth_demo_bidi_concat_plain_
# comparison, opt-in only, matching synth_demo_markdown.patlang's own
# pattern for a known-expensive repro.
#
# Measured result (both runs to their own genuine end -- the plain side
# via the memory watchdog's clean exit, not an arbitrary timeout):
#   bidi_synthesize_from_examples:  OK in 711ms.
#   synthesize_from_examples:       pool grew 33 -> 658 -> 16,283 ->
#     406,908 candidates (sizes 2/4/6/8) in ~24s, then hit the
#     interpreter's 8GB memory safety cap attempting size 9 and exited
#     cleanly (exit 137) -- a genuinely unbounded search on this case,
#     not merely a slow one.

include "../lib/bidi_synthesis.patlang"
include "../lib/test.patlang"

t_init()

make a function called bidi_concat_decoys returns cs
  return ["xx1", "xx2", "xx3", "xx4", "xx5", "xx6", "xx7", "xx8", "xx9", "xx10",
          "yy1", "yy2", "yy3", "yy4", "yy5", "yy6", "yy7", "yy8", "yy9", "yy10",
          "<div class=\"outer\">", "<span class=\"label\">", "</span>", "</div>"]
end

make a function called bidi_concat_examples returns pairs
  let b1 = new("Dict", "bc_b1")
  send(b1, "set", "inner", "hello")
  let b2 = new("Dict", "bc_b2")
  send(b2, "set", "inner", "world")
  return [[b1, "<div class=\"outer\"><span class=\"label\">hello</span></div>"], [b2, "<div class=\"outer\"><span class=\"label\">world</span></div>"]]
end

make a function called run_synth_demo_bidi_concat returns ok
  let registry = pr_standard_registry()

  # Baseline sanity checks: the witness-guided path must still find the
  # simple, uncluttered cases plain forward search already handles fine
  # -- proving Phase 1 is additive, not a behavior change for cases
  # that don't need it.
  let ws1 = new("Dict", "bc_ws1")
  send(ws1, "set", "inner", "hello")
  let ws2 = new("Dict", "bc_ws2")
  send(ws2, "set", "inner", "bold")
  let ws_result = bidi_synthesize_from_examples([[ws1, "<strong>hello</strong>"], [ws2, "<strong>bold</strong>"]], ["inner"], ["<strong>", "</strong>"], registry, ["concat"], 8)
  check("bidi finds a simple wrap_strong case (concat witness, 2 examples)", ws_result[0], "OK")

  let inc1 = new("Dict", "bc_inc1")
  send(inc1, "set", "n", 5)
  let inc2 = new("Dict", "bc_inc2")
  send(inc2, "set", "n", 10)
  let inc_result = bidi_synthesize_from_examples([[inc1, 6], [inc2, 11]], ["n"], [], registry, ["add"], 6)
  check("bidi finds increment(n) = n + 1 (arithmetic witness)", inc_result[0], "OK")

  let examples = bidi_concat_examples()
  let t0 = now_ms()
  let result = bidi_synthesize_from_examples(examples, ["inner"], bidi_concat_decoys(), registry, ["concat"], 14)
  let elapsed = now_ms() - t0
  print("bidi_synthesize_from_examples: " + result[0] + " (" + elapsed + "ms)")
  check("bidi finds the 4-way concatenation despite 24 decoy candidates", result[0], "OK")
  check("bidi's derived AST really does compose 3 concat calls, not a shortcut", contains_text("" + result[1], "concat"), true)

  print("(plain forward comparison NOT run here -- see run_synth_demo_bidi_concat_plain_comparison, opt-in only, confirmed to exhaust the interpreter's 8GB memory cap on this exact case)")

  t_report()
  return get("__vars", "t_fail") == 0
end

# OPT-IN ONLY -- confirmed to genuinely exhaust memory on this case
# (pool reached 406,908 candidates by size 8, then hit the interpreter's
# memory safety cap attempting size 9). Do not call from CI or a
# routine test run. Protected by rust-runtime/src/main.rs's own memory
# watchdog regardless (default 8GB), so running it directly is safe --
# it will exit cleanly with a clear message rather than threaten the
# rest of the system -- but it is NOT fast, and is not the point of
# this file's default run.
make a function called run_synth_demo_bidi_concat_plain_comparison returns done
  let registry = pr_standard_registry()
  let examples = bidi_concat_examples()
  print("=== plain forward synthesize_from_examples (WILL exhaust the memory cap -- this is the point) ===")
  let t0 = now_ms()
  let result = synthesize_from_examples(examples, ["inner"], bidi_concat_decoys(), registry, ["concat"], 14)
  print("synthesize_from_examples: " + result[0] + " (" + (now_ms() - t0) + "ms)")
  return true
end

run_synth_demo_bidi_concat()
