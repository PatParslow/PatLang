# Proof-of-concept for the bidirectional (meet-in-the-middle) witness-
# function design at
# C:\Users\p\.claude\plans\yes-design-it-bidirectional-witness.md
# (issue #69's markdown scaling wall) -- Phase 1 (concat/add/sub
# witnesses) and Phase 2 (cond's disjunctive witness, with A*-ordered
# partition search and ambiguity-tie tracking).
#
# Stress case: a 4-way string concatenation ("<div..><span..>" + inner
# + "</span></div>", needing 3 nested concat calls) with 24 decoy
# string constants of similar length/shape cluttering the string-typed
# candidate pool at every level -- real clutter a plain forward search
# has to pair up combinatorially (every candidate string times every
# other candidate string, at every level), that a witness-driven
# backward split just scans past by exact value.
#
# Run safely under the interpreter's own memory watchdog (rust-runtime/
# src/main.rs, added specifically after this comparison's own plain-
# forward run genuinely exhausted memory during development): the plain
# side is NOT run by default here, since it is a confirmed, real
# resource hog, not just slow -- see run_synth_demo_bidi_concat_plain_
# comparison, opt-in only, matching synth_demo_markdown.patlang's own
# pattern for a known-expensive repro.
#
# Measured result (both runs to their own genuine end -- the plain side
# via the memory watchdog's clean exit, not an arbitrary timeout):
#   bidi_synthesize_from_examples:  OK in 711ms.
#   synthesize_from_examples:       pool grew 33 -> 658 -> 16,283 ->
#     406,908 candidates (sizes 2/4/6/8) in ~24s, then hit the
#     interpreter's 8GB memory safety cap attempting size 9 and exited
#     cleanly (exit 137) -- a genuinely unbounded search on this case,
#     not merely a slow one.

include "../lib/bidi_synthesis.patlang"
include "../lib/test.patlang"

t_init()

make a function called bidi_concat_decoys returns cs
  return ["xx1", "xx2", "xx3", "xx4", "xx5", "xx6", "xx7", "xx8", "xx9", "xx10",
          "yy1", "yy2", "yy3", "yy4", "yy5", "yy6", "yy7", "yy8", "yy9", "yy10",
          "<div class=\"outer\">", "<span class=\"label\">", "</span>", "</div>"]
end

make a function called bidi_concat_examples returns pairs
  let b1 = new("Dict", "bc_b1")
  send(b1, "set", "inner", "hello")
  let b2 = new("Dict", "bc_b2")
  send(b2, "set", "inner", "world")
  return [[b1, "<div class=\"outer\"><span class=\"label\">hello</span></div>"], [b2, "<div class=\"outer\"><span class=\"label\">world</span></div>"]]
end

make a function called run_synth_demo_bidi_concat returns ok
  let registry = pr_standard_registry()

  # Baseline sanity checks: the witness-guided path must still find the
  # simple, uncluttered cases plain forward search already handles fine
  # -- proving Phase 1 is additive, not a behavior change for cases
  # that don't need it.
  let ws1 = new("Dict", "bc_ws1")
  send(ws1, "set", "inner", "hello")
  let ws2 = new("Dict", "bc_ws2")
  send(ws2, "set", "inner", "bold")
  let ws_result = bidi_synthesize_from_examples([[ws1, "<strong>hello</strong>"], [ws2, "<strong>bold</strong>"]], ["inner"], ["<strong>", "</strong>"], registry, ["concat"], 8)
  check("bidi finds a simple wrap_strong case (concat witness, 2 examples)", ws_result[0], "OK")

  let inc1 = new("Dict", "bc_inc1")
  send(inc1, "set", "n", 5)
  let inc2 = new("Dict", "bc_inc2")
  send(inc2, "set", "n", 10)
  let inc_result = bidi_synthesize_from_examples([[inc1, 6], [inc2, 11]], ["n"], [], registry, ["add"], 6)
  check("bidi finds increment(n) = n + 1 (arithmetic witness)", inc_result[0], "OK")

  # Phase 2 (cond's disjunctive witness) + Phase 3 (range witnesses for
  # gt/geq/eq_int): a 3-example case (n=1->10, n=2->20, n=3->10).
  # Before Phase 3 existed, this search only found comparisons via slow
  # full recursive growth, and settled for a deeply nested, size-15
  # tied pair of candidates (correctly flagged as ambiguous by the
  # tie-tracking Phase 2 added -- proving that mechanism fires was the
  # ORIGINAL point of this case). With Phase 3's direct scan for a
  # matching comparison over already-built values, the search now finds
  # the actual minimal, correctly-generalizing formula directly --
  # cond(eq_int(n,2), 20, 10), size 8, no tie -- a real, measured
  # improvement (3900ms -> ~1500ms on this case), not a regression in
  # the ambiguity-tracking mechanism itself (which is still exercised,
  # just no longer triggered by THIS now-easier case).
  let cond1 = new("Dict", "bc_cond1")
  send(cond1, "set", "n", 1)
  let cond2 = new("Dict", "bc_cond2")
  send(cond2, "set", "n", 2)
  let cond3 = new("Dict", "bc_cond3")
  send(cond3, "set", "n", 3)
  let cond_result = bidi_synthesize_from_examples([[cond1, 10], [cond2, 20], [cond3, 10]], ["n"], [], registry, ["cond", "gt", "add", "eq_int"], 10)
  check("bidi finds the correct minimal cond case with Phase 3's range witness", cond_result[0], "OK")
  check("finds the actual minimal formula (size 8), not a larger tied one", sbe_size(cond_result[1]), 8)
  let cond_ho = new("Dict", "bc_cond_ho")
  send(cond_ho, "set", "n", 4)
  check("held-out: cond(eq_int(n,2),20,10) generalizes to n=4 -> 10", sbe_eval(cond_result[1], cond_ho, registry)[1], 10)

  let examples = bidi_concat_examples()
  let t0 = now_ms()
  let result = bidi_synthesize_from_examples(examples, ["inner"], bidi_concat_decoys(), registry, ["concat"], 14)
  let elapsed = now_ms() - t0
  print("bidi_synthesize_from_examples: " + result[0] + " (" + elapsed + "ms)")
  check("bidi finds the 4-way concatenation despite 24 decoy candidates", result[0], "OK")
  check("bidi's derived AST really does compose 3 concat calls, not a shortcut", contains_text("" + result[1], "concat"), true)

  print("(plain forward comparison NOT run here -- see run_synth_demo_bidi_concat_plain_comparison, opt-in only, confirmed to exhaust the interpreter's 8GB memory cap on this exact case)")

  t_report()
  return get("__vars", "t_fail") == 0
end

# OPT-IN ONLY -- confirmed to genuinely exhaust memory on this case
# (pool reached 406,908 candidates by size 8, then hit the interpreter's
# memory safety cap attempting size 9). Do not call from CI or a
# routine test run. Protected by rust-runtime/src/main.rs's own memory
# watchdog regardless (default 8GB), so running it directly is safe --
# it will exit cleanly with a clear message rather than threaten the
# rest of the system -- but it is NOT fast, and is not the point of
# this file's default run.
make a function called run_synth_demo_bidi_concat_plain_comparison returns done
  let registry = pr_standard_registry()
  let examples = bidi_concat_examples()
  print("=== plain forward synthesize_from_examples (WILL exhaust the memory cap -- this is the point) ===")
  let t0 = now_ms()
  let result = synthesize_from_examples(examples, ["inner"], bidi_concat_decoys(), registry, ["concat"], 14)
  print("synthesize_from_examples: " + result[0] + " (" + (now_ms() - t0) + "ms)")
  return true
end

# OPT-IN ONLY -- not because it's dangerous (it isn't, well within the
# memory cap), but because it's too slow for the default suite. This is
# the actual real first_exceeding case (5 single-list examples,
# self_hosting/lib/synthesis_by_example.patlang's own history with it),
# the reason Phase 2/3 exist at all.
#
# Real history on THIS exact case, each step measured, not assumed:
# partition search with no A*-ordering returned a confidently WRONG
# answer after ~82 minutes. A*-ordering fixed correctness but not
# speed. Range witnesses (Phase 3) sped up a small toy case but this
# real case still exhausted the interpreter's 8GB memory cap -- traced
# to the boolean TEST sub-search recursing into ANOTHER disjunctive
# `cond` search at full "any"-type combinatorial cost. Excluding "cond"
# from the test search's own list (bidi_strip_cond) got it to ~29s.
# Replacing partition-and-recurse with partition-and-SCAN
# (bidi_try_cond_combined -- read a/b/test directly off the shared,
# already-growing index instead of fully re-synthesizing them per
# partition) got it to **~1.8s**, a further ~16x.
#
# It does NOT find a generalizing formula on THIS 5-example dataset --
# and that's expected, not a bug: this exact single-list dataset is a
# KNOWN under-specified case (established earlier working on the plain
# enumerator; needs a second list's worth of examples to force the
# general formula, exactly like after_space/sum3 elsewhere in this
# codebase). See run_synth_demo_bidi_cond_real_8ex below for the
# disambiguated case, where the combined approach DOES find the correct,
# held-out-verified general formula.
make a function called run_synth_demo_bidi_cond_real returns done
  let registry = pr_standard_registry()
  let b1 = new("Dict", "bcr_b1")
  send(b1, "set", "xs", [10, 20, 30])
  send(b1, "set", "threshold", 5)
  let b2 = new("Dict", "bcr_b2")
  send(b2, "set", "xs", [10, 20, 30])
  send(b2, "set", "threshold", 9)
  let b3 = new("Dict", "bcr_b3")
  send(b3, "set", "xs", [10, 20, 30])
  send(b3, "set", "threshold", 10)
  let b4 = new("Dict", "bcr_b4")
  send(b4, "set", "xs", [10, 20, 30])
  send(b4, "set", "threshold", 19)
  let b5 = new("Dict", "bcr_b5")
  send(b5, "set", "xs", [10, 20, 30])
  send(b5, "set", "threshold", 20)
  let examples = [[b1, 10], [b2, 10], [b3, 20], [b4, 20], [b5, 30]]

  print("=== real first_exceeding case (5 single-list examples), ~1.8s expected ===")
  let t0 = now_ms()
  let result = bidi_synthesize_from_examples(examples, ["xs", "threshold"], [], registry, ["list_get", "gt", "cond"], 18)
  print("status=" + result[0] + " elapsed_ms=" + (now_ms() - t0) + " notes=" + result[2])

  let ho1 = new("Dict", "bcr_ho1")
  send(ho1, "set", "xs", [5, 50, 500])
  send(ho1, "set", "threshold", 7)
  let r1 = sbe_eval(result[1], ho1, registry)
  print("held-out (xs=[5,50,500], threshold=7): got " + r1[1] + " expected 50")

  let ho2 = new("Dict", "bcr_ho2")
  send(ho2, "set", "xs", [10, 20, 30])
  send(ho2, "set", "threshold", 25)
  let r2 = sbe_eval(result[1], ho2, registry)
  print("held-out (xs=[10,20,30], threshold=25): got " + r2[1] + " expected 30")
  return true
end

# OPT-IN ONLY (~2min15s) -- the disambiguated 8-example (two-list) case
# that forces the true general formula. The real formula here is a
# NESTED pair of conditionals (list_get(xs, cond(gt(xs[0],threshold),0,
# cond(gt(xs[1],threshold),1,2)))), which is exactly what makes the
# partition-based approach struggle at this scale: its single binary
# partition per call has to guess the FIRST split correctly, then
# recursively guess the second, while most of the 254 candidate first-
# splits are wrong but still locally satisfiable on their own subset --
# they don't fail fast, they succeed on a wrong branch and waste a full
# recursive sub-search before the outer check catches it. Left running
# deliberately (not killed early) to get a real number: ~6 HOURS
# without completing, still healthy (3-16GB, never near the memory
# cap) -- genuinely slow, not stuck or leaking.
#
# bidi_try_cond_combined (partition enumeration + scan the shared index
# instead of recursing) finds the correct, held-out-verified general
# formula in ~2 minutes 15 seconds -- roughly 160x faster than
# partition-only on this exact case, and ~23x faster than the original
# flat enumerator's own ~53-minute solve (self_hosting/examples/synth_
# demo_markdown.patlang-adjacent history; see the site page). Also
# correctly reports the residual structural ambiguity at that size
# rather than hiding it.
make a function called run_synth_demo_bidi_cond_real_8ex returns done
  let registry = pr_standard_registry()
  let b1 = new("Dict", "bcr8_b1")
  send(b1, "set", "xs", [10, 20, 30])
  send(b1, "set", "threshold", 5)
  let b2 = new("Dict", "bcr8_b2")
  send(b2, "set", "xs", [10, 20, 30])
  send(b2, "set", "threshold", 9)
  let b3 = new("Dict", "bcr8_b3")
  send(b3, "set", "xs", [10, 20, 30])
  send(b3, "set", "threshold", 10)
  let b4 = new("Dict", "bcr8_b4")
  send(b4, "set", "xs", [10, 20, 30])
  send(b4, "set", "threshold", 19)
  let b5 = new("Dict", "bcr8_b5")
  send(b5, "set", "xs", [10, 20, 30])
  send(b5, "set", "threshold", 20)
  let b6 = new("Dict", "bcr8_b6")
  send(b6, "set", "xs", [5, 50, 500])
  send(b6, "set", "threshold", 1)
  let b7 = new("Dict", "bcr8_b7")
  send(b7, "set", "xs", [5, 50, 500])
  send(b7, "set", "threshold", 7)
  let b8 = new("Dict", "bcr8_b8")
  send(b8, "set", "xs", [5, 50, 500])
  send(b8, "set", "threshold", 60)
  let examples = [[b1, 10], [b2, 10], [b3, 20], [b4, 20], [b5, 30], [b6, 5], [b7, 50], [b8, 500]]

  print("=== real first_exceeding case (8 two-list examples), ~2min15s expected ===")
  let t0 = now_ms()
  let result = bidi_synthesize_from_examples(examples, ["xs", "threshold"], [], registry, ["list_get", "gt", "cond"], 22)
  print("status=" + result[0] + " elapsed_ms=" + (now_ms() - t0) + " notes=" + result[2])

  let ho1 = new("Dict", "bcr8_ho1")
  send(ho1, "set", "xs", [1, 100, 1000])
  send(ho1, "set", "threshold", 50)
  let r1 = sbe_eval(result[1], ho1, registry)
  print("held-out (xs=[1,100,1000], threshold=50): got " + r1[1] + " expected 100")
  return true
end

run_synth_demo_bidi_concat()
