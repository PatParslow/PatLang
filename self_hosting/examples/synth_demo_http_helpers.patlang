# Populates the persistent composite library (self_hosting/lib/
# composite_library.patlang) with the HTTP/text-parsing helpers derived
# by example for self_hosting/examples/goap_webservice_demo.patlang:
# crlf, es_contains, first_line, and path_of (built by COMPOSING two
# smaller derived pieces, after_space and up_to_space), plus
# body_for_path via the separate decision-list mode. Each is saved once
# here; self_hosting/examples/synth_demo_library_reuse.patlang proves a
# LATER, separate process can load and reuse them without re-deriving
# anything.

include "../lib/composite_library.patlang"

make a function called run_synth_demo_http_helpers returns ok
  let registry = pr_standard_registry()

  let empty_bindings = new("Dict", "hh_empty")
  let crlf_examples = [[empty_bindings, chr(13) + chr(10)]]
  let crlf_ast = synthesize_from_examples(crlf_examples, [], [], registry, ["chr", "concat"], 6)[1]
  print("crlf derived")
  cl_save("http", "crlf", [], [], 4, "expression", crlf_ast, crlf_examples)

  let e1 = new("Dict", "hh_e1")
  send(e1, "set", "hay", "hello world")
  send(e1, "set", "needle", "world")
  let e2 = new("Dict", "hh_e2")
  send(e2, "set", "hay", "hello world")
  send(e2, "set", "needle", "zzz")
  let es_examples = [[e1, true], [e2, false]]
  let es_ast = synthesize_from_examples(es_examples, ["hay", "needle"], [], registry, ["index_of", "geq"], 6)[1]
  print("es_contains derived")
  cl_save("string", "es_contains", ["hay", "needle"], ["string", "string"], 5, "expression", es_ast, es_examples)
  register_composite(registry, "es_contains", es_ast, ["hay", "needle"], ["string", "string"], 5)

  let f1 = new("Dict", "hh_f1")
  send(f1, "set", "text", "GET /health HTTP/1.1" + chr(13) + chr(10) + chr(13) + chr(10))
  let f2 = new("Dict", "hh_f2")
  send(f2, "set", "text", "POST /x HTTP/1.1" + chr(13) + chr(10) + chr(13) + chr(10))
  let fl_examples = [[f1, "GET /health HTTP/1.1"], [f2, "POST /x HTTP/1.1"]]
  let fl_ast = synthesize_from_examples(fl_examples, ["text"], [chr(13) + chr(10)], registry, ["substr", "index_of"], 7)[1]
  print("first_line derived")
  cl_save("http", "first_line", ["text"], ["string"], 6, "expression", fl_ast, fl_examples)

  let a1 = new("Dict", "hh_a1")
  send(a1, "set", "s", "GET /health HTTP/1.1")
  let a2 = new("Dict", "hh_a2")
  send(a2, "set", "s", "POST /x HTTP/1.1")
  let a3 = new("Dict", "hh_a3")
  send(a3, "set", "s", "GET /a/very/long/path/that/keeps/going/on/and/on/for/a/while HTTP/1.1")
  let after_space_examples = [[a1, "/health HTTP/1.1"], [a2, "/x HTTP/1.1"], [a3, "/a/very/long/path/that/keeps/going/on/and/on/for/a/while HTTP/1.1"]]
  let after_space_ast = synthesize_from_examples(after_space_examples, ["s"], [" "], registry, ["substr", "index_of", "add", "sub", "str_len"], 12)[1]
  print("after_space derived (3 examples -- rules out the substr-clamp overfit shortcut)")
  cl_save("http", "after_space", ["s"], ["string"], 4, "expression", after_space_ast, after_space_examples)
  register_composite(registry, "after_space", after_space_ast, ["s"], ["string"], 4)

  let u1 = new("Dict", "hh_u1")
  send(u1, "set", "s", "/health HTTP/1.1")
  let u2 = new("Dict", "hh_u2")
  send(u2, "set", "s", "/x HTTP/1.1")
  let up_to_space_examples = [[u1, "/health"], [u2, "/x"]]
  let up_to_space_ast = synthesize_from_examples(up_to_space_examples, ["s"], [" "], registry, ["substr", "index_of"], 8)[1]
  print("up_to_space derived")
  cl_save("http", "up_to_space", ["s"], ["string"], 4, "expression", up_to_space_ast, up_to_space_examples)
  register_composite(registry, "up_to_space", up_to_space_ast, ["s"], ["string"], 4)

  let p1 = new("Dict", "hh_p1")
  send(p1, "set", "reqline", "GET /health HTTP/1.1")
  let p2 = new("Dict", "hh_p2")
  send(p2, "set", "reqline", "POST /x HTTP/1.1")
  let path_of_examples = [[p1, "/health"], [p2, "/x"]]
  let path_of_ast = synthesize_from_examples(path_of_examples, ["reqline"], [], registry, ["after_space", "up_to_space"], 6)[1]
  print("path_of derived by composing after_space + up_to_space")
  cl_save("http", "path_of", ["reqline"], ["string"], 8, "expression", path_of_ast, path_of_examples)

  let bfp_lookup_examples = [["/health", "OK"], ["/echo", "ECHO"], ["/time", "TIME"]]
  let bfp_ast = synthesize_lookup_from_examples("path", bfp_lookup_examples, "NOT FOUND")
  print("body_for_path derived (decision-list mode)")
  # cl_save's example shape is [bindings_dict, expected] -- decision-list
  # examples are stored the same way as any other composite's, for a
  # uniform re-verification path.
  let bfp_b1 = new("Dict", "hh_bfp1")
  send(bfp_b1, "set", "path", "/health")
  let bfp_b2 = new("Dict", "hh_bfp2")
  send(bfp_b2, "set", "path", "/echo")
  let bfp_b3 = new("Dict", "hh_bfp3")
  send(bfp_b3, "set", "path", "/time")
  let bfp_b4 = new("Dict", "hh_bfp4")
  send(bfp_b4, "set", "path", "/nope")
  let bfp_examples = [[bfp_b1, "OK"], [bfp_b2, "ECHO"], [bfp_b3, "TIME"], [bfp_b4, "NOT FOUND"]]
  cl_save("http", "body_for_path", ["path"], ["string"], 5, "lookup", bfp_ast, bfp_examples)

  print("library populated: string/es_contains, http/{crlf,first_line,after_space,up_to_space,path_of,body_for_path}")
  return true
end

run_synth_demo_http_helpers()
