# Proves the composite library (self_hosting/lib/composite_library.
# patlang) is genuinely PERSISTENT and reusable across separate process
# runs, not just within the process that derived something: this file
# contains NO calls to synthesize_from_examples/synthesize_lookup_from_
# examples at all -- every composite it uses comes from
# self_hosting/composite_library/*/*.json, written by
# synth_demo_http_helpers.patlang / synth_demo_list_ops.patlang /
# synth_demo_numeric_ops.patlang in earlier, independent runs. Each is
# re-verified against its own stored examples on load (see
# composite_library.patlang's file header for why), so this also proves
# the load-time verification gate doesn't reject anything that's still
# genuinely correct.

include "../lib/test.patlang"
include "../lib/composite_library.patlang"

t_init()

let registry = pr_standard_registry()
let report = cl_load_all(registry)

let i = 0
let n = to_num(list_len(report))
while i < n do
  let row = report[i]
  print(row[0] + "/" + row[1] + ": " + row[2])
  let i = i + 1
end

check("at least one composite loaded from each of the 3 populated domains", to_num(list_len(cl_list_domains())) >= 3, true)

let all_ok = true
let i = 0
while i < n do
  if report[i][2] == false then
    let all_ok = false
  end
  let i = i + 1
end
check("every composite currently in the library re-verifies successfully on load", all_ok, true)

# ---- actually USE the reused composites, from a process that never
# derived any of them ----

check("http/crlf, reused", sbe_eval(["Call", "crlf", []], new("Dict", "lr1"), registry)[1], chr(13) + chr(10))

let b1 = new("Dict", "lr2")
send(b1, "set", "reqline", "GET /health HTTP/1.1")
check("http/path_of, reused (itself composed from after_space + up_to_space, also reused)", sbe_eval(["Call", "path_of", [["Input", "reqline"]]], b1, registry)[1], "/health")

let b2 = new("Dict", "lr3")
send(b2, "set", "path", "/echo")
check("http/body_for_path, reused (decision-list mode)", sbe_eval(["Call", "body_for_path", [["Input", "path"]]], b2, registry)[1], "ECHO")

let b3 = new("Dict", "lr4")
send(b3, "set", "xs", [1, 2, 3])
check("list/second, reused", sbe_eval(["Call", "second", [["Input", "xs"]]], b3, registry)[1], 2)

let b4 = new("Dict", "lr5")
send(b4, "set", "n", 41)
check("numeric/increment, reused", sbe_eval(["Call", "increment", [["Input", "n"]]], b4, registry)[1], 42)

t_report()
