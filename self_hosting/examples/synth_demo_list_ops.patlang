# Broadens the derived-composite library into a new primitive domain:
# LIST operations (self_hosting/lib/primitive_registry.patlang's
# list_get/list_len wrappers), proving the enumerator and type-directed
# search generalize beyond strings/HTTP parsing without any change to
# synthesis_by_example.patlang itself.

include "../lib/composite_library.patlang"

make a function called run_synth_demo_list_ops returns ok
  let registry = pr_standard_registry()

  # second(xs) -> the element at index 1
  let s1 = new("Dict", "lo_s1")
  send(s1, "set", "xs", [10, 20, 30])
  let s2 = new("Dict", "lo_s2")
  send(s2, "set", "xs", ["a", "b", "c", "d"])
  let second_examples = [[s1, 20], [s2, "b"]]
  let second_ast = synthesize_from_examples(second_examples, ["xs"], [], registry, ["list_get"], 4)[1]
  print("second: " + ("" + second_ast))
  cl_save("list", "second", ["xs"], ["list"], 3, "expression", second_ast, second_examples)
  register_composite(registry, "second", second_ast, ["xs"], ["list"], 3)

  # list_is_empty(xs) -> true iff the list has zero elements
  let e1 = new("Dict", "lo_e1")
  send(e1, "set", "xs", [])
  let e2 = new("Dict", "lo_e2")
  send(e2, "set", "xs", [1])
  let e3 = new("Dict", "lo_e3")
  send(e3, "set", "xs", [1, 2, 3])
  let is_empty_examples = [[e1, true], [e2, false], [e3, false]]
  let is_empty_ast = synthesize_from_examples(is_empty_examples, ["xs"], [], registry, ["list_len", "eq_int"], 5)[1]
  print("list_is_empty: " + ("" + is_empty_ast))
  cl_save("list", "list_is_empty", ["xs"], ["list"], 3, "expression", is_empty_ast, is_empty_examples)
  register_composite(registry, "list_is_empty", is_empty_ast, ["xs"], ["list"], 3)

  # second_or_first(xs) -> second(xs) if the list is long enough, using
  # second() and list_is_empty() as ALREADY-DERIVED building blocks --
  # proving cross-domain composite reuse (a "list" composite is used
  # directly by another "list" composite the way path_of reused two
  # "http" composites).
  let f1 = new("Dict", "lo_f1")
  send(f1, "set", "xs", [10, 20, 30])
  let f2 = new("Dict", "lo_f2")
  send(f2, "set", "xs", ["a", "b"])
  let first_examples = [[f1, 10], [f2, "a"]]
  let first_ast = synthesize_from_examples(first_examples, ["xs"], [], registry, ["list_get"], 4)[1]
  print("first: " + ("" + first_ast))
  cl_save("list", "first", ["xs"], ["list"], 3, "expression", first_ast, first_examples)

  print("library populated: list/{second,list_is_empty,first}")
  return true
end

run_synth_demo_list_ops()
