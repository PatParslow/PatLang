# Markdown-domain synthesis demo, backing the "Markdown domain" section
# of the example-driven-synthesis site page. The exact script that
# produced that page's original numbers was never committed (a session
# artifact, not preserved) -- this is a faithful reconstruction, built
# and validated fresh rather than assumed correct, with its own
# derivation bugs found and fixed along the way (documented below) so
# a later re-run of this file is the actual source of truth for that
# page's claims, not this comment.
#
# Six domain composites, each derived individually from a handful of
# Given/Then examples:
#   find_position(text, marker)      = find_substr(text, marker)
#   second_marker(text, from)        = index_of_from(text, "**", from)
#   inner_text(text, start, end)     = substr(text, start, sub(end, start))
#   wrap_strong(inner)               = "<strong>" + inner + "</strong>"
#   strip_hash(line)                 = substr(line, 2, sub(str_len(line), 2))
#   h1_line(line)                    = "<h1>" + strip_hash(line) + "</h1>"
#
# Checked directly, not assumed: with just the 2 examples below,
# inner_text's search already lands on the correct general formula
# (substr(text, start, sub(end, start))), not an overfit shortcut --
# unlike after_space (synth_demo_http_helpers.patlang), whose analogous
# 1-example case DOES admit a substr-clamp shortcut. A third, genuinely
# different-offset example is kept anyway as a held-out generalization
# check rather than removed, since it's a real, cheap thing to verify.
#
# The actual claim under test is the LAST step: composing all six
# already-derived pieces (plus the raw reassembly primitives substr/
# add/sub/str_len/concat none of the six pieces alone provide) into one
# inline-bold transform, "**hello** world" -> "<strong>hello</strong>
# world", as a SINGLE flat search rather than a further staged
# decomposition.

include "../lib/composite_library.patlang"
include "../lib/test.patlang"

t_init()

make a function called run_synth_demo_markdown returns ok
  let registry = pr_standard_registry()

  # ---- find_position ----
  let fp1 = new("Dict", "md_fp1")
  send(fp1, "set", "text", "**hello** world")
  send(fp1, "set", "marker", "**")
  let fp2 = new("Dict", "md_fp2")
  send(fp2, "set", "text", "abc **bold** def")
  send(fp2, "set", "marker", "**")
  let fp_examples = [[fp1, 0], [fp2, 4]]
  let t0 = now_ms()
  let fp_result = synthesize_from_examples(fp_examples, ["text", "marker"], [], registry, ["find_substr"], 4)
  print("find_position: " + fp_result[0] + " (" + (now_ms() - t0) + "ms)")
  check("find_position derives", fp_result[0], "OK")
  register_composite(registry, "find_position", fp_result[1], ["text", "marker"], ["string", "string"], 3)
  cl_save("markdown", "find_position", ["text", "marker"], ["string", "string"], 3, "expression", fp_result[1], fp_examples)

  # ---- second_marker ----
  let sm1 = new("Dict", "md_sm1")
  send(sm1, "set", "text", "**hello** world")
  send(sm1, "set", "from", 2)
  let sm2 = new("Dict", "md_sm2")
  send(sm2, "set", "text", "abc **bold** def")
  send(sm2, "set", "from", 6)
  let sm_examples = [[sm1, 7], [sm2, 10]]
  let t1 = now_ms()
  let sm_result = synthesize_from_examples(sm_examples, ["text", "from"], ["**"], registry, ["index_of_from"], 6)
  print("second_marker: " + sm_result[0] + " (" + (now_ms() - t1) + "ms)")
  check("second_marker derives", sm_result[0], "OK")
  register_composite(registry, "second_marker", sm_result[1], ["text", "from"], ["string", "int"], 3)
  cl_save("markdown", "second_marker", ["text", "from"], ["string", "int"], 3, "expression", sm_result[1], sm_examples)

  # ---- inner_text ----
  let it_r1 = new("Dict", "md_itr1")
  send(it_r1, "set", "text", "**hello** world")
  send(it_r1, "set", "start", 2)
  send(it_r1, "set", "end", 7)
  let it_r2 = new("Dict", "md_itr2")
  send(it_r2, "set", "text", "abc **bold** def")
  send(it_r2, "set", "start", 6)
  send(it_r2, "set", "end", 10)
  let it_r3 = new("Dict", "md_itr3")
  send(it_r3, "set", "text", "x**y** longer tail here")
  send(it_r3, "set", "start", 3)
  send(it_r3, "set", "end", 4)
  let it_examples = [[it_r1, "hello"], [it_r2, "bold"], [it_r3, "y"]]
  let t2 = now_ms()
  let it_result = synthesize_from_examples(it_examples, ["text", "start", "end"], [], registry, ["substr", "add", "sub"], 10)
  print("inner_text: " + it_result[0] + " (" + (now_ms() - t2) + "ms)")
  check("inner_text derives the general formula", it_result[0], "OK")
  check("inner_text is the real substr/sub formula, not a shortcut", contains_text("" + it_result[1], "sub"), true)
  register_composite(registry, "inner_text", it_result[1], ["text", "start", "end"], ["string", "int", "int"], 4)
  cl_save("markdown", "inner_text", ["text", "start", "end"], ["string", "int", "int"], 4, "expression", it_result[1], it_examples)

  # ---- wrap_strong ----
  let ws1 = new("Dict", "md_ws1")
  send(ws1, "set", "inner", "hello")
  let ws2 = new("Dict", "md_ws2")
  send(ws2, "set", "inner", "bold")
  let ws_examples = [[ws1, "<strong>hello</strong>"], [ws2, "<strong>bold</strong>"]]
  let t3 = now_ms()
  let ws_result = synthesize_from_examples(ws_examples, ["inner"], ["<strong>", "</strong>"], registry, ["concat"], 8)
  print("wrap_strong: " + ws_result[0] + " (" + (now_ms() - t3) + "ms)")
  check("wrap_strong derives", ws_result[0], "OK")
  register_composite(registry, "wrap_strong", ws_result[1], ["inner"], ["string"], 3)
  cl_save("markdown", "wrap_strong", ["inner"], ["string"], 3, "expression", ws_result[1], ws_examples)

  # ---- strip_hash ----
  let sh1 = new("Dict", "md_sh1")
  send(sh1, "set", "line", "# Hello")
  let sh2 = new("Dict", "md_sh2")
  send(sh2, "set", "line", "# World")
  let sh_examples = [[sh1, "Hello"], [sh2, "World"]]
  let t4 = now_ms()
  let sh_result = synthesize_from_examples(sh_examples, ["line"], [2], registry, ["substr", "str_len", "sub"], 8)
  print("strip_hash: " + sh_result[0] + " (" + (now_ms() - t4) + "ms)")
  check("strip_hash derives", sh_result[0], "OK")
  register_composite(registry, "strip_hash", sh_result[1], ["line"], ["string"], 3)
  cl_save("markdown", "strip_hash", ["line"], ["string"], 3, "expression", sh_result[1], sh_examples)

  # ---- h1_line: composes strip_hash + concat, the working ATX-heading converter ----
  let h1a = new("Dict", "md_h1a")
  send(h1a, "set", "line", "# Hello")
  let h1b = new("Dict", "md_h1b")
  send(h1b, "set", "line", "# World")
  let h1_examples = [[h1a, "<h1>Hello</h1>"], [h1b, "<h1>World</h1>"]]
  let t5 = now_ms()
  # max_size is a real cumulative COST budget (issue #71's closing fix):
  # strip_hash (cost 3) + two concat calls (cost 1 each) + 3 leaves = 8.
  let h1_result = synthesize_from_examples(h1_examples, ["line"], ["<h1>", "</h1>"], registry, ["strip_hash", "concat"], 12)
  print("h1_line: " + h1_result[0] + " (" + (now_ms() - t5) + "ms)")
  check("h1_line derives by composing strip_hash + concat", h1_result[0], "OK")
  cl_save("markdown", "h1_line", ["line"], ["string"], 5, "expression", h1_result[1], h1_examples)

  print("markdown library populated: find_position, second_marker, inner_text, wrap_strong, strip_hash, h1_line")
  print("(one-shot 6-piece inline-bold composition NOT attempted here -- see run_synth_demo_markdown_scaling_wall_repro, opt-in only, it crashes the process by design)")

  t_report()
  return get("__vars", "t_fail") == 0
end

# ---- OPT-IN ONLY: reproduces the real, measured resource-exhaustion
# finding behind issue #69 ("composing more than three or four already-
# derived pieces in one search still scales poorly"). This is not a
# slow test -- it is a confirmed CRASH. Composing all six markdown
# pieces above (plus the raw reassembly primitives none of them alone
# provide -- substr/add/sub/str_len/concat, 9 candidates total per
# level) into one inline-bold transform in a single flat search
# exhausts memory and crashes the interpreter process, verified twice,
# live, with no artificial timeout imposed either time (a first attempt
# at reporting this used an arbitrary `timeout 300` cutoff and treated
# hitting it as confirmation -- that was wrong methodology, caught and
# redone properly: both runs below ran completely unbounded to their
# own real end):
#
#   default window (16): reached size 16 (pool 918,575) in ~41.5
#     minutes, then a genuine OOM crash attempting size 17
#     ("memory allocation of 2415919104 bytes failed").
#   window=8 (sbe_window_size_override): reached size 18
#     (pool 1,927,186) in ~65.6 minutes, then the SAME crash attempting
#     size 19 -- windowing did not help, and let it run LONGER before
#     failing on a LARGER pool, not shorter/smaller. Consistent with
#     the mechanism: eviction only prunes what's retained for FUTURE
#     argument lookups, it doesn't reduce how many combinations get
#     generated from whatever's currently retained at one level -- and
#     this explosion comes from breadth across 9 same-level candidates,
#     not from retained historical depth the way Design B's window was
#     built to address (see synthesis_by_example.patlang's own
#     sbe_window_size comment, and issue #73).
#
# Do not call this from CI or a routine test run. Call it directly and
# deliberately if this finding ever needs re-verifying against a future
# engine change. Self-contained (builds and re-derives its own small
# registry) so it never needs state threaded out of
# run_synth_demo_markdown -- just call it on its own.
make a function called run_synth_demo_markdown_scaling_wall_repro returns done
  let registry = pr_standard_registry()
  let fp1 = new("Dict", "rw_fp1")
  send(fp1, "set", "text", "**hello** world")
  send(fp1, "set", "marker", "**")
  let fp2 = new("Dict", "rw_fp2")
  send(fp2, "set", "text", "abc **bold** def")
  send(fp2, "set", "marker", "**")
  let fp_result = synthesize_from_examples([[fp1, 0], [fp2, 4]], ["text", "marker"], [], registry, ["find_substr"], 4)
  register_composite(registry, "find_position", fp_result[1], ["text", "marker"], ["string", "string"], 3)

  let sm1 = new("Dict", "rw_sm1")
  send(sm1, "set", "text", "**hello** world")
  send(sm1, "set", "from", 2)
  let sm2 = new("Dict", "rw_sm2")
  send(sm2, "set", "text", "abc **bold** def")
  send(sm2, "set", "from", 6)
  let sm_result = synthesize_from_examples([[sm1, 7], [sm2, 10]], ["text", "from"], ["**"], registry, ["index_of_from"], 6)
  register_composite(registry, "second_marker", sm_result[1], ["text", "from"], ["string", "int"], 3)

  let it1 = new("Dict", "rw_it1")
  send(it1, "set", "text", "**hello** world")
  send(it1, "set", "start", 2)
  send(it1, "set", "end", 7)
  let it2 = new("Dict", "rw_it2")
  send(it2, "set", "text", "abc **bold** def")
  send(it2, "set", "start", 6)
  send(it2, "set", "end", 10)
  let it3 = new("Dict", "rw_it3")
  send(it3, "set", "text", "x**y** longer tail here")
  send(it3, "set", "start", 3)
  send(it3, "set", "end", 4)
  let it_result = synthesize_from_examples([[it1, "hello"], [it2, "bold"], [it3, "y"]], ["text", "start", "end"], [], registry, ["substr", "add", "sub"], 10)
  register_composite(registry, "inner_text", it_result[1], ["text", "start", "end"], ["string", "int", "int"], 4)

  let ws1 = new("Dict", "rw_ws1")
  send(ws1, "set", "inner", "hello")
  let ws2 = new("Dict", "rw_ws2")
  send(ws2, "set", "inner", "bold")
  let ws_result = synthesize_from_examples([[ws1, "<strong>hello</strong>"], [ws2, "<strong>bold</strong>"]], ["inner"], ["<strong>", "</strong>"], registry, ["concat"], 8)
  register_composite(registry, "wrap_strong", ws_result[1], ["inner"], ["string"], 3)

  let ib1 = new("Dict", "md_ib1")
  send(ib1, "set", "text", "**hello** world")
  let ib2 = new("Dict", "md_ib2")
  send(ib2, "set", "text", "abc **bold** def")
  let inline_bold_examples = [[ib1, "<strong>hello</strong> world"], [ib2, "abc <strong>bold</strong> def"]]
  print("=== attempting the one-shot inline-bold composition (WILL exhaust memory and crash -- this is the point) ===")
  let t6 = now_ms()
  let ib_result = synthesize_from_examples(inline_bold_examples, ["text"], [], registry, ["find_position", "second_marker", "inner_text", "wrap_strong", "substr", "add", "sub", "str_len", "concat"], 30)
  let ib_elapsed = now_ms() - t6
  print("inline_bold (one-shot, 9 candidate primitives/composites per level): " + ib_result[0] + " (" + ib_elapsed + "ms)")
  return true
end

run_synth_demo_markdown()
