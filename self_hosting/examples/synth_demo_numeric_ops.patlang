# Broadens the derived-composite library into a third primitive domain:
# small numeric functions over self_hosting/lib/primitive_registry.
# patlang's add/sub/geq/eq_int wrappers.

include "../lib/composite_library.patlang"

make a function called run_synth_demo_numeric_ops returns ok
  let registry = pr_standard_registry()

  # increment(n) -> n + 1
  let i1 = new("Dict", "no_i1")
  send(i1, "set", "n", 5)
  let i2 = new("Dict", "no_i2")
  send(i2, "set", "n", 100)
  let increment_examples = [[i1, 6], [i2, 101]]
  let increment_ast = synthesize_from_examples(increment_examples, ["n"], [], registry, ["add"], 4)[1]
  print("increment: " + ("" + increment_ast))
  cl_save("numeric", "increment", ["n"], ["int"], 2, "expression", increment_ast, increment_examples)
  register_composite(registry, "increment", increment_ast, ["n"], ["int"], 2)

  # sum3(a, b, c) -> a + b + c
  #
  # BUG CAUGHT HERE (kept as a documented finding, not silently fixed
  # away): the first attempt at this example set used [1,2,3]->6 and
  # [10,20,30]->60 -- both accidentally satisfy a+b==c, so add(c,c) (=6
  # and =60 respectively) matched BOTH examples exactly and, being
  # smaller than the genuine a+b+c formula, is what the search actually
  # returned. Not a synthesizer bug: the examples themselves were
  # insufficiently discriminating, the same underlying pitfall as
  # after_space's single-example substr-clamp shortcut in
  # synth_demo_http_helpers.patlang, recurring in the numeric domain via
  # a different mechanism (an accidental algebraic coincidence instead of
  # a clamping quirk). Fixed by choosing a triple where a+b != c.
  let s1 = new("Dict", "no_s1")
  send(s1, "set", "a", 1)
  send(s1, "set", "b", 2)
  send(s1, "set", "c", 5)
  let s2 = new("Dict", "no_s2")
  send(s2, "set", "a", 10)
  send(s2, "set", "b", 1)
  send(s2, "set", "c", 1)
  let sum3_examples = [[s1, 8], [s2, 12]]
  let sum3_ast = synthesize_from_examples(sum3_examples, ["a", "b", "c"], [], registry, ["add"], 6)[1]
  print("sum3: " + ("" + sum3_ast))
  cl_save("numeric", "sum3", ["a", "b", "c"], ["int", "int", "int"], 3, "expression", sum3_ast, sum3_examples)

  # is_at_least_ten(n) -> n >= 10
  #
  # BUG CAUGHT HERE too: the first attempt used examples 15->true,
  # 3->false, 10->true, none of which land AT the boundary the search
  # doesn't already know about -- geq(n, 9) satisfies all three exactly as
  # well as the intended geq(n, 10) (nothing here distinguishes n=9 from
  # n=10), and being the same size, whichever the enumerator happened to
  # generate first won. Fixed by adding the actual boundary case (n=9 ->
  # false), which only the correct threshold satisfies.
  let g1 = new("Dict", "no_g1")
  send(g1, "set", "n", 15)
  let g2 = new("Dict", "no_g2")
  send(g2, "set", "n", 3)
  let g3 = new("Dict", "no_g3")
  send(g3, "set", "n", 10)
  let g4 = new("Dict", "no_g4")
  send(g4, "set", "n", 9)
  let is_at_least_ten_examples = [[g1, true], [g2, false], [g3, true], [g4, false]]
  let is_at_least_ten_ast = synthesize_from_examples(is_at_least_ten_examples, ["n"], [], registry, ["geq"], 4)[1]
  print("is_at_least_ten: " + ("" + is_at_least_ten_ast))
  cl_save("numeric", "is_at_least_ten", ["n"], ["int"], 2, "expression", is_at_least_ten_ast, is_at_least_ten_examples)

  print("library populated: numeric/{increment,sum3,is_at_least_ten}")
  return true
end

run_synth_demo_numeric_ops()
