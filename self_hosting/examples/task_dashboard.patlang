# Slice 4 of the signal-discovery/composition backlog item: a live
# "what's alive" dashboard, browser-viewable, backed by a native PatLang
# HTTP server -- same shape as examples/gui_server_demo.patlang (GET / ->
# HTML+JS page, GET /data -> live JSON), just rendering
# self_hosting/lib/signal_discovery.patlang's own signal_discover_all()
# instead of a computed fib table. Every task currently within
# DASHBOARD_MAX_AGE_MS of its beacon (self_hosting/lib/task_registry.patlang)
# shows up automatically; anything that stops re-announcing (a clean
# exit or a crash, this dashboard can't tell which) simply drops off the
# list once its beacon goes stale -- no separate "process died" detection
# needed, the same staleness rule Slices 0-3 already established.
#
# Same trust caveat as every other slice here: this shows what tasks
# CLAIM to be and offer, not a verified fact.
#
# Bounded to a fixed number of requests (matching gui_server_demo.patlang's
# own testable-demo convention) rather than serving forever -- a real,
# permanently-running dashboard would just replace the request counter
# below with `while true do serve_one(port) end`. Kept bounded here so
# this can be driven and verified the same way the rest of this slice's
# work was (see the Slice 4 section of the task-registry-beacon memory
# checkpoint for the live verification transcript).

include "../lib/html.patlang"
include "../lib/json.patlang"
include "../lib/signal_discovery.patlang"

make a function called dashboard_max_age_ms returns ms
  return 15000
end

make a function called dashboard_data_json returns out
  let tasks = signal_discover_all(dashboard_max_age_ms())
  let b = sb_new()
  sb_push(b, "[")
  let i = 0
  let n = to_num(list_len(tasks))
  while i < n do
    if i > 0 then
      sb_push(b, ",")
    end
    let entry = tasks[i]
    let task_name = entry[0]
    let port = entry[1]
    let actions = entry[2]
    sb_push(b, "{" + q() + "name" + q() + ":" + json_quote(task_name) + ",")
    sb_push(b, q() + "port" + q() + ":" + port + ",")
    sb_push(b, q() + "actions" + q() + ":[")
    let j = 0
    let an = to_num(list_len(actions))
    while j < an do
      if j > 0 then
        sb_push(b, ",")
      end
      let action = actions[j]
      sb_push(b, "{" + q() + "name" + q() + ":" + json_quote(action[0]) + "," + q() + "description" + q() + ":" + json_quote(action[1]) + "}")
      let j = j + 1
    end
    sb_push(b, "]}")
    let i = i + 1
  end
  sb_push(b, "]")
  return sb_str(b)
end

make a function called dashboard_page_script returns out
  let b = sb_new()
  sb_push(b, "async function load() {" + nl())
  sb_push(b, "  const r = await fetch('/data');" + nl())
  sb_push(b, "  const tasks = await r.json();" + nl())
  sb_push(b, "  const el = document.getElementById('tasks');" + nl())
  sb_push(b, "  if (tasks.length === 0) {" + nl())
  sb_push(b, "    el.innerHTML = '<p>No tasks currently announced.</p>';" + nl())
  sb_push(b, "    return;" + nl())
  sb_push(b, "  }" + nl())
  sb_push(b, "  el.innerHTML = tasks.map(t => {" + nl())
  sb_push(b, "    const actions = t.actions.map(a => `<li><strong>${a.name}</strong>: ${a.description}</li>`).join('');" + nl())
  sb_push(b, "    return `<div class='card'><h3>${t.name}</h3><p>port ${t.port}</p><ul>${actions}</ul></div>`;" + nl())
  sb_push(b, "  }).join('');" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "document.getElementById('go').addEventListener('click', load);" + nl())
  sb_push(b, "load();" + nl())
  return sb_str(b)
end

make a function called dashboard_page_body returns out
  let b = sb_new()
  sb_push(b, "<h1>PatLang task dashboard</h1>" + nl())
  sb_push(b, "<p>Live tasks, per their own self-reported presence beacons -- see them, not a guarantee they're honest.</p>" + nl())
  sb_push(b, "<button id='go'>Refresh</button>" + nl())
  sb_push(b, "<div id='tasks'></div>" + nl())
  return sb_str(b)
end

make a function called dsvr_contains takes hay, needle returns found
  let hn = hay.length
  let nn = needle.length
  let found = false
  let i = 0
  while (i <= hn - nn) and (not found) do
    if substr(hay, i, nn) == needle then
      let found = true
    end
    let i = i + 1
  end
  return found
end

# Same short-read fix as echo_server.patlang/gui_server_demo.patlang/
# event_loop_demo.patlang -- tcp_read is a single, possibly-partial read.
make a function called read_http_request takes conn returns text
  let text = tcp_read(conn)
  let looping = true
  while looping do
    if dsvr_contains(text, chr(13) + chr(10) + chr(13) + chr(10)) then
      let looping = false
    else
      let more = tcp_read(conn)
      if more == "" then
        let looping = false
      else
        let text = text + more
      end
    end
  end
  return text
end

make a function called request_path takes request returns path
  let b = sb_new()
  let i = 4
  let scanning = true
  while (i < request.length) and scanning do
    let c = char_code(request, i)
    if (c == 32) or (c == 13) or (c == 10) then
      let scanning = false
    else
      sb_push(b, request[i])
      let i = i + 1
    end
  end
  return sb_str(b)
end

make a function called serve_one takes port returns done
  let conn = tcp_accept(port)
  let request = read_http_request(conn)
  let path = request_path(request)
  if path == "/data" then
    tcp_write(conn, http_ok("application/json", dashboard_data_json()))
  else
    let page = html_page("PatLang task dashboard", dashboard_page_body(), dashboard_page_script())
    tcp_write(conn, http_ok("text/html", page))
  end
  tcp_close(conn)
  print("SERVED: " + path)
  return true
end

let port = tcp_listen(0)
print("PORT: " + port)
serve_one(port)
serve_one(port)
serve_one(port)
print("DONE")
