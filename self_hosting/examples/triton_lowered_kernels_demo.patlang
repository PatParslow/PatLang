# Slice 2 proof: PatLang SOURCE (not fixed hand-written Python) is
# lowered by lib/lower_triton.patlang into a real Triton kernel, run on
# the GPU via lib/triton.patlang's triton_run_kernel_source, and checked
# against a plain-PatLang computation -- same discipline as Slice 1's
# triton_vector_add_demo.patlang. Also exercises the rejection path: an
# unsupported kernel body must fail lowering with a clear message, not
# silently miscompile or crash.

include "F:/PatLang/self_hosting/lib/test.patlang"
include "F:/PatLang/self_hosting/lib/triton.patlang"

t_init()

# --- Scenario 1: elementwise add, lowered from real PatLang source -----
let add_src = "make a function called add_kernel takes x, y, out\n  store(out, offs, x[offs] + y[offs])\nend\n"
let a = [1, 2, 3, 4, 5, 6, 7, 8]
let b = [10, 20, 30, 40, 50, 60, 70, 80]
let dummy_out = [0, 0, 0, 0, 0, 0, 0, 0]
let lowered_result = triton_run_kernel_source(add_src, "add_kernel", [a, b, dummy_out])
check("lowered elementwise-add kernel lowers without error", lowered_result[1][0], "Ok")

let expected = []
let i = 0
while i < to_num(list_len(a)) do
  let expected = list_push(expected, to_num(a[i] + b[i]) + 0.0)
  let i = i + 1
end
check("lowered elementwise-add kernel matches plain PatLang computation", lowered_result[0], expected)

# --- Scenario 2: block reduction (sum), lowered from real PatLang source
let sum_src = "make a function called sum_kernel takes x, out\n  store(out, 0, sum(x[offs]))\nend\n"
let xs = [1, 2, 3, 4, 5, 6, 7, 8]
let dummy_sum_out = [0]
let sum_result = triton_run_kernel_source(sum_src, "sum_kernel", [xs, dummy_sum_out])
check("lowered reduction kernel lowers without error", sum_result[1][0], "Ok")

let total = 0.0
let j = 0
while j < to_num(list_len(xs)) do
  let total = total + to_num(xs[j])
  let j = j + 1
end
check("lowered reduction kernel matches plain PatLang sum", sum_result[0][0], total)

# --- Scenario 3: rejection path, no GPU run needed -----------------------
let bad_src = "make a function called bad_kernel takes x, out\n  print(x[offs])\nend\n"
let bad_lowered = triton_lower_kernel_source(bad_src, "bad_kernel")
check("kernel body with an unsupported call is rejected, not silently miscompiled", bad_lowered[1][0], "Err")

# --- Scenario 4: vector-conditioned if/elif is rejected at lowering time,
# not left to fail silently inside Triton's own compiler later (the exact
# class of bug the first version of the Mandelbrot demo shipped with --
# see lower_triton.patlang's triton_expr_is_vector header). A condition
# built from a raw buffer load is per-lane VECTOR-shaped; Triton only
# allows a scalar/constexpr condition in a Python if.
let bad_if_src = "make a function called bad_if_kernel takes x, out\n  let v = x[offs]\n  if v <= 4.0 then\n    store(out, offs, 1.0)\n  end\nend\n"
let bad_if_lowered = triton_lower_kernel_source(bad_if_src, "bad_if_kernel")
check("if/elif on a per-lane vector condition is rejected, not silently miscompiled", bad_if_lowered[1][0], "Err")

# A condition derived from a REDUCTION (sum/max/etc -- collapses a block
# to one true scalar) is genuinely safe and must still be accepted.
let ok_if_src = "make a function called ok_if_kernel takes x, out\n  let total = sum(x[offs])\n  if total <= 4.0 then\n    store(out, 0, 1.0)\n  end\nend\n"
let ok_if_lowered = triton_lower_kernel_source(ok_if_src, "ok_if_kernel")
check("if/elif on a scalar (reduction-derived) condition is still accepted", ok_if_lowered[1][0], "Ok")

t_report()
