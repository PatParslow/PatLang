# Slice 1 proof: PatLang drives a real Triton GPU kernel and gets back
# a correct result -- verified against a plain PatLang-computed sum,
# not just "it ran without erroring". See lib/triton.patlang's own
# header for the architecture (generate a Python/Triton driver script,
# exec_capture it, parse JSON back).

include "F:/PatLang/self_hosting/lib/test.patlang"
include "F:/PatLang/self_hosting/lib/triton.patlang"

t_init()

let a = [1, 2, 3, 4, 5, 6, 7, 8]
let b = [10, 20, 30, 40, 50, 60, 70, 80]

let gpu_result = triton_vector_add(a, b)

let expected = []
let i = 0
while i < to_num(list_len(a)) do
  let expected = list_push(expected, to_num(a[i] + b[i]) + 0.0)
  let i = i + 1
end

check("GPU-computed vector-add matches plain PatLang computation", gpu_result, expected)

# A non-power-of-2, non-trivial-size case too.
let a2 = [1, 2, 3, 4, 5, 6, 7]
let b2 = [100, 200, 300, 400, 500, 600, 700]
let gpu_result2 = triton_vector_add(a2, b2)
let expected2 = []
let i2 = 0
while i2 < to_num(list_len(a2)) do
  let expected2 = list_push(expected2, to_num(a2[i2] + b2[i2]) + 0.0)
  let i2 = i2 + 1
end
check("GPU-computed vector-add matches for a non-power-of-2 size", gpu_result2, expected2)

t_report()
