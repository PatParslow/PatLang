# Proves argv()/write_file/file_exists/read_file all work end to end
# via --x64 -- the primitives needed for patc2.exe (a self-compiled
# binary) to function as a CLI tool, not just complete a compile.
# Run with three args, e.g.:
#   ./patc1.exe self_hosting/examples/x64_argv_test.patlang out.exe --x64
#   ./out.exe foo.patlang out.exe --x64
# Expected: argc=3, the three args echoed, write_ok, exists_ok, then
# the written file's own contents echoed back.

let args = argv()
rt_print_str(rt_str_concat("argc=", rt_int_to_str(args.length)))
let i = 0
while i < args.length do
  rt_print_str(args[i])
  let i = i + 1
end

let wrote = write_file("F:/PatLang/self_hosting/build/argv_test_scratch.txt", "hello from write_file")
if wrote == 1 then
  rt_print_str("write_ok")
end
if file_exists("F:/PatLang/self_hosting/build/argv_test_scratch.txt") == "1" then
  rt_print_str("exists_ok")
end
let contents = read_file("F:/PatLang/self_hosting/build/argv_test_scratch.txt")
rt_print_str(contents)
