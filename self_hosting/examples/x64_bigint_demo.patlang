# Numeric tower, first working cut: ordinary `+` on values that
# happen to be BigInt-tagged -- no named-function workaround, no
# special syntax. codegen_x64.patlang classifies this whole file's
# top-level code ("main") as "dynamic mode" because it calls
# rt_bigint_from_i64 directly; x64_binop_asm_dynamic then resolves `+`
# at runtime based on each operand's own tag.
#
# Hand-computed expected output:
#   bigint + bigint:
#     123456789012345 + 987654321098765 = 1111111110111110
#   fixnum + fixnum that OVERFLOWS the 48-bit fixnum range
#   (~140737488355327), promoting to BigInt automatically:
#     100000000000000 + 100000000000000 = 200000000000000
#   bigint + fixnum (mixed, no overflow needed for the fixnum side):
#     123456789012345 + 100000000000000 = 223456789012345
#
# Expected output:
#   1111111110111110
#   200000000000000
#   223456789012345

let a = rt_bigint_from_i64(123456789012345)
let b = rt_bigint_from_i64(987654321098765)
let c = a + b
rt_print_str(rt_bigint_to_string(c))

let x = 100000000000000
let y = 100000000000000
let z = x + y
rt_print_str(rt_bigint_to_string(z))

let d = a + x
rt_print_str(rt_bigint_to_string(d))
