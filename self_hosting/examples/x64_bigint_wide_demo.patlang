# Proves the widened dynamic dispatch: `-`, `*`, and comparisons on
# values that might be BigInt, all via plain operators, no special
# syntax. codegen_x64.patlang classifies this file's "main" as
# dynamic-mode because it calls rt_bigint_from_i64.
#
# Hand-computed expected output:
#   bigint - bigint:
#     987654321098765 - 123456789012345 = 864197532086420
#   fixnum - fixnum, result goes NEGATIVE but stays within the 48-bit
#   fixnum range (no promotion needed):
#     5 - 100 = -95
#   fixnum * fixnum that OVERFLOWS the 48-bit range, promoting to
#   BigInt automatically:
#     20000000 * 20000000 = 400000000000000
#   bigint * bigint:
#     123456789012345 * 2 (as a bigint constant, to exercise the
#     bigint*bigint path directly) = 246913578024690
#   comparisons:
#     bigint(123456789012345) < bigint(987654321098765) -> true (1)
#     bigint(987654321098765) > bigint(123456789012345) -> true (1)
#     5 == 5 -> true (1, plain fixnum-fixnum fast path)
#
# Expected output:
#   864197532086420
#   -95
#   400000000000000
#   246913578024690
#   1
#   1
#   1

let a = rt_bigint_from_i64(987654321098765)
let b = rt_bigint_from_i64(123456789012345)
let c = a - b
rt_print_str(rt_bigint_to_string(c))

let p = 5
let q = 100
let r = p - q
rt_print_i64(rt_fixnum_unpack(r))

let m1 = 20000000
let m2 = 20000000
let m3 = m1 * m2
rt_print_str(rt_bigint_to_string(m3))

let t = rt_bigint_from_i64(123456789012345)
let two = rt_bigint_from_i64(2)
let doubled = t * two
rt_print_str(rt_bigint_to_string(doubled))

let lt = b < a
rt_print_i64(lt)

let gt = a > b
rt_print_i64(gt)

let eq = p == 5
rt_print_i64(eq)
