# Self-test for the new band/bor/bxor/shl/shr x64 codegen (needed by
# the numeric-tower tagging scheme's own tag-packing arithmetic).
# Hand-computed expected output:
#   12 band 10 = 8
#   12 bor 3   = 15
#   12 bxor 10 = 6
#   1 shl 60   = 1152921504606846976
#   (1 shl 60) shr 60 = 1
#
# GitHub #47: rewritten to use print() (universal across every backend)
# instead of rt_print_i64 (an x64-runtime-only PatLang function, never
# in scope for pat --ir-run/--patc) -- the original version could never
# actually pass its own interp-vs-x64 comparison harness, since an
# unresolved call to rt_print_i64 under those two backends silently
# no-ops rather than erroring, always producing empty interpreter
# output to compare against the x64 backend's real output.

let a = 12 band 10
print(a)

let b = 12 bor 3
print(b)

let c = 12 bxor 10
print(c)

let d = 1 shl 60
print(d)

let e = d shr 60
print(e)
