# Self-test for the new band/bor/bxor/shl/shr x64 codegen (needed by
# the numeric-tower tagging scheme's own tag-packing arithmetic).
# Hand-computed expected output:
#   12 band 10 = 8
#   12 bor 3   = 15
#   12 bxor 10 = 6
#   1 shl 60   = 1152921504606846976
#   (1 shl 60) shr 60 = 1

let a = 12 band 10
rt_print_i64(a)

let b = 12 bor 3
rt_print_i64(b)

let c = 12 bxor 10
rt_print_i64(c)

let d = 1 shl 60
rt_print_i64(d)

let e = d shr 60
rt_print_i64(e)
