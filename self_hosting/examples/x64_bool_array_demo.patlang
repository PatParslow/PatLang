# Proves the bool_array container (GitHub #45, Slice 1): a real
# bit-packed backing store (64 bools/word), growable past a single
# word's worth of bits, with its own small explicit API.
#
# Expected output:
#   0
#   false
#   false
#   true
#   3
#   65
#   0
#   true
#   true
#   true
#   <bool_array len=65>

let a = bool_array_new(0)
print(bool_array_len(a))

let b = bool_array_new(3)
print(bool_array_get(b, 0))
bool_array_set(b, 1, true)
print(bool_array_get(b, 0))
print(bool_array_get(b, 1))
print(bool_array_len(b))

let c = bool_array_new(0)
let i = 0
while i < 65 do
  let c = bool_array_push(c, i == 3)
  let i = i + 1
end
print(bool_array_len(c))
print(bool_array_len(a))
print(bool_array_get(c, 3))
bool_array_set(c, 64, true)
print(bool_array_get(c, 64))
print(bool_array_get(c, 0) != true)
print(c)
