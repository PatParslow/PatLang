# Slice 5 closure proof case. A closure literal capturing an enclosing
# local, called both directly and (crucially) through a variable via
# CallValue -- and a second, recursive-flavored case exercising the
# per-frame captured-count scratch slot under real re-entrancy: an
# outer function that itself calls a closure, whose own body ALSO
# calls a (different) closure before returning, proving the two
# CallValue call sites' bookkeeping don't clobber each other.
#
# Expected output: 15, 15, 100

let base = 10
let add_to_base = |x| { return base + x }
rt_print_i64(add_to_base(5))

let f = add_to_base
rt_print_i64(f(5))

make a function called outer takes n returns result
  let inner = |y| { return n * y }
  let mid = |z| { return inner(z) + 0 }
  return mid(10)
end
rt_print_i64(outer(10))
