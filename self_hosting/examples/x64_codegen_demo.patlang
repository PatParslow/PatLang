# x64_codegen_demo.patlang -- Slice 1 round-trip proof case for the new
# native x64 backend (self_hosting/lib/codegen_x64.patlang). Combined
# with lib/x64_runtime.patlang (see the driver script) and compiled
# straight to a standalone .exe, with NO rustc involved anywhere in the
# build. Deliberately restricted to Slice 1's supported subset: plain
# integer arithmetic, if/while, and calls to the PatLang-authored
# runtime's rt_print_i64 -- no lists, strings, BigInt, or closures.
#
# Verification: this exact program must also be run via the ordinary
# interpreter (`pat --ir-run`) and produce IDENTICAL output, proving
# the new backend is correct, not just "it assembled".

let total = 0
let i = 1
while i <= 10 do
  let total = total + i
  let i = i + 1
end
rt_print_i64(total)

let a = 7
let b = 3
rt_print_i64(a * b - a / b)

let n = 5
let fact = 1
let k = 1
while k <= n do
  let fact = fact * k
  let k = k + 1
end
rt_print_i64(fact)

if total > 50 then
  rt_print_i64(1)
else
  rt_print_i64(0)
end

rt_print_i64(0 - 42)
