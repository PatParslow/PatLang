# Interpreter-run baseline for x64_codegen_demo.patlang -- IDENTICAL
# logic, using the real interpreter's print() instead of rt_print_i64
# (which only exists once compiled through codegen_x64.patlang's own
# primitive set -- mem_poke_byte etc. aren't real host functions under
# --ir-run). This is the "known correct" output the native x64 build
# must match exactly.

let total = 0
let i = 1
while i <= 10 do
  let total = total + i
  let i = i + 1
end
print(total)

# NOTE: the x64 backend's "/" is truncating integer division (a plain
# x64 `idiv`), unlike the interpreter's own "/" on two Ints (which
# produces an exact Rational, e.g. 7/3 stays 7/3). floor() here makes
# this baseline match Slice 1's actual, deliberately simpler semantics
# -- for positive operands floor(a/b) and truncating division agree.
let a = 7
let b = 3
print(a * b - to_num(floor(a / b)))

let n = 5
let fact = 1
let k = 1
while k <= n do
  let fact = fact * k
  let k = k + 1
end
print(fact)

if total > 50 then
  print(1)
else
  print(0)
end

print(0 - 42)
