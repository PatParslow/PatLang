# Proves Complex, covering the deliberately-supported operator set
# (+/-/*/==/!=) via plain source syntax. Complex is represented as a
# heap block of two ALREADY-TAGGED numeric components, so its own
# arithmetic (rt_complex_add/_sub/_mul) is ordinary PatLang using `+`/
# `-`/`*` on those components -- reusing the same dynamic dispatch
# BigInt/Rational already proved, no new arithmetic primitives.
#
# Hand-computed expected output:
#   (3+4i) + (1+2i) = 4+6i
#   (3+4i) - (1+2i) = 2+2i
#   (3+4i) * (1+2i) = (3*1-4*2) + (3*2+4*1)i = -5+10i
#   (3+4i) == (3+4i) -> true (1) -- constructed twice, must compare
#   by VALUE not by heap address
#   (3+4i) == (1+2i) -> false (0)
#   (3+4i) != (1+2i) -> true (1)
#   a Complex mixing a BigInt real part with a plain-int imaginary
#   part, added to a plain real fixnum (promoted to Complex(re=5,
#   im=0)): (123456789012345+2i) + 5 = 123456789012350+2i -- proves
#   the promote-to-complex path handles a lower-tier operand cleanly
#
# Expected output:
#   4+6i
#   2+2i
#   -5+10i
#   1
#   0
#   1
#   123456789012350+2i

let c1 = rt_complex_new(3, 4)
let c2 = rt_complex_new(1, 2)

let s = c1 + c2
rt_print_str(rt_complex_to_string(s))

let d = c1 - c2
rt_print_str(rt_complex_to_string(d))

let p = c1 * c2
rt_print_str(rt_complex_to_string(p))

let c1_again = rt_complex_new(3, 4)
let eq1 = c1 == c1_again
rt_print_i64(eq1)

let eq2 = c1 == c2
rt_print_i64(eq2)

let ne = c1 != c2
rt_print_i64(ne)

let big_re = rt_bigint_from_i64(123456789012345)
let mixed = rt_complex_new(big_re, 2)
let five = 5
let result = mixed + five
rt_print_str(rt_complex_to_string(result))
