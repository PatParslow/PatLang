# Proves exec_capture for the ACTUAL real-world use it exists for:
# invoking nasm, matching x64_build.patlang's own real invocation
# shape. Assembles a trivial valid .asm file and checks nasm produced
# the expected output file.
let asm_src = "global main\nsection .text\nmain:\n  ret\n"
let ok = rt_write_file("self_hosting/build/x64_exec_nasm_test.asm", asm_src)
rt_print_i64(ok)
let out = exec_capture("C:\\Program Files\\NASM\\nasm.exe", "-f", "win64", "-o", "self_hosting/build/x64_exec_nasm_test.obj", "self_hosting/build/x64_exec_nasm_test.asm")
let len = rt_str_len(out)
rt_print_i64(rt_fixnum_unpack(len))
let exists = rt_file_exists("self_hosting/build/x64_exec_nasm_test.obj")
rt_print_str(exists)
