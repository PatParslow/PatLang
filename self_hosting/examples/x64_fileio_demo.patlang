# Proves file I/O (step 2 of 3 toward self-hosting via --x64):
# rt_write_file, rt_read_file, rt_file_exists, and a check against a
# genuinely nonexistent path. Writes to a scratch path under
# self_hosting/build/ (mirroring where every other demo's own output
# already lands).
#
# Hand-computed expected output:
#   write succeeds -> 1
#   file exists after writing -> "1"
#   reading it back gives exactly what was written
#   a path that was never created does not exist -> "0"
#
# Expected output:
#   1
#   1
#   Hello from the x64 backend's own file I/O!
#   0

let path = "self_hosting/build/x64_fileio_scratch.txt"
let content = "Hello from the x64 backend's own file I/O!"
let ok = rt_write_file(path, content)
rt_print_i64(ok)

let exists = rt_file_exists(path)
rt_print_str(exists)

let readback = rt_read_file(path)
rt_print_str(readback)

let missing = rt_file_exists("self_hosting/build/x64_fileio_definitely_not_here.txt")
rt_print_str(missing)
