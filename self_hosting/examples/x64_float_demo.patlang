# Slice 7 numeric-tower (floats) proof case. Whole-program float mode
# (triggered by the presence of any "." literal below) applies to
# every Bin instruction in this file, so this demo is deliberately
# PURE float arithmetic -- no int loop counters or other int Bin usage
# that float-mode would silently reinterpret as float bits.
#
# Hand-computed expected output. Arithmetic results are truncated
# toward zero via f64_to_i64_trunc, then printed with the existing int
# printer; comparison results are ALREADY plain 0/1 ints (setcc, not a
# float bit pattern), so those print directly with no conversion:
#   a = 3.5 + 2.25 = 5.75            -> trunc -> 5
#   b = 10.0 - 4.5 = 5.5             -> trunc -> 5
#   c = 2.5 * 4.0 = 10.0             -> trunc -> 10
#   d = 9.0 / 2.0 = 4.5              -> trunc -> 4
#   e = (3.5 < 4.5)                  -> true  -> 1
#   f = (3.5 > 4.5)                  -> false -> 0
#
# Expected output: 5, 5, 10, 4, 1, 0

let a = 3.5 + 2.25
rt_print_i64(f64_to_i64_trunc(a))

let b = 10.0 - 4.5
rt_print_i64(f64_to_i64_trunc(b))

let c = 2.5 * 4.0
rt_print_i64(f64_to_i64_trunc(c))

let d = 9.0 / 2.0
rt_print_i64(f64_to_i64_trunc(d))

let e = 3.5 < 4.5
rt_print_i64(e)

let f = 3.5 > 4.5
rt_print_i64(f)
