# Proves growable lists (list_push), the first of the three primitives
# needed toward eventual self-hosting via --x64 (lexer/parser/lower
# use list_push 27 times combined). Matches the interpreter's own
# list_push semantics exactly: functional (returns a NEW list), not
# in-place.
#
# Hand-computed expected output:
#   starting empty, pushing 1,2,3 -> length 3, elements 1,2,3
#   the ORIGINAL (pre-push) list is still length 0 -- proves list_push
#   is functional, not a mutation of the original reference
#   pushing a mix of value kinds (fixnum, BigInt, string) onto one
#   list, read back correctly
#
# Expected output:
#   3
#   1
#   2
#   3
#   0
#   7
#   999999999999
#   hi

let empty = []
let l1 = list_push(empty, 1)
let l2 = list_push(l1, 2)
let l3 = list_push(l2, 3)
rt_print_i64(rt_fixnum_unpack(list_len(l3)))
rt_print_i64(rt_fixnum_unpack(l3[0]))
rt_print_i64(rt_fixnum_unpack(l3[1]))
rt_print_i64(rt_fixnum_unpack(l3[2]))
rt_print_i64(rt_fixnum_unpack(list_len(empty)))

let mixed = list_push(list_push(list_push([], 7), rt_bigint_from_i64(999999999999)), "hi")
rt_print_i64(rt_fixnum_unpack(mixed[0]))
rt_print_str(rt_bigint_to_string(mixed[1]))
rt_print_str(mixed[2])
