# Slice 2 heap proof case. Allocates three blocks of different sizes
# via rt_heap_alloc (a real PatLang bump allocator, see lib/x64_runtime
# .patlang), checks the returned addresses are correctly spaced by the
# 8-byte-aligned block sizes, and round-trips an 8-byte value through
# mem_poke_qword/mem_peek_qword. Everything printed here is a value
# computable by hand ahead of time, so the expected output is a fixed,
# known sequence -- not "did it crash", a real correctness check.
#
# Expected output: 16, 8, 987654321, 1

let block_a = rt_heap_alloc(10)
let block_b = rt_heap_alloc(3)
let block_c = rt_heap_alloc(8)

rt_print_i64(block_b - block_a)
rt_print_i64(block_c - block_b)

mem_poke_qword(block_a, 0, 987654321)
rt_print_i64(mem_peek_qword(block_a, 0))

let block_d = rt_heap_alloc(1)
if block_d - block_c == 8 then
  rt_print_i64(1)
else
  rt_print_i64(0)
end
