# Proves Interval, mirroring x64_complex_demo.patlang's structure
# closely -- same composite-of-two-tagged-values shape, same reused
# dynamic dispatch, only the arithmetic rules differ.
#
# Hand-computed expected output:
#   [1,2] + [3,4] = [4,6]
#   [1,5] - [2,3] = [1-3, 5-2] = [-2,3]  (interval subtraction rule,
#   not naive component-wise)
#   [2,3] * [4,5] = min/max of {8,10,12,15} = [8,15]
#   [-2,3] * [4,5] = min/max of {-8,-10,12,15} = [-10,15]  (proves the
#   general min/max-of-four-products rule, not just the "both
#   positive" shortcut)
#   [1,2] == [1,2] (constructed twice) -> true (1)
#   [1,2] == [3,4] -> false (0)
#   a mixed case: [1,2] + 5 (plain fixnum promoted to degenerate
#   interval [5,5]) = [6,7]
#
# Expected output:
#   [4,6]
#   [-2,3]
#   [8,15]
#   [-10,15]
#   1
#   0
#   [6,7]

let a = rt_interval_new(1, 2)
let b = rt_interval_new(3, 4)
let s = a + b
rt_print_str(rt_interval_to_string(s))

let c = rt_interval_new(1, 5)
let d = rt_interval_new(2, 3)
let diff = c - d
rt_print_str(rt_interval_to_string(diff))

let e = rt_interval_new(2, 3)
let f = rt_interval_new(4, 5)
let p1 = e * f
rt_print_str(rt_interval_to_string(p1))

let g = rt_interval_new(0 - 2, 3)
let h = rt_interval_new(4, 5)
let p2 = g * h
rt_print_str(rt_interval_to_string(p2))

let a_again = rt_interval_new(1, 2)
let eq1 = a == a_again
rt_print_i64(eq1)

let eq2 = a == b
rt_print_i64(eq2)

let five = 5
let mixed = a + five
rt_print_str(rt_interval_to_string(mixed))
