# Slice 4 list proof case. Uses PatLang's OWN native list-literal
# syntax and `l[i]`/`list_len(l)` -- not just the explicitly-named
# rt_list_* functions -- to prove BuildList and the list_get/list_len
# aliases both work, plus an explicit rt_list_new/rt_list_set mutable
# list, plus a list holding STRINGS (proving values are genuinely
# uniform: ints and string addresses both just live as qwords).
#
# Expected output:
#   150
#   6
#   foobar

let nums = [10, 20, 30, 40, 50]
let sum = 0
let i = 0
while i < list_len(nums) do
  let sum = sum + nums[i]
  let i = i + 1
end
rt_print_i64(sum)

let mutable_list = rt_list_new(3)
rt_list_set(mutable_list, 0, 1)
rt_list_set(mutable_list, 1, 2)
rt_list_set(mutable_list, 2, 3)
let msum = 0
let j = 0
while j < rt_list_len(mutable_list) do
  let msum = msum + rt_list_get(mutable_list, j)
  let j = j + 1
end
rt_print_i64(msum)

let strs = ["foo", "bar"]
rt_print_str(rt_str_concat(strs[0], strs[1]))
