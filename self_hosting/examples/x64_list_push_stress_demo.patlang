# Stress test proving the O(1)-amortized fix for list_push -- pushes
# 20000 items one at a time (exactly the accumulation pattern
# lexer.patlang uses building its token list). Under the ORIGINAL
# O(n) per-push bug this would take an astronomically long time
# (O(n^2) = 400 million element-copies); under the fix it should
# complete near-instantly.
make a function called stress takes n returns result
  let l = []
  let i = 0
  while i < n do
    let l = list_push(l, i)
    let i = i + 1
  end
  return list_len(l)
end
rt_print_i64(rt_fixnum_unpack(stress(20000)))
