# GitHub #109 regression check: sqrt/sin/cos/etc (anything routed
# through x64_math1_asm/x64_math2_asm's CallHost dispatch) used to
# print as a garbage integer under a real --x64 compile+run, because
# the boxed-float value print() receives for a dynamically-dispatched
# argument had no "float" case at all in print()'s own type_of()
# dispatch (self_hosting/lib/x64_runtime.patlang) -- it fell through to
# the plain-int default, printing the boxed pointer's raw bits.
print(sqrt(9.0))
print(sqrt(2.0))
print(sin(0.0))
print(cos(0.0))
print(pow(2.0, 10.0))
print(floor(2.9) + sqrt(4.0))
