# Proves Object: a first-class heap value [type id][field count]
# [tagged field values...], fields by index, in-place mutation, and
# identity (not value) equality -- deliberately NOT the existing
# interpreter/rustc backend's string-keyed oo system (see
# x64_runtime.patlang's own Object header for the full reasoning).
#
# Hand-computed expected output:
#   a 2-field object (type_id=1) holding a fixnum and a BigInt real,
#   read back correctly:
#     field 0 = 42
#     field 1 = 999999999999999 (a genuine BigInt, proving a tower
#     value can live inside an object field)
#   mutation is visible through the SAME reference (in-place, not
#   copy-on-write):
#     field 0 after set = 100
#   identity equality: the same object compared to itself is equal;
#   a SEPARATELY-CONSTRUCTED object with IDENTICAL field values is
#   NOT equal (proves this is reference identity, not deep value
#   comparison -- the deliberate design choice):
#     obj == obj -> true (1)
#     obj == other_with_same_fields -> false (0)
#   type_id and field_count read back correctly:
#     type_id = 1
#     field_count = 2
#
# Expected output:
#   42
#   999999999999999
#   100
#   1
#   0
#   1
#   2

let obj = rt_object_new(1, 2)
rt_object_set(obj, 0, 42)
let big = rt_bigint_from_i64(999999999999999)
rt_object_set(obj, 1, big)

rt_print_i64(rt_fixnum_unpack(rt_object_get(obj, 0)))
rt_print_str(rt_bigint_to_string(rt_object_get(obj, 1)))

rt_object_set(obj, 0, 100)
rt_print_i64(rt_fixnum_unpack(rt_object_get(obj, 0)))

let same = obj == obj
rt_print_i64(same)

let other = rt_object_new(1, 2)
rt_object_set(other, 0, 100)
rt_object_set(other, 1, big)
let diff = obj == other
rt_print_i64(diff)

rt_print_i64(rt_object_type(obj))
rt_print_i64(rt_object_field_count(obj))
