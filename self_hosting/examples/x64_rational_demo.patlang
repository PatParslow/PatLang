# Proves Rational, covering division from the start (per the user's
# explicit instruction). Plain `/` on values that might not divide
# evenly produces a Rational automatically -- no special syntax.
#
# Hand-computed expected output:
#   7 / 2 (inexact fixnum/fixnum) -> Rational 7/2
#   1/2 + 1/2 (rational + rational) -> reduces to 1 (den==1 prints
#   as a plain int, no "/1" suffix)
#   2/4 (constructed directly, unreduced input) -> reduces to 1/2
#   (proves gcd reduction happens on construction, not just result)
#   (1/2) * (2/3) -> 1/3
#   10 / 5 (EXACT fixnum/fixnum division) -> stays a plain fixnum,
#   printed via rt_fixnum_unpack + rt_print_i64, not rt_rational_to_string
#   1/2 < 2/3 -> true (1)
#   3/4 > 1/2 -> true (1)
#
# Expected output:
#   7/2
#   1
#   1/2
#   1/3
#   2
#   1
#   1

let a = 7
let b = 2
let r1 = a / b
rt_print_str(rt_rational_to_string(r1))

let half1 = rt_rational_new(1, 2)
let half2 = rt_rational_new(1, 2)
let r2 = half1 + half2
rt_print_str(rt_rational_to_string(r2))

let unreduced = rt_rational_new(2, 4)
rt_print_str(rt_rational_to_string(unreduced))

let two_thirds = rt_rational_new(2, 3)
let r3 = unreduced * two_thirds
rt_print_str(rt_rational_to_string(r3))

let exact = 10 / 5
rt_print_i64(rt_fixnum_unpack(exact))

let lt = unreduced < two_thirds
rt_print_i64(lt)

let three_q = rt_rational_new(3, 4)
let gt = three_q > unreduced
rt_print_i64(gt)
