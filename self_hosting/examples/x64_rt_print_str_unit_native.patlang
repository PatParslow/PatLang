# GitHub #63 item 2: printing gives unit, not `true`, whatever it prints.
# The old x64 backend's rt_print_str returned a Bool placeholder; v2 has no
# separate printing primitives to call, so this checks print() itself, on a
# string, a bool and a float.
let r1 = print("a")
print(type_of(r1))
let r2 = print(true)
print(type_of(r2))
let r3 = print(3.0)
print(type_of(r3))
