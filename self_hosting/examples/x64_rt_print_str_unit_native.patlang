# GitHub #63 item 2: rt_print_str used to return `true` (a Bool
# placeholder predating Unit having its own family tag), so
# type_of(rt_print_str(...)) reported "bool" on the x64 backend,
# unlike the native interpreter's own print primitive. print() itself
# already worked around this for ITS OWN return value via a separate
# `if false` trick, so this was invisible for ordinary print(x) calls
# -- but rt_print_str/rt_print_bool/rt_print_float are real, directly
# callable API surface in their own right (x64_runtime.patlang, always
# linked in), so this checks them directly, not through print().
let r1 = rt_print_str("a")
print(type_of(r1))
let r2 = rt_print_bool(true)
print(type_of(r2))
let r3 = rt_print_float(4613937818241073152)
print(type_of(r3))
