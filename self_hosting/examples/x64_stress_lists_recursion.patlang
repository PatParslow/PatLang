# Stress test combining lists, recursion, and closures via the x64
# backend -- a shape not covered by the low-level ALU/shift fixtures
# in self_hosting/tests/x64_asm/.

let ok = true

make a function called fib takes n returns result
  if n < 2 then
    return n
  else
    return fib(n - 1) + fib(n - 2)
  end
end

if fib(20) != 6765 then
  print("FAIL: recursive fib(20)")
  let ok = false
end

let xs = []
let i = 0
while i < 200 do
  let xs = list_push(xs, i * i)
  let i = i + 1
end
if xs.length != 200 then
  print("FAIL: list_push 200 elements")
  let ok = false
end
if xs[199] != 199 * 199 then
  print("FAIL: list indexing after 200 pushes")
  let ok = false
end

make a function called make_adder takes n returns adder_fn
  let adder = |x| { return x + n }
  return adder
end

let add5 = make_adder(5)
if add5(10) != 15 then
  print("FAIL: closure captured value")
  let ok = false
end

let total = 0
let j = 0
while j < xs.length do
  let total = total + xs[j]
  let j = j + 1
end
if total != 2646700 then
  print("FAIL: list-accumulate sum")
  let ok = false
end

if ok then
  print("ALL PASS")
  os_exit(0)
else
  os_exit(1)
end
