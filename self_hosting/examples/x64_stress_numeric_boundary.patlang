# Stress test for numeric-tower boundary behavior via the x64 backend:
# the 48-bit fixnum/BigInt-promotion boundary (2^47), negative values
# crossing that boundary, and a loop-computed accumulator (not just a
# literal) crossing it -- the exact shape of code (v = v*10 + d) that
# session 8's xa_parse_int fix depends on working correctly.
#
# Calls rt_bigint_from_i64 up front purely to get this file classified
# "dynamic mode" by codegen_x64.patlang's taint analysis (see
# self_hosting/examples/x64_bigint_demo.patlang's own header comment
# for the same pattern) -- without that, plain fixnum+fixnum arithmetic
# that overflows 48 bits does NOT get BigInt-promoted at all and
# silently wraps/corrupts instead (a separate, deliberate, documented
# scope limit of the current numeric tower, not a bug -- see
# x64_runtime.patlang's own "DELIBERATE SCOPE LIMITS" comment above
# rt_tag_mask/rt_payload_mask, ~line 1792).
let discard = rt_bigint_from_i64(1)

# Two result buckets, reported separately and BOTH printed every run:
#   ok_core      -- must pass; a regression here blocks the native
#                   toolchain being a safe default.
#   ok_known_gap -- operators NOT yet wired for BigInt-aware dynamic
#                   dispatch (only `+` is, per the DELIBERATE SCOPE
#                   LIMITS comment above). Expected to currently FAIL;
#                   kept here (not deleted) so this test keeps covering
#                   them and turns green the moment they're wired up.
let ok_core = true
let ok_known_gap = true

let fixnum_max = 140737488355327
if fixnum_max + 1 != 140737488355328 then
  print("FAIL (core): fixnum boundary +1 arithmetic")
  let ok_core = false
end

let big = 6917529027641081857

# `-` on a BigInt-tagged value: NOT wired for dynamic dispatch today.
if big - 1 != 6917529027641081856 then
  print("FAIL (known gap, `-` not yet dynamic-dispatch-wired): large literal subtraction")
  let ok_known_gap = false
end

# `band` on a BigInt-tagged value: NOT wired for dynamic dispatch today.
if big band 255 != 1 then
  print("FAIL (known gap, `band` not yet dynamic-dispatch-wired): large literal band 255")
  let ok_known_gap = false
end

let neg_big = 0 - 6917529027641081857
if neg_big + 6917529027641081857 != 0 then
  print("FAIL (core): negative large-literal arithmetic")
  let ok_core = false
end

# Loop-computed accumulator crossing the fixnum/BigInt boundary --
# same shape as xa_parse_int's own digit-accumulation loop, and the
# exact `v = v*10 + d` pattern the earlier session-8 imul-immediate bug
# fix (xa_enc_imul_imm) needs to keep computing correctly.
let v = 0
let i = 0
while i < 19 do
  let v = v * 10 + 5
  let i = i + 1
end
if v != 5555555555555555555 then
  print("FAIL (core): loop-accumulated BigInt crossing")
  let ok_core = false
end

let neg = -11
if neg != 0 - 11 then
  print("FAIL (core): negative literal equality")
  let ok_core = false
end

# Rational (from exact `/`): tower family reserved but not implemented
# per the DELIBERATE SCOPE LIMITS comment. Kept here rather than
# deleted, same reasoning as `-`/`band` above.
if 4 / 8 != 1 / 2 then
  print("FAIL (known gap, Rational not yet implemented): exact rational division")
  let ok_known_gap = false
end

if ok_known_gap then
  print("(known-gap operators all pass too -- update this test's comments, they're wired now)")
end

if ok_core then
  print("ALL CORE PASS")
  os_exit(0)
else
  os_exit(1)
end
