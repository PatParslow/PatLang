# Stress test for string equality/comparison edge cases via the x64
# backend -- deliberately exercises the exact failure class found in
# session 8 (string-equality-against-a-literal silently false), plus
# neighboring edge cases: empty strings, single chars, strings that
# look numeric, and strings differing only in the last byte.

let ok = true

if "" != "" then
  print("FAIL: empty string self-equality")
  let ok = false
end

if "a" == "b" then
  print("FAIL: single-char strings wrongly equal")
  let ok = false
end

if "abc" != "abc" then
  print("FAIL: multi-char string self-equality")
  let ok = false
end

if "abcd" == "abce" then
  print("FAIL: strings differing only in last byte wrongly equal")
  let ok = false
end

if "6917529027641081857" != "6917529027641081857" then
  print("FAIL: numeric-looking string self-equality")
  let ok = false
end

if "6917529027641081857" == "6917529027641081856" then
  print("FAIL: adjacent large numeric strings wrongly equal")
  let ok = false
end

let s = "hello" + " " + "world"
if s != "hello world" then
  print("FAIL: concatenated string equality")
  let ok = false
end

if type_of("x") != "string" then
  print("FAIL: type_of(string literal) != \"string\"")
  let ok = false
end

if type_of(5) == "string" then
  print("FAIL: type_of(int) wrongly == \"string\"")
  let ok = false
end

let n = 5
print("value is " + n)

if ok then
  print("ALL PASS")
  os_exit(0)
else
  os_exit(1)
end
