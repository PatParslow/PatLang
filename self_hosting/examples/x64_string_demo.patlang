# Slice 3 string proof case. Two string literals, concatenated, and
# printed -- plus the concatenated result's length, which must equal
# the sum of the two literals' own lengths.
#
# Expected output:
#   Hello, world!
#   13

let a = "Hello, "
let b = "world!"
let c = rt_str_concat(a, b)
rt_print_str(c)
rt_print_i64(rt_str_len(c))
