# Proves the strings/lists/closures TAGGING migration specifically:
# identity equality for strings/lists/closures now works correctly
# even inside a "dynamic mode" function (one that also touches
# BigInt elsewhere) -- the exact scenario the second family-check bug
# was about -- plus a heterogeneous list holding a fixnum, a BigInt,
# a string, and a closure all at once, read back correctly.
#
# Hand-computed expected output:
#   two SEPARATELY-BUILT strings with the same content are NOT equal
#   (identity, not value, matching the existing pre-tagging semantics
#   -- unchanged behavior, now just correctly enforced by the tag
#   scheme rather than by the absence of one):
#     "abc" == "abc" (as two separate literal Const sites) -> false (0)
#   the SAME string reference compared to itself IS equal:
#     s == s -> true (1)
#   a heterogeneous list: [fixnum, BigInt, string, closure], read back
#   and used correctly:
#     list[0] unpacked = 7
#     list[1] as bigint string = 300000000000000
#     list[2] as string = "hi"
#     list[3] called as closure = 42
#
# Expected output:
#   0
#   1
#   7
#   300000000000000
#   hi
#   42

let big = rt_bigint_from_i64(300000000000000)
let a = "abc"
let b = "abc"
let eq1 = a == b
rt_print_i64(eq1)

let s = "xyz"
let eq2 = s == s
rt_print_i64(eq2)

let fn_val = |x| { return x + 42 }
let items = [7, big, "hi", fn_val]

rt_print_i64(rt_fixnum_unpack(items[0]))
rt_print_str(rt_bigint_to_string(items[1]))
rt_print_str(items[2])
let closure_from_list = items[3]
let closure_result = closure_from_list(0)
rt_print_i64(closure_result)
