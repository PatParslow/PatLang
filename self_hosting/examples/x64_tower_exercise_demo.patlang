# Full-tower exercise: combinations not covered by any single-level
# demo so far -- BigInt endpoints inside an Interval, a Rational real
# part inside a Complex, and a long fixnum->BigInt promotion chain
# feeding into both. Deliberately does NOT mix Complex and Interval
# with each other (comparing/combining two different KINDS of
# composite value has no obvious meaning and isn't supported --
# rt_interval_from_num/rt_complex_from_num would wrap the other
# composite's tagged word as-is rather than doing anything sensible
# with it -- a real, accepted gap, not attempted here).
#
# Hand-computed expected output:
#   1) A fixnum doubled 6 times (1 -> 64) via `*`, then multiplied by
#      a value chosen so the PRODUCT overflows the 48-bit fixnum
#      range, forcing genuine promotion mid-expression:
#      64 * 5000000000000 = 320000000000000 (exceeds the ~140.7
#      trillion fixnum ceiling) -> BigInt
#   2) Two reduced-on-construction rationals summing to a whole
#      number: 1/3 + 1/6 + 1/2 = 1 (three-way chain, not just pairwise)
#   3) A Complex number whose REAL PART IS ITSELF A RATIONAL (never
#      tested before): (1/2 + 1i) -- proves rt_num_to_string correctly
#      formats a Rational component inside a Complex
#   4) An Interval whose ENDPOINTS ARE BOTH BIGINT (never tested
#      before): [10^17, 2*10^17] + [1,1] -- proves rt_interval_add's
#      own `+` on components correctly dispatches BigInt+BigInt
#      internally (not just BigInt+fixnum like the wide bigint demo)
#
# Expected output:
#   320000000000000
#   1
#   1/2+1i
#   [100000000000000001,200000000000000001]

let x = 1
let x = x * 2
let x = x * 2
let x = x * 2
let x = x * 2
let x = x * 2
let x = x * 2
let big_factor = 5000000000000
let overflowed = x * big_factor
rt_print_str(rt_bigint_to_string(overflowed))

let a = rt_rational_new(1, 3)
let b = rt_rational_new(1, 6)
let c = rt_rational_new(1, 2)
let total = a + b + c
rt_print_str(rt_rational_to_string(total))

let half = rt_rational_new(1, 2)
let cplx = rt_complex_new(half, 1)
rt_print_str(rt_complex_to_string(cplx))

let lo = rt_bigint_from_i64(100000000000000)
let lo = lo * 1000
let hi = lo * 2
let iv = rt_interval_new(lo, hi)
let one_pair = rt_interval_new(1, 1)
let iv2 = iv + one_pair
rt_print_str(rt_interval_to_string(iv2))
