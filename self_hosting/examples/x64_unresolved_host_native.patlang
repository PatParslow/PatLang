# Calls a host that does not exist: first in code that never runs, then for
# real. The interpreter stops with "host fn 'no_such_host' not found"; a
# native x64 program must stop at the same call with the same message, not carry
# on with a placeholder 0 (GitHub #114).
print("before")
if 1 == 2 then
  no_such_host(1)
end
print("dead branch skipped")
no_such_host(2)
print("never printed")
