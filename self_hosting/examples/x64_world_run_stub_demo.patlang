# Native x64 has no clean-interpreter run: host_caps says so, and world_run
# answers with a checkable ok=false instead of crashing.
let caps = host_caps()
print(caps[0])
let has_swap = false
let i = 0
while i < list_len(caps) do
  if caps[i] == "world_swap" then let has_swap = true end
  let i = i + 1
end
print(has_swap)
let r = world_run([], [])
print(r[2])
print(r[1])
