# This is what zi_infer_skeleton_auto (self_hosting/lib/zs_infer.patlang)
# produces from priced_vending_machine.feature alone -- no hand-written
# schema was read to make it, and no state variable names were supplied by
# hand either. The feature names its own state ("vending machine
# inventory", "Bowen's balance") through a small, closed table of
# quantity/arithmetic phrasings ("contains at least", "'s balance is
# decreased by"), so both the state variables themselves and their real
# require/ensure clauses are inferred, not left as placeholders. Only the
# `init` lines below and the `domain` line are added by hand: no phrase in
# the feature says what the state starts at, or what values the operation's
# own input ranges over, and neither is guessed at.
#
# Regenerate the inferred part with:
#   let text = read_file("self_hosting/examples/zs/priced_vending_machine.feature")
#   print(zi_infer_skeleton_auto(text))

schema BuyASnackWithMoneySchema
state inventory, balance
# TODO: no phrase in the feature says what these start at.
#   init inventory = ...

operation BuyASnackWithMoney(p1)
  require map_get_or(inventory, "cookie", 0) >= 1
  require balance >= 10
  ensure inventory' == map_put(inventory, "cookie", map_get(inventory, "cookie") - 1)
  ensure balance' == balance - 10
end

fact cookie is in stock => true
fact vending machine inventory contains at least one cookie => true
fact Bowen's balance is at least {p1} dollars => true

do Bowen inserts {p1} dollars and Bowen selects cookie => BuyASnackWithMoney(p1)

then the vending machine dispenses a cookie => true
then the vending machine inventory subtracts a cookie => true
then Bowen's balance is decreased by {p1} dollars => true

goal buy a snack with money => BuyASnackWithMoney

# ---- added by hand below: init values and the operation's own input domain ----
# balance starts at 10, not 0: this minimal schema has no deposit operation
# (the feature's own "Bowen inserts 10 dollars" was absorbed into
# BuyASnackWithMoney's own combined action, per Phase 1's own When/And
# joining), so starting at 0 would make the >= 10 precondition permanently
# unsatisfiable and the exploration below would visit one state and stop.
init inventory = map_of("cookie", 2)
init balance = 10
domain p1 = set_of(10)
