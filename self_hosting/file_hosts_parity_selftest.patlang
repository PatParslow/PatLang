# The file hosts must return the same types and values compiled natively (x64)
# as under the interpreter -- callers compare them with == true, != true and
# == "" (queue.patlang's `file_exists(path) != true` made every queue read look
# empty on x64 while file_exists still returned "1").
#
# Run both ways from the repo root and require the same result:
#   rust-runtime/target/release/pat.exe --ir-run self_hosting/file_hosts_parity_selftest.patlang
#   ./patc1.exe self_hosting/file_hosts_parity_selftest.patlang temp/fhp.exe --x64 && ./temp/fhp.exe

include "lib/test.patlang"

t_init()

let p = "temp/_file_hosts_parity.txt"
remove_file(p)

check("file_exists is false for a missing file", file_exists(p) == false, true)
check("file_exists is not true for a missing file", file_exists(p) != true, true)
check("try_read_file of a missing file is empty", try_read_file(p), "")
check("remove_file of a missing file reports an error", starts_with("" + remove_file(p), "ERR"), true)

check("write_file returns true", write_file(p, "abc") == true, true)
check("file_exists is true for a present file", file_exists(p) == true, true)
check("file_exists is not false for a present file", file_exists(p) != false, true)
check("read_file returns the contents", read_file(p), "abc")
check("try_read_file returns the contents", try_read_file(p), "abc")
if file_exists(p) then
  check("a bare `if file_exists` takes the true branch for a present file", true, true)
else
  check("a bare `if file_exists` takes the true branch for a present file", false, true)
end

check("remove_file reports OK", remove_file(p), "OK")
check("the file is gone", file_exists(p) == false, true)
if file_exists(p) then
  check("a bare `if file_exists` takes the false branch for a missing file", false, true)
else
  check("a bare `if file_exists` takes the false branch for a missing file", true, true)
end

t_report()
