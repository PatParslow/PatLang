# The file hosts must return the same types and values compiled natively (x64)
# as under the interpreter -- callers compare them with == true, != true and
# == "" (queue.patlang's `file_exists(path) != true` made every queue read look
# empty on x64 while file_exists still returned "1").
#
# Run both ways from the repo root and require the same result:
#   rust-runtime/target/release/pat.exe --ir-run self_hosting/file_hosts_parity_selftest.patlang
#   ./patc1.exe self_hosting/file_hosts_parity_selftest.patlang temp/fhp.exe --x64 && ./temp/fhp.exe

include "lib/test.patlang"

t_init()

let p = "temp/_file_hosts_parity.txt"
remove_file(p)

check("file_exists is false for a missing file", file_exists(p) == false, true)
check("file_exists is not true for a missing file", file_exists(p) != true, true)
check("try_read_file of a missing file is empty", try_read_file(p), "")
check("remove_file of a missing file reports an error", starts_with("" + remove_file(p), "ERR"), true)

check("write_file returns true", write_file(p, "abc") == true, true)
check("file_exists is true for a present file", file_exists(p) == true, true)
check("file_exists is not false for a present file", file_exists(p) != false, true)
check("read_file returns the contents", read_file(p), "abc")
check("try_read_file returns the contents", try_read_file(p), "abc")
if file_exists(p) then
  check("a bare `if file_exists` takes the true branch for a present file", true, true)
else
  check("a bare `if file_exists` takes the true branch for a present file", false, true)
end

check("remove_file reports OK", remove_file(p), "OK")
check("the file is gone", file_exists(p) == false, true)
if file_exists(p) then
  check("a bare `if file_exists` takes the false branch for a missing file", false, true)
else
  check("a bare `if file_exists` takes the false branch for a missing file", true, true)
end

# GitHub #192: write_file must auto-create its own parent directory,
# matching the interpreter's own create_dir_all behavior -- natively,
# this previously silently failed with nothing written at all (no
# exception mechanism to surface it), breaking any first-ever write
# into a not-yet-existing directory (e.g. task_registry.patlang's own
# ".patlang_queue/" beacon files). Also checks file_exists on the bare
# DIRECTORY itself, not just the file inside it: natively this used to
# always read false (os_file_size's own CreateFileA has no
# FILE_FLAG_BACKUP_SEMANTICS, so it can't open a directory handle at
# all), breaking task_registry.patlang's own tr_discover_all, whose
# first line is exactly `file_exists(q_dir())`.
let nested_dir = "temp/_fhp_nested"
let nested_sub_dir = nested_dir + "/sub"
let nested_path = nested_sub_dir + "/leaf.txt"
# Self-cleaning, not relying on an external rm -- remove_file only
# handles a plain file or an EMPTY directory (never recursive), so a
# leftover tree from a PRIOR run must be torn down leaf-first.
remove_file(nested_path)
remove_file(nested_sub_dir)
remove_file(nested_dir)
check("the nested parent directory does not exist yet", file_exists(nested_dir) == false, true)
check("write_file into a not-yet-existing nested directory still returns true", write_file(nested_path, "deep") == true, true)
check("write_file auto-created the parent directory, now visible to file_exists on the bare directory itself", file_exists(nested_dir) == true, true)
check("the file itself exists and has the right content", read_file(nested_path), "deep")
let remove_result = remove_file(nested_path)
check("the nested file is gone after remove_file", file_exists(nested_path) == false, true)
# Tear the directories back down too, leaf-first -- leaves nothing
# behind for a subsequent run to trip over.
let remove_sub = remove_file(nested_sub_dir)
let remove_top = remove_file(nested_dir)

t_report()
