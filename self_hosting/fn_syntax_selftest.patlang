# Selftest for the self-hosted parser's `fn name(params) { body }`
# support (self_hosting/lib/parser.patlang's parse_fn_def). This form was
# always a real, working native keyword (rust-runtime/src/lexer.rs's
# Token::Fn / parser.rs's parse_function) that the self-hosted parser had
# simply never learned to recognize -- parse_stmt fell through to its
# generic "unexpected token" case for any bare 'fn'. No lexer or lowering/
# codegen changes were needed: `fn`/`{`/`}` were already tokenized
# generically (same as any other keyword-as-plain-IDENT, and `{`/`}` were
# already emitted as OP tokens for the already-working brace-style if/
# while), and a brace-bodied function produces the exact same
# ["Func", name, params, body] node make-a-function-called already builds.
#
# Run from the repo root:
#   rust-runtime/target/release/pat --ir-run self_hosting/fn_syntax_selftest.patlang

include "lib/includes.patlang"
include "lib/gherkin.patlang"
include "lib/lexer.patlang"
include "lib/parser.patlang"

let ctx = ctx_new()

make a function called fn_test_parse_ok takes source returns ok
  let toks = tokenize(source)
  let ast = parse_program(toks)
  let stmts = ast[1]
  let err = parse_find_error(stmts)
  return err[0] == ""
end

make a function called fn_test_parse_err takes source returns msg
  let toks = tokenize(source)
  let ast = parse_program(toks)
  let stmts = ast[1]
  let err = parse_find_error(stmts)
  return err[0]
end

# ---- 1: simple fn with params, called and printed ----
let src1 = "fn add(a, b) {
  return a + b
}

print(add(2, 3))
"
expect(ctx, "fn with params parses cleanly", fn_test_parse_ok(src1), true)

# ---- 2: zero-parameter fn ----
let src2 = "fn no_params() {
  return 42
}

print(no_params())
"
expect(ctx, "zero-parameter fn parses cleanly", fn_test_parse_ok(src2), true)

# ---- 3: fn main() is rejected, same as make a function called main ----
let src3 = "fn main() {
  return 1
}
"
expect(ctx, "fn main() is rejected as a reserved name", fn_test_parse_err(src3), "'main' is a reserved function name")

# ---- 4: nested brace-style control flow inside an fn-defined function --
# proves the new dispatch branch composes with the ALREADY-working
# brace-style if/elif/else/while, not just that fn parses in isolation.
let src4 = "fn classify(x) {
  let result = \"\"
  if x > 10 {
    let result = \"big\"
  } elif x > 0 {
    let result = \"small\"
  } else {
    let result = \"non-positive\"
  }
  let i = 0
  while i < 3 {
    print(i)
    let i = i + 1
  }
  return result
}

print(classify(15))
"
expect(ctx, "fn body with nested brace-style if/elif/else/while parses cleanly", fn_test_parse_ok(src4), true)

# ---- 5: the real file -- self_hosting/lib/regex.patlang, previously
# rejected with 'unexpected token 'fn'', now parses end-to-end.
let regex_source = read_file("self_hosting/lib/regex.patlang")
expect(ctx, "the real lib/regex.patlang parses with zero errors", fn_test_parse_ok(regex_source), true)

# ---- 6: the JS-style spelling, function NAME(params) { body }, is the same node ----
let src6 = "function add(a, b) {
  return a + b
}

print(add(2, 3))
"
expect(ctx, "function keyword form parses cleanly", fn_test_parse_ok(src6), true)

let src7 = "function main() {
  return 1
}
"
expect(ctx, "function main() is rejected as a reserved name", fn_test_parse_err(src7), "'main' is a reserved function name")

let src8 = "function classify(x) {
  if x > 10 {
    return 1
  } else {
    return 0
  }
}

print(classify(15))
"
expect(ctx, "function keyword body with brace-style control flow parses cleanly", fn_test_parse_ok(src8), true)

ctx_report(ctx)
