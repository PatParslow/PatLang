# Selftest for self_hosting/lib/format.patlang. Standalone (includes its
# own deps, same convention as lint_selftest.patlang), operates on
# in-memory string fixtures -- fmt_reindent takes/returns full source
# text, no filesystem needed for testing it.
#
# Run from the repo root:
#   rust-runtime/target/release/pat --ir-run self_hosting/format_selftest.patlang

include "lib/test.patlang"
include "lib/lexer.patlang"
include "lib/includes.patlang"
include "lib/format.patlang"

t_init()

# fmt_reindent always emits a trailing newline (matching the near-universal
# text-file convention), so the fixture builder does too, to compare
# apples to apples.
make a function called fixture_join takes lines returns s
  let b = sb_new()
  let i = 0
  let n = to_num(list_len(lines))
  while i < n do
    sb_push(b, lines[i])
    sb_push(b, chr(10))
    let i = i + 1
  end
  return sb_str(b)
end

# ---- 1: idempotency -- a correctly-indented file is unchanged ----
let clean = fixture_join(["make a function called f takes x returns y", "  if x > 0 then", "    let y = 1", "  else", "    let y = 2", "  end", "  return y", "end"])
let clean_out = fmt_reindent(clean)
check("a correctly-indented file is unchanged (idempotent)", clean_out, clean)

# ---- 2: drifted indentation gets fixed ----
let drifted = fixture_join(["make a function called f takes x returns y", "if x > 0 then", "let y = 1", "        else", "let y = 2", "end", "  return y", "end"])
let drifted_out = fmt_reindent(drifted)
check("drifted indentation is fixed to match the clean version", drifted_out, clean)

# ---- 3: nested if/else/while all track correctly ----
let nested = fixture_join(["make a function called g returns r", "  let i = 0", "  while i < 3 do", "    if i == 1 then", "      print(i)", "    else", "      if i == 2 then", "        print(99)", "      end", "    end", "    let i = i + 1", "  end", "  return r", "end"])
check("nested if/else/while is idempotent when already correct", fmt_reindent(nested), nested)

let nested_drifted = fixture_join(["make a function called g returns r", "let i = 0", "while i < 3 do", "if i == 1 then", "print(i)", "else", "if i == 2 then", "print(99)", "end", "end", "let i = i + 1", "end", "return r", "end"])
check("nested if/else/while drift is fixed to match the correct version", fmt_reindent(nested_drifted), nested)

# ---- 4: same-line if...then...end one-liner is left alone, not double-indented ----
let oneliner = fixture_join(["make a function called h takes x returns c", "  let c = 0", "  if x > 0 then c = 1 end", "  return c", "end"])
check("a same-line if-then-end one-liner is not treated as a real block opener", fmt_reindent(oneliner), oneliner)

# ---- 5: comments and blank lines survive verbatim; only leading whitespace changes ----
let commented = fixture_join(["# top-level comment, untouched", "make a function called k returns r", "# a comment before a statement", "let r = 1", "", "  # a badly-indented comment -- gets reindented like any other line", "return r", "end"])
let commented_expected = fixture_join(["# top-level comment, untouched", "make a function called k returns r", "  # a comment before a statement", "  let r = 1", "", "  # a badly-indented comment -- gets reindented like any other line", "  return r", "end"])
let commented_out = fmt_reindent(commented)
check("comments are reindented like normal lines, content preserved verbatim", commented_out, commented_expected)

t_report()
