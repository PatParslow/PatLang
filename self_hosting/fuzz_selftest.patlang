# Selftest for self_hosting/lib/fuzz.patlang. Standalone (includes its own
# deps, same convention as lint_selftest.patlang).
#
# Run from the repo root:
#   rust-runtime/target/release/pat --ir-run self_hosting/fuzz_selftest.patlang

include "lib/test.patlang"
include "lib/lexer.patlang"
include "lib/parser.patlang"
include "lib/includes.patlang"
include "lib/format.patlang"
include "lib/peg.patlang"
include "lib/fuzz.patlang"

t_init()

# ---- 1: determinism -- same seed produces identical generated output ----
let gen_a = fuzz_gen_program("determinism_seed")
let gen_b = fuzz_gen_program("determinism_seed")
check("the same seed produces byte-identical generated source", gen_a[0], gen_b[0])
check("the same seed produces the same next PRNG state", gen_a[1], gen_b[1])

let gen_c = fuzz_gen_program("a_different_seed")
check("a different seed produces different generated source", gen_a[0] == gen_c[0], false)

# ---- 2: self-consistency -- end-count matches block-opener count,
# independent of invoking either parser. Checked across several seeds to
# exercise different generated shapes (plain, if/else, while, one-liner,
# nested combinations). ----
let seeds = ["consistency_1", "consistency_2", "consistency_3", "consistency_4", "consistency_5", "consistency_6", "consistency_7", "consistency_8"]
let i = 0
let n = to_num(list_len(seeds))
make a function called fuzz_test_count_char takes s, ch returns count
  let count = 0
  let i = 0
  while i < s.length do
    if s[i] == ch then
      let count = count + 1
    end
    let i = i + 1
  end
  return count
end

while i < n do
  let gen = fuzz_gen_program(seeds[i])
  let source = gen[0]
  let opens_braces = fuzz_test_count_char(source, "{")
  if opens_braces > 0 then
    # brace-style program: '{' count must match '}' count exactly.
    let closes_braces = fuzz_test_count_char(source, "}")
    check("seed '" + seeds[i] + "' (brace style): '{' count matches '}' count", closes_braces, opens_braces)
  else
    let ends = fuzz_count_word(source, "end")
    let opens = fuzz_count_word(source, "then") + fuzz_count_word(source, "do") + 1
    check("seed '" + seeds[i] + "' (word style): end-count matches opener-count (function signature + then/do)", ends, opens)
  end
  let i = i + 1
end

# ---- 3: the actual point of the tool -- native, self-hosted, and PEG
# grammar-checker all agree across many generated programs against the
# CURRENT, real codebase. A failure here is a genuine parser bug, not a
# fuzzer bug -- this is a regression check, not just a smoke test.
let pat_exe = "rust-runtime/target/release/pat.exe"
let grammar_source = read_file("docs/grammar/patlang-full.peg")
let peg_rules = peg_load_grammar(grammar_source)
let result = fuzz_run(pat_exe, peg_rules, "regression_check_seed", 60, "self_hosting/build/fuzz_selftest_scratch.patlang")
let disagreements = result[0]
check("60 generated programs: native, self-hosted, and PEG checker agree on all of them", to_num(list_len(disagreements)), 0)

t_report()
