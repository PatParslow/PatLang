# Selftest for the gates tool's record logic (v2/tools/gates_logic.patlang).
#
# Given a record in which a feature file's whole run failed after more than
# ten minutes, so it now runs as one unit per scenario,
# when --failed chooses what to run,
# then each of its scenario units is chosen, and no unit of another feature
# whose name merely starts the same;
# when the record is pruned before any of its scenario units has run,
# then the whole feature's row is kept, so the failure and the split are not
# lost (they were, 2026-11-24: --failed then ran nothing, and the next run
# ran the feature whole again);
# when one of its scenario units has a row,
# then the whole feature's row is dropped;
# and a row for a unit that no longer exists at all is dropped.

include "lib/includes.patlang"
include "lib/gherkin.patlang"
include "v2/tools/gates_logic.patlang"

let ctx = ctx_new()
let whole = ["part1_linux/integers", "k1", "fail", 826292, 426512384]
let other = ["part1_linux/integers_more", "k2", "pass", 1000, 1000]
let gone = ["part1_linux/deleted", "k3", "pass", 1000, 1000]
let rows = [whole, other, gone]
let units = ["part1_linux/integers@1", "part1_linux/integers@2", "part1_linux/integers@3", "part1_linux/integers_more", "part1_linux/integers_more@1"]

expect(ctx, "the feature now runs split", gt_split_feature(rows, "part1_linux/integers"), true)

let only = gt_failed_names(rows)
expect(ctx, "--failed chooses each of its scenario units", [gt_selected("part1_linux/integers@1", only), gt_selected("part1_linux/integers@3", only)], [true, true])
expect(ctx, "and the whole name, if it still runs whole", gt_selected("part1_linux/integers", only), true)
expect(ctx, "but not another feature whose name starts the same", [gt_selected("part1_linux/integers_more", only), gt_selected("part1_linux/integers_more@1", only)], [false, false])

let kept = gt_rows_kept(rows, units)
expect(ctx, "pruned before its scenarios ran, the whole row is kept", gt_member(kept, whole), true)
expect(ctx, "so it still runs split", gt_split_feature(kept, "part1_linux/integers"), true)
expect(ctx, "and --failed still chooses it", gt_selected("part1_linux/integers@2", gt_failed_names(kept)), true)
expect(ctx, "a row for a unit that no longer exists is dropped", gt_member(kept, gone), false)
expect(ctx, "a row for a unit that exists is kept", gt_member(kept, other), true)

let after = list_push(kept, ["part1_linux/integers@1", "k4", "pass", 5000, 1000])
let kept2 = gt_rows_kept(after, units)
expect(ctx, "once a scenario unit has a row, the whole row is dropped", gt_member(kept2, whole), false)
expect(ctx, "and it still runs split", gt_split_feature(kept2, "part1_linux/integers"), true)

ctx_report(ctx)
