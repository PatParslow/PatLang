# Selftest for doc strings in a scenario (lib/gherkin.patlang, step_doc): the
# lines between two lines of """ under a step are that step's, so a scenario
# can carry the program it is about (review, test-suite recommendation 2).
#
# Given features run from text with steps that keep what they are given,
# then a step's doc string reaches it whole, each line without the opening
# """'s indentation and with any more; a step without one gets ""; a doc
# string ending the file still runs
# its step; and a line inside a doc string is never run as a step, even one
# that reads as a step.

include "lib/includes.patlang"
include "lib/gherkin.patlang"

make a function called st_keep takes ctx returns ok
  ctx_set(ctx, "seen", list_push(ctx_get(ctx, "seen"), step_doc(ctx)))
  return true
end

make a function called st_inner takes ctx returns ok
  ctx_set(ctx, "inner_ran", true)
  return true
end

make a function called dt_run takes feature returns seen
  let c = ctx_new()
  ctx_set(c, "seen", [])
  ctx_set(c, "inner_ran", false)
  step(c, "a step", "st_keep")
  step(c, "a step that must not run", "st_inner")
  run_feature(c, feature)
  return [ctx_get(c, "seen"), ctx_get(c, "inner_ran")]
end

let ctx = ctx_new()
let q = chr(34) + chr(34) + chr(34)
let nl = chr(10)

let r = dt_run("Feature: f" + nl + "  Scenario: s" + nl + "    Given a step" + nl + "      " + q + nl + "      print(1)" + nl + "        print(2)" + nl + "      " + q + nl + "    Then a step" + nl)
expect(ctx, "the doc string reaches its step, each line without the opening's indentation and with any more", r[0][0], "print(1)" + nl + "  print(2)" + nl)
expect(ctx, "a step with none gets the empty string", r[0][1], "")
expect(ctx, "two steps ran", list_len(r[0]), 2)

let r = dt_run("Feature: f" + nl + "  Scenario: s" + nl + "    Given a step" + nl + "      " + q + nl + "      Given a step that must not run" + nl + "      " + q)
expect(ctx, "a line in a doc string is not run as a step", r[1], false)
expect(ctx, "a doc string ending the file still runs its step", r[0], ["Given a step that must not run" + nl])

let r = dt_run("Feature: f" + nl + "  Scenario: one" + nl + "    Given a step" + nl + "      " + q + nl + "      x" + nl + "      " + q + nl + "  Scenario: two" + nl + "    Given a step" + nl)
expect(ctx, "the next scenario's step gets none of it", r[0], ["x" + nl, ""])

ctx_report(ctx)
