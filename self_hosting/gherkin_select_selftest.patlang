# Selftest for running one scenario of a feature (lib/gherkin.patlang).
#
# Given a feature with three scenarios and a runner whose steps print which
# scenario ran,
# when the runner is given FILE.feature@2,
# then only the second scenario's steps run, and its counts are its own;
# when it is given --list-scenarios,
# then it prints FILE.feature@1 to @3;
# when it is given the plain file,
# then all three run;
# when it is given a number past the last scenario,
# then nothing runs and it exits 1, so a stale unit name fails.

include "lib/includes.patlang"
include "lib/gherkin.patlang"
include "lib/program_run.patlang"
include "lib/v2_engines.patlang"

let ctx = ctx_new()
let dir = spec_out()
let feature = dir + "/gherkin_select_three.feature"
write_file(feature, "Feature: three\n\n  Scenario: one\n    Given step one\n\n  Scenario: two\n    Given step two\n\n  Scenario: three\n    Given step three\n")
let runner = dir + "/gherkin_select_runner.patlang"
write_file(runner, "include \"" + path_absolute("self_hosting/lib/gherkin.patlang") + "\"\n" +
  "make a function called st_one takes ctx returns ok\n  print(\"ran one\")\n  return expect(ctx, \"one\", 1, 1)\nend\n" +
  "make a function called st_two takes ctx returns ok\n  print(\"ran two\")\n  return expect(ctx, \"two\", 2, 2)\nend\n" +
  "make a function called st_three takes ctx returns ok\n  print(\"ran three\")\n  return expect(ctx, \"three\", 3, 3)\nend\n" +
  "let ctx = ctx_new()\nstep(ctx, \"step one\", \"st_one\")\nstep(ctx, \"step two\", \"st_two\")\nstep(ctx, \"step three\", \"st_three\")\n" +
  "run_suite(ctx, [\"" + feature + "\"], argv())\n")

let r = exec_measured("self_hosting/build/v2_interp.exe", [runner, feature + "@2"])
expect(ctx, "the second scenario runs", contains_text(r[0], "ran two"), true)
expect(ctx, "the first does not", contains_text(r[0], "ran one"), false)
expect(ctx, "the third does not", contains_text(r[0], "ran three"), false)
expect(ctx, "the counts are the chosen scenario's", contains_text(r[0], "tests: 1 passed, 0 failed"), true)
expect(ctx, "it exits 0", r[2], true)

let l = exec_measured("self_hosting/build/v2_interp.exe", [runner, "--list-scenarios"])
expect(ctx, "--list-scenarios names each scenario", printed(l[0], feature + "@1\n" + feature + "@2\n" + feature + "@3\n"), true)

let a = exec_measured("self_hosting/build/v2_interp.exe", [runner, feature])
expect(ctx, "the plain file runs all three", contains_text(a[0], "tests: 3 passed, 0 failed"), true)

let p = exec_measured("self_hosting/build/v2_interp.exe", [runner, feature + "@4"])
expect(ctx, "a scenario past the last runs nothing", contains_text(p[0], "ran "), false)
expect(ctx, "and exits 1", p[2], false)

# Given a feature whose Background sets a count to 0, and two scenarios that
# each add one and expect 1, when it runs, then each starts from the
# Background: both pass, and the Background's step runs twice, not where it is
# written. A scenario run alone (@2) starts from it too.
let bfeature = dir + "/gherkin_background.feature"
write_file(bfeature, "Feature: a background\n\n  Background:\n    Given a fresh count\n\n  Scenario: first\n    When one is added\n    Then the count is 1\n\n  Scenario: second\n    When one is added\n    Then the count is 1\n")
let brunner = dir + "/gherkin_background_runner.patlang"
write_file(brunner, "include \"" + path_absolute("self_hosting/lib/gherkin.patlang") + "\"\n" +
  "make a function called st_fresh takes ctx returns ok\n  let r = ctx_get(ctx, \"runs\")\n  if r == false then\n    let r = 0\n  end\n  ctx_set(ctx, \"runs\", r + 1)\n  print(\"fresh run \" + (r + 1))\n  ctx_set(ctx, \"n\", 0)\n  return true\nend\n" +
  "make a function called st_add takes ctx returns ok\n  ctx_set(ctx, \"n\", ctx_get(ctx, \"n\") + 1)\n  return true\nend\n" +
  "make a function called st_is_one takes ctx returns ok\n  return expect(ctx, \"the count\", ctx_get(ctx, \"n\"), 1)\nend\n" +
  "let ctx = ctx_new()\nstep(ctx, \"a fresh count\", \"st_fresh\")\nstep(ctx, \"one is added\", \"st_add\")\nstep(ctx, \"the count is 1\", \"st_is_one\")\n" +
  "run_suite(ctx, [\"" + bfeature + "\"], argv())\n")
let b = exec_measured("self_hosting/build/v2_interp.exe", [brunner, bfeature])
expect(ctx, "each scenario starts from the Background", contains_text(b[0], "tests: 2 passed, 0 failed"), true)
expect(ctx, "the Background's step runs once for each scenario", [contains_text(b[0], "fresh run 2"), contains_text(b[0], "fresh run 3")], [true, false])
let b2 = exec_measured("self_hosting/build/v2_interp.exe", [brunner, bfeature + "@2"])
expect(ctx, "a scenario run alone starts from the Background", contains_text(b2[0], "tests: 1 passed, 0 failed"), true)

ctx_report(ctx)
