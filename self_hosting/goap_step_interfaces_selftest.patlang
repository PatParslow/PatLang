# GitHub #21 quick-win #2: classes+traits step interfaces wired with
# REAL formal parameters, not name matching (self_hosting/lib/
# goap_step_interfaces.patlang). Mirrors the same demo1/demo2 GOAP
# scenarios goap_snippet_synthesis's own selftest covers, but proves
# the key property the old string-template approach could never prove:
# each step class below names its OWN parameters however it likes --
# deliberately NOT matching the producing step's local variable name --
# and the assembler still wires the right value through, because the
# wiring is derived from the plan's actual precondition/effect
# structure, not from scanning generated text for a shared identifier.

include "lib/test.patlang"
include "lib/goap_step_interfaces.patlang"

t_init()

# ---- step classes: each names its own params independently ----

class GatherWoodStep {
  traits GoapStep
  make a function called run takes self returns resource
    let resource = "wood"
    print("gathered " + resource)
    return resource
  end
}

class BuildHouseStep {
  traits GoapStep
  make a function called run takes self, material returns dwelling
    let dwelling = "house built from " + material
    print(dwelling)
    return dwelling
  end
}

class ScaleStep {
  traits GoapStep
  make a function called run takes self, raw_value returns doubled
    let doubled = to_num(raw_value) * 2
    print("scaled " + raw_value + " -> " + doubled)
    return doubled
  end
}

# ---- demo 1: two-step plan, wiring across DIFFERENTLY-named params ----

action_add("gather_wood", [], [["have", ["wood"]]], [], 1)
action_add("build_house", [["have", ["wood"]]], [["have", ["house"]]], [], 1)
let plan1 = plan([["have", ["house"]]])
check("demo 1: plan finds the two-step sequence", to_num(list_len(plan1)), 2)

let registry1 = new("Dict", "step_classes_1")
send(registry1, "set", "gather_wood", "GatherWoodStep")
send(registry1, "set", "build_house", "BuildHouseStep")
let defs1 = [
  ["gather_wood", [], [["have", ["wood"]]]],
  ["build_house", [["have", ["wood"]]], [["have", ["house"]]]]
]

let synth1 = synthesize_program_structural(plan1, defs1, registry1, [])
check("demo 1: structural synthesis succeeds", synth1[0], "OK")
check("demo 1: wiring never references BuildHouseStep's own param name 'material'", contains_text(synth1[1], "material"), false)
check("demo 1: wiring never references GatherWoodStep's own local name 'resource'", contains_text(synth1[1], "resource"), false)
check("demo 1: wiring passes step0's actual return variable positionally", contains_text(synth1[1], "step0_out"), true)

let class_defs_text = "include \"../lib/goap_step_interfaces.patlang\"\nclass GatherWoodStep {\n  traits GoapStep\n  make a function called run takes self returns resource\n    let resource = \"wood\"\n    print(\"gathered \" + resource)\n    return resource\n  end\n}\nclass BuildHouseStep {\n  traits GoapStep\n  make a function called run takes self, material returns dwelling\n    let dwelling = \"house built from \" + material\n    print(dwelling)\n    return dwelling\n  end\n}\n"
let demo1_path = "self_hosting/build/goap_step_iface_selftest_demo1.patlang"
write_file(demo1_path, class_defs_text + synth1[1])
let run1_out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", demo1_path)
check("demo 1: real function call chain reproduces the same runtime behavior", run1_out, "gathered wood\nhouse built from wood\n\n")

# ---- demo 2: literal (non-step-produced) precondition wired as a real arg ----

action_add("scale", [["input", ["X"]]], [["scaled", ["X"]]], [], 1)
rule_add("input", ["5"], [])
let plan2 = plan([["scaled", ["5"]]])

let registry2 = new("Dict", "step_classes_2")
send(registry2, "set", "scale", "ScaleStep")
let defs2 = [["scale", [["input", ["X"]]], [["scaled", ["X"]]]]]

let synth2 = synthesize_program_structural(plan2, defs2, registry2, [])
check("demo 2: literal-precondition step synthesizes", synth2[0], "OK")
check("demo 2: the ground literal '5' is wired in as a real quoted argument", contains_text(synth2[1], "\"5\""), true)

let scale_class_defs_text = "include \"../lib/goap_step_interfaces.patlang\"\nclass ScaleStep {\n  traits GoapStep\n  make a function called run takes self, raw_value returns doubled\n    let doubled = to_num(raw_value) * 2\n    print(\"scaled \" + raw_value + \" -> \" + doubled)\n    return doubled\n  end\n}\n"
let demo2_path = "self_hosting/build/goap_step_iface_selftest_demo2.patlang"
write_file(demo2_path, scale_class_defs_text + synth2[1])
let run2_out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", demo2_path)
check("demo 2: run() call chain reproduces the same runtime behavior", run2_out, "scaled 5 -> 10\n\n")

# ---- error paths ----

action_add("undocumented_step", [], [["have", ["mystery"]]], [], 1)
let plan3 = plan([["have", ["mystery"]]])
let synth_missing_class = synthesize_program_structural(plan3, [["undocumented_step", [], [["have", ["mystery"]]]]], new("Dict", "empty_registry"), [])
check("an action with no registered step class is reported as an error", synth_missing_class[0], "ERR")

let synth_missing_def = synthesize_program_structural(plan1, [], registry1, [])
check("an action with no supplied action definition is reported as an error", synth_missing_def[0], "ERR")

t_report()
