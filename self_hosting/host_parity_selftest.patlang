# The interpreter hosts sc_substr, sed, the stage-0 shims (add, multiply,
# subtract, max, min, calculate, calculate_result, get_value, process, validate),
# object_delete, progress_report, plan_incremental, action_clear and read_file_b64
# must give the same results compiled natively (x64) as under the interpreter.
# Each of these used to be missing on x64 and silently evaluate to 0.
#
# Run both ways from the repo root and require the same result:
#   rust-runtime/target/release/pat.exe --ir-run self_hosting/host_parity_selftest.patlang
#   ./patc1.exe self_hosting/host_parity_selftest.patlang temp/hp.exe --x64 && ./temp/hp.exe

include "lib/test.patlang"

t_init()

# --- sc_substr ---
let h = str_intern("hello")
check("sc_substr inside the string", sc_substr(h, 1, 3), "ell")
check("sc_substr clamps the count at the end", sc_substr(h, 3, 10), "lo")
check("sc_substr past the end is empty", sc_substr(h, 9, 2), "")
check("sc_substr of zero characters is empty", sc_substr(h, 0, 0), "")

# --- sed: literal s/pat/repl/[g][i] ---
check("sed g replaces every match", sed("s/l/L/g", "hello"), "heLLo")
check("sed without g replaces the first match only", sed("s/l/L/", "hello"), "heLlo")
check("sed i matches case-insensitively", sed("s/L/x/i", "hello"), "hexlo")
check("sed gi replaces every match case-insensitively", sed("s/L/x/gi", "hello world"), "hexxo worxd")
check("sed with no match returns the input", sed("s/zz/x/g", "hello"), "hello")
check("sed with a command other than s returns the input", sed("p/l/x/", "hello"), "hello")
check("sed with an empty pattern returns the input", sed("s//x/g", "hello"), "hello")
check("sed missing its replacement returns the input", sed("s/l", "hello"), "hello")
check("sed with an empty replacement deletes the first match", sed("s/l/", "hello"), "helo")
check("sed reads flags from everything after the third slash", sed("s/o/0/g/extra", "foo boo"), "f00 b00")
check("sed replaces non-overlapping matches", sed("s/ab/X/g", "ababab"), "XXX")

# --- stage-0 shims (integers: a float argument does not survive a function call on
# x64 at all, for any function -- see GitHub #50) ---
check("add", add(2, 3), 5)
check("multiply", multiply(2, 3), 6)
check("subtract", subtract(5, 3), 2)
check("max", max(2, 3), 3)
check("min", min(2, 3), 2)
check("calculate", calculate(1), 0)
check("calculate_result", calculate_result(1), 0)
check("get_value", get_value(1), 0)
check("process", process(1), true)
check("validate", validate(1), true)

# --- object_delete, progress_report ---
new("Thing", "t1")
check("an object has its class before it is deleted", get("t1", "type"), "Thing")
object_delete("t1")
check("object_delete removes the object", get("t1", "type") != "Thing", true)
progress_report("halfway")
check("progress_report accepts a status", true, true)

# --- plan_incremental and action_clear ---
rule_add("at", ["home"], [])
action_add("go", [["at", ["home"]]], [["at", ["work"]]], [["at", ["home"]]], 1)
let p1 = plan([["at", ["work"]]])
let p2 = plan_incremental([["at", ["work"]]])
check("plan finds the one-step plan", list_len(p1), 1)
check("plan_incremental finds the same plan", p2[0], p1[0])
action_clear()
check("action_clear forgets the actions", list_len(plan([["at", ["work"]]])), 0)

# --- read_file_b64 ---
write_file_bytes("temp/_host_parity_b64.bin", [0, 1, 2, 250, 251, 252, 253, 254, 255, 65, 66])
check("read_file_b64 encodes raw bytes, with padding", read_file_b64("temp/_host_parity_b64.bin"), "AAEC+vv8/f7/QUI=")
remove_file("temp/_host_parity_b64.bin")

t_report()
