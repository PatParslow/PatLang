# Cross-backend oracle for interp_run: runs every self-contained, terminating
# program in self_hosting/examples/ on the in-process world backend and on a
# fresh pat.exe process, and requires identical stdout and ok. Programs that
# touch the network, files, time, stdin, processes or `syntax` blocks are
# skipped (their result depends on more than the interpreter), and programs
# that exhaust the world step budget are counted separately rather than
# compared.
#
# Run from the repo root:
#   rust-runtime/target/release/pat.exe --ir-run self_hosting/interp_run_corpus_check.patlang

include "lib/test.patlang"
include "lib/interp_run.patlang"

make a function called irc_skip_reason takes src returns why
  let bad = ["include ", "tcp_", "spawn(", "signal_", "read_line", "argv(", "now_ms", "exec_capture", "random", "fiber_", "budgeted", "parallel_map", "sleep", "queue_", "getenv", "syntax ", "vfs_flush", "write_file", "read_file", "list_dir", "os_", "gui_", "http", "env("]
  let i = 0
  while i < list_len(bad) do
    if contains_text(src, bad[i]) then return bad[i] end
    let i = i + 1
  end
  return ""
end

t_init()

let files = list_dir("self_hosting/examples")
let i = 0
let same = 0
let differ = 0
let skipped = 0
let over_budget = 0
while i < list_len(files) do
  let f = files[i]
  let i = i + 1
  if substr(f, f.length - 8, 8) == ".patlang" then
    let src = read_file("self_hosting/examples/" + f)
    if irc_skip_reason(src) != "" then
      let skipped = skipped + 1
    else
      let a = interp_run_full(src, [["backend", "world"], ["max_steps", 20000000]])
      if contains_text(a[1], "step budget") then
        let over_budget = over_budget + 1
      else
        let b = interp_run_full(src, [["backend", "process"], ["timeout_ms", 60000]])
        if a[0] == b[0] and a[2] == b[2] then
          let same = same + 1
        else
          let differ = differ + 1
          print("DIFF " + f + " ok=" + a[2] + "/" + b[2] + " stdout_len=" + a[0].length + "/" + b[0].length + " world_err=[" + substr(a[1], 0, 100) + "]")
        end
      end
    end
  end
end
print("compared=" + (same + differ) + " same=" + same + " differ=" + differ + " skipped=" + skipped + " over_budget=" + over_budget)
check("every compared program gives identical stdout and ok on both backends", differ, 0)
check("the corpus is large enough to mean something", same >= 30, true)
t_report()
