# Selftest for self_hosting/lib/interp_run.patlang.
#
# Run from the repo root:
#   rust-runtime/target/release/pat.exe --ir-run self_hosting/interp_run_selftest.patlang

include "lib/includes.patlang"
include "lib/gherkin.patlang"
include "lib/interp_run.patlang"

make a function called irt_src takes lines returns text
  let out = ""
  let i = 0
  while i < list_len(lines) do
    let out = out + lines[i] + chr(10)
    let i = i + 1
  end
  return out
end

let nl = chr(10)

let ctx = ctx_new()

# --- backend selection ---
expect(ctx, "auto picks the in-process world backend when it exists", interp_backend([]), "world")
expect(ctx, "backend:process is honoured", interp_backend([["backend", "process"]]), "process")
expect(ctx, "a wall-clock timeout needs the process backend", interp_backend([["timeout_ms", 1000]]), "process")
expect(ctx, "stdin needs the process backend", interp_backend([["stdin", "x"]]), "process")

# --- the same answer from both backends ---
let hello = irt_src(["print(\"hello\")", "print(2 * 21)"])
let w = interp_run(ctx, hello, [["backend", "world"]])
let p = interp_run(ctx, hello, [["backend", "process"]])
expect(ctx, "world: stdout is exactly the prints", w[0], "hello" + nl + "42" + nl)
expect(ctx, "process: stdout is exactly the prints", p[0], "hello" + nl + "42" + nl)
expect(ctx, "world: ok", w[2], true)
expect(ctx, "process: ok", p[2], true)
expect(ctx, "world: empty stderr", w[1], "")
expect(ctx, "process: empty stderr", p[1], "")

let prog = irt_src([
  "make a function called fib takes n returns r",
  "  if n < 2 then return n end",
  "  return fib(n - 1) + fib(n - 2)",
  "end",
  "let xs = []",
  "let i = 0",
  "while i < 10 do",
  "  let xs = list_push(xs, fib(i))",
  "  let i = i + 1",
  "end",
  "print(xs)",
  "print(\"done\" + \" \" + 1.5)"
])
let chk = interp_run_check(ctx, prog, [])
expect(ctx, "both backends agree on a function/list/loop program", chk[0], true)
expect(ctx, "interp_run_check reports no difference", chk[1], "")

# --- runtime errors: partial stdout kept, ok=false, same first stderr line ---
let crash = irt_src(["print(\"before\")", "let x = no_such_function(1)"])
let cw = interp_run(ctx, crash, [["backend", "world"]])
let cp = interp_run(ctx, crash, [["backend", "process"]])
expect(ctx, "world crash: ok=false", cw[2], false)
expect(ctx, "process crash: ok=false", cp[2], false)
expect(ctx, "world crash keeps partial stdout", cw[0], "before" + nl)
expect(ctx, "process crash keeps partial stdout", cp[0], "before" + nl)
expect(ctx, "world crash reports an IR runtime error", starts_with(cw[1], "IR runtime error"), true)
let cc = interp_run_check(ctx, crash, [])
expect(ctx, "both backends agree on a crash", cc[0], true)

# --- bitwise operators decode on both backends (world_run's IR decoder once lacked them) ---
let bits = irt_src(["print(12 band 10)", "print(12 bor 3)", "print(12 bxor 5)", "print(1 shl 4)", "print(256 shr 2)", "print(bnot 0)"])
let bw = interp_run(ctx, bits, [["backend", "world"]])
expect(ctx, "world: bitwise operators run", bw[0], "8" + nl + "15" + nl + "9" + nl + "16" + nl + "64" + nl + "-1" + nl)
let bc = interp_run_check(ctx, bits, [])
expect(ctx, "both backends agree on bitwise operators", bc[0], true)

# --- parse errors (world backend compiles in PatLang) ---
let bad = interp_run(ctx, "print(1", [["backend", "world"]])
expect(ctx, "a parse error is ok=false", bad[2], false)
expect(ctx, "a parse error is named as one", starts_with(bad[1], "parse error"), true)
expect(ctx, "a parse error runs nothing", bad[0], "")

# --- limits ---
let spin = irt_src(["while true do", "end"])
let sw = interp_run(ctx, spin, [["backend", "world"], ["max_steps", 5000]])
expect(ctx, "world: max_steps stops an infinite loop", sw[2], false)
expect(ctx, "world: the budget error says so", contains_text(sw[1], "step budget exhausted"), true)
let sp = interp_run(ctx, spin, [["backend", "process"], ["timeout_ms", 400]])
expect(ctx, "process: timeout_ms stops an infinite loop", sp[2], false)
expect(ctx, "process: the timeout is reported", contains_text(sp[1], "timeout after 400 ms"), true)

# --- stdin (process only) ---
let echo = irt_src(["let a = read_line()", "let b = read_line()", "print(b + a)"])
let ei = interp_run(ctx, echo, [["stdin", "one" + nl + "two" + nl]])
expect(ctx, "stdin reaches the child", ei[0], "twoone" + nl)
let ew = interp_run(ctx, echo, [["backend", "world"], ["stdin", "x"]])
expect(ctx, "world backend refuses stdin rather than hanging", ew[2], false)

# --- includes resolved before running, on both backends ---
let inc = irt_src(["include \"lib/pset.patlang\"", "let s = pset_add(pset_new(), \"a\")", "print(pset_size(s))"])
let iw = interp_run(ctx, inc, [["backend", "world"], ["base_dir", "self_hosting"]])
let ip = interp_run(ctx, inc, [["backend", "process"], ["base_dir", "self_hosting"]])
expect(ctx, "world: include resolved via base_dir", iw[0], "1" + nl)
expect(ctx, "process: include resolved via base_dir", ip[0], "1" + nl)

# --- world-only: VFS in/out ---
let vsrc = irt_src(["vfs_write(\"/out/r\", vfs_read(\"/in/x\") + \"!\")"])
let vr = interp_run_full(ctx, vsrc, [["backend", "world"], ["vfs_in", [["/in/x", "hey"]]], ["vfs_out_prefix", "/out/"]])
expect(ctx, "vfs_out carries the child's write", vr[3][0][1], "hey!")

# --- the caller's world is untouched ---
ctx_set(ctx, "irt_k", "mine")
fact("irt_p", "a", "b")
let iso = irt_src(["print(get(\"__vars\", \"irt_k\"))", "set_var(\"irt_k\", \"theirs\")", "fact(\"irt_p\", \"c\", \"d\")"])
let ir1 = interp_run(ctx, iso, [["backend", "world"]])
expect(ctx, "child does not see the caller's var", ir1[0], nl)
expect(ctx, "caller var unchanged after the run", ctx_get(ctx, "irt_k"), "mine")
expect(ctx, "caller facts unchanged after the run", query("irt_p", "c", "_"), 0)

# --- many runs in a row ---
let n = 0
let last = ""
while n < 200 do
  let r = interp_run(ctx, irt_src(["let v = 1 + 1", "print(v)"]), [["backend", "world"]])
  let last = r[0]
  let n = n + 1
end
expect(ctx, "200 sequential world runs all work", last, "2" + nl)

# --- planner output is deterministic (HashSet iteration order used to leak into plan order) ---
let goap_src = read_file("self_hosting/examples/goap_parameterized_demo.patlang")
let goap_first = interp_run(ctx, goap_src, [["backend", "world"]])[0]
let goap_diffs = 0
let gi = 0
while gi < 15 do
  if interp_run(ctx, goap_src, [["backend", "world"]])[0] != goap_first then let goap_diffs = goap_diffs + 1 end
  let gi = gi + 1
end
expect(ctx, "a parameterized GOAP plan is identical across 15 runs", goap_diffs, 0)

# --- no backend at all is reported, not fatal ---
let none = interp_run(ctx, "print(1)", [["backend", "process"], ["pat_path", "does/not/exist.exe"]])
expect(ctx, "a missing pat.exe is ok=false, not a crash", none[2], false)

# --- syntax { ... } DSL blocks compile on both backends (#120) -- the
# self-hosted lexer/parser used by the world backend has no knowledge of
# this grammar at all, so without interp_compile expanding it first, a
# world-backend compile failed immediately with a generic parse error
# while the process backend succeeded for free (its spawned real pat.exe
# gets the native parser's own built-in syntax_dsl.rs support). Uses a
# real example (router_dsl_source.patlang) rather than a hand-rolled one --
# this grammar's trigger-matching is sensitive enough that a naive minimal
# repro silently fails to expand at all instead of raising a clear error.
let dsl_src = read_file("self_hosting/examples/router_dsl_source.patlang")
let dsl_w = interp_run_full(ctx, dsl_src, [["backend", "world"]])
let dsl_p = interp_run_full(ctx, dsl_src, [["backend", "process"]])
expect(ctx, "world: a syntax DSL program compiles and runs", dsl_w[2], true)
expect(ctx, "process: the same program also succeeds", dsl_p[2], true)
expect(ctx, "both backends agree on a syntax DSL program", dsl_w[0], dsl_p[0])

# --- world_run refuses while a fiber is alive (#120: documents an
# already-enforced, deliberate scope boundary -- concurrent isolates via
# fibers/parallel_map are not supported, not a bug to fix). world_run's
# own precondition checks (this one, and the stdin rejection above) raise
# as a genuine IR runtime error rather than returning ok=false -- unlike a
# CHILD program crashing INSIDE a world_run call, which world_run itself
# catches and reports as a value. Calling it directly here would crash
# this very selftest, so the repro runs in its own subprocess instead,
# exactly like interp_run's own process backend does for anything that
# might not return cleanly.
let fiber_repro = irt_src([
  "include \"lib/interp_run.patlang\"",
  "make a function called irt_fiber_gen takes unused returns done",
  "  while true do",
  "    fiber_yield(1)",
  "  end",
  "  return \"unreachable\"",
  "end",
  "let g = fiber_new(\"irt_fiber_gen\")",
  "let r = fiber_resume(g, 0)",
  "print(\"alive=\" + fiber_alive(g))",
  "let w = interp_run(\"print(1)\", [[\"backend\", \"world\"]])",
  "print(\"ok=\" + w[2])",
  "print(w[1])"
])
let fiber_result = interp_run_full(ctx, expand_includes(fiber_repro, "self_hosting"), [["backend", "process"]])
expect(ctx, "the fiber is alive mid-generator", starts_with(fiber_result[0], "alive=true"), true)
expect(ctx, "world_run refuses while a fiber is alive", fiber_result[2], false)
expect(ctx, "the refusal names the fiber as the reason", contains_text(fiber_result[1], "fiber"), true)

# --- print() with no args: interp_run's own two backends genuinely
# DIFFER (#120), confirmed here rather than assumed -- a plain `pat
# --ir-run` of `print()` alone emits one blank line (confirmed separately
# outside interp_run), and the process backend matches that (it spawns a
# real such process); but world_run's own captured-stdout handling (Rust,
# hosts.rs) returns "" (empty, not even a newline) for the exact same
# program -- a real divergence this corpus check didn't catch because no
# self_hosting/examples/*.patlang file happens to call print() with zero
# arguments. This looks like a genuine small gap in world_run's native
# stdout capture specifically for a zero-byte print, not an inherent
# platform difference -- left as a documented, regression-pinned known
# difference rather than fixed here, since fixing it means editing
# rust-runtime/src/ir/hosts.rs, outside this pass's self-hosted-library
# scope.
let bare_w = interp_run(ctx, "print()", [["backend", "world"]])
let bare_p = interp_run(ctx, "print()", [["backend", "process"]])
expect(ctx, "world: bare print() captures as empty, not even a newline", bare_w[0], "")
expect(ctx, "process: bare print() emits one blank line, UNLIKE world", bare_p[0], nl)

# --- #{...} interpolation: the interpreter's own print() (both interp_run
# backends go through it) never interpolates #{...} -- only the natively
# COMPILED runtime's own print (x64_runtime.patlang) does that. Not a
# backend-vs-backend divergence at all; both interp_run backends agree,
# confirmed here, with the real difference against the compiled runtime
# left undocumented until now.
let interp_w = interp_run(ctx, "print(\"#{1+1}\")", [["backend", "world"]])
let interp_p = interp_run(ctx, "print(\"#{1+1}\")", [["backend", "process"]])
expect(ctx, "world: #{...} is NOT interpolated by --ir-run's print", interp_w[0], "#{1+1}" + nl)
expect(ctx, "process: agrees with world -- neither interpolates #{...}", interp_p[0], "#{1+1}" + nl)

ctx_report(ctx)
