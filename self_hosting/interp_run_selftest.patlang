# Selftest for self_hosting/lib/interp_run.patlang: both backends, on v2.
#
# Run from the repo root, built by v2:
#   self_hosting/build/v2.exe self_hosting/interp_run_selftest.patlang self_hosting/build/interp_run_selftest.exe
#   self_hosting/build/interp_run_selftest.exe

include "lib/includes.patlang"
include "lib/gherkin.patlang"
include "lib/interp_run.patlang"

make a function called irt_src takes lines returns text
  let b = sb_new()
  let i = 0
  while i < list_len(lines) do
    sb_push(b, lines[i])
    sb_push(b, chr(10))
    let i = i + 1
  end
  return sb_str(b)
end

make a function called irt_fiber_gen takes unused returns done
  while true do
    fiber_yield(1)
  end
  return "unreachable"
end

let nl = chr(10)

let ctx = ctx_new()

# --- backend selection ---
expect(ctx, "auto picks the in-process world backend", interp_backend([]), "world")
expect(ctx, "backend:process is honoured", interp_backend([["backend", "process"]]), "process")
expect(ctx, "a wall-clock timeout needs the process backend", interp_backend([["timeout_ms", 1000]]), "process")
expect(ctx, "stdin needs the process backend", interp_backend([["stdin", "x"]]), "process")

# --- the same answer from both backends ---
let hello = irt_src(["print(\"hello\")", "print(2 * 21)"])
let w = interp_run(ctx, hello, [["backend", "world"]])
let p = interp_run(ctx, hello, [["backend", "process"]])
expect(ctx, "world: stdout is exactly the prints", w[0], "hello" + nl + "42" + nl)
expect(ctx, "process: stdout is exactly the prints", p[0], "hello" + nl + "42" + nl)
expect(ctx, "world: ok", w[2], true)
expect(ctx, "process: ok", p[2], true)
expect(ctx, "world: empty stderr", w[1], "")
expect(ctx, "process: empty stderr", p[1], "")

let prog = irt_src([
  "make a function called fib takes n returns r",
  "  if n < 2 then return n end",
  "  return fib(n - 1) + fib(n - 2)",
  "end",
  "let xs = []",
  "let i = 0",
  "while i < 10 do",
  "  let xs = list_push(xs, fib(i))",
  "  let i = i + 1",
  "end",
  "print(xs)",
  "print(\"done\" + \" \" + 1.5)"
])
let chk = interp_run_check(ctx, prog, [])
expect(ctx, "both backends agree on a function/list/loop program", chk[0], true)
expect(ctx, "interp_run_check reports no difference", chk[1], "")

# --- a stop: partial stdout kept, ok=false, what it said in stdout on both ---
let crash = irt_src(["print(\"before\")", "let x = no_such_function(1)", "print(\"not reached\")"])
let cw = interp_run(ctx, crash, [["backend", "world"]])
let cp = interp_run(ctx, crash, [["backend", "process"]])
expect(ctx, "world crash: ok=false", cw[2], false)
expect(ctx, "process crash: ok=false", cp[2], false)
expect(ctx, "world crash keeps partial stdout and says what stopped it", cw[0], "before" + nl + "host fn 'no_such_function' not found" + nl)
expect(ctx, "process crash keeps partial stdout and says what stopped it", cp[0], "before" + nl + "host fn 'no_such_function' not found" + nl)
let cc = interp_run_check(ctx, crash, [])
expect(ctx, "both backends agree on a crash", cc[0], true)
let failed = irt_src(["make a function called half takes n returns r", "  require n % 2 == 0", "  return n / 2", "end", "print(half(4))", "print(half(3))"])
let fc = interp_run_check(ctx, failed, [])
expect(ctx, "both backends agree on a failed require", fc[0], true)
expect(ctx, "a failed require is named", contains_text(interp_run(ctx, failed, [])[0], "precondition failed in half()"), true)

# --- bitwise operators ---
let bits = irt_src(["print(12 band 10)", "print(12 bor 3)", "print(12 bxor 5)", "print(1 shl 4)", "print(256 shr 2)", "print(bnot 0)"])
let bw = interp_run(ctx, bits, [["backend", "world"]])
expect(ctx, "world: bitwise operators run", bw[0], "8" + nl + "15" + nl + "9" + nl + "16" + nl + "64" + nl + "-1" + nl)
let bc = interp_run_check(ctx, bits, [])
expect(ctx, "both backends agree on bitwise operators", bc[0], true)

# --- a program that does not compile ---
let bad = interp_run(ctx, "print(1", [["backend", "world"]])
expect(ctx, "a parse error is ok=false", bad[2], false)
expect(ctx, "a parse error is reported as the interpreter reports it", starts_with(bad[0], "error: "), true)
let bad_p = interp_run(ctx, "print(1", [["backend", "process"]])
expect(ctx, "the process backend reports it the same way", starts_with(bad_p[0], "error: "), true)

# --- limits ---
let spin = irt_src(["while true do", "end"])
let sw = interp_run(ctx, spin, [["backend", "world"], ["max_steps", 5000]])
expect(ctx, "world: max_steps stops an infinite loop", sw[2], false)
expect(ctx, "world: the budget's stop says so", contains_text(sw[0], "step budget of 5000 exhausted"), true)
let sp = interp_run(ctx, spin, [["backend", "process"], ["timeout_ms", 2000]])
expect(ctx, "process: timeout_ms stops an infinite loop", sp[2], false)
expect(ctx, "process: the timeout is reported", contains_text(sp[1], "timeout after 2000 ms"), true)
let calls = irt_src(["make a function called down takes n returns r", "  if n == 0 then return 0 end", "  return down(n - 1)", "end", "print(down(100))", "print(down(100000))"])
let sc = interp_run(ctx, calls, [["max_steps", 1000]])
expect(ctx, "world: calls spend the budget too", sc[0], "0" + nl + "step budget of 1000 exhausted" + nl)

# --- stdin (process only) ---
let echo = irt_src(["let a = read_line()", "let b = read_line()", "print(b + a)"])
let ei = interp_run(ctx, echo, [["stdin", "one" + nl + "two" + nl]])
expect(ctx, "stdin reaches the child", ei[0], "twoone" + nl)
let ew = interp_run(ctx, echo, [["backend", "world"], ["stdin", "x"]])
expect(ctx, "world backend refuses stdin rather than hanging", ew[2], false)

# --- includes resolved before running, on both backends ---
let inc = irt_src(["include \"lib/pset.patlang\"", "let s = pset_add(pset_new(), \"a\")", "print(pset_size(s))"])
let iw = interp_run(ctx, inc, [["backend", "world"], ["base_dir", "self_hosting"]])
let ip = interp_run(ctx, inc, [["backend", "process"], ["base_dir", "self_hosting"]])
expect(ctx, "world: include resolved via base_dir", iw[0], "1" + nl)
expect(ctx, "process: include resolved via base_dir", ip[0], "1" + nl)

# --- world-only: VFS in/out ---
let vsrc = irt_src(["vfs_write(\"/out/r\", vfs_read(\"/in/x\") + \"!\")", "vfs_write(\"/other\", \"no\")"])
let vr = interp_run_full(ctx, vsrc, [["backend", "world"], ["vfs_in", [["/in/x", "hey"]]], ["vfs_out_prefix", "/out/"]])
expect(ctx, "vfs_out carries the child's write", vr[3], [["/out/r", "hey!"]])
expect(ctx, "the child's files are not the caller's", vfs_exists("/out/r"), false)

# --- the caller's world is untouched ---
fact("irt_p", "a", "b")
new("Widget", "irt_w")
vfs_write("/irt/mine", "mine")
let iso = irt_src(["print(query(\"irt_p\", \"a\", 0))", "print(get(\"irt_w\", \"type\"))", "print(vfs_exists(\"/irt/mine\"))", "fact(\"irt_p\", \"c\", \"d\")", "new(\"Widget\", \"irt_theirs\")", "vfs_write(\"/irt/theirs\", \"theirs\")"])
let ir1 = interp_run(ctx, iso, [["backend", "world"]])
# a missing field reads as unit, which prints as an empty line (spec 1.5)
expect(ctx, "child sees none of the caller's facts, objects and files", ir1[0], "0" + nl + nl + "false" + nl)
expect(ctx, "caller facts unchanged after the run", query("irt_p", "c", 0), 0)
expect(ctx, "caller objects unchanged after the run", get("irt_theirs", "type"), unit)
expect(ctx, "caller files unchanged after the run", vfs_exists("/irt/theirs"), false)
expect(ctx, "caller's own state still there", [query("irt_p", "a", 0), get("irt_w", "type"), vfs_read("/irt/mine")], [1, "Widget", "mine"])

# --- many runs in a row ---
let n = 0
let last = ""
let t0 = now_ms()
while n < 200 do
  let r = interp_run(ctx, irt_src(["let v = 1 + 1", "print(v)"]), [["backend", "world"]])
  let last = r[0]
  let n = n + 1
end
print("200 world runs: " + (now_ms() - t0) + " ms")
expect(ctx, "200 sequential world runs all work", last, "2" + nl)

# --- planner output is deterministic ---
let goap_src = read_file("self_hosting/examples/goap_parameterized_demo.patlang")
let goap_first = interp_run(ctx, goap_src, [["backend", "world"]])[0]
let goap_diffs = 0
let gi = 0
while gi < 15 do
  if interp_run(ctx, goap_src, [["backend", "world"]])[0] != goap_first then let goap_diffs = goap_diffs + 1 end
  let gi = gi + 1
end
expect(ctx, "the GOAP demo prints a plan", contains_text(goap_first, "plan"), true)
expect(ctx, "a parameterized GOAP plan is identical across 15 runs", goap_diffs, 0)
expect(ctx, "and the process backend prints the same plan", interp_run(ctx, goap_src, [["backend", "process"]])[0], goap_first)

# --- no backend at all is reported, not fatal ---
let none = interp_run(ctx, "print(1)", [["backend", "process"], ["pat_path", "does/not/exist.exe"]])
expect(ctx, "a missing interpreter is ok=false, not a crash", none[2], false)

# --- syntax { ... } DSL blocks compile on both backends ---
let dsl_src = read_file("self_hosting/examples/router_dsl_source.patlang")
let dsl_w = interp_run_full(ctx, dsl_src, [["backend", "world"]])
let dsl_p = interp_run_full(ctx, dsl_src, [["backend", "process"]])
expect(ctx, "world: a syntax DSL program compiles and runs", dsl_w[2], true)
expect(ctx, "process: the same program also succeeds", dsl_p[2], true)
expect(ctx, "both backends agree on a syntax DSL program", dsl_w[0], dsl_p[0])

# --- the world backend runs while a fiber is alive (spec 1.15: a fiber runs
# in the world it was made in, so a world does not disturb it) ---
let g = fiber_new("irt_fiber_gen")
fiber_resume(g, 0)
let fw = interp_run(ctx, irt_src(["print(1)"]), [["backend", "world"]])
expect(ctx, "a world run while a fiber is alive", fw[0], "1" + nl)
expect(ctx, "the fiber is still alive and resumes", [fiber_alive(g), fiber_resume(g, 0)], [true, 1])

# --- a call with the wrong number of arguments: refused when compiling, the
# same on both backends ---
let bare_c = interp_run_check(ctx, "print()", [])
expect(ctx, "both backends agree on print()", bare_c[0], true)
expect(ctx, "print() is refused", interp_run(ctx, "print()", [])[2], false)

# --- #{...} is text: neither backend interpolates it ---
let interp_c = interp_run_check(ctx, "print(\"#{1+1}\")", [])
expect(ctx, "both backends agree on #{...}", interp_c[0], true)
expect(ctx, "#{...} prints as written", interp_run(ctx, "print(\"#{1+1}\")", [])[0], "#{1+1}" + nl)

ctx_report(ctx)
