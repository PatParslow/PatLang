# ir_well_formed (ir.patlang), the compiler's contract on every function it
# lowers. Given functions whose jumps go to labels that exist, are missing,
# are negative or lie past the last label, then it accepts only the first.
# Given a function of N branches, each to its own labels, then checking it
# takes time in proportion to N: it ran three times per function on every
# build, and once searched the labels from the front for every jump, which
# was most of a build's time (review finding O7).
include "v2/ir.patlang"
include "lib/gherkin.patlang"
include "lib/cost_check.patlang"

make a function called wf_branches takes n returns func
  let instrs = [["const", 0, "bool", "true"]]
  let i = 0
  while i < n do
    let instrs = list_push(instrs, ["branch", 0, 2 * i, 2 * i + 1])
    let instrs = list_push(instrs, ["label", 2 * i])
    let instrs = list_push(instrs, ["label", 2 * i + 1])
    let i = i + 1
  end
  let instrs = list_push(instrs, ["return", 0])
  return ir_fn("wf", 0, 1, instrs, [0])
end

make a function called wf_jump_to takes target returns func
  return ir_fn("wf", 0, 1, [["const", 0, "unit", ""], ["label", 0], ["label", 3], ["jump", target], ["return", 0]], [0])
end

let ctx = ctx_new()
expect(ctx, "a jump to a label that exists", ir_well_formed(wf_jump_to(3), false), true)
expect(ctx, "a jump to a label between two that exist", ir_well_formed(wf_jump_to(1), false), false)
expect(ctx, "a jump past the last label", ir_well_formed(wf_jump_to(4), false), false)
expect(ctx, "a jump to a negative label", ir_well_formed(wf_jump_to(0 - 1), false), false)
expect(ctx, "a branch whose second label is missing", ir_well_formed(ir_fn("wf", 0, 1, [["const", 0, "bool", "true"], ["label", 0], ["branch", 0, 0, 9], ["return", 0]], [0]), false), false)
expect(ctx, "a function of 1000 branches", ir_well_formed(wf_branches(1000), false), true)

# each time the cheapest of several readings after a warm-up
# (lib/cost_check.patlang, #284)
let sizes = [2000, 4000, 8000]
let fns = [wf_branches(2000), wf_branches(4000), wf_branches(8000)]
let reader = |f| do
  return || do
    let t0 = cpu_cycles()
    ir_well_formed(f, false)
    return cpu_cycles() - t0
  end
end
let times = cheapest_cycles([reader(fns[0]), reader(fns[1]), reader(fns[2])], cost_rounds())
let k = 0
while k < list_len(sizes) do
  print(sizes[k] + " branches: " + times[k] + " cycles")
  let k = k + 1
end
# linear: four times the branches take well under eight times as long
expect(ctx, "8000 branches in proportion to 2000", times[2] <= 8 * times[0] + 60000000, true)
ctx_report(ctx)
