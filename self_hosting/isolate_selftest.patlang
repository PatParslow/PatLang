# Selftest for self_hosting/lib/mailbox.patlang and lib/isolate.patlang.
#
# Run from the repo root, built by v2:
#   self_hosting/build/v2.exe self_hosting/isolate_selftest.patlang self_hosting/build/isolate_selftest.exe
#   self_hosting/build/isolate_selftest.exe
#
# An isolate's turn runs in a world of its own (docs/spec/values-and-memory.md
# 1.15), in-process, on any v2 program.

include "lib/includes.patlang"
include "lib/gherkin.patlang"
include "lib/isolate.patlang"

let nl = chr(10)

make a function called ist_src takes lines returns text
  let b = sb_new()
  let i = 0
  while i < list_len(lines) do
    sb_push(b, lines[i])
    sb_push(b, chr(10))
    let i = i + 1
  end
  return sb_str(b)
end

let ctx = ctx_new()

# --- mailbox: ordering, ack, at-least-once ---
let a = mbox_put("box", "alice", "first")
let b = mbox_put("box", "bob", "second")
let c = mbox_put("box", "alice", "third")
expect(ctx, "ids are unique", a != b and b != c, true)
expect(ctx, "count reports pending messages", mbox_count("box"), 3)
expect(ctx, "ids list oldest first", mbox_ids("box")[0], a)
let p = mbox_peek("box")
expect(ctx, "peek returns the oldest payload", p[1], "first")
expect(ctx, "peek does not remove", mbox_count("box"), 3)
mbox_ack("box", p[0])
expect(ctx, "ack removes exactly that message", mbox_count("box"), 2)
let t = mbox_take("box")
expect(ctx, "take returns the next oldest", t[1], "second")
let d = mbox_drain("box")
expect(ctx, "drain returns what is left in order", d[0][1], "third")
expect(ctx, "drain empties the box", mbox_count("box"), 0)
expect(ctx, "peek on an empty box is empty", list_len(mbox_peek("box")), 0)
let e = mbox_put("box", "alice", "later")
expect(ctx, "ids are never reused after a box empties", e != a and e != b and e != c, true)
expect(ctx, "boxes are independent", mbox_count("other"), 0)

# --- isolate: a turn runs in a world ("turns"), in-process, on any v2
# program; the process backend is there too when an interpreter is.
let top_caps = isolate_caps()
if top_caps[0] == "turns" then
  # --- a stateful ping-pong across turns ---
  let worker = ist_src([
    "include \"lib/mailbox.patlang\"",
    "let n = 0",
    "if vfs_exists(\"/state/n\") == \"1\" then",
    "  let n = to_num(vfs_read(\"/state/n\"))",
    "end",
    "let msgs = mbox_drain(\"in\")",
    "let i = 0",
    "while i < list_len(msgs) do",
    "  let n = n + 1",
    "  mbox_put(\"out\", vfs_read(\"/__iso__/self\"), \"pong:\" + msgs[i][1] + \"#\" + n)",
    "  let i = i + 1",
    "end",
    "vfs_write(\"/state/n\", \"\" + n)"
  ])
  let expanded = expand_includes(worker, "self_hosting")
  let h = isolate_start(ctx, expanded, [])
  expect(ctx, "the worker compiles", isolate_ok(h), true)
  let h2 = isolate_start(ctx, expanded, [])
  expect(ctx, "each isolate gets its own id", h[0] != h2[0], true)

  isolate_send(h, "main", "a")
  isolate_send(h, "main", "b")
  expect(ctx, "messages wait in the inbox until a turn runs", isolate_pending(h), 2)
  let r1 = isolate_step(ctx, h)
  expect(ctx, "the first turn succeeds", r1[0], true)
  expect(ctx, "the turn consumed the inbox", isolate_pending(h), 0)
  let out1 = isolate_recv(h)
  expect(ctx, "both replies came back", list_len(out1), 2)
  expect(ctx, "replies keep order", out1[0][1], "pong:a#1")
  expect(ctx, "second reply carries updated state", out1[1][1], "pong:b#2")
  expect(ctx, "the child knew its own id", starts_with(out1[0][0], "0000000001~iso"), true)
  expect(ctx, "recv empties the outbox", list_len(isolate_recv(h)), 0)

  isolate_send(h, "main", "c")
  let r2 = isolate_step(ctx, h)
  let out2 = isolate_recv(h)
  expect(ctx, "state persisted across turns", out2[0][1], "pong:c#3")
  expect(ctx, "the parent can read the isolate's state", isolate_state(h, "n"), "3")
  expect(ctx, "turns are counted", isolate_turns(h), 2)

  # --- isolation ---
  expect(ctx, "the other isolate's state is untouched", isolate_state(h2, "n"), "")
  expect(ctx, "the parent's own vfs has no leaked /state", vfs_exists("/state/n") == "1", false)
  ctx_set(ctx, "ist_k", "parent")
  let leak = ist_src(["set_var(\"ist_k\", \"child\")", "fact(\"ist_f\", \"a\", \"b\")"])
  let hl = isolate_start(ctx, leak, [])
  isolate_step(ctx, hl)
  expect(ctx, "a child's variables do not reach the parent", ctx_get(ctx, "ist_k"), "parent")
  expect(ctx, "a child's facts do not reach the parent", query("ist_f", "a", "_"), 0)

  # --- a failed turn commits nothing and keeps the message ---
  let crashy = ist_src([
    "include \"lib/mailbox.patlang\"",
    "vfs_write(\"/state/touched\", \"yes\")",
    "let m = mbox_take(\"in\")",
    "let x = no_such_function(1)"
  ])
  let hc = isolate_start(ctx, expand_includes(crashy, "self_hosting"), [])
  isolate_send(hc, "main", "keep me")
  let rc = isolate_step(ctx, hc)
  expect(ctx, "a crashing turn reports failure", rc[0], false)
  expect(ctx, "its writes were rolled back", isolate_state(hc, "touched"), "")
  expect(ctx, "its inbox message is still there", isolate_pending(hc), 1)
  expect(ctx, "a failed turn is not counted", isolate_turns(hc), 0)

  # --- step budget per isolate ---
  let spin = isolate_start(ctx, ist_src(["while true do", "end"]), [["max_steps", 3000]])
  let rs = isolate_step(ctx, spin)
  expect(ctx, "an isolate that never returns is stopped by its budget", rs[0], false)
  expect(ctx, "the budget's stop is reported", contains_text(rs[1], "step budget of 3000 exhausted"), true)

  # --- run_until_idle ---
  let hi = isolate_start(ctx, expanded, [])
  isolate_send(hi, "main", "x")
  isolate_send(hi, "main", "y")
  let idle = isolate_run_until_idle(ctx, hi, 5)
  expect(ctx, "run_until_idle stops when the inbox is empty", idle[1], true)
  expect(ctx, "one turn was enough to drain both", idle[0], 1)

  # --- a bad program is reported, not fatal ---
  let bad = isolate_start(ctx, "print(1", [])
  expect(ctx, "a source that does not compile gives no isolate", isolate_ok(bad), false)
  expect(ctx, "the compile error is reported as the interpreter reports it", starts_with(bad[1], "error: "), true)

  expect(ctx, "isolate_caps lists turn-based isolates", isolate_caps()[0], "turns")
end

# --- process backend: the same isolate semantics, but each turn runs by
# spawning a separate interpreter process instead of in a world
# (self_hosting/lib/isolate_process.patlang), forced with ["backend",
# "process"]. Needs "subprocess", which an engine in the browser has not, so
# there it is skipped; where processes can start, a missing interpreter fails.
if iri_has_cap("subprocess") == false then
  expect(ctx, "process backend skipped: this engine starts no processes", true, true)
elif not expect(ctx, "the interpreter the process backend starts is there", file_exists(interp_pat_path([])), true) then
  print("  (" + interp_pat_path([]) + " is missing)")
else
  let popts = [["backend", "process"]]
  let pworker = ist_src([
    "include \"lib/mailbox.patlang\"",
    "let n = 0",
    "if vfs_exists(\"/state/n\") == \"1\" then",
    "  let n = to_num(vfs_read(\"/state/n\"))",
    "end",
    "let msgs = mbox_drain(\"in\")",
    "let i = 0",
    "while i < list_len(msgs) do",
    "  let n = n + 1",
    "  mbox_put(\"out\", vfs_read(\"/__iso__/self\"), \"pong:\" + msgs[i][1] + \"#\" + n)",
    "  let i = i + 1",
    "end",
    "vfs_write(\"/state/n\", \"\" + n)"
  ])
  let pexpanded = expand_includes(pworker, "self_hosting")
  let ph = isolate_start(ctx, pexpanded, popts)
  expect(ctx, "process backend: the worker compiles", isolate_ok(ph), true)
  let ph2 = isolate_start(ctx, pexpanded, popts)
  expect(ctx, "process backend: each isolate gets its own id", ph[0] != ph2[0], true)

  isolate_send(ph, "main", "a")
  isolate_send(ph, "main", "b")
  expect(ctx, "process backend: messages wait in the inbox until a turn runs", isolate_pending(ph), 2)
  let pr1 = isolate_step(ctx, ph)
  expect(ctx, "process backend: the first turn succeeds", pr1[0], true)
  expect(ctx, "process backend: the turn consumed the inbox", isolate_pending(ph), 0)
  let pout1 = isolate_recv(ph)
  expect(ctx, "process backend: both replies came back", list_len(pout1), 2)
  expect(ctx, "process backend: replies keep order", pout1[0][1], "pong:a#1")
  expect(ctx, "process backend: second reply carries updated state", pout1[1][1], "pong:b#2")

  isolate_send(ph, "main", "c")
  let pr2 = isolate_step(ctx, ph)
  let pout2 = isolate_recv(ph)
  expect(ctx, "process backend: state persisted across a spawned turn", pout2[0][1], "pong:c#3")
  expect(ctx, "process backend: the parent can read the isolate's state", isolate_state(ph, "n"), "3")
  expect(ctx, "process backend: turns are counted", isolate_turns(ph), 2)

  # --- isolation (even more strongly true here -- a different OS process,
  # not just a swapped world in the same process memory -- but still worth
  # asserting for parity with the world backend's own guarantee) ---
  expect(ctx, "process backend: the other isolate's state is untouched", isolate_state(ph2, "n"), "")
  ctx_set(ctx, "ist_pk", "parent")
  let pleak = ist_src(["set_var(\"ist_pk\", \"child\")", "fact(\"ist_pf\", \"a\", \"b\")"])
  let phl = isolate_start(ctx, pleak, popts)
  isolate_step(ctx, phl)
  expect(ctx, "process backend: a child's variables do not reach the parent", ctx_get(ctx, "ist_pk"), "parent")
  expect(ctx, "process backend: a child's facts do not reach the parent", query("ist_pf", "a", "_"), 0)

  # --- a failed turn commits nothing and keeps the message ---
  let pcrashy = ist_src([
    "include \"lib/mailbox.patlang\"",
    "vfs_write(\"/state/touched\", \"yes\")",
    "let m = mbox_take(\"in\")",
    "let x = no_such_function(1)"
  ])
  let phc = isolate_start(ctx, expand_includes(pcrashy, "self_hosting"), popts)
  isolate_send(phc, "main", "keep me")
  let prc = isolate_step(ctx, phc)
  expect(ctx, "process backend: a crashing turn reports failure", prc[0], false)
  expect(ctx, "process backend: its writes were rolled back", isolate_state(phc, "touched"), "")
  expect(ctx, "process backend: its inbox message is still there", isolate_pending(phc), 1)
  expect(ctx, "process backend: a failed turn is not counted", isolate_turns(phc), 0)

  # --- budget: wall-clock timeout_ms, NOT max_steps (the world backend's
  # option) -- a plain subprocess has no step-count instrumentation to
  # enforce, only how long exec_capture_io is willing to wait for it.
  let pspin = isolate_start(ctx, ist_src(["while true do", "end"]), [["backend", "process"], ["timeout_ms", 2000]])
  let prs = isolate_step(ctx, pspin)
  expect(ctx, "process backend: an isolate that never returns is stopped by timeout_ms", prs[0], false)

  # --- run_until_idle works the same regardless of backend ---
  let phi = isolate_start(ctx, pexpanded, popts)
  isolate_send(phi, "main", "x")
  isolate_send(phi, "main", "y")
  let pidle = isolate_run_until_idle(ctx, phi, 5)
  expect(ctx, "process backend: run_until_idle stops when the inbox is empty", pidle[1], true)
  expect(ctx, "process backend: one turn was enough to drain both", pidle[0], 1)
end

# --- a signal into an isolate: the parent sends, the child polls in its turn ---
let sig_child = ist_src(["signal_use_driver(\"vfs\")", "when ping do", "  signal_reply(\"pong from the isolate\")", "end", "signal_poll(9601, 0)"])
let sig_src = expand_includes("include \"lib/signals.patlang\"" + nl + sig_child, "self_hosting")
let sh = isolate_start(ctx, sig_src, [])
expect(ctx, "the signalled isolate compiles", isolate_ok(sh), true)
let smid = mbox_put_ns("/iso/" + sh[0], "sig/9601", "parent", "ping" + nl + "hello")
let sturn = isolate_step(ctx, sh)
expect(ctx, "the signalled isolate's turn succeeded", sturn[0], true)
expect(ctx, "the isolate took the signal from its box", mbox_count_ns("/iso/" + sh[0], "sig/9601"), 0)
expect(ctx, "the reply is in the isolate's namespace", vfs_read("/iso/" + sh[0] + "/sig/9601/reply/" + smid), "pong from the isolate")

ctx_report(ctx)
