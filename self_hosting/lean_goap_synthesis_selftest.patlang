# check()/t_report() regression coverage for self_hosting/examples/
# lean_goap_synthesis_demo.patlang -- a GOAP-planned action sequence
# synthesized into real Lean 4 source, verified two independent ways
# (the actual `lean` binary, and this project's own self-hosted Lean
# frontend). Requires `lean` on PATH -- lean_run_file shells out to it
# for real, this is not simulated.

include "lib/test.patlang"
include "lib/goap_snippet_synthesis.patlang"
include "lib/utf8.patlang"
include "lib/lean_lexer.patlang"
include "lib/lean_parser.patlang"
include "lib/lean_run.patlang"

t_init()

action_add("gather_wood", [], [["have", ["wood"]]], [], 1)
action_add("build_house", [["have", ["wood"]]], [["have", ["house"]]], [], 1)
let plan1 = plan([["have", ["house"]]])
check("plan finds the two-step sequence", to_num(list_len(plan1)), 2)

let synth_lean = synthesize_program(plan1, snippet_dict_lean(), [])
check("the SAME plan assembles against a Lean dict too (proves the polyglot design generalizes past two scripting languages)", synth_lean[0], "OK")

let lean_src = synth_lean[1]
check("Lean-specific syntax genuinely differs from the PatLang/Python dicts (++, not +)", contains_text(lean_src, "++"), true)

let lean_path = "self_hosting/build/lean_goap_synthesis_selftest_demo.lean"
write_file(lean_path, lean_src)
let run_result = lean_run_file(lean_path)
check("the real `lean` binary genuinely runs the synthesized source successfully", run_result[0], "ok")
check("build_house's snippet correctly reads gather_wood's `wood` (composition, same convention as the PatLang/Python demo)", contains_text(run_result[1], "house built from wood"), true)

let lean_ast = lean_parse(lean_tokenize(lean_src))
let def_wood = lean_find_command(lean_ast, "def")
check("this project's OWN self-hosted Lean frontend independently agrees the generated text is well-formed Lean (finds the first def by name)", def_wood[2], "wood")

t_report()
