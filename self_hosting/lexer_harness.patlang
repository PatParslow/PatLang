# Self-hosting Lexer Harness
# Produces a list of token maps for a tiny input and prints a summary.

# Input program
let src = "print \"hello\"\nprint \"world\"\n";


# Initialize native lexer
initialize_lexer(src)

# Tokens list id we build up
let tokens = list_new()

# Small helpers
make a function called push_token takes ttype, text returns ok
  let m = map_new()
  map_set(m, "type", ttype)
  map_set(m, "text", text)
  tokens.add(m)
  ok = "true"
end

# Minimal scanning loop: number, identifier, string, or single char
make a function called scan_once returns progressed
  let ch = current_char()
  if ch = nil {
    progressed = "false"
  } else {
    if is_whitespace(ch) {
      skip_whitespace()
      progressed = "true"
    } else {
      if is_digit(ch) {
        let txt = extract_number()
        push_token("NUMBER", txt)
        progressed = "true"
      } else {
        if can_start_identifier(ch) {
          # Small helpers
          fn push_token(list, ttype, text) {
            let m = map_new()
            map_set(m, "type", ttype)
            map_set(m, "text", text)
            list.add(m)
          }

          # Minimal scanning step: number, identifier, string, or single char
          fn scan_once(tokens) {
            let ch = current_char()
            if ch = nil {
              return "false"
            }
            if is_whitespace(ch) {
              skip_whitespace()
              return "true"
            }
            if is_digit(ch) {
              let txt = extract_number()
              push_token(tokens, "NUMBER", txt)
              return "true"
            }
            if can_start_identifier(ch) {
              let txt = extract_identifier()
              push_token(tokens, "IDENT", txt)
              return "true"
            }
            if is_quote(ch) {
              let txt = extract_string()
              push_token(tokens, "STRING", txt)
              return "true"
            }
            # single char
            let one = ch
            advance_position()
            push_token(tokens, "CHAR", one)
            return "true"
          }

          fn main() {
            # Input program
            let src = "print \"hello\"\nprint \"world\"\n"
            initialize_lexer(src)
            let tokens = list_new()

            # Main loop
            let guard = 0
            while guard < 1000 do
              if at_end_of_input() {
                break
              }
              let p = scan_once(tokens)
              if p = "false" {
                break
              }
              guard = guard + 1
            end

            # Emit EOF token
            push_token(tokens, "EOF", "")

            # Print summary
            let n = list_len(tokens)
            print("TOKENS: " + n)
            let first = list_get(tokens, 0)
            let last = list_get(tokens, n - 1)
            print("FIRST: " + get(first, "type"))
            print("LAST: " + get(last, "type"))
          }

          main()
