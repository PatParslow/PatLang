# =============================================================================
# Stage 1 self-hosted lexer demo: tokenize a small PatLang program and print
# the token stream. The lexer itself lives in lib/lexer.patlang and is written
# in the Stage 0 compilable subset — it runs under pat --ir-run and compiles
# to a native executable via patc with identical output.
# =============================================================================

include "lib/lexer.patlang"

let sample = "let x = 41\nprint(x + 1)\n# a comment\nlet s = \"hi there\"\nif x >= 40 then print(s) end\n"
let toks = tokenize(sample)
print("TOKENS: " + toks.length)
print_tokens(toks)
