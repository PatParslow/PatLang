# Real-function implementations of the Block Ownership Model's own
# established sugar names (self_hosting/block_model/lower.patlang) --
# get_global/set_global/handler_new/handler_register/handler_lookup --
# so ordinary PatLang library code written against them runs correctly
# under BOTH the real engine (`pat --ir-run`/`--patc`) AND the block-
# model engine (`bm_lower_program`/`bi_run`), from the SAME unmodified
# source. block-model's own lowerer always intercepts these exact names
# by an earlier, hardcoded match in its own Call dispatch, before any
# declared-function lookup ever runs -- so under block-model, this
# file's own function BODIES are never actually reached at all (they
# exist only so the file parses/lowers as ordinary, harmless
# declarations); under the real engine, they give these names real,
# working semantics. Confirmed no name-collision risk with block-model's
# own dispatch this way, not assumed.
#
# Written while porting self_hosting/lib/{zs_schema,schema_bdd,zs_expr}
# .patlang off `new("Dict", ...)` + ambient set_var/get -- the "ephemeral
# majority" pattern docs/plans/block-ownership-model.md's own Fork B
# (section 6) was designed to eliminate, and which block-model's own
# `new(...)` genuinely cannot run at all (Phase 13 only supports its
# `class`-declared form). Kept as its own small, dependency-free file
# (not bundled into any ONE of those three) because each is also
# included independently elsewhere (e.g. self_hosting/zs_expr_selftest
# .patlang includes zs_expr.patlang alone) -- a shared file every
# consumer can `include` directly avoids relying on fragile transitive-
# include ordering between them.

# get_global's own "absent" case matters here specifically: the real
# `get("__vars", key)` returns Unit for a key never set, but block-
# model's own GlobalGet returns `false` -- normalized here so a
# singleton-registry's own "does it already exist" check (by TYPE, not
# truthiness -- see zs_registry's own comment for why truthiness alone
# is a real trap) behaves identically under both engines.
make a function called get_global takes name returns v
  let v = get("__vars", name)
  if type_of(v) == "unit" then
    return false
  end
  return v
end

make a function called set_global takes name, value returns done
  set_var(name, value)
  return true
end

# Mirrors self_hosting/block_model/interp.patlang's own bm_rt_assoc_get/
# bm_rt_assoc_set exactly (an ordinary assoc-list, rebuilt via list_push
# only on write -- never list_set, for the same issue #145 native x64
# aliasing reason that file's own header already documents) -- not a
# new design, a real-function twin of an already-proven one.
make a function called handler_new returns h
  return []
end

make a function called handler_lookup takes h, name returns v
  let n = list_len(h)
  let i = 0
  while i < n do
    let entry = list_get(h, i)
    if list_get(entry, 0) == name then
      return list_get(entry, 1)
    end
    let i = i + 1
  end
  return false
end

make a function called handler_register takes h, name, ref returns out
  let n = list_len(h)
  let out = []
  let replaced = false
  let i = 0
  while i < n do
    let entry = list_get(h, i)
    if list_get(entry, 0) == name then
      let out = list_push(out, [name, ref])
      let replaced = true
    else
      let out = list_push(out, entry)
    end
    let i = i + 1
  end
  if replaced then
    return out
  end
  return list_push(out, [name, ref])
end
