# Minimal argv-handling helpers.
#
# Factors out a pattern found duplicated ad hoc across 10+
# self_hosting/tools/*_main.patlang files (confirmed directly in
# coverage_main.patlang lines 90-100: `let args = argv()`, a bare
# `if args.length < N` check, a hand-written "usage: ..." string, and a
# manual `if args.length >= 2 then let x = args[1] end` for an optional
# positional arg) -- one implementation instead of N near-identical ones.
#
# Deliberately minimal: positional args only, matching what those files
# actually need. Not a flag-parsing framework -- friendly_cli's own
# meta-command dispatch (help/status/history/heal-config) needs a
# command-NAME lookup, not just positional args by index, so that stays
# friendly_cli-specific logic built on top of these primitives, not
# folded in here.

# require_args(args, min_count, usage_text) -> true if args has at least
# min_count entries; otherwise prints usage_text and returns false.
# Callers follow the same "if not require_args(...) then return false end"
# shape the duplicated code already used, just with one implementation.
make a function called require_args takes args, min_count, usage_text returns ok
  if args.length < min_count then
    print(usage_text)
    return false
  end
  return true
end

# arg_or_default(args, index, default_val) -> args[index] if present,
# else default_val. Replaces the "if args.length >= N+1 then let x =
# args[N] end" pattern for optional positional args.
make a function called arg_or_default takes args, index, default_val returns value
  if args.length > index then
    return args[index]
  end
  return default_val
end
