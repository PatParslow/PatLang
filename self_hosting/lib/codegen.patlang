# =============================================================================
# Stage 1 self-hosted code generator (Stage 0 compilable subset).
# Walks the list-shaped IR from lib/lower.patlang and emits the Rust source
# text of the program-builder section. Combined with the fixed runtime
# prelude (codegen_prelude host), this is the complete emitted program —
# the host back end is reduced to "write file, run rustc" (rustc_build).
#
# Uses chr(34)/chr(10) for quotes/newlines so this file stays inside the
# escape-free Stage 1 dialect (ready for eventual self-compilation).
# =============================================================================

make a function called q returns s
  return chr(34)
end

make a function called nl returns s
  return chr(10)
end

make a function called rs_escape takes s returns out
  # sb_new/sb_push/sb_str + str_intern/sc_code, NOT `out = out + ...` /
  # char_code(s,i) -- both are the same O(n^2) anti-pattern found (and
  # fixed) in self_hosting/lib/syntax_dsl.patlang and lib/lexer.patlang:
  # string concatenation copies the whole accumulated string per append,
  # and char_code/substr recompute an O(n) is-ascii check on every call.
  # rs_escape is exactly the kind of function that needs this fix most:
  # it's called to escape entire embedded Rust-source chunks (see
  # runtime_rs.patlang's PRELUDE_* mirrors) into Rust string literals,
  # sometimes tens of thousands of characters at a time.
  let h = str_intern(s)
  let n = sc_len(h)
  let out = sb_new()
  let i = 0
  while i < n do
    let c = sc_code(h, i)
    if c == 92 then
      sb_push(out, chr(92) + chr(92))
    else
      if c == 34 then
        sb_push(out, chr(92) + chr(34))
      else
        if c == 10 then
          sb_push(out, chr(92) + "n")
        else
          if c == 9 then
            sb_push(out, chr(92) + "t")
          else
            if c == 13 then
              sb_push(out, chr(92) + "r")
            else
              sb_push(out, sc_char(h, i))
            end
          end
        end
      end
    end
    let i = i + 1
  end
  return sb_str(out)
end

# Rust expression for an owned string: "escaped".to_string()
make a function called rs_str takes s returns out
  return q() + rs_escape(s) + q() + ".to_string()"
end

make a function called binop_name takes op returns name
  if op == "+" then
    return "Add"
  else
    if op == "-" then
      return "Sub"
    else
      if op == "*" then
        return "Mul"
      else
        if op == "/" then
          return "Div"
        else
          if op == "%" then
            return "Mod"
          else
            if op == "==" then
              return "Eq"
            else
              if op == "!=" then
                return "Ne"
              else
                if op == "<" then
                  return "Lt"
                else
                  if op == "<=" then
                    return "Le"
                  else
                    if op == ">" then
                      return "Gt"
                    else
                      if op == ">=" then
                        return "Ge"
                      else
                        if op == "and" then
                          return "And"
                        else
                          if op == "or" then
                            return "Or"
                          else
                            if op == "band" then
                              return "BitAnd"
                            else
                              if op == "bor" then
                                return "BitOr"
                              else
                                if op == "bxor" then
                                  return "BitXor"
                                else
                                  if op == "shl" then
                                    return "Shl"
                                  else
                                    if op == "shr" then
                                      return "Shr"
                                    else
                                      return "Eq"
                                    end
                                  end
                                end
                              end
                            end
                          end
                        end
                      end
                    end
                  end
                end
              end
            end
          end
        end
      end
    end
  end
end

# Stage 38: mirrors ir/lowering.rs's Int-by-default/Float-if-decimal-point
# rule (Const's "num" text is the raw literal source text, so a "." anywhere
# in it is exactly the same discriminator the host lexer/lowerer uses).
make a function called text_has_dot takes s returns found
  let i = 0
  while i < s.length do
    if char_code(s, i) == 46 then
      return true
    end
    let i = i + 1
  end
  return false
end

make a function called emit_instr_rs takes instr returns out
  let ty = instr[0]
  if ty == "Const" then
    let kind = instr[1]
    if kind == "num" then
      if text_has_dot(instr[2]) then
        return "Instr::Const(Value::Float(" + instr[2] + "))"
      else
        return "Instr::Const(Value::Int(" + instr[2] + "))"
      end
    else
      if kind == "str" then
        return "Instr::Const(Value::String(" + rs_str(instr[2]) + ".into()))"
      else
        return "Instr::Const(Value::Bool(" + instr[2] + "))"
      end
    end
  else
    if ty == "Load" then
      return "Instr::LoadLocal(" + rs_str(instr[1]) + ")"
    else
      if ty == "Store" then
        return "Instr::StoreLocal(" + rs_str(instr[1]) + ")"
      else
        if ty == "Bin" then
          return "Instr::BinOp(BinOpKind::" + binop_name(instr[1]) + ")"
        else
          if ty == "Un" then
            if instr[1] == "not" then
              return "Instr::UnOp(UnOpKind::Not)"
            else
              if instr[1] == "bnot" then
                return "Instr::UnOp(UnOpKind::BitNot)"
              else
                return "Instr::UnOp(UnOpKind::Neg)"
              end
            end
          else
            if ty == "Jump" then
              return "Instr::Jump(" + instr[1] + ")"
            else
              if ty == "JumpIfFalse" then
                return "Instr::JumpIfFalse(" + instr[1] + ")"
              else
                if ty == "CallHost" then
                  return "Instr::CallHost(" + rs_str(instr[1]) + ", " + instr[2] + ")"
                else
                  if ty == "Call" then
                    return "Instr::Call(" + rs_str(instr[1]) + ", " + instr[2] + ")"
                  else
                    if ty == "MakeClosure" then
                      let names = instr[2]
                      let b = sb_new()
                      sb_push(b, "Instr::MakeClosure(" + rs_str(instr[1]) + ", vec![")
                      let k = 0
                      while k < names.length do
                        if k > 0 then
                          sb_push(b, ", ")
                        end
                        sb_push(b, rs_str(names[k]))
                        let k = k + 1
                      end
                      sb_push(b, "])")
                      return sb_str(b)
                    else
                      if ty == "CallValue" then
                        return "Instr::CallValue(" + instr[1] + ")"
                      else
                        if ty == "BuildList" then
                          return "Instr::BuildList(" + instr[1] + ")"
                        else
                          return "Instr::Return"
                        end
                      end
                    end
                  end
                end
              end
            end
          end
        end
      end
    end
  end
end

make a function called emit_build_program takes ir returns out
  let b = sb_new()
  sb_push(b, "fn build_program() -> Program {" + nl())
  sb_push(b, "    let mut functions: HashMap<String, Function> = HashMap::new();" + nl())
  sb_push(b, "    // Seed event handlers registry from embedded Program" + nl())
  let events = ir[3]
  let i = 0
  while i < events.length do
    let ev = events[i]
    sb_push(b, "    event_handlers_register(" + rs_str(ev[1]) + ", " + rs_str(ev[2]) + ");" + nl())
    let i = i + 1
  end
  let funcs = ir[2]
  let i = 0
  while i < funcs.length do
    let f = funcs[i]
    sb_push(b, "    // function " + f[1] + nl())
    sb_push(b, "    let mut body: Vec<Instr> = Vec::new();" + nl())
    let instrs = f[3]
    let k = 0
    while k < instrs.length do
      sb_push(b, "    body.push(" + emit_instr_rs(instrs[k]) + ");" + nl())
      let k = k + 1
    end
    sb_push(b, "    let params: Vec<String> = vec![")
    let params = f[2]
    let k = 0
    while k < params.length do
      if k > 0 then
        sb_push(b, ", ")
      end
      sb_push(b, rs_str(params[k]))
      let k = k + 1
    end
    sb_push(b, "];" + nl())
    sb_push(b, "    functions.insert(" + rs_str(f[1]) + ", Function { name: " + rs_str(f[1]) + ", params, body });" + nl())
    let i = i + 1
  end
  sb_push(b, "    Program { functions, entry: " + rs_str(ir[1]) + " }" + nl())
  sb_push(b, "}" + nl())
  return sb_str(b)
end

# main() used to come for free as part of emit_runtime_rs()'s output
# (embedded statically in PRELUDE_CORE's mirrored text); it had to move
# here once main() itself moved out of PRELUDE_CORE in codegen.rs (Stage
# 40, the --patc prelude chunk-precompile-and-link investigation) --
# main() calls build_program() and needs to register call_dispatch via
# set_dispatch_fallback, both genuinely per-program, so a shared/
# precompiled runtime library can no longer provide it. Byte-for-byte
# mirror of the Rust text codegen.rs's emit_rust now generates in the
# same spot -- see the patlang-patc-prelude-chunk-linking-investigation
# memory for the reasoning on both sides.
make a function called emit_main_rs returns out
  let b = sb_new()
  sb_push(b, "#[cfg(not(target_arch = \"wasm32\"))]" + nl())
  sb_push(b, "fn main(){" + nl())
  sb_push(b, "    let child = std::thread::Builder::new()" + nl())
  sb_push(b, "        .stack_size(256 * 1024 * 1024)" + nl())
  sb_push(b, "        .spawn(|| {" + nl())
  sb_push(b, "            set_dispatch_fallback(call_dispatch);" + nl())
  sb_push(b, "            let program = build_program();" + nl())
  sb_push(b, "            match run(&program) {" + nl())
  sb_push(b, "                Ok(v) => { println!(\"{}\", display_value(&v)); 0 }" + nl())
  sb_push(b, "                Err(e) => { eprintln!(\"IR runtime error: {}\", e); 1 }" + nl())
  sb_push(b, "            }" + nl())
  sb_push(b, "        })" + nl())
  sb_push(b, "        .expect(\"failed to spawn worker thread\");" + nl())
  sb_push(b, "    let code = child.join().unwrap_or(1);" + nl())
  sb_push(b, "    std::process::exit(code);" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, nl())
  sb_push(b, "#[cfg(target_arch = \"wasm32\")]" + nl())
  sb_push(b, "fn main(){" + nl())
  sb_push(b, "    set_dispatch_fallback(call_dispatch);" + nl())
  sb_push(b, "    let program = build_program();" + nl())
  sb_push(b, "    match run(&program) { Ok(v) => println!(\"{}\", display_value(&v)), Err(e) => { eprintln!(\"IR runtime error: {}\", e); std::process::exit(1); } }" + nl())
  sb_push(b, "}" + nl())
  return sb_str(b)
end

# Full emitted program: runtime library text + generated builder section.
# emit_runtime_rs lives in lib/runtime_rs.patlang — the runtime is PatLang
# source too, so every byte of the emitted program originates from .patlang
# files processed by this toolchain.
make a function called emit_program_rs takes ir returns out
  return emit_runtime_rs() + emit_build_program(ir) + emit_main_rs()
end

# =============================================================================
# Stage 37A — host-function prelude chunking (self-hosted mirror).
# Mirrors rust-runtime/src/ir/codegen.rs's HOST_CHUNK_TABLE/required_chunks:
# walk the list-shaped IR's CallHost instructions, map each host function name
# to its chunk via the same fixed table, plus "core" always included.
# =============================================================================

make a function called list_contains takes xs, v returns found
  let i = 0
  while i < xs.length do
    if xs[i] == v then
      return true
    end
    let i = i + 1
  end
  return false
end

# Static host-function-name -> chunk-name table, same regrouping as the Rust
# side's HOST_CHUNK_TABLE.
make a function called host_chunk_of takes name returns chunk
  if name == "list_get" then return "core" end
  if name == "list_len" then return "core" end
  if name == "list_push" then return "core" end
  if name == "list_set" then return "core" end
  if name == "type_of" then return "core" end
  if name == "char_code" then return "strings_ext" end
  if name == "substr" then return "strings_ext" end
  if name == "chr" then return "strings_ext" end
  if name == "to_num" then return "strings_ext" end
  if name == "hash_string" then return "strings_ext" end
  if name == "vec_new" then return "collections_handles" end
  if name == "vec_push" then return "collections_handles" end
  if name == "vec_set" then return "collections_handles" end
  if name == "vec_get" then return "collections_handles" end
  if name == "vec_len" then return "collections_handles" end
  if name == "vec_to_list" then return "collections_handles" end
  if name == "str_intern" then return "collections_handles" end
  if name == "sc_len" then return "collections_handles" end
  if name == "sc_code" then return "collections_handles" end
  if name == "sc_char" then return "collections_handles" end
  if name == "sb_new" then return "collections_handles" end
  if name == "sb_push" then return "collections_handles" end
  if name == "sb_str" then return "collections_handles" end
  if name == "read_file" then return "files" end
  if name == "write_file" then return "files" end
  if name == "touch_file" then return "files" end
  if name == "file_exists" then return "files" end
  if name == "now_ms" then return "io_misc" end
  if name == "byte_length" then return "io_misc" end
  if name == "read_line" then return "io_misc" end
  if name == "argv" then return "io_misc" end
  if name == "print" then return "io_misc" end
  if name == "sed" then return "io_misc" end
  if name == "add" then return "io_misc" end
  if name == "multiply" then return "io_misc" end
  if name == "subtract" then return "io_misc" end
  if name == "max" then return "io_misc" end
  if name == "min" then return "io_misc" end
  if name == "calculate" then return "io_misc" end
  if name == "calculate_result" then return "io_misc" end
  if name == "get_value" then return "io_misc" end
  if name == "process" then return "io_misc" end
  if name == "validate" then return "io_misc" end
  if name == "len" then return "io_misc" end
  if name == "new" then return "oo" end
  if name == "class_def" then return "oo" end
  if name == "set_var" then return "oo" end
  if name == "get" then return "oo" end
  if name == "send" then return "oo" end
  if name == "infer_type_for" then return "logic" end
  if name == "fact" then return "logic" end
  if name == "goal" then return "logic" end
  if name == "query" then return "logic" end
  # The real Prolog-style rule/solve engine, and the goal-oriented
  # (GOAP) action/plan/pursue/activate system built on it -- all missing
  # here until now (confirmed via git history that this predates the
  # current session entirely, not a regression): a program using any of
  # these compiled fine via native --patc (rust-runtime/src/ir/codegen.
  # rs's HOST_CHUNK_TABLE already lists all of them under ChunkId::
  # Logic) but failed via patc1.exe with "host fn '...' not found",
  # since required_chunks never knew to include the logic chunk for
  # them. Found via self_hosting/examples/paradigm_gallery/event_goal.
  # patlang failing under patc1.exe specifically on action_add.
  if name == "rule_add" then return "logic" end
  if name == "solve" then return "logic" end
  if name == "action_add" then return "logic" end
  if name == "plan" then return "logic" end
  if name == "goal_def" then return "logic" end
  if name == "pursue" then return "logic" end
  if name == "action_bind" then return "logic" end
  if name == "action_lookup" then return "logic" end
  if name == "action_base_name" then return "logic" end
  if name == "action_label_args" then return "logic" end
  if name == "contract_check" then return "contracts" end
  if name == "tcp_listen" then return "networking" end
  if name == "tcp_try_listen" then return "networking" end
  if name == "tcp_connect" then return "networking" end
  if name == "tcp_accept" then return "networking" end
  if name == "sleep_ms" then return "networking" end
  if name == "tcp_accept_timeout" then return "networking" end
  if name == "tcp_read" then return "networking" end
  if name == "tcp_write" then return "networking" end
  if name == "tcp_close" then return "networking" end
  if name == "parse_tiny_source" then return "codegen_bootstrap" end
  if name == "lower_and_compile" then return "codegen_bootstrap" end
  if name == "emit_rust_for" then return "codegen_bootstrap" end
  if name == "copy_file" then return "codegen_bootstrap" end
  if name == "patc_compile_from_argv" then return "codegen_bootstrap" end
  if name == "get_argv" then return "codegen_bootstrap" end
  if name == "rustc_build" then return "codegen_bootstrap" end
  if name == "rustc_build_chunked" then return "codegen_bootstrap" end
  if name == "rustc_build_chunked_texts" then return "codegen_bootstrap" end
  if name == "run_ir" then return "codegen_bootstrap" end
  if name == "sqrt" then return "math" end
  if name == "pow" then return "math" end
  if name == "sin" then return "math" end
  if name == "cos" then return "math" end
  if name == "tan" then return "math" end
  if name == "asin" then return "math" end
  if name == "acos" then return "math" end
  if name == "atan" then return "math" end
  if name == "atan2" then return "math" end
  if name == "log" then return "math" end
  if name == "exp" then return "math" end
  if name == "floor" then return "math" end
  if name == "ceil" then return "math" end
  if name == "round" then return "math" end
  if name == "trunc" then return "math" end
  if name == "abs" then return "math" end
  if name == "numeric_kind" then return "math" end
  return ""
end

# required_chunks(ir) -> list of chunk names needed by this program: "core"
# always, plus one entry per distinct CallHost host function name actually
# used, mapped through host_chunk_of, plus the single Stage 39 cross-chunk
# edge (math -> numeric_tower, applied after the main scan below) -- mirrors
# rust-runtime/src/ir/codegen.rs's CROSS_CHUNK_EDGES.
make a function called required_chunks takes ir returns names
  let names = ["core"]
  let funcs = ir[2]
  let i = 0
  while i < funcs.length do
    let f = funcs[i]
    let instrs = f[3]
    let k = 0
    while k < instrs.length do
      let instr = instrs[k]
      if instr[0] == "CallHost" then
        let c = host_chunk_of(instr[1])
        if c != "" then
          if list_contains(names, c) == false then
            let names = list_push(names, c)
          end
        end
        # A live playground must support arbitrary PatLang -- run_ir
        # interprets an IR tree built at RUNTIME from not-yet-known user
        # source, so static analysis of THIS program's own IR can never see
        # what the eventually-submitted user code will call. Force-include
        # every optional chunk unconditionally whenever run_ir appears,
        # mirroring rust-runtime/src/ir/codegen.rs's `required_chunks`.
        if instr[1] == "run_ir" then
          let all_chunks = ["strings_ext", "collections_handles", "files", "io_misc", "oo", "logic", "contracts", "networking", "codegen_bootstrap", "numeric_tower", "math"]
          let ci = 0
          while ci < all_chunks.length do
            if list_contains(names, all_chunks[ci]) == false then
              let names = list_push(names, all_chunks[ci])
            end
            let ci = ci + 1
          end
        end
      end
      # Stage 38: "numeric_tower" is a special case, not driven by
      # host_chunk_of -- any numeric BinOp (Add/Sub/Mul/Div/Mod, not
      # comparison/logic ops) or unary negation could in principle overflow
      # into bignum or hit inexact int division, and there is no cheap static
      # proof either way from the bare IR, so inclusion is deliberately
      # coarse/conservative (a documented limitation, not a bug) -- mirrors
      # rust-runtime/src/ir/codegen.rs's `required_chunks`.
      if instr[0] == "Bin" then
        if instr[1] == "+" then
          if list_contains(names, "numeric_tower") == false then
            let names = list_push(names, "numeric_tower")
          end
        else
          if instr[1] == "-" then
            if list_contains(names, "numeric_tower") == false then
              let names = list_push(names, "numeric_tower")
            end
          else
            if instr[1] == "*" then
              if list_contains(names, "numeric_tower") == false then
                let names = list_push(names, "numeric_tower")
              end
            else
              if instr[1] == "/" then
                if list_contains(names, "numeric_tower") == false then
                  let names = list_push(names, "numeric_tower")
                end
              else
                if instr[1] == "%" then
                  if list_contains(names, "numeric_tower") == false then
                    let names = list_push(names, "numeric_tower")
                  end
                end
              end
            end
          end
        end
      end
      if instr[0] == "Un" then
        if instr[1] == "-" then
          if list_contains(names, "numeric_tower") == false then
            let names = list_push(names, "numeric_tower")
          end
        end
      end
      let k = k + 1
    end
    let i = i + 1
  end
  # Cross-chunk edge: math's chunk text is written entirely in terms of the
  # full numeric tower's Value variants/helpers, so it needs numeric_tower
  # even if this program has no ordinary arithmetic BinOp anywhere (e.g. a
  # program calling only sqrt()).
  if list_contains(names, "math") then
    if list_contains(names, "numeric_tower") == false then
      let names = list_push(names, "numeric_tower")
    end
  end
  # Cross-chunk edge: oo's send() dispatcher has an "infer_relations" method
  # arm that reads the FACTS thread-local, but FACTS is only declared in
  # logic's chunk text. Mirrors rust-runtime/src/ir/codegen.rs's
  # CROSS_CHUNK_EDGES (found via the benchmark suite -- a program using
  # send() with no fact/query/goal).
  if list_contains(names, "oo") then
    if list_contains(names, "logic") == false then
      let names = list_push(names, "logic")
    end
  end
  # Cross-chunk edge: contract_check's success path records a fact via
  # RULES/LogicRule, both declared only in logic's chunk text -- any
  # program calling contract_check (require/ensure/assert) needs logic's
  # declarations to compile. Mirrors rust-runtime/src/ir/codegen.rs's
  # CROSS_CHUNK_EDGES (Contracts -> Logic entry) -- missing here until
  # now, same pre-existing gap as the host_chunk_of entries just above.
  if list_contains(names, "contracts") then
    if list_contains(names, "logic") == false then
      let names = list_push(names, "logic")
    end
  end
  return names
end

# Tree-shaken emitted program: only the chunks this program's host calls
# actually need, instead of the full prelude.
make a function called emit_program_rs_shaken takes ir returns out
  return emit_runtime_rs_for(required_chunks(ir)) + emit_build_program(ir) + emit_main_rs()
end

# Comma-separated chunk names, for handing to the `rustc_build_chunked`
# host function's `chunk_names_csv` parameter (mirrors how
# rust-runtime/src/main.rs's own `--patc` mode joins the same set on the
# Rust side before calling `build_chunked_native`).
make a function called join_csv takes names returns out
  let b = sb_new()
  let i = 0
  while i < names.length do
    if i > 0 then
      sb_push(b, ",")
    end
    sb_push(b, names[i])
    let i = i + 1
  end
  return sb_str(b)
end

# chunk_texts_for(names) -> [base_name, pairs] where `pairs` is a list of
# [name, text] 2-element lists, one entry per chunk in `names` (with "core"
# and whichever Value variant merged into a single entry named
# `base_name`, matching the native side's own base/tier1/tier2 split --
# see build_chunked_native_opt's caller-side merge in codegen.rs). This is
# the self-hosted counterpart of that merge: since a standalone compiled
# patc-generated program (patc1.exe, patc2.exe, ...) has no access to
# ChunkId/PRELUDE_* at all, it must supply chunk TEXT explicitly to
# `rustc_build_chunked_texts` -- sourced here via the ALREADY-EXISTING
# emit_chunk_* mirror functions (runtime_rs.patlang), each proven
# byte-for-byte identical to codegen.rs's own PRELUDE_* constants by
# `selfhost_runtime_text_parity`.
make a function called chunk_texts_for takes names returns result
  let wants_tower = list_contains(names, "numeric_tower")
  let base_name = "patlang_base_fast"
  if wants_tower then
    let base_name = "patlang_base_tower"
  end
  let base_text = emit_chunk_core()
  if wants_tower then
    let base_text = base_text + emit_chunk_numeric_tower()
  else
    let base_text = base_text + emit_chunk_value_fast()
  end
  let pairs = [[base_name, base_text]]
  if list_contains(names, "strings_ext") then
    let pairs = list_push(pairs, ["strings_ext", emit_chunk_strings_ext()])
  end
  if list_contains(names, "collections_handles") then
    let pairs = list_push(pairs, ["collections_handles", emit_chunk_collections_handles()])
  end
  if list_contains(names, "files") then
    let pairs = list_push(pairs, ["files", emit_chunk_files()])
  end
  if list_contains(names, "io_misc") then
    let pairs = list_push(pairs, ["io_misc", emit_chunk_io_misc()])
  end
  if list_contains(names, "networking") then
    let pairs = list_push(pairs, ["networking", emit_chunk_networking()])
  end
  if list_contains(names, "codegen_bootstrap") then
    let pairs = list_push(pairs, ["codegen_bootstrap", emit_chunk_codegen_bootstrap()])
  end
  if list_contains(names, "math") then
    let pairs = list_push(pairs, ["math", emit_chunk_math()])
  end
  # "logic" must be added before "oo"/"contracts" -- both of THOSE need a
  # "logic" entry already present in `pairs` (embedded_build_chunked looks
  # it up by name at Tier 2), same CROSS_CHUNK_EDGES-driven ordering the
  # native side's own tiering already relies on.
  if list_contains(names, "logic") then
    let pairs = list_push(pairs, ["logic", emit_chunk_logic()])
  end
  if list_contains(names, "oo") then
    let pairs = list_push(pairs, ["oo", emit_chunk_oo()])
  end
  if list_contains(names, "contracts") then
    let pairs = list_push(pairs, ["contracts", emit_chunk_contracts()])
  end
  return [base_name, pairs]
end

# Chunked emitted program: per-program text ONLY (call_dispatch +
# build_program + main), no PRELUDE_* runtime text at all -- mirrors
# rust-runtime/src/ir/codegen.rs's `emit_rust_chunked`. Meant to be handed
# to the `rustc_build_chunked` host function together with
# `join_csv(required_chunks(ir))`, which supplies the actual chunk TEXT
# itself (from codegen.rs's own PRELUDE_* constants, precompiled once into
# cached rlibs) -- this function only needs to generate the small, always-
# different-per-program part and pick the right chunk NAMES, exactly like
# the monolithic `emit_program_rs_shaken` already does for text selection,
# just without inlining the chosen chunks' TEXT into the output at all.
make a function called emit_program_rs_chunked takes ir returns out
  return emit_dispatch_for(required_chunks(ir)) + emit_build_program(ir) + emit_main_rs()
end
