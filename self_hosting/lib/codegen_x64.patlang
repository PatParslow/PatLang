      # result correctly); any other combination (List/Object/Closure,
      # or a String mixed with one of those) keeps the old placeholder
      # -- no meaningful `+` is defined for those yet.
      sb_push(sb, "    mov r15, 17293822569102704640" + x64_nl_char())
      sb_push(sb, "    mov rax, [rbp-" + dyn_a + "]" + x64_nl_char())
      sb_push(sb, "    and rax, r15" + x64_nl_char())
      sb_push(sb, "    mov r10, [rbp-" + dyn_b + "]" + x64_nl_char())
      sb_push(sb, "    and r10, r15" + x64_nl_char())
      sb_push(sb, "    mov rcx, 2305843009213693952" + x64_nl_char())
      sb_push(sb, "    cmp rax, rcx" + x64_nl_char())
      sb_push(sb, "    jne .DYN_OBJPLUS_NOTSTR_" + suffix + x64_nl_char())
      sb_push(sb, "    cmp r10, rcx" + x64_nl_char())
      sb_push(sb, "    jne .DYN_OBJPLUS_NOTSTR_" + suffix + x64_nl_char())
      # Same payload-nonzero guard as .DYN_OBJCMP_ above -- a bare tag
