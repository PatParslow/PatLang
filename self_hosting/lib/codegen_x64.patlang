end

# The non-blocking process-creation primitive itself. Directly modeled
# on x64_os_exec_run_asm above (SAME cmdline-preserve-across-heap-alloc
# dance, SAME SECURITY_ATTRIBUTES/STARTUPINFOA field offsets, SAME
# CreateProcessA stack-argument layout -- all already proven correct
# there) but deliberately simpler in two ways: (1) stdout/stderr are
# discarded via a CreateFileA("NUL") handle instead of a real pipe --
# no read loop, no pipe-fill deadlock concern, since nobody ever reads
# this output; (2) does NOT call WaitForSingleObject -- spawn is
# non-blocking by design, that's what is_alive/wait exist for. Returns
# [pid, handle] as a genuine tagged list so the caller can recover the
# real HANDLE later purely from the pid it was given.
make a function called x64_os_spawn_run_asm returns asm
  let suffix = label_asm_safe(0)
  let sb = sb_new()
  sb_push(sb, "    pop r10" + x64_nl_char())
  sb_push(sb, "    pop rax" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  sb_push(sb, "    push r10" + x64_nl_char())
  sb_push(sb, "    mov rax, r10" + x64_nl_char())
  sb_push(sb, "    add rax, 1" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  sb_push(sb, "    call rt_heap_alloc" + x64_nl_char())
  sb_push(sb, "    add rsp, 8" + x64_nl_char())
  sb_push(sb, "    mov r14, rax" + x64_nl_char())
  sb_push(sb, "    pop r10" + x64_nl_char())
  sb_push(sb, "    pop rax" + x64_nl_char())
  sb_push(sb, "    mov r15, rsp" + x64_nl_char())
  sb_push(sb, "    sub rsp, 336" + x64_nl_char())
  sb_push(sb, "    and rsp, -16" + x64_nl_char())
  sb_push(sb, "    xor rsi, rsi" + x64_nl_char())
  sb_push(sb, "  .spawn_cpy_loop_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    cmp rsi, r10" + x64_nl_char())
  sb_push(sb, "    jge .spawn_cpy_done_" + suffix + x64_nl_char())
  sb_push(sb, "    mov dl, [rax+rsi]" + x64_nl_char())
  sb_push(sb, "    mov [r14+rsi], dl" + x64_nl_char())
  sb_push(sb, "    inc rsi" + x64_nl_char())
  sb_push(sb, "    jmp .spawn_cpy_loop_" + suffix + x64_nl_char())
  sb_push(sb, "  .spawn_cpy_done_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    mov byte [r14+rsi], 0" + x64_nl_char())
  # "NUL\0" written directly into g_scratch -- no existing mechanism to
  # embed a literal ASCII filename constant in generated asm text, so
  # the bytes are just poked in at runtime instead ('N'=78,'U'=85,'L'=76).
  sb_push(sb, "    mov word [rel g_scratch], 21838" + x64_nl_char())
  sb_push(sb, "    mov byte [rel g_scratch+2], 76" + x64_nl_char())
  sb_push(sb, "    mov byte [rel g_scratch+3], 0" + x64_nl_char())
  # SECURITY_ATTRIBUTES @80: nLength=24, lpSecurityDescriptor=0, bInheritHandle=1
  sb_push(sb, "    mov qword [rsp+80], 24" + x64_nl_char())
  sb_push(sb, "    mov qword [rsp+88], 0" + x64_nl_char())
  sb_push(sb, "    mov qword [rsp+96], 1" + x64_nl_char())
  sb_push(sb, "    lea rcx, [rel g_scratch]" + x64_nl_char())
  sb_push(sb, "    mov rdx, 1073741824" + x64_nl_char())
  sb_push(sb, "    mov r8, 3" + x64_nl_char())
  sb_push(sb, "    lea r9, [rsp+80]" + x64_nl_char())
  sb_push(sb, "    mov qword [rsp+32], 3" + x64_nl_char())
  sb_push(sb, "    mov qword [rsp+40], 128" + x64_nl_char())
  sb_push(sb, "    mov qword [rsp+48], 0" + x64_nl_char())
  sb_push(sb, "    call CreateFileA" + x64_nl_char())
  sb_push(sb, "    mov [rsp+104], rax" + x64_nl_char())
  # Zero the whole STARTUPINFOA (104 bytes = 13 qwords) before setting
  # the specific fields we need.
  sb_push(sb, "    mov rcx, 0" + x64_nl_char())
  sb_push(sb, "  .spawn_zero_si_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    cmp rcx, 13" + x64_nl_char())
  sb_push(sb, "    jge .spawn_zero_si_done_" + suffix + x64_nl_char())
  sb_push(sb, "    mov qword [rsp+128+rcx*8], 0" + x64_nl_char())
  sb_push(sb, "    inc rcx" + x64_nl_char())
  sb_push(sb, "    jmp .spawn_zero_si_" + suffix + x64_nl_char())
  sb_push(sb, "  .spawn_zero_si_done_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    mov qword [rsp+128], 104" + x64_nl_char())
  sb_push(sb, "    mov qword [rsp+188], 256" + x64_nl_char())
  sb_push(sb, "    mov rax, [rsp+104]" + x64_nl_char())
  sb_push(sb, "    mov [rsp+216], rax" + x64_nl_char())
  sb_push(sb, "    mov [rsp+224], rax" + x64_nl_char())
  sb_push(sb, "    mov rcx, 0" + x64_nl_char())
  sb_push(sb, "    lea rdx, [r14]" + x64_nl_char())
  sb_push(sb, "    xor r8, r8" + x64_nl_char())
  sb_push(sb, "    xor r9, r9" + x64_nl_char())
  sb_push(sb, "    mov qword [rsp+32], 1" + x64_nl_char())
  sb_push(sb, "    mov qword [rsp+40], 0" + x64_nl_char())
  sb_push(sb, "    mov qword [rsp+48], 0" + x64_nl_char())
  sb_push(sb, "    mov qword [rsp+56], 0" + x64_nl_char())
  sb_push(sb, "    lea rax, [rsp+128]" + x64_nl_char())
  sb_push(sb, "    mov qword [rsp+64], rax" + x64_nl_char())
  sb_push(sb, "    lea rax, [rsp+240]" + x64_nl_char())
  sb_push(sb, "    mov qword [rsp+72], rax" + x64_nl_char())
  sb_push(sb, "    call CreateProcessA" + x64_nl_char())
  sb_push(sb, "    cmp rax, 0" + x64_nl_char())
  sb_push(sb, "    je .spawn_failed_" + suffix + x64_nl_char())
  sb_push(sb, "    mov rcx, [rsp+248]" + x64_nl_char())
  sb_push(sb, "    call CloseHandle" + x64_nl_char())
  sb_push(sb, "    mov rcx, [rsp+104]" + x64_nl_char())
  sb_push(sb, "    call CloseHandle" + x64_nl_char())
  sb_push(sb, "    mov r12, [rsp+240]" + x64_nl_char())
  sb_push(sb, "    mov eax, [rsp+256]" + x64_nl_char())
  sb_push(sb, "    mov r13, rax" + x64_nl_char())
  sb_push(sb, "    jmp .spawn_all_done_" + suffix + x64_nl_char())
  sb_push(sb, "  .spawn_failed_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    mov rcx, [rsp+104]" + x64_nl_char())
  sb_push(sb, "    call CloseHandle" + x64_nl_char())
  sb_push(sb, "    mov r12, 0" + x64_nl_char())
  sb_push(sb, "    mov r13, 0" + x64_nl_char())
  sb_push(sb, "  .spawn_all_done_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    mov rsp, r15" + x64_nl_char())
  sb_push(sb, "    add rsp, 16" + x64_nl_char())
  # Record [pid, handle] in g_procs_table (so is_alive/wait/kill can
  # recover the real HANDLE later from just the pid) via the ordinary
  # PatLang helper procs_table_add, then return just the pid -- matching
  # the real host's spawn() semantics (Int PID, not a pair).
  sb_push(sb, "    push r13" + x64_nl_char())
  sb_push(sb, "    push r12" + x64_nl_char())
  sb_push(sb, "    call procs_table_add" + x64_nl_char())
  sb_push(sb, "    add rsp, 16" + x64_nl_char())
  sb_push(sb, "    push r13" + x64_nl_char())
  return sb_str(sb)
end

# ---- Stage B, part 1 of the interp.patlang-compilation roadmap (#25):
# real TCP networking via Winsock2. These are deliberately narrow raw
# primitives (a single socket op each) -- ALL bookkeeping (the
# g_listeners_table/g_conns_table [id, socket] assoc-lists, the
# tcp_try_listen AddrInUse carve-out, the tcp_read-vs-tcp_read_or_empty
# fatal/non-fatal split) lives in ordinary PatLang wrapper functions in
# x64_runtime.patlang, matching this backend's established "runtime
# logic belongs in PatLang, native primitives stay narrow" philosophy
# (see x64_exec_capture_asm's own header for the precedent). r12/r13/
# r14/rbx are all safe scratch here: none of them is ever assigned to a
# PatLang local across a CallHost instruction (x64_reg_pool is
# rbx/r13/r14 only, and the register allocator treats CallHost as a
# call boundary -- see x64_instr_is_call_boundary -- so no local can be
# live in ANY of them at this exact point); Win32/Winsock DLL calls
# follow the real Win64 ABI and preserve rbx/rsi/rdi/rbp/r12-r15
# themselves, so (unlike calls to this backend's OWN rt_heap_alloc,
# which has no such guarantee) values kept in those registers safely
# survive back-to-back winsock calls within one primitive.

make a function called x64_os_wsa_startup_asm returns asm
  let sb = sb_new()
  sb_push(sb, "    mov r15, rsp" + x64_nl_char())
  sb_push(sb, "    sub rsp, 480" + x64_nl_char())
  sb_push(sb, "    and rsp, -16" + x64_nl_char())
  sb_push(sb, "    mov rcx, 514" + x64_nl_char())
  sb_push(sb, "    lea rdx, [rsp+32]" + x64_nl_char())
  sb_push(sb, "    call WSAStartup" + x64_nl_char())
  sb_push(sb, "    mov rsp, r15" + x64_nl_char())
  return sb_str(sb)
end

# os_bind_listen(sock, port) -> actual bound port (>=0) on success, -1
# if the port is already in use (WSAEADDRINUSE, 10048 -- the ONE
# specific carve-out tcp_try_listen needs), -2 for any other failure.
# Binds to 127.0.0.1 specifically (matching host_tcp_listen's own
# TcpListener::bind(("127.0.0.1", port)), not 0.0.0.0), and reads back
# the ACTUAL bound port via getsockname so port=0 (OS-assigned) works
# the same as a real port number.
make a function called x64_os_bind_listen_asm returns asm
  let suffix = label_asm_safe(0)
  let sb = sb_new()
  sb_push(sb, "    pop rdx" + x64_nl_char())
  sb_push(sb, "    pop rax" + x64_nl_char())
  sb_push(sb, "    mov r12, rax" + x64_nl_char())
  sb_push(sb, "    mov r13, rdx" + x64_nl_char())
  sb_push(sb, "    mov r15, rsp" + x64_nl_char())
  sb_push(sb, "    sub rsp, 96" + x64_nl_char())
  sb_push(sb, "    and rsp, -16" + x64_nl_char())
  # sockaddr_in @ [rsp+32..47]: sin_family=AF_INET, sin_port=htons(port),
  # sin_addr=127.0.0.1 (bytes 127,0,0,1 read back as the little-endian
  # dword 16777343), sin_zero=0.
