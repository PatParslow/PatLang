  sb_push(sb, "    cmp qword [rsp+56], -1" + x64_nl_char())
  sb_push(sb, "    je .ofs_invalid_" + suffix + x64_nl_char())
  sb_push(sb, "    mov rcx, [rsp+56]" + x64_nl_char())
  sb_push(sb, "    xor rdx, rdx" + x64_nl_char())
  sb_push(sb, "    call GetFileSize" + x64_nl_char())
  sb_push(sb, "    mov r12, rax" + x64_nl_char())
  sb_push(sb, "    mov rcx, [rsp+56]" + x64_nl_char())
  sb_push(sb, "    call CloseHandle" + x64_nl_char())
  sb_push(sb, "    mov rax, r12" + x64_nl_char())
  sb_push(sb, "    jmp .ofs_done_" + suffix + x64_nl_char())
  sb_push(sb, "  .ofs_invalid_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    mov rax, -1" + x64_nl_char())
  sb_push(sb, "  .ofs_done_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    mov rsp, r15" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  return sb_str(sb)
end

