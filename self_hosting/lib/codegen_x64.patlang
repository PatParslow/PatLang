    # everything else: the "set" special-case and method/class
    # resolution, returning the closure to invoke or 0 if there's
    # nothing left to invoke.
    let k = to_num(argc) - 2
    let suffix = label_asm_safe(0)
    # 1. Collect all argc pushed values into a heap array (exact idiom
    #    as x64_exec_capture_asm's own arg collection): arr[0]=recv,
    #    arr[1]=method, arr[2..]=rest args.
    sb_push(sb, "    mov rax, " + (to_num(argc) * 8) + x64_nl_char())
    sb_push(sb, "    push rax" + x64_nl_char())
    sb_push(sb, "    call rt_heap_alloc" + x64_nl_char())
    sb_push(sb, "    add rsp, 8" + x64_nl_char())
    sb_push(sb, "    mov r12, rax" + x64_nl_char())
    let ai = to_num(argc) - 1
    while ai >= 0 do
