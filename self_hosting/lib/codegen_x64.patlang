# Promotes the operand pair (if fixnum) into BigInt-tagged values in
# place -- shared by every dynamic op's slow path. Operands live in two
# fixed per-frame stack slots (dyn_a/dyn_b, offsets derived from
# `locals`), not registers r13/r14 -- freed for the locals register
# allocator (see memory patlang-x64-register-allocator-slice8). Clobbers
# rax/r15/r10.
make a function called x64_dynamic_promote_both_asm takes suffix, spilled returns asm
  let dyn_a = 8 * (to_num(list_len(spilled)) + 2)
  let dyn_b = 8 * (to_num(list_len(spilled)) + 3)
  let sb = sb_new()
  # Real bug found (same root cause as the .DYN_NOTFAST_ family-check
  # fix above): "top-16-bits nonzero" is NOT a valid "already tagged,
  # not a fixnum" test -- a NEGATIVE fixnum's sign extension also sets
  # those bits, so a negative fixnum reaching here was wrongly treated
  # as an already-promoted BigInt and left as its raw (garbage, once
  # dereferenced) bit pattern instead of being unpacked and promoted.
  # Fixed to the same "does it round-trip through a 48-bit sign
  # extension unchanged" test x64_binop_asm_dynamic's own overflow
  # check already uses -- true for any genuine fixnum (positive or
  # negative), false for a real tagged pointer (this system's 16MB
  # heap never gets remotely close to setting bit 47, the only way a
  # real address could coincidentally round-trip).
  sb_push(sb, "    mov rax, [rbp-" + dyn_a + "]" + x64_nl_char())
  sb_push(sb, "    mov rcx, rax" + x64_nl_char())
  sb_push(sb, "    shl rcx, 16" + x64_nl_char())
  sb_push(sb, "    sar rcx, 16" + x64_nl_char())
  sb_push(sb, "    cmp rcx, rax" + x64_nl_char())
  sb_push(sb, "    jne .DYNP_OP1OK_" + suffix + x64_nl_char())
  sb_push(sb, "    push rcx" + x64_nl_char())
  sb_push(sb, "    call rt_bigint_from_i64" + x64_nl_char())
  sb_push(sb, "    add rsp, 8" + x64_nl_char())
  sb_push(sb, "    mov [rbp-" + dyn_a + "], rax" + x64_nl_char())
  sb_push(sb, ".DYNP_OP1OK_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    mov rax, [rbp-" + dyn_b + "]" + x64_nl_char())
  sb_push(sb, "    mov rcx, rax" + x64_nl_char())
  sb_push(sb, "    shl rcx, 16" + x64_nl_char())
  sb_push(sb, "    sar rcx, 16" + x64_nl_char())
  sb_push(sb, "    cmp rcx, rax" + x64_nl_char())
  sb_push(sb, "    jne .DYNP_OP2OK_" + suffix + x64_nl_char())
  sb_push(sb, "    push rcx" + x64_nl_char())
  sb_push(sb, "    call rt_bigint_from_i64" + x64_nl_char())
  sb_push(sb, "    add rsp, 8" + x64_nl_char())
  sb_push(sb, "    mov [rbp-" + dyn_b + "], rax" + x64_nl_char())
  sb_push(sb, ".DYNP_OP2OK_" + suffix + ":" + x64_nl_char())
  return sb_str(sb)
end

