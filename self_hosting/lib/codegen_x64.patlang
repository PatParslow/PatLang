      sb_push(sb, "    pop rdx" + x64_nl_char())
      sb_push(sb, "    pop rax" + x64_nl_char())
      sb_push(sb, "    add rax, rdx" + x64_nl_char())
      sb_push(sb, "    mov byte [rax], cl" + x64_nl_char())
      sb_push(sb, "    push 0" + x64_nl_char())
    else
      if name == "mem_peek_byte" then
        sb_push(sb, "    pop rdx" + x64_nl_char())
        sb_push(sb, "    pop rax" + x64_nl_char())
        sb_push(sb, "    add rax, rdx" + x64_nl_char())
        sb_push(sb, "    movzx rax, byte [rax]" + x64_nl_char())
        sb_push(sb, "    push rax" + x64_nl_char())
      else
      if name == "mem_heap_base" then
        sb_push(sb, "    lea rax, [rel g_heap]" + x64_nl_char())
        sb_push(sb, "    push rax" + x64_nl_char())
      elif name == "mem_heap_size" then
        # MUST match g_heap's own `resb <N>` size below byte-for-byte --
        # rt_heap_alloc's own bounds check (x64_runtime.patlang) relies
        # on this to detect exhaustion instead of silently overflowing
        # into unmapped memory (GitHub #31 follow-up, patc2->patc3 crash).
        sb_push(sb, "    mov rax, 536870912" + x64_nl_char())
        sb_push(sb, "    push rax" + x64_nl_char())
      else
      if name == "mem_heap_state_addr" then
        sb_push(sb, "    lea rax, [rel g_heap_state]" + x64_nl_char())
        sb_push(sb, "    push rax" + x64_nl_char())
      else
      if name == "len" then
        sb_push(sb, x64_len_asm())
      elif name == "byte_length" then
        # byte_length(s) -- this backend's strings are ALREADY byte-only
        # (no separate char count, see x64_len_asm's own header on
        # host_len's String->byte-length semantics), so it's a plain
        # alias for the same primitive .length itself uses.
        sb_push(sb, x64_len_asm())
      else
      if name == "mem_sb_table_addr" then
        # Persistent 8-byte global holding the CURRENT tagged-list value
        # of sb_new/sb_push/sb_str's (self_hosting/lib/x64_runtime.patlang)
        # StringBuilder-entries table -- same "fixed .bss slot, real
        # PatLang list value stored through it" pattern as
        # mem_heap_state_addr, needed because sb_push's handle (a stable
        # index) must keep working even when its own entry reallocates.
        sb_push(sb, "    lea rax, [rel g_sb_table]" + x64_nl_char())
        sb_push(sb, "    push rax" + x64_nl_char())
      else
      if name == "mem_vec_table_addr" then
        # Same pattern as mem_sb_table_addr, for vec_new/vec_push/
        # vec_get/vec_set/vec_len/vec_to_list's own table of entries
        # (each entry an ordinary PatLang List instead of a byte
        # buffer -- see x64_runtime.patlang's own header on these).
        sb_push(sb, "    lea rax, [rel g_vec_table]" + x64_nl_char())
        sb_push(sb, "    push rax" + x64_nl_char())
      else
      if name == "mem_vars_table_addr" then
        # Same pattern again, for set_var/get's global named-counter
        # store (see x64_runtime.patlang's own header on these).
        sb_push(sb, "    lea rax, [rel g_vars_table]" + x64_nl_char())
        sb_push(sb, "    push rax" + x64_nl_char())
      elif name == "mem_actions_table_addr" then
        # Same pattern again, for action_add/plan's global actions
        # store (GitHub #27 -- the GOAP planner, Stage 2 of #25).
        sb_push(sb, "    lea rax, [rel g_actions_table]" + x64_nl_char())
        sb_push(sb, "    push rax" + x64_nl_char())
      elif name == "mem_action_bodies_table_addr" then
        # Same pattern again, for action_bind/action_lookup's global
        # store of name->closure bindings (goal/pursue/activate's own
        # extension, continuing the interp.patlang-compilation roadmap
        # past #26/#27).
        sb_push(sb, "    lea rax, [rel g_action_bodies_table]" + x64_nl_char())
        sb_push(sb, "    push rax" + x64_nl_char())
      elif name == "mem_procs_table_addr" then
        # spawn/is_alive/wait/kill's global [pid, handle] table.
        sb_push(sb, "    lea rax, [rel g_procs_table]" + x64_nl_char())
        sb_push(sb, "    push rax" + x64_nl_char())
      elif name == "mem_listeners_table_addr" then
        # tcp_listen/tcp_try_listen/tcp_accept*'s global [port, socket]
        # listener table.
        sb_push(sb, "    lea rax, [rel g_listeners_table]" + x64_nl_char())
        sb_push(sb, "    push rax" + x64_nl_char())
      elif name == "mem_conns_table_addr" then
        # tcp_connect/tcp_accept*/tcp_read*/tcp_write/tcp_close's global
        # [conn_id, socket] connection table.
        sb_push(sb, "    lea rax, [rel g_conns_table]" + x64_nl_char())
        sb_push(sb, "    push rax" + x64_nl_char())
      elif name == "mem_wsa_init_addr" then
        # Lazy WSAStartup-done flag -- same lazy-init-on-first-use
        # convention as every other table's own .bss slot here.
        sb_push(sb, "    lea rax, [rel g_wsa_init]" + x64_nl_char())
        sb_push(sb, "    push rax" + x64_nl_char())
      elif name == "mem_vfs_table_addr" then
        # vfs_read/vfs_write/vfs_append/vfs_exists/vfs_list/vfs_delete's
        # global [path, contents] in-memory store -- same pattern again.
        sb_push(sb, "    lea rax, [rel g_vfs_table]" + x64_nl_char())
        sb_push(sb, "    push rax" + x64_nl_char())
      elif name == "mem_rules_table_addr" then
        # Same pattern again, for rule_add/solve's global rules store
        # (GitHub #26/#25 -- the Prolog-like logic engine) -- a single
        # persistent tagged rt_list value grown via rt_list_push.
        # Deliberately `elif` here, not another "else\nif...end" level:
        # per this session's own CLAUDE.md convention (added after a
        # real bug from exactly this chain, see i64_to_f64's own
        # history), adding a branch via elif can't desync the deferred
        # `end` stack this whole function's chain still uses for its
        # OTHER, pre-existing branches -- elif adds zero new nesting.
        sb_push(sb, "    lea rax, [rel g_rules_table]" + x64_nl_char())
        sb_push(sb, "    push rax" + x64_nl_char())
      elif name == "mem_classes_table_addr" then
        # Real classes for x64 (non-inheriting subset) -- class_def's own
        # registry (class name -> [field_defaults, methods]).
        sb_push(sb, "    lea rax, [rel g_classes_table]" + x64_nl_char())
        sb_push(sb, "    push rax" + x64_nl_char())
      elif name == "mem_goal_defs_table_addr" then
        # goal_def/pursue's own registry (goal name -> deps ground-fact
        # list), same assoc-list-of-[key, value] pattern as
        # g_classes_table just above -- primitive-gap fill (GitHub #31
        # follow-up), reuses the already-ported `plan_facts` for pursue's
        # actual search.
        sb_push(sb, "    lea rax, [rel g_goal_defs_table]" + x64_nl_char())
        sb_push(sb, "    push rax" + x64_nl_char())
      else
      if name == "mem_poke_qword" then
        sb_push(sb, "    pop rcx" + x64_nl_char())
        sb_push(sb, "    pop rdx" + x64_nl_char())
        sb_push(sb, "    pop rax" + x64_nl_char())
        sb_push(sb, "    add rax, rdx" + x64_nl_char())
        sb_push(sb, "    mov [rax], rcx" + x64_nl_char())
        sb_push(sb, "    push 0" + x64_nl_char())
      else
      if name == "mem_peek_qword" then
        sb_push(sb, "    pop rdx" + x64_nl_char())
        sb_push(sb, "    pop rax" + x64_nl_char())
        sb_push(sb, "    add rax, rdx" + x64_nl_char())
        sb_push(sb, "    mov rax, [rax]" + x64_nl_char())
        sb_push(sb, "    push rax" + x64_nl_char())
      else
      if name == "f64_to_i64_trunc" then
        # Slice 7: the ONE conversion primitive genuinely needing a
        # dedicated CPU instruction (cvttsd2si) -- ordinary arithmetic
        # alone can't do a float-to-int truncating conversion. Takes a
        # float BIT PATTERN (as pushed by float-mode Const/Bin), returns
        # a plain int.
        sb_push(sb, "    pop rax" + x64_nl_char())
        sb_push(sb, "    movq xmm0, rax" + x64_nl_char())
        sb_push(sb, "    cvttsd2si rax, xmm0" + x64_nl_char())
        sb_push(sb, "    push rax" + x64_nl_char())
      else
      if name == "i64_to_f64" then
        # The reverse of f64_to_i64_trunc, added while building
        # rt_float_decompose (real float-printing support): a genuine
        # bug was caught here directly by a segfault before this
        # existed -- f64_to_i64_trunc's result is a PLAIN INTEGER, not
        # a float bit pattern, so subtracting it directly from a real
        # float (`av - ipart`) via the float Bin path reinterpreted the
        # integer's raw bits AS IF they were a double (e.g. integer 1's
        # bit pattern 0x0...01 read as a double is a vanishingly small
        # denormalized number, not 1.0) -- silently wrong arithmetic,
        # not a type error, exactly the kind of bug that's easy to miss
        # without directly comparing against the interpreter's own
        # output. cvtsi2sd is the same instruction the `%` float-mode
        # path already uses inline (x64_binop_asm_float) but had no
        # PatLang-callable name of its own until now.
        sb_push(sb, "    pop rax" + x64_nl_char())
        sb_push(sb, "    cvtsi2sd xmm0, rax" + x64_nl_char())
        sb_push(sb, "    movq rax, xmm0" + x64_nl_char())
        sb_push(sb, "    push rax" + x64_nl_char())
      else
        if name == "os_write_console_bytes" then
          sb_push(sb, "    pop r13" + x64_nl_char())
          sb_push(sb, "    pop r14" + x64_nl_char())
          sb_push(sb, "    mov r15, rsp" + x64_nl_char())
          sb_push(sb, "    sub rsp, 48" + x64_nl_char())
          sb_push(sb, "    and rsp, -16" + x64_nl_char())
          sb_push(sb, "    mov rcx, -11" + x64_nl_char())
          sb_push(sb, "    call GetStdHandle" + x64_nl_char())
          sb_push(sb, "    mov rcx, rax" + x64_nl_char())
          sb_push(sb, "    mov rdx, r14" + x64_nl_char())
          sb_push(sb, "    mov r8, r13" + x64_nl_char())
          sb_push(sb, "    lea r9, [rel g_written]" + x64_nl_char())
          sb_push(sb, "    mov qword [rsp+32], 0" + x64_nl_char())
          sb_push(sb, "    call WriteFile" + x64_nl_char())
          sb_push(sb, "    mov rsp, r15" + x64_nl_char())
          sb_push(sb, "    push 0" + x64_nl_char())
        else
          if name == "os_get_command_line" then
            sb_push(sb, x64_os_get_command_line_asm())
          else
          if name == "os_exit" then
            sb_push(sb, "    pop rcx" + x64_nl_char())
            sb_push(sb, "    mov r15, rsp" + x64_nl_char())
            sb_push(sb, "    sub rsp, 32" + x64_nl_char())
            sb_push(sb, "    and rsp, -16" + x64_nl_char())
            sb_push(sb, "    call ExitProcess" + x64_nl_char())
          else
            print("codegen_x64: unsupported primitive (not a real function and not in the OS-boundary allowlist): " + name)
            # Real bug found and fixed here during the patc1-self-
            # compile fixpoint attempt: this string used to be
            # returned WITHOUT a trailing newline, and callers just
            # sb_push it straight into the output -- meaning it got
            # spliced directly onto the FRONT of whatever line
            # followed (e.g. "UNSUPPORTED_PRIMITIVE_ERRORL_main_103:"
            # as one malformed token), corrupting NASM's parsing of
            # every subsequent line and cascading into a wall of
            # unrelated-looking "label changed during code generation"
            # errors. Now a real, harmless NASM comment line with its
            # own newline, so it can never corrupt whatever follows it
            # regardless of how many unsupported-primitive calls a
            # program makes.
            #
            # SECOND, much more serious bug found and fixed here
            # (GitHub #27, Stage 2 regression testing): this comment
            # line was the ONLY thing emitted at the call site -- the
            # `argc` arguments already pushed onto the real stack by
            # the preceding Const/Load instructions were never
            # reclaimed, and no replacement result was ever pushed.
            # Every subsequent instruction in the function still
            # expects the stack machine's usual "N args consumed, 1
            # result produced" discipline, so this silently desynced
            # the REAL x64 stack pointer for everything downstream in
            # the function -- not a wrong VALUE, an actually corrupted
            # stack. Confirmed exactly: a test program calling an
            # unrelated unsupported primitive (contract_check) twice,
            # followed by a genuinely correct GOAP action_add/plan
            # sequence, produced a wrong plan purely because of this
            # upstream corruption -- the GOAP logic itself was fine in
            # isolation. Fixed to reclaim the pushed arguments and push
            # a harmless placeholder (0), matching the stack discipline
            # every other primitive already follows -- still silently
            # WRONG (an unsupported primitive's real behavior is still
            # not implemented), but no longer stack-corrupting.
            let asm = sb_new()
            sb_push(asm, "    ; UNSUPPORTED_PRIMITIVE_ERROR" + x64_nl_char())
            if argc > 0 then
              sb_push(asm, "    add rsp, " + (argc * 8) + x64_nl_char())
            end
            sb_push(asm, "    mov rax, 0" + x64_nl_char())
            sb_push(asm, "    push rax" + x64_nl_char())
            return sb_str(asm)
          end
        end
      end
      end
      end
      end
      end
      end
    end
  end
  end
  end
  end
  end
  end
  end
  end
  end
  end
  end
  end
  end
  end
  return sb_str(sb)
end

# BuildList (Slice 4): the argc elements are already on the real stack
# in left-to-right pushed order (leftmost/element[0] deepest). Same
# [8-byte length][elements] block layout as strings, except each
# element is a plain qword (no byte-packing needed -- every PatLang
# value in this backend is already a qword, so a "list of anything" is
# trivially a list of qwords, including string/list addresses
# themselves). Allocates via an ordinary Call to rt_heap_alloc (same
# internal calling convention as any other function call), using r12
# (non-volatile, safe across that call) to hold the new list's address
# while the pushed elements get popped into it in reverse order.
# List block format is [length:8][capacity:8][elements...] (see
# rt_list_push's own header for why capacity tracking exists) --
# BuildList allocates TIGHT (capacity == length), elements start at
# offset 16.
make a function called x64_buildlist_asm takes argc returns asm
  let n = to_num(argc)
  let sb = sb_new()
  sb_push(sb, "    mov rax, " + (16 + n * 8) + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  sb_push(sb, "    call rt_heap_alloc" + x64_nl_char())
  sb_push(sb, "    add rsp, 8" + x64_nl_char())
  sb_push(sb, "    mov r12, rax" + x64_nl_char())
  sb_push(sb, "    mov qword [r12], " + n + x64_nl_char())
  sb_push(sb, "    mov qword [r12+8], " + n + x64_nl_char())
  let k = n - 1
  while k >= 0 do
    sb_push(sb, "    pop r10" + x64_nl_char())
    sb_push(sb, "    mov [r12+" + (16 + k * 8) + "], r10" + x64_nl_char())
    let k = k - 1
  end
  sb_push(sb, "    mov rax, r12" + x64_nl_char())
  sb_push(sb, "    mov rcx, 3458764513820540928" + x64_nl_char())
  sb_push(sb, "    or rax, rcx" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  return sb_str(sb)
end

# MakeClosure(func_name, captured_names) -- captured_names.length is
# compile-time known, so this unrolls exactly like x64_buildlist_asm.
# Block layout: [code address][captured count][captured values...].
make a function called x64_makeclosure_asm takes func_name, captured_names returns asm
  let n = to_num(list_len(captured_names))
  let sb = sb_new()
  sb_push(sb, "    mov rax, " + (16 + n * 8) + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  sb_push(sb, "    call rt_heap_alloc" + x64_nl_char())
  sb_push(sb, "    add rsp, 8" + x64_nl_char())
  sb_push(sb, "    mov r12, rax" + x64_nl_char())
  sb_push(sb, "    lea rax, [rel " + func_name + "]" + x64_nl_char())
  sb_push(sb, "    mov [r12], rax" + x64_nl_char())
  sb_push(sb, "    mov qword [r12+8], " + n + x64_nl_char())
  let k = n - 1
  while k >= 0 do
    sb_push(sb, "    pop r10" + x64_nl_char())
    sb_push(sb, "    mov [r12+16+" + (8 * k) + "], r10" + x64_nl_char())
    let k = k - 1
  end
  sb_push(sb, "    mov rax, r12" + x64_nl_char())
  sb_push(sb, "    mov rcx, 4611686018427387904" + x64_nl_char())
  sb_push(sb, "    or rax, rcx" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  return sb_str(sb)
end

# CallValue(argc) -- the closure's OWN captured count is a runtime
# value (read from the closure object itself), unlike everywhere else
# in this backend where instruction operands are compile-time known --
# see this file's own header for the full stack-shuffling explanation.
make a function called x64_callvalue_asm takes argc, spilled returns asm
  let n = to_num(argc)
  # The current function's own private scratch slot, one past its last
  # named local (see x64_emit_func's frame_size reservation) -- used to
  # carry the closure's captured-count across the opaque `call` below,
  # since nothing about this backend's calling convention guarantees
  # any register survives a call, and a shared/global location would
  # be unsafe under recursion or a closure that itself calls another
  # closure before returning. Private to THIS activation's own rbp, so
  # every nested/recursive call gets its own independent copy for free.
  let cv_slot_offset = 8 * (to_num(list_len(spilled)) + 1)
  let sb = sb_new()
  # 1. Pop the N already-pushed own-args into the scratch buffer, out
  #    of the way, so the closure's captured values can be pushed
  #    underneath where they belong first.
  let k = n - 1
  while k >= 0 do
    sb_push(sb, "    pop rax" + x64_nl_char())
    sb_push(sb, "    lea r10, [rel g_scratch]" + x64_nl_char())
    sb_push(sb, "    mov [r10+" + (8 * k) + "], rax" + x64_nl_char())
    let k = k - 1
  end
  # 2. Pop the closure value itself (now on top) -- mask off the tag
  #    (family 0x4, since closures are tagged now) before treating it
  #    as a real address; every dereference below (code addr, captured
  #    count, captured values) reads through this masked r14.
  sb_push(sb, "    pop r14" + x64_nl_char())
  sb_push(sb, "    mov rcx, 281474976710655" + x64_nl_char())
  sb_push(sb, "    and r14, rcx" + x64_nl_char())
  sb_push(sb, "    mov r12, [r14]" + x64_nl_char())
  sb_push(sb, "    mov r13, [r14+8]" + x64_nl_char())
  sb_push(sb, "    mov [rbp-" + cv_slot_offset + "], r13" + x64_nl_char())
  # 3. Push the closure's captured values, in order -- a genuine
  #    runtime loop, since r13 (captured count) isn't compile-time
  #    known here.
  let suffix = label_asm_safe(argc)
  sb_push(sb, "    xor r10, r10" + x64_nl_char())
  sb_push(sb, "  .cv_loop_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    cmp r10, r13" + x64_nl_char())
  sb_push(sb, "    jge .cv_done_" + suffix + x64_nl_char())
  sb_push(sb, "    mov rax, [r14+16+r10*8]" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  sb_push(sb, "    inc r10" + x64_nl_char())
  sb_push(sb, "    jmp .cv_loop_" + suffix + x64_nl_char())
  sb_push(sb, "  .cv_done_" + suffix + ":" + x64_nl_char())
  # 4. Push the own-args back on top, in original order.
  let i = 0
  while i < n do
    sb_push(sb, "    lea r10, [rel g_scratch]" + x64_nl_char())
    sb_push(sb, "    mov rax, [r10+" + (8 * i) + "]" + x64_nl_char())
    sb_push(sb, "    push rax" + x64_nl_char())
    let i = i + 1
  end
  # 5. Indirect call, then clean up -- captured count is read back from
  #    THIS frame's own private slot (step 2), not from any register,
  #    since r12/r13/r14 are not guaranteed to survive the call.
  sb_push(sb, "    call r12" + x64_nl_char())
  sb_push(sb, "    mov rdx, [rbp-" + cv_slot_offset + "]" + x64_nl_char())
  sb_push(sb, "    add rdx, " + n + x64_nl_char())
  sb_push(sb, "    shl rdx, 3" + x64_nl_char())
  sb_push(sb, "    add rsp, rdx" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  return sb_str(sb)
end

# CallValue call sites need locally-unique NASM labels for their
# internal push-captured-values loop -- set_var-based counter, same
# pattern as the string-literal labels, since a program can contain
# more than one CallValue instruction.
make a function called label_asm_safe takes ignored returns label
  let n = to_num(get("__vars", "__x64_cv_counter"))
  set_var("__x64_cv_counter", n + 1)
  return "" + n
end

make a function called x64_emit_instr takes instr, func_name, regmap, spilled, label, is_float_bin, is_float_const, is_dynamic_bin, bool_print_override, float_print_override, is_tower_ctor_arg returns asm
  let sb = sb_new()
  sb_push(sb, label + ":" + x64_nl_char())
  let ty = instr[0]
  if ty == "Const" then
    let kind = instr[1]
    if kind == "bool" then
      # GitHub #24: tagged with the dedicated Bool family (6 shl 60)
      # instead of a bare fixnum 0/1, so print/type_of/send-dispatch can
      # tell a genuine Bool apart from "a fixnum that happens to be 0 or
      # 1" -- see x64_family_code_asm's own header for the tag value.
      if instr[2] == "true" then
        sb_push(sb, "    mov rax, 6917529027641081857" + x64_nl_char())
      else
        sb_push(sb, "    mov rax, 6917529027641081856" + x64_nl_char())
      end
      sb_push(sb, "    push rax" + x64_nl_char())
    else
      if kind == "str" then
        let label = x64_string_label_next()
        sb_push(sb, "    lea rax, [rel " + label + "]" + x64_nl_char())
        sb_push(sb, "    mov rcx, 2305843009213693952" + x64_nl_char())
        sb_push(sb, "    or rax, rcx" + x64_nl_char())
        sb_push(sb, "    push rax" + x64_nl_char())
      else
        # GitHub #37: this Const's own encoding is now decided per-
        # INSTRUCTION (`is_float_const`, from x64_analyze_float_consts)
        # instead of the old whole-function `float_mode` blanket --
        # see that analysis's own header comment for the full
        # reasoning and the real bug this replaced (a bare int literal
        # anywhere in a function containing an UNRELATED float literal
        # used to always get encoded as a float bit pattern, corrupting
        # it the moment it reached real plain-int arithmetic).
        # `is_float_const` only tracks dotless literals stage 2 proved
        # need float re-encoding -- a literal that ALREADY has a dot
        # (a genuine float literal like 10.0) always needs the
        # __float64__ wrapper regardless, so check both.
        if is_float_const or x64_contains(instr[2], ".") then
          sb_push(sb, "    mov rax, __float64__(" + x64_float_literal_text(instr[2]) + ")" + x64_nl_char())
          sb_push(sb, "    push rax" + x64_nl_char())
        else
          # GitHub #38 investigation, second and deeper bug found: a
          # bare integer LITERAL exceeding this backend's 48-bit signed
          # fixnum range (+-140737488355327) was ALWAYS emitted as a
          # raw untagged `mov rax, <literal>` regardless of magnitude
          # -- no promotion ever happens for a literal that's already
          # "too big" from the moment it's created (promotion only
          # ever triggers on ARITHMETIC overflow, detected after an
          # operation). Such a value then matches NEITHER "genuine
          # fixnum" (fails the round-trip test) NOR "real tagged
          # BigInt" (its family nibble is 0, since it was never
          # actually tagged) in any downstream dynamic dispatch --
          # confirmed exactly: `123456789012345 + 987654321098765`
          # (987654321098765 needs 50 bits, already past the 48-bit
          # boundary as a bare literal) silently gave `0`, having
          # fallen through `x64_binop_asm_dynamic`'s `DYN_OBJ_` catch-
          # all (neither a valid fixnum nor a recognized tag) to its
          # generic GIVEUP default. Fixed at the source: a literal
          # this large is promoted to a genuine BigInt (tagged via
          # `rt_bigint_from_i64`) the moment it's constructed, so every
          # value reaching arithmetic is either a genuine <=48-bit
          # fixnum or a properly tagged BigInt -- restoring the
          # invariant the rest of this backend's tagging scheme already
          # assumes. `to_num` here parses on the COMPILER's own host
          # side (a real, full-precision number), not the TARGET
          # program's constrained 48-bit representation, so this
          # comparison itself can't overflow.
          # Real bug found and fixed here (same CLASS as the
          # rt_payload_mask fix earlier this session, but a name-prefix
          # exclusion doesn't cover it): x64_runtime.patlang's OWN
          # functions embed large literal constants as RAW BIT
          # PATTERNS (family/tag masks like 1152921504606846976,
          # 17293822569102704640) -- NOT user-facing numbers -- and
          # unconditionally promoting THOSE via rt_bigint_from_i64
          # corrupted the runtime's own tagging scheme wholesale
          # (confirmed: even `20000000 * 20000000` broke, since
          # rt_bigint_from_i64/print themselves stopped working once
          # their own tag constants got mis-promoted). An `x64_func_
          # is_tower_impl`-style rt_/mem_-prefix exclusion does NOT
          # cover this: `print()` itself uses these exact constants as
          # bare comparison literals in its OWN body and isn't rt_/
          # mem_-prefixed -- and as the user pointed out mid-fix,
          # there's no principled way to call ANY PatLang function
          # "not user code", since x64_runtime.patlang is itself
          # ordinary PatLang compiled by this same pipeline. A real fix
          # (a function declaring "my literals are raw bits, exempt me
          # from numeric-tower semantics") is GitHub #33-adjacent
          # scope, not done here. Interim, narrower mitigation instead:
          # never promote a literal whose value EXACTLY matches one of
          # this backend's own known tag/mask constants -- a real
          # user-facing number essentially never coincidentally equals
          # one of these specific values.
          # Real bug found while testing THIS exclusion list itself:
          # PatLang's own literal parser silently CLAMPS an integer
          # literal exceeding i64::MAX to i64::MAX at parse time,
          # rather than promoting it to a real BigInt the way
          # arithmetic OVERFLOW correctly does -- confirmed directly
          # (`print(17293822569102704640)` gives `9223372036854775807`,
          # not the real value). This meant `to_num(instr[2])` could
          # never equal the numerically-correct comparison value for
          # family_mask (which exceeds i64::MAX), so the exclusion
          # silently never matched. Fixed by comparing the literal's
          # own RAW SOURCE TEXT instead of its parsed numeric value --
          # sidesteps this parser bug entirely, and is simpler besides.
          # (Exclusion list + magnitude check now shared with pass 1's
          # x64_collect_string_data via x64_num_const_needs_bigint_
          # promotion -- see GitHub #40.)
          let needs_promotion = x64_num_const_needs_bigint_promotion(instr[2])
          if is_tower_ctor_arg then
            let needs_promotion = false
          end
          if needs_promotion then
            # GitHub #40: a bare `mov rax, <text>` + rt_bigint_from_i64
            # silently corrupted any literal whose bit pattern's top
            # bit is set (e.g. 18446744073709551615, u64::MAX, encodes
            # to the same 64 bits as -1) since rt_bigint_from_i64
            # sign-extends its single register argument -- and could
            # never represent a literal larger than 2^64-1 at all
            # (no register holds it). Fixed: parse the literal's own
            # decimal TEXT directly via rt_bigint_from_decimal_str,
            # loaded from the .data label x64_collect_string_data (pass
            # 1) already reserved for this exact instruction.
            let label = x64_string_label_next()
            sb_push(sb, "    lea rax, [rel " + label + "]" + x64_nl_char())
            sb_push(sb, "    mov rcx, 2305843009213693952" + x64_nl_char())
            sb_push(sb, "    or rax, rcx" + x64_nl_char())
            sb_push(sb, "    push rax" + x64_nl_char())
            sb_push(sb, "    call rt_bigint_from_decimal_str" + x64_nl_char())
            sb_push(sb, "    add rsp, 8" + x64_nl_char())
            sb_push(sb, "    push rax" + x64_nl_char())
          else
            sb_push(sb, "    mov rax, " + instr[2] + x64_nl_char())
            sb_push(sb, "    push rax" + x64_nl_char())
          end
        end
      end
    end
  else
    if ty == "Load" then
      let reg = x64_reg_for_name(regmap, instr[1])
      if reg == "" then
        let slot = x64_local_index(spilled, instr[1])
        sb_push(sb, "    mov rax, [rbp-" + (8 * (slot + 1)) + "]" + x64_nl_char())
      else
        sb_push(sb, "    mov rax, " + reg + x64_nl_char())
      end
      sb_push(sb, "    push rax" + x64_nl_char())
    else
      if ty == "Store" then
        let reg = x64_reg_for_name(regmap, instr[1])
        sb_push(sb, "    pop rax" + x64_nl_char())
        if reg == "" then
          let slot = x64_local_index(spilled, instr[1])
          sb_push(sb, "    mov [rbp-" + (8 * (slot + 1)) + "], rax" + x64_nl_char())
        else
          sb_push(sb, "    mov " + reg + ", rax" + x64_nl_char())
        end
      else
        if ty == "Bin" then
          # GitHub #37: per-instruction, not whole-function.
          if is_float_bin then
            sb_push(sb, x64_binop_asm_float(instr[1]))
          else
            if is_dynamic_bin then
              if instr[1] == "/" then
                sb_push(sb, x64_binop_asm_div_dynamic(spilled))
              else
                if instr[1] == "%" then
                  sb_push(sb, x64_binop_asm_mod_dynamic(spilled))
                else
                  if x64_dynamic_op_supported(instr[1]) then
                    sb_push(sb, x64_binop_asm_dynamic(instr[1], spilled))
                  else
                    # Named scope limit: band/bor/bxor/shl/shr still
                    # aren't meaningful on the numeric tower (or aren't
                    # wired up yet), so they compile as plain int
                    # arithmetic on the raw tagged word inside a dynamic-
                    # mode function -- only correct if that operand is
                    # actually a fixnum. See x64_runtime.patlang's header.
                    sb_push(sb, x64_binop_asm(instr[1]))
                  end
                end
              end
            else
              sb_push(sb, x64_binop_asm(instr[1]))
            end
          end
        else
          if ty == "Un" then
            # Matches codegen.patlang's own three-way Un dispatch
            # (UnOpKind::Not/BitNot/Neg) exactly -- "not" is boolean
            # logical not (any nonzero -> 0, zero -> 1, not a bitwise
            # complement), "bnot" is the real bitwise complement, and
            # anything else (this IR only ever produces "-" here) is
            # arithmetic negation. Never dynamic-dispatched -- no
            # existing code path does that for Un either.
            sb_push(sb, "    pop rax" + x64_nl_char())
            if instr[1] == "not" then
              # GitHub #24: the operand may now be a Bool-TAGGED value
              # (family 6 shl 60), which is never bit-for-bit zero even
              # when its payload is false -- mask off the tag (payload-
              # only compare) before testing truthiness, matching
              # JumpIfFalse's own identical fix just below. and/or's
              # own lowering (lib/lower.patlang) composes THIS "not" op
              # for its short-circuit canonicalization, so fixing it
              # here covers and/or too, not just a literal `not x`.
              sb_push(sb, "    mov r10, 281474976710655" + x64_nl_char())
              sb_push(sb, "    and rax, r10" + x64_nl_char())
              sb_push(sb, "    cmp rax, 0" + x64_nl_char())
              sb_push(sb, "    sete al" + x64_nl_char())
              sb_push(sb, "    movzx rax, al" + x64_nl_char())
              sb_push(sb, "    mov r10, 6917529027641081856" + x64_nl_char())
              sb_push(sb, "    or rax, r10" + x64_nl_char())
            else
              if instr[1] == "bnot" then
                sb_push(sb, "    not rax" + x64_nl_char())
              else
                # GitHub #37: per-instruction, not whole-function.
                if is_float_bin then
                  # Real bug found alongside the modulo/float-literal
                  # fixes: `neg` is a two's-complement INTEGER negation
                  # on the raw 64-bit register -- applied to a double's
                  # raw bit pattern, this is NOT a sign flip in general
                  # (the NOT+1 carry chain can propagate into the
                  # exponent field), e.g. -1.5's bit pattern
                  # (0x3FF8000000000000) two's-complement-negates to
                  # 0xC008000000000000, which is -3.0, not -1.5 --
                  # silently wrong by exactly 2x for this literal, not
                  # a crash, so easy to miss without a direct
                  # arithmetic check. Correct float negation only
                  # toggles the sign bit (bit 63), done here as a plain
                  # GPR XOR against the sign mask -- no SSE round-trip
                  # needed since the value's bits are already sitting
                  # in rax.
                  sb_push(sb, "    mov r10, 9223372036854775808" + x64_nl_char())
                  sb_push(sb, "    xor rax, r10" + x64_nl_char())
                else
                  sb_push(sb, "    neg rax" + x64_nl_char())
                end
              end
            end
            sb_push(sb, "    push rax" + x64_nl_char())
          else
          if ty == "Jump" then
            sb_push(sb, "    jmp L_" + func_name + "_" + instr[1] + x64_nl_char())
          else
            if ty == "JumpIfFalse" then
              sb_push(sb, "    pop rax" + x64_nl_char())
              # GitHub #24: the condition value may now be Bool-TAGGED
              # (family 6 shl 60), which is never bit-for-bit zero even
              # when false -- mask to the payload before comparing, the
              # SAME fix as the "not" Un-op just above (this is the
              # ONLY JumpIfFalse emission site in the whole backend, so
              # this one change covers every if/while condition).
              sb_push(sb, "    mov r10, 281474976710655" + x64_nl_char())
              sb_push(sb, "    and rax, r10" + x64_nl_char())
              sb_push(sb, "    cmp rax, 0" + x64_nl_char())
              sb_push(sb, "    je L_" + func_name + "_" + instr[1] + x64_nl_char())
            else
              if ty == "CallHost" then
                sb_push(sb, x64_callhost_asm(instr[1], instr[2], spilled))
              else
                if ty == "Call" then
                  if bool_print_override then
                    sb_push(sb, "    call rt_print_bool" + x64_nl_char())
                  else
                    if float_print_override then
                      sb_push(sb, "    call rt_print_float" + x64_nl_char())
                    else
                      sb_push(sb, "    call " + x64_asm_label_for_func(instr[1]) + x64_nl_char())
                    end
                  end
                  let argc = to_num(instr[2])
                  if argc > 0 then
                    sb_push(sb, "    add rsp, " + (argc * 8) + x64_nl_char())
                  end
                  sb_push(sb, "    push rax" + x64_nl_char())
                else
                  if ty == "BuildList" then
                    sb_push(sb, x64_buildlist_asm(instr[1]))
                  else
                  if ty == "MakeClosure" then
                    sb_push(sb, x64_makeclosure_asm(instr[1], instr[2]))
                  else
                  if ty == "CallValue" then
                    sb_push(sb, x64_callvalue_asm(instr[1], spilled))
                  else
                  if ty == "Return" then
                    if func_name == "main" then
                      sb_push(sb, "    mov r15, rsp" + x64_nl_char())
                      sb_push(sb, "    sub rsp, 32" + x64_nl_char())
                      sb_push(sb, "    and rsp, -16" + x64_nl_char())
                      sb_push(sb, "    mov rcx, 0" + x64_nl_char())
                      sb_push(sb, "    call ExitProcess" + x64_nl_char())
                    else
                      sb_push(sb, "    pop rax" + x64_nl_char())
                      sb_push(sb, "    leave" + x64_nl_char())
                      sb_push(sb, "    ret" + x64_nl_char())
                    end
                  else
                    print("codegen_x64: unsupported IR instruction for Slice 1: " + ty)
                    # Real bug found and fixed here during the patc1
                    # self-compile fixpoint attempt (the actual root
                    # cause behind a wall of confusing "label changed
                    # during code generation" / "symbol not defined"
                    # NASM errors, not a NASM quirk at all): `sb`
                    # already has THIS instruction's own required
                    # label pushed to it at the top of this function
                    # (`label + ":"`) -- a bare `return "..."` here
                    # DISCARDS that already-built sb content entirely,
                    # silently dropping the label for this specific
                    # instruction index. Any OTHER instruction whose
                    # jump target points at this exact index (a very
                    # real case for any Un-instruction inside an
                    # if/while condition, e.g. `not`/unary `-` in a
                    # loop guard) then references a label that was
                    # simply never emitted. Fixed by pushing the error
                    # text into `sb` and returning `sb_str(sb)`
                    # instead, so the label survives.
                    sb_push(sb, "    ; UNSUPPORTED_INSTR_ERROR" + x64_nl_char())
                    return sb_str(sb)
                  end
                  end
                  end
                  end
                end
              end
            end
          end
          end
        end
      end
    end
  end
  return sb_str(sb)
end

# ---- one function -> nasm text ----

# ---- Slice 6: a narrowly, safely scoped register-usage win ----
#
# NOT a general register allocator -- that needs real liveness
# analysis with control-flow-merge-point consistency, a much larger
# and riskier undertaking. Instead: recognize the single most common
# wasteful pattern, `Const num` immediately followed by `Bin op`
# (loop counters, comparisons against a fixed bound -- `i + 1`,
# `i < 10`, extremely common in real code), and collapse the
# push-then-pop round-trip into ONE instruction using the constant as
# an immediate operand, which x86 supports directly for add/sub/imul/
# cmp. `/` and `%` are excluded -- `idiv` has no immediate-operand
# form, so fusing them would need to load the constant into a register
# first anyway, defeating the point.
#
# SAFETY: this is only correct if nothing can jump directly into the
# MIDDLE of the fused pair (skipping the Const's own contribution) --
# so fusion only fires when the Bin instruction's own index is NOT a
# jump target anywhere in the function. x64_collect_jump_targets scans
# every Jump/JumpIfFalse in the function once per call to check this.

make a function called x64_collect_jump_targets takes instrs returns targets
  let targets = []
  let n = to_num(list_len(instrs))
  let i = 0
  while i < n do
    let instr = instrs[i]
    if instr[0] == "Jump" then
      let targets = list_push(targets, to_num(instr[1]))
    else
      if instr[0] == "JumpIfFalse" then
        let targets = list_push(targets, to_num(instr[1]))
      end
    end
    let i = i + 1
  end
  return targets
end

make a function called x64_is_jump_target takes targets, idx returns yes
  let n = to_num(list_len(targets))
  let i = 0
  while i < n do
    if targets[i] == idx then
      return true
    end
    let i = i + 1
  end
  return false
end

# Real bug found while adding band/bor/bxor/shl/shr support (needed by
# the numeric-tower tagging scheme's own tag-packing arithmetic): this
# was an exclude-list ("everything fuses except / and %"), so the new
# bitwise ops silently fell through x64_fused_const_binop_asm's own
# unguarded else-branch and were mis-emitted as comparisons (cmp+setcc)
# -- wrong output with no error at all. Switched to an explicit
# include-list so a future new Bin op defaults to NOT fusing (safe:
# falls back to the always-correct non-fused x64_binop_asm path) rather
# than defaulting to fuse-and-hope, like x86 immediate-operand support
# actually varies per op is genuinely case-by-case.
make a function called x64_fusable_binop takes op returns yes
  if op == "+" then
    return true
  end
  if op == "-" then
    return true
  end
  if op == "*" then
    return true
  end
  if op == "==" then
    return true
  end
  if op == "!=" then
    return true
  end
  if op == "<" then
    return true
  end
  if op == "<=" then
    return true
  end
  if op == ">" then
    return true
  end
  if op == ">=" then
    return true
  end
  return false
end

# The fused Const+Bin sequence: pop the LEFT operand (already on the
# stack from whatever came before the Const), operate against the
# constant as an immediate, push the result. Same result-in-rax/push
# convention as x64_binop_asm, just without ever materializing the
# constant to the stack at all.
#
# Real bug found and fixed here (interp.patlang-compilation roadmap
# #25, hash_string's own FNV-1a prime 1099511628211): `add`/`sub`/`cmp
# reg64, imm` and the 3-operand `imul reg64, reg64, imm` ALL only
# support a 32-bit immediate (sign-extended to 64 bits by the CPU) --
# there is no encoding for a genuine 64-bit immediate operand in any of
# these forms. This function used to emit the constant text directly
# regardless of its magnitude; NASM silently accepted a value beyond
# the signed-32-bit range and encoded something else entirely (not an
# assembler error, just the wrong instruction semantics), corrupting
# any multiply/add/sub/compare against a constant that size. Confirmed
# exactly: `hash * 1099511628211` (1099511628211 ~= 1.1e12, nowhere
# near fitting in 32 bits) produced a value matching the correct
# answer's low 32 bits but wrong upper 32 bits -- textbook signature of
# a truncated-immediate multiply. Fixed: constants outside
# [-2147483648, 2147483647] now load into r10 via a real 64-bit `mov`
# first, then use the register-register form of each op (no immediate
# involved at all, so no magnitude limit).
make a function called x64_fused_const_binop_asm takes const_text, op returns asm
  let sb = sb_new()
  let n = to_num(const_text)
  let fits_imm32 = (n >= 0 - 2147483648) and (n <= 2147483647)
  sb_push(sb, "    pop rax" + x64_nl_char())
  if not fits_imm32 then
    sb_push(sb, "    mov r10, " + const_text + x64_nl_char())
  end
  if op == "+" then
    if fits_imm32 then
      sb_push(sb, "    add rax, " + const_text + x64_nl_char())
    else
      sb_push(sb, "    add rax, r10" + x64_nl_char())
    end
  else
    if op == "-" then
      if fits_imm32 then
        sb_push(sb, "    sub rax, " + const_text + x64_nl_char())
      else
        sb_push(sb, "    sub rax, r10" + x64_nl_char())
      end
    else
      if op == "*" then
        if fits_imm32 then
          sb_push(sb, "    imul rax, rax, " + const_text + x64_nl_char())
        else
          sb_push(sb, "    imul rax, r10" + x64_nl_char())
        end
      else
        if fits_imm32 then
          sb_push(sb, "    cmp rax, " + const_text + x64_nl_char())
        else
          sb_push(sb, "    cmp rax, r10" + x64_nl_char())
        end
        if op == "==" then
          sb_push(sb, "    sete al" + x64_nl_char())
        else
          if op == "!=" then
            sb_push(sb, "    setne al" + x64_nl_char())
          else
            if op == "<" then
              sb_push(sb, "    setl al" + x64_nl_char())
            else
              if op == "<=" then
                sb_push(sb, "    setle al" + x64_nl_char())
              else
                if op == ">" then
                  sb_push(sb, "    setg al" + x64_nl_char())
                else
                  sb_push(sb, "    setge al" + x64_nl_char())
                end
              end
            end
          end
        end
        sb_push(sb, "    movzx rax, al" + x64_nl_char())
        # GitHub #24: same Bool-tagging as x64_binop_asm's own
        # comparison branches -- this fused Const+Bin peephole is a
        # SEPARATE codegen path from x64_binop_asm (bypasses it
        # entirely for a Const-then-compare shape), so needed its own
        # copy of the fix; found by generating and reading the actual
        # asm for a real test case (`let x = 5 == 5`), not by assuming
        # the earlier 3-site fix was exhaustive.
        sb_push(sb, "    mov r10, 6917529027641081856" + x64_nl_char())
        sb_push(sb, "    or rax, r10" + x64_nl_char())
      end
    end
  end
  sb_push(sb, "    push rax" + x64_nl_char())
  return sb_str(sb)
end

make a function called x64_emit_func takes func, float_mode, dynamic_mode, float_func_names returns asm
  let func_name = func[1]
  let params = func[2]
  let instrs = func[3]
  let locals = x64_collect_locals(func)
  # GitHub #29: per-instruction, not whole-function, dynamic dispatch --
  # see x64_analyze_dynamic_bins's own header comment. A function with
  # zero string/tower content anywhere (dynamic_mode false) skips the
  # analysis entirely and gets dyn_bin_indices=[] for free, matching
  # today's fast path for the common all-int case at no extra compile
  # cost.
  # GitHub #29: per-instruction, not whole-function, dynamic dispatch --
  # see x64_analyze_dynamic_bins's own header comment. A function with
  # zero string/tower/arithmetic content anywhere (dynamic_mode false)
  # skips the analysis entirely and gets dyn_bin_indices=[] for free,
  # matching today's fast path for the common all-int case at no extra
  # compile cost. (x64_func_is_dynamic itself now also covers "contains
  # a +/-/* anywhere" -- see its own header for why.)
  let dyn_bin_indices = []
  if dynamic_mode then
    let dyn_bin_indices = x64_analyze_dynamic_bins(instrs)
  end
  # GitHub #38 follow-up: see x64_tower_ctor_arg_indices's own header --
  # a bare oversized literal passed directly to a tower-constructor
  # call must skip the new Const auto-promotion, since the constructor
  # already promotes its own raw argument.
  let tower_ctor_arg_indices = x64_tower_ctor_arg_indices(instrs)
  # Register allocation (Slice 8, see x64_reg_pool/x64_build_regmap):
  # eligible locals get a dedicated rbx/r13/r14 for their whole function
  # lifetime instead of a stack slot; everything else spills exactly as
  # before this slice.
  let regmap = x64_build_regmap(locals, instrs, dyn_bin_indices)
  let spilled = x64_spilled_locals(locals, regmap)
  # +1 extra slot beyond the (spilled) named locals, ALWAYS reserved,
  # for CallValue's own per-frame scratch (see x64_callvalue_asm) -- a
  # value that must survive an opaque `call` this backend's own
  # calling convention gives no register-preservation guarantee
  # across. Using a private slot in the CURRENT function's own stack
  # frame (not a shared/global location) makes it safe under
  # recursion/re-entrancy for free: every active call gets its own
  # rbp, so every active call's copy of this slot is independent.
  # +2 further slots (dyn_a/dyn_b, same offsets every dynamic-dispatch
  # codegen function derives from `spilled` -- see
  # x64_dynamic_promote_both_asm and siblings) hold the dynamic Bin
  # operand pair, freeing r13/r14 for the locals register allocator
  # (patlang-x64-register-allocator-slice8). ALWAYS reserved, same
  # unconditional-reservation reasoning as the CallValue slot above.
  let frame_size = 8 * (to_num(list_len(spilled)) + 3)
  if frame_size < 16 then
    let frame_size = 16
  end
  let sb = sb_new()
  sb_push(sb, x64_asm_label_for_func(func_name) + ":" + x64_nl_char())
  sb_push(sb, "    push rbp" + x64_nl_char())
  sb_push(sb, "    mov rbp, rsp" + x64_nl_char())
  sb_push(sb, "    sub rsp, " + frame_size + x64_nl_char())
  let argc = to_num(list_len(params))
  let p = 0
  while p < argc do
    let src_offset = 16 + 8 * (argc - 1 - p)
    sb_push(sb, "    mov rax, [rbp+" + src_offset + "]" + x64_nl_char())
    let reg = x64_reg_for_name(regmap, params[p])
    if reg == "" then
      let slot = x64_local_index(spilled, params[p])
      sb_push(sb, "    mov [rbp-" + (8 * (slot + 1)) + "], rax" + x64_nl_char())
    else
      sb_push(sb, "    mov " + reg + ", rax" + x64_nl_char())
    end
    let p = p + 1
  end
  let n = to_num(list_len(instrs))
  let jump_targets = x64_collect_jump_targets(instrs)
  # GitHub #37: per-INSTRUCTION float classification replaces the old
  # whole-function `float_mode` blanket (see this analysis's own
  # header comment above x64_taint_one_pass_float for the full
  # reasoning). `float_mode` here still gates whether to bother
  # running the analysis at all -- a function with zero float literals
  # anywhere (x64_func_is_float false) skips it entirely and gets
  # empty results for free, matching today's fast path for the common
  # all-int case at no extra compile cost, same "gate the analysis,
  # not the per-instruction decision" pattern #29 already established
  # for dynamic_mode/dyn_bin_indices.
  let float_instr_indices = []
  let produces_float = []
  let float_const_indices = []
  if float_mode then
    let float_result = x64_analyze_float_bins(instrs, float_func_names)
    let float_instr_indices = float_result[0]
    let produces_float = float_result[1]
    let float_const_indices = x64_analyze_float_consts(instrs, float_result[2], float_instr_indices)
  end
  let bool_print_overrides = x64_bool_print_call_indices(instrs)
  let i = 0
  while i < n do
    let instr = instrs[i]
    let fused = false
    # GitHub #29/#37: the compact fused form assumes a plain native op
    # -- only safe when NEITHER the current Const nor the upcoming Bin
    # is dynamic OR float per their own per-instruction analyses (a
    # mixed function can still fuse its provably-plain-int Bin ops).
    if not x64_str_in_list(dyn_bin_indices, i + 1) then
    if not x64_str_in_list(float_instr_indices, i + 1) then
    if not x64_str_in_list(float_const_indices, i) then
    if i + 1 < n then
      let next = instrs[i + 1]
      if instr[0] == "Const" then
        if instr[1] == "num" then
          if next[0] == "Bin" then
            if x64_fusable_binop(next[1]) then
              if not x64_is_jump_target(jump_targets, i + 1) then
                let fused = true
              end
            end
          end
        end
      end
    end
    end
    end
    end
    if fused then
      sb_push(sb, "L_" + func_name + "_" + i + ":" + x64_nl_char())
      sb_push(sb, "L_" + func_name + "_" + (i + 1) + ":" + x64_nl_char())
      sb_push(sb, x64_fused_const_binop_asm(instr[2], instrs[i + 1][1]))
      let i = i + 2
    else
      let label = "L_" + func_name + "_" + i
      let is_bool_print = x64_str_in_list(bool_print_overrides, i)
      let is_float_print = false
      if instr[0] == "Call" then
        if instr[1] == "print" then
          if to_num(instr[2]) == 1 then
            if not is_bool_print then
              if i > 0 then
                let is_float_print = produces_float[i - 1]
              end
            end
          end
        end
      end
      let is_dynamic_bin = x64_str_in_list(dyn_bin_indices, i)
      let is_float_bin = x64_str_in_list(float_instr_indices, i)
      let is_float_const = x64_str_in_list(float_const_indices, i)
      let is_tower_ctor_arg = x64_str_in_list(tower_ctor_arg_indices, i)
      sb_push(sb, x64_emit_instr(instr, func_name, regmap, spilled, label, is_float_bin, is_float_const, is_dynamic_bin, is_bool_print, is_float_print, is_tower_ctor_arg))
      let i = i + 1
    end
  end
  return sb_str(sb)
end

# ---- narrow real fix for GitHub #18: a bare int Const pushed directly
# as one of a Call's arguments (straight-line Const/Load pushes, no
# intervening Bin/Un) to a NAMED, statically-known callee that is
# itself NOT float-mode must be encoded as plain int, regardless of
# the CALLER's own blanket float_mode -- the caller's classification is
# a whole-FUNCTION decision (x64_func_is_float), but a Call's argument
# types are dictated by the CALLEE, which is staticness-known here
# (unlike a dynamically-dispatched closure CallValue, genuinely out of
# scope -- see #18's own text). Deliberately narrow: only bare literal/
# variable arguments in a straight run right before the Call are
# covered; a computed expression argument (any Bin/Un in that run)
# falls back to the existing warning-only behavior, since disentangling
# "was this float arithmetic genuinely intended" from "did an untyped
# literal just pass through" needs the full per-value tagging this
# file's header already names as deliberately deferred.

make a function called x64_str_in_list takes items, target returns yes
  let n = to_num(list_len(items))
  let i = 0
  while i < n do
    if items[i] == target then
      return true
    end
    let i = i + 1
  end
  return false
end

make a function called x64_collect_float_func_names takes funcs returns names
  let out = []
  let i = 0
  let n = to_num(list_len(funcs))
  while i < n do
    if x64_func_is_float(funcs[i]) then
      let out = list_push(out, funcs[i][1])
    end
    let i = i + 1
  end
  return out
end

# Returns the set (as a plain list) of instruction indices, within ONE
# function's own `instrs`, that are bare-int Consts safe to encode as
# plain int despite the function being float_mode -- because they sit
# in a straight-line Const/Load run immediately preceding a Call to a
# named, non-float-mode callee.
# GitHub #38 follow-up, real bug found and fixed: a bare oversized
# literal used DIRECTLY as the argument to a tower-CONSTRUCTOR call
# (e.g. `rt_bigint_from_i64(987654321098765)`, exactly
# x64_bigint_demo.patlang's own explicit-construction pattern) must
# NOT be auto-promoted by x64_emit_instr's new Const-promotion logic
# -- that logic exists so a bare literal reaching ARITHMETIC directly
# (with no explicit constructor call at all, e.g. bench_bigint_arith's
# `c + d`) still ends up correctly tagged; but rt_bigint_from_i64
# itself already expects and promotes a PLAIN raw i64 argument. Pre-
# promoting it first hands the constructor an already-tagged POINTER
# instead of the raw int it decomposes into limbs, corrupting the
# result. Mirrors #18's own `x64_call_arg_int_overrides` structure
# exactly (straight-line Const/Load run immediately before a Call),
# just checking against the fixed set of tower-constructor names
# instead of "callee isn't float_mode".
make a function called x64_tower_ctor_names returns names
  return ["rt_bigint_from_i64", "rt_rational_from_i64", "rt_complex_from_i64", "rt_interval_from_i64", "rt_complex_from_num", "rt_interval_from_num"]
end

# GitHub #58 investigation follow-up: the four `_from_i64` tower
# constructors below all expect a literal that ALREADY fits a genuine
# i64 -- their entire job is to promote an in-range i64 into the
# numeric tower's own representation, the same way arithmetic overflow
# does. A literal that does NOT fit i64 (e.g. rt_bigint_from_i64(
# 99999999999999999999)) is API misuse the compiler can catch
# statically: x64_tower_ctor_arg_indices deliberately EXEMPTS these
# call sites' own literal arguments from the general BigInt-promotion
# logic (x64_num_const_needs_bigint_promotion) specifically so a
# genuinely small literal here stays a raw fixnum -- but that same
# exemption previously let an out-of-range literal through unchecked
# too, silently truncated by NASM's own `mov reg64, imm` wraparound
# with no error at all. `rt_complex_from_num`/`rt_interval_from_num`
# take a raw f64 instead (a much wider representable range in
# practice) and are deliberately not covered here.
make a function called x64_i64_ctor_names returns names
  return ["rt_bigint_from_i64", "rt_rational_from_i64", "rt_complex_from_i64", "rt_interval_from_i64"]
end

# Text-based (not to_num-parsed) i64-range check -- GitHub #40 already
# found that PatLang's own literal parser silently CLAMPS a literal
# exceeding i64::MAX to i64::MAX at parse time, which would make a
# to_num-based comparison useless here for exactly the out-of-range
# literals this needs to catch. Comparing the literal's own decimal
# source text sidesteps that parser bug entirely.
make a function called x64_literal_exceeds_i64_range takes text returns exceeds
  let neg = false
  let digits = text
  if (digits.length > 0) and (substr(digits, 0, 1) == "-") then
    let neg = true
    let digits = substr(digits, 1, digits.length - 1)
  end
  let limit = "9223372036854775807"
  if neg then
    let limit = "9223372036854775808"
  end
  if digits.length > limit.length then
    return true
  end
  if digits.length < limit.length then
    return false
  end
  return digits > limit
end

make a function called x64_check_i64_ctor_literal_range takes ctor_name, text returns unused
  if x64_str_in_list(x64_i64_ctor_names(), ctor_name) then
    if x64_literal_exceeds_i64_range(text) then
      print("COMPILE ERROR: literal " + text + " passed directly to " + ctor_name + "() does not fit in a 64-bit integer (range -9223372036854775808..9223372036854775807).")
      print("  " + ctor_name + "() expects an already-in-range i64 to promote into the numeric tower -- it can't itself represent a literal this large (no register holds it, and it would otherwise silently wrap).")
      print("  Fix: build this value through ordinary arithmetic instead, e.g. write it as a plain literal/expression elsewhere in your program -- the compiler promotes an out-of-range literal to a real BigInt automatically outside a tower-constructor call.")
      # There is no real "halt the process" primitive callable from
      # PatLang source (no `os_exit`/`abort`/`panic` host function
      # exists, and a bare discarded-value Call to an unresolved name
      # is silently skipped rather than erroring -- confirmed directly:
      # only a CAPTURED unresolved call actually raises "host fn ...
      # not found" and stops the interpreter). Deliberately triggering
      # that existing, real halt path is the only reliable way to make
      # sure this compile never proceeds to emit a corrupted immediate
      # -- the message above is the one a user should actually read;
      # the interpreter's own "not found" text after it is expected
      # and can be ignored.
      let halt = x64_fatal_compile_error_halt(text)
    end
  end
  return 0
end

make a function called x64_tower_ctor_arg_indices takes instrs returns indices
  let out = []
  let n = to_num(list_len(instrs))
  let i = 0
  while i < n do
    let instr = instrs[i]
    if instr[0] == "Call" then
      let argc = to_num(instr[2])
      if argc > 0 then
        let start = i - argc
        if start >= 0 then
          let straight_line = true
          let j = start
          while j < i do
            let jty = instrs[j][0]
            if (jty != "Const") and (jty != "Load") then
              let straight_line = false
            end
            let j = j + 1
          end
          if straight_line then
            if x64_str_in_list(x64_tower_ctor_names(), instr[1]) then
              let j = start
              while j < i do
                let cur = instrs[j]
                if cur[0] == "Const" then
                  if cur[1] == "num" then
                    if not x64_contains(cur[2], ".") then
                      x64_check_i64_ctor_literal_range(instr[1], cur[2])
                      let out = list_push(out, j)
                    end
                  end
                end
                let j = j + 1
              end
            end
          end
        end
      end
    end
    let i = i + 1
  end
  return out
end

make a function called x64_call_arg_int_overrides takes instrs, float_func_names returns overrides
  let overrides = []
  let n = to_num(list_len(instrs))
  let i = 0
  while i < n do
    let instr = instrs[i]
    if instr[0] == "Call" then
      let argc = to_num(instr[2])
      if argc > 0 then
        let start = i - argc
        if start >= 0 then
          let straight_line = true
          let j = start
          while j < i do
            let jty = instrs[j][0]
            if (jty != "Const") and (jty != "Load") then
              let straight_line = false
            end
            let j = j + 1
          end
          if straight_line then
            let callee_is_float = x64_str_in_list(float_func_names, instr[1])
            if not callee_is_float then
              let j = start
              while j < i do
                let cur = instrs[j]
                if cur[0] == "Const" then
                  if cur[1] == "num" then
                    if not x64_contains(cur[2], ".") then
                      let overrides = list_push(overrides, j)
                    end
                  end
                end
                let j = j + 1
              end
            end
          end
        end
      end
    end
    let i = i + 1
  end
  return overrides
end

# GitHub #24 fix: a print(v) call whose single argument was JUST
# produced by a Bool-shaped instruction (a literal `true`/`false`, a
# comparison, or `not`) is rerouted to rt_print_bool instead of the
# generic print(), so it prints "true"/"false" instead of "1"/"0" --
# see rt_print_bool's own header in x64_runtime.patlang for the full
# reasoning and scope limits (this is a static, syntactic check, not
# real value tagging).
make a function called x64_is_bool_producing_instr takes instr returns yes
  if instr[0] == "Const" then
    if instr[1] == "bool" then
      return true
    end
    return false
  end
  if instr[0] == "Un" then
    return instr[1] == "not"
  end
  if instr[0] == "Bin" then
    return x64_is_dynamic_cmp_op(instr[1])
  end
  return false
end

make a function called x64_bool_print_call_indices takes instrs returns overrides
  let overrides = []
  let n = to_num(list_len(instrs))
  let i = 0
  while i < n do
    let instr = instrs[i]
    if instr[0] == "Call" then
      if instr[1] == "print" then
        if to_num(instr[2]) == 1 then
          if i > 0 then
            if x64_is_bool_producing_instr(instrs[i - 1]) then
              let overrides = list_push(overrides, i)
            end
          end
        end
      end
    end
    let i = i + 1
  end
  return overrides
end

# Real float-printing fix: a print(v) call inside a float_mode function
# whose argument wasn't already claimed by the bool-print override
# (#24) or the int-Call-arg override (#18, meaning it's a deliberately
# plain-int value despite the surrounding function's float_mode) or a
# string literal is, by elimination, a genuine float value -- reroute
# it to rt_print_float instead of the generic print(), which has no
# way to distinguish a float's raw bit pattern from any other family
# (see print()'s own header in x64_runtime.patlang: it's why floats
# fell through to the "<value>" placeholder in the first place).
make a function called x64_float_print_call_indices takes instrs, float_mode, int_overrides, bool_print_overrides returns overrides
  let out = []
  if not float_mode then
    return out
  end
  let n = to_num(list_len(instrs))
  let i = 0
  while i < n do
    let instr = instrs[i]
    if instr[0] == "Call" then
      if instr[1] == "print" then
        if to_num(instr[2]) == 1 then
          if i > 0 then
            if not x64_str_in_list(bool_print_overrides, i) then
              if not x64_str_in_list(int_overrides, i - 1) then
                let prev = instrs[i - 1]
                let is_str_const = false
                if prev[0] == "Const" then
                  if prev[1] == "str" then
                    let is_str_const = true
                  end
                end
                if not is_str_const then
                  let out = list_push(out, i)
                end
              end
            end
          end
        end
      end
    end
    let i = i + 1
  end
  return out
end

# ---- whole program -> nasm text ----

# A small local substring check -- NOT lib/x64_build.patlang's
# x64_build_contains (a different file; this backend's own driver
# scripts include only THIS file, so it needs its own copy, same
# reasoning x64_build.patlang used for not depending on lib/
# test.patlang's contains_text).
make a function called x64_contains takes hay, needle returns r
  let hn = to_num(sc_len(str_intern(hay)))
  let nn = to_num(sc_len(str_intern(needle)))
  if nn > hn then
    return false
  end
  let i = 0
  while i <= hn - nn do
    if substr(hay, i, nn) == needle then
      return true
    end
    let i = i + 1
  end
  return false
end

# Whole-program float-mode detection (Slice 7) -- see this file's own
# header for why this is a WHOLE-PROGRAM decision, not per-value.
# Scoped PER-FUNCTION, not whole-program: an earlier draft scanned the
# entire program (including the PatLang-authored runtime prelude that
# gets concatenated ahead of every user program), which silently broke
# rt_print_i64's own digit-extraction `%`/`/` the moment ANY float
# literal appeared anywhere in a program, since one shared flag forced
# EVERY function's Bin instructions -- including the runtime's -- into
# float mode. A function's own float-ness is still a whole-FUNCTION
# decision (no per-value type tagging), just no longer a whole-program
# one -- each function is independently plain-int or all-float based
# on whether ITS OWN body contains a float literal.
make a function called x64_func_is_float takes func returns yes
  let instrs = func[3]
  let i = 0
  let n = to_num(list_len(instrs))
  while i < n do
    let instr = instrs[i]
    if instr[0] == "Const" then
      if instr[1] == "num" then
        if x64_contains(instr[2], ".") then
          return true
        end
      end
    end
    let i = i + 1
  end
  return false
end

# Numeric-tower "dynamic mode" detection (first working cut -- see
# x64_runtime.patlang's own header above rt_bigint_from_i64 for the
# full, honestly-named scope limits). A function is dynamic if its own
# body directly calls rt_bigint_from_i64 -- a whole-function, syntactic
# decision exactly mirroring x64_func_is_float's own scope limit, NOT
# yet cross-function propagation or per-value specialization. Functions
# that never touch BigInt are unaffected (still get today's exact
# untagged int codegen), which is what keeps bench_loop/bench_fib's
# speed intact -- verified in this slice's own testing, not assumed.
# Real bug caught before it ever ran wrong: the tower's OWN
# implementation functions (rt_rational_add/_sub/_mul/_div/_cmp,
# rt_gcd) call rt_rational_new to build their result -- which, under
# the naive "dynamic if it calls a tower constructor anywhere" rule,
# would classify THEM as dynamic too. Unlike rt_bigint_add's own
# already-shipped case (safe by luck: its internal comparisons only
# ever see 0/1 sign flags or -1/0/1 cmp results, always well within
# the fixnum range), rt_rational_add's `n1*d2+n2*d1` etc. operate on
# genuinely arbitrary-range i64 numerators/denominators -- routing
# THAT through the tagged-fixnum fast path (which only correctly
# recovers values within +-140 trillion) would silently corrupt any
# rational built from a larger int, a real correctness bug, not just
# wasted dispatch overhead. Fixed by excluding the tower's own
# implementation functions by name: they always operate on already-
# unwrapped plain ints (via `tagged band payload_mask`, done
# explicitly in their own bodies), never on tagged values through
# ordinary Bin arithmetic, so they must never be classified dynamic
# regardless of what they call.
make a function called x64_func_is_tower_impl takes name returns yes
  # Broadened after a real crash was root-caused: rt_payload_mask()'s own
  # body computes `(1 shl 48) - 1` -- but `1 shl 48` (0x1000000000000000)
  # is bit-for-bit the BigInt family tag with a zero payload. Once the
  # arithmetic-implies-dynamic rule (added for the fixnum-overflow fix)
  # started sweeping in rt_payload_mask (its name matched none of the
  # four substrings below), that "-" got compiled through the tag-aware
  # dynamic dispatch, whose fast-path check reads the tag-shaped
  # intermediate value as "not a plausible fixnum" and takes the
  # (wrong, for this case) promotion path -- corrupting the runtime's
  # own mask constant, and through it every family-tag check downstream.
  # ALL of x64_runtime.patlang's own functions (the "rt_"/"mem_" naming
  # convention it uses throughout) work with raw, untagged bits/addresses
  # by design -- none of them should ever have user-level numeric-tower
  # promotion semantics applied to their own internal arithmetic, so the
  # whole prefix is excluded now, not just the bigint/rational subset.
  if x64_contains(name, "rt_") then
    return true
  end
  if x64_contains(name, "mem_") then
    return true
  end
  # Real bug found (GitHub #24-adjacent investigation): hash_string's
  # own FNV-1a loop (`hash bxor b; hash * 1099511628211`) works with a
  # DELIBERATELY wraparound raw 64-bit accumulator -- the huge
  # intermediate values it produces were never meant to participate in
  # the numeric tower at all (a hash digest is not a "number" a user
  # program does arithmetic ON, it's an opaque bit pattern by design).
  # Once such a value's magnitude exceeds the 48-bit fixnum window
  # (which it does almost immediately, since the FNV offset basis
  # itself is ~1.4e19), this backend's per-function dynamic-dispatch
  # analysis (added for the fixnum-overflow-to-BigInt fix) treats it as
  # "not a valid fixnum" -- and since it's ALSO not one of the 5
  # explicitly-tagged families, it falls into the catch-all "opaque
  # object" branch, silently returning 0 instead of the real product
  # (confirmed: `print(hash_string("hello"))` under --x64 crashed
  # further down the chain; a minimal 2-line repro isolated it to
  # `h2 * 1099511628211` alone silently giving 0). This is the SAME
  # class of gap as rt_/mem_'s own exclusion just above -- raw bit
  # manipulation that must never be promoted -- just under a name that
  # doesn't match either prefix. Excluded by exact name rather than
  # broadening the prefix rule, matching this session's own established
  # "narrow, well-justified exclusion, not a blanket carve-out" stance.
  if name == "hash_string" then
    return true
  end
  return false
end

make a function called x64_func_is_dynamic takes func returns yes
  # GitHub #56: this whole block of explicit by-name overrides (rt_
  # complex_eq/rt_interval_eq, PLUS rt_complex_add/_sub/_mul and
  # rt_interval_add/_sub/_mul added for #56 itself) used to live AFTER
  # the x64_func_is_tower_impl check below, which unconditionally
  # `return false`s for ANY name containing "rt_"/"mem_" -- including
  # every one of these override names. That made every override here
  # silently DEAD CODE (rt_complex_eq's included, from the day it was
  # written): the whole-function classification always fell through to
  # `false` before ever reaching them. Confirmed exactly by dumping the
  # actual generated asm for rt_complex_add (a throwaway driver mirroring
  # x64_bigint_driver.patlang's pattern, `write_file`-ing emit_program_
  # x64's own output) -- its `+` compiled through the STATIC string-
  # aware-plus path (PLUSSKIP/raw `add`), never through DYN_NOTFAST/
  # rt_dynamic_binop, despite x64_func_is_dynamic supposedly having just
  # been told to return true for it. rt_complex_eq's own override being
  # equally dead was never caught because x64_complex_demo.patlang's `==`
  # tests only ever use plain-int re/im components, where the WRONG
  # (identity-based) comparison still happens to give the right answer
  # by coincidence -- a BigInt component (the same case #56's add/sub/
  # mul bug needed to surface) would have exposed it too. Moved ALL of
  # these overrides here, BEFORE the tower_impl short-circuit, so they
  # actually run.
  if func[1] == "rt_complex_eq" then
    return true
  end
  if func[1] == "rt_interval_eq" then
    return true
  end
  if func[1] == "rt_complex_add" then
    return true
  end
  if func[1] == "rt_complex_sub" then
    return true
  end
  if func[1] == "rt_complex_mul" then
    return true
  end
  if func[1] == "rt_interval_add" then
    return true
  end
  if func[1] == "rt_interval_sub" then
    return true
  end
  if func[1] == "rt_interval_mul" then
    return true
  end
  if x64_func_is_tower_impl(func[1]) then
    return false
  end
  let instrs = func[3]
  let i = 0
  let n = to_num(list_len(instrs))
  while i < n do
    let instr = instrs[i]
    if instr[0] == "Call" then
      if instr[1] == "rt_bigint_from_i64" then
        return true
      end
      if instr[1] == "rt_rational_new" then
        return true
      end
      if instr[1] == "rt_rational_from_i64" then
        return true
      end
      if instr[1] == "rt_complex_new" then
        return true
      end
      if instr[1] == "rt_complex_from_i64" then
        return true
      end
      if instr[1] == "rt_complex_from_num" then
        return true
      end
      if instr[1] == "rt_interval_new" then
        return true
      end
      if instr[1] == "rt_interval_from_i64" then
        return true
      end
      if instr[1] == "rt_interval_from_num" then
        return true
      end
      if instr[1] == "rt_object_new" then
        return true
      end
    end
    # Real bug found (GitHub #19) while chasing what looked like a
    # print regression: a function that builds a string via `+`
    # (ordinary user syntax, e.g. `"hello" + " " + "world"`) was NEVER
    # classified dynamic just for containing a string literal -- so
    # its `+` went through the plain x64_binop_asm path, which does a
    # raw integer `add` on the two TAGGED string addresses. Two
    # String-family (0x2 in the top nibble) pointers added together
    # produce a bit pattern with a DIFFERENT, often unrelated family
    # nibble (confirmed: 0x2+0x2 in the top nibble carries to 0x4,
    # which happens to collide with the CLOSURE tag) -- silently wrong,
    # not even a crash, and print()'s own family dispatch then falls
    # through to its "<value>" default since the result doesn't match
    # any real family it knows. Any function touching a string literal
    # needs the tag-aware dynamic dispatch to have a chance at correct
    # behavior for ALL its ops involving that string, same reasoning as
    # rt_bigint_from_i64 above forcing dynamic mode for BigInt. (Same
    # blind spot as every other syntactic trigger here: a function that
    # ONLY ever receives strings via parameters, with no string literal
    # or forced-dynamic call of its own, still won't be detected --
    # full type inference is out of scope, matching this file's other
    # heuristics.)
    if instr[0] == "Const" then
      if instr[1] == "str" then
        return true
      end
    end
    # Integer-overflow-to-BigInt fix, mirroring pat --ir-run's own
    # behavior (confirmed directly: `9223372036854775807 + 1` silently
    # produced garbage under --x64 while the real interpreter correctly
    # auto-promotes to a genuine BigInt) -- plain "+"/"-"/"*" can ALWAYS
    # overflow a fixnum, regardless of whether the function otherwise
    # looks dynamic, so any function containing one needs the per-
    # instruction analysis below to run (x64_analyze_dynamic_bins's own
    # taint rule then routes just those specific Bin ops through the
    # already-correct overflow-check-and-promote dynamic dispatch --
    # see its own header). The x64_func_is_tower_impl exclusion at the
    # top of this function already protects rt_bigint_add and friends
    # (which use plain "+"/"-"/"*" on raw limbs internally and must
    # never recursively dynamic-dispatch on themselves) from this.
    if instr[0] == "Bin" then
      if instr[1] == "+" then
        return true
      end
      if instr[1] == "-" then
        return true
      end
      if instr[1] == "*" then
        return true
      end
      # GitHub #53: same reasoning as +/-/* above -- a bare "/" can
      # ALWAYS need to promote to Rational on inexact division,
      # regardless of whether the function otherwise looks dynamic.
      # Safe now that every x64_runtime.patlang caller needing genuine
      # truncating division uses the dedicated rt_trunc_div primitive
      # (a Call, invisible to this scan) instead of the "/" operator.
      if instr[1] == "/" then
        return true
      end
    end
    let i = i + 1
  end
  return false
end

# owns_globals: true for the RUNTIME chunk (x64_runtime.patlang alone
# -- the sole owner of the shared .bss state, declared `global` so a
# separately-compiled program chunk can `extern` it instead of
# re-declaring its own copy, which would be a link-time "multiple
# definition" error), false for the PROGRAM chunk (declares the same
# names `extern` instead of defining them).
#
# extern_names: function names to declare `extern` for beyond the
# fixed Win32 imports -- the program chunk passes the runtime chunk's
# OWN full function-name list here. Deliberately NOT a precise "walk
# the Call graph and only extern what's actually referenced" analysis:
# most runtime calls (rt_list_get, rt_heap_alloc, rt_bigint_add, ...)
# are hand-assembled `"    call rt_xxx"` string literals scattered
# throughout x64_binop_asm_dynamic/x64_callhost_asm/etc, not ordinary
# IR `Call` instructions -- invisible to any IR-level call-graph walk.
# An unconditional `extern` for the runtime's WHOLE function list is
# simple, robust (never misses one), and free: NASM only complains
# about a symbol that's BOTH referenced and undefined, never about an
# unused `extern` declaration. The runtime chunk itself passes an empty
# list (self-contained, no cross-chunk calls of its own).
# ---- multi-chunk program codegen (interp.patlang-compilation roadmap
# #25: fixing the NASM memory blowout on the full self-hosted-compiler
# bundle) ----
#
# Confirmed directly (self_hosting/build/measure_asm.patlang, run
# entirely under --ir-run so it never touches NASM): compiling the
# whole ~328-function patc1_all.patlang bundle as ONE emit_program_x64
# call produces 63MB / 2.9M lines / 288,700 labels (this codegen emits
# a label before literally every IR instruction, as a jump-target
# anchor -- see x64_emit_instr's own leading `label + ":"`). Assembling
# that in one nasm invocation was observed ballooning to 12-14GB of
# RAM (confirmed LINEAR, not exponential, growth via a live memory-
# capped monitor before killing it) -- an unusual label-per-instruction
# density real hand-written asm essentially never has, hitting a scaling
# edge case in NASM's own symbol-table handling.
#
# Fix: extend the SAME chunk-linking split already used for x64_
# runtime.obj (a separately-assembled, separately-linked chunk) one
# level deeper -- partition the "program" itself into several smaller
# groups of functions, each independently codegen'd/assembled into its
# own small .obj (each far below the pathological label-count
# threshold), then link ALL the resulting objects together in one
# final gcc invocation (ordinary separate compilation, exactly what C
# does routinely). This does NOT touch lowering at all: Call-vs-
# CallHost resolution already happened correctly during the ONE
# combined lex/parse/lower pass (see patc1_main.patlang's own header on
# why that step, unlike codegen, genuinely can't be split) -- codegen
# only needs to know, per function, whether it's defined HERE or
# reached via `extern`, which is exactly what partitioning the
# ALREADY-lowered func list preserves.
#
# Partitions by cumulative INSTRUCTION count, not a fixed function
# count -- a handful of functions (parse_program, lower_program, the
# lexer/parser's own large dispatch chains) are drastically bigger than
# most, so chunking by raw function count risks one wildly oversized
# chunk while others sit nearly empty. target_instrs is a soft cap: a
# single function larger than target_instrs on its own still gets its
# own whole chunk (never split mid-function -- codegen has no notion of
# a partial function body).
make a function called x64_partition_funcs takes funcs, target_instrs returns chunks
  let chunks = []
  let current = []
  let current_count = 0
  let n = to_num(list_len(funcs))
  let i = 0
  while i < n do
    let f = funcs[i]
    let fsize = to_num(list_len(f[3]))
    if current_count > 0 then
      if current_count + fsize > target_instrs then
        let chunks = list_push(chunks, current)
        let current = []
        let current_count = 0
      end
    end
    let current = list_push(current, f)
    let current_count = current_count + fsize
    let i = i + 1
  end
  if to_num(list_len(current)) > 0 then
    let chunks = list_push(chunks, current)
  end
  return chunks
end

make a function called x64_func_names_of takes funcs returns names
  let names = []
  let n = to_num(list_len(funcs))
  let i = 0
  while i < n do
    let names = list_push(names, funcs[i][1])
    let i = i + 1
  end
  return names
end

make a function called emit_program_x64 takes ir, owns_globals, extern_names returns asm
  let funcs = ir[2]
  let sb = sb_new()
  sb_push(sb, "default rel" + x64_nl_char())
  # Every defined function is declared `global` -- NASM labels are
  # file-local by default, so without this the linker could never
  # resolve the OTHER chunk's `extern rt_foo`/etc references against
  # this file's own function labels. Harmless to do unconditionally
  # even for functions nothing outside this chunk ever calls.
  let fn_count = to_num(list_len(funcs))
  if fn_count > 0 then
    let gl_line = sb_new()
    sb_push(gl_line, "global ")
    let gi = 0
    while gi < fn_count do
      if gi > 0 then
        sb_push(gl_line, ", ")
      end
      sb_push(gl_line, x64_asm_label_for_func(funcs[gi][1]))
      let gi = gi + 1
    end
    sb_push(sb, sb_str(gl_line) + x64_nl_char())
  end
  sb_push(sb, "extern GetStdHandle, WriteFile, ExitProcess, CreateFileA, GetFileSize, CloseHandle, ReadFile, CreateProcessA, CreatePipe, SetHandleInformation, WaitForSingleObject, GetCommandLineA, GetExitCodeProcess, TerminateProcess, WSAStartup, WSAGetLastError, socket, bind, listen, accept, connect, send, recv, closesocket, shutdown, getaddrinfo, freeaddrinfo, getsockname, ioctlsocket, htons, ntohs, Sleep, GetTickCount64, CopyFileA, MoveFileExA, FindFirstFileA, FindNextFileA, FindClose" + x64_nl_char())
  # Real C runtime math library (msvcrt/ucrtbase, already linked by
  # gcc's own default libs -- see x64_build.patlang) -- matches the
  # SAME underlying libm every real_host_sin/cos/sqrt/etc (rust-runtime/
  # src/ir/hosts.rs) delegates to via Rust's f64 methods, so results are
  # bit-for-bit comparable, not an approximation of our own.
  sb_push(sb, "extern sqrt, pow, sin, cos, tan, asin, acos, atan, atan2, log, exp, ceil, floor, round, trunc, fabs" + x64_nl_char())
  let en_count = to_num(list_len(extern_names))
  if en_count > 0 then
    let en_line = sb_new()
    sb_push(en_line, "extern ")
    let ei = 0
    while ei < en_count do
      if ei > 0 then
        sb_push(en_line, ", ")
      end
      sb_push(en_line, x64_asm_label_for_func(extern_names[ei]))
      let ei = ei + 1
    end
    sb_push(sb, sb_str(en_line) + x64_nl_char())
  end
  sb_push(sb, x64_nl_char())
  sb_push(sb, "section .bss" + x64_nl_char())
  if owns_globals then
    sb_push(sb, "    global g_written, g_scratch, g_scratch2, g_heap_state, g_sb_table, g_vec_table, g_vars_table, g_heap, g_rules_table, g_actions_table, g_action_bodies_table, g_procs_table, g_listeners_table, g_conns_table, g_wsa_init, g_last_recv_error, g_vfs_table, g_classes_table, g_goal_defs_table, g_finddata" + x64_nl_char())
    sb_push(sb, "    align 8" + x64_nl_char())
    sb_push(sb, "    g_written resd 1" + x64_nl_char())
    sb_push(sb, "    align 8" + x64_nl_char())
    sb_push(sb, "    g_scratch resb 256" + x64_nl_char())
    sb_push(sb, "    align 8" + x64_nl_char())
    # copy_file/rename_file's "to" path -- CopyFileA/MoveFileExA need
    # TWO null-terminated C strings live simultaneously, unlike every
    # other OS-boundary primitive here which only ever needs one at a
    # time (hence its own separate buffer, not sharing g_scratch).
    sb_push(sb, "    g_scratch2 resb 256" + x64_nl_char())
    sb_push(sb, "    align 8" + x64_nl_char())
    sb_push(sb, "    g_heap_state resq 1" + x64_nl_char())
    sb_push(sb, "    align 8" + x64_nl_char())
    sb_push(sb, "    g_sb_table resq 1" + x64_nl_char())
    sb_push(sb, "    align 8" + x64_nl_char())
    sb_push(sb, "    g_vec_table resq 1" + x64_nl_char())
    sb_push(sb, "    align 8" + x64_nl_char())
    sb_push(sb, "    g_vars_table resq 1" + x64_nl_char())
    sb_push(sb, "    align 8" + x64_nl_char())
    sb_push(sb, "    g_rules_table resq 1" + x64_nl_char())
    sb_push(sb, "    align 8" + x64_nl_char())
    sb_push(sb, "    g_actions_table resq 1" + x64_nl_char())
    sb_push(sb, "    align 8" + x64_nl_char())
    sb_push(sb, "    g_action_bodies_table resq 1" + x64_nl_char())
    sb_push(sb, "    align 8" + x64_nl_char())
    sb_push(sb, "    g_procs_table resq 1" + x64_nl_char())
    sb_push(sb, "    align 8" + x64_nl_char())
    sb_push(sb, "    g_listeners_table resq 1" + x64_nl_char())
    sb_push(sb, "    align 8" + x64_nl_char())
    sb_push(sb, "    g_conns_table resq 1" + x64_nl_char())
    sb_push(sb, "    align 8" + x64_nl_char())
    # WSAStartup lazy-init flag (Stage B, TCP networking) -- 0 until
    # the first networking call in the program, matching the same
    # lazy-init-on-first-use convention every other table here uses.
    sb_push(sb, "    g_wsa_init resq 1" + x64_nl_char())
    sb_push(sb, "    g_last_recv_error resq 1" + x64_nl_char())
    sb_push(sb, "    g_vfs_table resq 1" + x64_nl_char())
    sb_push(sb, "    align 8" + x64_nl_char())
    # Real classes for x64 (non-inheriting subset) -- class registry,
    # keyed by class name; see class_def_register's own header in
    # x64_runtime.patlang for exactly what this holds.
    sb_push(sb, "    g_classes_table resq 1" + x64_nl_char())
    sb_push(sb, "    align 8" + x64_nl_char())
    # goal_def/pursue's registry (goal name -> deps ground-fact list),
    # same single-persistent-rt_list convention as g_classes_table.
    sb_push(sb, "    g_goal_defs_table resq 1" + x64_nl_char())
    sb_push(sb, "    align 8" + x64_nl_char())
    # list_dir's WIN32_FIND_DATAA scratch buffer (os_find_first/
    # os_find_next/os_find_data_name/os_find_data_is_dir above) --
    # 592 bytes is the real sizeof(WIN32_FIND_DATAA) on x64, this
    # reservation is generous versus the ~318 bytes actually addressed.
    sb_push(sb, "    g_finddata resb 592" + x64_nl_char())
    sb_push(sb, "    align 16" + x64_nl_char())
    # Bumped from 16MB to 512MB after GitHub #31's follow-up crash
    # (patc2.exe -> patc3.exe: the bump allocator ran past the original
    # 16MB reservation, which was the LAST .bss entry, and walked into
    # unmapped memory). MUST match mem_heap_size()'s literal above --
    # cheap on 64-bit Windows specifically because .bss pages are
    # zero-fill-on-demand (reserving 512MB costs nothing in actual RAM
    # until touched), not a claim this is unbounded -- see
    # rt_heap_alloc's own header in x64_runtime.patlang for the real
    # fix still outstanding (genuine dynamic growth/free-list).
    sb_push(sb, "    g_heap resb 536870912" + x64_nl_char())
  else
    sb_push(sb, "extern g_written, g_scratch, g_scratch2, g_heap_state, g_sb_table, g_vec_table, g_vars_table, g_heap, g_rules_table, g_actions_table, g_action_bodies_table, g_procs_table, g_listeners_table, g_conns_table, g_wsa_init, g_last_recv_error, g_vfs_table, g_classes_table, g_goal_defs_table, g_finddata" + x64_nl_char())
  end
  sb_push(sb, x64_nl_char())
  sb_push(sb, "section .data" + x64_nl_char())
  sb_push(sb, "    align 8" + x64_nl_char())
  sb_push(sb, x64_collect_string_data(ir))
  sb_push(sb, x64_nl_char())
  sb_push(sb, "section .text" + x64_nl_char())
  sb_push(sb, x64_nl_char())
  x64_string_label_reset()
  let n = to_num(list_len(funcs))
  let float_func_names = x64_collect_float_func_names(funcs)
  let i = 0
  while i < n do
    sb_push(sb, x64_emit_func(funcs[i], x64_func_is_float(funcs[i]), x64_func_is_dynamic(funcs[i]), float_func_names))
    sb_push(sb, x64_nl_char())
    let i = i + 1
  end
  return sb_str(sb)
end
