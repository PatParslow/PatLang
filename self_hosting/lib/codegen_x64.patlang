  sb_push(sb, "    add rax, rbx" + x64_nl_char())
  sb_push(sb, "    cmp rax, 0" + x64_nl_char())
  sb_push(sb, "    jl .blit_y_next_" + suffix + x64_nl_char())
  sb_push(sb, "    cmp rax, r9" + x64_nl_char())
  sb_push(sb, "    jge .blit_y_next_" + suffix + x64_nl_char())
  sb_push(sb, "    xor rcx, rcx" + x64_nl_char())
  sb_push(sb, "  .blit_x_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    cmp rcx, r14" + x64_nl_char())
  sb_push(sb, "    jge .blit_y_next_" + suffix + x64_nl_char())
  sb_push(sb, "    mov rdx, r12" + x64_nl_char())
  sb_push(sb, "    add rdx, rcx" + x64_nl_char())
  sb_push(sb, "    cmp rdx, 0" + x64_nl_char())
  sb_push(sb, "    jl .blit_x_next_" + suffix + x64_nl_char())
  sb_push(sb, "    cmp rdx, r10" + x64_nl_char())
  sb_push(sb, "    jge .blit_x_next_" + suffix + x64_nl_char())
