# CallValue(argc) -- the closure's OWN captured count is a runtime
# value (read from the closure object itself), unlike everywhere else
# in this backend where instruction operands are compile-time known --
# see this file's own header for the full stack-shuffling explanation.
make a function called x64_callvalue_asm takes argc, spilled returns asm
  let n = to_num(argc)
  # The current function's own private scratch slot, one past its last
  # named local (see x64_emit_func's frame_size reservation) -- used to
  # carry the closure's captured-count across the opaque `call` below,
  # since nothing about this backend's calling convention guarantees
  # any register survives a call, and a shared/global location would
  # be unsafe under recursion or a closure that itself calls another
  # closure before returning. Private to THIS activation's own rbp, so
  # every nested/recursive call gets its own independent copy for free.
  let cv_slot_offset = 8 * (to_num(list_len(spilled)) + 1)
  let cv_lock_suffix = label_asm_safe(argc)
  let sb = sb_new()
  # g_scratch here is a temporary arg-shuffle buffer (NOT a path
  # string), but it's the SAME process-wide shared buffer every other
  # g_scratch user needs protection from now that real OS threads
  # exist -- lock_acquire before step 1's writes, lock_release right
  # after step 4's LAST read (below), deliberately BEFORE `call r12`:
  # that call invokes arbitrary closure body code, and holding the
  # lock across an unbounded nested call (even though CRITICAL_SECTION
  # is safely reentrant for the same thread, so it wouldn't deadlock)
  # would serialize far more than this function's own brief buffer
  # usage actually needs.
  sb_push(sb, x64_lock_acquire_asm(cv_lock_suffix))
  # 1. Pop the N already-pushed own-args into the scratch buffer, out
  #    of the way, so the closure's captured values can be pushed
  #    underneath where they belong first.
  let k = n - 1
  while k >= 0 do
    sb_push(sb, "    pop rax" + x64_nl_char())
    sb_push(sb, "    lea r10, [rel g_scratch]" + x64_nl_char())
    sb_push(sb, "    mov [r10+" + (8 * k) + "], rax" + x64_nl_char())
    let k = k - 1
  end
  # 2. Pop the closure value itself (now on top) -- mask off the tag
  #    (family 0x4, since closures are tagged now) before treating it
  #    as a real address; every dereference below (code addr, captured
  #    count, captured values) reads through this masked r14.
  sb_push(sb, "    pop r14" + x64_nl_char())
  sb_push(sb, "    mov rcx, 281474976710655" + x64_nl_char())
  sb_push(sb, "    and r14, rcx" + x64_nl_char())
  sb_push(sb, "    mov r12, [r14]" + x64_nl_char())
  sb_push(sb, "    mov r13, [r14+8]" + x64_nl_char())
  sb_push(sb, "    mov [rbp-" + cv_slot_offset + "], r13" + x64_nl_char())
  # 3. Push the closure's captured values, in order -- a genuine
  #    runtime loop, since r13 (captured count) isn't compile-time
  #    known here.
  let suffix = label_asm_safe(argc)
  sb_push(sb, "    xor r10, r10" + x64_nl_char())
  sb_push(sb, "  .cv_loop_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    cmp r10, r13" + x64_nl_char())
  sb_push(sb, "    jge .cv_done_" + suffix + x64_nl_char())
  sb_push(sb, "    mov rax, [r14+16+r10*8]" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  sb_push(sb, "    inc r10" + x64_nl_char())
  sb_push(sb, "    jmp .cv_loop_" + suffix + x64_nl_char())
  sb_push(sb, "  .cv_done_" + suffix + ":" + x64_nl_char())
  # 4. Push the own-args back on top, in original order. Last actual
  #    read of g_scratch in this function -- lock_release right after,
  #    before the nested call in step 5 (see this function's own
  #    header for why release happens here, not after the call).
  let i = 0
  while i < n do
    sb_push(sb, "    lea r10, [rel g_scratch]" + x64_nl_char())
    sb_push(sb, "    mov rax, [r10+" + (8 * i) + "]" + x64_nl_char())
    sb_push(sb, "    push rax" + x64_nl_char())
    let i = i + 1
  end
  sb_push(sb, x64_lock_release_asm())
  # 5. Indirect call, then clean up -- captured count is read back from
  #    THIS frame's own private slot (step 2), not from any register,
  #    since r12/r13/r14 are not guaranteed to survive the call.
  sb_push(sb, "    call r12" + x64_nl_char())
  sb_push(sb, "    mov rdx, [rbp-" + cv_slot_offset + "]" + x64_nl_char())
  sb_push(sb, "    add rdx, " + n + x64_nl_char())
  sb_push(sb, "    shl rdx, 3" + x64_nl_char())
  sb_push(sb, "    add rsp, rdx" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  return sb_str(sb)
end

# CallValue call sites need locally-unique NASM labels for their
# internal push-captured-values loop -- set_var-based counter, same
# pattern as the string-literal labels, since a program can contain
# more than one CallValue instruction.
make a function called label_asm_safe takes ignored returns label
  let n = to_num(get("__vars", "__x64_cv_counter"))
  set_var("__x64_cv_counter", n + 1)
  return "" + n
end

make a function called x64_emit_instr takes instr, func_name, regmap, spilled, label, is_float_bin, is_float_const, is_dynamic_bin, bool_print_override, float_print_override, is_tower_ctor_arg returns asm
  let sb = sb_new()
  sb_push(sb, label + ":" + x64_nl_char())
  let ty = instr[0]
  if ty == "Const" then
    let kind = instr[1]
    if kind == "bool" then
      # GitHub #24: tagged with the dedicated Bool family (6 shl 60)
      # instead of a bare fixnum 0/1, so print/type_of/send-dispatch can
      # tell a genuine Bool apart from "a fixnum that happens to be 0 or
      # 1" -- see x64_family_code_asm's own header for the tag value.
      if instr[2] == "true" then
        sb_push(sb, "    mov rax, 6917529027641081857" + x64_nl_char())
      else
        sb_push(sb, "    mov rax, 6917529027641081856" + x64_nl_char())
      end
      sb_push(sb, "    push rax" + x64_nl_char())
    else
      if kind == "unit" then
        # Unit family tag (8 shl 60 = 9223372036854775808) -- see
        # x64_family_code_asm's own header for the tag/rationale. Needed
        # for implicit-last-value-return/auto-print: an empty block, a
        # no-else `if`, or a zero-iteration `while` pushes this when its
        # value is wanted, same as ir/lowering.rs's Const(Value::Unit).
        sb_push(sb, "    mov rax, 9223372036854775808" + x64_nl_char())
        sb_push(sb, "    push rax" + x64_nl_char())
