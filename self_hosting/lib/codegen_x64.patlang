    #    null-pointer segfault (r14=0 inside x64_callvalue_asm's own
    #    closure-deref, once the wrong value got popped as "the
    #    closure").
    sb_push(sb, "    push r13" + x64_nl_char())
    sb_push(sb, "    mov rax, [r12+0]" + x64_nl_char())
    sb_push(sb, "    push rax" + x64_nl_char())
    let ri = 0
    while ri < k do
      sb_push(sb, "    mov rax, [r12+" + ((2 + ri) * 8) + "]" + x64_nl_char())
      sb_push(sb, "    push rax" + x64_nl_char())
      let ri = ri + 1
    end
    sb_push(sb, x64_callvalue_asm(k + 1, spilled))
    sb_push(sb, "    jmp .SEND_ALLDONE_" + suffix + x64_nl_char())
    sb_push(sb, ".SEND_DONE_" + suffix + ":" + x64_nl_char())
