  sb_push(sb, "    mov rbx, [rel g_resize_h]" + x64_nl_char())
  sb_push(sb, "    push r14" + x64_nl_char())
  sb_push(sb, "    push rbx" + x64_nl_char())
  sb_push(sb, x64_win_canvas_resize_asm())
  sb_push(sb, "    pop rax" + x64_nl_char())
  sb_push(sb, "    mov [rel g_canvas_w], r14" + x64_nl_char())
  sb_push(sb, "    mov [rel g_canvas_h], rbx" + x64_nl_char())
  sb_push(sb, "    push 5" + x64_nl_char())
  sb_push(sb, "    jmp .winmsg_ret_" + x64_nl_char())
  sb_push(sb, "  .winmsg_noresize_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    mov r15, rsp" + x64_nl_char())
  # 96 bytes: BitBlt's own stack args need [rsp+32..72), the rest is
  # the usual generic call-shadow-space margin.
  sb_push(sb, "    sub rsp, 96" + x64_nl_char())
  sb_push(sb, "    and rsp, -16" + x64_nl_char())
  # MSG lives in PERSISTENT .bss scratch (g_msg_scratch, 48 bytes:
  # hwnd@0 message@8 wParam@16 lParam@24 time@32 pt.x@36 pt.y@40) --
  # NOT a stack offset. See g_msg_scratch/g_paintstruct_scratch/
  # g_bmih_scratch's own .bss declaration comment for why: a fixed
  # address can never alias any call's own stack-argument window,
  # unlike a stack-relative offset within this same frame.
  sb_push(sb, "    lea rcx, [rel g_msg_scratch]" + x64_nl_char())
  sb_push(sb, "    xor rdx, rdx" + x64_nl_char())
  sb_push(sb, "    xor r8, r8" + x64_nl_char())
  sb_push(sb, "    xor r9, r9" + x64_nl_char())
  sb_push(sb, "    mov qword [rsp+32], 1" + x64_nl_char())
  sb_push(sb, "    call PeekMessageW" + x64_nl_char())
  sb_push(sb, "    cmp rax, 0" + x64_nl_char())
  sb_push(sb, "    jne .winmsg_have_" + x64_nl_char())
  sb_push(sb, "    mov rsp, r15" + x64_nl_char())
  sb_push(sb, "    push 0" + x64_nl_char())
  sb_push(sb, "    jmp .winmsg_ret_" + x64_nl_char())
  sb_push(sb, "  .winmsg_have_:" + x64_nl_char())
  sb_push(sb, "    mov eax, [rel g_msg_scratch+8]" + x64_nl_char())
  sb_push(sb, "    mov r12, rax" + x64_nl_char())
  sb_push(sb, "    cmp r12, 15" + x64_nl_char())
  sb_push(sb, "    jne .winmsg_notpaint_" + x64_nl_char())
  # WM_PAINT: BeginPaint into g_paintstruct_scratch (72 bytes) -> hdc,
  # then a plain BitBlt from g_mem_dc (Phase 3's DIB-section-backed
  # memory DC -- see g_mem_dc's own .bss declaration comment) onto the
  # window's own paint DC. Replaces the original StretchDIBits/hand-
  # built-BITMAPINFOHEADER approach entirely now that the canvas
  # surface itself is a real GDI bitmap rather than a bare heap
  # buffer -- BitBlt needs no pixel-format struct at all, GDI already
  # knows the source bitmap's own format.
  sb_push(sb, "    mov rcx, [rel g_hwnd]" + x64_nl_char())
  sb_push(sb, "    lea rdx, [rel g_paintstruct_scratch]" + x64_nl_char())
  sb_push(sb, "    call BeginPaint" + x64_nl_char())
  sb_push(sb, "    mov r13, rax" + x64_nl_char())
  # BitBlt(hdcPaint, 0, 0, canvas_w, canvas_h, g_mem_dc, 0, 0,
  #   SRCCOPY=0x00CC0020) -- 9 params, 4 register + 5 stack
  # ([rsp+32..72)).
  sb_push(sb, "    mov rcx, r13" + x64_nl_char())
  sb_push(sb, "    xor rdx, rdx" + x64_nl_char())
  sb_push(sb, "    xor r8, r8" + x64_nl_char())
  sb_push(sb, "    mov r9, [rel g_canvas_w]" + x64_nl_char())
  sb_push(sb, "    mov rax, [rel g_canvas_h]" + x64_nl_char())
  sb_push(sb, "    mov [rsp+32], rax" + x64_nl_char())
  sb_push(sb, "    mov rax, [rel g_mem_dc]" + x64_nl_char())
  sb_push(sb, "    mov [rsp+40], rax" + x64_nl_char())
  sb_push(sb, "    mov qword [rsp+48], 0" + x64_nl_char())
  sb_push(sb, "    mov qword [rsp+56], 0" + x64_nl_char())
  sb_push(sb, "    mov qword [rsp+64], 13369376" + x64_nl_char())
  sb_push(sb, "    call BitBlt" + x64_nl_char())
  sb_push(sb, "    mov rcx, [rel g_hwnd]" + x64_nl_char())
  sb_push(sb, "    lea rdx, [rel g_paintstruct_scratch]" + x64_nl_char())
  sb_push(sb, "    call EndPaint" + x64_nl_char())
  sb_push(sb, "    mov rsp, r15" + x64_nl_char())
  sb_push(sb, "    push r12" + x64_nl_char())
  sb_push(sb, "    jmp .winmsg_ret_" + x64_nl_char())
  sb_push(sb, "  .winmsg_notpaint_:" + x64_nl_char())
  sb_push(sb, "    lea rcx, [rel g_msg_scratch]" + x64_nl_char())
  sb_push(sb, "    call TranslateMessage" + x64_nl_char())
  sb_push(sb, "    lea rcx, [rel g_msg_scratch]" + x64_nl_char())
  sb_push(sb, "    call DispatchMessageW" + x64_nl_char())
  sb_push(sb, "    mov rsp, r15" + x64_nl_char())
  sb_push(sb, "    push r12" + x64_nl_char())
  sb_push(sb, "  .winmsg_ret_:" + x64_nl_char())
  return sb_str(sb)
end

# ============================================================
# Canvas host, Phase 2: ConPTY -- hosting a real, unmodified child
# process (vim/bash/cmd/git/anything) with a genuine terminal
# contract, no cooperation needed from the child at all.
# ============================================================
#
# Confirmed 100% greenfield before starting (same grep as Phase 1's own
# header -- CreatePseudoConsole/STARTUPINFOEX/InitializeProcThreadAttr
# ributeList/UpdateProcThreadAttribute: zero matches anywhere before
# this). All in kernel32.dll, already linked.
#
# Every struct that must survive across more than one WinAPI call
# within the same primitive lives in PERSISTENT .bss scratch (see
# g_conpty_hpc's own .bss declaration comment) from the very start
# here -- a direct, deliberate lesson from Phase 1's real stack-offset-
# overlap crash, not repeated.
#
# Single-instance (one pane) for now -- g_conpty_hpc/in_write/out_read/
# process are bare globals, not a table. Multi-pane is Phase 6.

# conpty_create(cols, rows) -> hpc. Creates two pipes (one for our
# keystrokes INTO the child, one for the child's own output back OUT
# to us) and a pseudoconsole wired to them. Stores hpc/our own pipe
# ends in g_conpty_hpc/g_conpty_in_write/g_conpty_out_read. The ends
# handed TO the pseudoconsole are closed once CreatePseudoConsole
# returns (it duplicates its own references internally, per MSDN) --
# only OUR OWN opposite ends survive past this function.
make a function called x64_conpty_create_asm returns asm
  let sb = sb_new()
  sb_push(sb, "    pop r10" + x64_nl_char())
  sb_push(sb, "    pop rax" + x64_nl_char())
  # r10=rows, rax=cols. Saved on the real stack, peeked (not popped
  # again) via r15 -- r15 itself is never clobbered by a real WinAPI
  # call (genuinely callee-saved under the real Win64 ABI), so it's
  # safe to keep reading [r15]/[r15+8] any time this function needs
  # cols/rows again, well after several other calls.
  sb_push(sb, "    push rax" + x64_nl_char())
  sb_push(sb, "    push r10" + x64_nl_char())
  sb_push(sb, "    mov r15, rsp" + x64_nl_char())
  sb_push(sb, "    sub rsp, 176" + x64_nl_char())
  sb_push(sb, "    and rsp, -16" + x64_nl_char())
  # SECURITY_ATTRIBUTES at [rsp+80] (24 bytes), bInheritHandle=TRUE --
  # reused for both CreatePipe calls below (sequential, never
  # simultaneous, same established reuse pattern as x64_os_exec_run_
  # asm's own single SECURITY_ATTRIBUTES).
  sb_push(sb, "    mov qword [rsp+80], 24" + x64_nl_char())
  sb_push(sb, "    mov qword [rsp+88], 0" + x64_nl_char())
  sb_push(sb, "    mov qword [rsp+96], 1" + x64_nl_char())
  # Pipe 1 (input TO the child): [rsp+104]=ConPTY's own read end,
  # [rsp+112]=OUR write end (kept, becomes g_conpty_in_write).
  sb_push(sb, "    lea rcx, [rsp+104]" + x64_nl_char())
  sb_push(sb, "    lea rdx, [rsp+112]" + x64_nl_char())
  sb_push(sb, "    lea r8, [rsp+80]" + x64_nl_char())
  sb_push(sb, "    xor r9, r9" + x64_nl_char())
  sb_push(sb, "    call CreatePipe" + x64_nl_char())
  sb_push(sb, "    mov rax, [rsp+112]" + x64_nl_char())
  sb_push(sb, "    mov [rel g_conpty_in_write], rax" + x64_nl_char())
  # Pipe 2 (output FROM the child): [rsp+120]=OUR read end (kept,
  # becomes g_conpty_out_read), [rsp+128]=ConPTY's own write end.
  sb_push(sb, "    lea rcx, [rsp+120]" + x64_nl_char())
  sb_push(sb, "    lea rdx, [rsp+128]" + x64_nl_char())
  sb_push(sb, "    lea r8, [rsp+80]" + x64_nl_char())
  sb_push(sb, "    xor r9, r9" + x64_nl_char())
  sb_push(sb, "    call CreatePipe" + x64_nl_char())
  sb_push(sb, "    mov rax, [rsp+120]" + x64_nl_char())
  sb_push(sb, "    mov [rel g_conpty_out_read], rax" + x64_nl_char())
  # CreatePseudoConsole(size, hInput, hOutput, dwFlags=0, &hpc). size
  # is a COORD (2 packed SHORTs) passed BY VALUE in ECX: cols in the
  # low 16 bits, rows in the high 16 bits.
  sb_push(sb, "    xor ecx, ecx" + x64_nl_char())
  sb_push(sb, "    mov cx, [r15+8]" + x64_nl_char())
  sb_push(sb, "    xor eax, eax" + x64_nl_char())
  sb_push(sb, "    mov ax, [r15]" + x64_nl_char())
  sb_push(sb, "    shl eax, 16" + x64_nl_char())
  sb_push(sb, "    or ecx, eax" + x64_nl_char())
  sb_push(sb, "    mov rdx, [rsp+104]" + x64_nl_char())
  sb_push(sb, "    mov r8, [rsp+128]" + x64_nl_char())
  sb_push(sb, "    xor r9, r9" + x64_nl_char())
  sb_push(sb, "    lea rax, [rsp+136]" + x64_nl_char())
  sb_push(sb, "    mov [rsp+32], rax" + x64_nl_char())
  sb_push(sb, "    call CreatePseudoConsole" + x64_nl_char())
  # HRESULT: S_OK=0. Not fully robust yet (no cleanup path on
  # failure) -- an accepted, named gap for this phase's own "prove the
  # plumbing" scope, matching x64_os_exec_run_asm's own incremental
  # history (robustness layered on AFTER the happy path was proven).
  sb_push(sb, "    mov rax, [rsp+136]" + x64_nl_char())
  sb_push(sb, "    mov [rel g_conpty_hpc], rax" + x64_nl_char())
  # Close OUR copies of the ends we just handed to ConPTY -- it keeps
  # its own internal references (MSDN), so this doesn't tear down the
  # underlying pipes, just releases handles we no longer need. (Tested
  # removing this as a diagnostic during a real STATUS_DLL_INIT_FAILED
  # investigation -- made no difference, restored to the correct/
  # recommended form.)
  sb_push(sb, "    mov rcx, [rsp+104]" + x64_nl_char())
  sb_push(sb, "    call CloseHandle" + x64_nl_char())
  sb_push(sb, "    mov rcx, [rsp+128]" + x64_nl_char())
  sb_push(sb, "    call CloseHandle" + x64_nl_char())
  sb_push(sb, "    mov rax, [rel g_conpty_hpc]" + x64_nl_char())
  sb_push(sb, "    mov rsp, r15" + x64_nl_char())
  sb_push(sb, "    add rsp, 16" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  return sb_str(sb)
end

# conpty_spawn(wide_cmdline_addr) -> hProcess (0 on failure). Runs the
# STARTUPINFOEX/attribute-list dance (size-query, allocate, real init,
# attach g_conpty_hpc as the PSEUDOCONSOLE attribute) then
# CreateProcessW. wide_cmdline_addr must point to a FRESH, mutable
# UTF-16LE null-terminated buffer (str_to_wide, conpty.patlang -- a
# plain PatLang function, not asm, matching x64_os_exec_run_asm's own
# "CreateProcess mutates lpCommandLine in place" precaution: a fresh
# rt_heap_alloc buffer per call is automatically safe here, same as
# there).
make a function called x64_conpty_spawn_asm returns asm
  let suffix = label_asm_safe(0)
  let sb = sb_new()
  sb_push(sb, "    pop rax" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  sb_push(sb, "    mov r15, rsp" + x64_nl_char())
  sb_push(sb, "    sub rsp, 96" + x64_nl_char())
  sb_push(sb, "    and rsp, -16" + x64_nl_char())
  # Step 1: size query (deliberately "fails" -- only g_pta_size matters).
  sb_push(sb, "    xor rcx, rcx" + x64_nl_char())
  sb_push(sb, "    mov rdx, 1" + x64_nl_char())
  sb_push(sb, "    xor r8, r8" + x64_nl_char())
  sb_push(sb, "    lea r9, [rel g_pta_size]" + x64_nl_char())
  sb_push(sb, "    call InitializeProcThreadAttributeList" + x64_nl_char())
  # Step 2: allocate the list buffer (rt_heap_alloc: ordinary PatLang-
  # convention call, no register-preservation guarantee -- r15 saved/
  # restored around it, same rule as every other rt_heap_alloc call
  # site in this file). Tested swapping this for GetProcessHeap/
  # HeapAlloc as a diagnostic during a real STATUS_DLL_INIT_FAILED
  # investigation -- made no difference, restored to rt_heap_alloc.
  sb_push(sb, "    push r15" + x64_nl_char())
  sb_push(sb, "    mov rax, [rel g_pta_size]" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  sb_push(sb, "    call rt_heap_alloc" + x64_nl_char())
  sb_push(sb, "    add rsp, 8" + x64_nl_char())
  sb_push(sb, "    pop r15" + x64_nl_char())
  sb_push(sb, "    mov [rel g_pta_list], rax" + x64_nl_char())
  # Step 3: real init.
  sb_push(sb, "    mov rcx, [rel g_pta_list]" + x64_nl_char())
  sb_push(sb, "    mov rdx, 1" + x64_nl_char())
  sb_push(sb, "    xor r8, r8" + x64_nl_char())
  sb_push(sb, "    lea r9, [rel g_pta_size]" + x64_nl_char())
  sb_push(sb, "    call InitializeProcThreadAttributeList" + x64_nl_char())
  # Step 4: UpdateProcThreadAttribute(list, 0,
  #   PROC_THREAD_ATTRIBUTE_PSEUDOCONSOLE=131094, hpc (the handle
  #   VALUE itself, not its address), sizeof(HPCON)=8, NULL, NULL).
  #
  # REAL BUG FOUND AND FIXED (root cause of the STATUS_DLL_INIT_FAILED
  # child crash, isolated by disassembling a known-working minimal C
  # reference implementation of this exact sequence and diffing it
  # instruction-by-instruction against this function): lpValue was
  # `lea r9, [rel g_conpty_hpc]` -- the ADDRESS of the .bss slot
  # holding hpc -- not the hpc VALUE itself. Despite MSDN's generic
  # "lpValue: a pointer to the attribute value" wording (which reads
  # as "pass &variable" for most attributes), PROC_THREAD_ATTRIBUTE_
  # PSEUDOCONSOLE is a special case confirmed via a real, independent,
  # working C reference: lpValue is the HPCON handle value itself,
  # passed directly (matching Microsoft's own official ConPTY sample).
  # Passing our .bss address instead meant UpdateProcThreadAttribute
  # copied a harmless-looking but WRONG "handle" (really just a local
  # memory address) into the attribute list -- every call up to and
  # including CreateProcessW succeeded regardless, since none of them
  # validate the pseudoconsole handle's authenticity, only the CHILD
  # process crashed, when it actually tried to attach to a "pseudo-
  # console" that was never a real one.
  sb_push(sb, "    mov rcx, [rel g_pta_list]" + x64_nl_char())
  sb_push(sb, "    xor rdx, rdx" + x64_nl_char())
  sb_push(sb, "    mov r8, 131094" + x64_nl_char())
  sb_push(sb, "    mov r9, [rel g_conpty_hpc]" + x64_nl_char())
  sb_push(sb, "    mov qword [rsp+32], 8" + x64_nl_char())
  sb_push(sb, "    mov qword [rsp+40], 0" + x64_nl_char())
  sb_push(sb, "    mov qword [rsp+48], 0" + x64_nl_char())
  sb_push(sb, "    call UpdateProcThreadAttribute" + x64_nl_char())
  # Step 5: STARTUPINFOEXW in g_startupinfoex (112 bytes: STARTUPINFOW
  # 104 bytes + lpAttributeList@104). Zeroed field-by-field (no index
  # register -- RIP-relative `[rel label+N]` only accepts a constant
  # displacement, never label+reg*scale, unlike a plain-register base
  # like [rsp+reg*8]), then cb=112 and lpAttributeList set.
  sb_push(sb, "    mov qword [rel g_startupinfoex+0], 0" + x64_nl_char())
  sb_push(sb, "    mov qword [rel g_startupinfoex+8], 0" + x64_nl_char())
  sb_push(sb, "    mov qword [rel g_startupinfoex+16], 0" + x64_nl_char())
  sb_push(sb, "    mov qword [rel g_startupinfoex+24], 0" + x64_nl_char())
  sb_push(sb, "    mov qword [rel g_startupinfoex+32], 0" + x64_nl_char())
  sb_push(sb, "    mov qword [rel g_startupinfoex+40], 0" + x64_nl_char())
  sb_push(sb, "    mov qword [rel g_startupinfoex+48], 0" + x64_nl_char())
  sb_push(sb, "    mov qword [rel g_startupinfoex+56], 0" + x64_nl_char())
  sb_push(sb, "    mov qword [rel g_startupinfoex+64], 0" + x64_nl_char())
  sb_push(sb, "    mov qword [rel g_startupinfoex+72], 0" + x64_nl_char())
  sb_push(sb, "    mov qword [rel g_startupinfoex+80], 0" + x64_nl_char())
  sb_push(sb, "    mov qword [rel g_startupinfoex+88], 0" + x64_nl_char())
  sb_push(sb, "    mov qword [rel g_startupinfoex+96], 0" + x64_nl_char())
  sb_push(sb, "    mov qword [rel g_startupinfoex+104], 0" + x64_nl_char())
  sb_push(sb, "    mov dword [rel g_startupinfoex+0], 112" + x64_nl_char())
  sb_push(sb, "    mov rax, [rel g_pta_list]" + x64_nl_char())
  sb_push(sb, "    mov [rel g_startupinfoex+104], rax" + x64_nl_char())
  # Step 6: CreateProcessW(NULL, wide_cmdline, NULL, NULL,
  #   bInheritHandles=FALSE, EXTENDED_STARTUPINFO_PRESENT=524288, NULL,
  #   NULL, &g_startupinfoex, &g_process_info). bInheritHandles=FALSE
  #   deliberately -- the child's I/O comes through the pseudoconsole
  #   attribute, not inherited handles, so there's nothing to inherit.
  sb_push(sb, "    xor rcx, rcx" + x64_nl_char())
  sb_push(sb, "    mov rdx, [r15]" + x64_nl_char())
  sb_push(sb, "    xor r8, r8" + x64_nl_char())
  sb_push(sb, "    xor r9, r9" + x64_nl_char())
  sb_push(sb, "    mov qword [rsp+32], 0" + x64_nl_char())
  sb_push(sb, "    mov qword [rsp+40], 524288" + x64_nl_char())
  sb_push(sb, "    mov qword [rsp+48], 0" + x64_nl_char())
  sb_push(sb, "    mov qword [rsp+56], 0" + x64_nl_char())
  sb_push(sb, "    lea rax, [rel g_startupinfoex]" + x64_nl_char())
  sb_push(sb, "    mov [rsp+64], rax" + x64_nl_char())
  sb_push(sb, "    lea rax, [rel g_process_info]" + x64_nl_char())
  sb_push(sb, "    mov [rsp+72], rax" + x64_nl_char())
  sb_push(sb, "    call CreateProcessW" + x64_nl_char())
  sb_push(sb, "    cmp rax, 0" + x64_nl_char())
  sb_push(sb, "    je .conpty_spawn_failed_" + suffix + x64_nl_char())
  sb_push(sb, "    mov rax, [rel g_process_info]" + x64_nl_char())
  sb_push(sb, "    mov [rel g_conpty_process], rax" + x64_nl_char())
  sb_push(sb, "    mov rsp, r15" + x64_nl_char())
  sb_push(sb, "    add rsp, 8" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  sb_push(sb, "    jmp .conpty_spawn_done_" + suffix + x64_nl_char())
  sb_push(sb, "  .conpty_spawn_failed_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    mov rsp, r15" + x64_nl_char())
  sb_push(sb, "    add rsp, 8" + x64_nl_char())
  sb_push(sb, "    push 0" + x64_nl_char())
  sb_push(sb, "  .conpty_spawn_done_" + suffix + ":" + x64_nl_char())
  return sb_str(sb)
end

# conpty_read_nonblocking(max_len) -> raw untagged buffer address
# (length-prefixed, matching os_exec_run's own raw-output convention
# -- the PatLang wrapper, conpty.patlang's own conpty_read, applies
# `bor rt_string_tag()`, same layered convention exec_capture_io
# already uses for os_exec_run's result). Empty (length 0) buffer if
# nothing is pending. PeekNamedPipe FIRST, exactly mirroring why
# win_peek_message is non-blocking -- ReadFile on an empty ConPTY pipe
# blocks, which would freeze the whole polled main loop.
make a function called x64_conpty_read_nonblocking_asm returns asm
  let suffix = label_asm_safe(0)
  let sb = sb_new()
  sb_push(sb, "    pop rax" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  sb_push(sb, "    mov r15, rsp" + x64_nl_char())
  sb_push(sb, "    sub rsp, 64" + x64_nl_char())
  sb_push(sb, "    and rsp, -16" + x64_nl_char())
  sb_push(sb, "    mov rcx, [rel g_conpty_out_read]" + x64_nl_char())
  sb_push(sb, "    xor rdx, rdx" + x64_nl_char())
  sb_push(sb, "    xor r8, r8" + x64_nl_char())
  sb_push(sb, "    xor r9, r9" + x64_nl_char())
  sb_push(sb, "    lea rax, [rsp+48]" + x64_nl_char())
  sb_push(sb, "    mov [rsp+32], rax" + x64_nl_char())
  sb_push(sb, "    mov qword [rsp+40], 0" + x64_nl_char())
  sb_push(sb, "    call PeekNamedPipe" + x64_nl_char())
  sb_push(sb, "    mov eax, [rsp+48]" + x64_nl_char())
  sb_push(sb, "    cmp rax, 0" + x64_nl_char())
  sb_push(sb, "    jne .conpty_read_have_" + suffix + x64_nl_char())
  # Nothing pending: return an empty (length-0) buffer.
  sb_push(sb, "    push r15" + x64_nl_char())
  sb_push(sb, "    mov rax, 8" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  sb_push(sb, "    call rt_heap_alloc" + x64_nl_char())
  sb_push(sb, "    add rsp, 8" + x64_nl_char())
  sb_push(sb, "    pop r15" + x64_nl_char())
  sb_push(sb, "    mov qword [rax], 0" + x64_nl_char())
  sb_push(sb, "    mov rsi, rax" + x64_nl_char())
  sb_push(sb, "    jmp .conpty_read_done_" + suffix + x64_nl_char())
  sb_push(sb, "  .conpty_read_have_" + suffix + ":" + x64_nl_char())
  # Cap the real available byte count to the caller's own max_len
