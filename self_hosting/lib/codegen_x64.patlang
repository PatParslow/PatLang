  sb_push(sb, "    movzx edx, byte [rsi+1]" + x64_nl_char())
  sb_push(sb, "    shl edx, 8" + x64_nl_char())
  sb_push(sb, "    or eax, edx" + x64_nl_char())
  sb_push(sb, "    movzx edx, byte [rsi]" + x64_nl_char())
  sb_push(sb, "    shl edx, 16" + x64_nl_char())
  sb_push(sb, "    or eax, edx" + x64_nl_char())
  sb_push(sb, "    mov [rdi], eax" + x64_nl_char())
  sb_push(sb, "  .blit_x_next_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    inc rcx" + x64_nl_char())
