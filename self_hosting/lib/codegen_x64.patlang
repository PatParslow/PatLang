      if kind == "str" then
        let label = x64_string_label_next()
        sb_push(sb, "    lea rax, [rel " + label + "]" + x64_nl_char())
        sb_push(sb, "    mov rcx, 2305843009213693952" + x64_nl_char())
        sb_push(sb, "    or rax, rcx" + x64_nl_char())
        sb_push(sb, "    push rax" + x64_nl_char())
      else
        # GitHub #37: this Const's own encoding is now decided per-
        # INSTRUCTION (`is_float_const`, from x64_analyze_float_consts)
        # instead of the old whole-function `float_mode` blanket --
        # see that analysis's own header comment for the full
        # reasoning and the real bug this replaced (a bare int literal
        # anywhere in a function containing an UNRELATED float literal
        # used to always get encoded as a float bit pattern, corrupting
