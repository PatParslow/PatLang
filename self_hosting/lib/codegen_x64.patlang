  sb_push(sb, "    mov dword [rsp+40], 1" + x64_nl_char())
  sb_push(sb, "    mov dword [rsp+44], 6" + x64_nl_char())
  sb_push(sb, "    mov qword [rsp+48], 0" + x64_nl_char())
