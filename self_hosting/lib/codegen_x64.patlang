    # gated behind g_wsa_init, since the g_wsa_init check itself would
    # need the exact same save/restore-rsp dance this already does.
    sb_push(sb, x64_os_wsa_startup_asm())
    sb_push(sb, "    push 0" + x64_nl_char())
  elif name == "os_socket_tcp" then
    sb_push(sb, "    mov r15, rsp" + x64_nl_char())
    sb_push(sb, "    sub rsp, 32" + x64_nl_char())
    sb_push(sb, "    and rsp, -16" + x64_nl_char())
    sb_push(sb, "    mov ecx, 2" + x64_nl_char())
    sb_push(sb, "    mov edx, 1" + x64_nl_char())
    sb_push(sb, "    mov r8d, 6" + x64_nl_char())
    sb_push(sb, "    call socket" + x64_nl_char())
    sb_push(sb, "    mov rsp, r15" + x64_nl_char())
    sb_push(sb, "    push rax" + x64_nl_char())
  elif name == "os_bind_listen" then
    sb_push(sb, x64_os_bind_listen_asm())
  elif name == "os_accept" then
    sb_push(sb, x64_os_accept_asm())
  elif name == "os_connect" then
    sb_push(sb, x64_os_connect_asm())
  elif name == "os_recv" then
    sb_push(sb, x64_os_recv_asm())
  elif name == "os_recv_had_error" then
    sb_push(sb, "    mov rax, [rel g_last_recv_error]" + x64_nl_char())
    sb_push(sb, "    push rax" + x64_nl_char())
  elif name == "os_send" then
    sb_push(sb, x64_os_send_asm())
  elif name == "os_closesocket" then
    sb_push(sb, "    pop rcx" + x64_nl_char())
    sb_push(sb, "    mov r15, rsp" + x64_nl_char())
    sb_push(sb, "    sub rsp, 32" + x64_nl_char())
    sb_push(sb, "    and rsp, -16" + x64_nl_char())
    sb_push(sb, "    call closesocket" + x64_nl_char())
    sb_push(sb, "    mov rsp, r15" + x64_nl_char())
    sb_push(sb, "    push 0" + x64_nl_char())
  elif name == "os_set_nonblocking" then
    # ioctlsocket(sock, FIONBIO, &1) -- Stage B part 2 (#25):
    # tcp_accept_timeout's non-blocking poll variant.
    sb_push(sb, "    pop rcx" + x64_nl_char())
    sb_push(sb, "    mov r15, rsp" + x64_nl_char())
    sb_push(sb, "    sub rsp, 48" + x64_nl_char())
    sb_push(sb, "    and rsp, -16" + x64_nl_char())
    sb_push(sb, "    mov dword [rsp+40], 1" + x64_nl_char())
    sb_push(sb, "    mov rdx, 0 - 2147195266" + x64_nl_char())
    sb_push(sb, "    lea r8, [rsp+40]" + x64_nl_char())
    sb_push(sb, "    call ioctlsocket" + x64_nl_char())
    sb_push(sb, "    mov rsp, r15" + x64_nl_char())
    sb_push(sb, "    push 0" + x64_nl_char())
  elif name == "os_accept_nonblocking" then
    sb_push(sb, "    pop rcx" + x64_nl_char())
    sb_push(sb, "    mov r12, rcx" + x64_nl_char())
    sb_push(sb, "    mov r15, rsp" + x64_nl_char())
    sb_push(sb, "    sub rsp, 32" + x64_nl_char())
    sb_push(sb, "    and rsp, -16" + x64_nl_char())
    sb_push(sb, "    mov rcx, r12" + x64_nl_char())
    sb_push(sb, "    xor rdx, rdx" + x64_nl_char())
    sb_push(sb, "    xor r8, r8" + x64_nl_char())
    sb_push(sb, "    call accept" + x64_nl_char())
    sb_push(sb, "    mov rsp, r15" + x64_nl_char())
    sb_push(sb, "    push rax" + x64_nl_char())
  elif name == "os_get_tick_count" then
    sb_push(sb, "    mov r15, rsp" + x64_nl_char())
    sb_push(sb, "    sub rsp, 32" + x64_nl_char())
    sb_push(sb, "    and rsp, -16" + x64_nl_char())
    sb_push(sb, "    call GetTickCount64" + x64_nl_char())
    sb_push(sb, "    mov rsp, r15" + x64_nl_char())
    sb_push(sb, "    push rax" + x64_nl_char())
  elif name == "sqrt" then
    sb_push(sb, x64_math1_asm("sqrt"))
  elif name == "sin" then
    sb_push(sb, x64_math1_asm("sin"))
  elif name == "cos" then
    sb_push(sb, x64_math1_asm("cos"))
  elif name == "tan" then
    sb_push(sb, x64_math1_asm("tan"))
  elif name == "asin" then
    sb_push(sb, x64_math1_asm("asin"))
  elif name == "acos" then
    sb_push(sb, x64_math1_asm("acos"))
  elif name == "atan" then
    sb_push(sb, x64_math1_asm("atan"))
  elif name == "log" then
    sb_push(sb, x64_math1_asm("log"))
  elif name == "exp" then
    sb_push(sb, x64_math1_asm("exp"))
  elif name == "pow" then
    sb_push(sb, x64_math2_asm("pow"))
  elif name == "atan2" then
    sb_push(sb, x64_math2_asm("atan2"))
  elif name == "abs" then
    sb_push(sb, x64_abs_asm())
  elif name == "ceil" then
    sb_push(sb, x64_roundlike_asm("ceil"))
  elif name == "round" then
    sb_push(sb, x64_roundlike_asm("round"))
  elif name == "trunc" then
    sb_push(sb, x64_roundlike_asm("trunc"))
  elif name == "bit_get" then
    sb_push(sb, "    pop rcx" + x64_nl_char())
    sb_push(sb, "    pop rax" + x64_nl_char())
    sb_push(sb, "    sar rax, cl" + x64_nl_char())
    sb_push(sb, "    and rax, 1" + x64_nl_char())
    sb_push(sb, "    push rax" + x64_nl_char())
  elif name == "bit_set" then
