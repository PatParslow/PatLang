make a function called x64_binop_asm takes op returns asm
  let sb = sb_new()
  sb_push(sb, "    pop r10" + x64_nl_char())
  sb_push(sb, "    pop rax" + x64_nl_char())
  if op == "+" then
    sb_push(sb, x64_str_aware_plus_asm())
  else
    if op == "-" then
      sb_push(sb, "    sub rax, r10" + x64_nl_char())
    else
      if op == "*" then
        sb_push(sb, "    imul rax, r10" + x64_nl_char())
      else
        if op == "/" then
          # GitHub #53 investigation: a REAL, but DIFFERENT bug from
          # what was first assumed here -- this genuinely-static "/"
          # path (reached only for a function that is NOT dynamic_mode
          # at all, or a per-instruction-provable-fixnum "/" within
          # one) is used throughout this codebase's own runtime for
          # ordinary TRUNCATING integer division with no numeric-tower
          # meaning at all (e.g. rt_bigint_from_i64's own digit-
          # counting loop, `t / 1000000000`) -- NOT every "/" should
          # promote to Rational, only one that's genuinely part of
          # dynamic-mode numeric-tower code. A first attempt made this
          # path ALSO promote-on-inexact, which broke rt_bigint_from_i64
          # itself (confirmed: plain bigint construction segfaulted).
          # Reverted to plain truncating division, unchanged from
          # before -- the real fix belongs in ROUTING ("/" inside a
          # genuinely dynamic_mode function should never reach this
          # static path in the first place), not in this function.
          sb_push(sb, "    cqo" + x64_nl_char())
          sb_push(sb, "    idiv r10" + x64_nl_char())
        else
          if op == "%" then
            sb_push(sb, "    cqo" + x64_nl_char())
            sb_push(sb, "    idiv r10" + x64_nl_char())
            sb_push(sb, "    mov rax, rdx" + x64_nl_char())
          else
            # Bitwise ops (needed by the numeric-tower tagging scheme's
            # own tag-packing arithmetic -- rt_bigint_from_i64 etc. in
            # x64_runtime.patlang use ordinary `shl`/`bor` to build tag
            # words, and since that file is compiled by THIS backend
            # too, these ops need real codegen here, not just in the
            # rustc-text backend).
            if op == "band" then
              sb_push(sb, "    and rax, r10" + x64_nl_char())
            else
              if op == "bor" then
                sb_push(sb, "    or rax, r10" + x64_nl_char())
              else
                if op == "bxor" then
                  sb_push(sb, "    xor rax, r10" + x64_nl_char())
                else
                  if op == "shl" then
                    sb_push(sb, "    mov rcx, r10" + x64_nl_char())
                    sb_push(sb, "    shl rax, cl" + x64_nl_char())
                  else
                    if op == "shr" then
                      sb_push(sb, "    mov rcx, r10" + x64_nl_char())
                      sb_push(sb, "    sar rax, cl" + x64_nl_char())
                    else
                      if op == "==" then
                        sb_push(sb, x64_str_aware_eq_asm(false))
                      else
                        if op == "!=" then
                          sb_push(sb, x64_str_aware_eq_asm(true))
                        else
                          if op == "<" then
                            sb_push(sb, x64_str_aware_ord_asm("setl"))
                          else
                            if op == "<=" then
                              sb_push(sb, x64_str_aware_ord_asm("setle"))
                            else
                              if op == ">" then
                                sb_push(sb, x64_str_aware_ord_asm("setg"))
                              else
                                if op == ">=" then
                                  sb_push(sb, x64_str_aware_ord_asm("setge"))
                                else
                                  print("codegen_x64: unsupported binary operator: " + op)
                                  return "    ; UNSUPPORTED_BINOP_ERROR" + x64_nl_char()
                                end
                              end
                            end
                          end
                        end
                      end
                    end
                  end
                end
              end
            end
          end
        end
      end
    end
  end
  # GitHub #24: tag a comparison's 0/1 result with the dedicated Bool
  # family so print/type_of/send-dispatch can tell it apart from a
  # plain fixnum -- every arithmetic/bitwise op above (+/-/*//,%/band/
  # bor/bxor/shl/shr) shares this same epilogue, so this must stay
  # gated on x64_is_dynamic_cmp_op(op) (true only for ==/!=/</<=/>/>=),
  # not applied unconditionally.
  if x64_is_dynamic_cmp_op(op) then
    sb_push(sb, "    mov rcx, 6917529027641081856" + x64_nl_char())
    sb_push(sb, "    or rax, rcx" + x64_nl_char())
  end
  sb_push(sb, "    push rax" + x64_nl_char())
  return sb_str(sb)
end

# ---- g_scratch/g_scratch2 lock (real OS threads make these process-
# wide shared, mutable state -- see g_scratch_cs's own .bss header) ----
#
# x64_lock_acquire_asm(suffix)/x64_lock_release_asm() are INLINED
# directly into another primitive's own asm sequence (same convention
# as x64_os_null_terminate_path_asm, called from inside x64_os_set_cwd_
# asm etc, not a standalone CallHost primitive). Each is SELF-aligning
# (its own mov r15,rsp/sub rsp,N/and rsp,-16/restore) rather than
# requiring the caller to have already set one up -- both make real
# WinAPI calls (InitializeCriticalSection/EnterCriticalSection/
# LeaveCriticalSection), and every existing caller in this file wraps
# g_scratch usage that happens BEFORE its own frame setup (the null-
# terminate call always comes first, the self-aligned WinAPI section
# second) -- self-aligning here means acquire/release can simply be
# placed at the very top/bottom of a function without re-deriving each
# caller's own register liveness. Per this file's own universal rule,
# no register survives a call unless explicitly preserved -- callers
# must not rely on rax/rcx/rdx/r8-r11 surviving acquire or release
# (which is exactly why every caller below places acquire as the FIRST
# instruction, before any arg is popped into a register, and release
# right before the final result is pushed -- nothing needing
# protection is ever live across either call).
#
# g_scratch_cs_ready's lazy init (0=never started, 1=another thread is
# initializing right now, 2=ready) uses a real `lock cmpxchg` race, not
# an eager startup hook -- the ONE thread that wins the 0->1
# transition calls InitializeCriticalSection and sets 2 itself; every
# other thread (this one's own 0->1 attempt failing, OR simply seeing
# 1 or 2 already) spins on `pause` until it sees 2. This keeps
# correctness independent of whether the program ever calls
# thread_spawn at all -- a single-threaded program's first lock_acquire
# just wins the race trivially and pays a few extra instructions, not a
# risk of ever touching an uninitialized CRITICAL_SECTION.
make a function called x64_lock_acquire_asm takes suffix returns asm
  let sb = sb_new()
  sb_push(sb, "    mov r15, rsp" + x64_nl_char())
  sb_push(sb, "    sub rsp, 32" + x64_nl_char())
  sb_push(sb, "    and rsp, -16" + x64_nl_char())
  sb_push(sb, "  .lock_check_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    mov rax, [rel g_scratch_cs_ready]" + x64_nl_char())
  sb_push(sb, "    cmp rax, 2" + x64_nl_char())
  sb_push(sb, "    je .lock_ready_" + suffix + x64_nl_char())
  sb_push(sb, "    xor rax, rax" + x64_nl_char())
  sb_push(sb, "    mov rcx, 1" + x64_nl_char())
  sb_push(sb, "    lock cmpxchg [rel g_scratch_cs_ready], rcx" + x64_nl_char())
  sb_push(sb, "    jne .lock_spin_" + suffix + x64_nl_char())
  sb_push(sb, "    lea rcx, [rel g_scratch_cs]" + x64_nl_char())
  sb_push(sb, "    call InitializeCriticalSection" + x64_nl_char())
  sb_push(sb, "    mov qword [rel g_scratch_cs_ready], 2" + x64_nl_char())
  sb_push(sb, "    jmp .lock_ready_" + suffix + x64_nl_char())
  sb_push(sb, "  .lock_spin_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    pause" + x64_nl_char())
  sb_push(sb, "    jmp .lock_check_" + suffix + x64_nl_char())
  sb_push(sb, "  .lock_ready_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    lea rcx, [rel g_scratch_cs]" + x64_nl_char())
  sb_push(sb, "    call EnterCriticalSection" + x64_nl_char())
  sb_push(sb, "    mov rsp, r15" + x64_nl_char())
  return sb_str(sb)
end

make a function called x64_lock_release_asm returns asm
  let sb = sb_new()
  sb_push(sb, "    mov r15, rsp" + x64_nl_char())
  sb_push(sb, "    sub rsp, 32" + x64_nl_char())
  sb_push(sb, "    and rsp, -16" + x64_nl_char())
  sb_push(sb, "    lea rcx, [rel g_scratch_cs]" + x64_nl_char())
  sb_push(sb, "    call LeaveCriticalSection" + x64_nl_char())
  sb_push(sb, "    mov rsp, r15" + x64_nl_char())
  return sb_str(sb)
end

# ---- file I/O (self-hosting-toward-x64, step 2 of 3: growable lists
# already done, exec_capture still ahead) ----
#
# Three new OS-boundary primitives, same win64-ABI save-rsp/align/
# restore-rsp pattern as the original os_write_console_bytes/os_exit,
# just with real CreateFileA/GetFileSize/ReadFile/CloseHandle
# sequences instead of GetStdHandle/WriteFile/ExitProcess. Contract:
# path_addr/data_addr/buf_addr are ALREADY-MASKED plain addresses --
# these primitives never see a tagged value, matching how
# mem_peek_qword etc already only ever take raw addresses (the
# PatLang WRAPPER functions below do all the tag-masking before
# calling). CreateFileA needs a NULL-TERMINATED C string, but this
# backend's strings are [length][bytes] (never null-terminated), so
# every primitive here copies the path into g_scratch + a trailing
# zero byte first -- reusing the existing 256-byte scratch buffer
# (an implicit "paths must fit in 256 bytes" limit, acceptable for a
# compiler's own source-file paths, not named as a hard guarantee for
# arbitrary use).
make a function called x64_os_null_terminate_path_asm takes suffix returns asm
  let sb = sb_new()
  sb_push(sb, "    lea rdi, [rel g_scratch]" + x64_nl_char())
  sb_push(sb, "    xor rsi, rsi" + x64_nl_char())
  sb_push(sb, "  .ntp_loop_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    cmp rsi, r10" + x64_nl_char())
  sb_push(sb, "    jge .ntp_done_" + suffix + x64_nl_char())
