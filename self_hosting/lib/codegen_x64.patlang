# Backs type_of/numeric_kind (see the x64_family_code CallHost case's
# own header) -- classifies by family nibble + Numeric sub-tag bits,
# same round-trip-fixnum-test-first discipline as every other
# classification this session already established.
make a function called x64_family_code_asm returns asm
  let suffix = label_asm_safe(0)
  let sb = sb_new()
  let bigint_tag = (1 shl 60) bor (1 shl 48)
  let rational_tag = (1 shl 60) bor (1 shl 48) bor (1 shl 49)
  let complex_tag = (1 shl 60) bor (1 shl 48) bor (1 shl 49) bor (1 shl 50)
  let interval_tag = (1 shl 60) bor (1 shl 52)
  sb_push(sb, "    pop rax" + x64_nl_char())
  sb_push(sb, "    mov rcx, rax" + x64_nl_char())
  sb_push(sb, "    shl rcx, 16" + x64_nl_char())
  sb_push(sb, "    sar rcx, 16" + x64_nl_char())
  sb_push(sb, "    cmp rcx, rax" + x64_nl_char())
  sb_push(sb, "    jne .fc_notfix_" + suffix + x64_nl_char())
  sb_push(sb, "    mov rax, 0" + x64_nl_char())
  sb_push(sb, "    jmp .fc_done_" + suffix + x64_nl_char())
  sb_push(sb, ".fc_notfix_" + suffix + ":" + x64_nl_char())
  # GitHub #47-adjacent fix: String/List/Closure/Object/BigInt/
  # Rational/Complex/Interval are ALL real heap pointers, which
  # rt_heap_alloc never returns as 0 -- so a zero PAYLOAD can never be
  # one of these 8 tags genuinely, only a coincidental bit-pattern
  # match (e.g. `1 shl 60` exactly equals the bare BigInt tag with zero
  # payload, and would otherwise misclassify as "bigint" instead of
  # "int"). Skip straight past all 8 payload-requiring checks when the
  # payload is zero -- Bool is the ONE tag below that legitimately has
  # a zero payload (false), so this jumps to right before that check,
  # not past it. Same reasoning as the identical fix just added to
  # print()'s own dispatch in x64_runtime.patlang.
  sb_push(sb, "    mov r14, rax" + x64_nl_char())
  sb_push(sb, "    mov r13, 281474976710655" + x64_nl_char())
  sb_push(sb, "    and r14, r13" + x64_nl_char())
  # GitHub #51: the zero-payload guard above (GitHub #48) only ruled out
  # ONE way a plain int can coincidentally match a reserved tag's upper
  # bits -- payload == 0. A plain int whose payload is NONZERO but still
  # not a real heap address (e.g. a large int produced by ordinary
  # arithmetic/bitwise ops that happens to fall in a reserved tag's bit
  # range) was NOT covered: the family comparisons below trust the tag
  # match and dereference the payload as if it were a genuine
  # rt_heap_alloc'd pointer, which segfaults when it isn't one. Every
  # one of the 8 payload-requiring families really is a rt_heap_alloc
  # pointer (see the #47-adjacent comment above), and rt_heap_alloc is a
  # simple bump allocator over one fixed g_heap region (x64_runtime
  # .patlang's own rt_heap_alloc) -- so a genuine pointer must fall
  # inside [g_heap, g_heap + bytes_used). Anything outside that range,
  # zero payload or not, cannot be a real heap pointer no matter what
  # its tag bits say, and falls through to the same safe "plain int"
  # default the zero-payload case already used (GitHub #34's established
  # convention) rather than being dereferenced.
  # GitHub #57: the lower bound here was `r14 >= g_heap`, which wrongly
  # rejects string LITERALS -- codegen_x64.patlang's own
  # x64_collect_string_data builds those directly into .data, never
  # through rt_heap_alloc, and .data sits at a LOWER address than
  # g_heap in this image's layout (confirmed empirically: a literal's
  # payload measured ~17KB below g_heap's base). Every real literal
  # was therefore always falling into fc_oob and misclassifying as
  # "other" via type_of/numeric_kind -- a plain small int (the thing
  # this bound exists to rule out) is nowhere near a real address
  # either way, so a generous fixed floor (64KB -- the standard
  # minimum valid address on Windows) still rules those out while
  # accepting genuine .data/heap pointers.
  sb_push(sb, "    push r12" + x64_nl_char())
  sb_push(sb, "    push r11" + x64_nl_char())
  sb_push(sb, "    lea r12, [rel g_heap]" + x64_nl_char())
  sb_push(sb, "    cmp r14, 65536" + x64_nl_char())
  sb_push(sb, "    jl .fc_oob_" + suffix + x64_nl_char())
  sb_push(sb, "    mov r11, [rel g_heap_state]" + x64_nl_char())
  sb_push(sb, "    add r11, r12" + x64_nl_char())
  sb_push(sb, "    cmp r14, r11" + x64_nl_char())
  sb_push(sb, "    jge .fc_oob_" + suffix + x64_nl_char())
  sb_push(sb, "    pop r11" + x64_nl_char())
  sb_push(sb, "    pop r12" + x64_nl_char())
  sb_push(sb, "    jmp .fc_inrange_" + suffix + x64_nl_char())
  sb_push(sb, ".fc_oob_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    pop r11" + x64_nl_char())
  sb_push(sb, "    pop r12" + x64_nl_char())
  sb_push(sb, "    jmp .fc_notinterval_" + suffix + x64_nl_char())
  sb_push(sb, ".fc_inrange_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    cmp r14, 0" + x64_nl_char())
  sb_push(sb, "    je .fc_notinterval_" + suffix + x64_nl_char())
  sb_push(sb, "    mov r15, 18446462598732840960" + x64_nl_char())
  sb_push(sb, "    and rax, r15" + x64_nl_char())
  sb_push(sb, "    mov rcx, 2305843009213693952" + x64_nl_char())
  sb_push(sb, "    cmp rax, rcx" + x64_nl_char())
  sb_push(sb, "    jne .fc_notstr_" + suffix + x64_nl_char())
  sb_push(sb, "    mov rax, 2" + x64_nl_char())
  sb_push(sb, "    jmp .fc_done_" + suffix + x64_nl_char())
  sb_push(sb, ".fc_notstr_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    mov rcx, 3458764513820540928" + x64_nl_char())
  sb_push(sb, "    cmp rax, rcx" + x64_nl_char())
  sb_push(sb, "    jne .fc_notlist_" + suffix + x64_nl_char())
  sb_push(sb, "    mov rax, 3" + x64_nl_char())
  sb_push(sb, "    jmp .fc_done_" + suffix + x64_nl_char())
  sb_push(sb, ".fc_notlist_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    mov rcx, 4611686018427387904" + x64_nl_char())
  sb_push(sb, "    cmp rax, rcx" + x64_nl_char())
  sb_push(sb, "    jne .fc_notclosure_" + suffix + x64_nl_char())
  sb_push(sb, "    mov rax, 4" + x64_nl_char())
  sb_push(sb, "    jmp .fc_done_" + suffix + x64_nl_char())
  sb_push(sb, ".fc_notclosure_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    mov rcx, 5764607523034234880" + x64_nl_char())
  sb_push(sb, "    cmp rax, rcx" + x64_nl_char())
  sb_push(sb, "    jne .fc_notobj_" + suffix + x64_nl_char())
  sb_push(sb, "    mov rax, 5" + x64_nl_char())
  sb_push(sb, "    jmp .fc_done_" + suffix + x64_nl_char())
  sb_push(sb, ".fc_notobj_" + suffix + ":" + x64_nl_char())
  # GitHub #45: bool_array's own family tag (7 shl 60 =
  # 8070450532247928832) -- like String/List/Closure/Object, its
  # payload is a genuine rt_heap_alloc pointer, so this check must stay
  # inside the same heap-range-guarded region as those (unlike Bool,
  # whose payload is just 0/1, checked further below, unguarded).
  sb_push(sb, "    mov rcx, 8070450532247928832" + x64_nl_char())
  sb_push(sb, "    cmp rax, rcx" + x64_nl_char())
  sb_push(sb, "    jne .fc_notboolarray_" + suffix + x64_nl_char())
  sb_push(sb, "    mov rax, 12" + x64_nl_char())
  sb_push(sb, "    jmp .fc_done_" + suffix + x64_nl_char())
  sb_push(sb, ".fc_notboolarray_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    mov rcx, " + bigint_tag + x64_nl_char())
  sb_push(sb, "    cmp rax, rcx" + x64_nl_char())
  sb_push(sb, "    jne .fc_notbigint_" + suffix + x64_nl_char())
  sb_push(sb, "    mov rax, 6" + x64_nl_char())
  sb_push(sb, "    jmp .fc_done_" + suffix + x64_nl_char())
  sb_push(sb, ".fc_notbigint_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    mov rcx, " + rational_tag + x64_nl_char())
  sb_push(sb, "    cmp rax, rcx" + x64_nl_char())
  sb_push(sb, "    jne .fc_notrational_" + suffix + x64_nl_char())
  sb_push(sb, "    mov rax, 7" + x64_nl_char())
  sb_push(sb, "    jmp .fc_done_" + suffix + x64_nl_char())
  sb_push(sb, ".fc_notrational_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    mov rcx, " + complex_tag + x64_nl_char())
  sb_push(sb, "    cmp rax, rcx" + x64_nl_char())
  sb_push(sb, "    jne .fc_notcomplex_" + suffix + x64_nl_char())
  sb_push(sb, "    mov rax, 8" + x64_nl_char())
  sb_push(sb, "    jmp .fc_done_" + suffix + x64_nl_char())
  sb_push(sb, ".fc_notcomplex_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    mov rcx, " + interval_tag + x64_nl_char())
  sb_push(sb, "    cmp rax, rcx" + x64_nl_char())
  sb_push(sb, "    jne .fc_notinterval_" + suffix + x64_nl_char())
  sb_push(sb, "    mov rax, 9" + x64_nl_char())
  sb_push(sb, "    jmp .fc_done_" + suffix + x64_nl_char())
  sb_push(sb, ".fc_notinterval_" + suffix + ":" + x64_nl_char())
  # GitHub #24: dedicated Bool family tag (6 shl 60 = 6917529027641081856),
  # the first genuinely new family added since this scheme's original six
  # (fixnum/Numeric/String/List/Closure/Object) -- confirmed unused via a
  # repo-wide grep for "4 shl 60"/"6 shl 60"/"7 shl 60" before picking it.
  #
  # GitHub #45 follow-up: this compared the FULL word against the
  # zero-payload bool tag with no masking -- correctly recognizing
  # `false` (payload 0) but NEVER `true` (payload 1), since an exact
  # `cmp rax, rcx` can only ever match one specific payload value.
  # Found while testing bool_array_get's own return value (a real
  # Bool constructed via `6917529027641081856 bor bit`): `type_of()`
  # reported "other" for `true` and `print()` fell through to its raw-
  # int default instead of "true" -- reproduced independently of
  # bool_array entirely (`type_of(true)` alone was already wrong; only
  # `print(true)` happened to look right, via a separate, unrelated
  # literal-folding shortcut at the call site, not this classifier).
  # Fixed the same way every OTHER family here already handles its own
  # payload: mask it off (via the SAME top-16-bits-only mask the
  # pointer-family checks use, reloaded fresh into scratch registers
  # since r15/rax may not still hold it on the OOB-jump path Bool's
  # own check is reached from) before comparing, so any payload value
  # (0 or 1) matches the family, not just a zero one.
  sb_push(sb, "    mov rcx, rax" + x64_nl_char())
  sb_push(sb, "    mov r10, 18446462598732840960" + x64_nl_char())
  sb_push(sb, "    and rcx, r10" + x64_nl_char())
  sb_push(sb, "    mov r11, 6917529027641081856" + x64_nl_char())
  sb_push(sb, "    cmp rcx, r11" + x64_nl_char())
  sb_push(sb, "    jne .fc_notbool_" + suffix + x64_nl_char())
  sb_push(sb, "    mov rax, 11" + x64_nl_char())
  sb_push(sb, "    jmp .fc_done_" + suffix + x64_nl_char())
  sb_push(sb, ".fc_notbool_" + suffix + ":" + x64_nl_char())
  # GitHub #48 follow-up: r14 (the payload, computed once right after
  # fc_notfix_ and never touched by any comparison branch above -- all
  # of them use only rax/rcx/r15) distinguishes the two ways execution
  # can reach here. Zero payload + no tag matched (not even Bool) means
  # this is a plain, unpromoted value too large for the 48-bit fixnum
  # window -- exactly the same case print()'s own fallback already
  # treats as a plain int (GitHub #34's established "safest available
  # default"), so this now agrees with print() instead of contradicting
  # it (a value could otherwise print as one thing and type_of() as
  # something else for the exact same value). A NONZERO payload that
  # matched none of the 8 real tags is a genuinely unrecognized/corrupt
  # value -- "other" remains the right answer there, unchanged.
  sb_push(sb, "    cmp r14, 0" + x64_nl_char())
  sb_push(sb, "    jne .fc_other_" + suffix + x64_nl_char())
  sb_push(sb, "    mov rax, 0" + x64_nl_char())
  sb_push(sb, "    jmp .fc_done_" + suffix + x64_nl_char())
  sb_push(sb, ".fc_other_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    mov rax, 10" + x64_nl_char())
  sb_push(sb, ".fc_done_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  return sb_str(sb)
end

# CallHost -- only the five special primitive names are legal here,
# PLUS several safe aliases: `l[i]` index syntax always lowers to
# CallHost("list_get", 2) regardless of backend (lib/lower.patlang's
# own doing, not special-cased here), and `list_len(l)` is ordinary
# unrecognized-call-becomes-CallHost the same as any host function
# name. Both are pure reads with unambiguous semantics (a read is a
# read regardless of the mutation model), so they're aliased straight
# to `call rt_list_get`/`call rt_list_len` -- reusing the SAME PatLang
# implementation, not a separate native primitive. `list_push` stays
# under its own explicit `rt_list_*` name (in-place-when-possible
# growable-list semantics, deliberately distinct from the interpreter's
# copy-on-write list_push -- see rt_list_push's own header). `list_set`
# WAS deliberately unaliased for the same reason (this backend's
# rt_list_set is in-place mutation, not copy-on-write) -- until GitHub
# #29's x64_analyze_dynamic_bins needed a genuine copy-on-write
# list_set for its own virtual-stack simulation, the first real caller
# of PLAIN list_set anywhere in this codebase. Aliased to a NEW,
# separate function (`rt_list_set_functional`, see x64_runtime.patlang)
# that actually implements the copy-on-write contract, rather than
# reusing the mutating `rt_list_set` under the ambiguous name -- keeps
# PatLang's own observable list_set semantics intact for any other
# caller.
# .length property-access syntax lowers straight to CallHost("len", 1)
# in the LOWERER itself, bypassing ordinary name resolution entirely --
# unlike sb_push/to_num/chr/substr/str_intern/sc_len (all shadowable by
# an ordinary same-named PatLang function, see x64_runtime.patlang's own
# header on this), this one genuinely needs native codegen here. Matches
# host_len's Rust semantics (rust-runtime/src/ir/hosts.rs:438): String ->
# byte length (this backend's strings are byte-only, no separate char
# count needed), List -> element count, Object -> field count, anything
# else -> 0.
make a function called x64_len_asm returns asm
  let suffix = label_asm_safe(0)
  let sb = sb_new()
  sb_push(sb, "    pop rax" + x64_nl_char())
  sb_push(sb, "    mov rcx, 17293822569102704640" + x64_nl_char())
  sb_push(sb, "    mov rdx, rax" + x64_nl_char())
  sb_push(sb, "    and rdx, rcx" + x64_nl_char())
  sb_push(sb, "    mov rcx, 2305843009213693952" + x64_nl_char())
  sb_push(sb, "    cmp rdx, rcx" + x64_nl_char())
  sb_push(sb, "    je .LEN_STRLIST_" + suffix + x64_nl_char())
  sb_push(sb, "    mov rcx, 3458764513820540928" + x64_nl_char())
  sb_push(sb, "    cmp rdx, rcx" + x64_nl_char())
  sb_push(sb, "    je .LEN_STRLIST_" + suffix + x64_nl_char())
  sb_push(sb, "    mov rcx, 5764607523034234880" + x64_nl_char())
  sb_push(sb, "    cmp rdx, rcx" + x64_nl_char())
  sb_push(sb, "    je .LEN_OBJ_" + suffix + x64_nl_char())
  sb_push(sb, "    mov rax, 0" + x64_nl_char())
  sb_push(sb, "    jmp .LEN_DONE_" + suffix + x64_nl_char())
  # String's length lives at [addr+0]; List's ALSO lives at [addr+0]
  # (both formats start with an 8-byte length field -- see rt_str_len/
  # rt_list_len's own layout comments) -- same masked-read either way.
  sb_push(sb, ".LEN_STRLIST_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    mov rcx, 281474976710655" + x64_nl_char())
  sb_push(sb, "    and rax, rcx" + x64_nl_char())
  sb_push(sb, "    mov rax, [rax]" + x64_nl_char())
  sb_push(sb, "    jmp .LEN_DONE_" + suffix + x64_nl_char())
  sb_push(sb, ".LEN_OBJ_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  sb_push(sb, "    call rt_object_field_count" + x64_nl_char())
  sb_push(sb, "    add rsp, 8" + x64_nl_char())
  sb_push(sb, ".LEN_DONE_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  return sb_str(sb)
end

# os_get_command_line() -> RAW (untagged) heap address of a fresh
# [length:8][bytes...] block holding the process's own command line
# (argv()'s own native boundary -- everything else, quote-aware
# tokenization and dropping argv[0], is ordinary PatLang in
# x64_runtime.patlang, matching this backend's "native primitives stay
# narrow" convention throughout). GetCommandLineA returns a pointer to
# a NUL-terminated C string, not this backend's own [length][bytes]
# form, so this measures the length itself before copying -- the ONE
# genuinely new native primitive the argv/read_file/write_file/
# file_exists gap needed (the other three already had rt_* wrappers
# built on existing os_file_size/os_read_file_into/os_write_file).
make a function called x64_os_get_command_line_asm returns asm
  let suffix = label_asm_safe(0)
  let sb = sb_new()
  sb_push(sb, "    mov r15, rsp" + x64_nl_char())
  sb_push(sb, "    sub rsp, 32" + x64_nl_char())
  sb_push(sb, "    and rsp, -16" + x64_nl_char())
  sb_push(sb, "    call GetCommandLineA" + x64_nl_char())
  sb_push(sb, "    mov rsp, r15" + x64_nl_char())
  sb_push(sb, "    mov r13, rax" + x64_nl_char())
  sb_push(sb, "    xor r14, r14" + x64_nl_char())
  sb_push(sb, "  .argv_len_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    cmp byte [r13+r14], 0" + x64_nl_char())
  sb_push(sb, "    je .argv_lendone_" + suffix + x64_nl_char())
  sb_push(sb, "    inc r14" + x64_nl_char())
  sb_push(sb, "    jmp .argv_len_" + suffix + x64_nl_char())
  sb_push(sb, "  .argv_lendone_" + suffix + ":" + x64_nl_char())
  # This backend's own calling convention gives NO register-
  # preservation guarantee across a call (documented repeatedly
  # elsewhere in this file) -- r13/r14 must be saved on the REAL
  # machine stack across rt_heap_alloc, not just left sitting in
  # registers.
  sb_push(sb, "    push r13" + x64_nl_char())
  sb_push(sb, "    push r14" + x64_nl_char())
  # Real bug caught here (not by review -- the tail of the captured
  # command line kept coming out corrupted/truncated by exactly ~8
  # bytes in testing): allocated only `length` bytes, then wrote an
  # 8-byte length HEADER plus `length` bytes of content into it -- an
  # 8-byte overflow past the block's own end, clobbering whatever the
  # bump allocator placed right after it. Must allocate length+8.
  sb_push(sb, "    mov rax, r14" + x64_nl_char())
  sb_push(sb, "    add rax, 8" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  sb_push(sb, "    call rt_heap_alloc" + x64_nl_char())
  sb_push(sb, "    add rsp, 8" + x64_nl_char())
  sb_push(sb, "    pop r14" + x64_nl_char())
  sb_push(sb, "    pop r13" + x64_nl_char())
  sb_push(sb, "    mov r12, rax" + x64_nl_char())
  sb_push(sb, "    mov [r12], r14" + x64_nl_char())
  sb_push(sb, "    xor rax, rax" + x64_nl_char())
  sb_push(sb, "  .argv_copy_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    cmp rax, r14" + x64_nl_char())
  sb_push(sb, "    jge .argv_copydone_" + suffix + x64_nl_char())
  sb_push(sb, "    mov cl, [r13+rax]" + x64_nl_char())
  sb_push(sb, "    mov [r12+8+rax], cl" + x64_nl_char())
  sb_push(sb, "    inc rax" + x64_nl_char())
  sb_push(sb, "    jmp .argv_copy_" + suffix + x64_nl_char())
  sb_push(sb, "  .argv_copydone_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    mov rax, r12" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  return sb_str(sb)
end

make a function called x64_callhost_asm takes name, argc, spilled returns asm
  # GitHub #52: a fixed-size, ALWAYS-inline raw machine-word equality
  # primitive, deliberately NOT going through x64_binop_asm_dynamic's
  # own "==" dispatch -- rt_dynamic_cmp_obj (x64_runtime.patlang) needs
  # genuine identity comparison for the Object/List/Closure fallback
  # case, but calling PatLang's own "==" operator there would recompile
  # through THIS SAME dynamic dispatch for non-numeric operands,
  # recursing back into the very out-of-line helper it's being called
  # from. A self-contained early return, deliberately NOT inserted into
  # the long if/else chain below (which nests without `elif` past a
  # certain point -- a single extra branch there needs a matching `end`
  # added at the FAR end of that chain, easy to get wrong; an early
  # return here needs nothing else to stay balanced).
  if name == "rt_raw_word_eq" then
    let rweq_sb = sb_new()
    sb_push(rweq_sb, "    pop rcx" + x64_nl_char())
    sb_push(rweq_sb, "    pop rax" + x64_nl_char())
    sb_push(rweq_sb, "    cmp rax, rcx" + x64_nl_char())
    sb_push(rweq_sb, "    sete al" + x64_nl_char())
    sb_push(rweq_sb, "    movzx rax, al" + x64_nl_char())
    sb_push(rweq_sb, "    mov rcx, 6917529027641081856" + x64_nl_char())
    sb_push(rweq_sb, "    or rax, rcx" + x64_nl_char())
    sb_push(rweq_sb, "    push rax" + x64_nl_char())
    return sb_str(rweq_sb)
  end
  # GitHub #53: a fixed-size, ALWAYS-inline PLAIN TRUNCATING integer
  # division primitive. `/` at the language level auto-promotes to a
  # Rational on inexact division (confirmed: this matches the real
  # interpreter's own semantics, `pat --ir-run`, not just this backend's
  # choice) -- but this runtime library's OWN internal arithmetic
  # (digit-extraction loops, bigint limb/carry math, GCD reduction) has
  # always relied on genuine truncating division with no tower meaning
  # at all. A first attempt made ALL "/" (including this static,
  # per-instruction-provable-fixnum path) promote-on-inexact to match
  # the language-level operator -- broke rt_bigint_from_i64 itself
  # (its own `t / 1000000000` digit-counting loop expects truncation,
  # not promotion). This primitive exists so that internal callers can
  # ask for truncating division explicitly and unambiguously, leaving
  # the "/" OPERATOR itself free to eventually be fixed to always
  # promote (a separate, not-yet-done change -- see the "/" case in
  # x64_binop_asm below, which still reverts to plain idiv here).
  if name == "rt_trunc_div" then
    let td_sb = sb_new()
    sb_push(td_sb, "    pop rcx" + x64_nl_char())
    sb_push(td_sb, "    pop rax" + x64_nl_char())
    sb_push(td_sb, "    cqo" + x64_nl_char())
    sb_push(td_sb, "    idiv rcx" + x64_nl_char())
    sb_push(td_sb, "    push rax" + x64_nl_char())
    return sb_str(td_sb)
  end
  let sb = sb_new()
  if name == "list_get" then
    sb_push(sb, "    call rt_list_get" + x64_nl_char())
    sb_push(sb, "    add rsp, 16" + x64_nl_char())
    sb_push(sb, "    push rax" + x64_nl_char())
  elif name == "list_set" then
    sb_push(sb, "    call rt_list_set_functional" + x64_nl_char())
    sb_push(sb, "    add rsp, 24" + x64_nl_char())
    sb_push(sb, "    push rax" + x64_nl_char())
  elif name == "class_def" then
    # `class X { ... }` lowers to a HARDCODED CallHost("class_def", 5)
    # (see lowering.rs's ClassDecl handling) -- bypasses ordinary
    # Call-vs-CallHost same-name-function resolution entirely, same
    # class of gap as rule_add above, so defining class_def_register as
    # an ordinary function in x64_runtime.patlang isn't enough on its
    # own; this CallHost name needs explicit routing too.
    sb_push(sb, "    call class_def_register" + x64_nl_char())
    sb_push(sb, "    add rsp, 40" + x64_nl_char())
    sb_push(sb, "    push rax" + x64_nl_char())
  elif name == "send" then
    # send(recv, method, arg1, ...) is genuinely variadic (PatLang has
    # no variadic function syntax, same reason exec_capture/spawn need
    # their own CallHost cases -- see x64_exec_capture_asm's own
    # header) -- argc IS a compile-time constant per call site though
    # (the source's own literal arg count), so this whole thing is a
    # compile-time-unrolled sequence, no runtime loop needed beyond
    # what x64_buildlist_asm/x64_callvalue_asm already do internally.
    #
    # Real invocation ("call whatever function a resolved closure
    # wraps") needs x64_callvalue_asm's own generated-code mechanism --
    # an ordinary PatLang function body can't do that (same reason
    # rust-runtime's interpreter.rs handles `send`'s closure-invocation
    # HERE rather than in hosts.rs's host_send, see interpreter.rs's own
    # comment on this). rt_send_prepare (x64_runtime.patlang) does
    # everything else: the "set" special-case and method/class
    # resolution, returning the closure to invoke or 0 if there's
    # nothing left to invoke.
    let k = to_num(argc) - 2
    let suffix = label_asm_safe(0)
    # 1. Collect all argc pushed values into a heap array (exact idiom
    #    as x64_exec_capture_asm's own arg collection): arr[0]=recv,
    #    arr[1]=method, arr[2..]=rest args.
    sb_push(sb, "    mov rax, " + (to_num(argc) * 8) + x64_nl_char())
    sb_push(sb, "    push rax" + x64_nl_char())
    sb_push(sb, "    call rt_heap_alloc" + x64_nl_char())
    sb_push(sb, "    add rsp, 8" + x64_nl_char())
    sb_push(sb, "    mov r12, rax" + x64_nl_char())
    let ai = to_num(argc) - 1
    while ai >= 0 do
      sb_push(sb, "    pop r10" + x64_nl_char())
      sb_push(sb, "    mov [r12+" + (ai * 8) + "], r10" + x64_nl_char())
      let ai = ai - 1
    end
    # 2. Re-push recv, method, then rest-args (building rest_list),
    #    for rt_send_prepare(recv, method, rest_list). Real bug found
    #    and fixed here via WinDbg (genuine null-pointer segfault, rax=0
    #    reading a bogus "recv"): x64_buildlist_asm's OWN generated code
    #    freely reassigns r12 for its own list-header bookkeeping (see
    #    its own header -- this backend gives no register-preservation
    #    guarantee across an embedded call/block any more than a real
    #    `call`), clobbering `arr`'s pointer out from under this
    #    function the moment it's invoked. `arr` must survive it (and
    #    the real `call rt_send_prepare` right after, which clobbers
    #    every register too) -- preserved on the real machine stack via
    #    push/pop, same idiom x64_os_exec_run_asm already uses for its
    #    own cmdline_addr/cmdline_len across an internal rt_heap_alloc
    #    call.
    sb_push(sb, "    push r12" + x64_nl_char())
    sb_push(sb, "    mov rax, [r12+0]" + x64_nl_char())
    sb_push(sb, "    push rax" + x64_nl_char())
    sb_push(sb, "    mov rax, [r12+8]" + x64_nl_char())
    sb_push(sb, "    push rax" + x64_nl_char())
    let ri = 0
    while ri < k do
      sb_push(sb, "    mov rax, [r12+" + ((2 + ri) * 8) + "]" + x64_nl_char())
      sb_push(sb, "    push rax" + x64_nl_char())
      let ri = ri + 1
    end
    sb_push(sb, x64_buildlist_asm(k))
    sb_push(sb, "    call rt_send_prepare" + x64_nl_char())
    sb_push(sb, "    add rsp, 24" + x64_nl_char())
    sb_push(sb, "    mov r13, rax" + x64_nl_char())
    sb_push(sb, "    pop r12" + x64_nl_char())
    sb_push(sb, "    cmp r13, 0" + x64_nl_char())
    sb_push(sb, "    je .SEND_DONE_" + suffix + x64_nl_char())
    # 3. Real method found -- invoke via x64_callvalue_asm: push recv,
    #    then rest-args (in order, matching the real interpreter's own
    #    `full_args = captured(none) + [recv] + rest`) -- x64_callvalue_
    #    asm's OWN calling convention (see its own header/step comments)
    #    expects the CLOSURE pushed FIRST, then the own-args pushed on
    #    top (it pops the top N as own-args, THEN pops what's left as
    #    the closure) -- opposite of the naive "closure last" order a
    #    first pass at this got wrong, caught by a genuine WinDbg-traced
    #    null-pointer segfault (r14=0 inside x64_callvalue_asm's own
    #    closure-deref, once the wrong value got popped as "the
    #    closure").
    sb_push(sb, "    push r13" + x64_nl_char())
    sb_push(sb, "    mov rax, [r12+0]" + x64_nl_char())
    sb_push(sb, "    push rax" + x64_nl_char())
    let ri = 0
    while ri < k do
      sb_push(sb, "    mov rax, [r12+" + ((2 + ri) * 8) + "]" + x64_nl_char())
      sb_push(sb, "    push rax" + x64_nl_char())
      let ri = ri + 1
    end
    sb_push(sb, x64_callvalue_asm(k + 1, spilled))
    sb_push(sb, "    jmp .SEND_ALLDONE_" + suffix + x64_nl_char())
    sb_push(sb, ".SEND_DONE_" + suffix + ":" + x64_nl_char())
    # "set" (or, out of this slice's scope, a genuinely unresolvable
    # method -- see rt_send_prepare's own header) already handled with
    # nothing further to invoke; push a placeholder so CallHost's own
    # "push exactly 1 result" contract still holds.
    sb_push(sb, "    push 0" + x64_nl_char())
    sb_push(sb, ".SEND_ALLDONE_" + suffix + ":" + x64_nl_char())
  elif name == "contract_check" then
    # Same class of gap as rule_add just below: `require`/`ensure`
    # statements lower to a HARDCODED CallHost("contract_check", 4)
    # (see lower.patlang, two sites: the immutable-reassignment check
    # and the require/ensure/assert statement arm) -- bypasses ordinary
    # Call-vs-CallHost resolution, so defining contract_check as an
    # ordinary function wasn't enough on its own.
    sb_push(sb, "    call contract_check" + x64_nl_char())
    sb_push(sb, "    add rsp, 32" + x64_nl_char())
    sb_push(sb, "    push rax" + x64_nl_char())
  elif name == "rule_add" then
    # Real gap found running real regression programs (GitHub #26,
    # Stage 1 slice 4): the native `rule pred(args).`/`rule head(args)
    # :- body.` DECLARATIVE syntax lowers to a HARDCODED
    # CallHost("rule_add", 3) (see lower.patlang's RuleDecl arm) --
    # unlike an ordinary `rule_add(...)` function-call expression,
    # this bypasses the normal Call-vs-CallHost same-name-function
    # resolution entirely, so defining rule_add as an ordinary
    # function in x64_runtime.patlang (already done) isn't enough on
    # its own; this CallHost name needs explicit routing too. `solve`
    # has no equivalent statement-level syntax (always an ordinary
    # function call), so it needed no such case.
    sb_push(sb, "    call rule_add" + x64_nl_char())
    sb_push(sb, "    add rsp, 24" + x64_nl_char())
    sb_push(sb, "    push rax" + x64_nl_char())
  else
  if name == "list_push" then
    sb_push(sb, "    call rt_list_push" + x64_nl_char())
    sb_push(sb, "    add rsp, 16" + x64_nl_char())
    sb_push(sb, "    push rax" + x64_nl_char())
  else
  if name == "os_file_size" then
    sb_push(sb, x64_os_file_size_asm())
  else
  if name == "os_read_file_into" then
    sb_push(sb, x64_os_read_file_into_asm())
  else
  if name == "os_write_file" then
    sb_push(sb, x64_os_write_file_asm())
  elif name == "os_copy_file" then
    # Deliberately `elif`, not another "else\nif...end" nesting level
    # -- per this session's own CLAUDE.md convention (added after a
    # real bug from exactly that pattern), a new branch on an existing
    # deferred-end chain should use elif so the end-count can't drift.
    sb_push(sb, x64_os_copy_file_asm())
  elif name == "os_rename_file" then
    sb_push(sb, x64_os_rename_file_asm())
  elif name == "os_read_line" then
    sb_push(sb, x64_os_read_line_asm())
  elif name == "os_find_first" then
    sb_push(sb, x64_os_find_first_asm())
  elif name == "os_find_next" then
    sb_push(sb, x64_os_find_next_asm())
  elif name == "os_find_data_name" then
    sb_push(sb, x64_os_find_data_name_asm())
  elif name == "os_find_data_is_dir" then
    sb_push(sb, x64_os_find_data_is_dir_asm())
  elif name == "os_find_close" then
    sb_push(sb, x64_os_find_close_asm())
  else
  if name == "exec_capture" then
    sb_push(sb, x64_exec_capture_asm(argc))
  elif name == "spawn" then
    # Stage A of the interp.patlang-compilation roadmap (#25, past
    # #26/#27): spawn(path, arg1, arg2, ...) -> Int PID, non-blocking.
    # Deliberately a CallHost primitive (like exec_capture, not an
    # ordinary PatLang function) since real callers (interp.patlang's
    # own dispatch) invoke it with a VARYING argument count (1-4) --
    # PatLang has no variadic function definitions, so an ordinary
    # fixed-arity function couldn't serve every call site.
    sb_push(sb, x64_spawn_asm(argc))
  elif name == "os_get_exit_code_process" then
    # Thin wrapper: GetExitCodeProcess(handle) -> exit code Int, or the
    # STILL_ACTIVE (259) sentinel if the process hasn't finished. Used
    # by is_alive/wait (both ordinary PatLang functions in x64_runtime.
    # patlang) rather than exposing raw GetExitCodeProcess plumbing there.
    sb_push(sb, "    pop rcx" + x64_nl_char())
    sb_push(sb, "    mov r15, rsp" + x64_nl_char())
    sb_push(sb, "    sub rsp, 48" + x64_nl_char())
    sb_push(sb, "    and rsp, -16" + x64_nl_char())
    sb_push(sb, "    lea rdx, [rsp+32]" + x64_nl_char())
    sb_push(sb, "    call GetExitCodeProcess" + x64_nl_char())
    sb_push(sb, "    mov eax, [rsp+32]" + x64_nl_char())
    sb_push(sb, "    mov rsp, r15" + x64_nl_char())
    sb_push(sb, "    push rax" + x64_nl_char())
  elif name == "os_terminate_process" then
    # TerminateProcess(handle) -- best-effort, failure (already-exited)
    # is not surfaced as an error, matching the real host's `let _ =
    # child.kill()` semantics (rust-runtime/src/ir/hosts.rs).
    #
    # Real bug found and fixed here: a plain `sub rsp, N`/`add rsp, N`
    # (no `and rsp, -16`) silently ASSUMES the incoming rsp is already
    # 16-aligned -- but this backend's own value-stack pushes/pops use
    # the real machine rsp directly for expression evaluation, and a
    # function's post-prologue baseline alignment depends on that
    # function's own frame_size (8 * (spilled_count + 3)) mod 16, which
    # varies function to function. Confirmed directly: os_socket_tcp
    # with a bare `sub rsp, 32` crashed in some call sites but not
    # others, purely depending on which enclosing function's frame_size
    # parity happened to leave rsp already aligned. Every one of these
    # thin OS-primitive wrappers now self-aligns via the same
    # save-rsp/and/restore dance x64_os_write_file_asm/x64_os_exec_run_
    # asm/x64_os_wsa_startup_asm already used, matching this file's own
    # established (if not universally followed) precedent.
    sb_push(sb, "    pop rcx" + x64_nl_char())
    sb_push(sb, "    mov rdx, 1" + x64_nl_char())
    sb_push(sb, "    mov r15, rsp" + x64_nl_char())
    sb_push(sb, "    sub rsp, 32" + x64_nl_char())
    sb_push(sb, "    and rsp, -16" + x64_nl_char())
    sb_push(sb, "    call TerminateProcess" + x64_nl_char())
    sb_push(sb, "    mov rsp, r15" + x64_nl_char())
    sb_push(sb, "    push 0" + x64_nl_char())
  elif name == "os_wait_for_single_object" then
    # WaitForSingleObject(handle, INFINITE) -- blocking wait used by
    # wait()'s reap-to-completion semantics.
    sb_push(sb, "    pop rcx" + x64_nl_char())
    sb_push(sb, "    mov rdx, -1" + x64_nl_char())
    sb_push(sb, "    mov r15, rsp" + x64_nl_char())
    sb_push(sb, "    sub rsp, 32" + x64_nl_char())
    sb_push(sb, "    and rsp, -16" + x64_nl_char())
    sb_push(sb, "    call WaitForSingleObject" + x64_nl_char())
    sb_push(sb, "    mov rsp, r15" + x64_nl_char())
    sb_push(sb, "    push 0" + x64_nl_char())
  elif name == "os_close_handle" then
    sb_push(sb, "    pop rcx" + x64_nl_char())
    sb_push(sb, "    mov r15, rsp" + x64_nl_char())
    sb_push(sb, "    sub rsp, 32" + x64_nl_char())
    sb_push(sb, "    and rsp, -16" + x64_nl_char())
    sb_push(sb, "    call CloseHandle" + x64_nl_char())
    sb_push(sb, "    mov rsp, r15" + x64_nl_char())
    sb_push(sb, "    push 0" + x64_nl_char())
  elif name == "os_sleep_ms" then
    sb_push(sb, "    pop rcx" + x64_nl_char())
    sb_push(sb, "    mov r15, rsp" + x64_nl_char())
    sb_push(sb, "    sub rsp, 32" + x64_nl_char())
    sb_push(sb, "    and rsp, -16" + x64_nl_char())
    sb_push(sb, "    call Sleep" + x64_nl_char())
    sb_push(sb, "    mov rsp, r15" + x64_nl_char())
    sb_push(sb, "    push 0" + x64_nl_char())
