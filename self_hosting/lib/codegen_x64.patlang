  sb_push(sb, "    mov r12, r8" + x64_nl_char())
  sb_push(sb, "    mov r11, r9" + x64_nl_char())
  sb_push(sb, "    mov r10, [rel g_canvas_w]" + x64_nl_char())
  sb_push(sb, "    mov r9, [rel g_canvas_h]" + x64_nl_char())
  sb_push(sb, "    mov r8, [rel g_canvas_buf]" + x64_nl_char())
