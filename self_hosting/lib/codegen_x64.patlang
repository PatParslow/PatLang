  sb_push(sb, "    and rsp, -16" + x64_nl_char())
  sb_push(sb, "    mov rcx, r12" + x64_nl_char())
  sb_push(sb, "    lea rdx, [r13+8]" + x64_nl_char())
  sb_push(sb, "    mov r8, 65536" + x64_nl_char())
  sb_push(sb, "    xor r9, r9" + x64_nl_char())
  sb_push(sb, "    call recv" + x64_nl_char())
  sb_push(sb, "    mov rsp, r15" + x64_nl_char())
  sb_push(sb, "    cmp rax, 0 - 1" + x64_nl_char())
