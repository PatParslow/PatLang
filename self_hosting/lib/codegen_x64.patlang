  sb_push(sb, "    jle .conpty_read_capped_" + suffix + x64_nl_char())
  sb_push(sb, "    mov r12, r13" + x64_nl_char())
  sb_push(sb, "  .conpty_read_capped_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    push r15" + x64_nl_char())
  sb_push(sb, "    push r12" + x64_nl_char())
  sb_push(sb, "    mov rax, r12" + x64_nl_char())
  sb_push(sb, "    add rax, 8" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  sb_push(sb, "    call rt_heap_alloc" + x64_nl_char())
  sb_push(sb, "    add rsp, 8" + x64_nl_char())
  sb_push(sb, "    pop r12" + x64_nl_char())
  sb_push(sb, "    pop r15" + x64_nl_char())
  sb_push(sb, "    mov rsi, rax" + x64_nl_char())
  sb_push(sb, "    mov [rsi], r12" + x64_nl_char())
  sb_push(sb, "    lea r13, [rsi+8]" + x64_nl_char())
  sb_push(sb, "    mov rcx, [rel g_conpty_out_read]" + x64_nl_char())
