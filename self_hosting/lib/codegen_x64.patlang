# BuildList (Slice 4): the argc elements are already on the real stack
# in left-to-right pushed order (leftmost/element[0] deepest). Same
# [8-byte length][elements] block layout as strings, except each
# element is a plain qword (no byte-packing needed -- every PatLang
# value in this backend is already a qword, so a "list of anything" is
# trivially a list of qwords, including string/list addresses
# themselves). Allocates via an ordinary Call to rt_heap_alloc (same
# internal calling convention as any other function call), using r12
# (non-volatile, safe across that call) to hold the new list's address
# while the pushed elements get popped into it in reverse order.
# List block format is [length:8][capacity:8][elements...] (see
# rt_list_push's own header for why capacity tracking exists) --
# BuildList allocates TIGHT (capacity == length), elements start at
# offset 16.
make a function called x64_buildlist_asm takes argc returns asm
  let n = to_num(argc)
  let sb = sb_new()
  sb_push(sb, "    mov rax, " + (16 + n * 8) + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  sb_push(sb, "    call rt_heap_alloc" + x64_nl_char())
  sb_push(sb, "    add rsp, 8" + x64_nl_char())
  sb_push(sb, "    mov r12, rax" + x64_nl_char())
  sb_push(sb, "    mov qword [r12], " + n + x64_nl_char())
  sb_push(sb, "    mov qword [r12+8], " + n + x64_nl_char())
  let k = n - 1
  while k >= 0 do
    sb_push(sb, "    pop r10" + x64_nl_char())
    sb_push(sb, "    mov [r12+" + (16 + k * 8) + "], r10" + x64_nl_char())
    let k = k - 1
  end
  sb_push(sb, "    mov rax, r12" + x64_nl_char())
  sb_push(sb, "    mov rcx, 3458764513820540928" + x64_nl_char())
  sb_push(sb, "    or rax, rcx" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  return sb_str(sb)
end

