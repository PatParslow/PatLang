  sb_push(sb, "    xor r8, r8" + x64_nl_char())
  sb_push(sb, "  .ts_copy_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    cmp r8, rdx" + x64_nl_char())
  sb_push(sb, "    jge .ts_copy_done_" + suffix + x64_nl_char())
