# =============================================================================
# Self-hosted PatLang -> x64 NASM (win64) backend -- SLICE 1.
#
# Consumes the EXACT SAME flat IR lib/lower.patlang already produces
# for the Rust-text backend (ir[1]=entry, ir[2]=[FuncIR...], ir[3]=
# [EventIR...]) -- zero changes to lexer/parser/lower. Emits real NASM
# `win64` assembly text, assembled+linked with the same toolchain
# (nasm -f win64, then gcc -Wl,--subsystem,console -lkernel32 -luser32)
# already proven working this session for the recovered Mandelbrot
# double-double kernel driver (turbo_dd.asm).
#
# SLICE 1 SCOPE (see the plan file for the full reasoning): every value
# is a plain 64-bit integer -- no tagged dynamic Value, no numeric
# tower, no strings/lists/closures. `+ - * / % == != < <= > >=` on
# ints, `if/else`, `while`, ordinary (non-closure) function calls.
#
# CALLING CONVENTION (this backend's own, NOT the win64 ABI -- only the
# small OS-boundary primitive calls below need genuine win64 ABI
# compliance): a call's arguments are simply the values already pushed
# onto the real x64 stack by evaluating each argument expression
# left-to-right (exactly matching lower.patlang's own Call-lowering
# order) -- the callee copies them into its own local slots by reading
# fixed offsets above its return address, and returns its single
# result on the stack too (pop the result into rax, `leave`, `ret`;
# the caller cleans up the argc*8 bytes of pushed args and re-pushes
# rax as its own result). This keeps every instruction's stack effect
# exactly "pop N values, push 1 value" throughout, matching the
# CallHost/Call/Bin/Un instructions' own implicit contract in the IR.
#
# THE ONLY NAMES THIS BACKEND GIVES SPECIAL MEANING TO (everything else
# reaching CallHost is a compile-time error -- see lib/x64_runtime.
# patlang's own header for why the list is this short and what each
# one does): mem_scratch_addr, mem_poke_byte, mem_peek_byte,
# mem_heap_base, mem_heap_state_addr, mem_poke_qword, mem_peek_qword,
# os_write_console_bytes, os_exit. Only the last two are genuine win64-
# ABI calls into real OS DLL functions (GetStdHandle/WriteFile/
# ExitProcess -- WriteFile, not WriteConsoleA: the latter only works
# against a genuine interactive console handle and silently fails
# whenever stdout is redirected/piped, which is exactly what happened
# capturing this program's output during development) -- guarded by a
# save-rsp/align/restore-rsp pattern
# (register r15) so the surrounding operand-stack discipline is never
# disturbed by the temporary 16-byte alignment a real ABI call needs.
#
# HEAP (Slice 2): deliberately NOT one-OS-call-per-allocation. One
# fixed, large `.bss` reservation (g_heap) plus one persistent 8-byte
# bump-pointer counter (g_heap_state) are the ONLY heap-related native
# primitives -- the actual allocator ALGORITHM (bump-and-align today,
# a real free-list/reuse scheme whenever that becomes worth it) is
# ordinary PatLang in lib/x64_runtime.patlang's rt_heap_alloc, using
# nothing but mem_heap_base/mem_heap_state_addr/mem_peek_qword/
# mem_poke_qword. This is the SAME "runtime logic belongs in PatLang,
# not baked into the native primitive" principle Slice 1's int-to-
# string conversion already established -- growing the allocator later
# means writing more PatLang, not touching this backend again.
#
# STRINGS (Slice 3): a string is a heap-allocated block laid out as
# [8-byte length][raw bytes, not null-terminated] -- an ordinary
# integer address, same as every other value in this backend's
# monomorphic world, no new tag or runtime type. String LITERALS
# become `.data` labels (an 8-byte length + the literal's raw bytes,
# encoded as explicit byte VALUES via db, not a quoted NASM string, so
# no escaping logic is needed for quotes/newlines/anything else) --
# see x64_collect_string_data. Every string OPERATION (concat, length,
# printing) is ordinary PatLang in lib/x64_runtime.patlang built from
# the existing mem_peek/poke_byte/qword + rt_heap_alloc primitives --
# NO new native primitives were needed for strings at all.
#
# DELIBERATE SCOPE LIMIT: `+` on the IR's `Bin` instruction is STILL
# always integer addition -- this backend has no dynamic type tags, so
# it cannot tell at codegen time whether a pushed value is an int or a
# string pointer, and making `+` polymorphic would need real type
# inference or runtime tagging (a much bigger, separate undertaking).
# String concatenation is therefore its own explicitly-named function,
# `rt_str_concat(a, b)`, not operator overloading -- a real, named
# simplification, not an oversight.
#
# CLOSURES (Slice 5): a closure is a heap block laid out as
# [8-byte code address][8-byte captured count][captured values...] --
# deliberately chosen to generalize toward "everything is a function,
# everything is an object" rather than being a closure-only special
# case: a code/behavior pointer plus a bag of values is already most
# of the way to a general object (`[type/vtable pointer][field count]
# [field values...]` is nearly the same shape), and once closures are
# real callable values storable in lists (Slice 4), an event-handler
# table is just a list of `[name_string, closure]` pairs, dispatched
# by calling the matching closure through the exact same CallValue
# mechanism this slice builds -- both are real, named future
# directions, not built here, but the representation is chosen with
# them in view rather than needing to be redesigned later.
#
# MakeClosure(func_name, captured_names) -- captured_names.length is
# known at COMPILE time (it's a literal list baked into the IR at this
# instruction), so this is unrolled exactly like BuildList: allocate,
# store the code address (a compile-time label -- `lea`) and count,
# then pop the already-pushed captured values into the block.
#
# CallValue(argc) -- the CLOSURE's own captured count is NOT known at
# compile time here (a variable can hold different closures at
# different times), so pushing its captured values onto the operand
# stack before the real `call` needs a genuine runtime loop, unlike
# every other instruction in this backend. argc (the call site's own
# explicit arg count) IS compile-time-known, so those args are popped
# into the .bss scratch buffer first (out of the way), the closure's
# captured values are pushed via the runtime loop, then the scratch
# args are pushed back on top in original order, then an INDIRECT call
# (`call r12`, not a compile-time label) reaches the synthesized
# function -- whose own params are exactly `captured ++ own_params`,
# per lib/lower.patlang's own lower_closure_literal, so this lines up
# with the ordinary Call calling convention automatically once the
# stack is arranged correctly.
#
# NUMERIC TOWER, Slice 7 -- floats only, NOT BigInt/Rational/Complex
# (each is its own separate, much larger undertaking, deliberately not
# started here): a genuine second numeric kind, using NASM's own
# `__float64__(literal)` compile-time-constant operator for Const
# (no .data label needed, unlike strings -- floats fit in the same
# 8-byte slot ints already use) and SSE2 (`movq`/`addsd`/`ucomisd`+
# setcc) for Bin arithmetic and comparisons.
#
# DELIBERATE, NAMED SCOPE LIMIT, the real one: float-mode is a WHOLE-
# FUNCTION decision (any float literal anywhere in a given function's
# own body -> every Bin instruction IN THAT FUNCTION becomes float
# arithmetic), not a per-value decision -- this backend still has no
# dynamic type tags, so it has no way to tell int bit patterns from
# float bit patterns at any given Bin site. This means a single
# function mixing float math with ordinary int loop counters/
# arithmetic would be silently WRONG under this scheme (an int loop
# counter's bits reinterpreted as a float). Real per-value tagging
# (needed for BigInt/Rational too) is the actual fix, and is
# deliberately deferred -- any one function compiled by this slice
# must be either ALL-int or ALL-float, never mixed WITHIN that
# function. Const+Bin fusion (Slice 6) is disabled entirely in float
# mode for the same reason (it was designed around integer immediates
# only).
#
# Scoped per-FUNCTION rather than per-program deliberately: an earlier
# draft scanned the whole concatenated program (user source PLUS the
# PatLang-authored runtime prelude every program gets prepended),
# which meant a single float literal anywhere in the user's own code
# forced the RUNTIME's own functions -- e.g. rt_print_i64's `%`/`/`
# decimal-digit-extraction, genuine int arithmetic -- into float mode
# too, silently breaking them. Caught immediately (compile-time
# "unsupported float binary operator: %" from the runtime itself, not
# a silent wrong answer) the first time a float demo was actually
# compiled and run. Per-function scoping fixes this cleanly: each
# function (including every runtime helper) is judged independently by
# whether ITS OWN body contains a float literal.
#
# Float PRINTING (decimal formatting) is ALSO deliberately not built
# here -- real float-to-string formatting is its own separate, fiddly
# problem. This slice proves float ARITHMETIC is correct by truncating
# results back to int (via the new f64_to_i64_trunc primitive) and
# printing THAT with the existing rt_print_i64, not by building a
# float formatter.
# =============================================================================

make a function called x64_nl_char returns s
  return chr(10)
end

# ---- string literal data (Slice 3) ----
#
# Two passes over the SAME ir[2] funcs list, in the SAME deterministic
# order, each independently resetting and re-incrementing this counter
# -- x64_collect_string_data (pass 1, builds the .data text) and the
# ordinary x64_emit_func/x64_emit_instr codegen walk (pass 2) therefore
# assign IDENTICAL S0/S1/S2/... labels to the same Const "str" nodes
# without needing any lookup table between the two passes.
make a function called x64_string_label_reset returns done
  set_var("__x64_str_counter", 0)
  return true
end

make a function called x64_string_label_next returns label
  let n = to_num(get("__vars", "__x64_str_counter"))
  set_var("__x64_str_counter", n + 1)
  return "S" + n
end

# A string literal's raw bytes as NASM `db` byte-value text (e.g.
# "72,101,108,108,111"), not a quoted NASM string -- sidesteps quoting/
# escaping entirely, uniformly handles every character. An empty
# string still needs at least one byte for `db` to accept, hence the
# "0" placeholder (never read, since the stored length is 0).
make a function called x64_bytes_of takes text returns s
  let h = str_intern(text)
  let n = to_num(sc_len(h))
  if n == 0 then
    return "0"
  end
  let sb = sb_new()
  let i = 0
  while i < n do
    if i > 0 then
      sb_push(sb, ",")
    end
    sb_push(sb, "" + sc_code(h, i))
    let i = i + 1
  end
  return sb_str(sb)
end

# GitHub #38's known tag/mask-constant exclusion list plus the 48-bit
# fixnum-range magnitude check, factored out of x64_emit_instr's Const
# branch so x64_collect_string_data (pass 1) and x64_emit_instr (pass
# 2) can't drift out of sync on which literals get BigInt-promoted --
# see GitHub #40: pass 2 now needs to know this BEFORE reaching the
# Const branch, to decide whether to reserve a .data string label for
# the literal's own decimal text (see rt_bigint_from_decimal_str).
make a function called x64_num_const_needs_bigint_promotion takes text returns needed
  let is_excluded = false
  if text == "1152921504606846976" then
    let is_excluded = true
  end
  if text == "1153765929536978944" then
    let is_excluded = true
  end
  if text == "1154891829443821568" then
    let is_excluded = true
  end
  if text == "1157425104234217472" then
    let is_excluded = true
  end
  if text == "2305843009213693952" then
    let is_excluded = true
  end
  if text == "3458764513820540928" then
    let is_excluded = true
  end
  if text == "4611686018427387904" then
    let is_excluded = true
  end
  if text == "5764607523034234880" then
    let is_excluded = true
  end
  if text == "17293822569102704640" then
    let is_excluded = true
  end
  if text == "281474976710655" then
    let is_excluded = true
  end
  # GitHub #24: the new dedicated Bool family tag (6 shl 60), used as a
  # bare PatLang-source literal inside x64_runtime.patlang's own
  # print()/rt_list_to_display_string/type_of (unlike every OTHER site
  # that embeds this same value, which write it directly into raw asm
  # TEXT via string concatenation, never through the Const-literal
  # compilation path at all, so never at risk here) -- exact same bug
  # class as this exclusion list's other entries: without it, this
  # constant gets wrongly BigInt-promoted (a real heap pointer) inside
  # x64_runtime.patlang's own compiled body, so `v band family_mask ==
  # bool_family` never matches (comparing a raw masked int against a
  # heap pointer). Found by generating real asm and noticing
  # x64_family_code_asm (native asm, never touches this promotion
  # logic) correctly identified a Bool via type_of, while print()'s own
  # PatLang-level dispatch (which DOES go through this promotion logic)
  # did not.
  if text == "6917529027641081856" then
    let is_excluded = true
  end
  if is_excluded then
    return false
  end
  let val = to_num(text)
  if (val > 140737488355327) or (val < 0 - 140737488355327) then
    return true
  end
  return false
end

# Walks every function's instructions once, emitting one .data label
# per Const "str" node encountered, in encounter order. GitHub #40:
# also emits one for each oversized Const "num" literal that pass 2
# will promote to a real BigInt via rt_bigint_from_decimal_str -- MUST
# stay in the same encounter order and use the SAME tower-ctor-arg
# exclusion as x64_emit_instr's own Const branch, or the two passes'
# label counters (both driven by the same shared x64_string_label_next
# counter) desync and every subsequent string label in the function
# points at the wrong .data block.
make a function called x64_collect_string_data takes ir returns asm
  x64_string_label_reset()
  let funcs = ir[2]
  let sb = sb_new()
  let fn_i = 0
  let fn_n = to_num(list_len(funcs))
  while fn_i < fn_n do
    let instrs = funcs[fn_i][3]
    let tower_ctor_arg_indices = x64_tower_ctor_arg_indices(instrs)
    let i = 0
    let n = to_num(list_len(instrs))
    while i < n do
      let instr = instrs[i]
      if instr[0] == "Const" then
        if instr[1] == "str" then
          let label = x64_string_label_next()
          sb_push(sb, label + ":" + x64_nl_char())
          sb_push(sb, "    dq " + to_num(sc_len(str_intern(instr[2]))) + x64_nl_char())
          sb_push(sb, "    db " + x64_bytes_of(instr[2]) + x64_nl_char())
        else
          if instr[1] == "num" then
            if not x64_contains(instr[2], ".") then
              if not x64_str_in_list(tower_ctor_arg_indices, i) then
                if x64_num_const_needs_bigint_promotion(instr[2]) then
                  let label = x64_string_label_next()
                  sb_push(sb, label + ":" + x64_nl_char())
                  sb_push(sb, "    dq " + to_num(sc_len(str_intern(instr[2]))) + x64_nl_char())
                  sb_push(sb, "    db " + x64_bytes_of(instr[2]) + x64_nl_char())
                end
              end
            end
          end
        end
      end
      let i = i + 1
    end
    let fn_i = fn_i + 1
  end
  return sb_str(sb)
end

# ---- local-variable slot allocation ----

make a function called x64_local_index takes names, name returns idx
  let n = to_num(list_len(names))
  let i = 0
  while i < n do
    if names[i] == name then
      return i
    end
    let i = i + 1
  end
  return 0 - 1
end

# Params first (in order), then every OTHER name a Store instruction
# targets, first-seen order. Slot k lives at [rbp - 8*(k+1)].
make a function called x64_collect_locals takes func returns names
  let params = func[2]
  let instrs = func[3]
  let names = []
  let pn = to_num(list_len(params))
  let i = 0
  while i < pn do
    let names = list_push(names, params[i])
    let i = i + 1
  end
  let n = to_num(list_len(instrs))
  let i = 0
  while i < n do
    let instr = instrs[i]
    if instr[0] == "Store" then
      if x64_local_index(names, instr[1]) < 0 then
        let names = list_push(names, instr[1])
      end
    end
    let i = i + 1
  end
  return names
end

# ---- locals register allocation (Slice 8) ----
#
# Deliberately simple, provably-correct allocator: eligible locals each
# get a DEDICATED register for their WHOLE function lifetime -- no
# interval-based SHARING of one register between two different locals
# within a function (a real linear-scan allocator with spill-by-
# furthest-end would pack more locals into the same 3 registers, but
# adds real correctness risk -- a wrong overlap check silently corrupts
# the self-hosted compiler's own output -- for marginal gain given the
# pool is only 3 registers wide; named, deliberate scope limit).
#
# Eligibility is NOT just "first K locals" -- this backend's OWN calling
# convention gives NO register-preservation guarantee across a `call`
# (documented repeatedly elsewhere in this file, e.g. x64_callvalue_asm:
# "r12/r13/r14 are not guaranteed to survive the call"). That's true not
# only for calls to other PatLang functions (Call/CallValue) but for
# every OTHER instruction kind that embeds an internal call under this
# same convention: CallHost, BuildList/MakeClosure (both call
# rt_heap_alloc), and Bin in dynamic_mode (may call rt_bigint_from_i64
# etc). A local register-allocated across one of these would be
# silently clobbered by the callee's own use of that register --
# exactly the class of bug this whole freeing effort has been careful
# to avoid. So a local is only eligible if NONE of these call-boundary
# instruction kinds appear between the start of the function and its
# last use (conservative: scans from index 0, not from the local's own
# first def, so it may spill a few more locals than strictly necessary
# -- correctness over optimality, matching this session's established
# "over-estimate, never under-estimate" liveness approach).
make a function called x64_reg_pool returns names
  return ["rbx", "r13", "r14"]
end

# A handful of legal PatLang function names collide with reserved x86
# instruction mnemonics that NASM refuses to accept as a label even with
# a trailing colon (confirmed directly: `wait:` alone errors "instruction
# expected, found `:'"). `wait` surfaced this when Stage A of the
# interp.patlang-compilation roadmap (#25) added a `wait(pid)` function
# matching the real host's process-lifecycle name. Every place a
# PatLang function name becomes an asm label OR a `call`/`global`/
# `extern` target must route through this so the mangled name is used
# consistently everywhere that name appears.
make a function called x64_asm_label_for_func takes name returns label
  if name == "wait" then
    return "pw_wait"
  end
  return name
end

# ---- GitHub #29: per-instruction (not per-function) dynamic-mode
# classification ----
#
# x64_func_is_dynamic (below) flags an entire FUNCTION as dynamic the
# moment it contains a string literal or a tower-constructor call
# ANYWHERE in its body -- which then routed EVERY "Bin" instruction in
# that whole function through the slow tag-checking dynamic dispatch
# path (x64_binop_asm_dynamic), including totally unrelated plain-int
# ops (a loop counter's `i = i + 1` sitting next to one small string
# build). Measured directly via self_hosting/run_benchmarks.patlang:
# bench_string_ops and bench_bigint_arith both ran SLOWER on --x64 than
# the plain interpreter because of this, while bench_list_ops (no
# string/tower content anywhere) got an 80x win from the exact same
# native backend. Filed as GitHub #29.
#
# x64_analyze_dynamic_bins below computes, once per function, the
# actual SET of "Bin" instruction indices whose operand(s) could
# plausibly be a non-fixnum (String/BigInt/Rational/Complex/Interval/
# Object) at runtime -- only THOSE need the dynamic dispatch path.
# Every other "Bin" in the same function gets the plain native op it
# would if the function had no string/tower content at all.
#
# This is a stack-simulated TAINT analysis, not full type inference --
# consistent with this file's own existing scope limit (x64_func_is_
# dynamic's own comment already accepts an analogous blind spot: a
# function that only receives strings via parameters, with no literal
# or constructor of its own, isn't detected either way -- not solved
# here either). Since the IR is a flat stack machine, a virtual "taint
# stack" mirrors the real value stack through one linear pass:
#   Const "str"            -> push tainted; any other Const -> push clean
#   Load name               -> push locals_taint[name] (default clean)
#   Store name               -> pop, set locals_taint[name] to it
#   Bin op                   -> pop a, b; if EITHER tainted, record this
#                               instruction's own index; push (a or b)
#   Un op                    -> pass the one operand's taint straight
#                               through (never dynamic-dispatched today,
#                               not touched by this analysis)
#   Call/CallValue/CallHost/
#   BuildList/MakeClosure    -> pop N argument taints, push TAINTED
#                               unconditionally (conservative: unknown
#                               return type -- same blind spot x64_func_
#                               is_dynamic already has for arbitrary
#                               calls today, no regression, and doesn't
#                               affect either measured benchmark's real
#                               bottleneck: a plain loop counter that
#                               never touches a call result)
#   Return                    -> pop 1 (no push, function exits)
#   Jump                      -> no stack effect
#   JumpIfFalse                -> pop 1 (no push)
#   anything else (shouldn't happen -- this is the exact same
#   instruction set x64_emit_instr itself supports, see its own
#   "unsupported IR instruction" fallback) -> bail out; caller falls
#   back to marking the WHOLE function dynamic (today's exact
#   behavior), never trusting an incomplete analysis.
#
# LOOP FIXED POINT: a local reassigned inside a loop body can affect a
# taint read at the TOP of that same loop on the next iteration -- the
# exact same backward-jump subtlety already documented and fixed once
# for the register allocator's own liveness scan (see the "REAL BUG
# FOUND AND FIXED HERE" comment above x64_extend_across_loops). Taint
# only ever grows (monotonic: once tainted, always tainted), so
# re-running the whole linear pass against the accumulating locals-
# taint map is guaranteed to converge within at most (distinct local
# count) + 1 passes; capped at a generous fixed bound as a named safety
# valve -- if that's somehow hit without converging, fall back to
# marking the whole function dynamic rather than trust a non-converged
# result. Correctness over optimality, same philosophy as everywhere
# else in this file.

make a function called x64_taint_get takes map, name returns tainted
  let n = to_num(list_len(map))
  let i = 0
  while i < n do
    if map[i][0] == name then
      return map[i][1]
    end
    let i = i + 1
  end
  return false
end

make a function called x64_taint_set takes map, name, tainted returns out
  let n = to_num(list_len(map))
  let out = []
  let found = false
  let i = 0
  while i < n do
    if map[i][0] == name then
      let out = list_push(out, [name, tainted])
      let found = true
    else
      let out = list_push(out, map[i])
    end
    let i = i + 1
  end
  if not found then
    let out = list_push(out, [name, tainted])
  end
  return out
end

make a function called x64_taint_maps_equal takes m1, m2 returns yes
  let n = to_num(list_len(m2))
  let i = 0
  while i < n do
    let name = m2[i][0]
    if x64_taint_get(m1, name) != m2[i][1] then
      return false
    end
    let i = i + 1
  end
  return true
end

make a function called x64_all_bin_indices takes instrs returns indices
  let out = []
  let n = to_num(list_len(instrs))
  let i = 0
  while i < n do
    if instrs[i][0] == "Bin" then
      let out = list_push(out, i)
    end
    let i = i + 1
  end
  return out
end

# Virtual-stack push/pop over a plain PatLang list: reuses storage via
# list_set once the backing list is already long enough (from an
# earlier push at this same depth in an earlier iteration/pop-then-
# push cycle) instead of only ever growing -- otherwise a pop followed
# by a later push at the same depth would read stale data one slot
# further down. Returns [new_stack, new_sp] / [value, new_sp].
make a function called x64_vstack_push takes stack, sp, val returns pair
  if sp < to_num(list_len(stack)) then
    let stack = list_set(stack, sp, val)
  else
    let stack = list_push(stack, val)
  end
  return [stack, sp + 1]
end

make a function called x64_vstack_pop takes stack, sp returns pair
  return [stack[sp - 1], sp - 1]
end

# One linear taint-simulation pass over a whole function's flat instrs,
# given the current (possibly still-converging) locals taint map.
# Returns [new_map, dyn_bin_indices, bailed].
make a function called x64_taint_one_pass takes instrs, locals_taint returns result
  let n = to_num(list_len(instrs))
  let stack = []
  let sp = 0
  let map = locals_taint
  let dyn_bin_indices = []
  let bailed = false
  let i = 0
  while (i < n) and (not bailed) do
    let instr = instrs[i]
    let ty = instr[0]
    if ty == "Const" then
      let tainted = instr[1] == "str"
      let pr = x64_vstack_push(stack, sp, tainted)
      let stack = pr[0]
      let sp = pr[1]
    elif ty == "Load" then
      let pr = x64_vstack_push(stack, sp, x64_taint_get(map, instr[1]))
      let stack = pr[0]
      let sp = pr[1]
    elif ty == "Store" then
      let pr = x64_vstack_pop(stack, sp)
      let sp = pr[1]
      # Monotonic OR, not overwrite: a clean re-store must NOT erase
      # taint a loop-carried store elsewhere already proved possible for
      # this name (fixed-point convergence relies on this -- see the
      # loop-carried-taint case in x64_dynamic_bin_analysis_selftest.
      # patlang, GitHub #29). Safe over-approximation, same "taint only
      # grows" philosophy stated in this analysis's own header comment.
      let map = x64_taint_set(map, instr[1], x64_taint_get(map, instr[1]) or pr[0])
    elif ty == "Bin" then
      let pr1 = x64_vstack_pop(stack, sp)
      let sp = pr1[1]
      let pr2 = x64_vstack_pop(stack, sp)
      let sp = pr2[1]
      # Real gap found via direct testing (mirroring pat --ir-run's own
      # behavior, not inventing new semantics -- confirmed the real
      # interpreter genuinely auto-promotes `9223372036854775807 + 1`
      # to a true BigInt, while --x64 silently wrapped/corrupted the
      # same expression to garbage): +/-/* can ALWAYS overflow a plain
      # fixnum into BigInt, regardless of whether either OPERAND was
      # already known non-fixnum -- unlike every other Bin op (==, <,
      # etc), where a clean-input result genuinely stays clean, the
      # *arithmetic itself* is the taint source here, not just its
      # inputs. x64_binop_asm_dynamic already implements the correct
      # overflow-check-then-promote sequence in full (a fast-path
      # register-mask test, `jo` on the real op, and a call to the
      # matching rt_bigint_* function on overflow) -- it just was never
      # being REACHED for two already-clean fixnum operands, since nothing
      # upstream ever tainted them. So: unconditionally treat these three
      # ops as both a dynamic-dispatch SITE and a taint SOURCE for their
      # own result, rather than only forwarding existing input taint.
      # This does mean more Bins take the (cheap: one register-mask
      # check plus a predictable-not-taken branch) dynamic path than
      # before -- an accepted, deliberate cost for genuine correctness,
      # not a "test on every access" tax (only arithmetic operations
      # themselves pay it, not every subsequent load/use of a value).
      # GitHub #53: `/` joins +/-/* here for the same reason -- it can
      # ALWAYS need to promote to Rational on inexact division,
      # regardless of whether either operand was already known
      # non-fixnum (confirmed against the real interpreter's own
      # semantics: `pat --ir-run` auto-promotes `7 / 2` on two bare int
      # literals, no numeric-tower operand in sight). Safe now that
      # every internal x64_runtime.patlang caller needing genuine
      # truncating division uses the dedicated rt_trunc_div primitive
      # instead of the "/" operator (a `Call`, not a `Bin`, so it's
      # untouched by this taint analysis).
      let op_can_overflow = (instr[1] == "+") or (instr[1] == "-") or (instr[1] == "*") or (instr[1] == "/")
      let result_taint = pr1[0] or pr2[0] or op_can_overflow
      if result_taint then
        let dyn_bin_indices = list_push(dyn_bin_indices, i)
      end
      let pr3 = x64_vstack_push(stack, sp, result_taint)
      let stack = pr3[0]
      let sp = pr3[1]
    elif ty == "Un" then
      let pr = x64_vstack_pop(stack, sp)
      let sp = pr[1]
      let pr2 = x64_vstack_push(stack, sp, pr[0])
      let stack = pr2[0]
      let sp = pr2[1]
    elif ty == "Jump" then
      let sp = sp
    elif ty == "JumpIfFalse" then
      let pr = x64_vstack_pop(stack, sp)
      let sp = pr[1]
    elif ty == "Return" then
      let pr = x64_vstack_pop(stack, sp)
      let sp = pr[1]
    elif ty == "CallHost" then
      let argc = to_num(instr[2])
      let k = 0
      while k < argc do
        let pr = x64_vstack_pop(stack, sp)
        let sp = pr[1]
        let k = k + 1
      end
      let pr2 = x64_vstack_push(stack, sp, true)
      let stack = pr2[0]
      let sp = pr2[1]
    elif ty == "Call" then
      let argc = to_num(instr[2])
      let k = 0
      while k < argc do
        let pr = x64_vstack_pop(stack, sp)
        let sp = pr[1]
        let k = k + 1
      end
      let pr2 = x64_vstack_push(stack, sp, true)
      let stack = pr2[0]
      let sp = pr2[1]
    elif ty == "BuildList" then
      let argc = to_num(instr[1])
      let k = 0
      while k < argc do
        let pr = x64_vstack_pop(stack, sp)
        let sp = pr[1]
        let k = k + 1
      end
      let pr2 = x64_vstack_push(stack, sp, true)
      let stack = pr2[0]
      let sp = pr2[1]
    elif ty == "MakeClosure" then
      let argc = to_num(list_len(instr[2]))
      let k = 0
      while k < argc do
        let pr = x64_vstack_pop(stack, sp)
        let sp = pr[1]
        let k = k + 1
      end
      let pr2 = x64_vstack_push(stack, sp, true)
      let stack = pr2[0]
      let sp = pr2[1]
    elif ty == "CallValue" then
      let argc = to_num(instr[1]) + 1
      let k = 0
      while k < argc do
        let pr = x64_vstack_pop(stack, sp)
        let sp = pr[1]
        let k = k + 1
      end
      let pr2 = x64_vstack_push(stack, sp, true)
      let stack = pr2[0]
      let sp = pr2[1]
    else
      let bailed = true
    end
    let i = i + 1
  end
  return [map, dyn_bin_indices, bailed]
end

make a function called x64_analyze_dynamic_bins takes instrs returns dyn_bin_indices
  let n = to_num(list_len(instrs))
  let max_passes = n + 10
  let map = []
  let dyn_bin_indices = []
  let pass = 0
  let bailed = false
  let stable = false
  while (pass < max_passes) and (not stable) and (not bailed) do
    let result = x64_taint_one_pass(instrs, map)
    let new_map = result[0]
    let dyn_bin_indices = result[1]
    let bailed = result[2]
    if x64_taint_maps_equal(map, new_map) then
      let stable = true
    end
    let map = new_map
    let pass = pass + 1
  end
  if bailed then
    return x64_all_bin_indices(instrs)
  end
  if not stable then
    return x64_all_bin_indices(instrs)
  end
  return dyn_bin_indices
end

# GitHub #37: replaces the old whole-FUNCTION float_mode boolean
# (x64_func_is_float) with genuine per-INSTRUCTION classification, the
# same architectural move already made for BigInt dynamic-dispatch
# (#29) and reusing the identical taint-analysis machinery
# (x64_vstack_push/pop, x64_taint_get/set, x64_taint_maps_equal) --
# see x64_analyze_dynamic_bins's own header for the established
# pattern this mirrors.
#
# THE BUG THIS FIXES: mixing a bare float literal with a bare int
# literal (or plain-int arithmetic) in the SAME function silently
# corrupted the int value whenever it crossed a call boundary --
# confirmed directly: `let places = 0; let places = places + 10;
# run(sqrt(2.0), places)` produced garbage, because the WHOLE
# function was classified float_mode purely for containing
# `sqrt(2.0)`, and `x64_binop_asm_float` was blindly applied to
# `places + 10` too, treating both raw ints as SSE2 float bit
# patterns. #18's own `x64_call_arg_int_overrides` only rescued a
# bare literal used DIRECTLY as a Call argument -- it couldn't help
# an arithmetic expression like `places + 10`, since THAT requires
# the Bin instruction ITSELF to be classified correctly, not just the
# literal's encoding.
#
# TWO-STAGE DESIGN:
# Stage 1 (x64_taint_one_pass_float/x64_analyze_float_bins) computes,
# via the SAME fixed-point forward taint propagation as the BigInt
# pass, which specific Bin/Un instructions actually combine a
# known-float value (a dotted literal, or the result of a known
# float-returning call) -- NOT "does this function contain a float
# literal ANYWHERE" but "does THIS SPECIFIC instruction's own operand
# chain ever touch one". A local variable's own taint is the OR of
# every value ever Stored into it (monotonic, loop-carried, identical
# reasoning to the BigInt pass's Store handling) -- `places` above is
# NEVER assigned from a float-tainted value anywhere, so its `+ 10`
# correctly stays plain-int arithmetic even though `sqrt(2.0)` lives
# in the same function.
#
# Stage 2 (x64_analyze_float_consts) answers the complementary
# question stage 1 can't: which specific bare, DOTLESS "Const num"
# instructions must be RE-ENCODED as a float bit pattern (rather than
# a plain int), because their own value is later consumed by an
# instruction stage 1 proved float. This needs its own pass (not just
# stage 1's forward taint) because a Const's own encoding decision
# depends on FUTURE use, not just its own literal text -- e.g. in
# `sqrt(2.0) + 5`, the bare `5` must be encoded as 5.0's bit pattern
# the moment it's pushed, which stage 1 alone can't tell it (stage 1
# only determines the RESULT of combining it is float, not that the
# literal itself needs re-encoding before that combination happens).
# Scoped to the two realistic patterns this session's own bugs
# actually hit: (a) a bare literal used DIRECTLY as one operand of a
# Bin/Un stage 1 already proved float, and (b) a bare literal
# immediately preceding a `Store x` where x's OWN final taint (from
# stage 1) is float -- i.e. `let x = 5` followed eventually by `x`
# meeting a real float somewhere. Does NOT trace origin through
# arbitrary multi-hop chains (`let x = 5; let y = x; y + 2.0` doesn't
# need it: y has no literal of its own to mark, and x's OWN Store
# already gets caught by rule (b) since x's final taint is float
# regardless of how far downstream that gets discovered) -- covers
# the common, realistic cases without a full general-dataflow origin
# tracker, matching this file's own established "named scope limit,
# not an oversight" convention.
make a function called x64_float_producing_host_names returns names
  return ["sqrt", "sin", "cos", "tan", "asin", "acos", "atan", "atan2", "log", "exp", "pow", "fabs"]
end

make a function called x64_taint_one_pass_float takes instrs, locals_taint, float_func_names returns result
  let n = to_num(list_len(instrs))
  let stack = []
  let sp = 0
  let map = locals_taint
  let float_instr_indices = []
  let produces_float = []
  let bailed = false
  let i = 0
  while i < n do
    let produces_float = list_push(produces_float, false)
    let i = i + 1
  end
  let i = 0
  while (i < n) and (not bailed) do
    let instr = instrs[i]
    let ty = instr[0]
    if ty == "Const" then
      let tainted = false
      if instr[1] == "num" then
        let tainted = x64_contains(instr[2], ".")
      end
      let produces_float = list_set(produces_float, i, tainted)
      let pr = x64_vstack_push(stack, sp, tainted)
      let stack = pr[0]
      let sp = pr[1]
    elif ty == "Load" then
      let tainted = x64_taint_get(map, instr[1])
      let produces_float = list_set(produces_float, i, tainted)
      let pr = x64_vstack_push(stack, sp, tainted)
      let stack = pr[0]
      let sp = pr[1]
    elif ty == "Store" then
      let pr = x64_vstack_pop(stack, sp)
      let sp = pr[1]
      let map = x64_taint_set(map, instr[1], x64_taint_get(map, instr[1]) or pr[0])
    elif ty == "Bin" then
      let pr1 = x64_vstack_pop(stack, sp)
      let sp = pr1[1]
      let pr2 = x64_vstack_pop(stack, sp)
      let sp = pr2[1]
      let result_taint = pr1[0] or pr2[0]
      if result_taint then
        let float_instr_indices = list_push(float_instr_indices, i)
      end
      let produces_float = list_set(produces_float, i, result_taint)
      let pr3 = x64_vstack_push(stack, sp, result_taint)
      let stack = pr3[0]
      let sp = pr3[1]
    elif ty == "Un" then
      let pr = x64_vstack_pop(stack, sp)
      let sp = pr[1]
      if pr[0] then
        let float_instr_indices = list_push(float_instr_indices, i)
      end
      let produces_float = list_set(produces_float, i, pr[0])
      let pr2 = x64_vstack_push(stack, sp, pr[0])
      let stack = pr2[0]
      let sp = pr2[1]
    elif ty == "Jump" then
      let sp = sp
    elif ty == "JumpIfFalse" then
      let pr = x64_vstack_pop(stack, sp)
      let sp = pr[1]
    elif ty == "Return" then
      let pr = x64_vstack_pop(stack, sp)
      let sp = pr[1]
    elif ty == "CallHost" then
      let argc = to_num(instr[2])
      let last_arg_taint = false
      let k = 0
      while k < argc do
        let pr = x64_vstack_pop(stack, sp)
        let sp = pr[1]
        let last_arg_taint = pr[0]
        let k = k + 1
      end
      # abs/ceil/round/trunc are runtime-adaptive (x64_abs_asm/
      # x64_roundlike_asm both check the ACTUAL value at runtime: an
      # int argument passes through unchanged, only a genuine float
      # gets the real float instruction) -- their result classification
      # must follow their OWN argument's taint, not a fixed answer.
      # Real bug found testing this fix: hardcoding these as
      # "always float" broke x64_math_abs_int_selftest's whole point
      # (abs of a plain int argument, which must stay plain int).
      let is_float_result = last_arg_taint
      if instr[1] != "abs" then
        if instr[1] != "ceil" then
          if instr[1] != "round" then
            if instr[1] != "trunc" then
              let is_float_result = x64_str_in_list(x64_float_producing_host_names(), instr[1])
            end
          end
        end
      end
      let produces_float = list_set(produces_float, i, is_float_result)
      let pr2 = x64_vstack_push(stack, sp, is_float_result)
      let stack = pr2[0]
      let sp = pr2[1]
    elif ty == "Call" then
      let argc = to_num(instr[2])
      let k = 0
      while k < argc do
        let pr = x64_vstack_pop(stack, sp)
        let sp = pr[1]
        let k = k + 1
      end
      let is_float_result = x64_str_in_list(float_func_names, instr[1])
      let produces_float = list_set(produces_float, i, is_float_result)
      let pr2 = x64_vstack_push(stack, sp, is_float_result)
      let stack = pr2[0]
      let sp = pr2[1]
    elif ty == "BuildList" then
      let argc = to_num(instr[1])
      let k = 0
      while k < argc do
        let pr = x64_vstack_pop(stack, sp)
        let sp = pr[1]
        let k = k + 1
      end
      let pr2 = x64_vstack_push(stack, sp, false)
      let stack = pr2[0]
      let sp = pr2[1]
    elif ty == "MakeClosure" then
      let argc = to_num(list_len(instr[2]))
      let k = 0
      while k < argc do
        let pr = x64_vstack_pop(stack, sp)
        let sp = pr[1]
        let k = k + 1
      end
      let pr2 = x64_vstack_push(stack, sp, false)
      let stack = pr2[0]
      let sp = pr2[1]
    elif ty == "CallValue" then
      let argc = to_num(instr[1]) + 1
      let k = 0
      while k < argc do
        let pr = x64_vstack_pop(stack, sp)
        let sp = pr[1]
        let k = k + 1
      end
      let pr2 = x64_vstack_push(stack, sp, false)
      let stack = pr2[0]
      let sp = pr2[1]
    else
      let bailed = true
    end
    let i = i + 1
  end
  return [map, float_instr_indices, produces_float, bailed]
end

# Stage 1 wrapper (fixed-point loop), mirroring x64_analyze_dynamic_bins
# exactly. On bail (an instruction type this pass doesn't recognize --
# should be rare), falls back to the OLD whole-function behavior
# (every Bin/Un floats, matching legacy x64_func_is_float semantics)
# rather than silently under-classifying.
make a function called x64_analyze_float_bins takes instrs, float_func_names returns result
  let n = to_num(list_len(instrs))
  let max_passes = n + 10
  let map = []
  let float_instr_indices = []
  let produces_float = []
  let pass = 0
  let bailed = false
  let stable = false
  while (pass < max_passes) and (not stable) and (not bailed) do
    let result = x64_taint_one_pass_float(instrs, map, float_func_names)
    let new_map = result[0]
    let float_instr_indices = result[1]
    let produces_float = result[2]
    let bailed = result[3]
    if x64_taint_maps_equal(map, new_map) then
      let stable = true
    end
    let map = new_map
    let pass = pass + 1
  end
  if bailed then
    let float_instr_indices = x64_all_bin_indices(instrs)
    let produces_float = []
    let i = 0
    while i < n do
      let produces_float = list_push(produces_float, true)
      let i = i + 1
    end
  end
  return [float_instr_indices, produces_float, map]
end

# Stage 2: which bare dotless "Const num" instructions must be
# re-encoded as a float bit pattern. See this section's own header
# comment above for the two rules implemented (direct Bin/Un operand;
# immediately-preceding a Store into an eventually-float local).
make a function called x64_analyze_float_consts takes instrs, final_map, float_instr_indices returns float_const_indices
  let n = to_num(list_len(instrs))
  let out = []
  let stack = []
  let sp = 0
  let i = 0
  while i < n do
    let instr = instrs[i]
    let ty = instr[0]
    if ty == "Const" then
      let origin = 0 - 1
      if instr[1] == "num" then
        if not x64_contains(instr[2], ".") then
          let origin = i
        end
      end
      let pr = x64_vstack_push(stack, sp, origin)
      let stack = pr[0]
      let sp = pr[1]
    elif ty == "Load" then
      let pr = x64_vstack_push(stack, sp, 0 - 1)
      let stack = pr[0]
      let sp = pr[1]
    elif ty == "Store" then
      let pr = x64_vstack_pop(stack, sp)
      let sp = pr[1]
      if pr[0] >= 0 then
        if x64_taint_get(final_map, instr[1]) then
          let out = list_push(out, pr[0])
        end
      end
    elif ty == "Bin" then
      let pr1 = x64_vstack_pop(stack, sp)
      let sp = pr1[1]
      let pr2 = x64_vstack_pop(stack, sp)
      let sp = pr2[1]
      if x64_str_in_list(float_instr_indices, i) then
        if pr1[0] >= 0 then
          let out = list_push(out, pr1[0])
        end
        if pr2[0] >= 0 then
          let out = list_push(out, pr2[0])
        end
      end
      let pr3 = x64_vstack_push(stack, sp, 0 - 1)
      let stack = pr3[0]
      let sp = pr3[1]
    elif ty == "Un" then
      let pr = x64_vstack_pop(stack, sp)
      let sp = pr[1]
      if x64_str_in_list(float_instr_indices, i) then
        if pr[0] >= 0 then
          let out = list_push(out, pr[0])
        end
      end
      let pr2 = x64_vstack_push(stack, sp, 0 - 1)
      let stack = pr2[0]
      let sp = pr2[1]
    elif ty == "Jump" then
      let sp = sp
    elif ty == "JumpIfFalse" then
      let pr = x64_vstack_pop(stack, sp)
      let sp = pr[1]
    elif ty == "Return" then
      let pr = x64_vstack_pop(stack, sp)
      let sp = pr[1]
    elif ty == "CallHost" then
      let argc = to_num(instr[2])
      let k = 0
      while k < argc do
        let pr = x64_vstack_pop(stack, sp)
        let sp = pr[1]
        let k = k + 1
      end
      let pr2 = x64_vstack_push(stack, sp, 0 - 1)
      let stack = pr2[0]
      let sp = pr2[1]
    elif ty == "Call" then
      let argc = to_num(instr[2])
      let k = 0
      while k < argc do
        let pr = x64_vstack_pop(stack, sp)
        let sp = pr[1]
        let k = k + 1
      end
      let pr2 = x64_vstack_push(stack, sp, 0 - 1)
      let stack = pr2[0]
      let sp = pr2[1]
    elif ty == "BuildList" then
      let argc = to_num(instr[1])
      let k = 0
      while k < argc do
        let pr = x64_vstack_pop(stack, sp)
        let sp = pr[1]
        let k = k + 1
      end
      let pr2 = x64_vstack_push(stack, sp, 0 - 1)
      let stack = pr2[0]
      let sp = pr2[1]
    elif ty == "MakeClosure" then
      let argc = to_num(list_len(instr[2]))
      let k = 0
      while k < argc do
        let pr = x64_vstack_pop(stack, sp)
        let sp = pr[1]
        let k = k + 1
      end
      let pr2 = x64_vstack_push(stack, sp, 0 - 1)
      let stack = pr2[0]
      let sp = pr2[1]
    elif ty == "CallValue" then
      let argc = to_num(instr[1]) + 1
      let k = 0
      while k < argc do
        let pr = x64_vstack_pop(stack, sp)
        let sp = pr[1]
        let k = k + 1
      end
      let pr2 = x64_vstack_push(stack, sp, 0 - 1)
      let stack = pr2[0]
      let sp = pr2[1]
    end
    let i = i + 1
  end
  return out
end

make a function called x64_instr_is_call_boundary takes instr, idx, dyn_bin_indices returns is_call
  let ty = instr[0]
  if ty == "Call" then
    return true
  end
  if ty == "CallValue" then
    return true
  end
  if ty == "CallHost" then
    return true
  end
  if ty == "BuildList" then
    return true
  end
  if ty == "MakeClosure" then
    return true
  end
  if ty == "Bin" then
    if x64_is_jump_target(dyn_bin_indices, idx) then
      return true
    end
    # REAL BUG FOUND AND FIXED HERE (2026-07-20, same session as the
    # `+`/`==` string-aware codegen fixes): x64_str_aware_eq_asm and
    # x64_str_aware_plus_asm can embed a REAL `call rt_str_eq`/`call
    # rt_str_concat` even in a NON-dynamic-mode function (whenever an
    # operand turns out to be a String at runtime) -- but this
    # function is exactly what the register allocator (see
    # x64_local_register_eligible below) uses to decide whether a
    # local can safely live in a register across a given instruction.
    # Before this fix, "Bin" was only a call boundary in dynamic_mode,
    # so a NON-dynamic function's `+`/`==`/`!=` on strings could
    # register-allocate a local straight across the embedded call,
    # which then silently clobbers it (this backend gives ZERO
    # register preservation across any call). Caught by the
    # x64_exec_demo/x64_exec_bigoutput_demo/x64_exec_nasm_demo
    # regression going from PASS to segfault the moment `+` started
    # doing real string concatenation -- rt_exec_join_args (called by
    # exec_capture) builds its joined command line with `+` on
    # strings, and a caller-side local was register-allocated across
    # that call without this fix. (GitHub #29: this carve-out stays
    # regardless of dyn_bin_indices, since it's about a call embedded
    # in the NON-dynamic string-aware codegen path itself, not about
    # whether the op was classified dynamic.)
    let op = instr[1]
    if op == "+" then
      return true
    end
    if op == "==" then
      return true
    end
    if op == "!=" then
      return true
    end
  end
  return false
end


# REAL BUG FOUND AND FIXED HERE (2026-07-20, discovered implementing
# argv() -- confirmed via a minimal repro before this fix, not just
# argv()'s own complexity): a value read at the TOP of a loop is only
# ONE occurrence in the flat instruction array (reused every iteration
# via the loop's own backward jump), so its "last use" INDEX can sit
# BEFORE a call-boundary instruction that appears LATER in that same
# loop body -- even though, at RUNTIME, that value must survive from
# one iteration's read to the next, spanning the call every single
# time the loop repeats. The original "scan 0..last" design silently
# missed this: a local like a loop-invariant bound variable (read only
# at the top of a `while` condition, with a call somewhere in the body)
# was wrongly judged call-free and register-allocated, then silently
# corrupted the first time the loop's own call clobbered its register.
# NONE of this session's demo regression suite happened to exercise
# this exact shape (a loop-condition variable + a call later in the
# same loop body) -- caught only by argv()'s own quote-aware tokenizer,
# which does exactly that (the outer `while i < len` condition reads
# `len`, and the loop body calls `char_code`/`rt_is_space`).
#
# Fix: before scanning for call-boundaries, extend a local's effective
# "last used" index to cover the full body of any loop (backward jump,
# Jump or JumpIfFalse with target <= its own index) that its raw last
# use falls inside -- to a fixed point, so nested loops extend
# correctly too.
make a function called x64_extend_across_loops takes instrs, last returns effective
  let n = to_num(list_len(instrs))
  let effective = last
  let changed = true
  while changed do
    let changed = false
    let j = 0
    while j < n do
      let instr = instrs[j]
      let is_edge = false
      if instr[0] == "Jump" then
        let is_edge = true
      end
      if instr[0] == "JumpIfFalse" then
        let is_edge = true
      end
      if is_edge then
        let target = to_num(instr[1])
        if target <= j then
          if effective >= target then
            if effective < j then
              let effective = j
              let changed = true
            end
          end
        end
      end
      let j = j + 1
    end
  end
  return effective
end

make a function called x64_local_register_eligible takes instrs, name, dyn_bin_indices returns ok
  let n = to_num(list_len(instrs))
  let last = 0 - 1
  let i = 0
  while i < n do
    let instr = instrs[i]
    if instr[0] == "Load" then
      if instr[1] == name then
        let last = i
      end
    else
      if instr[0] == "Store" then
        if instr[1] == name then
          let last = i
        end
      end
    end
    let i = i + 1
  end
  if last < 0 then
    return true
  end
  let last = x64_extend_across_loops(instrs, last)
  let i = 0
  while i <= last do
    if x64_instr_is_call_boundary(instrs[i], i, dyn_bin_indices) then
      return false
    end
    let i = i + 1
  end
  return true
end

# Register-assigned locals, in `locals`' own order, capped at the pool
# size -- parallel to x64_reg_pool()'s own order (regmap[0] gets rbx,
# regmap[1] gets r13, regmap[2] gets r14).
make a function called x64_build_regmap takes locals, instrs, dyn_bin_indices returns names
  let pool = x64_reg_pool()
  let cap = to_num(list_len(pool))
  let n = to_num(list_len(locals))
  let out = []
  let i = 0
  while i < n do
    if to_num(list_len(out)) < cap then
      let name = locals[i]
      if x64_local_register_eligible(instrs, name, dyn_bin_indices) then
        let out = list_push(out, name)
      end
    end
    let i = i + 1
  end
  return out
end

make a function called x64_reg_for_name takes regmap, name returns reg
  let idx = x64_local_index(regmap, name)
  if idx < 0 then
    return ""
  end
  let pool = x64_reg_pool()
  return pool[idx]
end

# Every local NOT in regmap still needs a stack slot, renumbered among
# themselves (own order, not original index in `locals`) so the frame
# doesn't waste space reserving slots for register-resident locals.
make a function called x64_spilled_locals takes locals, regmap returns names
  let n = to_num(list_len(locals))
  let out = []
  let i = 0
  while i < n do
    let name = locals[i]
    if x64_local_index(regmap, name) < 0 then
      let out = list_push(out, name)
    end
    let i = i + 1
  end
  return out
end

# ---- one instruction -> nasm text ----

# Float variant (Slice 7): operand bits already sit in plain GP
# registers (same push/pop discipline as everywhere else in this
# backend -- see this file's own header), shuttled into XMM registers
# via `movq` only for the actual SSE2 arithmetic/comparison, then back.
# ucomisd's flags are the UNSIGNED integer condition codes (setb/setbe/
# seta/setae for </<=/>/>=, NOT setl/setle/setg/setge) -- a genuine,
# easy-to-get-wrong difference from the integer comparison path, called
# out explicitly here rather than silently copy-pasted wrong.
# Real bug found while exercising the float/int-mixed-in-one-function
# case: a bare integer Const (e.g. a plain `0` argument at a call site)
# living in a function this backend has otherwise classified as
# float_mode (see this file's own header on the ALL-int-or-ALL-float
# per-function scoping) still gets routed through __float64__(...) --
# and NASM's __float64__ macro requires actual floating-point syntax
# (a decimal point), rejecting bare "0"/"5" with "expecting floating-
# point number" and cascading into a wall of unrelated-looking parse
# errors on every later line, exactly the failure mode already fixed
# once for missing trailing newlines (see the UNSUPPORTED_*_ERROR
# comments elsewhere in this file). Ensures the literal text always
# has a decimal point before handing it to __float64__, so an integer
# constant in a float-mode function still assembles (as the float
# value it's being treated as, consistent with this slice's documented
# all-or-nothing per-function typing) instead of hard-failing NASM.
make a function called x64_float_literal_text takes text returns out
  let i = 0
  let n = text.length
  while i < n do
    if substr(text, i, 1) == "." then
      return text
    end
    let i = i + 1
  end
  return text + ".0"
end

make a function called x64_binop_asm_float takes op returns asm
  let sb = sb_new()
  sb_push(sb, "    pop r10" + x64_nl_char())
  sb_push(sb, "    pop rax" + x64_nl_char())
  sb_push(sb, "    movq xmm0, rax" + x64_nl_char())
  sb_push(sb, "    movq xmm1, r10" + x64_nl_char())
  if op == "+" then
    sb_push(sb, "    addsd xmm0, xmm1" + x64_nl_char())
    sb_push(sb, "    movq rax, xmm0" + x64_nl_char())
  else
    if op == "-" then
      sb_push(sb, "    subsd xmm0, xmm1" + x64_nl_char())
      sb_push(sb, "    movq rax, xmm0" + x64_nl_char())
    else
      if op == "*" then
        sb_push(sb, "    mulsd xmm0, xmm1" + x64_nl_char())
        sb_push(sb, "    movq rax, xmm0" + x64_nl_char())
      else
        if op == "/" then
          sb_push(sb, "    divsd xmm0, xmm1" + x64_nl_char())
          sb_push(sb, "    movq rax, xmm0" + x64_nl_char())
        else
          if op == "%" then
            # fmod via truncated division, matching C's fmod / this
            # backend's own truncate-toward-zero integer % semantics:
            # xmm2 keeps the original numerator since xmm0 gets
            # overwritten by the quotient below.
            sb_push(sb, "    movq xmm2, xmm0" + x64_nl_char())
            sb_push(sb, "    divsd xmm0, xmm1" + x64_nl_char())
            sb_push(sb, "    cvttsd2si rax, xmm0" + x64_nl_char())
            sb_push(sb, "    cvtsi2sd xmm0, rax" + x64_nl_char())
            sb_push(sb, "    mulsd xmm0, xmm1" + x64_nl_char())
            sb_push(sb, "    subsd xmm2, xmm0" + x64_nl_char())
            sb_push(sb, "    movq rax, xmm2" + x64_nl_char())
          else
          sb_push(sb, "    ucomisd xmm0, xmm1" + x64_nl_char())
          if op == "==" then
            sb_push(sb, "    sete al" + x64_nl_char())
          else
            if op == "!=" then
              sb_push(sb, "    setne al" + x64_nl_char())
            else
              if op == "<" then
                sb_push(sb, "    setb al" + x64_nl_char())
              else
                if op == "<=" then
                  sb_push(sb, "    setbe al" + x64_nl_char())
                else
                  if op == ">" then
                    sb_push(sb, "    seta al" + x64_nl_char())
                  else
                    if op == ">=" then
                      sb_push(sb, "    setae al" + x64_nl_char())
                    else
                      print("codegen_x64: unsupported float binary operator: " + op)
                      return "    ; UNSUPPORTED_BINOP_ERROR" + x64_nl_char()
                    end
                  end
                end
              end
            end
          end
          sb_push(sb, "    movzx rax, al" + x64_nl_char())
          # GitHub #24: same Bool-tagging as x64_binop_asm's own
          # comparison branches (see its header) -- op is always a
          # comparison here (this is the ucomisd/setcc branch, reached
          # only when none of +/-/*//,% matched above), so no extra
          # gate is needed.
          sb_push(sb, "    mov r10, 6917529027641081856" + x64_nl_char())
          sb_push(sb, "    or rax, r10" + x64_nl_char())
          end
        end
      end
    end
  end
  sb_push(sb, "    push rax" + x64_nl_char())
  return sb_str(sb)
end

