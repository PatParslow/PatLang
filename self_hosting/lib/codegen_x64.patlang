                    # mode function -- only correct if that operand is
                    # actually a fixnum. See x64_runtime.patlang's header.
                    sb_push(sb, x64_binop_asm(instr[1]))
                  end
                end
              end
            else
              sb_push(sb, x64_binop_asm(instr[1]))
            end
          end
        else
          if ty == "Un" then
            # Matches codegen.patlang's own three-way Un dispatch
            # (UnOpKind::Not/BitNot/Neg) exactly -- "not" is boolean
            # logical not (any nonzero -> 0, zero -> 1, not a bitwise
            # complement), "bnot" is the real bitwise complement, and
            # anything else (this IR only ever produces "-" here) is
            # arithmetic negation. Never dynamic-dispatched -- no
            # existing code path does that for Un either.
            sb_push(sb, "    pop rax" + x64_nl_char())
            if instr[1] == "not" then
              sb_push(sb, "    cmp rax, 0" + x64_nl_char())
              sb_push(sb, "    sete al" + x64_nl_char())
              sb_push(sb, "    movzx rax, al" + x64_nl_char())
            else
              if instr[1] == "bnot" then
                sb_push(sb, "    not rax" + x64_nl_char())
              else
                if float_mode then
                  # Real bug found alongside the modulo/float-literal
                  # fixes: `neg` is a two's-complement INTEGER negation
                  # on the raw 64-bit register -- applied to a double's
                  # raw bit pattern, this is NOT a sign flip in general
                  # (the NOT+1 carry chain can propagate into the
                  # exponent field), e.g. -1.5's bit pattern
                  # (0x3FF8000000000000) two's-complement-negates to
                  # 0xC008000000000000, which is -3.0, not -1.5 --
                  # silently wrong by exactly 2x for this literal, not
                  # a crash, so easy to miss without a direct
                  # arithmetic check. Correct float negation only
                  # toggles the sign bit (bit 63), done here as a plain
                  # GPR XOR against the sign mask -- no SSE round-trip
                  # needed since the value's bits are already sitting
                  # in rax.
                  sb_push(sb, "    mov r10, 9223372036854775808" + x64_nl_char())
                  sb_push(sb, "    xor rax, r10" + x64_nl_char())
                else
                  sb_push(sb, "    neg rax" + x64_nl_char())
                end
              end
            end
            sb_push(sb, "    push rax" + x64_nl_char())
          else
          if ty == "Jump" then
            sb_push(sb, "    jmp L_" + func_name + "_" + instr[1] + x64_nl_char())
          else
            if ty == "JumpIfFalse" then
              sb_push(sb, "    pop rax" + x64_nl_char())
              sb_push(sb, "    cmp rax, 0" + x64_nl_char())
              sb_push(sb, "    je L_" + func_name + "_" + instr[1] + x64_nl_char())
            else
              if ty == "CallHost" then
                sb_push(sb, x64_callhost_asm(instr[1], instr[2]))
              else
                if ty == "Call" then
                  if bool_print_override then
                    sb_push(sb, "    call rt_print_bool" + x64_nl_char())
                  else
                    if float_print_override then
                      sb_push(sb, "    call rt_print_float" + x64_nl_char())
                    else
                      sb_push(sb, "    call " + instr[1] + x64_nl_char())
                    end
                  end
                  let argc = to_num(instr[2])
                  if argc > 0 then
                    sb_push(sb, "    add rsp, " + (argc * 8) + x64_nl_char())
                  end
                  sb_push(sb, "    push rax" + x64_nl_char())
                else
                  if ty == "BuildList" then
                    sb_push(sb, x64_buildlist_asm(instr[1]))
                  else
                  if ty == "MakeClosure" then
                    sb_push(sb, x64_makeclosure_asm(instr[1], instr[2]))
                  else
                  if ty == "CallValue" then
                    sb_push(sb, x64_callvalue_asm(instr[1], spilled))
                  else
                  if ty == "Return" then
                    if func_name == "main" then
                      sb_push(sb, "    mov r15, rsp" + x64_nl_char())
                      sb_push(sb, "    sub rsp, 32" + x64_nl_char())
                      sb_push(sb, "    and rsp, -16" + x64_nl_char())
                      sb_push(sb, "    mov rcx, 0" + x64_nl_char())
                      sb_push(sb, "    call ExitProcess" + x64_nl_char())
                    else
                      sb_push(sb, "    pop rax" + x64_nl_char())
                      sb_push(sb, "    leave" + x64_nl_char())
                      sb_push(sb, "    ret" + x64_nl_char())
                    end
                  else
                    print("codegen_x64: unsupported IR instruction for Slice 1: " + ty)
                    # Real bug found and fixed here during the patc1
                    # self-compile fixpoint attempt (the actual root
                    # cause behind a wall of confusing "label changed
                    # during code generation" / "symbol not defined"
                    # NASM errors, not a NASM quirk at all): `sb`
                    # already has THIS instruction's own required
                    # label pushed to it at the top of this function
                    # (`label + ":"`) -- a bare `return "..."` here
                    # DISCARDS that already-built sb content entirely,
                    # silently dropping the label for this specific
                    # instruction index. Any OTHER instruction whose
                    # jump target points at this exact index (a very
                    # real case for any Un-instruction inside an
                    # if/while condition, e.g. `not`/unary `-` in a
                    # loop guard) then references a label that was
                    # simply never emitted. Fixed by pushing the error
                    # text into `sb` and returning `sb_str(sb)`
                    # instead, so the label survives.
                    sb_push(sb, "    ; UNSUPPORTED_INSTR_ERROR" + x64_nl_char())
                    return sb_str(sb)
                  end
                  end
                  end
                  end
                end
              end
            end
          end
          end
        end
      end
    end
  end
  return sb_str(sb)
end

# ---- one function -> nasm text ----

# ---- Slice 6: a narrowly, safely scoped register-usage win ----
#
# NOT a general register allocator -- that needs real liveness
# analysis with control-flow-merge-point consistency, a much larger
# and riskier undertaking. Instead: recognize the single most common
# wasteful pattern, `Const num` immediately followed by `Bin op`
# (loop counters, comparisons against a fixed bound -- `i + 1`,
# `i < 10`, extremely common in real code), and collapse the
# push-then-pop round-trip into ONE instruction using the constant as
# an immediate operand, which x86 supports directly for add/sub/imul/
# cmp. `/` and `%` are excluded -- `idiv` has no immediate-operand
# form, so fusing them would need to load the constant into a register
# first anyway, defeating the point.
#
# SAFETY: this is only correct if nothing can jump directly into the
# MIDDLE of the fused pair (skipping the Const's own contribution) --
# so fusion only fires when the Bin instruction's own index is NOT a
# jump target anywhere in the function. x64_collect_jump_targets scans
# every Jump/JumpIfFalse in the function once per call to check this.

make a function called x64_collect_jump_targets takes instrs returns targets
  let targets = []
  let n = to_num(list_len(instrs))
  let i = 0
  while i < n do
    let instr = instrs[i]
    if instr[0] == "Jump" then
      let targets = list_push(targets, to_num(instr[1]))
    else
      if instr[0] == "JumpIfFalse" then
        let targets = list_push(targets, to_num(instr[1]))
      end
    end
    let i = i + 1
  end
  return targets
end

make a function called x64_is_jump_target takes targets, idx returns yes
  let n = to_num(list_len(targets))
  let i = 0
  while i < n do
    if targets[i] == idx then
      return true
    end
    let i = i + 1
  end
  return false
end

# Real bug found while adding band/bor/bxor/shl/shr support (needed by
# the numeric-tower tagging scheme's own tag-packing arithmetic): this
# was an exclude-list ("everything fuses except / and %"), so the new
# bitwise ops silently fell through x64_fused_const_binop_asm's own
# unguarded else-branch and were mis-emitted as comparisons (cmp+setcc)
# -- wrong output with no error at all. Switched to an explicit
# include-list so a future new Bin op defaults to NOT fusing (safe:
# falls back to the always-correct non-fused x64_binop_asm path) rather
# than defaulting to fuse-and-hope, like x86 immediate-operand support
# actually varies per op is genuinely case-by-case.
make a function called x64_fusable_binop takes op returns yes
  if op == "+" then
    return true
  end
  if op == "-" then
    return true
  end
  if op == "*" then
    return true
  end
  if op == "==" then
    return true
  end
  if op == "!=" then
    return true
  end
  if op == "<" then
    return true
  end
  if op == "<=" then
    return true
  end
  if op == ">" then
    return true
  end
  if op == ">=" then
    return true
  end
  return false
end

# The fused Const+Bin sequence: pop the LEFT operand (already on the
# stack from whatever came before the Const), operate against the
# constant as an immediate, push the result. Same result-in-rax/push
# convention as x64_binop_asm, just without ever materializing the
# constant to the stack at all.
make a function called x64_fused_const_binop_asm takes const_text, op returns asm
  let sb = sb_new()
  sb_push(sb, "    pop rax" + x64_nl_char())
  if op == "+" then
    sb_push(sb, "    add rax, " + const_text + x64_nl_char())
  else
    if op == "-" then
      sb_push(sb, "    sub rax, " + const_text + x64_nl_char())
    else
      if op == "*" then
        sb_push(sb, "    imul rax, rax, " + const_text + x64_nl_char())
      else
        sb_push(sb, "    cmp rax, " + const_text + x64_nl_char())
        if op == "==" then
          sb_push(sb, "    sete al" + x64_nl_char())
        else
          if op == "!=" then
            sb_push(sb, "    setne al" + x64_nl_char())
          else
            if op == "<" then
              sb_push(sb, "    setl al" + x64_nl_char())
            else
              if op == "<=" then
                sb_push(sb, "    setle al" + x64_nl_char())
              else
                if op == ">" then
                  sb_push(sb, "    setg al" + x64_nl_char())
                else
                  sb_push(sb, "    setge al" + x64_nl_char())
                end
              end
            end
          end
        end
        sb_push(sb, "    movzx rax, al" + x64_nl_char())
      end
    end
  end
  sb_push(sb, "    push rax" + x64_nl_char())
  return sb_str(sb)
end

make a function called x64_emit_func takes func, float_mode, dynamic_mode, float_func_names returns asm
  let func_name = func[1]
  let params = func[2]
  let instrs = func[3]
  let locals = x64_collect_locals(func)
  # Register allocation (Slice 8, see x64_reg_pool/x64_build_regmap):
  # eligible locals get a dedicated rbx/r13/r14 for their whole function
  # lifetime instead of a stack slot; everything else spills exactly as
  # before this slice.
  let regmap = x64_build_regmap(locals, instrs, dynamic_mode)
  let spilled = x64_spilled_locals(locals, regmap)
  # +1 extra slot beyond the (spilled) named locals, ALWAYS reserved,
  # for CallValue's own per-frame scratch (see x64_callvalue_asm) -- a
  # value that must survive an opaque `call` this backend's own
  # calling convention gives no register-preservation guarantee
  # across. Using a private slot in the CURRENT function's own stack
  # frame (not a shared/global location) makes it safe under
  # recursion/re-entrancy for free: every active call gets its own
  # rbp, so every active call's copy of this slot is independent.
  # +2 further slots (dyn_a/dyn_b, same offsets every dynamic-dispatch
  # codegen function derives from `spilled` -- see
  # x64_dynamic_promote_both_asm and siblings) hold the dynamic Bin
  # operand pair, freeing r13/r14 for the locals register allocator
  # (patlang-x64-register-allocator-slice8). ALWAYS reserved, same
  # unconditional-reservation reasoning as the CallValue slot above.
  let frame_size = 8 * (to_num(list_len(spilled)) + 3)
  if frame_size < 16 then
    let frame_size = 16
  end
  let sb = sb_new()
  sb_push(sb, func_name + ":" + x64_nl_char())
  sb_push(sb, "    push rbp" + x64_nl_char())
  sb_push(sb, "    mov rbp, rsp" + x64_nl_char())
  sb_push(sb, "    sub rsp, " + frame_size + x64_nl_char())
  let argc = to_num(list_len(params))
  let p = 0
  while p < argc do
    let src_offset = 16 + 8 * (argc - 1 - p)
    sb_push(sb, "    mov rax, [rbp+" + src_offset + "]" + x64_nl_char())
    let reg = x64_reg_for_name(regmap, params[p])
    if reg == "" then
      let slot = x64_local_index(spilled, params[p])
      sb_push(sb, "    mov [rbp-" + (8 * (slot + 1)) + "], rax" + x64_nl_char())
    else
      sb_push(sb, "    mov " + reg + ", rax" + x64_nl_char())
    end
    let p = p + 1
  end
  let n = to_num(list_len(instrs))
  let jump_targets = x64_collect_jump_targets(instrs)
  let int_overrides = []
  if float_mode then
    let int_overrides = x64_call_arg_int_overrides(instrs, float_func_names)
  end
  let bool_print_overrides = x64_bool_print_call_indices(instrs)
  let float_print_overrides = x64_float_print_call_indices(instrs, float_mode, int_overrides, bool_print_overrides)
  let i = 0
  while i < n do
    let instr = instrs[i]
    let fused = false
    if not float_mode then
      if not dynamic_mode then
      if i + 1 < n then
        let next = instrs[i + 1]
        if instr[0] == "Const" then
          if instr[1] == "num" then
            if next[0] == "Bin" then
              if x64_fusable_binop(next[1]) then
                if not x64_is_jump_target(jump_targets, i + 1) then
                  let fused = true
                end
              end
            end
          end
        end
      end
      end
    end
    if fused then
      sb_push(sb, "L_" + func_name + "_" + i + ":" + x64_nl_char())
      sb_push(sb, "L_" + func_name + "_" + (i + 1) + ":" + x64_nl_char())
      sb_push(sb, x64_fused_const_binop_asm(instr[2], instrs[i + 1][1]))
      let i = i + 2
    else
      let label = "L_" + func_name + "_" + i
      let is_override = x64_str_in_list(int_overrides, i)
      let is_bool_print = x64_str_in_list(bool_print_overrides, i)
      let is_float_print = x64_str_in_list(float_print_overrides, i)
      sb_push(sb, x64_emit_instr(instr, func_name, regmap, spilled, label, float_mode, dynamic_mode, is_override, is_bool_print, is_float_print))
      let i = i + 1
    end
  end
  return sb_str(sb)
end

# ---- narrow real fix for GitHub #18: a bare int Const pushed directly
# as one of a Call's arguments (straight-line Const/Load pushes, no
# intervening Bin/Un) to a NAMED, statically-known callee that is
# itself NOT float-mode must be encoded as plain int, regardless of
# the CALLER's own blanket float_mode -- the caller's classification is
# a whole-FUNCTION decision (x64_func_is_float), but a Call's argument
# types are dictated by the CALLEE, which is staticness-known here
# (unlike a dynamically-dispatched closure CallValue, genuinely out of
# scope -- see #18's own text). Deliberately narrow: only bare literal/
# variable arguments in a straight run right before the Call are
# covered; a computed expression argument (any Bin/Un in that run)
# falls back to the existing warning-only behavior, since disentangling
# "was this float arithmetic genuinely intended" from "did an untyped
# literal just pass through" needs the full per-value tagging this
# file's header already names as deliberately deferred.

make a function called x64_str_in_list takes items, target returns yes
  let n = to_num(list_len(items))
  let i = 0
  while i < n do
    if items[i] == target then
      return true
    end
    let i = i + 1
  end
  return false
end

make a function called x64_collect_float_func_names takes funcs returns names
  let out = []
  let i = 0
  let n = to_num(list_len(funcs))
  while i < n do
    if x64_func_is_float(funcs[i]) then
      let out = list_push(out, funcs[i][1])
    end
    let i = i + 1
  end
  return out
end

# Returns the set (as a plain list) of instruction indices, within ONE
# function's own `instrs`, that are bare-int Consts safe to encode as
# plain int despite the function being float_mode -- because they sit
# in a straight-line Const/Load run immediately preceding a Call to a
# named, non-float-mode callee.
make a function called x64_call_arg_int_overrides takes instrs, float_func_names returns overrides
  let overrides = []
  let n = to_num(list_len(instrs))
  let i = 0
  while i < n do
    let instr = instrs[i]
    if instr[0] == "Call" then
      let argc = to_num(instr[2])
      if argc > 0 then
        let start = i - argc
        if start >= 0 then
          let straight_line = true
          let j = start
          while j < i do
            let jty = instrs[j][0]
            if (jty != "Const") and (jty != "Load") then
              let straight_line = false
            end
            let j = j + 1
          end
          if straight_line then
            let callee_is_float = x64_str_in_list(float_func_names, instr[1])
            if not callee_is_float then
              let j = start
              while j < i do
                let cur = instrs[j]
                if cur[0] == "Const" then
                  if cur[1] == "num" then
                    if not x64_contains(cur[2], ".") then
                      let overrides = list_push(overrides, j)
                    end
                  end
                end
                let j = j + 1
              end
            end
          end
        end
      end
    end
    let i = i + 1
  end
  return overrides
end

# GitHub #24 fix: a print(v) call whose single argument was JUST
# produced by a Bool-shaped instruction (a literal `true`/`false`, a
# comparison, or `not`) is rerouted to rt_print_bool instead of the
# generic print(), so it prints "true"/"false" instead of "1"/"0" --
# see rt_print_bool's own header in x64_runtime.patlang for the full
# reasoning and scope limits (this is a static, syntactic check, not
# real value tagging).
make a function called x64_is_bool_producing_instr takes instr returns yes
  if instr[0] == "Const" then
    if instr[1] == "bool" then
      return true
    end
    return false
  end
  if instr[0] == "Un" then
    return instr[1] == "not"
  end
  if instr[0] == "Bin" then
    return x64_is_dynamic_cmp_op(instr[1])
  end
  return false
end

make a function called x64_bool_print_call_indices takes instrs returns overrides
  let overrides = []
  let n = to_num(list_len(instrs))
  let i = 0
  while i < n do
    let instr = instrs[i]
    if instr[0] == "Call" then
      if instr[1] == "print" then
        if to_num(instr[2]) == 1 then
          if i > 0 then
            if x64_is_bool_producing_instr(instrs[i - 1]) then
              let overrides = list_push(overrides, i)
            end
          end
        end
      end
    end
    let i = i + 1
  end
  return overrides
end

# Real float-printing fix: a print(v) call inside a float_mode function
# whose argument wasn't already claimed by the bool-print override
# (#24) or the int-Call-arg override (#18, meaning it's a deliberately
# plain-int value despite the surrounding function's float_mode) or a
# string literal is, by elimination, a genuine float value -- reroute
# it to rt_print_float instead of the generic print(), which has no
# way to distinguish a float's raw bit pattern from any other family
# (see print()'s own header in x64_runtime.patlang: it's why floats
# fell through to the "<value>" placeholder in the first place).
make a function called x64_float_print_call_indices takes instrs, float_mode, int_overrides, bool_print_overrides returns overrides
  let out = []
  if not float_mode then
    return out
  end
  let n = to_num(list_len(instrs))
  let i = 0
  while i < n do
    let instr = instrs[i]
    if instr[0] == "Call" then
      if instr[1] == "print" then
        if to_num(instr[2]) == 1 then
          if i > 0 then
            if not x64_str_in_list(bool_print_overrides, i) then
              if not x64_str_in_list(int_overrides, i - 1) then
                let prev = instrs[i - 1]
                let is_str_const = false
                if prev[0] == "Const" then
                  if prev[1] == "str" then
                    let is_str_const = true
                  end
                end
                if not is_str_const then
                  let out = list_push(out, i)
                end
              end
            end
          end
        end
      end
    end
    let i = i + 1
  end
  return out
end

# ---- whole program -> nasm text ----

# A small local substring check -- NOT lib/x64_build.patlang's
# x64_build_contains (a different file; this backend's own driver
# scripts include only THIS file, so it needs its own copy, same
# reasoning x64_build.patlang used for not depending on lib/
# test.patlang's contains_text).
make a function called x64_contains takes hay, needle returns r
  let hn = to_num(sc_len(str_intern(hay)))
  let nn = to_num(sc_len(str_intern(needle)))
  if nn > hn then
    return false
  end
  let i = 0
  while i <= hn - nn do
    if substr(hay, i, nn) == needle then
      return true
    end
    let i = i + 1
  end
  return false
end

# Whole-program float-mode detection (Slice 7) -- see this file's own
# header for why this is a WHOLE-PROGRAM decision, not per-value.
# Scoped PER-FUNCTION, not whole-program: an earlier draft scanned the
# entire program (including the PatLang-authored runtime prelude that
# gets concatenated ahead of every user program), which silently broke
# rt_print_i64's own digit-extraction `%`/`/` the moment ANY float
# literal appeared anywhere in a program, since one shared flag forced
# EVERY function's Bin instructions -- including the runtime's -- into
# float mode. A function's own float-ness is still a whole-FUNCTION
# decision (no per-value type tagging), just no longer a whole-program
# one -- each function is independently plain-int or all-float based
# on whether ITS OWN body contains a float literal.
make a function called x64_func_is_float takes func returns yes
  let instrs = func[3]
  let i = 0
  let n = to_num(list_len(instrs))
  while i < n do
    let instr = instrs[i]
    if instr[0] == "Const" then
      if instr[1] == "num" then
        if x64_contains(instr[2], ".") then
          return true
        end
      end
    end
    let i = i + 1
  end
  return false
end

# Numeric-tower "dynamic mode" detection (first working cut -- see
# x64_runtime.patlang's own header above rt_bigint_from_i64 for the
# full, honestly-named scope limits). A function is dynamic if its own
# body directly calls rt_bigint_from_i64 -- a whole-function, syntactic
# decision exactly mirroring x64_func_is_float's own scope limit, NOT
# yet cross-function propagation or per-value specialization. Functions
# that never touch BigInt are unaffected (still get today's exact
# untagged int codegen), which is what keeps bench_loop/bench_fib's
# speed intact -- verified in this slice's own testing, not assumed.
# Real bug caught before it ever ran wrong: the tower's OWN
# implementation functions (rt_rational_add/_sub/_mul/_div/_cmp,
# rt_gcd) call rt_rational_new to build their result -- which, under
# the naive "dynamic if it calls a tower constructor anywhere" rule,
# would classify THEM as dynamic too. Unlike rt_bigint_add's own
# already-shipped case (safe by luck: its internal comparisons only
# ever see 0/1 sign flags or -1/0/1 cmp results, always well within
# the fixnum range), rt_rational_add's `n1*d2+n2*d1` etc. operate on
# genuinely arbitrary-range i64 numerators/denominators -- routing
# THAT through the tagged-fixnum fast path (which only correctly
# recovers values within +-140 trillion) would silently corrupt any
# rational built from a larger int, a real correctness bug, not just
# wasted dispatch overhead. Fixed by excluding the tower's own
# implementation functions by name: they always operate on already-
# unwrapped plain ints (via `tagged band payload_mask`, done
# explicitly in their own bodies), never on tagged values through
# ordinary Bin arithmetic, so they must never be classified dynamic
# regardless of what they call.
make a function called x64_func_is_tower_impl takes name returns yes
  if x64_contains(name, "rt_bigint_") then
    return true
  end
  if x64_contains(name, "rt_rational_") then
    return true
  end
  if name == "rt_gcd" then
    return true
  end
  if name == "rt_fixnum_unpack" then
    return true
  end
  return false
end

make a function called x64_func_is_dynamic takes func returns yes
  if x64_func_is_tower_impl(func[1]) then
    return false
  end
  # rt_complex_eq doesn't call any tower CONSTRUCTOR (it returns a
  # plain 0/1, never builds a new Complex), so the syntactic "calls a
  # constructor" heuristic below can't see that its own `==` on
  # re/im components genuinely needs dynamic dispatch (those
  # components can be fixnum/BigInt/Rational, and a naive bitwise `==`
  # would wrongly say two equal-VALUE BigInts at different heap
  # addresses are unequal). Forced dynamic by name instead -- see
  # x64_runtime.patlang's own header on rt_complex_eq.
  if func[1] == "rt_complex_eq" then
    return true
  end
  # Same reasoning as rt_complex_eq, same fix.
  if func[1] == "rt_interval_eq" then
    return true
  end
  let instrs = func[3]
  let i = 0
  let n = to_num(list_len(instrs))
  while i < n do
    let instr = instrs[i]
    if instr[0] == "Call" then
      if instr[1] == "rt_bigint_from_i64" then
        return true
      end
      if instr[1] == "rt_rational_new" then
        return true
      end
      if instr[1] == "rt_rational_from_i64" then
        return true
      end
      if instr[1] == "rt_complex_new" then
        return true
      end
      if instr[1] == "rt_complex_from_i64" then
        return true
      end
      if instr[1] == "rt_complex_from_num" then
        return true
      end
      if instr[1] == "rt_interval_new" then
        return true
      end
      if instr[1] == "rt_interval_from_i64" then
        return true
      end
      if instr[1] == "rt_interval_from_num" then
        return true
      end
      if instr[1] == "rt_object_new" then
        return true
      end
    end
    # Real bug found (GitHub #19) while chasing what looked like a
    # print regression: a function that builds a string via `+`
    # (ordinary user syntax, e.g. `"hello" + " " + "world"`) was NEVER
    # classified dynamic just for containing a string literal -- so
    # its `+` went through the plain x64_binop_asm path, which does a
    # raw integer `add` on the two TAGGED string addresses. Two
    # String-family (0x2 in the top nibble) pointers added together
    # produce a bit pattern with a DIFFERENT, often unrelated family
    # nibble (confirmed: 0x2+0x2 in the top nibble carries to 0x4,
    # which happens to collide with the CLOSURE tag) -- silently wrong,
    # not even a crash, and print()'s own family dispatch then falls
    # through to its "<value>" default since the result doesn't match
    # any real family it knows. Any function touching a string literal
    # needs the tag-aware dynamic dispatch to have a chance at correct
    # behavior for ALL its ops involving that string, same reasoning as
    # rt_bigint_from_i64 above forcing dynamic mode for BigInt. (Same
    # blind spot as every other syntactic trigger here: a function that
    # ONLY ever receives strings via parameters, with no string literal
    # or forced-dynamic call of its own, still won't be detected --
    # full type inference is out of scope, matching this file's other
    # heuristics.)
    if instr[0] == "Const" then
      if instr[1] == "str" then
        return true
      end
    end
    let i = i + 1
  end
  return false
end

# owns_globals: true for the RUNTIME chunk (x64_runtime.patlang alone
# -- the sole owner of the shared .bss state, declared `global` so a
# separately-compiled program chunk can `extern` it instead of
# re-declaring its own copy, which would be a link-time "multiple
# definition" error), false for the PROGRAM chunk (declares the same
# names `extern` instead of defining them).
#
# extern_names: function names to declare `extern` for beyond the
# fixed Win32 imports -- the program chunk passes the runtime chunk's
# OWN full function-name list here. Deliberately NOT a precise "walk
# the Call graph and only extern what's actually referenced" analysis:
# most runtime calls (rt_list_get, rt_heap_alloc, rt_bigint_add, ...)
# are hand-assembled `"    call rt_xxx"` string literals scattered
# throughout x64_binop_asm_dynamic/x64_callhost_asm/etc, not ordinary
# IR `Call` instructions -- invisible to any IR-level call-graph walk.
# An unconditional `extern` for the runtime's WHOLE function list is
# simple, robust (never misses one), and free: NASM only complains
# about a symbol that's BOTH referenced and undefined, never about an
# unused `extern` declaration. The runtime chunk itself passes an empty
# list (self-contained, no cross-chunk calls of its own).
make a function called emit_program_x64 takes ir, owns_globals, extern_names returns asm
  let funcs = ir[2]
  let sb = sb_new()
  sb_push(sb, "default rel" + x64_nl_char())
  # Every defined function is declared `global` -- NASM labels are
  # file-local by default, so without this the linker could never
  # resolve the OTHER chunk's `extern rt_foo`/etc references against
  # this file's own function labels. Harmless to do unconditionally
  # even for functions nothing outside this chunk ever calls.
  let fn_count = to_num(list_len(funcs))
  if fn_count > 0 then
    let gl_line = sb_new()
    sb_push(gl_line, "global ")
    let gi = 0
    while gi < fn_count do
      if gi > 0 then
        sb_push(gl_line, ", ")
      end
      sb_push(gl_line, funcs[gi][1])
      let gi = gi + 1
    end
    sb_push(sb, sb_str(gl_line) + x64_nl_char())
  end
  sb_push(sb, "extern GetStdHandle, WriteFile, ExitProcess, CreateFileA, GetFileSize, CloseHandle, ReadFile, CreateProcessA, CreatePipe, SetHandleInformation, WaitForSingleObject, GetCommandLineA" + x64_nl_char())
  let en_count = to_num(list_len(extern_names))
  if en_count > 0 then
    let en_line = sb_new()
    sb_push(en_line, "extern ")
    let ei = 0
    while ei < en_count do
      if ei > 0 then
        sb_push(en_line, ", ")
      end
      sb_push(en_line, extern_names[ei])
      let ei = ei + 1
    end
    sb_push(sb, sb_str(en_line) + x64_nl_char())
  end
  sb_push(sb, x64_nl_char())
  sb_push(sb, "section .bss" + x64_nl_char())
  if owns_globals then
    sb_push(sb, "    global g_written, g_scratch, g_heap_state, g_sb_table, g_vec_table, g_vars_table, g_heap, g_rules_table, g_actions_table, g_action_bodies_table, g_procs_table, g_listeners_table, g_conns_table, g_wsa_init" + x64_nl_char())
    sb_push(sb, "    align 8" + x64_nl_char())
    sb_push(sb, "    g_written resd 1" + x64_nl_char())
    sb_push(sb, "    align 8" + x64_nl_char())
    sb_push(sb, "    g_scratch resb 256" + x64_nl_char())
    sb_push(sb, "    align 8" + x64_nl_char())
    sb_push(sb, "    g_heap_state resq 1" + x64_nl_char())
    sb_push(sb, "    align 8" + x64_nl_char())
    sb_push(sb, "    g_sb_table resq 1" + x64_nl_char())
    sb_push(sb, "    align 8" + x64_nl_char())
    sb_push(sb, "    g_vec_table resq 1" + x64_nl_char())
    sb_push(sb, "    align 8" + x64_nl_char())
    sb_push(sb, "    g_vars_table resq 1" + x64_nl_char())
    sb_push(sb, "    align 8" + x64_nl_char())
    sb_push(sb, "    g_rules_table resq 1" + x64_nl_char())
    sb_push(sb, "    align 8" + x64_nl_char())
    sb_push(sb, "    g_actions_table resq 1" + x64_nl_char())
    sb_push(sb, "    align 8" + x64_nl_char())
    sb_push(sb, "    g_action_bodies_table resq 1" + x64_nl_char())
    sb_push(sb, "    align 8" + x64_nl_char())
    sb_push(sb, "    g_procs_table resq 1" + x64_nl_char())
    sb_push(sb, "    align 8" + x64_nl_char())
    sb_push(sb, "    g_listeners_table resq 1" + x64_nl_char())
    sb_push(sb, "    align 8" + x64_nl_char())
    sb_push(sb, "    g_conns_table resq 1" + x64_nl_char())
    sb_push(sb, "    align 8" + x64_nl_char())
    # WSAStartup lazy-init flag (Stage B, TCP networking) -- 0 until
    # the first networking call in the program, matching the same
    # lazy-init-on-first-use convention every other table here uses.
    sb_push(sb, "    g_wsa_init resq 1" + x64_nl_char())
    sb_push(sb, "    align 16" + x64_nl_char())
    sb_push(sb, "    g_heap resb 16777216" + x64_nl_char())
  else
    sb_push(sb, "extern g_written, g_scratch, g_heap_state, g_sb_table, g_vec_table, g_vars_table, g_heap, g_rules_table, g_actions_table, g_action_bodies_table, g_procs_table, g_listeners_table, g_conns_table, g_wsa_init" + x64_nl_char())
  end
  sb_push(sb, x64_nl_char())
  sb_push(sb, "section .data" + x64_nl_char())
  sb_push(sb, "    align 8" + x64_nl_char())
  sb_push(sb, x64_collect_string_data(ir))
  sb_push(sb, x64_nl_char())
  sb_push(sb, "section .text" + x64_nl_char())
  sb_push(sb, x64_nl_char())
  x64_string_label_reset()
  let n = to_num(list_len(funcs))
  let float_func_names = x64_collect_float_func_names(funcs)
  let i = 0
  while i < n do
    sb_push(sb, x64_emit_func(funcs[i], x64_func_is_float(funcs[i]), x64_func_is_dynamic(funcs[i]), float_func_names))
    sb_push(sb, x64_nl_char())
    let i = i + 1
  end
  return sb_str(sb)
end
