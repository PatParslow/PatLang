# win_canvas_blit(src_buf, src_w, src_h, dest_x, dest_y) -> done. Phase
# 5: copies an image.patlang-shaped RGB24 buffer (row-major, 3 bytes/
# pixel, no padding -- image.patlang's own header) straight into the
# canvas surface at (dest_x, dest_y), converting RGB24->BGRX per pixel
