  sb_push(sb, "    pop r8" + x64_nl_char())
  sb_push(sb, "    pop r9" + x64_nl_char())
  sb_push(sb, "    pop rax" + x64_nl_char())
  sb_push(sb, x64_bit_mask_asm(suffix))
  sb_push(sb, "    mov rcx, r9" + x64_nl_char())
  sb_push(sb, "    sar rax, cl" + x64_nl_char())
  sb_push(sb, "    and rax, r10" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  return sb_str(sb)
end

