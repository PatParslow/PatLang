    # returns a small int code classifying v's family, which those
    # wrappers map to the real string result via ordinary literal
    # Consts (going through the normal string-literal pipeline, unlike
    # trying to emit a fresh string constant directly from raw asm
    # here). 0=fixnum, 2=string, 3=list, 4=closure, 5=object,
    # 6=bigint, 7=rational, 8=complex, 9=interval, 10=other (doesn't
    # round-trip as a fixnum AND doesn't match any known family/subtag).
    sb_push(sb, x64_family_code_asm())
  else
