# =============================================================================
# Self-hosted PatLang -> x64 NASM (win64) backend -- SLICE 1.
#
# Consumes the EXACT SAME flat IR lib/lower.patlang already produces
# for the Rust-text backend (ir[1]=entry, ir[2]=[FuncIR...], ir[3]=
# [EventIR...]) -- zero changes to lexer/parser/lower. Emits real NASM
# `win64` assembly text, assembled+linked with the same toolchain
# (nasm -f win64, then gcc -Wl,--subsystem,console -lkernel32 -luser32)
# already proven working this session for the recovered Mandelbrot
# double-double kernel driver (turbo_dd.asm).
#
# SLICE 1 SCOPE (see the plan file for the full reasoning): every value
# is a plain 64-bit integer -- no tagged dynamic Value, no numeric
# tower, no strings/lists/closures. `+ - * / % == != < <= > >=` on
# ints, `if/else`, `while`, ordinary (non-closure) function calls.
#
# CALLING CONVENTION (this backend's own, NOT the win64 ABI -- only the
# small OS-boundary primitive calls below need genuine win64 ABI
# compliance): a call's arguments are simply the values already pushed
# onto the real x64 stack by evaluating each argument expression
# left-to-right (exactly matching lower.patlang's own Call-lowering
# order) -- the callee copies them into its own local slots by reading
# fixed offsets above its return address, and returns its single
# result on the stack too (pop the result into rax, `leave`, `ret`;
# the caller cleans up the argc*8 bytes of pushed args and re-pushes
# rax as its own result). This keeps every instruction's stack effect
# exactly "pop N values, push 1 value" throughout, matching the
# CallHost/Call/Bin/Un instructions' own implicit contract in the IR.
#
# THE ONLY NAMES THIS BACKEND GIVES SPECIAL MEANING TO (everything else
# reaching CallHost is a compile-time error -- see lib/x64_runtime.
# patlang's own header for why the list is this short and what each
# one does): mem_scratch_addr, mem_poke_byte, mem_peek_byte,
# mem_heap_base, mem_heap_state_addr, mem_poke_qword, mem_peek_qword,
# os_write_console_bytes, os_exit. Only the last two are genuine win64-
# ABI calls into real OS DLL functions (GetStdHandle/WriteFile/
# ExitProcess -- WriteFile, not WriteConsoleA: the latter only works
# against a genuine interactive console handle and silently fails
# whenever stdout is redirected/piped, which is exactly what happened
# capturing this program's output during development) -- guarded by a
# save-rsp/align/restore-rsp pattern
# (register r15) so the surrounding operand-stack discipline is never
# disturbed by the temporary 16-byte alignment a real ABI call needs.
#
# HEAP (Slice 2): deliberately NOT one-OS-call-per-allocation. One
# fixed, large `.bss` reservation (g_heap) plus one persistent 8-byte
# bump-pointer counter (g_heap_state) are the ONLY heap-related native
# primitives -- the actual allocator ALGORITHM (bump-and-align today,
# a real free-list/reuse scheme whenever that becomes worth it) is
# ordinary PatLang in lib/x64_runtime.patlang's rt_heap_alloc, using
# nothing but mem_heap_base/mem_heap_state_addr/mem_peek_qword/
# mem_poke_qword. This is the SAME "runtime logic belongs in PatLang,
# not baked into the native primitive" principle Slice 1's int-to-
# string conversion already established -- growing the allocator later
# means writing more PatLang, not touching this backend again.
#
# STRINGS (Slice 3): a string is a heap-allocated block laid out as
# [8-byte length][raw bytes, not null-terminated] -- an ordinary
# integer address, same as every other value in this backend's
# monomorphic world, no new tag or runtime type. String LITERALS
# become `.data` labels (an 8-byte length + the literal's raw bytes,
# encoded as explicit byte VALUES via db, not a quoted NASM string, so
# no escaping logic is needed for quotes/newlines/anything else) --
# see x64_collect_string_data. Every string OPERATION (concat, length,
# printing) is ordinary PatLang in lib/x64_runtime.patlang built from
# the existing mem_peek/poke_byte/qword + rt_heap_alloc primitives --
# NO new native primitives were needed for strings at all.
#
# DELIBERATE SCOPE LIMIT: `+` on the IR's `Bin` instruction is STILL
# always integer addition -- this backend has no dynamic type tags, so
# it cannot tell at codegen time whether a pushed value is an int or a
# string pointer, and making `+` polymorphic would need real type
# inference or runtime tagging (a much bigger, separate undertaking).
# String concatenation is therefore its own explicitly-named function,
# `rt_str_concat(a, b)`, not operator overloading -- a real, named
# simplification, not an oversight.
#
# CLOSURES (Slice 5): a closure is a heap block laid out as
# [8-byte code address][8-byte captured count][captured values...] --
# deliberately chosen to generalize toward "everything is a function,
# everything is an object" rather than being a closure-only special
# case: a code/behavior pointer plus a bag of values is already most
# of the way to a general object (`[type/vtable pointer][field count]
# [field values...]` is nearly the same shape), and once closures are
# real callable values storable in lists (Slice 4), an event-handler
# table is just a list of `[name_string, closure]` pairs, dispatched
# by calling the matching closure through the exact same CallValue
# mechanism this slice builds -- both are real, named future
# directions, not built here, but the representation is chosen with
# them in view rather than needing to be redesigned later.
#
# MakeClosure(func_name, captured_names) -- captured_names.length is
# known at COMPILE time (it's a literal list baked into the IR at this
# instruction), so this is unrolled exactly like BuildList: allocate,
# store the code address (a compile-time label -- `lea`) and count,
# then pop the already-pushed captured values into the block.
#
# CallValue(argc) -- the CLOSURE's own captured count is NOT known at
# compile time here (a variable can hold different closures at
# different times), so pushing its captured values onto the operand
# stack before the real `call` needs a genuine runtime loop, unlike
# every other instruction in this backend. argc (the call site's own
# explicit arg count) IS compile-time-known, so those args are popped
# into the .bss scratch buffer first (out of the way), the closure's
# captured values are pushed via the runtime loop, then the scratch
# args are pushed back on top in original order, then an INDIRECT call
# (`call r12`, not a compile-time label) reaches the synthesized
# function -- whose own params are exactly `captured ++ own_params`,
# per lib/lower.patlang's own lower_closure_literal, so this lines up
# with the ordinary Call calling convention automatically once the
# stack is arranged correctly.
#
# NUMERIC TOWER, Slice 7 -- floats only, NOT BigInt/Rational/Complex
# (each is its own separate, much larger undertaking, deliberately not
# started here): a genuine second numeric kind, using NASM's own
# `__float64__(literal)` compile-time-constant operator for Const
# (no .data label needed, unlike strings -- floats fit in the same
# 8-byte slot ints already use) and SSE2 (`movq`/`addsd`/`ucomisd`+
# setcc) for Bin arithmetic and comparisons.
#
# DELIBERATE, NAMED SCOPE LIMIT, the real one: float-mode is a WHOLE-
# FUNCTION decision (any float literal anywhere in a given function's
# own body -> every Bin instruction IN THAT FUNCTION becomes float
# arithmetic), not a per-value decision -- this backend still has no
# dynamic type tags, so it has no way to tell int bit patterns from
# float bit patterns at any given Bin site. This means a single
# function mixing float math with ordinary int loop counters/
# arithmetic would be silently WRONG under this scheme (an int loop
# counter's bits reinterpreted as a float). Real per-value tagging
# (needed for BigInt/Rational too) is the actual fix, and is
# deliberately deferred -- any one function compiled by this slice
# must be either ALL-int or ALL-float, never mixed WITHIN that
# function. Const+Bin fusion (Slice 6) is disabled entirely in float
# mode for the same reason (it was designed around integer immediates
# only).
#
# Scoped per-FUNCTION rather than per-program deliberately: an earlier
# draft scanned the whole concatenated program (user source PLUS the
# PatLang-authored runtime prelude every program gets prepended),
# which meant a single float literal anywhere in the user's own code
# forced the RUNTIME's own functions -- e.g. rt_print_i64's `%`/`/`
# decimal-digit-extraction, genuine int arithmetic -- into float mode
# too, silently breaking them. Caught immediately (compile-time
# "unsupported float binary operator: %" from the runtime itself, not
# a silent wrong answer) the first time a float demo was actually
# compiled and run. Per-function scoping fixes this cleanly: each
# function (including every runtime helper) is judged independently by
# whether ITS OWN body contains a float literal.
#
# Float PRINTING (decimal formatting) is ALSO deliberately not built
# here -- real float-to-string formatting is its own separate, fiddly
# problem. This slice proves float ARITHMETIC is correct by truncating
# results back to int (via the new f64_to_i64_trunc primitive) and
# printing THAT with the existing rt_print_i64, not by building a
# float formatter.
# =============================================================================

make a function called nl returns s
  return chr(10)
end

# ---- string literal data (Slice 3) ----
#
# Two passes over the SAME ir[2] funcs list, in the SAME deterministic
# order, each independently resetting and re-incrementing this counter
# -- x64_collect_string_data (pass 1, builds the .data text) and the
# ordinary x64_emit_func/x64_emit_instr codegen walk (pass 2) therefore
# assign IDENTICAL S0/S1/S2/... labels to the same Const "str" nodes
# without needing any lookup table between the two passes.
make a function called x64_string_label_reset returns done
  set_var("__x64_str_counter", 0)
  return true
end

make a function called x64_string_label_next returns label
  let n = to_num(get("__vars", "__x64_str_counter"))
  set_var("__x64_str_counter", n + 1)
  return "S" + n
end

# A string literal's raw bytes as NASM `db` byte-value text (e.g.
# "72,101,108,108,111"), not a quoted NASM string -- sidesteps quoting/
# escaping entirely, uniformly handles every character. An empty
# string still needs at least one byte for `db` to accept, hence the
# "0" placeholder (never read, since the stored length is 0).
make a function called x64_bytes_of takes text returns s
  let h = str_intern(text)
  let n = to_num(sc_len(h))
  if n == 0 then
    return "0"
  end
  let sb = sb_new()
  let i = 0
  while i < n do
    if i > 0 then
      sb_push(sb, ",")
    end
    sb_push(sb, "" + sc_code(h, i))
    let i = i + 1
  end
  return sb_str(sb)
end

# Walks every function's instructions once, emitting one .data label
# per Const "str" node encountered, in encounter order.
make a function called x64_collect_string_data takes ir returns asm
  x64_string_label_reset()
  let funcs = ir[2]
  let sb = sb_new()
  let fn_i = 0
  let fn_n = to_num(list_len(funcs))
  while fn_i < fn_n do
    let instrs = funcs[fn_i][3]
    let i = 0
    let n = to_num(list_len(instrs))
    while i < n do
      let instr = instrs[i]
      if instr[0] == "Const" then
        if instr[1] == "str" then
          let label = x64_string_label_next()
          sb_push(sb, label + ":" + nl())
          sb_push(sb, "    dq " + to_num(sc_len(str_intern(instr[2]))) + nl())
          sb_push(sb, "    db " + x64_bytes_of(instr[2]) + nl())
        end
      end
      let i = i + 1
    end
    let fn_i = fn_i + 1
  end
  return sb_str(sb)
end

# ---- local-variable slot allocation ----

make a function called x64_local_index takes names, name returns idx
  let n = to_num(list_len(names))
  let i = 0
  while i < n do
    if names[i] == name then
      return i
    end
    let i = i + 1
  end
  return 0 - 1
end

# Params first (in order), then every OTHER name a Store instruction
# targets, first-seen order. Slot k lives at [rbp - 8*(k+1)].
make a function called x64_collect_locals takes func returns names
  let params = func[2]
  let instrs = func[3]
  let names = []
  let pn = to_num(list_len(params))
  let i = 0
  while i < pn do
    let names = list_push(names, params[i])
    let i = i + 1
  end
  let n = to_num(list_len(instrs))
  let i = 0
  while i < n do
    let instr = instrs[i]
    if instr[0] == "Store" then
      if x64_local_index(names, instr[1]) < 0 then
        let names = list_push(names, instr[1])
      end
    end
    let i = i + 1
  end
  return names
end

# ---- one instruction -> nasm text ----

# Float variant (Slice 7): operand bits already sit in plain GP
# registers (same push/pop discipline as everywhere else in this
# backend -- see this file's own header), shuttled into XMM registers
# via `movq` only for the actual SSE2 arithmetic/comparison, then back.
# ucomisd's flags are the UNSIGNED integer condition codes (setb/setbe/
# seta/setae for </<=/>/>=, NOT setl/setle/setg/setge) -- a genuine,
# easy-to-get-wrong difference from the integer comparison path, called
# out explicitly here rather than silently copy-pasted wrong.
make a function called x64_binop_asm_float takes op returns asm
  let sb = sb_new()
  sb_push(sb, "    pop rbx" + nl())
  sb_push(sb, "    pop rax" + nl())
  sb_push(sb, "    movq xmm0, rax" + nl())
  sb_push(sb, "    movq xmm1, rbx" + nl())
  if op == "+" then
    sb_push(sb, "    addsd xmm0, xmm1" + nl())
    sb_push(sb, "    movq rax, xmm0" + nl())
  else
    if op == "-" then
      sb_push(sb, "    subsd xmm0, xmm1" + nl())
      sb_push(sb, "    movq rax, xmm0" + nl())
    else
      if op == "*" then
        sb_push(sb, "    mulsd xmm0, xmm1" + nl())
        sb_push(sb, "    movq rax, xmm0" + nl())
      else
        if op == "/" then
          sb_push(sb, "    divsd xmm0, xmm1" + nl())
          sb_push(sb, "    movq rax, xmm0" + nl())
        else
          sb_push(sb, "    ucomisd xmm0, xmm1" + nl())
          if op == "==" then
            sb_push(sb, "    sete al" + nl())
          else
            if op == "!=" then
              sb_push(sb, "    setne al" + nl())
            else
              if op == "<" then
                sb_push(sb, "    setb al" + nl())
              else
                if op == "<=" then
                  sb_push(sb, "    setbe al" + nl())
                else
                  if op == ">" then
                    sb_push(sb, "    seta al" + nl())
                  else
                    if op == ">=" then
                      sb_push(sb, "    setae al" + nl())
                    else
                      print("codegen_x64: unsupported float binary operator: " + op)
                      return "UNSUPPORTED_BINOP_ERROR"
                    end
                  end
                end
              end
            end
          end
          sb_push(sb, "    movzx rax, al" + nl())
        end
      end
    end
  end
  sb_push(sb, "    push rax" + nl())
  return sb_str(sb)
end

make a function called x64_binop_asm takes op returns asm
  let sb = sb_new()
  sb_push(sb, "    pop rbx" + nl())
  sb_push(sb, "    pop rax" + nl())
  if op == "+" then
    sb_push(sb, "    add rax, rbx" + nl())
  else
    if op == "-" then
      sb_push(sb, "    sub rax, rbx" + nl())
    else
      if op == "*" then
        sb_push(sb, "    imul rax, rbx" + nl())
      else
        if op == "/" then
          sb_push(sb, "    cqo" + nl())
          sb_push(sb, "    idiv rbx" + nl())
        else
          if op == "%" then
            sb_push(sb, "    cqo" + nl())
            sb_push(sb, "    idiv rbx" + nl())
            sb_push(sb, "    mov rax, rdx" + nl())
          else
            sb_push(sb, "    cmp rax, rbx" + nl())
            if op == "==" then
              sb_push(sb, "    sete al" + nl())
            else
              if op == "!=" then
                sb_push(sb, "    setne al" + nl())
              else
                if op == "<" then
                  sb_push(sb, "    setl al" + nl())
                else
                  if op == "<=" then
                    sb_push(sb, "    setle al" + nl())
                  else
                    if op == ">" then
                      sb_push(sb, "    setg al" + nl())
                    else
                      if op == ">=" then
                        sb_push(sb, "    setge al" + nl())
                      else
                        print("codegen_x64: unsupported binary operator: " + op)
                        return "UNSUPPORTED_BINOP_ERROR"
                      end
                    end
                  end
                end
              end
            end
            sb_push(sb, "    movzx rax, al" + nl())
          end
        end
      end
    end
  end
  sb_push(sb, "    push rax" + nl())
  return sb_str(sb)
end

# CallHost -- only the five special primitive names are legal here,
# PLUS two safe aliases (Slice 4): `l[i]` index syntax always lowers to
# CallHost("list_get", 2) regardless of backend (lib/lower.patlang's
# own doing, not special-cased here), and `list_len(l)` is ordinary
# unrecognized-call-becomes-CallHost the same as any host function
# name. Both are pure reads with unambiguous semantics (a read is a
# read regardless of the mutation model), so they're aliased straight
# to `call rt_list_get`/`call rt_list_len` -- reusing the SAME PatLang
# implementation, not a separate native primitive. Deliberately NOT
# aliasing `list_set`/`list_push`: the interpreter's own list_set is
# copy-on-write/functional, but this backend's rt_list_set (see lib/
# x64_runtime.patlang) is in-place mutation -- aliasing the ambiguous
# name would silently change PatLang's own observable semantics, so
# list construction/mutation stays under its own explicit rt_list_*
# names instead.
make a function called x64_callhost_asm takes name, argc returns asm
  let sb = sb_new()
  if name == "list_get" then
    sb_push(sb, "    call rt_list_get" + nl())
    sb_push(sb, "    add rsp, 16" + nl())
    sb_push(sb, "    push rax" + nl())
  else
  if name == "list_len" then
    sb_push(sb, "    call rt_list_len" + nl())
    sb_push(sb, "    add rsp, 8" + nl())
    sb_push(sb, "    push rax" + nl())
  else
  if name == "mem_scratch_addr" then
    sb_push(sb, "    lea rax, [rel g_scratch]" + nl())
    sb_push(sb, "    push rax" + nl())
  else
    if name == "mem_poke_byte" then
      sb_push(sb, "    pop rcx" + nl())
      sb_push(sb, "    pop rdx" + nl())
      sb_push(sb, "    pop rax" + nl())
      sb_push(sb, "    add rax, rdx" + nl())
      sb_push(sb, "    mov byte [rax], cl" + nl())
      sb_push(sb, "    push 0" + nl())
    else
      if name == "mem_peek_byte" then
        sb_push(sb, "    pop rdx" + nl())
        sb_push(sb, "    pop rax" + nl())
        sb_push(sb, "    add rax, rdx" + nl())
        sb_push(sb, "    movzx rax, byte [rax]" + nl())
        sb_push(sb, "    push rax" + nl())
      else
      if name == "mem_heap_base" then
        sb_push(sb, "    lea rax, [rel g_heap]" + nl())
        sb_push(sb, "    push rax" + nl())
      else
      if name == "mem_heap_state_addr" then
        sb_push(sb, "    lea rax, [rel g_heap_state]" + nl())
        sb_push(sb, "    push rax" + nl())
      else
      if name == "mem_poke_qword" then
        sb_push(sb, "    pop rcx" + nl())
        sb_push(sb, "    pop rdx" + nl())
        sb_push(sb, "    pop rax" + nl())
        sb_push(sb, "    add rax, rdx" + nl())
        sb_push(sb, "    mov [rax], rcx" + nl())
        sb_push(sb, "    push 0" + nl())
      else
      if name == "mem_peek_qword" then
        sb_push(sb, "    pop rdx" + nl())
        sb_push(sb, "    pop rax" + nl())
        sb_push(sb, "    add rax, rdx" + nl())
        sb_push(sb, "    mov rax, [rax]" + nl())
        sb_push(sb, "    push rax" + nl())
      else
      if name == "f64_to_i64_trunc" then
        # Slice 7: the ONE conversion primitive genuinely needing a
        # dedicated CPU instruction (cvttsd2si) -- ordinary arithmetic
        # alone can't do a float-to-int truncating conversion. Takes a
        # float BIT PATTERN (as pushed by float-mode Const/Bin), returns
        # a plain int.
        sb_push(sb, "    pop rax" + nl())
        sb_push(sb, "    movq xmm0, rax" + nl())
        sb_push(sb, "    cvttsd2si rax, xmm0" + nl())
        sb_push(sb, "    push rax" + nl())
      else
        if name == "os_write_console_bytes" then
          sb_push(sb, "    pop r13" + nl())
          sb_push(sb, "    pop r14" + nl())
          sb_push(sb, "    mov r15, rsp" + nl())
          sb_push(sb, "    sub rsp, 48" + nl())
          sb_push(sb, "    and rsp, -16" + nl())
          sb_push(sb, "    mov rcx, -11" + nl())
          sb_push(sb, "    call GetStdHandle" + nl())
          sb_push(sb, "    mov rcx, rax" + nl())
          sb_push(sb, "    mov rdx, r14" + nl())
          sb_push(sb, "    mov r8, r13" + nl())
          sb_push(sb, "    lea r9, [rel g_written]" + nl())
          sb_push(sb, "    mov qword [rsp+32], 0" + nl())
          sb_push(sb, "    call WriteFile" + nl())
          sb_push(sb, "    mov rsp, r15" + nl())
          sb_push(sb, "    push 0" + nl())
        else
          if name == "os_exit" then
            sb_push(sb, "    pop rcx" + nl())
            sb_push(sb, "    mov r15, rsp" + nl())
            sb_push(sb, "    sub rsp, 32" + nl())
            sb_push(sb, "    and rsp, -16" + nl())
            sb_push(sb, "    call ExitProcess" + nl())
          else
            print("codegen_x64: unsupported primitive (not a real function and not in the OS-boundary allowlist): " + name)
            return "UNSUPPORTED_PRIMITIVE_ERROR"
          end
        end
      end
      end
      end
      end
      end
      end
    end
  end
  end
  end
  return sb_str(sb)
end

# BuildList (Slice 4): the argc elements are already on the real stack
# in left-to-right pushed order (leftmost/element[0] deepest). Same
# [8-byte length][elements] block layout as strings, except each
# element is a plain qword (no byte-packing needed -- every PatLang
# value in this backend is already a qword, so a "list of anything" is
# trivially a list of qwords, including string/list addresses
# themselves). Allocates via an ordinary Call to rt_heap_alloc (same
# internal calling convention as any other function call), using r12
# (non-volatile, safe across that call) to hold the new list's address
# while the pushed elements get popped into it in reverse order.
make a function called x64_buildlist_asm takes argc returns asm
  let n = to_num(argc)
  let sb = sb_new()
  sb_push(sb, "    mov rax, " + (8 + n * 8) + nl())
  sb_push(sb, "    push rax" + nl())
  sb_push(sb, "    call rt_heap_alloc" + nl())
  sb_push(sb, "    add rsp, 8" + nl())
  sb_push(sb, "    mov r12, rax" + nl())
  sb_push(sb, "    mov qword [r12], " + n + nl())
  let k = n - 1
  while k >= 0 do
    sb_push(sb, "    pop rbx" + nl())
    sb_push(sb, "    mov [r12+" + (8 + k * 8) + "], rbx" + nl())
    let k = k - 1
  end
  sb_push(sb, "    push r12" + nl())
  return sb_str(sb)
end

# MakeClosure(func_name, captured_names) -- captured_names.length is
# compile-time known, so this unrolls exactly like x64_buildlist_asm.
# Block layout: [code address][captured count][captured values...].
make a function called x64_makeclosure_asm takes func_name, captured_names returns asm
  let n = to_num(list_len(captured_names))
  let sb = sb_new()
  sb_push(sb, "    mov rax, " + (16 + n * 8) + nl())
  sb_push(sb, "    push rax" + nl())
  sb_push(sb, "    call rt_heap_alloc" + nl())
  sb_push(sb, "    add rsp, 8" + nl())
  sb_push(sb, "    mov r12, rax" + nl())
  sb_push(sb, "    lea rax, [rel " + func_name + "]" + nl())
  sb_push(sb, "    mov [r12], rax" + nl())
  sb_push(sb, "    mov qword [r12+8], " + n + nl())
  let k = n - 1
  while k >= 0 do
    sb_push(sb, "    pop rbx" + nl())
    sb_push(sb, "    mov [r12+16+" + (8 * k) + "], rbx" + nl())
    let k = k - 1
  end
  sb_push(sb, "    push r12" + nl())
  return sb_str(sb)
end

# CallValue(argc) -- the closure's OWN captured count is a runtime
# value (read from the closure object itself), unlike everywhere else
# in this backend where instruction operands are compile-time known --
# see this file's own header for the full stack-shuffling explanation.
make a function called x64_callvalue_asm takes argc, locals returns asm
  let n = to_num(argc)
  # The current function's own private scratch slot, one past its last
  # named local (see x64_emit_func's frame_size reservation) -- used to
  # carry the closure's captured-count across the opaque `call` below,
  # since nothing about this backend's calling convention guarantees
  # any register survives a call, and a shared/global location would
  # be unsafe under recursion or a closure that itself calls another
  # closure before returning. Private to THIS activation's own rbp, so
  # every nested/recursive call gets its own independent copy for free.
  let cv_slot_offset = 8 * (to_num(list_len(locals)) + 1)
  let sb = sb_new()
  # 1. Pop the N already-pushed own-args into the scratch buffer, out
  #    of the way, so the closure's captured values can be pushed
  #    underneath where they belong first.
  let k = n - 1
  while k >= 0 do
    sb_push(sb, "    pop rax" + nl())
    sb_push(sb, "    lea rbx, [rel g_scratch]" + nl())
    sb_push(sb, "    mov [rbx+" + (8 * k) + "], rax" + nl())
    let k = k - 1
  end
  # 2. Pop the closure value itself (now on top).
  sb_push(sb, "    pop r14" + nl())
  sb_push(sb, "    mov r12, [r14]" + nl())
  sb_push(sb, "    mov r13, [r14+8]" + nl())
  sb_push(sb, "    mov [rbp-" + cv_slot_offset + "], r13" + nl())
  # 3. Push the closure's captured values, in order -- a genuine
  #    runtime loop, since r13 (captured count) isn't compile-time
  #    known here.
  let suffix = label_asm_safe(argc)
  sb_push(sb, "    xor rbx, rbx" + nl())
  sb_push(sb, "  .cv_loop_" + suffix + ":" + nl())
  sb_push(sb, "    cmp rbx, r13" + nl())
  sb_push(sb, "    jge .cv_done_" + suffix + nl())
  sb_push(sb, "    mov rax, [r14+16+rbx*8]" + nl())
  sb_push(sb, "    push rax" + nl())
  sb_push(sb, "    inc rbx" + nl())
  sb_push(sb, "    jmp .cv_loop_" + suffix + nl())
  sb_push(sb, "  .cv_done_" + suffix + ":" + nl())
  # 4. Push the own-args back on top, in original order.
  let i = 0
  while i < n do
    sb_push(sb, "    lea rbx, [rel g_scratch]" + nl())
    sb_push(sb, "    mov rax, [rbx+" + (8 * i) + "]" + nl())
    sb_push(sb, "    push rax" + nl())
    let i = i + 1
  end
  # 5. Indirect call, then clean up -- captured count is read back from
  #    THIS frame's own private slot (step 2), not from any register,
  #    since r12/r13/r14 are not guaranteed to survive the call.
  sb_push(sb, "    call r12" + nl())
  sb_push(sb, "    mov rdx, [rbp-" + cv_slot_offset + "]" + nl())
  sb_push(sb, "    add rdx, " + n + nl())
  sb_push(sb, "    shl rdx, 3" + nl())
  sb_push(sb, "    add rsp, rdx" + nl())
  sb_push(sb, "    push rax" + nl())
  return sb_str(sb)
end

# CallValue call sites need locally-unique NASM labels for their
# internal push-captured-values loop -- set_var-based counter, same
# pattern as the string-literal labels, since a program can contain
# more than one CallValue instruction.
make a function called label_asm_safe takes ignored returns label
  let n = to_num(get("__vars", "__x64_cv_counter"))
  set_var("__x64_cv_counter", n + 1)
  return "" + n
end

make a function called x64_emit_instr takes instr, func_name, locals, label, float_mode returns asm
  let sb = sb_new()
  sb_push(sb, label + ":" + nl())
  let ty = instr[0]
  if ty == "Const" then
    let kind = instr[1]
    if kind == "bool" then
      if instr[2] == "true" then
        sb_push(sb, "    mov rax, 1" + nl())
      else
        sb_push(sb, "    mov rax, 0" + nl())
      end
      sb_push(sb, "    push rax" + nl())
    else
      if kind == "str" then
        let label = x64_string_label_next()
        sb_push(sb, "    lea rax, [rel " + label + "]" + nl())
        sb_push(sb, "    push rax" + nl())
      else
        if float_mode then
          sb_push(sb, "    mov rax, __float64__(" + instr[2] + ")" + nl())
        else
          sb_push(sb, "    mov rax, " + instr[2] + nl())
        end
        sb_push(sb, "    push rax" + nl())
      end
    end
  else
    if ty == "Load" then
      let slot = x64_local_index(locals, instr[1])
      sb_push(sb, "    mov rax, [rbp-" + (8 * (slot + 1)) + "]" + nl())
      sb_push(sb, "    push rax" + nl())
    else
      if ty == "Store" then
        let slot = x64_local_index(locals, instr[1])
        sb_push(sb, "    pop rax" + nl())
        sb_push(sb, "    mov [rbp-" + (8 * (slot + 1)) + "], rax" + nl())
      else
        if ty == "Bin" then
          if float_mode then
            sb_push(sb, x64_binop_asm_float(instr[1]))
          else
            sb_push(sb, x64_binop_asm(instr[1]))
          end
        else
          if ty == "Jump" then
            sb_push(sb, "    jmp L_" + func_name + "_" + instr[1] + nl())
          else
            if ty == "JumpIfFalse" then
              sb_push(sb, "    pop rax" + nl())
              sb_push(sb, "    cmp rax, 0" + nl())
              sb_push(sb, "    je L_" + func_name + "_" + instr[1] + nl())
            else
              if ty == "CallHost" then
                sb_push(sb, x64_callhost_asm(instr[1], instr[2]))
              else
                if ty == "Call" then
                  sb_push(sb, "    call " + instr[1] + nl())
                  let argc = to_num(instr[2])
                  if argc > 0 then
                    sb_push(sb, "    add rsp, " + (argc * 8) + nl())
                  end
                  sb_push(sb, "    push rax" + nl())
                else
                  if ty == "BuildList" then
                    sb_push(sb, x64_buildlist_asm(instr[1]))
                  else
                  if ty == "MakeClosure" then
                    sb_push(sb, x64_makeclosure_asm(instr[1], instr[2]))
                  else
                  if ty == "CallValue" then
                    sb_push(sb, x64_callvalue_asm(instr[1], locals))
                  else
                  if ty == "Return" then
                    if func_name == "main" then
                      sb_push(sb, "    mov r15, rsp" + nl())
                      sb_push(sb, "    sub rsp, 32" + nl())
                      sb_push(sb, "    and rsp, -16" + nl())
                      sb_push(sb, "    mov rcx, 0" + nl())
                      sb_push(sb, "    call ExitProcess" + nl())
                    else
                      sb_push(sb, "    pop rax" + nl())
                      sb_push(sb, "    leave" + nl())
                      sb_push(sb, "    ret" + nl())
                    end
                  else
                    print("codegen_x64: unsupported IR instruction for Slice 1: " + ty)
                    return "UNSUPPORTED_INSTR_ERROR"
                  end
                  end
                  end
                  end
                end
              end
            end
          end
        end
      end
    end
  end
  return sb_str(sb)
end

# ---- one function -> nasm text ----

# ---- Slice 6: a narrowly, safely scoped register-usage win ----
#
# NOT a general register allocator -- that needs real liveness
# analysis with control-flow-merge-point consistency, a much larger
# and riskier undertaking. Instead: recognize the single most common
# wasteful pattern, `Const num` immediately followed by `Bin op`
# (loop counters, comparisons against a fixed bound -- `i + 1`,
# `i < 10`, extremely common in real code), and collapse the
# push-then-pop round-trip into ONE instruction using the constant as
# an immediate operand, which x86 supports directly for add/sub/imul/
# cmp. `/` and `%` are excluded -- `idiv` has no immediate-operand
# form, so fusing them would need to load the constant into a register
# first anyway, defeating the point.
#
# SAFETY: this is only correct if nothing can jump directly into the
# MIDDLE of the fused pair (skipping the Const's own contribution) --
# so fusion only fires when the Bin instruction's own index is NOT a
# jump target anywhere in the function. x64_collect_jump_targets scans
# every Jump/JumpIfFalse in the function once per call to check this.

make a function called x64_collect_jump_targets takes instrs returns targets
  let targets = []
  let n = to_num(list_len(instrs))
  let i = 0
  while i < n do
    let instr = instrs[i]
    if instr[0] == "Jump" then
      let targets = list_push(targets, to_num(instr[1]))
    else
      if instr[0] == "JumpIfFalse" then
        let targets = list_push(targets, to_num(instr[1]))
      end
    end
    let i = i + 1
  end
  return targets
end

make a function called x64_is_jump_target takes targets, idx returns yes
  let n = to_num(list_len(targets))
  let i = 0
  while i < n do
    if targets[i] == idx then
      return true
    end
    let i = i + 1
  end
  return false
end

make a function called x64_fusable_binop takes op returns yes
  if op == "/" then
    return false
  end
  if op == "%" then
    return false
  end
  return true
end

# The fused Const+Bin sequence: pop the LEFT operand (already on the
# stack from whatever came before the Const), operate against the
# constant as an immediate, push the result. Same result-in-rax/push
# convention as x64_binop_asm, just without ever materializing the
# constant to the stack at all.
make a function called x64_fused_const_binop_asm takes const_text, op returns asm
  let sb = sb_new()
  sb_push(sb, "    pop rax" + nl())
  if op == "+" then
    sb_push(sb, "    add rax, " + const_text + nl())
  else
    if op == "-" then
      sb_push(sb, "    sub rax, " + const_text + nl())
    else
      if op == "*" then
        sb_push(sb, "    imul rax, rax, " + const_text + nl())
      else
        sb_push(sb, "    cmp rax, " + const_text + nl())
        if op == "==" then
          sb_push(sb, "    sete al" + nl())
        else
          if op == "!=" then
            sb_push(sb, "    setne al" + nl())
          else
            if op == "<" then
              sb_push(sb, "    setl al" + nl())
            else
              if op == "<=" then
                sb_push(sb, "    setle al" + nl())
              else
                if op == ">" then
                  sb_push(sb, "    setg al" + nl())
                else
                  sb_push(sb, "    setge al" + nl())
                end
              end
            end
          end
        end
        sb_push(sb, "    movzx rax, al" + nl())
      end
    end
  end
  sb_push(sb, "    push rax" + nl())
  return sb_str(sb)
end

make a function called x64_emit_func takes func, float_mode returns asm
  let func_name = func[1]
  let params = func[2]
  let instrs = func[3]
  let locals = x64_collect_locals(func)
  # +1 extra slot beyond the named locals, ALWAYS reserved, for
  # CallValue's own per-frame scratch (see x64_callvalue_asm) -- a
  # value that must survive an opaque `call` this backend's own
  # calling convention gives no register-preservation guarantee
  # across. Using a private slot in the CURRENT function's own stack
  # frame (not a shared/global location) makes it safe under
  # recursion/re-entrancy for free: every active call gets its own
  # rbp, so every active call's copy of this slot is independent.
  let frame_size = 8 * (to_num(list_len(locals)) + 1)
  if frame_size < 16 then
    let frame_size = 16
  end
  let sb = sb_new()
  sb_push(sb, func_name + ":" + nl())
  sb_push(sb, "    push rbp" + nl())
  sb_push(sb, "    mov rbp, rsp" + nl())
  sb_push(sb, "    sub rsp, " + frame_size + nl())
  let argc = to_num(list_len(params))
  let p = 0
  while p < argc do
    let src_offset = 16 + 8 * (argc - 1 - p)
    sb_push(sb, "    mov rax, [rbp+" + src_offset + "]" + nl())
    sb_push(sb, "    mov [rbp-" + (8 * (p + 1)) + "], rax" + nl())
    let p = p + 1
  end
  let n = to_num(list_len(instrs))
  let jump_targets = x64_collect_jump_targets(instrs)
  let i = 0
  while i < n do
    let instr = instrs[i]
    let fused = false
    if not float_mode then
      if i + 1 < n then
        let next = instrs[i + 1]
        if instr[0] == "Const" then
          if instr[1] == "num" then
            if next[0] == "Bin" then
              if x64_fusable_binop(next[1]) then
                if not x64_is_jump_target(jump_targets, i + 1) then
                  let fused = true
                end
              end
            end
          end
        end
      end
    end
    if fused then
      sb_push(sb, "L_" + func_name + "_" + i + ":" + nl())
      sb_push(sb, "L_" + func_name + "_" + (i + 1) + ":" + nl())
      sb_push(sb, x64_fused_const_binop_asm(instr[2], instrs[i + 1][1]))
      let i = i + 2
    else
      let label = "L_" + func_name + "_" + i
      sb_push(sb, x64_emit_instr(instr, func_name, locals, label, float_mode))
      let i = i + 1
    end
  end
  return sb_str(sb)
end

# ---- whole program -> nasm text ----

# A small local substring check -- NOT lib/x64_build.patlang's
# x64_build_contains (a different file; this backend's own driver
# scripts include only THIS file, so it needs its own copy, same
# reasoning x64_build.patlang used for not depending on lib/
# test.patlang's contains_text).
make a function called x64_contains takes hay, needle returns r
  let hn = to_num(sc_len(str_intern(hay)))
  let nn = to_num(sc_len(str_intern(needle)))
  if nn > hn then
    return false
  end
  let i = 0
  while i <= hn - nn do
    if substr(hay, i, nn) == needle then
      return true
    end
    let i = i + 1
  end
  return false
end

# Whole-program float-mode detection (Slice 7) -- see this file's own
# header for why this is a WHOLE-PROGRAM decision, not per-value.
# Scoped PER-FUNCTION, not whole-program: an earlier draft scanned the
# entire program (including the PatLang-authored runtime prelude that
# gets concatenated ahead of every user program), which silently broke
# rt_print_i64's own digit-extraction `%`/`/` the moment ANY float
# literal appeared anywhere in a program, since one shared flag forced
# EVERY function's Bin instructions -- including the runtime's -- into
# float mode. A function's own float-ness is still a whole-FUNCTION
# decision (no per-value type tagging), just no longer a whole-program
# one -- each function is independently plain-int or all-float based
# on whether ITS OWN body contains a float literal.
make a function called x64_func_is_float takes func returns yes
  let instrs = func[3]
  let i = 0
  let n = to_num(list_len(instrs))
  while i < n do
    let instr = instrs[i]
    if instr[0] == "Const" then
      if instr[1] == "num" then
        if x64_contains(instr[2], ".") then
          return true
        end
      end
    end
    let i = i + 1
  end
  return false
end

make a function called emit_program_x64 takes ir returns asm
  let funcs = ir[2]
  let sb = sb_new()
  sb_push(sb, "default rel" + nl())
  sb_push(sb, "global main" + nl())
  sb_push(sb, "extern GetStdHandle, WriteFile, ExitProcess" + nl())
  sb_push(sb, nl())
  sb_push(sb, "section .bss" + nl())
  sb_push(sb, "    align 8" + nl())
  sb_push(sb, "    g_written resd 1" + nl())
  sb_push(sb, "    align 8" + nl())
  sb_push(sb, "    g_scratch resb 256" + nl())
  sb_push(sb, "    align 8" + nl())
  sb_push(sb, "    g_heap_state resq 1" + nl())
  sb_push(sb, "    align 16" + nl())
  sb_push(sb, "    g_heap resb 16777216" + nl())
  sb_push(sb, nl())
  sb_push(sb, "section .data" + nl())
  sb_push(sb, "    align 8" + nl())
  sb_push(sb, x64_collect_string_data(ir))
  sb_push(sb, nl())
  sb_push(sb, "section .text" + nl())
  sb_push(sb, nl())
  x64_string_label_reset()
  let n = to_num(list_len(funcs))
  let i = 0
  while i < n do
    sb_push(sb, x64_emit_func(funcs[i], x64_func_is_float(funcs[i])))
    sb_push(sb, nl())
    let i = i + 1
  end
  return sb_str(sb)
end
