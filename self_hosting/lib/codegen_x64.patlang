  sb_push(sb, ".recv_ok_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    mov qword [rel g_last_recv_error], 0" + x64_nl_char())
  sb_push(sb, "    mov qword [r13], rax" + x64_nl_char())
