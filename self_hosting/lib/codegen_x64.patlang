  sb_push(sb, "    add rdi, rbx" + x64_nl_char())
  sb_push(sb, "    imul rdi, r10" + x64_nl_char())
  sb_push(sb, "    add rdi, rdx" + x64_nl_char())
  sb_push(sb, "    imul rdi, 4" + x64_nl_char())
  sb_push(sb, "    add rdi, r8" + x64_nl_char())
