  sb_push(sb, "    mov [rax+32+r8*8], r9" + x64_nl_char())
  sb_push(sb, "    inc r8" + x64_nl_char())
  sb_push(sb, "    jmp .ts_copy_" + suffix + x64_nl_char())
  sb_push(sb, "  .ts_copy_done_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    mov r12, rax" + x64_nl_char())
  sb_push(sb, "    mov r15, rsp" + x64_nl_char())
  sb_push(sb, "    sub rsp, 48" + x64_nl_char())
  sb_push(sb, "    and rsp, -16" + x64_nl_char())
  sb_push(sb, "    xor rcx, rcx" + x64_nl_char())
