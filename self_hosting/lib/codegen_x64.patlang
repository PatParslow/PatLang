# ---- Math library (interp.patlang-compilation roadmap #25, the layer
# past Stage 0/A/B's networking/process gaps): sqrt/sin/cos/tan/asin/
# acos/atan/log/exp/pow/atan2/abs/ceil/round/trunc, all real calls into
# the C runtime math library (msvcrt/ucrtbase, already linked by gcc's
# own default libs) -- the SAME underlying libm every real host_sin/
# host_sqrt/etc (rust-runtime/src/ir/hosts.rs) delegates to via Rust's
# f64 methods, so results are bit-for-bit comparable, not an
# approximation of our own.
#
# Deliberately narrower than the real hosts: this backend represents
# floats as a raw f64 bit pattern with NO separate tag (float_mode is a
# per-FUNCTION classification, "ALL int or ALL float", not a per-value
# tag -- see this file's own float_mode header) -- x64_math1_asm/
# x64_math2_asm assume their operand(s) are genuine float bit patterns
# already (the realistic case: calling sin/sqrt/etc. usefully already
# requires being in a float_mode function). x64_abs_asm/
# x64_roundlike_asm are the exception: abs/ceil/round/trunc are
# genuinely common on PLAIN INTS too (real host_abs/round_like return
# Int/BigInt input UNCHANGED, only actually computing for Float/
# Rational), so those two classify their operand at runtime via the
# same round-trip-through-48-bit-sign-extension test used throughout
# this file, and take the int-identity fast path when it's a genuine
# fixnum. BigInt/Rational/Complex inputs to any of these are NOT
# handled (the real hosts' exact-arithmetic branches for those aren't
# replicated here) -- a real, honest, but scoped-down implementation,
# not a stub.

make a function called x64_math1_asm takes cfunc returns asm
  let sb = sb_new()
  sb_push(sb, "    pop rax" + x64_nl_char())
  sb_push(sb, "    movq xmm0, rax" + x64_nl_char())
  sb_push(sb, "    mov r15, rsp" + x64_nl_char())
  sb_push(sb, "    sub rsp, 32" + x64_nl_char())
  sb_push(sb, "    and rsp, -16" + x64_nl_char())
  sb_push(sb, "    call " + cfunc + x64_nl_char())
  sb_push(sb, "    mov rsp, r15" + x64_nl_char())
  sb_push(sb, "    movq rax, xmm0" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  return sb_str(sb)
end

# 2-arg: args pushed in written order (pow(base,exp) -> base pushed
# first, exp on top; atan2(y,x) -> y pushed first, x on top), matching
# each C function's own (arg1, arg2) parameter order (xmm0, xmm1).
make a function called x64_math2_asm takes cfunc returns asm
