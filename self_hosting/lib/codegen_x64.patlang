# os_recv(sock) -> tagged string (0..65536 bytes read). Also records
# whether the recv itself failed into g_last_recv_error (read
# separately by os_recv_had_error) -- tcp_read (fatal on a genuine
# error) and tcp_read_or_empty (never fatal) share this ONE raw
# primitive and diverge purely in the ordinary-PatLang wrapper, per
# this backend's usual split of responsibility.
make a function called x64_os_recv_asm returns asm
  let suffix = label_asm_safe(0)
  let sb = sb_new()
  sb_push(sb, "    pop rax" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  sb_push(sb, "    mov rax, 65544" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  sb_push(sb, "    call rt_heap_alloc" + x64_nl_char())
  sb_push(sb, "    add rsp, 8" + x64_nl_char())
  sb_push(sb, "    mov r13, rax" + x64_nl_char())
  sb_push(sb, "    pop rax" + x64_nl_char())
  sb_push(sb, "    mov r12, rax" + x64_nl_char())
  sb_push(sb, "    mov r15, rsp" + x64_nl_char())
  sb_push(sb, "    sub rsp, 32" + x64_nl_char())
  sb_push(sb, "    and rsp, -16" + x64_nl_char())
  sb_push(sb, "    mov rcx, r12" + x64_nl_char())
  sb_push(sb, "    lea rdx, [r13+8]" + x64_nl_char())
  sb_push(sb, "    mov r8, 65536" + x64_nl_char())
  sb_push(sb, "    xor r9, r9" + x64_nl_char())
  sb_push(sb, "    call recv" + x64_nl_char())
  sb_push(sb, "    mov rsp, r15" + x64_nl_char())
  # REAL BUG FOUND AND FIXED (canvas_host's networking feature: a real
  # client's recv on an empty non-blocking socket was silently treated
  # as a SUCCESSFUL 4294967295-byte read instead of "no data yet"):
  # recv() returns a 32-bit `int` (SOCKET_ERROR = -1 as a 32-bit
  # value), but this compared the FULL 64-bit rax against a 64-bit-
  # sign-extended -1 (0xFFFFFFFFFFFFFFFF). When the upper 32 bits of
  # rax come back zero (recv()'s own actual, observed behavior on this
  # system), a genuine WSAEWOULDBLOCK failure left rax holding
  # 0x00000000FFFFFFFF, which is NOT equal to the 64-bit sentinel --
  # so the "ok" branch ran, storing that same 0xFFFFFFFF as the read
  # length. The very next real-client test hit this exact path (an
  # empty poll immediately after accept, before the client had sent
  # anything) and the server tried to process a ~4GB "chunk", crashing.
  # Fixed by comparing/storing via eax (the real 32-bit return value),
  # not rax -- movzx additionally guards the SUCCESS path against any
  # future callee that doesn't zero-extend its own upper bits.
  sb_push(sb, "    cmp eax, 0 - 1" + x64_nl_char())
  sb_push(sb, "    jne .recv_ok_" + suffix + x64_nl_char())
  sb_push(sb, "    mov qword [rel g_last_recv_error], 1" + x64_nl_char())
  sb_push(sb, "    mov qword [r13], 0" + x64_nl_char())
  sb_push(sb, "    jmp .recv_done_" + suffix + x64_nl_char())
  sb_push(sb, ".recv_ok_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    mov qword [rel g_last_recv_error], 0" + x64_nl_char())
  sb_push(sb, "    movzx rax, eax" + x64_nl_char())
  sb_push(sb, "    mov qword [r13], rax" + x64_nl_char())
  sb_push(sb, ".recv_done_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    mov rax, r13" + x64_nl_char())
  sb_push(sb, "    mov rcx, 2305843009213693952" + x64_nl_char())
  sb_push(sb, "    or rax, rcx" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  return sb_str(sb)
end

