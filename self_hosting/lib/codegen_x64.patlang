# os_exec_run(cmdline_addr, cmdline_len) -> captured combined stdout+
# stderr as a plain (untagged) address of a freshly rt_heap_alloc'd
# [length][bytes] block -- caller (rt_os_exec_run wrapper, folded
# directly into the CallHost site below) tags it. Real CreateProcessA
# + CreatePipe process-creation-with-redirected-output sequence, the
# standard MSDN pattern (create an inheritable pipe, clear inherit on
# OUR copy of the read end via SetHandleInformation so only the
# child's copy of the write end matters, redirect both hStdOutput and
# hStdError to the write end, close our copy of the write end
# immediately after CreateProcessA so ReadFile on the read end
# terminates instead of blocking forever once the child exits).
#
# Stack layout for this one persistent aligned rsp (all offsets fixed
# for the whole primitive): [0..31] shadow space, [32..79] scratch
# reserved for whichever call's OWN stack-passed args need it that
# moment (CreateProcessA's 6 stack args are the only ones that need
# this much) -- NEVER used for persistent data, since a later call's
# stack-arg write would clobber anything stored there. Persistent
# structs live ABOVE that: SECURITY_ATTRIBUTES @80, read/write pipe
# handle slots @104/@112, STARTUPINFOA @128 (104 bytes),
# PROCESS_INFORMATION @240 (24 bytes), bytesRead scratch @272.
# exec_capture(path, arg1, ..., argN) -- this call SITE's own argc is
# compile-time known (every CallHost site's is), so the N tagged-
# string args are popped (compile-time unrolled, same "pop N values
# into a heap block" pattern x64_buildlist_asm already uses) into a
# temp array, joined via the ordinary PatLang rt_exec_join_args, then
# handed to the real OS-boundary os_exec_run primitive. Only the
# process-creation/pipe part is raw assembly; the variadic-argument
# handling stays in PatLang/this array-popping helper, not hand-
# written asm, matching this backend's whole "runtime logic belongs
# in PatLang, native primitives stay narrow" philosophy.
make a function called x64_exec_capture_asm takes argc returns asm
  let n = to_num(argc)
  let sb = sb_new()
  sb_push(sb, "    mov rax, " + (n * 8) + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  sb_push(sb, "    call rt_heap_alloc" + x64_nl_char())
  sb_push(sb, "    add rsp, 8" + x64_nl_char())
  sb_push(sb, "    mov r12, rax" + x64_nl_char())
  let k = n - 1
  while k >= 0 do
    sb_push(sb, "    pop r10" + x64_nl_char())
    sb_push(sb, "    mov [r12+" + (k * 8) + "], r10" + x64_nl_char())
    let k = k - 1
  end
  sb_push(sb, "    push r12" + x64_nl_char())
  sb_push(sb, "    push " + n + x64_nl_char())
  sb_push(sb, "    call rt_exec_join_args" + x64_nl_char())
  sb_push(sb, "    add rsp, 16" + x64_nl_char())
  sb_push(sb, "    mov r13, rax" + x64_nl_char())
  sb_push(sb, "    mov r15, 281474976710655" + x64_nl_char())
  sb_push(sb, "    and r13, r15" + x64_nl_char())
  sb_push(sb, "    mov rax, [r13]" + x64_nl_char())
  sb_push(sb, "    lea r10, [r13+8]" + x64_nl_char())
  sb_push(sb, "    push r10" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  sb_push(sb, x64_os_exec_run_asm())
  sb_push(sb, "    pop rax" + x64_nl_char())
  sb_push(sb, "    mov r15, 2305843009213693952" + x64_nl_char())
  sb_push(sb, "    or rax, r15" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  return sb_str(sb)
end

make a function called x64_os_exec_run_asm returns asm
  let suffix = label_asm_safe(0)
  let sb = sb_new()
  # Real bug caught before testing (this backend's OWN calling
  # convention -- used by the upcoming rt_heap_alloc call below --
  # gives NO register-preservation guarantee across calls, an already-
  # established fact from the closures work). cmdline_addr/cmdline_len
  # must survive that call, so they're saved on the REAL machine
  # stack (genuine memory, unaffected by any register-clobbering
  # callee) via push/pop, not left sitting in a register across the
  # call.
  sb_push(sb, "    pop r10" + x64_nl_char())
  sb_push(sb, "    pop rax" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  sb_push(sb, "    push r10" + x64_nl_char())
  sb_push(sb, "    mov rax, r10" + x64_nl_char())
  sb_push(sb, "    add rax, 1" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  sb_push(sb, "    call rt_heap_alloc" + x64_nl_char())
  sb_push(sb, "    add rsp, 8" + x64_nl_char())
  sb_push(sb, "    mov r14, rax" + x64_nl_char())
  sb_push(sb, "    pop r10" + x64_nl_char())
  sb_push(sb, "    pop rax" + x64_nl_char())
  # rax = cmdline_addr, r10 = cmdline_len, r14 = fresh buffer -- copy
  # into it and null-terminate (CreateProcessA mutates its
  # lpCommandLine argument in place, so it can never point directly at
  # our own heap string's bytes). NOW set up the win64-ABI-call
  # alignment window -- r14 (a genuine callee-saved register under the
  # REAL Win32 ABI, unlike this backend's own convention) safely
  # survives every call from here on.
  sb_push(sb, "    mov r15, rsp" + x64_nl_char())
  sb_push(sb, "    sub rsp, 344" + x64_nl_char())
  sb_push(sb, "    and rsp, -16" + x64_nl_char())
  # [rsp+280]: a dedicated save slot for the CALLER's rbx (see the read
  # loop's own header comment below for why this function needs rbx at
  # all now). A fixed memory slot within this function's own already-
  # established frame, not a push/pop -- avoids shifting every other
  # already-correct [rsp+N] offset used throughout this function by 8.
  sb_push(sb, "    mov [rsp+280], rbx" + x64_nl_char())
  sb_push(sb, "    xor rsi, rsi" + x64_nl_char())
  sb_push(sb, "  .exec_cpy_loop_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    cmp rsi, r10" + x64_nl_char())
  sb_push(sb, "    jge .exec_cpy_done_" + suffix + x64_nl_char())
  sb_push(sb, "    mov dl, [rax+rsi]" + x64_nl_char())
  sb_push(sb, "    mov [r14+rsi], dl" + x64_nl_char())
  sb_push(sb, "    inc rsi" + x64_nl_char())
  sb_push(sb, "    jmp .exec_cpy_loop_" + suffix + x64_nl_char())
  sb_push(sb, "  .exec_cpy_done_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    mov byte [r14+rsi], 0" + x64_nl_char())
  # SECURITY_ATTRIBUTES @80: nLength=24, lpSecurityDescriptor=0, bInheritHandle=1
  sb_push(sb, "    mov qword [rsp+80], 24" + x64_nl_char())
  sb_push(sb, "    mov qword [rsp+88], 0" + x64_nl_char())
  sb_push(sb, "    mov qword [rsp+96], 1" + x64_nl_char())
  sb_push(sb, "    lea rcx, [rsp+104]" + x64_nl_char())
  sb_push(sb, "    lea rdx, [rsp+112]" + x64_nl_char())
  sb_push(sb, "    lea r8, [rsp+80]" + x64_nl_char())
  sb_push(sb, "    xor r9, r9" + x64_nl_char())
  sb_push(sb, "    call CreatePipe" + x64_nl_char())
  sb_push(sb, "    mov rcx, [rsp+104]" + x64_nl_char())
  sb_push(sb, "    mov rdx, 1" + x64_nl_char())
  sb_push(sb, "    xor r8, r8" + x64_nl_char())
  sb_push(sb, "    call SetHandleInformation" + x64_nl_char())
  # Zero the whole STARTUPINFOA (104 bytes = 13 qwords) before setting
