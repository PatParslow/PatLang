  # an incidental nibble-matching constant like family_mask.
  sb_push(sb, "    mov rax, [rbp-" + dyn_a + "]" + x64_nl_char())
  sb_push(sb, "    cmp rax, 0" + x64_nl_char())
  sb_push(sb, "    je .DYN_FAMOK1_" + suffix + x64_nl_char())
  sb_push(sb, "    mov rcx, rax" + x64_nl_char())
  sb_push(sb, "    shl rcx, 16" + x64_nl_char())
  sb_push(sb, "    sar rcx, 16" + x64_nl_char())
  sb_push(sb, "    cmp rcx, rax" + x64_nl_char())
  sb_push(sb, "    je .DYN_FAMOK1_" + suffix + x64_nl_char())
  sb_push(sb, "    mov r15, 17293822569102704640" + x64_nl_char())
  sb_push(sb, "    and rax, r15" + x64_nl_char())
  sb_push(sb, "    mov rcx, 1152921504606846976" + x64_nl_char())
  sb_push(sb, "    cmp rax, rcx" + x64_nl_char())
  sb_push(sb, "    jne .DYN_OBJ_" + suffix + x64_nl_char())
  sb_push(sb, ".DYN_FAMOK1_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    mov r10, [rbp-" + dyn_b + "]" + x64_nl_char())
  sb_push(sb, "    cmp r10, 0" + x64_nl_char())
  sb_push(sb, "    je .DYN_FAMOK2_" + suffix + x64_nl_char())
  sb_push(sb, "    mov rcx, r10" + x64_nl_char())
  sb_push(sb, "    shl rcx, 16" + x64_nl_char())
  sb_push(sb, "    sar rcx, 16" + x64_nl_char())
  sb_push(sb, "    cmp rcx, r10" + x64_nl_char())
  sb_push(sb, "    je .DYN_FAMOK2_" + suffix + x64_nl_char())
  sb_push(sb, "    mov r15, 17293822569102704640" + x64_nl_char())
  sb_push(sb, "    and r10, r15" + x64_nl_char())
  sb_push(sb, "    mov rcx, 1152921504606846976" + x64_nl_char())
  sb_push(sb, "    cmp r10, rcx" + x64_nl_char())
  sb_push(sb, "    jne .DYN_OBJ_" + suffix + x64_nl_char())
  sb_push(sb, ".DYN_FAMOK2_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    mov r15, 18446462598732840960" + x64_nl_char())
  sb_push(sb, "    mov rax, [rbp-" + dyn_a + "]" + x64_nl_char())
  sb_push(sb, "    and rax, r15" + x64_nl_char())
  sb_push(sb, "    mov r10, [rbp-" + dyn_b + "]" + x64_nl_char())
  sb_push(sb, "    and r10, r15" + x64_nl_char())
  sb_push(sb, "    mov rcx, 1157425104234217472" + x64_nl_char())
  sb_push(sb, "    cmp rax, rcx" + x64_nl_char())
  sb_push(sb, "    je .DYN_IVAL_" + suffix + x64_nl_char())
  sb_push(sb, "    cmp r10, rcx" + x64_nl_char())
  sb_push(sb, "    je .DYN_IVAL_" + suffix + x64_nl_char())
  sb_push(sb, "    mov rcx, 1154891829443821568" + x64_nl_char())
  sb_push(sb, "    cmp rax, rcx" + x64_nl_char())
  sb_push(sb, "    je .DYN_CPLX_" + suffix + x64_nl_char())
  sb_push(sb, "    cmp r10, rcx" + x64_nl_char())
  sb_push(sb, "    je .DYN_CPLX_" + suffix + x64_nl_char())
  sb_push(sb, "    mov rcx, 1153765929536978944" + x64_nl_char())
  sb_push(sb, "    cmp rax, rcx" + x64_nl_char())
  sb_push(sb, "    je .DYN_RAT_" + suffix + x64_nl_char())
  sb_push(sb, "    cmp r10, rcx" + x64_nl_char())
  sb_push(sb, "    je .DYN_RAT_" + suffix + x64_nl_char())
  sb_push(sb, x64_dynamic_promote_both_asm(suffix + "N", spilled))
  if x64_is_dynamic_cmp_op(op) then
