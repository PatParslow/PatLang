  sb_push(sb, "    mov rdx, [rax+8]" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  sb_push(sb, "    push rcx" + x64_nl_char())
  sb_push(sb, "    push rdx" + x64_nl_char())
  sb_push(sb, "    mov r10, rdx" + x64_nl_char())
  sb_push(sb, "    shl r10, 3" + x64_nl_char())
  sb_push(sb, "    add r10, 32" + x64_nl_char())
  sb_push(sb, "    push r10" + x64_nl_char())
  sb_push(sb, "    call rt_heap_alloc" + x64_nl_char())
  sb_push(sb, "    add rsp, 8" + x64_nl_char())
  sb_push(sb, "    pop rdx" + x64_nl_char())
  sb_push(sb, "    pop rcx" + x64_nl_char())
  sb_push(sb, "    pop r10" + x64_nl_char())
