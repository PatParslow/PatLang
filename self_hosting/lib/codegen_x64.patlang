  # extension test used throughout this file.
  sb_push(sb, "    mov rax, [rbp-" + dyn_a + "]" + x64_nl_char())
  sb_push(sb, "    cmp rax, 0" + x64_nl_char())
  sb_push(sb, "    je .DIV_FAMOK1_" + suffix + x64_nl_char())
  sb_push(sb, "    mov rcx, rax" + x64_nl_char())
  sb_push(sb, "    shl rcx, 16" + x64_nl_char())
  sb_push(sb, "    sar rcx, 16" + x64_nl_char())
  sb_push(sb, "    cmp rcx, rax" + x64_nl_char())
  sb_push(sb, "    jne .DIV_SLOW_" + suffix + x64_nl_char())
  sb_push(sb, ".DIV_FAMOK1_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    mov r10, [rbp-" + dyn_b + "]" + x64_nl_char())
  sb_push(sb, "    cmp r10, 0" + x64_nl_char())
  sb_push(sb, "    je .DIV_FAMOK2_" + suffix + x64_nl_char())
  sb_push(sb, "    mov rcx, r10" + x64_nl_char())
  sb_push(sb, "    shl rcx, 16" + x64_nl_char())
  sb_push(sb, "    sar rcx, 16" + x64_nl_char())
  sb_push(sb, "    cmp rcx, r10" + x64_nl_char())
  sb_push(sb, "    jne .DIV_SLOW_" + suffix + x64_nl_char())
  sb_push(sb, ".DIV_FAMOK2_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    mov rax, [rbp-" + dyn_a + "]" + x64_nl_char())
  sb_push(sb, "    shl rax, 16" + x64_nl_char())
  sb_push(sb, "    sar rax, 16" + x64_nl_char())
  sb_push(sb, "    mov r10, [rbp-" + dyn_b + "]" + x64_nl_char())
  sb_push(sb, "    shl r10, 16" + x64_nl_char())
  sb_push(sb, "    sar r10, 16" + x64_nl_char())
  sb_push(sb, "    cqo" + x64_nl_char())
  sb_push(sb, "    idiv r10" + x64_nl_char())
  sb_push(sb, "    cmp rdx, 0" + x64_nl_char())
  sb_push(sb, "    jne .DIV_INEXACT_" + suffix + x64_nl_char())
  # Same masking bug as the mod path: `and rax, PAYLOAD_MASK` strips
  # sign-extension off a NEGATIVE exact quotient. rax is already the
  # correctly sign-extended plain-int result, no masking needed.
  sb_push(sb, "    jmp .DIV_DONE_" + suffix + x64_nl_char())
  sb_push(sb, ".DIV_INEXACT_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    mov rax, [rbp-" + dyn_a + "]" + x64_nl_char())
  sb_push(sb, "    shl rax, 16" + x64_nl_char())
  sb_push(sb, "    sar rax, 16" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  sb_push(sb, "    mov rax, [rbp-" + dyn_b + "]" + x64_nl_char())
  sb_push(sb, "    shl rax, 16" + x64_nl_char())
  sb_push(sb, "    sar rax, 16" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  sb_push(sb, "    call rt_rational_new" + x64_nl_char())
  sb_push(sb, "    add rsp, 16" + x64_nl_char())
  sb_push(sb, "    jmp .DIV_DONE_" + suffix + x64_nl_char())
  sb_push(sb, ".DIV_SLOW_" + suffix + ":" + x64_nl_char())
  sb_push(sb, x64_dynamic_promote_both_rational_asm(suffix, spilled))
  sb_push(sb, "    push qword [rbp-" + dyn_a + "]" + x64_nl_char())
  sb_push(sb, "    push qword [rbp-" + dyn_b + "]" + x64_nl_char())
  sb_push(sb, "    call rt_rational_div" + x64_nl_char())
  sb_push(sb, "    add rsp, 16" + x64_nl_char())
  sb_push(sb, ".DIV_DONE_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  return sb_str(sb)
end

# Dynamic-mode `%`, dispatched separately like `/` (not through
# x64_dynamic_op_supported's generic table). Fast path (both operands
# genuine fixnums) is exact and correct: `idiv`'s remainder, truncated
# toward zero, matching the plain-int `%` path used outside dynamic-
# mode functions. Slow path (either operand is BigInt/Rational/Complex/
# Interval) has NO runtime implementation to fall back to yet -- unlike
# `/`, which can always promote to Rational, `%` on an arbitrary-
# precision BigInt genuinely needs bigint long-division (rt_bigint_div
# doesn't exist at all yet, only add/sub/mul/cmp), and Rational/Complex/
# Interval modulo isn't a meaningful defined operation in this tower at
# all. Deliberately a hard, distinctive-exit-code runtime trap here
# rather than silently falling through to plain int semantics on a
# raw tagged pointer (the previous behavior for ALL non-`/` ops
# outside x64_dynamic_op_supported's table) -- this is exactly the
# "clear error, not silently wrong output" invariant patc1_main.patlang
# documents for the whole backend; fixnum `%` (the overwhelmingly
# common case, including plain-int `%` inside a function that merely
# also happens to touch BigInt elsewhere) still works correctly.
make a function called x64_binop_asm_mod_dynamic takes spilled returns asm
  let dyn_a = 8 * (to_num(list_len(spilled)) + 2)
  let dyn_b = 8 * (to_num(list_len(spilled)) + 3)
  let suffix = label_asm_safe(0)
  let sb = sb_new()
  sb_push(sb, "    pop qword [rbp-" + dyn_b + "]" + x64_nl_char())
  sb_push(sb, "    pop qword [rbp-" + dyn_a + "]" + x64_nl_char())
  # Real bug found (exposed once the fixnum-overflow-to-BigInt fix made
  # an ordinary int loop's own `+`/`-`/`*` unconditional taint sources,
  # routing a ONCE-dormant plain `acc % N` through this dynamic path for
  # the first time on real programs): this used to test "is this operand
  # a plausible fixnum" via `top-16-bits-all-zero`, which is WRONG for a
  # genuine NEGATIVE fixnum (sign extension legitimately sets those bits
  # too) -- any negative intermediate value (e.g. `0 - 1`) wrongly fell
  # to `.MOD_UNSUPPORTED_`'s `os_exit(97)` trap, exhausting nothing but
  # exiting hard on perfectly ordinary arithmetic. Fixed to the SAME
  # "does it round-trip through a real 48-bit sign extension" test
  # `x64_binop_asm_dynamic`'s own NOTFAST branch already uses -- true for
  # a genuine fixnum (positive or negative), false only for an actually-
  # tagged (BigInt/Rational/...) value, which is the real "unsupported"
  # case this trap is meant to catch.
  sb_push(sb, "    mov rax, [rbp-" + dyn_a + "]" + x64_nl_char())
  sb_push(sb, "    cmp rax, 0" + x64_nl_char())
  sb_push(sb, "    je .MOD_FAMOK1_" + suffix + x64_nl_char())
  sb_push(sb, "    mov rcx, rax" + x64_nl_char())
  sb_push(sb, "    shl rcx, 16" + x64_nl_char())
  sb_push(sb, "    sar rcx, 16" + x64_nl_char())
  sb_push(sb, "    cmp rcx, rax" + x64_nl_char())
  sb_push(sb, "    jne .MOD_UNSUPPORTED_" + suffix + x64_nl_char())
  sb_push(sb, ".MOD_FAMOK1_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    mov r10, [rbp-" + dyn_b + "]" + x64_nl_char())
  sb_push(sb, "    cmp r10, 0" + x64_nl_char())
  sb_push(sb, "    je .MOD_FAMOK2_" + suffix + x64_nl_char())
  sb_push(sb, "    mov rcx, r10" + x64_nl_char())
  sb_push(sb, "    shl rcx, 16" + x64_nl_char())
  sb_push(sb, "    sar rcx, 16" + x64_nl_char())
  sb_push(sb, "    cmp rcx, r10" + x64_nl_char())
  sb_push(sb, "    jne .MOD_UNSUPPORTED_" + suffix + x64_nl_char())
  sb_push(sb, ".MOD_FAMOK2_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    mov rax, [rbp-" + dyn_a + "]" + x64_nl_char())
  sb_push(sb, "    shl rax, 16" + x64_nl_char())
  sb_push(sb, "    sar rax, 16" + x64_nl_char())
  sb_push(sb, "    mov r10, [rbp-" + dyn_b + "]" + x64_nl_char())
  sb_push(sb, "    shl r10, 16" + x64_nl_char())
  sb_push(sb, "    sar r10, 16" + x64_nl_char())
  sb_push(sb, "    cqo" + x64_nl_char())
  sb_push(sb, "    idiv r10" + x64_nl_char())
  # Same class of bug as the +/-/* masking fix documented above (in
  # x64_binop_asm_dynamic): this used to `and rdx, PAYLOAD_MASK` here,
  # which strips the sign-extension bits off a NEGATIVE remainder
  # (idiv's remainder can be negative for a negative dividend) --
  # correct for tagging a real heap address, wrong for a plain signed
  # int result. rdx is already the correctly sign-extended remainder,
  # no masking needed.
  sb_push(sb, "    mov rax, rdx" + x64_nl_char())
  sb_push(sb, "    jmp .MOD_DONE_" + suffix + x64_nl_char())
  sb_push(sb, ".MOD_UNSUPPORTED_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    mov rcx, 97" + x64_nl_char())
  sb_push(sb, "    mov r15, rsp" + x64_nl_char())
  sb_push(sb, "    sub rsp, 32" + x64_nl_char())
  sb_push(sb, "    and rsp, -16" + x64_nl_char())
  sb_push(sb, "    call ExitProcess" + x64_nl_char())
  sb_push(sb, ".MOD_DONE_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  return sb_str(sb)
end

# Dynamic-mode `+`/`-`/`*`/comparisons (widened from the +-only first
# cut -- see x64_runtime.patlang's own header above rt_bigint_from_i64
# for the full scope/history). Both operands are tagged words (fixnum:
# top 16 bits zero, low 48 bits a signed int; BigInt: family 0x1 tag,
# low 48 bits a heap address).
#
# Arithmetic (+/-/*): fast path is both-fixnum, checked for 48-bit
# overflow, promoting to BigInt (via the shared promote-both helper)
# only on genuine overflow. `*` needs the ONE-OPERAND `imul` form
# (`imul r10` computes rdx:rax = rax*r10 as a real 128-bit product and
# sets OF/CF if the result doesn't fit in 64 bits) rather than the
# two-operand form the plain int path uses -- a two-operand 64-bit
# `imul` on two ~48-bit-range values can itself silently wrap well
# before reaching our narrower 48-bit fixnum boundary, giving a wrong
# overflow verdict. After confirming the product fits in 64 bits (OF
# clear), the SAME sign-extend round-trip check as +/- narrows it to
# the actual 48-bit fixnum range.
#
# Comparisons: fast path is both-fixnum, plain `cmp`+setcc (no
# overflow concern). Slow path promotes both operands then calls
# rt_bigint_cmp (-1/0/1), then reuses the SAME setcc mnemonic against
# 0 -- rt_bigint_cmp's result sign already encodes the ordering
# exactly like an integer subtraction would.
#
# TAGMASK = top 16 bits set (0xFFFF shl 48) = 18446462598732840960.
# PAYLOAD_MASK = low 48 bits set ((1 shl 48) - 1) = 281474976710655.
make a function called x64_binop_asm_dynamic takes op, spilled returns asm
  let dyn_a = 8 * (to_num(list_len(spilled)) + 2)
  let dyn_b = 8 * (to_num(list_len(spilled)) + 3)
  let suffix = label_asm_safe(0)
  let sb = sb_new()
  sb_push(sb, "    pop qword [rbp-" + dyn_b + "]" + x64_nl_char())
  sb_push(sb, "    pop qword [rbp-" + dyn_a + "]" + x64_nl_char())
  # GitHub #38: this fast-path gate used to test "are this operand's
  # top 16 bits zero" (TAGMASK) as a stand-in for "does it genuinely
  # fit this backend's 48-bit SIGNED fixnum range" -- but those aren't
  # the same test. A value between 2^47 and 2^48 (e.g. 987654321098765)
  # has zero top-16-bits (passes the old check) but bit 47 -- the sign
  # position for a 48-bit signed value -- IS set, so the very next
  # `shl 16; sar 16` normalization below wrongly sign-extends it as
  # negative, corrupting it before the real add/sub/mul even runs
  # (confirmed exactly: `123456789012345 + 987654321098765` silently
  # gave `0`). Fixed to the SAME round-trip-through-48-bit-sign-
  # extension test already used correctly everywhere else in this
  # file (the DYN_NOTFAST branch's own FAMOK1/FAMOK2 checks, and the
  # mod/div dynamic fast-paths) -- true only for a genuine fixnum
  # (positive or negative), false for anything else, including this
  # exact "looks small but exceeds the signed range" case.
  sb_push(sb, "    mov rax, [rbp-" + dyn_a + "]" + x64_nl_char())
  sb_push(sb, "    cmp rax, 0" + x64_nl_char())
  sb_push(sb, "    je .DYN_FASTOK1_" + suffix + x64_nl_char())
  sb_push(sb, "    mov rcx, rax" + x64_nl_char())
  sb_push(sb, "    shl rcx, 16" + x64_nl_char())
  sb_push(sb, "    sar rcx, 16" + x64_nl_char())
  sb_push(sb, "    cmp rcx, rax" + x64_nl_char())
  sb_push(sb, "    jne .DYN_NOTFAST_" + suffix + x64_nl_char())
  sb_push(sb, ".DYN_FASTOK1_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    mov r10, [rbp-" + dyn_b + "]" + x64_nl_char())
  sb_push(sb, "    cmp r10, 0" + x64_nl_char())
  sb_push(sb, "    je .DYN_FASTOK2_" + suffix + x64_nl_char())
  sb_push(sb, "    mov rcx, r10" + x64_nl_char())
  sb_push(sb, "    shl rcx, 16" + x64_nl_char())
  sb_push(sb, "    sar rcx, 16" + x64_nl_char())
  sb_push(sb, "    cmp rcx, r10" + x64_nl_char())
  sb_push(sb, "    jne .DYN_NOTFAST_" + suffix + x64_nl_char())
  sb_push(sb, ".DYN_FASTOK2_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    mov rax, [rbp-" + dyn_a + "]" + x64_nl_char())
  sb_push(sb, "    shl rax, 16" + x64_nl_char())
  sb_push(sb, "    sar rax, 16" + x64_nl_char())
  sb_push(sb, "    mov r10, [rbp-" + dyn_b + "]" + x64_nl_char())
  sb_push(sb, "    shl r10, 16" + x64_nl_char())
  sb_push(sb, "    sar r10, 16" + x64_nl_char())
  if x64_is_dynamic_cmp_op(op) then
    sb_push(sb, "    cmp rax, r10" + x64_nl_char())
    sb_push(sb, "    " + x64_setcc_for_op(op) + " al" + x64_nl_char())
    sb_push(sb, "    movzx rax, al" + x64_nl_char())
    sb_push(sb, "    jmp .DYN_DONE_" + suffix + x64_nl_char())
  else
    if op == "*" then
      sb_push(sb, "    imul r10" + x64_nl_char())
      sb_push(sb, "    jo .DYN_OVERFLOW_" + suffix + x64_nl_char())
    else
      if op == "+" then
        sb_push(sb, "    add rax, r10" + x64_nl_char())
      else
        sb_push(sb, "    sub rax, r10" + x64_nl_char())
      end
    end
    sb_push(sb, "    mov rcx, rax" + x64_nl_char())
    sb_push(sb, "    shl rcx, 16" + x64_nl_char())
    sb_push(sb, "    sar rcx, 16" + x64_nl_char())
    sb_push(sb, "    cmp rcx, rax" + x64_nl_char())
    sb_push(sb, "    jne .DYN_OVERFLOW_" + suffix + x64_nl_char())
    # Real bug found (Stage B of the interp.patlang-compilation roadmap,
    # #25): this used to `and rax, PAYLOAD_MASK` (48-bit mask) here --
    # correct for TAGGING a real heap address, but WRONG for a plain
    # fixnum result, since masking strips the sign-extension bits off
    # any NEGATIVE result (e.g. 0-1 = -1 = 0xFFFF...FFFF masked to 48
    # bits becomes 0x0000FFFFFFFFFFFF, a huge POSITIVE number instead of
    # -1). Confirmed exactly: `busy == 0 - 1` inside a dynamic-mode
    # function evaluated false even though busy's own (CallHost-sourced,
    # correctly sign-extended) value truly was -1 -- the RHS `0 - 1`
    # went through this exact masking and came out corrupted. rcx
    # already holds the correct value (the shl16/sar16 round-trip test
    # just above IS the correct fixnum normalization -- no masking
    # needed at all), so just use it directly instead of re-deriving a
    # broken one from rax.
    sb_push(sb, "    mov rax, rcx" + x64_nl_char())
    sb_push(sb, "    jmp .DYN_DONE_" + suffix + x64_nl_char())
    sb_push(sb, ".DYN_OVERFLOW_" + suffix + ":" + x64_nl_char())
    sb_push(sb, x64_dynamic_promote_both_asm(suffix + "O", spilled))
    sb_push(sb, "    push qword [rbp-" + dyn_a + "]" + x64_nl_char())
    sb_push(sb, "    push qword [rbp-" + dyn_b + "]" + x64_nl_char())
    sb_push(sb, "    call " + x64_bigint_fn_for_op(op) + x64_nl_char())
    sb_push(sb, "    add rsp, 16" + x64_nl_char())
    sb_push(sb, "    jmp .DYN_DONE_" + suffix + x64_nl_char())
  end
  # NOTFAST: at least one operand isn't fixnum. Real bug found and
  # fixed here (before shipping, caught by x64_rational_demo's + and
  # * both printing garbage): this branch used to assume "not fixnum"
  # always means BigInt, unconditionally calling rt_bigint_* -- which
  # silently misreads a RATIONAL-tagged operand's [numerator]
  # [denominator] block as a BigInt's [sign][limb count][limbs...]
  # block (same byte offsets, totally different meaning). Must
  # classify BigInt vs Rational at RUNTIME (both are only known at
  # runtime -- a variable could hold either) before dispatching.
  #
  # SECOND bug of the same class, found and fixed while tagging
  # strings/lists/closures: the ORIGINAL fix above only handled
  # Rational-vs-BigInt confusion within the Numeric family, but once
  # String/List/Closure carry real tags too (not just Object), ANY
  # non-Numeric-family operand reaching this chain would still fall
  # through to the BigInt default -- e.g. comparing two strings inside
  # a function that's ALSO dynamic-mode (because it uses BigInt
  # elsewhere) would misread a string's [length][bytes] as a BigInt's
  # [sign][limb count]. Fixed by checking the FAMILY NIBBLE first: if
  # EITHER operand's family isn't 0x1 (Numeric), route straight to the
  # generic identity/no-op branch (.DYN_OBJ_, handles Object/String/
  # List/Closure/anything-mixed-with-a-fixnum uniformly) before ever
  # considering the Numeric-specific Interval/Complex/Rational/BigInt
  # chain at all.
  # NOTE: a fixnum's family reads as 0 (no tag at all), which does NOT
  # equal NUMERIC_FAMILY (1<<60) even though a fixnum genuinely IS
  # numeric-compatible -- this is exactly the mixed fixnum+BigInt/
  # Rational/Complex/Interval case every earlier promotion helper
  # already handles. A real bug caught here before it shipped (found
  # by re-running x64_bigint_demo's mixed bigint+fixnum case, which
  # segfaulted): the first draft of this family check required an
  # EXACT match to NUMERIC_FAMILY, which wrongly routed every mixed
  # fixnum+Numeric-composite pair into the identity/no-op branch
  # instead of the correct promotion chain. Fixed: an operand is
  # "numeric-compatible" if its family is EITHER 0 (fixnum) OR exactly
  # NUMERIC_FAMILY; only route to .DYN_OBJ_ if an operand's family is
  # neither (i.e. genuinely String/List/Closure/Object).
  sb_push(sb, ".DYN_NOTFAST_" + suffix + ":" + x64_nl_char())
  # GitHub #52: this used to hand-assemble the ENTIRE family-check/
  # promote/dispatch chain inline here (~490 lines) -- moved out-of-line
  # to rt_dynamic_binop (x64_runtime.patlang), compiled ONCE as part of
  # the cached runtime chunk, reached via a plain call instead of being
  # re-emitted at every "+"/"-"/"*"/comparison call site. See that
  # function's own header for the full investigation (root-caused: NASM
  # assembly time scales ~quadratically with local-label density within
  # one compiled unit -- 400x speedup measured moving this exact shape
  # out-of-line). x64_op_code_for below is op_code's single source of
  # truth; rt_dynamic_binop's own header documents the same convention.
  sb_push(sb, "    push qword [rbp-" + dyn_a + "]" + x64_nl_char())
  sb_push(sb, "    push qword [rbp-" + dyn_b + "]" + x64_nl_char())
  sb_push(sb, "    push " + x64_op_code_for(op) + x64_nl_char())
  sb_push(sb, "    call rt_dynamic_binop" + x64_nl_char())
  sb_push(sb, "    add rsp, 24" + x64_nl_char())
  sb_push(sb, ".DYN_DONE_" + suffix + ":" + x64_nl_char())
  # GitHub #24: same Bool-tagging as x64_binop_asm's own comparison
  # branches -- every branch through this whole dynamic-dispatch tree
  # (fixnum-fast, bigint/rational/complex/interval promotion, object
  # identity) converges on this ONE shared label before the single
  # push below, so gating on x64_is_dynamic_cmp_op(op) here covers
  # every dynamic-mode comparison path in one place, without touching
  # any of the individual branches above.
  if x64_is_dynamic_cmp_op(op) then
    sb_push(sb, "    mov rcx, 6917529027641081856" + x64_nl_char())
    sb_push(sb, "    or rax, rcx" + x64_nl_char())
  end
  sb_push(sb, "    push rax" + x64_nl_char())
  return sb_str(sb)
end

# `==`/`!=` on two String-family values must compare BYTE CONTENT, not
# the raw tagged address -- unlike the dynamic-mode DYN_OBJ branch
# above (deliberately identity-based for Object/List/Closure, matching
# this backend's own established design, see x64_runtime.patlang's
# rt_str_eq header), strings are a special case: the OTHER backends
# (interpreter, rustc-text) give String `==` real content-equality
# semantics (Rust's own String PartialEq), and patc1_main.patlang's
# own driver code (`args[2] == "--x64"`) is compiled by BOTH backends
# and relies on that -- a raw address compare here silently broke
# every `--x64` flag check once patc1_main.patlang started being
# compiled by ITS OWN backend for the patc2.exe self-compile (args[2]
# is a freshly heap-copied string from argv()'s tokenizer, never
# address-equal to the "--x64" literal even with identical bytes).
# Used in the NON-dynamic-mode path only (x64_binop_asm below) --
# dynamic-mode already has its own equivalent fix via
# x64_binop_asm_dynamic's DYN_OBJ branch, left as address-identity
# there deliberately (this function is scoped to fixing the ==/!=
# CASE specifically, not changing that established Object/List/
# Closure semantics). Family-nibble constants match the ones already
# used throughout this file: 17293822569102704640 = 0xF000... (top
# nibble mask), 2305843009213693952 = 0x2000... (String family tag).
  # REAL BUG FOUND AND FIXED HERE (2026-07-20, discovered by patc2.exe
  # crashing on EVEN ZERO ARGS after the first cut of this function --
  # bisected via self_hosting/examples/x64_zeroarg_repro.patlang down
  # to x64_runtime.patlang's own `print(v)`, specifically its `if
  # family == string_family then` line). `family` there is `v band
  # family_mask` -- a PLAIN INTEGER with every payload bit forced to
  # zero by construction (family_mask is the top-nibble-only mask), so
  # whenever v is genuinely a String, `family` ends up bit-for-bit
  # IDENTICAL to the bare `string_family` tag constant (also
  # payload-zero). The first cut of this function looked at the top
  # nibble ALONE and couldn't tell that apart from a real string
  # pointer -- it dispatched `family == string_family` to `rt_str_eq`,
  # which then dereferenced these bare tag words as if they were heap
  # addresses (reading a "length" from `payload_mask`-zero memory) --
  # instant segfault, and MUCH easier to hit than the original bug
  # (any tag-comparison idiom already used throughout
  # x64_runtime.patlang, not just an occasional string-literal
  # comparison). Fixed by ALSO requiring a nonzero payload (low 48
  # bits, `rt_payload_mask()`'s own mask) before treating an operand as
  # a real string -- a genuine heap-allocated string always has a
  # nonzero address there; a bare extracted/compared tag CONSTANT
  # (family_mask, string_family, bigint_family, etc, all computed via
  # `band` with a mask that zeroes the low 48 bits) never does.
make a function called x64_str_aware_eq_asm takes negate returns asm
  let suffix = label_asm_safe(0)
  let sb = sb_new()
  # Real bug found (interp.patlang-compilation roadmap, Stage past
  # math/bitfield/VFS): this used to jump straight to .STREQ_ (treating
  # the pair as a string comparison) as soon as EITHER operand alone
  # looked like a genuine string, without ever checking that the OTHER
  # operand was ALSO a string -- the exact same bug class already found
  # and fixed in x64_binop_asm_dynamic's DYN_OBJ branch this session,
  # just in this separate NON-dynamic-mode "string-aware ==" path
  # instead. Confirmed exactly: `existing == 0 - 1` inside vfs_append
  # (existing a genuine String, -1 a plain fixnum) jumped to STREQ_ the
  # moment `existing`'s check passed, then called rt_str_eq(existing,
  # -1) -- masking -1 to the 48-bit payload gives a bogus ~281 trillion
  # "address" nowhere near the real 16MB heap, and dereferencing it to
  # read a "length" field segfaulted. Fixed to a straight-line AND
  # chain: only reach .STREQ_ once BOTH operands independently pass the
  # string-family-and-nonzero-payload check; either one failing falls
  # through to the plain identity compare.
  sb_push(sb, "    mov r15, 17293822569102704640" + x64_nl_char())
  sb_push(sb, "    mov r9, 281474976710655" + x64_nl_char())
  sb_push(sb, "    mov r8, 2305843009213693952" + x64_nl_char())
  sb_push(sb, "    mov rcx, rax" + x64_nl_char())
  sb_push(sb, "    and rcx, r15" + x64_nl_char())
  sb_push(sb, "    cmp rcx, r8" + x64_nl_char())
  sb_push(sb, "    jne .STRSKIP_" + suffix + x64_nl_char())
  sb_push(sb, "    mov rcx, rax" + x64_nl_char())
  sb_push(sb, "    and rcx, r9" + x64_nl_char())
  sb_push(sb, "    cmp rcx, 0" + x64_nl_char())
  sb_push(sb, "    je .STRSKIP_" + suffix + x64_nl_char())
  sb_push(sb, "    mov rcx, r10" + x64_nl_char())
  sb_push(sb, "    and rcx, r15" + x64_nl_char())
  sb_push(sb, "    cmp rcx, r8" + x64_nl_char())
  sb_push(sb, "    jne .STRSKIP_" + suffix + x64_nl_char())
  sb_push(sb, "    mov rcx, r10" + x64_nl_char())
  sb_push(sb, "    and rcx, r9" + x64_nl_char())
  sb_push(sb, "    cmp rcx, 0" + x64_nl_char())
  sb_push(sb, "    je .STRSKIP_" + suffix + x64_nl_char())
  sb_push(sb, "    jmp .STREQ_" + suffix + x64_nl_char())
  sb_push(sb, ".STRSKIP_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    cmp rax, r10" + x64_nl_char())
  if negate then
    sb_push(sb, "    setne al" + x64_nl_char())
  else
    sb_push(sb, "    sete al" + x64_nl_char())
  end
  sb_push(sb, "    movzx rax, al" + x64_nl_char())
  sb_push(sb, "    jmp .STRDONE_" + suffix + x64_nl_char())
  sb_push(sb, ".STREQ_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  sb_push(sb, "    push r10" + x64_nl_char())
  sb_push(sb, "    call rt_str_eq" + x64_nl_char())
  sb_push(sb, "    add rsp, 16" + x64_nl_char())
  if negate then
    sb_push(sb, "    xor rax, 1" + x64_nl_char())
  end
  sb_push(sb, ".STRDONE_" + suffix + ":" + x64_nl_char())
  return sb_str(sb)
end

# `+` on two String-family values must CONCATENATE (call rt_str_concat),
# not raw-add the tagged words -- same backend-parity reasoning as
# x64_str_aware_eq_asm above (interpreter/rustc give `+` real string
# concatenation semantics, and self-hosted PatLang code throughout this
# codebase -- INCLUDING patc1_main.patlang's own `rt_src + chr(10) +
# source` and `"patc1: " + exe` -- relies on that). Found the SAME
# session, one bisection layer deeper: after fixing `==` (twice), the
# real fixpoint got further but `patc1_main.patlang`'s own
# `lower_source = rt_src + chr(10) + source` silently produced a
# ZERO-length string (raw `add` on two heap-pointer tagged words is
# meaningless address arithmetic, not concatenation) -- confirmed via
# a minimal repro (`"hello" + "world"` alone printed length 0) before
# touching codegen. Same nonzero-payload guard as the `==` fix, for the
# same reason (a bare extracted/compared tag CONSTANT must never be
# mistaken for a real heap string pointer here either).
make a function called x64_str_aware_plus_asm returns asm
  let suffix = label_asm_safe(0)
  let sb = sb_new()
  # Real bug found (GitHub #35 investigation): a natural "stringify a
  # list for display" idiom, `"" + some_list`, silently fell all the
  # way through this function's own String-vs-String AND-chain below
  # (a List's family nibble is 3, never matches the String check on
  # EITHER side) into `.PLUSSKIP_`'s raw `add rax, r10` -- pointer
  # arithmetic on two tagged values, producing garbage (confirmed:
  # `"" + [4]` printed `0` under --x64 instead of `[4]`). Fixed by
  # converting a LIST operand to its display string (the SAME
  # `rt_list_to_display_string` print() itself already uses) BEFORE
  # the existing String-family check runs, on EITHER side
  # independently -- so `list + string`, `string + list`, and
  # `list + list` all now stringify correctly, not just the specific
  # case that was hit.
  sb_push(sb, "    mov r15, 17293822569102704640" + x64_nl_char())
  sb_push(sb, "    mov rcx, rax" + x64_nl_char())
  sb_push(sb, "    and rcx, r15" + x64_nl_char())
  sb_push(sb, "    mov r8, 3458764513820540928" + x64_nl_char())
  sb_push(sb, "    cmp rcx, r8" + x64_nl_char())
  sb_push(sb, "    jne .PLUSNOTLIST1_" + suffix + x64_nl_char())
  sb_push(sb, "    push r10" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  sb_push(sb, "    call rt_list_to_display_string" + x64_nl_char())
  sb_push(sb, "    add rsp, 8" + x64_nl_char())
  sb_push(sb, "    pop r10" + x64_nl_char())
  sb_push(sb, ".PLUSNOTLIST1_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    mov rcx, r10" + x64_nl_char())
  sb_push(sb, "    and rcx, r15" + x64_nl_char())
  sb_push(sb, "    cmp rcx, r8" + x64_nl_char())
  sb_push(sb, "    jne .PLUSNOTLIST2_" + suffix + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  sb_push(sb, "    push r10" + x64_nl_char())
  sb_push(sb, "    call rt_list_to_display_string" + x64_nl_char())
  sb_push(sb, "    add rsp, 8" + x64_nl_char())
  sb_push(sb, "    mov r10, rax" + x64_nl_char())
  sb_push(sb, "    pop rax" + x64_nl_char())
  sb_push(sb, ".PLUSNOTLIST2_" + suffix + ":" + x64_nl_char())
  # Same bug class as x64_str_aware_eq_asm just above, same fix: only
  # concatenate once BOTH operands independently pass the string-
  # family-and-nonzero-payload check (a straight-line AND chain), not
  # as soon as EITHER one alone looks like a string.
  sb_push(sb, "    mov r15, 17293822569102704640" + x64_nl_char())
  sb_push(sb, "    mov r9, 281474976710655" + x64_nl_char())
  sb_push(sb, "    mov r8, 2305843009213693952" + x64_nl_char())
  sb_push(sb, "    mov rcx, rax" + x64_nl_char())
  sb_push(sb, "    and rcx, r15" + x64_nl_char())
  sb_push(sb, "    cmp rcx, r8" + x64_nl_char())
  sb_push(sb, "    jne .PLUSSKIP_" + suffix + x64_nl_char())
  sb_push(sb, "    mov rcx, rax" + x64_nl_char())
  sb_push(sb, "    and rcx, r9" + x64_nl_char())
  sb_push(sb, "    cmp rcx, 0" + x64_nl_char())
  sb_push(sb, "    je .PLUSSKIP_" + suffix + x64_nl_char())
  sb_push(sb, "    mov rcx, r10" + x64_nl_char())
  sb_push(sb, "    and rcx, r15" + x64_nl_char())
  sb_push(sb, "    cmp rcx, r8" + x64_nl_char())
  sb_push(sb, "    jne .PLUSSKIP_" + suffix + x64_nl_char())
  sb_push(sb, "    mov rcx, r10" + x64_nl_char())
  sb_push(sb, "    and rcx, r9" + x64_nl_char())
  sb_push(sb, "    cmp rcx, 0" + x64_nl_char())
  sb_push(sb, "    je .PLUSSKIP_" + suffix + x64_nl_char())
  sb_push(sb, "    jmp .PLUSCAT_" + suffix + x64_nl_char())
  sb_push(sb, ".PLUSSKIP_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    add rax, r10" + x64_nl_char())
  sb_push(sb, "    jmp .PLUSDONE_" + suffix + x64_nl_char())
  sb_push(sb, ".PLUSCAT_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  sb_push(sb, "    push r10" + x64_nl_char())
  sb_push(sb, "    call rt_str_concat" + x64_nl_char())
  sb_push(sb, "    add rsp, 16" + x64_nl_char())
  sb_push(sb, ".PLUSDONE_" + suffix + ":" + x64_nl_char())
  return sb_str(sb)
end

# `<`/`<=`/`>`/`>=` in the plain (non-dynamic-mode, non-float-mode)
