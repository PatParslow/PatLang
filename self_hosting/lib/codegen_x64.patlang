# os_read_line() -> tagged String, one line from stdin without the
# trailing newline (a lone trailing \r from a CRLF source is stripped
# too, matching hosts.rs's own host_read_line), or "" at EOF. Primitive-
# gap fill (GitHub #31 follow-up, deferred in the earlier batch --
# see [[patlang-x64-primitive-gap-fill-copy-rename-goap]]).
#
# Reads ONE byte at a time via ReadFile (simplicity over performance,
# matching this file's own established "correctness first" discipline
# for primitives that aren't hot paths) into g_scratch, accumulating up
# to 255 bytes (the same implicit "paths/lines must fit in 256 bytes"
# limit os_file_size/os_write_file etc already accept, not a new gap).
# r12/r13/r14/r15 are real win64 nonvolatile registers, properly
# callee-saved by ReadFile/GetStdHandle themselves (genuine external
# win64 ABI calls, unlike calls to OTHER PatLang-level functions in
# this backend, which give no such guarantee) -- safe to hold the
# running byte count in r12 across the read loop's own ReadFile calls.
make a function called x64_os_read_line_asm returns asm
  let suffix = label_asm_safe(0)
  let sb = sb_new()
  sb_push(sb, x64_lock_acquire_asm(suffix))
  sb_push(sb, "    mov r15, rsp" + x64_nl_char())
  sb_push(sb, "    sub rsp, 64" + x64_nl_char())
  sb_push(sb, "    and rsp, -16" + x64_nl_char())
  sb_push(sb, "    mov rcx, -10" + x64_nl_char())
  sb_push(sb, "    call GetStdHandle" + x64_nl_char())
  sb_push(sb, "    mov [rsp+56], rax" + x64_nl_char())
  sb_push(sb, "    xor r12, r12" + x64_nl_char())
  sb_push(sb, "  .rl_loop:" + x64_nl_char())
  sb_push(sb, "    cmp r12, 255" + x64_nl_char())
  sb_push(sb, "    jge .rl_done" + x64_nl_char())
  sb_push(sb, "    mov rcx, [rsp+56]" + x64_nl_char())
  sb_push(sb, "    lea rdx, [rel g_scratch]" + x64_nl_char())
  sb_push(sb, "    add rdx, r12" + x64_nl_char())
  sb_push(sb, "    mov r8, 1" + x64_nl_char())
  sb_push(sb, "    lea r9, [rsp+40]" + x64_nl_char())
  sb_push(sb, "    mov qword [rsp+32], 0" + x64_nl_char())
  sb_push(sb, "    call ReadFile" + x64_nl_char())
  sb_push(sb, "    mov rax, [rsp+40]" + x64_nl_char())
  sb_push(sb, "    cmp rax, 0" + x64_nl_char())
  sb_push(sb, "    je .rl_done" + x64_nl_char())
  sb_push(sb, "    lea rax, [rel g_scratch]" + x64_nl_char())
  sb_push(sb, "    add rax, r12" + x64_nl_char())
  sb_push(sb, "    movzx rax, byte [rax]" + x64_nl_char())
  sb_push(sb, "    cmp rax, 10" + x64_nl_char())
  sb_push(sb, "    je .rl_done" + x64_nl_char())
  sb_push(sb, "    inc r12" + x64_nl_char())
  sb_push(sb, "    jmp .rl_loop" + x64_nl_char())
  sb_push(sb, "  .rl_done:" + x64_nl_char())
  sb_push(sb, "    cmp r12, 0" + x64_nl_char())
  sb_push(sb, "    je .rl_build" + x64_nl_char())
  sb_push(sb, "    lea rax, [rel g_scratch]" + x64_nl_char())
  sb_push(sb, "    add rax, r12" + x64_nl_char())
  sb_push(sb, "    sub rax, 1" + x64_nl_char())
  sb_push(sb, "    movzx rax, byte [rax]" + x64_nl_char())
  sb_push(sb, "    cmp rax, 13" + x64_nl_char())
  sb_push(sb, "    jne .rl_build" + x64_nl_char())
  sb_push(sb, "    dec r12" + x64_nl_char())
  sb_push(sb, "  .rl_build:" + x64_nl_char())
  sb_push(sb, "    mov rsp, r15" + x64_nl_char())
  # r12 (byte count) is NOT guaranteed to survive a call to rt_heap_alloc
