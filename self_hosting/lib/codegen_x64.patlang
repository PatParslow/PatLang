  sb_push(sb, "    cmp r10, r14" + x64_nl_char())
  sb_push(sb, "    jl .exec_read_normal_" + suffix + x64_nl_char())
  sb_push(sb, "    lea rdx, [rel g_scratch]" + x64_nl_char())
  sb_push(sb, "    mov r8, 256" + x64_nl_char())
  sb_push(sb, "    jmp .exec_read_common_" + suffix + x64_nl_char())
  sb_push(sb, "  .exec_read_normal_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    lea rdx, [r13+r10]" + x64_nl_char())
  sb_push(sb, "    mov r8, r14" + x64_nl_char())
  sb_push(sb, "    sub r8, r10" + x64_nl_char())
  sb_push(sb, "  .exec_read_common_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    mov rcx, r12" + x64_nl_char())
  sb_push(sb, "    lea r9, [rsp+272]" + x64_nl_char())
  sb_push(sb, "    mov qword [rsp+32], 0" + x64_nl_char())
  sb_push(sb, "    call ReadFile" + x64_nl_char())
  sb_push(sb, "    cmp rax, 0" + x64_nl_char())
  sb_push(sb, "    je .exec_read_done_" + suffix + x64_nl_char())
  sb_push(sb, "    mov rax, [rsp+272]" + x64_nl_char())
  sb_push(sb, "    cmp rax, 0" + x64_nl_char())
  sb_push(sb, "    je .exec_read_done_" + suffix + x64_nl_char())
  sb_push(sb, "    cmp r10, r14" + x64_nl_char())
  sb_push(sb, "    jge .exec_read_loop_" + suffix + x64_nl_char())
  sb_push(sb, "    add r10, rax" + x64_nl_char())
  sb_push(sb, "    jmp .exec_read_loop_" + suffix + x64_nl_char())
  sb_push(sb, "  .exec_read_done_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    mov qword [rsi], r10" + x64_nl_char())
  sb_push(sb, "    mov rcx, [rsp+240]" + x64_nl_char())
  sb_push(sb, "    mov rdx, -1" + x64_nl_char())
  sb_push(sb, "    call WaitForSingleObject" + x64_nl_char())
  sb_push(sb, "    mov rcx, r12" + x64_nl_char())
  sb_push(sb, "    call CloseHandle" + x64_nl_char())
  sb_push(sb, "    mov rcx, [rsp+240]" + x64_nl_char())
  sb_push(sb, "    call CloseHandle" + x64_nl_char())
  sb_push(sb, "    mov rcx, [rsp+248]" + x64_nl_char())
  sb_push(sb, "    call CloseHandle" + x64_nl_char())
  sb_push(sb, "    jmp .exec_all_done_" + suffix + x64_nl_char())
  sb_push(sb, "  .exec_failed_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    mov rcx, [rsp+104]" + x64_nl_char())
  sb_push(sb, "    call CloseHandle" + x64_nl_char())
  sb_push(sb, "    mov rcx, [rsp+112]" + x64_nl_char())
  sb_push(sb, "    call CloseHandle" + x64_nl_char())
  # Same r15-across-rt_heap_alloc bug as the success path above, same fix.
  sb_push(sb, "    push r15" + x64_nl_char())
  sb_push(sb, "    mov rax, 8" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  sb_push(sb, "    call rt_heap_alloc" + x64_nl_char())
  sb_push(sb, "    add rsp, 8" + x64_nl_char())
  sb_push(sb, "    pop r15" + x64_nl_char())
  sb_push(sb, "    mov qword [rax], 0" + x64_nl_char())
  sb_push(sb, "    mov rsi, rax" + x64_nl_char())
  sb_push(sb, "  .exec_all_done_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    mov rax, rsi" + x64_nl_char())
  # GitHub #30/#31 investigation: this used to be "mov rsp,r15; add rsp,
  # 16" -- but r15 (saved right after the caller's cmdline_len/cmdline_
  # addr pair was already popped into registers, see the comment above
  # "mov r15, rsp") already represents the correct stack depth with
  # NOTHING outstanding; a WinDbg checkpoint diff (entry rsp vs rsp right
  # after this whole CallHost completes, GitHub #30's own comment trail)
  # measured a genuine, reproducible stack-pointer drift traced to this
  # exact "+16" being spurious. Removed.
  sb_push(sb, "    mov rsp, r15" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  return sb_str(sb)
end

