# ---- raw-mode console input (tab-completion primitive-gap fill) ----
#
# os_enable_raw_mode() -> the console's PREVIOUS mode as a plain int, or
# -1 if GetConsoleMode itself failed -- which it genuinely does when
# stdin isn't a real console (a redirected file or a piped subprocess,
# exactly how every BDD spec in this codebase drives a compiled program
# under test). -1 is the caller's signal to skip raw-mode line editing
# entirely and fall back to plain os_read_line, so piped/scripted use
# keeps working unchanged -- this was verified directly: SetConsoleMode
# on a pipe handle does not crash, it just reports failure via the
# return value, exactly like any other WinAPI call this backend already
# checks (GetConsoleMode here, same as the existing MoveFileExA-style
# calls elsewhere in this file that check rax against 0).
#
# On success, clears ENABLE_LINE_INPUT (0x0002) and ENABLE_ECHO_INPUT
# (0x0004) only -- so a byte arrives per keystroke instead of per line,
# with no OS-drawn echo (the caller must draw its own). ENABLE_PROCESSED_
# INPUT (0x0001) is deliberately left SET: Ctrl+C still terminates the
# process the normal way. A raw-mode reader that also wants to treat
# Ctrl+C as an editable keystroke (to cancel-in-place rather than exit)
# would need to clear that bit too and wire its own signal handling --
# real, separate future work, not attempted here; this is the safer
# default for a first cut.
make a function called x64_os_enable_raw_mode_asm returns asm
  let sb = sb_new()
  sb_push(sb, "    mov r15, rsp" + x64_nl_char())
  sb_push(sb, "    sub rsp, 64" + x64_nl_char())
  sb_push(sb, "    and rsp, -16" + x64_nl_char())
  sb_push(sb, "    mov rcx, -10" + x64_nl_char())
  sb_push(sb, "    call GetStdHandle" + x64_nl_char())
  sb_push(sb, "    mov [rsp+56], rax" + x64_nl_char())
  sb_push(sb, "    mov rcx, [rsp+56]" + x64_nl_char())
  sb_push(sb, "    lea rdx, [rsp+48]" + x64_nl_char())
  sb_push(sb, "    mov qword [rsp+48], 0" + x64_nl_char())
  sb_push(sb, "    call GetConsoleMode" + x64_nl_char())
  sb_push(sb, "    cmp rax, 0" + x64_nl_char())
  sb_push(sb, "    je .raw_en_fail" + x64_nl_char())
  sb_push(sb, "    mov eax, [rsp+48]" + x64_nl_char())
  sb_push(sb, "    mov r13d, eax" + x64_nl_char())
  sb_push(sb, "    and eax, -7" + x64_nl_char())
  sb_push(sb, "    mov rcx, [rsp+56]" + x64_nl_char())
  sb_push(sb, "    mov edx, eax" + x64_nl_char())
  sb_push(sb, "    call SetConsoleMode" + x64_nl_char())
  sb_push(sb, "    mov rax, r13" + x64_nl_char())
  sb_push(sb, "    jmp .raw_en_done" + x64_nl_char())
  sb_push(sb, "  .raw_en_fail:" + x64_nl_char())
  sb_push(sb, "    mov rax, -1" + x64_nl_char())
  sb_push(sb, "  .raw_en_done:" + x64_nl_char())
  sb_push(sb, "    mov rsp, r15" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  return sb_str(sb)
end

# os_disable_raw_mode(old_mode) -> restores whatever mode
# os_enable_raw_mode reported before it changed anything. Called with
# old_mode == -1 (raw mode was never actually entered, e.g. non-console
# stdin) this still issues a SetConsoleMode call with -1 as the mode
# value -- harmless (it just fails, same as GetConsoleMode already did
# on that same non-console handle) but callers should still guard the
# call site on old_mode != -1 to avoid it, matching x64_runtime.patlang's
# wrapper below.
make a function called x64_os_disable_raw_mode_asm returns asm
  let sb = sb_new()
  sb_push(sb, "    pop rcx" + x64_nl_char())
  sb_push(sb, "    mov r15, rsp" + x64_nl_char())
  sb_push(sb, "    sub rsp, 48" + x64_nl_char())
  sb_push(sb, "    and rsp, -16" + x64_nl_char())
  sb_push(sb, "    mov r13d, ecx" + x64_nl_char())
  sb_push(sb, "    mov rcx, -10" + x64_nl_char())
  sb_push(sb, "    call GetStdHandle" + x64_nl_char())
  sb_push(sb, "    mov rcx, rax" + x64_nl_char())
  sb_push(sb, "    mov edx, r13d" + x64_nl_char())
  sb_push(sb, "    call SetConsoleMode" + x64_nl_char())
  sb_push(sb, "    mov rsp, r15" + x64_nl_char())
  sb_push(sb, "    push 0" + x64_nl_char())
  return sb_str(sb)
end

# os_read_raw_byte() -> the next single byte from stdin as a plain int
# (0-255), or -1 at EOF/error. Same ReadFile-one-byte call
# os_read_line's own loop body already makes (see its header comment),
# extracted here as a standalone single read with no newline-scanning or
# accumulation -- the caller (a PatLang-level line editor) decides what
# to do with each byte, including recognizing Tab (9), Backspace (8),
# Enter (13 or 10 depending on how the byte arrives), and Escape (27,
# the lead byte of an arrow-key sequence on Windows consoles) itself.
make a function called x64_os_read_raw_byte_asm returns asm
  let suffix = label_asm_safe(0)
  let sb = sb_new()
  sb_push(sb, x64_lock_acquire_asm(suffix))
  sb_push(sb, "    mov r15, rsp" + x64_nl_char())
  sb_push(sb, "    sub rsp, 64" + x64_nl_char())
  sb_push(sb, "    and rsp, -16" + x64_nl_char())
  sb_push(sb, "    mov rcx, -10" + x64_nl_char())
  sb_push(sb, "    call GetStdHandle" + x64_nl_char())
  sb_push(sb, "    mov rcx, rax" + x64_nl_char())
  sb_push(sb, "    lea rdx, [rel g_scratch]" + x64_nl_char())
  sb_push(sb, "    mov r8, 1" + x64_nl_char())
  sb_push(sb, "    lea r9, [rsp+40]" + x64_nl_char())
  sb_push(sb, "    mov qword [rsp+32], 0" + x64_nl_char())
  sb_push(sb, "    call ReadFile" + x64_nl_char())
  # Same class of bug as x64_os_exec_run_asm's own read loop (found and
  # fixed there first, via a live user report): ReadFile's
  # lpNumberOfBytesRead is a DWORD, but this read [rsp+40] as a full
  # 64-bit qword -- if its never-zeroed upper 32 bits happen to be
  # nonzero garbage, a genuine EOF (bytesRead == 0) could be missed by
  # the `cmp rax, 0` check below. This module's own automated tests
  # never exercised this path (they all hit the non-console fallback,
  # never console_raw_enable's real branch), so it went unverified until
  # a live user report of raw-mode input trouble prompted re-checking
  # every ReadFile call in this file for the same mistake.
  sb_push(sb, "    mov eax, [rsp+40]" + x64_nl_char())
  sb_push(sb, "    cmp rax, 0" + x64_nl_char())
  sb_push(sb, "    je .rrb_eof" + x64_nl_char())
  sb_push(sb, "    lea rax, [rel g_scratch]" + x64_nl_char())
  sb_push(sb, "    movzx rax, byte [rax]" + x64_nl_char())
  sb_push(sb, "    jmp .rrb_done" + x64_nl_char())
  sb_push(sb, "  .rrb_eof:" + x64_nl_char())
  sb_push(sb, "    mov rax, -1" + x64_nl_char())
  sb_push(sb, "  .rrb_done:" + x64_nl_char())
  # rsp restored (via r15) BEFORE lock_release, not after -- lock_
  # release uses r15 internally for its OWN self-alignment, which would
  # clobber THIS function's own saved entry rsp if release ran first.
  sb_push(sb, "    mov rsp, r15" + x64_nl_char())
  sb_push(sb, "    mov r14, rax" + x64_nl_char())
  sb_push(sb, x64_lock_release_asm())
  sb_push(sb, "    mov rax, r14" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  return sb_str(sb)
end

# os_set_console_utf8() -> sets BOTH the console's input and output code
# pages to UTF-8 (65001). Fixes a real, live-reported bug: PatLang
# string literals in this codebase's own source are UTF-8 (e.g. the
# em-dashes in this very file's comments), and os_write_console_bytes
# writes those raw bytes straight to the console handle via WriteFile --
# but a Windows console's OUTPUT code page defaults to a legacy OEM
# page (commonly CP437 or CP850), not UTF-8, so any multi-byte UTF-8
# character gets reinterpreted byte-by-byte under that DIFFERENT
# encoding (an em-dash's 3 UTF-8 bytes 0xE2 0x80 0x94 rendering as
# "ÔÇö" is exactly this). SetConsoleOutputCP(65001) fixes rendering;
# SetConsoleCP(65001) does the matching fix for INPUT, so typed/pasted
# multi-byte characters round-trip correctly too (paired with
# line_edit.patlang's own byte-passthrough for the 0x80-0xFF range).
# No handle parameter needed -- unlike SetConsoleMode, these two APIs
# operate on the current process's console directly.
make a function called x64_os_set_console_utf8_asm returns asm
  let sb = sb_new()
  sb_push(sb, "    mov r15, rsp" + x64_nl_char())
  sb_push(sb, "    sub rsp, 32" + x64_nl_char())
  sb_push(sb, "    and rsp, -16" + x64_nl_char())
  sb_push(sb, "    mov rcx, 65001" + x64_nl_char())
  sb_push(sb, "    call SetConsoleOutputCP" + x64_nl_char())
  sb_push(sb, "    mov rcx, 65001" + x64_nl_char())
  sb_push(sb, "    call SetConsoleCP" + x64_nl_char())
  sb_push(sb, "    mov rsp, r15" + x64_nl_char())
  sb_push(sb, "    push 0" + x64_nl_char())
  return sb_str(sb)
end

# os_get_cwd() -> the process's current working directory as a tagged
# string, via GetCurrentDirectoryA. 1024 bytes is generous for a prompt
# hint (real Windows paths can exceed this with the \\?\ long-path
# prefix, but that's out of scope for what this is used for). Same
# push-r15-around-rt_heap_alloc protection as every other primitive here
# that allocates before doing OS work (rt_heap_alloc, an ORDINARY
# compiled PatLang function, gives no register-preservation guarantee).
# GetCurrentDirectoryA's DWORD return arrives via EAX, which the x64
# architecture itself zero-extends into the full RAX on any 32-bit
# register write -- unlike an OUT PARAMETER written via a pointer (the
# real gotcha fixed elsewhere in this file, e.g. ReadFile's
# lpNumberOfBytesRead), a function's own REGISTER return value needs no
# extra care reading it as a full qword.
make a function called x64_os_get_cwd_asm returns asm
  let sb = sb_new()
  sb_push(sb, "    mov r15, rsp" + x64_nl_char())
  sb_push(sb, "    push r15" + x64_nl_char())
  sb_push(sb, "    mov rax, 1032" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  sb_push(sb, "    call rt_heap_alloc" + x64_nl_char())
  sb_push(sb, "    add rsp, 8" + x64_nl_char())
  sb_push(sb, "    pop r15" + x64_nl_char())
  sb_push(sb, "    mov r14, rax" + x64_nl_char())
  sb_push(sb, "    sub rsp, 32" + x64_nl_char())
  sb_push(sb, "    and rsp, -16" + x64_nl_char())
  sb_push(sb, "    mov rcx, 1024" + x64_nl_char())
  sb_push(sb, "    lea rdx, [r14+8]" + x64_nl_char())
  sb_push(sb, "    call GetCurrentDirectoryA" + x64_nl_char())
  sb_push(sb, "    mov qword [r14], rax" + x64_nl_char())
  sb_push(sb, "    mov rsp, r15" + x64_nl_char())
  sb_push(sb, "    mov rax, r14" + x64_nl_char())
  sb_push(sb, "    mov rcx, 2305843009213693952" + x64_nl_char())
  sb_push(sb, "    or rax, rcx" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  return sb_str(sb)
end

# os_set_cwd(addr, len) -> 1/0 (SetCurrentDirectoryA's own BOOL,
# normalized). Real fix for a live-reported bug: `cd` can NEVER work by
# shelling out to `cmd.exe /c cd ...` (this terminal's own default
# fallback for any command it doesn't recognize as a built-in) --
# a child process's own working-directory change is entirely local to
# that child and is discarded the instant it exits; the PARENT (this
# terminal's own process) never sees it, no matter how the shelling-out
# is done. `cd` needs a real built-in calling SetCurrentDirectoryA
# directly, in-process -- see friendly_cli/terminal_native.patlang's own
# tmn_cd. addr/len follow the SAME null-terminate-into-a-fresh-buffer
# pattern os_exec_run already uses for its own cmdline argument, for the
# same reason (SetCurrentDirectoryA needs a real C string, and this
# caller's tagged-string bytes are never null-terminated on their own).
make a function called x64_os_set_cwd_asm returns asm
  let suffix = label_asm_safe(0)
  let sb = sb_new()
  # REWRITTEN: the first version called rt_heap_alloc to get a fresh
  # null-terminated buffer, holding addr/len in r12/r13 across that
  # call -- a real bug (caught by an actual crash, not review): r12-r15
  # are only guaranteed to survive REAL WinAPI calls; rt_heap_alloc is
  # an ORDINARY COMPILED PATLANG FUNCTION, which this backend's own
  # calling convention gives NO register-preservation guarantee across
  # AT ALL (the same established rule this file documents repeatedly
  # elsewhere, e.g. x64_os_exec_run_asm's own r15-across-rt_heap_alloc
  # fix) -- this primitive just never applied it to r12/r13. On top of
  # that, r15 was never actually set to the entry rsp before being
  # pushed, so the eventual `mov rsp, r15` restored garbage. Both fixed
  # by dropping rt_heap_alloc entirely and reusing
  # x64_os_null_terminate_path_asm (g_scratch, no allocation, no
  # register-preservation problem to have) -- the exact same helper
  # os_write_file/os_copy_file/os_rename_file already use for a
  # null-terminated path, proven correct there.
  sb_push(sb, x64_lock_acquire_asm(suffix))
  sb_push(sb, "    pop r10" + x64_nl_char())
  sb_push(sb, "    pop rax" + x64_nl_char())
  sb_push(sb, x64_os_null_terminate_path_asm(suffix))
  sb_push(sb, "    mov r15, rsp" + x64_nl_char())
  sb_push(sb, "    sub rsp, 32" + x64_nl_char())
  sb_push(sb, "    and rsp, -16" + x64_nl_char())
  sb_push(sb, "    lea rcx, [rel g_scratch]" + x64_nl_char())
  sb_push(sb, "    call SetCurrentDirectoryA" + x64_nl_char())
  sb_push(sb, "    mov rsp, r15" + x64_nl_char())
  sb_push(sb, "    cmp rax, 0" + x64_nl_char())
  sb_push(sb, "    je .scwd_fail_" + suffix + x64_nl_char())
  sb_push(sb, "    mov rax, 1" + x64_nl_char())
  sb_push(sb, "    jmp .scwd_done_" + suffix + x64_nl_char())
  sb_push(sb, "  .scwd_fail_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    mov rax, 0" + x64_nl_char())
  sb_push(sb, "  .scwd_done_" + suffix + ":" + x64_nl_char())
  # r15 already restored above (mov rsp, r15) -- safe for lock_release
  # to use it internally now.
  sb_push(sb, "    mov r14, rax" + x64_nl_char())
  sb_push(sb, x64_lock_release_asm())
  sb_push(sb, "    push r14" + x64_nl_char())
  return sb_str(sb)
end

# os_enable_ansi_colors() -> 1 if the console now honors ANSI escape
# sequences (ENABLE_VIRTUAL_TERMINAL_PROCESSING, 0x0004, set on the
# STDOUT handle), 0 if this isn't a real console (redirected/piped
# output, where GetConsoleMode itself fails, same non-console detection
# already used by os_enable_raw_mode) -- callers must check this and
# skip emitting color codes entirely when it's 0, not just print them
# unconditionally (raw escape bytes in a piped/logged/redirected output
# would be visible garbage, not color).
make a function called x64_os_enable_ansi_colors_asm returns asm
  let suffix = label_asm_safe(0)
  let sb = sb_new()
  sb_push(sb, "    mov r15, rsp" + x64_nl_char())
  sb_push(sb, "    sub rsp, 64" + x64_nl_char())
  sb_push(sb, "    and rsp, -16" + x64_nl_char())
  sb_push(sb, "    mov rcx, -11" + x64_nl_char())
  sb_push(sb, "    call GetStdHandle" + x64_nl_char())
  sb_push(sb, "    mov [rsp+56], rax" + x64_nl_char())
  sb_push(sb, "    mov rcx, [rsp+56]" + x64_nl_char())
  sb_push(sb, "    lea rdx, [rsp+48]" + x64_nl_char())
  sb_push(sb, "    mov qword [rsp+48], 0" + x64_nl_char())
  sb_push(sb, "    call GetConsoleMode" + x64_nl_char())
  sb_push(sb, "    cmp rax, 0" + x64_nl_char())
  sb_push(sb, "    je .ansi_fail_" + suffix + x64_nl_char())
  sb_push(sb, "    mov eax, [rsp+48]" + x64_nl_char())
  sb_push(sb, "    or eax, 4" + x64_nl_char())
  sb_push(sb, "    mov rcx, [rsp+56]" + x64_nl_char())
  sb_push(sb, "    mov edx, eax" + x64_nl_char())
  sb_push(sb, "    call SetConsoleMode" + x64_nl_char())
  sb_push(sb, "    mov rax, 1" + x64_nl_char())
  sb_push(sb, "    jmp .ansi_done_" + suffix + x64_nl_char())
  sb_push(sb, "  .ansi_fail_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    mov rax, 0" + x64_nl_char())
  sb_push(sb, "  .ansi_done_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    mov rsp, r15" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  return sb_str(sb)
end

# os_last_exec_exit_code() -> the real exit code (or -1) x64_os_exec_run_asm's
# most recent run left in g_last_exec_exit_code -- see that function's
# own comment. A shared global, not a return value threaded through
# exec_capture's own existing single-string return convention (which
# this deliberately does not change, to avoid risking its already-proven
# callers) -- exec_capture_io (x64_runtime.patlang) reads it right after
# calling os_exec_run.
make a function called x64_os_last_exec_exit_code_asm returns asm
  let sb = sb_new()
  sb_push(sb, "    mov rax, [rel g_last_exec_exit_code]" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  return sb_str(sb)
end

# ---- apply(fname): dynamic dispatch-by-name ----
#
# apply(fname) invokes a PatLang function by NAME (a runtime string),
# with zero explicit args -- used throughout self_hosting/lib/
# console.patlang and self_hosting/lib/test.patlang's own step()
# dispatcher for exactly this "look up a handler by name, call it"
# pattern. No whole-program flow analysis exists to know in advance
# which names any given apply() call site might be asked to resolve at
# runtime (fname is a genuine runtime value, not a compile-time
# constant), so this needs a real name -> callable-address table built
# into the binary, resolved at runtime -- there is real precedent for
# exactly this shape already in this backend: CallValue (this file's own
# closures work, see its header comment above: "an event-handler table
# is just a list of [name_string, closure] pairs, dispatched... through
# the exact same CallValue mechanism") already proves an INDIRECT call
# to a runtime-resolved PatLang function address works correctly under
# this backend's own (non-win64-ABI) calling convention -- no shadow
# space/16-byte-alignment dance needed for it, unlike a call to a real
# external WinAPI/CRT function; see x64_callvalue_asm's own `call r12`
# for the proven precedent this reuses.
#
# Deliberately kept mostly OUT of hand-written assembly: only the truly
# native operations (four primitives below) are asm; the actual name-
# matching scan is ORDINARY PATLANG (x64_runtime.patlang's own `apply`
# function, using the already-proven rt_str_eq), matching this file's
# own stated philosophy ("runtime logic belongs in PatLang, native
# primitives stay narrow" -- x64_exec_capture_asm's own header).
#
# The table itself (name -> function-pointer pairs, one entry per
# function in the WHOLE program except "main") is generated by
# x64_emit_apply_table_asm below as its own small, separately-linked
# object -- see x64_compile_unit.patlang's X64UnitLinker.build, which
# generates and links it on EVERY --x64 build unconditionally (a program
# that never calls apply() still gets a tiny unused table -- negligible
# cost, and avoids needing "does this program use apply()" detection at
# all). Table layout, 16 bytes per entry: [name_ptr:8][func_ptr:8],
# where name_ptr points at an ALREADY-VALID PatLang tagged-string
# payload ([8-byte length][raw bytes], the exact layout every other
# string in this backend uses -- see rt_print_str) so os_apply_table_
# name_at can hand back a real, usable tagged string just by OR-ing in
# the string-family tag bit, no copying needed.

make a function called x64_emit_apply_table_asm takes funcs returns asm
  let names = []
  let n_all = funcs.length
  let fi = 0
  while fi < n_all do
    let fname = funcs[fi][1]
    if fname != "main" then
      let names = list_push(names, fname)
    end
    let fi = fi + 1
  end
  let n = names.length
  let sb = sb_new()
  sb_push(sb, "default rel" + x64_nl_char())
  sb_push(sb, "global g_apply_table" + x64_nl_char())
  sb_push(sb, "global g_apply_table_count" + x64_nl_char())
  if n > 0 then
    let extern_line = sb_new()
    sb_push(extern_line, "extern ")
    let i = 0
    while i < n do
      if i > 0 then
        sb_push(extern_line, ", ")
      end
      sb_push(extern_line, x64_asm_label_for_func(names[i]))
      let i = i + 1
    end
    sb_push(sb, sb_str(extern_line) + x64_nl_char())
  end
  sb_push(sb, "section .data" + x64_nl_char())
  sb_push(sb, "g_apply_table_count: dq " + n + x64_nl_char())
  sb_push(sb, "g_apply_table:" + x64_nl_char())
  let i = 0
  while i < n do
    sb_push(sb, "  dq g_apply_name_" + i + x64_nl_char())
    sb_push(sb, "  dq " + x64_asm_label_for_func(names[i]) + x64_nl_char())
    let i = i + 1
  end
  let i = 0
  while i < n do
    sb_push(sb, "g_apply_name_" + i + ": dq " + names[i].length + x64_nl_char())
    sb_push(sb, "  db '" + names[i] + "'" + x64_nl_char())
    let i = i + 1
  end
  return sb_str(sb)
end

# os_apply_table_count() -> plain int, the table's entry count.
make a function called x64_os_apply_table_count_asm returns asm
  let sb = sb_new()
  sb_push(sb, "    mov rax, [rel g_apply_table_count]" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  return sb_str(sb)
end

# os_apply_table_name_at(i) -> the i'th entry's name, already a valid
# tagged PatLang string (see this section's own header for why no copy
# is needed).
make a function called x64_os_apply_table_name_at_asm returns asm
  let sb = sb_new()
  sb_push(sb, "    pop rax" + x64_nl_char())
  sb_push(sb, "    lea r10, [rel g_apply_table]" + x64_nl_char())
  sb_push(sb, "    mov r11, rax" + x64_nl_char())
  sb_push(sb, "    shl r11, 4" + x64_nl_char())
  sb_push(sb, "    add r10, r11" + x64_nl_char())
  sb_push(sb, "    mov rax, [r10]" + x64_nl_char())
  sb_push(sb, "    mov r15, 2305843009213693952" + x64_nl_char())
  sb_push(sb, "    or rax, r15" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  return sb_str(sb)
end

# os_apply_table_func_at(i) -> the i'th entry's RAW (untagged) callable
# code address, for os_call_indirect below.
make a function called x64_os_apply_table_func_at_asm returns asm
  let sb = sb_new()
  sb_push(sb, "    pop rax" + x64_nl_char())
  sb_push(sb, "    lea r10, [rel g_apply_table]" + x64_nl_char())
  sb_push(sb, "    mov r11, rax" + x64_nl_char())
  sb_push(sb, "    shl r11, 4" + x64_nl_char())
  sb_push(sb, "    add r10, r11" + x64_nl_char())
  sb_push(sb, "    mov rax, [r10+8]" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  return sb_str(sb)
end

# os_call_indirect(addr) -> calls the function at addr with ZERO args
# (apply()'s own contract), returns its result. The zero-capture,
# zero-own-arg special case of x64_callvalue_asm's proven `call r12`
# mechanism -- nothing to push before the call, nothing to clean up
# after (0 args popped means the stack-cleanup add would be `add rsp,
# 0`, so it's omitted rather than emitted as a no-op).
make a function called x64_os_call_indirect_asm returns asm
  let sb = sb_new()
  sb_push(sb, "    pop r12" + x64_nl_char())
  sb_push(sb, "    call r12" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  return sb_str(sb)
end

# ---- list_dir support (GitHub #31 follow-up, previously deferred --
# see [[patlang-x64-primitive-gap-fill-copy-rename-goap]]) ----
#
# An earlier attempt shelled out to cmd.exe's `dir /b` via
# exec_capture and was reverted after hitting a separate, pre-existing
# exec_capture output-buffer issue. This version uses genuine WinAPI
# (FindFirstFileA/FindNextFileA/FindClose against a WIN32_FIND_DATAA
# struct in g_finddata) instead, sidestepping the shell entirely --
# same reasoning as os_copy_file/os_rename_file above. Deliberately
# split into five narrow primitives (os_find_first/os_find_next/
# os_find_data_name/os_find_data_is_dir/os_find_close) with the
# iteration loop itself left to ORDINARY PatLang (list_dir in
# x64_runtime.patlang) -- matches this file's own established
# "runtime logic belongs in PatLang, native primitives stay narrow"
# philosophy (see exec_capture/sb_push's own headers).
#
# WIN32_FIND_DATAA field offsets used here (standard win64 layout):
#   dwFileAttributes: offset 0 (4 bytes)
#   cFileName:         offset 44 (260-byte null-terminated ANSI name)
# g_finddata is reserved at 592 bytes (the real sizeof on x64,
# generously rounded), more than the ~318 bytes actually addressed.

# os_find_first(path_addr, path_len) -> HANDLE, or -1 (INVALID_HANDLE_
# VALUE) if the directory doesn't exist or has no matching entries.
# Windows accepts forward slashes in paths fine (confirmed directly
# this session after an earlier, wrong assumption that backslashes
# were required -- see the copy_file/rename_file history above), so
# the search pattern is built as `path + "/*"`, no path translation
# needed.
# NOTE (thread-safety scope limit, named not silent): this locks its
# OWN g_scratch usage only. g_finddata (below, shared by find_first/
# find_next/find_data_name/find_data_is_dir across a WHOLE list_dir
# loop, not just one call) is NOT covered by that -- a real concurrent
# list_dir from two threads would still race on it. Deferred: nothing
# in this codebase currently calls list_dir from a background thread
# (canvas_host's own ls/cd/cat all run on the main thread only), and
# protecting a value that's shared across several SEPARATE primitive
# calls needs the CALLER (list_dir, x64_runtime.patlang) to hold the
# lock across all of them, not something an individual primitive here
# can self-contain the way g_scratch's single-call usage allows.
make a function called x64_os_find_first_asm returns asm
  let suffix = label_asm_safe(0)
  let sb = sb_new()
  sb_push(sb, x64_lock_acquire_asm(suffix))
  sb_push(sb, "    pop r10" + x64_nl_char())
  sb_push(sb, "    pop rax" + x64_nl_char())
  sb_push(sb, "    lea rdi, [rel g_scratch]" + x64_nl_char())
  sb_push(sb, "    xor rsi, rsi" + x64_nl_char())
  sb_push(sb, "  .ff_copy:" + x64_nl_char())
  sb_push(sb, "    cmp rsi, r10" + x64_nl_char())
  sb_push(sb, "    jge .ff_copy_done" + x64_nl_char())
  sb_push(sb, "    mov dl, [rax+rsi]" + x64_nl_char())
  sb_push(sb, "    mov [rdi+rsi], dl" + x64_nl_char())
  sb_push(sb, "    inc rsi" + x64_nl_char())
  sb_push(sb, "    jmp .ff_copy" + x64_nl_char())
  sb_push(sb, "  .ff_copy_done:" + x64_nl_char())
  sb_push(sb, "    mov byte [rdi+rsi], 47" + x64_nl_char())
  sb_push(sb, "    inc rsi" + x64_nl_char())
  sb_push(sb, "    mov byte [rdi+rsi], 42" + x64_nl_char())
  sb_push(sb, "    inc rsi" + x64_nl_char())
  sb_push(sb, "    mov byte [rdi+rsi], 0" + x64_nl_char())
  sb_push(sb, "    mov r15, rsp" + x64_nl_char())
  sb_push(sb, "    sub rsp, 32" + x64_nl_char())
  sb_push(sb, "    and rsp, -16" + x64_nl_char())
  sb_push(sb, "    lea rcx, [rel g_scratch]" + x64_nl_char())
  sb_push(sb, "    lea rdx, [rel g_finddata]" + x64_nl_char())
  sb_push(sb, "    call FindFirstFileA" + x64_nl_char())
  sb_push(sb, "    mov rsp, r15" + x64_nl_char())
  sb_push(sb, "    mov r14, rax" + x64_nl_char())
  sb_push(sb, x64_lock_release_asm())
  sb_push(sb, "    push r14" + x64_nl_char())
  return sb_str(sb)
end

# os_find_next(handle) -> 1/0, normalized from FindNextFileA's BOOL.
# Updates g_finddata on success, same as os_find_first.
make a function called x64_os_find_next_asm returns asm
  let sb = sb_new()
  sb_push(sb, "    pop rax" + x64_nl_char())
  sb_push(sb, "    mov r15, rsp" + x64_nl_char())
  sb_push(sb, "    sub rsp, 32" + x64_nl_char())
  sb_push(sb, "    and rsp, -16" + x64_nl_char())
  sb_push(sb, "    mov rcx, rax" + x64_nl_char())
  sb_push(sb, "    lea rdx, [rel g_finddata]" + x64_nl_char())
  sb_push(sb, "    call FindNextFileA" + x64_nl_char())
  sb_push(sb, "    mov rsp, r15" + x64_nl_char())
  sb_push(sb, "    cmp rax, 0" + x64_nl_char())
  sb_push(sb, "    je .fn_zero" + x64_nl_char())
  sb_push(sb, "    mov rax, 1" + x64_nl_char())
  sb_push(sb, "    jmp .fn_done" + x64_nl_char())
  sb_push(sb, "  .fn_zero:" + x64_nl_char())
  sb_push(sb, "    mov rax, 0" + x64_nl_char())
  sb_push(sb, "  .fn_done:" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  return sb_str(sb)
end

# os_find_data_name() -> tagged String, g_finddata's current cFileName
# (a null-terminated ANSI name at offset 44).
make a function called x64_os_find_data_name_asm returns asm
  let sb = sb_new()
  sb_push(sb, "    lea rax, [rel g_finddata]" + x64_nl_char())
  sb_push(sb, "    add rax, 44" + x64_nl_char())
  sb_push(sb, "    xor rcx, rcx" + x64_nl_char())
  sb_push(sb, "  .fdn_len:" + x64_nl_char())
  sb_push(sb, "    cmp byte [rax+rcx], 0" + x64_nl_char())
  sb_push(sb, "    je .fdn_len_done" + x64_nl_char())
  sb_push(sb, "    inc rcx" + x64_nl_char())
  sb_push(sb, "    jmp .fdn_len" + x64_nl_char())
  sb_push(sb, "  .fdn_len_done:" + x64_nl_char())
  # rcx (name length) is NOT guaranteed to survive `call rt_heap_alloc`
  # (a compiled PatLang function, not a real win64 ABI call) -- same
  # class of bug as x64_buildlist_asm's r12 clobber found earlier this
  # session, fixed here the same way via an explicit push/pop.
  sb_push(sb, "    push rcx" + x64_nl_char())
  sb_push(sb, "    mov rax, rcx" + x64_nl_char())
  sb_push(sb, "    add rax, 8" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  sb_push(sb, "    call rt_heap_alloc" + x64_nl_char())
  sb_push(sb, "    add rsp, 8" + x64_nl_char())
  sb_push(sb, "    mov r13, rax" + x64_nl_char())
  sb_push(sb, "    pop rcx" + x64_nl_char())
  sb_push(sb, "    mov [r13], rcx" + x64_nl_char())
  sb_push(sb, "    xor rdx, rdx" + x64_nl_char())
  sb_push(sb, "  .fdn_copy:" + x64_nl_char())
  sb_push(sb, "    cmp rdx, rcx" + x64_nl_char())
  sb_push(sb, "    jge .fdn_copy_done" + x64_nl_char())
  sb_push(sb, "    lea rax, [rel g_finddata]" + x64_nl_char())
  sb_push(sb, "    add rax, 44" + x64_nl_char())
  sb_push(sb, "    add rax, rdx" + x64_nl_char())
  sb_push(sb, "    movzx rax, byte [rax]" + x64_nl_char())
  sb_push(sb, "    mov r10, r13" + x64_nl_char())
  sb_push(sb, "    add r10, 8" + x64_nl_char())
  sb_push(sb, "    add r10, rdx" + x64_nl_char())
  sb_push(sb, "    mov [r10], al" + x64_nl_char())
  sb_push(sb, "    inc rdx" + x64_nl_char())
  sb_push(sb, "    jmp .fdn_copy" + x64_nl_char())
