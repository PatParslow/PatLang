    #    own cmdline_addr/cmdline_len across an internal rt_heap_alloc
    #    call.
    sb_push(sb, "    push r12" + x64_nl_char())
    sb_push(sb, "    mov rax, [r12+0]" + x64_nl_char())
    sb_push(sb, "    push rax" + x64_nl_char())
    sb_push(sb, "    mov rax, [r12+8]" + x64_nl_char())
    sb_push(sb, "    push rax" + x64_nl_char())
    let ri = 0
    while ri < k do
      sb_push(sb, "    mov rax, [r12+" + ((2 + ri) * 8) + "]" + x64_nl_char())
      sb_push(sb, "    push rax" + x64_nl_char())
      let ri = ri + 1
    end
    sb_push(sb, x64_buildlist_asm(k))
    sb_push(sb, "    call rt_send_prepare" + x64_nl_char())
    sb_push(sb, "    add rsp, 24" + x64_nl_char())
    sb_push(sb, "    mov r13, rax" + x64_nl_char())
    sb_push(sb, "    pop r12" + x64_nl_char())
    sb_push(sb, "    cmp r13, 0" + x64_nl_char())
    sb_push(sb, "    je .SEND_DONE_" + suffix + x64_nl_char())
    # 3. Real method found -- invoke via x64_callvalue_asm: push recv,
    #    then rest-args (in order, matching the real interpreter's own
    #    `full_args = captured(none) + [recv] + rest`) -- x64_callvalue_
    #    asm's OWN calling convention (see its own header/step comments)
    #    expects the CLOSURE pushed FIRST, then the own-args pushed on
