    sb_push(sb, "    cmp r10, 0" + x64_nl_char())
    sb_push(sb, "    je .DYN_OBJCMP_NOTSTR_" + suffix + x64_nl_char())
    sb_push(sb, "    push qword [rbp-" + dyn_a + "]" + x64_nl_char())
    sb_push(sb, "    push qword [rbp-" + dyn_b + "]" + x64_nl_char())
    if op == "==" then
