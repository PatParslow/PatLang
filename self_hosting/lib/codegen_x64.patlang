  # ORDINARY compiled PatLang function, and this file's own established,
  # documented rule (see the cmdline-preservation comment above) is that
  # such calls give NO register-preservation guarantee at all, r15
  # included. Confirmed via WinDbg on a genuine crash: r15 held
  # 0xF000000000000000 (the family-nibble mask constant used throughout
  # this file's own dynamic-mode tag checks) at the point of the later
  # `mov rsp, r15restore -- rt_heap_alloc's own compiled body clobbers
  # r15 internally, and nothing here protected the saved value across
  # that call, so the "restore" corrupted the real stack pointer
  # outright (a `push` right after crashed immediately, rsp pointing at
  # unmapped memory). This never surfaced before because exec_capture
  # had never previously been called from an --x64-COMPILED program at
  # runtime -- every earlier exec_capture caller was --patc/rustc-
  # compiled, which doesn't share this backend's register convention at
  # all. Fixed the same way r14/cmdline already is: push r15 onto the
  # REAL machine stack before the call, pop it back immediately after.
  sb_push(sb, "    push r15" + x64_nl_char())
  sb_push(sb, "    mov rax, 65544" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  sb_push(sb, "    call rt_heap_alloc" + x64_nl_char())
  sb_push(sb, "    add rsp, 8" + x64_nl_char())
  sb_push(sb, "    pop r15" + x64_nl_char())
  sb_push(sb, "    mov rsi, rax" + x64_nl_char())
  sb_push(sb, "    lea r13, [rax+8]" + x64_nl_char())
  sb_push(sb, "    xor rbx, rbx" + x64_nl_char())
  sb_push(sb, "    mov r14, 65536" + x64_nl_char())
  # Read loop: r12=readHandle, r13=output data start, rbx=total STORED
  # so far, r14=65536-byte cap.
  #
  # ROOT CAUSE FOUND AND FIXED HERE, via a live user report
  # (terminal_native.exe capturing garbled/wrong-length output for
  # `type`/`dir`/`ls`, reproduced down to `echo hello`: 7 real bytes,
  # consistently reported as a captured length of 105, with the real
  # "hello\r\n" bytes correctly written at the start and everything past
  # them genuinely zero, not garbage): the running total used to be
  # accumulated in r10 across MULTIPLE ReadFile calls (`add r10, rax`
  # each iteration, re-read at the top of the next). r10 is NOT a
  # callee-saved register under the real win64 ABI -- only rbx, rbp,
  # rdi, rsi, rsp, r12, r13, r14, r15 are (confirmed against the ABI
  # spec, not assumed by analogy to r12-r15's own correctly-documented
  # safety elsewhere in this file). ReadFile is free to clobber r10
  # internally (Windows' own syscall trampolines commonly use r10/r11
  # as scratch), and empirically does: within a single iteration r10 is
  # used correctly for addressing BEFORE the ReadFile call, but the
  # NEXT iteration's cap-check and accumulation read back whatever
  # ReadFile left in r10, not the real running total -- explaining
  # exactly the observed shape (correct bytes at the correct addresses,
  # wrong bookkeeping). Fixed by moving the accumulator to rbx, a
  # genuinely callee-saved register not otherwise used in this function
  # -- its own pre-call value is saved/restored via a dedicated stack
  # slot (see this function's own prologue, [rsp+280]) since it may be
  # live in the CALLER's own code (this primitive is inlined directly
  # into whatever PatLang function calls os_exec_run/exec_capture, not
  # a real function-call boundary that would otherwise imply this).
  #
  # Real bug found and fixed here, caught by an actual hang (not
  # review): once total reaches the cap, the ORIGINAL version simply
  # stopped calling ReadFile at all -- but the child process (e.g.
  # `dir` on a large directory) keeps trying to WRITE its remaining
  # output into the pipe, and once nobody's reading, the pipe fills up
  # and the child's own WriteFile call blocks. WaitForSingleObject
  # then waits FOREVER for a process that will never finish writing.
  # This is the classic Win32 "must keep draining the pipe or the
  # child deadlocks" gotcha. Fixed: once the real buffer is full,
  # KEEP calling ReadFile (so the child can keep writing and
  # eventually finish/exit) but redirect those reads into a small
  # THROWAWAY buffer (reusing g_scratch) instead of growing rbx/
  # writing past the allocated output block -- draining without
  # storing, until real EOF (ReadFile returns 0 bytes), only then
  # falling through to WaitForSingleObject.
  sb_push(sb, "    mov r12, [rsp+104]" + x64_nl_char())
  sb_push(sb, "  .exec_read_loop_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    cmp rbx, r14" + x64_nl_char())
  sb_push(sb, "    jl .exec_read_normal_" + suffix + x64_nl_char())
  sb_push(sb, "    lea rdx, [rel g_scratch]" + x64_nl_char())
  sb_push(sb, "    mov r8, 256" + x64_nl_char())
  sb_push(sb, "    jmp .exec_read_common_" + suffix + x64_nl_char())
  sb_push(sb, "  .exec_read_normal_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    lea rdx, [r13+rbx]" + x64_nl_char())
  sb_push(sb, "    mov r8, r14" + x64_nl_char())
  sb_push(sb, "    sub r8, rbx" + x64_nl_char())
  sb_push(sb, "  .exec_read_common_" + suffix + ":" + x64_nl_char())
  # [rsp+272] (lpNumberOfBytesRead's target) is explicitly zeroed
  # immediately before EVERY ReadFile call, not just once outside the
  # loop -- defensive, in case some other edge case leaves it stale
  # without the rbx fix above already being what matters here.
  sb_push(sb, "    mov qword [rsp+272], 0" + x64_nl_char())
  sb_push(sb, "    mov rcx, r12" + x64_nl_char())
  sb_push(sb, "    lea r9, [rsp+272]" + x64_nl_char())
  sb_push(sb, "    mov qword [rsp+32], 0" + x64_nl_char())
  sb_push(sb, "    call ReadFile" + x64_nl_char())
  sb_push(sb, "    cmp rax, 0" + x64_nl_char())
  sb_push(sb, "    je .exec_read_done_" + suffix + x64_nl_char())
  sb_push(sb, "    mov eax, [rsp+272]" + x64_nl_char())
  sb_push(sb, "    cmp rax, 0" + x64_nl_char())
  sb_push(sb, "    je .exec_read_done_" + suffix + x64_nl_char())
  sb_push(sb, "    cmp rbx, r14" + x64_nl_char())
  sb_push(sb, "    jge .exec_read_loop_" + suffix + x64_nl_char())
  sb_push(sb, "    add rbx, rax" + x64_nl_char())
  sb_push(sb, "    jmp .exec_read_loop_" + suffix + x64_nl_char())
  sb_push(sb, "  .exec_read_done_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    mov qword [rsi], rbx" + x64_nl_char())
  sb_push(sb, "    mov rcx, [rsp+240]" + x64_nl_char())
  sb_push(sb, "    mov rdx, -1" + x64_nl_char())
  sb_push(sb, "    call WaitForSingleObject" + x64_nl_char())
  # Real exit code, not the length-of-output heuristic run_classified's
  # own PatLang-level caller (exec_capture_io, x64_runtime.patlang) used
  # to rely on -- found and fixed directly, via terminal_native.patlang
  # itself: a genuinely FAILING command (cmd.exe reporting "not
  # recognized") still produces non-empty output (the error text
  # itself), so a length-based "success" check misreported almost every
  # real failure as success. [rsp+272] is free to reuse here -- its
  # earlier use for the read loop's own bytesRead scratch is long done
  # by this point (the loop already exited into .exec_read_done_
  # above). rcx must be RELOADED (not assumed to survive
  # WaitForSingleObject -- it's a volatile/caller-saved register under
  # the real win64 ABI, unlike rbx/rbp/rdi/rsi/r12-r15/rsp).
  sb_push(sb, "    mov rcx, [rsp+240]" + x64_nl_char())
  sb_push(sb, "    lea rdx, [rsp+272]" + x64_nl_char())
  sb_push(sb, "    call GetExitCodeProcess" + x64_nl_char())
  sb_push(sb, "    mov rax, [rsp+272]" + x64_nl_char())
  sb_push(sb, "    mov [rel g_last_exec_exit_code], rax" + x64_nl_char())
  sb_push(sb, "    mov rcx, r12" + x64_nl_char())
  sb_push(sb, "    call CloseHandle" + x64_nl_char())
  sb_push(sb, "    mov rcx, [rsp+240]" + x64_nl_char())
  sb_push(sb, "    call CloseHandle" + x64_nl_char())
  sb_push(sb, "    mov rcx, [rsp+248]" + x64_nl_char())
  sb_push(sb, "    call CloseHandle" + x64_nl_char())
  sb_push(sb, "    jmp .exec_all_done_" + suffix + x64_nl_char())
  sb_push(sb, "  .exec_failed_" + suffix + ":" + x64_nl_char())
  # -1: distinguishable from every real process exit code (0-255) --
  # CreateProcessA never even started the child, so there is no real
  # exit code to report.
  sb_push(sb, "    mov qword [rel g_last_exec_exit_code], -1" + x64_nl_char())
  sb_push(sb, "    mov rcx, [rsp+104]" + x64_nl_char())
  sb_push(sb, "    call CloseHandle" + x64_nl_char())
  sb_push(sb, "    mov rcx, [rsp+112]" + x64_nl_char())
  sb_push(sb, "    call CloseHandle" + x64_nl_char())
  # Same r15-across-rt_heap_alloc bug as the success path above, same fix.
  sb_push(sb, "    push r15" + x64_nl_char())
  sb_push(sb, "    mov rax, 8" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  sb_push(sb, "    call rt_heap_alloc" + x64_nl_char())
  sb_push(sb, "    add rsp, 8" + x64_nl_char())
  sb_push(sb, "    pop r15" + x64_nl_char())
  sb_push(sb, "    mov qword [rax], 0" + x64_nl_char())
  sb_push(sb, "    mov rsi, rax" + x64_nl_char())
  sb_push(sb, "  .exec_all_done_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    mov rax, rsi" + x64_nl_char())
  # Restore the CALLER's rbx (saved at [rsp+280] in this function's own
  # prologue) BEFORE collapsing the stack below -- once `mov rsp, r15`
  # runs, [rsp+280] no longer refers to this function's own frame at
  # all. Reached from both the success path (falls through from
  # .exec_read_done_ above) and the .exec_failed_ path (jumps here
  # directly) -- both must restore it the same way.
  sb_push(sb, "    mov rbx, [rsp+280]" + x64_nl_char())
  # GitHub #30/#31 investigation: this used to be "mov rsp,r15; add rsp,
  # 16" -- but r15 (saved right after the caller's cmdline_len/cmdline_
  # addr pair was already popped into registers, see the comment above
  # "mov r15, rsp") already represents the correct stack depth with
  # NOTHING outstanding; a WinDbg checkpoint diff (entry rsp vs rsp right
  # after this whole CallHost completes, GitHub #30's own comment trail)
  # measured a genuine, reproducible stack-pointer drift traced to this
  # exact "+16" being spurious. Removed.
  sb_push(sb, "    mov rsp, r15" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  return sb_str(sb)
end

# ============================================================
# Canvas host, Phase 1: Win32 window + GDI pixel blit primitives.
# ============================================================
#
# Confirmed 100% greenfield before starting (grepped across
# self_hosting for CreateWindowEx/RegisterClassEx/BitBlt/StretchDIBits/
# GetMessage/WndProc/CreatePseudoConsole -- zero matches anywhere).
# user32.dll/gdi32.dll are already linked by x64_build.patlang
# (-luser32 -lgdi32) but had zero actual calls into either before this.
#
# WndProc problem: Win32 invokes a window procedure using the REAL
# Win64 ABI (register args rcx/rdx/r8/r9), but this backend's own
# compiled-function calling convention pushes args onto the stack -- a
# compiled PatLang function cannot be registered as lpfnWndProc
# directly and correctly receive Win32's call. Resolved by registering
# a single FIXED trampoline (emitted once as literal asm text directly
# in emit_program_x64, see x64_win_data_and_trampoline_asm below, NOT
# compiled from any IR function) that tail-jumps straight to
# DefWindowProcW -- Win32 already places (hwnd,msg,wParam,lParam) in
# rcx/rdx/r8/r9 exactly as DefWindowProcW itself expects, so the
# trampoline needs no prologue at all. ALL real message handling
# happens by inspecting the peeked MSG inside win_peek_message's own
# polling loop (ordinary PatLang-driven control flow, a plain call/
# return this backend already supports), BEFORE DispatchMessageW is
# even invoked for anything WM_PAINT itself doesn't already fully
# service inline. Win32 never actually calls into PatLang-compiled
# logic anywhere in this design.
#
# Canvas surface is 32bpp BGRX (not RGB24, matching image.patlang's
# own buffers) -- every row is already 4-byte aligned with zero
# padding math, sidestepping the DIB row-padding pitfall entirely for
# the canvas's own primary surface. image.patlang's RGB24 buffers get
# converted at blit time only (Phase 5, canvas_blit_image), not here.

make a function called x64_win_data_and_trampoline_asm returns asm
  let sb = sb_new()
  # REAL BUG FOUND AND FIXED (caught by an actual linker error, not
  # review): NASM labels are file-local by default -- these two data
  # labels were correctly DEFINED in this unit's own .data section but
  # never marked `global`, so the linker genuinely could not see them
  # from any other unit's `extern` declaration, even though both sides
  # otherwise agreed on the symbol names.
  sb_push(sb, "global g_win_class_name, g_win_title" + x64_nl_char())
  sb_push(sb, "    align 2" + x64_nl_char())
  # Fixed window-class name and title, UTF-16LE (Basic Latin code
  # points are numerically identical to ASCII, so plain NASM character
  # constants are valid UTF-16 code units here). One fixed class/title
  # is enough for Phase 1's own goal (prove painting works at all) --
  # a general string-to-wide conversion helper can be added later
  # (plain PatLang, not asm -- pure byte manipulation, no WinAPI call
  # needed) once a real caller needs a runtime-variable title.
  sb_push(sb, "    g_win_class_name: dw 'P','a','t','L','a','n','g','C','a','n','v','a','s',0" + x64_nl_char())
  sb_push(sb, "    align 2" + x64_nl_char())
  sb_push(sb, "    g_win_title: dw 'P','a','t','L','a','n','g',' ','C','a','n','v','a','s',0" + x64_nl_char())
  sb_push(sb, x64_nl_char())
  # Explicit section switch, even though the caller's own next line
  # already re-declares "section .text" right after this whole block
  # is inserted -- NASM allows repeated section directives (they just
  # resume appending to that section), so the caller's own redundant
  # declaration is harmless. Switching HERE, rather than relying on
  # insertion-point ordering alone, keeps this function correct
  # regardless of exactly where its output gets spliced in.
  sb_push(sb, "section .text" + x64_nl_char())
  sb_push(sb, "global patlang_wndproc_trampoline" + x64_nl_char())
  sb_push(sb, "patlang_wndproc_trampoline:" + x64_nl_char())
  # REAL BUG FOUND AND FIXED (a real resize produced no visible effect
  # at all, not even a crash -- the DIB buffer was simply never
  # reallocated): the ORIGINAL version of this trampoline was a bare
  # tail-jump, on the assumption every message worth reacting to
  # (WM_CLOSE, WM_CHAR, ...) arrives via the QUEUE win_peek_message's
  # own PeekMessageW polls. WM_SIZE doesn't -- Windows delivers it via
  # SendMessage, a direct synchronous CALL into the window procedure
  # (this label) from inside whatever triggered the resize (SetWindowPos,
  # dragging the window border, ...), never touching the queue at all.
  # This trampoline is the ONLY code that ever sees it, so it now
  # checks for it here and records the new size for win_peek_message to
  # pick up on its next poll (see g_resize_pending's own .bss header),
  # rather than trying to catch something that was never queued.
  #
  # WNDPROC's real Win64 ABI args: hwnd=rcx, msg=rdx, wParam=r8,
  # lParam=r9 -- ALL FOUR must reach the final `jmp DefWindowProcW`
  # completely unmodified (a tail-jump reuses the caller's own argument
  # registers), so only rax/r10/r11 (not part of that 4-arg contract)
  # are used as scratch here, and r9 (lParam) is only ever READ, never
  # written.
  sb_push(sb, "    cmp edx, 5" + x64_nl_char())
  sb_push(sb, "    jne .wndproc_notsize_" + x64_nl_char())
  sb_push(sb, "    mov eax, r9d" + x64_nl_char())
  sb_push(sb, "    movzx r10, ax" + x64_nl_char())
  sb_push(sb, "    shr eax, 16" + x64_nl_char())
  sb_push(sb, "    movzx r11, ax" + x64_nl_char())
  sb_push(sb, "    mov [rel g_resize_w], r10" + x64_nl_char())
  sb_push(sb, "    mov [rel g_resize_h], r11" + x64_nl_char())
  sb_push(sb, "    mov qword [rel g_resize_pending], 1" + x64_nl_char())
  sb_push(sb, "  .wndproc_notsize_:" + x64_nl_char())
  sb_push(sb, "    jmp DefWindowProcW" + x64_nl_char())
  return sb_str(sb)
end

# patlang_thread_trampoline -- the fixed LPTHREAD_START_ROUTINE
# (DWORD WINAPI (LPVOID lpParam)) every thread_spawn call passes to
# CreateThread, same "one real global label, gated behind owns_globals"
# pattern as patlang_wndproc_trampoline just above (see its own header
# for why this MUST be gated -- a real link failure the first time this
# codebase hit it).
#
# lpParam (rcx) points at a context block thread_spawn built by copying
# a real closure value's own fields (same layout MakeClosure/CallValue
# already use, see x64_thread_spawn_asm's own header):
#   [0]  code_addr    -- the target PatLang function's entry label
#   [8]  argc         -- number of captured/passed values
#   [16] done_flag    -- 0 until this trampoline finishes, then 1
#   [24] result       -- the target function's own return value
#   [32..] arg0..argN-1
#
# Pushes args in the SAME order a normal call site would (arg0 pushed
# first/deepest -- see x64_callvalue_asm's own captured-value loop,
# identical shape), then calls the target function via its OWN
# ordinary PatLang calling convention on THIS thread's own (Windows-
# allocated) stack -- no manual stack setup needed here, unlike a real
# fiber, since CreateThread already gives every thread a full, real OS
# stack of its own.
#
# result then done_flag, in that order: x86 doesn't reorder store-store
# (a genuine architectural guarantee on this target, not an assumption)
# -- a caller polling done_flag then reading result is real, roughly
# correct, memory-ordering-first inter-thread handoff.
#
# REAL BUG FOUND AND FIXED (caught by re-deriving the calling
# convention from x64_callvalue_asm's own real code, not from a
# recalled/assumed description of it): PatLang's compiled-function
# convention is CALLER-cleans, not callee-pops -- x64_callvalue_asm's
# own post-call cleanup (`add rsp, (n+captured)*8` AFTER `call r12`,
# comment: "captured count is read back from THIS frame's own private
# slot... not from any register") proves the callee does a plain `ret`
# with the result in rax and does NOT itself remove its own pushed
# args; the CALLER always does that. The first version of this
# trampoline held the context pointer in rbx across `call r12`,
# assuming a register could survive an opaque PatLang-function call --
# it can't (this file's own universal rule, restated in that exact
# function's own comment). Fixed the same way x64_callvalue_asm fixes
# it: a real rbp-relative local frame slot, immune to whatever the
# callee does to registers, holding both the context pointer AND argc
# (needed again after the call, to know how many pushed arg slots to
# reclaim) across the call.
make a function called x64_thread_trampoline_asm returns asm
  let sb = sb_new()
  sb_push(sb, "global patlang_thread_trampoline" + x64_nl_char())
  sb_push(sb, "patlang_thread_trampoline:" + x64_nl_char())
  sb_push(sb, "    push rbp" + x64_nl_char())
  sb_push(sb, "    mov rbp, rsp" + x64_nl_char())
  sb_push(sb, "    sub rsp, 16" + x64_nl_char())
  sb_push(sb, "    mov [rbp-8], rcx" + x64_nl_char())
  sb_push(sb, "    mov r12, [rcx]" + x64_nl_char())
  sb_push(sb, "    mov r13, [rcx+8]" + x64_nl_char())
  sb_push(sb, "    mov [rbp-16], r13" + x64_nl_char())
  sb_push(sb, "    xor r10, r10" + x64_nl_char())
  sb_push(sb, "  .tt_push_loop:" + x64_nl_char())
  sb_push(sb, "    cmp r10, r13" + x64_nl_char())
  sb_push(sb, "    jge .tt_push_done" + x64_nl_char())
  sb_push(sb, "    mov rax, [rcx+32+r10*8]" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  sb_push(sb, "    inc r10" + x64_nl_char())
  sb_push(sb, "    jmp .tt_push_loop" + x64_nl_char())
  sb_push(sb, "  .tt_push_done:" + x64_nl_char())
  sb_push(sb, "    call r12" + x64_nl_char())
  # rax = result. Reclaim the N pushed arg slots (caller-cleans) using
  # the STABLE [rbp-16] copy of argc, not r13 (not guaranteed to have
  # survived the call).
  sb_push(sb, "    mov r10, [rbp-16]" + x64_nl_char())
  sb_push(sb, "    shl r10, 3" + x64_nl_char())
  sb_push(sb, "    add rsp, r10" + x64_nl_char())
  sb_push(sb, "    mov rcx, [rbp-8]" + x64_nl_char())
  sb_push(sb, "    mov [rcx+24], rax" + x64_nl_char())
  sb_push(sb, "    mov qword [rcx+16], 1" + x64_nl_char())
  sb_push(sb, "    mov rsp, rbp" + x64_nl_char())
  sb_push(sb, "    pop rbp" + x64_nl_char())
  sb_push(sb, "    xor eax, eax" + x64_nl_char())
  sb_push(sb, "    ret" + x64_nl_char())
  return sb_str(sb)
end

# win_create_window(width, height) -> hwnd. Registers a fixed window
# class (lpfnWndProc = the trampoline above) and creates a visible
# top-level window of the given client-adjacent size. Stores the
# result in g_hwnd (every later primitive here reads that global
# rather than taking hwnd as an explicit arg, matching g_last_exec_
# exit_code's own single-persistent-value convention) and also returns
# it directly.
make a function called x64_win_create_window_asm returns asm
  let sb = sb_new()
  # Args: width, height (pushed in that order by the caller -- pop in
  # reverse, matching x64_os_exec_run_asm's own established 2-arg
  # convention: last-pushed is popped first).
  sb_push(sb, "    pop r10" + x64_nl_char())
  sb_push(sb, "    pop rax" + x64_nl_char())
  # r10=height, rax=width. Saved on the REAL machine stack (not left
  # in a register) across every call below -- this backend's own
  # PatLang-function calls give no register-preservation guarantee at
  # all (already-established rule, see x64_os_exec_run_asm's own
  # header), and even genuine WinAPI calls only preserve rbx/rbp/rdi/
  # rsi/rsp/r12-r15 under the real Win64 ABI, not rax/r10. Peeked via
  # r15-relative addressing (not popped a second time) since both
  # values are needed again, at a fixed known offset, well after
  # several other calls have happened.
  sb_push(sb, "    push rax" + x64_nl_char())
  sb_push(sb, "    push r10" + x64_nl_char())
  sb_push(sb, "    mov r15, rsp" + x64_nl_char())
  sb_push(sb, "    sub rsp, 256" + x64_nl_char())
  sb_push(sb, "    and rsp, -16" + x64_nl_char())
  # GetModuleHandleW(NULL) -> hInstance, saved at [rsp+176] (a scratch
  # slot outside the WNDCLASSEXW struct's own [rsp+96,rsp+176) range
  # below, and outside [rsp+32,rsp+96) which CreateWindowExW's own
  # stack args reuse later in this same aligned frame).
  sb_push(sb, "    xor rcx, rcx" + x64_nl_char())
  sb_push(sb, "    call GetModuleHandleW" + x64_nl_char())
  sb_push(sb, "    mov [rsp+176], rax" + x64_nl_char())
  # WNDCLASSEXW at [rsp+96], 80 bytes total: cbSize@0 style@4
  # lpfnWndProc@8 cbClsExtra@16 cbWndExtra@20 hInstance@24 hIcon@32
  # hCursor@40 hbrBackground@48 lpszMenuName@56 lpszClassName@64
  # hIconSm@72 (struct offsets, added to the base rsp+96). style=3 =
  # CS_HREDRAW|CS_VREDRAW so resizing correctly triggers WM_PAINT.
  # hIcon/hCursor/hbrBackground left NULL -- deliberately: this window
  # never wants Win32's own background erase (we repaint the whole
  # client area ourselves on every WM_PAINT), and a missing cursor/
  # icon is a cosmetic gap acceptable for Phase 1's own proof-of-
  # painting goal, not a correctness blocker.
  sb_push(sb, "    mov dword [rsp+96], 80" + x64_nl_char())
  sb_push(sb, "    mov dword [rsp+100], 3" + x64_nl_char())
  sb_push(sb, "    lea rax, [rel patlang_wndproc_trampoline]" + x64_nl_char())
  sb_push(sb, "    mov [rsp+104], rax" + x64_nl_char())
  sb_push(sb, "    mov dword [rsp+112], 0" + x64_nl_char())
  sb_push(sb, "    mov dword [rsp+116], 0" + x64_nl_char())
  sb_push(sb, "    mov rax, [rsp+176]" + x64_nl_char())
  sb_push(sb, "    mov [rsp+120], rax" + x64_nl_char())
  sb_push(sb, "    mov qword [rsp+128], 0" + x64_nl_char())
  sb_push(sb, "    mov qword [rsp+136], 0" + x64_nl_char())
  sb_push(sb, "    mov qword [rsp+144], 0" + x64_nl_char())
  sb_push(sb, "    mov qword [rsp+152], 0" + x64_nl_char())
  sb_push(sb, "    lea rax, [rel g_win_class_name]" + x64_nl_char())
  sb_push(sb, "    mov [rsp+160], rax" + x64_nl_char())
  sb_push(sb, "    mov qword [rsp+168], 0" + x64_nl_char())
  sb_push(sb, "    lea rcx, [rsp+96]" + x64_nl_char())
  sb_push(sb, "    call RegisterClassExW" + x64_nl_char())
  # CreateWindowExW(0, className, title, WS_OVERLAPPEDWINDOW=0x00CF0000,
  #   CW_USEDEFAULT, CW_USEDEFAULT, width, height, NULL, NULL,
  #   hInstance, NULL). 12 args: 4 in registers (rcx/rdx/r8/r9), 8 on
  # the stack at [rsp+32..96) -- the SAME bytes RegisterClassExW's own
  # call just used for ITS shadow space, reused here now that call is
  # done, matching x64_os_exec_run_asm's established pattern of
  # reusing one fixed stack region across sequential (never
  # simultaneous) calls within one aligned frame. width is [r15+8]
  # (pushed first, so deeper/second-from-top), height is [r15+0]
  # (pushed second, so on top) -- read via r15, NOT rsp, since rsp now
  # points into this frame's own scratch area, not the saved-args pair.
  sb_push(sb, "    xor rcx, rcx" + x64_nl_char())
  sb_push(sb, "    lea rdx, [rel g_win_class_name]" + x64_nl_char())
  sb_push(sb, "    lea r8, [rel g_win_title]" + x64_nl_char())
  sb_push(sb, "    mov r9, 13565952" + x64_nl_char())
  sb_push(sb, "    mov qword [rsp+32], -2147483648" + x64_nl_char())
  sb_push(sb, "    mov qword [rsp+40], -2147483648" + x64_nl_char())
  sb_push(sb, "    mov rax, [r15+8]" + x64_nl_char())
  sb_push(sb, "    mov [rsp+48], rax" + x64_nl_char())
  sb_push(sb, "    mov rax, [r15]" + x64_nl_char())
  sb_push(sb, "    mov [rsp+56], rax" + x64_nl_char())
  sb_push(sb, "    mov qword [rsp+64], 0" + x64_nl_char())
  sb_push(sb, "    mov qword [rsp+72], 0" + x64_nl_char())
  sb_push(sb, "    mov rax, [rsp+176]" + x64_nl_char())
  sb_push(sb, "    mov [rsp+80], rax" + x64_nl_char())
  sb_push(sb, "    mov qword [rsp+88], 0" + x64_nl_char())
  sb_push(sb, "    call CreateWindowExW" + x64_nl_char())
  sb_push(sb, "    mov [rel g_hwnd], rax" + x64_nl_char())
  sb_push(sb, "    mov rcx, rax" + x64_nl_char())
  sb_push(sb, "    mov rdx, 1" + x64_nl_char())
  sb_push(sb, "    call ShowWindow" + x64_nl_char())
  sb_push(sb, "    mov rcx, [rel g_hwnd]" + x64_nl_char())
  sb_push(sb, "    call UpdateWindow" + x64_nl_char())
  sb_push(sb, "    mov rax, [rel g_hwnd]" + x64_nl_char())
  # Restore rsp past BOTH the aligned scratch frame AND the two
  # peeked-not-popped saved args ([r15,r15+16)) -- r15 alone would
  # leave those 16 bytes still logically "on the stack" from the
  # caller's perspective; +16 actually consumes them, so the net
  # effect of this whole inlined primitive is "pop 2 args, push 1
  # return value" as expected.
  sb_push(sb, "    mov rsp, r15" + x64_nl_char())
  sb_push(sb, "    add rsp, 16" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  return sb_str(sb)
end

# win_canvas_alloc(width, height) -> raw buf address. (Re)allocates
# the canvas pixel surface via rt_heap_alloc (an ordinary PatLang-
# convention call -- r15 must be saved/restored around it, same
# already-established rule/bug class as x64_os_exec_run_asm's own two
# rt_heap_alloc call sites). 32bpp BGRX, width*height*4 bytes, no row
# padding. Returns the raw untagged address directly so PatLang-level
# test/drawing code can mem_poke_byte into it exactly like image.
# patlang's own buffers.
make a function called x64_win_canvas_alloc_asm returns asm
  let sb = sb_new()
  sb_push(sb, "    pop r10" + x64_nl_char())
  sb_push(sb, "    pop rax" + x64_nl_char())
  # r10=height, rax=width.
  sb_push(sb, "    mov r15, rsp" + x64_nl_char())
  sb_push(sb, "    sub rsp, 32" + x64_nl_char())
  sb_push(sb, "    and rsp, -16" + x64_nl_char())
  sb_push(sb, "    imul rax, r10" + x64_nl_char())
  sb_push(sb, "    imul rax, 4" + x64_nl_char())
  sb_push(sb, "    push r15" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  sb_push(sb, "    call rt_heap_alloc" + x64_nl_char())
  sb_push(sb, "    add rsp, 8" + x64_nl_char())
  sb_push(sb, "    pop r15" + x64_nl_char())
  sb_push(sb, "    mov [rel g_canvas_buf], rax" + x64_nl_char())
  sb_push(sb, "    mov rsp, r15" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  return sb_str(sb)
end

# win_canvas_init_dib(width, height) -> raw buf address. Phase 3
# upgrade of win_canvas_alloc: instead of a bare rt_heap_alloc buffer,
# builds a real GDI DIB-section bitmap (CreateDIBSection) selected
# into a memory DC (g_mem_dc) -- ppvBits (the raw pixel pointer
# CreateDIBSection hands back) becomes g_canvas_buf exactly as before,
# so every existing mem_poke_byte-based caller (canvas_set_pixel, the
# Phase 1 gradient test) keeps working unchanged, while GDI text
# drawing (win_text_out) now ALSO writes into that same memory via
# TextOutA against g_mem_dc. win_canvas_alloc itself is left in place,
# unused -- superseded, not deleted, in case a future need for a bare
# non-GDI buffer resurfaces.
make a function called x64_win_canvas_init_dib_asm returns asm
  let sb = sb_new()
  sb_push(sb, "    pop r10" + x64_nl_char())
  sb_push(sb, "    pop rax" + x64_nl_char())
  # r10=height, rax=width -- saved via push/peek-via-r15, same
  # established pattern as win_create_window's own 2-arg handling.
  sb_push(sb, "    push rax" + x64_nl_char())
  sb_push(sb, "    push r10" + x64_nl_char())
  sb_push(sb, "    mov r15, rsp" + x64_nl_char())
  sb_push(sb, "    sub rsp, 128" + x64_nl_char())
  sb_push(sb, "    and rsp, -16" + x64_nl_char())
  # BITMAPINFOHEADER in g_bmih_scratch (persistent .bss, shared with
  # win_peek_message's OWN prior use of it -- safe, since that use is
  # now replaced by a plain BitBlt below and no longer touches it).
  # Negative biHeight = top-down, matching image.patlang's own layout.
  sb_push(sb, "    mov dword [rel g_bmih_scratch+0], 40" + x64_nl_char())
  sb_push(sb, "    mov rax, [r15+8]" + x64_nl_char())
  sb_push(sb, "    mov [rel g_bmih_scratch+4], eax" + x64_nl_char())
  sb_push(sb, "    mov rax, [r15]" + x64_nl_char())
  sb_push(sb, "    neg rax" + x64_nl_char())
  sb_push(sb, "    mov [rel g_bmih_scratch+8], eax" + x64_nl_char())
  sb_push(sb, "    mov word [rel g_bmih_scratch+12], 1" + x64_nl_char())
  sb_push(sb, "    mov word [rel g_bmih_scratch+14], 32" + x64_nl_char())
  sb_push(sb, "    mov dword [rel g_bmih_scratch+16], 0" + x64_nl_char())
  sb_push(sb, "    mov dword [rel g_bmih_scratch+20], 0" + x64_nl_char())
  sb_push(sb, "    mov dword [rel g_bmih_scratch+24], 0" + x64_nl_char())
  sb_push(sb, "    mov dword [rel g_bmih_scratch+28], 0" + x64_nl_char())
  sb_push(sb, "    mov dword [rel g_bmih_scratch+32], 0" + x64_nl_char())
  # GetDC(g_hwnd) -> a temporary screen DC, only needed as a reference
  # for CreateCompatibleDC; released again right after.
  sb_push(sb, "    mov rcx, [rel g_hwnd]" + x64_nl_char())
  sb_push(sb, "    call GetDC" + x64_nl_char())
  sb_push(sb, "    mov r12, rax" + x64_nl_char())
  sb_push(sb, "    mov rcx, r12" + x64_nl_char())
  sb_push(sb, "    call CreateCompatibleDC" + x64_nl_char())
  sb_push(sb, "    mov [rel g_mem_dc], rax" + x64_nl_char())
  # CreateDIBSection(g_mem_dc, &bmih, DIB_RGB_COLORS=0, &ppvBits, NULL, 0).
  sb_push(sb, "    mov rcx, [rel g_mem_dc]" + x64_nl_char())
  sb_push(sb, "    lea rdx, [rel g_bmih_scratch]" + x64_nl_char())
  sb_push(sb, "    xor r8, r8" + x64_nl_char())
  sb_push(sb, "    lea r9, [rsp+96]" + x64_nl_char())
  sb_push(sb, "    mov qword [rsp+32], 0" + x64_nl_char())
  sb_push(sb, "    mov qword [rsp+40], 0" + x64_nl_char())
  sb_push(sb, "    call CreateDIBSection" + x64_nl_char())
  sb_push(sb, "    mov r13, rax" + x64_nl_char())
  # REAL BUG FOUND AND FIXED (canvas_host.exe non-deterministic
  # segfault, root-caused via a diagnostic read of g_canvas_buf that
  # showed it reading 0 on every run): ppvBits (CreateDIBSection's own
  # out-param, written to [rsp+96]) was being re-read from that SAME
  # stack slot only at the very end of this function, AFTER four more
  # WinAPI calls (SelectObject/ReleaseDC/SetBkMode/SetTextColor) had
  # already run -- any of which is free to reuse its own callee's
  # shallow stack space (only 96 bytes below THIS frame's own rsp) and
  # silently clobber it before the delayed read. Exactly the same
  # stack-aliasing bug class as the MSG/PAINTSTRUCT/StretchDIBits fix
  # above (g_msg_scratch's own header) -- fixed the same way: capture
  # the value immediately, before anything else can touch that slot,
  # into the persistent g_canvas_buf global rather than leaving it on
  # the stack across further calls.
  sb_push(sb, "    mov rax, [rsp+96]" + x64_nl_char())
  sb_push(sb, "    mov [rel g_canvas_buf], rax" + x64_nl_char())
  sb_push(sb, "    mov rcx, [rel g_mem_dc]" + x64_nl_char())
  sb_push(sb, "    mov rdx, r13" + x64_nl_char())
  sb_push(sb, "    call SelectObject" + x64_nl_char())
  sb_push(sb, "    mov rcx, [rel g_hwnd]" + x64_nl_char())
  sb_push(sb, "    mov rdx, r12" + x64_nl_char())
  sb_push(sb, "    call ReleaseDC" + x64_nl_char())
  # SetBkMode(g_mem_dc, TRANSPARENT=1) + SetTextColor(g_mem_dc, green)
  # once here, so win_text_out itself needs no per-call state setup.
  # COLORREF is 0x00BBGGRR -- pure green (r=0,g=255,b=0) = 0x0000FF00.
  sb_push(sb, "    mov rcx, [rel g_mem_dc]" + x64_nl_char())
  sb_push(sb, "    mov rdx, 1" + x64_nl_char())
  sb_push(sb, "    call SetBkMode" + x64_nl_char())
  sb_push(sb, "    mov rcx, [rel g_mem_dc]" + x64_nl_char())
  sb_push(sb, "    mov rdx, 65280" + x64_nl_char())
  sb_push(sb, "    call SetTextColor" + x64_nl_char())
  sb_push(sb, "    mov rax, [rel g_canvas_buf]" + x64_nl_char())
  sb_push(sb, "    mov rsp, r15" + x64_nl_char())
  sb_push(sb, "    add rsp, 16" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  return sb_str(sb)
end

# win_canvas_resize(width, height) -> done. Rebuilds the DIB surface
