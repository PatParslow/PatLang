  sb_push(sb, "    mov cx, r13w" + x64_nl_char())
  sb_push(sb, "    call htons" + x64_nl_char())
  sb_push(sb, "    mov [rsp+34], ax" + x64_nl_char())
  sb_push(sb, "    mov dword [rsp+36], 16777343" + x64_nl_char())
  sb_push(sb, "    mov qword [rsp+40], 0" + x64_nl_char())
  sb_push(sb, "    mov rcx, r12" + x64_nl_char())
  sb_push(sb, "    lea rdx, [rsp+32]" + x64_nl_char())
  sb_push(sb, "    mov r8, 16" + x64_nl_char())
  sb_push(sb, "    call bind" + x64_nl_char())
  sb_push(sb, "    cmp rax, 0" + x64_nl_char())
  sb_push(sb, "    jne .bl_bind_failed_" + suffix + x64_nl_char())
  sb_push(sb, "    mov rcx, r12" + x64_nl_char())
  sb_push(sb, "    mov rdx, 128" + x64_nl_char())
  sb_push(sb, "    call listen" + x64_nl_char())
  sb_push(sb, "    cmp rax, 0" + x64_nl_char())
  sb_push(sb, "    jne .bl_listen_failed_" + suffix + x64_nl_char())
  sb_push(sb, "    mov rcx, r12" + x64_nl_char())
  sb_push(sb, "    lea rdx, [rsp+32]" + x64_nl_char())
  sb_push(sb, "    mov dword [rsp+56], 16" + x64_nl_char())
  sb_push(sb, "    lea r8, [rsp+56]" + x64_nl_char())
  sb_push(sb, "    call getsockname" + x64_nl_char())
  sb_push(sb, "    movzx rax, word [rsp+34]" + x64_nl_char())
  sb_push(sb, "    mov cx, ax" + x64_nl_char())
  sb_push(sb, "    call ntohs" + x64_nl_char())
  sb_push(sb, "    movzx rax, ax" + x64_nl_char())
  sb_push(sb, "    jmp .bl_done_" + suffix + x64_nl_char())
  sb_push(sb, ".bl_bind_failed_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    call WSAGetLastError" + x64_nl_char())
  sb_push(sb, "    cmp rax, 10048" + x64_nl_char())
  sb_push(sb, "    je .bl_addrinuse_" + suffix + x64_nl_char())
  sb_push(sb, "    mov rax, 0 - 2" + x64_nl_char())
  sb_push(sb, "    jmp .bl_done_" + suffix + x64_nl_char())
  sb_push(sb, ".bl_addrinuse_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    mov rax, 0 - 1" + x64_nl_char())
  sb_push(sb, "    jmp .bl_done_" + suffix + x64_nl_char())
  sb_push(sb, ".bl_listen_failed_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    mov rax, 0 - 2" + x64_nl_char())
  sb_push(sb, ".bl_done_" + suffix + ":" + x64_nl_char())
  sb_push(sb, "    mov rsp, r15" + x64_nl_char())
  sb_push(sb, "    push rax" + x64_nl_char())
  return sb_str(sb)
end

