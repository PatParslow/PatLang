# Contract checks for the interpreters written in PatLang
# (lib/interp.patlang, block_model/interp.patlang) when they run on v2.
#
# They were written against pat's host function contract_check(fname, kind,
# text, ok). v2 lowers require, ensure and assert itself, to the runtime's
# rt_contract_failed and rt_contract_held, so these functions give an
# interpreted program the same behaviour from those: a false clause stops the
# program naming the function, the kind and the text, in v2's wording
# (precondition, postcondition, assertion), and a clause that holds becomes
# the fact contract_holds(fname, "kind:text"), kind being require, ensure or
# assert, as v2's lowering records it.

# The word a failure message uses for a clause of this kind.
make a function called contract_wording_v2 takes kind returns word
  require value_class(kind) == 8
  let word = "assertion"
  if kind == "require" then
    let word = "precondition"
  elif kind == "ensure" then
    let word = "postcondition"
  end
  ensure value_class(word) == 8
  return word
end

make a function called contract_check_v2 takes fname, kind, text, ok returns done
  require (value_class(fname) == 8) and (value_class(kind) == 8) and (value_class(text) == 8)
  if not ok then
    rt_contract_failed(contract_wording_v2(kind), text, fname)
  end
  rt_contract_held(fname, kind, text)
  let done = true
  ensure done == true
  return done
end

make a function called contract_fail_v2 takes fname, kind, text returns done
  require (value_class(fname) == 8) and (value_class(kind) == 8) and (value_class(text) == 8)
  rt_contract_failed(contract_wording_v2(kind), text, fname)
  let done = false
  ensure false
  return done
end
