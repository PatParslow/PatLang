# Readings of cost for checks that compare them (spec 1.13, cpu_cycles).
#
# A single cpu_cycles reading varies with where the thread runs: on a hybrid
# processor its cost per unit of work differs by core, and under Linux in a
# virtual machine (WSL) the count includes time the host takes the processor
# away (#284). Measured 2026-11-24 on an i7-12700 with 24 busy processes:
# vi_cpu_cycles' "four times the work counts no more than eight times the
# cycles" failed 21 times in 30 on single readings, 13 in 30 on the cheapest
# of five, and 0 in 30 when each piece of work was first run once with its
# reading dropped (the first reading of a process ran about twice as fast as
# the rest, and paired with an ordinary reading of the other size it broke
# the ratio), then read five times in turn, the cheapest kept.
#
# cheapest_cycles(readers, rounds): readers is a list of closures taking
# nothing, each doing its piece of work and returning its own reading (so
# setup can stay outside the region it times). Each is run once and its
# reading dropped, then all of them in turn, rounds times; gives the cheapest
# reading of each, in the readers' order.
make a function called cheapest_cycles takes readers, rounds returns best
  let n = list_len(readers)
  let w = 0
  while w < n do
    let f = readers[w]
    f()
    let w = w + 1
  end
  let best = []
  let r = 0
  while r < rounds do
    let k = 0
    while k < n do
      let f = readers[k]
      let c = f()
      if r == 0 then
        let best = list_push(best, c)
      elif c < best[k] then
        let best = list_set(best, k, c)
      end
      let k = k + 1
    end
    let r = r + 1
  end
  return best
end

# The readings a cost check takes: five rounds after the warm-up.
make a function called cost_rounds returns n
  return 5
end
