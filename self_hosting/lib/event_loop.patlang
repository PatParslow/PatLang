# =============================================================================
# Reusable single-threaded event loop (JS/Node-style) with closure callbacks.
# Built on tcp_accept_timeout/sleep_ms. Replaces the earlier when/emit +
# set_var/get global-dispatch pattern (still supported separately) with
# ordinary closures stored as object properties — no event-name strings, no
# shared __vars namespace, callbacks close over whatever state they need.
#
# API:
#   let loop = event_loop_new()
#   event_loop_listen(loop, port, |conn| { ... })   # request callback
#   event_loop_on_tick(loop, || { ... })             # idle callback
#   event_loop_stop(loop)                            # called from a callback
#   event_loop_run(loop, poll_ms)                     # blocks until stopped
#
# Callbacks are called through a `let cb = get(loop, "...")` local binding
# rather than `get(loop, "...")(...)` directly, so the same library source
# works under both the Stage 0 Rust parser and the Stage 1 self-hosted
# parser (only the former currently allows calling the result of an
# arbitrary expression; both allow calling a named local variable).
# =============================================================================

make a function called next_evloop_id returns n
  let n = get("__vars", "__evloop_seq")
  if not n then
    let n = 0
  end
  set_var("__evloop_seq", n + 1)
  return n
end

make a function called event_loop_new returns name
  let name = "__evloop_" + next_evloop_id()
  new("EventLoop", name)
  send(name, "set", "running", true)
  return name
end

make a function called event_loop_listen takes loop, port, cb returns done
  send(loop, "set", "port", port)
  send(loop, "set", "on_request", cb)
  return true
end

make a function called event_loop_on_tick takes loop, cb returns done
  send(loop, "set", "on_tick", cb)
  return true
end

make a function called event_loop_stop takes loop returns done
  send(loop, "set", "running", false)
  return true
end

make a function called event_loop_run takes loop, poll_ms returns done
  while get(loop, "running") do
    let port = get(loop, "port")
    if port then
      let conn = tcp_accept_timeout(port, poll_ms)
      if conn >= 0 then
        let cb = get(loop, "on_request")
        if cb then
          cb(conn)
        end
      else
        let cb = get(loop, "on_tick")
        if cb then
          cb()
        end
      end
    else
      sleep_ms(poll_ms)
      let cb = get(loop, "on_tick")
      if cb then
        cb()
      end
    end
  end
  return true
end
