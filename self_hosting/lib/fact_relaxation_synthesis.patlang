# ---- Delete-free fact-cost relaxation synthesis (GitHub issue #71,
# closing the "unify with GOAP" investigation) ----
#
# The conceptual finding from the GOAP attempts (self_hosting/lib/
# goap_synthesis.patlang): this problem is delete-free (a "produce"
# action only ever ADDS a fact, never removes one), which makes it a
# monotonic reachability problem, not a real STRIPS domain with
# meaningfully distinct alternative world-states. Modeled as STRIPS
# world-state search anyway (GOAP's plan()/action_add()), every
# combination of independently-derivable facts becomes its own graph
# node -- confirmed directly: 10 independent leaf facts alone produced
# 2^10 = 1024 visited world-states immediately.
#
# The right algorithm for a delete-free domain is classical: track a
# single best-known COST per fact (not a world-state), and relax it
# forward -- an action needing facts {f1, f2, ...} to produce f3 gives a
# candidate cost(f3) = cost(f1) + cost(f2) + ... + action_cost, kept
# only if it beats f3's current best. Processed in non-decreasing cost
# order (a bucket-queue/Dial's-algorithm Dijkstra over FACTS, not
# states), this never enumerates a combination of facts as a "state" at
# all -- exactly the fix the GOAP investigation's own conclusion called
# for.
#
# Note on how this compares to self_hosting/lib/synthesis_by_example.
# patlang's own bottom-up enumerator: for a domain where every
# primitive costs exactly 1 (true of the primitives used in the GOAP
# benchmark -- list_get/gt/cond), bucket-queue-by-cost and level-by-
# AST-size are the SAME partition of the same search space, so this is
# not expected to outperform the already-tuned enumerator there; that
# equivalence is itself the confirmation that the enumerator was
# already doing the conceptually right thing, unlike GOAP's world-state
# search. Where this genuinely differs -- and the existing enumerator
# is measurably WRONG, not just differently organized -- is when
# primitives have UNEVEN registered cost: self_hosting/lib/
# primitive_registry.patlang already registers index_of_from at cost 2
# and tcp_connect at cost 5, but sbe_build_calls's own size-partition
# math (`rem = target_size - 1`) hardcodes "every primitive costs
# exactly 1 unit of AST size" regardless of its registered cost --
# meaning the existing enumerator's "smallest wins" tie-break is really
# "fewest AST nodes wins," silently ignoring registered cost whenever
# it isn't 1. frs_build_calls below is the same partition scheme
# parameterized by each primitive's OWN registered cost instead.

include "synthesis_by_example.patlang"

make a function called frs_build_calls takes prim, arg_types, arg_contracts, target_cost, prim_cost, index returns out
  if sbe_arg_types_has_any(arg_types) then
    let out = []
    let types = sbe_concrete_types()
    let t = 0
    let tn = to_num(list_len(types))
    while t < tn do
      let resolved = sbe_resolve_any_types(arg_types, types[t])
      let out = sbe_list_concat(out, frs_build_calls(prim, resolved, arg_contracts, target_cost, prim_cost, index))
      let t = t + 1
    end
    return out
  end
  let out = []
  let rem = target_cost - prim_cost
  let arity = to_num(list_len(arg_types))
  if arity == 1 then
    if rem >= 1 then
      let group = sbe_index_lookup_filtered(index, rem, arg_types[0], arg_contracts[0])
      let i = 0
      let n = to_num(list_len(group))
      while i < n do
        let out = list_push(out, ["Call", prim, [group[i]]])
        let i = i + 1
      end
    end
    return out
  end
  if arity == 2 then
    let a = 1
    while a <= rem - 1 do
      let b = rem - a
      let ga = sbe_index_lookup_filtered(index, a, arg_types[0], arg_contracts[0])
      let gb = sbe_index_lookup_filtered(index, b, arg_types[1], arg_contracts[1])
      let i = 0
      let ni = to_num(list_len(ga))
      while i < ni do
        let j = 0
        let nj = to_num(list_len(gb))
        while j < nj do
          let out = list_push(out, ["Call", prim, [ga[i], gb[j]]])
          let j = j + 1
        end
        let i = i + 1
      end
      let a = a + 1
    end
    return out
  end
  if arity == 3 then
    let a = 1
    while a <= rem - 2 do
      let b = 1
      while b <= rem - a - 1 do
        let c = rem - a - b
        let ga = sbe_index_lookup_filtered(index, a, arg_types[0], arg_contracts[0])
        let gb = sbe_index_lookup_filtered(index, b, arg_types[1], arg_contracts[1])
        let gc = sbe_index_lookup_filtered(index, c, arg_types[2], arg_contracts[2])
        let i = 0
        let ni = to_num(list_len(ga))
        while i < ni do
          let j = 0
          let nj = to_num(list_len(gb))
          while j < nj do
            let k = 0
            let nk = to_num(list_len(gc))
            while k < nk do
              let out = list_push(out, ["Call", prim, [ga[i], gb[j], gc[k]]])
              let k = k + 1
            end
            let j = j + 1
          end
          let i = i + 1
        end
        let b = b + 1
      end
      let a = a + 1
    end
    return out
  end
  if arity == 4 then
    let a = 1
    while a <= rem - 3 do
      let b = 1
      while b <= rem - a - 2 do
        let c = 1
        while c <= rem - a - b - 1 do
          let d = rem - a - b - c
          let ga = sbe_index_lookup_filtered(index, a, arg_types[0], arg_contracts[0])
          let gb = sbe_index_lookup_filtered(index, b, arg_types[1], arg_contracts[1])
          let gc = sbe_index_lookup_filtered(index, c, arg_types[2], arg_contracts[2])
          let gd = sbe_index_lookup_filtered(index, d, arg_types[3], arg_contracts[3])
          let i = 0
          let ni = to_num(list_len(ga))
          while i < ni do
            let j = 0
            let nj = to_num(list_len(gb))
            while j < nj do
              let k = 0
              let nk = to_num(list_len(gc))
              while k < nk do
                let l = 0
                let nl = to_num(list_len(gd))
                while l < nl do
                  let out = list_push(out, ["Call", prim, [ga[i], gb[j], gc[k], gd[l]]])
                  let l = l + 1
                end
                let k = k + 1
              end
              let j = j + 1
            end
            let i = i + 1
          end
          let c = c + 1
        end
        let b = b + 1
      end
      let a = a + 1
    end
    return out
  end
  return out
end

# Bucket-queue (Dial's algorithm) relaxation over facts, keyed exactly
# like the enumerator's own dedup key (sbe_output_key -- a fact's
# identity already IS its full multi-example value tuple, so "does this
# fact equal the target" already means "correct across every example
# simultaneously" -- no separate per-example solve-then-merge step is
# needed or wanted). `index` doubles as both the by-(type,cost) lookup
# structure frs_build_calls draws arguments from AND the record of
# which facts are already settled at which cost -- cost buckets are
# processed strictly increasingly, so the first time a key is seen is
# always its cheapest derivation, exactly like Dijkstra settling a node
# once and never revisiting it more cheaply later.
make a function called frs_synthesize_from_examples takes examples, input_names, extra_consts, registry, primitive_names, max_cost returns result
  let consts = sbe_list_concat(sbe_default_int_consts(), extra_consts)
  let sample_bindings = examples[0][0]
  let leaves = sbe_seed_leaves(input_names, consts)
  let index = sbe_index_new()
  let seen = new("Dict", "frs_seen_" + pr_next_id())
  let notes = []

  let winner = ["Const", ""]
  let found_match = false
  let alt_count = 0
  let i = 0
  let n = to_num(list_len(leaves))
  while i < n do
    let node = leaves[i]
    if sbe_matches_all(node, examples, registry) then
      if found_match then
        let alt_count = alt_count + 1
      else
        let found_match = true
        let winner = node
      end
    end
    let key = sbe_output_key(node, examples, registry)
    if not get(seen, key) then
      send(seen, "set", key, true)
      sbe_index_add(index, sbe_wrap(node, registry, sample_bindings))
    end
    let i = i + 1
  end
  if found_match then
    if alt_count > 0 then
      let notes = list_push(notes, sbe_ambiguity_note(alt_count, 1))
    end
    return ["OK", winner, notes]
  end

  let cost = 2
  while cost <= max_cost do
    print("frs_synthesize_from_examples: cost=" + cost + " at " + now_ms())
    let level_int = []
    let level_string = []
    let level_bool = []
    let level_list = []
    let winner = ["Const", ""]
    let found_match = false
    let alt_count = 0
    let p = 0
    let pn = to_num(list_len(primitive_names))
    while p < pn do
      let prim = primitive_names[p]
      let entry = pr_lookup(registry, prim)
      if entry then
        let arg_types = entry[5]
        let arg_contracts = entry[7]
        let prim_cost = to_num(entry[3])
        let candidates = frs_build_calls(prim, arg_types, arg_contracts, cost, prim_cost, index)
        let cn = to_num(list_len(candidates))
        let results = sbe_evaluate_candidates(candidates, examples, registry, sample_bindings)
        let c = 0
        while c < cn do
          let node = candidates[c]
          let r = results[c]
          let ok = r[0]
          let key = r[1]
          let ty = r[2]
          let value = r[3]
          if ok then
            if found_match then
              let alt_count = alt_count + 1
            else
              let found_match = true
              let winner = node
            end
          end
          if not get(seen, key) then
            send(seen, "set", key, true)
            let typed = [node, cost, ty, value]
            if ty == "int" then
              let level_int = list_push(level_int, typed)
            else
              if ty == "string" then
                let level_string = list_push(level_string, typed)
              else
                if ty == "bool" then
                  let level_bool = list_push(level_bool, typed)
                else
                  if ty == "list" then
                    let level_list = list_push(level_list, typed)
                  end
                end
              end
            end
          end
          let c = c + 1
        end
      end
      let p = p + 1
    end
    if to_num(list_len(level_int)) > 0 then
      sbe_index_set_bucket(index, "int", cost, level_int)
    end
    if to_num(list_len(level_string)) > 0 then
      sbe_index_set_bucket(index, "string", cost, level_string)
    end
    if to_num(list_len(level_bool)) > 0 then
      sbe_index_set_bucket(index, "bool", cost, level_bool)
    end
    if to_num(list_len(level_list)) > 0 then
      sbe_index_set_bucket(index, "list", cost, level_list)
    end

    let evict_cost = cost - sbe_window_size()
    if evict_cost >= 2 then
      sbe_evict_size(index, evict_cost)
    end

    if found_match then
      if alt_count > 0 then
        let notes = list_push(notes, sbe_ambiguity_note(alt_count, cost))
      end
      return ["OK", winner, notes]
    end
    let cost = cost + 1
  end

  let notes = list_push(notes, "reached max_cost (" + max_cost + ") without a match")
  return ["ERR", "no candidate up to cost " + max_cost, notes]
end
