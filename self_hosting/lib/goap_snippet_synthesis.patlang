# GOAP code-synthesis via a per-step snippet dictionary (GitHub #21).
# Extracted from the original prototype (self_hosting/tools/
# goap_snippet_synthesis_prototype.patlang, commit 9de1b81) so both that
# standalone demo AND self_hosting/synthesis_goap_snippet_selftest.patlang
# can share the same synthesis machinery instead of duplicating it -- the
# demo now just calls into this file and prints its own output; the
# selftest calls the same functions and asserts on the results instead.
#
# Idea being tested: once plan() finds a real sequence of actions, look
# each step's own base name up in a dictionary of source templates
# (potentially one per target language), substitute its bound argument
# values into the template's placeholders, and concatenate the results in
# plan order -- turning a synthesized PLAN directly into a synthesized
# PROGRAM, not just an abstract action sequence.

include "gherkin_contracts.patlang"

# ---- the snippet dictionary ----
# dict[lang][action_base_name] -> template string. Placeholders are
# {ARG0}, {ARG1}, ... substituted positionally from action_label_args's
# own bound-value list for that plan step (e.g. "build(X=5)" -> ARG0 =
# "5"). No placeholders at all just means the step ignores its own
# label's bindings (fine for a bare, unparameterized action).

make a function called snippet_dict_patlang returns d
  let d = new("Dict", "snippets_patlang")
  send(d, "set", "gather_wood", "let wood = \"wood\"\nprint(\"gathered \" + wood)\n")
  send(d, "set", "build_house", "let house = \"house built from \" + wood\nprint(house)\n")
  send(d, "set", "scale", "let scaled_{ARG0} = to_num(\"{ARG0}\") * 2\nprint(\"scaled \" + \"{ARG0}\" + \" -> \" + scaled_{ARG0})\n")
  return d
end

make a function called snippet_dict_python returns d
  let d = new("Dict", "snippets_python")
  send(d, "set", "gather_wood", "wood = 'wood'\nprint('gathered ' + wood)\n")
  send(d, "set", "build_house", "house = 'house built from ' + wood\nprint(house)\n")
  return d
end

# ---- placeholder substitution ----

make a function called snippet_substitute takes template, args returns text
  let text = template
  let i = 0
  let n = to_num(list_len(args))
  while i < n do
    let placeholder = "{ARG" + i + "}"
    let text = snippet_replace_all(text, placeholder, args[i])
    let i = i + 1
  end
  return text
end

make a function called snippet_replace_all takes text, needle, replacement returns out
  let out = sb_new()
  let i = 0
  while i < text.length do
    if (needle.length > 0) and (i + needle.length <= text.length) and (substr(text, i, needle.length) == needle) then
      sb_push(out, replacement)
      let i = i + needle.length
    else
      sb_push(out, text[i])
      let i = i + 1
    end
  end
  return sb_str(out)
end

# ---- plan -> program assembly ----
# synthesize_program(plan_labels, dict) -> assembled source text, or
# ["ERR", message] if a step's base name has no snippet or a contract
# clause rejects its binding.
#
# COMPOSITION (open question #1 from the issue, answered here): snippets
# just concatenate as ordinary sequential PatLang statements sharing the
# SAME top-level scope -- a later step's snippet can reference an earlier
# step's `let`-bound name directly (see build_house's `wood` reference),
# exactly the way hand-written sequential PatLang code already shares
# scope. No new state-passing mechanism needed for this shape; it falls
# out of the target language's own scoping rules. This only works
# because every snippet here is a flat sequence of statements in ONE
# assembled file -- a shape that would need revisiting for anything
# requiring real function boundaries between steps.
#
# CONTRACT INTERACTION (open question #2, answered here): the caller may
# pass require/ensure clauses (the same [kind, var, op, literal] shape
# gherkin_contracts.patlang's own t_pending_contracts already produces),
# checked via goap_verify_contracts against the plan's own labels BEFORE
# any snippet is assembled -- a contract-violating candidate never
# reaches code generation at all, the same ordering principle
# goap_verify_contracts's own header already establishes for GOAP
# candidates in general (issue #12), now reused for synthesis output.
#
# DECLARED SNIPPET INTERFACES (open question #3, still NOT answered
# here): this still trusts adjacent steps' variable names to line up by
# convention (e.g. build_house's snippet blindly references `wood` from
# gather_wood's snippet) -- see the issue's own tracking comment and
# [[patlang-issue-status-audit-and-21-quickwins]] for the standing
# discussion of whether/how to formalize this (leaning toward steps-as-
# functions with real parameter/return interfaces rather than a parallel
# provides/requires name-matching scheme, to avoid the latter's
# tendency to multiply near-duplicate snippets just to satisfy a
# predecessor's/successor's naming choice).
make a function called synthesize_program takes plan_labels, dict, contract_clauses returns result
  if to_num(list_len(contract_clauses)) > 0 then
    let ok = goap_verify_contracts(contract_clauses, plan_labels)
    if ok == false then
      return ["ERR", "a plan step violated a contract clause -- rejected before any code was generated"]
    end
  end
  let out = sb_new()
  let i = 0
  let n = to_num(list_len(plan_labels))
  while i < n do
    let label = plan_labels[i]
    let base = action_base_name(label)
    let args = action_label_args(label)
    let template = "" + get(dict, base)
    if template == "" then
      return ["ERR", "no snippet registered for action \"" + base + "\""]
    end
    sb_push(out, snippet_substitute(template, args))
    let i = i + 1
  end
  return ["OK", sb_str(out)]
end
