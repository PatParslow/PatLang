# img_load_file(path) -> an image.patlang "image" value decoded from
# disk by file extension, or [] on any read/decode/unsupported-format
# failure -- the one place that knows which decoder module handles
# which extension, so callers (friendly_cli's own `img` command, or any
# other embedder) don't need their own copy of that dispatch table.
# Extend this file (not the caller) as more decoders land -- PNG/JPEG/
# SVG per this feature's own "all formats in one push" scope, BMP first
# as the fastest real end-to-end proof of image.patlang's own pipeline.

include "includes.patlang"
include "image.patlang"
include "image_bmp.patlang"
include "image_png.patlang"

# No str_lower primitive exists in this codebase -- a small local
# byte-wise A-Z -> a-z shift is simpler than adding one for this single
# use site.
make a function called img_load_lower takes s returns lowered
  let out = ""
  let i = 0
  while i < s.length do
    let c = char_code(s, i)
    if (c >= 65) and (c <= 90) then
      let out = out + chr(c + 32)
    else
      let out = out + chr(c)
    end
    let i = i + 1
  end
  return out
end

make a function called img_load_ext takes path returns ext
  let name = path_basename(path)
  let i = name.length - 1
  while i >= 0 do
    if substr(name, i, 1) == "." then
      return img_load_lower(substr(name, i + 1, name.length - i - 1))
    end
    let i = i - 1
  end
  return ""
end

make a function called img_load_file takes path returns image
  let bytes = read_file(path)
  if bytes.length == 0 then
    return []
  end
  let ext = img_load_ext(path)
  if (ext == "bmp") then
    return bmp_decode(bytes)
  end
  if (ext == "png") then
    return png_decode(bytes)
  end
  return []
end
