# PNG raster decoder. Supports the common baseline case: 8-bit-depth,
# non-interlaced, color type 2 (RGB) or 6 (RGBA) -- covers the
# overwhelming majority of real-world PNGs (screenshots, exported
# images, anything written by a modern tool). Deliberately does NOT
# support palette/indexed (color type 3), grayscale (0/4), bit depths
# other than 8, or Adam7 interlacing -- a real, named scope limit, the
# same staged approach image_bmp.patlang's own header describes (BMP
# started 24/32-bit-only, then grew 1/4/8-bit palette support once a
# real file needed it -- PNG can grow the same way if a real file ever
# needs a mode outside this list).
#
# The file is a bytes value (read_file_raw, in image_load.patlang). PNG's
# compressed data (one or more IDAT chunks, concatenated) is zlib-wrapped
# DEFLATE, decompressed by packages/deflate's zlib_decompress, which checks
# the stream's Adler-32. After inflating, PNG applies one of 5 per-scanline
# filters (None/Sub/Up/Average/Paeth, RFC 2083 section 6.3); this module
# reverses that filtering in place before extracting the pixels.
#
# RGBA input (color type 6) has no natural "no pixel here" concept in
# image.patlang's own RGB-only buffer (see its own header on this) --
# composited onto a fixed BLACK background here via straight alpha
# blending (out = fg * a / 255), matching a Sixel terminal's own
# typical dark background so a partially-transparent PNG still looks
# reasonable without a real compositing target to blend against.

include "includes.patlang"
include "image.patlang"
include "../../packages/deflate/deflate.patlang"

make a function called png_u32 takes bytes, offset returns v
  return (bytes[offset] * 16777216) + (bytes[offset + 1] * 65536) + (bytes[offset + 2] * 256) + bytes[offset + 3]
end

make a function called png_paeth takes a, b, c returns predictor
  let p = a + b - c
  let pa = abs(p - a)
  let pb = abs(p - b)
  let pc = abs(p - c)
  if (pa <= pb) and (pa <= pc) then
    return a
  end
  if pb <= pc then
    return b
  end
  return c
end

# Whether the four bytes at offset spell name.
make a function called png_is_type takes bytes, offset, name returns yes
  let i = 0
  while i < 4 do
    if bytes[offset + i] != char_code(name, i) then
      return false
    end
    let i = i + 1
  end
  return true
end

# png_parse_chunks(bytes) -> [width, height, bit_depth, color_type,
# interlace, idat_bytes], or [] if the PNG signature or the IHDR chunk is
# missing, or a chunk runs past the end. Concatenates every IDAT chunk's
# payload in file order (the zlib stream spans all of them together).
make a function called png_parse_chunks takes bytes returns info
  let n = list_len(bytes)
  if n < 8 then
    return []
  end
  let sig = [137, 80, 78, 71, 13, 10, 26, 10]
  let s = 0
  while s < 8 do
    if bytes[s] != sig[s] then
      return []
    end
    let s = s + 1
  end
  let pos = 8
  let idat = bytes_new(0)
  let width = 0
  let height = 0
  let bit_depth = 0
  let color_type = 0
  let interlace = 0
  let saw_ihdr = false
  let saw_iend = false
  while (pos + 8 <= n) and (not saw_iend) do
    let clen = png_u32(bytes, pos)
    let cdata_offset = pos + 8
    if cdata_offset + clen + 4 > n then
      return []
    end
    if png_is_type(bytes, pos + 4, "IHDR") then
      if clen < 13 then
        return []
      end
      let width = png_u32(bytes, cdata_offset)
      let height = png_u32(bytes, cdata_offset + 4)
      let bit_depth = bytes[cdata_offset + 8]
      let color_type = bytes[cdata_offset + 9]
      let interlace = bytes[cdata_offset + 12]
      let saw_ihdr = true
    elif png_is_type(bytes, pos + 4, "IDAT") then
      pkg_append_range(idat, bytes, cdata_offset, clen)
    elif png_is_type(bytes, pos + 4, "IEND") then
      let saw_iend = true
    end
    let pos = cdata_offset + clen + 4
  end
  if not saw_ihdr then
    return []
  end
  return [width, height, bit_depth, color_type, interlace, idat]
end

# png_unfilter(buf, width, height, channels) -> reverses the per-
# scanline filter in place (RFC 2083 section 6.3), so `buf` afterward
# holds each row's filter byte, then its reconstructed pixel bytes.
make a function called png_unfilter takes buf, width, height, channels returns done
  let bytes_per_row = width * channels
  let row_stride = 1 + bytes_per_row
  let y = 0
  while y < height do
    let row_offset = y * row_stride
    let filter_type = bytes_get(buf, row_offset)
    let data_offset = row_offset + 1
    let prior_offset = data_offset - row_stride
    let x = 0
    while x < bytes_per_row do
      let raw_offset = data_offset + x
      let filt_val = bytes_get(buf, raw_offset)
      let a = 0
      if x >= channels then
        let a = bytes_get(buf, raw_offset - channels)
      end
      let b = 0
      if y > 0 then
        let b = bytes_get(buf, prior_offset + x)
      end
      let c = 0
      if (y > 0) and (x >= channels) then
        let c = bytes_get(buf, prior_offset + x - channels)
      end
      let recon = filt_val
      if filter_type == 1 then
        let recon = (filt_val + a) % 256
      elif filter_type == 2 then
        let recon = (filt_val + b) % 256
      elif filter_type == 3 then
        let recon = (filt_val + floor((a + b) / 2)) % 256
      elif filter_type == 4 then
        let recon = (filt_val + png_paeth(a, b, c)) % 256
      end
      bytes_set(buf, raw_offset, recon)
      let x = x + 1
    end
    let y = y + 1
  end
  return true
end

# png_decode(ctx, bytes) -> an image.patlang "image" value, or [] on any
# unsupported/malformed/undecodable input -- matches every other
# decoder's own established failure convention here. ctx is kept for
# callers written against the earlier decoder; nothing reads it.
make a function called png_decode takes ctx, bytes returns image
  let info = png_parse_chunks(bytes)
  if list_len(info) == 0 then
    return []
  end
  let width = info[0]
  let height = info[1]
  let bit_depth = info[2]
  let color_type = info[3]
  let interlace = info[4]
  if (width <= 0) or (height <= 0) then
    return []
  end
  if (bit_depth != 8) or (interlace != 0) then
    return []
  end
  if (color_type != 2) and (color_type != 6) then
    return []
  end
  let channels = 3
  if color_type == 6 then
    let channels = 4
  end
  let bytes_per_row = width * channels
  let z = zlib_decompress(info[5])
  if z[0] != "ok" then
    return []
  end
  let raw_buf = z[1]
  if bytes_len(raw_buf) != height * (1 + bytes_per_row) then
    return []
  end
  png_unfilter(raw_buf, width, height, channels)
  let out = img_new(width, height)
  let row_stride = 1 + bytes_per_row
  let y = 0
  while y < height do
    let row_offset = (y * row_stride) + 1
    let x = 0
    while x < width do
      let px_offset = row_offset + (x * channels)
      let r = bytes_get(raw_buf, px_offset)
      let g = bytes_get(raw_buf, px_offset + 1)
      let b = bytes_get(raw_buf, px_offset + 2)
      if channels == 4 then
        let alpha = bytes_get(raw_buf, px_offset + 3)
        let r = floor((r * alpha) / 255)
        let g = floor((g * alpha) / 255)
        let b = floor((b * alpha) / 255)
      end
      img_set_pixel(out, x, y, r, g, b)
      let x = x + 1
    end
    let y = y + 1
  end
  return out
end
