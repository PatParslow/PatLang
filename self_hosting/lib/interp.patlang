# =============================================================================
# Meta-circular PatLang interpreter -- through SLICE 2.
#
# Walks the same list-shaped IR lower_program() produces (see lower.patlang's
# header comment for the instr shapes) directly, with no codegen step at
# all -- the third possible "final stage" alongside emit_rust (rustc
# backend) and emit_x64 (NASM backend), sharing the exact same lexer/
# parser/lowerer those two already share.
#
# SLICE 1: core arithmetic, locals, and control flow -- Const/Load/Store/
# Bin/Un/Jump/JumpIfFalse/Return.
# SLICE 2 (this addition): CallHost (a curated, deliberately bounded set
# of common host functions -- see interp_call_host) and BuildList (list
# literals).
# NOT YET supported: Call (user-defined function calls -- interpret_ir
# only ever runs "main" right now, doesn't recurse into other funcs
# entries yet), CallValue/MakeClosure (closures). Hitting one of those is
# a clear, named error, not silently wrong behaviour. Runtime VALUES are
# just plain PatLang numbers/strings/lists/booleans -- no separate tagged
# Value type is needed, since the self-hosted interpreter runs AS a
# PatLang program and can already compute with PatLang's own native
# values directly.
# =============================================================================

make a function called interp_const takes kind, text returns v
  if kind == "num" then
    return to_num(text)
  end
  if kind == "bool" then
    if text == "true" then
      return true
    end
    return false
  end
  return text
end

# Locals are a plain list of [name, value] pairs -- linear lookup, not a
# hash map. Simple and correct; revisit for speed only if a real program
# actually needs it (see patlang-best-practices.html's own standing
# guidance: don't reach for a general structure before a specific need is
# demonstrated).
make a function called locals_get takes locals, name returns v
  let i = 0
  while i < locals.length do
    if locals[i][0] == name then
      return locals[i][1]
    end
    let i = i + 1
  end
  return 0
end

make a function called locals_set takes locals, name, v returns out
  let i = 0
  while i < locals.length do
    if locals[i][0] == name then
      return list_set(locals, i, [name, v])
    end
    let i = i + 1
  end
  return list_push(locals, [name, v])
end

# stack_pop(stack) -> [top, rest] -- lists are value semantics in PatLang,
# so "popping" means building the shorter list, not mutating in place.
make a function called stack_pop takes stack returns pair
  let n = stack.length
  let top = stack[n - 1]
  let rest = []
  let i = 0
  while i < n - 1 do
    let rest = list_push(rest, stack[i])
    let i = i + 1
  end
  return [top, rest]
end

# stack_pop_n(stack, n) -> [args, rest] -- pops the top `n` values and
# returns them in their ORIGINAL push order (arg0 first), since CallHost/
# BuildList's arguments were pushed left-to-right but the stack top holds
# the LAST one pushed.
make a function called stack_pop_n takes stack, n returns pair
  let args_rev = []
  let cur = stack
  let i = 0
  while i < n do
    let popped = stack_pop(cur)
    let args_rev = list_push(args_rev, popped[0])
    let cur = popped[1]
    let i = i + 1
  end
  let args = []
  let j = args_rev.length - 1
  while j >= 0 do
    let args = list_push(args, args_rev[j])
    let j = j - 1
  end
  return [args, cur]
end

# interp_call_host(name, args) -- SLICE 2 scope: a curated, deliberately
# bounded set of the most commonly-needed host functions, not a mirror of
# the full HOST_CHUNK_TABLE (that would mean duplicating dozens of Rust
# host-function bodies as PatLang here, for a benefit no test program has
# demonstrated yet). Anything outside this set is a clear, named error --
# widen the set only once a real program actually needs the next one, per
# this project's own standing guidance against building general capacity
# before a specific need is shown.
make a function called interp_call_host takes name, args returns result
  if name == "print" then
    print(args[0])
    return 0
  end
  if name == "list_push" then
    return list_push(args[0], args[1])
  end
  if name == "list_get" then
    return args[0][args[1]]
  end
  if name == "list_len" then
    return args[0].length
  end
  if name == "list_set" then
    return list_set(args[0], args[1], args[2])
  end
  if name == "len" then
    return args[0].length
  end
  if name == "to_num" then
    return to_num(args[0])
  end
  if name == "chr" then
    return chr(args[0])
  end
  if name == "char_code" then
    return char_code(args[0], args[1])
  end
  if name == "substr" then
    return substr(args[0], args[1], args[2])
  end
  if name == "type_of" then
    return type_of(args[0])
  end
  if name == "hash_string" then
    return hash_string(args[0])
  end
  print("interp_call_host: host function '" + name + "' not yet supported by interpret_ir (slice 2)")
  return 0
end

make a function called interp_bin takes op, a, b returns v
  if op == "+" then return a + b end
  if op == "-" then return a - b end
  if op == "*" then return a * b end
  if op == "/" then return a / b end
  if op == "%" then return a % b end
  if op == "==" then return a == b end
  if op == "!=" then return a != b end
  if op == "<" then return a < b end
  if op == ">" then return a > b end
  if op == "<=" then return a <= b end
  if op == ">=" then return a >= b end
  if op == "and" then return a and b end
  if op == "or" then return a or b end
  print("interp_bin: unsupported operator '" + op + "'")
  return 0
end

make a function called interp_un takes op, a returns v
  if op == "-" then return 0 - a end
  if op == "not" then return not a end
  print("interp_un: unsupported operator '" + op + "'")
  return 0
end

# find_func(funcs, name) -> the ["FuncIR", name, params, instrs] entry
# named `name`, or 0 if none matches (a missing user function is a real,
# clear error at the CallHost/Call site, not here).
make a function called find_func takes funcs, name returns f
  let i = 0
  while i < funcs.length do
    if funcs[i][1] == name then
      return funcs[i]
    end
    let i = i + 1
  end
  return 0
end

# interp_run_function(funcs, func, arg_values) -> the function's return
# value. `func` is a ["FuncIR", name, params, instrs] entry (see
# lower.patlang); `funcs` is the WHOLE program's function list, threaded
# through so a "Call" instruction can look up and recurse into any OTHER
# function by name (slice 3) -- ordinary PatLang function calls become
# ordinary recursive calls into this same interpreter, using PatLang's
# own call stack, no separate call-stack bookkeeping needed here.
make a function called interp_run_function takes funcs, func, arg_values returns result
  let params = func[2]
  let instrs = func[3]
  let locals = []
  let pi = 0
  while pi < params.length do
    let locals = locals_set(locals, params[pi], arg_values[pi])
    let pi = pi + 1
  end
  let stack = []
  let pc = 0
  let result = 0
  let running = true
  while running do
    if pc >= instrs.length then
      let running = false
    else
      let instr = instrs[pc]
      let op = instr[0]
      if op == "Const" then
        let stack = list_push(stack, interp_const(instr[1], instr[2]))
        let pc = pc + 1
      else
        if op == "Load" then
          let stack = list_push(stack, locals_get(locals, instr[1]))
          let pc = pc + 1
        else
          if op == "Store" then
            let popped = stack_pop(stack)
            let locals = locals_set(locals, instr[1], popped[0])
            let stack = popped[1]
            let pc = pc + 1
          else
            if op == "Bin" then
              let popped_b = stack_pop(stack)
              let b = popped_b[0]
              let popped_a = stack_pop(popped_b[1])
              let a = popped_a[0]
              let stack = list_push(popped_a[1], interp_bin(instr[1], a, b))
              let pc = pc + 1
            else
              if op == "Un" then
                let popped = stack_pop(stack)
                let stack = list_push(popped[1], interp_un(instr[1], popped[0]))
                let pc = pc + 1
              else
                if op == "Jump" then
                  let pc = instr[1]
                else
                  if op == "JumpIfFalse" then
                    let popped = stack_pop(stack)
                    let stack = popped[1]
                    if popped[0] then
                      let pc = pc + 1
                    else
                      let pc = instr[1]
                    end
                  else
                    if op == "Return" then
                      if stack.length > 0 then
                        let result = stack[stack.length - 1]
                      end
                      let running = false
                    else
                      if op == "CallHost" then
                        let popped = stack_pop_n(stack, instr[2])
                        let stack = list_push(popped[1], interp_call_host(instr[1], popped[0]))
                        let pc = pc + 1
                      else
                        if op == "BuildList" then
                          let popped = stack_pop_n(stack, instr[1])
                          let stack = list_push(popped[1], popped[0])
                          let pc = pc + 1
                        else
                          if op == "Call" then
                            let popped = stack_pop_n(stack, instr[2])
                            let callee = find_func(funcs, instr[1])
                            if callee == 0 then
                              print("interp_run_function: user function '" + instr[1] + "' not found")
                              let running = false
                            else
                              let call_result = interp_run_function(funcs, callee, popped[0])
                              let stack = list_push(popped[1], call_result)
                              let pc = pc + 1
                            end
                          else
                            if op == "MakeClosure" then
                              let captured_names = instr[2]
                              let popped = stack_pop_n(stack, captured_names.length)
                              let stack = list_push(popped[1], ["__closure__", instr[1], popped[0]])
                              let pc = pc + 1
                            else
                              if op == "CallValue" then
                                let popped_args = stack_pop_n(stack, instr[1])
                                let popped_closure = stack_pop(popped_args[1])
                                let closure = popped_closure[0]
                                let func_name = closure[1]
                                let captured_values = closure[2]
                                let all_args = captured_values
                                let k = 0
                                while k < popped_args[0].length do
                                  let all_args = list_push(all_args, popped_args[0][k])
                                  let k = k + 1
                                end
                                let callee = find_func(funcs, func_name)
                                if callee == 0 then
                                  print("interp_run_function: closure target function '" + func_name + "' not found")
                                  let running = false
                                else
                                  let call_result = interp_run_function(funcs, callee, all_args)
                                  let stack = list_push(popped_closure[1], call_result)
                                  let pc = pc + 1
                                end
                              else
                                print("interp_run_function: '" + op + "' not recognized (not part of the current IR instruction set)")
                                let running = false
                              end
                            end
                          end
                        end
                      end
                    end
                  end
                end
              end
            end
          end
        end
      end
    end
  end
  return result
end

# interpret_ir(ir) -- runs `ir`'s "main" function with no arguments and
# returns its result. `ir` is the ["ProgramIR", entry_name, funcs, events]
# shape lower_program() produces (or load_ir() reads back from a saved
# .ir file) -- exactly the same shape emit_program_rs/emit_program_x64
# already consume, so this is a genuine third final stage, not a parallel
# reimplementation of the front end.
make a function called interpret_ir takes ir returns result
  let entry = ir[1]
  let funcs = ir[2]
  let main_func = find_func(funcs, entry)
  if main_func == 0 then
    print("interpret_ir: entry function '" + entry + "' not found")
    return 0
  end
  return interp_run_function(funcs, main_func, [])
end
