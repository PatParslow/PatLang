# =============================================================================
# Meta-circular PatLang interpreter -- through SLICE 4 (full IR instruction
# set) plus proper error propagation and a "feature complete" host-function
# surface for the stateless utility chunks.
#
# Walks the same list-shaped IR lower_program() produces (see lower.patlang's
# header comment for the instr shapes) directly, with no codegen step at
# all -- the third possible "final stage" alongside emit_rust (rustc
# backend) and emit_x64 (NASM backend), sharing the exact same lexer/
# parser/lowerer those two already share.
#
# Every function that can fail returns a RESULT VALUE, not a bare value:
# ["Ok", value] on success, ["Err", message] on failure. PatLang has no
# try/catch (see patlang-best-practices.html's gotchas section) -- a real
# host-call failure inside a CallHost this interpreter invokes is still
# genuinely fatal to the whole process, same as it always was, but every
# INTERNAL interpreter error (unknown instruction, missing user function,
# unsupported operator, unsupported host function name) now propagates as
# an explicit Err up through recursive Call/CallValue chains instead of
# printing and silently returning 0 -- the caller (patc1_main.patlang's
# `interpret` subcommand) reports it as a clear, distinct error rather than
# a puzzling wrong answer.
#
# SLICE 1: core arithmetic, locals, and control flow -- Const/Load/Store/
# Bin/Un/Jump/JumpIfFalse/Return.
# SLICE 2: CallHost and BuildList (list literals). Host-function coverage
# spans essentially the whole real host surface -- core, strings_ext,
# collections_handles, files, io_misc, math, oo, logic, contracts,
# networking -- by delegating each name straight to the SAME real host
# function any other PatLang program (interpreted or compiled) already
# calls. oo/logic/contracts's OBJECTS/FACTS/RULES/ACTIONS registries live
# in the native process itself, not in anything this interpreter needs to
# reimplement -- there was never an architectural barrier to supporting
# them, just an initial, narrower scoping choice later widened once asked
# ("we should try to get the whole of the language supported"). Still
# EXCLUDED, deliberately: codegen_bootstrap's legacy compiler-meta tools
# (parse_tiny_source/lower_and_compile/emit_rust_for/copy_file/remove_
# file/patc_compile_from_argv/get_argv -- half debug-scaffolding, not a
# clean API) and bare rustc_build/rustc_build_chunked*/run_ir. In their
# place: two NEW, purpose-built primitives, `compile_patlang(source,
# out_path)` and `interpret_patlang(source)` -- `interp.patlang` is
# compiled into the SAME combined source as the compiler itself, so it
# can call `tokenize`/`parse_program`/`lower_program`/`required_chunks`/
# `chunk_texts_for`/`emit_program_rs_chunked`/`rustc_build_chunked_texts`
# directly as ordinary functions, exactly like `patc1_main.patlang`'s own
# `lower`/`emit_rust`/`interpret` subcommands do -- these two just make
# that same pipeline callable BY a running interpreted program, not only
# from the CLI. Built for the natural next step this enables: a REPL/
# friendly-cli session that can compile, not just interpret, what the
# user typed.
#
# One real consequence worth knowing: since interp.patlang ITSELF now
# calls oo/logic/contracts/networking host functions directly, any build
# that includes this file (patc1_all.patlang, i.e. patc1.exe/patc2.exe/
# patc3.exe) now unconditionally requires those chunks too, regardless of
# what the INTERPRETED program actually uses -- the same principle
# `required_chunks` already applies to `run_ir` (a program that can run
# arbitrary future IR can't statically know what chunks that IR will
# need, so it takes the superset), just now also true of `interpret_ir`.
# SLICE 3: Call (recursive user-defined function calls).
# SLICE 4: MakeClosure/CallValue (closures).
# =============================================================================

make a function called interp_const takes kind, text returns v
  if kind == "num" then
    return to_num(text)
  end
  if kind == "bool" then
    if text == "true" then
      return true
    end
    return false
  end
  if kind == "unit" then
    # Added for implicit-last-value-return/auto-print: this interpreter
    # itself runs ON the outer host interpreter, which now has a real
    # `unit` literal (see ir/lowering.rs's Expr::Identifier arm), so it
    # can just use that directly -- same as how `true`/`false` above
    # already delegate to the outer language's own booleans rather than
    # reimplementing a value representation from scratch.
    return unit
  end
  return text
end

# Locals are a plain list of [name, value] pairs -- linear lookup, not a
# hash map. Simple and correct; revisit for speed only if a real program
# actually needs it (see patlang-best-practices.html's own standing
# guidance: don't reach for a general structure before a specific need is
# demonstrated).
make a function called locals_get takes locals, name returns v
  let i = 0
  while i < locals.length do
    if locals[i][0] == name then
      return locals[i][1]
    end
    let i = i + 1
  end
  return 0
end

make a function called locals_set takes locals, name, v returns out
  let i = 0
  while i < locals.length do
    if locals[i][0] == name then
      return list_set(locals, i, [name, v])
    end
    let i = i + 1
  end
  return list_push(locals, [name, v])
end

# stack_pop(stack) -> [top, rest] -- lists are value semantics in PatLang,
# so "popping" means building the shorter list, not mutating in place.
make a function called stack_pop takes stack returns pair
  let n = stack.length
  let top = stack[n - 1]
  let rest = []
  let i = 0
  while i < n - 1 do
    let rest = list_push(rest, stack[i])
    let i = i + 1
  end
  return [top, rest]
end

# stack_pop_n(stack, n) -> [args, rest] -- pops the top `n` values and
# returns them in their ORIGINAL push order (arg0 first), since CallHost/
# BuildList's arguments were pushed left-to-right but the stack top holds
# the LAST one pushed.
make a function called stack_pop_n takes stack, n returns pair
  let args_rev = []
  let cur = stack
  let i = 0
  while i < n do
    let popped = stack_pop(cur)
    let args_rev = list_push(args_rev, popped[0])
    let cur = popped[1]
    let i = i + 1
  end
  let args = []
  let j = args_rev.length - 1
  while j >= 0 do
    let args = list_push(args, args_rev[j])
    let j = j - 1
  end
  return [args, cur]
end

# interp_call_host(name, args) -> ["Ok", value] | ["Err", message].
# "Feature complete" for every STATELESS utility chunk (core, strings_ext,
# collections_handles, files, io_misc, math) -- see this file's header
# comment for why oo/logic/contracts/networking/codegen_bootstrap are
# deliberately excluded. Written as a flat sequence of early returns (no
# nesting) -- each host function is a genuinely independent case, not a
# decision tree, so there's nothing for nested if/else to express here
# that a flat "if this one, handle it and return" chain doesn't already
# say more plainly.
make a function called interp_call_host takes name, args returns result
  # --- core ---
  if name == "list_get" then return ["Ok", args[0][args[1]]] end
  if name == "list_len" then return ["Ok", args[0].length] end
  if name == "list_push" then return ["Ok", list_push(args[0], args[1])] end
  if name == "list_set" then return ["Ok", list_set(args[0], args[1], args[2])] end
  if name == "type_of" then return ["Ok", type_of(args[0])] end
  if name == "bit_get" then return ["Ok", bit_get(args[0], args[1])] end
  if name == "bit_set" then return ["Ok", bit_set(args[0], args[1], args[2])] end
  if name == "bit_slice" then return ["Ok", bit_slice(args[0], args[1], args[2])] end
  if name == "bit_set_slice" then return ["Ok", bit_set_slice(args[0], args[1], args[2], args[3])] end
  if name == "vfs_read" then return ["Ok", vfs_read(args[0])] end
  if name == "vfs_write" then return ["Ok", vfs_write(args[0], args[1])] end
  if name == "vfs_append" then return ["Ok", vfs_append(args[0], args[1])] end
  if name == "vfs_exists" then return ["Ok", vfs_exists(args[0])] end
  if name == "vfs_list" then return ["Ok", vfs_list(args[0])] end
  if name == "vfs_delete" then return ["Ok", vfs_delete(args[0])] end
  if name == "vfs_flush_to_disk" then return ["Ok", vfs_flush_to_disk(args[0], args[1])] end
  # --- strings_ext ---
  if name == "char_code" then return ["Ok", char_code(args[0], args[1])] end
  if name == "substr" then return ["Ok", substr(args[0], args[1], args[2])] end
  if name == "chr" then return ["Ok", chr(args[0])] end
  if name == "to_num" then return ["Ok", to_num(args[0])] end
  if name == "hash_string" then return ["Ok", hash_string(args[0])] end
  # --- collections_handles ---
  if name == "vec_new" then return ["Ok", vec_new()] end
  if name == "vec_push" then return ["Ok", vec_push(args[0], args[1])] end
  if name == "vec_set" then return ["Ok", vec_set(args[0], args[1], args[2])] end
  if name == "vec_get" then return ["Ok", vec_get(args[0], args[1])] end
  if name == "vec_len" then return ["Ok", vec_len(args[0])] end
  if name == "vec_to_list" then return ["Ok", vec_to_list(args[0])] end
  if name == "str_intern" then return ["Ok", str_intern(args[0])] end
  if name == "sc_len" then return ["Ok", sc_len(args[0])] end
  if name == "sc_code" then return ["Ok", sc_code(args[0], args[1])] end
  if name == "sc_char" then return ["Ok", sc_char(args[0], args[1])] end
  if name == "sb_new" then return ["Ok", sb_new()] end
  if name == "sb_push" then return ["Ok", sb_push(args[0], args[1])] end
  if name == "sb_str" then return ["Ok", sb_str(args[0])] end
  # --- files ---
  if name == "read_file" then return ["Ok", read_file(args[0])] end
  if name == "try_read_file" then return ["Ok", try_read_file(args[0])] end
  if name == "write_file" then return ["Ok", write_file(args[0], args[1])] end
  if name == "touch_file" then return ["Ok", touch_file(args[0])] end
  if name == "file_exists" then return ["Ok", file_exists(args[0])] end
  if name == "list_dir" then return ["Ok", list_dir(args[0])] end
  if name == "rename_file" then return ["Ok", rename_file(args[0], args[1])] end
  if name == "exec_capture" then
    if args.length == 2 then return ["Ok", exec_capture(args[0], args[1])] end
    if args.length == 3 then return ["Ok", exec_capture(args[0], args[1], args[2])] end
    if args.length == 4 then return ["Ok", exec_capture(args[0], args[1], args[2], args[3])] end
    return ["Err", "exec_capture: " + args.length + " args not supported (expected 2-4)"]
  end
  if name == "exec_capture_io" then return ["Ok", exec_capture_io(args[0], args[1], args[2])] end
  # --- io_misc ---
  if name == "now_ms" then return ["Ok", now_ms()] end
  if name == "byte_length" then return ["Ok", byte_length(args[0])] end
  if name == "read_line" then return ["Ok", read_line()] end
  if name == "argv" then return ["Ok", argv()] end
  if name == "print" then
    print(args[0])
    return ["Ok", 0]
  end
  if name == "len" then return ["Ok", args[0].length] end
  # --- math ---
  if name == "sqrt" then return ["Ok", sqrt(args[0])] end
  if name == "pow" then return ["Ok", pow(args[0], args[1])] end
  if name == "sin" then return ["Ok", sin(args[0])] end
  if name == "cos" then return ["Ok", cos(args[0])] end
  if name == "tan" then return ["Ok", tan(args[0])] end
  if name == "asin" then return ["Ok", asin(args[0])] end
  if name == "acos" then return ["Ok", acos(args[0])] end
  if name == "atan" then return ["Ok", atan(args[0])] end
  if name == "atan2" then return ["Ok", atan2(args[0], args[1])] end
  if name == "log" then return ["Ok", log(args[0])] end
  if name == "exp" then return ["Ok", exp(args[0])] end
  if name == "floor" then return ["Ok", floor(args[0])] end
  if name == "ceil" then return ["Ok", ceil(args[0])] end
  if name == "round" then return ["Ok", round(args[0])] end
  if name == "trunc" then return ["Ok", trunc(args[0])] end
  if name == "abs" then return ["Ok", abs(args[0])] end
  if name == "to_fixed" then return ["Ok", to_fixed(args[0], args[1])] end
  if name == "numeric_kind" then return ["Ok", numeric_kind(args[0])] end
  # --- oo ---
  # These delegate straight to the SAME real host functions any other
  # PatLang program (interpreted or compiled) already calls -- the
  # OBJECTS/FACTS/RULES/ACTIONS registries they read/write live in the
  # native process itself, not in anything this interpreter would need
  # to reimplement in PatLang. There was never an architectural barrier
  # here, just an earlier, narrower scoping choice (see the "1 feature
  # complete" pass's memory notes) -- these are exactly as easy to
  # delegate as `sqrt`/`list_push` above.
  #
  # KNOWN LIMITATION found via broad-coverage testing, NOT fixed here:
  # a class's FIELDS work correctly through this interpreter (new/get/
  # set_var all genuinely delegate to the real native object store), but
  # a class's METHODS do not. `send(recv, method, ...)` is a real host
  # function that invokes the resolved method as a genuine NATIVE
  # closure value -- but when the class (and its methods) are declared
  # BY THE PROGRAM BEING INTERPRETED HERE, each method's "closure" is
  # actually this interpreter's own MakeClosure representation (see
  # interp_run_function's MakeClosure/CallValue handling below: a plain
  # list `["__closure__", func_name, captured_values]`, pure PatLang
  # data, not a real tagged closure value). The real native `send()` has
  # no way to know about that representation, so invoking a method
  # defined by the interpreted program silently does nothing useful
  # (confirmed directly: `type_of(send(obj, "method"))` reports "unit"
  # rather than running the method body or raising any error). Fixing
  # this properly would mean interp.patlang implementing its OWN method
  # dispatch (walking the class's method table itself and calling
  # interp_run_function on the closure data directly, rather than
  # delegating to the real `send`) -- a genuinely separate, larger piece
  # of work, not attempted in this pass. Field-only class usage (no
  # methods) works correctly today; method calls on an interpreter-
  # defined class do not.
  if name == "class_def" then return ["Ok", class_def(args[0], args[1], args[2], args[3], args[4])] end
  if name == "new" then return ["Ok", new(args[0], args[1])] end
  if name == "set_var" then return ["Ok", set_var(args[0], args[1])] end
  if name == "get" then return ["Ok", get(args[0], args[1])] end
  if name == "send" then
    if args.length == 2 then return ["Ok", send(args[0], args[1])] end
    if args.length == 3 then return ["Ok", send(args[0], args[1], args[2])] end
    if args.length == 4 then return ["Ok", send(args[0], args[1], args[2], args[3])] end
    if args.length == 5 then return ["Ok", send(args[0], args[1], args[2], args[3], args[4])] end
    return ["Err", "send: " + args.length + " args not supported (expected 2-5)"]
  end
  # --- logic ---
  if name == "fact" then return ["Ok", fact(args[0], args[1], args[2])] end
  if name == "query" then return ["Ok", query(args[0], args[1], args[2])] end
  if name == "goal" then
    if args.length == 1 then return ["Ok", goal(args[0])] end
    if args.length == 2 then return ["Ok", goal(args[0], args[1])] end
    if args.length == 3 then return ["Ok", goal(args[0], args[1], args[2])] end
    if args.length == 4 then return ["Ok", goal(args[0], args[1], args[2], args[3])] end
    return ["Err", "goal: " + args.length + " args not supported (expected 1-4)"]
  end
  if name == "rule_add" then return ["Ok", rule_add(args[0], args[1], args[2])] end
  if name == "solve" then return ["Ok", solve(args[0], args[1])] end
  if name == "action_add" then return ["Ok", action_add(args[0], args[1], args[2], args[3], args[4])] end
  if name == "plan" then return ["Ok", plan(args[0])] end
  if name == "goal_def" then return ["Ok", goal_def(args[0], args[1])] end
  if name == "pursue" then return ["Ok", pursue(args[0])] end
  if name == "action_bind" then return ["Ok", action_bind(args[0], args[1])] end
  if name == "action_lookup" then return ["Ok", action_lookup(args[0])] end
  if name == "action_base_name" then return ["Ok", action_base_name(args[0])] end
  if name == "action_label_args" then return ["Ok", action_label_args(args[0])] end
  # --- contracts ---
  if name == "contract_check" then return ["Ok", contract_check(args[0], args[1], args[2], args[3])] end
  # --- networking ---
  if name == "tcp_listen" then return ["Ok", tcp_listen(args[0])] end
  if name == "tcp_try_listen" then return ["Ok", tcp_try_listen(args[0])] end
  if name == "tcp_connect" then return ["Ok", tcp_connect(args[0], args[1])] end
  if name == "tcp_try_connect" then return ["Ok", tcp_try_connect(args[0], args[1])] end
  if name == "tcp_accept" then return ["Ok", tcp_accept(args[0])] end
  if name == "sleep_ms" then return ["Ok", sleep_ms(args[0])] end
  if name == "tcp_accept_timeout" then return ["Ok", tcp_accept_timeout(args[0], args[1])] end
  if name == "tcp_read" then return ["Ok", tcp_read(args[0])] end
  if name == "tcp_read_or_empty" then return ["Ok", tcp_read_or_empty(args[0])] end
  if name == "tcp_write" then return ["Ok", tcp_write(args[0], args[1])] end
  if name == "tcp_close" then return ["Ok", tcp_close(args[0])] end
  if name == "spawn" then
    if args.length == 1 then return ["Ok", spawn(args[0])] end
    if args.length == 2 then return ["Ok", spawn(args[0], args[1])] end
    if args.length == 3 then return ["Ok", spawn(args[0], args[1], args[2])] end
    if args.length == 4 then return ["Ok", spawn(args[0], args[1], args[2], args[3])] end
    return ["Err", "spawn: " + args.length + " args not supported (expected 1-4)"]
  end
  if name == "is_alive" then return ["Ok", is_alive(args[0])] end
  if name == "wait" then return ["Ok", wait(args[0])] end
  if name == "kill" then return ["Ok", kill(args[0])] end
  # --- meta: compile/interpret PatLang source from WITHIN a running
  # interpreted program. Not a mirror of any single existing host
  # function -- `interp.patlang` is compiled into the SAME combined
  # source as the compiler itself (lexer/parser/lower/codegen.patlang),
  # so it can call `tokenize`/`parse_program`/`lower_program`/
  # `required_chunks`/`chunk_texts_for`/`emit_program_rs_chunked`/
  # `rustc_build_chunked_texts` directly as ordinary function calls,
  # exactly like `patc1_main.patlang`'s own `lower`/`emit_rust`/
  # `interpret` subcommands already do -- these two just package that
  # SAME pipeline as callable primitives for a running program, rather
  # than only being reachable from the CLI. Built for the natural next
  # step this enables: an interactive REPL/friendly-cli session that can
  # compile (not just interpret) whatever the user typed.
  if name == "compile_patlang" then
    let expanded = expand_syntax_dsls(args[0])
    let toks = tokenize(expanded)
    let ast = parse_program(toks)
    let stmts = ast[1]
    let err = parse_find_error(stmts)
    if err[0] != "" then
      return ["Err", format_parse_error(err[0], err[1], expanded)]
    end
    let compiled_ir = lower_program(ast)
    let chunks = required_chunks(compiled_ir)
    let base_and_pairs = chunk_texts_for(chunks)
    let rs = emit_program_rs_chunked(compiled_ir)
    return ["Ok", rustc_build_chunked_texts(rs, base_and_pairs[0], base_and_pairs[1], args[1])]
  end
  if name == "interpret_patlang" then
    let expanded = expand_syntax_dsls(args[0])
    let toks = tokenize(expanded)
    let ast = parse_program(toks)
    let stmts = ast[1]
    let err = parse_find_error(stmts)
    if err[0] != "" then
      return ["Err", format_parse_error(err[0], err[1], expanded)]
    end
    return interpret_ir(lower_program(ast))
  end
  return ["Err", "host function '" + name + "' not supported by interpret_ir (codegen_bootstrap's legacy compiler-meta tools -- parse_tiny_source/lower_and_compile/emit_rust_for/copy_file/remove_file/patc_compile_from_argv/get_argv -- are deliberately out of scope: half debug-scaffolding, superseded here by the cleaner compile_patlang/interpret_patlang pair above; bare rustc_build/rustc_build_chunked*/run_ir are likewise out of scope, since compile_patlang/interpret_patlang already cover the same need in one call)"]
end

# ---- when/emit event handlers ----
#
# Bringing this interpreter back in line with the compiled path (ir/
# interpreter.rs's own Instr::CallHost "emit" arm): a `when EVENT do
# ... end` block lowers to a real closure, registered at RUNTIME via
# register_event_handler (called from wherever the `when` statement
# itself executes, so it can see an enclosing `let` -- see lower.patlang).
# Closures here are plain ["__closure__", func_name, captured_values]
# lists, not something a host function could invoke -- so, exactly like
# the native side, this has to live in the interpreter itself (see
# run()'s CallHost dispatch), not in interp_call_host's plain host-fn
# table. The registry is a global (__vars), not per-Interpreter-instance
# state, since a `when` block registered inside one call frame must stay
# registered for `emit` calls from anywhere else in the same run.

make a function called interp_event_handlers_get takes name returns handlers
  let all = get("__vars", "__interp_event_handlers")
  if not all then
    return []
  end
  let i = 0
  while i < all.length do
    if all[i][0] == name then
      return all[i][1]
    end
    let i = i + 1
  end
  return []
end

make a function called interp_event_handler_add takes name, closure returns done
  let all = get("__vars", "__interp_event_handlers")
  if not all then
    let all = []
  end
  let i = 0
  let found = false
  while i < all.length do
    if all[i][0] == name then
      let all = list_set(all, i, [name, list_push(all[i][1], closure)])
      let found = true
    end
    let i = i + 1
  end
  if not found then
    let all = list_push(all, [name, [closure]])
  end
  set_var("__interp_event_handlers", all)
  return true
end

# emit(funcs, name, payload) -> ["Ok", last_handler_result] | ["Err", msg].
# Calls each handler registered for `name`, in registration order, with
# args = captured_values ++ [name, payload] -- matching lower_when's
# auto-bound ["event_name", "event_data"] closure params exactly, same
# as the native side's full_args construction.
make a function called interp_emit takes funcs, name, payload returns result
  let handlers = interp_event_handlers_get(name)
  let last = 0
  let i = 0
  while i < handlers.length do
    let closure = handlers[i]
    let func_name = closure[1]
    let captured_values = closure[2]
    let all_args = captured_values
    let all_args = list_push(all_args, name)
    let all_args = list_push(all_args, payload)
    let callee = find_func(funcs, func_name)
    if callee == 0 then
      return ["Err", "emit: handler function '" + func_name + "' not found"]
    end
    let call_result = interp_run_function(funcs, callee, all_args)
    if call_result[0] == "Err" then
      return call_result
    end
    let last = call_result[1]
    let i = i + 1
  end
  return ["Ok", last]
end

make a function called interp_bin takes op, a, b returns v
  if op == "+" then return ["Ok", a + b] end
  if op == "-" then return ["Ok", a - b] end
  if op == "*" then return ["Ok", a * b] end
  if op == "/" then return ["Ok", a / b] end
  if op == "%" then return ["Ok", a % b] end
  if op == "==" then return ["Ok", a == b] end
  if op == "!=" then return ["Ok", a != b] end
  if op == "<" then return ["Ok", a < b] end
  if op == ">" then return ["Ok", a > b] end
  if op == "<=" then return ["Ok", a <= b] end
  if op == ">=" then return ["Ok", a >= b] end
  if op == "and" then return ["Ok", a and b] end
  if op == "or" then return ["Ok", a or b] end
  return ["Err", "unsupported binary operator '" + op + "'"]
end

make a function called interp_un takes op, a returns v
  if op == "-" then return ["Ok", 0 - a] end
  if op == "not" then return ["Ok", not a] end
  return ["Err", "unsupported unary operator '" + op + "'"]
end

# find_func(funcs, name) -> the ["FuncIR", name, params, instrs] entry
# named `name`, or 0 if none matches (a missing user function is a real,
# clear error at the CallHost/Call site, not here).
make a function called find_func takes funcs, name returns f
  let i = 0
  while i < funcs.length do
    if funcs[i][1] == name then
      return funcs[i]
    end
    let i = i + 1
  end
  return 0
end

# interp_run_function(funcs, func, arg_values) -> ["Ok", value] |
# ["Err", message]. `func` is a ["FuncIR", name, params, instrs] entry
# (see lower.patlang); `funcs` is the WHOLE program's function list,
# threaded through so a "Call"/"CallValue" instruction can look up and
# recurse into any other function by name -- ordinary PatLang function
# calls become ordinary recursive calls into this same interpreter, using
# PatLang's own call stack, no separate call-stack bookkeeping needed
# here.
# Interpreter -- the same OO treatment given to the compiler's own
# ObjCache/CompileUnit/X64UnitLinker classes this session: what used to
# be five loose local variables threaded through a giant while-loop via
# "let x = new_value" reassignment (locals/stack/pc/error_msg/has_error)
# are now real fields on a genuine PatLang object, mutated in place the
# same way any other class's state works (obj.field = value sugar).
#
# Deliberately NOT taken further into per-operation method dispatch
# (e.g. a "push"/"pop" method called via `send` for every single stack
# operation) -- this interpreter is about to be benchmarked, and dynamic
# dispatch (a class/method-table lookup) on every push/pop inside the
# hottest loop in the whole file would be a real, measurable performance
# regression for no architectural benefit; `run` below is the single
# coarse-grained method (one per function invocation, not one per
# instruction), matching the same granularity ObjCache/CompileUnit's own
# methods already use. The elif chain replaces the original deeply-
# nested if/else/if/else instruction dispatch (12 levels deep) per this
# session's own established CLAUDE.md convention: a new branch on a
# chain like that can no longer desync the deferred `end` stack, since
# there's only ever the one `end` for the whole chain regardless of how
# many elifs it has.
class Interpreter {
  field funcs = []
  field instrs = []
  field locals = []
  field stack = []
  field pc = 0
  field final_result = 0
  field error_msg = ""
  field has_error = false
  field running = true
  field fname = "main"
  field lines = []

  make a function called run takes self returns result
    while get(self, "running") do
      let instrs = get(self, "instrs")
      let pc = get(self, "pc")
      if pc >= instrs.length then
        self.running = false
      else
        # Debugger hook: a no-op (a single lookup that finds nothing) unless
        # dbg_start has actually put breakpoints/step-mode into the global
        # debug state, so ordinary (non-debug) interpretation pays only that
        # one cheap lookup per instruction. See dbg_check_pause's own
        # comment for the full pause/resume story via fiber_yield.
        dbg_check_pause(self, get(self, "fname"), get(self, "lines"), pc)
        let instr = instrs[pc]
        let op = instr[0]
        if op == "Const" then
          self.stack = list_push(get(self, "stack"), interp_const(instr[1], instr[2]))
          self.pc = pc + 1
        elif op == "Load" then
          self.stack = list_push(get(self, "stack"), locals_get(get(self, "locals"), instr[1]))
          self.pc = pc + 1
        elif op == "Store" then
          let popped = stack_pop(get(self, "stack"))
          self.locals = locals_set(get(self, "locals"), instr[1], popped[0])
          self.stack = popped[1]
          self.pc = pc + 1
        elif op == "Bin" then
          let popped_b = stack_pop(get(self, "stack"))
          let b = popped_b[0]
          let popped_a = stack_pop(popped_b[1])
          let a = popped_a[0]
          let bin_result = interp_bin(instr[1], a, b)
          if bin_result[0] == "Err" then
            self.error_msg = bin_result[1]
            self.has_error = true
            self.running = false
          else
            self.stack = list_push(popped_a[1], bin_result[1])
            self.pc = pc + 1
          end
        elif op == "Un" then
          let popped = stack_pop(get(self, "stack"))
          let un_result = interp_un(instr[1], popped[0])
          if un_result[0] == "Err" then
            self.error_msg = un_result[1]
            self.has_error = true
            self.running = false
          else
            self.stack = list_push(popped[1], un_result[1])
            self.pc = pc + 1
          end
        elif op == "Jump" then
          self.pc = instr[1]
        elif op == "JumpIfFalse" then
          let popped = stack_pop(get(self, "stack"))
          self.stack = popped[1]
          if popped[0] then
            self.pc = pc + 1
          else
            self.pc = instr[1]
          end
        elif op == "Return" then
          let stack = get(self, "stack")
          if stack.length > 0 then
            self.final_result = stack[stack.length - 1]
          end
          self.running = false
        elif op == "CallHost" then
          let popped = stack_pop_n(get(self, "stack"), instr[2])
          # register_event_handler/emit need to invoke a CLOSURE (a `when`
          # block's synthesized handler) -- an ordinary host fn can't do
          # that (interp_call_host has no access to `funcs`, and closures
          # here are plain PatLang lists, not something a host fn could
          # call back into anyway). Mirrors ir/interpreter.rs's own
          # Instr::CallHost dispatch exactly: these two names are special-
          # cased in the INTERPRETER itself, not the plain host-fn table.
          if instr[1] == "register_event_handler" then
            interp_event_handler_add(popped[0][0], popped[0][1])
            self.stack = list_push(popped[1], 0)
            self.pc = pc + 1
          elif instr[1] == "emit" then
            let emit_result = interp_emit(get(self, "funcs"), popped[0][0], popped[0][1])
            if emit_result[0] == "Err" then
              self.error_msg = emit_result[1]
              self.has_error = true
              self.running = false
            else
              self.stack = list_push(popped[1], emit_result[1])
              self.pc = pc + 1
            end
          else
            let call_result = interp_call_host(instr[1], popped[0])
            if call_result[0] == "Err" then
              self.error_msg = call_result[1]
              self.has_error = true
              self.running = false
            else
              self.stack = list_push(popped[1], call_result[1])
              self.pc = pc + 1
            end
          end
        elif op == "BuildList" then
          let popped = stack_pop_n(get(self, "stack"), instr[1])
          self.stack = list_push(popped[1], popped[0])
          self.pc = pc + 1
        elif op == "Call" then
          let popped = stack_pop_n(get(self, "stack"), instr[2])
          let callee = find_func(get(self, "funcs"), instr[1])
          if callee == 0 then
            self.error_msg = "user function '" + instr[1] + "' not found"
            self.has_error = true
            self.running = false
          else
            dbg_call_stack_push(instr[1])
            let call_result = interp_run_function(get(self, "funcs"), callee, popped[0])
            dbg_call_stack_pop()
            if call_result[0] == "Err" then
              self.error_msg = call_result[1]
              self.has_error = true
              self.running = false
            else
              self.stack = list_push(popped[1], call_result[1])
              self.pc = pc + 1
            end
          end
        elif op == "MakeClosure" then
          let captured_names = instr[2]
          let popped = stack_pop_n(get(self, "stack"), captured_names.length)
          self.stack = list_push(popped[1], ["__closure__", instr[1], popped[0]])
          self.pc = pc + 1
        elif op == "CallValue" then
          let popped_args = stack_pop_n(get(self, "stack"), instr[1])
          let popped_closure = stack_pop(popped_args[1])
          let closure = popped_closure[0]
          let func_name = closure[1]
          let captured_values = closure[2]
          let all_args = captured_values
          let k = 0
          while k < popped_args[0].length do
            let all_args = list_push(all_args, popped_args[0][k])
            let k = k + 1
          end
          let callee = find_func(get(self, "funcs"), func_name)
          if callee == 0 then
            self.error_msg = "closure target function '" + func_name + "' not found"
            self.has_error = true
            self.running = false
          else
            dbg_call_stack_push(func_name)
            let call_result = interp_run_function(get(self, "funcs"), callee, all_args)
            dbg_call_stack_pop()
            if call_result[0] == "Err" then
              self.error_msg = call_result[1]
              self.has_error = true
              self.running = false
            else
              self.stack = list_push(popped_closure[1], call_result[1])
              self.pc = pc + 1
            end
          end
        else
          self.error_msg = "'" + op + "' not recognized (not part of the current IR instruction set)"
          self.has_error = true
          self.running = false
        end
      end
    end
    if get(self, "has_error") then
      return ["Err", get(self, "error_msg")]
    end
    return ["Ok", get(self, "final_result")]
  end
}

# Unique per-call object-store name -- recursion (a Call/CallValue
# instruction recursing back into interp_run_function) means many
# Interpreter instances can be live at once, each its own stack frame;
# the object store is a single global namespace keyed by this name, so
# reusing a fixed name across recursive calls would alias and corrupt
# an outer frame's own live state. Same counter idiom lower.patlang
# already uses for next_closure_name/next_budgeted_name/next_activate_name.
make a function called next_interp_name returns name
  let n = get("__vars", "__interp_seq")
  if not n then
    let n = 0
  end
  set_var("__interp_seq", n + 1)
  return "__interp_" + n
end

make a function called interp_run_function takes funcs, func, arg_values returns result
  let params = func[2]
  let instrs = func[3]
  let locals = []
  let pi = 0
  while pi < params.length do
    let locals = locals_set(locals, params[pi], arg_values[pi])
    let pi = pi + 1
  end
  let interp = new("Interpreter", next_interp_name())
  interp.funcs = funcs
  interp.instrs = instrs
  interp.locals = locals
  interp.fname = func[1]
  # func[4] (the debug line table) is absent on IR loaded from a .ir file
  # saved before this field existed -- fall back to an empty table rather
  # than an out-of-bounds index, so old .ir files still interpret fine
  # (just without breakpoint/step support on those specific functions).
  if func.length > 4 then
    interp.lines = func[4]
  end
  return send(interp, "run")
end

# ---- Debugger: breakpoints, stepping, call-stack, via fiber pause/resume ----
#
# A whole debugged run is ONE fiber (dbg_start below), resumed repeatedly
# with a debug command. Each resume returns either a ["Paused", fname,
# line, locals, call_stack] snapshot (dbg_check_pause below yielded one
# instruction before it would have run) or the interpreter's own natural
# ["Ok", value] / ["Err", message] once the program actually finishes --
# no separate "Done" wrapper needed, since fiber_resume's final return is
# exactly the fiber body's own return value, and only a pause is ever
# tagged "Paused".
#
# All debug state (mode, breakpoints, the shadow call stack) lives in the
# __vars global table, NOT on any one Interpreter instance -- a paused
# program is typically many nested Interpreter objects deep (one per live
# PatLang call frame, since Call/CallValue recurse via ordinary PatLang
# calls, not an explicit frame stack), and the debugger needs to see
# across all of them at once from a single place.
#
# Modes: "run" (stop only at a breakpoint), "into" (stop at the very next
# line-tagged pc, any call depth), "over"/"out" (stop once the call-stack
# depth drops to/below a target depth recorded when the step command was
# issued).

make a function called dbg_lines_lookup takes lines, pc returns line
  let i = 0
  while i < lines.length do
    if lines[i][0] == pc then
      return lines[i][1]
    end
    let i = i + 1
  end
  return 0
end

make a function called dbg_breakpoint_hit takes fname, line returns hit
  let bps = get("__vars", "__dbg_breakpoints")
  if not bps then
    return false
  end
  let i = 0
  while i < bps.length do
    if (bps[i][0] == fname) and (bps[i][1] == line) then
      return true
    end
    let i = i + 1
  end
  return false
end

make a function called dbg_call_stack_snapshot returns cs
  let cs = get("__vars", "__dbg_call_stack")
  if not cs then
    return []
  end
  return cs
end

make a function called dbg_call_stack_depth returns n
  return dbg_call_stack_snapshot().length
end

# No list_slice/pop-last host builtin exists -- rebuild everything but the
# last element instead.
make a function called dbg_list_drop_last takes lst returns out
  let out = []
  let i = 0
  while i < (lst.length - 1) do
    let out = list_push(out, lst[i])
    let i = i + 1
  end
  return out
end

make a function called dbg_call_stack_push takes fname returns done
  set_var("__dbg_call_stack", list_push(dbg_call_stack_snapshot(), fname))
  return true
end

make a function called dbg_call_stack_pop returns done
  let cs = dbg_call_stack_snapshot()
  if cs.length > 0 then
    set_var("__dbg_call_stack", dbg_list_drop_last(cs))
  end
  return true
end

# cmd is [kind, breakpoints_or_false]: kind is one of "continue"/
# "step_into"/"step_over"/"step_out"/"stop"; breakpoints, when not false,
# REPLACES the current breakpoint set (a real IDE debugger conveniently
# just re-sends its whole current breakpoint list on every resume, rather
# than needing a separate "just update breakpoints, don't resume" command
# that this fiber-parked design has no clean way to express anyway).
make a function called dbg_apply_command takes cmd returns done
  let kind = cmd[0]
  let bps = cmd[1]
  if bps then
    set_var("__dbg_breakpoints", bps)
  end
  if kind == "continue" then
    set_var("__dbg_mode", "run")
  elif kind == "step_into" then
    set_var("__dbg_mode", "into")
  elif kind == "step_over" then
    set_var("__dbg_mode", "over")
    set_var("__dbg_target_depth", dbg_call_stack_depth())
  elif kind == "step_out" then
    set_var("__dbg_mode", "out")
    set_var("__dbg_target_depth", dbg_call_stack_depth() - 1)
  elif kind == "stop" then
    set_var("__dbg_stop_requested", true)
  end
  return true
end

# Called once per instruction from Interpreter.run(), BEFORE the
# instruction at pc executes -- a single lookup that finds nothing for
# most pcs (this table is sparse, one entry per statement), so ordinary
# non-debug interpretation pays almost nothing extra. Only pauses (via
# fiber_yield) at a statement boundary that's a breakpoint or satisfies
# the current step mode.
make a function called dbg_check_pause takes self, fname, lines, pc returns done
  if get("__vars", "__dbg_stop_requested") then
    self.error_msg = "stopped by debugger"
    self.has_error = true
    self.running = false
    return true
  end
  let line = dbg_lines_lookup(lines, pc)
  if line == 0 then
    return true
  end
  let mode = get("__vars", "__dbg_mode")
  if not mode then
    let mode = "run"
  end
  let should_pause = dbg_breakpoint_hit(fname, line)
  if mode == "into" then
    let should_pause = true
  end
  if (mode == "over") or (mode == "out") then
    if dbg_call_stack_depth() <= get("__vars", "__dbg_target_depth") then
      let should_pause = true
    end
  end
  if should_pause then
    let cmd = fiber_yield(["Paused", fname, line, get(self, "locals"), dbg_call_stack_snapshot()])
    dbg_apply_command(cmd)
    if get("__vars", "__dbg_stop_requested") then
      self.error_msg = "stopped by debugger"
      self.has_error = true
      self.running = false
    end
  end
  return true
end

# The one fiber-body function: fiber_new calls whatever named function
# with exactly the first fiber_resume's argument, so `bundle` is
# [entry_name, funcs] (lower_program's ProgramIR, indices 1 and 2) --
# dbg_start below sends that as its very first resume. Resets the debug
# globals fresh here (rather than trusting leftover state from an earlier
# session) and starts in "into" mode so the very first statement already
# pauses, matching what a debugger's initial "run to first line" normally
# does.
make a function called dbg_fiber_entry takes bundle returns result
  let entry = bundle[0]
  let funcs = bundle[1]
  set_var("__dbg_mode", "into")
  set_var("__dbg_target_depth", 0)
  set_var("__dbg_call_stack", [])
  set_var("__dbg_stop_requested", false)
  set_var("__interp_event_handlers", [])
  let main_func = find_func(funcs, entry)
  if main_func == 0 then
    return ["Err", "entry function '" + entry + "' not found"]
  end
  return interp_run_function(funcs, main_func, [])
end

# dbg_start(source) -> ["Ok", fiber_id, first_state]. Compiles `source`
# through the ordinary tokenize/parse_program/lower_program pipeline,
# spawns it as a fiber running dbg_fiber_entry, and performs the FIRST
# fiber_resume (delivering [entry, funcs] as that function's one
# argument) -- since dbg_fiber_entry starts in "into" mode, this first
# resume already returns the initial ["Paused", ...] snapshot at the
# program's first statement (or an immediate ["Ok"/"Err", ...] for a
# program with no debuggable top-level statement at all, e.g. an empty
# source file).
make a function called dbg_start takes source returns result
  let toks = tokenize(source)
  let ast = parse_program(toks)
  let ir = lower_program(ast)
  let fid = fiber_new("dbg_fiber_entry")
  let first = fiber_resume(fid, [ir[1], ir[2]])
  return ["Ok", fid, first]
end

# dbg_step(fiber_id, cmd) -> the next ["Paused", ...] or ["Ok"/"Err", ...]
# state. See dbg_apply_command for cmd's shape.
make a function called dbg_step takes fiber_id, cmd returns result
  return fiber_resume(fiber_id, cmd)
end

# dbg_trace(source, breakpoints, max_steps) -> ["Ok"/"Err", trace, final].
# A REPLAY debugger's capture pass: runs the whole program to completion in
# ONE call, single-stepping "into" every statement so `trace` captures the
# COMPLETE ["Paused", fname, line, locals, call_stack] sequence, not just
# breakpoint stops -- the browser UI needs the full sequence to scrub
# forward/back through afterwards. `breakpoints` is still threaded through
# to dbg_step/dbg_apply_command so it lands in the debug state (available
# to a caller that wants dbg_breakpoint_hit-style marking of which trace
# entries are breakpoints, e.g. to highlight them in the scrub UI) -- it
# does not change what gets captured here.
#
# Exists because the browser IDE calls into a WASM module through a
# stateless, one-shot convention (this site's runWasm/runWasmThreaded: one
# call, one _start(), the instance is then discarded) -- there is no
# persistent-instance calling convention here, and no blocking-stdin
# bridge either, so a genuinely interactive "click Step, resume the SAME
# paused fiber" design has no supported browser transport on this site.
# Capturing one real, complete execution trace and letting the UI scrub
# forward/back through it client-side (already-captured, real data, not
# synthesized) is the design that actually fits: the exact same shape
# patlang-robots.html's "replays the exact step-by-step transcript from a
# genuine run" already uses and documents to users.
#
# max_steps is a hard safety cap (an infinite/runaway loop in the user's
# own program must not hang the capture pass forever); hitting it ends the
# trace early with an ["Err", "..."] final rather than never returning.
make a function called dbg_trace takes source, breakpoints, max_steps returns result
  let started = dbg_start(source)
  let fid = started[1]
  let state = started[2]
  let trace = []
  let n = 0
  let looping = true
  while looping do
    if state[0] != "Paused" then
      let looping = false
    else
      let trace = list_push(trace, state)
      let n = n + 1
      if n >= max_steps then
        let looping = false
        return ["Err", trace, ["Err", "dbg_trace: stopped after " + max_steps + " steps (possible infinite loop)"]]
      end
      let state = dbg_step(fid, ["step_into", breakpoints])
    end
  end
  return ["Ok", trace, state]
end

# interpret_ir(ir) -> ["Ok", value] | ["Err", message]. Runs `ir`'s "main"
# function with no arguments. `ir` is the ["ProgramIR", entry_name, funcs,
# events] shape lower_program() produces (or load_ir() reads back from a
# saved .ir file) -- exactly the same shape emit_program_rs/emit_program_
# x64 already consume, so this is a genuine third final stage, not a
# parallel reimplementation of the front end.
make a function called interpret_ir takes ir returns result
  let entry = ir[1]
  let funcs = ir[2]
  set_var("__interp_event_handlers", [])
  let main_func = find_func(funcs, entry)
  if main_func == 0 then
    return ["Err", "entry function '" + entry + "' not found"]
  end
  return interp_run_function(funcs, main_func, [])
end

# ---- Debug trace JSON serialization (for the browser IDE) ----
#
# Needs json_quote/json_escape from lib/json.patlang -- any bundle that
# includes this section must also include lib/json.patlang (build_patc1's
# own bundle already does, for its own unrelated reasons; a standalone
# IDE-debug WASM bundle needs to add it explicitly).

make a function called dbg_value_to_json takes v returns json
  let ty = type_of(v)
  if ty == "string" then
    return json_quote(v)
  end
  if ty == "list" then
    let out = "["
    let i = 0
    while i < v.length do
      if i > 0 then
        let out = out + ","
      end
      let out = out + dbg_value_to_json(v[i])
      let i = i + 1
    end
    return out + "]"
  end
  if (ty == "int") or (ty == "float") or (ty == "bigint") or (ty == "bool") then
    return "" + v
  end
  # rational/complex/closure/object/unit: no direct JSON representation --
  # fall back to the same display string print(v) would show, as a JSON
  # string rather than a bare (possibly non-JSON) token.
  return json_quote("" + v)
end

# One ["Paused", fname, line, locals, call_stack] entry -> a JSON object
# string. locals is encoded as a JSON object (name -> value), not an
# array of pairs, so the IDE's variables panel can index straight by name.
make a function called dbg_paused_to_json takes ev returns json
  let fname = ev[1]
  let line = ev[2]
  let locals = ev[3]
  let call_stack = ev[4]
  let locals_json = "{"
  let i = 0
  while i < locals.length do
    if i > 0 then
      let locals_json = locals_json + ","
    end
    let locals_json = locals_json + json_quote(locals[i][0]) + ":" + dbg_value_to_json(locals[i][1])
    let i = i + 1
  end
  let locals_json = locals_json + "}"
  return "{\"fname\":" + json_quote(fname) + ",\"line\":" + line + ",\"locals\":" + locals_json + ",\"call_stack\":" + dbg_value_to_json(call_stack) + "}"
end

# dbg_trace_json(source, max_steps) -> a JSON string:
# {"ok":true,"trace":[...],"final_ok":true,"final_value":<json>} or
# {"ok":false,"trace":[...],"error":"..."} -- the browser IDE's actual
# entry point (see dbg_trace's own comment for why this is a captured
# replay, not a live click-driven session). Breakpoints are always empty
# here: this bundle always captures the FULL trace regardless, and lets
# the page-side UI decide which captured steps to treat as "breakpoint
# stops" when scrubbing through it.
make a function called dbg_trace_json takes source, max_steps returns json
  let r = dbg_trace(source, false, max_steps)
  let trace = r[1]
  let final = r[2]
  let trace_json = "["
  let i = 0
  while i < trace.length do
    if i > 0 then
      let trace_json = trace_json + ","
    end
    let trace_json = trace_json + dbg_paused_to_json(trace[i])
    let i = i + 1
  end
  let trace_json = trace_json + "]"
  if r[0] == "Ok" then
    return "{\"ok\":true,\"trace\":" + trace_json + ",\"final_ok\":" + (final[0] == "Ok") + ",\"final_value\":" + dbg_value_to_json(final[1]) + "}"
  end
  return "{\"ok\":false,\"trace\":" + trace_json + ",\"error\":" + json_quote(final[1]) + "}"
end
