# interp_run.patlang -- run PatLang source in a clean interpreter and get its
# output back as a value: [stdout, stderr, ok].
#
# Two backends behind one API:
#   "world"   in-process: the v2 interpreter (v2/interpreter.patlang) compiles
#             the program with the compiler's own front end and runs it in a
#             world of its own (docs/spec/values-and-memory.md 1.15), which
#             holds everything the program adds, declares or writes and none
#             of the caller's state. What it prints, and a stop, stay in the
#             world. Needs no subprocess.
#   "process" a fresh interpreter child via exec_capture_io: the v2
#             interpreter (self_hosting/build/v2_interp.exe), or a pat.exe
#             run with --quiet --ir-run. Needs "subprocess" in host_caps()
#             and that executable; honours a wall-clock timeout_ms and stdin.
#
# Both run the program on the same interpreter, so they print the same: a
# program that does not compile prints its errors on stdout ("error: ..."),
# as the interpreter's command line does, and so does a stop. stderr is the
# child process's and is empty on the world backend.
#
# Options are a list of [key, value] pairs (all optional):
#   backend      "auto" (default) | "world" | "process"
#   max_steps    world only: a step budget, spent at each call and each jump
#                back; exhausted => ok=false
#   timeout_ms   process only: wall-clock limit; expiry => ok=false
#   stdin        process only: text fed to the child's stdin
#   base_dir     resolve `include` lines in the source relative to this
#                directory before running (both backends)
#   pat_path     path to the child interpreter (else $PATLANG_PAT, else
#                self_hosting/build/v2_interp.exe)
#   vfs_in       world only: [[path, content], ...] written into the world's
#                virtual files before the program runs
#   vfs_out_prefix  world only: the world's virtual files under this prefix
#                come back, as [[path, content], ...]
#
# "auto" picks the world backend (a spawn costs far more than a world), and
# the process backend when the caller asks for something only it can do
# (timeout_ms, stdin). The world backend refuses stdin.
#
# The runtime's declarations the world backend compiles with are read once,
# and kept in the caller's context (lib/context.patlang).

include "context.patlang"
include "includes.patlang"
include "../v2/interpreter.patlang"

make a function called iri_opt takes opts, key, fallback returns value
  let i = 0
  let n = list_len(opts)
  while i < n do
    let kv = opts[i]
    if kv[0] == key then return kv[1] end
    let i = i + 1
  end
  return fallback
end

make a function called iri_has_cap takes name returns found
  let caps = host_caps()
  let i = 0
  while i < list_len(caps) do
    if caps[i] == name then return true end
    let i = i + 1
  end
  return false
end

# The runtime's declarations (v2/front.patlang), read the first time.
make a function called iri_runtime takes ctx returns rt
  if ctx_has(ctx, "__interp_run_runtime") then
    return ctx_get(ctx, "__interp_run_runtime")
  end
  let rt = iv_runtime("")
  ctx_set(ctx, "__interp_run_runtime", rt)
  return rt
end

# Source -> ["ok", program] or ["err", what the interpreter prints for it], the
# program being what interp_run_ir runs. `syntax` definitions are expanded and
# includes resolved as the interpreter's command line does.
make a function called interp_compile takes ctx, src returns result
  let c = iv_compile(iri_runtime(ctx), "_interp_run.patlang", src)
  if c[0] == "ok" then
    return c
  end
  let b = sb_new()
  let i = 0
  while i < list_len(c[1]) do
    sb_push(b, "error: " + c[1][i] + chr(10))
    let i = i + 1
  end
  return ["err", sb_str(b)]
end

make a function called interp_pat_path takes opts returns path
  let p = iri_opt(opts, "pat_path", "")
  if p != "" then return p end
  let e = "" + getenv("PATLANG_PAT")
  if e != "" then return e end
  return "self_hosting/build/v2_interp.exe"
end

# The arguments that run the program at `path` on the interpreter `pat`, and
# whether the child's output ends with an echo of the program's final value,
# for the caller to drop. The v2 interpreter takes the file alone and echoes
# nothing (spec 1.13); a pat.exe needs --ir-run, and echoes the value unless
# it understands --quiet.
make a function called iri_engine_command takes ctx, pat, path returns cmd
  require (value_class(pat) == 8) and (value_class(path) == 8)
  if not str_ends_with(pat, "pat.exe") then
    let cmd = [[path], false]
  elif iri_quiet_supported(ctx, pat) then
    let cmd = [["--quiet", "--ir-run", path], false]
  else
    let cmd = [["--ir-run", path], true]
  end
  ensure list_len(cmd) == 2
  return cmd
end

# "world" or "process" for these options on this runtime, "" if neither can run.
make a function called interp_backend takes opts returns name
  let want = iri_opt(opts, "backend", "auto")
  let has_proc = iri_has_cap("subprocess") and file_exists(interp_pat_path(opts))
  if want == "world" then return "world" end
  if want == "process" then
    if has_proc then return "process" end
    return ""
  end
  let needs_proc = iri_opt(opts, "timeout_ms", 0) > 0 or iri_opt(opts, "stdin", "") != ""
  if needs_proc and has_proc then return "process" end
  return "world"
end

make a function called iri_failed takes message returns result
  return ["", message, false, []]
end

# Does this pat.exe understand --quiet (drops the echo of the final value)?
# Probed once per pat_path and cached in the context.
make a function called iri_quiet_supported takes ctx, pat returns yes
  let key = "__interp_run_quiet_" + pat
  let cached = ctx_text(ctx, key)
  if cached != "" then return cached == "1" end
  let probe = "self_hosting/build/_interp_run_probe.patlang"
  write_file(probe, "print(\"q\")" + chr(10))
  let r = exec_capture_io(pat, ["--quiet", "--ir-run", probe], "", 0)
  remove_file(probe)
  let quiet = r[0] == "q" + chr(10)
  if quiet then ctx_set(ctx, key, "1") else ctx_set(ctx, key, "0") end
  return quiet
end

make a function called iri_tmp_path takes ctx, opts returns path
  let n = ctx_counter(ctx, "__interp_run_seq")
  let dir = iri_opt(opts, "tmp_dir", "self_hosting/build")
  return dir + "/_interp_run_" + now_ms() + "_" + n + ".patlang"
end

make a function called iri_run_process takes ctx, src, opts returns result
  let pat = interp_pat_path(opts)
  let tmp = iri_tmp_path(ctx, opts)
  write_file(tmp, src)
  let cmd = iri_engine_command(ctx, pat, tmp)
  let timeout = iri_opt(opts, "timeout_ms", 0)
  let r = exec_capture_io(pat, cmd[0], iri_opt(opts, "stdin", ""), timeout)
  remove_file(tmp)
  let out = r[0]
  if cmd[1] and r[2] then
    # An unpatched pat.exe echoes the program's final value (Unit -> an empty
    # line) after its own output.
    if out.length > 0 then let out = substr(out, 0, out.length - 1) end
  end
  return [out, r[1], r[2], []]
end

# interp_run_full(src, opts) -> [stdout, stderr, ok, vfs_out]
make a function called interp_run_full takes ctx, src, opts returns result
  let backend = interp_backend(opts)
  if backend == "" then
    return iri_failed("interp_run: no backend available for these options (host_caps: " + list_len(host_caps()) + " entries)")
  end
  let base_dir = iri_opt(opts, "base_dir", "")
  if base_dir != "" then let src = expand_includes(src, base_dir) end
  if backend == "process" then
    return iri_run_process(ctx, src, opts)
  end
  if iri_opt(opts, "stdin", "") != "" then
    return iri_failed("interp_run: stdin needs the process backend")
  end
  let c = interp_compile(ctx, src)
  if c[0] == "err" then return [c[1], "", false, []] end
  return interp_run_ir(c[1], opts)
end

# interp_run(src, opts) -> [stdout, stderr, ok]
make a function called interp_run takes ctx, src, opts returns result
  let r = interp_run_full(ctx, src, opts)
  return [r[0], r[1], r[2]]
end

# The world backend on a program interp_compile gave (compile once, run many
# times): a new world for each run, given back after it.
make a function called interp_run_ir takes program, opts returns result
  let w = world_new()
  let steps = iri_opt(opts, "max_steps", 0)
  if steps > 0 then world_steps(w, steps) end
  let vin = iri_opt(opts, "vfs_in", [])
  world_call(w, || {
    let i = 0
    while i < list_len(vin) do
      vfs_write(vin[i][0], vin[i][1])
      let i = i + 1
    end
    return true
  })
  let r = iv_world_run(w, program)
  let out = world_output(w)
  let prefix = iri_opt(opts, "vfs_out_prefix", "")
  let vout = []
  if prefix != "" then
    let vout = world_call(w, || {
      let paths = vfs_list(prefix)
      let got = []
      let i = 0
      while i < list_len(paths) do
        let got = list_push(got, [paths[i], vfs_read(paths[i])])
        let i = i + 1
      end
      return got
    })[1]
  end
  world_free(w)
  return [out, "", r[0] == "done", vout]
end

# Runs src on both backends and compares stdout, ok and the first line of
# stderr. Returns [same, detail]; only meaningful for programs that terminate.
make a function called interp_run_check takes ctx, src, opts returns result
  let a = interp_run_full(ctx, src, list_push(opts, ["backend", "world"]))
  let b = interp_run_full(ctx, src, list_push(opts, ["backend", "process"]))
  if a[0] != b[0] then return [false, "stdout differs: world=[" + a[0] + "] process=[" + b[0] + "]"] end
  if a[2] != b[2] then return [false, "ok differs: world=" + a[2] + " process=" + b[2]] end
  let ea = iri_first_line(a[1])
  let eb = iri_first_line(b[1])
  if ea != eb then return [false, "stderr differs: world=[" + ea + "] process=[" + eb + "]"] end
  return [true, ""]
end

make a function called iri_first_line takes s returns line
  let h = str_intern(s)
  let n = sc_len(h)
  let i = 0
  while i < n do
    if sc_code(h, i) == 10 then return substr(s, 0, i) end
    let i = i + 1
  end
  return s
end
