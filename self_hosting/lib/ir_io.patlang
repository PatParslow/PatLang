# =============================================================================
# IR serialization -- save the list-shaped IR lower_program() produces to a
# plain JSON text file, and load it back, so the compiler pipeline's stages
# can be run as separate commands against a saved `.ir` file instead of
# always re-lexing/parsing/lowering from source in one shot. Reuses
# lib/json.patlang's existing reader/writer, which operates on a small
# TAGGED value shape (["str", x] / ["num", x] / ["bool", x] / ["null"] /
# ["arr", [...]] / ["obj", [...]]) rather than plain PatLang values -- these
# two adapters convert between that tagged shape and the plain nested
# lists/strings/numbers/booleans the IR (and the AST) are actually built
# from, so ANY such plain PatLang value can be round-tripped through JSON,
# not just IR specifically.
# =============================================================================

make a function called to_json_value takes v returns j
  let t = type_of(v)
  if t == "string" then
    return ["str", v]
  end
  if t == "int" then
    return ["num", v]
  end
  if t == "float" then
    return ["num", v]
  end
  if t == "bool" then
    return ["bool", v]
  end
  if t == "list" then
    let items = []
    let i = 0
    while i < v.length do
      let items = list_push(items, to_json_value(v[i]))
      let i = i + 1
    end
    return ["arr", items]
  end
  return ["null"]
end

make a function called from_json_value takes j returns v
  let tag = j[0]
  if tag == "str" then
    return j[1]
  end
  if tag == "num" then
    return j[1]
  end
  if tag == "bool" then
    return j[1]
  end
  if tag == "arr" then
    let items = j[1]
    let out = []
    let i = 0
    while i < items.length do
      let out = list_push(out, from_json_value(items[i]))
      let i = i + 1
    end
    return out
  end
  return 0
end

# save_ir(ir, path) -- writes the IR (or any plain nested list/string/number
# value) to `path` as JSON text.
make a function called save_ir takes ir, path returns ok
  write_file(path, json_stringify(to_json_value(ir)))
  return true
end

# load_ir(path) -- reads back what save_ir wrote.
make a function called load_ir takes path returns ir
  return from_json_value(json_parse(read_file(path)))
end
