# isolate_process_runtime.patlang -- the VFS<->JSON marshalling shared by
# isolate_process.patlang (the parent side) and the generated child-process
# runner source isolate_step_process builds (self_hosting/lib/isolate_process.
# patlang's own isop_build_runner_source). Deliberately dependency-light
# (only json.patlang) since this file's text gets spliced, via expand_includes,
# into a FRESH pat.exe --ir-run child process per isolate turn -- the normal
# "no diamond includes in one compiled source" constraint (preprocess.rs/
# expand_includes_at_depth do not dedupe) applies there same as anywhere else.
#
# isopr_restore/isopr_dump do no print() of their own, so they never interleave
# with the isolate body's own stdout.

include "json.patlang"

make a function called isop_entries_to_json takes entries returns text
  let items = []
  let i = 0
  while i < list_len(entries) do
    let pair = entries[i]
    let items = list_push(items, json_make_arr([json_make_str(pair[0]), json_make_str(pair[1])]))
    let i = i + 1
  end
  return json_stringify(json_make_arr(items))
end

make a function called isop_json_to_entries takes text returns entries
  let arr = json_arr(json_parse(text))
  let out = []
  let i = 0
  while i < list_len(arr) do
    let pair = json_arr(arr[i])
    let out = list_push(out, [json_str(pair[0]), json_str(pair[1])])
    let i = i + 1
  end
  return out
end

# Child-side: load the VFS snapshot the parent wrote before the isolate body
# runs.
make a function called isopr_restore takes path returns done
  let entries = isop_json_to_entries(read_file(path))
  let i = 0
  while i < list_len(entries) do
    vfs_write(entries[i][0], entries[i][1])
    let i = i + 1
  end
  return true
end

# Child-side: dump the whole VFS (this process's entire namespace, since it
# started fresh and holds nothing but what isopr_restore just loaded plus
# whatever the isolate body itself wrote) back out for the parent to read
# once this process exits. Only reached if the body ran to completion without
# crashing -- a crash before this point leaves no dump file, which the parent
# (isolate_step_process) treats as turn failure/rollback, same as a crashing
# world_run turn today.
make a function called isopr_dump takes path returns done
  let keys = vfs_list("/")
  let entries = []
  let i = 0
  while i < list_len(keys) do
    let entries = list_push(entries, [keys[i], vfs_read(keys[i])])
    let i = i + 1
  end
  write_file(path, isop_entries_to_json(entries))
  return true
end
