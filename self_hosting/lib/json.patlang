# Minimal recursive-descent JSON parser: objects, arrays, strings (with
# escapes), numbers, true/false/null - enough to handle real API responses
# correctly rather than fragile substring scraping. Values are tagged
# lists: ["obj", [[key,value],...]], ["arr", [value,...]], ["str", s],
# ["num", n], ["bool", b], ["null"].

make a function called json_is_digit takes c returns yes
  let code = char_code(c, 0)
  return (code >= 48) and (code <= 57)
end

make a function called json_hex_val takes c returns v
  let code = char_code(c, 0)
  if (code >= 48) and (code <= 57) then
    return code - 48
  end
  if (code >= 97) and (code <= 102) then
    return (code - 97) + 10
  end
  if (code >= 65) and (code <= 70) then
    return (code - 65) + 10
  end
  return 0
end

make a function called json_hex_to_num takes hex returns n
  let n = 0
  let i = 0
  while i < hex.length do
    let n = (n * 16) + json_hex_val(hex[i])
    let i = i + 1
  end
  return n
end

make a function called json_skip_ws takes s, pos returns p
  let p = pos
  let scanning = true
  while scanning and (p < s.length) do
    let c = char_code(s, p)
    if (c == 32) or (c == 9) or (c == 10) or (c == 13) then
      let p = p + 1
    else
      let scanning = false
    end
  end
  return p
end

make a function called json_parse_string takes s, pos returns pair
  let b = sb_new()
  let p = pos + 1
  while s[p] != "\"" do
    let c = s[p]
    if c == "\\" then
      let e = s[p + 1]
      if e == "n" then
        sb_push(b, chr(10))
      end
      if e == "t" then
        sb_push(b, chr(9))
      end
      if e == "r" then
        sb_push(b, chr(13))
      end
      if e == "\"" then
        sb_push(b, "\"")
      end
      if e == "\\" then
        sb_push(b, "\\")
      end
      if e == "/" then
        sb_push(b, "/")
      end
      if e == "u" then
        sb_push(b, chr(json_hex_to_num(substr(s, p + 2, 4))))
        let p = p + 4
      end
      let p = p + 2
    else
      sb_push(b, c)
      let p = p + 1
    end
  end
  return [["str", sb_str(b)], p + 1]
end

make a function called json_parse_number takes s, pos returns pair
  let p = pos
  let start = pos
  if s[p] == "-" then
    let p = p + 1
  end
  while (p < s.length) and json_is_digit(s[p]) do
    let p = p + 1
  end
  if (p < s.length) and (s[p] == ".") then
    let p = p + 1
    while (p < s.length) and json_is_digit(s[p]) do
      let p = p + 1
    end
  end
  if (p < s.length) and ((s[p] == "e") or (s[p] == "E")) then
    let p = p + 1
    if (p < s.length) and ((s[p] == "+") or (s[p] == "-")) then
      let p = p + 1
    end
    while (p < s.length) and json_is_digit(s[p]) do
      let p = p + 1
    end
  end
  return [["num", to_num(substr(s, start, p - start))], p]
end

make a function called json_parse_array takes s, pos returns pair
  let p = json_skip_ws(s, pos + 1)
  let items = []
  if s[p] == "]" then
    return [["arr", items], p + 1]
  end
  let done = false
  while not done do
    let r = json_parse_value(s, p)
    let items = list_push(items, r[0])
    let p = json_skip_ws(s, r[1])
    if s[p] == "," then
      let p = json_skip_ws(s, p + 1)
    else
      let done = true
    end
  end
  return [["arr", items], p + 1]
end

make a function called json_parse_object takes s, pos returns pair
  let p = json_skip_ws(s, pos + 1)
  let pairs = []
  if s[p] == "}" then
    return [["obj", pairs], p + 1]
  end
  let done = false
  while not done do
    let p = json_skip_ws(s, p)
    let kr = json_parse_string(s, p)
    let key = kr[0][1]
    let p = json_skip_ws(s, kr[1])
    let p = json_skip_ws(s, p + 1)
    let vr = json_parse_value(s, p)
    let pairs = list_push(pairs, [key, vr[0]])
    let p = json_skip_ws(s, vr[1])
    if s[p] == "," then
      let p = json_skip_ws(s, p + 1)
    else
      let done = true
    end
  end
  return [["obj", pairs], p + 1]
end

make a function called json_parse_value takes s, pos returns pair
  let p = json_skip_ws(s, pos)
  let c = s[p]
  if c == "{" then
    return json_parse_object(s, p)
  end
  if c == "[" then
    return json_parse_array(s, p)
  end
  if c == "\"" then
    return json_parse_string(s, p)
  end
  if c == "t" then
    return [["bool", true], p + 4]
  end
  if c == "f" then
    return [["bool", false], p + 5]
  end
  if c == "n" then
    return [["null"], p + 4]
  end
  return json_parse_number(s, p)
end

make a function called json_parse takes s returns value
  let r = json_parse_value(s, 0)
  return r[0]
end

# ---- accessors ----
make a function called json_get takes obj, key returns value
  let pairs = obj[1]
  let i = 0
  while i < pairs.length do
    if pairs[i][0] == key then
      return pairs[i][1]
    end
    let i = i + 1
  end
  return ["null"]
end

make a function called json_str takes value returns s
  return value[1]
end

make a function called json_num takes value returns n
  return value[1]
end

make a function called json_arr takes value returns items
  return value[1]
end

# ---- encoding (just enough to build API request bodies) ----
make a function called json_escape takes s returns out
  let b = sb_new()
  let i = 0
  while i < s.length do
    let c = s[i]
    if c == "\"" then
      sb_push(b, "\\\"")
    else
      if c == "\\" then
        sb_push(b, "\\\\")
      else
        if char_code(s, i) == 10 then
          sb_push(b, "\\n")
        else
          if char_code(s, i) == 13 then
            sb_push(b, "\\r")
          else
            sb_push(b, c)
          end
        end
      end
    end
    let i = i + 1
  end
  return sb_str(b)
end

make a function called json_quote takes s returns out
  return "\"" + json_escape(s) + "\""
end

# ---- constructors (build tagged values without hand-rolling the
# internal ["str", s] / ["arr", items] / etc shape) ----
make a function called json_make_str takes s returns value
  return ["str", s]
end

make a function called json_make_num takes n returns value
  return ["num", n]
end

make a function called json_make_bool takes b returns value
  return ["bool", b]
end

make a function called json_make_null returns value
  return ["null"]
end

make a function called json_make_arr takes items returns value
  return ["arr", items]
end

make a function called json_make_obj takes pairs returns value
  return ["obj", pairs]
end

# ---- stringify (the reverse of json_parse) ----

make a function called json_stringify takes value returns s
  let tag = value[0]
  if tag == "str" then
    return json_quote(value[1])
  end
  if tag == "num" then
    return "" + value[1]
  end
  if tag == "bool" then
    if value[1] then
      return "true"
    end
    return "false"
  end
  if tag == "null" then
    return "null"
  end
  if tag == "arr" then
    let items = value[1]
    let b = sb_new()
    sb_push(b, "[")
    let i = 0
    while i < items.length do
      if i > 0 then
        sb_push(b, ",")
      end
      sb_push(b, json_stringify(items[i]))
      let i = i + 1
    end
    sb_push(b, "]")
    return sb_str(b)
  end
  if tag == "obj" then
    let pairs = value[1]
    let b = sb_new()
    sb_push(b, "{")
    let i = 0
    while i < pairs.length do
      if i > 0 then
        sb_push(b, ",")
      end
      sb_push(b, json_quote(pairs[i][0]))
      sb_push(b, ":")
      sb_push(b, json_stringify(pairs[i][1]))
      let i = i + 1
    end
    sb_push(b, "}")
    return sb_str(b)
  end
  return "null"
end

# Indented variant (matches the style git-diffable config files like
# site-manifest.json are usually kept in -- Python's json.dump(...,
# indent=2) equivalent). `depth` is the CURRENT nesting depth (pass 0
# from the top level); each level adds two spaces.
make a function called json_indent_spaces takes depth returns s
  let b = sb_new()
  let i = 0
  while i < depth do
    sb_push(b, "  ")
    let i = i + 1
  end
  return sb_str(b)
end

make a function called json_stringify_pretty takes value, depth returns s
  let tag = value[0]
  if tag == "arr" then
    let items = value[1]
    if items.length == 0 then
      return "[]"
    end
    let inner_indent = json_indent_spaces(depth + 1)
    let b = sb_new()
    sb_push(b, "[\n")
    let i = 0
    while i < items.length do
      sb_push(b, inner_indent)
      sb_push(b, json_stringify_pretty(items[i], depth + 1))
      if i < items.length - 1 then
        sb_push(b, ",")
      end
      sb_push(b, "\n")
      let i = i + 1
    end
    sb_push(b, json_indent_spaces(depth))
    sb_push(b, "]")
    return sb_str(b)
  end
  if tag == "obj" then
    let pairs = value[1]
    if pairs.length == 0 then
      return "{}"
    end
    let inner_indent = json_indent_spaces(depth + 1)
    let b = sb_new()
    sb_push(b, "{\n")
    let i = 0
    while i < pairs.length do
      sb_push(b, inner_indent)
      sb_push(b, json_quote(pairs[i][0]))
      sb_push(b, ": ")
      sb_push(b, json_stringify_pretty(pairs[i][1], depth + 1))
      if i < pairs.length - 1 then
        sb_push(b, ",")
      end
      sb_push(b, "\n")
      let i = i + 1
    end
    sb_push(b, json_indent_spaces(depth))
    sb_push(b, "}")
    return sb_str(b)
  end
  return json_stringify(value)
end
