# =============================================================================
# Lean 4 PEG grammar  (self_hosting/lib/lean.peg)
#
# This file is consumed by lib/peg.patlang's `peg_load` function as a
# VALIDATION GRAMMAR.  It accepts/rejects a Lean 4 token stream at the
# structural level; AST construction is done by the hand-written recursive-
# descent parser in lean_parser.patlang.
#
# Token types produced by lean_lexer.patlang and referenced here:
#   KEYWORD  -- reserved words (import, def, theorem, …)
#   IDENT    -- identifiers (including Unicode)
#   NUM      -- numeric literals
#   STR      -- string literals
#   OP       -- punctuation / operator tokens
#   DOC_COMMENT LINE_COMMENT BLOCK_COMMENT
#   NL       -- newlines (significant in places)
#   EOF
#
# Conventions (mirrors peg.patlang's own .peg format):
#   Rule   <- Alternative1 / Alternative2
#   Seq    item1 item2
#   "lit"  -- literal text (KEYWORD or OP depending on alpha/non-alpha)
#   ?      zero-or-one
#   *      zero-or-more
#   +      one-or-more
#   &      positive lookahead
#   !      negative lookahead
# =============================================================================

# ---- Top level ----

File          <- Skip* Command* EOF

Command       <- DocComment / HashCmd / SetOptionCmd / OpenCmd / ImportCmd
               / NamespaceCmd / SectionCmd / NoncomputableSection
               / AttrBlock Command
               / Modifiers DefLike
               / LineComment / BlockComment

# ---- Comments / whitespace ----

Skip          <- LineComment / BlockComment / NL

LineComment   <- "LINE_COMMENT"
BlockComment  <- "BLOCK_COMMENT"
DocComment    <- "DOC_COMMENT"

# ---- Import ----

ImportCmd     <- "import" ModulePath NL?

ModulePath    <- NamePart ("." NamePart)*
NamePart      <- "IDENT" / "NUM"

# ---- set_option ----

SetOptionCmd  <- "set_option" QualIdent OptionVal NL?

OptionVal     <- "NUM" / "STR" / "IDENT" / "true" / "false"

# ---- open ----

OpenCmd       <- "open" "scoped"? IdentList NL?
              / "open" QualIdent "in" Command

IdentList     <- QualIdent ("," QualIdent)*

# ---- namespace / section ----

NamespaceCmd  <- "namespace" QualIdent Skip* Command* "end" QualIdent? NL?

SectionCmd    <- "section" QualIdent? Skip* Command* "end" QualIdent? NL?

NoncomputableSection <- "noncomputable" "section" Skip* Command* "end" NL?

# ---- Modifiers ----

Modifiers     <- Modifier*

Modifier      <- "noncomputable" / "private" / "protected" / "partial"
               / "unsafe" / "mutual" / AttrBlock

AttrBlock     <- "@[" AttrList "]"

AttrList      <- Attr ("," Attr)*

Attr          <- QualIdent AttrArgs?

AttrArgs      <- "(" Expr ")"

# ---- Hash commands ----

HashCmd       <- HashKw Expr? NL?

HashKw        <- "#check" / "#eval" / "#print" / "#check_failure"
               / "#reduce" / "#assert" / "#norm_num" / "#simp"
               / "KEYWORD"

# ---- Definition-like commands ----

DefLike       <- DefCmd / TheoremCmd / LemmaCmd / AbbrevCmd
               / StructureCmd / ClassCmd / InstanceCmd
               / InductiveCmd / MutualCmd / ExampleCmd

DefCmd        <- "def" DefHead ":=" DefBody

TheoremCmd    <- ("theorem" / "lemma") DefHead ":=" TacticOrExpr

LemmaCmd      <- "lemma" DefHead ":=" TacticOrExpr

AbbrevCmd     <- "abbrev" DefHead ":=" Expr

InductiveCmd  <- "inductive" QualIdent TypeParams? ":" Expr "where" Skip* Ctor*

Ctor          <- "|" QualIdent ":" Expr NL?

MutualCmd     <- "mutual" Skip* DefLike* "end"

ExampleCmd    <- "example" TypeParams? (":" Expr)? ":=" TacticOrExpr

DefHead       <- QualIdent UnivParams? TypeParams? (":" Expr)?

UnivParams    <- ".{" IdentList "}"

TypeParams    <- Binder+

DefBody       <- TacticOrExpr WhereClauses?

WhereClauses  <- "where" Skip* DefLike+

# ---- Structure / Class ----

StructureCmd  <- "structure" QualIdent TypeParams? ("extends" IdentList)?
                 (":" Expr)? ("where" Skip* StructFields?)? Skip*

ClassCmd      <- "class" QualIdent TypeParams? ("extends" IdentList)?
                 (":" Expr)? ("where" Skip* StructFields?)? Skip*

InstanceCmd   <- "instance" QualIdent? TypeParams? (":" Expr)? ":=" TacticOrExpr
               / "instance" QualIdent? TypeParams? (":" Expr)? "where" Skip* StructFields?

StructFields  <- StructField+

StructField   <- QualIdent TypeParams? ":" Expr (":=" Expr)? NL?

# ---- Binders ----

Binder        <- ExplicitBinder / ImplicitBinder / StrictBinder / InstBinder
               / NamedBinder

ExplicitBinder <- "(" BinderNames ":" Expr ")"
               / "(" BinderNames ":" Expr ":=" Expr ")"

ImplicitBinder <- "{" BinderNames ":" Expr "}"

StrictBinder   <- "{{" BinderNames ":" Expr "}}"

InstBinder     <- "[" (QualIdent ":")? Expr "]"

NamedBinder    <- "(" QualIdent ")"

BinderNames    <- BinderName+

BinderName     <- QualIdent / "_"

# ---- Expressions ----

TacticOrExpr  <- "by" TacticBlock / Expr

Expr          <- LetExpr / HaveExpr / ShowExpr / FunExpr / LambdaExpr
               / ForallExpr / MatchExpr / IfExpr / CalcExpr
               / DoExpr / AnonymousCtorExpr
               / TypeAscExpr

TypeAscExpr   <- AppExpr (":" Expr)?

AppExpr       <- Atom Argument*

Argument      <- NamedArg / InstArg / Atom

NamedArg      <- "(" QualIdent ":=" Expr ")"

InstArg       <- "[" Expr "]"

Atom          <- "(" Expr ")" / AngleBracket / StructLit / StructUpdate
               / Subst / Projection / "·" / "_" / "@" QualIdent
               / "by" TacticBlock / Literal / QualIdent

Literal       <- "NUM" / "STR" / "true" / "false"

AngleBracket  <- "⟨" (Expr ("," Expr)*)? "⟩"
               / "<|" (Expr ("," Expr)*)? "|>"

StructLit     <- "{" (StructAssign ("," StructAssign)*)? "}"
               / "{" QualIdent "with" (StructAssign ("," StructAssign)*)? "}"

StructAssign  <- QualIdent ":=" Expr
               / QualIdent

StructUpdate  <- "{ " Expr " with" (StructAssign ("," StructAssign)*)? "}"

Subst         <- "▸"

Projection    <- Atom "." (QualIdent / "NUM")

LetExpr       <- "let" LetBinder (":=" / "<-") Expr NL? Expr

HaveExpr      <- "have" (QualIdent ":")? Expr ":=" TacticOrExpr NL? Expr

ShowExpr      <- "show" Expr (":=" / "from") TacticOrExpr

FunExpr       <- "fun" FunBinder+ "=>" Expr

LambdaExpr    <- "fun" FunBinder+ "=>" Expr

ForallExpr    <- ("∀" / "forall") Binder+ "," Expr

MatchExpr     <- "match" Expr ("," Expr)* (":" Expr)? "with" Skip*
                 MatchArm+

MatchArm      <- "|" Pattern+ ("," Pattern)* "=>" Expr NL?

Pattern       <- PatLit / PatCtor / PatWild / PatVar / PatStruct
               / "(" Pattern ")"

PatLit        <- Literal

PatCtor       <- QualIdent ("(" Pattern ("," Pattern)* ")")?

PatWild       <- "_"

PatVar        <- QualIdent

PatStruct     <- "{" (StructPatField ("," StructPatField)*)? "}"

StructPatField <- QualIdent (":=" Pattern)?

IfExpr        <- "if" (QualIdent ":" )? Expr "then" Expr "else" Expr

CalcExpr      <- "calc" CalcStep+

CalcStep      <- Expr CalcOp Expr NL? ("_" CalcOp Expr NL?)*

CalcOp        <- "=" / "≤" / "≥" / "<" / ">" / "≠" / "|" / "∣"
               / "≡" / "↔" / "_"

DoExpr        <- "do" Skip* DoStmt+

DoStmt        <- "let" LetBinder "<-" Expr NL?
               / "let" LetBinder ":=" Expr NL?
               / QualIdent "<-" Expr NL?
               / "return" Expr NL?
               / "if" Expr "then" Skip* DoStmt+ ("else" Skip* DoStmt+)? NL?
               / "for" QualIdent "in" Expr "do" Skip* DoStmt+ NL?
               / Expr NL?

AnonymousCtorExpr <- "⟨" (Expr ("," Expr)*)? "⟩"

LetBinder     <- QualIdent (":" Expr)?
               / "(" BinderNames ":" Expr ")"
               / "_"

FunBinder     <- ExplicitBinder / ImplicitBinder / StrictBinder / InstBinder
               / QualIdent / "(" QualIdent ":" Expr ")" / "_"

# ---- Identifiers ----

QualIdent     <- NamePart ("." NamePart)*
               / "«" "IDENT" "»"

# ---- Tactic block ----

TacticBlock   <- Skip* Tactic (Skip* Tactic)*

Tactic        <- FocusTactic / AllGoalsTactic / TacticCombinator
               / SimpleTactic

FocusTactic   <- "·" Skip* Tactic (Skip* Tactic)*

AllGoalsTactic <- "all_goals" Tactic

TacticCombinator <- Tactic "<;>" Tactic
               / "first" TacticBar+
               / "try" Tactic
               / "repeat" Tactic
               / "iterate" "NUM" Tactic
               / "(" Tactic (";" Tactic)* ")"
               / "case" QualIdent+ "=>" Skip* Tactic+

TacticBar      <- "|" Tactic

SimpleTactic  <- "apply" Expr
               / "exact" Expr
               / "refine" Expr
               / "intro" IntroPatterns
               / "intros" IntroPatterns?
               / "rintro" IntroPatterns
               / "simp" SimpArgs?
               / "simp_all" SimpArgs?
               / "ring"
               / "ring_nf" SimpArgs?
               / "norm_num" SimpArgs?
               / "linarith" SimpArgs?
               / "nlinarith" SimpArgs?
               / "positivity"
               / "aesop" SimpArgs?
               / "decide"
               / "native_decide"
               / "rfl"
               / "assumption"
               / "contradiction"
               / "trivial"
               / "sorry"
               / "skip"
               / "done"
               / "rw" "[" RwList "]" ("at" RwTarget)?
               / "rewrite" "[" RwList "]" ("at" RwTarget)?
               / "unfold" QualIdent+ ("at" RwTarget)?
               / "have" HaveDecl
               / "obtain" Pattern? (":" Expr)? ":=" Expr
               / "rcases" Expr "with" Pattern
               / "use" Expr ("," Expr)*
               / "constructor"
               / "left"
               / "right"
               / "cases" Expr ("with" Skip* TacticBar+)?
               / "induction" Expr ("with" Skip* TacticBar+)?
               / "generalize" Expr "=" QualIdent
               / "specialize" Expr
               / "push_neg" ("at" RwTarget)?
               / "contrapose" "!"?
               / "exfalso"
               / "absurd" Expr Expr
               / "norm_cast" ("at" RwTarget)?
               / "push_cast" SimpArgs?
               / "field_simp" SimpArgs?
               / "conv" ConvBlock?
               / "show" Expr
               / "suffices" (QualIdent ":")? Expr "by" TacticBlock
               / "calc" CalcStep+
               / "exact?" / "apply?" / "rw?" / "simp?"
               / "omega"
               / "fin_cases" QualIdent?
               / "interval_cases" QualIdent?
               / "lift" QualIdent "to" Expr ("using" Expr)?
               / "ext" IntroPatterns?
               / "funext" IntroPatterns?
               / "congr" "NUM"?
               / "gcongr" SimpArgs?
               / "trans" Expr?
               / "symm"
               / "ac_rfl"
               / "map_tac" QualIdent
               / Expr

IntroPatterns <- IntroPattern+

IntroPattern  <- QualIdent / "_" / "-" / "⟨" IntroPattern ("," IntroPattern)* "⟩"
               / "(" IntroPattern ("," IntroPattern)* ")"

SimpArgs      <- "[" SimpLemma ("," SimpLemma)* "]" ("at" RwTarget)?
               / "only" "[" SimpLemma ("," SimpLemma)* "]" ("at" RwTarget)?
               / "at" RwTarget

SimpLemma     <- "←"? QualIdent / Expr / "-" QualIdent / "*"

RwList        <- RwItem ("," RwItem)*

RwItem        <- "←"? Expr

RwTarget      <- "⊢" / "*" / QualIdent ("," QualIdent)*

HaveDecl      <- (QualIdent ":")? Expr (":=" TacticOrExpr)? ("by" TacticBlock)?

ConvBlock     <- "=>" Skip* ConvTactic+

ConvTactic    <- "ext" QualIdent / "rw" "[" RwList "]" / "simp" SimpArgs?
               / "ring_nf" / "norm_num" / "push_cast" / "pull_cast"
               / "lhs" / "rhs" / "arg" "NUM"? / "congr"
               / "skip"
