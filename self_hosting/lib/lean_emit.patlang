  end

  if kind == "type_asc" then
    return "(" + lean_emit_node(node[1], depth) + " : " + lean_emit_node(node[2], depth) + ")"
  end

  if kind == "named_arg" then
    return "(" + node[1] + " := " + lean_emit_node(node[2], depth) + ")"
  end

  if kind == "field" then
    return lean_emit_node(node[1], depth) + "." + node[2]
  end

  if kind == "do" then
    let b = sb_new()
    sb_push(b, "do\n")
    let stmts = node[1]
    let i = 0
    while i < stmts.length do
      sb_push(b, lean_indent(depth + 1))
      sb_push(b, lean_emit_node(stmts[i], depth + 1))
      sb_push(b, "\n")
      let i = i + 1
    end
    return sb_str(b)
  end

  if kind == "where_clause" then
    let b = sb_new()
    sb_push(b, "where\n")
    let sub = node[1]
    let i = 0
    while i < sub.length do
      sb_push(b, lean_indent(depth + 1))
      sb_push(b, lean_emit_node(sub[i], depth + 1))
      sb_push(b, "\n")
      let i = i + 1
    end
    return sb_str(b)
  end

  # Tactic nodes
  if (kind == "tactic") or (kind == "tactic_block") or (kind == "tactic_focus") then
    return lean_emit_tactic(node, depth)
  end

  # Fallback
  return "(?lean_emit kind=" + kind + ")"
end

# Top-level API: emit a Lean 4 file AST to a string.
make a function called lean_emit takes ast returns s
  return lean_emit_node(ast, 0)
end
