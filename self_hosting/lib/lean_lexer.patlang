# =============================================================================
# Lean 4 Lexer  (self_hosting/lib/lean_lexer.patlang)
#
# Tokenises a Lean 4 source string into a vector of token lists:
#   [type, text, line]
#
# Token types:
#   KEYWORD       -- reserved words (import, def, theorem, by, …)
#   IDENT         -- identifiers (including Unicode)
#   NUM           -- numeric literals (decimal, hex, float)
#   STR           -- string / interpolated-string literals
#   CHAR          -- character literals c'x'
#   OP            -- punctuation and operator tokens
#   DOC_COMMENT   -- /-- … -/  doc comments
#   LINE_COMMENT  -- -- …  to end-of-line
#   BLOCK_COMMENT -- /- … -/  (nested) block comments
#   NL            -- newline (significant for indentation-sensitive rules)
#   EOF           -- sentinel at end of stream
#
# Depends on: lib/utf8.patlang  (utf8_next, utf8_is_ident_start,
#              utf8_is_ident_part, utf8_is_digit, utf8_is_ws)
# Include order: utf8.patlang THEN lean_lexer.patlang.
# =============================================================================

# Keywords that are reserved in Lean 4 (non-exhaustive but covers the full
# language surface including Mathlib-heavy notation).
make a function called lean_is_keyword takes w returns r
  if w == "import" then return true end
  if w == "namespace" then return true end
  if w == "section" then return true end
  if w == "end" then return true end
  if w == "open" then return true end
  if w == "scoped" then return true end
  if w == "set_option" then return true end
  if w == "def" then return true end
  if w == "noncomputable" then return true end
  if w == "theorem" then return true end
  if w == "lemma" then return true end
  if w == "abbrev" then return true end
  if w == "structure" then return true end
  if w == "class" then return true end
  if w == "instance" then return true end
  if w == "inductive" then return true end
  if w == "mutual" then return true end
  if w == "where" then return true end
  if w == "with" then return true end
  if w == "extends" then return true end
  if w == "by" then return true end
  if w == "fun" then return true end
  if w == "let" then return true end
  if w == "have" then return true end
  if w == "show" then return true end
  if w == "from" then return true end
  if w == "return" then return true end
  if w == "do" then return true end
  if w == "if" then return true end
  if w == "then" then return true end
  if w == "else" then return true end
  if w == "match" then return true end
  if w == "forall" then return true end
  if w == "in" then return true end
  if w == "calc" then return true end
  if w == "Type" then return true end
  if w == "Sort" then return true end
  if w == "Prop" then return true end
  if w == "true" then return true end
  if w == "false" then return true end
  if w == "deriving" then return true end
  if w == "private" then return true end
  if w == "protected" then return true end
  if w == "partial" then return true end
  if w == "unsafe" then return true end
  if w == "opaque" then return true end
  if w == "example" then return true end
  if w == "variable" then return true end
  if w == "universe" then return true end
  if w == "axiom" then return true end
  if w == "constant" then return true end
  if w == "notation" then return true end
  if w == "macro_rules" then return true end
  if w == "syntax" then return true end
  if w == "macro" then return true end
  if w == "elab" then return true end
  if w == "attribute" then return true end
  if w == "export" then return true end
  if w == "suffices" then return true end
  if w == "obtain" then return true end
  if w == "rcases" then return true end
  if w == "use" then return true end
  if w == "apply" then return true end
  if w == "exact" then return true end
  if w == "refine" then return true end
  if w == "intro" then return true end
  if w == "intros" then return true end
  if w == "rintro" then return true end
  if w == "simp" then return true end
  if w == "ring" then return true end
  if w == "norm_num" then return true end
  if w == "linarith" then return true end
  if w == "nlinarith" then return true end
  if w == "positivity" then return true end
  if w == "aesop" then return true end
  if w == "decide" then return true end
  if w == "native_decide" then return true end
  if w == "rfl" then return true end
  if w == "assumption" then return true end
  if w == "contradiction" then return true end
  if w == "trivial" then return true end
  if w == "sorry" then return true end
  if w == "constructor" then return true end
  if w == "left" then return true end
  if w == "right" then return true end
  if w == "cases" then return true end
  if w == "induction" then return true end
  if w == "rw" then return true end
  if w == "rewrite" then return true end
  if w == "unfold" then return true end
  if w == "push_neg" then return true end
  if w == "contrapose" then return true end
  if w == "exfalso" then return true end
  if w == "absurd" then return true end
  if w == "norm_cast" then return true end
  if w == "push_cast" then return true end
  if w == "field_simp" then return true end
  if w == "conv" then return true end
  if w == "omega" then return true end
  if w == "ext" then return true end
  if w == "funext" then return true end
  if w == "congr" then return true end
  if w == "gcongr" then return true end
  if w == "trans" then return true end
  if w == "symm" then return true end
  if w == "ac_rfl" then return true end
  if w == "simp_all" then return true end
  if w == "ring_nf" then return true end
  if w == "all_goals" then return true end
  if w == "try" then return true end
  if w == "repeat" then return true end
  if w == "first" then return true end
  if w == "skip" then return true end
  if w == "done" then return true end
  if w == "case" then return true end
  if w == "focus" then return true end
  if w == "specialize" then return true end
  if w == "generalize" then return true end
  if w == "lift" then return true end
  if w == "fin_cases" then return true end
  if w == "interval_cases" then return true end
  if w == "push_neg" then return true end
  if w == "iterate" then return true end
  return false
end

# Read one identifier/keyword starting at byte offset i in src (via h).
# Returns [text, next_i].
make a function called lean_lex_ident takes h, src, i, n returns pair
  let b = sb_new()
  let pos = i
  let going = true
  while going and (pos < n) do
    let decoded = utf8_next(src, pos)
    let cp = decoded[0]
    let np = decoded[1]
    if pos == i then
      if utf8_is_ident_start(cp) then
        sb_push(b, substr(src, pos, np - pos))
        let pos = np
      else
        let going = false
      end
    else
      if utf8_is_ident_part(cp) then
        sb_push(b, substr(src, pos, np - pos))
        let pos = np
      else
        let going = false
      end
    end
  end
  return [sb_str(b), pos]
end

# Read a numeric literal (decimal / hex / binary / float) starting at i.
# Returns [text, next_i].
make a function called lean_lex_number takes src, i, n returns pair
  let b = sb_new()
  let pos = i
  # hex: 0x...
  if (char_code(src, pos) == 48) and (pos + 1 < n) then
    let next_c = char_code(src, pos + 1)
    if (next_c == 120) or (next_c == 88) then
      sb_push(b, "0")
      sb_push(b, src[pos + 1])
      let pos = pos + 2
      while (pos < n) and (lean_is_hex_digit(char_code(src, pos))) do
        sb_push(b, src[pos])
        let pos = pos + 1
      end
      return [sb_str(b), pos]
    end
    # binary: 0b...
    if (next_c == 98) or (next_c == 66) then
      sb_push(b, "0")
      sb_push(b, src[pos + 1])
      let pos = pos + 2
      while (pos < n) and ((char_code(src, pos) == 48) or (char_code(src, pos) == 49)) do
        sb_push(b, src[pos])
        let pos = pos + 1
      end
      return [sb_str(b), pos]
    end
  end
  # decimal
  while (pos < n) and utf8_is_digit(char_code(src, pos)) do
    sb_push(b, src[pos])
    let pos = pos + 1
  end
  # fractional part
  if (pos < n) and (char_code(src, pos) == 46) and (pos + 1 < n) and utf8_is_digit(char_code(src, pos + 1)) then
    sb_push(b, ".")
    let pos = pos + 1
    while (pos < n) and utf8_is_digit(char_code(src, pos)) do
      sb_push(b, src[pos])
      let pos = pos + 1
    end
  end
  # exponent
  if (pos < n) and ((char_code(src, pos) == 101) or (char_code(src, pos) == 69)) then
    sb_push(b, src[pos])
    let pos = pos + 1
    if (pos < n) and ((char_code(src, pos) == 43) or (char_code(src, pos) == 45)) then
      sb_push(b, src[pos])
      let pos = pos + 1
    end
    while (pos < n) and utf8_is_digit(char_code(src, pos)) do
      sb_push(b, src[pos])
      let pos = pos + 1
    end
  end
  return [sb_str(b), pos]
end

make a function called lean_is_hex_digit takes c returns r
  if (c >= 48) and (c <= 57) then return true end
  if (c >= 65) and (c <= 70) then return true end
  if (c >= 97) and (c <= 102) then return true end
  return false
end

# Read a double-quoted string literal (with escape sequences).
# Returns [text_including_quotes, next_i].
make a function called lean_lex_string takes src, i, n returns pair
  let b = sb_new()
  sb_push(b, "\"")
  let pos = i + 1
  while (pos < n) and (char_code(src, pos) != 34) do
    let c = char_code(src, pos)
    if c == 92 then
      sb_push(b, "\\")
      let pos = pos + 1
      if pos < n then
        sb_push(b, src[pos])
        let pos = pos + 1
      end
    else
      if c == 10 then
        sb_push(b, "\\n")
        let pos = pos + 1
      else
        sb_push(b, src[pos])
        let pos = pos + 1
      end
    end
  end
  sb_push(b, "\"")
  return [sb_str(b), pos + 1]
end

# Read a block comment /- … -/ with proper nesting.
# Returns [comment_text, next_i, is_doc].
# is_doc is true for /-- … -/ doc comments.
make a function called lean_lex_block_comment takes src, i, n returns triple
  # check for doc comment /--
  let is_doc = false
  if (i + 2 < n) and (char_code(src, i + 2) == 45) then
    let is_doc = true
  end
  let b = sb_new()
  let depth = 1
  let pos = i + 2
  sb_push(b, "/-")
  while (pos < n) and (depth > 0) do
    let c = char_code(src, pos)
    if (c == 47) and (pos + 1 < n) and (char_code(src, pos + 1) == 45) then
      sb_push(b, "/-")
      let depth = depth + 1
      let pos = pos + 2
    else
      if (c == 45) and (pos + 1 < n) and (char_code(src, pos + 1) == 47) then
        sb_push(b, "-/")
        let depth = depth - 1
        let pos = pos + 2
      else
        sb_push(b, src[pos])
        let pos = pos + 1
      end
    end
  end
  return [sb_str(b), pos, is_doc]
end

# Determine the token type for a multi-char Unicode operator given its first
# codepoint.  Returns "" if the codepoint is not a recognised Unicode op.
make a function called lean_unicode_op_text takes cp returns s
  if cp == 8592 then return "\xe2\x86\x90" end
  if cp == 8594 then return "\xe2\x86\x92" end
  if cp == 8614 then return "\xe2\x86\xa6" end
  if cp == 8658 then return "\xe2\x87\x92" end
  if cp == 8660 then return "\xe2\x87\x94" end
  if cp == 10216 then return "\xe2\x9f\xa8" end
  if cp == 10217 then return "\xe2\x9f\xa9" end
  if cp == 8214 then return "\xe2\x80\x96" end
  if cp == 183 then return "\xc2\xb7" end
  if cp == 8901 then return "\xe2\x8b\x85" end
  if cp == 8704 then return "\xe2\x88\x80" end
  if cp == 8707 then return "\xe2\x88\x83" end
  if cp == 955 then return "\xce\xbb" end
  if cp == 8743 then return "\xe2\x88\xa7" end
  if cp == 8744 then return "\xe2\x88\xa8" end
  if cp == 172 then return "\xc2\xac" end
  if cp == 8804 then return "\xe2\x89\xa4" end
  if cp == 8805 then return "\xe2\x89\xa5" end
  if cp == 8800 then return "\xe2\x89\xa0" end
  if cp == 8801 then return "\xe2\x89\xa1" end
  if cp == 8866 then return "\xe2\x8a\xa2" end
  if cp == 8868 then return "\xe2\x8a\xa4" end
  if cp == 8869 then return "\xe2\x8a\xa5" end
  if cp == 8838 then return "\xe2\x8a\x86" end
  if cp == 8839 then return "\xe2\x8a\x87" end
  if cp == 8834 then return "\xe2\x8a\x82" end
  if cp == 8835 then return "\xe2\x8a\x83" end
  if cp == 8846 then return "\xe2\x8a\x8e" end
  if cp == 8745 then return "\xe2\x88\xa9" end
  if cp == 8746 then return "\xe2\x88\xaa" end
  if cp == 9655 then return "\xe2\x96\xb7" end
  if cp == 9665 then return "\xe2\x96\xb1" end
  if cp == 10232 then return "\xe2\x9f\xb8" end
  if cp == 10233 then return "\xe2\x9f\xb9" end
  if cp == 10234 then return "\xe2\x9f\xba" end
  if cp == 8857 then return "\xe2\x8a\x99" end
  if cp == 8853 then return "\xe2\x8a\x95" end
  if cp == 8729 then return "\xe2\x88\x99" end
  if cp == 9633 then return "\xe2\x96\xa1" end
  return ""
end

# Main tokeniser.  Returns a vector of [type, text, line] triples.
make a function called lean_tokenize takes src returns toks
  let toks = vec_new()
  let n = src.length
  let i = 0
  let line = 1
  while i < n do
    let b0 = char_code(src, i)
    # Newline
    if b0 == 10 then
      vec_push(toks, ["NL", "\n", line])
      let line = line + 1
      let i = i + 1
    else
      # Carriage return (ignore or treat as part of CRLF)
      if b0 == 13 then
        let i = i + 1
      else
        # Whitespace (not newline)
        if utf8_is_ws(b0) and (b0 != 10) then
          let i = i + 1
        else
          # -- line comment
          if (b0 == 45) and (i + 1 < n) and (char_code(src, i + 1) == 45) then
            let b = sb_new()
            while (i < n) and (char_code(src, i) != 10) do
              sb_push(b, src[i])
              let i = i + 1
            end
            vec_push(toks, ["LINE_COMMENT", sb_str(b), line])
          else
            # /- block or doc comment
            if (b0 == 47) and (i + 1 < n) and (char_code(src, i + 1) == 45) then
              let triple = lean_lex_block_comment(src, i, n)
              let text = triple[0]
              let next_i = triple[1]
              let is_doc = triple[2]
              if is_doc then
                vec_push(toks, ["DOC_COMMENT", text, line])
              else
                vec_push(toks, ["BLOCK_COMMENT", text, line])
              end
              # Update line count for newlines inside the comment
              let ci = i
              while ci < next_i do
                if char_code(src, ci) == 10 then
                  let line = line + 1
                end
                let ci = ci + 1
              end
              let i = next_i
            else
              # #cmd (hash commands)
              if b0 == 35 then
                let b = sb_new()
                sb_push(b, "#")
                let pos = i + 1
                while (pos < n) and utf8_is_ident_part(char_code(src, pos)) do
                  sb_push(b, src[pos])
                  let pos = pos + 1
                end
                vec_push(toks, ["KEYWORD", sb_str(b), line])
                let i = pos
              else
                # Interpolated string s!"..."
                if (b0 == 115) and (i + 1 < n) and (char_code(src, i + 1) == 33) and (i + 2 < n) and (char_code(src, i + 2) == 34) then
                  let pair = lean_lex_string(src, i + 1, n)
                  vec_push(toks, ["STR", "s!" + pair[0], line])
                  let i = pair[1]
                else
                  # Regular string
                  if b0 == 34 then
                    let pair = lean_lex_string(src, i, n)
                    vec_push(toks, ["STR", pair[0], line])
                    let i = pair[1]
                  else
                    # Char literal c'x'
                    if (b0 == 99) and (i + 1 < n) and (char_code(src, i + 1) == 39) then
                      let b = sb_new()
                      sb_push(b, "c'")
                      let pos = i + 2
                      while (pos < n) and (char_code(src, pos) != 39) do
                        sb_push(b, src[pos])
                        let pos = pos + 1
                      end
                      sb_push(b, "'")
                      vec_push(toks, ["CHAR", sb_str(b), line])
                      let i = pos + 1
                    else
                      # Numeric literal
                      if utf8_is_digit(b0) then
                        let pair = lean_lex_number(src, i, n)
                        vec_push(toks, ["NUM", pair[0], line])
                        let i = pair[1]
                      else
                        # Identifiers and keywords
                        if utf8_is_ident_start(b0) then
                          let h = str_intern(src)
                          let pair = lean_lex_ident(h, src, i, n)
                          let text = pair[0]
                          let next_i = pair[1]
                          if lean_is_keyword(text) then
                            vec_push(toks, ["KEYWORD", text, line])
                          else
                            vec_push(toks, ["IDENT", text, line])
                          end
                          let i = next_i
                        else
                          # Unicode identifiers and operators
                          if b0 >= 128 then
                            let decoded = utf8_next(src, i)
                            let cp = decoded[0]
                            # Unicode operator single-codepoint?
                            let op_text = lean_unicode_op_text(cp)
                            if op_text != "" then
                              vec_push(toks, ["OP", op_text, line])
                              let i = decoded[1]
                            else
                              # Unicode identifier
                              if utf8_is_ident_start(cp) then
                                let h = str_intern(src)
                                let pair = lean_lex_ident(h, src, i, n)
                                let text = pair[0]
                                let next_i = pair[1]
                                vec_push(toks, ["IDENT", text, line])
                                let i = next_i
                              else
                                # Unknown Unicode – emit as UNK
                                vec_push(toks, ["UNK", substr(src, i, decoded[1] - i), line])
                                let i = decoded[1]
                              end
                            end
                          else
                            # ASCII operator / punctuation
                            let op = lean_lex_op(src, i, n)
                            vec_push(toks, ["OP", op[0], line])
                            let i = op[1]
                          end
                        end
                      end
                    end
                  end
                end
              end
            end
          end
        end
      end
    end
  end
  vec_push(toks, ["EOF", "", line])
  return toks
end

# Lex a multi-character ASCII operator starting at i.
# Returns [text, next_i].
make a function called lean_lex_op takes src, i, n returns pair
  let c0 = char_code(src, i)
  # Try 3-char ops first
  if i + 2 < n then
    let s3 = substr(src, i, 3)
    if (s3 == "<;>") or (s3 == "...") or (s3 == "«--") or (s3 == "-->") then
      return [s3, i + 3]
    end
  end
  # 2-char ops
  if i + 1 < n then
    let s2 = substr(src, i, 2)
    if s2 == ":=" then return [s2, i + 2] end
    if s2 == "::" then return [s2, i + 2] end
    if s2 == "=>" then return [s2, i + 2] end
    if s2 == "<-" then return [s2, i + 2] end
    if s2 == "->" then return [s2, i + 2] end
    if s2 == "|>" then return [s2, i + 2] end
    if s2 == "<|" then return [s2, i + 2] end
    if s2 == ">>" then return [s2, i + 2] end
    if s2 == "<<" then return [s2, i + 2] end
    if s2 == "&&" then return [s2, i + 2] end
    if s2 == "||" then return [s2, i + 2] end
    if s2 == ">=" then return [s2, i + 2] end
    if s2 == "<=" then return [s2, i + 2] end
    if s2 == "!=" then return [s2, i + 2] end
    if s2 == "==" then return [s2, i + 2] end
    if s2 == "++" then return [s2, i + 2] end
    if s2 == "**" then return [s2, i + 2] end
    if s2 == ":>" then return [s2, i + 2] end
    if s2 == ".." then return [s2, i + 2] end
    if s2 == "?." then return [s2, i + 2] end
    if s2 == "@[" then return [s2, i + 2] end
    if s2 == "{{" then return [s2, i + 2] end
    if s2 == "}}" then return [s2, i + 2] end
    if s2 == "«-" then return [s2, i + 2] end
  end
  # 1-char
  return [src[i], i + 1]
end
