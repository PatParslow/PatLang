# PatLang -> Triton kernel lowering (Slice 2).
#
# Takes the SOURCE TEXT of an ordinary PatLang function (no new grammar --
# a kernel is just a ["Func", name, params, body] AST node produced by the
# existing lexer.patlang/parser.patlang, same as any other function) and
# walks it to emit real @triton.jit Python source, replacing Slice 1's
# fixed hand-written kernel text. Deliberately reuses the existing frontend
# rather than inventing a `kernel` keyword: a new keyword would ripple into
# lexer/parser/lower/codegen AND their Rust mirror (runtime_rs.patlang) AND
# the language-spec BDD gate (CLAUDE.md S3) -- far more than this slice
# needs. Restricting what a *kernel-shaped function* may contain is a
# library-level concern, not a core-language one.
#
# Supported kernel-body subset (checked; anything else is a clear rejection,
# never a silent miscompile):
#   - scalar/list params (lowered to pointer args + a length/constexpr arg)
#   - arithmetic/comparison Bin ops, unary '-'/'not'
#   - If/elif (no 'else if' nesting per this repo's own control-flow rule)
#     lowered to tl.where / masked select
#   - counted While loops lowered to a Triton-style accumulator loop
#     (the shape reductions and matmul's K-loop need)
#   - Index reads/writes against a kernel param, lowered to tl.load/tl.store
#     with the standard offs/mask pattern
#   - a fixed math-function allowlist (exp/log/sqrt/sigmoid/abs/max/min)
#     mapped 1:1 onto tl.* / libdevice equivalents
#   - reduction calls (sum/max/min/argmax/argmin) over a block, mapped to
#     tl.sum/tl.max/tl.min/tl.argmax/tl.argmin
#   - atomic_add/atomic_max/atomic_min mapped to tl.atomic_*
# NOT supported (rejected): print/string ops, list/struct mutation other
# than the param buffers, closures, recursion, calls to non-kernel
# functions, multi-dim grids beyond program_id(0) (deferred -- see slice
# scope note in triton.patlang).
#
# Implicit block-scope variables: every kernel body is wrapped in the
# same pid/offs/mask/n/BLOCK_SIZE preamble Slice 1 already hand-wrote, so
# kernel PatLang source may reference `offs`, `mask`, `n` as plain bare
# Vars (they lower to themselves, unchanged) -- e.g. an elementwise-add
# kernel body is just `store(out, offs, x[offs] + y[offs])`. This mirrors
# real Triton kernels, which are also written in terms of a block offset
# + mask rather than a per-element loop.

include "lexer.patlang"
include "parser.patlang"

make a function called triton_math_fn_map takes name returns pyname
  if name == "exp" then
    return "tl.exp"
  elif name == "log" then
    return "tl.log"
  elif name == "sqrt" then
    return "tl.sqrt"
  elif name == "sigmoid" then
    return "tl.sigmoid"
  elif name == "abs" then
    return "tl.abs"
  elif name == "max" then
    return "tl.maximum"
  elif name == "min" then
    return "tl.minimum"
  else
    return ""
  end
end

make a function called triton_reduce_fn_map takes name returns pyname
  if name == "sum" then
    return "tl.sum"
  elif name == "reduce_max" then
    return "tl.max"
  elif name == "reduce_min" then
    return "tl.min"
  elif name == "argmax" then
    return "tl.argmax"
  elif name == "argmin" then
    return "tl.argmin"
  else
    return ""
  end
end

make a function called triton_atomic_fn_map takes name returns pyname
  if name == "atomic_add" then
    return "tl.atomic_add"
  elif name == "atomic_max" then
    return "tl.atomic_max"
  elif name == "atomic_min" then
    return "tl.atomic_min"
  else
    return ""
  end
end

# A rejection is a ["Err", message] pair returned alongside a null Python
# string, rather than an exception -- keeps this a plain data-flow result
# the caller (and BDD scenarios) can inspect, matching this codebase's
# existing "never surface Rust errors to users" discipline for a new
# failure class specific to this backend.
make a function called triton_reject takes msg returns r
  return ["", ["Err", msg]]
end

make a function called triton_ok takes py returns r
  return [py, ["Ok", ""]]
end

make a function called triton_lower_bin_op takes op returns pyop
  if op == "and" then
    return "&"
  elif op == "or" then
    return "|"
  else
    return op
  end
end

# Walks one expression AST node, emitting Python text. `params` is the
# list of kernel parameter names (so Index/Var against them lower to
# pointer-relative tl.load, not a plain Python variable read).
make a function called triton_lower_expr takes node, params returns r
  let ty = node[0]
  if ty == "Num" then
    return triton_ok(node[1])
  elif ty == "Bool" then
    return triton_ok(node[1])
  elif ty == "Var" then
    return triton_ok(node[1])
  elif ty == "Bin" then
    let l = triton_lower_expr(node[2], params)
    if l[1][0] == "Err" then
      return l
    end
    let rr = triton_lower_expr(node[3], params)
    if rr[1][0] == "Err" then
      return rr
    end
    let pyop = triton_lower_bin_op(node[1])
    return triton_ok("(" + l[0] + " " + pyop + " " + rr[0] + ")")
  elif ty == "Un" then
    let e = triton_lower_expr(node[2], params)
    if e[1][0] == "Err" then
      return e
    end
    if node[1] == "not" then
      return triton_ok("(~(" + e[0] + "))")
    else
      return triton_ok("(-(" + e[0] + "))")
    end
  elif ty == "Index" then
    let obj = triton_lower_expr(node[1], params)
    if obj[1][0] == "Err" then
      return obj
    end
    let idx = triton_lower_expr(node[2], params)
    if idx[1][0] == "Err" then
      return idx
    end
    return triton_ok("tl.load(" + obj[0] + "_ptr + (" + idx[0] + "), mask=mask)")
  elif ty == "Call" then
    return triton_lower_call(node[1], node[2], params)
  else
    return triton_reject("unsupported expression node in kernel body: " + ty)
  end
end

make a function called triton_lower_args takes args, params returns r
  let sb = sb_new()
  let n = to_num(list_len(args))
  let i = 0
  while i < n do
    let a = triton_lower_expr(args[i], params)
    if a[1][0] == "Err" then
      return a
    end
    if i > 0 then
      sb_push(sb, ", ")
    end
    sb_push(sb, a[0])
    let i = i + 1
  end
  return triton_ok(sb_str(sb))
end

# select(cond, a, b) -> tl.where(cond, a, b). This is the ONLY way to
# branch on a per-lane VECTOR condition in a kernel body -- Triton
# requires Python-level `if`/`elif` (this file's triton_lower_if) to have
# a SCALAR/constexpr condition; a vector condition there is a genuine
# Triton compile-time error, not something this lowerer's subset-checker
# currently catches (found while designing a Mandelbrot escape-count
# kernel, which inherently needs a per-pixel vector condition -- "has
# this pixel escaped yet" -- and so cannot use if/elif for it at all).
make a function called triton_lower_call takes name, args, params returns r
  if name == "select" then
    if to_num(list_len(args)) != 3 then
      return triton_reject("select(cond, a, b) needs exactly 3 args")
    end
    let a = triton_lower_args(args, params)
    if a[1][0] == "Err" then
      return a
    end
    return triton_ok("tl.where(" + a[0] + ")")
  end
  # Block-pointer primitives: the AST-driven analogue of Slice 3's fixed,
  # hand-generated matmul kernel -- these let a kernel author write a
  # real tiled/matmul-shaped kernel as PatLang source (make_block_ptr/
  # load_block/advance_block/dot/zeros_2d), rather than only ever getting
  # the ONE canonical matmul shape triton_matmul_kernel_source generates.
  # Fully generic strided/2D access from arbitrary PatLang, still not
  # attempted -- this is a fixed, small vocabulary of block-pointer
  # operations recognized by name, matching every other builtin in this
  # op-table, not a general block-pointer TYPE the lowerer reasons about.
  if name == "make_block_ptr" then
    if to_num(list_len(args)) != 7 then
      return triton_reject("make_block_ptr(buf, total_rows, total_cols, base_row, base_col, block_rows, block_cols) needs exactly 7 args")
    end
    if args[0][0] != "Var" then
      return triton_reject("make_block_ptr's first arg must be a bare buffer parameter name")
    end
    let bufName = args[0][1]
    let totalRows = triton_lower_expr(args[1], params)
    if totalRows[1][0] == "Err" then
      return totalRows
    end
    let totalCols = triton_lower_expr(args[2], params)
    if totalCols[1][0] == "Err" then
      return totalCols
    end
    let baseRow = triton_lower_expr(args[3], params)
    if baseRow[1][0] == "Err" then
      return baseRow
    end
    let baseCol = triton_lower_expr(args[4], params)
    if baseCol[1][0] == "Err" then
      return baseCol
    end
    let blockRows = triton_lower_expr(args[5], params)
    if blockRows[1][0] == "Err" then
      return blockRows
    end
    let blockCols = triton_lower_expr(args[6], params)
    if blockCols[1][0] == "Err" then
      return blockCols
    end
    return triton_ok("tl.make_block_ptr(base=" + bufName + "_ptr, shape=(" + totalRows[0] + ", " + totalCols[0] + "), strides=(" + totalCols[0] + ", 1), offsets=(" + baseRow[0] + ", " + baseCol[0] + "), block_shape=(" + blockRows[0] + ", " + blockCols[0] + "), order=(1, 0))")
  end
  if name == "load_block" then
    if to_num(list_len(args)) != 1 then
      return triton_reject("load_block(ptr) needs exactly 1 arg")
    end
    let a = triton_lower_expr(args[0], params)
    if a[1][0] == "Err" then
      return a
    end
    return triton_ok("tl.load(" + a[0] + ", boundary_check=(0, 1), padding_option='zero')")
  end
  if name == "advance_block" then
    if to_num(list_len(args)) != 3 then
      return triton_reject("advance_block(ptr, delta_row, delta_col) needs exactly 3 args")
    end
    let ptr = triton_lower_expr(args[0], params)
    if ptr[1][0] == "Err" then
      return ptr
    end
    let deltaRow = triton_lower_expr(args[1], params)
    if deltaRow[1][0] == "Err" then
      return deltaRow
    end
    let deltaCol = triton_lower_expr(args[2], params)
    if deltaCol[1][0] == "Err" then
      return deltaCol
    end
    return triton_ok("tl.advance(" + ptr[0] + ", (" + deltaRow[0] + ", " + deltaCol[0] + "))")
  end
  if name == "dot" then
    if to_num(list_len(args)) != 3 then
      return triton_reject("dot(a, b, acc) needs exactly 3 args")
    end
    let a = triton_lower_args(args, params)
    if a[1][0] == "Err" then
      return a
    end
    return triton_ok("tl.dot(" + a[0] + ")")
  end
  if name == "zeros_2d" then
    if to_num(list_len(args)) != 2 then
      return triton_reject("zeros_2d(rows, cols) needs exactly 2 args")
    end
    let a = triton_lower_args(args, params)
    if a[1][0] == "Err" then
      return a
    end
    return triton_ok("tl.zeros((" + a[0] + "), dtype=tl.float32)")
  end
  let mathpy = triton_math_fn_map(name)
  if mathpy != "" then
    let a = triton_lower_args(args, params)
    if a[1][0] == "Err" then
      return a
    end
    return triton_ok(mathpy + "(" + a[0] + ")")
  end
  let redpy = triton_reduce_fn_map(name)
  if redpy != "" then
    let a = triton_lower_args(args, params)
    if a[1][0] == "Err" then
      return a
    end
    return triton_ok(redpy + "(" + a[0] + ", axis=0)")
  end
  let atompy = triton_atomic_fn_map(name)
  if atompy != "" then
    if to_num(list_len(args)) != 2 then
      return triton_reject(name + " needs exactly (ptr, value)")
    end
    let ptr = triton_lower_expr(args[0], params)
    if ptr[1][0] == "Err" then
      return ptr
    end
    let val = triton_lower_expr(args[1], params)
    if val[1][0] == "Err" then
      return val
    end
    return triton_ok(atompy + "(" + ptr[0] + "_ptr + offs, " + val[0] + ", mask=mask)")
  end
  return triton_reject("call to unsupported function in kernel body: " + name)
end

# Emits one statement, `indent` spaces deep, into the given StringBuilder.
# Returns an ["Err", msg] on rejection, ["Ok", ""] otherwise.
make a function called triton_lower_stmt takes node, params, indent, sb returns status
  let ty = node[0]
  let pad = ""
  let k = 0
  while k < indent do
    let pad = pad + " "
    let k = k + 1
  end
  if ty == "Let" then
    let e = triton_lower_expr(node[2], params)
    if e[1][0] == "Err" then
      return e[1]
    end
    sb_push(sb, pad + node[1] + " = " + e[0] + "\n")
    return ["Ok", ""]
  elif ty == "Return" then
    return ["Err", "kernel bodies write results via Index-store, not return"]
  elif ty == "Expr" then
    let call = node[1]
    if call[0] != "Call" then
      return ["Err", "bare expression statement in kernel body must be a store/atomic call"]
    end
    if call[1] == "store" then
      if to_num(list_len(call[2])) != 3 then
        return ["Err", "store(buf, index, value) needs exactly 3 args"]
      end
      let buf = triton_lower_expr(call[2][0], params)
      if buf[1][0] == "Err" then
        return buf[1]
      end
      let idx = triton_lower_expr(call[2][1], params)
      if idx[1][0] == "Err" then
        return idx[1]
      end
      let val = triton_lower_expr(call[2][2], params)
      if val[1][0] == "Err" then
        return val[1]
      end
      # A literal-index store (store(out, 0, ...)) is inherently a
      # SCALAR write -- e.g. a reduction result. The block `mask` is a
      # per-lane vector shaped for the offs-indexed elementwise case, so
      # applying it to a scalar store is a genuine Triton shape mismatch
      # (found by running this: the kernel compile fails inside the
      # generated Python and exec_capture surfaces it only as an empty
      # result, not a visible PatLang-side error). Only vector (offs-
      # shaped) index stores need the mask.
      if call[2][1][0] == "Num" then
        sb_push(sb, pad + "tl.store(" + buf[0] + "_ptr + (" + idx[0] + "), " + val[0] + ")\n")
      else
        sb_push(sb, pad + "tl.store(" + buf[0] + "_ptr + (" + idx[0] + "), " + val[0] + ", mask=mask)\n")
      end
      return ["Ok", ""]
    end
    let atompy = triton_atomic_fn_map(call[1])
    if atompy != "" then
      let e = triton_lower_expr(call, params)
      if e[1][0] == "Err" then
        return e[1]
      end
      sb_push(sb, pad + e[0] + "\n")
      return ["Ok", ""]
    end
    if call[1] == "store_block" then
      if to_num(list_len(call[2])) != 2 then
        return ["Err", "store_block(ptr, value) needs exactly 2 args"]
      end
      let ptr = triton_lower_expr(call[2][0], params)
      if ptr[1][0] == "Err" then
        return ptr[1]
      end
      let val = triton_lower_expr(call[2][1], params)
      if val[1][0] == "Err" then
        return val[1]
      end
      sb_push(sb, pad + "tl.store(" + ptr[0] + ", " + val[0] + ", boundary_check=(0, 1))\n")
      return ["Ok", ""]
    end
    return ["Err", "unsupported call statement in kernel body: " + call[1]]
  elif ty == "If" then
    return triton_reject_unless_ok(triton_lower_if(node, params, indent, sb))
  elif ty == "While" then
    return triton_lower_while(node, params, indent, sb)
  else
    return ["Err", "unsupported statement kind in kernel body: " + ty]
  end
end

make a function called triton_reject_unless_ok takes status returns r
  return status
end

# If/elif -> nested Python if/elif is valid Triton for a SCALAR/constexpr
# condition (this file's own "no nested else-if, use elif" mirrors
# CLAUDE.md's structural rule, since the parser already normalizes it to
# that shape). CAUTION, not yet enforced by this lowerer: if `cond`
# involves a per-lane buffer read (e.g. `x[offs] > 0`), it is a VECTOR
# condition, and real Triton will reject a Python `if` on it at kernel-
# compile time -- exactly the class of failure the scalar-store/mask bug
# from Slice 2 was ([[patlang-triton-lowering-slice2-scoped]]): a real
# Triton-side error, surfaced through exec_capture only as an empty
# result, not a PatLang-visible rejection. Use `select(cond, a, b)`
# (-> tl.where) for any PER-PIXEL branching instead of if/elif.
make a function called triton_lower_if takes node, params, indent, sb returns status
  let cond = triton_lower_expr(node[1], params)
  if cond[1][0] == "Err" then
    return cond[1]
  end
  let pad = ""
  let k = 0
  while k < indent do
    let pad = pad + " "
    let k = k + 1
  end
  sb_push(sb, pad + "if " + cond[0] + ":\n")
  let thenBody = node[2]
  let st1 = triton_lower_block(thenBody, params, indent + 4, sb)
  if st1[0] == "Err" then
    return st1
  end
  let elseBody = node[3]
  if to_num(list_len(elseBody)) > 0 then
    sb_push(sb, pad + "else:\n")
    let st2 = triton_lower_block(elseBody, params, indent + 4, sb)
    if st2[0] == "Err" then
      return st2
    end
  end
  return ["Ok", ""]
end

# Bounded counted loop (`while i < N do ... end` with `i` incremented by a
# literal step in-body) -- the shape both reduction accumulation and
# matmul's K-loop need. Lowered to Triton's own `for`-over-range, which
# Triton's frontend unrolls/compiles at trace time, not a runtime GPU loop
# primitive of its own.
make a function called triton_lower_while takes node, params, indent, sb returns status
  let cond = node[1]
  if cond[0] != "Bin" then
    return ["Err", "kernel while-loop condition must be a simple i < N comparison"]
  end
  if cond[1] != "<" then
    return ["Err", "kernel while-loop condition must use '<' (counted loop only)"]
  end
  if cond[2][0] != "Var" then
    return ["Err", "kernel while-loop counter must be a plain variable"]
  end
  let counter = cond[2][1]
  let bound = triton_lower_expr(cond[3], params)
  if bound[1][0] == "Err" then
    return bound[1]
  end
  let pad = ""
  let k = 0
  while k < indent do
    let pad = pad + " "
    let k = k + 1
  end
  # Step detection: a plain `while i < N do ... end` (no trailing
  # increment, or a trailing `let i = i + 1`) lowers to `range(bound)`,
  # step 1, unchanged from before. A non-unit step -- e.g. matmul's
  # `while k0 < K do ... let k0 = k0 + BLOCK_K end` K-loop -- is detected
  # by inspecting the body's LAST statement for `let COUNTER = COUNTER +
  # STEP` and lowered to `range(0, bound, step)` instead. Assumes the
  # counter always starts at 0 (true of every kernel body written so far,
  # matching the existing `let i = 0` convention right before the while)
  # -- not re-derived from that statement, kept simple on purpose.
  let bodyLen = to_num(list_len(node[2]))
  let step = ""
  if bodyLen > 0 then
    let lastStmt = node[2][bodyLen - 1]
    if lastStmt[0] == "Let" then
      if lastStmt[1] == counter then
        let rhs = lastStmt[2]
        if rhs[0] == "Bin" then
          if rhs[1] == "+" then
            if rhs[2][0] == "Var" then
              if rhs[2][1] == counter then
                let stepLowered = triton_lower_expr(rhs[3], params)
                if stepLowered[1][0] == "Ok" then
                  let step = stepLowered[0]
                end
              end
            end
          end
        end
      end
    end
  end
  if step == "" then
    sb_push(sb, pad + "for " + counter + " in range(" + bound[0] + "):\n")
  else
    sb_push(sb, pad + "for " + counter + " in range(0, " + bound[0] + ", " + step + "):\n")
  end
  return triton_lower_block(node[2], params, indent + 4, sb)
end

make a function called triton_lower_block takes stmts, params, indent, sb returns status
  let n = to_num(list_len(stmts))
  if n == 0 then
    let pad = ""
    let k = 0
    while k < indent do
      let pad = pad + " "
      let k = k + 1
    end
    sb_push(sb, pad + "pass\n")
    return ["Ok", ""]
  end
  let i = 0
  while i < n do
    let status = triton_lower_stmt(stmts[i], params, indent, sb)
    if status[0] == "Err" then
      return status
    end
    let i = i + 1
  end
  return ["Ok", ""]
end

# ============================================================================
# Vector-vs-scalar shape checker (closes a real, previously-undocumented
# gap): Triton requires a Python-level `if`/`elif` condition to be
# SCALAR/constexpr -- a per-lane VECTOR condition (e.g. `mag2 <= 4.0`
# where `mag2` was computed from a buffer load) is a genuine Triton
# compile-time rejection, but until now this lowerer's own subset-checker
# never caught it: it would happily emit syntactically valid Python that
# Triton's compiler then rejected, surfaced only as an empty result via
# exec_capture, not a visible PatLang-side error (exactly the class of
# bug that shipped silently in the first version of the Mandelbrot demo,
# see [[patlang-triton-lowering-mandelbrot-timing-demo]] in project
# memory). `select(cond, a, b)` (-> tl.where) is the correct primitive for
# any PER-LANE branch; this checker makes an unsupported vector `if`/
# `elif` a clear rejection at lowering time instead of a silent runtime
# failure discovered later, if at all.
#
# Deliberately conservative in ONE direction only: anything not PROVEN
# scalar is treated as vector. A false rejection (flagging an actually-
# safe condition) just means the kernel author uses select() instead --
# mildly annoying, never wrong. A false ACCEPTANCE (letting a genuinely
# unsafe vector condition through) is the bug class this exists to
# prevent, so it is never the default.
make a function called triton_reduce_fn_is_scalar takes name returns r
  return triton_reduce_fn_map(name) != ""
end

make a function called triton_name_in_list takes name, names returns r
  let n = to_num(list_len(names))
  let i = 0
  while i < n do
    if names[i] == name then
      return true
    end
    let i = i + 1
  end
  return false
end

# Walks one expression node, returning true if it is per-lane VECTOR-
# shaped (unsafe as a bare if/elif condition), false if proven SCALAR.
# `scalarLocals` is the list of local variable names proven scalar so
# far (by the top-to-bottom statement walk in triton_check_kernel_shapes)
# -- any Var not in this list is conservatively treated as vector,
# including kernel params (always buffers/pointers when dereferenced)
# and the implicit `offs`/`mask`/`row`/`col` block-scope vars (always
# genuinely vector-shaped by construction).
make a function called triton_expr_is_vector takes node, scalarLocals returns is_vec
  let ty = node[0]
  if ty == "Num" then
    return false
  elif ty == "Bool" then
    return false
  elif ty == "Var" then
    return not triton_name_in_list(node[1], scalarLocals)
  elif ty == "Index" then
    return true
  elif ty == "Bin" then
    if triton_expr_is_vector(node[2], scalarLocals) then
      return true
    end
    return triton_expr_is_vector(node[3], scalarLocals)
  elif ty == "Un" then
    return triton_expr_is_vector(node[2], scalarLocals)
  elif ty == "Call" then
    let name = node[1]
    let args = node[2]
    if triton_reduce_fn_is_scalar(name) then
      return false
    end
    if name == "select" then
      if to_num(list_len(args)) < 3 then
        return true
      end
      if triton_expr_is_vector(args[1], scalarLocals) then
        return true
      end
      return triton_expr_is_vector(args[2], scalarLocals)
    end
    if triton_math_fn_map(name) != "" then
      if to_num(list_len(args)) == 0 then
        return true
      end
      return triton_expr_is_vector(args[0], scalarLocals)
    end
    return true
  else
    return true
  end
end

# Single shared-state, top-to-bottom walk of the kernel body tracking
# which locals are proven scalar so far, rejecting the first vector-
# conditioned if/elif found. Recurses into If/While bodies updating the
# SAME shared scalarLocals state (not scope-isolated) -- correct for the
# flat, single-function-body shape every real kernel here has; a local
# assigned differently across branches just stays conservatively
# vector-classified past that point, which is safe (see file header).
make a function called triton_check_stmt_shapes takes node, scalarLocals returns r
  let ty = node[0]
  if ty == "Let" then
    let isVec = triton_expr_is_vector(node[2], scalarLocals)
    if not isVec then
      let scalarLocals = list_push(scalarLocals, node[1])
    end
    return [scalarLocals, ["Ok", ""]]
  elif ty == "If" then
    if triton_expr_is_vector(node[1], scalarLocals) then
      return [scalarLocals, ["Err", "if/elif condition is per-lane (vector) shaped -- Triton only allows a scalar/constexpr condition here; use select(cond, a, b) instead"]]
    end
    let r1 = triton_check_block_shapes(node[2], scalarLocals)
    if r1[1][0] == "Err" then
      return r1
    end
    let scalarLocals = r1[0]
    let r2 = triton_check_block_shapes(node[3], scalarLocals)
    return r2
  elif ty == "While" then
    return triton_check_block_shapes(node[2], scalarLocals)
  else
    return [scalarLocals, ["Ok", ""]]
  end
end

make a function called triton_check_block_shapes takes stmts, scalarLocals returns r
  let n = to_num(list_len(stmts))
  let i = 0
  while i < n do
    let step = triton_check_stmt_shapes(stmts[i], scalarLocals)
    if step[1][0] == "Err" then
      return step
    end
    let scalarLocals = step[0]
    let i = i + 1
  end
  return [scalarLocals, ["Ok", ""]]
end

# ============================================================================

# Top-level entry point: given a kernel function's PatLang SOURCE TEXT
# (e.g. the body of a `make a function called ... end` block extracted by
# the caller), returns [triton_python_source, status] where status is
# ["Ok", ""] or ["Err", message]. `param_names` lists which params are
# device buffers (pointer args); any not listed are treated as plain
# scalar/constexpr args.
make a function called triton_lower_kernel_source takes src, kernel_name returns r
  let toks = tokenize(src)
  let program = parse_program(toks)
  let stmts = program[1]
  let n = to_num(list_len(stmts))
  if n == 0 then
    return ["", ["Err", "empty kernel source"]]
  end
  let fnNode = stmts[0]
  if fnNode[0] != "Func" then
    return ["", ["Err", "kernel source must be a single function definition"]]
  end
  let params = fnNode[2]
  let body = fnNode[3]
  let shapeCheck = triton_check_block_shapes(body, [])
  if shapeCheck[1][0] == "Err" then
    return ["", shapeCheck[1]]
  end
  let sb = sb_new()
  sb_push(sb, "@triton.jit\n")
  sb_push(sb, "def " + kernel_name + "(")
  let np = to_num(list_len(params))
  let i = 0
  while i < np do
    if i > 0 then
      sb_push(sb, ", ")
    end
    sb_push(sb, params[i] + "_ptr")
    let i = i + 1
  end
  if np > 0 then
    sb_push(sb, ", ")
  end
  sb_push(sb, "n, BLOCK_SIZE: tl.constexpr):\n")
  sb_push(sb, "    pid = tl.program_id(0)\n")
  sb_push(sb, "    offs = pid * BLOCK_SIZE + tl.arange(0, BLOCK_SIZE)\n")
  sb_push(sb, "    mask = offs < n\n")
  let status = triton_lower_block(body, params, 4, sb)
  if status[0] == "Err" then
    return ["", status]
  end
  return [sb_str(sb), ["Ok", ""]]
end

# Autotune-aware variant of triton_lower_kernel_source: prepends an
# @triton.autotune decorator listing several candidate BLOCK_SIZE
# `triton.Config`s, so Triton benchmarks each at first launch and
# picks the fastest for the actual input size -- instead of this
# lowerer guessing one fixed BLOCK_SIZE up front. Rejects reduction
# kernels outright (same triton_src_has_reduction guard the multi-block
# launch-strategy fix uses): a reduction assumes the WHOLE input is one
# block, so varying BLOCK_SIZE across autotune candidates would silently
# change which elements a given launch actually reduces over -- unsafe,
# not just untuned.
make a function called triton_lower_kernel_source_autotune takes src, kernel_name, block_candidates returns r
  if triton_src_has_reduction(src) then
    return ["", ["Err", "autotune is unsafe for a reduction kernel (BLOCK_SIZE must cover the whole input exactly, not vary) -- use triton_lower_kernel_source instead"]]
  end
  if to_num(list_len(block_candidates)) == 0 then
    return ["", ["Err", "triton_lower_kernel_source_autotune needs at least one BLOCK_SIZE candidate"]]
  end
  let toks = tokenize(src)
  let program = parse_program(toks)
  let stmts = program[1]
  let n = to_num(list_len(stmts))
  if n == 0 then
    return ["", ["Err", "empty kernel source"]]
  end
  let fnNode = stmts[0]
  if fnNode[0] != "Func" then
    return ["", ["Err", "kernel source must be a single function definition"]]
  end
  let params = fnNode[2]
  let body = fnNode[3]
  let shapeCheck = triton_check_block_shapes(body, [])
  if shapeCheck[1][0] == "Err" then
    return ["", shapeCheck[1]]
  end
  let sb = sb_new()
  sb_push(sb, "@triton.autotune(configs=[\n")
  let nc = to_num(list_len(block_candidates))
  let c = 0
  while c < nc do
    sb_push(sb, "    triton.Config({'BLOCK_SIZE': " + to_num(block_candidates[c]) + "}, num_warps=4),\n")
    let c = c + 1
  end
  sb_push(sb, "], key=['n'])\n")
  sb_push(sb, "@triton.jit\n")
  sb_push(sb, "def " + kernel_name + "(")
  let np = to_num(list_len(params))
  let i = 0
  while i < np do
    if i > 0 then
      sb_push(sb, ", ")
    end
    sb_push(sb, params[i] + "_ptr")
    let i = i + 1
  end
  if np > 0 then
    sb_push(sb, ", ")
  end
  sb_push(sb, "n, BLOCK_SIZE: tl.constexpr):\n")
  sb_push(sb, "    pid = tl.program_id(0)\n")
  sb_push(sb, "    offs = pid * BLOCK_SIZE + tl.arange(0, BLOCK_SIZE)\n")
  sb_push(sb, "    mask = offs < n\n")
  let status = triton_lower_block(body, params, 4, sb)
  if status[0] == "Err" then
    return ["", status]
  end
  return [sb_str(sb), ["Ok", ""]]
end

# ============================================================================
# SLICE 3: multi-dim grids + block pointers + matmul.
# ============================================================================
#
# `triton_lower_kernel_source_2d` generalizes the entry point above from a
# 1D offs/mask domain to a 2D row/col domain over a flattened row-major
# buffer -- a REAL second axis (tl.program_id(1), a second constexpr block
# size, a 2D offs_r/offs_c/mask_r/mask_c/mask preamble), still walking
# arbitrary PatLang kernel source via the same AST walker above (no new
# grammar, same op-table). This is the generic "multi-dim grid" capability:
# any kernel body written against this preamble's `offs`/`mask` sees the
# SAME names as the 1D case (a single flattened per-element offset/mask),
# so existing kernel bodies (elementwise add, etc) port to 2D unchanged --
# only the *launch* geometry changes to a 2D grid, and the row/col identity
# is available to a kernel body that wants it via `row`/`col` if needed for
# strided (non-flattened) access patterns.
make a function called triton_lower_kernel_source_2d takes src, kernel_name returns r
  let toks = tokenize(src)
  let program = parse_program(toks)
  let stmts = program[1]
  let n = to_num(list_len(stmts))
  if n == 0 then
    return ["", ["Err", "empty kernel source"]]
  end
  let fnNode = stmts[0]
  if fnNode[0] != "Func" then
    return ["", ["Err", "kernel source must be a single function definition"]]
  end
  let params = fnNode[2]
  let body = fnNode[3]
  let shapeCheck = triton_check_block_shapes(body, [])
  if shapeCheck[1][0] == "Err" then
    return ["", shapeCheck[1]]
  end
  let sb = sb_new()
  sb_push(sb, "@triton.jit\n")
  sb_push(sb, "def " + kernel_name + "(")
  let np = to_num(list_len(params))
  let i = 0
  while i < np do
    if i > 0 then
      sb_push(sb, ", ")
    end
    sb_push(sb, params[i] + "_ptr")
    let i = i + 1
  end
  if np > 0 then
    sb_push(sb, ", ")
  end
  sb_push(sb, "n_rows, n_cols, BLOCK_R: tl.constexpr, BLOCK_C: tl.constexpr):\n")
  sb_push(sb, "    pid_r = tl.program_id(0)\n")
  sb_push(sb, "    pid_c = tl.program_id(1)\n")
  sb_push(sb, "    row = pid_r * BLOCK_R + tl.arange(0, BLOCK_R)\n")
  sb_push(sb, "    col = pid_c * BLOCK_C + tl.arange(0, BLOCK_C)\n")
  sb_push(sb, "    mask_r = row < n_rows\n")
  sb_push(sb, "    mask_c = col < n_cols\n")
  sb_push(sb, "    row2 = row[:, None]\n")
  sb_push(sb, "    col2 = col[None, :]\n")
  sb_push(sb, "    mask = mask_r[:, None] & mask_c[None, :]\n")
  sb_push(sb, "    offs = row2 * n_cols + col2\n")
  let status = triton_lower_block(body, params, 4, sb)
  if status[0] == "Err" then
    return ["", status]
  end
  return [sb_str(sb), ["Ok", ""]]
end

# Canonical block-pointer matmul kernel (Triton's own tutorial shape,
# generated rather than AST-lowered from PatLang source -- matmul's
# tiled-accumulator-over-K structure with 2D block pointers is a
# recognized SHAPE here, the same "prove the architecture with a fixed
# kernel first" discipline this codebase already used for Slice 1's
# vector-add before any lowering existed at all, not a retreat from
# lowering in general. A fully generic AST-driven block-pointer lowering
# (arbitrary strided 2D access patterns from arbitrary PatLang source) is
# real future work, not attempted here.) Computes C[M,N] = A[M,K] @ B[K,N],
# all row-major. Uses tl.make_block_ptr + tl.advance + tl.dot, a 2D grid
# (pid_m, pid_n) -- no L2-cache-swizzle grouping (a known further
# optimization in Triton's real matmul tutorial, left out here since it
# doesn't change correctness, only performance).
make a function called triton_matmul_kernel_source takes kernel_name, m, n, k, block_m, block_n, block_k returns py
  let sb = sb_new()
  sb_push(sb, "@triton.jit\n")
  sb_push(sb, "def " + kernel_name + "(a_ptr, b_ptr, c_ptr, M, N, K, BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr):\n")
  sb_push(sb, "    pid_m = tl.program_id(0)\n")
  sb_push(sb, "    pid_n = tl.program_id(1)\n")
  sb_push(sb, "    a_block_ptr = tl.make_block_ptr(base=a_ptr, shape=(M, K), strides=(K, 1), offsets=(pid_m * BLOCK_M, 0), block_shape=(BLOCK_M, BLOCK_K), order=(1, 0))\n")
  sb_push(sb, "    b_block_ptr = tl.make_block_ptr(base=b_ptr, shape=(K, N), strides=(N, 1), offsets=(0, pid_n * BLOCK_N), block_shape=(BLOCK_K, BLOCK_N), order=(1, 0))\n")
  sb_push(sb, "    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\n")
  sb_push(sb, "    for k0 in range(0, K, BLOCK_K):\n")
  sb_push(sb, "        a_tile = tl.load(a_block_ptr, boundary_check=(0, 1), padding_option='zero')\n")
  sb_push(sb, "        b_tile = tl.load(b_block_ptr, boundary_check=(0, 1), padding_option='zero')\n")
  sb_push(sb, "        acc = tl.dot(a_tile, b_tile, acc)\n")
  sb_push(sb, "        a_block_ptr = tl.advance(a_block_ptr, (0, BLOCK_K))\n")
  sb_push(sb, "        b_block_ptr = tl.advance(b_block_ptr, (BLOCK_K, 0))\n")
  sb_push(sb, "    c_block_ptr = tl.make_block_ptr(base=c_ptr, shape=(M, N), strides=(N, 1), offsets=(pid_m * BLOCK_M, pid_n * BLOCK_N), block_shape=(BLOCK_M, BLOCK_N), order=(1, 0))\n")
  sb_push(sb, "    tl.store(c_block_ptr, acc, boundary_check=(0, 1))\n")
  return sb_str(sb)
end

# AST-driven counterpart to triton_matmul_kernel_source above: a kernel
# body written in real PatLang source using the block-pointer primitives
# (make_block_ptr/load_block/advance_block/dot/zeros_2d/store_block) is
# walked and lowered, instead of only ever getting the one fixed,
# hand-generated matmul shape. Implicit block-scope vars available to the
# kernel body: `M`, `N`, `K` (runtime sizes), `BLOCK_M`/`BLOCK_N`/
# `BLOCK_K` (constexpr tile sizes), `pid_m`/`pid_n` (this program's tile
# coordinates) -- same "implicit preamble variables" convention as
# `offs`/`mask` for the elementwise 1D/2D entry points. A genuinely
# generic PatLang matmul kernel now looks like:
#   make a function called my_matmul takes a, b, c
#     let a_tile_ptr = make_block_ptr(a, M, K, pid_m * BLOCK_M, 0, BLOCK_M, BLOCK_K)
#     let b_tile_ptr = make_block_ptr(b, K, N, 0, pid_n * BLOCK_N, BLOCK_K, BLOCK_N)
#     let acc = zeros_2d(BLOCK_M, BLOCK_N)
#     let k0 = 0
#     while k0 < K do
#       let acc = dot(load_block(a_tile_ptr), load_block(b_tile_ptr), acc)
#       let a_tile_ptr = advance_block(a_tile_ptr, 0, BLOCK_K)
#       let b_tile_ptr = advance_block(b_tile_ptr, BLOCK_K, 0)
#       let k0 = k0 + BLOCK_K
#     end
#     let c_tile_ptr = make_block_ptr(c, M, N, pid_m * BLOCK_M, pid_n * BLOCK_N, BLOCK_M, BLOCK_N)
#     store_block(c_tile_ptr, acc)
#   end
# Reuses triton_lower_while's non-unit-step detection (added alongside
# this) for the `let k0 = k0 + BLOCK_K` K-loop -- a plain range(bound)
# assumption (step 1) would silently iterate BLOCK_K times too many.
make a function called triton_lower_kernel_source_matmul takes src, kernel_name returns r
  let toks = tokenize(src)
  let program = parse_program(toks)
  let stmts = program[1]
  let n = to_num(list_len(stmts))
  if n == 0 then
    return ["", ["Err", "empty kernel source"]]
  end
  let fnNode = stmts[0]
  if fnNode[0] != "Func" then
    return ["", ["Err", "kernel source must be a single function definition"]]
  end
  let params = fnNode[2]
  let body = fnNode[3]
  let shapeCheck = triton_check_block_shapes(body, [])
  if shapeCheck[1][0] == "Err" then
    return ["", shapeCheck[1]]
  end
  let sb = sb_new()
  sb_push(sb, "@triton.jit\n")
  sb_push(sb, "def " + kernel_name + "(")
  let np = to_num(list_len(params))
  let i = 0
  while i < np do
    if i > 0 then
      sb_push(sb, ", ")
    end
    sb_push(sb, params[i] + "_ptr")
    let i = i + 1
  end
  if np > 0 then
    sb_push(sb, ", ")
  end
  sb_push(sb, "M, N, K, BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr):\n")
  sb_push(sb, "    pid_m = tl.program_id(0)\n")
  sb_push(sb, "    pid_n = tl.program_id(1)\n")
  let status = triton_lower_block(body, params, 4, sb)
  if status[0] == "Err" then
    return ["", status]
  end
  return [sb_str(sb), ["Ok", ""]]
end
