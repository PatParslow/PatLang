# =============================================================================
# Markdown-subset renderer (Stage 1 dialect) for the PatLang site generator.
# Supports: # ## ### headings (h2s collected for a TOC), ``` fenced code,
# - bullet lists, | tables, paragraphs, and inline `code`, **bold**, [t](u).
# =============================================================================

# self-contained prefix test (same as lib/test.patlang's)
make a function called starts_with takes s, prefix returns r
  if s.length < prefix.length then
    return false
  end
  return substr(s, 0, prefix.length) == prefix
end

make a function called slugify takes s returns out
  let b = sb_new()
  let i = 0
  while i < s.length do
    let c = char_code(s, i)
    if ((c >= 97) and (c <= 122)) or ((c >= 48) and (c <= 57)) then
      sb_push(b, s[i])
    else
      if (c >= 65) and (c <= 90) then
        sb_push(b, chr(c + 32))
      else
        sb_push(b, "-")
      end
    end
    let i = i + 1
  end
  return sb_str(b)
end

make a function called md_inline takes s returns out
  let b = sb_new()
  let i = 0
  let bold = 0
  while i < s.length do
    let c = char_code(s, i)
    if c == 96 then
      # `code`
      let j = i + 1
      let cb = sb_new()
      while (j < s.length) and (char_code(s, j) != 96) do
        sb_push(cb, s[j])
        let j = j + 1
      end
      sb_push(b, "<code>" + html_escape(sb_str(cb)) + "</code>")
      let i = j + 1
    else
      if (c == 42) and (char_code(s, i + 1) == 42) then
        if bold == 0 then
          sb_push(b, "<strong>")
          let bold = 1
        else
          sb_push(b, "</strong>")
          let bold = 0
        end
        let i = i + 2
      else
        if c == 91 then
          # [text](url)
          let j = i + 1
          let tb = sb_new()
          while (j < s.length) and (char_code(s, j) != 93) do
            sb_push(tb, s[j])
            let j = j + 1
          end
          if (char_code(s, j) == 93) and (char_code(s, j + 1) == 40) then
            let k = j + 2
            let ub = sb_new()
            while (k < s.length) and (char_code(s, k) != 41) do
              sb_push(ub, s[k])
              let k = k + 1
            end
            sb_push(b, "<a href='" + sb_str(ub) + "'>" + html_escape(sb_str(tb)) + "</a>")
            let i = k + 1
          else
            sb_push(b, html_escape(s[i]))
            let i = i + 1
          end
        else
          sb_push(b, html_escape(s[i]))
          let i = i + 1
        end
      end
    end
  end
  return sb_str(b)
end

make a function called md_cell_row takes line, tag returns out
  let b = sb_new()
  sb_push(b, "<tr>")
  let cell = sb_new()
  let i = 1
  while i <= line.length do
    let c = char_code(line, i)
    if (c == 124) or (c == -1) then
      let t = trim_ws(sb_str(cell))
      let cell = sb_new()
      if t != "" then
        sb_push(b, "<" + tag + ">" + md_inline(t) + "</" + tag + ">")
      end
    else
      sb_push(cell, line[i])
    end
    let i = i + 1
  end
  sb_push(b, "</tr>")
  return sb_str(b)
end

make a function called trim_ws takes s returns out
  let a = 0
  while (a < s.length) and ((char_code(s, a) == 32) or (char_code(s, a) == 9) or (char_code(s, a) == 13)) do
    let a = a + 1
  end
  let z = s.length
  while (z > a) and ((char_code(s, z - 1) == 32) or (char_code(s, z - 1) == 9) or (char_code(s, z - 1) == 13)) do
    let z = z - 1
  end
  return substr(s, a, z - a)
end

# Renders markdown to HTML; also fills toc (a string builder) with
# <li><a href='#slug'>title</a></li> entries for each ## heading.
make a function called md_to_html takes md, toc returns out
  let b = sb_new()
  let h = str_intern(md)
  let n = sc_len(h)
  let i = 0
  let line = sb_new()
  let in_code = 0
  let in_list = 0
  let in_table = 0
  let para = sb_new()
  let first_row = 0
  while i <= n do
    let c = sc_code(h, i)
    if (c == 10) or (c == -1) then
      let raw = sb_str(line)
      let line = sb_new()
      if in_code == 1 then
        if starts_with(trim_ws(raw), "```") then
          sb_push(b, "</code></pre>" + nl())
          let in_code = 0
        else
          sb_push(b, html_escape(raw) + nl())
        end
      else
        let t = trim_ws(raw)
        # close paragraph on blank or structural lines
        if (t == "") or starts_with(t, "#") or starts_with(t, "- ") or starts_with(t, "|") or starts_with(t, "```") then
          let ptxt = sb_str(para)
          let para = sb_new()
          if ptxt != "" then
            sb_push(b, "<p>" + md_inline(ptxt) + "</p>" + nl())
          end
        end
        if (in_list == 1) and (not starts_with(t, "- ")) then
          sb_push(b, "</ul>" + nl())
          let in_list = 0
        end
        if (in_table == 1) and (not starts_with(t, "|")) then
          sb_push(b, "</table>" + nl())
          let in_table = 0
        end
        if starts_with(t, "```") then
          sb_push(b, "<pre><code>")
          let in_code = 1
        else
          if starts_with(t, "### ") then
            sb_push(b, "<h3>" + md_inline(substr(t, 4, t.length - 4)) + "</h3>" + nl())
          else
            if starts_with(t, "## ") then
              let title = substr(t, 3, t.length - 3)
              let id = slugify(title)
              sb_push(b, "<h2 id='" + id + "'>" + md_inline(title) + "</h2>" + nl())
              sb_push(toc, "<li><a href='#" + id + "'>" + html_escape(title) + "</a></li>")
            else
              if starts_with(t, "# ") then
                sb_push(b, "<h1>" + md_inline(substr(t, 2, t.length - 2)) + "</h1>" + nl())
              else
                if starts_with(t, "- ") then
                  if in_list == 0 then
                    sb_push(b, "<ul>" + nl())
                    let in_list = 1
                  end
                  sb_push(b, "<li>" + md_inline(substr(t, 2, t.length - 2)) + "</li>" + nl())
                else
                  if starts_with(t, "|") then
                    if in_table == 0 then
                      sb_push(b, "<table>" + nl())
                      let in_table = 1
                      let first_row = 1
                      sb_push(b, md_cell_row(t, "th") + nl())
                    else
                      if starts_with(t, "|-") then
                        let first_row = 0
                      else
                        sb_push(b, md_cell_row(t, "td") + nl())
                      end
                    end
                  else
                    if t != "" then
                      if sb_str(para) != "" then
                        sb_push(para, " ")
                      end
                      sb_push(para, t)
                    end
                  end
                end
              end
            end
          end
        end
      end
      let i = i + 1
    else
      if c != 13 then
        sb_push(line, sc_char(h, i))
      end
      let i = i + 1
    end
  end
  let ptxt = sb_str(para)
  if ptxt != "" then
    sb_push(b, "<p>" + md_inline(ptxt) + "</p>" + nl())
  end
  if in_list == 1 then
    sb_push(b, "</ul>" + nl())
  end
  if in_table == 1 then
    sb_push(b, "</table>" + nl())
  end
  return sb_str(b)
end
