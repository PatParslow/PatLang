# Dual-mode output: one human-readable line, or one structured JSON line,
# for the same underlying event -- routemap.md's "Dual Mode Support"
# (interactive human use vs. programmatic agent use), and a single
# replacement for two competing ad hoc logging conventions found
# duplicated inside this codebase's own demos (a "log_line" style and a
# separate "log_event" style, neither shared).
#
# Every part of friendly_cli (and, eventually, other PatLang tools) should
# route its output through emit() rather than calling print() directly,
# so a single flag picks human vs. agent rendering everywhere at once.

include "json.patlang"

# render_human(event_kind, message, detail) -> "[event_kind] message" if
# detail is empty, else "[event_kind] message -- detail". Kept to one
# line per event on purpose: friendly_cli's terminal use is line-oriented
# (history, scrollback), and a multi-line human format would break that.
make a function called render_human takes event_kind, message, detail returns text
  if detail == "" then
    return "[" + event_kind + "] " + message
  end
  return "[" + event_kind + "] " + message + " -- " + detail
end

# render_json(event_kind, message, detail) -> the same event as a JSON
# object string, via json.patlang's own tagged-value constructors and
# json_stringify -- not hand-built with string concatenation, so escaping
# (quotes, newlines, backslashes inside message/detail) is handled in one
# place instead of risking a second, subtly different escaper here.
make a function called render_json takes event_kind, message, detail returns json_text
  let pairs = [
    ["event", json_make_str(event_kind)],
    ["message", json_make_str(message)],
    ["detail", json_make_str(detail)]
  ]
  return json_stringify(json_make_obj(pairs))
end

# emit(mode, event_kind, message, detail) -> prints the rendering for
# `mode` ("interactive" picks render_human, anything else -- "agent" --
# picks render_json) and returns true. The single call site every command
# handler and console_step failure branch should route through.
make a function called emit takes mode, event_kind, message, detail returns done
  if mode == "interactive" then
    print(render_human(event_kind, message, detail))
  else
    print(render_json(event_kind, message, detail))
  end
  return true
end
