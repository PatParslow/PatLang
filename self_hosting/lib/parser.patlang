# =============================================================================
# Stage 1 self-hosted parser library (Stage 0 compilable subset).
# Consumes tokens from lib/lexer.patlang, produces list-shaped AST nodes:
#   ["Program", [stmts]]  ["Let", name, expr]  ["Print", expr]
#   ["Num", text]  ["Str", text]  ["Var", name]  ["Bin", op, lhs, rhs]
# Parser functions return [node, next_pos] pairs.
# =============================================================================

make a function called parse_primary takes toks, pos returns r
  let t = toks[pos]
  let ty = t[0]
  let tx = t[1]
  if ty == "NUM" then
    return [["Num", tx], pos + 1]
  else
    if ty == "STR" then
      return [["Str", tx], pos + 1]
    else
      if ty == "IDENT" then
        return [["Var", tx], pos + 1]
      else
        if (ty == "OP") and (tx == "(") then
          let inner = parse_cmp(toks, pos + 1)
          let p = inner[1]
          let t2 = toks[p]
          if (t2[0] == "OP") and (t2[1] == ")") then
            return [inner[0], p + 1]
          else
            return [["Err", "expected )"], p]
          end
        else
          return [["Err", "unexpected " + ty + " '" + tx + "'"], pos + 1]
        end
      end
    end
  end
end

make a function called parse_mul takes toks, pos returns r
  let r1 = parse_primary(toks, pos)
  let node = r1[0]
  let p = r1[1]
  let looping = true
  while looping do
    let t = toks[p]
    let ty = t[0]
    let tx = t[1]
    if (ty == "OP") and ((tx == "*") or (tx == "/") or (tx == "%")) then
      let r2 = parse_primary(toks, p + 1)
      let node = ["Bin", tx, node, r2[0]]
      let p = r2[1]
    else
      let looping = false
    end
  end
  return [node, p]
end

make a function called parse_add takes toks, pos returns r
  let r1 = parse_mul(toks, pos)
  let node = r1[0]
  let p = r1[1]
  let looping = true
  while looping do
    let t = toks[p]
    let ty = t[0]
    let tx = t[1]
    if (ty == "OP") and ((tx == "+") or (tx == "-")) then
      let r2 = parse_mul(toks, p + 1)
      let node = ["Bin", tx, node, r2[0]]
      let p = r2[1]
    else
      let looping = false
    end
  end
  return [node, p]
end

make a function called parse_cmp takes toks, pos returns r
  let r1 = parse_add(toks, pos)
  let node = r1[0]
  let p = r1[1]
  let looping = true
  while looping do
    let t = toks[p]
    let ty = t[0]
    let tx = t[1]
    if (ty == "OP") and ((tx == "==") or (tx == "!=") or (tx == "<") or (tx == "<=") or (tx == ">") or (tx == ">=")) then
      let r2 = parse_add(toks, p + 1)
      let node = ["Bin", tx, node, r2[0]]
      let p = r2[1]
    else
      let looping = false
    end
  end
  return [node, p]
end

make a function called parse_stmt takes toks, pos returns r
  let t = toks[pos]
  let ty = t[0]
  let tx = t[1]
  if (ty == "IDENT") and (tx == "let") then
    let nameTok = toks[pos + 1]
    let name = nameTok[1]
    let eqTok = toks[pos + 2]
    if (eqTok[0] == "OP") and (eqTok[1] == "=") then
      let r1 = parse_cmp(toks, pos + 3)
      return [["Let", name, r1[0]], r1[1]]
    else
      return [["Err", "expected = after let name"], pos + 1]
    end
  else
    if (ty == "IDENT") and (tx == "print") then
      let lp = toks[pos + 1]
      if (lp[0] == "OP") and (lp[1] == "(") then
        let r1 = parse_cmp(toks, pos + 2)
        let p = r1[1]
        let rp = toks[p]
        if (rp[0] == "OP") and (rp[1] == ")") then
          return [["Print", r1[0]], p + 1]
        else
          return [["Err", "expected ) after print arg"], p]
        end
      else
        return [["Err", "expected ( after print"], pos + 1]
      end
    else
      return [["Err", "unexpected token '" + tx + "'"], pos + 1]
    end
  end
end

make a function called skip_nl takes toks, pos returns p
  let p = pos
  let looping = true
  while looping do
    let t = toks[p]
    if t[0] == "NL" then
      let p = p + 1
    else
      let looping = false
    end
  end
  return p
end

make a function called parse_program takes toks returns ast
  let stmts = []
  let pos = skip_nl(toks, 0)
  let looping = true
  while looping do
    let t = toks[pos]
    if t[0] == "EOF" then
      let looping = false
    else
      let r = parse_stmt(toks, pos)
      let stmts = list_push(stmts, r[0])
      let pos = skip_nl(toks, r[1])
    end
  end
  return ["Program", stmts]
end

make a function called ast_to_str takes node returns s
  let ty = node[0]
  if ty == "Num" then
    return "Num(" + node[1] + ")"
  else
    if ty == "Str" then
      return "Str('" + node[1] + "')"
    else
      if ty == "Var" then
        return "Var(" + node[1] + ")"
      else
        if ty == "Bin" then
          return "(" + ast_to_str(node[2]) + " " + node[1] + " " + ast_to_str(node[3]) + ")"
        else
          if ty == "Let" then
            return "Let " + node[1] + " = " + ast_to_str(node[2])
          else
            if ty == "Print" then
              return "Print " + ast_to_str(node[1])
            else
              return "Err(" + node[1] + ")"
            end
          end
        end
      end
    end
  end
end
