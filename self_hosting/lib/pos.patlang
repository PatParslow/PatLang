include "context.patlang"
# =============================================================================
# Point-of-sale library (Stage 1 dialect): event-driven checkout combining
# events (scan/pay), OO (product catalog in the object store), and logic
# (dairy facts drive a discount rule). Prices are integer pence.
# =============================================================================

make a function called pos_setup takes ctx returns done
  new("Product", "apple")
  send("apple", "set", "price", 30)
  new("Product", "banana")
  send("banana", "set", "price", 25)
  new("Product", "milk")
  send("milk", "set", "price", 120)
  fact("dairy", "milk", "yes")
  fact("dairy", "cheese", "yes")
  ctx_set(ctx, "total", 0)
  ctx_set(ctx, "items", 0)
  ctx_set(ctx, "receipt", "")
  goal("serve_customer", "till-1")
  return true
end

make a function called pos_scan takes ctx, item returns price
  let price = get(item, "price")
  if not price then
    print("  unknown item: " + item)
    return 0
  end
  if query("dairy", item, 0) > 0 then
    # dairy discount: 10% off
    let price = price * 9 / 10
  end
  ctx_set(ctx, "total", ctx_num(ctx, "total") + price)
  ctx_set(ctx, "items", ctx_num(ctx, "items") + 1)
  ctx_set(ctx, "receipt", ctx_text(ctx, "receipt") + "  " + item + "  " + price + "p\n")
  return price
end

make a function called pos_total takes ctx returns t
  return ctx_get(ctx, "total")
end

make a function called pos_pay takes ctx, tendered returns change
  let total = ctx_get(ctx, "total")
  let change = tendered - total
  print("--- RECEIPT ---")
  print(ctx_text(ctx, "receipt") + "  items: " + ctx_text(ctx, "items"))
  print("  total: " + total + "p, tendered: " + tendered + "p, change: " + change + "p")
  return change
end

let ctx = context_new()
context_hold(ctx)

when scan do
  let ctx = context_held()
  pos_scan(ctx, event_data)
end

when pay do
  let ctx = context_held()
  pos_pay(ctx, event_data)
end
