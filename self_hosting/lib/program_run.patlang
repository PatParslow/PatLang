# Running a program a test has written, and checking what it printed.
#
# run_interpreted(path) and run_compiled(src, exe) run it with v2 (from the
# repository root) and give [whether it exited 0, what it wrote to standard
# output]; run_compiled builds with v2.exe first and gives [false, the build's
# output] when the build fails.
#
# printed(out, expected) is whether out is the lines expected, where expected
# ends in a newline. v2 prints only what the program prints. The old engines
# then printed the program's last value on one line more, so that one line is
# allowed too, and the same test holds on either.

include "includes.patlang"
include "gherkin_text.patlang"

make a function called run_interpreted takes path returns result
  let r = exec_measured("self_hosting/build/v2_interp.exe", [path])
  return [r[2], r[0]]
end

make a function called run_compiled takes src, exe returns result
  let b = exec_measured("self_hosting/build/v2.exe", [src, exe])
  if not b[2] then
    return [false, b[0] + b[1]]
  end
  let r = exec_measured(exe, [])
  return [r[2], r[0]]
end

# Whether a program a test needs (lean, ruby) is on the PATH. A test checks
# it with expect, so a missing tool fails as itself, by name, and the test's
# other checks still run.
make a function called has_program takes name returns yes
  let r = exec_measured("where", [name])
  return r[2]
end

make a function called printed takes out, expected returns yes
  if out == expected then return true end
  if not str_starts_with(out, expected) then return false end
  let rest = substr(out, expected.length, out.length - expected.length)
  # one line more: text ending in a newline, with no other newline in it
  if not str_ends_with(rest, chr(10)) then return false end
  return not contains_text(substr(rest, 0, rest.length - 1), chr(10))
end
