# A durable, file-backed message queue -- entirely PatLang, no new Rust host
# functions. One key/file PER MESSAGE (self_hosting/lib/mailbox.patlang's own
# layout, independently reimplemented here rather than included -- queue.patlang
# is included from files that already include mailbox.patlang transitively
# [e.g. via isolate.patlang], and this codebase's include mechanism has no
# dedup, so a second copy of the SAME functions would collide; a few small
# local helpers (q_pad etc.) cost far less than that risk):
#   fs driver:  q_dir()/<topic>/<padded_id>         (plus .../.seq, the next-id counter)
#   vfs driver: /queue/<topic>/<padded_id>          (plus .../.seq)
# Each message's own file/key holds "status<TAB>payload". Originally one flat
# log file per topic (q_dir()/<topic>.log, tab-separated id/status/payload
# lines, rewritten WHOLE on every publish/ack/consume) -- GitHub #120: that
# shape meant a crash mid-write during any one call could corrupt or lose
# EVERY message in the topic, not just the one being touched. Per-message
# storage means a crash only ever risks the one message actually being
# written; every other already-committed message's own file is untouched.
# This does NOT add new protection against two CONCURRENT writers to the SAME
# topic racing on the same logical operation (the id-allocation counter is
# still a single read-then-write value, same residual limitation mailbox.
# patlang's own header honestly documents for its own counter) -- the
# established mitigation for that, unchanged, is still queue_writer_topic:
# give each writer its own topic so no two writers ever touch the same
# message set at all.
#
# An existing topic in the OLD flat-log shape is migrated the first time
# ANY call touches it (q_migrate_if_old): its rows are read once, written
# into the new per-message layout, and the old file/key is removed -- so a
# live system upgrading across this change loses nothing already durably
# published, and every topic ends up in exactly one place after its first
# touch post-upgrade, not two formats checked forever.
#
# The saga/contract-shaped wrapper (queue_attempt) realizes the pattern:
# intent = require, attempt = do the risky thing, outcome = ensure. If the
# wrapped function aborts (PatLang has no try/catch -- a host error is
# still fatal, unchanged by this library), the intent message is simply
# left "pending" on disk for a later run (or a dedicated recovery pass) to
# find via queue_pending and decide whether to retry or compensate.
#
# Storage driver: the log lives in real files ("fs", durable across
# processes) wherever host_caps() lists "fs", and in the in-memory VFS
# ("vfs", every target including the browser, gone when the world ends)
# where it does not. queue_use_driver("vfs") or queue_use_driver("fs")
# forces one; every queue_* call behaves the same on either.
#
# NOTE on style: q_dir() is a function, not a top-level `let`, for the same
# reason build_daemon.patlang's "constants" all are -- see that file's own
# header comment and [[patlang-backlog]] item 10.

include "includes.patlang"

make a function called q_dir returns path
  return ".patlang_queue"
end

# OLD flat-file-per-topic path/key -- kept only for one-time migration
# (q_migrate_if_old) and queue_remove_topic's own belt-and-suspenders
# cleanup; no longer written to by anything.
make a function called q_file takes topic returns path
  return q_dir() + "/" + topic + ".log"
end

make a function called q_key takes topic returns key
  return "/queue/" + topic + ".log"
end

# "fs" or "vfs": the forced driver if queue_use_driver was called, else "fs"
# when this runtime has files and "vfs" when it does not.
make a function called queue_driver returns name
  let forced = "" + get("__vars", "__queue_driver")
  if forced != "" then return forced end
  let caps = host_caps()
  let i = 0
  while i < list_len(caps) do
    if caps[i] == "fs" then return "fs" end
    let i = i + 1
  end
  return "vfs"
end

make a function called queue_use_driver takes name returns done
  set_var("__queue_driver", name)
  return true
end

make a function called q_tab returns t
  return chr(9)
end

# Split an OLD-format flat-log line into [id, status, payload]. Only used
# by the one-time migration read now (q_read_old_fs/q_read_old_vfs);
# everything else goes through the new per-message layout directly.
make a function called q_parse_line takes line returns fields
  let t = q_tab()
  let first = find_substr_queue(line, t)
  if first < 0 then
    return ["", "", ""]
  end
  let rest = substr(line, first + 1, line.length - first - 1)
  let second = find_substr_queue(rest, t)
  if second < 0 then
    return [substr(line, 0, first), rest, ""]
  end
  let id = substr(line, 0, first)
  let status = substr(rest, 0, second)
  let payload = substr(rest, second + 1, rest.length - second - 1)
  return [id, status, payload]
end

make a function called find_substr_queue takes hay, needle returns idx
  let hn = hay.length
  let nn = needle.length
  if nn == 0 then
    return 0
  end
  let i = 0
  while i <= hn - nn do
    if substr(hay, i, nn) == needle then
      return i
    end
    let i = i + 1
  end
  return -1
end

# ---- new per-message storage (mailbox-shaped) ----

make a function called q_msg_dir takes topic returns path
  return q_dir() + "/" + topic
end

make a function called q_msg_prefix takes topic returns prefix
  return "/queue/" + topic + "/"
end

make a function called q_pad takes n returns text
  let s = "" + n
  while s.length < 10 do
    let s = "0" + s
  end
  return s
end

make a function called q_counter_path takes topic returns path
  return q_msg_dir(topic) + "/.seq"
end

make a function called q_counter_key takes topic returns key
  return q_msg_prefix(topic) + ".seq"
end

make a function called q_pack_status_payload takes status, payload returns text
  return status + q_tab() + payload
end

make a function called q_unpack_status_payload takes text returns pair
  let sep = find_substr_queue(text, q_tab())
  if sep < 0 then
    return ["", text]
  end
  return [substr(text, 0, sep), substr(text, sep + 1, text.length - sep - 1)]
end

make a function called q_get_counter takes topic returns next_id
  if queue_driver() == "vfs" then
    if vfs_exists(q_counter_key(topic)) == "1" then
      return to_num(vfs_read(q_counter_key(topic)))
    end
    return 0
  end
  if file_exists(q_counter_path(topic)) == true then
    return to_num(read_file(q_counter_path(topic)))
  end
  return 0
end

make a function called q_set_counter takes topic, next_id returns done
  if queue_driver() == "vfs" then
    vfs_write(q_counter_key(topic), "" + next_id)
  else
    write_file(q_counter_path(topic), "" + next_id)
  end
  return true
end

make a function called q_put_message takes topic, id, status, payload returns done
  let text = q_pack_status_payload(status, payload)
  if queue_driver() == "vfs" then
    vfs_write(q_msg_prefix(topic) + q_pad(id), text)
  else
    write_file(q_msg_dir(topic) + "/" + q_pad(id), text)
  end
  return true
end

make a function called q_delete_message takes topic, padded_id returns done
  if queue_driver() == "vfs" then
    vfs_delete(q_msg_prefix(topic) + padded_id)
  else
    remove_file(q_msg_dir(topic) + "/" + padded_id)
  end
  return true
end

make a function called q_read_message takes topic, padded_id returns text
  if queue_driver() == "vfs" then
    return vfs_read(q_msg_prefix(topic) + padded_id)
  end
  return read_file(q_msg_dir(topic) + "/" + padded_id)
end

# Padded message ids for a topic, oldest first (vfs_list/list_dir are both
# already sorted, and equal-width zero-padded ids sort identically as
# strings or numbers).
make a function called q_message_ids takes topic returns ids
  if queue_driver() == "vfs" then
    let prefix = q_msg_prefix(topic)
    let keys = vfs_list(prefix)
    let out = []
    let i = 0
    while i < list_len(keys) do
      let suf = substr(keys[i], prefix.length, keys[i].length - prefix.length)
      if suf != ".seq" then
        let out = list_push(out, suf)
      end
      let i = i + 1
    end
    return out
  end
  if file_exists(q_msg_dir(topic)) != true then
    return []
  end
  let entries = list_dir(q_msg_dir(topic))
  let out = []
  let i = 0
  while i < list_len(entries) do
    if entries[i] != ".seq" then
      let out = list_push(out, entries[i])
    end
    let i = i + 1
  end
  return out
end

make a function called q_list_contains takes xs, v returns found
  let i = 0
  while i < list_len(xs) do
    if xs[i] == v then return true end
    let i = i + 1
  end
  return false
end

# ---- one-time migration from the old flat-log shape ----

make a function called q_parse_raw takes raw returns rows
  let lines = split_lines(raw)
  let out = []
  let i = 0
  let n = to_num(list_len(lines))
  while i < n do
    let line = str_trim(lines[i])
    if line.length > 0 then
      let out = list_push(out, q_parse_line(line))
    end
    let i = i + 1
  end
  return out
end

make a function called q_read_old_fs takes topic returns rows
  if file_exists(q_file(topic)) != true then
    return []
  end
  return q_parse_raw(read_file(q_file(topic)))
end

make a function called q_read_old_vfs takes topic returns rows
  if vfs_exists(q_key(topic)) != "1" then
    return []
  end
  return q_parse_raw(vfs_read(q_key(topic)))
end

# Writes a full [id, status, payload] row list into the new per-message
# layout from scratch, and advances the topic's counter past the highest
# id written (never backward). Used by migration and by q_write below.
make a function called q_write_rows_new takes topic, rows returns done
  let i = 0
  let n = to_num(list_len(rows))
  let max_id = -1
  while i < n do
    let row = rows[i]
    let id = to_num(row[0])
    if id > max_id then
      let max_id = id
    end
    q_put_message(topic, id, row[1], row[2])
    let i = i + 1
  end
  if max_id + 1 > q_get_counter(topic) then
    q_set_counter(topic, max_id + 1)
  end
  return true
end

make a function called q_migrate_if_old takes topic returns done
  if queue_driver() == "vfs" then
    if vfs_exists(q_key(topic)) == "1" then
      q_write_rows_new(topic, q_read_old_vfs(topic))
      vfs_delete(q_key(topic))
    end
  else
    if file_exists(q_file(topic)) == true then
      q_write_rows_new(topic, q_read_old_fs(topic))
      remove_file(q_file(topic))
    end
  end
  return true
end

# ---- public read/write (queue_publish/consume/ack/pending, and
# task_registry.patlang's own direct calls, are all built on just these
# two -- unchanged contract from the caller's point of view) ----

# Read a topic's rows as [id, status, payload] triples, oldest first.
# Returns [] if the topic has no messages yet.
make a function called q_read takes topic returns rows
  q_migrate_if_old(topic)
  let ids = q_message_ids(topic)
  let out = []
  let i = 0
  let n = to_num(list_len(ids))
  while i < n do
    let padded = ids[i]
    let unpacked = q_unpack_status_payload(q_read_message(topic, padded))
    let out = list_push(out, ["" + to_num(padded), unpacked[0], unpacked[1]])
    let i = i + 1
  end
  return out
end

# Replaces a topic's entire content with exactly these rows -- any
# existing message not present in `rows` is removed. This is the exact
# semantics task_registry.patlang's own direct q_write(topic, [[0, ...]])
# call relies on (the presence-beacon idiom: "this topic holds only its
# latest state"), and what queue_ack below reconstructs internally.
make a function called q_write takes topic, rows returns done
  q_migrate_if_old(topic)
  let existing = q_message_ids(topic)
  let keep = []
  let i = 0
  let n = to_num(list_len(rows))
  while i < n do
    let row = rows[i]
    let id = to_num(row[0])
    q_put_message(topic, id, row[1], row[2])
    let keep = list_push(keep, q_pad(id))
    let i = i + 1
  end
  let j = 0
  let en = to_num(list_len(existing))
  while j < en do
    if q_list_contains(keep, existing[j]) == false then
      q_delete_message(topic, existing[j])
    end
    let j = j + 1
  end
  let max_id = -1
  let k = 0
  while k < n do
    let rid = to_num(rows[k][0])
    if rid > max_id then
      let max_id = rid
    end
    let k = k + 1
  end
  if max_id + 1 > q_get_counter(topic) then
    q_set_counter(topic, max_id + 1)
  end
  return true
end

# queue_publish(topic, payload) -> msg_id (as a string). Appends a new
# "pending" message.
make a function called queue_publish takes topic, payload returns msg_id
  q_migrate_if_old(topic)
  let new_id = q_get_counter(topic)
  q_put_message(topic, new_id, "pending", payload)
  q_set_counter(topic, new_id + 1)
  return new_id
end

# queue_consume(topic) -> payload of the oldest pending message, or "" if
# none pending. Does NOT ack -- call queue_ack once the message has
# genuinely been handled, so a crash between consume and ack leaves it
# recoverable rather than silently lost.
make a function called queue_consume takes topic returns payload
  let rows = q_read(topic)
  let i = 0
  let n = to_num(list_len(rows))
  while i < n do
    let row = rows[i]
    if row[1] == "pending" then
      return row[2]
    end
    let i = i + 1
  end
  return ""
end

# queue_ack(topic, msg_id) -> marks the given message acked (rewrites
# only that one message's own file/key, not the whole topic).
make a function called queue_ack takes topic, msg_id returns done
  q_migrate_if_old(topic)
  let padded = q_pad(to_num(msg_id))
  let existing = q_message_ids(topic)
  if q_list_contains(existing, padded) == false then
    return true
  end
  let unpacked = q_unpack_status_payload(q_read_message(topic, padded))
  q_put_message(topic, to_num(msg_id), "acked", unpacked[1])
  return true
end

# queue_pending(topic) -> list of message ids still pending. What makes the
# queue "resumable": on a fresh process, this is simply whatever is still
# unacked, read straight from storage -- no separate load/restore step.
make a function called queue_pending takes topic returns ids
  let rows = q_read(topic)
  let out = []
  let i = 0
  let n = to_num(list_len(rows))
  while i < n do
    let row = rows[i]
    if row[1] == "pending" then
      let out = list_push(out, row[0])
    end
    let i = i + 1
  end
  return out
end

# queue_remove_topic(topic) -> done. Fully removes every message and the
# topic's own counter, so the next publish starts completely fresh (ids
# restart at 0). For test/spec fixture resets: truncating or deleting the
# old q_file(topic) path no longer has any effect once a topic is in the
# new per-message layout, so anything that used to reset a topic that way
# should call this instead.
make a function called queue_remove_topic takes topic returns done
  q_migrate_if_old(topic)
  if queue_driver() == "vfs" then
    if vfs_exists(q_key(topic)) == "1" then
      vfs_delete(q_key(topic))
    end
    let keys = vfs_list(q_msg_prefix(topic))
    let i = 0
    while i < list_len(keys) do
      vfs_delete(keys[i])
      let i = i + 1
    end
    return true
  end
  if file_exists(q_file(topic)) == true then
    remove_file(q_file(topic))
  end
  if file_exists(q_msg_dir(topic)) == true then
    let entries = list_dir(q_msg_dir(topic))
    let i = 0
    while i < list_len(entries) do
      remove_file(q_msg_dir(topic) + "/" + entries[i])
      let i = i + 1
    end
    remove_file(q_msg_dir(topic))
  end
  return true
end

# queue_list_topics() -> every topic name with any content, old or new
# format, de-duplicated. Replaces the old idiom of a caller scanning
# list_dir(q_dir()) and stripping ".log" itself (task_registry.patlang
# used to do exactly that -- a direct dependency on this module's own
# on-disk shape that this migration would otherwise have broken).
# list_dir suffixes directory entries with "/" (hosts.rs's own host_
# list_dir), which is what distinguishes a new-format topic directory
# from an old, not-yet-migrated ".log" file here.
make a function called queue_list_topics returns topics
  if queue_driver() == "vfs" then
    return q_list_topics_vfs()
  end
  if file_exists(q_dir()) != true then
    return []
  end
  let entries = list_dir(q_dir())
  let out = []
  let i = 0
  let n = to_num(list_len(entries))
  while i < n do
    let entry = entries[i]
    if str_ends_with(entry, "/") then
      let out = list_push(out, substr(entry, 0, entry.length - 1))
    elif str_ends_with(entry, ".log") then
      let out = list_push(out, substr(entry, 0, entry.length - 4))
    end
    let i = i + 1
  end
  return out
end

make a function called q_list_topics_vfs returns topics
  let keys = vfs_list("/queue/")
  let seen = []
  let out = []
  let i = 0
  while i < list_len(keys) do
    let rel = substr(keys[i], 7, keys[i].length - 7)
    let topic = ""
    if str_ends_with(rel, ".log") then
      let topic = substr(rel, 0, rel.length - 4)
    else
      let slash = find_substr_queue(rel, "/")
      if slash >= 0 then
        let topic = substr(rel, 0, slash)
      end
    end
    if (topic != "") and (q_list_contains(seen, topic) == false) then
      let seen = list_push(seen, topic)
      let out = list_push(out, topic)
    end
    let i = i + 1
  end
  return out
end

# ---- multi-topic reads, for the "give every writer its own topic" idiom ----
#
# PatLang has no locking primitive, so a topic shared between multiple
# concurrent writers can still race on id allocation (unchanged by the
# per-message storage above -- see this file's own header). The idiomatic
# fix isn't locking -- it's giving each writer its own topic name (e.g.
# queue_writer_topic below: a base name plus the writer's own identity) so
# no two writers ever touch the same message set at all. A reader that
# needs the combined stream then reads across that whole family of topics
# with the functions below, rather than one consumer trying to read one
# shared, contended topic.

# queue_writer_topic(base, writer_id) -> a topic name namespaced to one
# writer, e.g. queue_writer_topic("orders", "worker_1") -> "orders__worker_1".
# Purely a naming convention -- any unique-per-writer string works, this
# just gives it one canonical shape so producers and consumers agree.
make a function called queue_writer_topic takes base, writer_id returns topic
  return base + "__" + writer_id
end

# queue_pending_multi(topics) -> list of [topic, msg_id] pairs, one per
# still-pending message across every topic in the given list, in the order
# the topics were given (and id order within each topic).
make a function called queue_pending_multi takes topics returns pairs
  let out = []
  let t = 0
  let tn = to_num(list_len(topics))
  while t < tn do
    let topic = topics[t]
    let ids = queue_pending(topic)
    let i = 0
    let n = to_num(list_len(ids))
    while i < n do
      let out = list_push(out, [topic, ids[i]])
      let i = i + 1
    end
    let t = t + 1
  end
  return out
end

# queue_consume_multi(topics) -> [topic, payload] for the oldest pending
# message in the FIRST topic (in list order) that has one; ["", ""] if none
# of the given topics have anything pending. Simple "check topics in order"
# semantics -- there's no id shared across topics, so no attempt is made to
# merge them into one global time order.
make a function called queue_consume_multi takes topics returns result
  let t = 0
  let tn = to_num(list_len(topics))
  while t < tn do
    let topic = topics[t]
    let payload = queue_consume(topic)
    if payload != "" then
      return [topic, payload]
    end
    let t = t + 1
  end
  return ["", ""]
end

# queue_attempt(topic, payload, action) -> result of action(). Publishes an
# intent message before calling action, acks it once action returns
# normally. If action aborts (fatal host error -- PatLang has no
# try/catch, this doesn't change that), the intent message stays
# "pending" on disk for a later run to find via queue_pending and retry
# or compensate.
make a function called queue_attempt takes topic, payload, action returns result
  let msg_id = queue_publish(topic, payload)
  let result = action()
  queue_ack(topic, msg_id)
  return result
end
