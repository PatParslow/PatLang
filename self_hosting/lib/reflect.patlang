# =============================================================================
# Reflection: source -> AST -> JSON, entirely self-hosted.
#
# Reuses the EXISTING self-hosted frontend (lib/lexer.patlang + lib/
# parser.patlang, already producing the documented tagged-tuple AST shapes --
# see the comment block at the top of parser.patlang) rather than depending
# on the native Rust ast.rs/serde machinery or the parse_tiny_source/
# lower_and_compile meta-compilation host calls. A PatLang program reflects
# on source (its own or another file's) by literally reusing the same
# compiler frontend it already has.
#
# `ast_node_to_json` mirrors `ast_to_str` (parser.patlang's own AST pretty
# printer, right above this file's usual include point) node-for-node --
# same tag dispatch, same nesting -- just building a JSON object per node
# instead of a human-readable string. Keeping the two structurally identical
# makes it easy to see nothing was missed when a new node shape is added to
# the parser in the future.
#
# Reuses json_quote/json_escape from lib/json.patlang for string escaping;
# does not reuse json_parse (this is one-way: AST -> JSON text only).
# =============================================================================

make a function called ast_str_list_to_json takes items returns s
  let b = sb_new()
  sb_push(b, "[")
  let i = 0
  while i < items.length do
    if i > 0 then
      sb_push(b, ",")
    end
    sb_push(b, json_quote(items[i]))
    let i = i + 1
  end
  sb_push(b, "]")
  return sb_str(b)
end

make a function called ast_list_to_json takes nodes returns s
  let b = sb_new()
  sb_push(b, "[")
  let i = 0
  while i < nodes.length do
    if i > 0 then
      sb_push(b, ",")
    end
    sb_push(b, ast_node_to_json(nodes[i]))
    let i = i + 1
  end
  sb_push(b, "]")
  return sb_str(b)
end

make a function called ast_node_to_json takes node returns s
  let ty = node[0]
  if ty == "Num" then
    return "{" + json_quote("type") + ":" + json_quote("Num") + "," + json_quote("value") + ":" + json_quote(node[1]) + "}"
  else
    if ty == "Str" then
      return "{" + json_quote("type") + ":" + json_quote("Str") + "," + json_quote("value") + ":" + json_quote(node[1]) + "}"
    else
      if ty == "Bool" then
        return "{" + json_quote("type") + ":" + json_quote("Bool") + "," + json_quote("value") + ":" + json_quote(node[1]) + "}"
      else
        if ty == "Var" then
          return "{" + json_quote("type") + ":" + json_quote("Var") + "," + json_quote("name") + ":" + json_quote(node[1]) + "}"
        else
          if ty == "Bin" then
            return "{" + json_quote("type") + ":" + json_quote("Bin") + "," + json_quote("op") + ":" + json_quote(node[1]) + "," + json_quote("left") + ":" + ast_node_to_json(node[2]) + "," + json_quote("right") + ":" + ast_node_to_json(node[3]) + "}"
          else
            if ty == "Un" then
              return "{" + json_quote("type") + ":" + json_quote("Un") + "," + json_quote("op") + ":" + json_quote(node[1]) + "," + json_quote("expr") + ":" + ast_node_to_json(node[2]) + "}"
            else
              if ty == "Call" then
                return "{" + json_quote("type") + ":" + json_quote("Call") + "," + json_quote("name") + ":" + json_quote(node[1]) + "," + json_quote("args") + ":" + ast_list_to_json(node[2]) + "}"
              else
                if ty == "Closure" then
                  return "{" + json_quote("type") + ":" + json_quote("Closure") + "," + json_quote("params") + ":" + ast_str_list_to_json(node[1]) + "," + json_quote("body") + ":" + ast_list_to_json(node[2]) + "}"
                else
                  if ty == "List" then
                    return "{" + json_quote("type") + ":" + json_quote("List") + "," + json_quote("items") + ":" + ast_list_to_json(node[1]) + "}"
                  else
                    if ty == "Index" then
                      return "{" + json_quote("type") + ":" + json_quote("Index") + "," + json_quote("object") + ":" + ast_node_to_json(node[1]) + "," + json_quote("index") + ":" + ast_node_to_json(node[2]) + "}"
                    else
                      if ty == "Member" then
                        return "{" + json_quote("type") + ":" + json_quote("Member") + "," + json_quote("object") + ":" + ast_node_to_json(node[1]) + "," + json_quote("property") + ":" + json_quote(node[2]) + "}"
                      else
                        if ty == "Let" then
                          return "{" + json_quote("type") + ":" + json_quote("Let") + "," + json_quote("name") + ":" + json_quote(node[1]) + "," + json_quote("value") + ":" + ast_node_to_json(node[2]) + "}"
                        else
                          if ty == "Expr" then
                            return "{" + json_quote("type") + ":" + json_quote("Expr") + "," + json_quote("expr") + ":" + ast_node_to_json(node[1]) + "}"
                          else
                            if ty == "If" then
                              return "{" + json_quote("type") + ":" + json_quote("If") + "," + json_quote("cond") + ":" + ast_node_to_json(node[1]) + "," + json_quote("then") + ":" + ast_list_to_json(node[2]) + "," + json_quote("else") + ":" + ast_list_to_json(node[3]) + "}"
                            else
                              if ty == "While" then
                                return "{" + json_quote("type") + ":" + json_quote("While") + "," + json_quote("cond") + ":" + ast_node_to_json(node[1]) + "," + json_quote("body") + ":" + ast_list_to_json(node[2]) + "}"
                              else
                                if ty == "Func" then
                                  return "{" + json_quote("type") + ":" + json_quote("Func") + "," + json_quote("name") + ":" + json_quote(node[1]) + "," + json_quote("params") + ":" + ast_str_list_to_json(node[2]) + "," + json_quote("body") + ":" + ast_list_to_json(node[3]) + "}"
                                else
                                  if ty == "Return" then
                                    return "{" + json_quote("type") + ":" + json_quote("Return") + "," + json_quote("expr") + ":" + ast_node_to_json(node[1]) + "}"
                                  else
                                    if ty == "When" then
                                      return "{" + json_quote("type") + ":" + json_quote("When") + "," + json_quote("event") + ":" + json_quote(node[1]) + "," + json_quote("body") + ":" + ast_list_to_json(node[2]) + "}"
                                    else
                                      if ty == "Assert" then
                                        return "{" + json_quote("type") + ":" + json_quote("Assert") + "," + json_quote("kind") + ":" + json_quote(node[1]) + "," + json_quote("expr") + ":" + ast_node_to_json(node[2]) + "}"
                                      else
                                        # "Err" (parse error placeholder) and any future/unknown tag
                                        # both fall through here rather than aborting reflection --
                                        # a caller inspecting the JSON can check for "type":"Err" and
                                        # read "message" to see what didn't parse.
                                        return "{" + json_quote("type") + ":" + json_quote("Err") + "," + json_quote("message") + ":" + json_quote(node[1]) + "}"
                                      end
                                    end
                                  end
                                end
                              end
                            end
                          end
                        end
                      end
                    end
                  end
                end
              end
            end
          end
        end
      end
    end
  end
end

# ast_program_to_json(program): program is the ["Program", stmts] shape
# `parse_program` returns.
make a function called ast_program_to_json takes program returns s
  return "{" + json_quote("type") + ":" + json_quote("Program") + "," + json_quote("body") + ":" + ast_list_to_json(program[1]) + "}"
end

# reflect_source(src) -> a JSON string describing src's AST. The single
# documented entry point for reflection: tokenizes and parses src through
# the real self-hosted frontend, then serializes the result. Assumes
# lib/lexer.patlang and lib/parser.patlang are already included by the
# caller (this file only adds the AST->JSON step, matching lib/json.patlang's
# own include-order convention).
make a function called reflect_source takes src returns json
  let toks = tokenize(src)
  let ast = parse_program(toks)
  return ast_program_to_json(ast)
end
