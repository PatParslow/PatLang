  sb_push(b, "                    }" + nl())
  sb_push(b, "                    _ => Ok(Value::Unit)," + nl())
  sb_push(b, "                }" + nl())
  sb_push(b, "            }" + nl())
  sb_push(b, "                    _ => Err(format!(" + q() + "host fn '{}' not found" + q() + ", name))," + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "fn host_call_oo(name: &str, args: &[Value]) -> Option<Result<Value, String>> {" + nl())
  sb_push(b, "    match name {" + nl())
  sb_push(b, "        " + q() + "new" + q() + " | " + q() + "set_var" + q() + " | " + q() + "get" + q() + " | " + q() + "send" + q() + " => Some(host_call_oo_inner(name, args))," + nl())
