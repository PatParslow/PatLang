make a function called emit_runtime_rs_logic_0 takes b returns done
  sb_push(b, "thread_local! {" + nl())
  sb_push(b, "    static FACTS: RefCell<HashMap<String, Vec<(String, String)>>> = RefCell::new(HashMap::new());" + nl())
  sb_push(b, "    static GOALS: RefCell<Vec<(String, Vec<String>)>> = RefCell::new(Vec::new());" + nl())
  sb_push(b, "    static TYPE_RULES: RefCell<HashMap<(String, usize), String>> = RefCell::new(HashMap::new());" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "fn host_call_logic_inner(name: &str, args: &[Value]) -> Result<Value, String> {" + nl())
  sb_push(b, "    match name {" + nl())
  sb_push(b, q() + "infer_type_for" + q() + " => {" + nl())
  sb_push(b, "                // args: pred, index, class" + nl())
  sb_push(b, "                if args.len() != 3 { return Ok(Value::Unit); }" + nl())
  sb_push(b, "                let pred = match &args[0] { Value::String(s) => s.clone(), _ => String::new() };" + nl())
  sb_push(b, "                let idx = match &args[1] { Value::Number(n) => *n as usize, Value::String(s) => s.parse::<usize>().unwrap_or(0), _ => 0 };" + nl())
  sb_push(b, "                let class = match &args[2] { Value::String(s) => s.clone(), _ => String::new() };" + nl())
  sb_push(b, "                TYPE_RULES.with(|tr| { tr.borrow_mut().insert((pred, idx), class); });" + nl())
  sb_push(b, "                Ok(Value::Unit)" + nl())
  sb_push(b, "            }" + nl())
  sb_push(b, "            " + q() + "fact" + q() + " => {" + nl())
  sb_push(b, "                if args.len() != 3 { return Ok(Value::Unit); }" + nl())
  sb_push(b, "                let pred = match &args[0] { Value::String(s) => s.clone(), _ => String::new() };" + nl())
  sb_push(b, "                let a = to_s(args.get(1).unwrap_or(&Value::Unit));" + nl())
  sb_push(b, "                let b = to_s(args.get(2).unwrap_or(&Value::Unit));" + nl())
  sb_push(b, "                FACTS.with(|f| {" + nl())
  sb_push(b, "                    let mut m = f.borrow_mut();" + nl())
  sb_push(b, "                    m.entry(pred).or_insert_with(Vec::new).push((a, b));" + nl())
  sb_push(b, "                });" + nl())
  sb_push(b, "                Ok(Value::Unit)" + nl())
  sb_push(b, "            }" + nl())
  sb_push(b, "            " + q() + "goal" + q() + " => {" + nl())
  sb_push(b, "                if args.is_empty() { return Ok(Value::Unit); }" + nl())
  sb_push(b, "                let pred = match &args[0] { Value::String(s) => s.clone(), _ => String::new() };" + nl())
  sb_push(b, "                let mut items: Vec<String> = Vec::new();" + nl())
  sb_push(b, "                for a in &args[1..] { items.push(to_s(a)); }" + nl())
  sb_push(b, "                GOALS.with(|g| { g.borrow_mut().push((pred, items)); });" + nl())
  sb_push(b, "                Ok(Value::Unit)" + nl())
  sb_push(b, "            }" + nl())
  sb_push(b, "            " + q() + "query" + q() + " => {" + nl())
  sb_push(b, "                if args.len() != 3 { return Ok(Value::Number(0.0)); }" + nl())
  sb_push(b, "                let pred = match &args[0] { Value::String(s) => s.clone(), _ => String::new() };" + nl())
  sb_push(b, "                let a = to_s(args.get(1).unwrap_or(&Value::Unit));" + nl())
  sb_push(b, "                let mut count = 0usize;" + nl())
  sb_push(b, "                let mut bs: Vec<String> = Vec::new();" + nl())
  sb_push(b, "                FACTS.with(|f| {" + nl())
  sb_push(b, "                    if let Some(v) = f.borrow().get(&pred) {" + nl())
  sb_push(b, "                        for (x, b) in v.iter() {" + nl())
  sb_push(b, "                            if x == &a { count += 1; bs.push(b.clone()); }" + nl())
  sb_push(b, "                        }" + nl())
  sb_push(b, "                    }" + nl())
  sb_push(b, "                });" + nl())
  sb_push(b, "                // Apply simple type inference rules recorded" + nl())
  sb_push(b, "                TYPE_RULES.with(|tr| {" + nl())
  sb_push(b, "                    let rules = tr.borrow();" + nl())
  sb_push(b, "                    if let Some(class0) = rules.get(&(pred.clone(), 0usize)) { ensure_obj(&a, class0); }" + nl())
  sb_push(b, "                    if let Some(class1) = rules.get(&(pred.clone(), 1usize)) {" + nl())
  sb_push(b, "                        for b in bs.iter() { ensure_obj(b, class1); }" + nl())
  sb_push(b, "                    }" + nl())
  sb_push(b, "                });" + nl())
  sb_push(b, "                Ok(Value::Number(count as f64))" + nl())
  sb_push(b, "            }" + nl())
  sb_push(b, "                    _ => Err(format!(" + q() + "host fn '{}' not found" + q() + ", name))," + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "fn host_call_logic(name: &str, args: &[Value]) -> Option<Result<Value, String>> {" + nl())
  sb_push(b, "    match name {" + nl())
  sb_push(b, "        " + q() + "infer_type_for" + q() + " | " + q() + "fact" + q() + " | " + q() + "goal" + q() + " | " + q() + "query" + q() + " => Some(host_call_logic_inner(name, args))," + nl())
  sb_push(b, "        _ => None," + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  return true
end

