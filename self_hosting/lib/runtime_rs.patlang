  sb_push(b, "        }" + nl())
  sb_push(b, "        let quotient_sign_positive = self.sign == other.sign;" + nl())
  sb_push(b, "        let quotient = BigIntT {" + nl())
  sb_push(b, "            sign: if quotient_limbs.iter().all(|&x| x == 0) { Sign::Zero } else if quotient_sign_positive { Sign::Positive } else { Sign::Negative }," + nl())
  sb_push(b, "            limbs: quotient_limbs," + nl())
  sb_push(b, "        }.normalize();" + nl())
  sb_push(b, "        let remainder = if remainder.is_zero() { BigIntT::zero() } else { BigIntT { sign: self.sign, limbs: remainder.limbs }.normalize() };" + nl())
  sb_push(b, "        (quotient, remainder)" + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "    fn mul_by_base(&self) -> BigIntT {" + nl())
  sb_push(b, "        if self.is_zero() { return BigIntT::zero(); }" + nl())
  sb_push(b, "        let mut limbs = Vec::with_capacity(self.limbs.len() + 1);" + nl())
  sb_push(b, "        limbs.push(0);" + nl())
  sb_push(b, "        limbs.extend_from_slice(&self.limbs);" + nl())
  sb_push(b, "        BigIntT { sign: self.sign, limbs }.normalize()" + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "    fn cmp(&self, other: &BigIntT) -> std::cmp::Ordering {" + nl())
  sb_push(b, "        use Sign::*;" + nl())
  sb_push(b, "        match (self.sign, other.sign) {" + nl())
  sb_push(b, "            (Zero, Zero) => std::cmp::Ordering::Equal," + nl())
  sb_push(b, "            (Zero, Positive) => std::cmp::Ordering::Less," + nl())
  sb_push(b, "            (Zero, Negative) => std::cmp::Ordering::Greater," + nl())
  sb_push(b, "            (Positive, Zero) => std::cmp::Ordering::Greater," + nl())
  sb_push(b, "            (Negative, Zero) => std::cmp::Ordering::Less," + nl())
  sb_push(b, "            (Positive, Negative) => std::cmp::Ordering::Greater," + nl())
  sb_push(b, "            (Negative, Positive) => std::cmp::Ordering::Less," + nl())
  sb_push(b, "            (Positive, Positive) => Self::cmp_mag(&self.limbs, &other.limbs)," + nl())
  sb_push(b, "            (Negative, Negative) => Self::cmp_mag(&other.limbs, &self.limbs)," + nl())
  sb_push(b, "        }" + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "    fn eq(&self, other: &BigIntT) -> bool { self.cmp(other) == std::cmp::Ordering::Equal }" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "impl std::fmt::Display for BigIntT { fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result { write!(f, \"{}\", self.to_string()) } }" + nl())
  sb_push(b, "impl PartialEq for BigIntT { fn eq(&self, other: &Self) -> bool { BigIntT::eq(self, other) } }" + nl())
  sb_push(b, "impl Eq for BigIntT {}" + nl())
  sb_push(b, "impl PartialOrd for BigIntT { fn partial_cmp(&self, other: &Self) -> Option<std::cmp::Ordering> { Some(self.cmp(other)) } }" + nl())
  sb_push(b, "impl Ord for BigIntT { fn cmp(&self, other: &Self) -> std::cmp::Ordering { BigIntT::cmp(self, other) } }" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "fn nt_gcd(a: &BigIntT, b: &BigIntT) -> BigIntT {" + nl())
  sb_push(b, "    let mut a = BigIntT { sign: if a.is_zero() { Sign::Zero } else { Sign::Positive }, limbs: a.limbs.clone() };" + nl())
  sb_push(b, "    let mut b = BigIntT { sign: if b.is_zero() { Sign::Zero } else { Sign::Positive }, limbs: b.limbs.clone() };" + nl())
  sb_push(b, "    while !b.is_zero() {" + nl())
  sb_push(b, "        let (_, r) = a.div_rem(&b);" + nl())
  sb_push(b, "        let r_abs = BigIntT { sign: if r.is_zero() { Sign::Zero } else { Sign::Positive }, limbs: r.limbs };" + nl())
  sb_push(b, "        a = b;" + nl())
  sb_push(b, "        b = r_abs;" + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "    a" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "// ===== RationalT/NumT/ComplexT (hand-transcribed from ir/rational_complex_template.rs, unmodified logic) =====" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "#[derive(Debug, Clone, PartialEq)]" + nl())
  sb_push(b, "struct RationalT { num: BigIntT, den: BigIntT }" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "impl RationalT {" + nl())
  sb_push(b, "    fn new(num: BigIntT, den: BigIntT) -> Self {" + nl())
  sb_push(b, "        if den.is_zero() { panic!(\"RationalT: zero denominator\"); }" + nl())
  sb_push(b, "        let (num, den) = if den.is_negative() { (num.negate(), den.negate()) } else { (num, den) };" + nl())
  sb_push(b, "        if num.is_zero() { return RationalT { num: BigIntT::zero(), den: BigIntT::from_i64(1) }; }" + nl())
  sb_push(b, "        let g = nt_gcd(&num, &den);" + nl())
  sb_push(b, "        if g.is_zero() || g.eq(&BigIntT::from_i64(1)) {" + nl())
  sb_push(b, "            RationalT { num, den }" + nl())
  sb_push(b, "        } else {" + nl())
  sb_push(b, "            let (qn, _) = num.div_rem(&g);" + nl())
  sb_push(b, "            let (qd, _) = den.div_rem(&g);" + nl())
  sb_push(b, "            RationalT { num: qn, den: qd }" + nl())
  sb_push(b, "        }" + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "    fn from_i64_pair(n: i64, d: i64) -> Self { RationalT::new(BigIntT::from_i64(n), BigIntT::from_i64(d)) }" + nl())
  sb_push(b, "    fn is_zero(&self) -> bool { self.num.is_zero() }" + nl())
  sb_push(b, "    fn add(&self, other: &RationalT) -> RationalT {" + nl())
  sb_push(b, "        let num = self.num.mul(&other.den).add(&other.num.mul(&self.den));" + nl())
  sb_push(b, "        let den = self.den.mul(&other.den);" + nl())
  sb_push(b, "        RationalT::new(num, den)" + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "    fn sub(&self, other: &RationalT) -> RationalT {" + nl())
  sb_push(b, "        let num = self.num.mul(&other.den).sub(&other.num.mul(&self.den));" + nl())
  sb_push(b, "        let den = self.den.mul(&other.den);" + nl())
  sb_push(b, "        RationalT::new(num, den)" + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "    fn mul(&self, other: &RationalT) -> RationalT { RationalT::new(self.num.mul(&other.num), self.den.mul(&other.den)) }" + nl())
  sb_push(b, "    fn div(&self, other: &RationalT) -> RationalT {" + nl())
  sb_push(b, "        if other.is_zero() { panic!(\"RationalT: division by zero\"); }" + nl())
  sb_push(b, "        RationalT::new(self.num.mul(&other.den), self.den.mul(&other.num))" + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "    fn cmp(&self, other: &RationalT) -> std::cmp::Ordering {" + nl())
  sb_push(b, "        let lhs = self.num.mul(&other.den);" + nl())
  sb_push(b, "        let rhs = other.num.mul(&self.den);" + nl())
  sb_push(b, "        lhs.cmp(&rhs)" + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "    fn eq(&self, other: &RationalT) -> bool { self.cmp(other) == std::cmp::Ordering::Equal }" + nl())
  sb_push(b, "    fn to_bigint_if_integer(&self) -> Option<BigIntT> {" + nl())
  sb_push(b, "        if self.den.eq(&BigIntT::from_i64(1)) { Some(self.num.clone()) } else { None }" + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "    fn to_f64(&self) -> f64 { nt_bigint_to_f64_lossy(&self.num) / nt_bigint_to_f64_lossy(&self.den) }" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "fn nt_bigint_to_f64_lossy(b: &BigIntT) -> f64 { b.to_string().parse::<f64>().unwrap_or(f64::NAN) }" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "#[derive(Debug, Clone, PartialEq)]" + nl())
  sb_push(b, "enum NumT { Int(i64), Float(f64), Big(BigIntT), Rat(RationalT) }" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "impl NumT {" + nl())
  sb_push(b, "    fn rank(&self) -> u8 { match self { NumT::Int(_) => 0, NumT::Big(_) => 1, NumT::Rat(_) => 2, NumT::Float(_) => 3 } }" + nl())
  sb_push(b, "    fn to_bigint(&self) -> BigIntT { match self { NumT::Int(n) => BigIntT::from_i64(*n), NumT::Big(b) => b.clone(), _ => panic!(\"NumT::to_bigint: not integer-valued\") } }" + nl())
  sb_push(b, "    fn to_rational(&self) -> RationalT {" + nl())
  sb_push(b, "        match self {" + nl())
  sb_push(b, "            NumT::Int(n) => RationalT::from_i64_pair(*n, 1)," + nl())
  sb_push(b, "            NumT::Big(b) => RationalT::new(b.clone(), BigIntT::from_i64(1))," + nl())
  sb_push(b, "            NumT::Rat(r) => r.clone()," + nl())
  sb_push(b, "            NumT::Float(_) => panic!(\"NumT::to_rational: not exact\")," + nl())
  sb_push(b, "        }" + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "    fn to_f64(&self) -> f64 {" + nl())
  sb_push(b, "        match self { NumT::Int(n) => *n as f64, NumT::Float(f) => *f, NumT::Big(b) => nt_bigint_to_f64_lossy(b), NumT::Rat(r) => r.to_f64() }" + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "    fn promote_pair(a: &NumT, b: &NumT) -> (NumT, NumT) {" + nl())
  return true
end

