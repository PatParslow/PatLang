  sb_push(b, "    Number(f64)," + nl())
  sb_push(b, "    Int(i64)," + nl())
  sb_push(b, "    Float(f64)," + nl())
  sb_push(b, "    BigInt(BigIntT)," + nl())
  sb_push(b, "    Rational(RationalT)," + nl())
  sb_push(b, "    Complex(ComplexT)," + nl())
  sb_push(b, "    String(String)," + nl())
  sb_push(b, "    List(Vec<Value>)," + nl())
