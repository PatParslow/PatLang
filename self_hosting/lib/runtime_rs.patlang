  sb_push(b, "            }" + nl())
  sb_push(b, "                    _ => Err(format!(" + q() + "host fn '{}' not found" + q() + ", name))," + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "fn host_call_contracts(name: &str, args: &[Value]) -> Option<Result<Value, String>> {" + nl())
  sb_push(b, "    match name {" + nl())
