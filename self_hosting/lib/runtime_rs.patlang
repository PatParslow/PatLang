  sb_push(b, "                let out = match args.get(1) { Some(Value::String(s)) if !s.trim().is_empty() => s.clone(), _ => return Err(\"rustc_build: expected output path\".into()) };" + nl())
  sb_push(b, "                let target = match args.get(2) { Some(Value::String(s)) if !s.trim().is_empty() => Some(s.clone()), _ => None };" + nl())
  sb_push(b, "                let opt_level = match args.get(3) { Some(Value::String(s)) if !s.trim().is_empty() => Some(s.clone()), _ => None };" + nl())
  sb_push(b, "                let mut tmp = std::env::temp_dir();" + nl())
  sb_push(b, "                tmp.push(\"patlang_selfhost_build\");" + nl())
  sb_push(b, "                std::fs::create_dir_all(&tmp).map_err(|e| format!(\"rustc_build: temp dir: {}\", e))?;" + nl())
  sb_push(b, "                let src_path = tmp.join(format!(\"gen_{}.rs\", std::process::id()));" + nl())
  sb_push(b, "                std::fs::write(&src_path, &src).map_err(|e| format!(\"rustc_build: write {}: {}\", src_path.display(), e))?;" + nl())
  sb_push(b, "                if let Some(parent) = std::path::Path::new(&out).parent() { let _ = std::fs::create_dir_all(parent); }" + nl())
  sb_push(b, "                let rustc = std::env::var(\"RUSTC\").unwrap_or_else(|_| \"rustc\".to_string());" + nl())
  sb_push(b, "                // wasm32-wasip1-threads needs a nightly toolchain (its threaded" + nl())
  sb_push(b, "                // stdlib is only prebuilt on nightly) plus atomics/shared-memory" + nl())
  sb_push(b, "                // codegen flags -- neither applies to any other target, including" + nl())
  sb_push(b, "                // the ordinary non-threaded wasm32-wasip1 build." + nl())
  sb_push(b, "                let is_threaded_wasm = target.as_deref() == Some(\"wasm32-wasip1-threads\");" + nl())
  sb_push(b, "                let mut cmd = std::process::Command::new(&rustc);" + nl())
  sb_push(b, "                if is_threaded_wasm {" + nl())
  sb_push(b, "                    cmd.arg(\"+nightly\");" + nl())
  sb_push(b, "                }" + nl())
  sb_push(b, "                // Size-optimize + strip WASM builds (measured ~7x smaller, faster" + nl())
  sb_push(b, "                // to compile, byte-identical stdout); native keeps full -O" + nl())
  sb_push(b, "                // unless the caller explicitly overrides via opt_level." + nl())
  sb_push(b, "                let is_wasm = target.as_deref().map(|t| t.contains(\"wasm\")).unwrap_or(false);" + nl())
  sb_push(b, "                if let Some(lvl) = &opt_level {" + nl())
  sb_push(b, "                    cmd.arg(\"-C\").arg(format!(\"opt-level={}\", lvl));" + nl())
  sb_push(b, "                } else if is_wasm {" + nl())
  sb_push(b, "                    cmd.arg(\"-C\").arg(\"opt-level=z\");" + nl())
  sb_push(b, "                } else {" + nl())
  sb_push(b, "                    cmd.arg(\"-O\");" + nl())
  sb_push(b, "                }" + nl())
  sb_push(b, "                cmd.arg(\"-C\").arg(\"strip=symbols\");" + nl())
  sb_push(b, "                if is_threaded_wasm {" + nl())
  sb_push(b, "                    cmd.arg(\"-C\").arg(\"target-feature=+atomics,+bulk-memory,+mutable-globals\");" + nl())
  sb_push(b, "                    cmd.arg(\"-C\").arg(\"link-args=--shared-memory --max-memory=1073741824\");" + nl())
  return true
end

