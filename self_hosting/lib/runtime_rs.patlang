  sb_push(b, "                // rename_file(from, to) -> Bool" + nl())
  sb_push(b, "                let from = match args.get(0) { Some(Value::String(s)) => s.clone(), Some(v) => display_value(v), None => String::new() };" + nl())
  sb_push(b, "                let to = match args.get(1) { Some(Value::String(s)) => s.clone(), Some(v) => display_value(v), None => String::new() };" + nl())
  sb_push(b, "                if let Some(parent) = std::path::Path::new(&to).parent() { let _ = std::fs::create_dir_all(parent); }" + nl())
  sb_push(b, "                std::fs::rename(&from, &to).map(|_| Value::Bool(true)).map_err(|e| format!(\"rename_file: {} -> {}: {}\", from, to, e))" + nl())
  sb_push(b, "            }" + nl())
  sb_push(b, "            \"exec_capture\" => {" + nl())
  sb_push(b, "                // exec_capture(path, [arg1, arg2, ...]) -> stdout of running the" + nl())
  sb_push(b, "                // program. Trailing string args are passed through as argv to" + nl())
  sb_push(b, "                // the child. If the process exits with failure, stderr is" + nl())
  sb_push(b, "                // appended too, so transcripts of failing invocations still" + nl())
  sb_push(b, "                // show the error." + nl())
  sb_push(b, "                let p = match args.get(0) { Some(Value::String(s)) => s.clone(), _ => return Err(\"exec_capture: expected program path\".into()) };" + nl())
  sb_push(b, "                let extra: Vec<String> = args[1..].iter().filter_map(|v| match v { Value::String(s) => Some(s.clone()), _ => None }).collect();" + nl())
  sb_push(b, "                let out = std::process::Command::new(&p).args(&extra).output().map_err(|e| format!(\"exec_capture: {}: {}\", p, e))?;" + nl())
  sb_push(b, "                let mut text = String::from_utf8_lossy(&out.stdout).to_string();" + nl())
  sb_push(b, "                if !out.status.success() {" + nl())
  sb_push(b, "                    let err = String::from_utf8_lossy(&out.stderr);" + nl())
  sb_push(b, "                    if !err.trim().is_empty() {" + nl())
  sb_push(b, "                        if !text.is_empty() && !text.ends_with('\\n') { text.push('\\n'); }" + nl())
  sb_push(b, "                        text.push_str(&err);" + nl())
  sb_push(b, "                    }" + nl())
  sb_push(b, "                }" + nl())
  sb_push(b, "                Ok(Value::String(text))" + nl())
  sb_push(b, "            }" + nl())
  sb_push(b, "                    _ => Err(format!(\"host fn '{}' not found\", name))," + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "fn host_call_files(name: &str, args: &[Value]) -> Option<Result<Value, String>> {" + nl())
  sb_push(b, "    match name {" + nl())
  sb_push(b, "        \"read_file\" | \"write_file\" | \"touch_file\" | \"file_exists\" | \"list_dir\" | \"rename_file\" | \"exec_capture\" => Some(host_call_files_inner(name, args))," + nl())
  sb_push(b, "        _ => None," + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  return true
end

