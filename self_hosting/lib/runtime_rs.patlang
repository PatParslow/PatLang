  sb_push(b, "        Value::Complex(c) => format!(" + q() + "{}+{}i" + q() + ", nt_num_to_string(&c.re), nt_num_to_string(&c.im))," + nl())
  sb_push(b, "        Value::String(s) => s.clone()," + nl())
  sb_push(b, "        Value::List(xs) => { let parts: Vec<String> = xs.iter().map(nt_value_to_string).collect(); format!(" + q() + "[{}]" + q() + ", parts.join(" + q() + ", " + q() + ")) }" + nl())
  sb_push(b, "        Value::Object(map) => {" + nl())
  sb_push(b, "            let mut kvs: Vec<String> = map.iter().map(|(k,v)| format!(" + q() + "{}: {}" + q() + ", k, nt_value_to_string(v))).collect();" + nl())
