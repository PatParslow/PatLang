  sb_push(b, "            limbs: quotient_limbs," + nl())
  sb_push(b, "        }.normalize();" + nl())
  sb_push(b, "        let remainder = if remainder.is_zero() { BigIntT::zero() } else { BigIntT { sign: self.sign, limbs: remainder.limbs }.normalize() };" + nl())
  sb_push(b, "        (quotient, remainder)" + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "    fn mul_by_base(&self) -> BigIntT {" + nl())
  sb_push(b, "        if self.is_zero() { return BigIntT::zero(); }" + nl())
  sb_push(b, "        let mut limbs = Vec::with_capacity(self.limbs.len() + 1);" + nl())
  sb_push(b, "        limbs.push(0);" + nl())
  sb_push(b, "        limbs.extend_from_slice(&self.limbs);" + nl())
  sb_push(b, "        BigIntT { sign: self.sign, limbs }.normalize()" + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "    fn cmp(&self, other: &BigIntT) -> std::cmp::Ordering {" + nl())
  sb_push(b, "        use Sign::*;" + nl())
  sb_push(b, "        match (self.sign, other.sign) {" + nl())
  sb_push(b, "            (Zero, Zero) => std::cmp::Ordering::Equal," + nl())
  return true
end

