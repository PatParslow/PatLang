  sb_push(b, "        (_, Value::String(sb)) => Ok(Value::String(format!(" + q() + "{}{}" + q() + ", to_s(a), sb)))," + nl())
  sb_push(b, "        _ => Ok(Value::Number(a.as_number()? + b.as_number()?))," + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "fn sub(a:&Value,b:&Value)->Result<Value,String>{ Ok(Value::Number(a.as_number()? - b.as_number()?)) }" + nl())
  sb_push(b, "fn mul(a:&Value,b:&Value)->Result<Value,String>{ Ok(Value::Number(a.as_number()? * b.as_number()?)) }" + nl())
  sb_push(b, "fn div(a:&Value,b:&Value)->Result<Value,String>{ Ok(Value::Number(a.as_number()? / b.as_number()?)) }" + nl())
  sb_push(b, "fn modu(a:&Value,b:&Value)->Result<Value,String>{ Ok(Value::Number(a.as_number()? % b.as_number()?)) }" + nl())
  sb_push(b, "fn cmp(k:&BinOpKind,a:&Value,b:&Value)->Result<Value,String>{" + nl())
