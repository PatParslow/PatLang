  sb_push(b, "                    Le => x <= y," + nl())
  sb_push(b, "                    Gt => x > y," + nl())
  sb_push(b, "                    Ge => x >= y," + nl())
  sb_push(b, "                    _ => unreachable!()," + nl())
  sb_push(b, "                }" + nl())
  sb_push(b, "            } else {" + nl())
  sb_push(b, "                let (an, bn) = (a.as_number()?, b.as_number()?);" + nl())
  sb_push(b, "                match k {" + nl())
