  sb_push(b, "        | " + q() + "floor" + q() + " | " + q() + "ceil" + q() + " | " + q() + "round" + q() + " | " + q() + "trunc" + q() + " | " + q() + "abs" + q() + " | " + q() + "numeric_kind" + q() + " => Some(host_call_math_inner(name, args))," + nl())
  sb_push(b, "        _ => None," + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  return true
end

