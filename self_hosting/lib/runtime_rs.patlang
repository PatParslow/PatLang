  sb_push(b, "            Instr::BuildList(n) => { let n=*n; if stack.len()<n {return Err(" + q() + "stack underflow" + q() + ".into());} let start=stack.len()-n; let items: Vec<Value>=stack.drain(start..).collect(); stack.push(Value::List(items)); }" + nl())
