  sb_push(b, "" + nl())
  sb_push(b, "fn run_function(program: &Program, func: &Function, args: &[Value]) -> Result<Value,String> {" + nl())
  sb_push(b, "    let mut pc: usize = 0;" + nl())
  sb_push(b, "    let mut stack: Vec<Value> = Vec::new();" + nl())
  sb_push(b, "    let mut locals: HashMap<String, Value> = HashMap::new();" + nl())
  sb_push(b, "    // bind params" + nl())
  sb_push(b, "    for (i, p) in func.params.iter().enumerate() { if let Some(v) = args.get(i) { locals.insert(p.clone(), v.clone()); } }" + nl())
  sb_push(b, "    while pc < func.body.len() {" + nl())
  sb_push(b, "        match &func.body[pc] {" + nl())
  sb_push(b, "            Instr::Const(v) => stack.push(v.clone())," + nl())
  sb_push(b, "            Instr::LoadLocal(n) => stack.push(locals.get(n).cloned().unwrap_or(Value::Unit))," + nl())
  sb_push(b, "            Instr::StoreLocal(n) => { let v = stack.pop().ok_or(\"stack underflow\")?; locals.insert(n.clone(), v); }," + nl())
  sb_push(b, "            Instr::UnOp(k) => {" + nl())
  sb_push(b, "                let a = stack.pop().ok_or(\"stack underflow\")?;" + nl())
  sb_push(b, "                let r = match k { UnOpKind::Neg => neg(&a)?, UnOpKind::Not => Value::Bool(!a.as_bool()?), UnOpKind::BitNot => bitnot(&a)? };" + nl())
  sb_push(b, "                stack.push(r);" + nl())
  sb_push(b, "            }" + nl())
  sb_push(b, "            Instr::BinOp(k) => {" + nl())
  sb_push(b, "                use BinOpKind::*;" + nl())
  sb_push(b, "                let b = stack.pop().ok_or(\"stack underflow\")?;" + nl())
  sb_push(b, "                let a = stack.pop().ok_or(\"stack underflow\")?;" + nl())
  sb_push(b, "                let r = match k {" + nl())
