  sb_push(b, "" + nl())
  sb_push(b, "                fn msys_to_win_path(p: &str) -> String {" + nl())
  sb_push(b, "                    #[cfg(windows)]" + nl())
  sb_push(b, "                    {" + nl())
  sb_push(b, "                        let b = p.as_bytes();" + nl())
