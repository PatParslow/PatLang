  sb_push(b, "                        }" + nl())
  sb_push(b, "                        // Otherwise, just replace forward slashes with backslashes to be safe" + nl())
  sb_push(b, "                        return p.replace('/', \"\\\\\");" + nl())
  sb_push(b, "                    }" + nl())
  sb_push(b, "                    #[cfg(not(windows))]" + nl())
  sb_push(b, "                    {" + nl())
  sb_push(b, "                        p.to_string()" + nl())
  sb_push(b, "                    }" + nl())
  sb_push(b, "                }" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "                // Make input absolute for reliability" + nl())
  sb_push(b, "                let input_abs = {" + nl())
  sb_push(b, "                    let p = std::path::Path::new(&input_raw);" + nl())
  sb_push(b, "                    if p.is_absolute() { p.to_path_buf() } else { std::env::current_dir().unwrap_or_else(|_| std::path::PathBuf::from(\".\")).join(p) }" + nl())
  sb_push(b, "                };" + nl())
  sb_push(b, "                let input_arg = msys_to_win_path(&input_abs.display().to_string());" + nl())
  sb_push(b, "                // Normalize desired out path (if user provided a non-empty file path) to absolute" + nl())
  sb_push(b, "                let desired_out_abs: Option<String> = out_raw.as_ref().and_then(|s| {" + nl())
  sb_push(b, "                    let t = s.trim();" + nl())
  sb_push(b, "                    if t.is_empty() { return None; }" + nl())
  sb_push(b, "                    let p = std::path::Path::new(t);" + nl())
  sb_push(b, "                    let cwd_here = std::env::current_dir().unwrap_or_else(|_| std::path::PathBuf::from(\".\"));" + nl())
  sb_push(b, "                    let abs = if p.is_absolute() { p.to_path_buf() } else { cwd_here.join(p) };" + nl())
  sb_push(b, "                    // If the path points to an existing directory or looks like a directory (trailing sep), ignore it" + nl())
  sb_push(b, "                    let looks_dir = t.ends_with('/') || t.ends_with('\\\\');" + nl())
  sb_push(b, "                    if abs.is_dir() || looks_dir { None } else { Some(abs.display().to_string()) }" + nl())
  sb_push(b, "                });" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "                // Build command: pat --emit-rust <input> (capture Rust source, we compile with rustc)" + nl())
  sb_push(b, "                let mut cmd = std::process::Command::new(&pat_path);" + nl())
  sb_push(b, "                if let Ok(cwd) = std::env::current_dir() { let _ = cmd.current_dir(&cwd); }" + nl())
  sb_push(b, "                cmd.arg(\"--emit-rust\");" + nl())
  sb_push(b, "                if !input_arg.is_empty() { cmd.arg(&input_arg); }" + nl())
  sb_push(b, "                cmd.env_remove(\"RUST_LOG\");" + nl())
  sb_push(b, "                cmd.env_remove(\"PATLANG_DEBUG\");" + nl())
  sb_push(b, "                // Always print a concise debug line to aid bootstrap troubleshooting and write to a local log file" + nl())
  sb_push(b, "                let cwd_dbg = std::env::current_dir().ok().map(|p| p.display().to_string()).unwrap_or_default();" + nl())
  sb_push(b, "                println!(" + nl())
  sb_push(b, "                    \"[host lower_and_compile] cwd={} using_pat={} cmd: pat --emit-rust {:?} {}\"," + nl())
  sb_push(b, "                    cwd_dbg," + nl())
  sb_push(b, "                    pat_path," + nl())
  sb_push(b, "                    input_arg," + nl())
  sb_push(b, "                    match &desired_out_abs { Some(p) => format!(\"(will compile to {:?})\", p), None => String::from(\"\") }" + nl())
  sb_push(b, "                );" + nl())
  sb_push(b, "                if let Ok(mut f) = std::fs::OpenOptions::new().create(true).append(true).open(\"boot_host.log\") {" + nl())
  sb_push(b, "                    use std::io::Write;" + nl())
  sb_push(b, "                    let _ = writeln!(" + nl())
  sb_push(b, "                        f," + nl())
  sb_push(b, "                        \"cwd={} pat={} cmd: pat --emit-rust {} {}\"," + nl())
  sb_push(b, "                        cwd_dbg," + nl())
  sb_push(b, "                        pat_path," + nl())
  sb_push(b, "                        input_arg," + nl())
  return true
end

