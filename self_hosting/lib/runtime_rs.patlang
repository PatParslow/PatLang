  sb_push(b, "                let action_name = match &args[0] { Value::String(s) => s.clone(), v => to_s(v) };" + nl())
  sb_push(b, "                let preconds = parse_ground_facts(&args[1]);" + nl())
  sb_push(b, "                let add_effects = parse_ground_facts(&args[2]);" + nl())
  sb_push(b, "                let del_effects = parse_ground_facts(&args[3]);" + nl())
  sb_push(b, "                let cost = match &args[4] {" + nl())
  sb_push(b, "                    Value::Number(n) => n.round() as i64," + nl())
  sb_push(b, "                    Value::String(s) => s.parse::<f64>().unwrap_or(1.0).round() as i64," + nl())
  sb_push(b, "                    _ => 1," + nl())
  sb_push(b, "                };" + nl())
  sb_push(b, "                ACTIONS.with(|a| a.borrow_mut().push(GoapAction { name: action_name, preconds, add_effects, del_effects, cost }));" + nl())
  sb_push(b, "                Ok(Value::Unit)" + nl())
  sb_push(b, "            }" + nl())
  sb_push(b, "            \"plan\" => {" + nl())
  sb_push(b, "                if args.len() != 1 { return Err(\"plan: expected 1 arg (goal_facts_list)\".into()); }" + nl())
  sb_push(b, "                let goal_facts = parse_ground_facts(&args[0]);" + nl())
  sb_push(b, "                let actions: Vec<GoapAction> = ACTIONS.with(|a| a.borrow().clone());" + nl())
  sb_push(b, "                use std::collections::BinaryHeap;" + nl())
  sb_push(b, "                use std::cmp::Reverse;" + nl())
  sb_push(b, "                let start_state: HashSet<GroundFact> = current_ground_facts_as_state();" + nl())
  sb_push(b, "                let mut nodes: Vec<(HashSet<GroundFact>, Vec<String>, i64)> = vec![(start_state, Vec::new(), 0)];" + nl())
  sb_push(b, "                let mut frontier: BinaryHeap<Reverse<(i64, usize)>> = BinaryHeap::new();" + nl())
  sb_push(b, "                frontier.push(Reverse((0, 0)));" + nl())
  sb_push(b, "                let mut visited: HashSet<Vec<GroundFact>> = HashSet::new();" + nl())
  sb_push(b, "                const NODE_CAP: usize = 5000;" + nl())
  sb_push(b, "                let mut expansions = 0usize;" + nl())
  sb_push(b, "                let mut found: Option<Vec<String>> = None;" + nl())
  sb_push(b, "                while let Some(Reverse((cost, idx))) = frontier.pop() {" + nl())
  sb_push(b, "                    if expansions >= NODE_CAP { break; }" + nl())
  sb_push(b, "                    let (state, path, node_cost) = nodes[idx].clone();" + nl())
  sb_push(b, "                    if node_cost != cost { continue; }" + nl())
  sb_push(b, "                    expansions += 1;" + nl())
  sb_push(b, "                    if goal_facts.iter().all(|g| state.contains(g)) { found = Some(path); break; }" + nl())
  sb_push(b, "                    let mut state_key: Vec<GroundFact> = state.iter().cloned().collect();" + nl())
  sb_push(b, "                    state_key.sort();" + nl())
  sb_push(b, "                    if !visited.insert(state_key) { continue; }" + nl())
  sb_push(b, "                    for action in &actions {" + nl())
  sb_push(b, "                        for subst in ground_action_instances(&action.preconds, &state) {" + nl())
  sb_push(b, "                            let mut new_state = state.clone();" + nl())
  sb_push(b, "                            for d in &action.del_effects { new_state.remove(&apply_subst_to_fact(d, &subst)); }" + nl())
  sb_push(b, "                            for a2 in &action.add_effects { new_state.insert(apply_subst_to_fact(a2, &subst)); }" + nl())
  sb_push(b, "                            let mut new_path = path.clone();" + nl())
  sb_push(b, "                            new_path.push(action_instance_label(&action.name, &action.preconds, &subst));" + nl())
  sb_push(b, "                            let new_cost = node_cost + action.cost;" + nl())
  sb_push(b, "                            nodes.push((new_state, new_path, new_cost));" + nl())
  sb_push(b, "                            frontier.push(Reverse((new_cost, nodes.len() - 1)));" + nl())
  sb_push(b, "                        }" + nl())
  sb_push(b, "                    }" + nl())
  sb_push(b, "                }" + nl())
  sb_push(b, "                Ok(Value::List(found.unwrap_or_default().into_iter().map(Value::String).collect()))" + nl())
  sb_push(b, "            }" + nl())
  sb_push(b, "                    _ => Err(format!(\"host fn '{}' not found\", name))," + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "fn host_call_logic(name: &str, args: &[Value]) -> Option<Result<Value, String>> {" + nl())
  sb_push(b, "    match name {" + nl())
  sb_push(b, "        \"infer_type_for\" | \"fact\" | \"goal\" | \"query\" | \"rule_add\" | \"solve\" | \"action_add\" | \"plan\" => Some(host_call_logic_inner(name, args))," + nl())
  sb_push(b, "        _ => None," + nl())
  return true
end

