  sb_push(b, "                let listener = LISTENERS.with(|l| l.borrow().get(&port).map(|x| x.try_clone()))" + nl())
  sb_push(b, "                    .ok_or_else(|| format!(" + q() + "tcp_accept: no listener on port {}" + q() + ", port))?" + nl())
  sb_push(b, "                    .map_err(|e| format!(" + q() + "tcp_accept: {}" + q() + ", e))?;" + nl())
  sb_push(b, "                let (stream, _) = listener.accept().map_err(|e| format!(" + q() + "tcp_accept: {}" + q() + ", e))?;" + nl())
  sb_push(b, "                let id = NEXT_CONN.with(|n| { let mut b = n.borrow_mut(); let v = *b; *b += 1; v });" + nl())
  sb_push(b, "                CONNS.with(|c| c.borrow_mut().insert(id, stream));" + nl())
  sb_push(b, "                Ok(Value::Number(id as f64))" + nl())
  sb_push(b, "            }" + nl())
  sb_push(b, "            " + q() + "sleep_ms" + q() + " => {" + nl())
  sb_push(b, "                let ms = arg_num(&args, 0, " + q() + "sleep_ms" + q() + ")?.max(0.0) as u64;" + nl())
  sb_push(b, "                std::thread::sleep(std::time::Duration::from_millis(ms));" + nl())
  sb_push(b, "                Ok(Value::Unit)" + nl())
  sb_push(b, "            }" + nl())
  sb_push(b, "            " + q() + "tcp_accept_timeout" + q() + " => {" + nl())
  sb_push(b, "                // tcp_accept_timeout(port, ms) -> conn id, or -1 on timeout" + nl())
  sb_push(b, "                let port = arg_num(&args, 0, " + q() + "tcp_accept_timeout" + q() + ")? as u16;" + nl())
  sb_push(b, "                let ms = arg_num(&args, 1, " + q() + "tcp_accept_timeout" + q() + ")?.max(0.0) as u64;" + nl())
  sb_push(b, "                let listener = LISTENERS.with(|l| l.borrow().get(&port).map(|x| x.try_clone()))" + nl())
  sb_push(b, "                    .ok_or_else(|| format!(" + q() + "tcp_accept_timeout: no listener on port {}" + q() + ", port))?" + nl())
  sb_push(b, "                    .map_err(|e| format!(" + q() + "tcp_accept_timeout: {}" + q() + ", e))?;" + nl())
  sb_push(b, "                listener.set_nonblocking(true).map_err(|e| format!(" + q() + "tcp_accept_timeout: {}" + q() + ", e))?;" + nl())
  sb_push(b, "                let deadline = std::time::Instant::now() + std::time::Duration::from_millis(ms);" + nl())
  sb_push(b, "                loop {" + nl())
  sb_push(b, "                    match listener.accept() {" + nl())
  sb_push(b, "                        Ok((stream, _)) => {" + nl())
  sb_push(b, "                            let _ = stream.set_nonblocking(false);" + nl())
  sb_push(b, "                            let id = NEXT_CONN.with(|n| { let mut b = n.borrow_mut(); let v = *b; *b += 1; v });" + nl())
  sb_push(b, "                            CONNS.with(|c| c.borrow_mut().insert(id, stream));" + nl())
  sb_push(b, "                            return Ok(Value::Number(id as f64));" + nl())
  sb_push(b, "                        }" + nl())
  sb_push(b, "                        Err(ref e) if e.kind() == std::io::ErrorKind::WouldBlock => {" + nl())
  sb_push(b, "                            if std::time::Instant::now() >= deadline { return Ok(Value::Number(-1.0)); }" + nl())
  sb_push(b, "                            std::thread::sleep(std::time::Duration::from_millis(2));" + nl())
  sb_push(b, "                        }" + nl())
  sb_push(b, "                        Err(e) => return Err(format!(" + q() + "tcp_accept_timeout: {}" + q() + ", e))," + nl())
  sb_push(b, "                    }" + nl())
  sb_push(b, "                }" + nl())
  sb_push(b, "            }" + nl())
  sb_push(b, "            " + q() + "tcp_read" + q() + " => {" + nl())
  sb_push(b, "                // tcp_read(conn) -> String (single read, up to 64 KiB)" + nl())
  sb_push(b, "                use std::io::Read;" + nl())
  sb_push(b, "                let id = arg_num(&args, 0, " + q() + "tcp_read" + q() + ")? as usize;" + nl())
  sb_push(b, "                let mut stream = CONNS.with(|c| c.borrow().get(&id).map(|s| s.try_clone()))" + nl())
  sb_push(b, "                    .ok_or_else(|| format!(" + q() + "tcp_read: unknown connection {}" + q() + ", id))?" + nl())
  sb_push(b, "                    .map_err(|e| format!(" + q() + "tcp_read: {}" + q() + ", e))?;" + nl())
  sb_push(b, "                let mut buf = vec![0u8; 65536];" + nl())
  sb_push(b, "                let n = stream.read(&mut buf).map_err(|e| format!(" + q() + "tcp_read: {}" + q() + ", e))?;" + nl())
  sb_push(b, "                Ok(Value::String(String::from_utf8_lossy(&buf[..n]).to_string()))" + nl())
  sb_push(b, "            }" + nl())
  sb_push(b, "            " + q() + "tcp_write" + q() + " => {" + nl())
  sb_push(b, "                // tcp_write(conn, data) -> Bool" + nl())
  sb_push(b, "                use std::io::Write;" + nl())
  sb_push(b, "                let id = arg_num(&args, 0, " + q() + "tcp_write" + q() + ")? as usize;" + nl())
  sb_push(b, "                let data = match args.get(1) { Some(Value::String(s)) => s.clone(), Some(v) => to_s(v), None => String::new() };" + nl())
  sb_push(b, "                let mut stream = CONNS.with(|c| c.borrow().get(&id).map(|s| s.try_clone()))" + nl())
  sb_push(b, "                    .ok_or_else(|| format!(" + q() + "tcp_write: unknown connection {}" + q() + ", id))?" + nl())
  sb_push(b, "                    .map_err(|e| format!(" + q() + "tcp_write: {}" + q() + ", e))?;" + nl())
  sb_push(b, "                stream.write_all(data.as_bytes()).map_err(|e| format!(" + q() + "tcp_write: {}" + q() + ", e))?;" + nl())
  sb_push(b, "                let _ = stream.flush();" + nl())
  sb_push(b, "                Ok(Value::Bool(true))" + nl())
  sb_push(b, "            }" + nl())
  sb_push(b, "            " + q() + "tcp_close" + q() + " => {" + nl())
  sb_push(b, "                use std::io::Read;" + nl())
  sb_push(b, "                let id = arg_num(&args, 0, " + q() + "tcp_close" + q() + ")? as usize;" + nl())
  sb_push(b, "                if let Some(stream) = CONNS.with(|c| c.borrow_mut().remove(&id)) {" + nl())
  sb_push(b, "                    // Drain unread inbound bytes and half-close so the peer" + nl())
  sb_push(b, "                    // gets a graceful FIN rather than an RST" + nl())
  sb_push(b, "                    let _ = stream.set_nonblocking(true);" + nl())
  sb_push(b, "                    let mut sink = [0u8; 4096];" + nl())
  sb_push(b, "                    let mut s = stream;" + nl())
  return true
end

