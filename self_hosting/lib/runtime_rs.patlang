  sb_push(b, "thread_local! {" + nl())
  sb_push(b, "    static LISTENERS: RefCell<HashMap<u16, std::net::TcpListener>> = RefCell::new(HashMap::new());" + nl())
  sb_push(b, "    static CONNS: RefCell<HashMap<usize, std::net::TcpStream>> = RefCell::new(HashMap::new());" + nl())
  sb_push(b, "    static NEXT_CONN: RefCell<usize> = RefCell::new(1);" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "fn host_call_networking_inner(name: &str, args: &[Value]) -> Result<Value, String> {" + nl())
  sb_push(b, "    match name {" + nl())
  sb_push(b, q() + "tcp_listen" + q() + " => {" + nl())
  sb_push(b, "                // tcp_listen(port) -> Number actual bound port (0 = OS-assigned)" + nl())
  sb_push(b, "                let port = arg_num(&args, 0, " + q() + "tcp_listen" + q() + ")? as u16;" + nl())
  sb_push(b, "                let listener = std::net::TcpListener::bind((" + q() + "127.0.0.1" + q() + ", port))" + nl())
  sb_push(b, "                    .map_err(|e| format!(" + q() + "tcp_listen: bind {}: {}" + q() + ", port, e))?;" + nl())
  sb_push(b, "                let actual = listener.local_addr().map_err(|e| format!(" + q() + "tcp_listen: {}" + q() + ", e))?.port();" + nl())
  sb_push(b, "                LISTENERS.with(|l| l.borrow_mut().insert(actual, listener));" + nl())
  sb_push(b, "                Ok(Value::Number(actual as f64))" + nl())
  sb_push(b, "            }" + nl())
  sb_push(b, "            " + q() + "tcp_connect" + q() + " => {" + nl())
  sb_push(b, "                // tcp_connect(host, port) -> Number connection id (blocks until connected)" + nl())
  sb_push(b, "                let host = match args.get(0) { Some(Value::String(s)) => s.clone(), _ => return Err(" + q() + "tcp_connect: expected host string" + q() + ".into()) };" + nl())
  sb_push(b, "                let port = arg_num(&args, 1, " + q() + "tcp_connect" + q() + ")? as u16;" + nl())
  sb_push(b, "                let stream = std::net::TcpStream::connect((host.as_str(), port))" + nl())
  sb_push(b, "                    .map_err(|e| format!(" + q() + "tcp_connect: {}:{}: {}" + q() + ", host, port, e))?;" + nl())
  sb_push(b, "                let id = NEXT_CONN.with(|n| { let mut b = n.borrow_mut(); let v = *b; *b += 1; v });" + nl())
  sb_push(b, "                CONNS.with(|c| c.borrow_mut().insert(id, stream));" + nl())
  sb_push(b, "                Ok(Value::Number(id as f64))" + nl())
  sb_push(b, "            }" + nl())
  sb_push(b, "            " + q() + "tcp_accept" + q() + " => {" + nl())
