  sb_push(b, "        NumT::Int(x) => x.to_string()," + nl())
  sb_push(b, "        NumT::Float(x) => if x.fract()==0.0 && x.is_finite() { format!(" + q() + "{}" + q() + ", *x as i64) } else { x.to_string() }," + nl())
  sb_push(b, "        NumT::Big(b) => b.to_string()," + nl())
  sb_push(b, "        NumT::Rat(r) => format!(" + q() + "{}/{}" + q() + ", r.num, r.den)," + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "fn display_value(v: &Value) -> String { nt_value_to_string(v) }" + nl())
  sb_push(b, "fn to_s(v: &Value) -> String { nt_value_to_string(v) }" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "fn add(a:&Value,b:&Value)->Result<Value,String>{" + nl())
  sb_push(b, "    match (a,b) {" + nl())
  sb_push(b, "        (Value::String(sa), _) => Ok(Value::String(format!(" + q() + "{}{}" + q() + ", sa, to_s(b))))," + nl())
  sb_push(b, "        (_, Value::String(sb)) => Ok(Value::String(format!(" + q() + "{}{}" + q() + ", to_s(a), sb)))," + nl())
  sb_push(b, "        (Value::Complex(_), _) | (_, Value::Complex(_)) => Ok(nt_normalize_complex(nt_to_complex(a)?.add(&nt_to_complex(b)?)))," + nl())
  sb_push(b, "        _ => Ok(nt_to_value(nt_from_value(a)?.add(&nt_from_value(b)?)))," + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "}" + nl())
  return true
end

