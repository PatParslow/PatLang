  sb_push(b, "                let script_raw: &str = \"./patc_native.patlang\";" + nl())
  sb_push(b, "                let input_raw: String = src_path.clone();" + nl())
  sb_push(b, "                let out_raw: Option<String> = out_opt.clone();" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "                #[allow(unused_variables)]" + nl())
  sb_push(b, "                fn msys_to_win_path(p: &str) -> String {" + nl())
  sb_push(b, "                    #[cfg(windows)]" + nl())
  sb_push(b, "                    {" + nl())
  sb_push(b, "                        let b = p.as_bytes();" + nl())
  sb_push(b, "                        if b.len() >= 3 && b[0] == b'/' && b[2] == b'/' {" + nl())
