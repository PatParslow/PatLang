# Stage 38: `numeric_tower` sits last in the canonical order (matching
# rust-runtime/src/ir/codegen.rs's `ChunkId::CANONICAL_ORDER`), and its slot
# is filled by EXACTLY ONE of two mutually exclusive modules -- never both,
# never neither -- selected by whether "numeric_tower" is in `names`:
# `emit_chunk_numeric_tower()` (full tower: BigInt/Rational/Complex) if
# present, else `emit_chunk_value_fast()` (today's Number(f64) plus cheap
# Int/Float fast-path variants, no bignum). See the matching doc comment
# above `PRELUDE_VALUE_FAST` in rust-runtime/src/ir/codegen.rs for why.
make a function called emit_runtime_rs_for takes names returns s
  let b = sb_new()
  if list_contains(names, "core") then
    sb_push(b, emit_chunk_core())
  end
  if list_contains(names, "strings_ext") then
    sb_push(b, emit_chunk_strings_ext())
  end
  if list_contains(names, "collections_handles") then
    sb_push(b, emit_chunk_collections_handles())
  end
  if list_contains(names, "files") then
    sb_push(b, emit_chunk_files())
  end
  if list_contains(names, "io_misc") then
    sb_push(b, emit_chunk_io_misc())
  end
  if list_contains(names, "oo") then
    sb_push(b, emit_chunk_oo())
  end
  if list_contains(names, "logic") then
    sb_push(b, emit_chunk_logic())
  end
  if list_contains(names, "contracts") then
    sb_push(b, emit_chunk_contracts())
  end
  if list_contains(names, "networking") then
    sb_push(b, emit_chunk_networking())
  end
  if list_contains(names, "codegen_bootstrap") then
    sb_push(b, emit_chunk_codegen_bootstrap())
  end
  if list_contains(names, "numeric_tower") then
    sb_push(b, emit_chunk_numeric_tower())
  else
    sb_push(b, emit_chunk_value_fast())
  end
  if list_contains(names, "math") then
    sb_push(b, emit_chunk_math())
  end
  sb_push(b, emit_dispatch_for(names))
  return sb_str(b)
end

