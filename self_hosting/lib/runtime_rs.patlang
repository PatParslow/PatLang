  sb_push(b, "            (NumT::Float(x), NumT::Float(y)) => x.partial_cmp(y).unwrap_or(std::cmp::Ordering::Equal)," + nl())
  sb_push(b, "            (NumT::Big(x), NumT::Big(y)) => x.cmp(y)," + nl())
  sb_push(b, "            (NumT::Rat(x), NumT::Rat(y)) => x.cmp(y)," + nl())
