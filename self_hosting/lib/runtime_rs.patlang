  sb_push(b, "            " + q() + "set_var" + q() + " => {" + nl())
  sb_push(b, "                if args.len() != 2 { return Ok(Value::Unit); }" + nl())
  sb_push(b, "                let key = match &args[0] { Value::String(s) => s.clone(), _ => String::new() };" + nl())
  sb_push(b, "                let val = args.get(1).cloned().unwrap_or(Value::Unit);" + nl())
  sb_push(b, "                if !key.is_empty() {" + nl())
  sb_push(b, "                    OBJECTS.with(|o| {" + nl())
  sb_push(b, "                        let mut b = o.borrow_mut();" + nl())
  sb_push(b, "                        let m = b.entry(" + q() + "__vars" + q() + ".to_string()).or_insert_with(HashMap::new);" + nl())
  sb_push(b, "                        m.insert(key, val);" + nl())
  sb_push(b, "                    });" + nl())
  sb_push(b, "                }" + nl())
  sb_push(b, "                Ok(Value::Unit)" + nl())
  sb_push(b, "            }" + nl())
  sb_push(b, "            " + q() + "get" + q() + " => {" + nl())
  sb_push(b, "                if args.len() != 2 { return Err(" + q() + "expected 2 args" + q() + ".into()); }" + nl())
  sb_push(b, "                let key = match &args[1] { Value::String(s) => s.clone(), _ => return Err(" + q() + "expected string key" + q() + ".into()) };" + nl())
  sb_push(b, "                match &args[0] {" + nl())
  sb_push(b, "                    Value::String(name) => Ok(obj_get(name, &key).unwrap_or(Value::Unit))," + nl())
  sb_push(b, "                    Value::Object(map) => Ok(map.get(&key).cloned().unwrap_or(Value::Unit))," + nl())
  sb_push(b, "                    _ => Ok(Value::Unit)," + nl())
  sb_push(b, "                }" + nl())
  sb_push(b, "            }" + nl())
  sb_push(b, "            " + q() + "send" + q() + " => {" + nl())
  sb_push(b, "                if args.len() < 2 { return Ok(Value::Unit); }" + nl())
  sb_push(b, "                let recv = match &args[0] { Value::String(s) => s.clone(), _ => String::new() };" + nl())
  sb_push(b, "                let method = match &args[1] { Value::String(s) => s.clone(), _ => String::new() };" + nl())
  sb_push(b, "                let rest = &args[2..];" + nl())
  sb_push(b, "                match method.as_str() {" + nl())
  sb_push(b, "                    " + q() + "set" + q() + " => {" + nl())
  sb_push(b, "                        if rest.len() != 2 { return Ok(Value::Unit); }" + nl())
  sb_push(b, "                        let prop = match &rest[0] { Value::String(s) => s.clone(), _ => String::new() };" + nl())
  sb_push(b, "                        let val = rest[1].clone();" + nl())
  sb_push(b, "                        if !recv.is_empty() && !prop.is_empty() { obj_set(&recv, &prop, val); }" + nl())
  sb_push(b, "                        Ok(Value::Unit)" + nl())
  sb_push(b, "                    }" + nl())
  sb_push(b, "                    " + q() + "infer_is_adult" + q() + " => {" + nl())
  sb_push(b, "                        // reads age, sets is_adult when >= 18" + nl())
  sb_push(b, "                        if let Some(Value::Number(age)) = obj_get(&recv, " + q() + "age" + q() + ") {" + nl())
  sb_push(b, "                            if age >= 18.0 { obj_set(&recv, " + q() + "is_adult" + q() + ", Value::Bool(true)); return Ok(Value::Bool(true)); }" + nl())
  sb_push(b, "                        } else if let Some(Value::String(s)) = obj_get(&recv, " + q() + "age" + q() + ") {" + nl())
  sb_push(b, "                            if s.parse::<f64>().unwrap_or(0.0) >= 18.0 { obj_set(&recv, " + q() + "is_adult" + q() + ", Value::Bool(true)); return Ok(Value::Bool(true)); }" + nl())
  sb_push(b, "                        }" + nl())
  sb_push(b, "                        Ok(Value::Bool(false))" + nl())
  sb_push(b, "                    }" + nl())
  sb_push(b, "                    " + q() + "infer_relations" + q() + " => {" + nl())
  sb_push(b, "                        // if exists fact(" + q() + "parent" + q() + ", X, recv) then set has_parent true" + nl())
  sb_push(b, "                        let mut has = false;" + nl())
  sb_push(b, "                        FACTS.with(|f| {" + nl())
  sb_push(b, "                            if let Some(v) = f.borrow().get(" + q() + "parent" + q() + ") {" + nl())
