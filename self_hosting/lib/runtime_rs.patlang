  sb_push(b, "        Eq => a == b," + nl())
  sb_push(b, "        Ne => a != b," + nl())
  sb_push(b, "        // Relational: lexicographic for string pairs, numeric otherwise" + nl())
  sb_push(b, "        Lt | Le | Gt | Ge => {" + nl())
