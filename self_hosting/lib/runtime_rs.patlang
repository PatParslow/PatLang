  sb_push(b, "    const DURATION_WINDOW: usize = 16;" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "    fn predict_next_duration_ms(samples: &[i64]) -> i64 {" + nl())
  sb_push(b, "        let n = samples.len();" + nl())
  sb_push(b, "        if n == 0 { return 0; }" + nl())
  sb_push(b, "        if n < 2 { return samples[n - 1]; }" + nl())
  sb_push(b, "        let n_f = n as f64;" + nl())
  sb_push(b, "        let sum_x: f64 = (0..n).map(|i| i as f64).sum();" + nl())
  sb_push(b, "        let sum_y: f64 = samples.iter().map(|&v| v as f64).sum();" + nl())
  sb_push(b, "        let sum_xy: f64 = samples.iter().enumerate().map(|(i, &v)| i as f64 * v as f64).sum();" + nl())
  sb_push(b, "        let sum_xx: f64 = (0..n).map(|i| (i as f64) * (i as f64)).sum();" + nl())
  sb_push(b, "        let denom = n_f * sum_xx - sum_x * sum_x;" + nl())
  sb_push(b, "        let (slope, intercept) = if denom.abs() < f64::EPSILON {" + nl())
  sb_push(b, "            (0.0, sum_y / n_f)" + nl())
  sb_push(b, "        } else {" + nl())
  sb_push(b, "            let slope = (n_f * sum_xy - sum_x * sum_y) / denom;" + nl())
  sb_push(b, "            let intercept = (sum_y - slope * sum_x) / n_f;" + nl())
  sb_push(b, "            (slope, intercept)" + nl())
  sb_push(b, "        };" + nl())
  sb_push(b, "        let regression_estimate = slope * n_f + intercept;" + nl())
  sb_push(b, "        let recent_max = *samples.iter().max().unwrap_or(&0);" + nl())
  sb_push(b, "        (regression_estimate.max(0.0) as i64).max(recent_max)" + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "    pub fn budgeted_run(program: &Program, ms: i64, func_name: &str, captured: Value, existing_fiber_id: &Value) -> Result<Value, String> {" + nl())
  sb_push(b, "        let (id_value, first_call) = match existing_fiber_id {" + nl())
  sb_push(b, "            Value::Unit | Value::Bool(false) => (fiber_new(program, func_name.to_string())?, true)," + nl())
  sb_push(b, "            v => (v.clone(), false)," + nl())
  sb_push(b, "        };" + nl())
  sb_push(b, "        let id = id_from_value(&id_value)?;" + nl())
  sb_push(b, "        let deadline = now_ms_i64() + ms;" + nl())
  sb_push(b, "        {" + nl())
  sb_push(b, "            let handle = handle_for(id)?;" + nl())
  sb_push(b, "            let mut st = handle.state.lock().unwrap();" + nl())
  sb_push(b, "            st.budget_deadline_ms = Some(deadline);" + nl())
  sb_push(b, "            st.budget_last_check_ms = None;" + nl())
  sb_push(b, "        }" + nl())
  sb_push(b, "        let resume_arg = if first_call { captured } else { Value::Unit };" + nl())
  sb_push(b, "        let result = fiber_resume(&id_value, resume_arg)?;" + nl())
  sb_push(b, "        let still_alive = {" + nl())
  sb_push(b, "            let handle = handle_for(id)?;" + nl())
  sb_push(b, "            let st = handle.state.lock().unwrap();" + nl())
  sb_push(b, "            st.alive" + nl())
  sb_push(b, "        };" + nl())
  sb_push(b, "        if still_alive {" + nl())
  sb_push(b, "            Ok(Value::List(vec![Value::String(\"paused\".into()), id_value]))" + nl())
  sb_push(b, "        } else {" + nl())
  sb_push(b, "            Ok(Value::List(vec![Value::String(\"done\".into()), result]))" + nl())
  sb_push(b, "        }" + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "    pub fn budget_check() -> Result<(), String> {" + nl())
  sb_push(b, "        let id = match CURRENT_FIBER.with(|c| c.get()) {" + nl())
  sb_push(b, "            Some(id) => id," + nl())
  sb_push(b, "            None => return Ok(())," + nl())
  sb_push(b, "        };" + nl())
  sb_push(b, "        let handle = handle_for(id)?;" + nl())
  sb_push(b, "        let now = now_ms_i64();" + nl())
  sb_push(b, "        let (deadline, predicted) = {" + nl())
  sb_push(b, "            let mut st = handle.state.lock().unwrap();" + nl())
  sb_push(b, "            if let Some(prev) = st.budget_last_check_ms {" + nl())
  sb_push(b, "                let dur = (now - prev).max(0);" + nl())
  sb_push(b, "                st.recent_durations.push(dur);" + nl())
  sb_push(b, "                if st.recent_durations.len() > DURATION_WINDOW {" + nl())
  sb_push(b, "                    st.recent_durations.remove(0);" + nl())
  sb_push(b, "                }" + nl())
  sb_push(b, "            }" + nl())
  sb_push(b, "            st.budget_last_check_ms = Some(now);" + nl())
  sb_push(b, "            let predicted = predict_next_duration_ms(&st.recent_durations);" + nl())
  sb_push(b, "            (st.budget_deadline_ms, predicted)" + nl())
  sb_push(b, "        };" + nl())
  return true
end

