  sb_push(b, "fn math_num_decimal_digits(n: &BigIntT) -> usize {" + nl())
  sb_push(b, "    let s = n.to_string();" + nl())
  sb_push(b, "    s.trim_start_matches('-').len()" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "fn math_pow10(exp: usize) -> BigIntT {" + nl())
  sb_push(b, "    let mut r = BigIntT::from_i64(1);" + nl())
  sb_push(b, "    let ten = BigIntT::from_i64(10);" + nl())
  sb_push(b, "    for _ in 0..exp { r = r.mul(&ten); }" + nl())
  sb_push(b, "    r" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "// Floor of the true integer square root via Newton's method, for a" + nl())
  sb_push(b, "// non-negative BigIntT. Mirrors ir/hosts.rs's bigint_isqrt." + nl())
  sb_push(b, "fn math_isqrt(n: &BigIntT) -> BigIntT {" + nl())
  sb_push(b, "    if n.is_zero() { return BigIntT::zero(); }" + nl())
  sb_push(b, "    let digits = math_num_decimal_digits(n);" + nl())
  sb_push(b, "    let mut x = math_pow10(digits / 2 + 1);" + nl())
  sb_push(b, "    loop {" + nl())
  sb_push(b, "        let (q, _) = n.div_rem(&x);" + nl())
  sb_push(b, "        let y = x.add(&q);" + nl())
  sb_push(b, "        let (y, _) = y.div_rem(&BigIntT::from_i64(2));" + nl())
  sb_push(b, "        if BigIntT::cmp(&y, &x) != std::cmp::Ordering::Less { break; }" + nl())
  sb_push(b, "        x = y;" + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "    x" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "fn math_is_negative(v: &Value) -> bool {" + nl())
  sb_push(b, "    match v {" + nl())
  sb_push(b, "        Value::Int(n) => *n < 0," + nl())
  sb_push(b, "        Value::Float(f) => *f < 0.0," + nl())
  sb_push(b, "        Value::Number(f) => *f < 0.0," + nl())
  sb_push(b, "        Value::BigInt(b) => b.is_negative()," + nl())
  sb_push(b, "        Value::Rational(r) => r.num.is_negative()," + nl())
  sb_push(b, "        _ => false," + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "fn math_sqrt_nonneg(v: &Value) -> Result<Value, String> {" + nl())
  sb_push(b, "    match v {" + nl())
  sb_push(b, "        Value::Int(n) => {" + nl())
  sb_push(b, "            let bi = BigIntT::from_i64(*n);" + nl())
  sb_push(b, "            let r = math_isqrt(&bi);" + nl())
  sb_push(b, "            if r.mul(&r).eq(&bi) { Ok(nt_to_value(NumT::Big(r).normalize())) } else { Ok(Value::Float((*n as f64).sqrt())) }" + nl())
  sb_push(b, "        }" + nl())
  sb_push(b, "        Value::Number(f) if f.fract() == 0.0 && f.abs() < 9.0e15 => {" + nl())
  sb_push(b, "            let n = *f as i64;" + nl())
  sb_push(b, "            let bi = BigIntT::from_i64(n);" + nl())
  sb_push(b, "            let r = math_isqrt(&bi);" + nl())
  sb_push(b, "            if r.mul(&r).eq(&bi) { Ok(nt_to_value(NumT::Big(r).normalize())) } else { Ok(Value::Float(f.sqrt())) }" + nl())
  sb_push(b, "        }" + nl())
  sb_push(b, "        Value::Number(f) => Ok(Value::Number(f.sqrt()))," + nl())
  sb_push(b, "        Value::BigInt(b) => {" + nl())
  sb_push(b, "            let r = math_isqrt(b);" + nl())
  sb_push(b, "            if r.mul(&r).eq(b) { Ok(nt_to_value(NumT::Big(r).normalize())) } else { Ok(Value::Float(v.as_number()?.sqrt())) }" + nl())
  sb_push(b, "        }" + nl())
  sb_push(b, "        Value::Rational(rat) => {" + nl())
  sb_push(b, "            let rn = math_isqrt(&rat.num);" + nl())
  sb_push(b, "            let rd = math_isqrt(&rat.den);" + nl())
  sb_push(b, "            if rn.mul(&rn).eq(&rat.num) && rd.mul(&rd).eq(&rat.den) {" + nl())
  sb_push(b, "                Ok(nt_to_value(NumT::Rat(RationalT::new(rn, rd)).normalize()))" + nl())
  sb_push(b, "            } else {" + nl())
  sb_push(b, "                Ok(Value::Float(v.as_number()?.sqrt()))" + nl())
  sb_push(b, "            }" + nl())
  sb_push(b, "        }" + nl())
  sb_push(b, "        Value::Float(f) => Ok(Value::Float(f.sqrt()))," + nl())
  sb_push(b, "        Value::Unit => Ok(Value::Int(0))," + nl())
  sb_push(b, "        _ => Err(" + q() + "sqrt: expected numeric value" + q() + ".to_string())," + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "fn math_sqrt(v: &Value) -> Result<Value, String> {" + nl())
  sb_push(b, "    if matches!(v, Value::Complex(_)) { return Err(" + q() + "sqrt: complex input not supported" + q() + ".to_string()); }" + nl())
  sb_push(b, "    if math_is_negative(v) {" + nl())
  sb_push(b, "        let pos = neg(v)?;" + nl())
  sb_push(b, "        let root = math_sqrt_nonneg(&pos)?;" + nl())
  sb_push(b, "        Ok(nt_normalize_complex(ComplexT::new(NumT::Int(0), nt_from_value(&root)?)))" + nl())
  sb_push(b, "    } else {" + nl())
  sb_push(b, "        math_sqrt_nonneg(v)" + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "fn math_exact_base(v: &Value) -> Option<Value> {" + nl())
  sb_push(b, "    match v {" + nl())
  sb_push(b, "        Value::Int(_) | Value::BigInt(_) | Value::Rational(_) => Some(v.clone())," + nl())
  sb_push(b, "        Value::Number(f) if f.fract() == 0.0 && f.abs() < 9.0e15 => Some(Value::Int(*f as i64))," + nl())
  sb_push(b, "        _ => None," + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "fn math_exp_as_i64(v: &Value) -> Option<i64> {" + nl())
  sb_push(b, "    match v {" + nl())
  sb_push(b, "        Value::Int(n) => Some(*n)," + nl())
  sb_push(b, "        Value::BigInt(b) => b.to_string().parse::<i64>().ok()," + nl())
  sb_push(b, "        Value::Number(f) if f.fract() == 0.0 && f.abs() < 9.0e15 => Some(*f as i64)," + nl())
  sb_push(b, "        _ => None," + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  return true
end

