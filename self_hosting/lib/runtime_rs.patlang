  sb_push(b, "        Value::Bool(b) => b.to_string()," + nl())
  sb_push(b, "        Value::Number(n) => if n.fract()==0.0 { format!(" + q() + "{}" + q() + ", *n as i64) } else { n.to_string() }," + nl())
  sb_push(b, "        Value::Int(n) => n.to_string()," + nl())
  sb_push(b, "        Value::Float(n) => if n.fract()==0.0 && n.is_finite() { format!(" + q() + "{}" + q() + ", *n as i64) } else { n.to_string() }," + nl())
