  sb_push(b, "                    stack.push(r);" + nl())
  sb_push(b, "                } else {" + nl())
  sb_push(b, "                    let r = Host::call(n, &args)?; stack.push(r);" + nl())
  sb_push(b, "                }" + nl())
  sb_push(b, "            }" + nl())
  sb_push(b, "            Instr::Call(n, argc) => {" + nl())
