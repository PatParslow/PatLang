make a function called emit_runtime_rs_logic_0 takes b returns done
  sb_push(b, "thread_local! {" + nl())
  sb_push(b, "    static FACTS: RefCell<HashMap<String, Vec<(String, String)>>> = RefCell::new(HashMap::new());" + nl())
  sb_push(b, "    static GOALS: RefCell<Vec<(String, Vec<String>)>> = RefCell::new(Vec::new());" + nl())
  sb_push(b, "    static TYPE_RULES: RefCell<HashMap<(String, usize), String>> = RefCell::new(HashMap::new());" + nl())
  sb_push(b, "    static RULES: RefCell<Vec<LogicRule>> = RefCell::new(Vec::new());" + nl())
  sb_push(b, "    static ACTIONS: RefCell<Vec<GoapAction>> = RefCell::new(Vec::new());" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "use std::collections::HashSet;" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "#[derive(Clone)]" + nl())
  sb_push(b, "struct LogicRule { head_pred: String, head_args: Vec<String>, body: Vec<(String, Vec<String>)> }" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "#[derive(Clone, PartialEq, Eq, Hash, PartialOrd, Ord)]" + nl())
  sb_push(b, "struct GroundFact { pred: String, args: Vec<String> }" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "#[derive(Clone)]" + nl())
  sb_push(b, "struct GoapAction { name: String, preconds: Vec<GroundFact>, add_effects: Vec<GroundFact>, del_effects: Vec<GroundFact>, cost: i64 }" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "type LogicSubst = HashMap<String, String>;" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "fn is_logic_var(s: &str) -> bool {" + nl())
  sb_push(b, "    s.chars().next().map(|c| c.is_ascii_uppercase()).unwrap_or(false)" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "fn logic_walk(term: &str, subst: &LogicSubst) -> String {" + nl())
  sb_push(b, "    let mut cur = term.to_string();" + nl())
  sb_push(b, "    let mut hops = 0;" + nl())
  sb_push(b, "    while is_logic_var(&cur) {" + nl())
  sb_push(b, "        match subst.get(&cur) {" + nl())
  sb_push(b, "            Some(next) if next != &cur => { cur = next.clone(); hops += 1; if hops > 1000 { break; } }" + nl())
  sb_push(b, "            _ => break," + nl())
  sb_push(b, "        }" + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "    cur" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "fn unify_args(query_args: &[String], target_args: &[String], subst: &LogicSubst) -> Option<LogicSubst> {" + nl())
  sb_push(b, "    if query_args.len() != target_args.len() { return None; }" + nl())
  sb_push(b, "    let mut s = subst.clone();" + nl())
  sb_push(b, "    for (qa, ta) in query_args.iter().zip(target_args.iter()) {" + nl())
  sb_push(b, "        let qw = logic_walk(qa, &s);" + nl())
  sb_push(b, "        let tw = logic_walk(ta, &s);" + nl())
  sb_push(b, "        if is_logic_var(&qw) {" + nl())
  sb_push(b, "            if qw != tw { s.insert(qw, tw); }" + nl())
  sb_push(b, "        } else if is_logic_var(&tw) {" + nl())
  sb_push(b, "            if tw != qw { s.insert(tw, qw); }" + nl())
  sb_push(b, "        } else if qw != tw {" + nl())
  sb_push(b, "            return None;" + nl())
  sb_push(b, "        }" + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "    Some(s)" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "fn logic_apply_subst(args: &[String], subst: &LogicSubst) -> Vec<String> {" + nl())
  sb_push(b, "    args.iter().map(|a| logic_walk(a, subst)).collect()" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "const MAX_LOGIC_DEPTH: u32 = 200;" + nl())
  sb_push(b, "static RULE_RENAME_COUNTER: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "fn fresh_rename(rule: &LogicRule) -> LogicRule {" + nl())
  sb_push(b, "    let suffix = RULE_RENAME_COUNTER.fetch_add(1, std::sync::atomic::Ordering::Relaxed);" + nl())
  sb_push(b, "    let mut map: HashMap<String, String> = HashMap::new();" + nl())
  sb_push(b, "    let mut rename = |s: &str, map: &mut HashMap<String, String>| -> String {" + nl())
  sb_push(b, "        if is_logic_var(s) {" + nl())
  sb_push(b, "            map.entry(s.to_string()).or_insert_with(|| format!(\"{}__{}\", s, suffix)).clone()" + nl())
  sb_push(b, "        } else {" + nl())
  sb_push(b, "            s.to_string()" + nl())
  sb_push(b, "        }" + nl())
  sb_push(b, "    };" + nl())
  sb_push(b, "    let head_args = rule.head_args.iter().map(|a| rename(a, &mut map)).collect();" + nl())
  sb_push(b, "    let body = rule.body.iter().map(|(p, a)| (p.clone(), a.iter().map(|x| rename(x, &mut map)).collect())).collect();" + nl())
  sb_push(b, "    LogicRule { head_pred: rule.head_pred.clone(), head_args, body }" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "fn solve_goal(pred: &str, args: &[String], subst: &LogicSubst, depth: u32) -> Vec<LogicSubst> {" + nl())
  sb_push(b, "    if depth > MAX_LOGIC_DEPTH { return Vec::new(); }" + nl())
  sb_push(b, "    let candidates: Vec<LogicRule> = RULES.with(|r| r.borrow().iter().filter(|ru| ru.head_pred == pred).cloned().collect());" + nl())
  sb_push(b, "    let mut results = Vec::new();" + nl())
  sb_push(b, "    for rule in candidates {" + nl())
  sb_push(b, "        let rule = fresh_rename(&rule);" + nl())
  sb_push(b, "        if let Some(s2) = unify_args(args, &rule.head_args, subst) {" + nl())
  sb_push(b, "            results.extend(resolve_conjuncts(&rule.body, &s2, depth + 1));" + nl())
  sb_push(b, "        }" + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "    results" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "fn resolve_conjuncts(body: &[(String, Vec<String>)], subst: &LogicSubst, depth: u32) -> Vec<LogicSubst> {" + nl())
  sb_push(b, "    if body.is_empty() { return vec![subst.clone()]; }" + nl())
  sb_push(b, "    let (pred, args) = &body[0];" + nl())
  sb_push(b, "    let rest = &body[1..];" + nl())
  sb_push(b, "    let applied_args = logic_apply_subst(args, subst);" + nl())
  sb_push(b, "    let mut out = Vec::new();" + nl())
  sb_push(b, "    for s2 in solve_goal(pred, &applied_args, subst, depth) {" + nl())
  sb_push(b, "        out.extend(resolve_conjuncts(rest, &s2, depth));" + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "    out" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "fn value_to_str_list(v: &Value) -> Vec<String> {" + nl())
  sb_push(b, "    match v {" + nl())
  sb_push(b, "        Value::List(xs) => xs.iter().map(to_s).collect()," + nl())
  sb_push(b, "        other => vec![to_s(other)]," + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "fn parse_ground_facts(v: &Value) -> Vec<GroundFact> {" + nl())
  sb_push(b, "    let items = match v { Value::List(xs) => xs.clone(), _ => Vec::new() };" + nl())
  sb_push(b, "    let mut out = Vec::new();" + nl())
  sb_push(b, "    for item in items {" + nl())
  sb_push(b, "        if let Value::List(pair) = &item {" + nl())
  sb_push(b, "            if pair.len() == 2 {" + nl())
  sb_push(b, "                out.push(GroundFact { pred: to_s(&pair[0]), args: value_to_str_list(&pair[1]) });" + nl())
  sb_push(b, "            }" + nl())
  sb_push(b, "        }" + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "    out" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "fn current_ground_facts_as_state() -> HashSet<GroundFact> {" + nl())
  sb_push(b, "    RULES.with(|r| r.borrow().iter()" + nl())
  sb_push(b, "        .filter(|ru| ru.body.is_empty() && !ru.head_args.iter().any(|a| is_logic_var(a)))" + nl())
  sb_push(b, "        .map(|ru| GroundFact { pred: ru.head_pred.clone(), args: ru.head_args.clone() })" + nl())
  sb_push(b, "        .collect())" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "fn apply_subst_to_fact(fact: &GroundFact, subst: &LogicSubst) -> GroundFact {" + nl())
  sb_push(b, "    GroundFact { pred: fact.pred.clone(), args: logic_apply_subst(&fact.args, subst) }" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "fn ground_action_instances(preconds: &[GroundFact], state: &HashSet<GroundFact>) -> Vec<LogicSubst> {" + nl())
  sb_push(b, "    fn go(remaining: &[GroundFact], state: &HashSet<GroundFact>, subst: LogicSubst, out: &mut Vec<LogicSubst>) {" + nl())
  sb_push(b, "        if remaining.is_empty() { out.push(subst); return; }" + nl())
  sb_push(b, "        let (first, rest) = (&remaining[0], &remaining[1..]);" + nl())
  sb_push(b, "        let applied = logic_apply_subst(&first.args, &subst);" + nl())
  sb_push(b, "        for fact in state.iter().filter(|f| f.pred == first.pred) {" + nl())
  sb_push(b, "            if let Some(s2) = unify_args(&applied, &fact.args, &subst) {" + nl())
  sb_push(b, "                go(rest, state, s2, out);" + nl())
  sb_push(b, "            }" + nl())
  sb_push(b, "        }" + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "    let mut out = Vec::new();" + nl())
  sb_push(b, "    go(preconds, state, HashMap::new(), &mut out);" + nl())
  sb_push(b, "    out" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "fn action_instance_label(name: &str, preconds: &[GroundFact], subst: &LogicSubst) -> String {" + nl())
  sb_push(b, "    let mut seen: Vec<String> = Vec::new();" + nl())
  return true
end

