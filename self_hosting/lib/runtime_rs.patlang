  sb_push(b, "// ===== BigIntT (hand-transcribed from ir/bignum_template.rs, unmodified logic) =====" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "#[derive(Debug, Clone, Copy, PartialEq, Eq)]" + nl())
  sb_push(b, "enum Sign { Zero, Positive, Negative }" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "const NT_BASE: u64 = 1_000_000_000;" + nl())
  sb_push(b, "const NT_BASE_DIGITS: usize = 9;" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "#[derive(Debug, Clone)]" + nl())
  sb_push(b, "struct BigIntT { sign: Sign, limbs: Vec<u32> }" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "impl BigIntT {" + nl())
  sb_push(b, "    fn zero() -> Self { BigIntT { sign: Sign::Zero, limbs: Vec::new() } }" + nl())
  sb_push(b, "    fn is_zero(&self) -> bool { self.sign == Sign::Zero }" + nl())
  sb_push(b, "    fn is_negative(&self) -> bool { self.sign == Sign::Negative }" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "    fn normalize(mut self) -> Self {" + nl())
  sb_push(b, "        while self.limbs.last() == Some(&0) { self.limbs.pop(); }" + nl())
  sb_push(b, "        if self.limbs.is_empty() { self.sign = Sign::Zero; }" + nl())
  sb_push(b, "        self" + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "    fn from_i64(n: i64) -> Self {" + nl())
  sb_push(b, "        if n == 0 { return BigIntT::zero(); }" + nl())
  sb_push(b, "        let sign = if n < 0 { Sign::Negative } else { Sign::Positive };" + nl())
  sb_push(b, "        let mut mag: u64 = if n == i64::MIN { (i64::MAX as u64) + 1 } else { n.unsigned_abs() };" + nl())
  sb_push(b, "        let mut limbs = Vec::new();" + nl())
  sb_push(b, "        if mag == 0 { limbs.push(0); }" + nl())
  sb_push(b, "        while mag > 0 { limbs.push((mag % NT_BASE) as u32); mag /= NT_BASE; }" + nl())
  sb_push(b, "        BigIntT { sign, limbs }.normalize()" + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "    fn from_decimal_str(s: &str) -> Option<Self> {" + nl())
  sb_push(b, "        let s = s.trim();" + nl())
  sb_push(b, "        if s.is_empty() { return None; }" + nl())
  sb_push(b, "        let (neg, digits) = match s.as_bytes()[0] {" + nl())
  sb_push(b, "            b'-' => (true, &s[1..])," + nl())
  sb_push(b, "            b'+' => (false, &s[1..])," + nl())
  sb_push(b, "            _ => (false, s)," + nl())
  sb_push(b, "        };" + nl())
  sb_push(b, "        if digits.is_empty() || !digits.bytes().all(|b| b.is_ascii_digit()) { return None; }" + nl())
  sb_push(b, "        let trimmed = digits.trim_start_matches('0');" + nl())
  sb_push(b, "        if trimmed.is_empty() { return Some(BigIntT::zero()); }" + nl())
  sb_push(b, "        let mut limbs = Vec::new();" + nl())
  sb_push(b, "        let bytes = trimmed.as_bytes();" + nl())
  sb_push(b, "        let mut end = bytes.len();" + nl())
  sb_push(b, "        while end > 0 {" + nl())
  sb_push(b, "            let start = if end >= NT_BASE_DIGITS { end - NT_BASE_DIGITS } else { 0 };" + nl())
  sb_push(b, "            let chunk = std::str::from_utf8(&bytes[start..end]).unwrap();" + nl())
  sb_push(b, "            let limb: u32 = chunk.parse().unwrap();" + nl())
  sb_push(b, "            limbs.push(limb);" + nl())
  sb_push(b, "            end = start;" + nl())
  sb_push(b, "        }" + nl())
  sb_push(b, "        let sign = if neg { Sign::Negative } else { Sign::Positive };" + nl())
  sb_push(b, "        Some(BigIntT { sign, limbs }.normalize())" + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "    fn to_string(&self) -> String {" + nl())
  sb_push(b, "        if self.is_zero() { return \"0\".to_string(); }" + nl())
  sb_push(b, "        let mut s = String::new();" + nl())
  sb_push(b, "        if self.sign == Sign::Negative { s.push('-'); }" + nl())
  sb_push(b, "        let mut iter = self.limbs.iter().rev();" + nl())
  sb_push(b, "        let msl = iter.next().unwrap();" + nl())
  sb_push(b, "        s.push_str(&msl.to_string());" + nl())
  sb_push(b, "        for limb in iter { s.push_str(&format!(\"{:0width$}\", limb, width = NT_BASE_DIGITS)); }" + nl())
  sb_push(b, "        s" + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "    fn negate(&self) -> Self {" + nl())
  sb_push(b, "        let sign = match self.sign { Sign::Zero => Sign::Zero, Sign::Positive => Sign::Negative, Sign::Negative => Sign::Positive };" + nl())
  sb_push(b, "        BigIntT { sign, limbs: self.limbs.clone() }" + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "    fn cmp_mag(a: &[u32], b: &[u32]) -> std::cmp::Ordering {" + nl())
  sb_push(b, "        if a.len() != b.len() { return a.len().cmp(&b.len()); }" + nl())
  sb_push(b, "        for i in (0..a.len()).rev() { if a[i] != b[i] { return a[i].cmp(&b[i]); } }" + nl())
  sb_push(b, "        std::cmp::Ordering::Equal" + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "    fn add_mag(a: &[u32], b: &[u32]) -> Vec<u32> {" + nl())
  sb_push(b, "        let mut result = Vec::with_capacity(a.len().max(b.len()) + 1);" + nl())
  sb_push(b, "        let mut carry: u64 = 0;" + nl())
  sb_push(b, "        for i in 0..a.len().max(b.len()) {" + nl())
  sb_push(b, "            let av = *a.get(i).unwrap_or(&0) as u64;" + nl())
  sb_push(b, "            let bv = *b.get(i).unwrap_or(&0) as u64;" + nl())
  sb_push(b, "            let sum = av + bv + carry;" + nl())
  sb_push(b, "            result.push((sum % NT_BASE) as u32);" + nl())
  sb_push(b, "            carry = sum / NT_BASE;" + nl())
  sb_push(b, "        }" + nl())
  sb_push(b, "        if carry > 0 { result.push(carry as u32); }" + nl())
  sb_push(b, "        result" + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "    fn sub_mag(a: &[u32], b: &[u32]) -> Vec<u32> {" + nl())
  sb_push(b, "        let mut result = Vec::with_capacity(a.len());" + nl())
  sb_push(b, "        let mut borrow: i64 = 0;" + nl())
  sb_push(b, "        for i in 0..a.len() {" + nl())
  sb_push(b, "            let av = a[i] as i64;" + nl())
  sb_push(b, "            let bv = *b.get(i).unwrap_or(&0) as i64;" + nl())
  sb_push(b, "            let mut diff = av - bv - borrow;" + nl())
  sb_push(b, "            if diff < 0 { diff += NT_BASE as i64; borrow = 1; } else { borrow = 0; }" + nl())
  sb_push(b, "            result.push(diff as u32);" + nl())
  sb_push(b, "        }" + nl())
  sb_push(b, "        result" + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "    fn add(&self, other: &BigIntT) -> BigIntT {" + nl())
  sb_push(b, "        if self.is_zero() { return other.clone(); }" + nl())
  sb_push(b, "        if other.is_zero() { return self.clone(); }" + nl())
  sb_push(b, "        if self.sign == other.sign {" + nl())
  sb_push(b, "            BigIntT { sign: self.sign, limbs: Self::add_mag(&self.limbs, &other.limbs) }.normalize()" + nl())
  sb_push(b, "        } else {" + nl())
  sb_push(b, "            match Self::cmp_mag(&self.limbs, &other.limbs) {" + nl())
  sb_push(b, "                std::cmp::Ordering::Equal => BigIntT::zero()," + nl())
  sb_push(b, "                std::cmp::Ordering::Greater => BigIntT { sign: self.sign, limbs: Self::sub_mag(&self.limbs, &other.limbs) }.normalize()," + nl())
  sb_push(b, "                std::cmp::Ordering::Less => BigIntT { sign: other.sign, limbs: Self::sub_mag(&other.limbs, &self.limbs) }.normalize()," + nl())
  sb_push(b, "            }" + nl())
  sb_push(b, "        }" + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "    fn sub(&self, other: &BigIntT) -> BigIntT { self.add(&other.negate()) }" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "    fn mul(&self, other: &BigIntT) -> BigIntT {" + nl())
  sb_push(b, "        if self.is_zero() || other.is_zero() { return BigIntT::zero(); }" + nl())
  sb_push(b, "        let mut result = vec![0u64; self.limbs.len() + other.limbs.len()];" + nl())
  sb_push(b, "        for (i, &av) in self.limbs.iter().enumerate() {" + nl())
  sb_push(b, "            if av == 0 { continue; }" + nl())
  sb_push(b, "            let mut carry: u64 = 0;" + nl())
  sb_push(b, "            for (j, &bv) in other.limbs.iter().enumerate() {" + nl())
  sb_push(b, "                let idx = i + j;" + nl())
  sb_push(b, "                let prod = (av as u64) * (bv as u64) + result[idx] + carry;" + nl())
  sb_push(b, "                result[idx] = prod % NT_BASE;" + nl())
  sb_push(b, "                carry = prod / NT_BASE;" + nl())
  sb_push(b, "            }" + nl())
  return true
end

