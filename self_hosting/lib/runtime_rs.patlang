  sb_push(b, "fn host_bin_num(args: &[Value], f: fn(f64,f64)->f64) -> Result<Value, String> {" + nl())
  sb_push(b, "    let a = args.get(0).ok_or(" + q() + "expected 2 args" + q() + ")?;" + nl())
  sb_push(b, "    let b = args.get(1).ok_or(" + q() + "expected 2 args" + q() + ")?;" + nl())
