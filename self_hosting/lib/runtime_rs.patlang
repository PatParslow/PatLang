  sb_push(b, "    let program = build_program();" + nl())
  sb_push(b, "    match run(&program) { Ok(v) => println!(" + q() + "{}" + q() + ", display_value(&v)), Err(e) => { eprintln!(" + q() + "IR runtime error: {}" + q() + ", e); std::process::exit(1); } }" + nl())
