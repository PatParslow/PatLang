  sb_push(b, "" + nl())
  sb_push(b, "// display_value now comes from whichever value-module is selected (see the" + nl())
  sb_push(b, "// note above `enum BinOpKind`)." + nl())
  sb_push(b, "" + nl())
  sb_push(b, "// bit_get/bit_set/bit_slice/bit_set_slice (ChunkId::Core, always present)" + nl())
