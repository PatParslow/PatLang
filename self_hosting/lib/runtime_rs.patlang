  sb_push(b, "                let args_index = stack.len() - argc; let args: Vec<Value> = stack.drain(args_index..).collect();" + nl())
  sb_push(b, "                let callee = program.functions.get(n).ok_or_else(|| format!(" + q() + "function '{}' not found" + q() + ", n))?;" + nl())
  sb_push(b, "                let r = run_function(program, callee, &args)?; stack.push(r);" + nl())
