# Mirrors rust-runtime/src/ir/codegen.rs's RustCodegen::build_dispatch: the
# only part of the emitted text that is not a static per-chunk constant,
# since which chunks are present varies per program. Must produce
# byte-identical text to the Rust side for the same `names` list, in the
# same canonical order, or the whole-program parity assertion fails on
# ordering alone.
# (list_contains is defined in lib/codegen.patlang, which is always loaded
# alongside this file, so it is not redefined here.)
make a function called emit_dispatch_for takes names returns s
  let b = sb_new()
  sb_push(b, "fn call_dispatch(name: &str, args: &[Value]) -> Result<Value, String> {" + nl())
  if list_contains(names, "strings_ext") then
    sb_push(b, "    if let Some(r) = host_call_strings_ext(name, args) { return r; }" + nl())
  end
  if list_contains(names, "collections_handles") then
    sb_push(b, "    if let Some(r) = host_call_collections_handles(name, args) { return r; }" + nl())
  end
  if list_contains(names, "files") then
    sb_push(b, "    if let Some(r) = host_call_files(name, args) { return r; }" + nl())
  end
  if list_contains(names, "io_misc") then
    sb_push(b, "    if let Some(r) = host_call_io_misc(name, args) { return r; }" + nl())
  end
  if list_contains(names, "oo") then
    sb_push(b, "    if let Some(r) = host_call_oo(name, args) { return r; }" + nl())
  end
  if list_contains(names, "logic") then
    sb_push(b, "    if let Some(r) = host_call_logic(name, args) { return r; }" + nl())
  end
  if list_contains(names, "contracts") then
    sb_push(b, "    if let Some(r) = host_call_contracts(name, args) { return r; }" + nl())
  end
  if list_contains(names, "networking") then
    sb_push(b, "    if let Some(r) = host_call_networking(name, args) { return r; }" + nl())
  end
  if list_contains(names, "codegen_bootstrap") then
    sb_push(b, "    if let Some(r) = host_call_codegen_bootstrap(name, args) { return r; }" + nl())
  end
  if list_contains(names, "math") then
    sb_push(b, "    if let Some(r) = host_call_math(name, args) { return r; }" + nl())
  end
  sb_push(b, "    Err(format!(" + q() + "host fn '{}' not found" + q() + ", name))" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  return sb_str(b)
end

