  sb_push(b, "fn vfs_keys() -> Vec<String> { VFS.with(|m| m.borrow().keys().cloned().collect()) }" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "#[cfg(any(not(target_arch = \"wasm32\"), target_feature = \"atomics\"))]" + nl())
  sb_push(b, "static VFS: OnceLock<Mutex<HashMap<String, String>>> = OnceLock::new();" + nl())
  sb_push(b, "#[cfg(any(not(target_arch = \"wasm32\"), target_feature = \"atomics\"))]" + nl())
  sb_push(b, "fn vfs_get(path: &str) -> Option<String> { VFS.get_or_init(|| Mutex::new(HashMap::new())).lock().unwrap().get(path).cloned() }" + nl())
  sb_push(b, "#[cfg(any(not(target_arch = \"wasm32\"), target_feature = \"atomics\"))]" + nl())
  sb_push(b, "fn vfs_set(path: String, contents: String) { VFS.get_or_init(|| Mutex::new(HashMap::new())).lock().unwrap().insert(path, contents); }" + nl())
  sb_push(b, "#[cfg(any(not(target_arch = \"wasm32\"), target_feature = \"atomics\"))]" + nl())
  sb_push(b, "fn vfs_del(path: &str) -> bool { VFS.get_or_init(|| Mutex::new(HashMap::new())).lock().unwrap().remove(path).is_some() }" + nl())
  sb_push(b, "#[cfg(any(not(target_arch = \"wasm32\"), target_feature = \"atomics\"))]" + nl())
  sb_push(b, "fn vfs_keys() -> Vec<String> { VFS.get_or_init(|| Mutex::new(HashMap::new())).lock().unwrap().keys().cloned().collect() }" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "fn arg_usize(args: &[Value], i: usize, what: &str) -> Result<usize, String> {" + nl())
  sb_push(b, "    match args.get(i) {" + nl())
  sb_push(b, "        Some(Value::Number(n)) => Ok(*n as usize)," + nl())
  sb_push(b, "        Some(Value::String(s)) => s.trim().parse::<usize>().map_err(|_| format!(\"{}: expected index\", what))," + nl())
  sb_push(b, "        _ => Err(format!(\"{}: expected number\", what))," + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "fn arg_num(args: &[Value], i: usize, what: &str) -> Result<f64, String> {" + nl())
  sb_push(b, "    match args.get(i) {" + nl())
  sb_push(b, "        Some(Value::Number(n)) => Ok(*n)," + nl())
  sb_push(b, "        Some(Value::String(s)) => s.trim().parse::<f64>().map_err(|_| format!(\"{}: expected number\", what))," + nl())
  sb_push(b, "        _ => Err(format!(\"{}: expected number\", what))," + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "#[cfg(all(target_arch = \"wasm32\", not(target_feature = \"atomics\")))]" + nl())
  sb_push(b, "fn obj_get(name: &str, prop: &str) -> Option<Value> {" + nl())
  sb_push(b, "    OBJECTS.with(|o| {" + nl())
  sb_push(b, "        let b = o.borrow();" + nl())
  sb_push(b, "        b.get(name).and_then(|m| m.get(prop)).cloned()" + nl())
  sb_push(b, "    })" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "#[cfg(all(target_arch = \"wasm32\", not(target_feature = \"atomics\")))]" + nl())
  sb_push(b, "fn obj_set(name: &str, prop: &str, val: Value) {" + nl())
  sb_push(b, "    OBJECTS.with(|o| {" + nl())
  sb_push(b, "        let mut b = o.borrow_mut();" + nl())
  sb_push(b, "        let m = b.entry(name.to_string()).or_insert_with(HashMap::new);" + nl())
  sb_push(b, "        m.insert(prop.to_string(), val);" + nl())
  sb_push(b, "    });" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "#[cfg(any(not(target_arch = \"wasm32\"), target_feature = \"atomics\"))]" + nl())
  sb_push(b, "fn obj_get(name: &str, prop: &str) -> Option<Value> {" + nl())
  sb_push(b, "    OBJECTS.get_or_init(|| Mutex::new(HashMap::new())).lock().unwrap().get(name).and_then(|m| m.get(prop)).cloned()" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "#[cfg(any(not(target_arch = \"wasm32\"), target_feature = \"atomics\"))]" + nl())
  sb_push(b, "fn obj_set(name: &str, prop: &str, val: Value) {" + nl())
  sb_push(b, "    let mut b = OBJECTS.get_or_init(|| Mutex::new(HashMap::new())).lock().unwrap();" + nl())
  sb_push(b, "    b.entry(name.to_string()).or_insert_with(HashMap::new).insert(prop.to_string(), val);" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "fn ensure_obj(name: &str, class: &str) {" + nl())
  sb_push(b, "    obj_set(name, \"type\", Value::String(class.to_string()));" + nl())
  sb_push(b, "    obj_set(name, \"name\", Value::String(name.to_string()));" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "// NOTE: `enum Value` and its `impl` (as_number/as_bool), plus display_value," + nl())
  sb_push(b, "// add/sub/mul/div/modu/cmp/to_s/neg, used to live inline here. As of Stage 38" + nl())
  sb_push(b, "// they are provided by exactly one of two mutually-exclusive value-modules" + nl())
  sb_push(b, "// selected per compiled program by `prelude_for` (never both, never" + nl())
  sb_push(b, "// neither): `PRELUDE_VALUE_FAST` (today's plain `Number(f64)` + new cheap" + nl())
  sb_push(b, "// `Int(i64)`/`Float(f64)` fast-path variants, no bignum) when the program's" + nl())
  sb_push(b, "// IR contains no numeric operator at all, or `PRELUDE_NUMERIC_TOWER` (adds" + nl())
  sb_push(b, "// BigInt/Rational/Complex, hand-rolled, no external crates) when it does." + nl())
  sb_push(b, "// This split exists because `Value`'s definition is shared/monomorphic" + nl())
  sb_push(b, "// across every other chunk's text, so its variant set can't differ chunk by" + nl())
  sb_push(b, "// chunk within a single build -- see the doc comment on `PRELUDE_VALUE_FAST`" + nl())
  return true
end

make a function called emit_runtime_rs_core_1 takes b returns done
  sb_push(b, "// for the full rationale (Stage 38, \"risky shared-dependency edit\")." + nl())
  sb_push(b, "" + nl())
  sb_push(b, "#[derive(Clone, Debug, PartialEq)]" + nl())
  sb_push(b, "enum BinOpKind { Add, Sub, Mul, Div, Mod, Eq, Ne, Lt, Le, Gt, Ge, And, Or, BitAnd, BitOr, BitXor, Shl, Shr }" + nl())
  sb_push(b, "#[derive(Clone, Debug, PartialEq)]" + nl())
  sb_push(b, "enum UnOpKind { Neg, Not, BitNot }" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "#[derive(Clone, Debug, PartialEq)]" + nl())
  sb_push(b, "enum Instr {" + nl())
  sb_push(b, "    Const(Value)," + nl())
  sb_push(b, "    LoadLocal(String)," + nl())
  sb_push(b, "    StoreLocal(String)," + nl())
  sb_push(b, "    BinOp(BinOpKind)," + nl())
  sb_push(b, "    UnOp(UnOpKind)," + nl())
  sb_push(b, "    Jump(usize)," + nl())
  sb_push(b, "    JumpIfFalse(usize)," + nl())
  sb_push(b, "    CallHost(String, usize)," + nl())
  sb_push(b, "    Call(String, usize)," + nl())
  sb_push(b, "    MakeClosure(String, Vec<String>)," + nl())
  sb_push(b, "    CallValue(usize)," + nl())
  sb_push(b, "    BuildList(usize)," + nl())
  sb_push(b, "    Return," + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "struct Host;" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "// Stage 38: literals now emit `Value::Int`/`Value::Float` by default (see" + nl())
  sb_push(b, "// `emit_value`), not `Value::Number`, so that `div`'s int/int exactness check" + nl())
  sb_push(b, "// can tell them apart. Every host function OTHER than the arithmetic BinOp" + nl())
  sb_push(b, "// dispatch (add/sub/mul/div/modu/cmp, handled directly in `run_function`, not" + nl())
  sb_push(b, "// via `Host::call`) still pattern-matches `Value::Number` explicitly in its" + nl())
  sb_push(b, "// own unmodified chunk text (list indices, counts, etc.) -- per Stage 38's" + nl())
  sb_push(b, "// \"minimal blast radius\" goal those chunks are left untouched. Instead," + nl())
  sb_push(b, "// arguments are coerced back to plain `Number(f64)` right at the `Host::call`" + nl())
  sb_push(b, "// boundary, restoring pre-Stage-38 behavior for every non-arithmetic host" + nl())
  sb_push(b, "// function regardless of which value-module (`PRELUDE_VALUE_FAST` or" + nl())
  sb_push(b, "// `PRELUDE_NUMERIC_TOWER`) is selected." + nl())
  sb_push(b, "fn host_coerce_arg(v: &Value) -> Value {" + nl())
  sb_push(b, "    match v {" + nl())
  sb_push(b, "        Value::Int(n) => Value::Number(*n as f64)," + nl())
  sb_push(b, "        Value::Float(n) => Value::Number(*n)," + nl())
  sb_push(b, "        // BigInt/Rational/Complex are passed through UNCHANGED, not lossily" + nl())
  sb_push(b, "        // flattened: `print`/`display_value` (and anything else that just" + nl())
  sb_push(b, "        // consumes a `Value` generically rather than pattern-matching" + nl())
  sb_push(b, "        // `Value::Number` for an index/count) must see the exact tower value," + nl())
  sb_push(b, "        // or e.g. `print(10 / 3)` would silently lose exactness at this" + nl())
  sb_push(b, "        // boundary and print a lossy float instead of \"10/3\". Any" + nl())
  sb_push(b, "        // non-arithmetic host function that genuinely expected a plain index" + nl())
  sb_push(b, "        // here already had no better fallback pre-Stage-38 either (a" + nl())
  sb_push(b, "        // non-`Number`/`String` arg always fell through to that function's" + nl())
  sb_push(b, "        // own `_ => default` arm)." + nl())
  sb_push(b, "        other => other.clone()," + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "impl Host {" + nl())
  sb_push(b, "    fn call(name: &str, args: &[Value]) -> Result<Value, String> {" + nl())
  sb_push(b, "        // type_of needs to see the pre-coercion value (host_coerce_arg below" + nl())
  sb_push(b, "        // flattens Int/Float down to Number for every other host call," + nl())
  sb_push(b, "        // which would make type_of(1) wrongly report \"float\" instead of" + nl())
  sb_push(b, "        // \"int\" -- checked before the generic coercion, matching how the" + nl())
  sb_push(b, "        // interpreter's own host_type_of (ir/hosts.rs) never coerces at all)." + nl())
  sb_push(b, "        if name == \"type_of\" { return Ok(type_of_impl(args)); }" + nl())
  sb_push(b, "        let __coerced_args: Vec<Value> = args.iter().map(host_coerce_arg).collect();" + nl())
  sb_push(b, "        let args: &[Value] = &__coerced_args;" + nl())
  sb_push(b, "        match name {" + nl())
  sb_push(b, "\"list_get\" => {" + nl())
  sb_push(b, "                // list_get(list, index)" + nl())
  sb_push(b, "                if args.len() != 2 { return Err(\"expected 2 args\".into()); }" + nl())
  sb_push(b, "                let idx = match &args[1] { Value::Number(n) => *n as usize, Value::String(s) => s.parse::<usize>().unwrap_or(0), _ => 0 };" + nl())
  sb_push(b, "                match &args[0] {" + nl())
  sb_push(b, "                    Value::List(xs) => Ok(xs.get(idx).cloned().unwrap_or(Value::Unit))," + nl())
  sb_push(b, "                    Value::String(s) => {" + nl())
  sb_push(b, "                        if s.is_ascii() {" + nl())
  sb_push(b, "                            return Ok(match s.as_bytes().get(idx) { Some(b) => Value::String((*b as char).to_string()), None => Value::String(String::new()) });" + nl())
  sb_push(b, "                        }" + nl())
  sb_push(b, "                        let ch = s.chars().nth(idx).unwrap_or('\\0');" + nl())
  sb_push(b, "                        Ok(Value::String(if ch == '\\0' { String::new() } else { ch.to_string() }))" + nl())
  sb_push(b, "                    }" + nl())
  sb_push(b, "                    _ => Ok(Value::Unit)," + nl())
  sb_push(b, "                }" + nl())
  sb_push(b, "            }" + nl())
  sb_push(b, "            \"list_len\" => {" + nl())
  sb_push(b, "                // list_len(listOrString) -> String count (to match Stage 0 builtins)" + nl())
  sb_push(b, "                if args.len() != 1 { return Err(\"expected 1 arg\".into()); }" + nl())
  sb_push(b, "                let n = match &args[0] {" + nl())
  sb_push(b, "                    Value::List(xs) => xs.len()," + nl())
  sb_push(b, "                    Value::String(s) => s.chars().count()," + nl())
  sb_push(b, "                    _ => 0," + nl())
  sb_push(b, "                };" + nl())
  sb_push(b, "                Ok(Value::String(n.to_string()))" + nl())
  sb_push(b, "            }" + nl())
  sb_push(b, "            \"list_push\" => {" + nl())
  sb_push(b, "                // list_push(list, item) -> new list with item appended" + nl())
  sb_push(b, "                if args.len() != 2 { return Err(\"list_push: expected 2 args\".into()); }" + nl())
  sb_push(b, "                let mut xs = match &args[0] {" + nl())
  sb_push(b, "                    Value::List(xs) => xs.clone()," + nl())
  sb_push(b, "                    Value::Unit => Vec::new()," + nl())
  sb_push(b, "                    _ => return Err(\"list_push: expected list\".into())," + nl())
  sb_push(b, "                };" + nl())
  sb_push(b, "                xs.push(args[1].clone());" + nl())
  sb_push(b, "                Ok(Value::List(xs))" + nl())
  sb_push(b, "            }" + nl())
  sb_push(b, "            \"list_set\" => {" + nl())
  sb_push(b, "                // list_set(list, index, value) -> new list with element replaced" + nl())
  sb_push(b, "                if args.len() != 3 { return Err(\"list_set: expected 3 args\".into()); }" + nl())
  sb_push(b, "                let mut xs = match &args[0] {" + nl())
  sb_push(b, "                    Value::List(xs) => xs.clone()," + nl())
  sb_push(b, "                    _ => return Err(\"list_set: expected list\".into())," + nl())
  sb_push(b, "                };" + nl())
  sb_push(b, "                let idx = match &args[1] { Value::Number(n) => *n as usize, Value::String(s) => s.parse::<usize>().unwrap_or(usize::MAX), _ => usize::MAX };" + nl())
  sb_push(b, "                if idx >= xs.len() { return Err(format!(\"list_set: index {} out of range (len {})\", idx, xs.len())); }" + nl())
  sb_push(b, "                xs[idx] = args[2].clone();" + nl())
  sb_push(b, "                Ok(Value::List(xs))" + nl())
  sb_push(b, "            }" + nl())
  sb_push(b, "            \"bit_get\" => {" + nl())
  sb_push(b, "                if args.len() != 2 { return Err(\"bit_get: expected 2 args (n, pos)\".into()); }" + nl())
  sb_push(b, "                let n = bits_of(&args[0])?;" + nl())
  sb_push(b, "                let pos = bits_of(&args[1])?;" + nl())
  sb_push(b, "                if !(0..64).contains(&pos) { return Err(format!(\"bit_get: pos {} out of range 0..63\", pos)); }" + nl())
  sb_push(b, "                Ok(Value::Int((n >> pos) & 1))" + nl())
  sb_push(b, "            }" + nl())
  sb_push(b, "            \"bit_set\" => {" + nl())
  sb_push(b, "                if args.len() != 3 { return Err(\"bit_set: expected 3 args (n, pos, val)\".into()); }" + nl())
  sb_push(b, "                let n = bits_of(&args[0])?;" + nl())
  sb_push(b, "                let pos = bits_of(&args[1])?;" + nl())
  sb_push(b, "                let val = bits_of(&args[2])?;" + nl())
  sb_push(b, "                if !(0..64).contains(&pos) { return Err(format!(\"bit_set: pos {} out of range 0..63\", pos)); }" + nl())
  sb_push(b, "                let mask = 1i64 << pos;" + nl())
  sb_push(b, "                Ok(Value::Int(if val != 0 { n | mask } else { n & !mask }))" + nl())
  sb_push(b, "            }" + nl())
  sb_push(b, "            \"bit_slice\" => {" + nl())
  sb_push(b, "                if args.len() != 3 { return Err(\"bit_slice: expected 3 args (n, start, width)\".into()); }" + nl())
  sb_push(b, "                let n = bits_of(&args[0])?;" + nl())
  sb_push(b, "                let start = bits_of(&args[1])?;" + nl())
  sb_push(b, "                let width = bits_of(&args[2])?;" + nl())
  sb_push(b, "                if !(0..64).contains(&start) { return Err(format!(\"bit_slice: start {} out of range 0..63\", start)); }" + nl())
  sb_push(b, "                if !(0..=64).contains(&width) || start + width > 64 { return Err(format!(\"bit_slice: width {} at start {} out of range\", width, start)); }" + nl())
  sb_push(b, "                if width == 0 { return Ok(Value::Int(0)); }" + nl())
  sb_push(b, "                let mask: i64 = if width == 64 { -1 } else { (1i64 << width) - 1 };" + nl())
  sb_push(b, "                Ok(Value::Int((n >> start) & mask))" + nl())
  sb_push(b, "            }" + nl())
  sb_push(b, "            \"bit_set_slice\" => {" + nl())
  sb_push(b, "                if args.len() != 4 { return Err(\"bit_set_slice: expected 4 args (n, start, width, val)\".into()); }" + nl())
  sb_push(b, "                let n = bits_of(&args[0])?;" + nl())
  sb_push(b, "                let start = bits_of(&args[1])?;" + nl())
  sb_push(b, "                let width = bits_of(&args[2])?;" + nl())
  sb_push(b, "                let val = bits_of(&args[3])?;" + nl())
  sb_push(b, "                if !(0..64).contains(&start) { return Err(format!(\"bit_set_slice: start {} out of range 0..63\", start)); }" + nl())
  sb_push(b, "                if !(0..=64).contains(&width) || start + width > 64 { return Err(format!(\"bit_set_slice: width {} at start {} out of range\", width, start)); }" + nl())
  return true
end

