  sb_push(b, "" + nl())
  sb_push(b, "#[derive(Clone)]" + nl())
  sb_push(b, "struct Function { name: String, params: Vec<String>, body: Vec<Instr> }" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "#[derive(Clone)]" + nl())
  sb_push(b, "struct Program { functions: HashMap<String, Function>, entry: String }" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "fn run(program: &Program) -> Result<Value,String> {" + nl())
  sb_push(b, "    let entry = program.functions.get(&program.entry).ok_or(\"entry not found\")?;" + nl())
  sb_push(b, "    run_function(program, entry, &[])" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "// Fibers: Ruby-style cooperative green threads on top of real OS threads," + nl())
  sb_push(b, "// ported directly from rust-runtime/src/ir/fiber.rs's interpreter-side" + nl())
  sb_push(b, "// implementation -- same mutex+condvar design, just resolving/calling" + nl())
  sb_push(b, "// program functions via this file's own `run_function`/`Program::clone()`" + nl())
  sb_push(b, "// instead of `Interpreter::call_function`. Not available on an ordinary" + nl())
  sb_push(b, "// wasm32 build: that target has no std::thread support (see the `main()`" + nl())
  sb_push(b, "// split below for the same constraint already handled once). It IS" + nl())
  sb_push(b, "// available on a wasm32 build compiled with atomics (e.g." + nl())
  sb_push(b, "// wasm32-wasip1-threads), where std::thread/Mutex/Condvar are real --" + nl())
  sb_push(b, "// hence gating on target_feature = \"atomics\" rather than target_arch." + nl())
  sb_push(b, "#[cfg(any(not(target_arch = \"wasm32\"), target_feature = \"atomics\"))]" + nl())
  sb_push(b, "mod fibers {" + nl())
  sb_push(b, "    use super::{Program, Value, run_function};" + nl())
  sb_push(b, "    use std::collections::HashMap;" + nl())
  sb_push(b, "    use std::sync::atomic::{AtomicU64, Ordering};" + nl())
  sb_push(b, "    use std::sync::{Arc, Condvar, Mutex, OnceLock};" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "    enum FiberMsg {" + nl())
  sb_push(b, "        Yielded(Value)," + nl())
  sb_push(b, "        Done(Result<Value, String>)," + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "    struct FiberBox {" + nl())
  sb_push(b, "        to_fiber: Option<Value>," + nl())
  sb_push(b, "        from_fiber: Option<FiberMsg>," + nl())
  sb_push(b, "        alive: bool," + nl())
  sb_push(b, "        budget_deadline_ms: Option<i64>," + nl())
  sb_push(b, "        budget_last_check_ms: Option<i64>," + nl())
  sb_push(b, "        recent_durations: Vec<i64>," + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "    struct FiberHandle {" + nl())
  sb_push(b, "        state: Mutex<FiberBox>," + nl())
  sb_push(b, "        cv: Condvar," + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "    fn registry() -> &'static Mutex<HashMap<u64, Arc<FiberHandle>>> {" + nl())
  sb_push(b, "        static REGISTRY: OnceLock<Mutex<HashMap<u64, Arc<FiberHandle>>>> = OnceLock::new();" + nl())
  sb_push(b, "        REGISTRY.get_or_init(|| Mutex::new(HashMap::new()))" + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "    fn next_id() -> u64 {" + nl())
  sb_push(b, "        static NEXT: AtomicU64 = AtomicU64::new(1);" + nl())
  sb_push(b, "        NEXT.fetch_add(1, Ordering::Relaxed)" + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "    thread_local! {" + nl())
  sb_push(b, "        static CURRENT_FIBER: std::cell::Cell<Option<u64>> = std::cell::Cell::new(None);" + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "    fn now_ms_i64() -> i64 {" + nl())
  sb_push(b, "        std::time::SystemTime::now()" + nl())
  sb_push(b, "            .duration_since(std::time::UNIX_EPOCH)" + nl())
  sb_push(b, "            .map(|d| d.as_millis() as i64)" + nl())
  sb_push(b, "            .unwrap_or(0)" + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "    pub fn fiber_new(program: &Program, func_name: String) -> Result<Value, String> {" + nl())
  sb_push(b, "        if !program.functions.contains_key(&func_name) {" + nl())
  sb_push(b, "            return Err(format!(\"fiber_new: function '{}' not found\", func_name));" + nl())
  sb_push(b, "        }" + nl())
  return true
end

