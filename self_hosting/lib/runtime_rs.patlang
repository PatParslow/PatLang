  sb_push(b, "" + nl())
  sb_push(b, "        Ok(Value::Int(id as i64))" + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "    fn handle_for(id: u64) -> Result<Arc<FiberHandle>, String> {" + nl())
