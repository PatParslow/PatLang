  sb_push(b, "" + nl())
  sb_push(b, "    pub fn fiber_alive(id_val: &Value) -> Result<Value, String> {" + nl())
  sb_push(b, "        let id = id_from_value(id_val)?;" + nl())
  sb_push(b, "        let handle = handle_for(id)?;" + nl())
