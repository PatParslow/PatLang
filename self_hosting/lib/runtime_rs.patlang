  sb_push(b, "    if !global {" + nl())
  sb_push(b, "        if let Some(pos) = hay_l.find(&pat_l) {" + nl())
  sb_push(b, "            let mut out = String::with_capacity(hay.len());" + nl())
  sb_push(b, "            out.push_str(&hay[..pos]);" + nl())
  sb_push(b, "            out.push_str(rep);" + nl())
  sb_push(b, "            out.push_str(&hay[pos+pat.len()..]);" + nl())
  sb_push(b, "            return out;" + nl())
  sb_push(b, "        }" + nl())
  sb_push(b, "        return hay.to_string();" + nl())
  sb_push(b, "    } else {" + nl())
  sb_push(b, "        let mut out = String::with_capacity(hay.len());" + nl())
  sb_push(b, "        let mut start = 0usize;" + nl())
  sb_push(b, "        let mut idx = 0usize;" + nl())
  sb_push(b, "        while idx <= hay_l.len() {" + nl())
  sb_push(b, "            if let Some(pos) = hay_l[idx..].find(&pat_l) {" + nl())
  sb_push(b, "                let abs = idx + pos;" + nl())
  sb_push(b, "                out.push_str(&hay[start..abs]);" + nl())
  sb_push(b, "                out.push_str(rep);" + nl())
  sb_push(b, "                start = abs + pat.len();" + nl())
  sb_push(b, "                idx = start;" + nl())
  sb_push(b, "            } else { break; }" + nl())
  sb_push(b, "        }" + nl())
  sb_push(b, "        out.push_str(&hay[start..]);" + nl())
  sb_push(b, "        return out;" + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "// Simple interpolation: replace occurrences of #{name} using OBJECTS store vars or event locals if provided in scope." + nl())
  sb_push(b, "fn interpolate(input: &str) -> String {" + nl())
  sb_push(b, "    let mut out = String::new();" + nl())
  sb_push(b, "    let b = input.as_bytes();" + nl())
  sb_push(b, "    let mut i = 0usize;" + nl())
  sb_push(b, "    while i < b.len() {" + nl())
  sb_push(b, "        if i + 2 < b.len() && b[i] as char == '#' && b[i+1] as char == '{' {" + nl())
  sb_push(b, "            i += 2; let start = i;" + nl())
  sb_push(b, "            while i < b.len() && b[i] as char != '}' { i += 1; }" + nl())
  sb_push(b, "            let key = &input[start..i];" + nl())
  sb_push(b, "            let val = resolve_interp_var(key);" + nl())
  sb_push(b, "            out.push_str(&val);" + nl())
  sb_push(b, "            if i < b.len() && b[i] as char == '}' { i += 1; }" + nl())
  sb_push(b, "        } else { out.push(b[i] as char); i += 1; }" + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "    out" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "fn resolve_interp_var(key: &str) -> String {" + nl())
  sb_push(b, "    // Try OBJECTS first (object.name property), then fall back to key itself." + nl())
  sb_push(b, "    if let Some((obj, prop)) = key.split_once('.') {" + nl())
  sb_push(b, "        if let Some(v) = obj_get(obj, prop) { return display_value(&v); }" + nl())
  sb_push(b, "    } else {" + nl())
  sb_push(b, "        // No dot: may refer to a plain variable set on a synthetic " + q() + "__vars" + q() + " object by handlers." + nl())
  sb_push(b, "        if let Some(v) = obj_get(" + q() + "__vars" + q() + ", key) { return display_value(&v); }" + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "    String::new()" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "#[derive(Clone)]" + nl())
  sb_push(b, "struct Function { name: String, params: Vec<String>, body: Vec<Instr> }" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "struct Program { functions: HashMap<String, Function>, entry: String }" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "fn run(program: &Program) -> Result<Value,String> {" + nl())
  sb_push(b, "    let entry = program.functions.get(&program.entry).ok_or(" + q() + "entry not found" + q() + ")?;" + nl())
  sb_push(b, "    run_function(program, entry, &[])" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "fn run_function(program: &Program, func: &Function, args: &[Value]) -> Result<Value,String> {" + nl())
  sb_push(b, "    let mut pc: usize = 0;" + nl())
  sb_push(b, "    let mut stack: Vec<Value> = Vec::new();" + nl())
  sb_push(b, "    let mut locals: HashMap<String, Value> = HashMap::new();" + nl())
  sb_push(b, "    // bind params" + nl())
  sb_push(b, "    for (i, p) in func.params.iter().enumerate() { if let Some(v) = args.get(i) { locals.insert(p.clone(), v.clone()); } }" + nl())
  sb_push(b, "    while pc < func.body.len() {" + nl())
  sb_push(b, "        match &func.body[pc] {" + nl())
  sb_push(b, "            Instr::Const(v) => stack.push(v.clone())," + nl())
  sb_push(b, "            Instr::LoadLocal(n) => stack.push(locals.get(n).cloned().unwrap_or(Value::Unit))," + nl())
  sb_push(b, "            Instr::StoreLocal(n) => { let v = stack.pop().ok_or(" + q() + "stack underflow" + q() + ")?; locals.insert(n.clone(), v); }," + nl())
  sb_push(b, "            Instr::UnOp(k) => {" + nl())
  sb_push(b, "                let a = stack.pop().ok_or(" + q() + "stack underflow" + q() + ")?;" + nl())
  sb_push(b, "                let r = match k { UnOpKind::Neg => Value::Number(-a.as_number()?), UnOpKind::Not => Value::Bool(!a.as_bool()?) };" + nl())
  sb_push(b, "                stack.push(r);" + nl())
  sb_push(b, "            }" + nl())
  sb_push(b, "            Instr::BinOp(k) => {" + nl())
  sb_push(b, "                use BinOpKind::*;" + nl())
  sb_push(b, "                let b = stack.pop().ok_or(" + q() + "stack underflow" + q() + ")?;" + nl())
  sb_push(b, "                let a = stack.pop().ok_or(" + q() + "stack underflow" + q() + ")?;" + nl())
  return true
end

