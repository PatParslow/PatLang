  sb_push(b, "        " + q() + "ceil" + q() + " => math_round_like(args.get(0).ok_or(" + q() + "ceil: expected 1 arg" + q() + ")?, " + q() + "ceil" + q() + ")," + nl())
  sb_push(b, "        " + q() + "round" + q() + " => math_round_like(args.get(0).ok_or(" + q() + "round: expected 1 arg" + q() + ")?, " + q() + "round" + q() + ")," + nl())
