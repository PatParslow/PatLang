  sb_push(b, "                                                newest = match newest {" + nl())
  sb_push(b, "                                                    Some((prev_t, _)) => if t > prev_t { Some((t, path_str)) } else { newest }," + nl())
  sb_push(b, "                                                    None => Some((t, path_str))," + nl())
  return true
end

