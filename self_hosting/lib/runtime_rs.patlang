  sb_push(b, "fn math_int_pow_exact(base: &Value, exp: i64) -> Result<Value, String> {" + nl())
  sb_push(b, "    if exp == 0 { return Ok(Value::Int(1)); }" + nl())
  sb_push(b, "    if exp < 0 {" + nl())
  sb_push(b, "        let pos = math_int_pow_exact(base, -exp)?;" + nl())
  sb_push(b, "        return div(&Value::Int(1), &pos);" + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "    let mut result = Value::Int(1);" + nl())
  sb_push(b, "    let mut b = base.clone();" + nl())
  sb_push(b, "    let mut e = exp as u64;" + nl())
  sb_push(b, "    while e > 0 {" + nl())
  sb_push(b, "        if e & 1 == 1 { result = mul(&result, &b)?; }" + nl())
  sb_push(b, "        e >>= 1;" + nl())
  sb_push(b, "        if e > 0 { b = mul(&b, &b)?; }" + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "    Ok(result)" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "fn math_pow(args: &[Value]) -> Result<Value, String> {" + nl())
  sb_push(b, "    if args.len() != 2 { return Err(" + q() + "pow: expected 2 args" + q() + ".to_string()); }" + nl())
  sb_push(b, "    if let (Some(b), Some(e)) = (math_exact_base(&args[0]), math_exp_as_i64(&args[1])) {" + nl())
  sb_push(b, "        return math_int_pow_exact(&b, e);" + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "    let bf = args[0].as_number()?;" + nl())
  sb_push(b, "    let ef = args[1].as_number()?;" + nl())
  sb_push(b, "    Ok(Value::Float(bf.powf(ef)))" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "fn math_round_f(f: f64, mode: &str) -> f64 {" + nl())
  sb_push(b, "    match mode { " + q() + "floor" + q() + " => f.floor(), " + q() + "ceil" + q() + " => f.ceil(), " + q() + "round" + q() + " => f.round(), " + q() + "trunc" + q() + " => f.trunc(), _ => f }" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "fn math_round_like(v: &Value, mode: &str) -> Result<Value, String> {" + nl())
  sb_push(b, "    match v {" + nl())
  sb_push(b, "        Value::Int(_) | Value::BigInt(_) => Ok(v.clone())," + nl())
  sb_push(b, "        Value::Number(f) if f.fract() == 0.0 => Ok(v.clone())," + nl())
  sb_push(b, "        Value::Rational(r) => {" + nl())
  sb_push(b, "            let (q, rem) = r.num.div_rem(&r.den);" + nl())
  sb_push(b, "            let n_is_neg = r.num.is_negative();" + nl())
  sb_push(b, "            let n_is_pos = !r.num.is_zero() && !n_is_neg;" + nl())
  sb_push(b, "            let result = match mode {" + nl())
  sb_push(b, "                " + q() + "trunc" + q() + " => q," + nl())
  sb_push(b, "                " + q() + "floor" + q() + " => if !rem.is_zero() && n_is_neg { q.sub(&BigIntT::from_i64(1)) } else { q }," + nl())
  sb_push(b, "                " + q() + "ceil" + q() + " => if !rem.is_zero() && n_is_pos { q.add(&BigIntT::from_i64(1)) } else { q }," + nl())
  sb_push(b, "                " + q() + "round" + q() + " => {" + nl())
  sb_push(b, "                    let two_rem = rem.mul(&BigIntT::from_i64(2));" + nl())
  sb_push(b, "                    let two_rem_abs = if two_rem.is_negative() { two_rem.negate() } else { two_rem };" + nl())
  sb_push(b, "                    let past_half = BigIntT::cmp(&two_rem_abs, &r.den) != std::cmp::Ordering::Less;" + nl())
  sb_push(b, "                    if past_half { if n_is_neg { q.sub(&BigIntT::from_i64(1)) } else { q.add(&BigIntT::from_i64(1)) } } else { q }" + nl())
  sb_push(b, "                }" + nl())
  sb_push(b, "                _ => q," + nl())
  sb_push(b, "            };" + nl())
  sb_push(b, "            Ok(nt_to_value(NumT::Big(result).normalize()))" + nl())
  sb_push(b, "        }" + nl())
  sb_push(b, "        Value::Float(f) => Ok(Value::Float(math_round_f(*f, mode)))," + nl())
  sb_push(b, "        Value::Number(f) => Ok(Value::Number(math_round_f(*f, mode)))," + nl())
  sb_push(b, "        Value::Unit => Ok(Value::Int(0))," + nl())
  sb_push(b, "        _ => Err(format!(" + q() + "{}: expected numeric value" + q() + ", mode))," + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "fn math_abs(args: &[Value]) -> Result<Value, String> {" + nl())
  sb_push(b, "    let v = args.get(0).ok_or(" + q() + "abs: expected 1 arg" + q() + ".to_string())?;" + nl())
  sb_push(b, "    match v {" + nl())
  sb_push(b, "        Value::Int(_) | Value::BigInt(_) | Value::Rational(_) => {" + nl())
  sb_push(b, "            if math_is_negative(v) { neg(v) } else { Ok(v.clone()) }" + nl())
  sb_push(b, "        }" + nl())
  sb_push(b, "        Value::Number(f) => Ok(Value::Number(f.abs()))," + nl())
  sb_push(b, "        Value::Float(f) => Ok(Value::Float(f.abs()))," + nl())
  sb_push(b, "        Value::Complex(c) => {" + nl())
  sb_push(b, "            let re2 = nt_to_value(c.re.mul(&c.re));" + nl())
  sb_push(b, "            let im2 = nt_to_value(c.im.mul(&c.im));" + nl())
  sb_push(b, "            let sum = add(&re2, &im2)?;" + nl())
  sb_push(b, "            math_sqrt(&sum)" + nl())
  sb_push(b, "        }" + nl())
  sb_push(b, "        Value::Unit => Ok(Value::Int(0))," + nl())
  sb_push(b, "        _ => Err(" + q() + "abs: expected numeric value" + q() + ".to_string())," + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "fn math_numeric_kind(args: &[Value]) -> Result<Value, String> {" + nl())
  sb_push(b, "    let v = args.get(0).ok_or(" + q() + "numeric_kind: expected 1 arg" + q() + ".to_string())?;" + nl())
  sb_push(b, "    let s = match v {" + nl())
  sb_push(b, "        Value::Int(_) => " + q() + "int" + q() + "," + nl())
  sb_push(b, "        Value::Number(f) => if f.fract() == 0.0 { " + q() + "int" + q() + " } else { " + q() + "float" + q() + " }," + nl())
  sb_push(b, "        Value::Float(_) => " + q() + "float" + q() + "," + nl())
  sb_push(b, "        Value::BigInt(_) => " + q() + "bigint" + q() + "," + nl())
  sb_push(b, "        Value::Rational(_) => " + q() + "rational" + q() + "," + nl())
  sb_push(b, "        Value::Complex(_) => " + q() + "complex" + q() + "," + nl())
  sb_push(b, "        _ => " + q() + "other" + q() + "," + nl())
  sb_push(b, "    };" + nl())
  sb_push(b, "    Ok(Value::String(s.to_string()))" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "fn host_call_math_inner(name: &str, args: &[Value]) -> Result<Value, String> {" + nl())
  sb_push(b, "    match name {" + nl())
  sb_push(b, "        " + q() + "sqrt" + q() + " => math_sqrt(args.get(0).ok_or(" + q() + "sqrt: expected 1 arg" + q() + ")?)," + nl())
  sb_push(b, "        " + q() + "pow" + q() + " => math_pow(args)," + nl())
  sb_push(b, "        " + q() + "sin" + q() + " => Ok(Value::Float(arg_num(args, 0, " + q() + "sin" + q() + ")?.sin()))," + nl())
  sb_push(b, "        " + q() + "cos" + q() + " => Ok(Value::Float(arg_num(args, 0, " + q() + "cos" + q() + ")?.cos()))," + nl())
  sb_push(b, "        " + q() + "tan" + q() + " => Ok(Value::Float(arg_num(args, 0, " + q() + "tan" + q() + ")?.tan()))," + nl())
  return true
end

