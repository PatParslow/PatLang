  sb_push(b, "                    }" + nl())
  sb_push(b, "                });" + nl())
  sb_push(b, "                Ok(Value::Number(count as f64))" + nl())
  sb_push(b, "            }" + nl())
  sb_push(b, "\"rule_add\" => {" + nl())
  sb_push(b, "                if args.len() != 3 { return Err(\"rule_add: expected 3 args (head_pred, head_args_list, body_list)\".into()); }" + nl())
  sb_push(b, "                let head_pred = match &args[0] { Value::String(s) => s.clone(), v => to_s(v) };" + nl())
  sb_push(b, "                let head_args = value_to_str_list(&args[1]);" + nl())
  sb_push(b, "                let body_items = match &args[2] { Value::List(xs) => xs.clone(), _ => Vec::new() };" + nl())
  sb_push(b, "                let mut body = Vec::new();" + nl())
  sb_push(b, "                for item in body_items {" + nl())
  sb_push(b, "                    if let Value::List(pair) = &item {" + nl())
  sb_push(b, "                        if pair.len() == 2 {" + nl())
  sb_push(b, "                            body.push((to_s(&pair[0]), value_to_str_list(&pair[1])));" + nl())
  sb_push(b, "                        }" + nl())
  sb_push(b, "                    }" + nl())
  sb_push(b, "                }" + nl())
  sb_push(b, "                RULES.with(|r| r.borrow_mut().push(LogicRule { head_pred, head_args, body }));" + nl())
  sb_push(b, "                Ok(Value::Unit)" + nl())
  sb_push(b, "            }" + nl())
  sb_push(b, "            \"solve\" => {" + nl())
  sb_push(b, "                if args.len() != 2 { return Err(\"solve: expected 2 args (pred, args_list)\".into()); }" + nl())
  sb_push(b, "                let pred = match &args[0] { Value::String(s) => s.clone(), v => to_s(v) };" + nl())
  sb_push(b, "                let query_args = value_to_str_list(&args[1]);" + nl())
  sb_push(b, "                let empty: LogicSubst = HashMap::new();" + nl())
  sb_push(b, "                let solutions = solve_goal(&pred, &query_args, &empty, 0);" + nl())
  sb_push(b, "                let out: Vec<Value> = solutions.iter().map(|s| {" + nl())
