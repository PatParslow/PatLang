  sb_push(b, "                    Le => an <= bn," + nl())
  sb_push(b, "                    Gt => an > bn," + nl())
  sb_push(b, "                    Ge => an >= bn," + nl())
  sb_push(b, "                    _ => unreachable!()," + nl())
  sb_push(b, "                }" + nl())
  sb_push(b, "            }" + nl())
