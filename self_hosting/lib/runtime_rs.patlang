  sb_push(b, "                let class = match &args[0] { Value::String(s) => s.clone(), _ => String::new() };" + nl())
  sb_push(b, "                let name = match &args[1] { Value::String(s) => s.clone(), _ => String::new() };" + nl())
  sb_push(b, "                if !name.is_empty() { ensure_obj(&name, &class); }" + nl())
