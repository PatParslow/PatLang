# Runtime signals for PatLang programs: a running process can receive a
# named signal + optional payload from OUTSIDE itself -- a second CLI
# invocation ("server.exe --quit" sent to an already-running server, not a
# second server starting up), or a local network call. Delivery reuses
# tcp_connect/tcp_read/tcp_write/tcp_close exactly as they already existed,
# and dispatch reuses the existing when/emit event mechanism (see
# self_hosting/examples/event_loop_server.patlang) -- a signal just becomes
# an emit() call, so any `when <name> do ... end` handler already in the
# receiving program fires normally, no new handler concept needed.
#
# The trick this relies on: tcp_listen binds 127.0.0.1 only (hosts.rs's
# host_tcp_listen -- not configurable, not a new restriction added here),
# and a second bind to the SAME port simply fails. That failure IS the "is
# a primary already running" detector, for free -- no separate lockfile/
# PID-file mechanism needed (PatLang has none today; this doesn't add one).
# The one genuinely new host function this needed: tcp_try_listen(port) ->
# port_id or -1 on AddrInUse specifically, rather than tcp_listen's fatal-
# on-any-bind-failure behavior -- PatLang has no try/catch, so there was no
# way to gracefully ask "is something already listening" without it. See
# hosts.rs's host_tcp_try_listen for the full rationale.
#
# Usage shape (see self_hosting/examples/signals_demo.patlang for a full
# worked example, including a request/response "status" signal):
#   let port_id = signal_claim(9401)
#   if port_id >= 0 then
#     # primary: hold the port, poll it inside your own event loop
#     when quit do vfs_write("/app/should_stop", "1") end
#     when status do signal_reply("uptime: " + vfs_read("/app/uptime")) end
#     while running do
#       ... your own work ...
#       signal_poll(port_id, 20)   # cheap, non-blocking; fires when/emit
#     end
#   else
#     # secondary: someone else already owns this port
#     signal_send(9401, "quit", "")           # fire-and-forget
#     let reply = signal_query(9401, "status", "")  # request/response
#     print(reply)
#   end
#
# What a peer can do. Loopback is reachable by every process and every user
# on the machine, and the event namespace is the program's whole: so a
# signal reaches a handler only when both of these hold.
#   - The program allowed its name: signal_allow(["status", "quit"]) after
#     signal_claim. A name not allowed is ignored, whatever `when` handlers
#     the program has for its own events.
#   - The message carries the run's token: signal_claim makes one from the
#     system's random source and writes it to signal_token_path(port), a
#     file under the user's own profile, which signal_send and signal_query
#     read. A process that cannot read that file cannot send a signal.
# A peer that connects and sends nothing, or half a message, costs one
# signal_poll at most signal_read_ms() beyond its timeout, and one that
# leaves before the reply is written costs nothing.
#
# Wire format: "token\nname\nN\n" then N bytes of payload. The reply is
# everything the primary writes before it closes the connection.

include "mailbox.patlang"

# signal_claim(port) -> port_id (>= 0) if this process is now the primary
# holder of `port` for signal delivery, or -1 if another process already
# holds it (the caller should treat that as "an instance is already
# running" and typically call signal_send instead). Uses tcp_try_listen,
# NOT plain tcp_listen -- PatLang has no try/catch, so tcp_listen's bind
# failure is a FATAL error (would abort the whole program), not something
# this function could catch and turn into a graceful -1. tcp_try_listen
# was added specifically for this: -1 only for "already in use", any other
# bind failure (invalid port, permission denied) still aborts, same as
# plain tcp_listen would.
make a function called signal_claim takes port returns port_id
  if signal_driver() == "vfs" then return sigv_claim(port) end
  let port_id = tcp_try_listen(port)
  if port_id >= 0 then
    let token = signal_new_token()
    vfs_write(signal_token_key(port_id), token)
    write_file(signal_token_path(port_id), token)
  end
  return port_id
end

# signal_allow(names): the signals a peer may send this program. Each is the
# name of a `when` handler the program means to be reached from outside.
make a function called signal_allow takes names returns done
  let i = 0
  while i < list_len(names) do
    vfs_write("/signal_state/allowed/" + names[i], "1")
    let i = i + 1
  end
  return true
end

make a function called signal_allowed takes name returns yes
  return vfs_exists("/signal_state/allowed/" + name)
end

# Where the token of the run holding a port is kept for senders: a file under
# the user's own profile, which other users cannot read.
make a function called signal_token_path takes port returns path
  let base = "" + getenv("LOCALAPPDATA")
  if base == "" then
    let base = "" + getenv("TEMP")
  end
  return base + "/PatLang/signals/" + port + ".token"
end

make a function called signal_token_key takes port_id returns key
  return "/signal_state/token/" + port_id
end

# 32 hex digits from the system's random source.
make a function called signal_new_token returns token
  let digits = "0123456789abcdef"
  let bytes = random_bytes(16)
  let b = sb_new()
  let i = 0
  while i < list_len(bytes) do
    sb_push(b, substr(digits, word_shr(bytes[i], 4), 1))
    sb_push(b, substr(digits, word_and(bytes[i], 15), 1))
    let i = i + 1
  end
  return sb_str(b)
end

# How long signal_poll waits for a connected peer's message, in ms.
make a function called signal_read_ms returns ms
  return 250
end

# A message's header, read from the first bytes of text: [token, name, the
# payload's length in bytes, where the payload starts], or [] when text does
# not yet hold three lines, or the third is not a count.
make a function called signal_header takes text returns header
  let fields = []
  let start = 0
  let i = 0
  let n = text.length
  if n > 400 then
    let n = 400
  end
  while (i < n) and (list_len(fields) < 3) do
    if char_code(text, i) == 10 then
      let fields = list_push(fields, substr(text, start, i - start))
      let start = i + 1
    end
    let i = i + 1
  end
  if list_len(fields) < 3 then
    return []
  end
  let digits = fields[2]
  if digits.length == 0 then
    return []
  end
  let k = 0
  while k < digits.length do
    let c = char_code(digits, k)
    if (c < 48) or (c > 57) then
      return []
    end
    let k = k + 1
  end
  return [fields[0], fields[1], to_num(digits), start]
end

# The message a connected peer sends, within signal_read_ms(): [token, name,
# payload], or [] when it did not send a whole one in that time.
make a function called signal_read_message takes conn returns msg
  let deadline = clock_ms() + signal_read_ms()
  let b = sb_new()
  let header = []
  while true do
    let left = deadline - clock_ms()
    if left <= 0 then
      return []
    end
    let chunk = tcp_read_timeout(conn, left)
    if chunk == "" then
      return []
    end
    sb_push(b, chunk)
    if list_len(header) == 0 then
      let header = signal_header(sb_str(b))
    end
    if (list_len(header) > 0) and (sb_len(b) >= header[3] + header[2]) then
      let text = sb_str(b)
      return [header[0], header[1], substr(text, header[3], text.length - header[3])]
    end
    if (list_len(header) == 0) and (sb_len(b) > 400) then
      return []
    end
  end
  return []
end

# signal_poll(port_id, timeout_ms) -> the signal name received this call,
# or "" if none arrived within timeout_ms. On receipt, also calls
# emit(name, payload) so any `when name do ... end` handler in the calling
# program fires immediately -- callers that only need "did something
# arrive" can ignore the return value and rely purely on their own `when`
# handlers, matching event_loop_server.patlang's existing emit-driven style.
#
# Query-style signals (e.g. "status") get a reply channel: any `when`
# handler can call signal_reply(text) before returning, and that text is
# written back on the SAME connection before it's closed -- the connection
# is deliberately kept open across the emit() call rather than closed
# immediately after reading, specifically so a handler has something to
# reply on. Fire-and-forget signals (e.g. "quit") simply never call
# signal_reply, so an empty string is written back and the sender (using
# plain signal_send, which never reads a reply) never notices either way.
make a function called signal_poll takes port_id, timeout_ms returns name
  if signal_driver() == "vfs" then return sigv_poll(port_id) end
  let conn = tcp_accept_timeout(port_id, timeout_ms)
  if conn < 0 then
    return ""
  end
  # Nothing a peer does here stops the program. A peer that sends nothing, or
  # part of a message, is dropped after signal_read_ms(); one without the
  # run's token, or naming a signal the program did not allow, is dropped
  # unanswered; and the reply is written with tcp_try_write, since the peer
  # may have gone (a status query once ended a 20-minute simulation one tick
  # before it finished, when its sender dropped the connection).
  let msg = signal_read_message(conn)
  if list_len(msg) == 0 then
    tcp_close(conn)
    return ""
  end
  if (msg[0] != vfs_read(signal_token_key(port_id))) or (not signal_allowed(msg[1])) then
    tcp_close(conn)
    return ""
  end
  signal_reply("")
  emit(msg[1], msg[2])
  tcp_try_write(conn, vfs_read(signal_reply_key()))
  tcp_close(conn)
  return msg[1]
end

# signal_reply(text) -- call from inside a `when <name> do ... end` handler
# to send `text` back to whoever sent that signal via signal_query. Has no
# effect (silently ignored) if the signal was delivered via signal_send
# instead (fire-and-forget senders never read a reply anyway) or if this is
# called outside of a signal-triggered handler at all.
make a function called signal_reply takes text returns done
  vfs_write(signal_reply_key(), "" + text)
  return true
end

# Where a handler's reply waits, and the forced driver: named in-memory files,
# since a `when` handler takes only its event's name and data.
make a function called signal_reply_key returns key
  return "/signal_state/reply"
end

make a function called signal_driver_key returns key
  return "/signal_state/driver"
end

# signal_send(port, name, payload) -> true once delivered, discarding any
# reply. Use this for fire-and-forget signals (e.g. "quit") where you don't
# need a response. Only call this after signal_claim(port) has already
# told you a primary holds the port (the intended usage shape above) --
# PatLang has no try/catch, so unlike signal_claim (which checks
# tcp_listen's own -1-on-failure return), tcp_connect raises a FATAL
# host-function error if nothing is listening, not a value this function
# could catch and turn into a graceful `false`. In practice this only
# matters for the narrow race where the primary exits between your
# signal_claim failing and this call running -- if that happens the caller
# sees a clear "tcp_connect: ... connection refused" error and the process
# aborts, which is an honest failure mode for a fire-and-forget CLI
# signal, not a silent no-op.
make a function called signal_send takes port, name, payload returns delivered
  if signal_driver() == "vfs" then
    sigv_send(port, name, payload)
    return true
  end
  signal_query(port, name, payload)
  return true
end

# signal_query(port, name, payload) -> whatever the primary's `when <name>
# do ... end` handler passed to signal_reply(...), or "" if it didn't call
# signal_reply at all. Use this for request/response signals (e.g.
# "status"). Same fatal-on-nothing-listening caveat as signal_send (no
# try/catch to catch tcp_connect's error gracefully).
make a function called signal_query takes port, name, payload returns reply
  if signal_driver() == "vfs" then return sigv_query(port, name, payload) end
  let text = "" + payload
  let conn = tcp_connect("127.0.0.1", port)
  tcp_write(conn, read_file(signal_token_path(port)) + chr(10) + name + chr(10) + str_len(text) + chr(10) + text)
  # the reply is everything written before the primary closes
  let b = sb_new()
  while true do
    let chunk = tcp_read_or_empty(conn)
    if chunk == "" then
      tcp_close(conn)
      return sb_str(b)
    end
    sb_push(b, chunk)
  end
  tcp_close(conn)
  return sb_str(b)
end

# ---- vfs driver -----------------------------------------------------------
#
# Where the runtime has no tcp (the browser), or after signal_use_driver("vfs"),
# signals travel as mailbox messages instead: box "sig/<port>" holds what has
# been sent, "/sig/<port>/claim" marks the port as taken, and a reply is left at
# "/sig/<port>/reply/<message id>". There are no other processes to reach, so
# "primary" and "sender" are two parts of one program, or two isolates whose
# namespaces the parent addresses with the mbox_*_ns calls (see isolate.patlang):
# the parent drops a message in the isolate's "sig/<port>" box, the isolate calls
# signal_poll during its turn, and the parent reads the reply file afterwards.
# signal_query on this driver polls at once, so it answers only if the handler is
# registered in the same world.

make a function called signal_driver returns name
  if vfs_exists(signal_driver_key()) then return vfs_read(signal_driver_key()) end
  let caps = host_caps()
  let i = 0
  while i < list_len(caps) do
    if caps[i] == "tcp" then return "tcp" end
    let i = i + 1
  end
  return "vfs"
end

make a function called signal_use_driver takes name returns done
  vfs_write(signal_driver_key(), name)
  return true
end

make a function called sigv_box takes port returns box
  return "sig/" + port
end

make a function called sigv_claim takes port returns port_id
  let key = "/sig/" + port + "/claim"
  if vfs_exists(key) then
    return -1
  end
  vfs_write(key, "1")
  return port
end

# Queues a signal and returns its message id.
make a function called sigv_send takes port, name, payload returns id
  return mbox_put(sigv_box(port), "sender", name + chr(10) + payload)
end

# Handles at most one queued signal: emits it, stores whatever signal_reply set
# under the message id, returns the signal name ("" if none was waiting).
make a function called sigv_poll takes port returns name
  let m = mbox_take(sigv_box(port))
  if list_len(m) == 0 then
    return ""
  end
  let msg = m[1]
  let nl = find_substr_signals(msg, chr(10))
  let sig_name = msg
  let payload = ""
  if nl >= 0 then
    let sig_name = substr(msg, 0, nl)
    let payload = substr(msg, nl + 1, msg.length - nl - 1)
  end
  # a signal the program did not allow is taken from the box and ignored
  if not signal_allowed(sig_name) then
    return ""
  end
  signal_reply("")
  emit(sig_name, payload)
  vfs_write("/sig/" + port + "/reply/" + m[0], vfs_read(signal_reply_key()))
  return sig_name
end

make a function called sigv_query takes port, name, payload returns reply
  let id = sigv_send(port, name, payload)
  sigv_poll(port)
  let key = "/sig/" + port + "/reply/" + id
  if (not vfs_exists(key)) then
    return ""
  end
  let reply = vfs_read(key)
  vfs_delete(key)
  return reply
end

# Tiny local substring search -- self-contained rather than depending on
# whichever example/tool happens to define one, since this is a shared
# library other programs `include`.
make a function called find_substr_signals takes hay, needle returns idx
  if needle.length == 0 then
    return 0
  end
  let i = 0
  while i <= (hay.length - needle.length) do
    if substr(hay, i, needle.length) == needle then
      return i
    end
    let i = i + 1
  end
  return -1
end
