  return a and b
end

make a function called register_x64_dynamic_float_auto_box_call_steps takes ctx returns done
  step(ctx, "plus(a, b) with no float literal in its own body, called directly as plus(1.5, 2)", "st_noop")
  step(ctx, "both print 3.5, with no manual rt_box_float call anywhere in the source", "st_x64_dynamic_float_auto_box_call")
