  return a and b
end

make a function called register_x64_mixed_int_float_bin_steps takes ctx returns done
  step(ctx, "`x + 2.5` where x is an int local, and `a + x` where a is a float local and x an int local", "st_noop")
  step(ctx, "both print true for both comparisons against 7.5", "st_x64_mixed_int_float_bin")
