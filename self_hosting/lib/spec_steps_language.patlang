# GitHub #49: real step() registrations wiring spec_library/language/*.feature
# prose onto self_hosting/lib/test.patlang's executable Gherkin runner. Each
# step is registered under the EXACT sentence text used in the .feature file
# (see test.patlang's step_text/run_feature dispatch, which looks steps up by
# that literal text) -- Given/When lines in this batch of specs are narrative
# only (the literals are already fixed in the prose), so the real computation
# and check() calls live in the Then step. "x_kind is captured" steps compute
# the representation invariant into the global "x_kind" var so a following
# `And ensure x_kind == "..."` line (gherkin_contracts.patlang) can check it.
#
# Covers arithmetic_operators.feature, bitwise_operators.feature,
# comparison_operators.feature -- the three specs matching this session's own
# tag-collision bug pattern (#24, #46, #48), prioritized first per the #49
# rollout plan. Remaining spec_library/language/*.feature files are backlog.

include "includes.patlang"
include "gherkin_contracts.patlang"
include "signals.patlang"
include "sql.patlang"
include "queue.patlang"
include "task_registry.patlang"

make a function called st_noop returns done
  return true
end

# ---- arithmetic_operators.feature ----

make a function called st_arith_basic returns ok
  let a = check("2+3=5", 2 + 3, 5)
  let b = check("5-3=2", 5 - 3, 2)
  let c = check("4*3=12", 4 * 3, 12)
  let d = check("10/2=5", 10 / 2, 5)
  return a and b and c and d
end

make a function called st_arith_precedence returns ok
  return check("2 + 3 * 4 == 14, not 20", 2 + 3 * 4, 14)
end

make a function called st_arith_mod_sign returns ok
  return check("-10 % 3 == -1 (truncating)", -10 % 3, -1)
end

make a function called st_arith_kind_int returns done
  let x = 2 + 3 * 4
  set_var("x", x)
  set_var("x_kind", numeric_kind(x))
  return true
end

# ---- bitwise_operators.feature ----

make a function called st_bitwise_logic returns ok
  let a = check("12 band 10 = 8", 12 band 10, 8)
  let b = check("12 bor 10 = 14", 12 bor 10, 14)
  let c = check("12 bxor 10 = 6", 12 bxor 10, 6)
  return a and b and c
end

make a function called st_bitwise_shift returns ok
  let a = check("1 shl 4 = 16", 1 shl 4, 16)
  let b = check("16 shr 4 = 1", 16 shr 4, 1)
  return a and b
end

make a function called st_bitwise_kind_int returns done
  let x = 12 bxor 10
  set_var("x", x)
  set_var("x_kind", numeric_kind(x))
  return true
end

make a function called st_bitwise_kind_bigint returns done
  let x = 9223372036854775807 + 1
  set_var("x", x)
  set_var("x_kind", numeric_kind(x))
  return true
end

# ---- comparison_operators.feature ----

make a function called st_cmp_eq returns ok
  let a = check("3==3 is true", 3 == 3, true)
  let b = check("3==4 is false", 3 == 4, false)
  let c = check("3!=4 is true", 3 != 4, true)
  let d = check("3!=3 is false", 3 != 3, false)
  return a and b and c and d
end

make a function called st_cmp_ordering returns ok
  let a = check("3<4 true", 3 < 4, true)
  let b = check("4<3 false", 4 < 3, false)
  let c = check("3<3 false", 3 < 3, false)
  let d = check("3<=3 true", 3 <= 3, true)
  let e = check("4>3 true", 4 > 3, true)
  let f = check("3>3 false", 3 > 3, false)
  let g = check("3>=3 true", 3 >= 3, true)
  return a and b and c and d and e and f and g
end

make a function called st_cmp_string_eq returns ok
  let s1 = "abc"
  let s2 = substr("xabcx", 1, 3)
  return check("separately-constructed \"abc\" strings are ==", s1 == s2, true)
end

make a function called st_cmp_kind_bool returns done
  let x = 3 < 4
  set_var("x", x)
  set_var("x_kind", type_of(x))
  return true
end

# ---- if_elif_else.feature ----

make a function called st_if_true_branch returns ok
  let ran = "none"
  if true then
    let ran = "then"
  end
  return check("the then-branch executes", ran, "then")
end

make a function called st_if_false_no_else returns ok
  let ran = "none"
  if false then
    let ran = "then"
  end
  return check("neither branch executes; the statement is a no-op", ran, "none")
end

make a function called st_if_false_with_else returns ok
  let ran = "none"
  if false then
    let ran = "then"
  else
    let ran = "else"
  end
  return check("the else-branch executes", ran, "else")
end

make a function called st_elif_first_match returns ok
  let ran = "none"
  if false then
    let ran = "then"
  elif true then
    let ran = "elif"
  elif true then
    let ran = "second_elif"
  end
  return check("only that matching branch executes", ran, "elif")
end

# ---- while_loop.feature ----

make a function called st_while_sum returns ok
  let i = 0
  let sum = 0
  while i < 5 do
    let sum = sum + i
    let i = i + 1
  end
  return check("the sum is 10 (0+1+2+3+4)", sum, 10)
end

make a function called st_while_zero_iterations returns ok
  let ran = false
  while false do
    let ran = true
  end
  return check("the body never executes, not even once", ran, false)
end

# ---- logical_operators.feature ----

make a function called st_and_short_circuits returns ok
  set_var("lo_evaluated", false)
  let r = false and lo_side_effect()
  return check("X is NEVER evaluated (and, false lhs)", get("__vars", "lo_evaluated"), false)
end

make a function called lo_side_effect returns v
  set_var("lo_evaluated", true)
  return true
end

make a function called st_or_short_circuits returns ok
  set_var("lo_evaluated", false)
  let r = true or lo_side_effect()
  return check("X is NEVER evaluated (or, true lhs)", get("__vars", "lo_evaluated"), false)
end

make a function called st_and_evaluates_rhs_when_needed returns ok
  set_var("lo_evaluated", false)
  let r = true and lo_side_effect()
  return check("X IS evaluated (and, true lhs)", get("__vars", "lo_evaluated"), true)
end

make a function called st_not_negates returns ok
  let a = check("not true = false", not true, false)
  let b = check("not false = true", not false, true)
  return a and b
end

make a function called register_language_control_flow_steps returns done
  step("the condition true", "st_noop")
  step("an if-statement is evaluated", "st_noop")
  step("the then-branch executes", "st_if_true_branch")
  step("the condition false, with no else clause", "st_noop")
  step("neither branch executes; the statement is a no-op", "st_if_false_no_else")
  step("the condition false, with an else clause", "st_noop")
  step("the else-branch executes", "st_if_false_with_else")
  step("a false condition, followed by a nested if-true (elif-equivalent) branch", "st_noop")
  step("the statement is evaluated", "st_noop")
  step("only that matching branch executes", "st_elif_first_match")

  step("a loop summing i from 0 while i < 5, incrementing i each time", "st_noop")
  step("the while-statement runs to completion", "st_noop")
  step("the sum is 10 (0+1+2+3+4)", "st_while_sum")
  step("`while false do ... end`", "st_noop")
  step("the body never executes, not even once", "st_while_zero_iterations")

  step("`false and X`, where X has a detectable side effect if evaluated", "st_noop")
  step("the expression is evaluated", "st_noop")
  step("X is NEVER evaluated -- confirmed via a real side-effect counter, not assumed from the keyword", "st_and_short_circuits")
  step("`true or X`, where X has a detectable side effect if evaluated", "st_noop")
  step("X is NEVER evaluated", "st_or_short_circuits")
  step("`true and X`", "st_noop")
  step("X IS evaluated, since its value is needed to decide the result", "st_and_evaluates_rhs_when_needed")
  step("true and false", "st_noop")
  step("not is applied", "st_noop")
  step("not true = false, not false = true", "st_not_negates")
  return true
end

# ---- let_binding.feature ----

make a function called st_let_readable returns ok
  let x = 5
  return check("it is 5", x, 5)
end

make a function called st_let_reassign returns ok
  let x = 5
  let x = x + 1
  return check("it is 6", x, 6)
end

make a function called st_let_if_block_shares_scope returns ok
  let y = 1
  if true then
    let y = 99
  end
  return check("it is 99 -- the if-block did NOT get its own scope", y, 99)
end

make a function called st_let_while_accumulates_outer_scope returns ok
  let z = 1
  let n = 0
  while n < 3 do
    let z = z + 10
    let n = n + 1
  end
  return check("it is 31 (1 + 10 + 10 + 10)", z, 31)
end

# ---- closures.feature ----

make a function called st_closure_captures_free_var returns ok
  let base = 10
  let add_to_base = |x| { return base + x }
  return check("the result is 15", add_to_base(5), 15)
end

make a function called st_closure_via_alias returns ok
  let base = 10
  let add_to_base = |x| { return base + x }
  let f = add_to_base
  return check("it behaves identically to calling add_to_base(5) directly", f(5), add_to_base(5))
end

make a function called cl_outer takes n returns closure
  return |x| { return x + n }
end

make a function called st_closures_capture_independently returns ok
  let add10 = cl_outer(10)
  let add20 = cl_outer(20)
  let a = check("add10(1)=11", add10(1), 11)
  let b = check("add20(1)=21 -- each closure keeps its own captured n", add20(1), 21)
  return a and b
end

# ---- class_inheritance.feature ----

make a function called cls_setup_animal_person returns done
  return true
end

make a function called st_class_child_default_overrides returns ok
  let p = new("SpecPerson", "p1")
  return check("p.legs is 2, not 4 -- the more specific class wins", get(p, "legs"), 2)
end

make a function called st_class_inherited_field returns ok
  let p = new("SpecPerson", "p2")
  return check("it is \"...\", inherited from Animal", get(p, "sound"), "...")
end

make a function called st_class_parent_unaffected_by_child returns ok
  let a = new("SpecAnimal", "a1")
  return check("a.legs is 4 (Animal's own default), not 2", get(a, "legs"), 4)
end

# ---- traits_composition.feature ----

make a function called st_trait_collision_last_wins returns ok
  let w = new("SpecWidget", "w1")
  return check("Serializable's label runs (listed last), not Nameable's", send(w, "label"), "serialized:w1")
end

make a function called st_trait_noncolliding_composed returns ok
  let w = new("SpecWidget", "w1")
  return check("it runs correctly -- traits compose the UNION of methods", send(w, "to_str"), "<obj w1>")
end

make a function called st_trait_own_fields_unaffected returns ok
  let w = new("SpecWidget", "w1")
  return check("it is \"widget\", regardless of the traits list", get(w, "kind"), "widget")
end

make a function called register_language_bindings_closures_oo_steps returns done
  step("`let x = 5`", "st_noop")
  step("x is read", "st_noop")
  step("it is 5", "st_let_readable")
  step("`let x = 5` then `let x = x + 1`", "st_noop")
  step("x is read afterward", "st_noop")
  step("it is 6", "st_let_reassign")
  step("`let y = 1` then `if true then let y = 99 end`", "st_noop")
  step("y is read after the if-block", "st_noop")
  step("it is 99 -- the if-block did NOT get its own scope; it mutated the outer y directly", "st_let_if_block_shares_scope")
  step("`let z = 1` then a 3-iteration while-loop doing `let z = z + 10` each time", "st_noop")
  step("z is read after the loop", "st_noop")
  step("it is 31 (1 + 10 + 10 + 10), confirming each iteration's let mutates the SAME outer z, not a fresh one", "st_let_while_accumulates_outer_scope")

  step("`let base = 10` then `let add_to_base = |x| { return base + x }`", "st_noop")
  step("add_to_base(5) is called", "st_noop")
  step("the result is 15", "st_closure_captures_free_var")
  step("`let f = add_to_base`", "st_noop")
  step("f(5) is called", "st_noop")
  step("it behaves identically to calling add_to_base(5) directly", "st_closure_via_alias")
  step("a function `outer(n)` that creates and returns `|x| { return x + n }`", "st_noop")
  step("add10 = outer(10) and add20 = outer(20) are both created, then called with 1", "st_noop")
  step("add10(1)=11 and add20(1)=21 -- each closure keeps its own captured n from its OWN call to outer, not a shared/overwritten one", "st_closures_capture_independently")

  step("`class Animal { field legs = 4 }` and `class Person inherits Animal { field legs = 2 }`", "cls_setup_animal_person")
  step("new(\"Person\", \"p1\") is created", "st_noop")
  step("p.legs is 2, not 4 -- the more specific class wins", "st_class_child_default_overrides")
  step("Animal declares `field sound = \"...\"`, Person does not redeclare it", "st_noop")
  step("a Person instance reads .sound", "st_noop")
  step("it is \"...\", inherited from Animal", "st_class_inherited_field")
  step("the same two classes", "st_noop")
  step("new(\"Animal\", \"a1\") is created directly", "st_noop")
  step("a.legs is 4 (Animal's own default), not 2", "st_class_parent_unaffected_by_child")

  step("`traits Nameable, Serializable`, both defining a \"label\" method", "st_noop")
  step("send(obj, \"label\") is called", "st_noop")
  step("Serializable's label runs (listed last), not Nameable's", "st_trait_collision_last_wins")
  step("Serializable also defines \"to_str\", which Nameable does not", "st_noop")
  step("send(obj, \"to_str\") is called", "st_noop")
  step("it runs correctly -- traits compose the UNION of methods, only colliding names follow last-wins", "st_trait_noncolliding_composed")
  step("Widget also declares `field kind = \"widget\"`", "st_noop")
  step("get(obj, \"kind\") is read", "st_noop")
  step("it is \"widget\", regardless of the traits list", "st_trait_own_fields_unaffected")
  return true
end

class SpecAnimal {
  field legs = 4
  field sound = "..."
}

class SpecPerson inherits SpecAnimal {
  field legs = 2
}

class SpecNameable {
  make a function called label takes self returns msg
    return "name:" + get(self, "name")
  end
}

class SpecSerializable {
  make a function called label takes self returns msg
    return "serialized:" + get(self, "name")
  end
  make a function called to_str takes self returns msg
    return "<obj " + get(self, "name") + ">"
  end
}

class SpecWidget {
  traits SpecNameable, SpecSerializable
  field kind = "widget"
}

when we_tick do
  set_var("we_tick_count", get("__vars", "we_tick_count") + 1)
end

when we_ping do
  set_var("we_seen_name", event_name)
  set_var("we_seen_data", event_data)
end

let we_base = 100

when we_combine do
  let calls = get("__vars", "we_combined_calls")
  if calls == 0 then
    set_var("we_combined_first", we_base + to_num(event_data))
  else
    set_var("we_combined_second", we_base + to_num(event_data))
  end
  set_var("we_combined_calls", calls + 1)
end

# ---- function_definition_and_return.feature ----

make a function called fd_guarded takes n returns msg
  if n < 0 then
    return "negative"
  end
  return "non-negative"
end

make a function called st_return_exits_immediately returns ok
  return check("the function returns immediately, never reaching code after the if-block", fd_guarded(-5), "negative")
end

make a function called fd_no_return takes n returns done
  let x = n + 1
end

make a function called st_no_return_is_unit returns ok
  return check("a single BLANK line is printed -- NOT \"nil\"/\"undefined\"", type_of(fd_no_return(1)), "unit")
end

# ---- member_assignment.feature ----

make a function called st_dot_assign_agrees_with_get returns ok
  let o = new("SpecColorHolder", "o1")
  o.color = "blue"
  let a = check("o.color reads back \"blue\"", o.color, "blue")
  let b = check("get(o, \"color\") reads back \"blue\"", get(o, "color"), "blue")
  return a and b
end

# ---- new_send_get_basic.feature ----

make a function called st_new_implicit_type_name returns ok
  let obj = new("Widget", "w1")
  let a = check("get(obj, \"type\") is \"Widget\"", get(obj, "type"), "Widget")
  let b = check("get(obj, \"name\") is \"w1\"", get(obj, "name"), "w1")
  return a and b
end

make a function called st_send_set_writes_field returns ok
  let obj = new("Widget", "w2")
  send(obj, "set", "color", "red")
  return check("get(obj, \"color\") is \"red\"", get(obj, "color"), "red")
end

# ---- send_method_dispatch.feature ----

make a function called st_send_child_override_runs returns ok
  let person = new("SpecDispatchPerson", "p1")
  return check("Person's own speak() runs -- \"hi, my job is unemployed\"", send(person, "speak"), "hi, my job is unemployed")
end

make a function called st_send_parent_fallback_runs returns ok
  let animal = new("SpecDispatchAnimal", "a1")
  return check("Animal's own speak() runs, returning its sound field's value", send(animal, "speak"), "...")
end

# ---- list_string_literals_indexing.feature ----

make a function called st_list_literal_indexable returns ok
  let l = [10, 20, 30]
  let a = check("indexed at 0 is 10", l[0], 10)
  let b = check("indexed at 2 is 30", l[2], 30)
  return a and b
end

make a function called st_string_indexable returns ok
  let s = "hello"
  let a = check("indexed at 0 is \"h\"", s[0], "h")
  let b = check("indexed at 4 is \"o\"", s[4], "o")
  return a and b
end

make a function called st_length_property returns ok
  let l = [10, 20, 30]
  let s = "hello"
  let a = check("list .length is 3", l.length, 3)
  let b = check("string .length is 5", s.length, 5)
  return a and b
end

# ---- print_statement.feature ----

make a function called st_print_returns_unit returns ok
  let r = print("spec: print writes a value followed by a newline")
  return check("print's return value is Unit (its display text + newline is what every other scenario's own ok/FAIL output already depends on)", type_of(r), "unit")
end

make a function called st_print_unit_returns_unit returns ok
  let r = print(fd_no_return(1))
  return check("printing Unit is Unit too -- exactly one blank line is written, not nothing at all", type_of(r), "unit")
end

class SpecColorHolder {
  field placeholder = 0
}

class SpecDispatchAnimal {
  field sound = "..."
  make a function called speak takes self returns msg
    return get(self, "sound")
  end
}

class SpecDispatchPerson inherits SpecDispatchAnimal {
  field job = "unemployed"
  make a function called speak takes self returns msg
    return "hi, my job is " + get(self, "job")
  end
}

make a function called register_language_fn_obj_list_print_steps returns done
  step("a function with an if-guarded `return \"negative\"` before any later statement", "st_noop")
  step("called with an input that satisfies the guard", "st_noop")
  step("the function returns immediately, never reaching code after the if-block", "st_return_exits_immediately")
  step("a function whose body has no `return` anywhere", "st_noop")
  step("its result is printed", "st_noop")
  step("a single BLANK line is printed -- NOT the text \"nil\"/\"undefined\", and NOT silently nothing at all; the function does NOT implicitly return its last expression's value (unlike Ruby/Rust)", "st_no_return_is_unit")

  step("`o.color = \"blue\"` on an object with no color field previously set", "st_noop")
  step("o.color and get(o, \"color\") are both read afterward", "st_noop")
  step("both return \"blue\" -- confirming dot-assignment, dot-read, and get() all agree on the same underlying field store", "st_dot_assign_agrees_with_get")

  step("`new(\"Widget\", \"w1\")`, with no `class Widget {...}` ever declared", "st_noop")
  step("get(obj, \"type\") and get(obj, \"name\") are read", "st_noop")
  step("they are \"Widget\" and \"w1\" respectively -- auto-populated by new() itself, not something the caller has to set", "st_new_implicit_type_name")
  step("send(obj, \"set\", \"color\", \"red\")", "st_noop")
  step("get(obj, \"color\") is read", "st_noop")
  step("it is \"red\"", "st_send_set_writes_field")

  step("Animal defines speak() returning get(self,\"sound\"); Person (inherits Animal) defines its OWN speak() returning a job-based message", "st_noop")
  step("send(person_instance, \"speak\") is called", "st_noop")
  step("Person's own speak() runs -- \"hi, my job is unemployed\"", "st_send_child_override_runs")
  step("send(animal_instance, \"speak\") is called", "st_noop")
  step("Animal's own speak() runs, returning its sound field's value", "st_send_parent_fallback_runs")

  step("`[10, 20, 30]`", "st_noop")
  step("indexed at 0 and 2", "st_noop")
  step("the results are 10 and 30", "st_list_literal_indexable")
  step("\"hello\"", "st_noop")
  step("indexed at 0 and 4", "st_noop")
  step("the results are \"h\" and \"o\" -- each a STRING of length 1, not a raw character/byte value", "st_string_indexable")
  step("the same list and string", "st_noop")
  step(".length is read", "st_noop")
  step("it is the real element/character count (3 and 5 respectively)", "st_length_property")

  step("any value", "st_noop")
  step("print(value) is called", "st_noop")
  step("its display text is written, followed by a newline -- confirmed across many other specs in this same file, each of which depends on print's output landing on its own line", "st_print_returns_unit")
  step("an expression that evaluates to Unit (e.g. a function with no return statement, or set_var's own return value)", "st_noop")
  step("printed", "st_noop")
  step("exactly one blank line is written, not nothing at all", "st_print_unit_returns_unit")
  return true
end

# ---- require_ensure_assert.feature ----
# Uses exec_capture on dedicated driver scripts (self_hosting/tools/
# spec_fixtures/) rather than in-process calls, since a real contract
# violation is fatal (aborts the process) -- matching the pattern
# run_synthesis_selftests.patlang already uses for out-of-process checks.

make a function called st_contract_pass_no_effect returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/tools/spec_fixtures/require_ensure_pass.patlang")
  return check("it returns 5 normally, as if no contract were present", contains_text(out, "result=5"), true)
end

make a function called st_require_violation_fatal returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/tools/spec_fixtures/require_violation.patlang")
  let a = check("names \"precondition\" and the exact source condition text \"b != 0\"", contains_text(out, "precondition") and contains_text(out, "b != 0"), true)
  let b = check("does not reach the unreachable line after the violation", contains_text(out, "unreachable"), false)
  return a and b
end

make a function called st_contract_kind_labels returns ok
  let require_out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/tools/spec_fixtures/require_violation.patlang")
  let ensure_out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/tools/spec_fixtures/ensure_violation.patlang")
  let assert_out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/tools/spec_fixtures/assert_violation.patlang")
  let a = check("require violation is labeled \"precondition\"", contains_text(require_out, "precondition"), true)
  let b = check("ensure violation is labeled \"postcondition\"", contains_text(ensure_out, "postcondition"), true)
  let c = check("assert violation is labeled \"assertion\"", contains_text(assert_out, "assertion"), true)
  return a and b and c
end

# ---- include_directive.feature ----

make a function called st_include_transitive_splice returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/tools/spec_fixtures/include_entry.patlang")
  return check("it works -- confirming both the direct splice and the transitive one resolved correctly", contains_text(out, "result=21"), true)
end

# ---- alternate_block_delimiters.feature ----

make a function called st_while_do_end_matches_brace returns ok
  let i = 0
  let sum = 0
  while i < 2 do
    let sum = sum + i
    let i = i + 1
  end
  return check("it behaves identically to the brace form", sum, 1)
end

make a function called st_closure_do_end_matches_brace returns ok
  let f_do = |x| do return x * 2 end
  let f_brace = |x| { return x * 2 }
  return check("it behaves identically to `|x| { return x * 2 }`", f_do(5), f_brace(5))
end

make a function called st_if_do_end_is_parse_error returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/tools/spec_fixtures/if_do_end_parse_error.patlang")
  return check("it is a PARSE ERROR (\"Start the 'if' block with '{'\")", contains_text(out, "should not parse"), false)
end

make a function called st_if_then_end_parses_ok returns ok
  let ran = false
  if true then
    let ran = true
  end
  return check("it works -- if's Ruby-style alternate form is then/elif/else/end, never do/end", ran, true)
end

# ---- when_emit.feature ----
# `when` handlers must be declared at the TOP LEVEL of the program (a
# parse error otherwise: "'when' can only be declared at the top level...
# handlers are registered once, statically, not conditionally at
# runtime") -- so, unlike every other step here, these are declared as
# module-level `when` blocks below (near the SpecWidget etc. class decls),
# with the step functions only calling set_var/emit.

make a function called st_when_emit_runs_once_per_call returns done
  set_var("we_tick_count", 0)
  emit("we_tick", 5)
  emit("we_tick", 7)
  return true
end

make a function called st_when_emit_counter_is_two returns ok
  return check("the counter is 2 -- the handler ran once per emit", get("__vars", "we_tick_count"), 2)
end

make a function called st_when_emit_implicit_params returns done
  set_var("we_seen_name", "")
  set_var("we_seen_data", "")
  emit("we_ping", "payload42")
  return true
end

make a function called st_when_emit_implicit_params_check returns ok
  let a = check("event_name is the string passed as emit's first argument", get("__vars", "we_seen_name"), "we_ping")
  let b = check("event_data is the payload (second argument)", get("__vars", "we_seen_data"), "payload42")
  return a and b
end

make a function called st_when_emit_captures_enclosing_let returns done
  set_var("we_combined_first", -1)
  set_var("we_combined_second", -1)
  set_var("we_combined_calls", 0)
  emit("we_combine", "5")
  emit("we_combine", "7")
  return true
end

make a function called st_when_emit_captures_enclosing_let_check returns ok
  let a = check("it sees the real captured value of base (100+5=105 on the first call)", get("__vars", "we_combined_first"), 105)
  let b = check("100+7=107 on the second -- not a stale or hardcoded value", get("__vars", "we_combined_second"), 107)
  return a and b
end


make a function called register_language_contracts_include_delims_events_steps returns done
  step("`safe_divide(10, 2)` with `require b != 0` and `ensure (r*b)==a`", "st_noop")
  step("called", "st_noop")
  step("it returns 5 normally, as if no contract were present", "st_contract_pass_no_effect")
  step("`safe_divide(0, 0)`", "st_noop")
  step("it fails with \"contract violation: precondition failed in safe_divide(): b != 0\" -- the exact source condition text, not a generic message", "st_require_violation_fatal")
  step("the three different keywords", "st_noop")
  step("any one fails", "st_noop")
  step("the error names the correct kind label (\"precondition\" for require, \"postcondition\" for ensure, \"assertion\" for assert) -- distinguished by a string tag on ONE shared host call, not three separate mechanisms", "st_contract_kind_labels")

  step("an entry script that includes includer.patlang, which itself includes a SIBLING file helper.patlang by bare filename", "st_noop")
  step("the entry script calls a function from includer.patlang that itself calls a function from helper.patlang", "st_noop")
  step("it works -- confirming both the direct splice and the transitive one resolved correctly", "st_include_transitive_splice")

  step("`while i < 2 do ... end`", "st_noop")
  step("evaluated", "st_noop")
  step("it behaves identically to the brace form", "st_while_do_end_matches_brace")
  step("`|x| do return x * 2 end`", "st_noop")
  step("called", "st_noop")
  step("it behaves identically to `|x| { return x * 2 }`", "st_closure_do_end_matches_brace")
  step("`if true do ... end`", "st_noop")
  step("parsed", "st_noop")
  step("it is a PARSE ERROR (\"Start the 'if' block with '{'\")", "st_if_do_end_is_parse_error")
  step("`if true then ... end` instead", "st_noop")
  step("it works -- if's Ruby-style alternate form is then/elif/else/end, never do/end", "st_if_then_end_parses_ok")

  step("`when tick do ... end` incrementing a counter", "st_when_emit_runs_once_per_call")
  step("emit(\"tick\", 5) then emit(\"tick\", 7) are both called", "st_noop")
  step("the counter is 2 -- the handler ran once per emit", "st_when_emit_counter_is_two")
  step("the handler body reads `event_name` and `event_data` directly, with no declaration", "st_when_emit_implicit_params")
  step("an event fires", "st_noop")
  step("event_name is the string passed as emit's first argument, event_data is the payload (second argument)", "st_when_emit_implicit_params_check")
  step("`let base = 100` declared before the when-block, referenced inside it", "st_when_emit_captures_enclosing_let")
  step("the handler runs", "st_noop")
  step("it sees the real captured value of base (100), combined correctly with the live event_data each time (100+5=105 on the first call, 100+7=107 on the second) -- not a stale or hardcoded value", "st_when_emit_captures_enclosing_let_check")
  return true
end

# ---- action_add_plan.feature ----

make a function called st_goap_multistep_plan returns ok
  action_add("spec_gather_wood", [], [["spec_have", ["spec_wood"]]], [], 1)
  action_add("spec_build_house", [["spec_have", ["spec_wood"]]], [["spec_have", ["spec_house"]]], [], 1)
  let p = plan([["spec_have", ["spec_house"]]])
  let a = check("plan step 0 is gather_wood", action_base_name(p[0]), "spec_gather_wood")
  let b = check("plan step 1 is build_house", action_base_name(p[1]), "spec_build_house")
  let c = check("plan has exactly 2 steps, in order", p.length, 2)
  return a and b and c
end

make a function called st_goap_unreachable_goal_empty_plan returns ok
  let p = plan([["spec_nothing_produces_this", ["spec_x"]]])
  return check("the result is an empty list, not an error", p.length, 0)
end

# ---- rule_add_solve.feature ----

make a function called st_rule_ground_fact_one_solution returns ok
  rule_add("spec_parent", ["alice", "bob"], [])
  let sols = solve("spec_parent", ["alice", "bob"])
  return check("the result is a list with exactly 1 solution", sols.length, 1)
end

make a function called st_rule_chained_resolves_var returns ok
  rule_add("spec_parent", ["bob", "carol"], [])
  rule_add("spec_grandparent", ["X", "Z"], [["spec_parent", ["X", "Y"]], ["spec_parent", ["Y", "Z"]]])
  let sols = solve("spec_grandparent", ["alice", "Z"])
  return check("Z resolves to \"carol\" -- confirmed via real chained unification, not a flat lookup", sols[0][1], "carol")
end

make a function called st_rule_no_match_empty returns ok
  let sols = solve("spec_no_such_relation_at_all", ["x", "y"])
  return check("the result is an empty list, not an error", sols.length, 0)
end

# ---- rule_declaration_sugar.feature ----

rule spec_sugar_grandparent(X, Z) :- spec_sugar_parent(X, Y), spec_sugar_parent(Y, Z).

make a function called st_rule_sugar_matches_hand_written returns ok
  rule_add("spec_sugar_parent", ["alice", "bob"], [])
  rule_add("spec_sugar_parent", ["bob", "carol"], [])
  let sols = solve("spec_sugar_grandparent", ["alice", "Z"])
  return check("Z resolves to \"carol\" -- identical to the hand-written rule_add equivalent, since this IS that call under sugar", sols[0][1], "carol")
end

# ---- fact_query.feature ----

make a function called st_fact_records_binary_relation returns ok
  fact("spec_likes", "alice", "bob")
  fact("spec_likes", "alice", "carol")
  return check("the result is 2 -- a COUNT of matching facts, not a boolean or a list", query("spec_likes", "alice", "anything"), 2)
end

make a function called st_fact_third_arg_ignored returns ok
  return check("the result is unchanged -- query only ever filters on (pred, a), matching ANY b", query("spec_likes", "alice", "something_else_entirely"), 2)
end

make a function called st_fact_no_match_zero returns ok
  return check("the result is 0, not an error", query("spec_likes", "nobody_ever_recorded", "x"), 0)
end

# ---- goal_pursue_activate.feature ----

rule_add("spec_ga_dep", ["spec_ga_house", "spec_ga_walls"], [])
rule_add("spec_ga_dep", ["spec_ga_walls", "spec_ga_foundation"], [])
rule_add("spec_ga_built", ["spec_ga_foundation_base"], [])

action_add("spec_ga_build_from_base", [["spec_ga_built", ["spec_ga_foundation_base"]]], [["spec_ga_built", ["spec_ga_foundation"]]], [], 1)
action_add("spec_ga_build_from_dep", [["spec_ga_dep", ["X", "Y"]], ["spec_ga_built", ["Y"]]], [["spec_ga_built", ["X"]]], [], 1)

action_bind("spec_ga_build_from_base", |args| {
  return true
})
action_bind("spec_ga_build_from_dep", |args| {
  return true
})

goal spec_need_a_house {
  spec_ga_built(spec_ga_house)
}

make a function called st_pursue_finds_multistep_plan returns ok
  let p = pursue spec_need_a_house
  return check("it returns a 3-step plan, the same search plan() itself performs", p.length, 3)
end

make a function called st_activate_all_succeed returns ok
  let p = pursue spec_need_a_house
  let ok = activate p
  return check("it returns true", ok, true)
end

make a function called st_activate_stops_on_failing_step returns ok
  action_bind("spec_ga_build_from_dep", |args| {
    if args[0] == "spec_ga_house" then
      return false
    end
    return true
  })
  let p = pursue spec_need_a_house
  let ok = activate p
  return check("activate returns false -- stopping the moment the failing step runs, even though the planner still found a valid dependency chain", ok, false)
end

# ---- contract_holds_is_queryable.feature ----

make a function called spec_safe_divide takes a, b returns r
  require b != 0
  let r = a / b
  ensure (r * b) == a
  return r
end

make a function called st_contract_holds_queryable returns ok
  let r = spec_safe_divide(10, 2)
  let sols = solve("contract_holds", ["spec_safe_divide", "X"])
  return check("it returns a NON-EMPTY list of solutions -- the passing checks are real, derivable facts in the SAME store rule_add/solve uses, not an invisible side effect", sols.length > 0, true)
end

# ---- gherkin_contracts.feature (meta: the library implementing it) ----

make a function called st_gc_immediate_bound_check returns ok
  set_var("gc_spec_x", 5)
  let before = get("__vars", "t_fail")
  handle_contract_step("require", "gc_spec_x < 10")
  handle_contract_step("ensure", "gc_spec_x < 20")
  let after = get("__vars", "t_fail")
  return check("both clauses are evaluated immediately against the bound value of x, exactly like an ordinary require/ensure statement would be, and pass (t_fail unchanged)", after, before)
end

make a function called st_gc_synth_binding_check_passes returns ok
  action_add("spec_gc_scale", [["spec_gc_input", ["X"]]], [["spec_gc_scaled", ["X"]]], [], 1)
  rule_add("spec_gc_input", ["5"], [])
  handle_contract_step("require", "X < 10")
  handle_contract_step("ensure", "X < 20")
  let labels = plan([["spec_gc_scaled", ["5"]]])
  let pending = get("__vars", "t_pending_contracts")
  let ok = goap_verify_contracts(pending, labels)
  set_var("t_pending_contracts", [])
  return check("both clauses are evaluated against X's bound value as parsed out of that plan step's own label, before the candidate is accepted", ok, true)
end

make a function called st_gc_synth_binding_check_rejects_violation returns ok
  rule_add("spec_gc_input", ["15"], [])
  handle_contract_step("require", "X < 10")
  let labels = plan([["spec_gc_scaled", ["15"]]])
  let pending = get("__vars", "t_pending_contracts")
  let ok = goap_verify_contracts(pending, labels)
  set_var("t_pending_contracts", [])
  return check("the violation is detected and reported -- the scenario's own meta-check (a contract-violating candidate is correctly rejected) is what passes", ok, false)
end

make a function called st_gc_never_calls_contract_check_itself returns ok
  let src = read_file("self_hosting/lib/gherkin_contracts.patlang")
  return check("it contains no call to contract_check(...) -- the guard is genuinely separate from (and happens before) any code that would run the checked action for real", contains_text(src, "contract_check("), false)
end

make a function called register_language_logic_goap_contracts_steps returns done
  step("action_add(\"gather_wood\", [], [[\"have\",[\"wood\"]]], [], 1) and action_add(\"build_house\", [[\"have\",[\"wood\"]]], [[\"have\",[\"house\"]]], [], 1)", "st_noop")
  step("plan([[\"have\",[\"house\"]]]) is called", "st_noop")
  step("the result is [\"gather_wood\", \"build_house\"], in that exact order -- a real search, not a single-action lookup", "st_goap_multistep_plan")
  step("a goal no registered action (or chain of actions) can produce", "st_noop")
  step("plan is called", "st_noop")
  step("the result is an empty list, not an error", "st_goap_unreachable_goal_empty_plan")

  step("rule_add(\"parent\", [\"alice\",\"bob\"], [])", "st_noop")
  step("solve(\"parent\", [\"alice\",\"bob\"]) is called", "st_noop")
  step("the result is a list with exactly 1 solution", "st_rule_ground_fact_one_solution")
  step("rule_add(\"grandparent\", [\"X\",\"Z\"], [[\"parent\",[\"X\",\"Y\"]], [\"parent\",[\"Y\",\"Z\"]]]) plus parent(alice,bob) and parent(bob,carol)", "st_noop")
  step("solve(\"grandparent\", [\"alice\",\"Z\"]) is called", "st_noop")
  step("Z resolves to \"carol\" -- confirmed via real chained unification, not a flat lookup", "st_rule_chained_resolves_var")
  step("a query with no possible proof", "st_noop")
  step("solve is called", "st_noop")

  step("`rule grandparent(X, Z) :- parent(X, Y), parent(Y, Z).` plus parent(alice,bob) and parent(bob,carol)", "st_noop")
  step("solve(\"grandparent\", [\"alice\", \"Z\"]) is called", "st_noop")
  step("Z resolves to \"carol\" -- identical to the hand-written rule_add equivalent, since this IS that call under sugar", "st_rule_sugar_matches_hand_written")

  step("fact(\"likes\", \"alice\", \"bob\") and fact(\"likes\", \"alice\", \"carol\")", "st_noop")
  step("query(\"likes\", \"alice\", ANYTHING) is called", "st_noop")
  step("the result is 2 -- a COUNT of matching facts, not a boolean or a list", "st_fact_records_binary_relation")
  step("the same facts above", "st_noop")
  step("query is called with different, even nonsensical, third arguments", "st_noop")
  step("the result is unchanged -- query only ever filters on (pred, a), matching ANY b", "st_fact_third_arg_ignored")
  step("a subject with no recorded facts", "st_noop")
  step("query is called", "st_noop")
  step("the result is 0, not an error", "st_fact_no_match_zero")

  step("`goal need_a_house { built(house) }`, with dep/built facts and 2 registered actions, requiring a genuine chain", "st_noop")
  step("`pursue need_a_house` is evaluated", "st_noop")
  step("it returns a 3-step plan, the same search plan() itself performs", "st_pursue_finds_multistep_plan")
  step("action_bind bound both actions to closures that both return true", "st_noop")
  step("`activate PLAN` is evaluated", "st_noop")
  step("it returns true", "st_activate_all_succeed")
  step("the SAME plan is still findable, but one action is re-bound to a closure that now returns false for this specific case", "st_noop")
  step("pursue (finds the same plan again) then activate (runs it) are evaluated", "st_noop")
  step("activate returns false -- stopping the moment the failing step runs, even though the planner still found a valid dependency chain", "st_activate_stops_on_failing_step")

  step("safe_divide(10, 2), which passes both its require and ensure checks", "st_noop")
  step("solve(\"contract_holds\", [\"safe_divide\", \"X\"]) is called afterward", "st_noop")
  step("it returns a NON-EMPTY list of solutions -- the passing checks are real, derivable facts in the SAME store rule_add/solve uses, not an invisible side effect", "st_contract_holds_queryable")

  step("`Given an integer x` binds the global variable x, and a scenario adds `And require x < 10` / `And ensure x < 20`", "st_noop")
  step("the scenario runs against a hand-written \"brilliant\" transformation (returns 2*x)", "st_noop")
  step("both clauses are evaluated immediately against the bound value of x, exactly like an ordinary require/ensure statement would be", "st_gc_immediate_bound_check")
  step("an action `scale(X)` requiring `input(X)`, producing `scaled(X)`, and a scenario clause `And require X < 10` / `And ensure X < 20`", "st_noop")
  step("`plan([[\"scaled\", [\"5\"]]])` synthesizes the candidate `scale(X=5)`", "st_noop")
  step("both clauses are evaluated against X's bound value as parsed out of that plan step's own label, before the candidate is accepted -- not encoded as a GOAP GroundFact (a scalar comparison like `X < 10` isn't a unifiable ground predicate the way action_add's preconditions are)", "st_gc_synth_binding_check_passes")
  step("the same `scale(X)` action, but `plan([[\"scaled\", [\"15\"]]])` synthesizes `scale(X=15)`", "st_noop")
  step("the scenario's `And require X < 10` clause is checked against that binding", "st_noop")
  step("the violation is detected and reported -- the scenario's own meta-check (\"a contract-violating candidate is correctly rejected\") is what passes, honestly distinguishing \"the feature works\" from \"the underlying candidate happened to satisfy its contract\"", "st_gc_synth_binding_check_rejects_violation")
  step("the library that implements require/ensure clause checking (self_hosting/lib/gherkin_contracts.patlang)", "st_noop")
  step("its own source text is inspected directly", "st_noop")
  step("it contains no call to contract_check(...) -- the host primitive require/ensure/assert always lower to elsewhere in the language -- confirming the guard is genuinely separate from (and happens before) any code that would run the checked action for real", "st_gc_never_calls_contract_check_itself")
  return true
end

# ---- tcp_networking_round_trip.feature ----

make a function called st_tcp_connect_before_accept returns ok
  let port = tcp_listen(0)
  set_var("tcp_spec_port", port)
  let a = check("require port > 0", port > 0, true)
  let client = tcp_connect("127.0.0.1", port)
  let b = check("it succeeds (the OS backlog queues it) -- confirmed via a passing require, not assumed", client >= 0, true)
  set_var("tcp_spec_client", client)
  return a and b
end

make a function called st_tcp_round_trip_both_directions returns ok
  let port = get("__vars", "tcp_spec_port")
  let client = get("__vars", "tcp_spec_client")
  let server_conn = tcp_accept(port)
  tcp_write(client, "hello from client")
  tcp_write(server_conn, "hello from server")
  let a = check("the server's tcp_read returns exactly the client's message", tcp_read(server_conn), "hello from client")
  let b = check("the client's tcp_read returns exactly the server's message", tcp_read(client), "hello from server")
  tcp_close(client)
  tcp_close(server_conn)
  return a and b
end

# ---- tcp_close_teardown.feature ----

make a function called st_tcp_close_teardown returns ok
  let port = tcp_listen(0)
  let client = tcp_connect("127.0.0.1", port)
  let server_conn = tcp_accept(port)
  tcp_close(client)
  return check("it returns \"\" (an ensure guard on this exact fact passes) -- confirming the close was a real, graceful teardown the peer can observe, not just a local no-op", tcp_read(server_conn), "")
end

# ---- signals_claim_and_poll.feature ----

make a function called st_signal_first_claim_becomes_primary returns ok
  let port_id = signal_claim(9601)
  set_var("signal_spec_port_id", port_id)
  return check("it is >= 0 (a real port_id)", port_id >= 0, true)
end

make a function called st_signal_second_claim_rejected returns ok
  return check("it returns -1 -- the free single-instance-detection this subsystem relies on", signal_claim(9601), -1)
end

make a function called st_signal_poll_idle_times_out_empty returns ok
  let port_id = get("__vars", "signal_spec_port_id")
  return check("it returns \"\" within the timeout, not an error or a hang", signal_poll(port_id, 20), "")
end

# ---- sql_engine_end_to_end.feature ----

make a function called sql_spec_run takes db, sql returns new_db
  let ast = sql_parse(sql)
  let outcome = sql_execute(db, ast, "0")
  return outcome[0]
end

make a function called sql_spec_run_and_get takes db, sql returns outcome
  let ast = sql_parse(sql)
  return sql_execute(db, ast, "0")
end

make a function called st_sql_create_table_guarded returns ok
  let a = check("require not rdb_table_exists(\"spec_people\")", rdb_table_exists("spec_people"), false)
  let db = rdb_init()
  let db = sql_spec_run(db, "CREATE TABLE spec_people (name STRING, age INT)")
  set_var("sql_spec_db_marker", "created")
  let b = check("ensure rdb_table_exists(\"spec_people\") afterward passes -- the contract itself proves the table was actually created, not assumed", rdb_table_exists("spec_people"), true)
  return a and b
end

make a function called st_sql_insert_select_where returns ok
  let db = rdb_init()
  let db = sql_spec_run(db, "INSERT INTO spec_people VALUES ('alice', 30)")
  let db = sql_spec_run(db, "INSERT INTO spec_people VALUES ('bob', 25)")
  let sel = sql_spec_run_and_get(db, "SELECT name FROM spec_people WHERE age > 28")
  let a = check("exactly 1 row is returned", sel[1][2].length, 1)
  let b = check("it is alice", sel[1][2][0][0], "alice")
  return a and b
end

# ---- sql_test_environment_isolation.feature ----

make a function called st_sql_table_left_existing_this_process returns ok
  return check("a table created and left existing at the end of one process's run", rdb_table_exists("spec_isolated_table"), false)
end

make a function called st_sql_isolation_across_processes returns ok
  let db = rdb_init()
  let db = sql_spec_run(db, "CREATE TABLE spec_isolated_table (x INT)")
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/tools/spec_fixtures/sql_isolation_check.patlang")
  return check("it reports false -- each --ir-run invocation starts with a genuinely clean table namespace, confirmed empirically rather than assumed from the implementation", contains_text(out, "false"), true)
end

# ---- message_queue.feature ----

make a function called mq_spec_topic returns t
  return "spec_scratch_mq_topic"
end

make a function called mq_spec_reset returns done
  let path = q_file(mq_spec_topic())
  if file_exists(path) == "1" then
    write_file(path, "")
  end
  return true
end

make a function called st_mq_fresh_topic_empty returns done
  mq_spec_reset()
  require to_num(list_len(queue_pending(mq_spec_topic()))) == 0
  return true
end

make a function called st_mq_consume_fifo_unacked returns ok
  let id1 = queue_publish(mq_spec_topic(), "first message")
  let id2 = queue_publish(mq_spec_topic(), "second message")
  set_var("mq_spec_id1", id1)
  set_var("mq_spec_id2", id2)
  let payload = queue_consume(mq_spec_topic())
  return check("it returns \"first message\" -- FIFO order, and it remains pending until explicitly acked", payload, "first message")
end

make a function called st_mq_ack_removes_only_that_message returns ok
  let id1 = get("__vars", "mq_spec_id1")
  let id2 = get("__vars", "mq_spec_id2")
  queue_ack(mq_spec_topic(), id1)
  let pending = queue_pending(mq_spec_topic())
  ensure pending.length == 1
  return check("only the SECOND message's id remains", "" + pending[0], "" + id2)
end

# ---- task_registry_beacon.feature ----

make a function called tr_spec_task_name returns t
  return "spec_scratch_beacon_task"
end

make a function called tr_spec_reset returns done
  let path = q_file(tr_topic_for(tr_spec_task_name()))
  if file_exists(path) == "1" then
    write_file(path, "")
  end
  return true
end

make a function called st_tr_announce_readable_back returns ok
  tr_spec_reset()
  tr_announce(tr_spec_task_name(), "does spec work")
  let result = tr_read_one(tr_spec_task_name())
  return check("it returns the announced description", result[1], "does spec work")
end

make a function called st_tr_discover_finds_fresh returns ok
  let all = tr_discover_all(60000)
  let found = false
  let i = 0
  let n = to_num(list_len(all))
  while i < n do
    if all[i][0] == tr_spec_task_name() then
      let found = true
    end
    let i = i + 1
  end
  return check("the task appears in the results", found, true)
end

make a function called tr_spec_count_lines takes content returns n
  let count = 0
  let cur_len = 0
  let i = 0
  while i < content.length do
    let c = char_code(content, i)
    if c == 10 then
      if cur_len > 0 then
        let count = count + 1
      end
      let cur_len = 0
    else
      if c != 13 then
        let cur_len = cur_len + 1
      end
    end
    let i = i + 1
  end
  if cur_len > 0 then
    let count = count + 1
  end
  return count
end

make a function called st_tr_reannounce_overwrites returns ok
  tr_announce(tr_spec_task_name(), "a different description")
  let path = q_file(tr_topic_for(tr_spec_task_name()))
  let content = read_file(path)
  let nonempty = tr_spec_count_lines(content)
  ensure nonempty == 1
  return check("exactly 1 row exists, not 2 -- confirming this beacon keeps only its LATEST state, unlike queue_publish's own accumulating log", nonempty, 1)
end

make a function called register_language_host_primitives_steps returns done
  step("`require port > 0` after tcp_listen(0)", "st_tcp_connect_before_accept")
  step("tcp_connect is called immediately, with no tcp_accept having run yet", "st_noop")
  step("it succeeds (the OS backlog queues it) -- confirmed via a passing require, not assumed", "st_noop")
  step("a connected client/server pair", "st_noop")
  step("the client writes \"hello from client\" and the server writes \"hello from server\"", "st_noop")
  step("the server's tcp_read returns exactly the client's message, and the client's tcp_read returns exactly the server's message", "st_tcp_round_trip_both_directions")

  step("a connected pair, then `tcp_close(client)`", "st_noop")
  step("the server side calls tcp_read on its end of the connection", "st_noop")
  step("it returns \"\" (an ensure guard on this exact fact passes) -- confirming the close was a real, graceful teardown the peer can observe, not just a local no-op", "st_tcp_close_teardown")

  step("signal_claim(9601) called for the first time", "st_noop")
  step("the result is checked", "st_noop")
  step("it is >= 0 (a real port_id)", "st_signal_first_claim_becomes_primary")
  step("the same process still holds the port from the first claim", "st_noop")
  step("signal_claim(9601) is called again", "st_noop")
  step("it returns -1 -- the free single-instance-detection this subsystem relies on", "st_signal_second_claim_rejected")
  step("a claimed port with nothing sent to it", "st_noop")
  step("signal_poll(port_id, 20) is called", "st_noop")
  step("it returns \"\" within the timeout, not an error or a hang", "st_signal_poll_idle_times_out_empty")

  step("`require not rdb_table_exists(\"spec_people\")` beforehand", "st_noop")
  step("`CREATE TABLE spec_people (...)` is executed via sql_parse+sql_execute", "st_noop")
  step("`ensure rdb_table_exists(\"spec_people\")` afterward passes -- the contract itself proves the table was actually created, not assumed", "st_sql_create_table_guarded")
  step("two inserted rows (alice age 30, bob age 25)", "st_noop")
  step("`SELECT name FROM spec_people WHERE age > 28` is executed", "st_noop")
  step("exactly 1 row is returned, and it is alice", "st_sql_insert_select_where")

  step("a table created and left existing at the end of one process's run", "st_sql_table_left_existing_this_process")
  step("a SEPARATE, later process checks whether that table exists", "st_noop")
  step("it reports false -- each --ir-run invocation starts with a genuinely clean table namespace, confirmed empirically rather than assumed from the implementation", "st_sql_isolation_across_processes")

  step("a scratch-only topic name never used elsewhere", "st_noop")
  step("`require to_num(list_len(queue_pending(topic))) == 0` runs first", "st_noop")
  step("it passes -- confirming this is genuinely a clean start, not a leftover from a previous failed run", "st_mq_fresh_topic_empty")
  step("two published messages (\"first message\", \"second message\")", "st_noop")
  step("queue_consume is called", "st_noop")
  step("it returns \"first message\" -- FIFO order, and it remains pending until explicitly acked", "st_mq_consume_fifo_unacked")
  step("the first message is acked by its id", "st_noop")
  step("queue_pending is read afterward", "st_noop")
  step("only the SECOND message's id remains -- confirmed via an ensure guard on the exact remaining id, not just a count", "st_mq_ack_removes_only_that_message")

  step("tr_announce(\"spec_scratch_beacon_task\", \"does spec work\")", "st_noop")
  step("tr_read_one is called for that task", "st_noop")
  step("it returns the announced description", "st_tr_announce_readable_back")
  step("the same recent announcement", "st_noop")
  step("tr_discover_all(60000) is called", "st_noop")
  step("the task appears in the results", "st_tr_discover_finds_fresh")
  step("a second tr_announce call for the same task, with a different description", "st_noop")
  step("the underlying row count is checked via an ensure guard", "st_noop")
  step("exactly 1 row exists, not 2 -- confirming this beacon keeps only its LATEST state, unlike queue_publish's own accumulating log", "st_tr_reannounce_overwrites")
  return true
end

# ---- x64_bitwise_selftest_universal_print.feature ----
# GitHub #47: a genuine interp-vs-x64 comparison, via exec_capture on two
# real backends -- no cross-process concurrency needed here, just two
# ordinary sequential compiles/runs, matching run_benchmarks.patlang's
# own exec_capture(patc1_exe, src, exe_path, "--x64") pattern.

make a function called st_x64_bitwise_interp_matches_x64 returns ok
  let expected = "8\n15\n6\n1152921504606846976\n1"
  let interp_out = str_trim(exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/examples/x64_bitwise_selftest.patlang"))
  let a = check("interp output shows 8, 15, 6, 1152921504606846976, 1", interp_out, expected)
  let x64_exe = "self_hosting/build/spec_x64_bitwise_selftest.exe"
  exec_capture("./patc1.exe", "self_hosting/examples/x64_bitwise_selftest.patlang", x64_exe, "--x64")
  let x64_out = str_trim(exec_capture(x64_exe))
  let b = check("x64 output shows 8, 15, 6, 1152921504606846976, 1", x64_out, expected)
  let c = check("the two outputs match exactly", interp_out, x64_out)
  return a and b and c
end

# ---- signals_full_round_trip.feature ----
# A real two-process test: spawn() launches a genuinely detached child
# process (self_hosting/tools/spec_fixtures/signal_primary.patlang), this
# process (the "secondary") talks to it over the real loopback TCP signal
# mechanism, same as self_hosting/examples/signals_demo.patlang's own
# worked primary/secondary pattern. signal_query/signal_send are FATAL
# (no try/catch) if nothing is listening yet -- deliberately sleeps first
# rather than retrying, to avoid a retry loop's first early attempt
# crashing this entire spec run.

make a function called st_signals_round_trip_query_reply returns ok
  let log_path = "self_hosting/tools/spec_fixtures/signal_primary.log"
  if file_exists(log_path) == "1" then
    write_file(log_path, "")
  end
  let pid = spawn("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/tools/spec_fixtures/signal_primary.patlang")
  set_var("signals_rt_pid", pid)
  sleep_ms(600)
  let reply = signal_query(9701, "status", "")
  return check("it receives exactly \"uptime: 42\" -- the primary's own handler's reply text, round-tripped over the real TCP connection between two real OS processes", reply, "uptime: 42")
end

make a function called st_signals_round_trip_quit_stops_early returns ok
  let pid = get("__vars", "signals_rt_pid")
  signal_send(9701, "quit", "")
  let waited = 0
  while is_alive(pid) and (waited < 3000) do
    sleep_ms(50)
    let waited = waited + 50
  end
  let log_path = "self_hosting/tools/spec_fixtures/signal_primary.log"
  let log = read_file(log_path)
  return check("it shows the primary exited via the quit path, not by running its full bounded iteration count", contains_text(log, "exited via quit path"), true)
end

# ---- build_daemon_exemplar.feature ----
# GitHub #49: the full exemplar (logic + GOAP + timing/persistence +
# events + signals). Backs up the real shared history file first --
# self_hosting/lib/build_daemon.patlang's own bd_history_file() -- and
# restores it byte-for-byte afterward, confirmed, exactly as this spec's
# own text requires. Same spawn/signal_query/signal_send shape as the
# signals_full_round_trip spec above, over self_hosting/examples/
# build_daemon_demo.patlang (BD_PORT 9410) rather than reinventing a
# smaller fixture, since the exemplar IS that real file.

make a function called bd_spec_history_path returns p
  return "portfolio/build/build_daemon_history.txt"
end

make a function called st_bd_backup_history returns done
  let path = bd_spec_history_path()
  if file_exists(path) == "1" then
    set_var("bd_spec_backup", read_file(path))
  else
    set_var("bd_spec_backup", "")
  end
  return true
end

make a function called st_bd_primary_runs_initial_cycle returns ok
  let pid = spawn("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/examples/build_daemon_demo.patlang")
  set_var("bd_spec_pid", pid)
  sleep_ms(600)
  return check("it claims the signal port and runs an initial build cycle (a live 'status' reply exists at all)", signal_query(9410, "status", "").length > 0, true)
end

make a function called st_bd_status_reports_real_rebuild returns ok
  let reply = signal_query(9410, "status", "")
  return check("it receives a reply describing what was actually rebuilt -- a real signal_query round trip, same mechanism as the standalone signals spec", contains_text(reply, "rebuilt"), true)
end

make a function called st_bd_restore_history returns ok
  let path = bd_spec_history_path()
  let backup = get("__vars", "bd_spec_backup")
  if backup == "" then
    if file_exists(path) == "1" then
      write_file(path, "")
    end
  else
    write_file(path, backup)
  end
  let restored = ""
  if file_exists(path) == "1" then
    let restored = read_file(path)
  end
  return check("the shared history file is restored byte-for-byte equal again, confirmed, not just attempted", restored, backup)
end

make a function called st_bd_quit_stops_primary_cleanly returns ok
  let pid = get("__vars", "bd_spec_pid")
  signal_send(9410, "quit", "")
  let waited = 0
  while is_alive(pid) and (waited < 3000) do
    sleep_ms(50)
    let waited = waited + 50
  end
  let a = check("the primary cleanly stops (no longer alive) after a quit signal, not left running indefinitely", is_alive(pid), false)
  let b = st_bd_restore_history()
  return a and b
end

make a function called register_language_process_backend_steps returns done
  step("self_hosting/examples/x64_bitwise_selftest.patlang uses print()", "st_noop")
  step("the file is run under `pat --ir-run` and compiled+run via `--x64`", "st_noop")
  step("both show: 8, 15, 6, 1152921504606846976, 1", "st_noop")
  step("the two outputs match exactly", "st_x64_bitwise_interp_matches_x64")
  step("the original file called rt_print_i64, a name unresolved under", "st_noop")
  step("the file was run under `pat --ir-run` before this fix", "st_noop")
  step("every rt_print_i64 call silently no-op'd (an unresolved Call does not", "st_noop")
  step("comparing that empty output against the x64 backend's real,", "st_noop")

  step("a detached primary process (launched via `start /B`) with `when status do signal_reply(\"uptime: 42\") end` registered", "st_bd_backup_history")
  step("a separate, synchronous secondary process calls signal_query(port, \"status\", \"\")", "st_signals_round_trip_query_reply")
  step("it receives exactly \"uptime: 42\" -- the primary's own handler's reply text, round-tripped over the real TCP connection between two real OS processes", "st_noop")
  step("the secondary also calls signal_send(port, \"quit\", \"\") afterward", "st_noop")
  step("the primary's own log is inspected after the fact", "st_noop")
  step("it shows the primary exited via the quit path, not by running its full bounded iteration count", "st_signals_round_trip_quit_stops_early")

  step("self_hosting/examples/build_daemon_demo.patlang launched with no CLI args (via `start /B`)", "st_noop")
  step("it claims the signal port", "st_noop")
  step("it runs a build cycle derived from real logic facts (rule_add/solve) and a real cost-weighted GOAP plan (action_add/plan), logging via when/emit", "st_bd_primary_runs_initial_cycle")
  step("the primary is still running", "st_noop")
  step("a separate process runs the same demo with \"status\" as its CLI argument", "st_noop")
  step("it receives a reply describing what was actually rebuilt -- a real signal_query round trip, same mechanism as the standalone signals spec", "st_bd_status_reports_real_rebuild")
  step("the primary is still polling", "st_noop")
  step("a separate process sends \"quit\"", "st_noop")
  step("the primary's own log shows \"DAEMON: exiting\", not left running indefinitely", "st_bd_quit_stops_primary_cleanly")
  return true
end

make a function called register_language_arith_bitwise_cmp_steps returns done
  step("the integers 2 and 3", "st_noop")
  step("+, -, *, / are applied", "st_noop")
  step("2+3=5, 5-3=2, 4*3=12, 10/2=5", "st_arith_basic")
  step("2 + 3 * 4", "st_noop")
  step("evaluated", "st_noop")
  step("the result is 14, not 20 -- * is evaluated before +", "st_arith_precedence")
  step("-10 % 3", "st_noop")
  step("the result is -1, matching truncating division convention (like Rust/C, unlike Python's floored modulo)", "st_arith_mod_sign")
  step("x = 2 + 3 * 4", "st_arith_kind_int")
  step("numeric_kind(x) is captured", "st_noop")

  step("12 (1100) and 10 (1010)", "st_noop")
  step("band, bor, bxor are applied", "st_noop")
  step("12 band 10 = 8 (1000), 12 bor 10 = 14 (1110), 12 bxor 10 = 6 (0110)", "st_bitwise_logic")
  step("1 and 16", "st_noop")
  step("shl 4 and shr 4 are applied respectively", "st_noop")
  step("1 shl 4 = 16, 16 shr 4 = 1", "st_bitwise_shift")
  step("x = 12 bxor 10", "st_bitwise_kind_int")
  step("x = 9223372036854775807 + 1", "st_bitwise_kind_bigint")

  step("3 and 4", "st_noop")
  step("== and != are applied", "st_noop")
  step("3==3 is true, 3==4 is false, 3!=4 is true, 3!=3 is false", "st_cmp_eq")
  step("<, <=, >, >= are applied", "st_noop")
  step("3<4 true, 4<3 false, 3<3 false; 3<=3 true; 4>3 true, 3>3 false; 3>=3 true", "st_cmp_ordering")
  step("two separately-constructed strings \"abc\"", "st_noop")
  step("== is applied", "st_noop")
  step("the result is true", "st_cmp_string_eq")
  step("x = 3 < 4", "st_cmp_kind_bool")
  step("type_of(x) is captured", "st_noop")
  return true
end
