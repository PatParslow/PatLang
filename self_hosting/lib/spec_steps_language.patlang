  let outs = st_x64_run_both_guarded("self_hosting/tools/spec_fixtures/x64_exec_relative_path.patlang", "self_hosting/build/spec_x64_exec_relative_path.exe")
  let expected = "true\ntrue\ntrue\nafter"
  let a = expect(ctx, "the interpreter prints the expected lines", list_get(outs, 0) == expected, true)
  let b = expect(ctx, "native x64 prints exactly what the interpreter prints (previously: empty capture)", list_get(outs, 1) == list_get(outs, 0), true)
  return a and b
end

make a function called st_x64_exec_timeout takes ctx returns ok
  let outs = st_x64_run_both_guarded("self_hosting/tools/spec_fixtures/x64_exec_timeout.patlang", "self_hosting/build/spec_x64_exec_timeout.exe")
  let expected = "false\ntrue\ntrue\ntrue\ntrue\nfalse\ndone"
  let a = expect(ctx, "the interpreter prints the seven expected lines", list_get(outs, 0) == expected, true)
  let b = expect(ctx, "native x64 prints exactly what the interpreter prints (previously: hung forever)", list_get(outs, 1) == list_get(outs, 0), true)
  return a and b
end

make a function called register_x64_process_and_bounds_steps takes ctx returns done
  step(ctx, "an empty list, a three-element list, and out-of-range and negative indexes into them", "st_noop")
  step(ctx, "exec_capture and exec_capture_io called with \"rust-runtime/target/release/pat.exe\"", "st_noop")
  step(ctx, "an infinite-loop child with a 400 ms timeout and a quick child with a 30000 ms timeout", "st_noop")
  step(ctx, "both print the same nine lines, with Unit for the list reads and 0 for list_len of Unit", "st_x64_bounds_parity")
  step(ctx, "both print the same four lines, with the child's output captured", "st_x64_exec_relative_path")
  step(ctx, "both print the same seven lines: the infinite child reports failure and \"timeout after 400 ms\" well inside the guard, the quick child succeeds untimed", "st_x64_exec_timeout")
  return true
end

make a function called st_x64_float_type_of takes ctx returns ok
  let outs = st_x64_run_both("self_hosting/tools/spec_fixtures/x64_float_type_of.patlang", "self_hosting/build/spec_x64_float_type_of.exe")
  let expected = "float\n2.5\nfloat\n3\n2.5\nafter"
  let a = expect(ctx, "the interpreter prints the six expected lines", str_trim(list_get(outs, 0)) == expected, true)
  let b = expect(ctx, "native x64 prints exactly what the interpreter prints (previously: int, with the float's raw bits misread as an int)", str_trim(list_get(outs, 1)) == str_trim(list_get(outs, 0)), true)
  return a and b
end

make a function called register_x64_float_type_of_steps takes ctx returns done
  step(ctx, "a bare float literal and the direct, un-promoted result of sqrt()", "st_noop")
  step(ctx, "both print the same six lines: float, its string form, float again, the sqrt result's string form, the literal's own correct print, and \"after\"", "st_x64_float_type_of")
  return true
end

