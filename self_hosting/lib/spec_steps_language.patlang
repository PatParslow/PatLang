# The steps spec_library/language/*.feature runs on, for
# self_hosting/tools/run_language_spec_suite.patlang (GitHub #49, #269).
#
# A scenario carries its program in a doc string and says what it prints:
# those steps are spec_steps_program.patlang's, and run the program on both
# engines. The symbolic_* features drive the symbolic library in-process,
# with steps of their own (spec_steps_symbolic.patlang).

include "includes.patlang"
include "gherkin.patlang"
include "spec_steps_symbolic.patlang"
