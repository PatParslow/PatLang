make a function called st_x64_dynamic_float_auto_box_call takes ctx returns ok
  let outs = st_x64_run_both("self_hosting/tools/spec_fixtures/x64_dynamic_float_auto_box_call.patlang", "self_hosting/build/spec_x64_dynamic_float_auto_box_call.exe")
