# ---- x64_process_and_bounds.feature ----
# Same both-backends comparison as st_x64_run_both, but the native run goes
# through exec_capture_io with a wall-clock timeout so a regression in the
# very thing under test (a hung child) fails the gate instead of hanging it.

make a function called st_x64_run_both_guarded takes fixture, exe returns outs
  let interp_out = str_trim(exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", fixture))
  exec_capture("./patc1.exe", fixture, exe, "--x64")
  let r = exec_capture_io("./" + exe, [], "", 120000)
  return [interp_out, str_trim(r[0])]
end

make a function called st_x64_bounds_parity takes ctx returns ok
  let outs = st_x64_run_both_guarded("self_hosting/tools/spec_fixtures/x64_list_bounds.patlang", "self_hosting/build/spec_x64_list_bounds.exe")
  let expected = "unit\nunit\nunit\ntrue\n0\n0\n0\n3\nafter"
  let a = expect(ctx, "the interpreter prints the nine expected lines", list_get(outs, 0) == expected, true)
  let b = expect(ctx, "native x64 prints exactly what the interpreter prints (previously: segfault)", list_get(outs, 1) == list_get(outs, 0), true)
  return a and b
end

