end

# Native-only (rt_box_float has no interpreter equivalent, so this
# cannot use st_x64_run_both's own interp-vs-x64 comparison shape).
make a function called st_x64_dynamic_float_boxed_arg takes ctx returns ok
  exec_capture("./patc1.exe", "self_hosting/tools/spec_fixtures/x64_dynamic_float_boxed_arg.patlang", "self_hosting/build/spec_x64_dynamic_float_boxed_arg.exe", "--x64")
  let out = str_trim(exec_capture("self_hosting/build/spec_x64_dynamic_float_boxed_arg.exe"))
  return expect(ctx, "native x64 prints 3.5 then float (previously: segfault)", out, "3.5\nfloat")
end

make a function called register_x64_dynamic_float_boxed_arg_steps takes ctx returns done
  step(ctx, "plus(a, b) with no float literal in its own body, called with an explicitly boxed 1.5 and a plain int 2", "st_noop")
  step(ctx, "the file is compiled and run via --x64 only (rt_box_float has no interpreter equivalent)", "st_noop")
  step(ctx, "it prints 3.5 and then float, not a segfault", "st_x64_dynamic_float_boxed_arg")
  return true
end

