# Issue #44: match/case step registrations for spec_library/language/
# match_pattern.feature, run by self_hosting/tools/run_match_spec_suite.patlang.

include "regex.patlang"

make a function called st_noop takes ctx returns done
  return true
end

fn classify_demo(x) {
    match x do
      case 0 then
        return "lit0"
      case "hi" then
        return "greeting"
      case > 10 then
        return "big"
      case n then
        return "bound:" + n
    end
}

fn describe_demo(pair) {
    match pair do
      case ["Ok", v] then
        return "ok:" + v
      case ["Err", ["Nested", m]] then
        return "nested-err:" + m
      case _ then
        return "unknown"
    end
}

fn guarded_demo(x) {
    match x do
      case n when n > 100 then
        return "big-bound:" + n
      case n then
        return "small-bound:" + n
    end
}

fn glob_demo(s) {
    match s do
      case *fred* then
        return "glob-hit"
      case _ then
        return "glob-miss"
    end
}

fn nomatch_demo(x) {
    match x do
      case 1 then
        return "one"
      case 2 then
        return "two"
    end
}

# Real bug found via a user report of the browser IDE hanging (not by
# review): a matched arm whose body does NOT end in `return` (a plain
# side-effecting statement, e.g. `print(...)`) needs lower_match to jump
# PAST the remaining arms and the fatal no-match block to reach whatever
# comes after the whole match statement. That jump target was computed
# correctly, but the `Jump 0` placeholder it should have overwritten was
# never actually patched: lower_match collected each arm's placeholder pc
# into `endJumps` via the Vec API (vec_new/vec_push) but then read it back
# with list-style `.length`/`endJumps[i]` instead of `vec_len`/`vec_get` --
# a silent type mismatch (no error, just a wrong/falsy read) that made the
# patch-back loop iterate zero times. Every existing match scenario's
# matching arm ended in `return`, which exits via a `Return` instruction
# BEFORE ever reaching that arm's own unpatched `Jump 0` -- so nothing
# until this exact shape (a matched, non-returning arm with more arms
# after it) ever actually executed the broken jump. It jumped back to
# instruction 0 (function entry) instead of past the match, silently
# looping forever with the scrutinee unchanged -- reproduced directly via
# patc1.exe (self-hosted lower.patlang); native rust-runtime/src/ir/
# lowering.rs's own typed `Vec<usize>` has no equivalent confusion and was
# never affected.
fn nonreturn_arm_demo(x) {
    match x do
      case 1 then
        return "one"
      case > 2 then
        print("two-plus-side-effect")
      case > 10 then
        return "lots"
    end
    return "fell-through"
}

make a function called tail_value_demo takes x returns r
  match x do
    case 1 then
      "one"
    case _ then
      "other"
  end
end

make a function called assign_result_demo takes pair returns r
  match pair do
    case [a, b] then
      let r = a + b
    case _ then
      let r = 0
  end
end

make a function called captured_demo takes limit, x returns r
  let f = |y| {
    match y do
      case > limit then
        return "over"
      case n when n == limit then
        return "at"
      case _ then
        return "under"
    end
  }
  return f(x)
end

make a function called once_demo takes counter returns r
  let scrutinee = |c| {
    vec_set(c, 0, vec_get(c, 0) + 1)
    return 5
  }
  match scrutinee(counter) do
    case 1 then
      return "one"
    case 2 then
      return "two"
    case > 3 then
      return "many"
  end
end

make a function called other_type_demo takes x returns r
  match x do
    case "7" then
      return "text"
    case 7 then
      return "seven"
    case [a] then
      return "list"
    case _ then
      return "other"
  end
end

make a function called st_match_tail_value takes ctx returns ok
  let a = expect(ctx, "the function returns the taken arm's value", tail_value_demo(1), "one")
  let b = expect(ctx, "the function returns the other arm's value", tail_value_demo(2), "other")
  return a and b
end

make a function called st_match_assign_result takes ctx returns ok
  let a = expect(ctx, "the function returns what the taken arm assigned", assign_result_demo([2, 3]), 5)
  let b = expect(ctx, "or what the other arm assigned", assign_result_demo(9), 0)
  return a and b
end

make a function called st_match_captured takes ctx returns ok
  let a = expect(ctx, "over the captured limit", captured_demo(10, 11), "over")
  let b = expect(ctx, "at the captured limit", captured_demo(10, 10), "at")
  let c = expect(ctx, "under the captured limit", captured_demo(10, 9), "under")
  return a and b and c
end

make a function called st_match_once takes ctx returns ok
  let counter = vec_new()
  vec_push(counter, 0)
  let r = once_demo(counter)
  let a = expect(ctx, "the arm taken after testing several", r, "many")
  let b = expect(ctx, "the function was called once", vec_get(counter, 0), 1)
  return a and b
end

make a function called st_match_other_type takes ctx returns ok
  let a = expect(ctx, "a number does not match its text", other_type_demo(8), "other")
  let b = expect(ctx, "a string does not match a list pattern", other_type_demo("x"), "other")
  let c = expect(ctx, "a list of another length does not match", other_type_demo([1, 2]), "other")
  let d = expect(ctx, "a list of that length does", other_type_demo([1]), "list")
  return a and b and c and d
end

make a function called st_match_literal takes ctx returns ok
  return expect(ctx, "the literal-0 arm's body runs", classify_demo(0), "lit0")
end

make a function called st_match_binding takes ctx returns ok
  return expect(ctx, "the bare-identifier arm runs with the identifier bound to 3", classify_demo(3), "bound:3")
end

make a function called st_match_comparison takes ctx returns ok
  return expect(ctx, "the `> 10` arm's body runs", classify_demo(20), "big")
end

make a function called st_match_tagged_list takes ctx returns ok
  return expect(ctx, "the [\"Ok\", v] arm runs with v bound to 5", describe_demo(["Ok", 5]), "ok:5")
end

make a function called st_match_nested_list takes ctx returns ok
  return expect(ctx, "the [\"Err\", [\"Nested\", m]] arm runs with m bound to \"boom\"", describe_demo(["Err", ["Nested", "boom"]]), "nested-err:boom")
end

make a function called st_match_wildcard_fallthrough takes ctx returns ok
  return expect(ctx, "the wildcard arm runs, not the nested-list arm", describe_demo(["Err", "flat"]), "unknown")
end

make a function called st_match_when_guard takes ctx returns ok
  return expect(ctx, "the guarded arm's test fails and a later arm runs instead", guarded_demo(12), "small-bound:12")
end

make a function called st_match_nonreturn_arm takes ctx returns ok
  return expect(ctx, "a matched arm with no `return` correctly jumps past the remaining arms, not back into the match", nonreturn_arm_demo(99), "fell-through")
end

# Real bug found via a failing run (not review): the guard used to be
# ANDed into the pattern's own test as ONE expression, evaluated before the
# pattern's bindings were ever Store'd -- so `n` in `when n > 100` read as
# unbound/Unit no matter what the real scrutinee was, and every guard
# silently evaluated false, always falling through to the next arm. This
# scenario is the one the bug above passed anyway (guard genuinely SHOULD
# fail for 12) -- this one instead requires the guard to actually SUCCEED
# with its own pattern's binding in scope, which is what caught it.
make a function called st_match_when_guard_succeeds takes ctx returns ok
  return expect(ctx, "the guarded arm's test succeeds, using its own pattern's binding", guarded_demo(200), "big-bound:200")
end

make a function called st_match_glob takes ctx returns ok
  return expect(ctx, "the glob arm's body runs", glob_demo("alfred smith"), "glob-hit")
end

make a function called st_match_nomatch_fatal takes ctx returns ok
  # A match no case takes halts the program, so it is observed from outside.
  # This spawns pat --ir-run; run_runtime.patlang's contracts.feature checks
  # the same fixture on v2 and on the v2 interpreter.
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/v2/spec/fixtures/rt_match_no_case.patlang")
  let a = expect(ctx, "the program halts with a fatal \"no case matched\" error, not a silent no-op", contains_text(out, "no case matched"), true)
  let b = expect(ctx, "the case that matched ran first", contains_text(out, "one"), true)
  let c = expect(ctx, "nothing after the fatal match runs", contains_text(out, "not reached"), false)
  return a and b and c
end

make a function called register_language_match_steps takes ctx returns done
  step(ctx, "a match over the number 0 with cases for 0, \"hi\", a comparison, and a binding", "st_noop")
  step(ctx, "the match is evaluated", "st_noop")
  step(ctx, "the literal-0 arm's body runs", "st_match_literal")
  step(ctx, "a match over the number 3 against the same case list", "st_noop")
  step(ctx, "the bare-identifier arm runs with the identifier bound to 3", "st_match_binding")
  step(ctx, "a match over the number 20 against the same case list", "st_noop")
  step(ctx, "the `> 10` arm's body runs", "st_match_comparison")
  step(ctx, "a match over [\"Ok\", 5] with cases [\"Ok\", v], [\"Err\", [\"Nested\", m]], and _", "st_noop")
  step(ctx, "the [\"Ok\", v] arm runs with v bound to 5", "st_match_tagged_list")
  step(ctx, "a match over [\"Err\", [\"Nested\", \"boom\"]] against the same case list", "st_noop")
  step(ctx, "the [\"Err\", [\"Nested\", m]] arm runs with m bound to \"boom\"", "st_match_nested_list")
  step(ctx, "a match over [\"Err\", \"flat\"] against the same case list", "st_noop")
  step(ctx, "the wildcard arm runs, not the nested-list arm", "st_match_wildcard_fallthrough")
  step(ctx, "a match over the number 12 with a binding pattern guarded by `when n > 100`", "st_noop")
  step(ctx, "the guarded arm's test fails and a later arm runs instead", "st_match_when_guard")
  step(ctx, "a match over the number 200 against the same guarded case list", "st_noop")
  step(ctx, "the guarded arm's test succeeds, using its own pattern's binding", "st_match_when_guard_succeeds")
  step(ctx, "a match over \"alfred smith\" with a `*fred*` case", "st_noop")
  step(ctx, "the glob arm's body runs", "st_match_glob")
  step(ctx, "a match with only literal cases for 1 and 2, no wildcard", "st_noop")
  step(ctx, "the match is evaluated against 99", "st_noop")
  step(ctx, "the program halts with a fatal \"no case matched\" error, not a silent no-op", "st_match_nomatch_fatal")
  step(ctx, "a match where the matching arm has no `return`, with more arms and code after it", "st_noop")
  step(ctx, "a matched arm with no `return` correctly jumps past the remaining arms, not back into the match", "st_match_nonreturn_arm")
  step(ctx, "a function whose last statement is a match, each arm ending in a value", "st_noop")
  step(ctx, "the function returns the taken arm's value", "st_match_tail_value")
  step(ctx, "a function returning r, each arm of its match assigning r from the pattern's bindings", "st_noop")
  step(ctx, "the function returns what the taken arm assigned", "st_match_assign_result")
  step(ctx, "a closure whose match compares against and guards with a captured variable", "st_noop")
  step(ctx, "the captured value decides the arm", "st_match_captured")
  step(ctx, "a match whose scrutinee calls a function that counts its calls, with several arms tested", "st_noop")
  step(ctx, "the function was called once", "st_match_once")
  step(ctx, "a match over a number with string and list cases first, and over a string with number and list cases first", "st_noop")
  step(ctx, "each falls through to its wildcard arm", "st_match_other_type")
  return true
end
