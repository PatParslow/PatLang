# Steps for a scenario that carries its program (review, test-suite
# recommendation 2: the scenario's text is the test). The program is the Given's
# doc string, the When runs it on both engines, and the Then's doc string is
# what each must print:
#
#   Scenario: ...
#     Given the program
#       """
#       print(1 + 1)
#       """
#     When it runs interpreted and compiled
#     Then both print
#       """
#       2
#       """
#
# `Then both stop, saying` instead: both engines refuse or stop the program,
# and each says what the doc string holds. `Then both print, before stopping`
# with `And both stop, saying`: the program prints those lines, then stops.
# `Then both print the same, ending`: both run to the end, print the same,
# and the output ends with the doc string's lines (a selftest's summary).
#
# The program goes in spec_out(), one file a scenario, named from a counter; it
# includes a library as `include "{lib}/NAME.patlang"` (prog_text).
include "gherkin.patlang"
include "v2_engines.patlang"
include "program_run.patlang"

# The program's text: a line `include "{lib}/NAME.patlang"` includes that file
# of self_hosting/lib, and `include "{root}/PATH"` a file by its path from the
# repository's root, wherever the program is written.
make a function called prog_text takes doc returns text
  let lib = path_absolute("self_hosting/lib")
  let root = path_absolute(".")
  let lines = split_lines(doc)
  let lib_marker = "include " + chr(34) + "{lib}/"
  let root_marker = "include " + chr(34) + "{root}/"
  let b = sb_new()
  let i = 0
  while i < list_len(lines) do
    let l = lines[i]
    if str_starts_with(l, lib_marker) then
      sb_push(b, "include " + chr(34) + lib + "/" + substr(l, lib_marker.length, l.length - lib_marker.length))
    elif str_starts_with(l, root_marker) then
      sb_push(b, "include " + chr(34) + root + "/" + substr(l, root_marker.length, l.length - root_marker.length))
    else
      sb_push(b, l)
    end
    sb_push(b, chr(10))
    let i = i + 1
  end
  return sb_str(b)
end

make a function called st_prog_given takes ctx returns ok
  let n = 1
  if ctx_has(ctx, "prog_count") then
    let n = ctx_get(ctx, "prog_count") + 1
  end
  ctx_set(ctx, "prog_count", n)
  let path = spec_out() + "/scenario_program_" + n + ".patlang"
  write_file(path, prog_text(step_doc(ctx)))
  ctx_set(ctx, "prog_path", path)
  return expect(ctx, "the scenario carries a program", step_doc(ctx) != "", true)
end

make a function called st_prog_run takes ctx returns ok
  let path = ctx_get(ctx, "prog_path")
  ctx_set(ctx, "prog_interpreted", run_interpreted(path))
  if ctx_has(ctx, "prog_target") and (ctx_get(ctx, "prog_target") == "linux") then
    ctx_set(ctx, "prog_compiled", run_compiled_linux(path, path + ".elf"))
  else
    ctx_set(ctx, "prog_compiled", run_compiled(path, path + ".exe"))
  end
  return true
end

make a function called st_prog_prints takes ctx returns ok
  let want = step_doc(ctx)
  let a = ctx_get(ctx, "prog_interpreted")
  let c = ctx_get(ctx, "prog_compiled")
  let i = expect(ctx, "interpreted, it prints what the scenario says (got " + str_trim(a[1]) + ")", a[0] and printed(a[1], want), true)
  let k = expect(ctx, "compiled, it prints what the scenario says (got " + str_trim(c[1]) + ")", c[0] and printed(c[1], want), true)
  return i and k
end

# Both engines refuse or stop the program: neither run ends well, and each
# output holds the Then's doc string (a contract's message, a parse error).
make a function called st_prog_stops takes ctx returns ok
  let want = str_trim(step_doc(ctx))
  let a = ctx_get(ctx, "prog_interpreted")
  let c = ctx_get(ctx, "prog_compiled")
  let i = expect(ctx, "interpreted, it stops saying so (got " + str_trim(a[1]) + ")", (not a[0]) and str_contains(a[1], want), true)
  let k = expect(ctx, "compiled, it stops saying so (got " + str_trim(c[1]) + ")", (not c[0]) and str_contains(c[1], want), true)
  return i and k
end

# Both engines print the doc string's lines first and then stop: neither run
# ends well. What they say as they stop is an `And both stop, saying` step's.
make a function called st_prog_prints_before_stopping takes ctx returns ok
  let want = step_doc(ctx)
  let a = ctx_get(ctx, "prog_interpreted")
  let c = ctx_get(ctx, "prog_compiled")
  let i = expect(ctx, "interpreted, it prints what the scenario says, then stops (got " + str_trim(a[1]) + ")", (not a[0]) and str_starts_with(a[1], want), true)
  let k = expect(ctx, "compiled, it prints what the scenario says, then stops (got " + str_trim(c[1]) + ")", (not c[0]) and str_starts_with(c[1], want), true)
  return i and k
end

# Both engines run the program to the end and print the same, ending with the
# doc string's lines: for a selftest, whose summary is what the scenario is about.
make a function called st_prog_prints_ending takes ctx returns ok
  let want = step_doc(ctx)
  let a = ctx_get(ctx, "prog_interpreted")
  let c = ctx_get(ctx, "prog_compiled")
  let i = expect(ctx, "interpreted, its output ends as the scenario says (got " + str_trim(a[1]) + ")", a[0] and str_ends_with(a[1], want), true)
  let k = expect(ctx, "compiled, it prints exactly what the interpreter prints", c[0] and (c[1] == a[1]), true)
  return i and k
end

make a function called register_program_steps takes ctx returns done
  step(ctx, "the program", "st_prog_given")
  step(ctx, "it runs interpreted and compiled", "st_prog_run")
  step(ctx, "both print", "st_prog_prints")
  step(ctx, "both stop, saying", "st_prog_stops")
  step(ctx, "both print, before stopping", "st_prog_prints_before_stopping")
  step(ctx, "both print the same, ending", "st_prog_prints_ending")
  return true
end
