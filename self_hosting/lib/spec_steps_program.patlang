# Steps for a scenario that carries its program (review, test-suite
# recommendation 2: the scenario's text is the test). The program is the Given's
# doc string, the When runs it on both engines, and the Then's doc string is
# what each must print:
#
#   Scenario: ...
#     Given the program
#       """
#       print(1 + 1)
#       """
#     When it runs interpreted and compiled
#     Then both print
#       """
#       2
#       """
#
# The program goes in spec_out(), one file a scenario, named from a counter.
include "gherkin.patlang"
include "v2_engines.patlang"
include "program_run.patlang"

make a function called st_prog_given takes ctx returns ok
  let n = 1
  if ctx_has(ctx, "prog_count") then
    let n = ctx_get(ctx, "prog_count") + 1
  end
  ctx_set(ctx, "prog_count", n)
  let path = spec_out() + "/scenario_program_" + n + ".patlang"
  write_file(path, step_doc(ctx))
  ctx_set(ctx, "prog_path", path)
  return expect(ctx, "the scenario carries a program", step_doc(ctx) != "", true)
end

make a function called st_prog_run takes ctx returns ok
  let path = ctx_get(ctx, "prog_path")
  ctx_set(ctx, "prog_interpreted", run_interpreted(path))
  ctx_set(ctx, "prog_compiled", run_compiled(path, path + ".exe"))
  return true
end

make a function called st_prog_prints takes ctx returns ok
  let want = step_doc(ctx)
  let a = ctx_get(ctx, "prog_interpreted")
  let c = ctx_get(ctx, "prog_compiled")
  let i = expect(ctx, "interpreted, it prints what the scenario says (got " + str_trim(a[1]) + ")", a[0] and printed(a[1], want), true)
  let k = expect(ctx, "compiled, it prints what the scenario says (got " + str_trim(c[1]) + ")", c[0] and printed(c[1], want), true)
  return i and k
end

make a function called register_program_steps takes ctx returns done
  step(ctx, "the program", "st_prog_given")
  step(ctx, "it runs interpreted and compiled", "st_prog_run")
  step(ctx, "both print", "st_prog_prints")
  return true
end
