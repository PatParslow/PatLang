# Issue #49: step registrations for spec_library/language/symbolic_*.feature, the
# symbolic expression and interval library (lib/symbolic.patlang). Given and When
# only name what the Then step builds and checks.
include "symbolic.patlang"

make a function called st_sym_noop takes ctx returns ok
  return true
end

make a function called sym_x2_minus_2 returns e
  return sym_sub(sym_pow(sym_var("x"), sym_const(2)), sym_const(2))
end

# Whether an interval has exactly these endpoints.
make a function called sym_is_exactly takes ctx, label, iv, lo, hi returns ok
  let a = expect(ctx, label + ": lo", sym_ival_lo(iv) == lo, true)
  let b = expect(ctx, label + ": hi", sym_ival_hi(iv) == hi, true)
  return a and b
end

# Whether an interval holds a value, and is no wider than a few units in the last place.
make a function called sym_brackets takes ctx, label, iv, v returns ok
  let lo = sym_ival_lo(iv) * 1.0
  let hi = sym_ival_hi(iv) * 1.0
  let a = expect(ctx, label + ": holds " + v, (lo <= v) and (v <= hi), true)
  let b = expect(ctx, label + ": narrow", (hi - lo) < 0.00000000001, true)
  return a and b
end

make a function called st_sym_const takes ctx returns ok
  return sym_is_exactly(ctx, "sym_const(2)", sym_eval_interval(sym_const(2), []), 2, 2)
end

make a function called st_sym_rational takes ctx returns ok
  let iv = sym_eval_interval(sym_div(sym_const(10), sym_const(3)), [])
  let a = sym_is_exactly(ctx, "10/3", iv, 10 / 3, 10 / 3)
  let b = expect(ctx, "10/3 stays rational", numeric_kind(sym_ival_lo(iv)), "rational")
  return a and b
end

make a function called st_sym_sqrt takes ctx returns ok
  let iv = sym_eval_interval(sym_sqrt(sym_const(2)), [])
  let a = expect(ctx, "lo", sym_ival_lo(iv) * 1.0, 1.414213562373095)
  let b = expect(ctx, "hi", sym_ival_hi(iv) * 1.0, 1.4142135623730951)
  return a and b
end

make a function called st_sym_mul_positive takes ctx returns ok
  return sym_is_exactly(ctx, "[1,2]*[3,4]", sym_interval_mul(sym_interval(1, 2), sym_interval(3, 4)), 3, 8)
end

make a function called st_sym_mul_sign_flip takes ctx returns ok
  return sym_is_exactly(ctx, "[-2,3]*[-1,4]", sym_interval_mul(sym_interval(0 - 2, 3), sym_interval(0 - 1, 4)), 0 - 8, 12)
end

make a function called st_sym_deriv_sum takes ctx returns ok
  let e = sym_add(sym_pow(sym_var("x"), sym_const(2)), sym_const(5))
  return sym_is_exactly(ctx, "d(x^2+5) at 3", sym_eval_interval(sym_derivative(e, "x"), [["x", sym_interval(3, 3)]]), 6, 6)
end

make a function called st_sym_deriv_product takes ctx returns ok
  let e = sym_mul(sym_var("x"), sym_sin(sym_var("x")))
  return sym_is_exactly(ctx, "d(x sin x) at 0", sym_eval_interval(sym_derivative(e, "x"), [["x", sym_interval(0, 0)]]), 0, 0)
end

make a function called st_sym_mono_true takes ctx returns ok
  return expect(ctx, "x^2-2 on [1,2]", sym_is_monotonic(sym_x2_minus_2(), "x", sym_interval(1, 2)), true)
end

make a function called st_sym_mono_false takes ctx returns ok
  return expect(ctx, "x^2-2 on [-1,1]", sym_is_monotonic(sym_x2_minus_2(), "x", sym_interval(0 - 1, 1)), false)
end

make a function called st_sym_linear takes ctx returns ok
  let e = sym_add(sym_mul(sym_const(2), sym_var("x")), sym_const(4))
  return expect(ctx, "2x+4=0", sym_solve_for(e, "x", sym_no_range()), ["Solutions", [["Const", 0 - 2]]])
end

make a function called st_sym_quadratic_two takes ctx returns ok
  let sol = sym_solve_for(sym_x2_minus_2(), "x", sym_no_range())
  let a = expect(ctx, "two solutions", list_len(sol[1]), 2)
  let root = sqrt(2)
  let b = sym_brackets(ctx, "first root", sym_eval_interval(sol[1][0], []), root)
  let c = sym_brackets(ctx, "second root", sym_eval_interval(sol[1][1], []), 0 - root)
  return a and b and c
end

make a function called st_sym_quadratic_repeated takes ctx returns ok
  let e = sym_add(sym_sub(sym_pow(sym_var("x"), sym_const(2)), sym_mul(sym_const(4), sym_var("x"))), sym_const(4))
  return expect(ctx, "(x-2)^2=0", sym_solve_for(e, "x", sym_no_range()), ["Solutions", [["Const", 2]]])
end

make a function called st_sym_quadratic_complex takes ctx returns ok
  let e = sym_add(sym_pow(sym_var("x"), sym_const(2)), sym_const(1))
  let sol = sym_solve_for(e, "x", sym_no_range())
  let a = expect(ctx, "two solutions", list_len(sol[1]), 2)
  let b = expect(ctx, "the first is complex", numeric_kind(sol[1][0]), "complex")
  let c = expect(ctx, "the second is complex", numeric_kind(sol[1][1]), "complex")
  return a and b and c
end

make a function called st_sym_family_shape takes ctx returns ok
  let sol = sym_solve_for(sym_sin(sym_var("x")), "x", sym_no_range())
  let a = expect(ctx, "a family", sol[0], "Family")
  let b = expect(ctx, "over n", sol[2], "n")
  let c = expect(ctx, "in the integers", sol[3], ["Integers"])
  return a and b and c
end

make a function called st_sym_family_values takes ctx returns ok
  let pi = acos(0 - 1)
  let sol = sym_solve_for(sym_sin(sym_var("x")), "x", sym_no_range())
  let a = sym_brackets(ctx, "n=0", sym_eval_family_at(sol, 0), 0.0)
  let b = sym_brackets(ctx, "n=1", sym_eval_family_at(sol, 1), pi)
  let c = sym_brackets(ctx, "n=-1", sym_eval_family_at(sol, 0 - 1), 0 - pi)
  return a and b and c
end

make a function called st_sym_family_cos takes ctx returns ok
  let pi = acos(0 - 1)
  let sol = sym_solve_for(sym_sub(sym_cos(sym_var("x")), sym_const(1)), "x", sym_no_range())
  let a = sym_brackets(ctx, "n=-1", sym_eval_family_at(sol, 0 - 1), 0 - 2 * pi)
  let b = sym_brackets(ctx, "n=0", sym_eval_family_at(sol, 0), 0.0)
  let c = sym_brackets(ctx, "n=1", sym_eval_family_at(sol, 1), 2 * pi)
  return a and b and c
end

make a function called st_sym_mat_filter takes ctx returns ok
  let sol = sym_solve_for(sym_x2_minus_2(), "x", sym_no_range())
  let out = sym_materialize(sol, sym_interval(0, 10))
  let a = expect(ctx, "one root in [0,10]", list_len(out), 1)
  let b = sym_brackets(ctx, "it is the positive root", out[0], sqrt(2))
  return a and b
end

make a function called st_sym_mat_family takes ctx returns ok
  let pi = acos(0 - 1)
  let sol = sym_solve_for(sym_sin(sym_var("x")), "x", sym_no_range())
  let out = sym_materialize(sol, sym_interval(0 - 1, 7))
  let a = expect(ctx, "three members in [-1,7]", list_len(out), 3)
  let b = sym_brackets(ctx, "0", out[0], 0.0)
  let c = sym_brackets(ctx, "pi", out[1], pi)
  let d = sym_brackets(ctx, "2 pi", out[2], 2 * pi)
  return a and b and c and d
end

make a function called st_sym_no_range_error takes ctx returns ok
  let e = sym_add(sym_var("x"), sym_sin(sym_var("x")))
  return expect(ctx, "no form and no range is an error", sym_solve_for(e, "x", sym_no_range())[0], "Error")
end

make a function called st_sym_numeric_fallback takes ctx returns ok
  let e = sym_add(sym_var("x"), sym_sin(sym_var("x")))
  let sol = sym_solve_for(e, "x", sym_interval(0 - 10, 10))
  let a = expect(ctx, "solutions", sol[0], "Solutions")
  let b = expect(ctx, "one root", list_len(sol[1]), 1)
  let c = expect(ctx, "a bracket", sol[1][0][0], "Interval")
  let d = sym_brackets(ctx, "around 0", sol[1][0], 0.0)
  return a and b and c and d
end

make a function called register_language_symbolic_steps takes ctx returns done
  step(ctx, "sym_const(2)", "st_sym_noop")
  step(ctx, "sym_eval_interval is called with no bindings", "st_sym_noop")
  step(ctx, "sym_div(sym_const(10), sym_const(3)) -- 10/3, which the Numeric Tower already keeps as an exact Rational rather than a lossy float", "st_sym_noop")
  step(ctx, "sym_eval_interval is called", "st_sym_noop")
  step(ctx, "sym_sqrt(sym_const(2))", "st_sym_noop")
  step(ctx, "A = Interval(1, 2) and B = Interval(3, 4)", "st_sym_noop")
  step(ctx, "sym_interval_mul(A, B) is called", "st_sym_noop")
  step(ctx, "A = Interval(-2, 3) and B = Interval(-1, 4)", "st_sym_noop")
  step(ctx, "the result is Interval(2, 2) -- lo and hi identical, since a literal constant carries no uncertainty", "st_sym_const")
  step(ctx, "the result is Interval(10/3, 10/3) -- still zero-width, because the Tower's own Rational is exact, not an approximation needing enclosure", "st_sym_rational")
  step(ctx, "the result is Interval(1.414213562373095, 1.4142135623730951) -- the same one-ULP-wide bracket already hand-verified by direct bisection on interval-arithmetic.html, confirming sym_eval_interval's sqrt enclosure and the page's own worked example agree", "st_sym_sqrt")
  step(ctx, "the result is Interval(3, 8)", "st_sym_mul_positive")
  step(ctx, "the result is Interval(-8, 12) -- the minimum comes from (-2)*4, not from any same-position endpoint pairing", "st_sym_mul_sign_flip")
  step(ctx, "sym_add(sym_pow(sym_var(\"x\"), sym_const(2)), sym_const(5)) -- x^2 + 5", "st_sym_noop")
  step(ctx, "sym_derivative is called with respect to \"x\", then evaluated at x=3", "st_sym_noop")
  step(ctx, "sym_mul(sym_var(\"x\"), sym_sin(sym_var(\"x\"))) -- x * sin(x)", "st_sym_noop")
  step(ctx, "sym_derivative is called with respect to \"x\", then evaluated at x=0", "st_sym_noop")
  step(ctx, "f(x) = x^2 - 2 and its derivative 2x", "st_sym_noop")
  step(ctx, "sym_is_monotonic is called with interval Interval(1, 2)", "st_sym_noop")
  step(ctx, "sym_is_monotonic is called with interval Interval(-1, 1)", "st_sym_noop")
  step(ctx, "the result is Interval(6, 6) -- d/dx(x^2+5) = 2x, and 2*3 = 6", "st_sym_deriv_sum")
  step(ctx, "the result is Interval(0, 0) -- sin(x) + x*cos(x) at x=0 is 0 + 0 = 0, distinguishing this", "st_sym_deriv_product")
  step(ctx, "the result is true -- the derivative's own interval evaluates to Interval(2, 4), which does", "st_sym_mono_true")
  step(ctx, "the result is false -- the derivative's own interval evaluates to Interval(-2, 2), which", "st_sym_mono_false")
  step(ctx, "sym_solve_for is called on 2*x + 4 = 0 for variable \"x\"", "st_sym_noop")
  step(ctx, "sym_solve_for is called on x^2 - 2 for variable \"x\" -- discriminant of x^2 + 0x - 2 is", "st_sym_noop")
  step(ctx, "sym_solve_for is called on x^2 - 4*x + 4 for variable \"x\" -- (x-2)^2, discriminant", "st_sym_noop")
  step(ctx, "sym_solve_for is called on x^2 + 1 for variable \"x\" -- discriminant 0 - 4 = -4, negative", "st_sym_noop")
  step(ctx, "the result is Solutions([-2]) -- one exact Const, not an interval, since the coefficients", "st_sym_linear")
  step(ctx, "the result is Solutions([...]) with exactly 2 elements, evaluating via sym_eval_interval to", "st_sym_quadratic_two")
  step(ctx, "the result is Solutions([2]) -- a list with exactly ONE element, not two, confirming the", "st_sym_quadratic_repeated")
  step(ctx, "the result is Solutions([...]) with exactly 2 elements, both of numeric_kind \"complex\" -- i", "st_sym_quadratic_complex")
  step(ctx, "sym_solve_for is called on sym_sin(sym_var(\"x\")) for variable \"x\" with no bounded range", "st_sym_noop")
  step(ctx, "the Family returned above", "st_sym_noop")
  step(ctx, "its generator expression is evaluated at n = 0, n = 1, and n = -1", "st_sym_noop")
  step(ctx, "sym_solve_for is called on sym_sub(sym_cos(sym_var(\"x\")), sym_const(1)) for variable \"x\"", "st_sym_noop")
  step(ctx, "the result is a Family, not a Solutions list -- shape [\"Family\", generator_expr_in_n, \"n\",", "st_sym_family_shape")
  step(ctx, "the results are 0, pi, and -pi -- the (-1)^n * asin(c) + n*pi form collapsing correctly for", "st_sym_family_values")
  step(ctx, "the family's generator, evaluated at successive integer n, produces exactly", "st_sym_family_cos")
  step(ctx, "the quadratic Solutions([-1.41..., 1.41...]) from x^2-2=0", "st_sym_noop")
  step(ctx, "sym_materialize is called with range Interval(0, 10)", "st_sym_noop")
  step(ctx, "the sin(x)=0 Family from symbolic_periodic_solve.feature", "st_sym_noop")
  step(ctx, "sym_materialize is called with range Interval(-1, 7) -- roughly -0.3*pi to 2.2*pi", "st_sym_noop")
  step(ctx, "sym_solve_for is called on sym_add(sym_var(\"x\"), sym_sin(sym_var(\"x\"))) for variable \"x\" --", "st_sym_noop")
  step(ctx, "called WITHOUT a bounded range", "st_sym_noop")
  step(ctx, "the same x + sin(x) = 0 equation, called WITH range Interval(-10, 10)", "st_sym_noop")
  step(ctx, "the result is a list with exactly 1 element -- only the positive root falls inside [0,10]", "st_sym_mat_filter")
  step(ctx, "the result is a list with exactly 3 elements: 0, pi, 2*pi -- generated by walking n outward", "st_sym_mat_family")
  step(ctx, "it is an error -- the numeric fallback has no formula to fall back on for \"all\" solutions, so", "st_sym_no_range_error")
  step(ctx, "the result is Solutions([...]) containing exactly 1 element, a one-ULP-wide Interval", "st_sym_numeric_fallback")
  return true
end
