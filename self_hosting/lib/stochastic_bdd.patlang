# =============================================================================
# Stochastic BDD verification. Exact-match BDD (a single Given/Then
# assertion) can't verify a probabilistic rule -- "this event happens
# 30% of the time" isn't something one trial can confirm or refute. This
# module runs many trials and asserts the EMPIRICAL frequency falls
# within a statistically reasonable tolerance band of a declared
# probability, using the standard-error-of-a-proportion heuristic
# (sqrt(p*(1-p)/n)) rather than a fixed arbitrary tolerance, so the
# acceptable band narrows automatically as sample size grows -- a
# correct implementation at n=200 and n=20000 both pass; a genuinely
# wrong probability fails at both, just more decisively at the larger n.
#
# Deliberately separate from the induction engine (synth5/7/8/10/11/
# etc.): this doesn't induce a probability from data, it verifies a
# HAND-AUTHORED implementation's declared probability against its own
# actual runtime behavior. The probability value itself is still a
# human decision (per the project's original scope for fantpop-patlang
# -- see D:\Projects_Organized\04-Worldbuilding-Games\fantpop-patlang\
# README.md), just checked, not derived. This module also has no
# dependency on rule_add/solve or any of the subprocess-isolation
# machinery the induction modules need -- trials just call ordinary
# PatLang code directly, in-process, since there's no hypothesis-vs-
# hypothesis contamination risk to isolate against here.
#
# PatLang has no RNG host function (see self_hosting/examples/
# cga_classifier.patlang's own note) -- this module doesn't provide one
# either; callers supply their own trial outcomes (however they were
# generated -- a hand-rolled LCG, a compiled program's real output,
# whatever) as a plain success count out of n trials.
#
# Depends on lib/test.patlang's `check` for stochastic_check -- include
# that first if using it.
# =============================================================================

make a function called stochastic_std_error takes p, n returns se
  return sqrt((p * (1 - p)) / to_num(n))
end

# True if the observed success rate over n trials is within k standard
# errors of the expected probability p. k=3 is a reasonable default
# (~99.7% confidence under the normal approximation to a binomial) --
# strict enough to catch a genuinely wrong probability, loose enough not
# to flake on a correctly-implemented one.
make a function called stochastic_within_tolerance takes successes, n, expected_p, k returns ok
  let observed_p = to_num(successes) / to_num(n)
  let se = stochastic_std_error(expected_p, n)
  let diff = observed_p - expected_p
  if diff < 0 then
    let diff = 0 - diff
  end
  return diff <= (k * se)
end

# check()-style assertion (from lib/test.patlang) reporting the observed
# rate alongside the expected one, so a failure is diagnosable at a
# glance rather than a bare pass/fail.
make a function called stochastic_check takes label, successes, n, expected_p, k returns ok
  let observed_p = to_num(successes) / to_num(n)
  let ok = stochastic_within_tolerance(successes, n, expected_p, k)
  let msg = label + " (observed " + successes + "/" + n + " = " + observed_p + ", expected " + expected_p + ", k=" + k + ")"
  return check(msg, ok, true)
end
