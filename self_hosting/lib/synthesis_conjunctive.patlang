# =============================================================================
# Milestone 3 of the BDD-driven inductive synthesis system (see plan
# "wondering-about-extending-patlang-modular-shore"). Milestone 2's search
# was still a fixed template (one base predicate, one chain predicate).
# This module generalizes the BODY shape itself: given a pool of candidate
# background unary predicates, it searches CONJUNCTIONS of them --
#   target(X) :- P1(X), P2(X), ..., Pk(X).
# -- for the smallest conjunction that proves every positive example and
# fails every negative one. "Smallest" matters: a distractor predicate
# that happens to be true of every positive example but isn't actually
# required must NOT survive in the induced rule -- that's the parsimony
# property this milestone specifically tests, the conjunctive-body
# analogue of milestone 1's "branch count, not example count".
#
# Reuses milestone 2's query/hypothesis-testing machinery
# (self_hosting/lib/synthesis_recursive.patlang's synth2_query/
# synth2_test_hypothesis) unchanged -- subprocess-per-hypothesis isolation
# still applies for the same reason (rule_add/RULES has no PatLang-
# exposed removal API), just with a different clause-body generator.
#
# Milestone 9: originally tested subsets one subprocess spawn at a time,
# smallest-first, stopping at the first success -- worst case (nothing
# smaller works) still meant up to 2^n spawns. synth3_induce_conjunction
# now batches EVERY non-empty subset into a single subprocess via
# synth9_batch_test_hypotheses (synthesis_batch.patlang), each under its
# own uniquely-renamed head predicate, and picks the smallest PASSING one
# from the results -- same Occam's-razor guarantee, one process spawn
# instead of up to 2^n.
# =============================================================================

include "synthesis_batch.patlang"

make a function called synth3_list_tail takes xs returns tail
  let out = []
  let i = 1
  let n = to_num(list_len(xs))
  while i < n do
    let out = list_push(out, xs[i])
    let i = i + 1
  end
  return out
end

# All subsets of preds, as a list of lists (includes the empty subset).
make a function called synth3_all_subsets takes preds returns subsets
  if to_num(list_len(preds)) == 0 then
    return [[]]
  end
  let first = preds[0]
  let rest = synth3_list_tail(preds)
  let rest_subsets = synth3_all_subsets(rest)
  let result = []
  let i = 0
  let n = to_num(list_len(rest_subsets))
  while i < n do
    let result = list_push(result, rest_subsets[i])
    let i = i + 1
  end
  let j = 0
  while j < n do
    let result = list_push(result, list_push(rest_subsets[j], first))
    let j = j + 1
  end
  return result
end

# Build `rule target(X) :- P1(X), P2(X), ...Pk(X).` for a (non-empty)
# conjunction of unary background predicates.
make a function called synth3_clauses_for takes target_pred, subset returns src
  let sb = sb_new()
  sb_push(sb, "rule " + target_pred + "(X) :- ")
  let i = 0
  let n = to_num(list_len(subset))
  while i < n do
    if i > 0 then
      sb_push(sb, ", ")
    end
    sb_push(sb, subset[i] + "(X)")
    let i = i + 1
  end
  sb_push(sb, ".\n")
  return sb_str(sb)
end

# Stable ascending sort by subset size -- small n (candidate_preds is
# never large in practice), so a plain O(n^2) insertion sort is plenty.
make a function called synth3_sort_by_size takes subsets returns sorted
  let sorted = []
  let i = 0
  let n = to_num(list_len(subsets))
  while i < n do
    let item = subsets[i]
    let item_len = to_num(list_len(item))
    let sn = to_num(list_len(sorted))
    let insert_at = sn
    let j = 0
    let placed = false
    while (j < sn) and (not placed) do
      if item_len < to_num(list_len(sorted[j])) then
        let insert_at = j
        let placed = true
      end
      let j = j + 1
    end
    let new_sorted = []
    let k = 0
    while k < insert_at do
      let new_sorted = list_push(new_sorted, sorted[k])
      let k = k + 1
    end
    let new_sorted = list_push(new_sorted, item)
    while k < sn do
      let new_sorted = list_push(new_sorted, sorted[k])
      let k = k + 1
    end
    let sorted = new_sorted
    let i = i + 1
  end
  return sorted
end

# Batch-test every non-empty conjunction in ONE subprocess spawn, sorted
# smallest-first, and return the smallest one that passed (Occam's
# razor: a distractor predicate that's merely correlated with the
# positive examples -- true of all of them, but not actually load-
# bearing -- never survives once a smaller conjunction is found that
# already separates the examples). Returns [] if nothing in the search
# space fits.
make a function called synth3_induce_conjunction takes target_pred, candidate_preds, background_src, queries returns winner
  let subsets = synth3_all_subsets(candidate_preds)
  let non_empty = []
  let i = 0
  let n = to_num(list_len(subsets))
  while i < n do
    if to_num(list_len(subsets[i])) > 0 then
      let non_empty = list_push(non_empty, subsets[i])
    end
    let i = i + 1
  end
  let sorted = synth3_sort_by_size(non_empty)
  let sn = to_num(list_len(sorted))
  let batch = []
  let bi = 0
  while bi < sn do
    let subset = sorted[bi]
    let label_pred = target_pred + "__s" + to_str_i(bi)
    let clause_src = synth3_clauses_for(label_pred, subset)
    let batch = list_push(batch, [to_str_i(bi), clause_src, synth9_remap_queries(queries, label_pred)])
    let bi = bi + 1
  end
  let results = synth9_batch_test_hypotheses(background_src, batch)
  let ri = 0
  while ri < sn do
    if results[ri] then
      return sorted[ri]
    end
    let ri = ri + 1
  end
  return []
end
