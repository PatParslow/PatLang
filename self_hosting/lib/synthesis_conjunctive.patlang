# =============================================================================
# Milestone 3 of the BDD-driven inductive synthesis system (see plan
# "wondering-about-extending-patlang-modular-shore"). Milestone 2's search
# was still a fixed template (one base predicate, one chain predicate).
# This module generalizes the BODY shape itself: given a pool of candidate
# background unary predicates, it searches CONJUNCTIONS of them --
#   target(X) :- P1(X), P2(X), ..., Pk(X).
# -- for the smallest conjunction that proves every positive example and
# fails every negative one. "Smallest" matters: a distractor predicate
# that happens to be true of every positive example but isn't actually
# required must NOT survive in the induced rule -- that's the parsimony
# property this milestone specifically tests, the conjunctive-body
# analogue of milestone 1's "branch count, not example count".
#
# Reuses milestone 2's query/hypothesis-testing machinery
# (self_hosting/lib/synthesis_recursive.patlang's synth2_query/
# synth2_test_hypothesis) unchanged -- subprocess-per-hypothesis isolation
# still applies for the same reason (rule_add/RULES has no PatLang-
# exposed removal API), just with a different clause-body generator.
# =============================================================================

include "synthesis_recursive.patlang"

make a function called synth3_list_tail takes xs returns tail
  let out = []
  let i = 1
  let n = to_num(list_len(xs))
  while i < n do
    let out = list_push(out, xs[i])
    let i = i + 1
  end
  return out
end

# All subsets of preds, as a list of lists (includes the empty subset).
make a function called synth3_all_subsets takes preds returns subsets
  if to_num(list_len(preds)) == 0 then
    return [[]]
  end
  let first = preds[0]
  let rest = synth3_list_tail(preds)
  let rest_subsets = synth3_all_subsets(rest)
  let result = []
  let i = 0
  let n = to_num(list_len(rest_subsets))
  while i < n do
    let result = list_push(result, rest_subsets[i])
    let i = i + 1
  end
  let j = 0
  while j < n do
    let result = list_push(result, list_push(rest_subsets[j], first))
    let j = j + 1
  end
  return result
end

# Build `rule target(X) :- P1(X), P2(X), ...Pk(X).` for a (non-empty)
# conjunction of unary background predicates.
make a function called synth3_clauses_for takes target_pred, subset returns src
  let sb = sb_new()
  sb_push(sb, "rule " + target_pred + "(X) :- ")
  let i = 0
  let n = to_num(list_len(subset))
  while i < n do
    if i > 0 then
      sb_push(sb, ", ")
    end
    sb_push(sb, subset[i] + "(X)")
    let i = i + 1
  end
  sb_push(sb, ".\n")
  return sb_str(sb)
end

# Search conjunctions in increasing size order (Occam's razor: the
# smallest separating conjunction wins, so a distractor predicate that's
# merely correlated with the positive examples -- true of all of them,
# but not actually load-bearing -- never survives once a smaller
# conjunction is found that already separates the examples). Returns the
# winning subset, or [] if nothing in the search space fits.
make a function called synth3_induce_conjunction takes target_pred, candidate_preds, background_src, queries returns winner
  let subsets = synth3_all_subsets(candidate_preds)
  let n_candidates = to_num(list_len(candidate_preds))
  let size = 1
  while size <= n_candidates do
    let i = 0
    let n = to_num(list_len(subsets))
    while i < n do
      let subset = subsets[i]
      if to_num(list_len(subset)) == size then
        let clause_src = synth3_clauses_for(target_pred, subset)
        if synth2_test_hypothesis(background_src, clause_src, queries) then
          return subset
        end
      end
      let i = i + 1
    end
    let size = size + 1
  end
  return []
end
