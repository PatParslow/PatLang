# =============================================================================
# Test framework (Stage 1 dialect): unit assertions plus a Gherkin-style
# feature runner. Step definitions are registered in the object store keyed
# by their text; features are plain text dispatched line by line, so the
# same framework covers unit, integration, and behaviour tests.
# =============================================================================

# run_feature hands `require`/`ensure` steps to handle_contract_step, which
# lives in gherkin_contracts.patlang.
include "gherkin_contracts.patlang"

# Parametrised steps: a step registered with {placeholders} matches any line of
# that shape (step_match.patlang) and reads its captures through step_arg().
include "step_match.patlang"

# block_model_compat.patlang's own get_global/set_global/handler_*: this
# file's own ambient set_var/get(__vars,...) calls, and its own
# new("Dict"/"Step", ...)-based exact-step registry, are ported onto
# these (real functions, transparent under the Block Ownership Model's
# own block-model engine, which always intercepts these exact names
# earlier by a hardcoded match -- see that file's own header) so this
# file lowers under block-model too, found needed while re-attempting
# Phase 18's own zs_schema.patlang checkpoint one level further out
# (this framework is what actually RUNS that checkpoint's own selftest
# suite). Observably IDENTICAL for the real engine either way --
# get_global/set_global are thin wrappers over the exact same set_var/
# get calls this file always made.
include "block_model_compat.patlang"

make a function called t_init returns done
  set_global("t_pass", 0)
  set_global("t_fail", 0)
  set_global("t_tagfilter", "")
  set_global("t_pending_tags", "")
  set_global("t_skipping", 0)
  return true
end

make a function called contains_text takes hay, needle returns r
  if needle.length > hay.length then
    return false
  end
  let i = 0
  while i <= hay.length - needle.length do
    if substr(hay, i, needle.length) == needle then
      return true
    end
    let i = i + 1
  end
  return false
end

make a function called check takes label, actual, expected returns ok
  if actual == expected then
    set_global("t_pass", get_global("t_pass") + 1)
    print("  ok: " + label)
    return true
  else
    set_global("t_fail", get_global("t_fail") + 1)
    print("  FAIL: " + label + " (got " + actual + ", want " + expected + ")")
    return false
  end
end

make a function called t_report returns ok
  let p = get_global("t_pass")
  let f = get_global("t_fail")
  print("tests: " + p + " passed, " + f + " failed")
  if f == 0 then
    print("ALL TESTS PASSED")
    return true
  else
    print("TESTS FAILED")
    return false
  end
end

# ---- Gherkin runner ----

# Register a step: step("a fresh till", "st_fresh_till")
# A text containing {name} placeholders is registered as a pattern; anything
# else is an exact-text step, looked up first at dispatch.
make a function called step takes text, fname returns done
  if contains_text(text, "{") then
    return t_register_pattern_step(text, fname)
  end
  # Was new("Step", text) + send(text, "set", "fn", fname) -- the real
  # engine's own name-registry object system, one real object per exact
  # step text (like Step's own new("Step", text) convention this file's
  # own original header already named). Ported to a single shared
  # Handler-based registry instead (the same "ephemeral majority" fix
  # zs_registry() already got), keyed by the step's own text -- see this
  # file's own header for why (block-model's own `new(...)` genuinely
  # cannot run this form at all).
  let existing = get_global("t_exact_steps")
  if type_of(existing) != "list" then
    let existing = handler_new()
  end
  set_global("t_exact_steps", handler_register(existing, text, fname))
  return true
end

make a function called t_register_pattern_step takes text, fname returns done
  let pats = get_global("t_step_patterns")
  if type_of(pats) != "list" then
    let pats = []
  end
  let out = []
  let replaced = false
  let i = 0
  let n = to_num(list_len(pats))
  while i < n do
    if pats[i][0] == text then
      let out = list_push(out, [text, fname])
      let replaced = true
    else
      let out = list_push(out, pats[i])
    end
    let i = i + 1
  end
  if replaced == false then
    let out = list_push(out, [text, fname])
  end
  set_global("t_step_patterns", out)
  return true
end

# First registered pattern that matches wins: ["ok", captures, fname] or ["no"].
make a function called t_match_pattern_step takes text returns result
  let pats = get_global("t_step_patterns")
  if type_of(pats) != "list" then
    return ["no"]
  end
  let i = 0
  let n = to_num(list_len(pats))
  while i < n do
    let m = sm_match(pats[i][0], text)
    if m[0] == "ok" then
      return ["ok", m[1], pats[i][1]]
    end
    let i = i + 1
  end
  return ["no"]
end

# The text captured by {name} in the step currently being dispatched.
make a function called step_arg takes name returns value
  let caps = get_global("t_step_args")
  if type_of(caps) != "list" then
    return ""
  end
  let i = 0
  let n = to_num(list_len(caps))
  while i < n do
    if caps[i][0] == name then
      return caps[i][1]
    end
    let i = i + 1
  end
  return ""
end

make a function called starts_with takes s, prefix returns r
  if s.length < prefix.length then
    return false
  end
  return substr(s, 0, prefix.length) == prefix
end

make a function called trim_left takes s returns out
  let i = 0
  let scanning = true
  while (i < s.length) and scanning do
    let c = char_code(s, i)
    if (c == 32) or (c == 9) then
      let i = i + 1
    else
      let scanning = false
    end
  end
  return substr(s, i, s.length - i)
end

# Strip a Gherkin keyword; returns the step text or "" if not a step line
make a function called step_text takes line returns out
  if starts_with(line, "Given ") then
    return substr(line, 6, line.length - 6)
  end
  if starts_with(line, "When ") then
    return substr(line, 5, line.length - 5)
  end
  if starts_with(line, "Then ") then
    return substr(line, 5, line.length - 5)
  end
  if starts_with(line, "And ") then
    return substr(line, 4, line.length - 4)
  end
  return ""
end

# Run only scenarios whose preceding @tag line contains `tag` ("" = all)
make a function called run_feature_tagged takes feature, tag returns ok
  set_global("t_tagfilter", tag)
  return run_feature(feature)
end

make a function called run_feature_file takes path returns ok
  return run_feature(read_file(path))
end

make a function called run_feature takes feature returns ok
  let h = str_intern(feature)
  let n = sc_len(h)
  let i = 0
  let line = sb_new()
  while i <= n do
    let c = sc_code(h, i)
    if (c == 10) or (c == -1) then
      let raw = trim_left(sb_str(line))
      let line = sb_new()
      if starts_with(raw, "@") then
        set_global("t_pending_tags", raw)
      end
      if starts_with(raw, "Feature:") then
        print(raw)
      end
      if starts_with(raw, "Scenario:") then
        let filter = get_global("t_tagfilter")
        let tags = get_global("t_pending_tags")
        set_global("t_pending_tags", "")
        if filter then
          if tags then
            if contains_text(tags, filter) then
              set_global("t_skipping", 0)
              print(raw + "  [" + tags + "]")
            else
              set_global("t_skipping", 1)
              print(raw + "  [skipped: needs " + filter + "]")
            end
          else
            set_global("t_skipping", 1)
            print(raw + "  [skipped: needs " + filter + "]")
          end
        else
          set_global("t_skipping", 0)
          print(raw)
        end
      else
        let text = step_text(raw)
        if (text != "") and (get_global("t_skipping") != 1) then
          if starts_with(text, "require ") then
            handle_contract_step("require", substr(text, 8, text.length - 8))
          else
            if starts_with(text, "ensure ") then
              handle_contract_step("ensure", substr(text, 7, text.length - 7))
            else
              # Was get(text, "fn") -- see step()'s own header for why
              # this reads through the shared t_exact_steps Handler now.
              let fname = handler_lookup(get_global("t_exact_steps"), text)
              if fname then
                apply(fname)
              else
                let pm = t_match_pattern_step(text)
                if pm[0] == "ok" then
                  set_global("t_step_args", pm[1])
                  apply(pm[2])
                else
                  set_global("t_fail", get_global("t_fail") + 1)
                  print("  FAIL: undefined step: " + text)
                end
              end
            end
          end
        end
      end
      let i = i + 1
    else
      if c == 13 then
        let i = i + 1
      else
        sb_push(line, sc_char(h, i))
        let i = i + 1
      end
    end
  end
  return true
end
