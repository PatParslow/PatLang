# PatLang -> Triton GPU kernel plumbing.
#
# SLICE 1 (proven): the ARCHITECTURE works end to end using a single
# FIXED, hand-written Triton kernel (elementwise vector add) -- PatLang
# builds a Python/Triton driver script as text, writes it to disk, runs
# it via exec_capture (the same subprocess-and-capture-stdout pattern
# already used elsewhere in this codebase -- patc1.exe shelling out to
# rustc, ScriptCanvas-style JSON-over-stdout hosting), and parses the
# JSON result back into ordinary PatLang values. `triton_vector_add`
# below is that original fixed-kernel path, kept as-is for the Slice 1
# demo/regression test.
#
# SLICE 2 (this file, new): `triton_run_kernel_source` generalizes the
# same plumbing to a REAL lowering pass (lib/lower_triton.patlang) --
# the kernel body is no longer fixed text, it's PatLang source, walked
# and translated into Triton Python. Covers as much of Triton's actual
# model as sensibly maps onto a bounded PatLang function subset:
# arithmetic/comparisons, if/elif, counted while-loops (the shape both
# reductions and matmul's K-loop need), Index-based load/store,
# math-function calls (exp/log/sqrt/sigmoid/abs/max/min), block
# reductions (sum/reduce_max/reduce_min/argmax/argmin), and atomics
# (atomic_add/atomic_max/atomic_min). Still Triton-DSL lowering, not
# direct PTX/CUDA emission -- that's explicitly deferred to a possible
# later, more direct route.
#
# SLICE 3 (this file, new): `triton_run_kernel_source_2d` generalizes
# Slice 2's AST-driven lowering to a real 2D grid (multi-dim
# tl.program_id) -- same kernel-body PatLang, same offs/mask names, only
# the launch geometry changes. `triton_run_matmul` adds matmul via the
# canonical Triton block-pointer kernel shape (tl.make_block_ptr +
# tl.advance + tl.dot) -- generated rather than AST-lowered from PatLang
# source, since matmul's tiled-accumulator-over-K structure is a
# recognized SHAPE (the same "prove the architecture with a fixed kernel
# first" discipline this file's own Slice 1 already used), not yet a
# fully generic block-pointer lowering from arbitrary PatLang.
#
# Requires a real CUDA GPU + PyTorch (CUDA build) + Triton installed
# for the Python interpreter at PYTHON_EXE below -- confirmed present
# and working on this machine (RTX 5070 Ti, torch 2.12.0+cu132, triton
# 3.4.0) via a standalone sanity check before this file was written.

include "json.patlang"
include "lower_triton.patlang"

# True if `src` (kernel SOURCE text, before lowering) calls a reduction
# builtin. A reduction (sum/reduce_max/reduce_min/argmax/argmin) computes
# ONE result over the WHOLE input in a single Triton program -- splitting
# it across multiple grid blocks would make each block compute its own
# PARTIAL reduction and race to overwrite the same output slot (no
# combining/atomic step exists for this shape). Real bug-avoidance found
# while adding real multi-block launches: a reduction kernel MUST stay
# single-block (the whole array as one program, Slice 2's original
# strategy); only elementwise-style kernels (store keyed by `offs`, one
# independent output per input element) are safe to split across blocks.
# Text-level substring scan over the SOURCE (not the lowered Python) --
# matches this file's own tokenize-at-a-different-layer style elsewhere;
# a false positive here (a name that merely contains "sum(" etc as a
# substring) is harmless -- it only means an eligible kernel stays on the
# safe, already-proven single-block path instead of the faster one.
make a function called triton_src_has_reduction takes src returns has_it
  if str_contains(src, "sum(") then
    return true
  elif str_contains(src, "reduce_max(") then
    return true
  elif str_contains(src, "reduce_min(") then
    return true
  elif str_contains(src, "argmax(") then
    return true
  elif str_contains(src, "argmin(") then
    return true
  else
    return false
  end
end

make a function called str_contains takes hay, needle returns found
  let hn = hay.length
  let nn = needle.length
  if nn == 0 then
    return true
  end
  if nn > hn then
    return false
  end
  let i = 0
  while i <= (hn - nn) do
    if substr(hay, i, nn) == needle then
      return true
    end
    let i = i + 1
  end
  return false
end

# NOT top-level `let`s -- confirmed by direct test that a named function
# (`make a function called X`) does NOT close over top-level `let`
# bindings from its defining script at all (only anonymous closure
# LITERALS, `|| { ... }`, do). A genuine, previously-undocumented
# PatLang scoping gotcha, distinct from (though related to) the already-
# known "bare references to named functions lower to a local-variable
# load, only closures produce a real callable value" -- see regex.
# patlang's own header. Zero-arg getter functions, matching the pattern
# already used in fantpop-patlang's sim_max_new_locations_per_year, are
# the safe way to give a named function access to a "constant".
make a function called triton_python_exe returns path
  return "D:/Program Files/Python313/python.exe"
end

make a function called triton_scratch_dir returns dir
  return "F:/PatLang/self_hosting/build"
end

# Builds a JSON array literal string ("[1,2,3]") from a PatLang list of
# numbers -- also valid Python list syntax, which is all this needs
# (embedded directly into a generated driver script as a literal).
make a function called triton_num_list_json takes xs returns s
  let sb = sb_new()
  sb_push(sb, "[")
  let n = to_num(list_len(xs))
  let i = 0
  while i < n do
    if i > 0 then
      sb_push(sb, ",")
    end
    sb_push(sb, "" + xs[i])
    let i = i + 1
  end
  sb_push(sb, "]")
  return sb_str(sb)
end

# Runs a Triton elementwise vector-add kernel ON THE GPU for two equal-
# length PatLang lists of numbers, returning their elementwise sum as a
# new PatLang list. `a` and `b` must be the same length.
make a function called triton_vector_add takes a, b returns sums
  let n = to_num(list_len(a))
  let a_json = triton_num_list_json(a)
  let b_json = triton_num_list_json(b)
  let script = "import torch\nimport triton\nimport triton.language as tl\nimport json\n\n@triton.jit\ndef add_kernel(x_ptr, y_ptr, out_ptr, n, BLOCK_SIZE: tl.constexpr):\n    pid = tl.program_id(0)\n    offs = pid * BLOCK_SIZE + tl.arange(0, BLOCK_SIZE)\n    mask = offs < n\n    x = tl.load(x_ptr + offs, mask=mask)\n    y = tl.load(y_ptr + offs, mask=mask)\n    tl.store(out_ptr + offs, x + y, mask=mask)\n\nx = torch.tensor(" + a_json + ", device='cuda', dtype=torch.float32)\ny = torch.tensor(" + b_json + ", device='cuda', dtype=torch.float32)\nout = torch.empty_like(x)\nn = " + n + "\nBLOCK_SIZE = triton.next_power_of_2(n)\ngrid = (triton.cdiv(n, BLOCK_SIZE),)\nadd_kernel[grid](x, y, out, n, BLOCK_SIZE=BLOCK_SIZE)\nprint(json.dumps(out.cpu().tolist()))\n"
  let script_path = triton_scratch_dir() + "/_triton_vector_add.py"
  write_file(script_path, script)
  let out = exec_capture(triton_python_exe(), script_path)
  let parsed = json_parse(out)
  let items = json_arr(parsed)
  let result = []
  let m = to_num(list_len(items))
  let i = 0
  while i < m do
    let result = list_push(result, json_num(items[i]))
    let i = i + 1
  end
  return result
end

# SLICE 2: runs a REAL lowered kernel. `kernel_src` is the PatLang source
# text of a single `make a function called ... end` kernel body (params
# are the device buffers, e.g. `takes x, y`). `inputs` is a list of
# PatLang number-lists, one per kernel param, all equal length; the
# result is the kernel's `out` buffer (the last param is reserved as the
# output buffer by convention -- e.g. `takes x, y, out`). Returns
# [result_list, status] where status is ["Ok",""] or ["Err", message] --
# a rejection from the lowerer surfaces here, not as a crash.
make a function called triton_run_kernel_source takes kernel_src, kernel_name, inputs returns r
  let lowered = triton_lower_kernel_source(kernel_src, kernel_name)
  if lowered[1][0] == "Err" then
    return [[], lowered[1]]
  end
  let kernel_py = lowered[0]
  let nInputs = to_num(list_len(inputs))
  if nInputs == 0 then
    return [[], ["Err", "triton_run_kernel_source needs at least one input buffer"]]
  end
  let n = to_num(list_len(inputs[0]))
  let sb = sb_new()
  sb_push(sb, "import torch\nimport triton\nimport triton.language as tl\nimport json\n\n")
  sb_push(sb, kernel_py)
  sb_push(sb, "\n")
  let argNames = []
  let i = 0
  while i < nInputs do
    let varName = "buf" + i
    sb_push(sb, varName + " = torch.tensor(" + triton_num_list_json(inputs[i]) + ", device='cuda', dtype=torch.float32)\n")
    let argNames = list_push(argNames, varName)
    let i = i + 1
  end
  sb_push(sb, "n = " + n + "\n")
  if triton_src_has_reduction(kernel_src) then
    sb_push(sb, "BLOCK_SIZE = triton.next_power_of_2(n)\n")
  else
    sb_push(sb, "BLOCK_SIZE = 1024\n")
  end
  sb_push(sb, "grid = (triton.cdiv(n, BLOCK_SIZE),)\n")
  sb_push(sb, kernel_name + "[grid](")
  let j = 0
  while j < nInputs do
    sb_push(sb, argNames[j] + ", ")
    let j = j + 1
  end
  sb_push(sb, "n, BLOCK_SIZE=BLOCK_SIZE)\n")
  let outVar = argNames[nInputs - 1]
  sb_push(sb, "print(json.dumps(" + outVar + ".cpu().tolist()))\n")
  let script = sb_str(sb)
  let script_path = triton_scratch_dir() + "/_triton_run_kernel.py"
  write_file(script_path, script)
  let out = exec_capture(triton_python_exe(), script_path)
  let parsed = json_parse(out)
  let items = json_arr(parsed)
  let result = []
  let m = to_num(list_len(items))
  let k = 0
  while k < m do
    let result = list_push(result, json_num(items[k]))
    let k = k + 1
  end
  return [result, ["Ok", ""]]
end

# Autotune variant of triton_run_kernel_source: `block_candidates` is a
# list of BLOCK_SIZE values (e.g. [256, 512, 1024, 2048]) Triton will
# actually BENCHMARK at first launch, picking the fastest for this input
# size -- BLOCK_SIZE is deliberately NOT passed at the call site (the
# @triton.autotune wrapper supplies it internally once it's chosen), and
# `grid` is a lambda over Triton's own `meta` dict rather than a fixed
# tuple, since the grid size depends on whichever BLOCK_SIZE ends up
# selected. Rejected outright for reduction kernels by
# triton_lower_kernel_source_autotune itself (unsafe to vary block size
# there, see its own header) -- this driver just surfaces that rejection.
make a function called triton_run_kernel_source_autotune takes kernel_src, kernel_name, inputs, block_candidates returns r
  let lowered = triton_lower_kernel_source_autotune(kernel_src, kernel_name, block_candidates)
  if lowered[1][0] == "Err" then
    return [[], lowered[1]]
  end
  let kernel_py = lowered[0]
  let nInputs = to_num(list_len(inputs))
  if nInputs == 0 then
    return [[], ["Err", "triton_run_kernel_source_autotune needs at least one input buffer"]]
  end
  let n = to_num(list_len(inputs[0]))
  let sb = sb_new()
  sb_push(sb, "import torch\nimport triton\nimport triton.language as tl\nimport json\n\n")
  sb_push(sb, kernel_py)
  sb_push(sb, "\n")
  let argNames = []
  let i = 0
  while i < nInputs do
    let varName = "buf" + i
    sb_push(sb, varName + " = torch.tensor(" + triton_num_list_json(inputs[i]) + ", device='cuda', dtype=torch.float32)\n")
    let argNames = list_push(argNames, varName)
    let i = i + 1
  end
  sb_push(sb, "n = " + n + "\n")
  sb_push(sb, "grid = lambda meta: (triton.cdiv(n, meta['BLOCK_SIZE']),)\n")
  sb_push(sb, kernel_name + "[grid](")
  let j = 0
  while j < nInputs do
    sb_push(sb, argNames[j] + ", ")
    let j = j + 1
  end
  sb_push(sb, "n)\n")
  let outVar = argNames[nInputs - 1]
  sb_push(sb, "print(json.dumps(" + outVar + ".cpu().tolist()))\n")
  let script = sb_str(sb)
  let script_path = triton_scratch_dir() + "/_triton_run_kernel_autotune.py"
  write_file(script_path, script)
  let out = exec_capture(triton_python_exe(), script_path)
  let parsed = json_parse(out)
  let items = json_arr(parsed)
  let result = []
  let m = to_num(list_len(items))
  let k = 0
  while k < m do
    let result = list_push(result, json_num(items[k]))
    let k = k + 1
  end
  return [result, ["Ok", ""]]
end

# AST-driven counterpart to triton_run_matmul: `kernel_src` is real
# PatLang source using the block-pointer primitives (see
# triton_lower_kernel_source_matmul's own header for the exact shape
# expected -- `takes a, b, c`, two inputs one output), lowered via
# lib/lower_triton.patlang instead of the fixed hand-generated kernel.
# `a`/`b` are flattened row-major number-lists (a: M*K, b: K*N); returns
# C (M*N, row-major) as [result, status].
make a function called triton_run_matmul_from_source takes kernel_src, kernel_name, a, b, m, k, n, block_m, block_n, block_k returns r
  let lowered = triton_lower_kernel_source_matmul(kernel_src, kernel_name)
  if lowered[1][0] == "Err" then
    return [[], lowered[1]]
  end
  let kernel_py = lowered[0]
  let mm = to_num(m)
  let kk = to_num(k)
  let nn = to_num(n)
  let bm = to_num(block_m)
  let bn = to_num(block_n)
  let bk = to_num(block_k)
  let sb = sb_new()
  sb_push(sb, "import torch\nimport triton\nimport triton.language as tl\nimport json\n\n")
  sb_push(sb, kernel_py)
  sb_push(sb, "\n")
  sb_push(sb, "a = torch.tensor(" + triton_num_list_json(a) + ", device='cuda', dtype=torch.float32).reshape(" + mm + ", " + kk + ")\n")
  sb_push(sb, "b = torch.tensor(" + triton_num_list_json(b) + ", device='cuda', dtype=torch.float32).reshape(" + kk + ", " + nn + ")\n")
  sb_push(sb, "c = torch.empty((" + mm + ", " + nn + "), device='cuda', dtype=torch.float32)\n")
  sb_push(sb, "M, K, N = " + mm + ", " + kk + ", " + nn + "\n")
  sb_push(sb, "BLOCK_M, BLOCK_N, BLOCK_K = " + bm + ", " + bn + ", " + bk + "\n")
  sb_push(sb, "grid = (triton.cdiv(M, BLOCK_M), triton.cdiv(N, BLOCK_N))\n")
  sb_push(sb, kernel_name + "[grid](a, b, c, M, N, K, BLOCK_M=BLOCK_M, BLOCK_N=BLOCK_N, BLOCK_K=BLOCK_K)\n")
  sb_push(sb, "print(json.dumps(c.cpu().flatten().tolist()))\n")
  let script = sb_str(sb)
  let script_path = triton_scratch_dir() + "/_triton_matmul_from_source.py"
  write_file(script_path, script)
  let out = exec_capture(triton_python_exe(), script_path)
  let parsed = json_parse(out)
  let items = json_arr(parsed)
  let result = []
  let total = to_num(list_len(items))
  let idx = 0
  while idx < total do
    let result = list_push(result, json_num(items[idx]))
    let idx = idx + 1
  end
  return [result, ["Ok", ""]]
end

# Timed variant of triton_run_kernel_source: runs the SAME lowered kernel
# `reps` times inside ONE spawned Python process, isolating real kernel
# compute time from the fixed per-spawn cost (script write + process
# start + torch/triton import) that dominated the Mandelbrot demo's
# single-call timing ([[patlang-triton-lowering-mandelbrot-timing-demo]]:
# ~2.2s end-to-end for a kernel that's a tiny fraction of that). One
# warmup call (pays Triton's JIT-compile cost, excluded from the timed
# region) precedes `reps` synchronized launches; returns
# [result, total_kernel_ms, per_call_ms, status] -- total_kernel_ms/
# per_call_ms are ONLY the `reps` launches+syncs, still not counting
# process/import startup (that's still real, still paid once per
# exec_capture call -- this isolates the OTHER number, not eliminates
# this one). Same reduction-aware block/grid strategy as
# triton_run_kernel_source (see triton_src_has_reduction).
make a function called triton_run_kernel_source_timed takes kernel_src, kernel_name, inputs, reps returns r
  let lowered = triton_lower_kernel_source(kernel_src, kernel_name)
  if lowered[1][0] == "Err" then
    return [[], 0.0, 0.0, lowered[1]]
  end
  let kernel_py = lowered[0]
  let nInputs = to_num(list_len(inputs))
  if nInputs == 0 then
    return [[], 0.0, 0.0, ["Err", "triton_run_kernel_source_timed needs at least one input buffer"]]
  end
  let n = to_num(list_len(inputs[0]))
  let sb = sb_new()
  sb_push(sb, "import torch\nimport triton\nimport triton.language as tl\nimport json\nimport time\n\n")
  sb_push(sb, kernel_py)
  sb_push(sb, "\n")
  let argNames = []
  let i = 0
  while i < nInputs do
    let varName = "buf" + i
    sb_push(sb, varName + " = torch.tensor(" + triton_num_list_json(inputs[i]) + ", device='cuda', dtype=torch.float32)\n")
    let argNames = list_push(argNames, varName)
    let i = i + 1
  end
  sb_push(sb, "n = " + n + "\n")
  if triton_src_has_reduction(kernel_src) then
    sb_push(sb, "BLOCK_SIZE = triton.next_power_of_2(n)\n")
  else
    sb_push(sb, "BLOCK_SIZE = 1024\n")
  end
  sb_push(sb, "grid = (triton.cdiv(n, BLOCK_SIZE),)\n")
  let launchExpr = kernel_name + "[grid]("
  let j = 0
  while j < nInputs do
    let launchExpr = launchExpr + argNames[j] + ", "
    let j = j + 1
  end
  let launchExpr = launchExpr + "n, BLOCK_SIZE=BLOCK_SIZE)"
  sb_push(sb, launchExpr + "\n")
  sb_push(sb, "torch.cuda.synchronize()\n")
  sb_push(sb, "reps = " + to_num(reps) + "\n")
  sb_push(sb, "t0 = time.perf_counter()\n")
  sb_push(sb, "for _rep in range(reps):\n")
  sb_push(sb, "    " + launchExpr + "\n")
  sb_push(sb, "torch.cuda.synchronize()\n")
  sb_push(sb, "t1 = time.perf_counter()\n")
  let outVar = argNames[nInputs - 1]
  sb_push(sb, "print(json.dumps({\"result\": " + outVar + ".cpu().tolist(), \"total_ms\": (t1 - t0) * 1000.0, \"per_call_ms\": (t1 - t0) * 1000.0 / reps}))\n")
  let script = sb_str(sb)
  let script_path = triton_scratch_dir() + "/_triton_run_kernel_timed.py"
  write_file(script_path, script)
  let out = exec_capture(triton_python_exe(), script_path)
  let parsed = json_parse(out)
  let items = json_arr(json_get(parsed, "result"))
  let result = []
  let m = to_num(list_len(items))
  let k = 0
  while k < m do
    let result = list_push(result, json_num(items[k]))
    let k = k + 1
  end
  let total_ms = json_num(json_get(parsed, "total_ms"))
  let per_call_ms = json_num(json_get(parsed, "per_call_ms"))
  return [result, total_ms, per_call_ms, ["Ok", ""]]
end

# SLICE 3a: multi-dim-grid variant of triton_run_kernel_source. `inputs`
# are flattened row-major number-lists, all `rows * cols` long (e.g. a 2D
# elementwise add over two matrices); result is the last buffer, same
# flattened shape. Launches a real 2D grid (pid_r, pid_c) rather than the
# 1D (pid,) grid Slice 2 used -- the kernel body itself is unchanged
# PatLang (same offs/mask names), only the launch geometry differs.
make a function called triton_run_kernel_source_2d takes kernel_src, kernel_name, rows, cols, inputs returns r
  let lowered = triton_lower_kernel_source_2d(kernel_src, kernel_name)
  if lowered[1][0] == "Err" then
    return [[], lowered[1]]
  end
  let kernel_py = lowered[0]
  let nInputs = to_num(list_len(inputs))
  if nInputs == 0 then
    return [[], ["Err", "triton_run_kernel_source_2d needs at least one input buffer"]]
  end
  let sb = sb_new()
  sb_push(sb, "import torch\nimport triton\nimport triton.language as tl\nimport json\n\n")
  sb_push(sb, kernel_py)
  sb_push(sb, "\n")
  let argNames = []
  let i = 0
  while i < nInputs do
    let varName = "buf" + i
    sb_push(sb, varName + " = torch.tensor(" + triton_num_list_json(inputs[i]) + ", device='cuda', dtype=torch.float32)\n")
    let argNames = list_push(argNames, varName)
    let i = i + 1
  end
  sb_push(sb, "n_rows = " + to_num(rows) + "\n")
  sb_push(sb, "n_cols = " + to_num(cols) + "\n")
  if triton_src_has_reduction(kernel_src) then
    sb_push(sb, "BLOCK_R = triton.next_power_of_2(n_rows)\n")
    sb_push(sb, "BLOCK_C = triton.next_power_of_2(n_cols)\n")
  else
    sb_push(sb, "BLOCK_R = 32\n")
    sb_push(sb, "BLOCK_C = 32\n")
  end
  sb_push(sb, "grid = (triton.cdiv(n_rows, BLOCK_R), triton.cdiv(n_cols, BLOCK_C))\n")
  sb_push(sb, kernel_name + "[grid](")
  let j = 0
  while j < nInputs do
    sb_push(sb, argNames[j] + ", ")
    let j = j + 1
  end
  sb_push(sb, "n_rows, n_cols, BLOCK_R=BLOCK_R, BLOCK_C=BLOCK_C)\n")
  let outVar = argNames[nInputs - 1]
  sb_push(sb, "print(json.dumps(" + outVar + ".cpu().tolist()))\n")
  let script = sb_str(sb)
  let script_path = triton_scratch_dir() + "/_triton_run_kernel_2d.py"
  write_file(script_path, script)
  let out = exec_capture(triton_python_exe(), script_path)
  let parsed = json_parse(out)
  let items = json_arr(parsed)
  let result = []
  let m = to_num(list_len(items))
  let k = 0
  while k < m do
    let result = list_push(result, json_num(items[k]))
    let k = k + 1
  end
  return [result, ["Ok", ""]]
end

# SLICE 3b: matmul via the canonical block-pointer kernel
# (lib/lower_triton.patlang's triton_matmul_kernel_source). `a`/`b` are
# flattened row-major number-lists (a: M*K, b: K*N); returns C (M*N,
# row-major) as [result, status].
make a function called triton_run_matmul takes a, b, m, k, n returns r
  let mm = to_num(m)
  let kk = to_num(k)
  let nn = to_num(n)
  let block_m = 16
  let block_n = 16
  let block_k = 16
  let kernel_py = triton_matmul_kernel_source("matmul_kernel", mm, nn, kk, block_m, block_n, block_k)
  let sb = sb_new()
  sb_push(sb, "import torch\nimport triton\nimport triton.language as tl\nimport json\n\n")
  sb_push(sb, kernel_py)
  sb_push(sb, "\n")
  sb_push(sb, "a = torch.tensor(" + triton_num_list_json(a) + ", device='cuda', dtype=torch.float32).reshape(" + mm + ", " + kk + ")\n")
  sb_push(sb, "b = torch.tensor(" + triton_num_list_json(b) + ", device='cuda', dtype=torch.float32).reshape(" + kk + ", " + nn + ")\n")
  sb_push(sb, "c = torch.empty((" + mm + ", " + nn + "), device='cuda', dtype=torch.float32)\n")
  sb_push(sb, "M, K, N = " + mm + ", " + kk + ", " + nn + "\n")
  sb_push(sb, "BLOCK_M, BLOCK_N, BLOCK_K = " + block_m + ", " + block_n + ", " + block_k + "\n")
  sb_push(sb, "grid = (triton.cdiv(M, BLOCK_M), triton.cdiv(N, BLOCK_N))\n")
  sb_push(sb, "matmul_kernel[grid](a, b, c, M, N, K, BLOCK_M=BLOCK_M, BLOCK_N=BLOCK_N, BLOCK_K=BLOCK_K)\n")
  sb_push(sb, "print(json.dumps(c.cpu().flatten().tolist()))\n")
  let script = sb_str(sb)
  let script_path = triton_scratch_dir() + "/_triton_matmul.py"
  write_file(script_path, script)
  let out = exec_capture(triton_python_exe(), script_path)
  let parsed = json_parse(out)
  let items = json_arr(parsed)
  let result = []
  let total = to_num(list_len(items))
  let idx = 0
  while idx < total do
    let result = list_push(result, json_num(items[idx]))
    let idx = idx + 1
  end
  return [result, ["Ok", ""]]
end
