# The v2 engines the spec suites run programs on, none of them pat --ir-run.
# The compiler is the native v2 compiler that self_hosting/v2/tools/gates.sh
# builds, and the interpreter is v2's own, built by that compiler. Paths are
# from the repository's root.

make a function called v2_compiler returns path
  return "self_hosting/build/v2.exe"
end

# The interpreter for the system this program runs on: a program built with
# --linux and run under WSL starts the Linux build (the gates unit
# interpreter_linux), whose ports and processes are on the same side as its
# own; the Windows one, started through WSL's interop, listens where a Linux
# program cannot reach it.
make a function called v2_interpreter returns path
  if os_target() == "linux" then
    return "self_hosting/build/v2_interp_linux"
  end
  return "self_hosting/build/v2_interp.exe"
end

# Where a suite run writes what it makes (the executables it builds, the files
# it writes): PATLANG_SPEC_OUT, which the gates give each run a directory of
# its own in so that runs at the same time never share a file
# (docs/plans/gates.md), else self_hosting/build. It is made if missing.
make a function called spec_out returns dir
  let dir = "" + getenv("PATLANG_SPEC_OUT")
  if dir == "" then
    let dir = "self_hosting/build"
  end
  # made here, so a step that writes into it, or has another program write
  # there, works when its scenario runs alone (programs.feature's DNS
  # responder could not write its port file to a directory not yet made)
  make_directory(dir)
  return dir
end

# The v2 compiler run with args: [what it wrote to its output and its error
# stream, whether it exited 0].
make a function called v2_compile takes args returns r
  let res = exec_capture_io(v2_compiler(), args, "", 0)
  return [res[0] + res[1], res[2]]
end

# src run on the v2 interpreter: what it wrote to both outputs.
make a function called v2_interp_run takes src returns out
  return exec_capture(v2_interpreter(), src)
end

# src compiled by v2 into exe and run: what it wrote to both outputs, or the
# compiler's output when it did not build.
make a function called v2_native_run takes src, exe returns out
  let built = v2_compile([src, exe])
  if not built[1] then
    return built[0]
  end
  return exec_capture(exe)
end

# ---- Linux, through WSL (Ubuntu-24.04), for the --linux target ----

# A Windows path as WSL sees it: D:/x/y is /mnt/d/x/y.
make a function called v2_wsl_path takes p returns q
  let a = path_absolute(p)
  let c = char_code(a, 0)
  if (c >= 65) and (c <= 90) then
    let c = c + 32
  end
  return "/mnt/" + chr(c) + substr(a, 2, a.length - 2)
end

# A Linux executable run under WSL with args: [its output, whether it exited 0].
make a function called v2_linux_run takes exe, args returns r
  return v2_linux_run_from(["-d", "Ubuntu-24.04", "-e", v2_wsl_path(exe)], args)
end

# The same, with the program and everything it starts loaded at fixed addresses
# (setarch -R, inherited by children): for comparing two runs' peak memory. With
# randomised addresses a fixture's peak resident set varies by about 15% from run
# to run on the same input (2712 to 3104 KB over 12 runs); with fixed addresses
# the 12 runs gave the same figure.
make a function called v2_linux_run_unrandomised takes exe, args returns r
  return v2_linux_run_from(["-d", "Ubuntu-24.04", "-e", "setarch", "-R", v2_wsl_path(exe)], args)
end

make a function called v2_linux_run_from takes full, args returns r
  let i = 0
  while i < list_len(args) do
    let full = list_push(full, args[i])
    let i = i + 1
  end
  let res = exec_capture_io("wsl", full, "", 0)
  return [res[0], res[2]]
end

# The arguments as a file the Linux side reads them from, each one's bytes as
# hex on a line of its own: wsl.exe parses its own command line again, so an
# argument holding a space, a quote or a backslash would not arrive whole.
make a function called v2_linux_args_file takes args, path returns p
  let b = sb_new()
  let digits = "0123456789abcdef"
  let i = 0
  while i < list_len(args) do
    let bytes = bytes_from_str(args[i])
    let k = 0
    while k < bytes_len(bytes) do
      sb_push(b, substr(digits, word_shr(bytes[k], 4), 1))
      sb_push(b, substr(digits, word_and(bytes[k], 15), 1))
      let k = k + 1
    end
    sb_push(b, chr(10))
    let i = i + 1
  end
  write_file(path, sb_str(b))
  return path
end
