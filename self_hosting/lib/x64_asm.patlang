include "includes.patlang"

# ---- Self-hosted x86-64 assembler --------------------------------------
#
# Replaces nasm.exe for exactly the NASM-subset text
# self_hosting/lib/codegen_x64.patlang ever emits (see the design plan
# for the full inventory this was scoped against). Deliberately NOT a
# general x86-64 assembler: codegen_x64.patlang's own output interface
# (NASM-syntax text) is kept completely unchanged and untouched -- this
# file parses that same text rather than requiring codegen_x64.patlang
# to emit anything new, so none of its 9,000+ lines of proven,
# heavily-tested instruction-selection logic are put at risk.
#
# Public entry point: x64_assemble_chunk(asm_text) -> ChunkImage, a
# plain tagged list (matching this codebase's own convention elsewhere,
# e.g. AST nodes like ["Call", name, args]):
#
#   ["ChunkImage", text_bytes, data_bytes, bss_size, symbols, relocs, externs]
#
#   text_bytes:  list of int (0-255), the encoded .text section
#   data_bytes:  list of int (0-255), the encoded .data section
#   bss_size:    int, total .bss reservation (alignment-padded)
#   symbols:     list of [name, section, offset, is_global]
#                section in "text"|"data"|"bss"
#   relocs:      list of [section, offset, target_symbol, kind, addend]
#                kind in "REL32" | "RIP32" | "ABS64"
#   externs:     list of name (strings)
#
# Only three relocation kinds exist because codegen_x64.patlang never
# emits SIB/scaled-index addressing (confirmed by direct inspection --
# a code comment there explicitly considered and rejected it): REL32
# (call/jmp/jcc rel32, resolved as target_rva - (reloc_rva + 4)),
# RIP32 ([rel label(+disp)], same formula), ABS64 (dq label -- an
# absolute 8-byte pointer stored in .data).
#
# One real exception to "no SIB needed": x86-64 mandates a SIB byte for
# ANY memory operand whose base register is rsp or r12, even with no
# actual scaled index (rm=100 is the SIB-escape encoding, not just a
# register number) -- codegen_x64.patlang does address off rsp (e.g.
# "word [rsp+34]"), so this one mandatory-but-trivial SIB case (index
# field = 100 meaning "none", scale doesn't matter) IS handled below.
# This is not general SIB support; it's the one case x86-64 itself
# forces regardless of what the assembler wants to support.

# ---- byte-list emission helpers ----

make a function called xa_emit_u8 takes lst, v returns out
  return list_push(lst, v band 255)
end

# Encodes v as `n` little-endian bytes, two's-complement for negatives.
# n<=8 (imm64 is the largest form used anywhere in this codebase).
#
# Deliberately uses ONLY `+`/`-`/`*`/`>=`/`<` -- never `band`/`shr`/`/`/
# `%` -- on `v` itself. This isn't just a BigInt accommodation (an
# earlier version of this function branched on `type_of(v)`, using
# `band`/`shr` for a "plain Int" and a separate safe path only for a
# genuine BigInt): `band`/`shr`, when x64_asm.patlang itself is
# COMPILED (not interpreted), silently misbehave for ANY value outside
# this backend's own internal 48-bit "fast" tagged-int range -- found
# directly via a value as unremarkable as 2^47 (well within i64,
# `type_of` reports plain "int" both interpreted and compiled)
# returning a WRONG `band 255` result (16 instead of the correct 0)
# once compiled, and a considerably larger value (a real float64 bit
# pattern, ~4.6e18) segfaulting outright. `/`/`%` have their own
# separate, already-documented compiled-mode gap for genuine BigInt
# (`os_exit(97)`) plus the Rational-promotion trap below. `+`/`-`/`*`/
# comparisons are the only operators confirmed to behave correctly
# across the FULL range (ordinary Int, an Int outside the 48-bit fast
# range, and genuine BigInt) in both interpreted and compiled code, so
# this function stays entirely within that safe set unconditionally,
# rather than trying to track which specific range each operator does
# or doesn't handle correctly.
#
# Algorithm: bias a negative value into the equivalent non-negative
# two's-complement bit pattern first (via `+`, never `shl`, since `1
# shl 64` is itself out of range for n=8), then peel off each of the
# resulting value's bits from the TOP (bit 63) down via comparison and
# subtraction against a shrinking power of two, placing each set bit
# into the correct output byte. Must go top-down, not byte-by-byte from
# the bottom up: testing a low bit against the ORIGINAL, still-large
# remaining value before any higher bit has been subtracted out is
# meaningless (it compares the whole value against a tiny power of
# two, which is trivially true and proves nothing about that specific
# bit) -- confirmed as a real bug this way, on a value as simple as
# exactly 2^63, which came back as 2^63-1 (every low bit falsely "set")
# before this was restructured as a single top-down pass.
make a function called xa_int_to_bytes_le takes v, n returns bytes
  let powers = [1]
  let k = 0
  while k < 63 do
    let powers = list_push(powers, powers[k] * 2)
    let k = k + 1
  end
  let uv = v
  if uv < 0 then
    let bits = n * 8
    if bits < 64 then
      let uv = v + powers[bits]
    else
      let uv = v + (powers[63] * 2)
    end
  end
  let out = []
  let bi = 0
  while bi < n do
    let out = list_push(out, 0)
    let bi = bi + 1
  end
  # `bit_pos`/`byte_idx`/`bit_in_byte` below are always plain machine
  # ints (0-63/0-7), never BigInt, so ordinary `/`/`%` on THEM (never
  # on `uv`/`remaining` themselves) is safe.
  let remaining = uv
  let bit_pos = 63
  while bit_pos >= 0 do
    let p = powers[bit_pos]
    if remaining >= p then
      let remaining = remaining - p
      let byte_idx = bit_pos / 8
      if byte_idx < n then
        let bit_in_byte = bit_pos % 8
        let out = list_set(out, byte_idx, out[byte_idx] + powers[bit_in_byte])
      end
    end
    let bit_pos = bit_pos - 1
  end
  return out
end

make a function called xa_emit_bytes takes lst, bytes returns out
  let out = lst
  let i = 0
  let n = to_num(list_len(bytes))
  while i < n do
    let out = list_push(out, bytes[i])
    let i = i + 1
  end
  return out
end

make a function called xa_emit_i32 takes lst, v returns out
  return xa_emit_bytes(lst, xa_int_to_bytes_le(v, 4))
end

make a function called xa_emit_i64 takes lst, v returns out
  return xa_emit_bytes(lst, xa_int_to_bytes_le(v, 8))
end

make a function called xa_emit_i16 takes lst, v returns out
  return xa_emit_bytes(lst, xa_int_to_bytes_le(v, 2))
end

# One comma-separated item from a `db`/`dw` data directive: either a
# plain integer literal ("104") or a single-character NASM literal
# ('P') -- codegen_x64.patlang's `dw` UTF-16-ish string literals
# (g_win_class_name/g_win_title, x64_win32_window.patlang's own window-
# title data) are the only real user of the quoted-char form; db never
# emits it (always pre-converted to numeric byte codes), but this
# helper is used by both so a future db-with-char-literals emission
# doesn't need its own copy of this parsing.
make a function called xa_parse_data_item takes item returns v
  if (item.length == 3) and (char_code(item, 0) == 39) and (char_code(item, 2) == 39) then
    return char_code(item, 1)
  end
  return xa_parse_int(item)
end

# ---- register tables ----
#
# One flat table: [name, num, size, is_xmm]. size in 8/16/32/64.
# Built once as a literal rather than a big if/elif chain, then
# scanned -- table lookups over ~70 short-lived entries are not
# remotely a hot path (each program is assembled once).

make a function called xa_reg_table returns table
  return [
    ["al",0,8,false],["cl",1,8,false],["dl",2,8,false],["bl",3,8,false],
    ["spl",4,8,false],["bpl",5,8,false],["sil",6,8,false],["dil",7,8,false],
    ["r8b",8,8,false],["r9b",9,8,false],["r10b",10,8,false],["r11b",11,8,false],
    ["r12b",12,8,false],["r13b",13,8,false],["r14b",14,8,false],["r15b",15,8,false],
    ["ax",0,16,false],["cx",1,16,false],["dx",2,16,false],["bx",3,16,false],
    ["sp",4,16,false],["bp",5,16,false],["si",6,16,false],["di",7,16,false],
    ["r8w",8,16,false],["r9w",9,16,false],["r10w",10,16,false],["r11w",11,16,false],
    ["r12w",12,16,false],["r13w",13,16,false],["r14w",14,16,false],["r15w",15,16,false],
    ["eax",0,32,false],["ecx",1,32,false],["edx",2,32,false],["ebx",3,32,false],
    ["esp",4,32,false],["ebp",5,32,false],["esi",6,32,false],["edi",7,32,false],
    ["r8d",8,32,false],["r9d",9,32,false],["r10d",10,32,false],["r11d",11,32,false],
    ["r12d",12,32,false],["r13d",13,32,false],["r14d",14,32,false],["r15d",15,32,false],
    ["rax",0,64,false],["rcx",1,64,false],["rdx",2,64,false],["rbx",3,64,false],
    ["rsp",4,64,false],["rbp",5,64,false],["rsi",6,64,false],["rdi",7,64,false],
    ["r8",8,64,false],["r9",9,64,false],["r10",10,64,false],["r11",11,64,false],
    ["r12",12,64,false],["r13",13,64,false],["r14",14,64,false],["r15",15,64,false],
    ["xmm0",0,128,true],["xmm1",1,128,true],["xmm2",2,128,true],["xmm3",3,128,true],
    ["xmm4",4,128,true],["xmm5",5,128,true],["xmm6",6,128,true],["xmm7",7,128,true],
    ["xmm8",8,128,true],["xmm9",9,128,true],["xmm10",10,128,true],["xmm11",11,128,true],
    ["xmm12",12,128,true],["xmm13",13,128,true],["xmm14",14,128,true],["xmm15",15,128,true]
  ]
end

# Returns [num, size, is_xmm] or false if `name` is not a register.
make a function called xa_lookup_reg takes name returns info
  let table = xa_reg_table()
  let i = 0
  let n = to_num(list_len(table))
  while i < n do
    let row = table[i]
    if row[0] == name then
      return [row[1], row[2], row[3]]
    end
    let i = i + 1
  end
  return false
end

# ---- tiny string helpers specific to this assembler ----

make a function called xa_is_digit_char takes code returns yes
  return (code >= 48) and (code <= 57)
end

# Parses a decimal integer, optionally signed with a leading '-'.
# Bare wrapper over to_num for readability at call sites.
make a function called xa_parse_int takes s returns v
  return to_num(s)
end

make a function called xa_pow10 takes n returns v
  let v = 1
  let i = 0
  while i < n do
    let v = v * 10
    let i = i + 1
  end
  return v
end

# Parses a decimal string of the form "[-]digits.digits" (always
# containing exactly one '.', per x64_float_literal_text's own
# guarantee -- callers never need to handle a dotless or exponent-
# notation form) into its exact IEEE-754 double bit pattern, entirely
# via integer/BigInt arithmetic -- never materializes an actual
# "Float" value at any point. That's deliberate, not just a style
# choice: this backend's own float_mode is a per-FUNCTION (not
# per-value) static classification, and `to_num` compiled natively
# only accumulates decimal digits (silently ignoring "."), so neither
# "make this function float_mode" nor "call to_num" reliably produces
# a correct float value here at all, let alone its exact bits.
# Staying entirely in Int/BigInt arithmetic sidesteps both problems.
#
# Algorithm: represent the value exactly as numerator/denominator
# (both arbitrary-precision integers, e.g. "3.14" -> 314/100),
# normalize into the form (num/den)*2^e with num/den in [1,2) by
# repeated doubling of whichever side is smaller (never fractional,
# so plain BigInt multiplication suffices), then extract the 52
# fraction bits one at a time via ordinary restoring binary long
# division (double num, compare to den, subtract-and-set-bit or not) --
# deliberately NEVER using `/` or `%` on a BigInt-sized value: this
# backend's own compiled dynamic-dispatch codegen for those two
# operators only handles genuine fixnum operands and hard-exits
# (`os_exit(97)`, the ".MOD_UNSUPPORTED_"/equivalent DIV trap) on a
# real BigInt one, confirmed directly (this function's own scaled
# numerator routinely exceeds 48 bits) -- `*`, `-`, `>=`/`<`, and `+`
# all verified working correctly on BigInt operands when compiled,
# unlike `/`/`%`. Rounds half-UP, not the IEEE-correct half-to-EVEN --
# a deliberate, real simplification: an exact tie at the 53rd bit
# would require the fractional part to be EXACTLY representable in
# exactly 53 bits of binary precision, which essentially never happens
# for a literal a real program would actually write, so this is
# correct for every realistic input without the extra complexity of
# tie-breaking-to-even.
make a function called xa_float_bits_of_string takes s returns bits
  let neg = false
  let i = 0
  if char_code(s, 0) == 45 then
    let neg = true
    let i = 1
  end
  let dot = i
  while char_code(s, dot) != 46 do
    let dot = dot + 1
  end
  let int_part = substr(s, i, dot - i)
  let frac_part = substr(s, dot + 1, s.length - dot - 1)
  let frac_len = frac_part.length
  let num = xa_parse_int(int_part + frac_part)
  let den = xa_pow10(frac_len)

  if num == 0 then
    if neg then
      return 9223372036854775808
    end
    return 0
  end

  let e = 0
  if num >= den then
    while num >= (den * 2) do
      let den = den * 2
      let e = e + 1
    end
  else
    while num < den do
      let num = num * 2
      let e = e - 1
    end
  end

  # num/den is now in [1,2) -- the leading "1" is the implicit bit
  # every normal double's significand already has, so subtract it off
  # once before extracting fraction bits: only the ".something" part
  # (now num/den in [0,1)) is real mantissa content.
  let num = num - den

  # Extract the 52 fraction bits one at a time via restoring binary
  # long division (double num, compare to den: if it fits, that bit
  # is 1 and we subtract; otherwise 0).
  let frac_bits = 0
  let bit_i = 0
  while bit_i < 52 do
    let num = num * 2
    let frac_bits = frac_bits * 2
    if num >= den then
      let num = num - den
      let frac_bits = frac_bits + 1
    end
    let bit_i = bit_i + 1
  end
  # Round half-up using one more bit: double the leftover remainder
  # and compare to den again (equivalent to asking whether the 53rd
  # bit would be >= 1, i.e. the true fraction is at or past halfway
  # between this value and the next representable one).
  let num = num * 2
  if num >= den then
    let frac_bits = frac_bits + 1
  end
  # A round-up carry can push the fraction to exactly 2^52 (e.g.
  # 0.99999...-style rounding) -- renormalize by bumping the exponent.
  if frac_bits >= 4503599627370496 then
    let frac_bits = 0
    let e = e + 1
  end

  let exponent_biased = e + 1023
  let mantissa_bits = frac_bits
  let result = mantissa_bits + (exponent_biased * 4503599627370496)
  if neg then
    let result = result + 9223372036854775808
  end
  return result
end

make a function called xa_looks_like_int takes s returns yes
  if s.length == 0 then
    return false
  end
  let i = 0
  if char_code(s, 0) == 45 then
    let i = 1
  end
  if i >= s.length then
    return false
  end
  while i < s.length do
    if not xa_is_digit_char(char_code(s, i)) then
      return false
    end
    let i = i + 1
  end
  return true
end

# Splits `s` on every top-level occurrence of single-char `sep`.
# Safe for this assembler's comma-separated operand/directive lists
# because codegen_x64.patlang never emits a comma inside `[...]`
# (confirmed: no SIB/scaled-index addressing is ever generated, which
# is the only shape that would need one).
make a function called xa_split_char takes s, sep returns parts
  let out = []
  let start = 0
  let i = 0
  let n = s.length
  while i < n do
    if char_code(s, i) == sep then
      let out = list_push(out, substr(s, start, i - start))
      let start = i + 1
    end
    let i = i + 1
  end
  let out = list_push(out, substr(s, start, n - start))
  return out
end

make a function called xa_strip_comment takes line returns stripped
  let i = 0
  let n = line.length
  while i < n do
    if char_code(line, i) == 59 then
      return substr(line, 0, i)
    end
    let i = i + 1
  end
  return line
end

# ---- operand parsing ----
#
# Returns a tagged operand:
#   ["reg", num, size, is_xmm]
#   ["imm", value]
#   ["mem", base_num, disp, size_hint]        -- size_hint 0 if none given
#   ["relmem", label, disp, size_hint]        -- [rel label(+/-N)]
#   ["label", name]                            -- bare identifier (call/jmp
#                                                  target, or a dq/db value)

# Splits `inner` on every top-level '+' (or '-' not at position 0,
# which starts a negative term) into terms, keeping each term's own
# leading sign character (default '+' for the first term and any term
# whose split point was itself a '+'). E.g. "r12+8+rax" ->
# ["+r12", "+8", "+rax"]; "rbp-16" -> ["+rbp", "-16"].
make a function called xa_split_mem_terms takes inner returns terms
  let terms = []
  let start = 0
  let sign = "+"
  let i = 1
  while i <= inner.length do
    let at_end = i == inner.length
    let c = 0
    if not at_end then
      let c = char_code(inner, i)
    end
    if at_end or (c == 43) or (c == 45) then
      let terms = list_push(terms, sign + str_trim(substr(inner, start, i - start)))
      if not at_end then
        if c == 43 then
          let sign = "+"
        else
          let sign = "-"
        end
        let start = i + 1
      end
    end
    let i = i + 1
  end
  return terms
end

make a function called xa_parse_mem_inner takes inner returns operand
  # inner is whatever was between [ and ], already trimmed, with any
  # leading "rel " already stripped by the caller when present. Forms
  # seen: "reg", "reg+N", "reg-N", "reg+reg" (base+index, no scale --
  # e.g. x64_runtime.patlang's own byte-scan loops' "[r13+r14]"),
  # "reg+N+reg"/"reg+reg+N" (base+disp+index, e.g. "[r12+8+rax]"), and
  # "reg+N+reg*N" (base+disp+scaled-index, e.g. "[rcx+32+r10*8]",
  # array/list-element addressing) -- all found only at real
  # (x64_runtime.patlang) scale, not anticipated by this plan's
  # original addressing-mode inventory. Returns
  # [base_name, index_name_or_false, disp, scale] (scale is 1 when no
  # index, or when an index has no explicit "*N").
  let terms = xa_split_mem_terms(inner)
  let base = substr(terms[0], 1, terms[0].length - 1)
  let index_name = false
  let disp = 0
  let scale = 1
  let ti = 1
  let tn = to_num(list_len(terms))
  while ti < tn do
    let term = terms[ti]
    let term_sign = substr(term, 0, 1)
    let term_body = substr(term, 1, term.length - 1)
    if xa_looks_like_int(term_body) then
      let v = xa_parse_int(term_body)
      if term_sign == "-" then
        let v = 0 - v
      end
      let disp = disp + v
    else
      # A register term, optionally scaled ("reg*N") -- x86-64
      # addressing has no negative index, so a leading '-' here would
      # be meaningless; never emitted in practice (codegen_x64.patlang
      # only ever adds an index).
      let star_idx = -1
      let si = 0
      while si < term_body.length do
        if char_code(term_body, si) == 42 then
          let star_idx = si
          let si = term_body.length
        end
        let si = si + 1
      end
      if star_idx >= 0 then
        let index_name = substr(term_body, 0, star_idx)
        let scale = xa_parse_int(str_trim(substr(term_body, star_idx + 1, term_body.length - star_idx - 1)))
      else
        let index_name = term_body
      end
    end
    let ti = ti + 1
  end
  return [base, index_name, disp, scale]
end

make a function called xa_parse_operand takes raw returns operand
  let s = str_trim(raw)
  let size_hint = 0
  if str_starts_with(s, "byte ") then
    let size_hint = 8
    let s = str_trim(substr(s, 5, s.length - 5))
  else
    if str_starts_with(s, "word ") then
      let size_hint = 16
      let s = str_trim(substr(s, 5, s.length - 5))
    else
      if str_starts_with(s, "dword ") then
        let size_hint = 32
        let s = str_trim(substr(s, 6, s.length - 6))
      else
        if str_starts_with(s, "qword ") then
          let size_hint = 64
          let s = str_trim(substr(s, 6, s.length - 6))
        end
      end
    end
  end

  if str_starts_with(s, "[") then
    let inner = str_trim(substr(s, 1, s.length - 2))
    if str_starts_with(inner, "rel ") then
      let rest = str_trim(substr(inner, 4, inner.length - 4))
      let parsed = xa_parse_mem_inner(rest)
      # `[rel label]` is always RIP-relative to a single symbol -- never
      # base+index -- so parsed[1] (the index name, if any) is ignored.
      return ["relmem", parsed[0], parsed[2], size_hint]
    end
    let parsed = xa_parse_mem_inner(inner)
    let reg = xa_lookup_reg(parsed[0])
    if parsed[1] then
      let idx_reg = xa_lookup_reg(parsed[1])
      return ["mem", reg[0], parsed[2], size_hint, idx_reg[0], parsed[3]]
    end
    return ["mem", reg[0], parsed[2], size_hint]
  end

  if xa_looks_like_int(s) then
    return ["imm", xa_parse_int(s)]
  end

  # A simple unevaluated arithmetic immediate ("0 - 2", "0 - 2147195266")
  # -- NASM evaluates constant expressions itself at assemble time;
  # codegen_x64.patlang relies on that for negation (`0 - N` instead of
  # a literal `-N`) rather than pre-computing it, found only at real
  # scale (x64_runtime.patlang's own tcp_listen error-code handling).
  # Only "A - B" (space-separated, both sides plain digit strings) is
  # needed -- confirmed by grepping the real file for every occurrence
  # of this shape before adding support, not guessed.
  let minus_idx = -1
  let mi = 0
  while mi < s.length do
    if (char_code(s, mi) == 45) and (mi > 0) and (char_code(s, mi - 1) == 32) then
      let minus_idx = mi
      let mi = s.length
    end
    let mi = mi + 1
  end
  if minus_idx >= 0 then
    let lhs = str_trim(substr(s, 0, minus_idx))
    let rhs = str_trim(substr(s, minus_idx + 1, s.length - minus_idx - 1))
    if xa_looks_like_int(lhs) and xa_looks_like_int(rhs) then
      return ["imm", xa_parse_int(lhs) - xa_parse_int(rhs)]
    end
  end

  # NASM's `__float64__(literal)` pseudo-immediate: codegen_x64.patlang
  # emits `mov reg, __float64__(x)` for EVERY float literal Const in
  # ANY compiled program (not just x64_runtime.patlang's own window-
  # title strings -- confirmed by reading the real emission site,
  # x64_emit_func's "is_float_const or contains '.'" branch), to load
  # its raw IEEE-754 bit pattern into a general register. Parsed here
  # via xa_float_bits_of_string, NOT `to_num` + a host `float_to_bits`
  # primitive: this needs to work when x64_asm.patlang ITSELF is
  # compiled (to run inside patc1.exe natively, not just interpreted),
  # and a compiled program has no interpreter to call a host-only
  # primitive back into. `to_num` compiled natively is also, separately,
  # too narrow for this -- confirmed directly: x64_runtime.patlang's
  # own to_num implementation only accumulates decimal DIGITS, silently
  # ignoring the "." entirely (to_num("3.14") compiled == 3, not 3.14).
  if str_starts_with(s, "__float64__(") then
    let inner = substr(s, 12, s.length - 13)
    return ["imm", xa_float_bits_of_string(inner)]
  end

  let reg = xa_lookup_reg(s)
  if reg then
    return ["reg", reg[0], reg[1], reg[2]]
  end

  return ["label", s]
end

# ---- REX / ModRM / SIB encoding ----
#
# rex(w, r, x, b) -- the four REX fields as described in the Intel SDM:
# W=64-bit operand size, R=extension of ModRM.reg, X=extension of
# SIB.index (always 0 here, no SIB index is ever used), B=extension of
# ModRM.rm (or of an opcode+reg encoding, e.g. push/pop).
make a function called xa_rex takes w, r, x, b returns byte
  let v = 64
  if w then
    let v = v + 8
  end
  if r then
    let v = v + 4
  end
  if x then
    let v = v + 2
  end
  if b then
    let v = v + 1
  end
  return v
end

make a function called xa_needs_rex_b takes regnum returns yes
  return regnum >= 8
end

# Encodes a ModRM(+SIB)(+disp) byte sequence for `rm_operand` (a "reg",
# "mem", or "relmem" tagged operand) paired with a `reg_field` register
# number (the instruction's other operand, or a fixed /digit extension
# for single-operand opcodes like `neg`/`inc`). Returns
# [bytes, reloc_or_false] where reloc, if present, is
# [offset_within_bytes, kind, label, addend] -- offset_within_bytes
# locates where the 4-byte disp32/RIP32 placeholder starts, for the
# caller to translate into an absolute reloc once it knows this
# instruction's final position in the chunk.
make a function called xa_encode_modrm takes rm_operand, reg_field returns result
  let tag = rm_operand[0]
  if tag == "reg" then
    let rm_num = rm_operand[1]
    let modrm = 192 + ((reg_field band 7) * 8) + (rm_num band 7)
    return [[modrm], false]
  end
  if tag == "relmem" then
    let label = rm_operand[1]
    let addend = rm_operand[2]
    let modrm = 0 + ((reg_field band 7) * 8) + 5
    let bytes = [modrm, 0, 0, 0, 0]
    return [bytes, [1, "RIP32", label, addend]]
  end
  # tag == "mem": [base_reg (+disp)], or [base_reg+index_reg(*scale)]
  # when a 5th element is present -- a real SIB base+index addressing
  # mode (e.g. x64_runtime.patlang's own byte-scan loops' `[r13+r14]`,
  # or scaled array/list-element addressing like `[rcx+32+r10*8]`,
  # 6th element = scale, defaulting to 1 when absent), found missing
  # entirely (the index register name was silently misparsed as a
  # garbage displacement, defaulting to 0) only at real-scale
  # verification -- none of Phase 1-4's addressing-mode coverage
  # anticipated it (the plan's own scope notes explicitly, and
  # wrongly, assumed no SIB/scaled-index addressing was ever emitted).
  if to_num(list_len(rm_operand)) >= 5 then
    let base_num = rm_operand[1]
    let disp = rm_operand[2]
    let index_num = rm_operand[4]
    let scale = 1
    if to_num(list_len(rm_operand)) >= 6 then
      let scale = rm_operand[5]
    end
    let scale_bits = 0
    if scale == 2 then
      let scale_bits = 1
    end
    if scale == 4 then
      let scale_bits = 2
    end
    if scale == 8 then
      let scale_bits = 3
    end
    let base_low = base_num band 7
    let index_low = index_num band 7
    let sib = (scale_bits * 64) + (index_low * 8) + base_low
    if (disp == 0) and (base_low != 5) then
      let modrm = 0 + ((reg_field band 7) * 8) + 4
      return [[modrm, sib], false]
    end
    let modrm = 128 + ((reg_field band 7) * 8) + 4
    let disp_bytes = xa_int_to_bytes_le(disp, 4)
    return [xa_emit_bytes([modrm, sib], disp_bytes), false]
  end
  let base_num = rm_operand[1]
  let disp = rm_operand[2]
  let base_low = base_num band 7
  let needs_sib = base_low == 4
  # [rbp]/[r13] with a ZERO displacement can't use mod=00 (that
  # encoding is reserved for RIP-relative addressing when rm=101) --
  # forcing it through the mod=10/disp32 path below (same as any other
  # non-zero displacement, just with disp32=0) is correct and simplest,
  # matching that path's own existing "always disp32, never disp8"
  # simplification. Found missing (previously printed-and-silently-
  # produced-a-wrong-RIP-relative-encoding) only at real-scale
  # (x64_runtime.patlang) verification -- none of Phase 1-4's fixtures
  # happened to spill a local into the very first stack slot below rbp
  # with zero offset.
  if (disp == 0) and (base_low != 5) then
    let modrm = 0 + ((reg_field band 7) * 8) + base_low
    if needs_sib then
      return [[modrm, 36], false]
    end
    return [[modrm], false]
  end
  let modrm = 128 + ((reg_field band 7) * 8) + base_low
  let disp_bytes = xa_int_to_bytes_le(disp, 4)
  if needs_sib then
    return [xa_emit_bytes([modrm, 36], disp_bytes), false]
  end
  return [xa_emit_bytes([modrm], disp_bytes), false]
end

# ---- instruction encoders ----
#
# Every encoder returns [bytes, reloc_or_false] with the same reloc
# shape as xa_encode_modrm (an offset local to `bytes`, resolved to an
# absolute chunk offset by the caller). Two-operand forms follow this
# codebase's own NASM-text convention throughout: `op dst, src`.

make a function called xa_enc_push_pop takes op, reg returns result
  if reg[0] == "imm" then
    # `push 0` (an extra literal argument pushed onto the evaluation
    # stack before a host call, e.g. rt_dynamic_binop's operator-code
    # arg) -- PUSH imm32 (0x68 id, sign-extended to 64-bit), always the
    # 4-byte form for simplicity (matching this codebase's own
    # established "always the wider immediate/displacement form, never
    # the short one" pattern elsewhere). pop never takes an immediate.
    return [xa_emit_bytes([104], xa_int_to_bytes_le(reg[1], 4)), false]
  end
  if reg[0] != "reg" then
    # push/pop r/m64 -- a genuine, real gap: `pop qword [rbp-24]`/
    # `push qword [rbp-16]` (spilling an evaluation-stack value
    # straight to a stack local, x64_runtime.patlang's own overflow-
    # checked "DYN" fast-path arithmetic) were previously silently
    # mis-encoded as a REGISTER push/pop (reg[1] read as a register
    # number when `reg` was actually a "mem" operand whose index-1
    # element is the BASE register number, not itself a valid
    # register to push/pop) -- found only by tracing a real segfault
    # back to this exact miscompilation, not caught by any Phase 1-4
    # fixture (none used a mem-operand push/pop). `push r/m64` is
    # FF /6; `pop r/m64` is 8F /0.
    let ext = 6
    if op == "pop" then
      let ext = 0
    end
    let rex = xa_rex(false, false, xa_needs_rex_x_for_rm(reg), xa_needs_rex_b_for_rm(reg))
    let mm = xa_encode_modrm(reg, ext)
    let opcode = 255
    if op == "pop" then
      let opcode = 143
    end
    return [xa_emit_bytes([rex, opcode], mm[0]), xa_shift_reloc(mm[1], 2)]
  end
  let base = 80
  if op == "pop" then
    let base = 88
  end
  let opcode = base + (reg[1] band 7)
  if xa_needs_rex_b(reg[1]) then
    return [[xa_rex(false, false, false, true), opcode], false]
  end
  return [[opcode], false]
end

# The effective operand size (8/16/32/64) for a mov -- taken from
# whichever operand is a real register (its own size field is
# authoritative), or from the memory operand's own size_hint ("byte "/
# "word "/"dword "/"qword " prefix) when the other side is an
# immediate and there's no register to ask. Defaults to 64 (this
# codebase's overwhelming common case) when neither is available.
# Needed because xa_enc_mov used to hardcode REX.W=true and the 32/64-
# bit opcode forms unconditionally, silently emitting a 64-bit mov's
# machine code for an 8-bit ("mov cl, [mem]", 45 uses) or 32-bit
# ("mov eax, ecx", "mov ecx, 2", 74 uses combined) mov in
# x64_runtime.patlang -- found only at real-scale verification, since
# none of Phase 1-4's fixtures exercised anything but 64-bit registers.
make a function called xa_mov_size takes dst, src returns sz
  if dst[0] == "reg" then
    return dst[2]
  end
  if src[0] == "reg" then
    return src[2]
  end
  if to_num(list_len(dst)) >= 4 then
    if dst[3] != 0 then
      return dst[3]
    end
  end
  return 64
end

make a function called xa_enc_mov takes dst, src returns result
  let sz = xa_mov_size(dst, src)
  if (dst[0] == "reg") and (src[0] == "imm") then
    if sz == 64 then
      let opcode = 184 + (dst[1] band 7)
      let rex = xa_rex(true, false, false, xa_needs_rex_b(dst[1]))
      return [xa_emit_bytes([rex, opcode], xa_int_to_bytes_le(src[1], 8)), false]
    end
    # 8/16/32-bit reg<-imm (B8+r id, imm32 zero-extended to 64 for
    # 32-bit; 16-bit needs a 0x66 operand-size prefix; 8-bit uses B0+r
    # ib instead) -- REX.W always false here (imm64 is the ONLY form
    # that needs it, handled above).
    if sz == 8 then
      let opcode = 176 + (dst[1] band 7)
      let rex = xa_rex(false, false, false, xa_needs_rex_b(dst[1]))
      return [xa_emit_bytes([rex, opcode], xa_int_to_bytes_le(src[1], 1)), false]
    end
    let opcode = 184 + (dst[1] band 7)
    let rex = xa_rex(false, false, false, xa_needs_rex_b(dst[1]))
    if sz == 16 then
      return [xa_emit_bytes([102, rex, opcode], xa_int_to_bytes_le(src[1], 2)), false]
    end
    return [xa_emit_bytes([rex, opcode], xa_int_to_bytes_le(src[1], 4)), false]
  end
  if dst[0] == "reg" then
    # mov reg, r/m  (8B /r, or 8A /r for 8-bit) -- REX.W only for 64-bit;
    # 16-bit needs a leading 0x66 operand-size prefix.
    let opcode = 139
    if sz == 8 then
      let opcode = 138
    end
    let rex = xa_rex(sz == 64, xa_needs_rex_b(dst[1]), xa_needs_rex_x_for_rm(src), xa_needs_rex_b_for_rm(src))
    let mm = xa_encode_modrm(src, dst[1])
    if sz == 16 then
      return [xa_emit_bytes([102, rex, opcode], mm[0]), xa_shift_reloc(mm[1], 3)]
    end
    return [xa_emit_bytes([rex, opcode], mm[0]), xa_shift_reloc(mm[1], 2)]
  end
  if src[0] == "imm" then
    # mov r/m, imm  (C7 /0 for 16/32/64-bit id/iw, sign/zero-extended
    # as appropriate; C6 /0 ib for 8-bit) -- dst is "mem"/"relmem". A
    # RIP-relative disp32 here is followed by a trailing immediate --
    # RIP-relative addressing always means "relative to the address of
    # the NEXT instruction", which is further away once a trailing
    # immediate is present. xa_reloc_rip_trail folds that adjustment
    # into the reloc's own addend rather than teaching the generic
    # RIP32 patch formula (x64_pe_link.patlang) about per-instruction
    # trailing-byte counts.
    let rex = xa_rex(sz == 64, false, xa_needs_rex_x_for_rm(dst), xa_needs_rex_b_for_rm(dst))
    let mm = xa_encode_modrm(dst, 0)
    if sz == 8 then
      return [xa_emit_bytes(xa_emit_bytes([rex, 198], mm[0]), xa_int_to_bytes_le(src[1], 1)), xa_reloc_rip_trail(xa_shift_reloc(mm[1], 2), 1)]
    end
    if sz == 16 then
      return [xa_emit_bytes(xa_emit_bytes([102, rex, 199], mm[0]), xa_int_to_bytes_le(src[1], 2)), xa_reloc_rip_trail(xa_shift_reloc(mm[1], 3), 2)]
    end
    return [xa_emit_bytes(xa_emit_bytes([rex, 199], mm[0]), xa_int_to_bytes_le(src[1], 4)), xa_reloc_rip_trail(xa_shift_reloc(mm[1], 2), 4)]
  end
  # mov r/m, reg  (89 /r, or 88 /r for 8-bit) -- dst is "mem"/"relmem".
  let opcode = 137
  if sz == 8 then
    let opcode = 136
  end
  let rex = xa_rex(sz == 64, xa_needs_rex_b(src[1]), xa_needs_rex_x_for_rm(dst), xa_needs_rex_b_for_rm(dst))
  let mm = xa_encode_modrm(dst, src[1])
  if sz == 16 then
    return [xa_emit_bytes([102, rex, opcode], mm[0]), xa_shift_reloc(mm[1], 3)]
  end
  return [xa_emit_bytes([rex, opcode], mm[0]), xa_shift_reloc(mm[1], 2)]
end

# xa_encode_modrm's reloc offset is relative to the START of mm[0] (the
# modrm+disp bytes alone) -- every caller that prepends prefix bytes
# (REX, opcode, 0F, mandatory SSE prefixes, ...) before mm[0] must shift
# the reloc's recorded offset by however many prefix bytes it added, or
# the linker patches the wrong bytes later.
make a function called xa_shift_reloc takes reloc, extra returns out
  if reloc == false then
    return false
  end
  return [reloc[0] + extra, reloc[1], reloc[2], reloc[3]]
end

# See the comment at xa_enc_mov's "mov [mem], imm" case: a RIP32 reloc
# followed by a trailing immediate needs its addend reduced by however
# many bytes of immediate follow the disp32, since "relative to the
# next instruction" moves further away once there's more instruction
# left after the displacement field. A no-op for anything else
# (REL32 call/jmp targets in this codebase are never followed by a
# trailing immediate).
make a function called xa_reloc_rip_trail takes reloc, trailing_bytes returns out
  if reloc == false then
    return false
  end
  if reloc[1] != "RIP32" then
    return reloc
  end
  return [reloc[0], reloc[1], reloc[2], reloc[3] - trailing_bytes]
end

make a function called xa_needs_rex_b_for_rm takes operand returns yes
  if operand[0] == "reg" then
    return xa_needs_rex_b(operand[1])
  end
  if operand[0] == "mem" then
    return xa_needs_rex_b(operand[1])
  end
  return false
end

# REX.X extends the SIB index field to select r8-r15 -- only relevant
# for a "mem" operand carrying a real index register (the 5th element,
# see xa_parse_operand's own base+index comment). Needed alongside
# xa_needs_rex_b_for_rm (which only ever covers the BASE register)
# wherever a base+index memory operand can appear, or the SIB index
# field silently picks the wrong register (e.g. r14 without REX.X
# reads as rsi) -- a real, previously-nonexistent case now that
# base+index addressing itself exists.
make a function called xa_needs_rex_x_for_rm takes operand returns yes
  if operand[0] == "mem" then
    if to_num(list_len(operand)) >= 5 then
      return xa_needs_rex_b(operand[4])
    end
  end
  return false
end

make a function called xa_enc_lea takes dst, src returns result
  let rex = xa_rex(true, xa_needs_rex_b(dst[1]), false, xa_needs_rex_b_for_rm(src))
  let mm = xa_encode_modrm(src, dst[1])
  return [xa_emit_bytes([rex, 141], mm[0]), xa_shift_reloc(mm[1], 2)]
end

# add/sub/and/or/xor/cmp, all `op dst, src` where dst is reg or mem.
make a function called xa_alu_opcodes takes name returns pair
  # [reg_form_opcode, imm_extension]
  if name == "add" then
    return [1, 0]
  end
  if name == "or" then
    return [9, 1]
  end
  if name == "and" then
    return [33, 4]
  end
  if name == "sub" then
    return [41, 5]
  end
  if name == "xor" then
    return [49, 6]
  end
  if name == "cmp" then
    return [57, 7]
  end
  return [1, 0]
end

make a function called xa_enc_alu takes name, dst, src returns result
  let ops = xa_alu_opcodes(name)
  if src[0] == "imm" then
    let ext = ops[1]
    let v = src[1]
    let rex = xa_rex(true, false, xa_needs_rex_x_for_rm(dst), xa_needs_rex_b_for_rm(dst))
    if (v >= -128) and (v <= 127) then
      let mm = xa_encode_modrm(dst, ext)
      return [xa_emit_bytes(xa_emit_bytes([rex, 131], mm[0]), xa_int_to_bytes_le(v, 1)), xa_reloc_rip_trail(xa_shift_reloc(mm[1], 2), 1)]
    end
    let mm = xa_encode_modrm(dst, ext)
    return [xa_emit_bytes(xa_emit_bytes([rex, 129], mm[0]), xa_int_to_bytes_le(v, 4)), xa_reloc_rip_trail(xa_shift_reloc(mm[1], 2), 4)]
  end
  # reg/reg or reg/mem: `op dst, src` -> encode as opcode /r with
  # dst as the r/m operand and src's register number as the reg field
  # (opcode+1 selects the "r/m, reg" -> actually reversed; see note).
  # ops[0] here is the "Eb/Ev, Gb/Gv" (dst=r/m, src=reg) form's opcode,
  # which is what every alu reg,reg / mem,reg case in this codebase's
  # emitted text needs (dst is never a bare label/imm-only target).
  let rex = xa_rex(true, xa_needs_rex_b_for_rm(src), xa_needs_rex_x_for_rm(dst), xa_needs_rex_b_for_rm(dst))
  let mm = xa_encode_modrm(dst, src[1])
  return [xa_emit_bytes([rex, ops[0]], mm[0]), xa_shift_reloc(mm[1], 2)]
end

make a function called xa_enc_imul takes dst, src returns result
  let rex = xa_rex(true, xa_needs_rex_b(dst[1]), false, xa_needs_rex_b_for_rm(src))
  let mm = xa_encode_modrm(src, dst[1])
  return [xa_emit_bytes([rex, 15, 175], mm[0]), xa_shift_reloc(mm[1], 3)]
end

make a function called xa_enc_test takes a, b returns result
  let rex = xa_rex(true, xa_needs_rex_b_for_rm(b), false, xa_needs_rex_b_for_rm(a))
  let mm = xa_encode_modrm(a, b[1])
  return [xa_emit_bytes([rex, 133], mm[0]), xa_shift_reloc(mm[1], 2)]
end

make a function called xa_enc_unary takes ext, operand returns result
  # inc/dec (FF /0, /1), neg/not (F7 /3, /2), single-operand imul
  # (F7 /5: RDX:RAX := RAX * r/m64) -- all r/m64, group-5-or-group-3
  # opcode extensions distinguished only by which FF/F7 opcode byte
  # each ext value needs.
  let opcode = 255
  if (ext == 3) or (ext == 2) or (ext == 5) then
    let opcode = 247
  end
  let rex = xa_rex(true, false, false, xa_needs_rex_b_for_rm(operand))
  let mm = xa_encode_modrm(operand, ext)
  return [xa_emit_bytes([rex, opcode], mm[0]), xa_shift_reloc(mm[1], 2)]
end

make a function called xa_enc_shift_imm takes ext, dst, amount returns result
  let rex = xa_rex(true, false, false, xa_needs_rex_b_for_rm(dst))
  let mm = xa_encode_modrm(dst, ext)
  return [xa_emit_bytes(xa_emit_bytes([rex, 193], mm[0]), [amount band 255]), xa_reloc_rip_trail(xa_shift_reloc(mm[1], 2), 1)]
end

make a function called xa_shift_ext takes name returns ext
  if name == "shl" then
    return 4
  end
  if name == "shr" then
    return 5
  end
  return 7
end

make a function called xa_enc_setcc takes name returns result
  # Always `setcc al` in this codebase's emitted text -- no REX needed
  # (al is register 0, no extension, and al never collides with the
  # spl/bpl/sil/dil low-byte-needs-REX ambiguity since those are never
  # the target here).
  let op = 148
  if name == "setne" then
    let op = 149
  else
    if name == "setl" then
      let op = 156
    else
      if name == "setg" then
        let op = 159
      else
        if name == "setle" then
          let op = 158
        else
          if name == "setge" then
            let op = 157
          else
            if name == "seta" then
              let op = 151
            else
              if name == "setae" then
                let op = 147
              else
                if name == "setb" then
                  let op = 146
                else
                  if name == "setbe" then
                    let op = 150
                  end
                end
              end
            end
          end
        end
      end
    end
  end
  return [[15, op, 192], false]
end

# Source-operand size for movzx: a "reg" operand carries its size at
# index 2 (["reg", num, size, is_xmm]); a "mem"/"relmem" operand's
# index 2 is its displacement, NOT a size -- the explicit byte/word
# size prefix is carried separately, at index 3.
make a function called xa_operand_size takes op returns size
  if op[0] == "reg" then
    return op[2]
  end
  return op[3]
end

make a function called xa_enc_movzx takes dst, src returns result
  let opcode = 182
  if xa_operand_size(src) == 16 then
    let opcode = 183
  end
  let rex = xa_rex(dst[2] == 64, xa_needs_rex_b(dst[1]), false, xa_needs_rex_b_for_rm(src))
  let mm = xa_encode_modrm(src, dst[1])
  return [xa_emit_bytes([rex, 15, opcode], mm[0]), xa_shift_reloc(mm[1], 3)]
end

# call/jmp/jcc: all `op label`, always encoded as the near rel32 form
# (uniform, no short-jump optimization) -- correctness over code size.
make a function called xa_enc_call takes label returns result
  return [[232, 0, 0, 0, 0], [1, "REL32", label, 0]]
end

# Register-indirect call (`call r12`, FF /2 -- calls through a runtime
# function-pointer value, e.g. the apply()-by-name dispatch table) --
# explicitly deferred as unimplemented back in Phase 3 (only a
# function-POINTER-VALUE relocation, `dq label`, was tested then, never
# an actual indirect call through one) and found genuinely load-bearing
# at real (x64_runtime.patlang) scale: 5 real `call r12` sites.
make a function called xa_enc_call_indirect takes reg_operand returns result
  let reg_num = reg_operand[1]
  let modrm = 192 + (2 * 8) + (reg_num band 7)
  if xa_needs_rex_b(reg_num) then
    return [[xa_rex(false, false, false, true), 255, modrm], false]
  end
  return [[255, modrm], false]
end

make a function called xa_enc_jmp takes label returns result
  return [[233, 0, 0, 0, 0], [1, "REL32", label, 0]]
end

make a function called xa_jcc_opcode takes name returns op
  if (name == "je") or (name == "jz") then
    return 132
  end
  if name == "jne" then
    return 133
  end
  if name == "jg" then
    return 143
  end
  if name == "jl" then
    return 140
  end
  if name == "jge" then
    return 141
  end
  if name == "jle" then
    return 142
  end
  if name == "jo" then
    return 128
  end
  return 132
end

make a function called xa_enc_jcc takes name, label returns result
  let op = xa_jcc_opcode(name)
  return [[15, op, 0, 0, 0, 0], [2, "REL32", label, 0]]
end

# SSE: F2/F3/66-prefixed scalar-double ops, all `op dst_xmm, src`.
make a function called xa_enc_sse_rr takes prefix, opcode, dst, src returns result
  let mm = xa_encode_modrm(src, dst[1])
  return [xa_emit_bytes(xa_emit_bytes(prefix, [15, opcode]), mm[0]), xa_shift_reloc(mm[1], to_num(list_len(prefix)) + 2)]
end

make a function called xa_enc_movq_sse takes dst, src returns result
  if (dst[3] == true) and (src[3] == true) then
    let mm = xa_encode_modrm(src, dst[1])
    return [xa_emit_bytes([243, 15, 126], mm[0]), xa_shift_reloc(mm[1], 3)]
  end
  if dst[3] == true then
    # movq xmm, r64 -- 66 REX.W 0F 6E /r
    let rex = xa_rex(true, xa_needs_rex_b(dst[1]), false, xa_needs_rex_b_for_rm(src))
    let mm = xa_encode_modrm(src, dst[1])
    return [xa_emit_bytes([102, rex, 15, 110], mm[0]), xa_shift_reloc(mm[1], 4)]
  end
  # movq r64, xmm -- 66 REX.W 0F 7E /r
  let rex = xa_rex(true, xa_needs_rex_b(src[1]), false, xa_needs_rex_b_for_rm(dst))
  let mm = xa_encode_modrm(dst, src[1])
  return [xa_emit_bytes([102, rex, 15, 126], mm[0]), xa_shift_reloc(mm[1], 4)]
end

make a function called xa_enc_cvtsi2sd takes dst, src returns result
  let rex = xa_rex(true, xa_needs_rex_b(dst[1]), false, xa_needs_rex_b_for_rm(src))
  let mm = xa_encode_modrm(src, dst[1])
  return [xa_emit_bytes([242, rex, 15, 42], mm[0]), xa_shift_reloc(mm[1], 4)]
end

make a function called xa_enc_cvttsd2si takes dst, src returns result
  let rex = xa_rex(true, xa_needs_rex_b(dst[1]), false, xa_needs_rex_b_for_rm(src))
  let mm = xa_encode_modrm(src, dst[1])
  return [xa_emit_bytes([242, rex, 15, 44], mm[0]), xa_shift_reloc(mm[1], 4)]
end

# ---- top-level instruction dispatch ----
#
# Returns [bytes, reloc_or_false] like every xa_enc_* helper.
make a function called xa_encode_instr takes mnemonic, ops returns result
  if mnemonic == "push" then
    return xa_enc_push_pop("push", ops[0])
  end
  if mnemonic == "pop" then
    return xa_enc_push_pop("pop", ops[0])
  end
  if mnemonic == "mov" then
    return xa_enc_mov(ops[0], ops[1])
  end
  if mnemonic == "lea" then
    return xa_enc_lea(ops[0], ops[1])
  end
  if (mnemonic == "add") or (mnemonic == "sub") or (mnemonic == "and") or (mnemonic == "or") or (mnemonic == "xor") or (mnemonic == "cmp") then
    return xa_enc_alu(mnemonic, ops[0], ops[1])
  end
  if mnemonic == "imul" then
    # Two forms: "imul reg, r/m" (0F AF /r, xa_enc_imul below) and the
    # single-operand "imul r/m" (F7 /5: RDX:RAX := RAX * r/m64, sets
    # OF/CF for the overflow-checked-arithmetic idiom this codebase
    # uses -- `imul r10` immediately followed by `jo .OVERFLOW_n` in
    # x64_runtime.patlang's own dynamic-mode integer multiply). Found
    # missing (single-operand form entirely unhandled -- xa_enc_imul
    # unconditionally read a nonexistent ops[1]) only at real-scale
    # verification; none of Phase 2's fixtures exercised it.
    if to_num(list_len(ops)) == 1 then
      return xa_enc_unary(5, ops[0])
    end
    return xa_enc_imul(ops[0], ops[1])
  end
  if mnemonic == "test" then
    return xa_enc_test(ops[0], ops[1])
  end
  if mnemonic == "inc" then
    return xa_enc_unary(0, ops[0])
  end
  if mnemonic == "dec" then
    return xa_enc_unary(1, ops[0])
  end
  if mnemonic == "neg" then
    return xa_enc_unary(3, ops[0])
  end
  if mnemonic == "not" then
    return xa_enc_unary(2, ops[0])
  end
  if (mnemonic == "shl") or (mnemonic == "shr") or (mnemonic == "sar") then
    return xa_enc_shift_imm(xa_shift_ext(mnemonic), ops[0], ops[1][1])
  end
  if str_starts_with(mnemonic, "set") then
    return xa_enc_setcc(mnemonic)
  end
  if mnemonic == "movzx" then
    return xa_enc_movzx(ops[0], ops[1])
  end
  if mnemonic == "call" then
    if ops[0][0] == "reg" then
      return xa_enc_call_indirect(ops[0])
    end
    return xa_enc_call(ops[0][1])
  end
  if mnemonic == "jmp" then
    return xa_enc_jmp(ops[0][1])
  end
  if str_starts_with(mnemonic, "j") then
    return xa_enc_jcc(mnemonic, ops[0][1])
  end
  if mnemonic == "ret" then
    return [[195], false]
  end
  if mnemonic == "leave" then
    return [[201], false]
  end
  if mnemonic == "cqo" then
    return [[72, 153], false]
  end
  if mnemonic == "cdq" then
    return [[153], false]
  end
  if mnemonic == "pause" then
    return [[243, 144], false]
  end
  if mnemonic == "idiv" then
    let rex = xa_rex(true, false, false, xa_needs_rex_b_for_rm(ops[0]))
    let mm = xa_encode_modrm(ops[0], 7)
    return [xa_emit_bytes([rex, 247], mm[0]), xa_shift_reloc(mm[1], 2)]
  end
  if mnemonic == "lock" then
    # "lock cmpxchg [mem], reg" is emitted as one logical line
    # ("lock cmpxchg ...") by codegen_x64.patlang -- the caller passes
    # the remainder through with mnemonic already reduced to
    # "cmpxchg" and this arm is unreachable in practice, kept only so
    # a bare "lock" prefix token is never silently swallowed if seen.
    return [[240], false]
  end
  if mnemonic == "cmpxchg" then
    let rex = xa_rex(true, xa_needs_rex_b(ops[1][1]), false, xa_needs_rex_b_for_rm(ops[0]))
    let mm = xa_encode_modrm(ops[0], ops[1][1])
    return [xa_emit_bytes([240, rex, 15, 177], mm[0]), xa_shift_reloc(mm[1], 4)]
  end
  if mnemonic == "xadd" then
    # "lock xadd [mem], reg" -- 0F C1 /r (XADD r/m64, r64), same
    # operand-order/lock-prefix shape as cmpxchg just above (r/m is
    # the destination, reg is the other operand); codegen_x64.patlang's
    # only real use is a genuine hardware atomic fetch-and-add
    # (`lock xadd [rcx], rax`), found missing here at real-scale
    # (x64_runtime.patlang) verification -- none of Phase 2's 6 hand-
    # written fixtures happened to exercise it.
    let rex = xa_rex(true, xa_needs_rex_b(ops[1][1]), false, xa_needs_rex_b_for_rm(ops[0]))
    let mm = xa_encode_modrm(ops[0], ops[1][1])
    return [xa_emit_bytes([240, rex, 15, 193], mm[0]), xa_shift_reloc(mm[1], 4)]
  end
  if mnemonic == "movq" then
    return xa_enc_movq_sse(ops[0], ops[1])
  end
  if mnemonic == "addsd" then
    return xa_enc_sse_rr([242], 88, ops[0], ops[1])
  end
  if mnemonic == "subsd" then
    return xa_enc_sse_rr([242], 92, ops[0], ops[1])
  end
  if mnemonic == "mulsd" then
    return xa_enc_sse_rr([242], 89, ops[0], ops[1])
  end
  if mnemonic == "divsd" then
    return xa_enc_sse_rr([242], 94, ops[0], ops[1])
  end
  if mnemonic == "ucomisd" then
    return xa_enc_sse_rr([102], 46, ops[0], ops[1])
  end
  if mnemonic == "cvtsi2sd" then
    return xa_enc_cvtsi2sd(ops[0], ops[1])
  end
  if mnemonic == "cvttsd2si" then
    return xa_enc_cvttsd2si(ops[0], ops[1])
  end
  print("x64_asm: unknown mnemonic '" + mnemonic + "'")
  return [[], false]
end

# ---- line-oriented parser + chunk assembler ----

make a function called xa_next_id returns id
  let n = get("__vars", "xa_id_counter")
  if not n then
    let n = 0
  end
  set_var("xa_id_counter", n + 1)
  return n
end

make a function called xa_new_state returns state
  let d = new("Dict", "xa_state_" + xa_next_id())
  send(d, "set", "section", "text")
  send(d, "set", "text_bytes", [])
  send(d, "set", "data_bytes", [])
  send(d, "set", "bss_size", 0)
  send(d, "set", "symbols", [])
  send(d, "set", "relocs", [])
  send(d, "set", "externs", [])
  send(d, "set", "globals", [])
  send(d, "set", "current_global", "")
  return d
end

make a function called xa_state_offset takes state, section returns off
  if section == "text" then
    return to_num(list_len(get(state, "text_bytes")))
  end
  if section == "data" then
    return to_num(list_len(get(state, "data_bytes")))
  end
  return get(state, "bss_size")
end

make a function called xa_declare_symbol takes state, name, section returns done
  let globals = get(state, "globals")
  let is_global = list_contains_str(globals, name)
  let off = xa_state_offset(state, section)
  let syms = get(state, "symbols")
  send(state, "set", "symbols", list_push(syms, [name, section, off, is_global]))
  return true
end

make a function called list_contains_str takes lst, v returns yes
  let i = 0
  let n = to_num(list_len(lst))
  while i < n do
    if lst[i] == v then
      return true
    end
    let i = i + 1
  end
  return false
end

make a function called xa_add_names takes state, key, names_csv returns done
  let parts = xa_split_char(names_csv, 44)
  let cur = get(state, key)
  let i = 0
  let n = to_num(list_len(parts))
  while i < n do
    let name = str_trim(parts[i])
    if name.length > 0 then
      let cur = list_push(cur, name)
    end
    let i = i + 1
  end
  send(state, "set", key, cur)
  return true
end

# Records a REL32/RIP32 reloc found at `local_offset` inside `bytes`
# (as returned by an xa_enc_* helper) at its real position once
# `bytes` is appended to the chunk at `base_offset`.
make a function called xa_record_reloc takes state, section, base_offset, reloc returns done
  if reloc == false then
    return true
  end
  let local_offset = reloc[0]
  let kind = reloc[1]
  let label = reloc[2]
  let addend = reloc[3]
  let relocs = get(state, "relocs")
  let entry = [section, base_offset + local_offset, label, kind, addend]
  send(state, "set", "relocs", list_push(relocs, entry))
  return true
end

make a function called xa_process_instr_line takes state, line returns done
  let sp = -1
  let i = 0
  while i < line.length do
    if char_code(line, i) == 32 then
      let sp = i
      let i = line.length
    end
    let i = i + 1
  end
  let mnemonic = line
  let rest = ""
  if sp >= 0 then
    let mnemonic = substr(line, 0, sp)
    let rest = str_trim(substr(line, sp + 1, line.length - sp - 1))
  end

  if mnemonic == "lock" then
    let sp2 = -1
    let i = 0
    while i < rest.length do
      if char_code(rest, i) == 32 then
        let sp2 = i
        let i = rest.length
      end
      let i = i + 1
    end
    let mnemonic = substr(rest, 0, sp2)
    let rest = str_trim(substr(rest, sp2 + 1, rest.length - sp2 - 1))
  end

  let ops = []
  if rest.length > 0 then
    let raw_parts = xa_split_char(rest, 44)
    let i = 0
    let n = to_num(list_len(raw_parts))
    while i < n do
      let op = xa_parse_operand(raw_parts[i])
      # A dot-scoped local label used as a jump/call TARGET (e.g. "jne
      # .DYN_FASTOK1_0") must be prefixed with the enclosing global
      # label's name, exactly matching how xa_declare_symbol already
      # prefixes the DECLARATION of that same label -- xa_parse_operand
      # has no access to `state`/current_global, so this can't happen
      # inside it; done here instead, right where both the operand and
      # `state` are in scope. Found missing (the reloc target name
      # never matched the declared symbol name at all, always failing
      # as "undefined symbol") only at real-scale verification -- none
      # of Phase 1-4's fixtures happened to reference a dot-label from
      # inside a JUMP rather than only declaring/falling into one.
      if (op[0] == "label") and str_starts_with(op[1], ".") then
        let op = ["label", get(state, "current_global") + op[1]]
      end
      let ops = list_push(ops, op)
      let i = i + 1
    end
  end

  let result = xa_encode_instr(mnemonic, ops)
  let base_offset = xa_state_offset(state, "text")
  send(state, "set", "text_bytes", xa_emit_bytes(get(state, "text_bytes"), result[0]))
  xa_record_reloc(state, "text", base_offset, result[1])
  return true
end

make a function called xa_process_line takes state, raw_line returns done
  let line = str_trim(xa_strip_comment(raw_line))
  if line.length == 0 then
    return true
  end
  # `label: rest-of-line` (label and a directive on ONE line) -- only
  # emitted by codegen_x64.patlang for its two win32-window UTF-16-ish
  # string literals (g_win_class_name/g_win_title: dw ...), but handled
  # generically here rather than special-cased to that one directive.
  # A PURE label line (nothing after the colon) still falls through
  # unchanged to the dedicated check further below -- this only fires
  # when there's real content after the colon to re-dispatch.
  let colon_idx = -1
  let ci = 0
  while ci < line.length do
    let c = char_code(line, ci)
    if c == 58 then
      let colon_idx = ci
      let ci = line.length
    else
      if (c == 32) or (c == 9) then
        let ci = line.length
      else
        let ci = ci + 1
      end
    end
  end
  if colon_idx >= 0 then
    let after = str_trim(substr(line, colon_idx + 1, line.length - colon_idx - 1))
    if after.length > 0 then
      let name = substr(line, 0, colon_idx)
      if str_starts_with(name, ".") then
        let full = get(state, "current_global") + name
        xa_declare_symbol(state, full, get(state, "section"))
      else
        xa_declare_symbol(state, name, get(state, "section"))
        send(state, "set", "current_global", name)
      end
      return xa_process_line(state, after)
    end
  end
  if str_starts_with(line, "default ") then
    return true
  end
  if str_starts_with(line, "section ") then
    let name = str_trim(substr(line, 8, line.length - 8))
    if name == ".text" then
      send(state, "set", "section", "text")
    else
      if name == ".data" then
        send(state, "set", "section", "data")
      else
        send(state, "set", "section", "bss")
      end
    end
    return true
  end
  if str_starts_with(line, "global ") then
    xa_add_names(state, "globals", substr(line, 7, line.length - 7))
    return true
  end
  if str_starts_with(line, "extern ") then
    xa_add_names(state, "externs", substr(line, 7, line.length - 7))
    return true
  end
  if str_starts_with(line, "align ") then
    let n = xa_parse_int(str_trim(substr(line, 6, line.length - 6)))
    let sec = get(state, "section")
    if sec == "text" then
      let bytes = get(state, "text_bytes")
      while (to_num(list_len(bytes)) % n) != 0 do
        let bytes = list_push(bytes, 144)
      end
      send(state, "set", "text_bytes", bytes)
    else
      if sec == "data" then
        let bytes = get(state, "data_bytes")
        while (to_num(list_len(bytes)) % n) != 0 do
          let bytes = list_push(bytes, 0)
        end
        send(state, "set", "data_bytes", bytes)
      else
        let bss = get(state, "bss_size")
        while (bss % n) != 0 do
          let bss = bss + 1
        end
        send(state, "set", "bss_size", bss)
      end
    end
    return true
  end
  if str_starts_with(line, "db ") then
    let parts = xa_split_char(str_trim(substr(line, 3, line.length - 3)), 44)
    let bytes = get(state, "data_bytes")
    let i = 0
    let n = to_num(list_len(parts))
    while i < n do
      let item = str_trim(parts[i])
      # A whole quoted STRING literal (`db 'bench_fib'`, x64_emit_
      # apply_table_asm's own function-name-string data) -- distinct
      # from the single-quoted-CHAR literal xa_parse_data_item already
      # handles (`db 'P'` from the dw-adjacent case, length 3) -- any
      # longer single-quoted item expands to one byte per character.
      # Found missing only at real-scale verification (the apply-table
      # object x64_compile_unit.patlang's own real build always links
      # in, never exercised by any Phase 1-4 fixture).
      if (item.length > 3) and (char_code(item, 0) == 39) and (char_code(item, item.length - 1) == 39) then
        let ci = 1
        while ci < item.length - 1 do
          let bytes = list_push(bytes, char_code(item, ci))
          let ci = ci + 1
        end
      else
        let bytes = list_push(bytes, xa_parse_data_item(item) band 255)
      end
      let i = i + 1
    end
    send(state, "set", "data_bytes", bytes)
    return true
  end
  # `dw` -- only used for two UTF-16-ish window-title string literals
  # (g_win_class_name/g_win_title in x64_runtime.patlang, generated by
  # codegen_x64.patlang's own win32-window support), always numeric or
  # single-char-literal items, never a label reference -- so no reloc
  # handling is needed here, unlike dq.
  if str_starts_with(line, "dw ") then
    let parts = xa_split_char(str_trim(substr(line, 3, line.length - 3)), 44)
    let data_bytes = get(state, "data_bytes")
    let i = 0
    let n = to_num(list_len(parts))
    while i < n do
      let data_bytes = xa_emit_i16(data_bytes, xa_parse_data_item(str_trim(parts[i])))
      let i = i + 1
    end
    send(state, "set", "data_bytes", data_bytes)
    return true
  end
  if str_starts_with(line, "dq ") then
    let parts = xa_split_char(str_trim(substr(line, 3, line.length - 3)), 44)
    let i = 0
    let n = to_num(list_len(parts))
    while i < n do
      let v = str_trim(parts[i])
      if xa_looks_like_int(v) then
        send(state, "set", "data_bytes", xa_emit_i64(get(state, "data_bytes"), xa_parse_int(v)))
      else
        let off = xa_state_offset(state, "data")
        send(state, "set", "data_bytes", xa_emit_i64(get(state, "data_bytes"), 0))
        let relocs = get(state, "relocs")
        send(state, "set", "relocs", list_push(relocs, ["data", off, v, "ABS64", 0]))
      end
      let i = i + 1
    end
    return true
  end
  if char_code(line, line.length - 1) == 58 then
    let name = substr(line, 0, line.length - 1)
    if str_starts_with(name, ".") then
      let full = get(state, "current_global") + name
      xa_declare_symbol(state, full, get(state, "section"))
    else
      xa_declare_symbol(state, name, get(state, "section"))
      send(state, "set", "current_global", name)
    end
    return true
  end
  let parts = xa_split_char(line, 32)
  if to_num(list_len(parts)) >= 3 then
    let kind = parts[1]
    if (kind == "resb") or (kind == "resq") or (kind == "resd") then
      let name = parts[0]
      xa_declare_symbol(state, name, "bss")
      let count = xa_parse_int(parts[2])
      let sz_unit = 1
      if kind == "resq" then
        let sz_unit = 8
      end
      if kind == "resd" then
        let sz_unit = 4
      end
      send(state, "set", "bss_size", get(state, "bss_size") + (count * sz_unit))
      return true
    end
  end
  xa_process_instr_line(state, line)
  return true
end

# Assembles one chunk of NASM-subset text into a ChunkImage.
make a function called x64_assemble_chunk takes asm_text returns chunk
  let state = xa_new_state()
  let lines = split_lines(asm_text)
  let i = 0
  let n = to_num(list_len(lines))
  while i < n do
    xa_process_line(state, lines[i])
    let i = i + 1
  end
  return ["ChunkImage",
    get(state, "text_bytes"),
    get(state, "data_bytes"),
    get(state, "bss_size"),
    get(state, "symbols"),
    get(state, "relocs"),
    get(state, "externs")]
end
