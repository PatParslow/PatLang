# x64_build.patlang -- turns codegen_x64.patlang's generated NASM text
# into a real standalone .exe, entirely via PatLang (write_file +
# exec_capture), no new Rust host function needed -- the same "runtime
# logic belongs in PatLang, not baked into a native primitive"
# principle the rest of this backend has followed throughout. Mirrors
# the exact nasm/gcc toolchain invocation already proven across every
# earlier slice's own driver script.

include "x64_pe_link.patlang"

make a function called x64_nasm_exe returns path
  return "C:/Program Files/NASM/nasm.exe"
end

# Not lib/test.patlang's contains_text -- deliberately a small local
# copy so this file doesn't pull in the whole test framework just for
# one substring check.
make a function called x64_build_contains takes hay, needle returns r
  if needle.length > hay.length then
    return false
  end
  let i = 0
  while i <= hay.length - needle.length do
    if substr(hay, i, needle.length) == needle then
      return true
    end
    let i = i + 1
  end
  return false
end

# Builds asm_source into out_path (a real .exe). Returns out_path on
# success, or an error message string starting with "NASM ERROR:" or
# "LINK ERROR:" on failure -- callers should check for that prefix
# rather than assuming success (this file has no exceptions to raise,
# same as everywhere else in PatLang).
make a function called x64_build takes asm_source, out_path returns result
  let asm_path = out_path + ".asm"
  let obj_path = out_path + ".obj"
  write_file(asm_path, asm_source)
  let nasm_out = exec_capture(x64_nasm_exe(), "-Ox", "-f", "win64", "-o", obj_path, asm_path)
  if x64_build_contains(nasm_out, "error") then
    return "NASM ERROR:\n" + nasm_out
  end
  let gcc_out = exec_capture("gcc", "-o", out_path, obj_path, "-Wl,--subsystem,console", "-lkernel32", "-luser32", "-lgdi32", "-lws2_32")
  if x64_build_contains(gcc_out, "error") then
    return "LINK ERROR:\n" + gcc_out
  end
  return out_path
end

# Just the assemble step (asm_source -> obj_path), factored out so the
# runtime-chunk build (build_x64_runtime.patlang) and the program-chunk
# half of x64_build_linked below can share it instead of duplicating
# the nasm invocation. Returns obj_path on success, "NASM ERROR:..." on
# failure, same convention as x64_build.
make a function called x64_assemble takes asm_source, asm_path, obj_path returns result
  write_file(asm_path, asm_source)
  # -Ox: iterate jump-size optimization to a fixed point instead of NASM's
  # default (bounded) pass count -- without this, a large generated file
  # with many labels can hit "label ... changed during code generation"
  # (a genuine short-vs-near jump-size oscillation NASM's default pass
  # limit doesn't have enough iterations to resolve), confirmed directly
  # on interp.patlang's own interp_call_host during the interp.patlang-
  # compilation roadmap (#25)'s chunk-splitting work.
  let nasm_out = exec_capture(x64_nasm_exe(), "-Ox", "-f", "win64", "-o", obj_path, asm_path)
  if x64_build_contains(nasm_out, "error") then
    return "NASM ERROR:\n" + nasm_out
  end
  return obj_path
end

# Separate-compilation build (the "chunk link" architecture): assembles
# ONLY program_asm (the user's own program, compiled with owns_globals
# = false / extern_names = the runtime's function list, see
# emit_program_x64's own header) into its own .obj, then links it
# together with an ALREADY-BUILT runtime_obj_path (see
# build_x64_runtime.patlang's fingerprint-cached build) in ONE gcc
# invocation -- gcc/ld resolve the program chunk's `extern` references
# against the runtime chunk's `global` symbols automatically, the same
# way any two ordinary object files link, no new toolchain behaviour
# needed. Returns out_path on success, "NASM ERROR:"/"LINK ERROR:" on
# failure, same convention as x64_build.
make a function called x64_build_linked takes program_asm, runtime_obj_path, out_path returns result
  let asm_path = out_path + ".asm"
  let obj_path = out_path + ".obj"
  let asm_result = x64_assemble(program_asm, asm_path, obj_path)
  if x64_build_contains(asm_result, "NASM ERROR:") then
    return asm_result
  end
  let gcc_out = exec_capture("gcc", "-o", out_path, obj_path, runtime_obj_path, "-Wl,--subsystem,console", "-lkernel32", "-luser32", "-lgdi32", "-lws2_32")
  if x64_build_contains(gcc_out, "error") then
    return "LINK ERROR:\n" + gcc_out
  end
  return out_path
end

# x64_build_linked_multi(program_asm_chunks, runtime_obj_path, out_path)
# -- the fix for the NASM memory-blowout on the full self-hosted-
# compiler bundle (see x64_partition_funcs's own header in codegen_x64.
# patlang): program_asm_chunks is a LIST of separately-generated asm
# texts (each already small, well under the pathological label-count
# threshold that made one giant combined asm balloon nasm.exe to
# 12-14GB), assembled here into their own numbered .obj files and
# linked together with runtime_obj_path in ONE final gcc invocation --
# ordinary separate compilation, exactly what C does routinely.
#
# The final gcc call needs a VARIABLE number of object-file arguments
# (one per chunk, however many that turns out to be) -- PatLang has no
# variadic call syntax (exec_capture's own argc is fixed per call site,
# same reasoning x64_spawn_asm's own header already documents for a
# DIFFERENT variadic case), so instead of exec_capture(...) with a
# fixed arg list, the whole gcc command line is built as ONE string and
# handed to cmd.exe's own `/c` (which does the argv splitting), rather
# than adding a new Rust host function just for this.
# x64_link_objs(obj_paths, runtime_obj_path, out_path) -- the pure
# linking half of the above: given ALREADY-ASSEMBLED object files
# (however many, however they were produced -- x64_build_linked_multi's
# own chunk-assembly loop below, or CompileUnit's own per-function
# ensure_obj, see self_hosting/lib/x64_compile_unit.patlang), links them
# all together with runtime_obj_path in ONE gcc invocation. Factored out
# so the per-function object-cache path (GitHub incremental-compile-
# caching plan) can reuse this exact linking mechanism without also
# reusing the "assemble N asm chunks first" half, which that path
# doesn't need (each function's own .obj is already cache-checked/
# assembled by the time linking happens).
make a function called x64_link_objs takes obj_paths, runtime_obj_path, out_path returns result
  # A variable number of object files can't go through a fixed-arity
  # exec_capture call directly (PatLang has no variadic call syntax,
  # same reasoning x64_spawn_asm's own header documents for a DIFFERENT
  # variadic case), and routing the whole command line through a shell
  # (cmd.exe /c) turned out to have its own real quoting/escaping
  # problems (confirmed: a manually-reconstructed equivalent command,
  # typed through bash's own shell first, got mangled before cmd.exe
  # ever saw it -- a two-layer shell-quoting problem, not something
  # worth chasing further). Using a GCC/ld "response file" (@file, one
  # argument per line, a mechanism both tools support natively for
  # exactly this "too many arguments" case) avoids any shell entirely --
  # exec_capture's own argc stays fixed at 2 (gcc, "@responsefile"), no
  # variadic problem, no quoting problem.
  let resp = sb_new()
  sb_push(resp, "-o" + chr(10))
  sb_push(resp, out_path + chr(10))
  let oi = 0
  let ocount = to_num(list_len(obj_paths))
  while oi < ocount do
    sb_push(resp, obj_paths[oi] + chr(10))
    let oi = oi + 1
  end
  sb_push(resp, runtime_obj_path + chr(10))
  sb_push(resp, "-Wl,--subsystem,console" + chr(10))
  sb_push(resp, "-lkernel32" + chr(10))
  sb_push(resp, "-luser32" + chr(10))
  sb_push(resp, "-lgdi32" + chr(10))
  sb_push(resp, "-lws2_32" + chr(10))
  let resp_path = out_path + ".gcc_args.rsp"
  write_file(resp_path, sb_str(resp))
  let gcc_out = exec_capture("gcc", "@" + resp_path)
  if x64_build_contains(gcc_out, "error") then
    return "LINK ERROR:\n" + gcc_out
  end
  return out_path
end

make a function called x64_build_linked_multi takes program_asm_chunks, runtime_obj_path, out_path returns result
  let n = to_num(list_len(program_asm_chunks))
  let objs = []
  let i = 0
  while i < n do
    let chunk_asm_path = out_path + ".chunk" + i + ".asm"
    let chunk_obj_path = out_path + ".chunk" + i + ".obj"
    let asm_result = x64_assemble(program_asm_chunks[i], chunk_asm_path, chunk_obj_path)
    if x64_build_contains(asm_result, "NASM ERROR:") then
      return "NASM ERROR (chunk " + i + "):\n" + asm_result
    end
    let objs = list_push(objs, chunk_obj_path)
    let i = i + 1
  end
  return x64_link_objs(objs, runtime_obj_path, out_path)
end

# ==========================================================================
# Phase 5 -- the self-hosted toolchain (x64_asm.patlang +
# x64_pe_link.patlang) is now the DEFAULT real build path for --x64:
# x64_build_use_native_toolchain() below returns true, and
# patc1_main.patlang genuinely consults it (send(linker, "build_native",
# ...) vs send(linker, "build", ...)). The nasm/gcc functions above are
# NOT deleted and remain fully reachable by flipping that one return
# value to false -- per this project's own verification discipline of
# keeping superseded paths as permanent cross-checking oracles rather
# than removing them, the same reason --ir-run/--patc/wasm are all still
# around. That fallback has already earned its keep: differential-testing
# the two assemblers against each other on identical .asm input is what
# found the three-operand `imul` encoding bug.
# ==========================================================================

# Real production wiring now exists (X64UnitLinker.build_native /
# CompileUnit.ensure_chunk_native, self_hosting/lib/x64_compile_unit.
# patlang) and patc1_main.patlang's --x64 path DOES consult this flag.
# RESOLVED (session 8): the root cause of the earlier string-equality-
# vs-literal corruption (every rt_str_eq comparison returning false
# once compiled through the native toolchain) was xa_parse_int's use
# of to_num(), which silently loses precision via a float64 round-trip
# for large decimal literals -- corrupting the Bool-TRUE tagged
# constant (0x6000000000000001 -> 0x6000000000000000, i.e. Bool-FALSE)
# every time it was assembled. Fixed by parsing decimal strings with
# exact integer arithmetic (substr + a digit lookup table), with no
# to_num()/char_code() dependency (char_code assumes the TARGET
# program's tagged-pointer memory model, which does not hold for code
# running inside the current bootstrap compiler's own compiled body).
# Verified: a trivial --x64 program, the rt_str_eq("abc","abc") direct-
# call repro (now correctly exits 1), the full self_hosting/tests/
# x64_asm/run_tests.sh suite (9/9), and a real recursive benchmark
# (fib(32) = 2178309) all pass through the native toolchain. See
# patlang-x64-selfhosted-assembler-phase1 memory for the full
# investigation trail.
make a function called x64_build_use_native_toolchain returns enabled
  return true
end

# The exact real import surface codegen_x64.patlang's own emit_program_x64
# declares (see its own "extern ..." sb_push lines) -- kept as one
# explicit, verified-against-the-real-DLLs list here rather than derived
# from a ChunkImage's own `externs`.
#
# round/trunc are deliberately ABSENT and must stay absent: msvcrt.dll
# exports ceil, floor and fabs but neither round nor trunc (checked
# against the real DLL's export table). Importing them would name two
# symbols that do not exist -- exactly the Phase 4 bug already found and
# fixed once. x64_roundlike_asm therefore synthesises both from
# floor/ceil; see its own header. (An earlier version of this comment
# claimed roundlike used SSE roundsd and never called out at all; that
# had stopped being true, and the stale claim hid a real bug -- codegen
# was emitting `call round` against an import list that rightly did not
# declare it, so any program rounding a float failed to link natively.)
make a function called x64_default_import_spec returns spec
  return [
    ["KERNEL32.DLL", ["GetStdHandle", "WriteFile", "ExitProcess", "CreateFileA", "GetFileSize", "CloseHandle", "ReadFile", "CreateProcessA", "CreatePipe", "SetHandleInformation", "WaitForSingleObject", "GetCommandLineA", "GetEnvironmentVariableA", "GetExitCodeProcess", "TerminateProcess", "Sleep", "GetTickCount64", "CopyFileA", "MoveFileExA", "FindFirstFileA", "FindNextFileA", "FindClose", "GetConsoleMode", "SetConsoleMode", "SetConsoleOutputCP", "SetConsoleCP", "GetCurrentDirectoryA", "SetCurrentDirectoryA", "CreatePseudoConsole", "ResizePseudoConsole", "ClosePseudoConsole", "InitializeProcThreadAttributeList", "UpdateProcThreadAttribute", "CreateProcessW", "PeekNamedPipe", "GetLastError", "CreateThread", "ExitThread", "InitializeCriticalSection", "EnterCriticalSection", "LeaveCriticalSection", "TlsAlloc", "TlsGetValue", "TlsSetValue", "AcquireSRWLockExclusive", "ReleaseSRWLockExclusive", "SleepConditionVariableSRW", "WakeConditionVariable", "GetModuleHandleW", "GlobalAlloc", "GlobalLock", "GlobalUnlock", "GlobalSize"]],
    ["WS2_32.DLL", ["WSAStartup", "WSAGetLastError", "socket", "bind", "listen", "accept", "connect", "send", "recv", "closesocket", "shutdown", "getaddrinfo", "freeaddrinfo", "getsockname", "ioctlsocket", "htons", "ntohs"]],
    ["USER32.DLL", ["RegisterClassExW", "CreateWindowExW", "ShowWindow", "UpdateWindow", "DefWindowProcW", "PeekMessageW", "TranslateMessage", "DispatchMessageW", "BeginPaint", "EndPaint", "InvalidateRect", "GetClientRect", "DestroyWindow", "GetKeyState", "OpenClipboard", "CloseClipboard", "EmptyClipboard", "SetClipboardData", "GetClipboardData", "SetWindowTextA", "GetDC", "ReleaseDC"]],
    ["GDI32.DLL", ["CreateCompatibleDC", "CreateDIBSection", "SelectObject", "BitBlt", "TextOutA", "SetTextColor", "SetBkMode", "DeleteObject", "StretchDIBits"]],
    ["MSVCRT.DLL", ["sqrt", "pow", "sin", "cos", "tan", "asin", "acos", "atan", "atan2", "log", "exp", "ceil", "floor", "fabs"]]
  ]
end

# x64_assemble_native(asm_source, asm_path) -> ChunkImage, or an error
# string starting with "ASM ERROR:" -- the native-toolchain analogue of
# x64_assemble. Still writes asm_path to disk (even though nothing reads
# it back) purely so this stays a drop-in swap for any caller/diagnostic
# workflow that expects the .asm text to land on disk at that path, same
# as every nasm-based caller already relies on.
make a function called x64_assemble_native takes asm_source, asm_path returns result
  write_file(asm_path, asm_source)
  let chunk = x64_assemble_chunk(asm_source)
  if not chunk then
    return "ASM ERROR: x64_assemble_chunk failed for " + asm_path
  end
  return chunk
end

# x64_link_native_chunks(chunks, out_path) -> out_path, or an error string
# starting with "LINK ERROR:" -- the native-toolchain analogue of
# x64_link_objs. `chunks` is a plain list of ChunkImages (the runtime
# chunk plus every program chunk), already merged the same way x64_link
# has supported since Phase 1 -- no separate "link objs against a
# pre-built runtime .obj" step is meaningful here, since this linker has
# no COFF reader (Phase 3's own explicitly-deferred note) and therefore
# cannot consume a nasm-built runtime.obj at all: the runtime's OWN asm
# source (self_hosting/build/x64_runtime.asm, written by
# build_x64_runtime.patlang regardless of which toolchain built its
# cached .obj) must be assembled into a ChunkImage via x64_assemble_native
# too and included in `chunks`, same as any other chunk.
make a function called x64_link_native_chunks takes chunks, out_path returns result
  let result = x64_link(chunks, x64_default_import_spec(), "main", out_path)
  if x64_build_contains(result, "LINK ERROR:") then
    return result
  end
  return result
end
