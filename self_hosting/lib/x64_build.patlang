# x64_build.patlang -- turns codegen_x64.patlang's generated NASM text
# into a real standalone .exe, entirely via PatLang (write_file +
# exec_capture), no new Rust host function needed -- the same "runtime
# logic belongs in PatLang, not baked into a native primitive"
# principle the rest of this backend has followed throughout. Mirrors
# the exact nasm/gcc toolchain invocation already proven across every
# earlier slice's own driver script.

make a function called x64_nasm_exe returns path
  return "C:/Program Files/NASM/nasm.exe"
end

# Not lib/test.patlang's contains_text -- deliberately a small local
# copy so this file doesn't pull in the whole test framework just for
# one substring check.
make a function called x64_build_contains takes hay, needle returns r
  if needle.length > hay.length then
    return false
  end
  let i = 0
  while i <= hay.length - needle.length do
    if substr(hay, i, needle.length) == needle then
      return true
    end
    let i = i + 1
  end
  return false
end

# Builds asm_source into out_path (a real .exe). Returns out_path on
# success, or an error message string starting with "NASM ERROR:" or
# "LINK ERROR:" on failure -- callers should check for that prefix
# rather than assuming success (this file has no exceptions to raise,
# same as everywhere else in PatLang).
make a function called x64_build takes asm_source, out_path returns result
  let asm_path = out_path + ".asm"
  let obj_path = out_path + ".obj"
  write_file(asm_path, asm_source)
  let nasm_out = exec_capture(x64_nasm_exe(), "-f", "win64", "-o", obj_path, asm_path)
  if x64_build_contains(nasm_out, "error") then
    return "NASM ERROR:\n" + nasm_out
  end
  let gcc_out = exec_capture("gcc", "-o", out_path, obj_path, "-Wl,--subsystem,console", "-lkernel32", "-luser32", "-lgdi32")
  if x64_build_contains(gcc_out, "error") then
    return "LINK ERROR:\n" + gcc_out
  end
  return out_path
end

# Just the assemble step (asm_source -> obj_path), factored out so the
# runtime-chunk build (build_x64_runtime.patlang) and the program-chunk
# half of x64_build_linked below can share it instead of duplicating
# the nasm invocation. Returns obj_path on success, "NASM ERROR:..." on
# failure, same convention as x64_build.
make a function called x64_assemble takes asm_source, asm_path, obj_path returns result
  write_file(asm_path, asm_source)
  let nasm_out = exec_capture(x64_nasm_exe(), "-f", "win64", "-o", obj_path, asm_path)
  if x64_build_contains(nasm_out, "error") then
    return "NASM ERROR:\n" + nasm_out
  end
  return obj_path
end

# Separate-compilation build (the "chunk link" architecture): assembles
# ONLY program_asm (the user's own program, compiled with owns_globals
# = false / extern_names = the runtime's function list, see
# emit_program_x64's own header) into its own .obj, then links it
# together with an ALREADY-BUILT runtime_obj_path (see
# build_x64_runtime.patlang's fingerprint-cached build) in ONE gcc
# invocation -- gcc/ld resolve the program chunk's `extern` references
# against the runtime chunk's `global` symbols automatically, the same
# way any two ordinary object files link, no new toolchain behaviour
# needed. Returns out_path on success, "NASM ERROR:"/"LINK ERROR:" on
# failure, same convention as x64_build.
make a function called x64_build_linked takes program_asm, runtime_obj_path, out_path returns result
  let asm_path = out_path + ".asm"
  let obj_path = out_path + ".obj"
  let asm_result = x64_assemble(program_asm, asm_path, obj_path)
  if x64_build_contains(asm_result, "NASM ERROR:") then
    return asm_result
  end
  let gcc_out = exec_capture("gcc", "-o", out_path, obj_path, runtime_obj_path, "-Wl,--subsystem,console", "-lkernel32", "-luser32", "-lgdi32")
  if x64_build_contains(gcc_out, "error") then
    return "LINK ERROR:\n" + gcc_out
  end
  return out_path
end
