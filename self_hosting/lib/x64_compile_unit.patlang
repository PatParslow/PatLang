# CompileUnit -- one function's own compilation unit: its IR, a stable
# content hash (the ObjCache lookup key), and the logic to produce its
# own .obj, either from cache or by running the exact same codegen/
# assemble steps this whole backend already used per-chunk (just with a
# ONE-function chunk now).
#
# x64_content_hash is a deliberately SIMPLE polynomial (djb2-style) hash
# over the function's own canonical JSON serialization
# (json_stringify(to_json_value(func_ir)), reusing lib/ir_io.patlang's
# existing to_json_value + lib/json.patlang's existing json_stringify --
# no new serialization code needed). NOT the same algorithm as the real
# `hash_string` host function (FNV-1a) -- deliberately: hash_string has
# NO x64 native codegen support (confirmed on the "unsupported
# primitive" list during the self-hosting-fixpoint work), and this
# cache doesn't need to match hash_string's own digest values anyway,
# only to be deterministic and collision-resistant enough for a few
# hundred functions -- a plain modular polynomial computed via ordinary
# PatLang int arithmetic (kept well under the 48-bit fixnum range via
# an explicit modulus, no BigInt promotion risk) works on every backend
# uniformly with zero new primitive dependencies.
make a function called x64_content_hash takes s returns digest
  let h = 5381
  let n = s.length
  let i = 0
  while i < n do
    let c = char_code(s, i)
    let h = (h * 33 + c) % 999999937
    let i = i + 1
  end
  return "" + h
end

# GitHub reliability follow-up (patlang-x64-int-48bit-grayzone-gap memory,
# session 5/6): x64_content_hash above is a hash of the TARGET function's
# own IR only, with zero dependency on THIS COMPILER's own version -- so a
# codegen_x64.patlang fix silently kept serving a stale cached .obj for any
# function whose source hadn't itself changed, confirmed directly (had to
# `rm -rf x64_obj_cache/*.obj` by hand after every codegen change during
# that investigation, even after a full patc1.exe rebuild). Fixed by
# folding a hash of codegen_x64.patlang's OWN source (the file that defines
# emit_program_x64, i.e. everything that actually decides what asm a given
# IR produces) into every content_hash below, so any codegen change
# automatically invalidates every cached object -- no manual cache-clearing
# required. Memoized in a global var since it's the same value for every
# unit within one compiler run and reading+hashing the file is not free.
make a function called x64_compiler_fingerprint takes none returns fp
  # NOTE: get() on a never-set key concatenates as "" but is NOT == ""
  # (patlang-get-unset-key-not-equal-empty-string) -- coerce first.
  let cur = "" + get("__vars", "__x64_compiler_fingerprint")
  if cur == "" then
    let src = read_file("self_hosting/lib/codegen_x64.patlang")
    let cur = x64_content_hash(src)
    set_var("__x64_compiler_fingerprint", cur)
  end
  return cur
end

class CompileUnit {
  field func_ir = []
  field name = ""
  field content_hash = ""
  field state = "unstarted"
  field pending_obj_path = ""
  field pending_pid = 0

  # ensure_obj(self, cache, extern_names) -> obj_path, or an error string
  # starting with "NASM ERROR:" on a genuine assembly failure (same
  # convention as x64_assemble/x64_build). Cache hit skips codegen/
  # assembly entirely. Sequential convenience wrapper around prepare+
  # finish below -- equivalent to calling them back to back for exactly
  # this one unit, kept for callers (like the earlier standalone
  # integration test) that don't need cross-unit parallelism.
  make a function called ensure_obj takes self, cache, extern_names returns obj_path
    send(self, "prepare", cache, extern_names)
    return send(self, "finish", cache)
  end

  # prepare(self, cache, extern_names): cache hit -> records the cached
  # path directly, nothing to wait for. Cache miss -> emits this unit's
  # own asm, writes it, and launches nasm via the REAL, ALREADY-
  # SUPPORTED non-blocking spawn() primitive (Stage A process-lifecycle
  # work) instead of the blocking exec_capture x64_assemble normally
  # uses -- returns immediately with the child PID still running, so a
  # caller building many CompileUnits can call prepare() on ALL of them
  # first (launching every cache-miss's own nasm concurrently) before
  # calling finish() on any of them, rather than serializing one
  # assemble-and-wait per function. Real object-file separate
  # compilation already has zero runtime cost (see this whole feature's
  # own design discussion); this is the natural next step for its
  # BUILD-time cost -- unique per-unit filenames (name+content_hash,
  # already how ensure_obj names its own output) mean concurrent nasm
  # invocations can never clash on the same file.
  make a function called prepare takes self, cache, extern_names returns done
    let h = get(self, "content_hash")
    if send(cache, "has", h) then
      self.state = "cached"
      return true
    end
    let func_ir = get(self, "func_ir")
    let name = get(self, "name")
    let asm = emit_program_x64(["ProgramIR", "main", [func_ir], []], false, extern_names)
    let out_path = "self_hosting/build/unit_" + name + "." + h
    let asm_path = out_path + ".asm"
    let obj_path = out_path + ".obj"
    write_file(asm_path, asm)
    let pid = spawn(x64_nasm_exe(), "-Ox", "-f", "win64", "-o", obj_path, asm_path)
    self.pending_obj_path = obj_path
    self.pending_pid = pid
    self.state = "spawned"
    return true
  end

  # finish(self, cache) -> obj_path, or an error string starting with
  # "NASM ERROR:". For a cache hit, returns the cached path immediately
  # (no wait). For a spawned unit, waits for THIS unit's own nasm to
  # finish -- but since every other unit's nasm was already launched
  # concurrently back in prepare(), the total wall time across many
  # finish() calls is bounded by the SLOWEST individual assemble, not
  # their sum. spawn()'s own real semantics discard stdout/stderr (see
  # its header in x64_runtime.patlang -- Stage A scope, non-blocking by
  # design), so a failure here can only report nasm's exit code, not
  # the detailed error text exec_capture-based x64_assemble gives --
  # a real, named diagnostic-quality tradeoff for the parallelism, not
  # something papered over.
  make a function called finish takes self, cache returns obj_path
    let st = get(self, "state")
    if st == "cached" then
      return send(cache, "path_for", get(self, "content_hash"))
    end
    let pid = get(self, "pending_pid")
    let code = wait(pid)
    let obj_path = get(self, "pending_obj_path")
    if code != 0 then
      return "NASM ERROR: nasm exited " + code + " assembling " + obj_path + " (run x64_assemble directly on this unit for full diagnostic text)"
    end
    if file_exists(obj_path) == "0" then
      return "NASM ERROR: nasm exited 0 but " + obj_path + " was never created"
    end
    let h = get(self, "content_hash")
    send(cache, "store", h, obj_path)
    return send(cache, "path_for", h)
  end

  # ensure_chunk_native(self, cache_dir, extern_names) -> ChunkImage, or
  # an error string starting with "ASM ERROR:". The native-toolchain
  # (self-hosted assembler, x64_asm.patlang/x64_pe_link.patlang)
  # analogue of ensure_obj above: same cache-hit-or-fresh-assemble shape
  # and same content_hash (already folds in x64_compiler_fingerprint(),
  # see x64_make_compile_unit), but produces an in-memory ChunkImage
  # instead of an on-disk .obj, since this linker has no COFF reader
  # (x64_link_native_chunks's own header) and never needs one -- no
  # nasm/gcc subprocess involved at all. Cached as JSON on disk (a
  # ChunkImage is a plain tagged list of ints/strings, see
  # x64_assemble_chunk's own return shape -- round-trips exactly through
  # to_json_value/json_stringify/json_parse/from_json_value the same way
  # x64_content_hash already serializes a func_ir) so a cache hit skips
  # re-assembling entirely, preserving the whole point of this per-
  # function architecture (an unchanged function costs nothing on a
  # rebuild) for the native path too, not just the nasm path.
  make a function called ensure_chunk_native takes self, cache_dir, extern_names returns chunk_or_err
    let h = get(self, "content_hash")
    let cache_path = cache_dir + "/" + h + ".chunk.json"
    if file_exists(cache_path) == "1" then
      return from_json_value(json_parse(read_file(cache_path)))
    end
    let func_ir = get(self, "func_ir")
    let asm = emit_program_x64(["ProgramIR", "main", [func_ir], []], false, extern_names)
    let chunk = x64_assemble_chunk(asm)
    if not chunk then
      return "ASM ERROR: x64_assemble_chunk failed for unit " + get(self, "name")
    end
    write_file(cache_path, json_stringify(to_json_value(chunk)))
    return chunk
  end
}

# Builds a CompileUnit for one function's IR -- the "constructor" step
# (this backend's own new(class,name) only initializes fields to the
# class's static defaults, see x64_runtime.patlang's own class-support
# header, so real per-instance construction is new()-then-assign, an
# established, simple pattern rather than a gap).
make a function called x64_make_compile_unit takes func_ir returns unit
  let name = func_ir[1]
  let unit = new("CompileUnit", "cu_" + name)
  unit.func_ir = func_ir
  unit.name = name
  unit.content_hash = name + "_" + x64_content_hash(json_stringify(to_json_value(func_ir))) + "_" + x64_compiler_fingerprint()
  return unit
end

# Every OTHER function in `funcs` (all except index `self_idx`) plus
# rt_names -- exactly the extern list a per-function .obj needs to link
# against everything else, same computation patc1_main.patlang's own
# per-chunk path already did (just per-function now instead of per
# size-bucketed chunk).
make a function called x64_extern_names_for takes funcs, self_idx, rt_names returns names
  # g_apply_table/g_apply_table_count are DATA symbols defined in the
  # separately-generated, separately-linked apply-table unit (see
  # build's own comment below) -- declared extern here, unconditionally,
  # for every unit, so any unit whose own body happens to call the
  # os_apply_table_* primitives (which reference these symbols directly
  # via inline asm, not an ordinary function call) has them available.
  # Harmless for every other unit: an unused `extern` declaration costs
  # nothing.
  let names = list_push(rt_names, "g_apply_table")
  let names = list_push(names, "g_apply_table_count")
  let n = funcs.length
  let i = 0
  while i < n do
    if i != self_idx then
      let names = list_push(names, funcs[i][1])
    end
    let i = i + 1
  end
  return names
end

# X64UnitLinker -- orchestrates the whole per-function-cached build:
# one CompileUnit per function (cache hit or fresh assemble, see
# CompileUnit.ensure_obj's own header), then ONE final link
# (x64_link_objs, self_hosting/lib/x64_build.patlang) against all of
# them plus the runtime object. Replaces x64_partition_funcs's arbitrary
# size-based chunking entirely for the program side -- every function
# is its own real, separately-compiled, separately-cached unit, exactly
# what "genuine separation of concerns" (this whole feature's own
# starting brief) means: no more magic instruction-count threshold
# deciding whether a program even GETS chunked.
class X64UnitLinker {
  field cache = 0

  # Two passes, not one: EVERY unit's prepare() (cache check, or a
  # non-blocking nasm spawn) runs first, so every cache-miss's own nasm
  # is already running concurrently by the time ANY unit's finish()
  # (which waits) is called -- real parallel assembly, not one-at-a-
  # time. Cache hits cost nothing extra in either pass (prepare just
  # records the path, finish just returns it).
  make a function called build takes self, funcs, rt_names, runtime_obj_path, out_path returns result
    let cache = get(self, "cache")
    let n = funcs.length
    let units = []
    let i = 0
    while i < n do
      let unit = x64_make_compile_unit(funcs[i])
      let extern_names = x64_extern_names_for(funcs, i, rt_names)
      send(unit, "prepare", cache, extern_names)
      let units = list_push(units, unit)
      let i = i + 1
    end
    let objs = []
    let i = 0
    while i < n do
      let obj_or_err = send(units[i], "finish", cache)
      if x64_build_contains(obj_or_err, "NASM ERROR:") then
        return obj_or_err
      end
      let objs = list_push(objs, obj_or_err)
      let i = i + 1
    end
    # Apply-table unit (see codegen_x64.patlang's own "apply(fname):
    # dynamic dispatch-by-name" section header for the full design):
    # a small generated data-only object exposing g_apply_table/
    # g_apply_table_count (name -> function-pointer pairs for every
    # function this build produces), so apply() can resolve a runtime
    # string to a real callable address. Generated and linked
    # UNCONDITIONALLY on every --x64 build, not gated on whether this
    # particular program calls apply() -- negligible size/build-time
    # cost, and avoids needing to detect that in advance.
    let apply_table_asm = x64_emit_apply_table_asm(funcs)
    let apply_table_asm_path = out_path + ".apply_table.asm"
    let apply_table_obj_path = out_path + ".apply_table.obj"
    let apply_table_result = x64_assemble(apply_table_asm, apply_table_asm_path, apply_table_obj_path)
    if x64_build_contains(apply_table_result, "NASM ERROR:") then
      return apply_table_result
    end
    let objs = list_push(objs, apply_table_obj_path)
    return x64_link_objs(objs, runtime_obj_path, out_path)
  end

  # build_native(self, funcs, rt_names, runtime_asm_path, out_path) --
  # the self-hosted-toolchain (x64_asm.patlang/x64_pe_link.patlang)
  # analogue of build() above: same per-function cache-hit-or-fresh-
  # assemble shape (ensure_chunk_native instead of ensure_obj), same
  # apply-table generation, but produces in-memory ChunkImages and links
  # them via x64_link_native_chunks -- no nasm/gcc subprocess anywhere
  # in this path. Takes the RUNTIME'S OWN ASM SOURCE PATH (not a
  # pre-built .obj -- this linker has no COFF reader, so
  # self_hosting/build/x64_runtime.asm, written by build_x64_runtime.
  # patlang regardless of which toolchain built its cached .obj, is
  # assembled into a ChunkImage here directly), matching
  # x64_link_native_chunks's own documented requirement.
  #
  # No non-blocking spawn()/parallelism here (unlike build() above) --
  # x64_assemble_chunk runs synchronously, in-process, with no
  # subprocess to overlap; ensure_chunk_native's own on-disk JSON cache
  # is what keeps a rebuild of an otherwise-unchanged function cheap.
  make a function called build_native takes self, funcs, rt_names, runtime_asm_path, out_path returns result
    let cache = get(self, "cache")
    let cache_dir = get(cache, "cache_dir")
    let runtime_asm = read_file(runtime_asm_path)
    let runtime_chunk = x64_assemble_chunk(runtime_asm)
    if not runtime_chunk then
      return "ASM ERROR: x64_assemble_chunk failed for runtime asm " + runtime_asm_path
    end
    let chunks = [runtime_chunk]
    let n = funcs.length
    let i = 0
    while i < n do
      let unit = x64_make_compile_unit(funcs[i])
      let extern_names = x64_extern_names_for(funcs, i, rt_names)
      let chunk_or_err = send(unit, "ensure_chunk_native", cache_dir, extern_names)
      # chunk_or_err is either a ChunkImage (a list) or an "ASM ERROR:"-
      # prefixed string -- check via type_of() rather than
      # x64_build_contains, which assumes a plain string and would fail
      # calling substr() on a list.
      if type_of(chunk_or_err) == "string" then
        return chunk_or_err
      end
      let chunks = list_push(chunks, chunk_or_err)
      let i = i + 1
    end
    let apply_table_asm = x64_emit_apply_table_asm(funcs)
    let apply_table_chunk = x64_assemble_chunk(apply_table_asm)
    if not apply_table_chunk then
      return "ASM ERROR: x64_assemble_chunk failed for the apply table"
    end
    let chunks = list_push(chunks, apply_table_chunk)
    return x64_link_native_chunks(chunks, out_path)
  end
}
