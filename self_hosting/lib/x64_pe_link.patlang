include "x64_asm.patlang"

# ---- Minimal PE32+ linker for PatLang-assembled x64 chunks ---------------
#
# Replaces gcc-as-linker for exactly the shape x64_build.patlang needs: one
# or more ChunkImage records (see x64_asm.patlang) produced by
# x64_assemble_chunk, plus a fixed list of DLL imports, merged into a
# single working PE32+ .exe. Not a general linker -- no arbitrary object
# file formats, no static libraries, no ordinal imports, always
# import-by-name, no base relocation table (ASLR off, fixed ImageBase),
# matching what the design plan scoped for Phase 1.
#
# Entry point is set directly to the "main" symbol (the program is
# CRT-less and calls ExitProcess itself -- confirmed safe by inspecting
# bootstrap/hello_bootstrap.asm, which ends every path via `call
# ExitProcess`, never `ret`).

make a function called xpl_section_span takes raw_size, section_align returns span
  let floored = raw_size
  if floored < 1 then
    let floored = 1
  end
  return xpl_round_up(floored, section_align)
end

make a function called xpl_round_up takes v, boundary returns r
  let rem = v % boundary
  if rem == 0 then
    return v
  end
  return v + (boundary - rem)
end

make a function called xpl_emit_u16 takes lst, v returns out
  return xa_emit_bytes(lst, xa_int_to_bytes_le(v, 2))
end

make a function called xpl_emit_u32 takes lst, v returns out
  return xa_emit_bytes(lst, xa_int_to_bytes_le(v, 4))
end

make a function called xpl_emit_u64 takes lst, v returns out
  return xa_emit_bytes(lst, xa_int_to_bytes_le(v, 8))
end

make a function called xpl_ascii_bytes takes s returns bytes
  let out = []
  let i = 0
  while i < s.length do
    let out = list_push(out, char_code(s, i))
    let i = i + 1
  end
  return out
end

make a function called xpl_pad_to takes lst, n returns out
  let out = lst
  while to_num(list_len(out)) < n do
    let out = list_push(out, 0)
  end
  return out
end

# ---- symbol table ----
#
# Real bug found (session 8, native-toolchain cutover): the built-in
# "Dict" class (a host-level/Rust construct, no PatLang source of its
# own to inspect) silently returned a WRONG value for a genuinely-set
# key once this symbol table grew to real-program scale (hundreds of
# entries across multiple chunks) -- confirmed directly: a chunk-local
# symbol's own correctly-registered offset did not come back out of a
# later `get` for the exact same key. A follow-up hand-rolled CLASS
# (mutating `self.field` inside a method) ALSO failed once compiled,
# despite round-tripping correctly under the trusted INTERPRETER --
# never actually proven correct through patc1.exe's own compiled body,
# only through `pat --ir-run`, the same class of gap this session's
# other two bugs (shl/shr/sar-by-cl; the negative-imm64 2^64 overflow)
# already showed can hide a compiled-only defect. The fix that actually
# held: avoid BOTH Dict and any new class/`send`-based abstraction, and
# use the exact same plain-parallel-lists-plus-linear-scan shape
# already proven correct, compiled, in x64_link's own body for
# `all_symbols`/`all_relocs`/`local_names` -- two parallel lists (names,
# values) threaded through as ordinary function-local variables via
# `let x = list_push(x, ...)`, looked up with this one helper. A linear
# scan isn't the fastest structure for a few hundred entries, but this
# runs once per build, not once per program execution -- correctness
# matters far more than micro-optimizing a compile-time lookup here.
make a function called xpl_list_lookup takes names, values, target returns v_or_false
  let i = 0
  let n = to_num(list_len(names))
  while i < n do
    if names[i] == target then
      return values[i]
    end
    let i = i + 1
  end
  return false
end

# ---- bucketed symbol index ----
#
# xpl_list_lookup above is a LINEAR scan, and the relocation loop calls
# it once per relocation against the WHOLE merged symbol table. That is
# quadratic in program size, and at real self-hosted-compiler-bundle
# scale it stops being a footnote and becomes the entire build: linking
# the ~330-function compiler (513 chunks, tens of thousands of symbols
# and relocations) sat in that one loop for over an hour and 45 minutes,
# single-threaded, while the per-function ASSEMBLY phase that precedes
# it had finished in about 24 minutes. Measured, not assumed -- the
# per-unit .chunk.json cache files stop being written the moment
# assembly ends, so their newest timestamp dates the phase boundary
# exactly.
#
# Fixed by bucketing the symbol table once up front and scanning only
# the matching bucket. Deliberately hand-rolled over plain lists rather
# than reaching for the Dict host type: Dict was found to silently lose
# or misresolve entries when compiled at scale in this codebase (see
# patlang-x64-selfhosted-assembler-phase1 memory), which is exactly why
# the symbol table is a pair of parallel lists in the first place.
# GitHub #197's own string-label fix (codegen_x64.patlang's
# x64_string_label_for) made string-literal symbol names much longer
# ("S_funcname_i" instead of "S42"), which exposed a pre-existing O(n^2)
# trap here: char_code(s, i) re-checks s.is_ascii() over the WHOLE
# string on EVERY call (rust-runtime/src/ir/hosts.rs), so hashing an
# n-char name cost O(n^2), not O(n) -- harmless at "S42"'s length, not
# at a full function name's. Fixed by interning once (str_intern, which
# does the is_ascii/char-split work ONCE) and reading bytes via sc_code,
# which is genuinely O(1) per character.
make a function called xpl_hash_bucket takes s, nbuckets returns idx
  let handle = str_intern(s)
  let h = 5381
  let n = to_num(sc_len(handle))
  let i = 0
  while i < n do
    let h = (h * 33 + sc_code(handle, i)) % 999999937
    let i = i + 1
  end
  return h % nbuckets
end

make a function called xpl_vec_lookup takes names_vec, values_vec, target returns v_or_false
  let i = 0
  let n = vec_len(names_vec)
  while i < n do
    if vec_get(names_vec, i) == target then
      return vec_get(values_vec, i)
    end
    let i = i + 1
  end
  return false
end

make a function called xpl_build_index takes names, values returns index
  # ~8 names per bucket at the compiler bundle's own symbol count; the
  # bucket lists stay short enough that the residual per-bucket linear
  # scan is genuinely cheap, without allocating an absurd number of
  # empty lists for a small program.
  #
  # Each bucket is a vec_* handle (mutable, O(1)-amortized push), not a
  # plain List. A plain List made this whole function O(n_buckets *
  # n_symbols): list_set(bn, k, ...) copies the ENTIRE 4096-slot OUTER
  # list on every single insertion (List's copy-on-write semantics),
  # not just the one bucket being appended to. Confirmed as the
  # dominant cost of EVERY --x64 compile, not just the self-hosted
  # compiler's own ~330-function bundle this function's own header
  # already profiled once before: a trivial, few-line user program pays
  # the same ~100s+ cost here, since this scales with x64_runtime.obj's
  # own total symbol count (tens of thousands), not the user program's
  # size (confirmed via a live x64_build_status poll showing the build
  # parked in "link-index-symbols" for the entire duration). Same
  # List-in-a-hot-loop anti-pattern already documented for Strings
  # (project CLAUDE.md's "String Building" section) and already fixed
  # elsewhere for exactly this shape (bench_listbuild.patlang's own
  # header) -- vec_* was already the established answer, just not
  # applied here yet. Still deliberately not Dict, per this file's own
  # header note just above.
  let nbuckets = 4096
  let bn = vec_new()
  let bv = vec_new()
  let b = 0
  while b < nbuckets do
    vec_push(bn, vec_new())
    vec_push(bv, vec_new())
    let b = b + 1
  end
  let n = to_num(list_len(names))
  let j = 0
  while j < n do
    let k = xpl_hash_bucket(names[j], nbuckets)
    vec_push(vec_get(bn, k), names[j])
    vec_push(vec_get(bv, k), values[j])
    let j = j + 1
  end
  return [bn, bv, nbuckets]
end

make a function called xpl_index_lookup takes index, target returns v_or_false
  let k = xpl_hash_bucket(target, index[2])
  return xpl_vec_lookup(vec_get(index[0], k), vec_get(index[1], k), target)
end

# ---- layout + link ----
#
# chunks: list of ChunkImage (see x64_asm.patlang header comment)
# import_spec: [ [dll_name, [func_name, ...]], ... ]
# entry_symbol: name of the label to use as the PE entry point (usually "main")
# out_path: where to write the final .exe
#
# Returns out_path on success, or a string starting with "LINK ERROR:"
# on failure.
make a function called x64_link takes chunks, import_spec, entry_symbol, out_path returns result
  let image_base = 5368709120
  let section_align = 4096
  let file_align = 512

  # ---- Pass 1: concatenate chunk sections, recording each chunk's base
  # offset within the merged text/data/bss regions and every symbol's
  # ABSOLUTE offset within its section (not yet an RVA -- the section's
  # own RVA is only known after import-table size is decided below).
  # merged_text/merged_data/all_symbols/all_relocs are vec_* handles, not
  # plain Lists, and every chunk's own text/data bytes are copied in via
  # vec_extend (one bulk call per chunk) rather than a per-byte loop.
  # GitHub #75's own fix (inlining this loop instead of calling
  # xa_emit_bytes once per chunk) addressed the OUTER per-chunk
  # function-call cost; this addresses the INNER one-call-per-byte cost
  # the same way, for the same reason (a CallHost dispatch per byte, not
  # per chunk). This specific change was NOT the fix for the ~100-second
  # --x64 compile-time regression investigated 2026-10-19 -- isolated
  # standalone timing proved list_push/vec_push called 531K times takes
  # a fraction of a second either way; the real cause, found by
  # instrumenting further once this change alone didn't move the
  # measured time at all, was list_contains_str's own linear scan a few
  # dozen lines down (see its own comment there). Kept anyway: avoiding
  # one host-call dispatch per byte of a ~531KB buffer is a real,
  # independently worthwhile improvement, just not the dominant one here.
  let merged_text = vec_new()
  let merged_data = vec_new()
  let merged_bss = 0
  let all_symbols = vec_new()
  let all_relocs = vec_new()
  let ci = 0
  let cn = to_num(list_len(chunks))
  while ci < cn do
    let chunk = chunks[ci]
    let text_base = vec_len(merged_text)
    let data_base = vec_len(merged_data)
    let bss_base = merged_bss
    vec_extend(merged_text, chunk[1])
    vec_extend(merged_data, chunk[2])
    let merged_bss = merged_bss + chunk[3]

    # Real bug found (session 8, native-toolchain cutover): every chunk
    # is assembled independently, and x64_string_label_for() (codegen_
    # x64.patlang) derives its labels from THIS chunk's own func_name+
    # instruction-index pairs, starting again from "S_<fn>_0" for every
    # emit_program_x64() call -- meaning the runtime chunk's own string
    # labels and the SEPARATE per-function program chunks' own string
    # labels (each function is its own tiny "program" per x64_compile_
    # unit.patlang's ensure_chunk_native) can still reuse the exact same
    # bare names across chunks (same func_name, e.g. two chunks each
    # defining their own "main"). None of these
    # are ever declared `global` (only real cross-chunk references like
    # function names are), so `is_global` (sym[3]) is false for all of
    # them -- but this flat symbol table used to key EVERY symbol by its
    # bare name regardless, so chunk B's own "S0" would silently
    # OVERWRITE chunk A's "S0" in the shared Dict the moment both
    # chunks' symbols were collected, corrupting any relocation in chunk
    # A that referenced its own "S0" to point at chunk B's data instead.
    # NASM never hits this because a real .obj file gives every non-
    # `global` label real LOCAL (file-scoped) symbol visibility -- this
    # simple linker's one flat table had no equivalent scoping. Fixed by
    # giving every NON-global symbol (and every reloc target that
    # resolves to one) a chunk-unique prefix, so same-named locals from
    # different chunks never collide; only genuinely `global` names
    # (still bare) are visible across chunk boundaries, matching real
    # symbol-visibility semantics.
    let syms = chunk[4]
    let local_names = []
    let si = 0
    let sn = to_num(list_len(syms))
    while si < sn do
      let sym = syms[si]
      let name = sym[0]
      let section = sym[1]
      let offset = sym[2]
      let is_global = sym[3]
      let base = text_base
      if section == "data" then
        let base = data_base
      else
        if section == "bss" then
          let base = bss_base
        end
      end
      let key = name
      if not is_global then
        let key = "$L" + ci + "$" + name
        let local_names = list_push(local_names, name)
      end
      vec_push(all_symbols, [key, section, base + offset])
      let si = si + 1
    end

    # Real bug found (2026-10-19, same investigation as the chunk-merge
    # fix above): list_contains_str(local_names, target) below was a
    # LINEAR SCAN over local_names, called once per RELOCATION -- for
    # the runtime chunk specifically (tens of thousands of local symbols
    # AND tens of thousands of relocations), that is tens of millions of
    # string comparisons per --x64 compile, dominating the whole link
    # step (confirmed via direct timing: ~98 of ~100 seconds, isolated
    # precisely to this one loop). Completely unrelated to the chunk-
    # merge/list_push issue above -- found only by instrumenting further
    # once fixing that one didn't move the measured time at all. Fixed
    # the same way xpl_build_index already fixes the equivalent problem
    # for the full symbol table: index local_names ONCE per chunk,
    # rather than linear-scanning it once per relocation. Values don't
    # matter for a membership check -- local_names doubles as its own
    # value list; xpl_index_lookup returning anything other than `false`
    # means "found".
    let local_names_index = xpl_build_index(local_names, local_names)
    let relocs = chunk[5]
    let ri = 0
    let rn = to_num(list_len(relocs))
    while ri < rn do
      let reloc = relocs[ri]
      let section = reloc[0]
      let offset = reloc[1]
      let target = reloc[2]
      let kind = reloc[3]
      let addend = reloc[4]
      let base = text_base
      if section == "data" then
        let base = data_base
      end
      let target_key = target
      if xpl_index_lookup(local_names_index, target) != false then
        let target_key = "$L" + ci + "$" + target
      end
      vec_push(all_relocs, [section, base + offset, target_key, kind, addend])
      let ri = ri + 1
    end
    let ci = ci + 1
  end

  # ---- Import-thunk generation: one 6-byte `jmp [rel iat_slot]`
  # (FF 25 disp32) per imported function, placed at the START of .text
  # so their RVAs are known before user code offsets are rebased.
  let thunk_names = []
  let di = 0
  let dn = to_num(list_len(import_spec))
  while di < dn do
    let dll_entry = import_spec[di]
    let funcs = dll_entry[1]
    let fi = 0
    let fcount = to_num(list_len(funcs))
    while fi < fcount do
      let thunk_names = list_push(thunk_names, funcs[fi])
      let fi = fi + 1
    end
    let di = di + 1
  end
  let thunk_area_size = to_num(list_len(thunk_names)) * 6

  # ---- Section RVA layout ----
  #
  # Every section this linker declares is unconditional (always exactly
  # 4: .text/.data/.bss/.idata), so each one must reserve at least one
  # full page of RVA space even when its real content is empty (e.g. a
  # pure-arithmetic test program with no globals at all has zero .data
  # and zero .bss) -- xpl_round_up(0, section_align) is 0, which would
  # make the NEXT section start at the exact same RVA as this one,
  # producing overlapping sections. objdump tolerates reading a file
  # like that; the real Windows loader does not ("Exec format error"),
  # confirmed directly. xpl_section_span floors at one page.
  let headers_size = xpl_round_up(1024, file_align)
  let text_rva = section_align
  let text_size_raw = thunk_area_size + vec_len(merged_text)
  let text_size = xpl_round_up(text_size_raw, file_align)
  let data_rva = text_rva + xpl_section_span(text_size_raw, section_align)
  let data_size_raw = vec_len(merged_data)
  let data_size = xpl_round_up(data_size_raw, file_align)
  let bss_rva = data_rva + xpl_section_span(data_size_raw, section_align)
  let bss_size_raw = merged_bss
  let idata_rva = bss_rva + xpl_section_span(bss_size_raw, section_align)

  # ---- Build .idata content: Import Directory Table, then per-DLL
  # ILT, IAT, Hint/Name entries, then DLL name strings -- offsets
  # within .idata are computed in a fixed, pre-planned order so every
  # cross-reference (descriptor -> ILT/IAT/name) can be resolved before
  # any bytes are emitted.
  let num_dlls = to_num(list_len(import_spec))
  let descriptors_size = (num_dlls + 1) * 20
  let dll_thunk_offsets = []
  let running = descriptors_size
  let di = 0
  while di < num_dlls do
    let funcs = import_spec[di][1]
    let count = to_num(list_len(funcs)) + 1
    let dll_thunk_offsets = list_push(dll_thunk_offsets, running)
    let running = running + (count * 8)
    let di = di + 1
  end
  let ilt_offsets = dll_thunk_offsets
  let iat_offsets = []
  let iat_region_start = running
  let di = 0
  while di < num_dlls do
    let funcs = import_spec[di][1]
    let count = to_num(list_len(funcs)) + 1
    let iat_offsets = list_push(iat_offsets, running)
    let running = running + (count * 8)
    let di = di + 1
  end
  let iat_region_size = running - iat_region_start
  let hintname_offsets = []
  let di = 0
  while di < num_dlls do
    let funcs = import_spec[di][1]
    let per_dll = []
    let fi = 0
    let fcount = to_num(list_len(funcs))
    while fi < fcount do
      let per_dll = list_push(per_dll, running)
      let entry_len = 2 + funcs[fi].length + 1
      let running = running + xpl_round_up(entry_len, 2)
      let fi = fi + 1
    end
    let hintname_offsets = list_push(hintname_offsets, per_dll)
    let di = di + 1
  end
  let dllname_offsets = []
  let di = 0
  while di < num_dlls do
    let dllname_offsets = list_push(dllname_offsets, running)
    let running = running + import_spec[di][0].length + 1
    let di = di + 1
  end
  let idata_size_raw = running

  # ---- Emit .idata bytes ----
  let idata = []
  let di = 0
  while di < num_dlls do
    let idata = xpl_emit_u32(idata, idata_rva + ilt_offsets[di])
    let idata = xpl_emit_u32(idata, 0)
    let idata = xpl_emit_u32(idata, 0)
    let idata = xpl_emit_u32(idata, idata_rva + dllname_offsets[di])
    let idata = xpl_emit_u32(idata, idata_rva + iat_offsets[di])
    let di = di + 1
  end
  let idata = xpl_pad_to(idata, descriptors_size)

  let di = 0
  while di < num_dlls do
    let funcs = import_spec[di][1]
    let hn = hintname_offsets[di]
    let fi = 0
    let fnn = to_num(list_len(funcs))
    while fi < fnn do
      let idata = xpl_emit_u64(idata, idata_rva + hn[fi])
      let fi = fi + 1
    end
    let idata = xpl_emit_u64(idata, 0)
    let di = di + 1
  end

  # Real bug found (session 8, native-toolchain cutover): the built-in
  # "Dict" class (a host-level/Rust construct with no PatLang source of
  # its own) silently lost or misresolved entries once COMPILED into
  # patc1.exe at real-program scale (confirmed: a basic get/set round-
  # trip that worked perfectly under the trusted interpreter came back
  # `false` for everything once compiled). A hand-rolled class-based
  # replacement (mutating `self.field` inside a method) ALSO failed
  # once compiled, even though it round-tripped correctly under the
  # interpreter -- never actually proven correct THROUGH patc1.exe
  # itself, only through `pat --ir-run`, which is exactly the kind of
  # gap this session's other two bugs (shl/shr/sar-by-cl; the negative-
  # imm64 2^64 overflow) already showed can hide a compiled-only
  # defect. Rather than trust ANY new abstraction without a compiled
  # proof, this now uses the exact same plain-parallel-lists-plus-
  # linear-scan shape ALREADY PROVEN correct, compiled, in THIS SAME
  # FUNCTION for `all_symbols`/`all_relocs`/`local_names` above -- no
  # class, no `send`, no Dict, just `let x = list_push(x, ...)` at this
  # function's own top level.
  let iat_names = []
  let iat_values = []
  let di = 0
  while di < num_dlls do
    let funcs = import_spec[di][1]
    let base_off = iat_offsets[di]
    let fi = 0
    let fnn = to_num(list_len(funcs))
    while fi < fnn do
      let iat_names = list_push(iat_names, funcs[fi])
      let iat_values = list_push(iat_values, idata_rva + base_off + (fi * 8))
      let fi = fi + 1
    end
    let di = di + 1
  end
  let di = 0
  while di < num_dlls do
    let funcs = import_spec[di][1]
    let hn = hintname_offsets[di]
    let fi = 0
    let fnn = to_num(list_len(funcs))
    while fi < fnn do
      let idata = xpl_emit_u64(idata, idata_rva + hn[fi])
      let fi = fi + 1
    end
    let idata = xpl_emit_u64(idata, 0)
    let di = di + 1
  end

  let di = 0
  while di < num_dlls do
    let funcs = import_spec[di][1]
    let fi = 0
    let fnn = to_num(list_len(funcs))
    while fi < fnn do
      let idata = xpl_emit_u16(idata, 0)
      let idata = xa_emit_bytes(idata, xpl_ascii_bytes(funcs[fi]))
      let idata = list_push(idata, 0)
      if (to_num(list_len(idata)) % 2) != 0 then
        let idata = list_push(idata, 0)
      end
      let fi = fi + 1
    end
    let di = di + 1
  end

  let di = 0
  while di < num_dlls do
    let idata = xa_emit_bytes(idata, xpl_ascii_bytes(import_spec[di][0]))
    let idata = list_push(idata, 0)
    let di = di + 1
  end
  let idata = xpl_pad_to(idata, idata_size_raw)
  let idata_size = xpl_round_up(idata_size_raw, file_align)

  # ---- Import thunks (start of .text) ----
  let thunks = []
  let ti = 0
  let tn = to_num(list_len(thunk_names))
  while ti < tn do
    let thunk_rva = text_rva + (ti * 6)
    let iat_slot_rva = xpl_list_lookup(iat_names, iat_values, thunk_names[ti])
    let disp = iat_slot_rva - (thunk_rva + 6)
    let thunks = xpl_emit_u16(thunks, 9727)
    let thunks = xpl_emit_u32(thunks, disp)
    let iat_names = list_push(iat_names, "$thunk$" + thunk_names[ti])
    let iat_values = list_push(iat_values, thunk_rva)
    let ti = ti + 1
  end

  # ---- Flat symbol table: user symbols (rebased to final RVAs) plus
  # one thunk-symbol per import (so a `call SomeImport` reloc resolves
  # exactly like a `call SomeLocalFunction` reloc -- no special-casing
  # needed at the point a relocation is patched, only here at table-
  # build time).
  let symtab_names = []
  let symtab_values = []
  let si = 0
  let sn = vec_len(all_symbols)
  while si < sn do
    let sym = vec_get(all_symbols, si)
    let name = sym[0]
    let section = sym[1]
    let offset = sym[2]
    let base_rva = text_rva + thunk_area_size
    if section == "data" then
      let base_rva = data_rva
    else
      if section == "bss" then
        let base_rva = bss_rva
      end
    end
    let symtab_names = list_push(symtab_names, name)
    let symtab_values = list_push(symtab_values, base_rva + offset)
    let si = si + 1
  end
  let ti = 0
  while ti < tn do
    let symtab_names = list_push(symtab_names, thunk_names[ti])
    let symtab_values = list_push(symtab_values, xpl_list_lookup(iat_names, iat_values, "$thunk$" + thunk_names[ti]))
    let ti = ti + 1
  end

  # ---- Patch relocations directly into merged_text / merged_data ----
  # Index the finished symbol table ONCE here, rather than linear-scanning
  # it per relocation inside the loop below (see xpl_build_index's own
  # header for the measured cost of not doing this).
  let unused_pidx = x64_build_progress("link-index-symbols", 0, to_num(list_len(symtab_names)))
  let symtab_index = xpl_build_index(symtab_names, symtab_values)
  let ri = 0
  let rn = vec_len(all_relocs)
  # Reported every 500 relocations rather than every one: enough
  # resolution to see the loop advancing (or not) on a build that takes
  # minutes, without paying a status update per iteration on the
  # hottest loop in the linker.
  let unused_prel = x64_build_progress("link-relocations", 0, rn)
  while ri < rn do
    if (ri % 500) == 0 then
      let unused_pr = x64_build_progress("link-relocations", ri, rn)
    else
      if (ri % 50) == 0 then
        x64_build_tick()
      end
    end
    let reloc = vec_get(all_relocs, ri)
    let section = reloc[0]
    let offset = reloc[1]
    let target = reloc[2]
    let kind = reloc[3]
    let addend = reloc[4]
    let target_rva = xpl_index_lookup(symtab_index, target)
    if not target_rva then
      # Distinguish the two very different reasons a lookup can miss,
      # rather than reporting both as "undefined symbol". A bare linear
      # scan of the same table answers it definitively: if the name IS
      # there, the bucket index disagreed between build and lookup (a
      # real defect in the indexing, and the error should say so
      # instead of blaming the symbol); if it genuinely is not there,
      # the reference really is dangling. This costs one linear scan on
      # a path that is about to abort anyway.
      let linear_rva = xpl_list_lookup(symtab_names, symtab_values, target)
      if not linear_rva then
        return "LINK ERROR: undefined symbol '" + target + "' (not present in the symbol table at all; reloc " + ri + " of " + rn + ", section " + section + ", kind " + kind + ")"
      end
      return "LINK ERROR: symbol index inconsistency for '" + target + "' -- present in the symbol table (rva " + linear_rva + ") but the hash index did not find it; build bucket and lookup bucket disagree (reloc " + ri + " of " + rn + ")"
    end
    # Patched INLINE, deliberately, rather than through xpl_patch_bytes
    # (see GitHub #75 -- unchanged reasoning, still correct: handing an
    # accumulator through a function call that returns it copies it in
    # full on every call). A SEPARATE, deeper bug in the same spot was
    # found and fixed one level down instead of here (issue #89's
    # linker-scaling follow-up, 2026-09-06): plain `list_set`, when
    # compiled via --x64, routed to x64_runtime.patlang's own
    # rt_list_set_functional, which UNCONDITIONALLY reallocated and
    # copied every element of the WHOLE list on every single call, with
    # no in-place fast path at all (unlike rt_list_push, which mutates
    # in place whenever capacity allows). Calling it once per patched
    # byte (4-8 times per relocation) against `merged_text`/`merged_data`
    # -- potentially megabytes -- made this loop O(relocations *
    # image_size), not O(relocations): confirmed directly via
    # self_hosting/examples/x64_linker_scaling_probe.exe (1500 synthetic
    # one-function chunks fine, 1800 exhausts a 1.9GB heap). Fixed at the
    # actual source, rt_list_set_functional's own body in x64_runtime.
    # patlang, so every caller of plain `list_set` -- this loop, and
    # codegen_x64.patlang's x64_vstack_push/x64_analyze_dynamic_bins --
    # benefits without needing to change anything here.
    if kind == "ABS64" then
      let value_bytes = xa_int_to_bytes_le(image_base + target_rva + addend, 8)
      let bi = 0
      while bi < 8 do
        vec_set(merged_data, offset + bi, value_bytes[bi])
        let bi = bi + 1
      end
    else
      let reloc_rva = text_rva + thunk_area_size + offset
      let value = (target_rva + addend) - (reloc_rva + 4)
      let value_bytes = xa_int_to_bytes_le(value, 4)
      let bi = 0
      while bi < 4 do
        vec_set(merged_text, offset + bi, value_bytes[bi])
        let bi = bi + 1
      end
    end
    let ri = ri + 1
  end

  let entry_rva = xpl_index_lookup(symtab_index, entry_symbol)
  if not entry_rva then
    return "LINK ERROR: entry symbol '" + entry_symbol + "' not defined"
  end

  # ---- Assemble final image ----
  let idata_datadir_size = descriptors_size
  let sizeof_image = xpl_round_up(idata_rva + idata_size_raw, section_align)

  let text_file_offset = headers_size
  let data_file_offset = headers_size + text_size
  let idata_file_offset = headers_size + text_size + data_size

  let hdr = xpl_build_headers(headers_size, image_base, section_align, file_align,
    entry_rva, sizeof_image,
    text_rva, text_size, thunk_area_size + vec_len(merged_text), text_file_offset,
    data_rva, data_size, data_size_raw, data_file_offset,
    bss_rva, xpl_round_up(bss_size_raw, section_align),
    idata_rva, idata_size, idata_size_raw, idata_datadir_size, idata_file_offset,
    iat_region_start, iat_region_size)

  # One conversion back to a plain List each, here at the very end where
  # xa_emit_bytes needs List indexing -- a single O(n) copy, not one per
  # byte, so none of the cost this whole function exists to avoid.
  let merged_text_list = vec_to_list(merged_text)
  let merged_data_list = vec_to_list(merged_data)
  let out = xpl_pad_to(hdr, headers_size)
  let out = xa_emit_bytes(out, thunks)
  let out = xa_emit_bytes(out, merged_text_list)
  let out = xpl_pad_to(out, headers_size + text_size)
  let out = xa_emit_bytes(out, merged_data_list)
  let out = xpl_pad_to(out, headers_size + text_size + data_size)
  let out = xa_emit_bytes(out, idata)
  let out = xpl_pad_to(out, headers_size + text_size + data_size + idata_size)

  let ok = write_file_bytes(out_path, out)
  if not ok then
    return "LINK ERROR: write_file_bytes failed for " + out_path
  end
  return out_path
end

make a function called xpl_patch_bytes takes lst, offset, value_bytes returns out
  let out = lst
  let i = 0
  let n = to_num(list_len(value_bytes))
  while i < n do
    let out = list_set(out, offset + i, value_bytes[i])
    let i = i + 1
  end
  return out
end

# ---- PE header construction ----
#
# text_raw/data_raw/idata_raw are the ACTUAL content sizes (before
# file-alignment padding) -- PE's SizeOfRawData per section is the
# padded size, but VirtualSize is the real, unpadded size.
make a function called xpl_build_headers takes headers_size, image_base, section_align, file_align, entry_rva, sizeof_image, text_rva, text_size, text_raw, text_file_offset, data_rva, data_size, data_raw, data_file_offset, bss_rva, bss_virtual_size, idata_rva, idata_size, idata_raw, idata_datadir_size, idata_file_offset, iat_region_start, iat_region_size returns bytes
  let b = []
  # DOS header: MZ + e_lfanew at offset 0x3C pointing past a 64-byte stub.
  let b = xa_emit_bytes(b, [77, 90])
  let b = xpl_pad_to(b, 60)
  let b = xpl_emit_u32(b, 64)

  # PE signature
  let b = xa_emit_bytes(b, [80, 69, 0, 0])

  # COFF File Header
  let b = xpl_emit_u16(b, 34404)
  let b = xpl_emit_u16(b, 4)
  let b = xpl_emit_u32(b, 0)
  let b = xpl_emit_u32(b, 0)
  let b = xpl_emit_u32(b, 0)
  let b = xpl_emit_u16(b, 240)
  let b = xpl_emit_u16(b, 34)

  # Optional Header (PE32+)
  let b = xpl_emit_u16(b, 523)
  let b = xa_emit_bytes(b, [0, 0])
  let b = xpl_emit_u32(b, text_size)
  let b = xpl_emit_u32(b, data_size + idata_size)
  let b = xpl_emit_u32(b, bss_virtual_size)
  let b = xpl_emit_u32(b, entry_rva)
  let b = xpl_emit_u32(b, text_rva)
  let b = xpl_emit_u64(b, image_base)
  let b = xpl_emit_u32(b, section_align)
  let b = xpl_emit_u32(b, file_align)
  let b = xpl_emit_u16(b, 6)
  let b = xpl_emit_u16(b, 0)
  let b = xpl_emit_u16(b, 0)
  let b = xpl_emit_u16(b, 0)
  let b = xpl_emit_u16(b, 6)
  let b = xpl_emit_u16(b, 0)
  let b = xpl_emit_u32(b, 0)
  let b = xpl_emit_u32(b, sizeof_image)
  let b = xpl_emit_u32(b, headers_size)
  let b = xpl_emit_u32(b, 0)
  let b = xpl_emit_u16(b, 3)
  let b = xpl_emit_u16(b, 256)
  let b = xpl_emit_u64(b, 1048576)
  let b = xpl_emit_u64(b, 4096)
  let b = xpl_emit_u64(b, 1048576)
  let b = xpl_emit_u64(b, 4096)
  let b = xpl_emit_u32(b, 0)
  let b = xpl_emit_u32(b, 16)

  let dd = 0
  while dd < 16 do
    if dd == 1 then
      let b = xpl_emit_u32(b, idata_rva)
      let b = xpl_emit_u32(b, idata_datadir_size)
    else
      if dd == 12 then
        let b = xpl_emit_u32(b, idata_rva + iat_region_start)
        let b = xpl_emit_u32(b, iat_region_size)
      else
        let b = xpl_emit_u32(b, 0)
        let b = xpl_emit_u32(b, 0)
      end
    end
    let dd = dd + 1
  end

  let text_virtual_size = text_raw
  if text_virtual_size < section_align then
    let text_virtual_size = section_align
  end
  let b = xpl_emit_section_header(b, ".text", text_virtual_size, text_rva, text_size, text_file_offset, 1610612768)
  # A section header's VirtualSize of exactly 0 is rejected by the real
  # Windows loader even though objdump tolerates it when just reading
  # the file -- confirmed directly: a program with no .data/.bss
  # content (e.g. a pure-arithmetic test with no globals) produced a
  # file objdump parsed fine but Windows refused to run ("Exec format
  # error"). Every section this linker ever declares is unconditional
  # (always exactly 4), so floor VirtualSize at one page whenever the
  # real content is smaller than that, rather than only emitting a
  # section header when there's real content -- simpler than making
  # NumberOfSections and the RVA layout conditional.
  let data_virtual_size = data_raw
  if data_virtual_size < section_align then
    let data_virtual_size = section_align
  end
  let bss_virtual_size_hdr = bss_virtual_size
  if bss_virtual_size_hdr < section_align then
    let bss_virtual_size_hdr = section_align
  end
  let b = xpl_emit_section_header(b, ".data", data_virtual_size, data_rva, data_size, data_file_offset, 3221225536)
  let b = xpl_emit_section_header(b, ".bss", bss_virtual_size_hdr, bss_rva, 0, 0, 3221225600)
  let idata_virtual_size = idata_raw
  if idata_virtual_size < section_align then
    let idata_virtual_size = section_align
  end
  let b = xpl_emit_section_header(b, ".idata", idata_virtual_size, idata_rva, idata_size, idata_file_offset, 3221225536)

  return b
end

# One 40-byte IMAGE_SECTION_HEADER: an 8-byte name (NUL-padded, not
# NUL-terminated if exactly 8 chars -- ".idata" fits with room to
# spare so this is never actually exercised at the boundary here),
# VirtualSize, VirtualAddress, SizeOfRawData, PointerToRawData, then
# four zeroed fields (relocations/linenumbers, unused for an EXE),
# and Characteristics.
make a function called xpl_emit_section_header takes b, name, virtual_size, rva, raw_size, raw_ptr, characteristics returns out
  let start = to_num(list_len(b))
  let out = xa_emit_bytes(b, xpl_ascii_bytes(name))
  let out = xpl_pad_to(out, start + 8)
  let out = xpl_emit_u32(out, virtual_size)
  let out = xpl_emit_u32(out, rva)
  let out = xpl_emit_u32(out, raw_size)
  let out = xpl_emit_u32(out, raw_ptr)
  let out = xpl_emit_u32(out, 0)
  let out = xpl_emit_u32(out, 0)
  let out = xpl_emit_u16(out, 0)
  let out = xpl_emit_u16(out, 0)
  let out = xpl_emit_u32(out, characteristics)
  return out
end
