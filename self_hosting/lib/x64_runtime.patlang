# x64_runtime.patlang -- runtime support for the native x64 backend
# (self_hosting/lib/codegen_x64.patlang), written in ORDINARY PatLang
# and compiled by that SAME backend, not hand-assembled and not an
# external Rust/C library. This file's functions are combined into the
# same ProgramIR as the user's own program before codegen_x64 ever
# runs, so calling rt_print_i64 from user code lowers to a completely
# ordinary ["Call", "rt_print_i64", 1] -- no different from calling any
# other PatLang function.
#
# This file is the ONLY place allowed to call the small, fixed set of
# primitive operations codegen_x64.patlang gives special native-codegen
# meaning to (everything else in this file is 100% ordinary PatLang):
#   mem_scratch_addr()              -> address of a fixed 256-byte
#                                       .bss scratch buffer (Slice 1
#                                       has no heap/allocator at all)
#   mem_poke_byte(addr, offset, v)  -> write one byte
#   mem_peek_byte(addr, offset)     -> read one byte
#   os_write_console_bytes(addr, n) -> write n bytes from addr to stdout
#   os_exit(code)                   -> ExitProcess
# See codegen_x64.patlang's own header for exactly how each of these
# five names gets special-cased; everywhere else in the whole pipeline,
# a function call is just a function call.

make a function called rt_int_to_string takes n, buf_addr returns len
  let is_neg = n < 0
  let v = n
  if is_neg then
    let v = 0 - v
  end
  let count = 0
  if v == 0 then
    mem_poke_byte(buf_addr, 0, 48)
    let count = 1
  else
    while v > 0 do
      let digit = v % 10
      mem_poke_byte(buf_addr, count, digit + 48)
      let v = v / 10
      let count = count + 1
    end
  end
  if is_neg then
    mem_poke_byte(buf_addr, count, 45)
    let count = count + 1
  end
  # Digits were written least-significant-first; reverse buf_addr[0..count)
  # in place so they read left-to-right, matching ordinary decimal text.
  let i = 0
  let j = count - 1
  while i < j do
    let a = mem_peek_byte(buf_addr, i)
    let b = mem_peek_byte(buf_addr, j)
    mem_poke_byte(buf_addr, i, b)
    mem_poke_byte(buf_addr, j, a)
    let i = i + 1
    let j = j - 1
  end
  return count
end

make a function called rt_print_i64 takes n returns done
  let buf = mem_scratch_addr()
  let len = rt_int_to_string(n, buf)
  mem_poke_byte(buf, len, 10)
  os_write_console_bytes(buf, len + 1)
  return true
end
