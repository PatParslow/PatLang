# x64_runtime.patlang -- runtime support for the native x64 backend
# (self_hosting/lib/codegen_x64.patlang), written in ORDINARY PatLang
# and compiled by that SAME backend, not hand-assembled and not an
# external Rust/C library. This file's functions are combined into the
# same ProgramIR as the user's own program before codegen_x64 ever
# runs, so calling rt_print_i64 from user code lowers to a completely
# ordinary ["Call", "rt_print_i64", 1] -- no different from calling any
# other PatLang function.
#
# This file is the ONLY place allowed to call the small, fixed set of
# primitive operations codegen_x64.patlang gives special native-codegen
# meaning to (everything else in this file is 100% ordinary PatLang):
#   mem_scratch_addr()              -> address of a fixed 256-byte
#                                       .bss scratch buffer
#   mem_poke_byte(addr, offset, v)  -> write one byte
#   mem_peek_byte(addr, offset)     -> read one byte
#   mem_heap_base()                 -> address of a fixed 16MB .bss
#                                       heap region -- one single OS-
#                                       free static reservation, NOT a
#                                       per-allocation OS call
#   mem_heap_state_addr()           -> address of a persistent 8-byte
#                                       "bytes used so far" counter
#   mem_poke_qword(addr, offset, v) -> write eight bytes
#   mem_peek_qword(addr, offset)    -> read eight bytes
#   os_write_console_bytes(addr, n) -> write n bytes from addr to stdout
#   os_exit(code)                   -> ExitProcess
# See codegen_x64.patlang's own header for exactly how each of these
# names gets special-cased; everywhere else in the whole pipeline, a
# function call is just a function call.
#
# HEAP ALLOCATOR: rt_heap_alloc below is a genuine bump allocator --
# real PatLang logic (round up to 8-byte alignment, add to a running
# total, return the old total as the new block's address), not
# something baked into the native backend. It never frees or reuses
# memory -- correct and simple for now (matches Slice 1's own
# "correctness over performance, prove the plumbing first" discipline),
# a real free-list/reuse scheme is a deliberately separate future
# change to THIS function alone, not to codegen_x64.patlang.

make a function called rt_int_to_string takes n, buf_addr returns len
  let is_neg = n < 0
  let v = n
  if is_neg then
    let v = 0 - v
  end
  let count = 0
  if v == 0 then
    mem_poke_byte(buf_addr, 0, 48)
    let count = 1
  else
    while v > 0 do
      let digit = v % 10
      mem_poke_byte(buf_addr, count, digit + 48)
      let v = v / 10
      let count = count + 1
    end
  end
  if is_neg then
    mem_poke_byte(buf_addr, count, 45)
    let count = count + 1
  end
  # Digits were written least-significant-first; reverse buf_addr[0..count)
  # in place so they read left-to-right, matching ordinary decimal text.
  let i = 0
  let j = count - 1
  while i < j do
    let a = mem_peek_byte(buf_addr, i)
    let b = mem_peek_byte(buf_addr, j)
    mem_poke_byte(buf_addr, i, b)
    mem_poke_byte(buf_addr, j, a)
    let i = i + 1
    let j = j - 1
  end
  return count
end

make a function called rt_heap_alloc takes size returns addr
  let state = mem_heap_state_addr()
  let used = mem_peek_qword(state, 0)
  let aligned_size = size
  let rem = aligned_size % 8
  if rem != 0 then
    let aligned_size = aligned_size + (8 - rem)
  end
  let addr = mem_heap_base() + used
  mem_poke_qword(state, 0, used + aligned_size)
  return addr
end

make a function called rt_print_i64 takes n returns done
  let buf = mem_scratch_addr()
  let len = rt_int_to_string(n, buf)
  mem_poke_byte(buf, len, 10)
  os_write_console_bytes(buf, len + 1)
  return true
end

# ---- strings (Slice 3, TAGGED as of the closures/strings/lists
# tagging migration) ----
#
# A string is a heap-allocated block: [8-byte length][raw bytes, not
# null-terminated]. Now carries a real tag -- family 0x2, reserved for
# exactly this since the original tag-layout design -- so a string
# value is dynamically self-describing like every other tagged value
# in this backend, not just an opaque raw address. String LITERALS
# are built by codegen_x64.patlang directly into .data (see that
# file's own header for where the tag gets OR'd onto the `lea`d
# address) -- everything below is genuine PatLang, masking the tag off
# before dereferencing (`s band rt_payload_mask()`) and OR'ing
# `rt_string_tag()` back onto any NEWLY CONSTRUCTED string's address
# before returning it.
#
# `+` on the IR's Bin instruction is STILL always integer addition
# (never string concatenation) even now that strings are tagged --
# codegen_x64.patlang's dynamic dispatch treats String (like List/
# Closure/Object) as identity-only, no arithmetic meaning, same
# deliberate scope limit as before, just now enforced by the tag
# scheme itself rather than by the complete absence of one. String
# concatenation is still this explicitly-named function.

make a function called rt_string_tag returns tag
  return 2 shl 60
end

make a function called rt_str_len takes s returns len
  let addr = s band rt_payload_mask()
  return mem_peek_qword(addr, 0)
end

make a function called rt_str_concat takes a, b returns result
  let addr_a = a band rt_payload_mask()
  let addr_b = b band rt_payload_mask()
  let len_a = rt_str_len(a)
  let len_b = rt_str_len(b)
  let total = len_a + len_b
  let result = rt_heap_alloc(8 + total)
  mem_poke_qword(result, 0, total)
  let i = 0
  while i < len_a do
    mem_poke_byte(result, 8 + i, mem_peek_byte(addr_a, 8 + i))
    let i = i + 1
  end
  let j = 0
  while j < len_b do
    mem_poke_byte(result, 8 + len_a + j, mem_peek_byte(addr_b, 8 + j))
    let j = j + 1
  end
  return result bor rt_string_tag()
end

make a function called rt_print_str takes s returns done
  let addr = s band rt_payload_mask()
  let len = rt_str_len(s)
  os_write_console_bytes(addr + 8, len)
  mem_poke_byte(mem_scratch_addr(), 0, 10)
  os_write_console_bytes(mem_scratch_addr(), 1)
  return true
end

# ---- shadowing host primitives (Slice 8 continued): sb_new/sb_push/
# sb_str, to_num, chr, substr, str_intern/sc_len/sc_code/sc_char ----
#
# These are ORDINARY PatLang functions sharing their exact names with
# Rust host primitives (rust-runtime/src/ir/hosts.rs) the x64 backend's
# x64_callhost_asm never natively supported -- confirmed (a dedicated
# shadow test, x64_shadow_test.patlang, compiled+run via --x64) that
# the lowerer only emits a CallHost for a name with NO user-level
# definition in scope, so defining these here (this file is ONLY ever
# prepended for --x64 compiles, so this can't affect the rustc-text
# backend or interpreter's own, correct, existing host functions) makes
# ORDINARY function-call codegen handle them -- no new hand-assembled
# asm needed for any of these (mem_sb_table_addr, added to
# codegen_x64.patlang's x64_callhost_asm alongside this, is the one
# genuinely new native primitive this whole batch needed). Each mirrors
# its Rust counterpart's semantics as closely as makes sense for this
# backend's actual tagged-value representation (fixnum-or-family-tag,
# not Rust's richer Value enum) -- documented per-function below.

# StringBuilder. Rust's host_sb_push has a fire-and-forget contract
# (returns Unit; existing call sites everywhere in codegen_x64.patlang
# do `sb_push(sb, "...")` as a bare statement, never `let sb =
# sb_push(...)`) -- so a handle's IDENTITY must survive across pushes
# even when its backing storage grows, unlike rt_list_push's own
# "caller rebinds the return value" contract. Design: a persistent
# global table (g_sb_table, an ordinary PatLang List value stored
# through the one dedicated .bss slot mem_sb_table_addr() -- see that
# primitive's own header in codegen_x64.patlang) holds each
# StringBuilder's CURRENT entry address; sb_new appends a fresh entry
# and returns its stable INDEX as the handle; sb_push looks the entry
# up by index, grows it (same amortized-doubling discipline as
# rt_list_push -- mutate in place when there's room, else reallocate),
# and writes the new address back into the table via rt_list_set ONLY
# when reallocation actually happened, so the handle (the table index)
# never needs to change.
make a function called sb_new returns handle
  let table_addr = mem_sb_table_addr()
  let table = mem_peek_qword(table_addr, 0)
  if table == 0 then
    let table = rt_list_new(0)
    mem_poke_qword(table_addr, 0, table)
  end
  let cap = 64
  let entry = rt_heap_alloc(16 + cap)
  mem_poke_qword(entry, 0, 0)
  mem_poke_qword(entry, 8, cap)
  let new_table = rt_list_push(table, entry)
  mem_poke_qword(table_addr, 0, new_table)
  return rt_list_len(new_table) - 1
end

make a function called sb_push takes handle, text returns done
  let table = mem_peek_qword(mem_sb_table_addr(), 0)
  let entry = rt_list_get(table, handle)
  let src = text band rt_payload_mask()
  let n = mem_peek_qword(src, 0)
  let len = mem_peek_qword(entry, 0)
  let cap = mem_peek_qword(entry, 8)
  if len + n <= cap then
    let i = 0
    while i < n do
      mem_poke_byte(entry, 16 + len + i, mem_peek_byte(src, 8 + i))
      let i = i + 1
    end
    mem_poke_qword(entry, 0, len + n)
    return true
  end
  let new_cap = cap * 2
  if new_cap < len + n then
    let new_cap = len + n
  end
  let new_entry = rt_heap_alloc(16 + new_cap)
  mem_poke_qword(new_entry, 0, len + n)
  mem_poke_qword(new_entry, 8, new_cap)
  let i = 0
  while i < len do
    mem_poke_byte(new_entry, 16 + i, mem_peek_byte(entry, 16 + i))
    let i = i + 1
  end
  let j = 0
  while j < n do
    mem_poke_byte(new_entry, 16 + len + j, mem_peek_byte(src, 8 + j))
    let j = j + 1
  end
  rt_list_set(table, handle, new_entry)
  return true
end

# Clones the buffer's current content into a fresh tagged string
# (matching Rust's `.clone()` sb_str -- safe to keep pushing to the same
# handle afterward, even though no existing call site actually does).
make a function called sb_str takes handle returns s
  let table = mem_peek_qword(mem_sb_table_addr(), 0)
  let entry = rt_list_get(table, handle)
  let len = mem_peek_qword(entry, 0)
  let result = rt_heap_alloc(8 + len)
  mem_poke_qword(result, 0, len)
  let i = 0
  while i < len do
    mem_poke_byte(result, 8 + i, mem_peek_byte(entry, 16 + i))
    let i = i + 1
  end
  return result bor rt_string_tag()
end

# to_num(v): if v is already numeric (fixnum, or ANY Numeric-family
# tagged value -- BigInt/Rational/Complex/Interval), returns it
# unchanged, matching Rust's own "preserve the value's own numeric
# kind" behaviour. If v is a String, parses it as an integer (ASCII
# digits, optional leading '-'). Scope limit, named deliberately: no
# float-string parsing -- every ACTUAL to_num call site in this
# backend's own source (44 in codegen_x64.patlang) converts something
# already integer-valued (list lengths, arg counts, IR field text), so
# this is a real behavioural match for how it's actually used here, not
# a full reimplementation of Rust's more general host_to_num.
#
# Classifies by the top NIBBLE (bits 60-63), not the whole 16-bit tag --
# a REAL bug caught here (segfault in print(), same root cause):
# negative fixnums computed by NON-dynamic-mode code (plain `sub`, never
# masked back to the canonical "top 16 bits always zero" tagged form the
# way dynamic-mode arithmetic explicitly does) are raw 64-bit two's-
# complement, so their top 16 bits read as 0xFFFF (sign-extended), not
# 0x0000. A 16-bit-tag check for "== 0" misses every negative plain-mode
# fixnum. The top NIBBLE alone is unambiguous: real family selectors are
# only 1 (Numeric)/2 (String)/3 (List)/4 (Closure)/5 (Object), so nibble
# 0xF can ONLY be this sign-extension leak, never a genuine tagged
# family -- safe to treat identically to nibble 0 (clean fixnum).
make a function called to_num takes v returns n
  let nibble = (v shr 60) band 15
  if nibble == 0 then
    return v
  end
  if nibble == 15 then
    return v
  end
  if nibble == 1 then
    return v
  end
  let addr = v band rt_payload_mask()
  let len = mem_peek_qword(addr, 0)
  let i = 0
  let neg = false
  if len > 0 then
    if mem_peek_byte(addr, 8) == 45 then
      let neg = true
      let i = 1
    end
  end
  let acc = 0
  while i < len do
    let d = mem_peek_byte(addr, 8 + i)
    if d >= 48 then
      if d <= 57 then
        let acc = acc * 10 + (d - 48)
      end
    end
    let i = i + 1
  end
  if neg then
    return 0 - acc
  end
  return acc
end

# chr(n) -> 1-byte string (empty for n < 0). Single-byte only (this
# backend's strings are plain bytes throughout, no UTF-8 handling
# anywhere else either) -- matches the actual need everywhere this is
# used (building single ASCII characters like quotes/newlines), not
# Rust's fuller Unicode char support. Supersedes the "this backend has
# no chr() primitive" workaround rt_dquote_str's own header used to
# note; that function is left as-is (already correct), just no longer
# the only way to build a 1-byte string.
make a function called chr takes n returns s
  if n < 0 then
    let result = rt_heap_alloc(8)
    mem_poke_qword(result, 0, 0)
    return result bor rt_string_tag()
  end
  let result = rt_heap_alloc(9)
  mem_poke_qword(result, 0, 1)
  mem_poke_byte(result, 8, n)
  return result bor rt_string_tag()
end

# substr(s, start, count) -> byte slice, clamped to the string's actual
# length (matching Rust's ASCII-path clamping: `st = start.min(len)`,
# `en = (st+count).min(len)`).
make a function called substr takes s, start, count returns result
  let addr = s band rt_payload_mask()
  let len = mem_peek_qword(addr, 0)
  let st = start
  if st > len then
    let st = len
  end
  let en = st + count
  if en > len then
    let en = len
  end
  let n = en - st
  let result = rt_heap_alloc(8 + n)
  mem_poke_qword(result, 0, n)
  let i = 0
  while i < n do
    mem_poke_byte(result, 8 + i, mem_peek_byte(addr, 8 + st + i))
    let i = i + 1
  end
  return result bor rt_string_tag()
end

# str_intern/sc_len/sc_code/sc_char: Rust's versions hand out a stable
# integer id into a global interned-string TABLE so a hot scanning loop
# (the lexer indexes the whole source per character) never re-clones a
# Value::String local on every access. This backend has no such cloning
# cost to avoid (strings are already heap blocks referenced by address,
# not deep-copied per access) -- confirmed via lexer.patlang's own
# usage (the ONLY call site in the whole self-hosted compiler source):
# str_intern is called EXACTLY ONCE per tokenize() call, and the
# returned handle is used only within that same call, never crossing
# into another function or needing to persist. So the "handle" can just
# BE the string's own masked address -- no table, no id-to-entry
# lookup, nothing to grow or manage. A deliberately simpler, still
# fully general, implementation (works correctly regardless of how many
# strings are ever interned or how many times), not a scope-limited one.
make a function called str_intern takes s returns handle
  return s band rt_payload_mask()
end

make a function called sc_len takes handle returns len
  return mem_peek_qword(handle, 0)
end

make a function called sc_code takes handle, i returns code
  let len = mem_peek_qword(handle, 0)
  if i < len then
    return mem_peek_byte(handle, 8 + i)
  end
  return 0 - 1
end

make a function called sc_char takes handle, i returns s
  let len = mem_peek_qword(handle, 0)
  if i < len then
    return chr(mem_peek_byte(handle, 8 + i))
  end
  let result = rt_heap_alloc(8)
  mem_poke_qword(result, 0, 0)
  return result bor rt_string_tag()
end

# vec_new/vec_push/vec_get/vec_set/vec_len/vec_to_list: Rust's
# "handle-based builder" for O(1) push/index on large collections
# (rust-runtime/src/ir/hosts.rs's VECS thread-local), used by
# lexer.patlang to accumulate its token list (`vec_push(tokens,
# item)`, called as a bare statement -- same fire-and-forget contract
# as sb_push, so this needs the EXACT same "stable handle across
# growth" design as sb_new/sb_push/sb_str above (see that block's own
# header for the full reasoning: a naive address-as-handle design
# breaks the moment growth reallocates, since existing call sites never
# rebind the handle). Simpler than sb_* though: each entry here is an
# ORDINARY PatLang List (not a hand-rolled byte buffer), so entry
# growth just reuses the ALREADY O(1)-amortized rt_list_push directly
# -- no byte-copying logic to write. vec_to_list needs no copy either:
# a PatLang List IS already this backend's native list representation,
# so returning the entry's current tagged value as-is is correct (same
# "handle out, no more pushes expected afterward" idiom the ACTUAL
# lexer.patlang call site follows: vec_to_list(tokens) is always the
# LAST thing done with a given vec handle).
make a function called vec_new returns handle
  let table_addr = mem_vec_table_addr()
  let table = mem_peek_qword(table_addr, 0)
  if table == 0 then
    let table = rt_list_new(0)
    mem_poke_qword(table_addr, 0, table)
  end
  let entry = rt_list_new(0)
  let new_table = rt_list_push(table, entry)
  mem_poke_qword(table_addr, 0, new_table)
  return rt_list_len(new_table) - 1
end

make a function called vec_push takes handle, item returns done
  let table = mem_peek_qword(mem_vec_table_addr(), 0)
  let entry = rt_list_get(table, handle)
  let new_entry = rt_list_push(entry, item)
  rt_list_set(table, handle, new_entry)
  return true
end

make a function called vec_get takes handle, idx returns value
  let table = mem_peek_qword(mem_vec_table_addr(), 0)
  let entry = rt_list_get(table, handle)
  return rt_list_get(entry, idx)
end

make a function called vec_set takes handle, idx, item returns done
  let table = mem_peek_qword(mem_vec_table_addr(), 0)
  let entry = rt_list_get(table, handle)
  rt_list_set(entry, idx, item)
  return true
end

make a function called vec_len takes handle returns n
  let table = mem_peek_qword(mem_vec_table_addr(), 0)
  let entry = rt_list_get(table, handle)
  return rt_list_len(entry)
end

make a function called vec_to_list takes handle returns l
  let table = mem_peek_qword(mem_vec_table_addr(), 0)
  return rt_list_get(table, handle)
end

# char_code(s, idx) -> ASCII byte at idx, or -1 if out of range. Same
# shape as sc_code, but takes a plain (tagged) string directly rather
# than an interned handle.
make a function called char_code takes s, idx returns code
  let addr = s band rt_payload_mask()
  let len = mem_peek_qword(addr, 0)
  if idx < len then
    return mem_peek_byte(addr, 8 + idx)
  end
  return 0 - 1
end

# print(v): genuinely value-polymorphic, NOT string-only. Real bug
# caught here (segfault, not a compile-time warning): x64_runtime.
# patlang is prepended to EVERY --x64 compile, not just the bundled
# compiler source's own (all-string) print(...) call sites -- so a
# string-only print silently became the print for every OTHER x64
# program too, including ones that print plain numbers directly (e.g.
# x64_codegen_demo_baseline.patlang's `print(total)`). Passing a raw
# fixnum into rt_print_str (which treats its argument as a string's
# masked HEAP ADDRESS) reads garbage memory as if it were a
# [length][bytes] block -- an immediate segfault, not a graceful
# failure. Dispatches on the family tag like x64_binop_asm_dynamic
# does: fixnum -> rt_int_to_str, String -> print directly, BigInt/
# Rational/Complex/Interval -> their own *_to_string helper (all
# already exist, built for the numeric-tower demos). List/Object/
# Closure fall back to a fixed placeholder rather than attempting real
# pretty-printing (not exercised by any known caller; a placeholder is
# safe, a crash is not).
make a function called print takes v returns done
  let family_mask = 17293822569102704640
  let family = v band family_mask
  if family == 0 then
    return rt_print_str(rt_int_to_str(v))
  end
  # Sign-extension leak from non-dynamic-mode arithmetic (see to_num's
  # own header for the full explanation) -- family_mask IS all four
  # nibble bits, so a value that's genuinely all-ones there (rather than
  # a real family selector, which only ever uses 1-5) is a raw negative
  # fixnum that was never re-masked to the canonical zero-tag form.
  if family == family_mask then
    return rt_print_str(rt_int_to_str(v))
  end
  let string_family = 2305843009213693952
  if family == string_family then
    return rt_print_str(v)
  end
  let bigint_family = 1152921504606846976
  if family == bigint_family then
    return rt_print_str(rt_bigint_to_string(v))
  end
  let rational_family = 1153765929536978944
  if family == rational_family then
    return rt_print_str(rt_rational_to_string(v))
  end
  let complex_family = 1154891829443821568
  if family == complex_family then
    return rt_print_str(rt_complex_to_string(v))
  end
  let interval_family = 1157425104234217472
  if family == interval_family then
    return rt_print_str(rt_interval_to_string(v))
  end
  return rt_print_str("<value>")
end

# Byte-content string equality -- NOT the same as `==`, which on tagged
# String values is raw ADDRESS identity (x64_binop_asm_dynamic's
# .DYN_OBJ_ branch, deliberate scope limit documented there). Two
# separately-interned or separately-allocated strings with identical
# text are NOT `==` in this backend, so set_var/get's string-keyed
# lookup below needs a real content comparison, not `==`.
make a function called rt_str_eq takes a, b returns eq
  let addr_a = a band rt_payload_mask()
  let addr_b = b band rt_payload_mask()
  let len_a = mem_peek_qword(addr_a, 0)
  let len_b = mem_peek_qword(addr_b, 0)
  if len_a != len_b then
    return false
  end
  let i = 0
  while i < len_a do
    if mem_peek_byte(addr_a, 8 + i) != mem_peek_byte(addr_b, 8 + i) then
      return false
    end
    let i = i + 1
  end
  return true
end

# set_var(key, value) / get(store, key): the bundled compiler source
# uses these ONLY as a small global named-counter store (checked every
# call site: lower.patlang's closure/budgeted/activate sequence
# counters, codegen_x64.patlang's string/CallValue label counters --
# always numeric values, always `get("__vars", key)` with the literal
# store name "__vars"). Genuinely general (any string key, any value,
# any store name is accepted, just always compared by content not
# identity) but scoped to what's actually needed: a single global
# linear-scan key/value store (two parallel persistent-table entries,
# same g_*_table/mem_*_table_addr pattern as sb_*/vec_*), not a
# multi-namespace object system. `store` is accepted but not used to
# select between namespaces -- every actual call site passes the same
# "__vars" literal, so a second global for a different store name has
# never been observed and isn't implemented; get on an unset key
# returns 0 (matches how every actual key is initialized via set_var
# before its first get, e.g. lower.patlang:629 `set_var("__closure_seq",
# 0)`), not Rust's Unit/nil.
make a function called set_var takes key, value returns done
  let table_addr = mem_vars_table_addr()
  let table = mem_peek_qword(table_addr, 0)
  if table == 0 then
    let keys = rt_list_new(0)
    let vals = rt_list_new(0)
    let table = rt_list_new(2)
    rt_list_set(table, 0, keys)
    rt_list_set(table, 1, vals)
    mem_poke_qword(table_addr, 0, table)
  end
  let keys = rt_list_get(table, 0)
  let vals = rt_list_get(table, 1)
  let n = rt_list_len(keys)
  let i = 0
  while i < n do
    if rt_str_eq(rt_list_get(keys, i), key) then
      rt_list_set(vals, i, value)
      return true
    end
    let i = i + 1
  end
  let new_keys = rt_list_push(keys, key)
  let new_vals = rt_list_push(vals, value)
  rt_list_set(table, 0, new_keys)
  rt_list_set(table, 1, new_vals)
  return true
end

make a function called get takes store, key returns value
  let table = mem_peek_qword(mem_vars_table_addr(), 0)
  if table == 0 then
    return 0
  end
  let keys = rt_list_get(table, 0)
  let vals = rt_list_get(table, 1)
  let n = rt_list_len(keys)
  let i = 0
  while i < n do
    if rt_str_eq(rt_list_get(keys, i), key) then
      return rt_list_get(vals, i)
    end
    let i = i + 1
  end
  return 0
end

# floor(v): fixnum/BigInt pass through unchanged (already integers,
# matching Rust's own `Value::Int(_) | Value::BigInt(_) => v.clone()`);
# Rational computes real floor division on [numerator][denominator]
# (matches Rust's exact BigInt-based floor, not a lossy float
# round-trip): q = n/d truncated toward zero (this backend's `/` is
# native idiv, truncating), then if there's a nonzero remainder AND n
# is negative, subtract 1 (truncation rounds toward zero, i.e. UP for
# negative operands, so it overshoots floor by exactly one in that
# case). Named scope limit: Complex/Interval/Float have no floor
# implemented here (this backend's only actual caller,
# x64_codegen_demo_baseline.patlang, only ever floors a fixnum-or-
# Rational division result) -- falls through to "unchanged" for
# anything else rather than erroring, a safe default.
make a function called floor takes v returns result
  let family_mask = 17293822569102704640
  let family = v band family_mask
  let rational_family = 1153765929536978944
  if family == rational_family then
    let addr = v band rt_payload_mask()
    let n = mem_peek_qword(addr, 0)
    let d = mem_peek_qword(addr, 8)
    let q = n / d
    let r = n - q * d
    if r != 0 then
      if n < 0 then
        return q - 1
      end
    end
    return q
  end
  return v
end

# ---- lists (Slice 4, TAGGED as of the closures/strings/lists tagging
# migration) ----
#
# Same [8-byte length][elements] block layout as strings, except each
# element is a plain TAGGED qword rather than a byte -- every PatLang
# value in this backend is already a qword, so "a list of anything"
# (fixnums, BigInt/Rational/Complex/Interval, strings, other lists,
# closures, objects) is trivially a list of tagged qwords, no
# per-type handling needed anywhere. Now carries family 0x3's tag on
# the list's own address, same masking/tagging discipline as strings.
# codegen_x64.patlang's BuildList handling (PatLang's own `[e0, e1,
# ...]` literal syntax) calls rt_heap_alloc directly and constructs
# this same layout inline rather than calling rt_list_new -- both
# produce identical (now tagged) blocks.
#
# `list_get`/`list_len` are aliased directly to rt_list_get/rt_list_len
# by codegen_x64.patlang (so `l[i]` and `list_len(l)` work with
# PatLang's own native syntax); rt_list_new/rt_list_set are NOT
# aliased from list_push/list_set -- this file's rt_list_set mutates
# IN PLACE, unlike the interpreter's own copy-on-write list_set, so it
# keeps its own distinct name rather than silently changing meaning.
#
# Fixed-size only -- no growable/push support yet (a real growable list
# needs a reallocate-and-copy strategy, a deliberately separate, named,
# not-yet-built follow-up, same spirit as strings' `+`-stays-int-only
# limit).

make a function called rt_list_tag returns tag
  return 3 shl 60
end

# List block format, TWO qwords of header, not one: [length:8]
# [capacity:8][elements: capacity*8 bytes]. Elements start at offset
# 16, not 8 -- a real, deliberate format change from the original
# Slice 4 layout (see rt_list_push's own header for why capacity
# tracking is necessary, not cosmetic). rt_list_new/BuildList (in
# codegen_x64.patlang) both allocate TIGHT (capacity == length, no
# spare room) -- only rt_list_push ever creates a list with genuine
# spare capacity.
make a function called rt_list_new takes n returns tagged
  let addr = rt_heap_alloc(16 + n * 8)
  mem_poke_qword(addr, 0, n)
  mem_poke_qword(addr, 8, n)
  return addr bor rt_list_tag()
end

make a function called rt_list_len takes l returns len
  let addr = l band rt_payload_mask()
  return mem_peek_qword(addr, 0)
end

make a function called rt_list_get takes l, i returns value
  let addr = l band rt_payload_mask()
  return mem_peek_qword(addr, 16 + i * 8)
end

make a function called rt_list_set takes l, i, v returns done
  let addr = l band rt_payload_mask()
  mem_poke_qword(addr, 16 + i * 8, v)
  return true
end

# Growable lists: list_push(list, item) -> a list with item appended.
#
# REAL PERFORMANCE BUG found and fixed here (not by review -- by an
# actual self-compile attempt burning 20+ CPU-minutes on ~10K lines
# of the compiler's own source before being killed): the original
# version always reallocated a tightly-sized block and copied EVERY
# existing element on EVERY push, an O(n) cost per call -- meaning a
# loop that accumulates N items one push at a time (exactly how
# lexer.patlang builds its token list, one token per push) costs
# O(n^2) total. The interpreter's own list_push is O(1) amortized
# (`Arc::make_mut(&mut xs).push(...)` -- Rust's Vec grows by
# doubling, and Arc::make_mut only copies when the list is actually
# SHARED, mutating in place otherwise). Fixed by tracking real spare
# CAPACITY in the block header (see the format comment above) and
# growing geometrically (doubling) only when capacity is exhausted,
# mutating in place (bumping length, writing into already-reserved
# space) whenever there's room.
#
# NAMED, DELIBERATE SEMANTIC DEVIATION from the interpreter's own
# safety guarantee: Arc::make_mut only mutates in place when the
# reference count is 1 (i.e. provably unshared), copying otherwise --
# this backend has NO reference counting at all, so it cannot tell
# whether an older list value still aliases the same block. The
# in-place growth path here is therefore only PROBABLY safe, not
# PROVABLY safe: it's correct for the dominant, realistic pattern
# (`let xs = list_push(xs, item)` accumulated in a loop, where the
# old binding is never read again), but a program that keeps an OLDER
# list reference around, then pushes onto a chain descended from it
# MULTIPLE times while that older reference still has spare capacity,
# could observe the older reference's contents change underneath it.
# This tradeoff is deliberate -- realistic performance for the
# overwhelmingly common accumulation pattern (needed for self-hosting
# at all) over perfect aliasing safety for a rarer divergent-branches
# pattern. x64_growable_list_demo.patlang's own "the original list
# stays length 0" check still passes (it never re-reads a list that
# was later pushed onto), but is not a general proof of safety.
make a function called rt_list_push takes l, v returns tagged
  let addr = l band rt_payload_mask()
  let n = mem_peek_qword(addr, 0)
  let cap = mem_peek_qword(addr, 8)
  if n < cap then
    mem_poke_qword(addr, 16 + n * 8, v)
    mem_poke_qword(addr, 0, n + 1)
    return l
  end
  let new_cap = cap * 2
  if new_cap < 1 then
    let new_cap = 1
  end
  if new_cap < n + 1 then
    let new_cap = n + 1
  end
  let new_addr = rt_heap_alloc(16 + new_cap * 8)
  mem_poke_qword(new_addr, 0, n + 1)
  mem_poke_qword(new_addr, 8, new_cap)
  let i = 0
  while i < n do
    mem_poke_qword(new_addr, 16 + i * 8, mem_peek_qword(addr, 16 + i * 8))
    let i = i + 1
  end
  mem_poke_qword(new_addr, 16 + n * 8, v)
  return new_addr bor rt_list_tag()
end

# ---- numeric tower: BigInt (tagged values, DYNAMIC-MODE functions only) ----
#
# Scope, named explicitly (see the plan at wondering-about-extending-
# patlang-modular-shore.md and memory patlang-x64-tower-design-
# philosophy for the full three-round design negotiation this came
# from): every value in a function codegen_x64.patlang classifies as
# "dynamic" (currently: any function whose own body calls
# rt_bigint_from_i64, directly -- a whole-function decision, exactly
# mirroring Slice 7's float_mode scope limit, NOT yet per-value
# specialization or cross-function propagation) is a TAGGED 64-bit
# word: top 16 bits (48-63) = tag, low 48 bits = payload.
#   tag all-zero  -> fixnum: payload is a signed 48-bit int (~+-140
#                    trillion), recovered via `(w shl 16) shr 16`
#                    (sign-extends from bit 47; `shr` in this backend
#                    lowers to `sar`, an arithmetic shift).
#   family 0x1
#   (numeric),
#   local bit0    -> BigInt: payload (masked) is a heap address.
# Functions NOT classified dynamic (everything that doesn't touch
# BigInt, including every existing demo/benchmark) get TODAY'S EXACT
# untagged codegen, unchanged -- this is the property that keeps the
# whole-int/whole-float speed advantage (see memory patlang-x64-
# benchmarking) intact; verified, not just assumed, in this slice's
# own testing.
#
# `+` on two dynamic-mode values therefore genuinely stays `+` in
# source PatLang (see codegen_x64.patlang's x64_binop_asm_dynamic) --
# no named-function workaround. Fixnum+fixnum that overflows 48 bits
# promotes to BigInt automatically at the `+` site itself, mirroring
# the interpreter's own checked_add-then-promote behavior.
#
# DELIBERATE SCOPE LIMITS, named honestly (this is a first working
# cut of a very large design, not full parity):
#   - Only `+` gets dynamic dispatch this pass; `-`/`*`/`/`/comparisons
#     on genuinely dynamic (possibly-BigInt) values are NOT yet wired
#     -- rt_bigint_add exists and is reachable, subtract/multiply/
#     compare on the tower are real follow-up work.
#   - Rational, Complex, Object: tag space reserved (families 0x2 List,
#     0x3 String were already spoken for by existing types; Numeric's
#     own family-local bits 1/2 for Rational/Float are reserved),
#     nothing implemented.
#   - String/List/Closure values are NOT tagged -- they keep today's
#     exact raw-address representation, untouched by this pass. A
#     BigInt value has never been stored into a List or passed through
#     a Closure capture in this cut; doing so is unverified.
#   - A NEGATIVE integer literal used DIRECTLY as an operand to `+`
#     inside a dynamic-mode function is unverified/unsafe in this cut
#     (Const codegen is intentionally unchanged in dynamic mode, so a
#     literal like `-5` keeps its natural two's-complement top bits
#     set, which the fixnum check would misread as a non-zero tag).
#     Every value used this way in the demo is non-negative. Real fix
#     is per-value analysis of "will this Const flow into a dynamic
#     Bin or a plain function argument", deferred with everything else
#     under "not yet per-value specialization" above.
#   - BigInt division, and magnitudes large enough for a single
#     schoolbook column's carry itself to overflow 64 bits: still out
#     of scope, unchanged from the original floats-only Slice 7 notes.

make a function called rt_tag_mask returns mask
  return (1 shl 16 - 1) shl 48
end

make a function called rt_payload_mask returns mask
  return 1 shl 48 - 1
end

make a function called rt_bigint_tag returns tag
  return (1 shl 60) bor (1 shl 48)
end

# Recovers the true signed value of a fixnum-tagged word -- NEEDED
# before handing a dynamic-mode arithmetic RESULT to a plain-int
# function like rt_print_i64: a tagged fixnum's raw 64-bit bit pattern
# is NOT numerically equal to the true value for negative numbers (the
# top 16 tag bits are forced to zero, not sign-extended, so e.g. -95
# stored this way reads as a huge POSITIVE 64-bit number if used
# unpacked). Comparison results (always a plain 0/1) don't need this --
# only genuine arithmetic results do.
make a function called rt_fixnum_unpack takes tagged returns n
  return (tagged shl 16) shr 16
end

make a function called rt_int_to_str takes n returns s
  let buf = mem_scratch_addr()
  let len = rt_int_to_string(n, buf)
  let s = rt_heap_alloc(8 + len)
  mem_poke_qword(s, 0, len)
  let i = 0
  while i < len do
    mem_poke_byte(s, 8 + i, mem_peek_byte(buf, i))
    let i = i + 1
  end
  return s bor rt_string_tag()
end

# Zero-padded to exactly 9 digits -- for every limb EXCEPT the most
# significant one when printing a BigInt (base 10^9 per limb).
make a function called rt_limb9_to_str takes n returns s
  let s = rt_heap_alloc(8 + 9)
  mem_poke_qword(s, 0, 9)
  let v = n
  let i = 8
  while i >= 0 do
    let d = v % 10
    mem_poke_byte(s, 8 + i, d + 48)
    let v = v / 10
    let i = i - 1
  end
  return s bor rt_string_tag()
end

# Real bug found here: an earlier draft used list_push/list_len to
# collect limbs before allocating the block. list_push is NOT one of
# this backend's supported CallHost primitives (see x64_binop_asm's
# neighbor x64_callhost_asm's own header: list_get/list_len are
# aliased, list_push/list_set deliberately are not). Because
# x64_runtime.patlang is unconditionally prepended to EVERY compiled
# program, that one bad call silently poisoned every program's own
# generated .asm with an "UNSUPPORTED_PRIMITIVE_ERROR" placeholder
# function -- caught immediately (a printed compile-time error) the
# first time ANY demo was rebuilt after this file changed, even
# demos that never call rt_bigint_from_i64 at all. Fixed by counting
# limbs with a plain integer loop first, then allocating once and
# writing digits directly into the heap block -- no dynamic PatLang
# list anywhere in this function.
make a function called rt_bigint_from_i64 takes n returns tagged
  let sign = 0
  let v = n
  if v < 0 then
    let sign = 1
    let v = 0 - v
  end
  let n_limbs = 1
  if v > 0 then
    let n_limbs = 0
    let t = v
    while t > 0 do
      let n_limbs = n_limbs + 1
      let t = t / 1000000000
    end
  end
  let addr = rt_heap_alloc(16 + n_limbs * 8)
  mem_poke_qword(addr, 0, sign)
  mem_poke_qword(addr, 8, n_limbs)
  if v == 0 then
    mem_poke_qword(addr, 16, 0)
  else
    let i = 0
    let t = v
    while t > 0 do
      mem_poke_qword(addr, 16 + i * 8, t % 1000000000)
      let t = t / 1000000000
      let i = i + 1
    end
  end
  return addr bor rt_bigint_tag()
end

make a function called rt_bigint_to_string takes tagged returns s
  let addr = tagged band rt_payload_mask()
  let sign = mem_peek_qword(addr, 0)
  let count = mem_peek_qword(addr, 8)
  let result = ""
  if sign == 1 then
    let result = "-"
  end
  let top = mem_peek_qword(addr, 16 + (count - 1) * 8)
  let result = rt_str_concat(result, rt_int_to_str(top))
  let i = count - 2
  while i >= 0 do
    let limb = mem_peek_qword(addr, 16 + i * 8)
    let result = rt_str_concat(result, rt_limb9_to_str(limb))
    let i = i - 1
  end
  return result
end

# |a| vs |b|, ignoring sign: -1, 0, or 1.
make a function called rt_bigint_mag_cmp takes addr_a, addr_b returns cmp
  let na = mem_peek_qword(addr_a, 8)
  let nb = mem_peek_qword(addr_b, 8)
  if na != nb then
    if na > nb then
      return 1
    else
      return 0 - 1
    end
  end
  let i = na - 1
  let result = 0
  let keep_going = true
  while keep_going do
    if i < 0 then
      let keep_going = false
    else
      let la = mem_peek_qword(addr_a, 16 + i * 8)
      let lb = mem_peek_qword(addr_b, 16 + i * 8)
      if la != lb then
        if la > lb then
          let result = 1
        else
          let result = 0 - 1
        end
        let keep_going = false
      else
        let i = i - 1
      end
    end
  end
  return result
end

# |a| + |b| (sign-agnostic), a fresh heap block, sign left as 0 --
# caller (rt_bigint_add) sets the real sign afterward.
make a function called rt_bigint_mag_add takes addr_a, addr_b returns addr
  let na = mem_peek_qword(addr_a, 8)
  let nb = mem_peek_qword(addr_b, 8)
  let n = na
  if nb > n then
    let n = nb
  end
  let addr = rt_heap_alloc(16 + (n + 1) * 8)
  let carry = 0
  let i = 0
  let out_n = 0
  while i < n do
    let la = 0
    if i < na then
      let la = mem_peek_qword(addr_a, 16 + i * 8)
    end
    let lb = 0
    if i < nb then
      let lb = mem_peek_qword(addr_b, 16 + i * 8)
    end
    let s = la + lb + carry
    if s >= 1000000000 then
      let s = s - 1000000000
      let carry = 1
    else
      let carry = 0
    end
    mem_poke_qword(addr, 16 + i * 8, s)
    let out_n = i + 1
    let i = i + 1
  end
  if carry > 0 then
    mem_poke_qword(addr, 16 + out_n * 8, carry)
    let out_n = out_n + 1
  end
  mem_poke_qword(addr, 0, 0)
  mem_poke_qword(addr, 8, out_n)
  return addr
end

# Drop leading (most-significant) zero limbs down to a minimum of 1.
make a function called rt_bigint_trim takes addr returns addr2
  let n = mem_peek_qword(addr, 8)
  let keep_going = true
  while keep_going do
    if n <= 1 then
      let keep_going = false
    else
      let top = mem_peek_qword(addr, 16 + (n - 1) * 8)
      if top == 0 then
        let n = n - 1
      else
        let keep_going = false
      end
    end
  end
  mem_poke_qword(addr, 8, n)
  return addr
end

# |a| - |b| (sign-agnostic), REQUIRES |a| >= |b| (caller's job to pick
# the larger-magnitude operand as addr_a via rt_bigint_mag_cmp first).
make a function called rt_bigint_mag_sub takes addr_a, addr_b returns addr
  let na = mem_peek_qword(addr_a, 8)
  let nb = mem_peek_qword(addr_b, 8)
  let addr = rt_heap_alloc(16 + na * 8)
  let borrow = 0
  let i = 0
  while i < na do
    let la = mem_peek_qword(addr_a, 16 + i * 8)
    let lb = 0
    if i < nb then
      let lb = mem_peek_qword(addr_b, 16 + i * 8)
    end
    let d = la - lb - borrow
    if d < 0 then
      let d = d + 1000000000
      let borrow = 1
    else
      let borrow = 0
    end
    mem_poke_qword(addr, 16 + i * 8, d)
    let i = i + 1
  end
  mem_poke_qword(addr, 0, 0)
  mem_poke_qword(addr, 8, na)
  return rt_bigint_trim(addr)
end

# Real signed BigInt add: same-sign -> magnitude add, keep sign;
# different-sign -> magnitude subtract (larger minus smaller), sign of
# the larger-magnitude operand -- the standard schoolbook rule, not a
# same-sign-only shortcut.
make a function called rt_bigint_add takes tagged_a, tagged_b returns tagged
  let addr_a = tagged_a band rt_payload_mask()
  let addr_b = tagged_b band rt_payload_mask()
  let sign_a = mem_peek_qword(addr_a, 0)
  let sign_b = mem_peek_qword(addr_b, 0)
  let result = 0
  if sign_a == sign_b then
    let result = rt_bigint_mag_add(addr_a, addr_b)
    mem_poke_qword(result, 0, sign_a)
  else
    let c = rt_bigint_mag_cmp(addr_a, addr_b)
    if c == 0 then
      return rt_bigint_from_i64(0)
    else
      if c > 0 then
        let result = rt_bigint_mag_sub(addr_a, addr_b)
        mem_poke_qword(result, 0, sign_a)
      else
        let result = rt_bigint_mag_sub(addr_b, addr_a)
        mem_poke_qword(result, 0, sign_b)
      end
    end
  end
  return result bor rt_bigint_tag()
end

# Negation: flips the sign, EXCEPT for a zero-magnitude value, which
# stays sign 0 either way (no such thing as -0 here, matching
# rt_bigint_from_i64(0)'s own always-sign-0 convention). Builds a NEW
# block rather than mutating in place -- this scheme doesn't yet share
# BigInt blocks between values (nothing aliases one), but copying is
# the safe default regardless.
make a function called rt_bigint_negate takes tagged returns tagged2
  let addr = tagged band rt_payload_mask()
  let sign = mem_peek_qword(addr, 0)
  let count = mem_peek_qword(addr, 8)
  let is_zero = false
  if count == 1 then
    if mem_peek_qword(addr, 16) == 0 then
      let is_zero = true
    end
  end
  if is_zero then
    return tagged
  end
  let new_sign = 1
  if sign == 1 then
    let new_sign = 0
  end
  let addr2 = rt_heap_alloc(16 + count * 8)
  mem_poke_qword(addr2, 0, new_sign)
  mem_poke_qword(addr2, 8, count)
  let i = 0
  while i < count do
    mem_poke_qword(addr2, 16 + i * 8, mem_peek_qword(addr, 16 + i * 8))
    let i = i + 1
  end
  return addr2 bor rt_bigint_tag()
end

make a function called rt_bigint_sub takes tagged_a, tagged_b returns tagged
  return rt_bigint_add(tagged_a, rt_bigint_negate(tagged_b))
end

# |a| * |b| (sign-agnostic), plain schoolbook column multiply, base
# 10^9 limbs. Each column product (up to (10^9-1)^2 ~ 1e18) plus
# running carry stays comfortably within a signed 64-bit accumulator
# for any magnitude this pass is scoped to handle (same "not truly
# arbitrary precision yet" limit named in this file's own header).
make a function called rt_bigint_mag_mul takes addr_a, addr_b returns addr
  let na = mem_peek_qword(addr_a, 8)
  let nb = mem_peek_qword(addr_b, 8)
  let addr = rt_heap_alloc(16 + (na + nb) * 8)
  let z = 0
  while z < na + nb do
    mem_poke_qword(addr, 16 + z * 8, 0)
    let z = z + 1
  end
  let i = 0
  while i < na do
    let la = mem_peek_qword(addr_a, 16 + i * 8)
    let carry = 0
    let j = 0
    while j < nb do
      let lb = mem_peek_qword(addr_b, 16 + j * 8)
      let cur = mem_peek_qword(addr, 16 + (i + j) * 8)
      let prod = la * lb + cur + carry
      let digit = prod % 1000000000
      let carry = prod / 1000000000
      mem_poke_qword(addr, 16 + (i + j) * 8, digit)
      let j = j + 1
    end
    let k = i + nb
    while carry > 0 do
      let cur = mem_peek_qword(addr, 16 + k * 8)
      let s = cur + carry
      let digit = s % 1000000000
      let carry = s / 1000000000
      mem_poke_qword(addr, 16 + k * 8, digit)
      let k = k + 1
    end
    let i = i + 1
  end
  mem_poke_qword(addr, 0, 0)
  mem_poke_qword(addr, 8, na + nb)
  return rt_bigint_trim(addr)
end

make a function called rt_bigint_mul takes tagged_a, tagged_b returns tagged
  let addr_a = tagged_a band rt_payload_mask()
  let addr_b = tagged_b band rt_payload_mask()
  let sign_a = mem_peek_qword(addr_a, 0)
  let sign_b = mem_peek_qword(addr_b, 0)
  let mag = rt_bigint_mag_mul(addr_a, addr_b)
  let count = mem_peek_qword(mag, 8)
  let is_zero = false
  if count == 1 then
    if mem_peek_qword(mag, 16) == 0 then
      let is_zero = true
    end
  end
  let result_sign = 0
  if is_zero == false then
    if sign_a != sign_b then
      let result_sign = 1
    end
  end
  mem_poke_qword(mag, 0, result_sign)
  return mag bor rt_bigint_tag()
end

# Full signed compare: -1/0/1. Differing signs resolve immediately;
# same sign falls back to rt_bigint_mag_cmp, negated if both negative
# (since for two negative numbers, the one with the LARGER magnitude
# is actually the SMALLER value).
make a function called rt_bigint_cmp takes tagged_a, tagged_b returns cmp
  let addr_a = tagged_a band rt_payload_mask()
  let addr_b = tagged_b band rt_payload_mask()
  let sign_a = mem_peek_qword(addr_a, 0)
  let sign_b = mem_peek_qword(addr_b, 0)
  if sign_a != sign_b then
    if sign_a == 1 then
      return 0 - 1
    else
      return 1
    end
  end
  let m = rt_bigint_mag_cmp(addr_a, addr_b)
  if sign_a == 1 then
    return 0 - m
  else
    return m
  end
end

# ---- numeric tower: Rational (tower level 2, i64-backed only) ----
#
# Rational's tag: family 0x1 (Numeric), local bits 0b011 (bit0 ">=
# BigInt" AND bit1 ">=Rational" both set -- the thermometer code, see
# rt_bigint_tag's own family/local-bit layout). A Rational is a heap
# block [8-byte numerator][8-byte denominator], denominator always
# kept positive (sign lives in the numerator), reduced via gcd on
# every construction so equal fractions compare equal by raw value.
#
# DELIBERATE SCOPE LIMIT, named honestly: this Rational is i64-backed
# ONLY, NOT BigInt-backed -- it literally cannot hold a numerator or
# denominator too large for a plain 64-bit int, so BigInt-Rational
# interop (dividing a BigInt by anything, or a Rational whose value
# would overflow i64) is out of scope by representation, not just
# unimplemented. x64_binop_asm_dynamic's `/` dispatch only promotes
# FIXNUM operands to Rational; a BigInt-tagged operand reaching that
# promotion step is silently mishandled (treated as if already
# Rational-tagged) -- a real, accepted gap matching the existing
# "BigInt division still out of scope" limit from the first BigInt
# cut, not a new kind of omission.

make a function called rt_rational_tag returns tag
  return (1 shl 60) bor (1 shl 48) bor (1 shl 49)
end

make a function called rt_gcd takes a, b returns g
  let x = a
  if x < 0 then
    let x = 0 - x
  end
  let y = b
  if y < 0 then
    let y = 0 - y
  end
  while y != 0 do
    let t = y
    let y = x % y
    let x = t
  end
  return x
end

make a function called rt_rational_new takes num, den returns tagged
  let n = num
  let d = den
  if d < 0 then
    let n = 0 - n
    let d = 0 - d
  end
  let g = rt_gcd(n, d)
  if g == 0 then
    let g = 1
  end
  let n = n / g
  let d = d / g
  let addr = rt_heap_alloc(16)
  mem_poke_qword(addr, 0, n)
  mem_poke_qword(addr, 8, d)
  return addr bor rt_rational_tag()
end

make a function called rt_rational_from_i64 takes n returns tagged
  return rt_rational_new(n, 1)
end

make a function called rt_rational_to_string takes tagged returns s
  let addr = tagged band rt_payload_mask()
  let n = mem_peek_qword(addr, 0)
  let d = mem_peek_qword(addr, 8)
  if d == 1 then
    return rt_int_to_str(n)
  end
  return rt_str_concat(rt_str_concat(rt_int_to_str(n), "/"), rt_int_to_str(d))
end

make a function called rt_rational_add takes a, b returns tagged
  let addr_a = a band rt_payload_mask()
  let addr_b = b band rt_payload_mask()
  let n1 = mem_peek_qword(addr_a, 0)
  let d1 = mem_peek_qword(addr_a, 8)
  let n2 = mem_peek_qword(addr_b, 0)
  let d2 = mem_peek_qword(addr_b, 8)
  return rt_rational_new(n1 * d2 + n2 * d1, d1 * d2)
end

make a function called rt_rational_sub takes a, b returns tagged
  let addr_a = a band rt_payload_mask()
  let addr_b = b band rt_payload_mask()
  let n1 = mem_peek_qword(addr_a, 0)
  let d1 = mem_peek_qword(addr_a, 8)
  let n2 = mem_peek_qword(addr_b, 0)
  let d2 = mem_peek_qword(addr_b, 8)
  return rt_rational_new(n1 * d2 - n2 * d1, d1 * d2)
end

make a function called rt_rational_mul takes a, b returns tagged
  let addr_a = a band rt_payload_mask()
  let addr_b = b band rt_payload_mask()
  let n1 = mem_peek_qword(addr_a, 0)
  let d1 = mem_peek_qword(addr_a, 8)
  let n2 = mem_peek_qword(addr_b, 0)
  let d2 = mem_peek_qword(addr_b, 8)
  return rt_rational_new(n1 * n2, d1 * d2)
end

make a function called rt_rational_div takes a, b returns tagged
  let addr_a = a band rt_payload_mask()
  let addr_b = b band rt_payload_mask()
  let n1 = mem_peek_qword(addr_a, 0)
  let d1 = mem_peek_qword(addr_a, 8)
  let n2 = mem_peek_qword(addr_b, 0)
  let d2 = mem_peek_qword(addr_b, 8)
  return rt_rational_new(n1 * d2, d1 * n2)
end

make a function called rt_rational_cmp takes a, b returns cmp
  let addr_a = a band rt_payload_mask()
  let addr_b = b band rt_payload_mask()
  let n1 = mem_peek_qword(addr_a, 0)
  let d1 = mem_peek_qword(addr_a, 8)
  let n2 = mem_peek_qword(addr_b, 0)
  let d2 = mem_peek_qword(addr_b, 8)
  let lhs = n1 * d2
  let rhs = n2 * d1
  if lhs < rhs then
    return 0 - 1
  end
  if lhs > rhs then
    return 1
  end
  return 0
end

# ---- numeric tower: Complex (tower level 3) ----
#
# Complex's tag: family 0x1 (Numeric), local bits 0b1111 (adds a
# fourth thermometer bit ">=Complex" on top of BigInt/Rational/Float's
# existing three -- see codegen_x64.patlang's own tag-layout header).
#
# UNLIKE BigInt/Rational, a Complex value is not a further extension
# of int MAGNITUDE -- it's a genuinely composite value, a pair of
# numbers (matching the real rustc-backend's own ComplexT, which wraps
# two NumT). So its representation is a heap block of two ALREADY-
# TAGGED numeric words: [8-byte tagged re][8-byte tagged im], where
# each component can independently be a fixnum, BigInt, or Rational
# (never itself Complex -- no nested complex-of-complex support).
#
# This representation choice is what lets rt_complex_add/_sub/_mul be
# ORDINARY PatLang using plain `+`/`-`/`*` on the extracted re/im
# components: since these functions call rt_complex_new, they're
# classified dynamic-mode by codegen_x64.patlang's x64_func_is_dynamic
# (same whole-function rule as everything else in this tower), and
# their own `+`/`-`/`*` on re/im therefore go through the EXISTING
# x64_binop_asm_dynamic machinery, which already correctly handles
# fixnum/BigInt/Rational operands -- no new arithmetic primitives were
# needed for Complex component math at all.
#
# DELIBERATE SCOPE LIMIT: only `+`/`-`/`*`/`==`/`!=` are meaningful
# and supported for top-level Complex operands (via
# x64_binop_asm_dynamic's own Complex classification branch).
# `/`/`<`/`<=`/`>`/`>=` on Complex values are NOT implemented -- for
# ordering specifically, there is no total order on complex numbers to
# begin with, so this is a genuine representation limit, not laziness;
# codegen_x64.patlang's comparison dispatch for Complex always calls
# rt_complex_eq and reuses the usual setcc-against-0 pattern, which
# gives a SAFE (no memory misread/crash) but not remotely meaningful
# result for ordering ops -- named here so it's never mistaken for
# real complex ordering support.

make a function called rt_complex_tag returns tag
  return (1 shl 60) bor (1 shl 48) bor (1 shl 49) bor (1 shl 50)
end

make a function called rt_fixnum_pack takes n returns tagged
  return n band rt_payload_mask()
end

make a function called rt_complex_new takes re, im returns tagged
  let addr = rt_heap_alloc(16)
  mem_poke_qword(addr, 0, re)
  mem_poke_qword(addr, 8, im)
  return addr bor rt_complex_tag()
end

# Wraps ANY already-tagged numeric value (fixnum/BigInt/Rational) as
# Complex(re=that value, im=0) -- used both for genuine "make a
# complex from a real number" construction and, in codegen_x64.
# patlang's promote-to-complex helper, for lifting a lower-tier
# operand up to Complex when mixed with a genuine Complex operand.
make a function called rt_complex_from_num takes tagged returns result
  return rt_complex_new(tagged, rt_fixnum_pack(0))
end

make a function called rt_complex_from_i64 takes n returns tagged
  return rt_complex_from_num(rt_fixnum_pack(n))
end

# Dispatches a single ALREADY-TAGGED numeric word (fixnum/BigInt/
# Rational -- never Complex) to the right *_to_string. A genuinely
# reusable "print any tower value" helper, not Complex-specific,
# needed here so rt_complex_to_string can format its re/im components
# whichever kind they happen to be.
make a function called rt_num_to_string takes tagged returns s
  let masked = tagged band rt_tag_mask()
  if masked == 0 then
    return rt_int_to_str(rt_fixnum_unpack(tagged))
  end
  if masked == rt_bigint_tag() then
    return rt_bigint_to_string(tagged)
  end
  if masked == rt_rational_tag() then
    return rt_rational_to_string(tagged)
  end
  return "?"
end

# "a+bi" -- deliberately not "a-bi" for negative im (rt_num_to_string
# already emits the leading "-" itself, so this always reads as
# "a+-bi" for a negative imaginary part). A real, named simplification
# matching the project's usual "correct but not polished" first-cut
# style, not an oversight.
make a function called rt_complex_to_string takes tagged returns s
  let addr = tagged band rt_payload_mask()
  let re = mem_peek_qword(addr, 0)
  let im = mem_peek_qword(addr, 8)
  let s = rt_num_to_string(re)
  let s = rt_str_concat(s, "+")
  let s = rt_str_concat(s, rt_num_to_string(im))
  let s = rt_str_concat(s, "i")
  return s
end

make a function called rt_complex_add takes a, b returns tagged
  let addr_a = a band rt_payload_mask()
  let addr_b = b band rt_payload_mask()
  let re_a = mem_peek_qword(addr_a, 0)
  let im_a = mem_peek_qword(addr_a, 8)
  let re_b = mem_peek_qword(addr_b, 0)
  let im_b = mem_peek_qword(addr_b, 8)
  return rt_complex_new(re_a + re_b, im_a + im_b)
end

make a function called rt_complex_sub takes a, b returns tagged
  let addr_a = a band rt_payload_mask()
  let addr_b = b band rt_payload_mask()
  let re_a = mem_peek_qword(addr_a, 0)
  let im_a = mem_peek_qword(addr_a, 8)
  let re_b = mem_peek_qword(addr_b, 0)
  let im_b = mem_peek_qword(addr_b, 8)
  return rt_complex_new(re_a - re_b, im_a - im_b)
end

# (a+bi)(c+di) = (ac-bd) + (ad+bc)i
make a function called rt_complex_mul takes a, b returns tagged
  let addr_a = a band rt_payload_mask()
  let addr_b = b band rt_payload_mask()
  let re_a = mem_peek_qword(addr_a, 0)
  let im_a = mem_peek_qword(addr_a, 8)
  let re_b = mem_peek_qword(addr_b, 0)
  let im_b = mem_peek_qword(addr_b, 8)
  let ac = re_a * re_b
  let bd = im_a * im_b
  let ad = re_a * im_b
  let bc = im_a * re_b
  return rt_complex_new(ac - bd, ad + bc)
end

# Returns a plain 0/1 (not -1/0/1 like the other *_cmp functions) --
# equality is the only well-defined comparison here. Compares
# component-wise via `==`, which -- since this function itself calls
# rt_complex_new nowhere, it needs to be explicitly forced into
# dynamic mode by codegen_x64.patlang's classifier by name, see that
# file's own x64_func_is_dynamic for why.
make a function called rt_complex_eq takes a, b returns eq
  let addr_a = a band rt_payload_mask()
  let addr_b = b band rt_payload_mask()
  let re_a = mem_peek_qword(addr_a, 0)
  let im_a = mem_peek_qword(addr_a, 8)
  let re_b = mem_peek_qword(addr_b, 0)
  let im_b = mem_peek_qword(addr_b, 8)
  if re_a == re_b then
    if im_a == im_b then
      return 1
    end
  end
  return 0
end

# ---- numeric tower: Interval ----
#
# Interval's tag: family 0x1 (Numeric), but UNLIKE BigInt/Rational/
# Float/Complex's thermometer bits (each implying the ones before it,
# because that chain really is a linear "wider magnitude" ordering),
# Interval is a SEPARATE extension axis -- an interval isn't "beyond"
# Complex, it's a different kind of composite value entirely. So it
# gets its own dedicated bit (bit4, i.e. local bits 0b10000) rather
# than extending the thermometer chain further -- deliberately NOT
# combined with the BigInt/Rational/Float/Complex bits, since an
# interval's own container-ness says nothing about what TYPE its
# endpoints are (those are separately tagged, stored inside).
#
# Same composite-value shape as Complex: [8-byte tagged lo][8-byte
# tagged hi], each endpoint independently fixnum/BigInt/Rational
# (never itself an Interval or Complex -- no nesting, same as
# Complex). Same payoff: rt_interval_add/_sub/_mul are ordinary
# PatLang using `+`/`-`/`*`/`<`/`>` on the extracted endpoints, which
# -- since these functions call rt_interval_new and are therefore
# classified dynamic-mode -- route through the EXISTING
# x64_binop_asm_dynamic machinery. No new arithmetic primitives.
#
# DELIBERATE SCOPE LIMIT (same reasoning as Complex): only
# `+`/`-`/`*`/`==`/`!=` supported for top-level Interval operands.
# Ordering (`<`/`<=`/`>`/`>=`) between two intervals is genuinely
# ambiguous (does [a,b] < [c,d] mean "definitely less" (b<c) or
# "possibly less"? both are defensible, this cut picks neither) --
# same safe-but-deterministically-false treatment as Complex's
# ordering gap, not real support. `/` is unwired (same accepted-gap
# class as Complex's).
#
# Complex intervals (an Interval of Complex endpoints, or a Complex
# with Interval components) are NOT supported -- noted as a real
# combination the user flagged as plausible future work once k-blades
# (and therefore Object) exist, not attempted here.

make a function called rt_interval_tag returns tag
  return (1 shl 60) bor (1 shl 52)
end

make a function called rt_interval_new takes lo, hi returns tagged
  let addr = rt_heap_alloc(16)
  mem_poke_qword(addr, 0, lo)
  mem_poke_qword(addr, 8, hi)
  return addr bor rt_interval_tag()
end

# Degenerate interval [v,v] wrapping any already-tagged numeric value
# -- used both for genuine construction and, in codegen_x64.patlang's
# promote-to-interval helper, for lifting a lower-tier operand up when
# mixed with a genuine Interval operand.
make a function called rt_interval_from_num takes tagged returns result
  return rt_interval_new(tagged, tagged)
end

make a function called rt_interval_from_i64 takes n returns tagged
  return rt_interval_from_num(rt_fixnum_pack(n))
end

make a function called rt_interval_to_string takes tagged returns s
  let addr = tagged band rt_payload_mask()
  let lo = mem_peek_qword(addr, 0)
  let hi = mem_peek_qword(addr, 8)
  let s = "["
  let s = rt_str_concat(s, rt_num_to_string(lo))
  let s = rt_str_concat(s, ",")
  let s = rt_str_concat(s, rt_num_to_string(hi))
  let s = rt_str_concat(s, "]")
  return s
end

make a function called rt_interval_add takes a, b returns tagged
  let addr_a = a band rt_payload_mask()
  let addr_b = b band rt_payload_mask()
  let lo_a = mem_peek_qword(addr_a, 0)
  let hi_a = mem_peek_qword(addr_a, 8)
  let lo_b = mem_peek_qword(addr_b, 0)
  let hi_b = mem_peek_qword(addr_b, 8)
  return rt_interval_new(lo_a + lo_b, hi_a + hi_b)
end

# [lo_a,hi_a] - [lo_b,hi_b] = [lo_a-hi_b, hi_a-lo_b] (subtracting the
# other interval's max from this min, and vice versa -- the standard
# interval-subtraction rule, not a naive component-wise subtract).
make a function called rt_interval_sub takes a, b returns tagged
  let addr_a = a band rt_payload_mask()
  let addr_b = b band rt_payload_mask()
  let lo_a = mem_peek_qword(addr_a, 0)
  let hi_a = mem_peek_qword(addr_a, 8)
  let lo_b = mem_peek_qword(addr_b, 0)
  let hi_b = mem_peek_qword(addr_b, 8)
  return rt_interval_new(lo_a - hi_b, hi_a - lo_b)
end

# min/max of the four endpoint products -- the standard interval-
# multiplication rule (needed because the sign of each endpoint isn't
# known in general, so which product is smallest/largest isn't fixed).
make a function called rt_interval_mul takes a, b returns tagged
  let addr_a = a band rt_payload_mask()
  let addr_b = b band rt_payload_mask()
  let lo_a = mem_peek_qword(addr_a, 0)
  let hi_a = mem_peek_qword(addr_a, 8)
  let lo_b = mem_peek_qword(addr_b, 0)
  let hi_b = mem_peek_qword(addr_b, 8)
  let p1 = lo_a * lo_b
  let p2 = lo_a * hi_b
  let p3 = hi_a * lo_b
  let p4 = hi_a * hi_b
  let lo = p1
  if p2 < lo then
    let lo = p2
  end
  if p3 < lo then
    let lo = p3
  end
  if p4 < lo then
    let lo = p4
  end
  let hi = p1
  if p2 > hi then
    let hi = p2
  end
  if p3 > hi then
    let hi = p3
  end
  if p4 > hi then
    let hi = p4
  end
  return rt_interval_new(lo, hi)
end

# Returns a plain 0/1, same reasoning as rt_complex_eq -- forced
# dynamic by name in codegen_x64.patlang since it calls no tower
# constructor of its own.
make a function called rt_interval_eq takes a, b returns eq
  let addr_a = a band rt_payload_mask()
  let addr_b = b band rt_payload_mask()
  let lo_a = mem_peek_qword(addr_a, 0)
  let hi_a = mem_peek_qword(addr_a, 8)
  let lo_b = mem_peek_qword(addr_b, 0)
  let hi_b = mem_peek_qword(addr_b, 8)
  if lo_a == lo_b then
    if hi_a == hi_b then
      return 1
    end
  end
  return 0
end

# ---- Object (clean, closures-based direction -- NOT the existing
# interpreter/rustc backend's oo system) ----
#
# The existing interpreter/rustc-backend Object (Value::Object, the
# `oo` prelude chunk in rust-runtime/src/ir/codegen.rs) is a string-
# keyed global-handle system tied to the older GOAP/logic-facts
# subsystem (object_new/get/send against a global name table, plus
# hardcoded methods like infer_is_adult). Per explicit user direction,
# this backend's Object does NOT mirror that -- it follows the SAME
# direction Slice 5's closures were deliberately shaped toward: a
# first-class heap value, [8-byte type id][8-byte field count][tagged
# field values...], reusing the SAME family-tag scheme every other
# composite value in this backend already uses. Fields are accessed
# by INDEX (no name->slot mapping in this first cut -- a real, named
# simplification, not an oversight). type_id is caller-assigned and
# opaque to this runtime (no built-in vtable/method dispatch yet --
# that's exactly where the closures-as-proto-objects direction from
# Slice 5 would connect, not built here).
#
# User's own explicit note, worth remembering for later: "The clean
# [design] is preferred if we will be able to revisit the legacy to
# keep it mirrored so the user experience remains the same whichever
# path is being used. Consistency is key, but that should not prevent
# us developing new implementations to improve things." -- i.e. the
# EXISTING interpreter/rustc backend's Object semantics should
# eventually migrate toward THIS model too, for cross-backend
# consistency. Not attempted in this pass (a real, separate, larger
# undertaking touching the Rust runtime itself, not just this
# self-hosted x64 backend) -- named here so it isn't lost.
#
# Object tag: family 0x5 (reserved for exactly this since the
# original tag-layout design), local bits 0 (type_id lives INSIDE the
# heap block, not in the tag itself -- unlike BigInt/Rational/Complex/
# Interval, Object needs an open-ended type space, not a fixed
# thermometer position).
#
# Object equality is IDENTITY, not value equality (objects are
# mutable heap references, mutated in place by rt_object_set --
# matching rt_list_set's own in-place-mutation convention, not the
# interpreter's copy-on-write list_set). This makes Object comparison
# genuinely simpler than Complex/Interval's: raw tagged-word equality
# (`cmp` on the whole 64-bit word) is ALREADY correct for "same
# object" and ALREADY correctly reports "not equal" against any
# differently-tagged value (different address low bits AND/OR
# different tag high bits) -- no runtime function call needed at all,
# unlike rt_complex_eq/rt_interval_eq.
#
# Arithmetic (+/-/*) on an Object operand is not meaningful and is
# NOT implemented -- codegen_x64.patlang's dispatch treats this as a
# safe, deterministic no-op (returns 0) rather than falling through
# to the wrong BigInt-family default (which would misread an Object's
# [type id][field count] header as BigInt's [sign][limb count]).

make a function called rt_object_tag returns tag
  return 5 shl 60
end

make a function called rt_object_new takes type_id, field_count returns tagged
  let addr = rt_heap_alloc(16 + field_count * 8)
  mem_poke_qword(addr, 0, type_id)
  mem_poke_qword(addr, 8, field_count)
  let i = 0
  while i < field_count do
    mem_poke_qword(addr, 16 + i * 8, rt_fixnum_pack(0))
    let i = i + 1
  end
  return addr bor rt_object_tag()
end

make a function called rt_object_type takes obj returns type_id
  let addr = obj band rt_payload_mask()
  return mem_peek_qword(addr, 0)
end

make a function called rt_object_field_count takes obj returns n
  let addr = obj band rt_payload_mask()
  return mem_peek_qword(addr, 8)
end

make a function called rt_object_get takes obj, i returns tagged
  let addr = obj band rt_payload_mask()
  return mem_peek_qword(addr, 16 + i * 8)
end

# In-place mutation (same convention as rt_list_set, not the
# interpreter's copy-on-write semantics).
make a function called rt_object_set takes obj, i, v returns done
  let addr = obj band rt_payload_mask()
  mem_poke_qword(addr, 16 + i * 8, v)
  return true
end

# ---- file I/O (self-hosting-toward-x64, step 2 of 3) ----
#
# Matches the interpreter's own read_file/write_file/file_exists call
# signatures and semantics as closely as this backend allows: read_
# file(path) returns String contents, write_file(path, contents)
# returns a boolean-like 1/0 (this backend's own bool convention, not
# the interpreter's richer Bool type), file_exists(path) returns "1"/
# "0" strings exactly like the interpreter's own convention. NAMED
# GAP: no error propagation mechanism exists in this backend at all
# (no exceptions, no Result type) -- a failed read_file returns an
# empty string rather than raising an error, unlike the interpreter's
# own Err(...) on a missing file. write_file also does NOT create
# parent directories first (the interpreter's own version does) -- a
# real, separate piece of Win32 work (recursive mkdir), deferred.

make a function called rt_read_file takes path returns tagged
  let addr = path band rt_payload_mask()
  let path_len = mem_peek_qword(addr, 0)
  let path_bytes = addr + 8
  let size = os_file_size(path_bytes, path_len)
  if size < 0 then
    let e = rt_heap_alloc(8)
    mem_poke_qword(e, 0, 0)
    return e bor rt_string_tag()
  end
  let buf = rt_heap_alloc(8 + size)
  mem_poke_qword(buf, 0, size)
  os_read_file_into(path_bytes, path_len, buf + 8, size)
  return buf bor rt_string_tag()
end

make a function called rt_write_file takes path, contents returns ok
  let addr = path band rt_payload_mask()
  let path_len = mem_peek_qword(addr, 0)
  let path_bytes = addr + 8
  let caddr = contents band rt_payload_mask()
  let data_len = mem_peek_qword(caddr, 0)
  let data_bytes = caddr + 8
  return os_write_file(path_bytes, path_len, data_bytes, data_len)
end

make a function called rt_file_exists takes path returns s
  let addr = path band rt_payload_mask()
  let path_len = mem_peek_qword(addr, 0)
  let path_bytes = addr + 8
  let size = os_file_size(path_bytes, path_len)
  if size < 0 then
    return "0"
  end
  return "1"
end

# ---- exec (self-hosting-toward-x64, step 3 of 3) ----
#
# exec_capture(path, arg1, arg2, ...) matches the interpreter's own
# call SHAPE (a variadic list of string args, not a single list
# parameter -- confirmed against rust-runtime/src/ir/codegen.rs's own
# "exec_capture" handler before implementing). codegen_x64.patlang's
# CallHost handling for "exec_capture" already knows this call site's
# argc at codegen time (every CallHost site does), so it pops all N
# tagged-string args (compile-time unrolled, same pattern
# x64_buildlist_asm already uses) into a temp heap array and calls
# rt_exec_join_args (below) to build a single space-joined command
# line -- ordinary PatLang, not raw assembly, since string-joining
# has no reason to be hand-written asm once rt_str_concat already
# exists. Only the GENUINE OS boundary (process creation + pipe
# redirection) is a native primitive: os_exec_run(cmdline_addr,
# cmdline_len) -> captured output as a plain string address (masked/
# unmasked the same as every other OS-boundary primitive's contract).
#
# NAMED GAPS versus the interpreter's own exec_capture (real
# scope limits, not oversights):
#   - stdout AND stderr are redirected to the SAME pipe (combined
#     output), not "stdout normally, stderr appended only on
#     failure" -- simpler, and still shows errors from a failing
#     invocation, just doesn't distinguish the two streams.
#   - output is capped at a fixed 65536-byte buffer -- silently
#     truncated beyond that, not truly unbounded.
#   - no quoting/escaping of arguments containing spaces (the
#     command line is a plain space-joined string) -- fine for this
#     project's own actual invocations (nasm/gcc with plain paths),
#     not general-purpose.
#   - no error propagation if CreateProcessA itself fails (bad path,
#     etc) -- returns an empty string, matching this backend's
#     existing no-exceptions-anywhere convention.

# Real bug found by an actual failed run (not review): the first
# version joined args with plain spaces, no quoting. nasm.exe's own
# real install path on Windows almost always contains a space
# ("C:\Program Files\NASM\nasm.exe"), which CreateProcessA's command-
# line parser then splits into two separate tokens -- CreateProcessA
# silently fails (no such program as "C:\Program"), and since nothing
# checked its return value, the primitive proceeded to read from a
# pipe nothing was ever writing to, returning an empty string with no
# indication anything went wrong. Fixed by wrapping every argument in
# double quotes (ASCII 34, built via mem_poke_byte -- this backend
# has no chr() primitive) -- the standard Windows command-line
# quoting convention, sufficient for ordinary paths/flags even though
# it doesn't handle a literal embedded quote character within an
# argument (not needed for this project's own actual invocations).
make a function called rt_dquote_str returns s
  let s = rt_heap_alloc(9)
  mem_poke_qword(s, 0, 1)
  mem_poke_byte(s, 8, 34)
  return s bor rt_string_tag()
end

make a function called rt_exec_join_args takes arr, count returns tagged
  let q = rt_dquote_str()
  let e = rt_heap_alloc(8)
  mem_poke_qword(e, 0, 0)
  let result = e bor rt_string_tag()
  let i = 0
  while i < count do
    let item = mem_peek_qword(arr, i * 8)
    if i > 0 then
      let result = rt_str_concat(result, " ")
    end
    let result = rt_str_concat(result, q)
    let result = rt_str_concat(result, item)
    let result = rt_str_concat(result, q)
    let i = i + 1
  end
  return result
end
