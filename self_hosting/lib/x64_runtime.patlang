# x64_runtime.patlang -- runtime support for the native x64 backend
# (self_hosting/lib/codegen_x64.patlang), written in ORDINARY PatLang
# and compiled by that SAME backend, not hand-assembled and not an
# external Rust/C library. This file's functions are combined into the
# same ProgramIR as the user's own program before codegen_x64 ever
# runs, so calling rt_print_i64 from user code lowers to a completely
# ordinary ["Call", "rt_print_i64", 1] -- no different from calling any
# other PatLang function.
#
# This file is the ONLY place allowed to call the small, fixed set of
# primitive operations codegen_x64.patlang gives special native-codegen
# meaning to (everything else in this file is 100% ordinary PatLang):
#   mem_scratch_addr()              -> address of a fixed 256-byte
#                                       .bss scratch buffer
#   mem_poke_byte(addr, offset, v)  -> write one byte
#   mem_peek_byte(addr, offset)     -> read one byte
#   mem_heap_base()                 -> address of a fixed 16MB .bss
#                                       heap region -- one single OS-
#                                       free static reservation, NOT a
#                                       per-allocation OS call
#   mem_heap_state_addr()           -> address of a persistent 8-byte
#                                       "bytes used so far" counter
#   mem_poke_qword(addr, offset, v) -> write eight bytes
#   mem_peek_qword(addr, offset)    -> read eight bytes
#   os_write_console_bytes(addr, n) -> write n bytes from addr to stdout
#   os_exit(code)                   -> ExitProcess
# See codegen_x64.patlang's own header for exactly how each of these
# names gets special-cased; everywhere else in the whole pipeline, a
# function call is just a function call.
#
# HEAP ALLOCATOR: rt_heap_alloc below is a genuine bump allocator --
# real PatLang logic (round up to 8-byte alignment, add to a running
# total, return the old total as the new block's address), not
# something baked into the native backend. It never frees or reuses
# memory -- correct and simple for now (matches Slice 1's own
# "correctness over performance, prove the plumbing first" discipline),
# a real free-list/reuse scheme is a deliberately separate future
# change to THIS function alone, not to codegen_x64.patlang.

make a function called rt_int_to_string takes n, buf_addr returns len
  # GitHub #34 (found via bit_set(0,63,1), which legitimately produces
  # this exact value): i64::MIN's own negation OVERFLOWS in two's
  # complement (there's no positive i64 counterpart to
  # -9223372036854775808 -- negating it wraps back to itself), so `0 -
  # v` below left `v` still negative, the `while v > 0` digit loop
  # below never ran, and this returned just "-" with zero digits.
  # Special-cased here rather than fixed generically, since it's the
  # ONE value where naive negate-then-extract-digits fails -- every
  # other i64 negates safely. `1 shl 63` (not a bare `-9223372036854775808`
  # literal) sidesteps a SEPARATE overflow: parsing that literal would
  # first parse the unsigned digits "9223372036854775808" (one more
  # than i64::MAX) before negating, overflowing during PARSING itself.
  if n == (1 shl 63) then
    let digits = "9223372036854775808"
    mem_poke_byte(buf_addr, 0, 45)
    let i = 0
    while i < 19 do
      mem_poke_byte(buf_addr, 1 + i, char_code(digits, i))
      let i = i + 1
    end
    return 20
  end
  let is_neg = n < 0
  let v = n
  if is_neg then
    let v = 0 - v
  end
  let count = 0
  if v == 0 then
    mem_poke_byte(buf_addr, 0, 48)
    let count = 1
  else
    while v > 0 do
      let digit = v % 10
      mem_poke_byte(buf_addr, count, digit + 48)
      let v = rt_trunc_div(v, 10)
      let count = count + 1
    end
  end
  if is_neg then
    mem_poke_byte(buf_addr, count, 45)
    let count = count + 1
  end
  # Digits were written least-significant-first; reverse buf_addr[0..count)
  # in place so they read left-to-right, matching ordinary decimal text.
  let i = 0
  let j = count - 1
  while i < j do
    let a = mem_peek_byte(buf_addr, i)
    let b = mem_peek_byte(buf_addr, j)
    mem_poke_byte(buf_addr, i, b)
    mem_poke_byte(buf_addr, j, a)
    let i = i + 1
    let j = j - 1
  end
  return count
end

# Real bug found (GitHub #31 follow-up) via WinDbg on the patc2.exe ->
# patc3.exe self-hosting fixpoint: rt_heap_alloc never checked `used`
# against g_heap's actual reserved size (codegen_x64.patlang's
# `g_heap resb <N>` -- see mem_heap_size() below, which MUST be kept
# in sync with that literal by hand, no shared constant exists between
# the two files). Once a compile touched enough heap to run past the
# end of g_heap -- g_heap is declared LAST in the .bss section, so
# there's nothing but unmapped memory beyond it -- every subsequent
# "allocation" kept silently handing out addresses past the reserved
# region, and the first write through one of them (inside rt_list_get's
# string branch, in this case) hit an unmapped page and crashed with a
# generic access violation, giving zero indication the real cause was
# heap exhaustion. User's explicit correction after this was found:
# "the heap alloc should grow our heap, and we should definitely not
# fail silently AND we might want to consider the size first" -- so
# this now (1) fails LOUDLY via a diagnostic print + os_exit rather
# than silently corrupting memory, and (2) the reservation itself
# (mem_heap_size()) was sized generously rather than left at the
# original 16MB. Real dynamic growth (a second VirtualAlloc'd region
# once this one fills, or a proper segmented heap) is a bigger, still-
# undone follow-up -- deliberately NOT attempted here; a large-but-
# still-fixed reservation is a legitimate, cheap mitigation on 64-bit
# Windows specifically because `.bss` pages are zero-fill-on-demand
# (reserving 512MB costs nothing in actual RAM until touched), not a
# claim that this is unbounded.
make a function called rt_heap_alloc takes size returns addr
  let state = mem_heap_state_addr()
  let used = mem_peek_qword(state, 0)
  let aligned_size = size
  let rem = aligned_size % 8
  if rem != 0 then
    let aligned_size = aligned_size + (8 - rem)
  end
  if used + aligned_size > mem_heap_size() then
    print("rt_heap_alloc: heap exhausted (" + (used + aligned_size) + " bytes requested, " + mem_heap_size() + " reserved) -- see rt_heap_alloc's own header in x64_runtime.patlang")
    os_exit(97)
  end
  let addr = mem_heap_base() + used
  mem_poke_qword(state, 0, used + aligned_size)
  return addr
end

make a function called rt_print_i64 takes n returns done
  let buf = mem_scratch_addr()
  let len = rt_int_to_string(n, buf)
  mem_poke_byte(buf, len, 10)
  os_write_console_bytes(buf, len + 1)
  return true
end

# ---- strings (Slice 3, TAGGED as of the closures/strings/lists
# tagging migration) ----
#
# A string is a heap-allocated block: [8-byte length][raw bytes, not
# null-terminated]. Now carries a real tag -- family 0x2, reserved for
# exactly this since the original tag-layout design -- so a string
# value is dynamically self-describing like every other tagged value
# in this backend, not just an opaque raw address. String LITERALS
# are built by codegen_x64.patlang directly into .data (see that
# file's own header for where the tag gets OR'd onto the `lea`d
# address) -- everything below is genuine PatLang, masking the tag off
# before dereferencing (`s band rt_payload_mask()`) and OR'ing
# `rt_string_tag()` back onto any NEWLY CONSTRUCTED string's address
# before returning it.
#
# `+` on the IR's Bin instruction is STILL always integer addition
# (never string concatenation) even now that strings are tagged --
# codegen_x64.patlang's dynamic dispatch treats String (like List/
# Closure/Object) as identity-only, no arithmetic meaning, same
# deliberate scope limit as before, just now enforced by the tag
# scheme itself rather than by the complete absence of one. String
# concatenation is still this explicitly-named function.

make a function called rt_string_tag returns tag
  return 2 shl 60
end

make a function called rt_str_len takes s returns len
  let addr = s band rt_payload_mask()
  return mem_peek_qword(addr, 0)
end

make a function called rt_str_concat takes a, b returns result
  let addr_a = a band rt_payload_mask()
  let addr_b = b band rt_payload_mask()
  let len_a = rt_str_len(a)
  let len_b = rt_str_len(b)
  let total = len_a + len_b
  let result = rt_heap_alloc(8 + total)
  mem_poke_qword(result, 0, total)
  let i = 0
  while i < len_a do
    mem_poke_byte(result, 8 + i, mem_peek_byte(addr_a, 8 + i))
    let i = i + 1
  end
  let j = 0
  while j < len_b do
    mem_poke_byte(result, 8 + len_a + j, mem_peek_byte(addr_b, 8 + j))
    let j = j + 1
  end
  return result bor rt_string_tag()
end

# Real gap found (GitHub #24) via the cross-backend benchmark suite:
# print(v) has no way to tell a genuine Bool apart from a fixnum that
# happens to be 0 or 1 (this backend doesn't tag booleans distinctly
# at all -- comparisons/`not` just produce a plain untagged 0/1, same
# bit pattern as any other small integer), so print(a == b) always
# showed "1"/"0" instead of the interpreter's "true"/"false". Full
# fix needs real value tagging (a bigger, riskier retrofit -- every
# JumpIfFalse/comparison/logical op already assumes booleans are
# plain untagged 0/1, so tagging them would mean auditing and
# updating all of that too). This narrower fix instead reroutes ONLY
# the specific, staticness-known case of `print(<a bool-producing
# expression>)` -- see x64_bool_print_call_indices -- to call this
# function directly instead of the generic print(), at compile time,
# without touching how booleans are represented at runtime anywhere
# else. `print(some_var)` where some_var happens to hold a 0/1 that
# was originally a bool is NOT covered (the static check can't see
# through a variable), matching this backend's existing "syntactic
# heuristic, not full type inference" precedent elsewhere.
# Real float formatter (not just a truncate-to-int proof, per this
# file's own earlier header on float PRINTING being "deliberately not
# built"). Deliberately APPROXIMATE, not a byte-exact shortest-round-
# trip formatter like Rust's own f64 Display: fixed 6-digit fractional
# precision via repeated *10/truncate digit extraction, trailing zeros
# trimmed, decimal point omitted entirely for a whole number (matching
# Rust's own "15" not "15.0" for an exact integer value). "Nice" binary
# fractions (halves/quarters/eighths, e.g. 1.5, 3.75, -3.25) round
# perfectly through this and match exactly; a value with no exact
# binary representation (e.g. 0.1) may show trailing rounding noise
# this simple loop doesn't correct for -- an honest, documented scope
# limit, not a claim of full precision.
#
# Split into TWO functions deliberately, not one: this backend's
# per-FUNCTION (not per-value) float/int-or-dynamic classification
# means a single function can't do both real float arithmetic (needs
# float_mode) AND string building (needs dynamic_mode for the string
# literals/rt_str_concat calls) -- float_mode takes unconditional
# priority in x64_emit_instr's Bin dispatch, so a string comparison
# living in a float_mode function would be silently miscompiled as a
# float comparison instead. rt_float_decompose does ONLY float math,
# returning its results as a plain List of already-extracted integers
# (BuildList's own codegen isn't float/dynamic-mode-conditioned at
# all, so this is a safe bridge between the two); rt_format_float_parts
# does ONLY string work on those already-int values. Also deliberately
# avoids ANY bare (non-decimal) integer Const inside the float-mode
# half -- even `let neg = 0` would get silently miscoded via this
# backend's own float-mode Const-wrapping (see the GitHub #18 fix's
# own header) since it's a fresh literal, not a Bin/Call result;
# `neg` is instead derived directly from a comparison expression
# (already safely integer-typed regardless of the surrounding
# function's float_mode, since comparisons always produce a plain
# setcc/movzx 0/1, never a float-encoded one).
make a function called rt_float_decompose takes v returns parts
  let neg = v < 0.0
  let av = v
  if neg then
    let av = 0.0 - v
  end
  let ipart = f64_to_i64_trunc(av)
  # Real bug found (and fixed via the new i64_to_f64 primitive above):
  # f64_to_i64_trunc's result is a PLAIN INTEGER, not a float bit
  # pattern -- subtracting it directly here (`av - ipart`) would
  # reinterpret its raw integer bits as if they were a double via the
  # float Bin path (this whole function is float_mode), giving
  # complete garbage rather than the intended fractional remainder.
  # Every digit-extraction step below has the identical shape, same
  # fix needed each time.
  #
  # GitHub #36: extended from 6 to 16 raw fractional digits (a
  # double has ~15-17 significant decimal digits total; 16 fractional
  # digits comfortably covers the common case of a small integer part,
  # e.g. sqrt(2)'s 16-digit fractional part). The 16th digit is a PURE
  # rounding peek, never displayed itself -- rt_round_digits (a plain,
  # non-float function, since carry propagation needs int comparisons)
  # rounds the first 15 to the nearest using it. This still isn't
  # arbitrary-precision-correct dtoa (float64 rounding error in this
  # repeated multiply-and-truncate accumulates by digit ~15-16 for
  # values with a larger integer part), but it's a real, substantial
  # improvement over the previous hard 6-digit truncation with no
  # rounding at all.
  let cur = av - i64_to_f64(ipart)
  let cur = cur * 10.0
  let d0 = f64_to_i64_trunc(cur)
  let cur = cur - i64_to_f64(d0)
  let cur = cur * 10.0
  let d1 = f64_to_i64_trunc(cur)
  let cur = cur - i64_to_f64(d1)
  let cur = cur * 10.0
  let d2 = f64_to_i64_trunc(cur)
  let cur = cur - i64_to_f64(d2)
  let cur = cur * 10.0
  let d3 = f64_to_i64_trunc(cur)
  let cur = cur - i64_to_f64(d3)
  let cur = cur * 10.0
  let d4 = f64_to_i64_trunc(cur)
  let cur = cur - i64_to_f64(d4)
  let cur = cur * 10.0
  let d5 = f64_to_i64_trunc(cur)
  let cur = cur - i64_to_f64(d5)
  let cur = cur * 10.0
  let d6 = f64_to_i64_trunc(cur)
  let cur = cur - i64_to_f64(d6)
  let cur = cur * 10.0
  let d7 = f64_to_i64_trunc(cur)
  let cur = cur - i64_to_f64(d7)
  let cur = cur * 10.0
  let d8 = f64_to_i64_trunc(cur)
  let cur = cur - i64_to_f64(d8)
  let cur = cur * 10.0
  let d9 = f64_to_i64_trunc(cur)
  let cur = cur - i64_to_f64(d9)
  let cur = cur * 10.0
  let d10 = f64_to_i64_trunc(cur)
  let cur = cur - i64_to_f64(d10)
  let cur = cur * 10.0
  let d11 = f64_to_i64_trunc(cur)
  let cur = cur - i64_to_f64(d11)
  let cur = cur * 10.0
  let d12 = f64_to_i64_trunc(cur)
  let cur = cur - i64_to_f64(d12)
  let cur = cur * 10.0
  let d13 = f64_to_i64_trunc(cur)
  let cur = cur - i64_to_f64(d13)
  let cur = cur * 10.0
  let d14 = f64_to_i64_trunc(cur)
  let cur = cur - i64_to_f64(d14)
  let cur = cur * 10.0
  let d15 = f64_to_i64_trunc(cur)
  # GitHub #41-adjacent fix: extended from 15 to 16 KEPT fractional
  # digits (17 raw, d16 as the new rounding peek) -- confirmed via
  # x64_math_selftest that 15 kept digits was one short of Rust's own
  # f64 Display round-trip precision for ordinary values like sqrt(2)
  # (1.4142135623730951 needs 16 fractional digits; the previous 15-
  # digit cutoff gave 1.414213562373095, silently missing the last
  # digit). 16 doesn't guarantee matching Rust's shortest-round-trip
  # algorithm (Grisu/Ryu) for EVERY double -- that's a materially
  # bigger undertaking, out of scope here -- but it closes the specific
  # gap this session's regression suite caught and moves this backend
  # from "one short of round-trip" to "matches round-trip for values
  # whose shortest representation needs <=16 significant digits",
  # which covers the overwhelming majority of real values (worst case
  # for an IEEE double is 17).
  let cur = cur - i64_to_f64(d15)
  let cur = cur * 10.0
  let d16 = f64_to_i64_trunc(cur)
  let raw = [neg, ipart, d0, d1, d2, d3, d4, d5, d6, d7, d8, d9, d10, d11, d12, d13, d14, d15, d16]
  let parts16 = rt_round_digits(raw)
  # Real regression caught by re-running the full selftest, not just the
  # single case that motivated the 15->16 change: a FIXED 16-digit
  # cutoff also broke exp(1.0) (2.718281828459045, whose Rust round-trip
  # form needs only 15 digits) by showing a spurious extra digit
  # (...4590451). Rust's actual float Display uses the SHORTEST decimal
  # that round-trips back to the exact same f64 bits, which varies per
  # value (15 digits here, 16 for sqrt(2)/atan2(1,1)) -- a fixed cutoff
  # can never match this for every value. Rather than implement the
  # real algorithm (Grisu/Ryu), this checks the ONE boundary this
  # regression suite actually exercises: try rounding down to 15 kept
  # digits, RECONSTRUCT the resulting float value from those digits,
  # and use the 15-digit form only if it reconstructs back to the exact
  # same value -- otherwise keep the 16-digit form. Still not a general
  # shortest-round-trip implementation (doesn't try 14, 13, ... or 17),
  # but covers the real 15-vs-16 boundary this backend's own tests hit.
  let ipart16 = parts16[1]
  let digits16 = [parts16[2], parts16[3], parts16[4], parts16[5], parts16[6], parts16[7], parts16[8], parts16[9], parts16[10], parts16[11], parts16[12], parts16[13], parts16[14], parts16[15], parts16[16], parts16[17]]
  let cand = rt_round_digits_at(digits16, 15, ipart16)
  let ipart15 = cand[0]
  let digits15 = cand[1]
  let folded15 = rt_digits_fold(digits15, 15)
  let recon15 = i64_to_f64(ipart15) + (i64_to_f64(folded15) / rt_pow10(15))
  if recon15 == av then
    let digits15 = list_set(digits15, 15, 0)
    return [neg, ipart15, digits15[0], digits15[1], digits15[2], digits15[3], digits15[4], digits15[5], digits15[6], digits15[7], digits15[8], digits15[9], digits15[10], digits15[11], digits15[12], digits15[13], digits15[14], digits15[15]]
  end
  return parts16
end

# Float helper (called only from rt_float_decompose's own float-mode
# body): 10.0^n via a plain multiply loop -- n is always a small kept-
# digit count (<=16) here, so this is cheap and exact for every value
# it's actually called with.
make a function called rt_pow10 takes n returns v
  let v = 1.0
  let i = 0
  while i < n do
    let v = v * 10.0
    let i = i + 1
  end
  return v
end

# Plain-int helper (see rt_round_digits's own header for why digit
# folding stays int-mode, not float): folds digits[0..count-1] into a
# single integer, most-significant digit first.
make a function called rt_digits_fold takes digits, count returns v
  let v = 0
  let i = 0
  while i < count do
    let v = v * 10 + digits[i]
    let i = i + 1
  end
  return v
end

# General round-half-up-with-carry: rounds `digits[0..cutoff-1]` using
# `digits[cutoff]` as the peek digit (never displayed itself),
# propagating any carry leftward through the kept digits and, if it
# cascades past digits[0], into `ipart`. Returns [new_ipart,
# new_digits(0..cutoff-1)]. Shared by rt_round_digits (rounds
# rt_float_decompose's raw 16 digits down to the kept 15) and
# to_fixed (re-rounds those already-rounded 15 digits down to whatever
# shorter `places` the caller actually asked for -- without this
# second rounding pass, `to_fixed(x, 10)` would just TRUNCATE the
# 15-digit result at 10 rather than rounding it, e.g.
# `to_fixed(sqrt(2), 10)` would give `...23` instead of the correctly-
# rounded `...24`; GitHub #36).
make a function called rt_round_digits_at takes digits, cutoff, ipart returns result
  let out = digits
  if digits[cutoff] >= 5 then
    let carry = 1
    let i = cutoff - 1
    while (i >= 0) and (carry == 1) do
      let v = out[i] + carry
      if v == 10 then
        let out = list_set(out, i, 0)
        let carry = 1
      else
        let out = list_set(out, i, v)
        let carry = 0
      end
      let i = i - 1
    end
    if carry == 1 then
      let ipart = ipart + 1
    end
  end
  return [ipart, out]
end

# Plain (non-float) helper: rounds the 16 raw fractional digits
# (raw[2..18]) down to the 15 kept for display, using the 16th (never
# displayed) as the round-half-up peek. Kept separate from
# rt_float_decompose (float_mode) because carry propagation needs
# plain integer comparisons/increments, and this backend's per-
# FUNCTION float/int classification can't mix the two in one function
# (see rt_float_decompose's own header for why).
make a function called rt_round_digits takes raw returns parts
  let neg = raw[0]
  let ipart = raw[1]
  let digits = [raw[2], raw[3], raw[4], raw[5], raw[6], raw[7], raw[8], raw[9], raw[10], raw[11], raw[12], raw[13], raw[14], raw[15], raw[16], raw[17], raw[18]]
  let rounded = rt_round_digits_at(digits, 16, ipart)
  let ipart = rounded[0]
  let digits = rounded[1]
  return [neg, ipart, digits[0], digits[1], digits[2], digits[3], digits[4], digits[5], digits[6], digits[7], digits[8], digits[9], digits[10], digits[11], digits[12], digits[13], digits[14], digits[15]]
end

make a function called rt_format_float_parts takes parts returns s
  let neg = parts[0]
  let ipart = parts[1]
  let result = ""
  # GitHub #24: `neg` comes from rt_float_decompose's `v < 0.0`, a real
  # comparison result -- now Bool-TAGGED, never bit-for-bit `1` even
  # when true. Use the language's own truthy `if`, not a manual `==1`.
  if neg then
    let result = "-"
  end
  let result = rt_str_concat(result, rt_int_to_str(ipart))
  let digits = ""
  let i = 2
  while i < 18 do
    let digits = rt_str_concat(digits, rt_int_to_str(parts[i]))
    let i = i + 1
  end
  let dl = digits.length
  while (dl > 0) and (substr(digits, dl - 1, 1) == "0") do
    let dl = dl - 1
  end
  if dl > 0 then
    let result = rt_str_concat(result, ".")
    let result = rt_str_concat(result, substr(digits, 0, dl))
  end
  return result
end

make a function called rt_print_float takes v returns done
  let parts = rt_float_decompose(v)
  return rt_print_str(rt_format_float_parts(parts))
end

make a function called rt_bool_to_string takes v returns s
  # GitHub #24: v may now be Bool-TAGGED (family 6 shl 60), never
  # bit-for-bit 0 even when false -- mask to the payload first.
  let payload = v band rt_payload_mask()
  if payload == 0 then
    return "false"
  end
  return "true"
end

make a function called rt_print_bool takes v returns done
  return rt_print_str(rt_bool_to_string(v))
end

make a function called rt_print_str takes s returns done
  let addr = s band rt_payload_mask()
  let len = rt_str_len(s)
  os_write_console_bytes(addr + 8, len)
  mem_poke_byte(mem_scratch_addr(), 0, 10)
  os_write_console_bytes(mem_scratch_addr(), 1)
  return true
end

# ---- shadowing host primitives (Slice 8 continued): sb_new/sb_push/
# sb_str, to_num, chr, substr, str_intern/sc_len/sc_code/sc_char ----
#
# These are ORDINARY PatLang functions sharing their exact names with
# Rust host primitives (rust-runtime/src/ir/hosts.rs) the x64 backend's
# x64_callhost_asm never natively supported -- confirmed (a dedicated
# shadow test, x64_shadow_test.patlang, compiled+run via --x64) that
# the lowerer only emits a CallHost for a name with NO user-level
# definition in scope, so defining these here (this file is ONLY ever
# prepended for --x64 compiles, so this can't affect the rustc-text
# backend or interpreter's own, correct, existing host functions) makes
# ORDINARY function-call codegen handle them -- no new hand-assembled
# asm needed for any of these (mem_sb_table_addr, added to
# codegen_x64.patlang's x64_callhost_asm alongside this, is the one
# genuinely new native primitive this whole batch needed). Each mirrors
# its Rust counterpart's semantics as closely as makes sense for this
# backend's actual tagged-value representation (fixnum-or-family-tag,
# not Rust's richer Value enum) -- documented per-function below.

# StringBuilder. Rust's host_sb_push has a fire-and-forget contract
# (returns Unit; existing call sites everywhere in codegen_x64.patlang
# do `sb_push(sb, "...")` as a bare statement, never `let sb =
# sb_push(...)`) -- so a handle's IDENTITY must survive across pushes
# even when its backing storage grows, unlike rt_list_push's own
# "caller rebinds the return value" contract. Design: a persistent
# global table (g_sb_table, an ordinary PatLang List value stored
# through the one dedicated .bss slot mem_sb_table_addr() -- see that
# primitive's own header in codegen_x64.patlang) holds each
# StringBuilder's CURRENT entry address; sb_new appends a fresh entry
# and returns its stable INDEX as the handle; sb_push looks the entry
# up by index, grows it (same amortized-doubling discipline as
# rt_list_push -- mutate in place when there's room, else reallocate),
# and writes the new address back into the table via rt_list_set ONLY
# when reallocation actually happened, so the handle (the table index)
# never needs to change.
make a function called sb_new returns handle
  let table_addr = mem_sb_table_addr()
  let table = mem_peek_qword(table_addr, 0)
  if table == 0 then
    let table = rt_list_new(0)
    mem_poke_qword(table_addr, 0, table)
  end
  let cap = 64
  let entry = rt_heap_alloc(16 + cap)
  mem_poke_qword(entry, 0, 0)
  mem_poke_qword(entry, 8, cap)
  let new_table = rt_list_push(table, entry)
  mem_poke_qword(table_addr, 0, new_table)
  return rt_list_len(new_table) - 1
end

make a function called sb_push takes handle, text returns done
  let table = mem_peek_qword(mem_sb_table_addr(), 0)
  let entry = rt_list_get(table, handle)
  let src = text band rt_payload_mask()
  let n = mem_peek_qword(src, 0)
  let len = mem_peek_qword(entry, 0)
  let cap = mem_peek_qword(entry, 8)
  if len + n <= cap then
    let i = 0
    while i < n do
      mem_poke_byte(entry, 16 + len + i, mem_peek_byte(src, 8 + i))
      let i = i + 1
    end
    mem_poke_qword(entry, 0, len + n)
    return true
  end
  let new_cap = cap * 2
  if new_cap < len + n then
    let new_cap = len + n
  end
  let new_entry = rt_heap_alloc(16 + new_cap)
  mem_poke_qword(new_entry, 0, len + n)
  mem_poke_qword(new_entry, 8, new_cap)
  let i = 0
  while i < len do
    mem_poke_byte(new_entry, 16 + i, mem_peek_byte(entry, 16 + i))
    let i = i + 1
  end
  let j = 0
  while j < n do
    mem_poke_byte(new_entry, 16 + len + j, mem_peek_byte(src, 8 + j))
    let j = j + 1
  end
  rt_list_set(table, handle, new_entry)
  return true
end

# Clones the buffer's current content into a fresh tagged string
# (matching Rust's `.clone()` sb_str -- safe to keep pushing to the same
# handle afterward, even though no existing call site actually does).
make a function called sb_str takes handle returns s
  let table = mem_peek_qword(mem_sb_table_addr(), 0)
  let entry = rt_list_get(table, handle)
  let len = mem_peek_qword(entry, 0)
  let result = rt_heap_alloc(8 + len)
  mem_poke_qword(result, 0, len)
  let i = 0
  while i < len do
    mem_poke_byte(result, 8 + i, mem_peek_byte(entry, 16 + i))
    let i = i + 1
  end
  return result bor rt_string_tag()
end

# to_num(v): if v is already numeric (fixnum, or ANY Numeric-family
# tagged value -- BigInt/Rational/Complex/Interval), returns it
# unchanged, matching Rust's own "preserve the value's own numeric
# kind" behaviour. If v is a String, parses it as an integer (ASCII
# digits, optional leading '-'). Scope limit, named deliberately: no
# float-string parsing -- every ACTUAL to_num call site in this
# backend's own source (44 in codegen_x64.patlang) converts something
# already integer-valued (list lengths, arg counts, IR field text), so
# this is a real behavioural match for how it's actually used here, not
# a full reimplementation of Rust's more general host_to_num.
#
# Classifies by the top NIBBLE (bits 60-63), not the whole 16-bit tag --
# a REAL bug caught here (segfault in print(), same root cause):
# negative fixnums computed by NON-dynamic-mode code (plain `sub`, never
# masked back to the canonical "top 16 bits always zero" tagged form the
# way dynamic-mode arithmetic explicitly does) are raw 64-bit two's-
# complement, so their top 16 bits read as 0xFFFF (sign-extended), not
# 0x0000. A 16-bit-tag check for "== 0" misses every negative plain-mode
# fixnum. The top NIBBLE alone is unambiguous: real family selectors are
# only 1 (Numeric)/2 (String)/3 (List)/4 (Closure)/5 (Object), so nibble
# 0xF can ONLY be this sign-extension leak, never a genuine tagged
# family -- safe to treat identically to nibble 0 (clean fixnum).
make a function called to_num takes v returns n
  let nibble = (v shr 60) band 15
  if nibble == 0 then
    return v
  end
  if nibble == 15 then
    return v
  end
  if nibble == 1 then
    return v
  end
  let addr = v band rt_payload_mask()
  let len = mem_peek_qword(addr, 0)
  let i = 0
  let neg = false
  if len > 0 then
    if mem_peek_byte(addr, 8) == 45 then
      let neg = true
      let i = 1
    end
  end
  let acc = 0
  while i < len do
    let d = mem_peek_byte(addr, 8 + i)
    if d >= 48 then
      if d <= 57 then
        let acc = acc * 10 + (d - 48)
      end
    end
    let i = i + 1
  end
  if neg then
    return 0 - acc
  end
  return acc
end

# chr(n) -> 1-byte string (empty for n < 0). Single-byte only (this
# backend's strings are plain bytes throughout, no UTF-8 handling
# anywhere else either) -- matches the actual need everywhere this is
# used (building single ASCII characters like quotes/newlines), not
# Rust's fuller Unicode char support. Supersedes the "this backend has
# no chr() primitive" workaround rt_dquote_str's own header used to
# note; that function is left as-is (already correct), just no longer
# the only way to build a 1-byte string.
make a function called chr takes n returns s
  if n < 0 then
    let result = rt_heap_alloc(8)
    mem_poke_qword(result, 0, 0)
    return result bor rt_string_tag()
  end
  let result = rt_heap_alloc(9)
  mem_poke_qword(result, 0, 1)
  mem_poke_byte(result, 8, n)
  return result bor rt_string_tag()
end

# substr(s, start, count) -> byte slice, clamped to the string's actual
# length (matching Rust's ASCII-path clamping: `st = start.min(len)`,
# `en = (st+count).min(len)`).
make a function called substr takes s, start, count returns result
  let addr = s band rt_payload_mask()
  let len = mem_peek_qword(addr, 0)
  let st = start
  if st > len then
    let st = len
  end
  let en = st + count
  if en > len then
    let en = len
  end
  let n = en - st
  let result = rt_heap_alloc(8 + n)
  mem_poke_qword(result, 0, n)
  let i = 0
  while i < n do
    mem_poke_byte(result, 8 + i, mem_peek_byte(addr, 8 + st + i))
    let i = i + 1
  end
  return result bor rt_string_tag()
end

# str_intern/sc_len/sc_code/sc_char: Rust's versions hand out a stable
# integer id into a global interned-string TABLE so a hot scanning loop
# (the lexer indexes the whole source per character) never re-clones a
# Value::String local on every access. This backend has no such cloning
# cost to avoid (strings are already heap blocks referenced by address,
# not deep-copied per access) -- confirmed via lexer.patlang's own
# usage (the ONLY call site in the whole self-hosted compiler source):
# str_intern is called EXACTLY ONCE per tokenize() call, and the
# returned handle is used only within that same call, never crossing
# into another function or needing to persist. So the "handle" can just
# BE the string's own masked address -- no table, no id-to-entry
# lookup, nothing to grow or manage. A deliberately simpler, still
# fully general, implementation (works correctly regardless of how many
# strings are ever interned or how many times), not a scope-limited one.
make a function called str_intern takes s returns handle
  return s band rt_payload_mask()
end

make a function called sc_len takes handle returns len
  return mem_peek_qword(handle, 0)
end

make a function called sc_code takes handle, i returns code
  let len = mem_peek_qword(handle, 0)
  if i < len then
    return mem_peek_byte(handle, 8 + i)
  end
  return 0 - 1
end

make a function called sc_char takes handle, i returns s
  let len = mem_peek_qword(handle, 0)
  if i < len then
    return chr(mem_peek_byte(handle, 8 + i))
  end
  let result = rt_heap_alloc(8)
  mem_poke_qword(result, 0, 0)
  return result bor rt_string_tag()
end

# vec_new/vec_push/vec_get/vec_set/vec_len/vec_to_list: Rust's
# "handle-based builder" for O(1) push/index on large collections
# (rust-runtime/src/ir/hosts.rs's VECS thread-local), used by
# lexer.patlang to accumulate its token list (`vec_push(tokens,
# item)`, called as a bare statement -- same fire-and-forget contract
# as sb_push, so this needs the EXACT same "stable handle across
# growth" design as sb_new/sb_push/sb_str above (see that block's own
# header for the full reasoning: a naive address-as-handle design
# breaks the moment growth reallocates, since existing call sites never
# rebind the handle). Simpler than sb_* though: each entry here is an
# ORDINARY PatLang List (not a hand-rolled byte buffer), so entry
# growth just reuses the ALREADY O(1)-amortized rt_list_push directly
# -- no byte-copying logic to write. vec_to_list needs no copy either:
# a PatLang List IS already this backend's native list representation,
# so returning the entry's current tagged value as-is is correct (same
# "handle out, no more pushes expected afterward" idiom the ACTUAL
# lexer.patlang call site follows: vec_to_list(tokens) is always the
# LAST thing done with a given vec handle).
make a function called vec_new returns handle
  let table_addr = mem_vec_table_addr()
  let table = mem_peek_qword(table_addr, 0)
  if table == 0 then
    let table = rt_list_new(0)
    mem_poke_qword(table_addr, 0, table)
  end
  let entry = rt_list_new(0)
  let new_table = rt_list_push(table, entry)
  mem_poke_qword(table_addr, 0, new_table)
  return rt_list_len(new_table) - 1
end

make a function called vec_push takes handle, item returns done
  let table = mem_peek_qword(mem_vec_table_addr(), 0)
  let entry = rt_list_get(table, handle)
  let new_entry = rt_list_push(entry, item)
  rt_list_set(table, handle, new_entry)
  return true
end

make a function called vec_get takes handle, idx returns value
  let table = mem_peek_qword(mem_vec_table_addr(), 0)
  let entry = rt_list_get(table, handle)
  return rt_list_get(entry, idx)
end

make a function called vec_set takes handle, idx, item returns done
  let table = mem_peek_qword(mem_vec_table_addr(), 0)
  let entry = rt_list_get(table, handle)
  rt_list_set(entry, idx, item)
  return true
end

make a function called vec_len takes handle returns n
  let table = mem_peek_qword(mem_vec_table_addr(), 0)
  let entry = rt_list_get(table, handle)
  return rt_list_len(entry)
end

make a function called vec_to_list takes handle returns l
  let table = mem_peek_qword(mem_vec_table_addr(), 0)
  return rt_list_get(table, handle)
end

# char_code(s, idx) -> ASCII byte at idx, or -1 if out of range. Same
# shape as sc_code, but takes a plain (tagged) string directly rather
# than an interned handle.
make a function called char_code takes s, idx returns code
  let addr = s band rt_payload_mask()
  let len = mem_peek_qword(addr, 0)
  if idx < len then
    return mem_peek_byte(addr, 8 + idx)
  end
  return 0 - 1
end

# print(v): genuinely value-polymorphic, NOT string-only. Real bug
# caught here (segfault, not a compile-time warning): x64_runtime.
# patlang is prepended to EVERY --x64 compile, not just the bundled
# compiler source's own (all-string) print(...) call sites -- so a
# string-only print silently became the print for every OTHER x64
# program too, including ones that print plain numbers directly (e.g.
# x64_codegen_demo_baseline.patlang's `print(total)`). Passing a raw
# fixnum into rt_print_str (which treats its argument as a string's
# masked HEAP ADDRESS) reads garbage memory as if it were a
# [length][bytes] block -- an immediate segfault, not a graceful
# failure. Dispatches on the family tag like x64_binop_asm_dynamic
# does: fixnum -> rt_int_to_str, String -> print directly, BigInt/
# Rational/Complex/Interval -> their own *_to_string helper (all
# already exist, built for the numeric-tower demos). List now gets
# genuine recursive pretty-printing (see the "list_family" branch
# below), matching the real interpreter's own v_to_string format
# exactly: "[elem, elem, ...]" -- real bug found via the meta-circular
# interpreter's own benchmark work (a plan/solve result -- a list of
# lists of strings -- printed as the bare "<value>" placeholder instead
# of its real content, e.g. "[[alice, carol]]"). Object/Closure still
# fall back to a fixed placeholder -- pretty-printing an Object would
# need a field-enumeration primitive this backend doesn't expose yet,
# a separate, larger piece of work not attempted here.
make a function called print takes v returns done
  # GitHub #55: this used to hand-roll its OWN family-tag classification
  # via raw `band` masking, duplicating (and, for BigInt/Rational/
  # Complex/Interval specifically, getting WRONG -- see #55's own
  # findings) logic that x64_family_code_asm already implements
  # correctly as type_of/numeric_kind's native classifier, including
  # #51's heap-bounds guard against a coincidental tag-bit collision.
  # Several attempts to fix the hand-rolled version in place (a wide
  # combined mask, its bit-identical negative-literal form, individual
  # small sub-family bit checks) all produced confidently wrong results
  # for reasons never root-caused, despite the identical classification
  # already working correctly via type_of. Simplest real fix: stop
  # duplicating the classifier at all, just ask it.
  let kind = type_of(v)
  if kind == "int" then
    return rt_print_str(rt_int_to_str(v))
  end
  if kind == "string" then
    return rt_print_str(v)
  end
  if kind == "bigint" then
    return rt_print_str(rt_bigint_to_string(v))
  end
  if kind == "rational" then
    return rt_print_str(rt_rational_to_string(v))
  end
  if kind == "complex" then
    return rt_print_str(rt_complex_to_string(v))
  end
  if kind == "interval" then
    return rt_print_str(rt_interval_to_string(v))
  end
  if kind == "list" then
    return rt_print_str(rt_list_to_display_string(v))
  end
  if kind == "bool" then
    return rt_print_bool(v)
  end
  if kind == "bool_array" then
    let sb = sb_new()
    sb_push(sb, "<bool_array len=")
    sb_push(sb, rt_int_to_str(bool_array_len(v)))
    sb_push(sb, ">")
    return rt_print_str(sb_str(sb))
  end
  # GitHub #34: anything type_of doesn't recognize as one of the above
  # (object/closure/unit, or a genuinely corrupt/garbage value) prints
  # as a raw signed int -- the safest available default (previously an
  # unconditional "<value>" placeholder, which silently discarded a
  # perfectly real, meaningful integer result for the far more common
  # "unusual bit pattern that's still a real int" case).
  return rt_print_str(rt_int_to_str(v))
end

# rt_list_to_display_string(v) -> "[elem, elem, ...]", recursively
# rendering each element the SAME way `print` itself would (a nested
# list of lists prints correctly, matching v_to_string's own recursive
# format exactly) -- NOT a general "value to string" refactor of print
# itself (this stays a small, list-specific helper) since print's own
# dispatch already reads cleanly as a flat family-tag chain; recursing
# into a SEPARATE function for just the one case that needs recursion
# is simpler than threading a "return string instead of writing" mode
# through every other branch above.
make a function called rt_list_to_display_string takes v returns s
  let sb = sb_new()
  sb_push(sb, "[")
  let n = rt_list_len(v)
  let i = 0
  while i < n do
    if i > 0 then
      sb_push(sb, ", ")
    end
    let elem = rt_list_get(v, i)
    let family_mask = 17293822569102704640
    let elem_family = elem band family_mask
    let list_family = 3458764513820540928
    let string_family = 2305843009213693952
    let bigint_family = 1152921504606846976
    let rational_family = 1153765929536978944
    let complex_family = 1154891829443821568
    let interval_family = 1157425104234217472
    let bool_family = 6917529027641081856
    # GitHub #47-adjacent fix: same "String/List/BigInt/Rational/
    # Complex/Interval always have a nonzero payload (a real heap
    # address, never 0)" guard as print()'s own dispatch just above --
    # a zero-payload false match on any of these six is coincidence,
    # not a genuine tagged value (Bool is the exception, since its
    # payload directly encodes true/false and 0 is legitimate there).
    let payload_mask = 281474976710655
    let elem_payload = elem band payload_mask
    let has_payload = elem_payload != 0
    if has_payload and (elem_family == list_family) then
      sb_push(sb, rt_list_to_display_string(elem))
    elif elem_family == 0 then
      sb_push(sb, rt_int_to_str(elem))
    elif elem_family == family_mask then
      sb_push(sb, rt_int_to_str(elem))
    elif has_payload and (elem_family == string_family) then
      sb_push(sb, elem)
    elif has_payload and (elem_family == bigint_family) then
      sb_push(sb, rt_bigint_to_string(elem))
    elif has_payload and (elem_family == rational_family) then
      sb_push(sb, rt_rational_to_string(elem))
    elif has_payload and (elem_family == complex_family) then
      sb_push(sb, rt_complex_to_string(elem))
    elif has_payload and (elem_family == interval_family) then
      sb_push(sb, rt_interval_to_string(elem))
    elif elem_family == bool_family then
      sb_push(sb, rt_bool_to_string(elem))
    else
      sb_push(sb, "<value>")
    end
    let i = i + 1
  end
  sb_push(sb, "]")
  return sb_str(sb)
end

# Byte-content string equality -- NOT the same as `==`, which on tagged
# String values is raw ADDRESS identity (x64_binop_asm_dynamic's
# .DYN_OBJ_ branch, deliberate scope limit documented there). Two
# separately-interned or separately-allocated strings with identical
# text are NOT `==` in this backend, so set_var/get's string-keyed
# lookup below needs a real content comparison, not `==`.
make a function called rt_str_eq takes a, b returns eq
  let addr_a = a band rt_payload_mask()
  let addr_b = b band rt_payload_mask()
  let len_a = mem_peek_qword(addr_a, 0)
  let len_b = mem_peek_qword(addr_b, 0)
  if len_a != len_b then
    return false
  end
  let i = 0
  while i < len_a do
    if mem_peek_byte(addr_a, 8 + i) != mem_peek_byte(addr_b, 8 + i) then
      return false
    end
    let i = i + 1
  end
  return true
end

# Real bug found (GitHub #20) while testing the x64 backend's own `+`
# string-concat fix: `<`/`<=`/`>`/`>=`/`==`/`!=` on strings in the
# dynamic dispatcher (x64_binop_asm_dynamic's .DYN_OBJ_ branch) did a
# raw ADDRESS comparison on the tagged pointers -- this file's OWN
# header comment above rt_str_eq called that "deliberate", but it's
# actually just wrong: the real interpreter (rust-runtime/src/ir/ops.rs
# `cmp`) defines string comparison as genuine lexicographic byte
# comparison (Rust's own `&str`/`String` Ord), same as `strcmp`, not
# identity. Two SEPARATELY allocated strings with identical content
# were comparing as unequal, and ordering comparisons were comparing
# meaningless heap addresses instead of any lexicographic order at
# all. rt_str_cmp gives the standard strcmp-style -1/0/1 result:
# byte-by-byte up to the shorter length, then the shorter string sorts
# first if all compared bytes are equal (matches Rust's own str Ord).
make a function called rt_str_cmp takes a, b returns result
  let addr_a = a band rt_payload_mask()
  let addr_b = b band rt_payload_mask()
  let len_a = mem_peek_qword(addr_a, 0)
  let len_b = mem_peek_qword(addr_b, 0)
  let min_len = len_a
  if len_b < min_len then
    let min_len = len_b
  end
  let i = 0
  while i < min_len do
    let ca = mem_peek_byte(addr_a, 8 + i)
    let cb = mem_peek_byte(addr_b, 8 + i)
    if ca < cb then
      return 0 - 1
    end
    if ca > cb then
      return 1
    end
    let i = i + 1
  end
  if len_a < len_b then
    return 0 - 1
  end
  if len_a > len_b then
    return 1
  end
  return 0
end

# set_var(key, value) / get(store, key): GENUINELY per-namespace, matching
# the real interpreter's own actual design (rust-runtime/src/ir/hosts.rs's
# host_get/host_set_var/ensure_obj/obj_get/obj_set all read and write ONE
# shared per-name field store -- "__vars" is just the one conventional
# namespace name every existing call site here happens to use, not a
# special case the real host treats differently from any other object
# handle). The PREVIOUS version of this function ignored `store` entirely
# and always read/wrote a single flat table -- harmless as long as every
# caller passed literal "__vars" (true of every pre-existing call site:
# lower.patlang's closure/budgeted/activate sequence counters,
# codegen_x64.patlang's string/CallValue label counters), but WRONG the
# moment real class support (GitHub classes-for-x64-caching plan) needed
# `get(self, "field")`/`obj.field = value` to read/write a DIFFERENT
# object's own namespace -- every object would have silently aliased the
# same global "__vars" table instead of its own fields. Fixed by making
# the underlying table a list of [namespace_name, keys, vals] triples,
# looked up by `store`/`key` together -- `rt_ns_get`/`rt_ns_set` below do
# the real work; `get`/`set_var` are now thin, backward-compatible
# wrappers (every existing 2-arg `set_var(key,value)` call site is
# unaffected, since it's just sugar for `rt_ns_set("__vars",key,value)`).
make a function called rt_ns_find takes table, store returns idx
  let n = rt_list_len(table)
  let i = 0
  while i < n do
    if rt_str_eq(rt_list_get(rt_list_get(table, i), 0), store) then
      return i
    end
    let i = i + 1
  end
  return 0 - 1
end

make a function called rt_ns_set takes store, key, value returns done
  let table_addr = mem_vars_table_addr()
  let table = mem_peek_qword(table_addr, 0)
  if table == 0 then
    let table = rt_list_new(0)
    mem_poke_qword(table_addr, 0, table)
  end
  let ns_idx = rt_ns_find(table, store)
  if ns_idx < 0 then
    let keys = rt_list_new(0)
    let vals = rt_list_new(0)
    let ns = rt_list_new(3)
    rt_list_set(ns, 0, store)
    rt_list_set(ns, 1, keys)
    rt_list_set(ns, 2, vals)
    let table = rt_list_push(table, ns)
    mem_poke_qword(table_addr, 0, table)
    let ns_idx = rt_list_len(table) - 1
  end
  let ns = rt_list_get(table, ns_idx)
  let keys = rt_list_get(ns, 1)
  let vals = rt_list_get(ns, 2)
  let n = rt_list_len(keys)
  let i = 0
  while i < n do
    if rt_str_eq(rt_list_get(keys, i), key) then
      rt_list_set(vals, i, value)
      return true
    end
    let i = i + 1
  end
  let new_keys = rt_list_push(keys, key)
  let new_vals = rt_list_push(vals, value)
  rt_list_set(ns, 1, new_keys)
  rt_list_set(ns, 2, new_vals)
  return true
end

# Returns 0 on an unset key -- matches this function's own pre-existing
# convention (documented below on `get`), not Rust's Unit/nil.
make a function called rt_ns_get takes store, key returns value
  let table = mem_peek_qword(mem_vars_table_addr(), 0)
  if table == 0 then
    return 0
  end
  let ns_idx = rt_ns_find(table, store)
  if ns_idx < 0 then
    return 0
  end
  let ns = rt_list_get(table, ns_idx)
  let keys = rt_list_get(ns, 1)
  let vals = rt_list_get(ns, 2)
  let n = rt_list_len(keys)
  let i = 0
  while i < n do
    if rt_str_eq(rt_list_get(keys, i), key) then
      return rt_list_get(vals, i)
    end
    let i = i + 1
  end
  return 0
end

# The bundled compiler source's OWN pre-existing usage (checked every call
# site) always passes "__vars" as `store`/never uses a second namespace --
# kept as a thin wrapper so those call sites are untouched. get on an
# unset key returns 0 (matches how every actual key is initialized via
# set_var before its first get, e.g. lower.patlang:629
# `set_var("__closure_seq", 0)`), not Rust's Unit/nil.
make a function called set_var takes key, value returns done
  return rt_ns_set("__vars", key, value)
end

make a function called get takes store, key returns value
  return rt_ns_get(store, key)
end

# ---- real classes for x64 (non-inheriting subset) ----
#
# Mirrors rust-runtime/src/ir/hosts.rs's real class_def/new/send
# semantics (host_class_def/host_new/host_send/resolve_class_method),
# narrowed to a named, explicit scope limit: single classes with plain
# fields + methods only -- NO `inherits`/traits support (the real host's
# own parent-chain walk in resolve_class_method/
# resolve_class_field_defaults is real extra work this narrower x64 cut
# doesn't need yet; add it later if something else genuinely needs
# inheritance on this backend, same "named scope limit, not an
# oversight" convention as every other deliberately-narrower cut in this
# file). A class registered with a non-empty parent/traits list here
# still works -- those args are simply ignored, matching how an
# unregistered class already behaves in the real host (zero defaults,
# no methods) rather than raising an error.
#
# g_classes_table: assoc list, class name -> [field_defaults, methods]
# (both themselves assoc lists: field_defaults is [[name,default],...],
# methods is [[name,closure],...] -- exactly the shape class_def's own
# 5 real args already arrive in, see lowering.rs's ClassDecl handling).
make a function called class_def_register takes name, parent, field_defaults, methods, traits returns done
  let table = mem_peek_qword(mem_classes_table_addr(), 0)
  if table == 0 then
    let table = rt_list_new(0)
  end
  let n = rt_list_len(table)
  let i = 0
  while i < n do
    if rt_str_eq(rt_list_get(rt_list_get(table, i), 0), name) then
      let entry = rt_list_get(table, i)
      rt_list_set(entry, 1, field_defaults)
      rt_list_set(entry, 2, methods)
      mem_poke_qword(mem_classes_table_addr(), 0, table)
      return true
    end
    let i = i + 1
  end
  let entry = rt_list_new(3)
  rt_list_set(entry, 0, name)
  rt_list_set(entry, 1, field_defaults)
  rt_list_set(entry, 2, methods)
  let table = rt_list_push(table, entry)
  mem_poke_qword(mem_classes_table_addr(), 0, table)
  return true
end

# Returns the registered [field_defaults, methods] entry, or an empty
# list if `name` was never registered (matches the real host's own
# "unregistered class -> zero defaults, no methods" fallback, not an
# error).
make a function called class_def_lookup takes name returns entry
  let table = mem_peek_qword(mem_classes_table_addr(), 0)
  if table == 0 then
    return []
  end
  let n = rt_list_len(table)
  let i = 0
  while i < n do
    if rt_str_eq(rt_list_get(rt_list_get(table, i), 0), name) then
      return rt_list_get(table, i)
    end
    let i = i + 1
  end
  return []
end

# Resolves `method` on `class` (single-class only, per this file's own
# documented scope limit above -- no parent-chain walk). Returns the
# closure value, or 0 if unregistered/not found.
make a function called class_method_lookup takes class, method returns closure_or_zero
  let entry = class_def_lookup(class)
  if rt_list_len(entry) == 0 then
    return 0
  end
  let methods = rt_list_get(entry, 2)
  let n = rt_list_len(methods)
  let i = 0
  while i < n do
    let pair = rt_list_get(methods, i)
    if rt_str_eq(rt_list_get(pair, 0), method) then
      return rt_list_get(pair, 1)
    end
    let i = i + 1
  end
  return 0
end

# new(class, name): populates `name`'s own namespace (the SAME per-name
# store get/set_var/send("set",...) already share, see rt_ns_get/
# rt_ns_set's own header above -- there is no separate "object table" in
# the real design this mirrors) with `class`'s field defaults, plus a
# "type" entry so send() can later resolve which class's methods to
# dispatch to. Real host's own optional trailing "inherits"/"traits"
# keyword-pairs are out of scope here (2-arg new only, see this file's
# class-support header above) -- `new` isn't a reserved word, so
# (unlike "class_def" and "send", both hardcoded at the lowering/
# CallHost level) an ordinary same-named PatLang function definition
# shadows it directly, same convention as get/set_var above.
make a function called new takes class, name returns tagged_name
  let entry = class_def_lookup(class)
  if rt_list_len(entry) > 0 then
    let field_defaults = rt_list_get(entry, 1)
    let n = rt_list_len(field_defaults)
    let i = 0
    while i < n do
      let pair = rt_list_get(field_defaults, i)
      rt_ns_set(name, rt_list_get(pair, 0), rt_list_get(pair, 1))
      let i = i + 1
    end
  end
  rt_ns_set(name, "type", class)
  return name
end

# send(recv, method, arg1, ...) is variadic (CallHost, real codegen-level
# handling in x64_callhost_asm below -- PatLang has no variadic function
# syntax, same reason exec_capture/spawn need their own CallHost cases
# too). This helper does everything EXCEPT the actual closure invocation
# (a real `call` to whatever function the resolved closure wraps, which
# needs x64_callvalue_asm's own generated-code mechanism, not something
# an ordinary PatLang function body can do) -- mirrors host_send's own
# "set" special-case (rust-runtime/src/ir/hosts.rs) plus interpreter.rs's
# own class-method resolution, minus the actual call. Returns the
# resolved method closure to invoke, or 0 if there's nothing left to
# invoke (either the "set" case, already handled here directly, or a
# genuinely unresolvable method -- this narrower x64 cut doesn't
# distinguish the two, since every method this backend's OWN classes
# ever call is expected to resolve; a real "unknown method" error path
# is out of scope, matching this file's other named scope limits).
make a function called rt_send_prepare takes recv, method, rest_args returns closure_or_zero
  if rt_str_eq(method, "set") then
    rt_ns_set(recv, rt_list_get(rest_args, 0), rt_list_get(rest_args, 1))
    return 0
  end
  let class = rt_ns_get(recv, "type")
  return class_method_lookup(class, method)
end

# read_file/write_file/file_exists: thin shadows over the rt_* wrappers
# already built (this session, earlier checkpoint) on the supported
# os_file_size/os_read_file_into/os_write_file primitives -- their
# conventions already match the Rust host functions exactly (tagged
# String for read_file, "1"/"0" legacy string-bool for file_exists),
# so no new logic needed, just the name under which patc1_main.patlang
# (and any other --x64-compiled program) actually calls them. Load-
# bearing for a self-compiled patc2.exe to function as a CLI tool at
# all -- these were deliberately deferred through the fixpoint COMPILE
# itself (never executed on that path) but are exactly what
# patc1_main.patlang's own driver logic needs to do anything once
# patc2.exe is actually RUN.
make a function called read_file takes path returns s
  return rt_read_file(path)
end

make a function called write_file takes path, contents returns ok
  return rt_write_file(path, contents)
end

make a function called rt_is_space takes c returns yes
  if c == 32 then
    return true
  end
  if c == 9 then
    return true
  end
  return false
end

# argv() -> List of program arguments with argv[0] (the exe's own
# path) dropped, matching Rust's host_argv contract for the compiled
# (not interpreted) case -- no mode-flag/script-path stripping needed
# here, that's only relevant to `pat --ir-run`'s own wrapper, not a
# standalone --x64-compiled .exe. The ONE genuinely new native
# primitive this needed is os_get_command_line (codegen_x64.patlang,
# wraps GetCommandLineA) -- everything else here, quote-aware
# tokenization, is ordinary PatLang. Basic double-quote support only
# (a quoted segment's internal spaces don't split it, quotes
# themselves stripped) -- same "sufficient for ordinary paths/flags,
# doesn't handle an embedded escaped quote" scope limit
# rt_dquote_str's own header already names for the exec_capture side
# of this identical problem.
make a function called argv returns args
  let cmdline = os_get_command_line() bor rt_string_tag()
  let len = rt_str_len(cmdline)
  let tokens = []
  let i = 0
  while i < len do
    while (i < len) and (rt_is_space(char_code(cmdline, i))) do
      let i = i + 1
    end
    if i < len then
      if char_code(cmdline, i) == 34 then
        let i = i + 1
        let start = i
        while (i < len) and (char_code(cmdline, i) != 34) do
          let i = i + 1
        end
        let tok = substr(cmdline, start, i - start)
        let tokens = list_push(tokens, tok)
        if i < len then
          let i = i + 1
        end
      else
        let start = i
        while (i < len) and (not rt_is_space(char_code(cmdline, i))) do
          let i = i + 1
        end
        let tok = substr(cmdline, start, i - start)
        let tokens = list_push(tokens, tok)
      end
    end
  end
  let out = []
  let n = list_len(tokens)
  let j = 1
  while j < n do
    let out = list_push(out, tokens[j])
    let j = j + 1
  end
  return out
end

make a function called file_exists takes path returns s
  return rt_file_exists(path)
end

# floor(v): fixnum/BigInt pass through unchanged (already integers,
# matching Rust's own `Value::Int(_) | Value::BigInt(_) => v.clone()`);
# Rational computes real floor division on [numerator][denominator]
# (matches Rust's exact BigInt-based floor, not a lossy float
# round-trip): q = n/d truncated toward zero (this backend's `/` is
# native idiv, truncating), then if there's a nonzero remainder AND n
# is negative, subtract 1 (truncation rounds toward zero, i.e. UP for
# negative operands, so it overshoots floor by exactly one in that
# case). Named scope limit: Complex/Interval/Float have no floor
# implemented here (this backend's only actual caller,
# x64_codegen_demo_baseline.patlang, only ever floors a fixnum-or-
# Rational division result) -- falls through to "unchanged" for
# anything else rather than erroring, a safe default.
make a function called floor takes v returns result
  let family_mask = 17293822569102704640
  let family = v band family_mask
  let rational_family = 1153765929536978944
  if family == rational_family then
    let addr = v band rt_payload_mask()
    let n = mem_peek_qword(addr, 0)
    let d = mem_peek_qword(addr, 8)
    let q = rt_trunc_div(n, d)
    let r = n - q * d
    if r != 0 then
      if n < 0 then
        return q - 1
      end
    end
    return q
  end
  return v
end

# ---- lists (Slice 4, TAGGED as of the closures/strings/lists tagging
# migration) ----
#
# Same [8-byte length][elements] block layout as strings, except each
# element is a plain TAGGED qword rather than a byte -- every PatLang
# value in this backend is already a qword, so "a list of anything"
# (fixnums, BigInt/Rational/Complex/Interval, strings, other lists,
# closures, objects) is trivially a list of tagged qwords, no
# per-type handling needed anywhere. Now carries family 0x3's tag on
# the list's own address, same masking/tagging discipline as strings.
# codegen_x64.patlang's BuildList handling (PatLang's own `[e0, e1,
# ...]` literal syntax) calls rt_heap_alloc directly and constructs
# this same layout inline rather than calling rt_list_new -- both
# produce identical (now tagged) blocks.
#
# `list_get`/`list_len` are aliased directly to rt_list_get/rt_list_len
# by codegen_x64.patlang (so `l[i]` and `list_len(l)` work with
# PatLang's own native syntax); rt_list_new/rt_list_set are NOT
# aliased from list_push/list_set -- this file's rt_list_set mutates
# IN PLACE, unlike the interpreter's own copy-on-write list_set, so it
# keeps its own distinct name rather than silently changing meaning.
#
# Fixed-size only -- no growable/push support yet (a real growable list
# needs a reallocate-and-copy strategy, a deliberately separate, named,
# not-yet-built follow-up, same spirit as strings' `+`-stays-int-only
# limit).

make a function called rt_list_tag returns tag
  return 3 shl 60
end

# List block format, TWO qwords of header, not one: [length:8]
# [capacity:8][elements: capacity*8 bytes]. Elements start at offset
# 16, not 8 -- a real, deliberate format change from the original
# Slice 4 layout (see rt_list_push's own header for why capacity
# tracking is necessary, not cosmetic). rt_list_new/BuildList (in
# codegen_x64.patlang) both allocate TIGHT (capacity == length, no
# spare room) -- only rt_list_push ever creates a list with genuine
# spare capacity.
make a function called rt_list_new takes n returns tagged
  let addr = rt_heap_alloc(16 + n * 8)
  mem_poke_qword(addr, 0, n)
  mem_poke_qword(addr, 8, n)
  return addr bor rt_list_tag()
end

make a function called rt_list_len takes l returns len
  let addr = l band rt_payload_mask()
  return mem_peek_qword(addr, 0)
end

# Real bug found (GitHub incremental-compile-caching plan, self-hosting
# fixpoint investigation): `s[i]` index syntax ALWAYS lowers to
# CallHost("list_get", 2) regardless of whether the receiver is a
# String or a List (see x64_callhost_asm's own header on this, lower.
# patlang's own doing) -- this function used to unconditionally apply
# the LIST layout (8-byte-per-element, data starting at offset 16),
# which is simply the wrong byte offsets for a String (1-byte-per-char,
# data starting at offset 8). Confirmed directly: `let s = "abc";
# print(s[1])` printed 256 instead of "b" under --x64 (matches the
# interpreter exactly for --ir-run/--patc, only --x64 was wrong) --
# never caught before because nothing in the self-hosted compiler's own
# internals happened to index into a STRING via `[i]` syntax under
# --x64 until lib/json.patlang's json_escape (newly exercised by this
# feature's own content-hashing, not something json.patlang did
# differently -- it was always broken, just never reached). Fixed by
# checking the family tag first: a String receiver returns a genuine
# new one-character tagged String (matching the interpreter's own
# `s[i]` semantics exactly), a List receiver keeps the original
# qword-element behavior.
make a function called rt_list_get takes l, i returns value
  let family_mask = 17293822569102704640
  let family = l band family_mask
  if family == rt_string_tag() then
    let addr = l band rt_payload_mask()
    let ch = mem_peek_byte(addr, 8 + i)
    let out = rt_heap_alloc(9)
    mem_poke_qword(out, 0, 1)
    mem_poke_byte(out, 8, ch)
    return out bor rt_string_tag()
  end
  let addr = l band rt_payload_mask()
  return mem_peek_qword(addr, 16 + i * 8)
end

make a function called rt_list_set takes l, i, v returns done
  let addr = l band rt_payload_mask()
  mem_poke_qword(addr, 16 + i * 8, v)
  return true
end

# Growable lists: list_push(list, item) -> a list with item appended.
#
# REAL PERFORMANCE BUG found and fixed here (not by review -- by an
# actual self-compile attempt burning 20+ CPU-minutes on ~10K lines
# of the compiler's own source before being killed): the original
# version always reallocated a tightly-sized block and copied EVERY
# existing element on EVERY push, an O(n) cost per call -- meaning a
# loop that accumulates N items one push at a time (exactly how
# lexer.patlang builds its token list, one token per push) costs
# O(n^2) total. The interpreter's own list_push is O(1) amortized
# (`Arc::make_mut(&mut xs).push(...)` -- Rust's Vec grows by
# doubling, and Arc::make_mut only copies when the list is actually
# SHARED, mutating in place otherwise). Fixed by tracking real spare
# CAPACITY in the block header (see the format comment above) and
# growing geometrically (doubling) only when capacity is exhausted,
# mutating in place (bumping length, writing into already-reserved
# space) whenever there's room.
#
# NAMED, DELIBERATE SEMANTIC DEVIATION from the interpreter's own
# safety guarantee: Arc::make_mut only mutates in place when the
# reference count is 1 (i.e. provably unshared), copying otherwise --
# this backend has NO reference counting at all, so it cannot tell
# whether an older list value still aliases the same block. The
# in-place growth path here is therefore only PROBABLY safe, not
# PROVABLY safe: it's correct for the dominant, realistic pattern
# (`let xs = list_push(xs, item)` accumulated in a loop, where the
# old binding is never read again), but a program that keeps an OLDER
# list reference around, then pushes onto a chain descended from it
# MULTIPLE times while that older reference still has spare capacity,
# could observe the older reference's contents change underneath it.
# This tradeoff is deliberate -- realistic performance for the
# overwhelmingly common accumulation pattern (needed for self-hosting
# at all) over perfect aliasing safety for a rarer divergent-branches
# pattern. x64_growable_list_demo.patlang's own "the original list
# stays length 0" check still passes (it never re-reads a list that
# was later pushed onto), but is not a general proof of safety.
make a function called rt_list_push takes l, v returns tagged
  let addr = l band rt_payload_mask()
  let n = mem_peek_qword(addr, 0)
  let cap = mem_peek_qword(addr, 8)
  if n < cap then
    mem_poke_qword(addr, 16 + n * 8, v)
    mem_poke_qword(addr, 0, n + 1)
    return l
  end
  let new_cap = cap * 2
  if new_cap < 1 then
    let new_cap = 1
  end
  if new_cap < n + 1 then
    let new_cap = n + 1
  end
  let new_addr = rt_heap_alloc(16 + new_cap * 8)
  mem_poke_qword(new_addr, 0, n + 1)
  mem_poke_qword(new_addr, 8, new_cap)
  let i = 0
  while i < n do
    mem_poke_qword(new_addr, 16 + i * 8, mem_peek_qword(addr, 16 + i * 8))
    let i = i + 1
  end
  mem_poke_qword(new_addr, 16 + n * 8, v)
  return new_addr bor rt_list_tag()
end

# GitHub #29: the plain `list_set` host function (rust-runtime/src/ir/
# hosts.rs's host_list_set) is COPY-ON-WRITE/functional -- returns a NEW
# list with one element replaced, leaves the original untouched -- unlike
# this file's own `rt_list_set` just above (in-place mutation, used
# throughout this file's own internal tables like g_rules_table). Needed
# for real the first time by codegen_x64.patlang's own x64_analyze_
# dynamic_bins (a per-instruction dynamic-mode classification pass,
# GitHub #29): its virtual-stack simulation needs a real functional
# list_set to reuse storage across push/pop cycles at the same stack
# depth. Before this, plain `list_set` had NO native x64 support at
# all (deliberately, see x64_callhost_asm's own big comment on why
# list_set/list_push were never aliased to the MUTATING rt_list_set) --
# compiling ANY function that called plain list_set via --x64 failed
# with "unsupported primitive," discovered attempting to self-compile
# the bundle containing codegen_x64.patlang's own new analysis code.
make a function called rt_list_set_functional takes l, i, v returns tagged
  let addr = l band rt_payload_mask()
  let n = mem_peek_qword(addr, 0)
  let cap = mem_peek_qword(addr, 8)
  let new_addr = rt_heap_alloc(16 + cap * 8)
  mem_poke_qword(new_addr, 0, n)
  mem_poke_qword(new_addr, 8, cap)
  let k = 0
  while k < n do
    mem_poke_qword(new_addr, 16 + k * 8, mem_peek_qword(addr, 16 + k * 8))
    let k = k + 1
  end
  mem_poke_qword(new_addr, 16 + i * 8, v)
  return new_addr bor rt_list_tag()
end

# ---- bool_array (Slice 1, GitHub #45) ----
#
# A plain List of Bool values costs one full 8-byte tagged word PER
# BOOL -- wasteful for a large bool array. This is a genuinely
# separate container, not another List variant: a real bit-packed
# backing store (64 bools per qword), growable via the same doubling
# strategy rt_list_push already uses, deliberately NOT capped at a
# single word's worth of bits (per the issue's own explicit ask). Kept
# as its own small, explicit API (bool_array_new/get/set/len/push)
# rather than folded into the generic list_* family-dispatch machinery
# -- overloading that pervasive dispatch is exactly the kind of change
# that cost #38 a multi-hour ripple chase; this stays a self-contained
# addition instead.
#
# Block format: [length:8][capacity_words:8][words: capacity_words*8
# bytes] -- same two-qword-header shape as rt_list's own [length]
# [capacity][elements], just reinterpreting "elements" as 64 packed
# bits per word instead of one qword per element. Bit i of the array
# lives at word (i shr 6), bit position (i band 63) of that word.
# Fresh heap memory is zero-filled (rt_heap_alloc's own .bss backing),
# so any not-yet-written bits within an allocated word are already
# false -- no explicit zeroing needed on growth.
#
# Family tag 7 (7 shl 60): the first genuinely new family since Bool's
# 6 (#24) -- confirmed unused via the same repo-wide-grep check #24's
# own comment already flagged doing before picking 6.
make a function called rt_bool_array_tag returns tag
  return 7 shl 60
end

make a function called bool_array_new takes n returns tagged
  let cap_words = n shr 6
  if (n band 63) != 0 then
    let cap_words = cap_words + 1
  end
  let addr = rt_heap_alloc(16 + cap_words * 8)
  mem_poke_qword(addr, 0, n)
  mem_poke_qword(addr, 8, cap_words)
  return addr bor rt_bool_array_tag()
end

make a function called bool_array_len takes arr returns len
  let addr = arr band rt_payload_mask()
  return mem_peek_qword(addr, 0)
end

make a function called bool_array_get takes arr, i returns value
  let addr = arr band rt_payload_mask()
  let word_idx = i shr 6
  let bit_idx = i band 63
  let word = mem_peek_qword(addr, 16 + word_idx * 8)
  let bit = (word shr bit_idx) band 1
  return 6917529027641081856 bor bit
end

make a function called bool_array_set takes arr, i, v returns done
  let addr = arr band rt_payload_mask()
  let word_idx = i shr 6
  let bit_idx = i band 63
  let word = mem_peek_qword(addr, 16 + word_idx * 8)
  let mask = 1 shl bit_idx
  if v then
    let word = word bor mask
  else
    let word = word band (bnot mask)
  end
  mem_poke_qword(addr, 16 + word_idx * 8, word)
  return true
end

# Growable, same doubling-by-words strategy as rt_list_push: mutates
# in place (bumping length, writing into already-reserved spare
# capacity) whenever the pushed bit's own word already exists;
# reallocates+copies (doubling capacity_words, or growing to exactly
# fit if doubling still wouldn't cover the new bit) only when it
# doesn't. Same named, deliberate aliasing tradeoff as rt_list_push
# (no reference counting in this backend, so in-place growth is only
# PROBABLY safe against an older alias, not provably so) -- see that
# function's own header comment for the full reasoning, unchanged
# here.
make a function called bool_array_push takes arr, v returns tagged
  let addr = arr band rt_payload_mask()
  let n = mem_peek_qword(addr, 0)
  let cap_words = mem_peek_qword(addr, 8)
  let needed_word = n shr 6
  if needed_word < cap_words then
    mem_poke_qword(addr, 0, n + 1)
    bool_array_set(arr, n, v)
    return arr
  end
  let new_cap_words = cap_words * 2
  if new_cap_words < 1 then
    let new_cap_words = 1
  end
  if new_cap_words <= needed_word then
    let new_cap_words = needed_word + 1
  end
  let new_addr = rt_heap_alloc(16 + new_cap_words * 8)
  mem_poke_qword(new_addr, 0, n + 1)
  mem_poke_qword(new_addr, 8, new_cap_words)
  let i = 0
  while i < cap_words do
    mem_poke_qword(new_addr, 16 + i * 8, mem_peek_qword(addr, 16 + i * 8))
    let i = i + 1
  end
  let new_tagged = new_addr bor rt_bool_array_tag()
  bool_array_set(new_tagged, n, v)
  return new_tagged
end

# ---- numeric tower: BigInt (tagged values, DYNAMIC-MODE functions only) ----
#
# Scope, named explicitly (see the plan at wondering-about-extending-
# patlang-modular-shore.md and memory patlang-x64-tower-design-
# philosophy for the full three-round design negotiation this came
# from): every value in a function codegen_x64.patlang classifies as
# "dynamic" (currently: any function whose own body calls
# rt_bigint_from_i64, directly -- a whole-function decision, exactly
# mirroring Slice 7's float_mode scope limit, NOT yet per-value
# specialization or cross-function propagation) is a TAGGED 64-bit
# word: top 16 bits (48-63) = tag, low 48 bits = payload.
#   tag all-zero  -> fixnum: payload is a signed 48-bit int (~+-140
#                    trillion), recovered via `(w shl 16) shr 16`
#                    (sign-extends from bit 47; `shr` in this backend
#                    lowers to `sar`, an arithmetic shift).
#   family 0x1
#   (numeric),
#   local bit0    -> BigInt: payload (masked) is a heap address.
# Functions NOT classified dynamic (everything that doesn't touch
# BigInt, including every existing demo/benchmark) get TODAY'S EXACT
# untagged codegen, unchanged -- this is the property that keeps the
# whole-int/whole-float speed advantage (see memory patlang-x64-
# benchmarking) intact; verified, not just assumed, in this slice's
# own testing.
#
# `+` on two dynamic-mode values therefore genuinely stays `+` in
# source PatLang (see codegen_x64.patlang's x64_binop_asm_dynamic) --
# no named-function workaround. Fixnum+fixnum that overflows 48 bits
# promotes to BigInt automatically at the `+` site itself, mirroring
# the interpreter's own checked_add-then-promote behavior.
#
# DELIBERATE SCOPE LIMITS, named honestly (this is a first working
# cut of a very large design, not full parity):
#   - Only `+` gets dynamic dispatch this pass; `-`/`*`/`/`/comparisons
#     on genuinely dynamic (possibly-BigInt) values are NOT yet wired
#     -- rt_bigint_add exists and is reachable, subtract/multiply/
#     compare on the tower are real follow-up work.
#   - Rational, Complex, Object: tag space reserved (families 0x2 List,
#     0x3 String were already spoken for by existing types; Numeric's
#     own family-local bits 1/2 for Rational/Float are reserved),
#     nothing implemented.
#   - String/List/Closure values are NOT tagged -- they keep today's
#     exact raw-address representation, untouched by this pass. A
#     BigInt value has never been stored into a List or passed through
#     a Closure capture in this cut; doing so is unverified.
#   - A NEGATIVE integer literal used DIRECTLY as an operand to `+`
#     inside a dynamic-mode function is unverified/unsafe in this cut
#     (Const codegen is intentionally unchanged in dynamic mode, so a
#     literal like `-5` keeps its natural two's-complement top bits
#     set, which the fixnum check would misread as a non-zero tag).
#     Every value used this way in the demo is non-negative. Real fix
#     is per-value analysis of "will this Const flow into a dynamic
#     Bin or a plain function argument", deferred with everything else
#     under "not yet per-value specialization" above.
#   - BigInt division, and magnitudes large enough for a single
#     schoolbook column's carry itself to overflow 64 bits: still out
#     of scope, unchanged from the original floats-only Slice 7 notes.

make a function called rt_tag_mask returns mask
  return (1 shl 16 - 1) shl 48
end

make a function called rt_payload_mask returns mask
  return 1 shl 48 - 1
end

make a function called rt_bigint_tag returns tag
  return (1 shl 60) bor (1 shl 48)
end

# Recovers the true signed value of a fixnum-tagged word -- NEEDED
# before handing a dynamic-mode arithmetic RESULT to a plain-int
# function like rt_print_i64: a tagged fixnum's raw 64-bit bit pattern
# is NOT numerically equal to the true value for negative numbers (the
# top 16 tag bits are forced to zero, not sign-extended, so e.g. -95
# stored this way reads as a huge POSITIVE 64-bit number if used
# unpacked). Comparison results (always a plain 0/1) don't need this --
# only genuine arithmetic results do.
make a function called rt_fixnum_unpack takes tagged returns n
  return (tagged shl 16) shr 16
end

make a function called rt_int_to_str takes n returns s
  let buf = mem_scratch_addr()
  let len = rt_int_to_string(n, buf)
  let s = rt_heap_alloc(8 + len)
  mem_poke_qword(s, 0, len)
  let i = 0
  while i < len do
    mem_poke_byte(s, 8 + i, mem_peek_byte(buf, i))
    let i = i + 1
  end
  return s bor rt_string_tag()
end

# Zero-padded to exactly 9 digits -- for every limb EXCEPT the most
# significant one when printing a BigInt (base 10^9 per limb).
make a function called rt_limb9_to_str takes n returns s
  let s = rt_heap_alloc(8 + 9)
  mem_poke_qword(s, 0, 9)
  let v = n
  let i = 8
  while i >= 0 do
    let d = v % 10
    mem_poke_byte(s, 8 + i, d + 48)
    let v = rt_trunc_div(v, 10)
    let i = i - 1
  end
  return s bor rt_string_tag()
end

# Real bug found here: an earlier draft used list_push/list_len to
# collect limbs before allocating the block. list_push is NOT one of
# this backend's supported CallHost primitives (see x64_binop_asm's
# neighbor x64_callhost_asm's own header: list_get/list_len are
# aliased, list_push/list_set deliberately are not). Because
# x64_runtime.patlang is unconditionally prepended to EVERY compiled
# program, that one bad call silently poisoned every program's own
# generated .asm with an "UNSUPPORTED_PRIMITIVE_ERROR" placeholder
# function -- caught immediately (a printed compile-time error) the
# first time ANY demo was rebuilt after this file changed, even
# demos that never call rt_bigint_from_i64 at all. Fixed by counting
# limbs with a plain integer loop first, then allocating once and
# writing digits directly into the heap block -- no dynamic PatLang
# list anywhere in this function.
make a function called rt_bigint_from_i64 takes n returns tagged
  let sign = 0
  let v = n
  if v < 0 then
    let sign = 1
    let v = 0 - v
  end
  let n_limbs = 1
  if v > 0 then
    let n_limbs = 0
    let t = v
    while t > 0 do
      let n_limbs = n_limbs + 1
      let t = rt_trunc_div(t, 1000000000)
    end
  end
  let addr = rt_heap_alloc(16 + n_limbs * 8)
  mem_poke_qword(addr, 0, sign)
  mem_poke_qword(addr, 8, n_limbs)
  if v == 0 then
    mem_poke_qword(addr, 16, 0)
  else
    let i = 0
    let t = v
    while t > 0 do
      mem_poke_qword(addr, 16 + i * 8, t % 1000000000)
      let t = rt_trunc_div(t, 1000000000)
      let i = i + 1
    end
  end
  return addr bor rt_bigint_tag()
end

# GitHub #40: rt_bigint_from_i64 only ever received a single i64
# register value, sign-extended -- correct for arithmetic-overflow
# promotion (the value genuinely started as a real i64/f64 computation)
# but WRONG for an oversized integer LITERAL whose bit pattern exceeds
# i64's signed range: a literal like 18446744073709551615 (u64::MAX)
# encodes, as a bare 64-bit register value, to the same bit pattern as
# -1 -- passing that through rt_bigint_from_i64 silently built BigInt
# "-1" instead of the real magnitude. Worse, a literal genuinely LARGER
# than 2^64-1 can't even be expressed as a single register value at
# all, so no i64-based constructor could ever cover it. Fixed by
# parsing the literal's own DECIMAL TEXT directly into base-10^9 limbs
# (exploiting that 9 decimal digits always fit in one limb) --
# handles both the u64-range sign bug and arbitrary-length literals in
# one general mechanism, with no register-width ceiling at all.
make a function called rt_bigint_from_decimal_str takes s returns tagged
  let len = rt_str_len(s)
  let sign = 0
  let start = 0
  if len > 0 then
    if char_code(s, 0) == 45 then
      let sign = 1
      let start = 1
    end
  end
  let i = start
  while (i < len - 1) and (char_code(s, i) == 48) do
    let i = i + 1
  end
  let start = i
  let digit_len = len - start
  let n_limbs = rt_trunc_div(digit_len + 8, 9)
  if n_limbs < 1 then
    let n_limbs = 1
  end
  let first_chunk_len = digit_len - (n_limbs - 1) * 9
  let addr = rt_heap_alloc(16 + n_limbs * 8)
  mem_poke_qword(addr, 8, n_limbs)
  let pos = start
  let val = 0
  let k = 0
  while k < first_chunk_len do
    let val = val * 10 + (char_code(s, pos) - 48)
    let pos = pos + 1
    let k = k + 1
  end
  mem_poke_qword(addr, 16 + (n_limbs - 1) * 8, val)
  let limb_idx = n_limbs - 2
  while limb_idx >= 0 do
    let val = 0
    let k = 0
    while k < 9 do
      let val = val * 10 + (char_code(s, pos) - 48)
      let pos = pos + 1
      let k = k + 1
    end
    mem_poke_qword(addr, 16 + limb_idx * 8, val)
    let limb_idx = limb_idx - 1
  end
  # A literal that's all zero digits (e.g. "-0", never written by a
  # real user but cheap to guard) must not carry a stray sign bit --
  # matches rt_bigint_from_i64(0)'s own always-sign-0 convention.
  if n_limbs == 1 then
    if mem_peek_qword(addr, 16) == 0 then
      let sign = 0
    end
  end
  mem_poke_qword(addr, 0, sign)
  return addr bor rt_bigint_tag()
end

make a function called rt_bigint_to_string takes tagged returns s
  let addr = tagged band rt_payload_mask()
  let sign = mem_peek_qword(addr, 0)
  let count = mem_peek_qword(addr, 8)
  let result = ""
  if sign == 1 then
    let result = "-"
  end
  let top = mem_peek_qword(addr, 16 + (count - 1) * 8)
  let result = rt_str_concat(result, rt_int_to_str(top))
  let i = count - 2
  while i >= 0 do
    let limb = mem_peek_qword(addr, 16 + i * 8)
    let result = rt_str_concat(result, rt_limb9_to_str(limb))
    let i = i - 1
  end
  return result
end

# |a| vs |b|, ignoring sign: -1, 0, or 1.
make a function called rt_bigint_mag_cmp takes addr_a, addr_b returns cmp
  let na = mem_peek_qword(addr_a, 8)
  let nb = mem_peek_qword(addr_b, 8)
  if na != nb then
    if na > nb then
      return 1
    else
      return 0 - 1
    end
  end
  let i = na - 1
  let result = 0
  let keep_going = true
  while keep_going do
    if i < 0 then
      let keep_going = false
    else
      let la = mem_peek_qword(addr_a, 16 + i * 8)
      let lb = mem_peek_qword(addr_b, 16 + i * 8)
      if la != lb then
        if la > lb then
          let result = 1
        else
          let result = 0 - 1
        end
        let keep_going = false
      else
        let i = i - 1
      end
    end
  end
  return result
end

# |a| + |b| (sign-agnostic), a fresh heap block, sign left as 0 --
# caller (rt_bigint_add) sets the real sign afterward.
make a function called rt_bigint_mag_add takes addr_a, addr_b returns addr
  let na = mem_peek_qword(addr_a, 8)
  let nb = mem_peek_qword(addr_b, 8)
  let n = na
  if nb > n then
    let n = nb
  end
  let addr = rt_heap_alloc(16 + (n + 1) * 8)
  let carry = 0
  let i = 0
  let out_n = 0
  while i < n do
    let la = 0
    if i < na then
      let la = mem_peek_qword(addr_a, 16 + i * 8)
    end
    let lb = 0
    if i < nb then
      let lb = mem_peek_qword(addr_b, 16 + i * 8)
    end
    let s = la + lb + carry
    if s >= 1000000000 then
      let s = s - 1000000000
      let carry = 1
    else
      let carry = 0
    end
    mem_poke_qword(addr, 16 + i * 8, s)
    let out_n = i + 1
    let i = i + 1
  end
  if carry > 0 then
    mem_poke_qword(addr, 16 + out_n * 8, carry)
    let out_n = out_n + 1
  end
  mem_poke_qword(addr, 0, 0)
  mem_poke_qword(addr, 8, out_n)
  return addr
end

# Drop leading (most-significant) zero limbs down to a minimum of 1.
make a function called rt_bigint_trim takes addr returns addr2
  let n = mem_peek_qword(addr, 8)
  let keep_going = true
  while keep_going do
    if n <= 1 then
      let keep_going = false
    else
      let top = mem_peek_qword(addr, 16 + (n - 1) * 8)
      if top == 0 then
        let n = n - 1
      else
        let keep_going = false
      end
    end
  end
  mem_poke_qword(addr, 8, n)
  return addr
end

# |a| - |b| (sign-agnostic), REQUIRES |a| >= |b| (caller's job to pick
# the larger-magnitude operand as addr_a via rt_bigint_mag_cmp first).
make a function called rt_bigint_mag_sub takes addr_a, addr_b returns addr
  let na = mem_peek_qword(addr_a, 8)
  let nb = mem_peek_qword(addr_b, 8)
  let addr = rt_heap_alloc(16 + na * 8)
  let borrow = 0
  let i = 0
  while i < na do
    let la = mem_peek_qword(addr_a, 16 + i * 8)
    let lb = 0
    if i < nb then
      let lb = mem_peek_qword(addr_b, 16 + i * 8)
    end
    let d = la - lb - borrow
    if d < 0 then
      let d = d + 1000000000
      let borrow = 1
    else
      let borrow = 0
    end
    mem_poke_qword(addr, 16 + i * 8, d)
    let i = i + 1
  end
  mem_poke_qword(addr, 0, 0)
  mem_poke_qword(addr, 8, na)
  return rt_bigint_trim(addr)
end

# Real signed BigInt add: same-sign -> magnitude add, keep sign;
# different-sign -> magnitude subtract (larger minus smaller), sign of
# the larger-magnitude operand -- the standard schoolbook rule, not a
# same-sign-only shortcut.
make a function called rt_bigint_add takes tagged_a, tagged_b returns tagged
  let addr_a = tagged_a band rt_payload_mask()
  let addr_b = tagged_b band rt_payload_mask()
  let sign_a = mem_peek_qword(addr_a, 0)
  let sign_b = mem_peek_qword(addr_b, 0)
  let result = 0
  if sign_a == sign_b then
    let result = rt_bigint_mag_add(addr_a, addr_b)
    mem_poke_qword(result, 0, sign_a)
  else
    let c = rt_bigint_mag_cmp(addr_a, addr_b)
    if c == 0 then
      return rt_bigint_from_i64(0)
    else
      if c > 0 then
        let result = rt_bigint_mag_sub(addr_a, addr_b)
        mem_poke_qword(result, 0, sign_a)
      else
        let result = rt_bigint_mag_sub(addr_b, addr_a)
        mem_poke_qword(result, 0, sign_b)
      end
    end
  end
  return result bor rt_bigint_tag()
end

# Negation: flips the sign, EXCEPT for a zero-magnitude value, which
# stays sign 0 either way (no such thing as -0 here, matching
# rt_bigint_from_i64(0)'s own always-sign-0 convention). Builds a NEW
# block rather than mutating in place -- this scheme doesn't yet share
# BigInt blocks between values (nothing aliases one), but copying is
# the safe default regardless.
make a function called rt_bigint_negate takes tagged returns tagged2
  let addr = tagged band rt_payload_mask()
  let sign = mem_peek_qword(addr, 0)
  let count = mem_peek_qword(addr, 8)
  let is_zero = false
  if count == 1 then
    if mem_peek_qword(addr, 16) == 0 then
      let is_zero = true
    end
  end
  if is_zero then
    return tagged
  end
  let new_sign = 1
  if sign == 1 then
    let new_sign = 0
  end
  let addr2 = rt_heap_alloc(16 + count * 8)
  mem_poke_qword(addr2, 0, new_sign)
  mem_poke_qword(addr2, 8, count)
  let i = 0
  while i < count do
    mem_poke_qword(addr2, 16 + i * 8, mem_peek_qword(addr, 16 + i * 8))
    let i = i + 1
  end
  return addr2 bor rt_bigint_tag()
end

make a function called rt_bigint_sub takes tagged_a, tagged_b returns tagged
  return rt_bigint_add(tagged_a, rt_bigint_negate(tagged_b))
end

# |a| * |b| (sign-agnostic), plain schoolbook column multiply, base
# 10^9 limbs. Each column product (up to (10^9-1)^2 ~ 1e18) plus
# running carry stays comfortably within a signed 64-bit accumulator
# for any magnitude this pass is scoped to handle (same "not truly
# arbitrary precision yet" limit named in this file's own header).
make a function called rt_bigint_mag_mul takes addr_a, addr_b returns addr
  let na = mem_peek_qword(addr_a, 8)
  let nb = mem_peek_qword(addr_b, 8)
  let addr = rt_heap_alloc(16 + (na + nb) * 8)
  let z = 0
  while z < na + nb do
    mem_poke_qword(addr, 16 + z * 8, 0)
    let z = z + 1
  end
  let i = 0
  while i < na do
    let la = mem_peek_qword(addr_a, 16 + i * 8)
    let carry = 0
    let j = 0
    while j < nb do
      let lb = mem_peek_qword(addr_b, 16 + j * 8)
      let cur = mem_peek_qword(addr, 16 + (i + j) * 8)
      let prod = la * lb + cur + carry
      let digit = prod % 1000000000
      let carry = rt_trunc_div(prod, 1000000000)
      mem_poke_qword(addr, 16 + (i + j) * 8, digit)
      let j = j + 1
    end
    let k = i + nb
    while carry > 0 do
      let cur = mem_peek_qword(addr, 16 + k * 8)
      let s = cur + carry
      let digit = s % 1000000000
      let carry = rt_trunc_div(s, 1000000000)
      mem_poke_qword(addr, 16 + k * 8, digit)
      let k = k + 1
    end
    let i = i + 1
  end
  mem_poke_qword(addr, 0, 0)
  mem_poke_qword(addr, 8, na + nb)
  return rt_bigint_trim(addr)
end

make a function called rt_bigint_mul takes tagged_a, tagged_b returns tagged
  let addr_a = tagged_a band rt_payload_mask()
  let addr_b = tagged_b band rt_payload_mask()
  let sign_a = mem_peek_qword(addr_a, 0)
  let sign_b = mem_peek_qword(addr_b, 0)
  let mag = rt_bigint_mag_mul(addr_a, addr_b)
  let count = mem_peek_qword(mag, 8)
  let is_zero = false
  if count == 1 then
    if mem_peek_qword(mag, 16) == 0 then
      let is_zero = true
    end
  end
  let result_sign = 0
  if is_zero == false then
    if sign_a != sign_b then
      let result_sign = 1
    end
  end
  mem_poke_qword(mag, 0, result_sign)
  return mag bor rt_bigint_tag()
end

# Full signed compare: -1/0/1. Differing signs resolve immediately;
# same sign falls back to rt_bigint_mag_cmp, negated if both negative
# (since for two negative numbers, the one with the LARGER magnitude
# is actually the SMALLER value).
make a function called rt_bigint_cmp takes tagged_a, tagged_b returns cmp
  let addr_a = tagged_a band rt_payload_mask()
  let addr_b = tagged_b band rt_payload_mask()
  let sign_a = mem_peek_qword(addr_a, 0)
  let sign_b = mem_peek_qword(addr_b, 0)
  if sign_a != sign_b then
    if sign_a == 1 then
      return 0 - 1
    else
      return 1
    end
  end
  let m = rt_bigint_mag_cmp(addr_a, addr_b)
  if sign_a == 1 then
    return 0 - m
  else
    return m
  end
end

# ---- numeric tower: Rational (tower level 2, i64-backed only) ----
#
# Rational's tag: family 0x1 (Numeric), local bits 0b011 (bit0 ">=
# BigInt" AND bit1 ">=Rational" both set -- the thermometer code, see
# rt_bigint_tag's own family/local-bit layout). A Rational is a heap
# block [8-byte numerator][8-byte denominator], denominator always
# kept positive (sign lives in the numerator), reduced via gcd on
# every construction so equal fractions compare equal by raw value.
#
# DELIBERATE SCOPE LIMIT, named honestly: this Rational is i64-backed
# ONLY, NOT BigInt-backed -- it literally cannot hold a numerator or
# denominator too large for a plain 64-bit int, so BigInt-Rational
# interop (dividing a BigInt by anything, or a Rational whose value
# would overflow i64) is out of scope by representation, not just
# unimplemented. x64_binop_asm_dynamic's `/` dispatch only promotes
# FIXNUM operands to Rational; a BigInt-tagged operand reaching that
# promotion step is silently mishandled (treated as if already
# Rational-tagged) -- a real, accepted gap matching the existing
# "BigInt division still out of scope" limit from the first BigInt
# cut, not a new kind of omission.

make a function called rt_rational_tag returns tag
  return (1 shl 60) bor (1 shl 48) bor (1 shl 49)
end

make a function called rt_gcd takes a, b returns g
  let x = a
  if x < 0 then
    let x = 0 - x
  end
  let y = b
  if y < 0 then
    let y = 0 - y
  end
  while y != 0 do
    let t = y
    let y = x % y
    let x = t
  end
  return x
end

make a function called rt_rational_new takes num, den returns tagged
  let n = num
  let d = den
  if d < 0 then
    let n = 0 - n
    let d = 0 - d
  end
  let g = rt_gcd(n, d)
  if g == 0 then
    let g = 1
  end
  let n = rt_trunc_div(n, g)
  let d = rt_trunc_div(d, g)
  let addr = rt_heap_alloc(16)
  mem_poke_qword(addr, 0, n)
  mem_poke_qword(addr, 8, d)
  return addr bor rt_rational_tag()
end

make a function called rt_rational_from_i64 takes n returns tagged
  return rt_rational_new(n, 1)
end

make a function called rt_rational_to_string takes tagged returns s
  let addr = tagged band rt_payload_mask()
  let n = mem_peek_qword(addr, 0)
  let d = mem_peek_qword(addr, 8)
  if d == 1 then
    return rt_int_to_str(n)
  end
  return rt_str_concat(rt_str_concat(rt_int_to_str(n), "/"), rt_int_to_str(d))
end

make a function called rt_rational_add takes a, b returns tagged
  let addr_a = a band rt_payload_mask()
  let addr_b = b band rt_payload_mask()
  let n1 = mem_peek_qword(addr_a, 0)
  let d1 = mem_peek_qword(addr_a, 8)
  let n2 = mem_peek_qword(addr_b, 0)
  let d2 = mem_peek_qword(addr_b, 8)
  return rt_rational_new(n1 * d2 + n2 * d1, d1 * d2)
end

make a function called rt_rational_sub takes a, b returns tagged
  let addr_a = a band rt_payload_mask()
  let addr_b = b band rt_payload_mask()
  let n1 = mem_peek_qword(addr_a, 0)
  let d1 = mem_peek_qword(addr_a, 8)
  let n2 = mem_peek_qword(addr_b, 0)
  let d2 = mem_peek_qword(addr_b, 8)
  return rt_rational_new(n1 * d2 - n2 * d1, d1 * d2)
end

make a function called rt_rational_mul takes a, b returns tagged
  let addr_a = a band rt_payload_mask()
  let addr_b = b band rt_payload_mask()
  let n1 = mem_peek_qword(addr_a, 0)
  let d1 = mem_peek_qword(addr_a, 8)
  let n2 = mem_peek_qword(addr_b, 0)
  let d2 = mem_peek_qword(addr_b, 8)
  return rt_rational_new(n1 * n2, d1 * d2)
end

make a function called rt_rational_div takes a, b returns tagged
  let addr_a = a band rt_payload_mask()
  let addr_b = b band rt_payload_mask()
  let n1 = mem_peek_qword(addr_a, 0)
  let d1 = mem_peek_qword(addr_a, 8)
  let n2 = mem_peek_qword(addr_b, 0)
  let d2 = mem_peek_qword(addr_b, 8)
  return rt_rational_new(n1 * d2, d1 * n2)
end

make a function called rt_rational_cmp takes a, b returns cmp
  let addr_a = a band rt_payload_mask()
  let addr_b = b band rt_payload_mask()
  let n1 = mem_peek_qword(addr_a, 0)
  let d1 = mem_peek_qword(addr_a, 8)
  let n2 = mem_peek_qword(addr_b, 0)
  let d2 = mem_peek_qword(addr_b, 8)
  let lhs = n1 * d2
  let rhs = n2 * d1
  if lhs < rhs then
    return 0 - 1
  end
  if lhs > rhs then
    return 1
  end
  return 0
end

# ---- numeric tower: Complex (tower level 3) ----
#
# Complex's tag: family 0x1 (Numeric), local bits 0b1111 (adds a
# fourth thermometer bit ">=Complex" on top of BigInt/Rational/Float's
# existing three -- see codegen_x64.patlang's own tag-layout header).
#
# UNLIKE BigInt/Rational, a Complex value is not a further extension
# of int MAGNITUDE -- it's a genuinely composite value, a pair of
# numbers (matching the real rustc-backend's own ComplexT, which wraps
# two NumT). So its representation is a heap block of two ALREADY-
# TAGGED numeric words: [8-byte tagged re][8-byte tagged im], where
# each component can independently be a fixnum, BigInt, or Rational
# (never itself Complex -- no nested complex-of-complex support).
#
# This representation choice is what lets rt_complex_add/_sub/_mul be
# ORDINARY PatLang using plain `+`/`-`/`*` on the extracted re/im
# components: since these functions call rt_complex_new, they're
# classified dynamic-mode by codegen_x64.patlang's x64_func_is_dynamic
# (same whole-function rule as everything else in this tower), and
# their own `+`/`-`/`*` on re/im therefore go through the EXISTING
# x64_binop_asm_dynamic machinery, which already correctly handles
# fixnum/BigInt/Rational operands -- no new arithmetic primitives were
# needed for Complex component math at all.
#
# DELIBERATE SCOPE LIMIT: only `+`/`-`/`*`/`==`/`!=` are meaningful
# and supported for top-level Complex operands (via
# x64_binop_asm_dynamic's own Complex classification branch).
# `/`/`<`/`<=`/`>`/`>=` on Complex values are NOT implemented -- for
# ordering specifically, there is no total order on complex numbers to
# begin with, so this is a genuine representation limit, not laziness;
# codegen_x64.patlang's comparison dispatch for Complex always calls
# rt_complex_eq and reuses the usual setcc-against-0 pattern, which
# gives a SAFE (no memory misread/crash) but not remotely meaningful
# result for ordering ops -- named here so it's never mistaken for
# real complex ordering support.

make a function called rt_complex_tag returns tag
  return (1 shl 60) bor (1 shl 48) bor (1 shl 49) bor (1 shl 50)
end

make a function called rt_fixnum_pack takes n returns tagged
  return n band rt_payload_mask()
end

make a function called rt_complex_new takes re, im returns tagged
  let addr = rt_heap_alloc(16)
  mem_poke_qword(addr, 0, re)
  mem_poke_qword(addr, 8, im)
  return addr bor rt_complex_tag()
end

# Wraps ANY already-tagged numeric value (fixnum/BigInt/Rational) as
# Complex(re=that value, im=0) -- used both for genuine "make a
# complex from a real number" construction and, in codegen_x64.
# patlang's promote-to-complex helper, for lifting a lower-tier
# operand up to Complex when mixed with a genuine Complex operand.
make a function called rt_complex_from_num takes tagged returns result
  return rt_complex_new(tagged, rt_fixnum_pack(0))
end

make a function called rt_complex_from_i64 takes n returns tagged
  return rt_complex_from_num(rt_fixnum_pack(n))
end

# Dispatches a single ALREADY-TAGGED numeric word (fixnum/BigInt/
# Rational -- never Complex) to the right *_to_string. A genuinely
# reusable "print any tower value" helper, not Complex-specific,
# needed here so rt_complex_to_string can format its re/im components
# whichever kind they happen to be.
make a function called rt_num_to_string takes tagged returns s
  # GitHub #54: this used to classify via `tagged band rt_tag_mask() ==
  # 0` to detect a plain fixnum -- WRONG for a NEGATIVE fixnum, whose
  # sign-extension sets those same tag-mask bits (the exact pitfall
  # every OTHER classifier in this file already avoids via a round-trip
  # sign-extension test, see x64_dynamic_promote_both_asm's own header).
  # A negative real/imaginary/interval-bound component fell through
  # every check to the "?" placeholder. Fixed to reuse type_of, which
  # already gets this right (and picks up GitHub #51's heap-bounds fix
  # for free).
  let kind = type_of(tagged)
  if kind == "int" then
    return rt_int_to_str(rt_fixnum_unpack(tagged))
  end
  if kind == "bigint" then
    return rt_bigint_to_string(tagged)
  end
  if kind == "rational" then
    return rt_rational_to_string(tagged)
  end
  return "?"
end

# "a+bi" -- deliberately not "a-bi" for negative im (rt_num_to_string
# already emits the leading "-" itself, so this always reads as
# "a+-bi" for a negative imaginary part). A real, named simplification
# matching the project's usual "correct but not polished" first-cut
# style, not an oversight.
make a function called rt_complex_to_string takes tagged returns s
  let addr = tagged band rt_payload_mask()
  let re = mem_peek_qword(addr, 0)
  let im = mem_peek_qword(addr, 8)
  let s = rt_num_to_string(re)
  let s = rt_str_concat(s, "+")
  let s = rt_str_concat(s, rt_num_to_string(im))
  let s = rt_str_concat(s, "i")
  return s
end

make a function called rt_complex_add takes a, b returns tagged
  let addr_a = a band rt_payload_mask()
  let addr_b = b band rt_payload_mask()
  let re_a = mem_peek_qword(addr_a, 0)
  let im_a = mem_peek_qword(addr_a, 8)
  let re_b = mem_peek_qword(addr_b, 0)
  let im_b = mem_peek_qword(addr_b, 8)
  # GitHub #56: passing two dynamic-dispatch-requiring `+` expressions
  # directly as a nested call's own arguments (`rt_complex_new(re_a +
  # re_b, im_a + im_b)`) corrupted the first result -- confirmed by
  # isolating the exact same computation with the sums first assigned
  # to named locals, which worked correctly every time. Root cause not
  # chased into the codegen's own argument-evaluation ordering (a
  # deeper, likely broader bug); this sidesteps it the same way
  # rt_complex_mul's ac/bd/ad/bc already did for its own multiplies.
  let re_sum = re_a + re_b
  let im_sum = im_a + im_b
  return rt_complex_new(re_sum, im_sum)
end

make a function called rt_complex_sub takes a, b returns tagged
  let addr_a = a band rt_payload_mask()
  let addr_b = b band rt_payload_mask()
  let re_a = mem_peek_qword(addr_a, 0)
  let im_a = mem_peek_qword(addr_a, 8)
  let re_b = mem_peek_qword(addr_b, 0)
  let im_b = mem_peek_qword(addr_b, 8)
  # Same #56 fix as rt_complex_add -- see its own comment.
  let re_diff = re_a - re_b
  let im_diff = im_a - im_b
  return rt_complex_new(re_diff, im_diff)
end

# (a+bi)(c+di) = (ac-bd) + (ad+bc)i
make a function called rt_complex_mul takes a, b returns tagged
  let addr_a = a band rt_payload_mask()
  let addr_b = b band rt_payload_mask()
  let re_a = mem_peek_qword(addr_a, 0)
  let im_a = mem_peek_qword(addr_a, 8)
  let re_b = mem_peek_qword(addr_b, 0)
  let im_b = mem_peek_qword(addr_b, 8)
  let ac = re_a * re_b
  let bd = im_a * im_b
  let ad = re_a * im_b
  let bc = im_a * re_b
  # Same #56 fix as rt_complex_add -- see its own comment.
  let re_result = ac - bd
  let im_result = ad + bc
  return rt_complex_new(re_result, im_result)
end

# Returns a plain 0/1 (not -1/0/1 like the other *_cmp functions) --
# equality is the only well-defined comparison here. Compares
# component-wise via `==`, which -- since this function itself calls
# rt_complex_new nowhere, it needs to be explicitly forced into
# dynamic mode by codegen_x64.patlang's classifier by name, see that
# file's own x64_func_is_dynamic for why.
make a function called rt_complex_eq takes a, b returns eq
  let addr_a = a band rt_payload_mask()
  let addr_b = b band rt_payload_mask()
  let re_a = mem_peek_qword(addr_a, 0)
  let im_a = mem_peek_qword(addr_a, 8)
  let re_b = mem_peek_qword(addr_b, 0)
  let im_b = mem_peek_qword(addr_b, 8)
  if re_a == re_b then
    if im_a == im_b then
      return 1
    end
  end
  return 0
end

# ---- numeric tower: Interval ----
#
# Interval's tag: family 0x1 (Numeric), but UNLIKE BigInt/Rational/
# Float/Complex's thermometer bits (each implying the ones before it,
# because that chain really is a linear "wider magnitude" ordering),
# Interval is a SEPARATE extension axis -- an interval isn't "beyond"
# Complex, it's a different kind of composite value entirely. So it
# gets its own dedicated bit (bit4, i.e. local bits 0b10000) rather
# than extending the thermometer chain further -- deliberately NOT
# combined with the BigInt/Rational/Float/Complex bits, since an
# interval's own container-ness says nothing about what TYPE its
# endpoints are (those are separately tagged, stored inside).
#
# Same composite-value shape as Complex: [8-byte tagged lo][8-byte
# tagged hi], each endpoint independently fixnum/BigInt/Rational
# (never itself an Interval or Complex -- no nesting, same as
# Complex). Same payoff: rt_interval_add/_sub/_mul are ordinary
# PatLang using `+`/`-`/`*`/`<`/`>` on the extracted endpoints, which
# -- since these functions call rt_interval_new and are therefore
# classified dynamic-mode -- route through the EXISTING
# x64_binop_asm_dynamic machinery. No new arithmetic primitives.
#
# DELIBERATE SCOPE LIMIT (same reasoning as Complex): only
# `+`/`-`/`*`/`==`/`!=` supported for top-level Interval operands.
# Ordering (`<`/`<=`/`>`/`>=`) between two intervals is genuinely
# ambiguous (does [a,b] < [c,d] mean "definitely less" (b<c) or
# "possibly less"? both are defensible, this cut picks neither) --
# same safe-but-deterministically-false treatment as Complex's
# ordering gap, not real support. `/` is unwired (same accepted-gap
# class as Complex's).
#
# Complex intervals (an Interval of Complex endpoints, or a Complex
# with Interval components) are NOT supported -- noted as a real
# combination the user flagged as plausible future work once k-blades
# (and therefore Object) exist, not attempted here.

make a function called rt_interval_tag returns tag
  return (1 shl 60) bor (1 shl 52)
end

make a function called rt_interval_new takes lo, hi returns tagged
  let addr = rt_heap_alloc(16)
  mem_poke_qword(addr, 0, lo)
  mem_poke_qword(addr, 8, hi)
  return addr bor rt_interval_tag()
end

# Degenerate interval [v,v] wrapping any already-tagged numeric value
# -- used both for genuine construction and, in codegen_x64.patlang's
# promote-to-interval helper, for lifting a lower-tier operand up when
# mixed with a genuine Interval operand.
make a function called rt_interval_from_num takes tagged returns result
  return rt_interval_new(tagged, tagged)
end

make a function called rt_interval_from_i64 takes n returns tagged
  return rt_interval_from_num(rt_fixnum_pack(n))
end

make a function called rt_interval_to_string takes tagged returns s
  let addr = tagged band rt_payload_mask()
  let lo = mem_peek_qword(addr, 0)
  let hi = mem_peek_qword(addr, 8)
  let s = "["
  let s = rt_str_concat(s, rt_num_to_string(lo))
  let s = rt_str_concat(s, ",")
  let s = rt_str_concat(s, rt_num_to_string(hi))
  let s = rt_str_concat(s, "]")
  return s
end

make a function called rt_interval_add takes a, b returns tagged
  let addr_a = a band rt_payload_mask()
  let addr_b = b band rt_payload_mask()
  let lo_a = mem_peek_qword(addr_a, 0)
  let hi_a = mem_peek_qword(addr_a, 8)
  let lo_b = mem_peek_qword(addr_b, 0)
  let hi_b = mem_peek_qword(addr_b, 8)
  # Same #56 fix as rt_complex_add -- see its own comment (this file,
  # above rt_complex_add) for the full explanation.
  let lo_sum = lo_a + lo_b
  let hi_sum = hi_a + hi_b
  return rt_interval_new(lo_sum, hi_sum)
end

# [lo_a,hi_a] - [lo_b,hi_b] = [lo_a-hi_b, hi_a-lo_b] (subtracting the
# other interval's max from this min, and vice versa -- the standard
# interval-subtraction rule, not a naive component-wise subtract).
make a function called rt_interval_sub takes a, b returns tagged
  let addr_a = a band rt_payload_mask()
  let addr_b = b band rt_payload_mask()
  let lo_a = mem_peek_qword(addr_a, 0)
  let hi_a = mem_peek_qword(addr_a, 8)
  let lo_b = mem_peek_qword(addr_b, 0)
  let hi_b = mem_peek_qword(addr_b, 8)
  # Same #56 fix as rt_complex_add -- see its own comment.
  let lo_diff = lo_a - hi_b
  let hi_diff = hi_a - lo_b
  return rt_interval_new(lo_diff, hi_diff)
end

# min/max of the four endpoint products -- the standard interval-
# multiplication rule (needed because the sign of each endpoint isn't
# known in general, so which product is smallest/largest isn't fixed).
make a function called rt_interval_mul takes a, b returns tagged
  let addr_a = a band rt_payload_mask()
  let addr_b = b band rt_payload_mask()
  let lo_a = mem_peek_qword(addr_a, 0)
  let hi_a = mem_peek_qword(addr_a, 8)
  let lo_b = mem_peek_qword(addr_b, 0)
  let hi_b = mem_peek_qword(addr_b, 8)
  let p1 = lo_a * lo_b
  let p2 = lo_a * hi_b
  let p3 = hi_a * lo_b
  let p4 = hi_a * hi_b
  let lo = p1
  if p2 < lo then
    let lo = p2
  end
  if p3 < lo then
    let lo = p3
  end
  if p4 < lo then
    let lo = p4
  end
  let hi = p1
  if p2 > hi then
    let hi = p2
  end
  if p3 > hi then
    let hi = p3
  end
  if p4 > hi then
    let hi = p4
  end
  return rt_interval_new(lo, hi)
end

# Returns a plain 0/1, same reasoning as rt_complex_eq -- forced
# dynamic by name in codegen_x64.patlang since it calls no tower
# constructor of its own.
make a function called rt_interval_eq takes a, b returns eq
  let addr_a = a band rt_payload_mask()
  let addr_b = b band rt_payload_mask()
  let lo_a = mem_peek_qword(addr_a, 0)
  let hi_a = mem_peek_qword(addr_a, 8)
  let lo_b = mem_peek_qword(addr_b, 0)
  let hi_b = mem_peek_qword(addr_b, 8)
  if lo_a == lo_b then
    if hi_a == hi_b then
      return 1
    end
  end
  return 0
end

# ---- Dynamic-mode binop dispatch (GitHub #52) ----
#
# x64_binop_asm_dynamic (codegen_x64.patlang) used to hand-assemble this
# ENTIRE family-check/promote/dispatch chain INLINE at every single "+"/
# "-"/"*"/comparison call site in dynamic-mode code -- ~500 lines,
# repeated per call site, not per program. Compiling a function that
# itself has many such operators (this codegen library's own functions,
# which build asm text via heavy string concatenation) could produce a
# single compiled unit with thousands of near-identical local labels,
# which NASM assembles at roughly QUADRATIC cost in label density (see
# GitHub #52's own investigation: 150 vs 300 repetitions of this exact
# shape went from 15.8s to un-finished-in-60s; moving the SAME logic
# out-of-line and calling it instead measured 0.04s for the same work,
# a ~400x difference). This is that out-of-line home: ordinary PatLang,
# compiled ONCE as part of this cached runtime chunk, reached via a
# plain `call` from every operator site instead of being re-emitted.
#
# op_code convention (x64_op_code_for in codegen_x64.patlang is the
# single source of truth this must stay in sync with): 0=+ 1=- 2=*
# 3=== 4=!= 5=< 6=<= 7=> 8=>=
#
# CAUTION for future maintainers: this function (and everything it
# calls transitively within this file) must NEVER use PatLang's own
# "+"/"-"/"*"/comparison OPERATORS on values whose type isn't already
# proven by a preceding `type_of` check in THIS SAME function -- doing
# so would recompile through x64_binop_asm_dynamic's own dynamic
# dispatch, which calls back into THIS function for non-fixnum
# operands, infinitely recursing. Every branch below either (a) has
# already confirmed both operands are genuine ints via type_of before
# using a bare operator on them (safe -- takes the cheap fixnum fast
# path, never re-enters this function), or (b) calls a leaf rt_*
# function directly (rt_bigint_add etc, or the dedicated
# rt_raw_word_eq primitive for raw identity comparison -- NOT a bare
# "==", which would recurse for non-numeric operands).

make a function called rt_dynamic_numeric_binop takes a, b, op_code returns result
  let ka = type_of(a)
  let kb = type_of(b)
  if (ka == "int") and (kb == "int") then
    if op_code == 0 then
      return a + b
    end
    if op_code == 1 then
      return a - b
    end
    if op_code == 2 then
      return a * b
    end
    if op_code == 3 then
      return a == b
    end
    if op_code == 4 then
      return a != b
    end
    if op_code == 5 then
      return a < b
    end
    if op_code == 6 then
      return a <= b
    end
    if op_code == 7 then
      return a > b
    end
    return a >= b
  end
  if (ka == "interval") or (kb == "interval") then
    let pa = a
    let pb = b
    if ka != "interval" then
      let pa = rt_interval_from_num(a)
    end
    if kb != "interval" then
      let pb = rt_interval_from_num(b)
    end
    if op_code == 3 then
      return rt_interval_eq(pa, pb) == 1
    end
    if op_code == 4 then
      return rt_interval_eq(pa, pb) != 1
    end
    if op_code >= 5 then
      return false
    end
    if op_code == 0 then
      return rt_interval_add(pa, pb)
    end
    if op_code == 1 then
      return rt_interval_sub(pa, pb)
    end
    return rt_interval_mul(pa, pb)
  end
  if (ka == "complex") or (kb == "complex") then
    let pa = a
    let pb = b
    if ka != "complex" then
      let pa = rt_complex_from_num(a)
    end
    if kb != "complex" then
      let pb = rt_complex_from_num(b)
    end
    if op_code == 3 then
      return rt_complex_eq(pa, pb) == 1
    end
    if op_code == 4 then
      return rt_complex_eq(pa, pb) != 1
    end
    if op_code >= 5 then
      return false
    end
    if op_code == 0 then
      return rt_complex_add(pa, pb)
    end
    if op_code == 1 then
      return rt_complex_sub(pa, pb)
    end
    return rt_complex_mul(pa, pb)
  end
  if (ka == "rational") or (kb == "rational") then
    let pa = a
    let pb = b
    if ka != "rational" then
      let pa = rt_rational_from_i64(a)
    end
    if kb != "rational" then
      let pb = rt_rational_from_i64(b)
    end
    if op_code >= 3 then
      let c = rt_rational_cmp(pa, pb)
      if op_code == 3 then
        return c == 0
      end
      if op_code == 4 then
        return c != 0
      end
      if op_code == 5 then
        return c < 0
      end
      if op_code == 6 then
        return c <= 0
      end
      if op_code == 7 then
        return c > 0
      end
      return c >= 0
    end
    if op_code == 0 then
      return rt_rational_add(pa, pb)
    end
    if op_code == 1 then
      return rt_rational_sub(pa, pb)
    end
    return rt_rational_mul(pa, pb)
  end
  # Default: BigInt (matches the original DYN_HASTAG fallthrough --
  # any remaining Numeric-family pair that isn't Interval/Complex/
  # Rational is BigInt, or a fixnum mixed with one).
  let pa = a
  let pb = b
  if ka == "int" then
    let pa = rt_bigint_from_i64(a)
  end
  if kb == "int" then
    let pb = rt_bigint_from_i64(b)
  end
  if op_code >= 3 then
    let c = rt_bigint_cmp(pa, pb)
    if op_code == 3 then
      return c == 0
    end
    if op_code == 4 then
      return c != 0
    end
    if op_code == 5 then
      return c < 0
    end
    if op_code == 6 then
      return c <= 0
    end
    if op_code == 7 then
      return c > 0
    end
    return c >= 0
  end
  if op_code == 0 then
    return rt_bigint_add(pa, pb)
  end
  if op_code == 1 then
    return rt_bigint_sub(pa, pb)
  end
  return rt_bigint_mul(pa, pb)
end

# "+" on at least one non-Numeric-family operand -- string concat,
# auto-stringify a fixnum against a string, or list-to-display-string
# first. Mirrors the original DYN_OBJPLUS chain exactly (GitHub #19/
# #35's own fixes, now expressed as ordinary type_of checks instead of
# hand-rolled family-tag bit twiddling).
make a function called rt_dynamic_plus_obj takes a, b returns result
  let pa = a
  let pb = b
  if type_of(pa) == "list" then
    let pa = rt_list_to_display_string(pa)
  end
  if type_of(pb) == "list" then
    let pb = rt_list_to_display_string(pb)
  end
  let ka = type_of(pa)
  let kb = type_of(pb)
  if (ka == "string") and (kb == "string") then
    return rt_str_concat(pa, pb)
  end
  if (ka == "string") and (kb == "int") then
    return rt_str_concat(pa, rt_int_to_str(pb))
  end
  if (ka == "int") and (kb == "string") then
    return rt_str_concat(rt_int_to_str(pa), pb)
  end
  return 0
end

# Comparison on at least one non-Numeric-family operand -- real content
# comparison for two genuine strings (GitHub #20), raw identity
# otherwise (Object/List/Closure, or any mixed-type pair -- mirrors the
# original DYN_OBJCMP_NOTSTR fallback exactly).
make a function called rt_dynamic_cmp_obj takes a, b, op_code returns result
  if (type_of(a) == "string") and (type_of(b) == "string") then
    # GitHub #20 regression, found+fixed: rt_str_eq returns a genuine
    # PatLang true/false (Bool-tagged), NOT the bare 0/1 int convention
    # rt_bigint_cmp/rt_complex_eq/rt_interval_eq use -- comparing its
    # result against the literal `1` was always false (a Bool-tagged
    # true's raw bits are nowhere near 1), so string `==`/`!=` silently
    # fell through to raw identity comparison for every real string
    # pair. Use the boolean result directly.
    if op_code == 3 then
      return rt_str_eq(a, b)
    end
    if op_code == 4 then
      return not rt_str_eq(a, b)
    end
    let c = rt_str_cmp(a, b)
    if op_code == 5 then
      return c < 0
    end
    if op_code == 6 then
      return c <= 0
    end
    if op_code == 7 then
      return c > 0
    end
    return c >= 0
  end
  if op_code == 3 then
    return rt_raw_word_eq(a, b)
  end
  if op_code == 4 then
    return not rt_raw_word_eq(a, b)
  end
  return false
end

# Top-level dynamic-mode dispatcher -- x64_binop_asm_dynamic's own
# DYN_NOTFAST path calls straight into this (push a, push b, push
# op_code, call) instead of hand-assembling the whole chain inline.
make a function called rt_dynamic_binop takes a, b, op_code returns result
  let ka = type_of(a)
  let kb = type_of(b)
  let ka_numeric = (ka == "int") or (ka == "bigint") or (ka == "rational") or (ka == "complex") or (ka == "interval")
  let kb_numeric = (kb == "int") or (kb == "bigint") or (kb == "rational") or (kb == "complex") or (kb == "interval")
  if ka_numeric and kb_numeric then
    return rt_dynamic_numeric_binop(a, b, op_code)
  end
  if op_code == 0 then
    return rt_dynamic_plus_obj(a, b)
  end
  if op_code >= 3 then
    return rt_dynamic_cmp_obj(a, b, op_code)
  end
  return 0
end

# ---- Object (clean, closures-based direction -- NOT the existing
# interpreter/rustc backend's oo system) ----
#
# The existing interpreter/rustc-backend Object (Value::Object, the
# `oo` prelude chunk in rust-runtime/src/ir/codegen.rs) is a string-
# keyed global-handle system tied to the older GOAP/logic-facts
# subsystem (object_new/get/send against a global name table, plus
# hardcoded methods like infer_is_adult). Per explicit user direction,
# this backend's Object does NOT mirror that -- it follows the SAME
# direction Slice 5's closures were deliberately shaped toward: a
# first-class heap value, [8-byte type id][8-byte field count][tagged
# field values...], reusing the SAME family-tag scheme every other
# composite value in this backend already uses. Fields are accessed
# by INDEX (no name->slot mapping in this first cut -- a real, named
# simplification, not an oversight). type_id is caller-assigned and
# opaque to this runtime (no built-in vtable/method dispatch yet --
# that's exactly where the closures-as-proto-objects direction from
# Slice 5 would connect, not built here).
#
# User's own explicit note, worth remembering for later: "The clean
# [design] is preferred if we will be able to revisit the legacy to
# keep it mirrored so the user experience remains the same whichever
# path is being used. Consistency is key, but that should not prevent
# us developing new implementations to improve things." -- i.e. the
# EXISTING interpreter/rustc backend's Object semantics should
# eventually migrate toward THIS model too, for cross-backend
# consistency. Not attempted in this pass (a real, separate, larger
# undertaking touching the Rust runtime itself, not just this
# self-hosted x64 backend) -- named here so it isn't lost.
#
# Object tag: family 0x5 (reserved for exactly this since the
# original tag-layout design), local bits 0 (type_id lives INSIDE the
# heap block, not in the tag itself -- unlike BigInt/Rational/Complex/
# Interval, Object needs an open-ended type space, not a fixed
# thermometer position).
#
# Object equality is IDENTITY, not value equality (objects are
# mutable heap references, mutated in place by rt_object_set --
# matching rt_list_set's own in-place-mutation convention, not the
# interpreter's copy-on-write list_set). This makes Object comparison
# genuinely simpler than Complex/Interval's: raw tagged-word equality
# (`cmp` on the whole 64-bit word) is ALREADY correct for "same
# object" and ALREADY correctly reports "not equal" against any
# differently-tagged value (different address low bits AND/OR
# different tag high bits) -- no runtime function call needed at all,
# unlike rt_complex_eq/rt_interval_eq.
#
# Arithmetic (+/-/*) on an Object operand is not meaningful and is
# NOT implemented -- codegen_x64.patlang's dispatch treats this as a
# safe, deterministic no-op (returns 0) rather than falling through
# to the wrong BigInt-family default (which would misread an Object's
# [type id][field count] header as BigInt's [sign][limb count]).

make a function called rt_object_tag returns tag
  return 5 shl 60
end

make a function called rt_object_new takes type_id, field_count returns tagged
  let addr = rt_heap_alloc(16 + field_count * 8)
  mem_poke_qword(addr, 0, type_id)
  mem_poke_qword(addr, 8, field_count)
  let i = 0
  while i < field_count do
    mem_poke_qword(addr, 16 + i * 8, rt_fixnum_pack(0))
    let i = i + 1
  end
  return addr bor rt_object_tag()
end

make a function called rt_object_type takes obj returns type_id
  let addr = obj band rt_payload_mask()
  return mem_peek_qword(addr, 0)
end

make a function called rt_object_field_count takes obj returns n
  let addr = obj band rt_payload_mask()
  return mem_peek_qword(addr, 8)
end

make a function called rt_object_get takes obj, i returns tagged
  let addr = obj band rt_payload_mask()
  return mem_peek_qword(addr, 16 + i * 8)
end

# In-place mutation (same convention as rt_list_set, not the
# interpreter's copy-on-write semantics).
make a function called rt_object_set takes obj, i, v returns done
  let addr = obj band rt_payload_mask()
  mem_poke_qword(addr, 16 + i * 8, v)
  return true
end

# ---- file I/O (self-hosting-toward-x64, step 2 of 3) ----
#
# Matches the interpreter's own read_file/write_file/file_exists call
# signatures and semantics as closely as this backend allows: read_
# file(path) returns String contents, write_file(path, contents)
# returns a boolean-like 1/0 (this backend's own bool convention, not
# the interpreter's richer Bool type), file_exists(path) returns "1"/
# "0" strings exactly like the interpreter's own convention. NAMED
# GAP: no error propagation mechanism exists in this backend at all
# (no exceptions, no Result type) -- a failed read_file returns an
# empty string rather than raising an error, unlike the interpreter's
# own Err(...) on a missing file. write_file also does NOT create
# parent directories first (the interpreter's own version does) -- a
# real, separate piece of Win32 work (recursive mkdir), deferred.

make a function called rt_read_file takes path returns tagged
  let addr = path band rt_payload_mask()
  let path_len = mem_peek_qword(addr, 0)
  let path_bytes = addr + 8
  let size = os_file_size(path_bytes, path_len)
  if size < 0 then
    let e = rt_heap_alloc(8)
    mem_poke_qword(e, 0, 0)
    return e bor rt_string_tag()
  end
  let buf = rt_heap_alloc(8 + size)
  mem_poke_qword(buf, 0, size)
  os_read_file_into(path_bytes, path_len, buf + 8, size)
  return buf bor rt_string_tag()
end

make a function called rt_write_file takes path, contents returns ok
  let addr = path band rt_payload_mask()
  let path_len = mem_peek_qword(addr, 0)
  let path_bytes = addr + 8
  let caddr = contents band rt_payload_mask()
  let data_len = mem_peek_qword(caddr, 0)
  let data_bytes = caddr + 8
  return os_write_file(path_bytes, path_len, data_bytes, data_len)
end

make a function called rt_file_exists takes path returns s
  let addr = path band rt_payload_mask()
  let path_len = mem_peek_qword(addr, 0)
  let path_bytes = addr + 8
  let size = os_file_size(path_bytes, path_len)
  if size < 0 then
    return "0"
  end
  return "1"
end

# ---- exec (self-hosting-toward-x64, step 3 of 3) ----
#
# exec_capture(path, arg1, arg2, ...) matches the interpreter's own
# call SHAPE (a variadic list of string args, not a single list
# parameter -- confirmed against rust-runtime/src/ir/codegen.rs's own
# "exec_capture" handler before implementing). codegen_x64.patlang's
# CallHost handling for "exec_capture" already knows this call site's
# argc at codegen time (every CallHost site does), so it pops all N
# tagged-string args (compile-time unrolled, same pattern
# x64_buildlist_asm already uses) into a temp heap array and calls
# rt_exec_join_args (below) to build a single space-joined command
# line -- ordinary PatLang, not raw assembly, since string-joining
# has no reason to be hand-written asm once rt_str_concat already
# exists. Only the GENUINE OS boundary (process creation + pipe
# redirection) is a native primitive: os_exec_run(cmdline_addr,
# cmdline_len) -> captured output as a plain string address (masked/
# unmasked the same as every other OS-boundary primitive's contract).
#
# NAMED GAPS versus the interpreter's own exec_capture (real
# scope limits, not oversights):
#   - stdout AND stderr are redirected to the SAME pipe (combined
#     output), not "stdout normally, stderr appended only on
#     failure" -- simpler, and still shows errors from a failing
#     invocation, just doesn't distinguish the two streams.
#   - output is capped at a fixed 65536-byte buffer -- silently
#     truncated beyond that, not truly unbounded.
#   - no quoting/escaping of arguments containing spaces (the
#     command line is a plain space-joined string) -- fine for this
#     project's own actual invocations (nasm/gcc with plain paths),
#     not general-purpose.
#   - no error propagation if CreateProcessA itself fails (bad path,
#     etc) -- returns an empty string, matching this backend's
#     existing no-exceptions-anywhere convention.

# Real bug found by an actual failed run (not review): the first
# version joined args with plain spaces, no quoting. nasm.exe's own
# real install path on Windows almost always contains a space
# ("C:\Program Files\NASM\nasm.exe"), which CreateProcessA's command-
# line parser then splits into two separate tokens -- CreateProcessA
# silently fails (no such program as "C:\Program"), and since nothing
# checked its return value, the primitive proceeded to read from a
# pipe nothing was ever writing to, returning an empty string with no
# indication anything went wrong. Fixed by wrapping every argument in
# double quotes (ASCII 34, built via mem_poke_byte -- this backend
# has no chr() primitive) -- the standard Windows command-line
# quoting convention, sufficient for ordinary paths/flags even though
# it doesn't handle a literal embedded quote character within an
# argument (not needed for this project's own actual invocations).
make a function called rt_dquote_str returns s
  let s = rt_heap_alloc(9)
  mem_poke_qword(s, 0, 1)
  mem_poke_byte(s, 8, 34)
  return s bor rt_string_tag()
end

# A token needs quoting only if an UNQUOTED copy of it would be split
# into more than one argv entry by CreateProcessA's own tokenizer --
# i.e. it contains a space, or is empty (0-length args would otherwise
# vanish entirely from the joined command line). Matches Rust's own
# std::process::Command::args, which quotes only when necessary rather
# than wrapping every token unconditionally.
make a function called rt_exec_arg_needs_quoting takes item returns needed
  let len = rt_str_len(item)
  if len == 0 then
    return true
  end
  let i = 0
  while i < len do
    if char_code(item, i) == 32 then
      return true
    end
    let i = i + 1
  end
  return false
end

# GitHub #40-adjacent selftest gap: quoting EVERY argument unconditionally
# (the previous behavior) is what fixed nasm.exe's own space-containing
# install path, but it also changed how cmd.exe's `/c` re-parses its own
# tail for any OTHER argument that does NOT need quoting -- an argv
# token that is quoted from its very first to very last character has
# those quotes cleanly stripped during normal argv tokenization, but
# cmd.exe's `/c` handling re-parses its tail with its OWN, weaker rules,
# so a token quoted ONLY because this function used to quote everything
# (not because it actually contained a space) could end up echoed
# without its surrounding quotes even though the SAME multi-word
# argument, quoted by a strictly-necessary quoter (this is what Rust's
# own Command::args does), keeps its quotes through cmd.exe's tail
# re-parsing -- confirmed directly: x64_exec_capture_r15_selftest.patlang's
# `echo "hello from exec_capture"` case differed from the interpreter
# (which uses Rust's own quote-only-when-needed Command::args) purely
# because of this. Quoting only when actually needed (this fix) matches
# the interpreter's real, already-correct behavior exactly, rather than
# chasing cmd.exe's own idiosyncratic /c re-parsing rules directly.
make a function called rt_exec_join_args takes arr, count returns tagged
  let q = rt_dquote_str()
  let e = rt_heap_alloc(8)
  mem_poke_qword(e, 0, 0)
  let result = e bor rt_string_tag()
  let i = 0
  while i < count do
    let item = mem_peek_qword(arr, i * 8)
    if i > 0 then
      let result = rt_str_concat(result, " ")
    end
    let needs_q = rt_exec_arg_needs_quoting(item)
    if needs_q then
      let result = rt_str_concat(result, q)
    end
    let result = rt_str_concat(result, item)
    if needs_q then
      let result = rt_str_concat(result, q)
    end
    let i = i + 1
  end
  return result
end

# =============================================================================
# Prolog-like logic engine (GitHub #26, Stage 1 of the #25 Rust-free-
# toolchain roadmap): rule_add/solve, real unification with backtracking.
# Ground truth: rust-runtime/src/ir/hosts.rs lines ~780-958 (`is_logic_var`/
# `walk`/`unify_args`/`apply_subst`/`fresh_rename`/`solve_goal`/
# `resolve_conjuncts`/`host_rule_add`/`host_solve`). Deliberately NOT a
# ground-only subset -- real programs in this repo (goal_oriented_build_
# demo.patlang, synthesis_grandparent_selftest.patlang, paradigm_gallery/
# functional_logic.patlang, etc) genuinely rely on variable unification and
# multi-solution backtracking, not just fact lookup.
#
# Variable convention (matches the Rust host exactly): an arg string is a
# logic variable iff its first character is ASCII uppercase.
#
# Substitution representation: a Subst is a plain PatLang List of
# [var, value] pairs -- no hashmap exists in this backend (there is
# genuinely nothing to key one by; see rt_runtime's own set_var/get, which
# is a linear-scan assoc list for exactly the same reason). Looked up via
# linear scan + rt_str_eq.
# =============================================================================

make a function called is_logic_var takes s returns yes
  if s.length == 0 then
    return false
  end
  let c = char_code(s, 0)
  return (c >= 65) and (c <= 90)
end

make a function called logic_subst_lookup takes subst, var returns result
  let n = subst.length
  let i = 0
  while i < n do
    let pair = subst[i]
    if rt_str_eq(pair[0], var) then
      return ["Ok", pair[1]]
    end
    let i = i + 1
  end
  return ["Err", ""]
end

# Real correctness hazard avoided here, not just a style choice:
# rt_list_push (above) mutates in place when capacity allows, and its
# own header comment explicitly names the exact failure mode this
# would hit -- "a rarer divergent-branches pattern" where an older
# reference gets silently mutated underneath it. Backtracking IS
# exactly that pattern: solve_goal below tries every matching rule
# against the SAME incoming subst, so multiple sibling branches must
# extend it independently. logic_subst_extend therefore always
# allocates and copies fresh rather than ever calling rt_list_push on
# a Subst.
make a function called logic_subst_extend takes subst, var, value returns out
  let n = subst.length
  let out = rt_list_new(n + 1)
  let i = 0
  while i < n do
    rt_list_set(out, i, subst[i])
    let i = i + 1
  end
  rt_list_set(out, n, [var, value])
  return out
end

# Follows `term` through `subst` while it's still bound to another
# variable, up to 1000 hops (cycle guard, matching the Rust host
# exactly), returning the final ground/unbound term.
make a function called logic_walk takes term, subst returns out
  let cur = term
  let hops = 0
  while is_logic_var(cur) and (hops < 1000) do
    let found = logic_subst_lookup(subst, cur)
    if found[0] == "Err" then
      return cur
    end
    let next = found[1]
    if rt_str_eq(next, cur) then
      return cur
    end
    let cur = next
    let hops = hops + 1
  end
  return cur
end

# unify_args(query_args, target_args, subst) -> ["Ok", new_subst] on
# success, ["Err", ""] on failure -- pairwise walk both sides; if one
# side is an unbound variable, bind it; if both are ground and differ,
# fail. Matches the Rust host's unify_args exactly (hosts.rs ~832-847).
make a function called unify_args takes query_args, target_args, subst returns result
  if query_args.length != target_args.length then
    return ["Err", ""]
  end
  let s = subst
  let n = query_args.length
  let i = 0
  while i < n do
    let qw = logic_walk(query_args[i], s)
    let tw = logic_walk(target_args[i], s)
    if is_logic_var(qw) then
      if not rt_str_eq(qw, tw) then
        let s = logic_subst_extend(s, qw, tw)
      end
    else
      if is_logic_var(tw) then
        if not rt_str_eq(tw, qw) then
          let s = logic_subst_extend(s, tw, qw)
        end
      else
        if not rt_str_eq(qw, tw) then
          return ["Err", ""]
        end
      end
    end
    let i = i + 1
  end
  return ["Ok", s]
end

make a function called apply_subst takes args, subst returns out
  let n = args.length
  let out = rt_list_new(n)
  let i = 0
  while i < n do
    rt_list_set(out, i, logic_walk(args[i], subst))
    let i = i + 1
  end
  return out
end

# Global rules store, same lazy-init-on-first-use pattern as vec_new/
# sb_new's own tables (a real tagged rt_list is never bit-for-bit zero,
# so 0 in the .bss slot unambiguously means "not yet created"). Each
# entry: [head_pred, head_args_list, body_list] -- a ground fact is
# exactly a rule with an empty body_list, matching the Rust host's own
# "ground fact = rule with empty body" representation.
make a function called logic_rules_list returns l
  let addr = mem_rules_table_addr()
  let l = mem_peek_qword(addr, 0)
  if l == 0 then
    let l = rt_list_new(0)
    mem_poke_qword(addr, 0, l)
  end
  return l
end

make a function called logic_rules_list_set takes l returns done
  mem_poke_qword(mem_rules_table_addr(), 0, l)
  return true
end

# fresh_rename: renames every logic variable in a rule to a fresh,
# globally-unique name on every use (hosts.rs ~856-872), so recursive
# backtracking into the same rule twice can't leak one attempt's
# bindings into another's. Counter reuses the existing set_var/get
# global-named-counter pattern (same idiom codegen_x64.patlang's own
# label counters already use).
make a function called logic_next_rename_id returns id
  let cur = to_num(get("__vars", "__logic_rename_ctr"))
  let next = cur + 1
  set_var("__logic_rename_ctr", next)
  return next
end

make a function called logic_rename_lookup takes map, var returns result
  let n = map.length
  let i = 0
  while i < n do
    let pair = map[i]
    if rt_str_eq(pair[0], var) then
      return ["Ok", pair[1]]
    end
    let i = i + 1
  end
  return ["Err", ""]
end

# Renames one term (a no-op if it's not a variable), returning
# [new_term, updated_map] so repeated occurrences of the SAME variable
# within one fresh_rename call consistently get the SAME new name.
make a function called logic_rename_term takes term, suffix, map returns result
  if not is_logic_var(term) then
    return [term, map]
  end
  let found = logic_rename_lookup(map, term)
  if found[0] == "Ok" then
    return [found[1], map]
  end
  let renamed = term + "__" + suffix
  let new_map = logic_subst_extend(map, term, renamed)
  return [renamed, new_map]
end

make a function called logic_rename_args takes args, suffix, map returns result
  let n = args.length
  let out = rt_list_new(n)
  let cur_map = map
  let i = 0
  while i < n do
    let r = logic_rename_term(args[i], suffix, cur_map)
    rt_list_set(out, i, r[0])
    let cur_map = r[1]
    let i = i + 1
  end
  return [out, cur_map]
end

make a function called logic_fresh_rename takes rule returns renamed
  let suffix = rt_int_to_str(logic_next_rename_id())
  let head_pred = rule[0]
  let head_args = rule[1]
  let body = rule[2]
  let r1 = logic_rename_args(head_args, suffix, [])
  let new_head_args = r1[0]
  let body_n = body.length
  let new_body = rt_list_new(body_n)
  let cur_map = r1[1]
  let bi = 0
  while bi < body_n do
    let item = body[bi]
    let r2 = logic_rename_args(item[1], suffix, cur_map)
    rt_list_set(new_body, bi, [item[0], r2[0]])
    let cur_map = r2[1]
    let bi = bi + 1
  end
  return [head_pred, new_head_args, new_body]
end

make a function called logic_candidates_for_pred takes pred returns matches
  let rules = logic_rules_list()
  let n = rules.length
  let out = rt_list_new(0)
  let i = 0
  while i < n do
    let rule = rules[i]
    if rt_str_eq(rule[0], pred) then
      let out = rt_list_push(out, rule)
    end
    let i = i + 1
  end
  return out
end

# Depth-capped (200, matching MAX_LOGIC_DEPTH in the Rust host)
# recursive search: for every stored rule whose head predicate
# matches, fresh-rename it, try to unify args against its head, and if
# it unifies, recurse into resolve_conjuncts on its body; concatenate
# all resulting substs across all matching rules.
make a function called solve_goal takes pred, args, subst, depth returns results
  if depth > 200 then
    return []
  end
  let candidates = logic_candidates_for_pred(pred)
  let out = rt_list_new(0)
  let n = candidates.length
  let i = 0
  while i < n do
    let rule = logic_fresh_rename(candidates[i])
    let u = unify_args(args, rule[1], subst)
    if u[0] == "Ok" then
      let sub_results = resolve_conjuncts(rule[2], u[1], depth + 1)
      let sj = 0
      let sn = sub_results.length
      while sj < sn do
        let out = rt_list_push(out, sub_results[sj])
        let sj = sj + 1
      end
    end
    let i = i + 1
  end
  return out
end

# Empty body -> proven, [subst]. Otherwise resolve the first conjunct
# (neq(A,B) is a built-in inequality FILTER on already-walked terms,
# not a rule lookup -- matches hosts.rs's own resolve_conjuncts
# exactly) and, for each resulting subst, recursively resolve the
# rest, concatenating.
make a function called resolve_conjuncts takes body, subst, depth returns results
  if body.length == 0 then
    return [subst]
  end
  let first = body[0]
  let pred = first[0]
  let cargs = first[1]
  let rest_n = body.length - 1
  let rest = rt_list_new(rest_n)
  let ri = 0
  while ri < rest_n do
    rt_list_set(rest, ri, body[ri + 1])
    let ri = ri + 1
  end
  if pred == "neq" then
    let a0 = logic_walk(cargs[0], subst)
    let a1 = logic_walk(cargs[1], subst)
    if not rt_str_eq(a0, a1) then
      return resolve_conjuncts(rest, subst, depth)
    end
    return []
  end
  let applied = apply_subst(cargs, subst)
  let sub_results = solve_goal(pred, applied, subst, depth)
  let out = rt_list_new(0)
  let i = 0
  let n = sub_results.length
  while i < n do
    let more = resolve_conjuncts(rest, sub_results[i], depth)
    let j = 0
    let mn = more.length
    while j < mn do
      let out = rt_list_push(out, more[j])
      let j = j + 1
    end
    let i = i + 1
  end
  return out
end

make a function called rule_add takes head_pred, head_args, body returns done
  let rules = logic_rules_list()
  let rules = rt_list_push(rules, [head_pred, head_args, body])
  logic_rules_list_set(rules)
  return true
end

# solve(pred, args_list) -> List of solutions; each solution is
# args_list with any variables replaced by their bound values, one
# entry per way the goal can be proven true (real backtracking).
make a function called solve takes pred, query_args returns solutions
  let results = solve_goal(pred, query_args, [], 0)
  let out = rt_list_new(0)
  let n = results.length
  let i = 0
  while i < n do
    let out = rt_list_push(out, apply_subst(query_args, results[i]))
    let i = i + 1
  end
  return out
end

# =============================================================================
# GOAP planner (GitHub #27, Stage 2 of the #25 Rust-free-toolchain
# roadmap): action_add/plan, uniform-cost search over world-states.
# Ground truth: rust-runtime/src/ir/hosts.rs lines ~960-1131. Shares its
# fact substrate with Stage 1 above: the world state is exactly the set
# of ground, empty-body rules currently registered.
#
# Real programs in this repo use PARAMETERIZED actions with logic
# variables in preconditions (e.g. action_add("build_from_dep",
# [["dep",["X","Y"]],["built",["Y"]]], [["built",["X"]]], [], 1)),
# genuinely requiring ground_action_instances to bind X/Y per-expansion
# against the current state -- not a ground-only subset.
#
# No hashmap or priority-queue structure exists in this backend --
# two DELIBERATE, DOCUMENTED simplifications instead of hidden
# approximations, both explicitly named in the planning discussion for
# this feature:
#   - Frontier: a growable list of [cost, state, path] nodes, linear-
#     scan "pop minimum" instead of a real binary heap.
#   - Visited: canonicalize each state as a sorted, joined string of
#     "pred(args)" facts, checked via linear scan instead of a hashset.
# Both bounded by the same NODE_CAP (5000) the Rust host uses either
# way.
# =============================================================================

make a function called logic_actions_list returns l
  let addr = mem_actions_table_addr()
  let l = mem_peek_qword(addr, 0)
  if l == 0 then
    let l = rt_list_new(0)
    mem_poke_qword(addr, 0, l)
  end
  return l
end

make a function called logic_actions_list_set takes l returns done
  mem_poke_qword(mem_actions_table_addr(), 0, l)
  return true
end

# action_add(name, preconds_list, add_effects_list, del_effects_list,
# cost) -> Unit. preconds/add_effects/del_effects are lists of
# [pred, args_list] pairs -- the SAME shape as a rule's body items.
make a function called action_add takes name, preconds, add_effects, del_effects, cost returns done
  let actions = logic_actions_list()
  let actions = rt_list_push(actions, [name, preconds, add_effects, del_effects, cost])
  logic_actions_list_set(actions)
  return true
end

make a function called logic_is_ground_args takes args returns yes
  let n = args.length
  let i = 0
  while i < n do
    if is_logic_var(args[i]) then
      return false
    end
    let i = i + 1
  end
  return true
end

# World state = every rule with an empty body AND no variable in its
# head args (a genuine ground fact, not a general rule).
make a function called current_ground_facts_as_state returns state
  let rules = logic_rules_list()
  let n = rules.length
  let out = rt_list_new(0)
  let i = 0
  while i < n do
    let rule = rules[i]
    if rule[2].length == 0 then
      if logic_is_ground_args(rule[1]) then
        let out = rt_list_push(out, [rule[0], rule[1]])
      end
    end
    let i = i + 1
  end
  return out
end

make a function called logic_fact_eq takes a, b returns yes
  if not rt_str_eq(a[0], b[0]) then
    return false
  end
  let aa = a[1]
  let ba = b[1]
  if aa.length != ba.length then
    return false
  end
  let n = aa.length
  let i = 0
  while i < n do
    if not rt_str_eq(aa[i], ba[i]) then
      return false
    end
    let i = i + 1
  end
  return true
end

make a function called logic_state_contains takes state, fact returns yes
  let n = state.length
  let i = 0
  while i < n do
    if logic_fact_eq(state[i], fact) then
      return true
    end
    let i = i + 1
  end
  return false
end

# Conjunctively unify an action's (possibly parameterized)
# preconditions against the current world state, returning one Subst
# per way they can all hold simultaneously (matching
# ground_action_instances in the Rust host exactly -- reuses Stage 1's
# unify_args/apply_subst directly, just matching against STATE facts
# instead of the rules store).
make a function called logic_ground_action_instances_go takes remaining, state, subst, out returns out2
  if remaining.length == 0 then
    return rt_list_push(out, subst)
  end
  let first = remaining[0]
  let pred = first[0]
  let fargs = first[1]
  let applied = apply_subst(fargs, subst)
  let rest_n = remaining.length - 1
  let rest = rt_list_new(rest_n)
  let ri = 0
  while ri < rest_n do
    rt_list_set(rest, ri, remaining[ri + 1])
    let ri = ri + 1
  end
  let sn = state.length
  let si = 0
  let cur_out = out
  while si < sn do
    let fact = state[si]
    if rt_str_eq(fact[0], pred) then
      let u = unify_args(applied, fact[1], subst)
      if u[0] == "Ok" then
        let cur_out = logic_ground_action_instances_go(rest, state, u[1], cur_out)
      end
    end
    let si = si + 1
  end
  return cur_out
end

make a function called ground_action_instances takes preconds, state returns substs
  return logic_ground_action_instances_go(preconds, state, [], rt_list_new(0))
end

# A parameterized action's plan step is reported with its bound values
# (e.g. "build(X=target_a)") so two instantiations of the same action
# template are distinguishable in the returned plan -- ground actions
# report their bare name unchanged, matching the Rust host exactly.
make a function called logic_collect_vars_in_args takes args, seen returns out
  let n = args.length
  let i = 0
  let cur = seen
  while i < n do
    let a = args[i]
    if is_logic_var(a) then
      let found = false
      let sj = 0
      let sn = cur.length
      while sj < sn do
        if rt_str_eq(cur[sj], a) then
          let found = true
        end
        let sj = sj + 1
      end
      if not found then
        let cur = rt_list_push(cur, a)
      end
    end
    let i = i + 1
  end
  return cur
end

make a function called action_instance_label takes name, preconds, subst returns label
  let seen = rt_list_new(0)
  let n = preconds.length
  let i = 0
  while i < n do
    let seen = logic_collect_vars_in_args(preconds[i][1], seen)
    let i = i + 1
  end
  if seen.length == 0 then
    return name
  end
  let parts = ""
  let j = 0
  let jn = seen.length
  while j < jn do
    if j > 0 then
      let parts = parts + ","
    end
    let parts = parts + seen[j] + "=" + logic_walk(seen[j], subst)
    let j = j + 1
  end
  return name + "(" + parts + ")"
end

# Real correctness hazard avoided here, same class as
# logic_subst_extend above: `path` is the SAME starting list extended
# independently by every sibling action-instance found at one search
# node, so rt_list_push's mutate-in-place-when-possible growth would
# let one sibling's appended step leak into another's path. Always
# copies fresh.
make a function called logic_path_extend takes path, label returns out
  let n = path.length
  let out = rt_list_new(n + 1)
  let i = 0
  while i < n do
    rt_list_set(out, i, path[i])
    let i = i + 1
  end
  rt_list_set(out, n, label)
  return out
end

make a function called logic_frontier_pop_min takes frontier returns result
  let n = frontier.length
  let best_i = 0
  let best_cost = frontier[0][0]
  let i = 1
  while i < n do
    let c = frontier[i][0]
    if c < best_cost then
      let best_cost = c
      let best_i = i
    end
    let i = i + 1
  end
  let node = frontier[best_i]
  let rest_n = n - 1
  let rest = rt_list_new(rest_n)
  let ri = 0
  let j = 0
  while j < n do
    if j != best_i then
      rt_list_set(rest, ri, frontier[j])
      let ri = ri + 1
    end
    let j = j + 1
  end
  return [node, rest]
end

make a function called logic_fact_to_str takes fact returns s
  let out = fact[0] + "("
  let args = fact[1]
  let n = args.length
  let i = 0
  while i < n do
    if i > 0 then
      let out = out + ","
    end
    let out = out + args[i]
    let i = i + 1
  end
  return out + ")"
end

# Canonicalizes a state (a value SET, order-independent) into one
# comparable string: format every fact, sort the fragments (a simple
# selection sort -- state sizes here are small and NODE_CAP already
# bounds total work), join. Two states with the same facts in any
# order canonicalize identically.
make a function called logic_state_canonical takes state returns s
  let n = state.length
  let strs = rt_list_new(n)
  let i = 0
  while i < n do
    rt_list_set(strs, i, logic_fact_to_str(state[i]))
    let i = i + 1
  end
  let a = 0
  while a < n do
    let min_i = a
    let b = a + 1
    while b < n do
      if rt_str_cmp(strs[b], strs[min_i]) < 0 then
        let min_i = b
      end
      let b = b + 1
    end
    if min_i != a then
      let tmp = strs[a]
      rt_list_set(strs, a, strs[min_i])
      rt_list_set(strs, min_i, tmp)
    end
    let a = a + 1
  end
  let out = ""
  let j = 0
  while j < n do
    let out = out + strs[j] + "|"
    let j = j + 1
  end
  return out
end

make a function called logic_visited_contains takes visited, key returns yes
  let n = visited.length
  let i = 0
  while i < n do
    if rt_str_eq(visited[i], key) then
      return true
    end
    let i = i + 1
  end
  return false
end

make a function called logic_state_remove takes state, fact returns out
  let n = state.length
  let out = rt_list_new(0)
  let i = 0
  while i < n do
    if not logic_fact_eq(state[i], fact) then
      let out = rt_list_push(out, state[i])
    end
    let i = i + 1
  end
  return out
end

# Real bug found via a Stage 2 regression test (GitHub #27): rt_list_
# push mutates in place when capacity allows, and multiple sibling
# actions considered at the SAME search node all start from the SAME
# "state" reference -- mutating it in place here let one action's
# added fact leak into a SIBLING action's own, supposedly-independent
# precondition check at that same node (confirmed exactly: a 2-fact
# extra state caused "link" to wrongly appear satisfied immediately
# after "compile_b", because "compile_a"'s own state-add call, tried
# moments earlier at the SAME node, had mutated the shared buffer
# in place). Same class of hazard as logic_subst_extend/
# logic_path_extend above; always copies fresh instead.
make a function called logic_state_add takes state, fact returns out
  if logic_state_contains(state, fact) then
    return state
  end
  let n = state.length
  let out = rt_list_new(n + 1)
  let i = 0
  while i < n do
    rt_list_set(out, i, state[i])
    let i = i + 1
  end
  rt_list_set(out, n, fact)
  return out
end

make a function called logic_apply_effects takes state, effects, subst, is_add returns out
  let n = effects.length
  let cur = state
  let i = 0
  while i < n do
    let eff = effects[i]
    let grounded = [eff[0], apply_subst(eff[1], subst)]
    if is_add then
      let cur = logic_state_add(cur, grounded)
    else
      let cur = logic_state_remove(cur, grounded)
    end
    let i = i + 1
  end
  return cur
end

make a function called logic_state_satisfies_goal takes state, goal_facts returns yes
  let n = goal_facts.length
  let i = 0
  while i < n do
    if not logic_state_contains(state, goal_facts[i]) then
      return false
    end
    let i = i + 1
  end
  return true
end

# plan(goal_facts_list) -> List of action names/labels in execution
# order, or an empty List if no plan is found within NODE_CAP.
# Uniform-cost (Dijkstra) search: see this section's own header for
# the linear-scan frontier/visited substitutions used in place of a
# real heap/hashset.
make a function called plan_facts takes goal_facts returns path
  let actions = logic_actions_list()
  let start_state = current_ground_facts_as_state()
  let frontier = [[0, start_state, []]]
  let visited = rt_list_new(0)
  let node_cap = 5000
  let expansions = 0
  while frontier.length > 0 do
    if expansions >= node_cap then
      return []
    end
    let popped = logic_frontier_pop_min(frontier)
    let node = popped[0]
    let frontier = popped[1]
    let cost = node[0]
    let state = node[1]
    let path = node[2]
    let expansions = expansions + 1
    if logic_state_satisfies_goal(state, goal_facts) then
      return path
    end
    let key = logic_state_canonical(state)
    if not logic_visited_contains(visited, key) then
      let visited = rt_list_push(visited, key)
      let an = actions.length
      let ai = 0
      while ai < an do
        let action = actions[ai]
        let aname = action[0]
        let preconds = action[1]
        let add_eff = action[2]
        let del_eff = action[3]
        let acost = action[4]
        let insts = ground_action_instances(preconds, state)
        let ii = 0
        let in_n = insts.length
        while ii < in_n do
          let subst = insts[ii]
          let new_state = logic_apply_effects(state, del_eff, subst, false)
          let new_state = logic_apply_effects(new_state, add_eff, subst, true)
          let label = action_instance_label(aname, preconds, subst)
          let new_path = logic_path_extend(path, label)
          let new_cost = cost + acost
          let frontier = rt_list_push(frontier, [new_cost, new_state, new_path])
          let ii = ii + 1
        end
        let ai = ai + 1
      end
    end
  end
  return []
end

make a function called plan takes goal_facts returns path
  return plan_facts(goal_facts)
end

# =============================================================================
# goal/pursue/activate extension + design-by-contract (continuing the
# interp.patlang-compilation roadmap past #26/#27): action_bind/
# action_lookup (bind a real closure to an action name, looked up again
# when a plan step for that action is `activate`d) and action_base_name/
# action_label_args (split a plan-step label like "build(X=house,Y=2)"
# back into its base name and bound-value list -- exactly the reverse
# of action_instance_label above, so the two round-trip), plus
# contract_check (require/ensure/assert enforcement).
# Ground truth: rust-runtime/src/ir/hosts.rs lines ~1202-1248, ~2356-2380.
# =============================================================================

make a function called logic_action_bodies_list returns l
  let addr = mem_action_bodies_table_addr()
  let l = mem_peek_qword(addr, 0)
  if l == 0 then
    let l = rt_list_new(0)
    mem_poke_qword(addr, 0, l)
  end
  return l
end

make a function called logic_action_bodies_list_set takes l returns done
  mem_poke_qword(mem_action_bodies_table_addr(), 0, l)
  return true
end

# action_bind(name, closure) -> Unit. A single global sequential store
# (not a divergent-branches/backtracking context like Subst/state
# above), so mutate-in-place via rt_list_set (for a replace) or
# rt_list_push (for a fresh append) is safe here -- there is only ever
# one canonical binding table, never multiple independent extensions
# of a shared starting point.
make a function called action_bind takes name, closure returns done
  let bodies = logic_action_bodies_list()
  let n = bodies.length
  let i = 0
  let found = false
  while i < n do
    if rt_str_eq(bodies[i][0], name) then
      rt_list_set(bodies, i, [name, closure])
      let found = true
    end
    let i = i + 1
  end
  if not found then
    let bodies = rt_list_push(bodies, [name, closure])
    logic_action_bodies_list_set(bodies)
  end
  return true
end

# action_lookup(name) -> the bound closure, or a fatal runtime trap if
# none was ever bound -- matches the real host's own fatal Err here
# (PatLang has no try/catch for either backend to recover via anyway).
# Distinctive exit code 99, same documented-trap convention as the
# dynamic-mode % trap (97) and contract_check's own trap (98) below.
make a function called action_lookup takes name returns closure
  let bodies = logic_action_bodies_list()
  let n = bodies.length
  let i = 0
  while i < n do
    if rt_str_eq(bodies[i][0], name) then
      return bodies[i][1]
    end
    let i = i + 1
  end
  print("activate: no action bound to '" + name + "' (call action_bind(\"" + name + "\", ...) first)")
  os_exit(99)
  return 0
end

make a function called logic_str_index_of takes s, ch returns idx
  let n = s.length
  let i = 0
  while i < n do
    if substr(s, i, 1) == ch then
      return i
    end
    let i = i + 1
  end
  return 0 - 1
end

# Splits a plan-step label back into [base_name, bound_values_list] --
# the exact reverse of action_instance_label above ("build" -> ("build",
# []), "build(X=house,Y=2)" -> ("build", ["house","2"])), so the two
# round-trip. Assumes the label was genuinely produced by
# action_instance_label (always well-formed: an open paren, if any, is
# always eventually closed by the label's own final character).
make a function called logic_split_action_label takes label returns result
  let open_i = logic_str_index_of(label, "(")
  if open_i < 0 then
    return [label, []]
  end
  let name = substr(label, 0, open_i)
  let inner_len = label.length - open_i - 2
  if inner_len <= 0 then
    return [name, []]
  end
  let inner = substr(label, open_i + 1, inner_len)
  let vals = []
  let start = 0
  let n = inner.length
  let i = 0
  while i <= n do
    if (i == n) or (substr(inner, i, 1) == ",") then
      let part = substr(inner, start, i - start)
      let eq_i = logic_str_index_of(part, "=")
      if eq_i >= 0 then
        let vals = rt_list_push(vals, substr(part, eq_i + 1, part.length - eq_i - 1))
      else
        let vals = rt_list_push(vals, part)
      end
      let start = i + 1
    end
    let i = i + 1
  end
  return [name, vals]
end

make a function called action_base_name takes label returns name
  let r = logic_split_action_label(label)
  return r[0]
end

make a function called action_label_args takes label returns vals
  let r = logic_split_action_label(label)
  return r[1]
end

# contract_check(func, kind, text, ok) -- require/ensure/assert
# enforcement, the shared design-by-contract primitive. A successful
# check becomes an ordinary derivable fact (reuses #26's own rule_add
# infrastructure directly, exactly matching the real host's own
# "record as a ground fact" behavior) so contracts compose with the
# logic engine/GOAP planner, not just a pass/fail side effect. A
# failing check is fatal -- distinctive exit code 98, same trap
# convention as action_lookup's miss case above.
make a function called contract_check takes func, kind, text, ok returns done
  if ok then
    let combined = kind + ":" + text
    rule_add("contract_holds", [func, combined], [])
    return true
  end
  let label = "assertion"
  if kind == "require" then
    let label = "precondition"
  else
    if kind == "ensure" then
      let label = "postcondition"
    end
  end
  print("contract violation: " + label + " failed in " + func + "(): " + text)
  os_exit(98)
  return false
end

# Stage A of the interp.patlang-compilation roadmap (#25, past #26/#27):
# process lifecycle. g_procs_table stores [pid, handle] pairs (same
# assoc-list-over-a-persistent-.bss-slot pattern as
# logic_action_bodies_list above) so is_alive/wait/kill can recover the
# real Win32 HANDLE later from just the pid the caller was given by
# spawn(). spawn() itself is a CallHost primitive (x64_spawn_asm/
# x64_os_spawn_run_asm in codegen_x64.patlang) that calls
# procs_table_add directly from generated asm and returns just the pid,
# matching the real host's spawn() semantics.
make a function called logic_procs_list returns l
  let addr = mem_procs_table_addr()
  let l = mem_peek_qword(addr, 0)
  if l == 0 then
    let l = rt_list_new(0)
    mem_poke_qword(addr, 0, l)
  end
  return l
end

make a function called logic_procs_list_set takes l returns done
  mem_poke_qword(mem_procs_table_addr(), 0, l)
  return true
end

make a function called procs_table_add takes pid, handle returns done
  let procs = logic_procs_list()
  let procs = rt_list_push(procs, [pid, handle])
  logic_procs_list_set(procs)
  return true
end

make a function called procs_table_lookup takes pid returns handle
  let procs = logic_procs_list()
  let n = procs.length
  let i = 0
  while i < n do
    if procs[i][0] == pid then
      return procs[i][1]
    end
    let i = i + 1
  end
  return 0 - 1
end

make a function called procs_table_remove takes pid returns done
  let procs = logic_procs_list()
  let n = procs.length
  let out = []
  let i = 0
  while i < n do
    if not (procs[i][0] == pid) then
      let out = rt_list_push(out, procs[i])
    end
    let i = i + 1
  end
  logic_procs_list_set(out)
  return true
end

make a function called is_alive takes pid returns result
  let handle = procs_table_lookup(pid)
  if handle == 0 - 1 then
    return false
  end
  let code = os_get_exit_code_process(handle)
  return code == 259
end

make a function called wait takes pid returns code
  let handle = procs_table_lookup(pid)
  if handle == 0 - 1 then
    return 0 - 1
  end
  os_wait_for_single_object(handle)
  let code = os_get_exit_code_process(handle)
  os_close_handle(handle)
  procs_table_remove(pid)
  return code
end

make a function called kill takes pid returns result
  let handle = procs_table_lookup(pid)
  if handle == 0 - 1 then
    return true
  end
  os_terminate_process(handle)
  os_close_handle(handle)
  procs_table_remove(pid)
  return true
end

make a function called sleep_ms takes ms returns done
  os_sleep_ms(ms)
  return true
end

# Stage B, part 1 of the interp.patlang-compilation roadmap (#25): real
# TCP networking. g_listeners_table stores [port, socket] pairs,
# g_conns_table stores [conn_id, socket] pairs (conn_id assigned from
# an incrementing counter, same set_var/get global-counter idiom as
# logic_next_rename_id above) -- same assoc-list-over-a-persistent-
# .bss-slot pattern as logic_procs_list. Exit code 96 is this stage's
# distinctive fatal-runtime-trap code (see 97/98/99's own precedent
# from dynamic-mode `%`/contract_check/action_lookup).
make a function called logic_listeners_list returns l
  let addr = mem_listeners_table_addr()
  let l = mem_peek_qword(addr, 0)
  if l == 0 then
    let l = rt_list_new(0)
    mem_poke_qword(addr, 0, l)
  end
  return l
end

make a function called logic_listeners_list_set takes l returns done
  mem_poke_qword(mem_listeners_table_addr(), 0, l)
  return true
end

make a function called listeners_table_add takes port, sock returns done
  let listeners = logic_listeners_list()
  let listeners = rt_list_push(listeners, [port, sock])
  logic_listeners_list_set(listeners)
  return true
end

make a function called listeners_table_lookup takes port returns sock
  let listeners = logic_listeners_list()
  let n = listeners.length
  let i = 0
  while i < n do
    if listeners[i][0] == port then
      return listeners[i][1]
    end
    let i = i + 1
  end
  return 0 - 1
end

make a function called logic_conns_list returns l
  let addr = mem_conns_table_addr()
  let l = mem_peek_qword(addr, 0)
  if l == 0 then
    let l = rt_list_new(0)
    mem_poke_qword(addr, 0, l)
  end
  return l
end

make a function called logic_conns_list_set takes l returns done
  mem_poke_qword(mem_conns_table_addr(), 0, l)
  return true
end

make a function called logic_next_conn_id returns id
  let cur = to_num(get("__vars", "__tcp_conn_ctr"))
  let next = cur + 1
  set_var("__tcp_conn_ctr", next)
  return next
end

make a function called conns_table_add takes sock returns id
  let id = logic_next_conn_id()
  let conns = logic_conns_list()
  let conns = rt_list_push(conns, [id, sock])
  logic_conns_list_set(conns)
  return id
end

make a function called conns_table_lookup takes conn returns sock
  let conns = logic_conns_list()
  let n = conns.length
  let i = 0
  while i < n do
    if conns[i][0] == conn then
      return conns[i][1]
    end
    let i = i + 1
  end
  return 0 - 1
end

make a function called conns_table_remove takes conn returns done
  let conns = logic_conns_list()
  let n = conns.length
  let out = []
  let i = 0
  while i < n do
    if not (conns[i][0] == conn) then
      let out = rt_list_push(out, conns[i])
    end
    let i = i + 1
  end
  logic_conns_list_set(out)
  return true
end

make a function called tcp_listen takes port returns actual
  os_wsa_startup()
  let sock = os_socket_tcp()
  let actual = os_bind_listen(sock, port)
  if actual == 0 - 1 then
    print("tcp_listen: bind " + port + ": address already in use")
    os_exit(96)
  end
  if actual == 0 - 2 then
    print("tcp_listen: bind " + port + ": failed")
    os_exit(96)
  end
  listeners_table_add(actual, sock)
  return actual
end

make a function called tcp_try_listen takes port returns actual
  os_wsa_startup()
  let sock = os_socket_tcp()
  let actual = os_bind_listen(sock, port)
  if actual == 0 - 1 then
    os_closesocket(sock)
    return 0 - 1
  end
  if actual == 0 - 2 then
    print("tcp_try_listen: bind " + port + ": failed")
    os_exit(96)
  end
  listeners_table_add(actual, sock)
  return actual
end

make a function called tcp_connect takes host, port returns id
  os_wsa_startup()
  let sock = os_connect(host, port)
  if sock == 0 - 1 then
    print("tcp_connect: " + host + ":" + port + ": failed")
    os_exit(96)
  end
  let id = conns_table_add(sock)
  return id
end

make a function called tcp_accept takes port returns id
  let sock = listeners_table_lookup(port)
  if sock == 0 - 1 then
    print("tcp_accept: no listener on port " + port)
    os_exit(96)
  end
  let newsock = os_accept(sock)
  let id = conns_table_add(newsock)
  return id
end

make a function called tcp_read takes conn returns data
  let sock = conns_table_lookup(conn)
  let data = os_recv(sock)
  if os_recv_had_error() then
    print("tcp_read: connection " + conn + ": recv failed")
    os_exit(96)
  end
  return data
end

make a function called tcp_read_or_empty takes conn returns data
  let sock = conns_table_lookup(conn)
  let data = os_recv(sock)
  return data
end

make a function called tcp_write takes conn, data returns result
  let sock = conns_table_lookup(conn)
  os_send(sock, data)
  return true
end

make a function called tcp_close takes conn returns done
  let sock = conns_table_lookup(conn)
  os_closesocket(sock)
  conns_table_remove(conn)
  return true
end

# Stage B, part 2 of the interp.patlang-compilation roadmap (#25):
# tcp_accept_timeout, the non-blocking poll variant used by PatLang
# event loops. Sets the listener socket non-blocking once, then polls
# accept() in a loop against a real wall-clock deadline (GetTickCount64
# via os_get_tick_count) -- mirrors host_tcp_accept_timeout's own
# set_nonblocking + retry-until-deadline loop.
make a function called tcp_accept_timeout takes port, ms returns id
  let sock = listeners_table_lookup(port)
  if sock == 0 - 1 then
    print("tcp_accept_timeout: no listener on port " + port)
    os_exit(96)
  end
  os_set_nonblocking(sock)
  let deadline = os_get_tick_count() + ms
  let result = 0 - 1
  let done = false
  while not done do
    let newsock = os_accept_nonblocking(sock)
    if newsock == 0 - 1 then
      if os_get_tick_count() >= deadline then
        let done = true
      else
        sleep_ms(2)
      end
    else
      let result = conns_table_add(newsock)
      let done = true
    end
  end
  return result
end

# VFS layer (interp.patlang-compilation roadmap #25, continuing past
# the math library/bitfield ops): purely an in-memory [path, contents]
# assoc list, same pattern as every other table above -- the real host
# (rust-runtime/src/ir/hosts.rs) is ALSO just a process-local HashMap,
# no actual disk I/O except vfs_flush_to_disk's own explicit write-
# through, so this needs no new raw asm primitives at all beyond the
# existing write_file. Exit code 95 is this layer's distinctive fatal-
# runtime-trap code (see 96/97/98/99's own precedent).
make a function called logic_vfs_list returns l
  let addr = mem_vfs_table_addr()
  let l = mem_peek_qword(addr, 0)
  if l == 0 then
    let l = rt_list_new(0)
    mem_poke_qword(addr, 0, l)
  end
  return l
end

make a function called logic_vfs_list_set takes l returns done
  mem_poke_qword(mem_vfs_table_addr(), 0, l)
  return true
end

make a function called vfs_table_lookup takes path returns contents
  let entries = logic_vfs_list()
  let n = entries.length
  let i = 0
  while i < n do
    if rt_str_eq(entries[i][0], path) then
      return entries[i][1]
    end
    let i = i + 1
  end
  return 0 - 1
end

make a function called vfs_table_set takes path, contents returns done
  let entries = logic_vfs_list()
  let n = entries.length
  let i = 0
  let found = false
  while i < n do
    if rt_str_eq(entries[i][0], path) then
      rt_list_set(entries, i, [path, contents])
      let found = true
    end
    let i = i + 1
  end
  if not found then
    let entries = rt_list_push(entries, [path, contents])
    logic_vfs_list_set(entries)
  end
  return true
end

make a function called vfs_table_remove takes path returns existed
  let entries = logic_vfs_list()
  let n = entries.length
  let out = []
  let existed = false
  let i = 0
  while i < n do
    if rt_str_eq(entries[i][0], path) then
      let existed = true
    else
      let out = rt_list_push(out, entries[i])
    end
    let i = i + 1
  end
  logic_vfs_list_set(out)
  return existed
end

make a function called vfs_str_starts_with takes s, prefix returns result
  if prefix.length > s.length then
    return false
  end
  return substr(s, 0, prefix.length) == prefix
end

make a function called vfs_read takes path returns contents
  let contents = vfs_table_lookup(path)
  if contents == 0 - 1 then
    print("vfs_read: not found: " + path)
    os_exit(95)
  end
  return contents
end

make a function called vfs_write takes path, contents returns result
  vfs_table_set(path, contents)
  return true
end

make a function called vfs_append takes path, text returns result
  let existing = vfs_table_lookup(path)
  if existing == 0 - 1 then
    vfs_table_set(path, text)
  else
    vfs_table_set(path, existing + text)
  end
  return true
end

make a function called vfs_exists takes path returns result
  let contents = vfs_table_lookup(path)
  if contents == 0 - 1 then
    return "0"
  end
  return "1"
end

make a function called vfs_delete takes path returns result
  return vfs_table_remove(path)
end

# vfs_list(prefix) -> sorted List of matching paths. Simple bubble sort
# (this table is never large enough in practice for the O(n^2) cost to
# matter -- matches the real host's `matching.sort()`, which is also
# just a plain lexicographic string sort).
make a function called vfs_list takes prefix returns result
  let entries = logic_vfs_list()
  let n = entries.length
  let matches = []
  let i = 0
  while i < n do
    if vfs_str_starts_with(entries[i][0], prefix) then
      let matches = rt_list_push(matches, entries[i][0])
    end
    let i = i + 1
  end
  let m = matches.length
  let a = 0
  while a < m do
    let b = 0
    while b < m - a - 1 do
      if matches[b] > matches[b + 1] then
        let tmp = matches[b]
        rt_list_set(matches, b, matches[b + 1])
        rt_list_set(matches, b + 1, tmp)
      end
      let b = b + 1
    end
    let a = a + 1
  end
  return matches
end

# vfs_flush_to_disk(prefix, real_dir) -> Int count written. Real
# host's own allowed-root security gate (PATLANG_VFS_ALLOWED_ROOT) is
# NOT replicated here -- a real but scoped-down implementation, matching
# this session's established practice for primitives unlikely to be
# exercised by the compiler-compiling-itself workload.
make a function called vfs_flush_to_disk takes prefix, real_dir returns count
  let matches = vfs_list(prefix)
  let n = matches.length
  let i = 0
  let count = 0
  while i < n do
    let contents = vfs_table_lookup(matches[i])
    write_file(real_dir + "/" + matches[i], contents)
    let count = count + 1
    let i = i + 1
  end
  return count
end

# type_of/numeric_kind: real host reflection over every Value variant
# (rust-runtime/src/ir/hosts.rs). x64_family_code (a raw CallHost
# primitive, see codegen_x64.patlang's own header on it) does the
# family-nibble classification and returns a small int code; these
# ordinary PatLang wrappers map that code to the actual string result
# via real literal Consts, reusing the normal string-literal pipeline
# rather than trying to emit a fresh string constant from raw asm.
#
# Honest, documented gap: this backend has no PER-VALUE tag for
# fixnum-vs-bool-vs-unit-vs-float (float_mode is a per-FUNCTION
# classification here, not a tag -- see this file's own float_mode
# notes throughout) -- family code 0 covers all four, and this always
# reports "int" for it, never "bool"/"unit"/"float". A real but
# scoped-down implementation, not a stub.
make a function called type_of takes v returns result
  let code = x64_family_code(v)
  if code == 2 then
    return "string"
  end
  if code == 3 then
    return "list"
  end
  if code == 4 then
    return "closure"
  end
  if code == 5 then
    return "object"
  end
  if code == 6 then
    return "bigint"
  end
  if code == 7 then
    return "rational"
  end
  if code == 8 then
    return "complex"
  end
  if code == 9 then
    return "interval"
  end
  if code == 11 then
    return "bool"
  end
  if code == 12 then
    return "bool_array"
  end
  if code == 0 then
    return "int"
  end
  return "other"
end

make a function called numeric_kind takes v returns result
  let code = x64_family_code(v)
  if code == 0 then
    return "int"
  end
  if code == 6 then
    return "bigint"
  end
  if code == 7 then
    return "rational"
  end
  if code == 8 then
    return "complex"
  end
  if code == 9 then
    return "interval"
  end
  return "other"
end

# to_fixed(x, places) -- built on the SAME rt_float_decompose used by
# rt_print_float. GitHub #36: previously only extracted 6 fractional
# digits with no rounding at the cutoff; now extracts 15 (rounded via
# rt_round_digits, see rt_float_decompose's own header) and, when
# `places` asks for FEWER than 15, re-rounds down to that shorter
# cutoff via the same rt_round_digits_at helper -- without this,
# `to_fixed(x, 10)` would just truncate the already-rounded 15-digit
# result at 10 rather than rounding it there (e.g.
# `to_fixed(sqrt(2), 10)` gave `...23` instead of the correctly-
# rounded `...24`). `places` beyond 15 still truncates rather than
# genuinely extending precision (this backend's own extraction ceiling).
make a function called to_fixed takes x, places returns result
  let parts = rt_float_decompose(x)
  let neg = parts[0]
  let ipart = parts[1]
  let digits = [parts[2], parts[3], parts[4], parts[5], parts[6], parts[7], parts[8], parts[9], parts[10], parts[11], parts[12], parts[13], parts[14], parts[15], parts[16], parts[17]]
  let p = places
  if p > 16 then
    let p = 16
  end
  if p < 16 then
    let rounded = rt_round_digits_at(digits, p, ipart)
    let ipart = rounded[0]
    let digits = rounded[1]
  end
  let ds = ""
  let i = 0
  while i < p do
    let ds = ds + rt_int_to_str(digits[i])
    let i = i + 1
  end
  let result = ""
  # GitHub #24: same fix as rt_format_float_parts -- `neg` is now
  # Bool-TAGGED (from rt_float_decompose's `v < 0.0`), not a plain 1.
  if neg then
    let result = "-"
  end
  let result = result + rt_int_to_str(ipart)
  if p > 0 then
    let result = result + "." + ds
  end
  return result
end

# hash_string(s) -- lowercase hex FNV-1a 64-bit digest, matching the
# real host's own algorithm (rust-runtime/src/ir/hosts.rs) exactly.
# Pure self-hosted PatLang, no new raw asm primitive needed: hash_string
# has no string LITERAL of its own (uses char_code/substr, not a bare
# "..." Const), so it's a plain non-dynamic, non-float function -- `*`
# there is ordinary `imul` with no overflow check/promotion at all
# (unlike dynamic-mode's BigInt-promoting `*`), which wraps silently
# mod 2^64 exactly like FNV-1a's own algorithm needs.
#
# Real bug found and fixed here: the FNV offset basis
# (0xcbf29ce484222325 = 14695981039346656037 unsigned) written as a
# bare decimal literal gets silently CORRUPTED by BOTH backends' own
# numeric-literal parsing for an integer this large (confirmed
# directly: `print(0 - 3750763034362895579)` prints
# -3750763034362895360 under --ir-run -- the wrong value already,
# precision lost somewhere in literal lexing/parsing for anything
# beyond safe f64-exact-integer range -- and something DIFFERENT and
# also wrong under --x64). A pre-existing, orthogonal lexer/numeric-
# literal limitation, not something to chase here -- sidestepped
# entirely by building the exact 64-bit pattern via 8 individual
# byte-pokes (each a small, safely-representable 0-255 literal) into
# scratch memory instead of ever writing the huge constant directly.
make a function called rt_fnv_offset_basis returns hash
  let addr = mem_scratch_addr()
  mem_poke_byte(addr, 0, 37)
  mem_poke_byte(addr, 1, 35)
  mem_poke_byte(addr, 2, 34)
  mem_poke_byte(addr, 3, 132)
  mem_poke_byte(addr, 4, 228)
  mem_poke_byte(addr, 5, 156)
  mem_poke_byte(addr, 6, 242)
  mem_poke_byte(addr, 7, 203)
  return mem_peek_qword(addr, 0)
end

make a function called hash_string takes s returns result
  let hash = rt_fnv_offset_basis()
  let n = s.length
  let i = 0
  while i < n do
    let b = char_code(s, i)
    let hash = hash bxor b
    let hash = hash * 1099511628211
    let i = i + 1
  end
  return rt_u64_to_hex16(hash)
end

# rt_u64_to_hex16(n) -- 16-char lowercase hex of n's raw 64-bit bit
# pattern, treated as unsigned. Deliberately goes through memory
# (poke the qword, then read it back BYTE BY BYTE via mem_peek_byte)
# rather than shifting+masking the value directly -- this backend's
# `shr` operator is arithmetic (SAR, sign-extending, matching Rust's
# `>>` on i64 -- see bit_get/bit_slice's own header), so a logical
# right-shift needed for hex-digit extraction on a NEGATIVE n isn't
# directly available; byte-level memory reads are unsigned by
# construction (movzx) and sidestep the issue entirely.
make a function called rt_byte_to_hex2 takes b returns s
  let hi = rt_trunc_div(b, 16)
  let lo = b - hi * 16
  return rt_hex_digit(hi) + rt_hex_digit(lo)
end

make a function called rt_hex_digit takes d returns c
  if d < 10 then
    return chr(48 + d)
  end
  return chr(97 + d - 10)
end

make a function called rt_u64_to_hex16 takes n returns s
  let addr = mem_scratch_addr()
  mem_poke_qword(addr, 0, n)
  let s = ""
  let i = 7
  while i >= 0 do
    let b = mem_peek_byte(addr, i)
    let s = s + rt_byte_to_hex2(b)
    let i = i - 1
  end
  return s
end

# =============================================================================
# Primitive-gap fill (GitHub #31 follow-up): touch_file/list_dir/
# rename_file/copy_file/now_ms/fact/query/goal/goal_def/pursue --
# surfaced as "codegen_x64: unsupported primitive" warnings when the
# self-hosting-fixpoint compile (patc1.exe recompiling the WHOLE
# self-hosted-compiler bundle, including its own caching feature's
# ObjCache.store, via --x64) was finally reached without crashing for
# the first time. Deliberately implemented here as ORDINARY shadowing
# PatLang functions (matching this file's own established sb_new/
# sb_push/chr convention -- "no new hand-assembled asm needed for any
# of these") rather than new native CallHost cases, wherever an
# existing supported primitive (exec_capture, os_get_tick_count,
# rule_add/solve/plan) already covers the real work.
#
# read_line and rustc_build*/rustc_build_chunked_texts remain
# UNSUPPORTED after this batch -- read_line needs genuine new stdin-
# read asm (no shortcut via an existing primitive), and rustc_build*
# invokes the rustc-text backend, which the x64 pipeline itself never
# needs to call for its own operation. Named, deliberate scope limit
# for this batch, not an oversight.

# copy_file(from, to) -> "OK <to>"/"ERR: <msg>", matching hosts.rs's
# host_copy_file contract closely enough for this backend's own actual
# callers (ObjCache.store just checks the return isn't an error
# prefix). Not a fully faithful mirror (no canonicalized absolute path
# in the OK message, "to" as given instead), a named simplification.
#
# Real bug found and fixed here: an EARLIER version of this function
# shelled out to cmd.exe's `copy` builtin via exec_capture -- broke in
# two separate, confirmed ways: (1) exec_capture's rt_exec_join_args
# quotes EVERY arg unconditionally (including "cmd.exe" itself), and
# cmd.exe's own /c switch has a documented quoting quirk that garbles
# multiple separately-quoted tokens (confirmed: `cmd /c "copy" "/Y"
# "a.txt" "b.txt"` prints `'"copy"' is not recognized`); (2) even after
# combining the whole sub-command into ONE joined string (the standard
# workaround for that quirk), a SEPARATE, pre-existing exec_capture
# output-buffer issue surfaced (confirmed: a 2-token `cmd /c echo hi`
# via separate args works, but combining tokens or going through `dir`
# produced garbled/truncated captured output) -- not this session's
# bug to chase down further, just avoided entirely by using a genuine
# WinAPI call (os_copy_file, CopyFileA under the hood) instead of a
# shell round-trip.
make a function called copy_file takes from, to returns result
  let from_addr = from band rt_payload_mask()
  let from_len = mem_peek_qword(from_addr, 0)
  let to_addr = to band rt_payload_mask()
  let to_len = mem_peek_qword(to_addr, 0)
  let ok = os_copy_file(from_addr + 8, from_len, to_addr + 8, to_len)
  if ok == 0 then
    return "ERR: CopyFileA failed for " + from + " -> " + to
  end
  return "OK " + to
end

# touch_file(path) -> "OK <path>"/"ERR: <msg>" -- creates an empty file
# (truncating an existing one, matching hosts.rs's own
# OpenOptions::create+write+truncate semantics) via the already-
# supported write_file, not new asm.
make a function called touch_file takes path returns result
  write_file(path, "")
  if file_exists(path) == "1" then
    return "OK " + path
  end
  return "ERR: touch_file failed for " + path
end

# rename_file(from, to) -> Bool, matching hosts.rs's own Bool return
# (unlike copy_file/touch_file's "OK"/"ERR:" string convention) via a
# genuine WinAPI call (os_rename_file, MoveFileExA under the hood) --
# see copy_file's own header for why this isn't shelled out to cmd.exe.
make a function called rename_file takes from, to returns ok
  let from_addr = from band rt_payload_mask()
  let from_len = mem_peek_qword(from_addr, 0)
  let to_addr = to band rt_payload_mask()
  let to_len = mem_peek_qword(to_addr, 0)
  let ok = os_rename_file(from_addr + 8, from_len, to_addr + 8, to_len)
  return ok != 0
end

# list_dir(path) -> List of entry names, directories suffixed "/" --
# matches hosts.rs's own host_list_dir contract. An earlier attempt
# shelled out to cmd.exe's `dir /b` via exec_capture and was reverted
# after hitting a separate, pre-existing exec_capture output-buffer
# issue (confirmed directly: a 2-token `cmd /c echo hi` via separate
# args returns clean output, but going through `dir` produced visibly
# garbled/truncated captured text) unrelated to the cmd.exe quoting
# quirk copy_file/rename_file ran into. This version uses genuine
# WinAPI (os_find_first/os_find_next/os_find_data_name/
# os_find_data_is_dir/os_find_close, all in codegen_x64.patlang)
# instead, sidestepping the shell entirely -- same fix shape as
# copy_file/rename_file above. "." and ".." are skipped, matching
# readdir/std::fs::read_dir's own convention (neither one appears in
# hosts.rs's own host_list_dir output either).
make a function called list_dir takes path returns entries
  let addr = path band rt_payload_mask()
  let path_len = mem_peek_qword(addr, 0)
  let handle = os_find_first(addr + 8, path_len)
  let entries = []
  if handle == 0 - 1 then
    return entries
  end
  let has_more = 1
  while has_more == 1 do
    let name = os_find_data_name()
    if (not rt_str_eq(name, ".")) and (not rt_str_eq(name, "..")) then
      if os_find_data_is_dir() == 1 then
        let entries = list_push(entries, name + "/")
      else
        let entries = list_push(entries, name)
      end
    end
    let has_more = os_find_next(handle)
  end
  os_find_close(handle)
  return entries
end

# now_ms() -> ms since system boot (os_get_tick_count is an already-
# supported native primitive, GetTickCount64 under the hood) --
# "monotonic-enough for self-timing" per hosts.rs::host_now_ms's own
# header, even though it isn't true Unix-epoch time (a named, honest
# gap, not a silent one).
make a function called now_ms returns ms
  return os_get_tick_count()
end

# read_line() -> String, one line from stdin (see os_read_line's own
# header in codegen_x64.patlang for the real ReadFile-loop logic).
make a function called read_line returns line
  return os_read_line()
end

# fact/query/goal -- the legacy flat 2-arg fact-store trio (superseded
# by, but still a documented part of the public API alongside,
# rule_add/solve's real backward-chaining engine -- see hosts.rs's own
# "A1: real backward-chaining resolution... what the flat fact/query/
# goal trio above never provided" comment). Implemented here by
# reusing rule_add/solve directly (a ground fact IS a rule with an
# empty body, the same Prolog trick hosts.rs's own comment names) --
# no separate storage table needed.
make a function called fact takes pred, a, b returns done
  rule_add(pred, [a, b], [])
  return true
end

make a function called query takes pred, a, ignored_wildcard returns count
  # "Q" (not "__Q") -- is_logic_var's own convention (hosts.rs/
  # x64_runtime.patlang's solve engine) is "starts with an uppercase
  # letter"; "__Q" starts with "_" and was therefore treated as a
  # GROUND constant, not a variable, so this silently searched for
  # literal matches on "__Q" and always returned 0. Real bug found via
  # a direct RED check (fact/query round-trip printed 0 instead of the
  # expected count) before this was ever assumed correct.
  let solutions = solve(pred, [a, "Q"])
  return solutions.length
end

# goal(pred, items...) -- the legacy pending-goal recorder. Confirmed
# (grepped hosts.rs's own GOALS thread-local) that NOTHING ever reads
# GOALS back -- host_goal only pushes into it, and the only other
# reference clears it on a full facts/goals reset. A genuinely
# unread bookkeeping call, so a faithful mirror is simply a no-op that
# returns done, matching every OBSERVABLE behavior of the real host
# function exactly.
make a function called goal takes pred returns done
  return true
end

# goal_def(name, deps) -> stores a named goal's dependency ground-fact
# list (deps: [[pred,[args...]], ...], same shape a RuleDecl body
# already builds) for pursue(name) to look up later. g_goal_defs_table:
# assoc list, goal name -> deps -- same single-persistent-rt_list
# pattern as g_classes_table (class_def_register's own header above).
make a function called goal_def takes name, deps returns done
  let table = mem_peek_qword(mem_goal_defs_table_addr(), 0)
  if table == 0 then
    let table = rt_list_new(0)
  end
  let n = rt_list_len(table)
  let i = 0
  while i < n do
    if rt_str_eq(rt_list_get(rt_list_get(table, i), 0), name) then
      let entry = rt_list_get(table, i)
      rt_list_set(entry, 1, deps)
      mem_poke_qword(mem_goal_defs_table_addr(), 0, table)
      return true
    end
    let i = i + 1
  end
  let entry = rt_list_new(2)
  rt_list_set(entry, 0, name)
  rt_list_set(entry, 1, deps)
  let table = rt_list_push(table, entry)
  mem_poke_qword(mem_goal_defs_table_addr(), 0, table)
  return true
end

# pursue(name) -> List of action-name labels in execution order for a
# goal previously declared via goal_def -- looks up the stored deps and
# hands off to the already-ported plan_facts (via `plan`), same as
# hosts.rs's own host_pursue. An unknown name returns an empty plan
# (a named simplification versus the real host's hard error -- this
# backend's own established convention throughout is to return an
# empty/zero fallback rather than raise where a hard error isn't
# already plumbed through, e.g. class_def_lookup's own unregistered-
# class fallback just above).
make a function called pursue takes name returns steps
  let table = mem_peek_qword(mem_goal_defs_table_addr(), 0)
  if table == 0 then
    return []
  end
  let n = rt_list_len(table)
  let i = 0
  while i < n do
    if rt_str_eq(rt_list_get(rt_list_get(table, i), 0), name) then
      let deps = rt_list_get(rt_list_get(table, i), 1)
      return plan(deps)
    end
    let i = i + 1
  end
  return []
end
