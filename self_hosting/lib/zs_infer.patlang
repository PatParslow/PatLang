# =============================================================================
# zs_infer: infer a declared-schema skeleton from an existing Gherkin feature
# -- the reverse direction of zs_generate.patlang (schema -> Gherkin).
#
# What is genuinely inferable from Gherkin text alone, and what is not, is
# the whole design constraint here:
#
#   - A QUOTED span, or a bare number, that appears in a Given/When/Then line
#     is a real, mechanical signal that the value varies -- generalise it to
#     a `{pN}` placeholder and capture it. This is not a guess: it is the
#     same quoting convention every hand-written feature in this codebase
#     already follows (a fact/then/do template only ever generalises a
#     quoted span or a number), so reading it back out is just reversing an
#     encoding, not inventing one.
#   - Plain unquoted word variation is NOT a usable signal and is left as
#     fixed literal text. Two scenarios that say "cookie is in stock" and
#     "chips are in stock" do not obviously share a template -- a human has
#     to decide that. This is a real, documented limitation, not an
#     oversight.
#   - WHAT a phrase asserts about the schema's state is not inferable at
#     all: nothing in Gherkin text names a state model. The skeleton's
#     `require`/`ensure` clauses are therefore honest placeholders
#     (`require true` / `ensure true`) -- vacuously true, so the skeleton is
#     valid, loadable PatLang the moment it is written, but asserting
#     nothing until a person fills them in. Presenting a guessed clause as
#     if it were checked would misrepresent what was actually derived.
#
# Phase 2 (zi_suggest_requires) goes one step further, but only for a schema
# whose facts a person has already filled in with real meaning: it proposes
# ALREADY-DECLARED facts as candidate `require` clauses, by checking which
# facts hold in every state a person has classed "accepted" and fail in at
# least one classed "rejected". Picking which states are relevant to a given
# operation -- the ones reached immediately before it runs, across a set of
# accepted and rejected scenarios -- is the caller's job (zs_feature.patlang
# already computes exactly these states while checking a feature); this
# function only does the induction once that selection has been made. This
# is deliberately not open-ended expression synthesis -- it reuses
# vocabulary the person already wrote, and every suggestion is returned as a
# hypothesis for confirmation, never asserted as a checked fact.
#
# Phase 3 (zi_infer_skeleton_with_state, zi_match_require, zi_match_ensure)
# recognises a small, closed table of quantity/arithmetic PHRASINGS ("contains
# at least N X", "is decreased by N") that, unlike free prose, do have one
# fixed formal meaning -- and only ever emits a clause when the phrase's own
# subject literally names one of the schema's already-declared state
# variables. A feature written this precisely has largely already written
# the clause in English, so this is closer to compiling a small controlled
# vocabulary than to reading arbitrary BDD; the value is real but
# conditional on that discipline, not a general upgrade to Phase 1.
#
# zi_infer_state_vars/zi_infer_skeleton_auto read that same closed table one
# more way: for the variable NAME a require/ensure-shaped phrase names,
# whether or not any schema has declared it yet. This removes the need to
# already know the state variable names by hand -- zi_infer_skeleton_auto
# takes only feature text -- but proposes a variable only when a phrase in
# the table actually names it, never from an ordinary noun like the item or
# the actor. A feature with no such phrase gets exactly Phase 1's plain,
# state-free output back.
#
# A Given/Then line can itself say "X and Y", not just spread X and Y
# across separate Gherkin And-steps. zi_split_and_clauses tries each
# top-level "and"-joined side independently, so a compound line contributes
# every recognised clause, not only the first (or, before this was bounded,
# a corrupted one -- an unbounded item capture used to read past "and"/"or"
# into the rest of the sentence). "or" is deliberately never split the same
# way: two separately-required clauses would demand BOTH sides, turning a
# genuine disjunction into a stronger, wrong precondition.
# =============================================================================

include "zs_feature.patlang"

# ---- capture inference: the encoding zi_templatize reverses ----

make a function called zi_is_digit takes c returns r
  return (c >= 48) and (c <= 57)
end

make a function called zi_is_alnum takes c returns r
  return zi_is_digit(c) or ((c >= 65) and (c <= 90)) or ((c >= 97) and (c <= 122))
end

# Generalises a Given/When/Then line into a {pN} template plus the ordered
# list of what each placeholder captured (as text). A quoted span always
# becomes a placeholder, whatever it contains; an unquoted run of characters
# becomes one only when every character in it is a digit. Everything else
# is copied through as literal text, unchanged.
make a function called zi_templatize takes text returns result
  let h = str_intern(text)
  let n = sc_len(h)
  let out = sb_new()
  let caps = []
  let k = 0
  let i = 0
  while i < n do
    let c = sc_code(h, i)
    if c == 34 then
      let j = i + 1
      while (j < n) and (sc_code(h, j) != 34) do
        let j = j + 1
      end
      let inner = sc_substr(h, i + 1, j - i - 1)
      let k = k + 1
      sb_push(out, "\"{p" + k + "}\"")
      let caps = list_push(caps, inner)
      let i = j + 1
    elif zi_is_alnum(c) then
      let j = i
      while (j < n) and zi_is_alnum(sc_code(h, j)) do
        let j = j + 1
      end
      let word = sc_substr(h, i, j - i)
      if zi_all_digits(word) then
        let k = k + 1
        sb_push(out, "{p" + k + "}")
        let caps = list_push(caps, word)
      else
        sb_push(out, word)
      end
      let i = j
    else
      sb_push(out, sc_char(h, i))
      let i = i + 1
    end
  end
  return [sb_str(out), caps]
end

make a function called zi_all_digits takes s returns r
  let h = str_intern(s)
  let n = sc_len(h)
  if n == 0 then
    return false
  end
  let i = 0
  while i < n do
    if zi_is_digit(sc_code(h, i)) == false then
      return false
    end
    let i = i + 1
  end
  return true
end

# ---- naming: PascalCase("borrow a book") -> "BorrowABook" ----

make a function called zi_pascal_case takes text returns name
  let h = str_intern(text)
  let n = sc_len(h)
  let out = sb_new()
  let at_start = true
  let i = 0
  while i < n do
    let c = sc_code(h, i)
    if zi_is_alnum(c) then
      if at_start then
        sb_push(out, zi_upper_char(c))
        let at_start = false
      else
        sb_push(out, sc_char(h, i))
      end
    else
      let at_start = true
    end
    let i = i + 1
  end
  return sb_str(out)
end

make a function called zi_upper_char takes c returns ch
  if (c >= 97) and (c <= 122) then
    return chr(c - 32)
  end
  return chr(c)
end

make a function called zi_join_comma takes items returns text
  return zi_join_with(items, ", ")
end

make a function called zi_join_with takes items, sep returns text
  let out = sb_new()
  let i = 0
  let n = to_num(list_len(items))
  while i < n do
    if i > 0 then
      sb_push(out, sep)
    end
    sb_push(out, items[i])
    let i = i + 1
  end
  return sb_str(out)
end

# Ordered-unique append: pushes s onto list only when it is not already there.
make a function called zi_add_unique takes list, s returns out
  if ze_names_has(list, s) then
    return list
  end
  return list_push(list, s)
end

# ---- Phase 1: the skeleton ----

# Infers a declared-schema skeleton from a Gherkin feature's text. The
# result is valid PatLang (zs_load accepts it) as soon as it is written --
# it names one operation, keyed off the feature's own "wants to" narrative
# when one is present, and generalises every Given/When/Then line seen
# across every scenario into a deduplicated fact/do/then template. It
# asserts nothing about the schema's state: `require true`/`ensure true`
# are honest placeholders, and the missing state/domain declarations are
# left as TODO comments rather than guessed at.
make a function called zi_infer_skeleton takes feature_text returns text
  return zi_infer_skeleton_with_state(feature_text, [])
end

# ---- Phase 3: real require/ensure clauses from a known, closed vocabulary ----
#
# Phase 1's require/ensure clauses stay the placeholder `true` because free
# English carries no fixed formal meaning -- "the cookie is nice" and "the
# cookie is in stock" are indistinguishable to a parser. But a small set of
# quantity and arithmetic PHRASINGS do have one fixed, unambiguous meaning
# ("contains at least N X", "is decreased by N"), the same way a quoted span
# or a bare number does. zi_match_require/zi_match_ensure recognise exactly
# those phrasings against a CLOSED table, and only ever produce a clause
# when the phrase's own subject or field resolves, by exact name, to one of
# the schema's already-declared state variables -- never against arbitrary
# prose, and never by guessing which variable was meant. A phrase outside
# this table, or one whose subject doesn't literally name a declared state
# variable, is left exactly as Phase 1 leaves it: a vacuous `fact`/`then`
# line, not a fabricated clause.
#
# This still requires state variables to already be declared (Phase 1's own
# TODO), which is a real, worth-stating boundary: a feature written this
# precisely has largely already written the formal clause in English, so
# recognising it is closer to compiling a small controlled vocabulary than
# to reading arbitrary BDD. The value is real for a feature disciplined
# enough to write it, and conditional on that discipline.

make a function called zi_lower_char takes c returns ch
  if (c >= 65) and (c <= 90) then
    return chr(c + 32)
  end
  return chr(c)
end

make a function called zi_lower takes text returns out
  let h = str_intern(text)
  let n = sc_len(h)
  let b = sb_new()
  let i = 0
  while i < n do
    sb_push(b, zi_lower_char(sc_code(h, i)))
    let i = i + 1
  end
  return sb_str(b)
end

# A number spelled as a digit string or one of a small, closed set of number
# words ("a"/"an"/"one" through "ten"); -1 when neither.
make a function called zi_word_to_number takes word returns n
  if zi_all_digits(word) then
    return to_num(word)
  end
  let w = zi_lower(word)
  if (w == "a") or (w == "an") or (w == "one") then
    return 1
  end
  if w == "two" then
    return 2
  end
  if w == "three" then
    return 3
  end
  if w == "four" then
    return 4
  end
  if w == "five" then
    return 5
  end
  if w == "six" then
    return 6
  end
  if w == "seven" then
    return 7
  end
  if w == "eight" then
    return 8
  end
  if w == "nine" then
    return 9
  end
  if w == "ten" then
    return 10
  end
  return -1
end

# The last whitespace-separated token of text, trimmed.
make a function called zi_last_word takes text returns word
  let h = str_intern(zs_trim(text))
  let n = sc_len(h)
  let i = n
  while (i > 0) and (sc_code(h, i - 1) != 32) do
    let i = i - 1
  end
  return sc_substr(h, i, n - i)
end

# [first_word, rest] of text, trimmed; rest is "" when text is one word.
make a function called zi_first_word_and_rest takes text returns parts
  let h = str_intern(zs_trim(text))
  let n = sc_len(h)
  let i = 0
  while (i < n) and (sc_code(h, i) != 32) do
    let i = i + 1
  end
  return [sc_substr(h, 0, i), zs_trim(sc_substr(h, i, n - i))]
end

# text up to (not including) the first top-level " and " or " or ",
# whichever comes first; text unchanged when neither appears. Bounds an
# item/field capture so a Given/Then line that goes on to say "... and
# Bowen's balance is at least 10 dollars" doesn't read the rest of the
# sentence as part of the first clause's own value.
make a function called zi_before_conjunction takes text returns before
  let h = str_intern(text)
  let n = sc_len(h)
  let idx_and = sm_find(h, n, " and ", 0)
  let idx_or = sm_find(h, n, " or ", 0)
  let idx = -1
  if (idx_and >= 0) and ((idx_or < 0) or (idx_and < idx_or)) then
    let idx = idx_and
  elif idx_or >= 0 then
    let idx = idx_or
  end
  if idx < 0 then
    return text
  end
  return zs_trim(sc_substr(h, 0, idx))
end

# Splits text on top-level " and " (outside double-quoted spans) into its
# conjuncts, so each can be tried against zi_match_require/zi_match_ensure
# independently -- "X contains at least one cookie and Y is at least 10
# dollars" is two real preconditions, not one. Deliberately never splits on
# " or ": two separately-required clauses would demand BOTH sides, turning
# a genuine disjunction into a strictly stronger, wrong precondition. A
# line with no top-level " and " is returned as the single original text.
make a function called zi_split_and_clauses takes text returns clauses
  let h = str_intern(text)
  let n = sc_len(h)
  let out = []
  let start = 0
  let quoted = false
  let i = 0
  while i < n do
    let c = sc_code(h, i)
    if c == 34 then
      let quoted = quoted == false
    end
    if (quoted == false) and sm_at(h, n, " and ", i) then
      let out = list_push(out, zs_trim(sc_substr(h, start, i - start)))
      let i = i + 5
      let start = i
    else
      let i = i + 1
    end
  end
  let out = list_push(out, zs_trim(sc_substr(h, start, n - start)))
  return out
end

# Structurally recognises a require-shaped Given phrase, independent of
# whether its subject is a declared state variable:
#   "{subject} contains at least|at most|exactly {qty} {item}"
#     -> ["map", subject's own last word, op, qty, item]
#   "{subject}'s {field} is at least|at most|exactly {qty}"
#     -> ["scalar", field, op, qty]
#   ["none"] when nothing in the table matches at all.
# zi_match_require and zi_infer_state_vars are the two consumers: one checks
# the subject against already-declared names before building a clause, the
# other proposes the subject itself as a candidate declaration.
make a function called zi_parse_require_phrase takes text returns parsed
  let h = str_intern(text)
  let n = sc_len(h)
  let map_ops = [[" contains at least ", ">="], [" contains at most ", "<="], [" contains exactly ", "=="]]
  let k = 0
  while k < 3 do
    let phrase = map_ops[k][0]
    let op = map_ops[k][1]
    let idx = sm_find(h, n, phrase, 0)
    if idx >= 0 then
      let subject = zs_trim(sc_substr(h, 0, idx))
      let plen = sc_len(str_intern(phrase))
      let rest = zs_trim(sc_substr(h, idx + plen, n - idx - plen))
      let qr = zi_first_word_and_rest(rest)
      let qty = zi_word_to_number(qr[0])
      let item = zi_before_conjunction(qr[1])
      if (qty >= 0) and (item != "") then
        return ["map", zi_last_word(subject), op, qty, item]
      end
    end
    let k = k + 1
  end
  let idx_apos = sm_find(h, n, "'s ", 0)
  if idx_apos >= 0 then
    let remainder = sc_substr(h, idx_apos + 3, n - idx_apos - 3)
    let rh = str_intern(remainder)
    let rn = sc_len(rh)
    let scalar_ops = [[" is at least ", ">="], [" is at most ", "<="], [" is exactly ", "=="]]
    let j = 0
    while j < 3 do
      let phrase = scalar_ops[j][0]
      let op = scalar_ops[j][1]
      let idxc = sm_find(rh, rn, phrase, 0)
      if idxc >= 0 then
        let field = zs_trim(sc_substr(rh, 0, idxc))
        let plen = sc_len(str_intern(phrase))
        let rest = zs_trim(sc_substr(rh, idxc + plen, rn - idxc - plen))
        let qty = zi_word_to_number(zi_first_word_and_rest(rest)[0])
        if qty >= 0 then
          return ["scalar", field, op, qty]
        end
      end
      let j = j + 1
    end
  end
  return ["none"]
end

# As zi_parse_require_phrase, but only ever returns a hit whose subject
# literally names one of state_names -- never a guessed clause.
make a function called zi_match_require takes text, state_names returns hit
  let p = zi_parse_require_phrase(text)
  if (p[0] == "map") and ze_names_has(state_names, p[1]) then
    return ["hit", "map_get_or(" + p[1] + ", \"" + p[4] + "\", 0) " + p[2] + " " + p[3]]
  end
  if (p[0] == "scalar") and ze_names_has(state_names, p[1]) then
    return ["hit", p[1] + " " + p[2] + " " + p[3]]
  end
  return ["no"]
end

# Structurally recognises an ensure-shaped Then phrase, independent of
# whether its subject is a declared state variable:
#   "{subject} subtracts|adds {qty} {item}"
#     -> ["map", subject's own last word, sign, qty, item]
#   "{subject}'s {field} is decreased by|increased by {qty}"
#     -> ["scalar", field, sign, qty]
#   "{subject}'s {field} becomes {qty}"
#     -> ["scalar", field, "=", qty]
#   ["none"] when nothing in the table matches at all.
make a function called zi_parse_ensure_phrase takes text returns parsed
  let h = str_intern(text)
  let n = sc_len(h)
  let map_ops = [[" subtracts ", "-"], [" adds ", "+"]]
  let k = 0
  while k < 2 do
    let phrase = map_ops[k][0]
    let sign = map_ops[k][1]
    let idx = sm_find(h, n, phrase, 0)
    if idx >= 0 then
      let subject = zs_trim(sc_substr(h, 0, idx))
      let plen = sc_len(str_intern(phrase))
      let rest = zs_trim(sc_substr(h, idx + plen, n - idx - plen))
      let qr = zi_first_word_and_rest(rest)
      let qty = zi_word_to_number(qr[0])
      let item = zi_before_conjunction(qr[1])
      if (qty >= 0) and (item != "") then
        return ["map", zi_last_word(subject), sign, qty, item]
      end
    end
    let k = k + 1
  end
  let idx_apos = sm_find(h, n, "'s ", 0)
  if idx_apos >= 0 then
    let remainder = sc_substr(h, idx_apos + 3, n - idx_apos - 3)
    let rh = str_intern(remainder)
    let rn = sc_len(rh)
    let scalar_ops = [[" is decreased by ", "-"], [" is increased by ", "+"]]
    let j = 0
    while j < 2 do
      let phrase = scalar_ops[j][0]
      let sign = scalar_ops[j][1]
      let idxc = sm_find(rh, rn, phrase, 0)
      if idxc >= 0 then
        let field = zs_trim(sc_substr(rh, 0, idxc))
        let plen = sc_len(str_intern(phrase))
        let rest = zs_trim(sc_substr(rh, idxc + plen, rn - idxc - plen))
        let qty = zi_word_to_number(zi_first_word_and_rest(rest)[0])
        if qty >= 0 then
          return ["scalar", field, sign, qty]
        end
      end
      let j = j + 1
    end
    let idxb = sm_find(rh, rn, " becomes ", 0)
    if idxb >= 0 then
      let field = zs_trim(sc_substr(rh, 0, idxb))
      let plen = sc_len(str_intern(" becomes "))
      let rest = zs_trim(sc_substr(rh, idxb + plen, rn - idxb - plen))
      let qty = zi_word_to_number(zi_first_word_and_rest(rest)[0])
      if qty >= 0 then
        return ["scalar", field, "=", qty]
      end
    end
  end
  return ["none"]
end

# As zi_parse_ensure_phrase, but only ever returns a hit whose subject
# literally names one of state_names -- never a guessed clause.
make a function called zi_match_ensure takes text, state_names returns hit
  let p = zi_parse_ensure_phrase(text)
  if (p[0] == "map") and ze_names_has(state_names, p[1]) then
    return ["hit", p[1] + "' == map_put(" + p[1] + ", \"" + p[4] + "\", map_get(" + p[1] + ", \"" + p[4] + "\") " + p[2] + " " + p[3] + ")"]
  end
  if (p[0] == "scalar") and ze_names_has(state_names, p[1]) then
    if p[2] == "=" then
      return ["hit", p[1] + "' == " + p[3]]
    end
    return ["hit", p[1] + "' == " + p[1] + " " + p[2] + " " + p[3]]
  end
  return ["no"]
end

# The candidate state variable a require- or ensure-shaped phrase names --
# "" when the phrase matches neither table. This is the same closed
# vocabulary zi_match_require/zi_match_ensure read, just read for the
# variable's NAME instead of for a clause: "vending machine inventory
# contains at least one cookie" names a candidate variable ("inventory")
# whether or not any schema has declared it yet, the same way a quoted span
# names a capture whether or not it is ever bound to an operation input.
# Never proposes a name from ordinary prose with no recognised shape.
make a function called zi_candidate_state_var takes text returns name
  let pr = zi_parse_require_phrase(text)
  if pr[0] != "none" then
    return pr[1]
  end
  let pe = zi_parse_ensure_phrase(text)
  if pe[0] != "none" then
    return pe[1]
  end
  return ""
end

# The state variables a feature's own Given/Then phrases name, in the order
# first seen, deduplicated. Built from the same closed table as
# zi_match_require/zi_match_ensure, so a variable is only ever proposed when
# some phrase in the feature actually names it through a recognised
# quantity/arithmetic shape -- never from an arbitrary noun, and never a
# guess at what unrelated words like the item ("cookie") or the actor
# ("Bowen") might mean.
make a function called zi_infer_state_vars takes feature_text returns names
  let scenarios = zf_parse_feature(feature_text)[1]
  let out = []
  let si = 0
  let sn = to_num(list_len(scenarios))
  while si < sn do
    let steps = scenarios[si][1]
    let ti = 0
    let tn = to_num(list_len(steps))
    while ti < tn do
      let phase = steps[ti][0]
      if (phase == "given") or (phase == "then") then
        let clauses = zi_split_and_clauses(steps[ti][1])
        let ci = 0
        let cn = to_num(list_len(clauses))
        while ci < cn do
          let cand = zi_candidate_state_var(clauses[ci])
          if cand != "" then
            let out = zi_add_unique(out, cand)
          end
          let ci = ci + 1
        end
      end
      let ti = ti + 1
    end
    let si = si + 1
  end
  return out
end

# Fully automatic: infers the schema's state variables from the same closed
# phrase table as the require/ensure clauses themselves, then infers the
# skeleton using them. Nothing here is guessed beyond what the table already
# licenses -- a feature with no recognised quantity/arithmetic phrase still
# gets Phase 1's plain, state-free skeleton, exactly as zi_infer_skeleton
# alone would.
make a function called zi_infer_skeleton_auto takes feature_text returns text
  return zi_infer_skeleton_with_state(feature_text, zi_infer_state_vars(feature_text))
end

# As zi_infer_skeleton, but given the target schema's already-declared state
# variable names, also tries every Given phrase against zi_match_require and
# every Then phrase against zi_match_ensure. Where one matches, the real
# clause replaces the `true` placeholder for that half of the operation
# (deduplicated across scenarios); where none matches for a half, that half
# keeps today's honest placeholder and TODO exactly as Phase 1 alone would.
make a function called zi_infer_skeleton_with_state takes feature_text, state_names returns text
  let parsed = zf_parse_feature(feature_text)
  let goal_str = parsed[0]
  let scenarios = parsed[1]

  let op_name = "Op1"
  if goal_str != "" then
    let op_name = zi_pascal_case(goal_str)
  end

  # Every When (and its following And/But lines) in a scenario is one
  # combined action, not several: a real feature routinely spreads one
  # operation's inputs across multiple When/And lines (this project's own
  # examples/zs/vending_machine.feature does exactly this -- "Bowen inserts
  # 10 dollars" / "And Bowen selects cookie"). Templatizing each line
  # separately would infer one `do` line per line instead of one per
  # scenario, each with its own, usually different, capture count -- and
  # since every `do` line for an operation must call it with exactly the
  # arity that operation declares, that produces a skeleton that fails to
  # load. Joining a scenario's When/And lines into one string before
  # templatizing keeps the arity one-per-scenario, matching how the goal's
  # single inferred operation is actually invoked.
  let given_templates = []
  let when_templates = []
  let then_templates = []
  let require_clauses = []
  let ensure_clauses = []
  let si = 0
  let sn = to_num(list_len(scenarios))
  while si < sn do
    let steps = scenarios[si][1]
    let when_parts = []
    let ti = 0
    let tn = to_num(list_len(steps))
    while ti < tn do
      let phase = steps[ti][0]
      if phase == "given" then
        # The fact/then vocabulary layer below still treats the whole line
        # as one phrase, matching how the real checker matches a whole
        # step's text -- only require/ensure inference looks inside it for
        # more than one recognisable clause.
        let tmpl = zi_templatize(steps[ti][1])[0]
        let given_templates = zi_add_unique(given_templates, tmpl)
        let clauses = zi_split_and_clauses(steps[ti][1])
        let ci = 0
        let cn = to_num(list_len(clauses))
        while ci < cn do
          let req = zi_match_require(clauses[ci], state_names)
          if req[0] == "hit" then
            let require_clauses = zi_add_unique(require_clauses, req[1])
          end
          let ci = ci + 1
        end
      elif phase == "when" then
        let when_parts = list_push(when_parts, steps[ti][1])
      else
        let tmpl = zi_templatize(steps[ti][1])[0]
        let then_templates = zi_add_unique(then_templates, tmpl)
        let clauses = zi_split_and_clauses(steps[ti][1])
        let ci = 0
        let cn = to_num(list_len(clauses))
        while ci < cn do
          let ens = zi_match_ensure(clauses[ci], state_names)
          if ens[0] == "hit" then
            let ensure_clauses = zi_add_unique(ensure_clauses, ens[1])
          end
          let ci = ci + 1
        end
      end
      let ti = ti + 1
    end
    if to_num(list_len(when_parts)) > 0 then
      let when_tmpl = zi_templatize(zi_join_with(when_parts, " and "))[0]
      let when_templates = zi_add_unique(when_templates, when_tmpl)
    end
    let si = si + 1
  end

  # The operation's own parameters come from the first distinct combined
  # When template seen -- the canonical action for the single operation
  # this phase infers. A feature whose scenarios genuinely combine a
  # different number of values per scenario for the same goal (rarer, and
  # not exercised by this codebase's own features) still generates its own
  # `do` line per shape, which then needs a person to reconcile the
  # resulting arity mismatch by hand -- an honest remaining limit, not a
  # silent one, since zs_load refuses to load it.
  let op_inputs = []
  if to_num(list_len(when_templates)) > 0 then
    let op_inputs = sm_parse_template(when_templates[0])[1]
  end

  let out = sb_new()
  let schema_name = "InferredSchema"
  if goal_str != "" then
    let schema_name = op_name + "Schema"
  end
  sb_push(out, "schema " + schema_name + "\n")
  if to_num(list_len(state_names)) == 0 then
    sb_push(out, "# TODO: this schema has no state yet -- Gherkin text names no\n")
    sb_push(out, "# state model, so none was guessed at. Add one, e.g.:\n")
    sb_push(out, "#   state someVariable\n")
    sb_push(out, "#   init someVariable = ...\n\n")
  else
    sb_push(out, "state " + zi_join_comma(state_names) + "\n")
    sb_push(out, "# TODO: no phrase in the feature says what these start at.\n")
    sb_push(out, "#   init " + state_names[0] + " = ...\n\n")
  end

  sb_push(out, "operation " + op_name + "(" + zi_join_comma(op_inputs) + ")\n")
  if to_num(list_len(require_clauses)) == 0 then
    sb_push(out, "  # TODO: replace with the real precondition(s) for " + op_name + ".\n")
    sb_push(out, "  require true\n")
  else
    let ri = 0
    let rn = to_num(list_len(require_clauses))
    while ri < rn do
      sb_push(out, "  require " + require_clauses[ri] + "\n")
      let ri = ri + 1
    end
  end
  if to_num(list_len(ensure_clauses)) == 0 then
    sb_push(out, "  # TODO: replace with the real effect(s)/postcondition(s).\n")
    sb_push(out, "  ensure true\n")
  else
    let ei = 0
    let en = to_num(list_len(ensure_clauses))
    while ei < en do
      sb_push(out, "  ensure " + ensure_clauses[ei] + "\n")
      let ei = ei + 1
    end
  end
  sb_push(out, "end\n\n")

  let gi = 0
  let gn = to_num(list_len(given_templates))
  while gi < gn do
    sb_push(out, "fact " + given_templates[gi] + " => true\n")
    let gi = gi + 1
  end
  if gn > 0 then
    sb_push(out, "\n")
  end

  let wi = 0
  let wn = to_num(list_len(when_templates))
  while wi < wn do
    let caps = sm_parse_template(when_templates[wi])[1]
    sb_push(out, "do " + when_templates[wi] + " => " + op_name + "(" + zi_join_comma(caps) + ")\n")
    let wi = wi + 1
  end
  if wn > 0 then
    sb_push(out, "\n")
  end

  let hi = 0
  let hn = to_num(list_len(then_templates))
  while hi < hn do
    sb_push(out, "then " + then_templates[hi] + " => true\n")
    let hi = hi + 1
  end
  if hn > 0 then
    sb_push(out, "\n")
  end

  if goal_str != "" then
    sb_push(out, "goal " + goal_str + " => " + op_name + "\n")
  end

  return sb_str(out)
end

# ---- Phase 2: proposing already-declared facts as candidate requires ----
#
# For a schema entry whose `fact` lines a person has already filled in with
# real meaning, and a feature whose scenarios are marked accepted/rejected
# (an accepted scenario is one whose outcome the schema's own checker
# confirms; a rejected one is a `negative` scenario, or one the checker
# reports as violated), this proposes `require <fact>` for a candidate
# operation: any already-declared fact that holds in the state reached by
# every accepted scenario before that operation runs, and fails to hold
# before at least one rejected one. Each result is a suggestion, carrying
# its own support/counter-example counts, not an assertion -- it must be
# reviewed and confirmed by a person before it is added to the schema, the
# same way any induced hypothesis must be, since a fact merely correlating
# with acceptance is not the same claim as a fact the schema's author
# intended as a precondition.
make a function called zi_suggest_requires takes entry, accepted_envs, rejected_envs returns suggestions
  let facts = entry[7]
  let out = []
  let fi = 0
  let nfacts = to_num(list_len(facts))
  while fi < nfacts do
    let fact_text = facts[fi][0]
    let fact_ast = facts[fi][2]
    let holds_all_accepted = true
    let ai = 0
    let an = to_num(list_len(accepted_envs))
    while ai < an do
      ze_rt_clear()
      let v = ze_eval(fact_ast, accepted_envs[ai])
      if (ze_rt_error() != "") or (v != true) then
        let holds_all_accepted = false
      end
      let ai = ai + 1
    end
    let fails_some_rejected = false
    let counter_examples = 0
    let ri = 0
    let rn = to_num(list_len(rejected_envs))
    while ri < rn do
      ze_rt_clear()
      let v = ze_eval(fact_ast, rejected_envs[ri])
      if (ze_rt_error() != "") or (v != true) then
        let fails_some_rejected = true
        let counter_examples = counter_examples + 1
      end
      let ri = ri + 1
    end
    if holds_all_accepted and (an > 0) and fails_some_rejected then
      let out = list_push(out, [fact_text, an, counter_examples, rn])
    end
    let fi = fi + 1
  end
  return out
end
