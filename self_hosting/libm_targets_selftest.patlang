# Selftest: v2's math functions give the same bits on every target.
#
# Given a program that applies sin, cos, tan, asin, acos, atan, atan2, exp,
# log, pow, % and sqrt to every input in self_hosting/v2/spec/libm_vectors.txt
# and prints each result's bits, when it is built as a native executable and as
# WebAssembly and both are run, then both print the same lines: one math
# library, written in PatLang, serves every target, so a program prints the
# same digits on Windows, Linux and in a browser.

include "lib/includes.patlang"
include "lib/gherkin.patlang"
include "lib/v2_engines.patlang"
include "lib/program_run.patlang"

let ctx = ctx_new()
expect(ctx, "node is on the PATH", has_program("node"), true)

let src = spec_out() + "/libm_targets.patlang"
let prog = "make a function called lt_words takes line returns words
  let words = []
  let b = sb_new()
  let have = false
  let i = 0
  while i < line.length do
    let c = char_code(line, i)
    if c == 32 then
      if have then
        let words = list_push(words, sb_str(b))
        let b = sb_new()
        let have = false
      end
    elif c != 13 then
      sb_push(b, chr(c))
      let have = true
    end
    let i = i + 1
  end
  if have then
    let words = list_push(words, sb_str(b))
  end
  return words
end

make a function called lt_apply takes name, a, b returns r
  if name == \"sin\" then
    return sin(a)
  elif name == \"cos\" then
    return cos(a)
  elif name == \"tan\" then
    return tan(a)
  elif name == \"asin\" then
    return asin(a)
  elif name == \"acos\" then
    return acos(a)
  elif name == \"atan\" then
    return atan(a)
  elif name == \"atan2\" then
    return atan2(a, b)
  elif name == \"exp\" then
    return exp(a)
  elif name == \"log\" then
    return log(a)
  elif name == \"pow\" then
    return pow(a, b)
  elif name == \"fmod\" then
    return a % b
  elif name == \"sqrt\" then
    if a < 0.0 then
      return 0.0
    end
    return sqrt(a)
  end
  return 0.0
end

let text = read_file(argv()[0])
let lines = split_lines(text)
let out = sb_new()
let i = 0
while i < list_len(lines) do
  let w = lt_words(lines[i])
  if (list_len(w) >= 3) and (w[0] != \"#\") then
    let a = float_from_bits(to_num(w[1]))
    let b = 0.0
    if list_len(w) == 4 then
      let b = float_from_bits(to_num(w[2]))
    end
    sb_push(out, w[0] + \" \" + float_bits(lt_apply(w[0], a, b) * 1.0) + chr(10))
  end
  let i = i + 1
end
print(sb_str(out))
"
write_file(src, "include " + chr(34) + path_absolute("self_hosting/lib/includes.patlang") + chr(34) + chr(10) + prog)

let vectors = "self_hosting/v2/spec/libm_vectors.txt"
let exe = spec_out() + "/libm_targets.exe"
let wasm = spec_out() + "/libm_targets.wasm"
let b1 = exec_measured("self_hosting/build/v2.exe", [src, exe])
expect(ctx, "the native build succeeds", b1[2], true)
let b2 = exec_measured("self_hosting/build/v2.exe", [src, wasm, "--wasm"])
expect(ctx, "the WebAssembly build succeeds", b2[2], true)

let native = exec_measured(exe, [vectors])
let web = exec_measured("node", ["self_hosting/v2/wasm/run_node.mjs", "--files", "self_hosting/v2/spec", wasm, vectors])
expect(ctx, "the native run succeeds", native[2], true)
expect(ctx, "the WebAssembly run succeeds", web[2], true)

let nl = split_lines(native[0])
let wl = split_lines(web[0])
expect(ctx, "both print a line for every vector", (list_len(nl) > 6000) and (list_len(nl) == list_len(wl)), true)
let differ = []
let i = 0
while (i < list_len(nl)) and (i < list_len(wl)) do
  if nl[i] != wl[i] then
    let differ = list_push(differ, i)
  end
  let i = i + 1
end
print("  results that differ between native and WebAssembly: " + list_len(differ))
let k = 0
while (k < list_len(differ)) and (k < 10) do
  print("    line " + differ[k] + ": native " + nl[differ[k]] + ", wasm " + wl[differ[k]])
  let k = k + 1
end
expect(ctx, "native and WebAssembly give the same bits for every result", list_len(differ), 0)
ctx_report(ctx)
