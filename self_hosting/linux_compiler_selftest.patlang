# Selftest: the v2 compiler runs on Linux, and builds what it builds on Windows.
#
# Given the compiler built with --linux (a static Linux executable) and a small
# program, when that compiler is run under WSL to build the program, and the
# Windows compiler builds the same program with --linux, then the two files are
# the same bytes, and the program runs on Linux printing what it says. A Linux
# compiler with no target given builds for Linux.

include "lib/includes.patlang"
include "lib/gherkin.patlang"
include "lib/v2_engines.patlang"
include "lib/program_run.patlang"

let ctx = ctx_new()
expect(ctx, "wsl is on the PATH", has_program("wsl"), true)

let dir = spec_out()
let lc = dir + "/v2_linux_compiler"
let built = v2_compile(["self_hosting/v2/compile.patlang", lc, "--linux", "--workers", "4"])
expect(ctx, "the compiler builds for Linux", built[1], true)

let src = dir + "/lc_program.patlang"
write_file(src, "print(" + chr(34) + "built on Linux" + chr(34) + ")" + chr(10) + "print([1, 2.5, 3 / 4])" + chr(10))
let cross = dir + "/lc_program_cross"
let made = v2_compile([src, cross, "--linux", "--no-cache"])
expect(ctx, "the Windows compiler builds the program for Linux", made[1], true)

# the Linux compiler runs from the repository's root, as v2.exe does, with no
# target given: its own system's
let native = dir + "/lc_program_native"
let full = ["-d", "Ubuntu-24.04", "--cd", v2_wsl_path("."), "-e", v2_wsl_path(lc), src, native, "--no-cache"]
let ran = exec_capture_io("wsl", full, "", 0)
expect(ctx, "the Linux compiler runs and succeeds", ran[2], true)
expect(ctx, "both build the same bytes", read_file_bytes(native, 0, 100000000) == read_file_bytes(cross, 0, 100000000), true)
let out = v2_linux_run(native, [])
expect(ctx, "the program runs on Linux", out, ["built on Linux" + chr(10) + "[1, 2.5, 3/4]" + chr(10), true])
ctx_report(ctx)
