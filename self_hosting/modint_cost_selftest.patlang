# Selftest: what a modint modulo 2^k costs, compiled.
#
# Given a compiled program that does a stream cipher's steps (an add, an xor
# and a rotate) n times on 32-bit modints, and the same on ints masked to 32
# bits, when it times both by cpu_cycles (the cheapest of three readings,
# at four iteration counts), then the modints cost at most ten times the ints
# at each count, and both cost about the same per step at every count.
#
# Before modints modulo 2^k were held as words (spec 2.1) the ratio was about
# 850: each operation made and freed a block. The words are an optimisation
# only; vi_modint_word_form checks nothing a program sees has changed.

include "lib/includes.patlang"
include "lib/gherkin.patlang"
include "lib/v2_engines.patlang"
include "lib/program_run.patlang"

make a function called probe_source returns text
  return str_join([
    "make a function called mod_steps takes n returns c",
    "  let a = mod_make(1234567, 4294967296)",
    "  let b = mod_make(7654321, 4294967296)",
    "  let t = cpu_cycles()",
    "  let i = 0",
    "  while i < n do",
    "    let a = a + b",
    "    let b = rotl(b bxor a, 7)",
    "    let i = i + 1",
    "  end",
    "  let c = cpu_cycles() - t",
    "  assert a != b",
    "  return c",
    "end",
    "make a function called int_steps takes n returns c",
    "  let x = 1234567",
    "  let y = 7654321",
    "  let t = cpu_cycles()",
    "  let i = 0",
    "  while i < n do",
    "    let x = (x + y) band 4294967295",
    "    let z = y bxor x",
    "    let y = ((z shl 7) band 4294967295) bor (z shr 25)",
    "    let i = i + 1",
    "  end",
    "  let c = cpu_cycles() - t",
    "  assert x != y",
    "  return c",
    "end",
    "make a function called cheapest takes f, n returns c",
    "  let best = 0 - 1",
    "  let k = 0",
    "  while k < 3 do",
    "    if f == 0 then",
    "      let c = mod_steps(n)",
    "    else",
    "      let c = int_steps(n)",
    "    end",
    "    if (best < 0) or (c < best) then",
    "      let best = c",
    "    end",
    "    let k = k + 1",
    "  end",
    "  return best",
    "end",
    "let sizes = [25000, 50000, 100000, 200000]",
    "let s = 0",
    "while s < list_len(sizes) do",
    "  let n = sizes[s]",
    "  print(\"\" + n + \" \" + cheapest(0, n) + \" \" + cheapest(1, n))",
    "  let s = s + 1",
    "end",
    ""
  ], chr(10))
end

# A line's words, split at spaces.
make a function called words_of takes line returns words
  let b = bytes_from_str(line)
  let words = []
  let start = 0
  let i = 0
  while i <= bytes_len(b) do
    if (i == bytes_len(b)) or (bytes_get(b, i) == 32) then
      if i > start then
        let words = list_push(words, bytes_to_str(bytes_slice(b, start, i - start)))
      end
      let start = i + 1
    end
    let i = i + 1
  end
  return words
end

let ctx = ctx_new()
let src = spec_out() + "/modint_cost_probe.patlang"
write_file(src, probe_source())
let r = run_compiled(src, spec_out() + "/modint_cost_probe.exe")
expect(ctx, "the probe builds and runs", r[0], true)
if r[0] then
  let lines = split_lines(r[1])
  let i = 0
  while i < list_len(lines) do
    let f = words_of(lines[i])
    if list_len(f) == 3 then
      let n = to_num(f[0])
      let m = to_num(f[1])
      let w = to_num(f[2])
      expect(ctx, "" + n + " steps: modints " + floor(m / n) + " cycles a step, ints " + floor(w / n) + ": at most ten times", m <= 10 * w, true)
    end
    let i = i + 1
  end
end
ctx_report(ctx)
