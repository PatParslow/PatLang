# Self-hosting Parser Harness
# Accepts tokens from the lexer harness shape and prints a minimal AST summary by lowering a print string.

# Build a tiny Program shape with a single Print("Hello from native AST") and compile it
let prog = map_new()
map_set(prog, "type", "Program")

let stmts = list_new()

let e = map_new()
map_set(e, "type", "String")
map_set(e, "value", "Hello from native AST")

let s = map_new()
map_set(s, "type", "Print")
map_set(s, "expr", e)

stmts.add(s)
map_set(prog, "stmts", stmts)

let out = lower_and_compile(prog, "./native_ast_demo.exe")
print(out)
