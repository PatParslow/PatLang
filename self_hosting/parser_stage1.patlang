# =============================================================================
# Stage 1 self-hosted parser demo: lex + parse a small program and print the
# AST. Lexer and parser live in lib/ and are written in the Stage 0
# compilable subset.
# =============================================================================

include "lib/lexer.patlang"
include "lib/parser.patlang"

let sample = "let x = 41\nlet y = x + 1\nprint(y)\nprint(\"answer: \" + y)\nprint((y - 2) * 10 >= 400)\n"
let toks = tokenize(sample)
let ast = parse_program(toks)
let stmts = ast[1]
print("STMTS: " + stmts.length)
let k = 0
while k < stmts.length do
  print(ast_to_str(stmts[k]))
  let k = k + 1
end
