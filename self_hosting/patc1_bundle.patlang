# The self-hosted compiler's source bundle: which files make up patc1, and
# their concatenation (each file's own includes expanded) into the one
# program patc1 is built from. Shared by build_patc1.patlang (Gen A, under
# the Rust interpreter) and build_patc1_native.patlang (run by pati, then
# compiled with patc1 --x64). Needs includes.patlang's expand_includes.

# The bundle, as DATA rather than as eighteen near-identical hand-edited
# lines. Adding or removing a module is now a one-line edit here plus the
# matching `include` above, instead of two edits that silently drift --
# and they HAVE drifted: an audit found the include list naming 16 lib
# files against 18 in the old concatenation (x64_asm and x64_pe_link
# appeared only in the concatenation, reaching the include list
# transitively via x64_build).
#
# The `include` list above genuinely cannot be derived from this one:
# includes are resolved at parse time, so they must be literal
# statements and cannot be generated from a runtime list. The two lists
# therefore still have to agree by hand -- but only one of them is now a
# place where a copy-paste slip can go unnoticed, and the check below
# turns a missing file into a named error instead of a mystery.
#
# Order here is NOT load-bearing for call resolution: the whole bundle is
# one compilation unit, and a function may call one defined later in the
# file (x64_asm.patlang calls into build_progress.patlang and resolves
# fine regardless of position). It is kept in dependency order anyway,
# for readability -- leaf modules first.
make a function called patc1_bundle_paths returns bundle
  return [
    "self_hosting/lib/lexer.patlang",
    "self_hosting/lib/parser.patlang",
    "self_hosting/lib/lower.patlang",
    "self_hosting/lib/codegen.patlang",
    "self_hosting/lib/runtime_rs.patlang",
    "self_hosting/lib/includes.patlang",
    "self_hosting/lib/signals.patlang",
    "self_hosting/lib/build_progress.patlang",
    "self_hosting/lib/codegen_x64.patlang",
    "self_hosting/lib/x64_asm.patlang",
    "self_hosting/lib/x64_pe_link.patlang",
    "self_hosting/lib/x64_build.patlang",
    "self_hosting/lib/json.patlang",
    "self_hosting/lib/ir_io.patlang",
    "self_hosting/lib/x64_obj_cache.patlang",
    "self_hosting/lib/x64_compile_unit.patlang",
    "self_hosting/lib/interp.patlang",
    "self_hosting/lib/world_native.patlang",
    "self_hosting/lib/regex_dsl.patlang",
    "self_hosting/lib/syntax_dsl.patlang",
    "self_hosting/block_model/block_ir.patlang",
    "self_hosting/block_model/free_vars.patlang",
    "self_hosting/block_model/flight_check.patlang",
    "self_hosting/block_model/classes.patlang",
    "self_hosting/block_model/lower.patlang",
    "self_hosting/block_model/native_codegen.patlang",
    "self_hosting/block_model/patc_backend.patlang",
    "self_hosting/patc1_main.patlang"
  ]
end

# patc1_main.patlang's patc1_built_fingerprint, with the fingerprint filled in.
make a function called patc1_fill_fingerprint takes text, fp returns out
  let lines = split_lines(text)
  let b = sb_new()
  let i = 0
  while i < list_len(lines) do
    if lines[i] == "  let fp = " + chr(34) + chr(34) then
      sb_push(b, "  let fp = " + chr(34) + fp + chr(34))
    else
      sb_push(b, lines[i])
    end
    sb_push(b, chr(10))
    let i = i + 1
  end
  return sb_str(b)
end

make a function called patc1_bundle_source returns src
  let src_sb = sb_new()
  let codegen_fp = "built"
  let bi = 0
  let bundle = patc1_bundle_paths()
  let bn = to_num(list_len(bundle))
  while bi < bn do
    let path = bundle[bi]
    if file_exists(path) != true then
      print("build_patc1: bundle file missing: " + path)
    end
    # Each bundle file's own `include "..."` lines (e.g. signals.patlang's
    # own `include "mailbox.patlang"`) are expanded here, relative to THAT
    # file's own directory, before concatenation -- not left as dangling
    # literal text. Plain concatenation alone used to leave such lines in
    # patc1_all.patlang unexpanded; tokenize/parse_program silently tolerate
    # an unresolved `include "X"` line as two harmless no-op statements (a
    # bare-identifier read of the unbound name `include`, then a bare
    # string-literal statement), so the bundle still compiled fine via the
    # normal rustc_build_chunked path below -- but `patc1.exe lower`'s own
    # separate code path calls expand_includes BEFORE tokenizing, which
    # actively tries to resolve and read the referenced file, and fails
    # outright when it was never copied alongside a bundle built this way.
    # Found verifying GitHub #25 Piece 2 (the Python IR bootstrap) still
    # works: `patc1.exe lower self_hosting/build/patc1_all.patlang ...`
    # failed on a missing self_hosting/build/mailbox.patlang -- a real,
    # confirmed regression (git blame: the include line was added 2026-09-
    # 19, nearly two months after Piece 2's own last verification), not
    # anything wrong with the bootstrap interpreter itself.
    let piece = expand_includes(read_file(path), path_dirname(path))
    if (path == "self_hosting/lib/codegen_x64.patlang") or (path == "self_hosting/lib/x64_asm.patlang") then
      let codegen_fp = codegen_fp + "_" + hash_string(piece)
    end
    # The compiled compiler records which code generator it was built from,
    # so its per-function chunk cache is keyed by the generator actually
    # running (x64_compiler_fingerprint), not by whatever codegen_x64.
    # patlang says on disk at compile time -- those differ whenever the
    # source is edited before patc1.exe is rebuilt, and chunks compiled then
    # were stored under the NEW source's key and reused after the rebuild.
    if path == "self_hosting/patc1_main.patlang" then
      let piece = patc1_fill_fingerprint(piece, codegen_fp)
    end
    if bi > 0 then
      sb_push(src_sb, chr(10))
    end
    sb_push(src_sb, piece)
    let bi = bi + 1
  end
  return sb_str(src_sb)
end
