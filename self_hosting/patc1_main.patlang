# =============================================================================
# patc1: the self-hosted PatLang compiler driver (Stage 1 dialect --
# concatenated after lib/lexer + lib/parser + lib/lower + lib/codegen +
# lib/runtime_rs + lib/includes; patc1_main.patlang itself is Stage 1 code
# too, so it's parsed by the same self-hosted frontend it drives).
#
# `include "path"` lines in the INPUT program are expanded here (lib/
# includes.patlang's expand_includes, a self-hosted mirror of rust-runtime/
# src/preprocess.rs's native-only expand_includes) before tokenizing, so a
# multi-file .patlang program written with `include` compiles identically
# whether handed to native pat.exe (--ir-run/--patc) or directly to
# patc1.exe -- previously only the native frontend understood `include` at
# all, forcing every multi-file self-hosted-compiled program (see
# build_portfolio.patlang's demos) to manually concatenate dependencies
# with read_file(...) + chr(10) + ... instead.
#
# Usage: patc1 <input.patlang> <output-exe> [target-triple] [opt-level]
# target-triple is optional and passed straight through to rustc_build
# (e.g. "wasm32-wasip1"); pass "" for a native build with an opt-level
# override. opt-level is optional and overrides the default -O -- needed
# when compiling unusually large generated programs (e.g. the self-hosted
# compiler's own combined source, self_hosting/build/patc1_all.patlang, for
# the fixpoint check) where rustc's optimizer has been observed to blow up
# memory usage or hang at higher optimization levels; "0" is confirmed safe.
# Ordinary user programs should omit this and keep the default -O. The
# emitted program's runtime text comes from emit_runtime_rs (PatLang
# source); the only external tool is rustc.
#
# ALTERNATE BACKEND: `patc1 <input.patlang> <output-exe> --x64` routes
# through lib/codegen_x64.patlang instead -- real x64 NASM, assembled
# and linked via nasm+gcc (lib/x64_build.patlang), NO rustc anywhere in
# that path. Only the Slice 1-6 subset (plain ints/strings/lists/
# closures, no numeric tower/BigInt/Rational/Object/facts-and-rules) is
# supported -- anything outside that subset is a clear compile-time
# error from codegen_x64.patlang itself, not silently wrong output.
#
# SEPARATE COMPILATION (chunk link, not textual concatenation): the
# input program is compiled ALONE (never prepended with
# x64_runtime.patlang's own source the way earlier revisions of this
# file did), then linked against an ALREADY-BUILT, fingerprint-cached
# self_hosting/build/x64_runtime.obj (see build_x64_runtime.patlang --
# run that once, separately, before using --x64; this file does NOT
# auto-rebuild it, matching how patc1.exe itself must already exist
# before patc1_main.patlang can run at all). This is what keeps an
# ordinary small program's own --x64 compile fast regardless of how
# large x64_runtime.patlang grows: the runtime's own codegen only ever
# happens once per source change, not once per program compiled
# against it (the previous whole-source-concatenation design forced a
# full re-codegen of the ENTIRE runtime on every single --x64 compile,
# a real, measured slowdown once the runtime grew past a few hundred
# lines -- see patlang-x64-chunk-linking memory for the full story).
# The runtime's own function-name list (needed so the program chunk
# knows what to `extern`, see emit_program_x64's own header) is
# re-derived by lexing+parsing (NOT full codegen -- cheap) x64_runtime.
# patlang fresh on every --x64 invocation.
# =============================================================================

make a function called x64_list_concat takes a, b returns c
  let c = a
  let n = b.length
  let i = 0
  while i < n do
    let c = list_push(c, b[i])
    let i = i + 1
  end
  return c
end

make a function called x64_name_in_list takes names, name returns yes
  let n = names.length
  let i = 0
  while i < n do
    if names[i] == name then
      return true
    end
    let i = i + 1
  end
  return false
end

# =============================================================================
# Explicit pipeline-stage subcommands (surfacing the modularity that used
# to be hidden behind CLI flags, per direct instruction: "make it clear and
# obvious how to lower from source to intermediate, saved, and then run
# each of the required final stages with separate commands... rather than
# them being hidden in command line switches"). Every backend (rustc, x64,
# wasm once it exists, the meta-circular interpreter) already shares the
# exact same lex/parse/lower front end -- these subcommands make that
# sharing visible and usable directly, instead of only reachable as an
# internal implementation detail of the old single `patc1 <in> <out>`
# invocation, which still works unchanged below for every existing caller.
#
#   patc1 lower <input.patlang> <output.ir>    -- tokenize+parse+lower, save IR
#   patc1 emit_rust <input.ir> <output.rs>     -- rustc-backend text, from a saved IR
#   patc1 emit_x64 <input.ir> <output.asm>     -- NASM-backend text, from a saved IR
#   patc1 emit_wasm <input.ir> <output.wasm>   -- NOT YET IMPLEMENTED, reserved
#   patc1 interpret <input.ir>                 -- meta-circular interpreter (slice 1:
#                                                  arithmetic/locals/control flow only)
#
# Future candidates in the same shape, not yet implemented: `optimise
# <input.ir> <output.ir>` (an IR-to-IR pass), `cfg <input.ir>` (dump a
# control-flow graph), `debug <input.ir>` (an interactive/inspectable
# step-through of `interpret`'s own execution) -- and, if any of those need
# name/type information beyond what the plain IR already carries, a real
# symbol table would slot in as another value threaded alongside the IR,
# not a redesign of this shape.
# =============================================================================

let args = argv()
if args.length >= 1 then
  if args[0] == "lower" then
    let raw_source = read_file(args[1])
    let source = expand_includes(raw_source, path_dirname(args[1]))
    let source = expand_syntax_dsls(source)
    let toks = tokenize(source)
    let ast = parse_program(toks)
    let stmts = ast[1]
    let err = parse_find_error(stmts)
    if err[0] != "" then
      print(format_parse_error(err[0], err[1], source))
    else
      let ir = lower_program(ast)
      save_ir(ir, args[2])
      print("lower: wrote " + args[2])
    end
  else
    if args[0] == "emit_rust" then
      let ir = load_ir(args[1])
      write_file(args[2], emit_program_rs(ir))
      print("emit_rust: wrote " + args[2])
    else
      if args[0] == "emit_x64" then
        let ir = load_ir(args[1])
        write_file(args[2], emit_program_x64(ir, true, []))
        print("emit_x64: wrote " + args[2])
      else
        if args[0] == "emit_wasm" then
          print("emit_wasm: not yet implemented -- PatLang currently reaches WASM only")
          print("  via emit_rust + rustc's own wasm32-wasip1 target (patc1 <in> <out> wasm32-wasip1);")
          print("  a native, rustc-free WASM emitter is a reserved future command, not this one.")
        else
          if args[0] == "interpret" then
            # Real cosmetic bug found via broad-coverage testing of the
            # meta-circular interpreter: on success this used to ALWAYS
            # print result[1] (the whole program's own implicit final
            # return value) -- but `pat --ir-run`'s own transcript never
            # shows that value, only whatever the program's own explicit
            # print() calls produced. Confirmed directly: a program with
            # no trailing bare-expression statement printed one extra,
            # unwanted line (typically "0") that `pat --ir-run` never
            # showed for the identical source. Matches --ir-run's own
            # convention now: stay silent on success, only report errors.
            let ir = load_ir(args[1])
            let result = interpret_ir(ir)
            if result[0] == "Err" then
              print("interpret: error: " + result[1])
            end
          else
            let dummy = 0
          end
        end
      end
    end
  end
else
  let dummy = 0
end

if args.length < 2 then
  if args.length == 0 then
    print("usage: patc1 <input.patlang> <output-exe> [target-triple] [opt-level]")
    print("       patc1 <input.patlang> <output-exe> --x64")
    print("       patc1 lower|emit_rust|emit_x64|emit_wasm|interpret ...")
  end
else
  if (args[0] == "lower") or (args[0] == "emit_rust") or (args[0] == "emit_x64") or (args[0] == "emit_wasm") or (args[0] == "interpret") then
    # already handled above
    let dummy = 0
  else
  let input = args[0]
  let output = args[1]
  let raw_source = read_file(input)
  let source = expand_includes(raw_source, path_dirname(input))
  let source = expand_syntax_dsls(source)
  let use_x64 = false
  if args.length >= 3 then
    if args[2] == "--x64" then
      let use_x64 = true
    end
  end
  let runtime_obj = "F:/PatLang/self_hosting/build/x64_runtime.obj"
  let lower_source = source
  if use_x64 then
    if file_exists(runtime_obj) == "1" then
      # The lowerer resolves Call vs CallHost by whether it sees a
      # matching function DEFINITION in the SAME compilation unit --
      # it has no notion of "resolved later via linking". So the
      # combined (runtime + program) text still has to be lexed/
      # parsed/lowered TOGETHER for correct call resolution, even
      # though the runtime's own .obj is separately cached -- lexing/
      # parsing is cheap (not the cost this split exists to avoid);
      # only CODEGEN (below, x64_collect_runtime_names/the emit_
      # program_x64 split) skips redoing the runtime's own work.
      let rt_src = read_file("F:/PatLang/self_hosting/lib/x64_runtime.patlang")
      let lower_source = rt_src + chr(10) + source
    end
  end
  let toks = tokenize(lower_source)
  let ast = parse_program(toks)
  let stmts = ast[1]
  let err = parse_find_error(stmts)
  if err[0] != "" then
    print(format_parse_error(err[0], err[1], lower_source))
  else
    let ir = lower_program(ast)
    if use_x64 then
      let runtime_names_file = "F:/PatLang/self_hosting/build/x64_runtime.funcs"
      if file_exists(runtime_obj) == "1" then
        # Cached manifest (written by build_x64_runtime.patlang),
        # NOT a second lex/parse/lower of x64_runtime.patlang -- doing
        # that a second time here (on top of the COMBINED parse just
        # above, unavoidable for correct Call/CallHost resolution) was
        # pure redundant cost that turned out to dominate a small
        # demo's whole compile time in testing.
        let rt_names = split_lines(read_file(runtime_names_file))
        # Split the COMBINED ir's funcs by name: anything the runtime
        # itself defines (except "main" -- x64_runtime.patlang has no
        # meaningful top-level code of its own, but lower_program
        # synthesizes an empty main for every source unit regardless,
        # which must never compete with the program's own real one)
        # was already compiled into runtime_obj by
        # build_x64_runtime.patlang; only the PROGRAM's own functions
        # need fresh codegen here.
        #
        # Real bug found and fixed here: this filter used to silently
        # EXCLUDE any function whose name matched an rt_names entry --
        # correct for "main" (never meaningfully redefined by real
        # programs) but wrong once x64_runtime.patlang started shadowing
        # ordinary, common-word host-primitive names (fact/query/goal/
        # etc, added this session) that a genuine user program could
        # legitimately ALSO define. Confirmed directly: a user's own
        # recursive `fact(n)` (1 arg) was silently discarded, and every
        # call to "fact" in the compiled program instead resolved to
        # x64_runtime.patlang's own unrelated 3-arg `fact(pred,a,b)` --
        # no compile error, no warning, just a wrong answer (fact(5)
        # printed the query-registration's own return value instead of
        # 120). `pat --ir-run` never hits this since it has no runtime
        # prelude to collide with at all. A name appearing in rt_names
        # AND appearing more than once in the COMBINED function list
        # (once from x64_runtime.patlang's own source, once from the
        # user's) is unambiguous evidence of exactly this collision --
        # reported as a clear, loud compile error rather than silently
        # picking one definition, matching this session's own established
        # "fail loudly, never silently corrupt/mis-resolve" discipline
        # (see rt_heap_alloc's own bounds-check fix for the same principle).
        let all_funcs = ir[2]
        let name_counts = []
        let nci = 0
        while nci < all_funcs.length do
          if all_funcs[nci][1] != "main" then
            let name_counts = list_push(name_counts, all_funcs[nci][1])
          end
          let nci = nci + 1
        end
        let collided_names = []
        let ci = 0
        while ci < rt_names.length do
          let rname = rt_names[ci]
          if rname != "main" then
            let occurrences = 0
            let oi = 0
            while oi < name_counts.length do
              if name_counts[oi] == rname then
                let occurrences = occurrences + 1
              end
              let oi = oi + 1
            end
            if occurrences > 1 then
              if not x64_name_in_list(collided_names, rname) then
                let collided_names = list_push(collided_names, rname)
              end
            end
          end
          let ci = ci + 1
        end
        if collided_names.length > 0 then
          print("patc1 --x64: compile error -- the following function name(s) are defined BOTH by this program and by x64_runtime.patlang's own shadowing primitives, and cannot be told apart: " + collided_names)
          print("  Rename the program's own function(s), or if the intent really is to use the runtime's own primitive, remove the program's conflicting definition.")
          let program_funcs = []
        else
        let program_funcs = []
        let pfi = 0
        let pf_count = all_funcs.length
        while pfi < pf_count do
          let fname = all_funcs[pfi][1]
          if not x64_name_in_list(rt_names, fname) then
            let program_funcs = list_push(program_funcs, all_funcs[pfi])
          end
          let pfi = pfi + 1
        end
        end
        # Per-function object cache (GitHub incremental-compile-caching
        # plan -- replaces the old size-threshold branch entirely: one
        # CompileUnit per function, cache-hit-or-fresh-assemble, ONE
        # final link. No more magic 1500-instruction threshold deciding
        # whether a program even gets chunked -- every program, however
        # small or large, goes through the SAME path now; a small
        # program's first compile is all cache misses (as cheap as the
        # old single-chunk path always was), and every later compile
        # (of that program OR the giant self-hosted-compiler bundle
        # alike) only pays for whatever functions actually changed. This
        # is also what permanently fixes the original NASM memory-
        # blowout root cause (one combined asm's label density
        # ballooning nasm.exe to 12-14GB assembling the self-hosted
        # compiler's own ~328-function bundle, see x64_partition_funcs's
        # own now-superseded header) -- every function is its own,
        # always-small .obj, regardless of how many other functions the
        # program has.
        if collided_names.length == 0 then
          let cache = new("ObjCache", "patc1_obj_cache")
          cache.cache_dir = "self_hosting/build/x64_obj_cache"
          let linker = new("X64UnitLinker", "patc1_linker")
          linker.cache = cache
          let exe = send(linker, "build", program_funcs, rt_names, runtime_obj, output)
          print("patc1: " + exe)
        end
      else
        print("patc1: --x64 needs self_hosting/build/x64_runtime.obj -- run:")
        print("  pat --ir-run self_hosting/build_x64_runtime.patlang")
      end
    else
      # Stage 40 (patlang-patc-prelude-chunk-linking-investigation):
      # `patc1_main.patlang` gets compiled INTO patc1.exe itself -- the
      # driver logic that runs for EVERY compile patc1.exe performs,
      # including Gen B/C (patc1.exe compiling its own combined source
      # into patc2.exe/patc3.exe). As a STANDALONE compiled program it has
      # no direct access to ChunkId/PRELUDE_*/build_chunked_native (only
      # the native `pat` process has those) -- but it DOES have its own
      # compiled-in self-hosted mirror functions (`emit_chunk_core()` etc,
      # from runtime_rs.patlang, part of the same combined source), so it
      # can supply chunk TEXT explicitly via `chunk_texts_for` and drive
      # the self-contained `rustc_build_chunked_texts` host function
      # (embedded, std-library-only implementation in codegen.rs's
      # PRELUDE_CODEGEN_BOOTSTRAP text) instead of falling back to the
      # old monolithic path. This is what makes Gen B/C genuinely use
      # chunking too, not just Gen A.
      #
      # Cross-compilation (a non-empty, non-"--x64" target-triple arg,
      # e.g. "wasm32-wasip1") is rare and has no chunked equivalent --
      # still falls back to the monolithic `emit_program_rs`+`rustc_build`
      # path in that case.
      let has_target_triple = false
      if args.length >= 3 then
        if args[2] != "--x64" then
          if args[2] != "" then
            let has_target_triple = true
          end
        end
      end
      if has_target_triple then
        let rs = emit_program_rs(ir)
        if args.length >= 4 then
          let exe = rustc_build(rs, output, args[2], args[3])
        else
          let exe = rustc_build(rs, output, args[2])
        end
        print("patc1: " + exe)
      else
        let chunks = required_chunks(ir)
        let base_and_pairs = chunk_texts_for(chunks)
        let base_name = base_and_pairs[0]
        let pairs = base_and_pairs[1]
        let rs = emit_program_rs_chunked(ir)
        # Default the FINAL LINK step's opt-level to "0" when the caller
        # doesn't specify one, rather than leaving it at rustc's own
        # default (-O/opt-level 2). Two hung, 1GB+-and-climbing rustc.exe
        # processes were found and killed the first time Gen B
        # (./patc1.exe compiling its own combined ~2.3MB-per-program-text
        # source into patc2.exe) was tried WITHOUT an explicit opt-level
        # arg -- the exact memory-blowup/hang pathology `rustc_build`'s
        # own opt-level override exists for, just newly reachable via the
        # chunked path's final link instead of the old monolithic one.
        # The precompiled CHUNK rlibs are UNAFFECTED (still always built
        # at the real -O, proven safe there) -- only the small, always-
        # regenerated per-program glue text is affected, where the
        # optimization loss is a minor, worthwhile trade against a real
        # crash risk for any caller (like Gen B/C) compiling something
        # this large.
        if args.length >= 4 then
          let exe = rustc_build_chunked_texts(rs, base_name, pairs, output, args[3])
        else
          let exe = rustc_build_chunked_texts(rs, base_name, pairs, output, "0")
        end
        print("patc1: " + exe)
      end
    end
  end
  end
end
