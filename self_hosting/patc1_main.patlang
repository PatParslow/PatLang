# =============================================================================
# patc1: the self-hosted PatLang compiler driver (Stage 1 dialect, no includes
# — concatenated after lib/lexer + lib/parser + lib/lower + lib/codegen +
# lib/runtime_rs).
#
# Usage: patc1 <input.patlang> <output-exe>
# The emitted program's runtime text comes from emit_runtime_rs (PatLang
# source); the only external tool is rustc.
# =============================================================================

let args = argv()
if args.length < 2 then
  print("usage: patc1 <input.patlang> <output-exe>")
else
  let input = args[0]
  let output = args[1]
  let source = read_file(input)
  let toks = tokenize(source)
  let ast = parse_program(toks)
  let ir = lower_program(ast)
  let rs = emit_program_rs(ir)
  let exe = rustc_build(rs, output)
  print("patc1: " + exe)
end
