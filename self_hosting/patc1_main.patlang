# =============================================================================
# patc1: the self-hosted PatLang compiler driver (Stage 1 dialect, no includes
# — concatenated after lib/lexer + lib/parser + lib/lower + lib/codegen).
#
# Usage: patc1 <input.patlang> <output-exe> [prelude.rs]
# The prelude path defaults to self_hosting/runtime/prelude.rs relative to
# the working directory.
# =============================================================================

let args = argv()
if args.length < 2 then
  print("usage: patc1 <input.patlang> <output-exe> [prelude.rs]")
else
  let input = args[0]
  let output = args[1]
  let prelude_path = "self_hosting/runtime/prelude.rs"
  if args.length >= 3 then
    let prelude_path = args[2]
  end
  let source = read_file(input)
  let toks = tokenize(source)
  let ast = parse_program(toks)
  let ir = lower_program(ast)
  let prelude = read_file(prelude_path)
  let rs = prelude + emit_build_program(ir)
  let exe = rustc_build(rs, output)
  print("patc1: " + exe)
end
