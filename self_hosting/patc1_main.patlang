# =============================================================================
# patc1: the self-hosted PatLang compiler driver (Stage 1 dialect --
# concatenated after lib/lexer + lib/parser + lib/lower + lib/codegen +
# lib/runtime_rs + lib/includes; patc1_main.patlang itself is Stage 1 code
# too, so it's parsed by the same self-hosted frontend it drives).
#
# `include "path"` lines in the INPUT program are expanded here (lib/
# includes.patlang's expand_includes, a self-hosted mirror of rust-runtime/
# src/preprocess.rs's native-only expand_includes) before tokenizing, so a
# multi-file .patlang program written with `include` compiles identically
# whether handed to native pat.exe (--ir-run/--patc) or directly to
# patc1.exe -- previously only the native frontend understood `include` at
# all, forcing every multi-file self-hosted-compiled program (see
# build_portfolio.patlang's demos) to manually concatenate dependencies
# with read_file(...) + chr(10) + ... instead.
#
# Usage: patc1 <input.patlang> <output-exe> [target-triple] [opt-level]
# target-triple is optional and passed straight through to rustc_build
# (e.g. "wasm32-wasip1"); pass "" for a native build with an opt-level
# override. opt-level is optional and overrides the default -O -- needed
# when compiling unusually large generated programs (e.g. the self-hosted
# compiler's own combined source, self_hosting/build/patc1_all.patlang, for
# the fixpoint check) where rustc's optimizer has been observed to blow up
# memory usage or hang at higher optimization levels; "0" is confirmed safe.
# Ordinary user programs should omit this and keep the default -O. The
# emitted program's runtime text comes from emit_runtime_rs (PatLang
# source); the only external tool is rustc.
# =============================================================================

let args = argv()
if args.length < 2 then
  print("usage: patc1 <input.patlang> <output-exe> [target-triple] [opt-level]")
else
  let input = args[0]
  let output = args[1]
  let raw_source = read_file(input)
  let source = expand_includes(raw_source, path_dirname(input))
  let toks = tokenize(source)
  let ast = parse_program(toks)
  let ir = lower_program(ast)
  let rs = emit_program_rs(ir)
  if args.length >= 4 then
    let exe = rustc_build(rs, output, args[2], args[3])
  else
    if args.length >= 3 then
      let exe = rustc_build(rs, output, args[2])
    else
      let exe = rustc_build(rs, output)
    end
  end
  print("patc1: " + exe)
end
