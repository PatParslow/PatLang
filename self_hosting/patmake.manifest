# patmake manifest: name : command : dep1,dep2,...
# Each command is idempotent/cheap-when-unchanged by its own convention
# (content-hash fingerprint against its real inputs) -- patmake just
# guarantees BOTH run, in a safe order, every time. See
# self_hosting/tools/patmake_main.patlang's own header for why this
# tool exists (GitHub #40's stale-x64_runtime.obj incident).
patc1_exe : rust-runtime/target/release/pat --ir-run self_hosting/build_patc1.patlang :
x64_runtime_obj : rust-runtime/target/release/pat --ir-run self_hosting/build_x64_runtime.patlang :
all : : patc1_exe,x64_runtime_obj
