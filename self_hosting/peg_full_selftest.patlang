# Selftest for docs/grammar/patlang-full.peg -- the full-language PEG
# grammar (Slice 2), interpreted by self_hosting/lib/peg.patlang.
# Mirrors peg_selftest.patlang's convention but exercises every
# construct in the full grammar, including the three grammar-level
# ambiguities the design had to resolve explicitly: assignment vs
# equality, trailing-closure-block vs condition-block, and rule-decl vs
# rule-as-a-call.
#
# Run from the repo root:
#   rust-runtime/target/release/pat --ir-run self_hosting/peg_full_selftest.patlang

include "lib/test.patlang"
include "lib/lexer.patlang"
include "lib/peg.patlang"

t_init()

let grammar_source = read_file("docs/grammar/patlang-full.peg")
let rules = peg_load_grammar(grammar_source)
check("grammar file loads with a plausible rule count", to_num(list_len(rules)) > 40, true)

make a function called peg_test_accepts takes rules, source returns ok
  let toks = tokenize(source)
  return peg_accepts(rules, "Program", toks)
end

# ---- statements ----
check("let with mut", peg_test_accepts(rules, "let mut x = 5
x = 6
print(x)
"), true)

check("bare assignment", peg_test_accepts(rules, "let x = 1
x = 2
"), true)

check("member assignment", peg_test_accepts(rules, "let obj = foo
obj.prop = 5
"), true)

check("fn brace form", peg_test_accepts(rules, "fn add(a, b) {
  return a + b
}
"), true)

check("function keyword form", peg_test_accepts(rules, "function add(a, b) {
  return a + b
}
"), true)

check("make a function called, word body with takes/returns", peg_test_accepts(rules, "make a function called add takes a, b returns r
  let r = a + b
  return r
end
"), true)

check("if brace with elif chain", peg_test_accepts(rules, "if x > 0 {
  print(1)
} elif x == 0 {
  print(2)
} else {
  print(3)
}
"), true)

check("if word style with elif chain (shared end)", peg_test_accepts(rules, "if x > 0 then
  print(1)
elif x == 0 then
  print(2)
else
  print(3)
end
"), true)

check("while brace and word style", peg_test_accepts(rules, "let i = 0
while i < 3 {
  let i = i + 1
}
while i < 6 do
  let i = i + 1
end
"), true)

check("budgeted block", peg_test_accepts(rules, "budgeted(100) {
  print(1)
}
"), true)

check("budgeted with existing fiber arg, word body", peg_test_accepts(rules, "budgeted(100, fib) do
  print(1)
end
"), true)

check("when handler", peg_test_accepts(rules, "when tick {
  print(1)
}
"), true)

check("contracts: require/ensure/assert", peg_test_accepts(rules, "require x > 0
ensure y > 0
assert z > 0
"), true)

check("rule declaration: single-clause body", peg_test_accepts(rules, "rule parent(a, b) :- father(a, b).
"), true)

check("rule declaration: multi-call body", peg_test_accepts(rules, "rule parent(a, b) :- father(a, b), mother(a, b).
"), true)

check("rule declaration: fact (no body)", peg_test_accepts(rules, "rule fact(a).
"), true)

check("rule as an ordinary call, not a declaration", peg_test_accepts(rules, "print(rule(1, 2))
"), true)

check("bare print sugar", peg_test_accepts(rules, "print 1 + 2
"), true)

# ---- expressions / literals ----
check("list literal and indexing", peg_test_accepts(rules, "let l = [1, 2, 3]
print(l[0])
"), true)

check("closure literal, brace body", peg_test_accepts(rules, "let f = |a, b| { return a + b }
print(f(1, 2))
"), true)

check("closure literal, word body", peg_test_accepts(rules, "let f = |a, b| do
  return a + b
end
print(f(1, 2))
"), true)

check("bitwise and shift operators", peg_test_accepts(rules, "let r = 1 band 2 bor 3 bxor 4
let s = 1 shl 2
let t = 8 shr 1
"), true)

check("pipeline operator", peg_test_accepts(rules, "let r = 5 |> add1 |> double
"), true)

check("member access chain", peg_test_accepts(rules, "let r = obj.a.b.c
"), true)

# ---- the three grammar-level ambiguities, explicitly ----
check("trailing block attaches as closure arg in general expr position", peg_test_accepts(rules, "let x = f(1) { print(2) }
"), true)

check("trailing block does NOT get swallowed into an if condition", peg_test_accepts(rules, "if f(1) {
  print(1)
}
"), true)

check("bare assignment vs mid-expression equality both parse in their own positions", peg_test_accepts(rules, "let x = 1
x = 2
let y = (x == 2)
"), true)

# ---- reject cases ----
check("trailing operator with nothing after it is rejected", peg_test_accepts(rules, "let x = 5 +
"), false)

check("unclosed brace block is rejected", peg_test_accepts(rules, "if x > 0 {
  print(1)
"), false)

check("malformed rule decl (missing closing dot) is rejected", peg_test_accepts(rules, "rule parent(a, b) :- father(a, b)
"), false)

# ---- goal/pursue/activate (added when the real syntax landed) ----
check("goal declaration with dependencies", peg_test_accepts(rules, "goal need_house {
  built(house), foo(bar)
}
"), true)

check("goal declaration with no dependencies", peg_test_accepts(rules, "goal empty_goal {
}
"), true)

check("pursue as an expression (let RHS)", peg_test_accepts(rules, "let p = pursue need_house
"), true)

check("pursue as a bare statement", peg_test_accepts(rules, "pursue need_house
"), true)

check("pursue/goal/rule as ordinary parenthesized calls, not declarations", peg_test_accepts(rules, "print(rule(1, 2))
print(goal(1, 2))
print(pursue(1))
"), true)

check("activate as an expression (let RHS)", peg_test_accepts(rules, "let ok = activate p
"), true)

check("activate as a bare statement, both call forms", peg_test_accepts(rules, "activate p
activate(p)
"), true)

check("activate(...) inside an if condition does not swallow the if's body block", peg_test_accepts(rules, "if activate(p) {
  print(1)
}
"), true)

check("malformed goal decl (missing closing brace) is rejected", peg_test_accepts(rules, "goal need_house {
  built(house)
"), false)

t_report()
