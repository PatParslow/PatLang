# Selftest for docs/grammar/patlang-full.peg -- the full-language PEG
# grammar (Slice 2), interpreted by self_hosting/lib/peg.patlang.
# Mirrors peg_selftest.patlang's convention but exercises every
# construct in the full grammar, including the three grammar-level
# ambiguities the design had to resolve explicitly: assignment vs
# equality, trailing-closure-block vs condition-block, and rule-decl vs
# rule-as-a-call.
#
# Run from the repo root:
#   rust-runtime/target/release/pat --ir-run self_hosting/peg_full_selftest.patlang

include "lib/includes.patlang"
include "lib/gherkin.patlang"
include "lib/lexer.patlang"
include "lib/peg.patlang"

let ctx = ctx_new()

let grammar_source = read_file("docs/grammar/patlang-full.peg")
let rules = peg_load_grammar(ctx, grammar_source)
expect(ctx, "grammar file loads with a plausible rule count", to_num(list_len(rules)) > 40, true)

make a function called peg_test_accepts takes ctx, rules, source returns ok
  let toks = tokenize(source)
  return peg_accepts(ctx, rules, "Program", toks)
end

# ---- statements ----
expect(ctx, "let with mut", peg_test_accepts(ctx, rules, "let mut x = 5
x = 6
print(x)
"), true)

expect(ctx, "bare assignment", peg_test_accepts(ctx, rules, "let x = 1
x = 2
"), true)

expect(ctx, "member assignment", peg_test_accepts(ctx, rules, "let obj = foo
obj.prop = 5
"), true)

expect(ctx, "fn brace form", peg_test_accepts(ctx, rules, "fn add(a, b) {
  return a + b
}
"), true)

expect(ctx, "function keyword form", peg_test_accepts(ctx, rules, "function add(a, b) {
  return a + b
}
"), true)

expect(ctx, "make a function called, word body with takes/returns", peg_test_accepts(ctx, rules, "make a function called add takes a, b returns r
  let r = a + b
  return r
end
"), true)

expect(ctx, "if brace with elif chain", peg_test_accepts(ctx, rules, "if x > 0 {
  print(1)
} elif x == 0 {
  print(2)
} else {
  print(3)
}
"), true)

expect(ctx, "if word style with elif chain (shared end)", peg_test_accepts(ctx, rules, "if x > 0 then
  print(1)
elif x == 0 then
  print(2)
else
  print(3)
end
"), true)

expect(ctx, "while brace and word style", peg_test_accepts(ctx, rules, "let i = 0
while i < 3 {
  let i = i + 1
}
while i < 6 do
  let i = i + 1
end
"), true)

expect(ctx, "budgeted block", peg_test_accepts(ctx, rules, "budgeted(100) {
  print(1)
}
"), true)

expect(ctx, "budgeted with existing fiber arg, word body", peg_test_accepts(ctx, rules, "budgeted(100, fib) do
  print(1)
end
"), true)

expect(ctx, "when handler", peg_test_accepts(ctx, rules, "when tick {
  print(1)
}
"), true)

expect(ctx, "contracts: require/ensure/assert", peg_test_accepts(ctx, rules, "require x > 0
ensure y > 0
assert z > 0
"), true)

expect(ctx, "rule declaration: single-clause body", peg_test_accepts(ctx, rules, "rule parent(a, b) :- father(a, b).
"), true)

expect(ctx, "rule declaration: multi-call body", peg_test_accepts(ctx, rules, "rule parent(a, b) :- father(a, b), mother(a, b).
"), true)

expect(ctx, "rule declaration: fact (no body)", peg_test_accepts(ctx, rules, "rule fact(a).
"), true)

expect(ctx, "rule as an ordinary call, not a declaration", peg_test_accepts(ctx, rules, "print(rule(1, 2))
"), true)

expect(ctx, "bare print sugar", peg_test_accepts(ctx, rules, "print 1 + 2
"), true)

# ---- expressions / literals ----
expect(ctx, "list literal and indexing", peg_test_accepts(ctx, rules, "let l = [1, 2, 3]
print(l[0])
"), true)

expect(ctx, "closure literal, brace body", peg_test_accepts(ctx, rules, "let f = |a, b| { return a + b }
print(f(1, 2))
"), true)

expect(ctx, "closure literal, word body", peg_test_accepts(ctx, rules, "let f = |a, b| do
  return a + b
end
print(f(1, 2))
"), true)

expect(ctx, "bitwise and shift operators", peg_test_accepts(ctx, rules, "let r = 1 band 2 bor 3 bxor 4
let s = 1 shl 2
let t = 8 shr 1
"), true)

expect(ctx, "pipeline operator", peg_test_accepts(ctx, rules, "let r = 5 |> add1 |> double
"), true)

expect(ctx, "member access chain", peg_test_accepts(ctx, rules, "let r = obj.a.b.c
"), true)

# ---- the three grammar-level ambiguities, explicitly ----
expect(ctx, "trailing block attaches as closure arg in general expr position", peg_test_accepts(ctx, rules, "let x = f(1) { print(2) }
"), true)

expect(ctx, "trailing block does NOT get swallowed into an if condition", peg_test_accepts(ctx, rules, "if f(1) {
  print(1)
}
"), true)

expect(ctx, "bare assignment vs mid-expression equality both parse in their own positions", peg_test_accepts(ctx, rules, "let x = 1
x = 2
let y = (x == 2)
"), true)

# ---- reject cases ----
expect(ctx, "trailing operator with nothing after it is rejected", peg_test_accepts(ctx, rules, "let x = 5 +
"), false)

expect(ctx, "unclosed brace block is rejected", peg_test_accepts(ctx, rules, "if x > 0 {
  print(1)
"), false)

expect(ctx, "malformed rule decl (missing closing dot) is rejected", peg_test_accepts(ctx, rules, "rule parent(a, b) :- father(a, b)
"), false)

# ---- goal/pursue/activate (added when the real syntax landed) ----
expect(ctx, "goal declaration with dependencies", peg_test_accepts(ctx, rules, "goal need_house {
  built(house), foo(bar)
}
"), true)

expect(ctx, "goal declaration with no dependencies", peg_test_accepts(ctx, rules, "goal empty_goal {
}
"), true)

expect(ctx, "pursue as an expression (let RHS)", peg_test_accepts(ctx, rules, "let p = pursue need_house
"), true)

expect(ctx, "pursue as a bare statement", peg_test_accepts(ctx, rules, "pursue need_house
"), true)

expect(ctx, "pursue/goal/rule as ordinary parenthesized calls, not declarations", peg_test_accepts(ctx, rules, "print(rule(1, 2))
print(goal(1, 2))
print(pursue(1))
"), true)

expect(ctx, "activate as an expression (let RHS)", peg_test_accepts(ctx, rules, "let ok = activate p
"), true)

expect(ctx, "activate as a bare statement, both call forms", peg_test_accepts(ctx, rules, "activate p
activate(p)
"), true)

expect(ctx, "activate(...) inside an if condition does not swallow the if's body block", peg_test_accepts(ctx, rules, "if activate(p) {
  print(1)
}
"), true)

expect(ctx, "malformed goal decl (missing closing brace) is rejected", peg_test_accepts(ctx, rules, "goal need_house {
  built(house)
"), false)

# ---- class declarations and match/case (both real parsers accept these) ----

expect(ctx, "class with fields, brace form", peg_test_accepts(ctx, rules, "class Animal {
  field name = 1
  field legs = 4
}
print(1)
"), true)

expect(ctx, "class with inherits and a traits line", peg_test_accepts(ctx, rules, "class Animal {
  field name = 1
}
class Dog inherits Animal {
  field sound = 2
  traits Loud, Friendly
}
print(1)
"), true)

expect(ctx, "class in do ... end form with a method", peg_test_accepts(ctx, rules, "class Counter do
  field n = 0
  make a function called bump takes self returns r
    return 1
  end
end
print(1)
"), true)

expect(ctx, "class in begin ... end form", peg_test_accepts(ctx, rules, "class Box begin
  field w = 1
end
print(1)
"), true)

expect(ctx, "brace class with a word-form method", peg_test_accepts(ctx, rules, "class Pt {
  field x = 0
  make a function called getx takes self returns r
    return 1
  end
}
print(1)
"), true)

expect(ctx, "match with literal, comparison, guarded binding and wildcard arms", peg_test_accepts(ctx, rules, "let n = 3
match n do
  case 3 then print(3)
  case > 10 then print(10)
  case x when x == 5 then print(5)
  case _ then print(0)
end
"), true)

expect(ctx, "match with list and glob patterns", peg_test_accepts(ctx, rules, "let name = 1
match name do
  case [1, _, x] then print(x)
  case *.patlang then print(1)
  case fred* then print(2)
end
"), true)

expect(ctx, "match nested in an if, with an if inside an arm body", peg_test_accepts(ctx, rules, "let n = 2
if n > 1 {
  match n do
    case 2 then
      if n == 2 {
        print(2)
      }
      print(3)
    case _ then print(0)
  end
}
"), true)

expect(ctx, "match followed by more statements", peg_test_accepts(ctx, rules, "let n = 1
match n do
  case 1 then print(1)
end
print(2)
"), true)

expect(ctx, "class body with a method line the real parsers reject is rejected", peg_test_accepts(ctx, rules, "class Animal {
  field name = 1
  method speak() {
    return 1
  }
}
print(1)
"), false)

expect(ctx, "class with an unclosed brace is rejected", peg_test_accepts(ctx, rules, "class Animal {
  field name = 1
print(1)
"), false)

expect(ctx, "class opened with a brace and closed with end is rejected", peg_test_accepts(ctx, rules, "class A {
  field x = 1
end
print(1)
"), false)

expect(ctx, "class with no name is rejected", peg_test_accepts(ctx, rules, "class {
  field x = 1
}
"), false)

expect(ctx, "match without do is rejected", peg_test_accepts(ctx, rules, "let n = 1
match n
  case 1 then print(1)
end
"), false)

expect(ctx, "case arm without then is rejected", peg_test_accepts(ctx, rules, "let n = 1
match n do
  case 1 print(1)
end
"), false)

expect(ctx, "match without a closing end is rejected", peg_test_accepts(ctx, rules, "let n = 1
match n do
  case 1 then print(1)
"), false)

# ---- rule/goal arguments are expressions; ";" separates statements ----

expect(ctx, "rule facts and heads take numeric arguments", peg_test_accepts(ctx, rules, "rule dob(alice, 1996).
rule dob(bob, 2015).
rule older(X, Y) :- dob(X, D1), dob(Y, D2).
print(1)
"), true)

expect(ctx, "goal dependencies take numeric arguments", peg_test_accepts(ctx, rules, "rule built(1).
goal g { built(1), built(2) }
print(1)
"), true)

expect(ctx, "semicolon as an optional statement separator", peg_test_accepts(ctx, rules, "let x = 1; let y = 2
print(x); print(y)
"), true)

expect(ctx, "semicolon separator inside a closure body", peg_test_accepts(ctx, rules, "let f = |p| { print(1); print(2) }
f(1)
"), true)

ctx_report(ctx)
