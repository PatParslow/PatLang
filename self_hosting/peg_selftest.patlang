# Selftest for self_hosting/lib/peg.patlang (the PEG grammar-file
# reader + interpreter). Standalone (includes its own deps, same
# convention as lint_selftest.patlang), against
# docs/grammar/patlang-slice1.peg -- the deliberately small Slice-1
# proof-of-concept subset (let/print/if/while/fn, both brace and word
# styles), not full PatLang.
#
# Run from the repo root:
#   rust-runtime/target/release/pat --ir-run self_hosting/peg_selftest.patlang

include "lib/test.patlang"
include "lib/lexer.patlang"
include "lib/peg.patlang"

t_init()

let grammar_source = read_file("docs/grammar/patlang-slice1.peg")
let rules = peg_load_grammar(grammar_source)
check("grammar file loads with a plausible rule count", to_num(list_len(rules)) > 20, true)

make a function called peg_test_accepts takes rules, source returns ok
  let toks = tokenize(source)
  return peg_accepts(rules, "Program", toks)
end

# ---- accept cases: one per construct the subset covers ----
check("plain let + print", peg_test_accepts(rules, "let x = 5
print(x)
"), true)

check("word-style if/else/end", peg_test_accepts(rules, "if x > 0 then
  print(1)
else
  print(2)
end
"), true)

check("brace-style if/elif/else", peg_test_accepts(rules, "if x > 0 {
  print(1)
} elif x < 0 {
  print(2)
} else {
  print(3)
}
"), true)

check("word-style while/do/end", peg_test_accepts(rules, "let i = 0
while i < 3 do
  print(i)
  let i = i + 1
end
"), true)

check("brace-style while", peg_test_accepts(rules, "let i = 0
while i < 3 {
  print(i)
  let i = i + 1
}
"), true)

check("make a function called (word body)", peg_test_accepts(rules, "make a function called add takes a, b returns r
  let r = a + b
  return r
end

print(add(2, 3))
"), true)

check("make a function called (brace body)", peg_test_accepts(rules, "make a function called add takes a, b returns r
  let r = a + b
  return r
}
"), false)
# (the mismatched brace-close on a `make`-opened, no-brace-body function
# is deliberately a REJECT case, not a typo -- make's own body form was
# opened without a leading '{', so a lone trailing '}' has nothing to
# match; this exercises that the checker doesn't just wave through
# anything with balanced-looking tokens.)

check("fn with parenthesized params", peg_test_accepts(rules, "fn add(a, b) {
  return a + b
}

print(add(2, 3))
"), true)

check("nested precedence expression", peg_test_accepts(rules, "let r = 1 + 2 * 3 == 7 and not (4 > 5)
print(r)
"), true)

# ---- reject cases: real syntax errors within the subset's own vocabulary ----
check("trailing operator with nothing after it is rejected", peg_test_accepts(rules, "let x = 5 +
"), false)

check("unclosed brace block is rejected", peg_test_accepts(rules, "if x > 0 {
  print(1)
"), false)

check("fn without parens is rejected (word-style params not valid for fn)", peg_test_accepts(rules, "fn add a, b {
  return a + b
}
"), false)

t_report()
