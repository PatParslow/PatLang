# =============================================================================
# Stage 1 self-hosting pipeline: PatLang source is tokenized by the PatLang
# lexer, parsed by the PatLang parser, and the resulting AST shape is lowered
# and compiled to a native executable (compile_shape host bridges to Stage 0
# IR + rustc). Usage:
#   pat --ir-run self_hosting/pipeline_stage1.patlang
# The output executable path is printed on success.
# =============================================================================

include "lib/lexer.patlang"
include "lib/parser.patlang"

let source = "let x = 40\nlet y = x + 2\nprint(\"answer: \" + y)\nprint(y * 10)\n"
print("SOURCE:")
print(source)

let toks = tokenize(source)
print("TOKENS: " + toks.length)

let ast = parse_program(toks)
let stmts = ast[1]
print("STMTS: " + stmts.length)
let k = 0
while k < stmts.length do
  print("  " + ast_to_str(stmts[k]))
  let k = k + 1
end

let exe = compile_shape(ast, "./selfhost_pipeline_demo.exe")
print("COMPILED: " + exe)
