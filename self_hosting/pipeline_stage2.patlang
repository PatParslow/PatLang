# =============================================================================
# Stage 2 self-hosting pipeline demo: the PatLang-written lexer + parser
# process a feature-rich program (functions, recursion, control flow, lists,
# events, logic facts/queries, OO objects) and compile it to a native
# executable via compile_shape.
#
# Run from the repo root:
#   rust-runtime/target/debug/pat --ir-run self_hosting/pipeline_stage2.patlang
# Then run the printed executable.
# =============================================================================

include "lib/lexer.patlang"
include "lib/parser.patlang"

let source = read_file("self_hosting/examples/feature_demo.patlang")
let toks = tokenize(source)
print("TOKENS: " + toks.length)

let ast = parse_program(toks)
let stmts = ast[1]
print("STMTS: " + stmts.length)
let k = 0
while k < stmts.length do
  print("  " + ast_to_str(stmts[k]))
  let k = k + 1
end

let exe = compile_shape(ast, "./selfhost_feature_demo.exe")
print("COMPILED: " + exe)
