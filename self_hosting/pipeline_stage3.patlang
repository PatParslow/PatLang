# =============================================================================
# Stage 3 self-hosting pipeline: lexing, parsing, AND lowering all happen in
# PatLang. The host's compile_ir only decodes the finished IR and runs
# codegen + rustc. This is fixpoint step 1 from the roadmap.
#
# Run from the repo root:
#   rust-runtime/target/debug/pat --ir-run self_hosting/pipeline_stage3.patlang
# =============================================================================

include "lib/lexer.patlang"
include "lib/parser.patlang"
include "lib/lower.patlang"

let source = read_file("self_hosting/examples/feature_demo.patlang")
let toks = tokenize(source)
print("TOKENS: " + toks.length)

let ast = parse_program(toks)
print("STMTS: " + ast[1].length)

let ir = lower_program(ast)
print("FUNCS: " + ir[2].length)
print("EVENTS: " + ir[3].length)

let exe = compile_ir(ir, "./selfhost_stage3_demo.exe")
print("COMPILED: " + exe)
