# =============================================================================
# Stage 4 self-hosting pipeline: lexing, parsing, lowering, AND Rust code
# generation all happen in PatLang. The host contributes only the fixed
# runtime prelude text (codegen_prelude) and the dumb back end that writes
# the source and invokes rustc (rustc_build). Fixpoint step 2a.
#
# Run from the repo root:
#   rust-runtime/target/debug/pat --ir-run self_hosting/pipeline_stage4.patlang
# =============================================================================

include "lib/lexer.patlang"
include "lib/parser.patlang"
include "lib/lower.patlang"
include "lib/codegen.patlang"
include "lib/runtime_rs.patlang"

let source = read_file("self_hosting/examples/feature_demo.patlang")
let toks = tokenize(source)
print("TOKENS: " + vec_len(toks))

let ast = parse_program(toks)
print("STMTS: " + ast[1].length)

let ir = lower_program(ast)
print("FUNCS: " + ir[2].length)

let rs = emit_program_rs(ir)
print("RUST CHARS: " + rs.length)

let exe = rustc_build(rs, "./selfhost_stage4_demo.exe")
print("COMPILED: " + exe)
