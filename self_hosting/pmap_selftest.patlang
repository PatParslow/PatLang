# Selftest for self_hosting/lib/pmap.patlang.
#
# Run from the repo root:
#   rust-runtime/target/release/pat --ir-run self_hosting/pmap_selftest.patlang

include "lib/test.patlang"
include "lib/pmap.patlang"

t_init()

let empty = pmap_new()
check("a new map has size 0", pmap_size(empty), 0)
check("a new map does not have an arbitrary key", pmap_has(empty, "Dune"), false)

let m1 = pmap_put(empty, "Dune", "A. Diallo")
check("putting one key makes size 1", pmap_size(m1), 1)
check("the map now has the put key", pmap_has(m1, "Dune"), true)
check("pmap_get returns the value just put", pmap_get(m1, "Dune"), "A. Diallo")
check("a key never put is absent", pmap_has(m1, "Neuromancer"), false)

let m2 = pmap_put(m1, "Neuromancer", "S. Okonkwo")
check("putting a second distinct key makes size 2", pmap_size(m2), 2)
check("both values are retrievable after the second put", pmap_get(m2, "Dune") + "/" + pmap_get(m2, "Neuromancer"), "A. Diallo/S. Okonkwo")

let m3 = pmap_put(m2, "Dune", "B. Marsh")
check("overwriting an existing key does not change size", pmap_size(m3), 2)
check("overwriting an existing key replaces its value", pmap_get(m3, "Dune"), "B. Marsh")
check("overwriting one key leaves the other untouched", pmap_get(m3, "Neuromancer"), "S. Okonkwo")
check("the original map is untouched by pmap_put (functional, not mutating)", pmap_get(m2, "Dune"), "A. Diallo")

let m4 = pmap_remove(m3, "Dune")
check("removing a present key drops the size by one", pmap_size(m4), 1)
check("the removed key is no longer present", pmap_has(m4, "Dune"), false)
check("the other key survives removal", pmap_has(m4, "Neuromancer"), true)

let m5 = pmap_remove(m4, "not present at all")
check("removing an absent key is a no-op on size", pmap_size(m5), 1)

let keys = pmap_keys(m2)
check("pmap_keys returns the right count", to_num(list_len(keys)), 2)
check("pmap_keys includes a key that was put", (keys[0] == "Dune") or (keys[1] == "Dune"), true)

t_report()
