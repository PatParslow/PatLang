# Selftest for self_hosting/lib/pmap.patlang.
#
# Run from the repo root:
#   rust-runtime/target/release/pat --ir-run self_hosting/pmap_selftest.patlang

include "lib/includes.patlang"
include "lib/gherkin.patlang"
include "lib/pmap.patlang"

let ctx = ctx_new()

let empty = pmap_new()
expect(ctx, "a new map has size 0", pmap_size(empty), 0)
expect(ctx, "a new map does not have an arbitrary key", pmap_has(empty, "Dune"), false)

let m1 = pmap_put(empty, "Dune", "A. Diallo")
expect(ctx, "putting one key makes size 1", pmap_size(m1), 1)
expect(ctx, "the map now has the put key", pmap_has(m1, "Dune"), true)
expect(ctx, "pmap_get returns the value just put", pmap_get(m1, "Dune"), "A. Diallo")
expect(ctx, "a key never put is absent", pmap_has(m1, "Neuromancer"), false)

let m2 = pmap_put(m1, "Neuromancer", "S. Okonkwo")
expect(ctx, "putting a second distinct key makes size 2", pmap_size(m2), 2)
expect(ctx, "both values are retrievable after the second put", pmap_get(m2, "Dune") + "/" + pmap_get(m2, "Neuromancer"), "A. Diallo/S. Okonkwo")

let m3 = pmap_put(m2, "Dune", "B. Marsh")
expect(ctx, "overwriting an existing key does not change size", pmap_size(m3), 2)
expect(ctx, "overwriting an existing key replaces its value", pmap_get(m3, "Dune"), "B. Marsh")
expect(ctx, "overwriting one key leaves the other untouched", pmap_get(m3, "Neuromancer"), "S. Okonkwo")
expect(ctx, "the original map is untouched by pmap_put (functional, not mutating)", pmap_get(m2, "Dune"), "A. Diallo")

let m4 = pmap_remove(m3, "Dune")
expect(ctx, "removing a present key drops the size by one", pmap_size(m4), 1)
expect(ctx, "the removed key is no longer present", pmap_has(m4, "Dune"), false)
expect(ctx, "the other key survives removal", pmap_has(m4, "Neuromancer"), true)

let m5 = pmap_remove(m4, "not present at all")
expect(ctx, "removing an absent key is a no-op on size", pmap_size(m5), 1)

let keys = pmap_keys(m2)
expect(ctx, "pmap_keys returns the right count", to_num(list_len(keys)), 2)
expect(ctx, "pmap_keys includes a key that was put", (keys[0] == "Dune") or (keys[1] == "Dune"), true)

ctx_report(ctx)
