# Selftest for self_hosting/lib/program_run.patlang.
#
# Given a program's output and the lines a test expects,
# when printed() compares them,
# then the exact lines pass, so do the lines plus one more (the old engines'
# report of the program's last value), and anything else fails.
# Given a small program, when it is interpreted and when it is compiled,
# then both exit 0 and print its lines; a program that does not build gives
# false and the build's output.

include "lib/includes.patlang"
include "lib/gherkin.patlang"
include "lib/program_run.patlang"
include "lib/v2_engines.patlang"

let ctx = ctx_new()

expect(ctx, "the exact lines pass", printed("a\nb\n", "a\nb\n"), true)
expect(ctx, "the lines and an empty last-value line pass", printed("a\nb\n\n", "a\nb\n"), true)
expect(ctx, "the lines and a last-value line pass", printed("a\nb\n0\n", "a\nb\n"), true)
expect(ctx, "two lines more fail", printed("a\nb\nc\nd\n", "a\nb\n"), false)
expect(ctx, "a line more with no newline at its end fails", printed("a\nb\nc", "a\nb\n"), false)
expect(ctx, "fewer lines fail", printed("a\n", "a\nb\n"), false)
expect(ctx, "a different line fails", printed("a\nbx\n", "a\nb\n"), false)

let src = spec_out() + "/program_run_selftest_ok.patlang"
write_file(src, "print(\"one\")\nprint(1 + 1)\n")
let i = run_interpreted(src)
expect(ctx, "an interpreted program exits 0", i[0], true)
expect(ctx, "an interpreted program prints its lines", printed(i[1], "one\n2\n"), true)
let c = run_compiled(src, spec_out() + "/program_run_selftest_ok.exe")
expect(ctx, "a compiled program exits 0", c[0], true)
expect(ctx, "a compiled program prints its lines", printed(c[1], "one\n2\n"), true)

let bad = spec_out() + "/program_run_selftest_bad.patlang"
write_file(bad, "make a function called f takes x returns y\n")
let b = run_compiled(bad, spec_out() + "/program_run_selftest_bad.exe")
expect(ctx, "a program that does not build gives false", b[0], false)

ctx_report(ctx)
