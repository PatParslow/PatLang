# Selftest for self_hosting/lib/pset.patlang.
#
# Run from the repo root:
#   rust-runtime/target/release/pat --ir-run self_hosting/pset_selftest.patlang

include "lib/test.patlang"
include "lib/pset.patlang"

t_init()

let empty = pset_new()
check("a new set has size 0", pset_size(empty), 0)
check("a new set does not contain an arbitrary item", pset_contains(empty, "Dune"), false)

let s1 = pset_add(empty, "Dune")
check("adding one item makes size 1", pset_size(s1), 1)
check("the set now contains the added item", pset_contains(s1, "Dune"), true)
check("the set does not contain something never added", pset_contains(s1, "Neuromancer"), false)

let s2 = pset_add(s1, "Neuromancer")
check("adding a second distinct item makes size 2", pset_size(s2), 2)
check("both items are present after the second add", pset_contains(s2, "Dune") and pset_contains(s2, "Neuromancer"), true)

let s3 = pset_add(s2, "Dune")
check("re-adding an existing item is a no-op on size", pset_size(s3), 2)
check("the original set is untouched by pset_add (functional, not mutating)", pset_size(s2), 2)

let s4 = pset_remove(s3, "Dune")
check("removing a present item drops the size by one", pset_size(s4), 1)
check("the removed item is no longer contained", pset_contains(s4, "Dune"), false)
check("the other item survives removal", pset_contains(s4, "Neuromancer"), true)

let s5 = pset_remove(s4, "not present at all")
check("removing an absent item is a no-op on size", pset_size(s5), 1)

let list_view = pset_to_list(s4)
check("pset_to_list exposes the same size", to_num(list_len(list_view)), 1)

check("a set equals itself", pset_equal(s2, s2), true)
check("two sets built via different add orders are equal", pset_equal(pset_add(pset_add(pset_new(), "a"), "b"), pset_add(pset_add(pset_new(), "b"), "a")), true)
check("sets of different size are not equal", pset_equal(s1, s2), false)
check("same size but different members are not equal", pset_equal(pset_add(pset_new(), "a"), pset_add(pset_new(), "b")), false)

t_report()
