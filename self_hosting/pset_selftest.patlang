# Selftest for self_hosting/lib/pset.patlang.
#
# Run from the repo root:
#   rust-runtime/target/release/pat --ir-run self_hosting/pset_selftest.patlang

include "lib/includes.patlang"
include "lib/gherkin.patlang"
include "lib/pset.patlang"

let ctx = ctx_new()

let empty = pset_new()
expect(ctx, "a new set has size 0", pset_size(empty), 0)
expect(ctx, "a new set does not contain an arbitrary item", pset_contains(empty, "Dune"), false)

let s1 = pset_add(empty, "Dune")
expect(ctx, "adding one item makes size 1", pset_size(s1), 1)
expect(ctx, "the set now contains the added item", pset_contains(s1, "Dune"), true)
expect(ctx, "the set does not contain something never added", pset_contains(s1, "Neuromancer"), false)

let s2 = pset_add(s1, "Neuromancer")
expect(ctx, "adding a second distinct item makes size 2", pset_size(s2), 2)
expect(ctx, "both items are present after the second add", pset_contains(s2, "Dune") and pset_contains(s2, "Neuromancer"), true)

let s3 = pset_add(s2, "Dune")
expect(ctx, "re-adding an existing item is a no-op on size", pset_size(s3), 2)
expect(ctx, "the original set is untouched by pset_add (functional, not mutating)", pset_size(s2), 2)

let s4 = pset_remove(s3, "Dune")
expect(ctx, "removing a present item drops the size by one", pset_size(s4), 1)
expect(ctx, "the removed item is no longer contained", pset_contains(s4, "Dune"), false)
expect(ctx, "the other item survives removal", pset_contains(s4, "Neuromancer"), true)

let s5 = pset_remove(s4, "not present at all")
expect(ctx, "removing an absent item is a no-op on size", pset_size(s5), 1)

let list_view = pset_to_list(s4)
expect(ctx, "pset_to_list exposes the same size", to_num(list_len(list_view)), 1)

expect(ctx, "a set equals itself", pset_equal(s2, s2), true)
expect(ctx, "two sets built via different add orders are equal", pset_equal(pset_add(pset_add(pset_new(), "a"), "b"), pset_add(pset_add(pset_new(), "b"), "a")), true)
expect(ctx, "sets of different size are not equal", pset_equal(s1, s2), false)
expect(ctx, "same size but different members are not equal", pset_equal(pset_add(pset_new(), "a"), pset_add(pset_new(), "b")), false)

ctx_report(ctx)
