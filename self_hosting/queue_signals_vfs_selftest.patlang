# Selftest for the VFS drivers of lib/queue.patlang and lib/signals.patlang
# (the drivers that work without files or tcp, so on every target including the
# browser), and for a signal crossing into an isolate.
#
# Run from the repo root:
#   rust-runtime/target/release/pat.exe --ir-run self_hosting/queue_signals_vfs_selftest.patlang

include "lib/includes.patlang"
include "lib/gherkin.patlang"
include "lib/queue.patlang"
include "lib/signals.patlang"
include "lib/isolate.patlang"

let ctx = ctx_new()
context_hold(ctx)

# --- queue on the vfs driver ---
queue_use_driver("vfs")
expect(ctx, "the driver is the one asked for", queue_driver(), "vfs")
expect(ctx, "an unseen topic has nothing pending", list_len(queue_pending("orders")), 0)
let m0 = queue_publish("orders", "first")
let m1 = queue_publish("orders", "second")
expect(ctx, "message ids count up", m1, m0 + 1)
expect(ctx, "both are pending", list_len(queue_pending("orders")), 2)
expect(ctx, "consume returns the oldest pending payload", queue_consume("orders"), "first")
expect(ctx, "consume does not ack", list_len(queue_pending("orders")), 2)
queue_ack("orders", m0)
expect(ctx, "ack removes only that message", list_len(queue_pending("orders")), 1)
expect(ctx, "the next consume is the next message", queue_consume("orders"), "second")
queue_ack("orders", m1)
expect(ctx, "everything acked leaves nothing pending", list_len(queue_pending("orders")), 0)
expect(ctx, "each message lives in its own vfs key (#120: one key per message, not one flat log)", vfs_exists("/queue/orders/0000000000"), "1")
expect(ctx, "no real file was written", file_exists(".patlang_queue/orders.log"), false)
expect(ctx, "no real file was written for the new per-message layout either", file_exists(".patlang_queue/orders"), false)

let seven = || do
  return 7
end
expect(ctx, "queue_attempt returns the action's result", queue_attempt("jobs", "job-1", seven), 7)
expect(ctx, "a completed attempt leaves nothing pending", list_len(queue_pending("jobs")), 0)

let ta = queue_writer_topic("multi", "a")
let tb = queue_writer_topic("multi", "b")
queue_publish(tb, "from b")
queue_publish(ta, "from a")
let cm = queue_consume_multi([ta, tb])
expect(ctx, "consume_multi checks topics in order", cm[1], "from a")
expect(ctx, "pending_multi spans topics", list_len(queue_pending_multi([ta, tb])), 2)

# --- signals on the vfs driver ---
signal_use_driver("vfs")
expect(ctx, "the signal driver is the one asked for", signal_driver(), "vfs")
expect(ctx, "the first claim of a port wins", signal_claim(9501), 9501)
expect(ctx, "a second claim of the same port is refused", signal_claim(9501), -1)
expect(ctx, "a different port is free", signal_claim(9502), 9502)

ctx_set(ctx, "sig_pings", 0)
when ping do
  let ctx = context_held()
  ctx_set(ctx, "sig_pings", ctx_num(ctx, "sig_pings") + 1)
end
when status do
  let ctx = context_held()
  signal_reply("alive, pings=" + ctx_text(ctx, "sig_pings"))
end

expect(ctx, "polling an empty port returns no signal", signal_poll(9501, 0), "")
signal_send(9501, "ping", "hello")
signal_send(9501, "ping", "again")
expect(ctx, "a sent signal waits until polled", mbox_count("sig/9501"), 2)
expect(ctx, "poll returns the signal's name", signal_poll(9501, 0), "ping")
expect(ctx, "poll fires the when handler", ctx_get(ctx, "sig_pings"), 1)
expect(ctx, "one signal is handled per poll", mbox_count("sig/9501"), 1)
signal_poll(9501, 0)
expect(ctx, "the second signal is handled next", ctx_get(ctx, "sig_pings"), 2)
expect(ctx, "a query gets the handler's reply", signal_query(9501, "status", ""), "alive, pings=2")
expect(ctx, "a query nobody handles gets an empty reply", signal_query(9501, "unknown_signal", ""), "")

# --- a signal into an isolate: parent sends, child polls during its turn ---
# Isolates need world_swap OR subprocess (host_caps). A native x64 program
# has no world_swap but does have subprocess+fs, so isolate_caps() there
# is "process" (self_hosting/lib/isolate_process.patlang's spawned-pat.exe
# turns), not empty -- this body is backend-agnostic (isolate_step picks
# whichever backend applies) and runs for real on both. Only a truly
# capability-less host hits the refusal below.
if list_len(isolate_caps()) == 0 then
  expect(ctx, "without world_swap or subprocess an isolate is refused, not half-run", isolate_ok(isolate_start(ctx, "print(1)", [])), false)
else
  let child = ""
  let child = child + "signal_use_driver(" + chr(34) + "vfs" + chr(34) + ")" + chr(10)
  let child = child + "when ping do" + chr(10)
  let child = child + "  signal_reply(" + chr(34) + "pong from the isolate" + chr(34) + ")" + chr(10)
  let child = child + "end" + chr(10)
  let child = child + "signal_poll(9601, 0)" + chr(10)
  let child_src = expand_includes("include " + chr(34) + "lib/signals.patlang" + chr(34) + chr(10) + child, "self_hosting")
  let h = isolate_start(ctx, child_src, [])
  expect(ctx, "the isolate compiles", isolate_ok(h), true)
  let mid = mbox_put_ns("/iso/" + h[0], "sig/9601", "parent", "ping" + chr(10) + "hello")
  let turn = isolate_step(ctx, h)
  expect(ctx, "the isolate's turn succeeded", turn[0], true)
  expect(ctx, "the isolate took the signal from its box", mbox_count_ns("/iso/" + h[0], "sig/9601"), 0)
  expect(ctx, "the reply is in the isolate's namespace", vfs_read("/iso/" + h[0] + "/sig/9601/reply/" + mid), "pong from the isolate")
end

ctx_report(ctx)
