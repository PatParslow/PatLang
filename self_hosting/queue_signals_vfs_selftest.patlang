# Selftest for the VFS drivers of lib/queue.patlang and lib/signals.patlang
# (the drivers that work without files or tcp, so on every target including the
# browser), and for a signal crossing into an isolate.
#
# Run from the repo root:
#   rust-runtime/target/release/pat.exe --ir-run self_hosting/queue_signals_vfs_selftest.patlang

include "lib/test.patlang"
include "lib/queue.patlang"
include "lib/signals.patlang"
include "lib/isolate.patlang"

t_init()

# --- queue on the vfs driver ---
queue_use_driver("vfs")
check("the driver is the one asked for", queue_driver(), "vfs")
check("an unseen topic has nothing pending", list_len(queue_pending("orders")), 0)
let m0 = queue_publish("orders", "first")
let m1 = queue_publish("orders", "second")
check("message ids count up", m1, m0 + 1)
check("both are pending", list_len(queue_pending("orders")), 2)
check("consume returns the oldest pending payload", queue_consume("orders"), "first")
check("consume does not ack", list_len(queue_pending("orders")), 2)
queue_ack("orders", m0)
check("ack removes only that message", list_len(queue_pending("orders")), 1)
check("the next consume is the next message", queue_consume("orders"), "second")
queue_ack("orders", m1)
check("everything acked leaves nothing pending", list_len(queue_pending("orders")), 0)
check("the log lives in the vfs", vfs_exists("/queue/orders.log"), "1")
check("no real file was written", file_exists(".patlang_queue/orders.log"), false)

let seven = || do
  return 7
end
check("queue_attempt returns the action's result", queue_attempt("jobs", "job-1", seven), 7)
check("a completed attempt leaves nothing pending", list_len(queue_pending("jobs")), 0)

let ta = queue_writer_topic("multi", "a")
let tb = queue_writer_topic("multi", "b")
queue_publish(tb, "from b")
queue_publish(ta, "from a")
let cm = queue_consume_multi([ta, tb])
check("consume_multi checks topics in order", cm[1], "from a")
check("pending_multi spans topics", list_len(queue_pending_multi([ta, tb])), 2)

# --- signals on the vfs driver ---
signal_use_driver("vfs")
check("the signal driver is the one asked for", signal_driver(), "vfs")
check("the first claim of a port wins", signal_claim(9501), 9501)
check("a second claim of the same port is refused", signal_claim(9501), -1)
check("a different port is free", signal_claim(9502), 9502)

set_var("sig_pings", 0)
when ping do
  set_var("sig_pings", get("__vars", "sig_pings") + 1)
end
when status do
  signal_reply("alive, pings=" + get("__vars", "sig_pings"))
end

check("polling an empty port returns no signal", signal_poll(9501, 0), "")
signal_send(9501, "ping", "hello")
signal_send(9501, "ping", "again")
check("a sent signal waits until polled", mbox_count("sig/9501"), 2)
check("poll returns the signal's name", signal_poll(9501, 0), "ping")
check("poll fires the when handler", get("__vars", "sig_pings"), 1)
check("one signal is handled per poll", mbox_count("sig/9501"), 1)
signal_poll(9501, 0)
check("the second signal is handled next", get("__vars", "sig_pings"), 2)
check("a query gets the handler's reply", signal_query(9501, "status", ""), "alive, pings=2")
check("a query nobody handles gets an empty reply", signal_query(9501, "unknown_signal", ""), "")

# --- a signal into an isolate: parent sends, child polls during its turn ---
let child = ""
let child = child + "signal_use_driver(" + chr(34) + "vfs" + chr(34) + ")" + chr(10)
let child = child + "when ping do" + chr(10)
let child = child + "  signal_reply(" + chr(34) + "pong from the isolate" + chr(34) + ")" + chr(10)
let child = child + "end" + chr(10)
let child = child + "signal_poll(9601, 0)" + chr(10)
let child_src = expand_includes("include " + chr(34) + "lib/signals.patlang" + chr(34) + chr(10) + child, "self_hosting")
let h = isolate_start(child_src, [])
check("the isolate compiles", isolate_ok(h), true)
let mid = mbox_put_ns("/iso/" + h[0], "sig/9601", "parent", "ping" + chr(10) + "hello")
let turn = isolate_step(h)
check("the isolate's turn succeeded", turn[0], true)
check("the isolate took the signal from its box", mbox_count_ns("/iso/" + h[0], "sig/9601"), 0)
check("the reply is in the isolate's namespace", vfs_read("/iso/" + h[0] + "/sig/9601/reply/" + mid), "pong from the isolate")

t_report()
