# Validates lib/regex_dsl.patlang (the self-hosted-dialect regex engine)
# by running it through the actual self-hosted pipeline: the self-hosted
# lexer/parser/lower tokenize+parse+lower the engine's own source (which
# uses do/end blocks and |params| do ... end closures, so it must go
# through lib/lexer.patlang + lib/parser.patlang, not the Rust CLI's own
# parser), then run_ir executes the result directly (no rustc needed) --
# same mechanism the in-browser playground uses.
#
# Run from the repo root:
#   rust-runtime/target/debug/pat --ir-run self_hosting/regex_dsl_selftest.patlang

include "lib/lexer.patlang"
include "lib/parser.patlang"
include "lib/lower.patlang"

let engine_src = read_file("self_hosting/lib/regex_dsl.patlang")
let cases_src = read_file("self_hosting/examples/regex_dsl_selftest_cases.patlang")
let src = engine_src + chr(10) + cases_src

let toks = tokenize(src)
print("tokens: " + vec_len(toks))

let ast = parse_program(toks)
let stmts = ast[1]
let i = 0
let errs = 0
while i < stmts.length {
    let s = stmts[i]
    if s[0] == "Err" {
        print("parse error: " + s[1])
        let errs = errs + 1
    }
    let i = i + 1
}
print("parse errors: " + errs)

if errs == 0 {
    let ir = lower_program(ast)
    run_ir(ir)
}
