# Selftest for self_hosting/lib/regex_vm.patlang: regular expressions for
# programs, matched by a Pike VM (no backtracking, so a match costs time in
# proportion to the text times the pattern, and nothing recurses per
# character).
#
# Given patterns with classes, escapes, groups, alternation, greedy and lazy
# quantifiers, counted repeats and anchors, when each is found in or replaced
# through a text, then the leftmost match is the one a backtracking engine
# (Perl, Python, JavaScript) gives, every non-overlapping match is replaced, an
# empty match moves on one character, non-ASCII text is matched by character,
# a pattern that does not parse says why, and replacing through a text twice as
# long takes about twice as long.

include "lib/includes.patlang"
include "lib/gherkin.patlang"
include "lib/regex_vm.patlang"
include "lib/cost_check.patlang"

let ctx = ctx_new()

# finding
expect(ctx, "digits are found where they start and end", regex_find("abc123def", "\\d+", 0), [3, 6])
expect(ctx, "a search from a later start finds the later match", regex_find("a1b22", "\\d+", 2), [3, 5])
expect(ctx, "no match gives -1, -1", regex_find("abc", "\\d", 0), [0 - 1, 0 - 1])
expect(ctx, "regex_test says whether there is a match", [regex_test("x-y", "-"), regex_test("xy", "-")], [true, false])
expect(ctx, "a counted repeat takes as many as it may", regex_find("aaaa", "a{2,3}", 0), [0, 3])
expect(ctx, "an exact count", regex_find("aaaa", "a{2}", 1), [1, 3])
expect(ctx, "the leftmost alternative that matches wins", regex_find("abcd", "ab|abcd", 0), [0, 2])

# replacing
expect(ctx, "every match is replaced", regex_replace("a1b22c333", "\\d+", "#"), "a#b#c#")
expect(ctx, "tags are stripped", regex_replace("<b>x</b><i>y</i>", "<[^>]+>", ""), "xy")
expect(ctx, "a lazy repeat stops at the first close", regex_replace("<script>a</script>keep<script>b</script>", "<script>[\\s\\S]*?</script>", " "), " keep ")
expect(ctx, "a greedy repeat runs to the last close", regex_replace("<script>a</script>keep<script>b</script>", "<script>[\\s\\S]*</script>", " "), " ")
expect(ctx, "white space is collapsed", regex_replace("a  \n\t b", "\\s+", " "), "a b")
expect(ctx, "groups and alternation", regex_replace("cat dog cow", "c(at|ow)", "X"), "X dog X")
expect(ctx, "an optional character", regex_replace("https://x.org and http://y", "https?://", ""), "x.org and y")
expect(ctx, "a negated class with ranges", regex_replace("a-b.c d", "[^a-zA-Z0-9_]", "_"), "a_b_c_d")
expect(ctx, "\\S \\W \\D are the complements", [regex_replace("a b", "\\S", "x"), regex_replace("a-b", "\\W", "+"), regex_replace("a1", "\\D", "z")], ["x x", "a+b", "z1"])
expect(ctx, "^ matches at the start only", regex_replace("aaa", "^a", "b"), "baa")
expect(ctx, "$ matches at the end only", regex_replace("aaa", "a$", "b"), "aab")
expect(ctx, "\\b matches at a word's edges", regex_replace("cat concat", "\\bcat", "dog"), "dog concat")
expect(ctx, "an empty match moves on one character", regex_replace("abc", "x*", "-"), "-a-b-c-")
expect(ctx, "a lazy optional prefers none", regex_find("aa", "a??a", 0), [0, 1])
expect(ctx, "escaped specials are literal", regex_replace("1+1=2.", "\\+|\\.", "!"), "1!1=2!")
expect(ctx, "non-ASCII text is matched by character", regex_replace("café au lait", "é", "e"), "cafe au lait")
expect(ctx, "a class holds non-ASCII characters", regex_replace("naïve", "[ïé]", "i"), "naive")
expect(ctx, "all matches are listed", regex_find_all("a1b22c333", "\\d+"), ["1", "22", "333"])

# a pattern that does not parse
let bad = regex_compile("(ab")
expect(ctx, "an unclosed group does not compile", bad[0], false)
expect(ctx, "and says so", str_contains(bad[1], "never closed"), true)
expect(ctx, "a repeat of nothing does not compile", regex_compile("*a")[0], false)

# scaling: a text twice as long takes about twice as long
make a function called rx_bench takes n returns cycles
  let b = sb_new()
  let i = 0
  while i < n do
    sb_push(b, "<p>word ")
    sb_push(b, "" + i)
    sb_push(b, "</p>\n")
    let i = i + 1
  end
  let text = sb_str(b)
  let t0 = cpu_cycles()
  let out = regex_replace(text, "<[^>]+>", "")
  let cycles = cpu_cycles() - t0
  return cycles
end
# each time the cheapest of several readings after a warm-up
# (lib/cost_check.patlang, #284)
let c = cheapest_cycles([|| do return rx_bench(1000) end, || do return rx_bench(2000) end, || do return rx_bench(4000) end], cost_rounds())
expect(ctx, "replacing through 4000 lines takes at most 3 times 2000's", c[2] <= 3 * c[1], true)
expect(ctx, "and 2000 at most 3 times 1000's", c[1] <= 3 * c[0], true)

ctx_report(ctx)
