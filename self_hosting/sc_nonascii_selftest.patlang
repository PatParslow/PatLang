# Interned-string access (str_intern / sc_len / sc_code / sc_char / sc_substr)
# must stay O(1) per call when the string contains a non-ASCII character.
# Before the char index existed, one em dash anywhere in a source file sent
# every sc_* call through chars().nth(i), turning a lexer-style scan of the
# whole string quadratic (a 250 KB flattened source took 130 s to compile in
# the browser playground).
#
# Run from the repo root:
#   self_hosting/build/v2_interp.exe self_hosting/sc_nonascii_selftest.patlang

include "lib/includes.patlang"
include "lib/gherkin.patlang"
include "lib/cost_check.patlang"

# The cycles a scan of a string of n plain characters after one em dash
# takes (the string made before the reading starts).
make a function called sns_scan_cycles takes n returns c
  let b = sb_new()
  sb_push(b, "—")
  let i = 0
  while i < n do
    sb_push(b, "a")
    let i = i + 1
  end
  let h = str_intern(sb_str(b))
  let t0 = cpu_cycles()
  let total = 0
  let j = 0
  let len = sc_len(h)
  while j < len do
    let total = total + sc_code(h, j)
    let j = j + 1
  end
  return cpu_cycles() - t0
end

let ctx = ctx_new()

# --- correctness on non-ASCII text ---
let h = str_intern("héllo—wörld")
expect(ctx, "sc_len counts characters, not bytes", sc_len(h), 11)
expect(ctx, "sc_code of an accented letter", sc_code(h, 1), 233)
expect(ctx, "sc_code of an em dash", sc_code(h, 5), 8212)
expect(ctx, "sc_code just past the end is -1", sc_code(h, 11), -1)
expect(ctx, "sc_char of an accented letter", sc_char(h, 1), "é")
expect(ctx, "sc_char of a plain letter after non-ASCII text", sc_char(h, 6), "w")
expect(ctx, "sc_char past the end is empty", sc_char(h, 99), "")
expect(ctx, "sc_substr spans non-ASCII characters", sc_substr(h, 4, 4), "o—wö")
expect(ctx, "sc_substr clamps at the end", sc_substr(h, 9, 10), "ld")
let ascii = str_intern("plain")
expect(ctx, "ASCII strings still index by byte", sc_code(ascii, 4), 110)

# --- scaling: a scan over a string with one non-ASCII char is linear ---
# Each doubling of the input should about double the cost; a quadratic scan
# would take four times as much. Each cost is the cheapest of several
# cpu_cycles readings after a warm-up (lib/cost_check.patlang, #284): the
# clock's time from one reading each failed under the gates' load (gates run
# 15: 671 ms against 212 ms).
let sizes = [50000, 100000, 200000, 400000]
let readers = []
let k = 0
while k < list_len(sizes) do
  let n = sizes[k]
  let readers = list_push(readers, || do return sns_scan_cycles(n) end)
  let k = k + 1
end
let cs = cheapest_cycles(readers, cost_rounds())
let k = 1
while k < list_len(sizes) do
  # 20 million cycles of slack keep a short run from being decided by a stray
  # interruption
  expect(ctx, "scanning " + sizes[k] + " chars costs under 3x as much as " + sizes[k - 1] + " (" + cs[k] + " cycles against " + cs[k - 1] + ")", cs[k] < (cs[k - 1] + 20000000) * 3, true)
  let k = k + 1
end

ctx_report(ctx)
