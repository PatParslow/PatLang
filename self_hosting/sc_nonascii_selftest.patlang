# Interned-string access (str_intern / sc_len / sc_code / sc_char / sc_substr)
# must stay O(1) per call when the string contains a non-ASCII character.
# Before the char index existed, one em dash anywhere in a source file sent
# every sc_* call through chars().nth(i), turning a lexer-style scan of the
# whole string quadratic (a 250 KB flattened source took 130 s to compile in
# the browser playground).
#
# Run from the repo root:
#   rust-runtime/target/release/pat.exe --ir-run self_hosting/sc_nonascii_selftest.patlang

include "lib/test.patlang"

make a function called sns_scan_ms takes n returns ms
  let b = sb_new()
  sb_push(b, "—")
  let i = 0
  while i < n do
    sb_push(b, "a")
    let i = i + 1
  end
  let h = str_intern(sb_str(b))
  let t0 = now_ms()
  let total = 0
  let j = 0
  let len = sc_len(h)
  while j < len do
    let total = total + sc_code(h, j)
    let j = j + 1
  end
  return now_ms() - t0
end

t_init()

# --- correctness on non-ASCII text ---
let h = str_intern("héllo—wörld")
check("sc_len counts characters, not bytes", sc_len(h), 11)
check("sc_code of an accented letter", sc_code(h, 1), 233)
check("sc_code of an em dash", sc_code(h, 5), 8212)
check("sc_code just past the end is -1", sc_code(h, 11), -1)
check("sc_char of an accented letter", sc_char(h, 1), "é")
check("sc_char of a plain letter after non-ASCII text", sc_char(h, 6), "w")
check("sc_char past the end is empty", sc_char(h, 99), "")
check("sc_substr spans non-ASCII characters", sc_substr(h, 4, 4), "o—wö")
check("sc_substr clamps at the end", sc_substr(h, 9, 10), "ld")
let ascii = str_intern("plain")
check("ASCII strings still index by byte", sc_code(ascii, 4), 110)

# --- scaling: a scan over a string with one non-ASCII char is linear ---
let small = sns_scan_ms(50000)
let large = sns_scan_ms(200000)
check("scanning 200000 chars with a non-ASCII char finishes in under 300 ms", large < 300, true)
check("4x the input costs well under 16x the time", large < (small + 20) * 8, true)

t_report()
