# Minimal end-to-end shape lowering smoke test
# Program: let x = 2; print(x)

let prog = map_new()
map_set(prog, "type", "Program")

let stmts = list_new()

let v = map_new()
map_set(v, "type", "Number")
map_set(v, "value", "2")

let letstmt = map_new()
map_set(letstmt, "type", "Let")
map_set(letstmt, "name", "x")
map_set(letstmt, "value", v)

let id = map_new()
map_set(id, "type", "Identifier")
map_set(id, "name", "x")

let s = map_new()
map_set(s, "type", "Print")
map_set(s, "expr", id)

stmts.add(letstmt)
stmts.add(s)
map_set(prog, "stmts", stmts)

let out = lower_and_compile(prog, "./shape_smoke.exe")
print(out)
