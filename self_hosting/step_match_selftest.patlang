# Selftest for parametrised Gherkin steps (self_hosting/lib/step_match.patlang
# and the pattern dispatch in lib/test.patlang): a step registered with
# {placeholders} matches any line of that shape and hands the captured text
# to its function through step_arg(name), so one function covers every
# spelling of a step instead of one hand-written function per literal line.
#
# Run from the repo root:
#   rust-runtime/target/release/pat.exe --ir-run self_hosting/step_match_selftest.patlang

include "lib/includes.patlang"
include "lib/gherkin.patlang"
include "lib/step_match.patlang"

# ---- the matcher on its own ----

make a function called capture_of takes result, name returns v
  let caps = result[1]
  let i = 0
  let n = to_num(list_len(caps))
  while i < n do
    if caps[i][0] == name then
      return caps[i][1]
    end
    let i = i + 1
  end
  return "<none>"
end

# ---- steps through the real Gherkin runner ----

make a function called st_holds takes ctx returns done
  ctx_set(ctx, "sm_last_holds", step_arg(ctx, "title"))
  return true
end

make a function called st_borrows takes ctx returns done
  ctx_set(ctx, "sm_last_member", step_arg(ctx, "member"))
  ctx_set(ctx, "sm_last_title", step_arg(ctx, "title"))
  return true
end

make a function called st_exact takes ctx returns done
  ctx_set(ctx, "sm_exact_hit", 1)
  return true
end

make a function called sm_feature returns text
  return "Feature: Parametrised steps

Scenario: Two different titles reach the same step function
  Given the library holds \"Dune\"
  And the library holds \"Foundation\"
  When \"A. Diallo\" borrows \"Neuromancer\"
  Then an exact step still works
"
end

let ctx = ctx_new()

# matcher: literal text, one placeholder
let r1 = sm_match("the library holds \"{title}\"", "the library holds \"Dune\"")
expect(ctx, "matcher accepts a line of the template's shape", r1[0], "ok")
expect(ctx, "matcher captures the placeholder text", capture_of(r1, "title"), "Dune")

# matcher: two placeholders separated by a literal
let r2 = sm_match("\"{member}\" borrows \"{title}\"", "\"A. Diallo\" borrows \"Neuromancer\"")
expect(ctx, "two placeholders both captured (first)", capture_of(r2, "member"), "A. Diallo")
expect(ctx, "two placeholders both captured (second)", capture_of(r2, "title"), "Neuromancer")

# matcher: a line of a different shape is rejected
let r3 = sm_match("the library holds \"{title}\"", "the library sells \"Dune\"")
expect(ctx, "matcher rejects a line of a different shape", r3[0], "no")

# matcher: an empty capture is rejected
let r4 = sm_match("the library holds \"{title}\"", "the library holds \"\"")
expect(ctx, "matcher rejects an empty capture", r4[0], "no")

# matcher: a template with no placeholder matches only itself
let r5 = sm_match("an exact step still works", "an exact step still works")
expect(ctx, "placeholder-free template matches its own text", r5[0], "ok")
expect(ctx, "placeholder-free template captures nothing", to_num(list_len(r5[1])), 0)

# runner: parametrised steps dispatch with their captures, exact steps unchanged
step(ctx, "the library holds \"{title}\"", "st_holds")
step(ctx, "\"{member}\" borrows \"{title}\"", "st_borrows")
step(ctx, "an exact step still works", "st_exact")
run_feature(ctx, sm_feature())

expect(ctx, "parametrised Given ran with its own capture (last one wins)", ctx_get(ctx, "sm_last_holds"), "Foundation")
expect(ctx, "parametrised When captured the member", ctx_get(ctx, "sm_last_member"), "A. Diallo")
expect(ctx, "parametrised When captured the title", ctx_get(ctx, "sm_last_title"), "Neuromancer")
expect(ctx, "an exact-text step still dispatches beside patterns", ctx_get(ctx, "sm_exact_hit"), 1)

# ---- sm_fill: the inverse of sm_match ----
expect(ctx, "a single placeholder is filled from its binding", sm_fill("{item} is in stock", [["item", "cookie"]]), "cookie is in stock")
expect(ctx, "multiple placeholders are each filled", sm_fill("\"{member}\" borrows \"{title}\"", [["member", "A. Diallo"], ["title", "Dune"]]), "\"A. Diallo\" borrows \"Dune\"")
expect(ctx, "a numeric value is written without quotes", sm_fill("Bowen inserts {amount} dollars", [["amount", 10]]), "Bowen inserts 10 dollars")
expect(ctx, "a missing binding leaves the placeholder visible", sm_fill("{item} is in stock", []), "{item} is in stock")
expect(ctx, "filling then matching round-trips the same binding", sm_match("{item} is in stock", sm_fill("{item} is in stock", [["item", "chips"]]))[1][0][1], "chips")

ctx_report(ctx)
