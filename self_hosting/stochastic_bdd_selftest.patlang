# Selftest for stochastic BDD verification (self_hosting/lib/
# stochastic_bdd.patlang), motivated directly by fantpop-patlang's
# marriage-eligibility correction: cross-class and same-sex marriage are
# both valid, just less common than same-class/opposite-sex -- a
# probabilistic preference, not a hard rule, so exact-match BDD can't
# verify it. This selftest proves the tolerance-band mechanism itself
# works: a correctly-implemented ~30% event (fantpop's actual birth-
# chance base rate, self_hosting/../../fantpop-patlang/docs/
# reverse_engineering_notes.md) passes; a deliberately mismatched
# declared probability against the same trials correctly fails.
#
# PatLang has no RNG host function, so trials use a small seeded LCG
# (same pattern as self_hosting/examples/cga_classifier.patlang) rather
# than any new host capability -- pure PatLang, nothing new needed to
# exercise this.

include "lib/test.patlang"
include "lib/stochastic_bdd.patlang"

t_init()

make a function called rand_seed takes seed returns done
  let s = seed % 2147483647
  let s2 = s
  if s <= 0 then
    let s2 = 1
  end
  set_var("stoch_rand", s2)
  return true
end

make a function called rand_next returns r
  let s = to_num(get("__vars", "stoch_rand"))
  let s2 = (s * 48271) % 2147483647
  set_var("stoch_rand", s2)
  return s2
end

# A trial with a true fantpop.rb constant: birth chance base rate 30%
# (docs/reverse_engineering_notes.md's "Numeric mechanics" section).
make a function called birth_trial returns happened
  let roll = rand_next() % 100
  return roll < 30
end

rand_seed(42)
let n = 2000
let successes = 0
let i = 0
while i < n do
  if birth_trial() then
    let successes = successes + 1
  end
  let i = i + 1
end
stochastic_check("birth_trial's actual rate matches the declared 30% base chance", successes, n, 0.3, 3)

# ---- proving detection: the SAME trial data, checked against a
# deliberately wrong declared probability, must correctly fail ----
let wrongly_ok = stochastic_within_tolerance(successes, n, 0.7, 3)
check("a genuinely mismatched declared probability (0.7 vs the real ~0.3) is correctly detected as failing", wrongly_ok, false)

# ---- the tolerance band should still be reasonable at a much smaller
# sample size (looser band, same mechanism) ----
rand_seed(7)
let n_small = 100
let successes_small = 0
let j = 0
while j < n_small do
  if birth_trial() then
    let successes_small = successes_small + 1
  end
  let j = j + 1
end
stochastic_check("the same mechanism also works at a much smaller sample size", successes_small, n_small, 0.3, 3)

t_report()
