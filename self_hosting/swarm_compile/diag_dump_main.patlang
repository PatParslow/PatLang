make a function called x64_name_in_list takes names, name returns yes
  let n = names.length
  let i = 0
  while i < n do
    if names[i] == name then
      return true
    end
    let i = i + 1
  end
  return false
end

let args = argv()
let bundle_path = args[0]
let rt_names_file = "self_hosting/build/x64_runtime.funcs"
let rt_names = split_lines(read_file(rt_names_file))
let src = expand_includes(read_file(bundle_path), path_dirname(bundle_path))
let toks = tokenize(src)
let ast = parse_program(toks)
let ir = bm_patc_lower(ast, rt_names)
let all_funcs = ir[2]
print("total funcs: " + to_num(list_len(all_funcs)))
let i = 0
while i < list_len(all_funcs) do
  if all_funcs[i][1] == "main" then
    print("main func_ir: " + json_stringify(to_json_value(all_funcs[i])))
  end
  if all_funcs[i][1] == "mbox_prefix" then
    print("mbox_prefix func_ir: " + json_stringify(to_json_value(all_funcs[i])))
  end
  if all_funcs[i][1] == "x64_assemble_chunk" then
    print("x64_assemble_chunk func_ir (first 500 chars): " + substr(json_stringify(to_json_value(all_funcs[i])), 0, 500))
  end
  let i = i + 1
end
