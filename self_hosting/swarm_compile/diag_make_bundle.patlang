# One-off scratch-file generator for phase1_bench.patlang's real-scale
# measurement: flattens a pure-library .patlang file (no top-level
# statements of its own) via the SAME expand_includes the ordinary
# CLI uses, then appends ONE trivial top-level statement.
#
# WHY: confirmed directly (self_hosting/swarm_compile/diag_dump_main.
# patlang) that bm_patc_lower synthesizes a CORRUPTED "main" FuncIR --
# containing another real function's own body, not an empty one -- for
# a source unit with ZERO top-level statements. A source with at least
# one real top-level statement (e.g. this project's own fixtures all
# end with a bare call like `start()`) lowers "main" correctly. This
# is a separate, previously-unknown bug from the `__loop_exit_N` one
# (which needs a top-level WHILE loop specifically); out of scope to
# fix (same reasoning as the loop-exit exclusion: it's inside self_
# hosting/block_model/lower.patlang, which this work must not touch).
# Appending one harmless statement is the cheapest way to route around
# it for a TIMING measurement that was never going to run/link the
# result anyway.
include "../lib/includes.patlang"

let args = argv()
let src_path = args[0]
let out_path = args[1]
let expanded = expand_includes(read_file(src_path), path_dirname(src_path))
write_file(out_path, expanded + chr(10) + "print(\"bench\")" + chr(10))
print("wrote " + out_path + " (" + expanded.length + " + trailer chars)")
