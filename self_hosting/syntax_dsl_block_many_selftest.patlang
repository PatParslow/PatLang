# Validates the Block/Many/${...} extensions to lib/syntax_dsl.patlang: a
# `loopy { ... }` DSL whose WhileLine rule uses `expect Block` (a
# multi-line, brace-delimited loop body) and whose SwitchLine/CaseClause
# rules use `expect Many(CaseClause)` plus `expect Block` again for each
# case body -- run through the real self-hosted lexer/parser/lower/interp
# pipeline, same pattern as syntax_dsl_selftest.patlang.
#
# Run from the repo root:
#   rust-runtime/target/release/pat --ir-run self_hosting/syntax_dsl_block_many_selftest.patlang

include "lib/lexer.patlang"
include "lib/parser.patlang"
include "lib/lower.patlang"

let engine_src = read_file("self_hosting/lib/regex_dsl.patlang")
let preprocessor_src = read_file("self_hosting/lib/syntax_dsl.patlang")

let driver = engine_src + chr(10) + preprocessor_src + chr(10)
  + "let dsl_src = read_file(\"self_hosting/examples/block_many_dsl_source.patlang\")" + chr(10)
  + "let expanded = expand_syntax_dsls(dsl_src)" + chr(10)
  + "print(\"---EXPANDED---\")" + chr(10)
  + "print(expanded)" + chr(10)
  + "print(\"---END---\")" + chr(10)
  + "write_file(\"self_hosting/build/block_many_dsl_expanded.patlang\", expanded)" + chr(10)

let toks = tokenize(driver)
print("tokens: " + vec_len(toks))

let ast = parse_program(toks)
let stmts = ast[1]
let i = 0
let errs = 0
while i < stmts.length {
    let s = stmts[i]
    if s[0] == "Err" {
        print("parse error: " + s[1])
        let errs = errs + 1
    }
    let i = i + 1
}
print("parse errors: " + errs)

if errs == 0 {
    let ir = lower_program(ast)
    run_ir(ir)
}
