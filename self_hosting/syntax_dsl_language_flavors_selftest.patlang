# Expands each language-flavored `syntax { ... }` DSL example
# (self_hosting/examples/language_flavors/*_source.patlang) through the
# real self-hosted lib/syntax_dsl.patlang preprocessor, prints the result,
# and writes it to self_hosting/build/ so it can be run directly through
# the real pipeline as a separate verification step (same two-step pattern
# as syntax_dsl_block_many_selftest.patlang).
#
# Run from the repo root:
#   rust-runtime/target/release/pat --ir-run self_hosting/syntax_dsl_language_flavors_selftest.patlang

include "lib/lexer.patlang"
include "lib/parser.patlang"
include "lib/lower.patlang"

let engine_src = read_file("self_hosting/lib/regex_dsl.patlang")
let preprocessor_src = read_file("self_hosting/lib/syntax_dsl.patlang")

let driver = engine_src + chr(10) + preprocessor_src + chr(10)
  + "let java_src = read_file(\"self_hosting/examples/language_flavors/java_ese_source.patlang\")" + chr(10)
  + "let java_out = expand_syntax_dsls(java_src)" + chr(10)
  + "print(\"---JAVA---\")" + chr(10)
  + "print(java_out)" + chr(10)
  + "write_file(\"self_hosting/build/java_ese_expanded.patlang\", java_out)" + chr(10)
  + "let cpp_src = read_file(\"self_hosting/examples/language_flavors/cpp_ese_source.patlang\")" + chr(10)
  + "let cpp_out = expand_syntax_dsls(cpp_src)" + chr(10)
  + "print(\"---CPP---\")" + chr(10)
  + "print(cpp_out)" + chr(10)
  + "write_file(\"self_hosting/build/cpp_ese_expanded.patlang\", cpp_out)" + chr(10)
  + "let py_src = read_file(\"self_hosting/examples/language_flavors/python_ese_source.patlang\")" + chr(10)
  + "let py_out = expand_syntax_dsls(py_src)" + chr(10)
  + "print(\"---PYTHON---\")" + chr(10)
  + "print(py_out)" + chr(10)
  + "write_file(\"self_hosting/build/python_ese_expanded.patlang\", py_out)" + chr(10)

let toks = tokenize(driver)
print("tokens: " + vec_len(toks))

let ast = parse_program(toks)
let stmts = ast[1]
let i = 0
let errs = 0
while i < stmts.length {
    let s = stmts[i]
    if s[0] == "Err" {
        print("parse error: " + s[1])
        let errs = errs + 1
    }
    let i = i + 1
}
print("parse errors: " + errs)

if errs == 0 {
    let ir = lower_program(ast)
    run_ir(ir)
}
