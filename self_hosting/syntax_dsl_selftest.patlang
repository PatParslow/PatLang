# Validates lib/syntax_dsl.patlang (the self-hosted DSL-block preprocessor)
# against the literal RouterDSL example, run through the real self-hosted
# pipeline: lexer/parser/lower tokenize+parse+lower this driver's own code,
# and the *preprocessor itself* runs as ordinary function calls
# (expand_syntax_dsls is called at runtime -- it operates on raw text, not
# on tokens, so it needs no special parser support).
#
# Run from the repo root:
#   rust-runtime/target/debug/pat --ir-run self_hosting/syntax_dsl_selftest.patlang

include "lib/lexer.patlang"
include "lib/parser.patlang"
include "lib/lower.patlang"

let engine_src = read_file("self_hosting/lib/regex_dsl.patlang")
let preprocessor_src = read_file("self_hosting/lib/syntax_dsl.patlang")

# `expand_syntax_dsls` needs to run as PatLang code itself (it's written in
# the do/end dialect), so we tokenize/parse/lower the engine + preprocessor
# together with a small tail that re-reads the router example itself (via
# read_file, available to the compiled program's own host environment) and
# prints the expansion -- avoids having to escape the example's content into
# a string literal here.
let driver = engine_src + chr(10) + preprocessor_src + chr(10)
  + "let router_src = read_file(\"self_hosting/examples/router_dsl_source.patlang\")" + chr(10)
  + "print(expand_syntax_dsls(router_src))" + chr(10)

let toks = tokenize(driver)
print("tokens: " + vec_len(toks))

let ast = parse_program(toks)
let stmts = ast[1]
let i = 0
let errs = 0
while i < stmts.length {
    let s = stmts[i]
    if s[0] == "Err" {
        print("parse error: " + s[1])
        let errs = errs + 1
    }
    let i = i + 1
}
print("parse errors: " + errs)

if errs == 0 {
    let ir = lower_program(ast)
    run_ir(ir)
}
