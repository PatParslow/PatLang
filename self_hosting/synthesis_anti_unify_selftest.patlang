# Milestone 7 selftest for the general anti-unification engine
# (self_hosting/lib/synthesis_anti_unify.patlang). Three scenarios prove
# the new literal-list representation subsumes milestone 3 (pure unary
# conjunction) and milestones 4-6 (pure binary chain) separately, then a
# flagship scenario proves it can COMPOSE them -- a chain ending in a
# conjunctive filter condition, which neither prior module could induce
# on its own.

include "lib/test.patlang"
include "lib/synthesis.patlang"
include "lib/synthesis_anti_unify.patlang"

t_init()

# ---- scenario A: pure conjunction (no relational chain at all) --
# the milestone-3 case, now going through the general engine ----
let facts_a = [
  synth5_fact_unary("has_job", "alice"),
  synth5_fact_unary("good_credit", "alice"),
  synth5_fact_unary("has_job", "dave"),
  synth5_fact_unary("good_credit", "dave"),
  synth5_fact_unary("is_student", "dave")
]
let queries_a = [
  synth2_query("eligible", "alice", true),
  synth2_query("eligible", "dave", true),
  synth2_query("eligible", "bob", false)
]
let result_a = synth7_induce("eligible", ["alice", "dave"], queries_a, facts_a, 2)
check("scenario A: pure conjunction succeeds", result_a[0], "ok")
check("scenario A: no relational chain induced", to_num(list_len(result_a[1][0])), 0)
check("scenario A: the distractor is_student does not survive", synth_list_contains(result_a[1][1][0], "is_student"), false)
check("scenario A: has_job survives", synth_list_contains(result_a[1][1][0], "has_job"), true)
check("scenario A: good_credit survives", synth_list_contains(result_a[1][1][0], "good_credit"), true)

# ---- scenario B: pure chain (no unary filter needed) -- the
# milestone-4/5/6 grandparent case, now going through the general engine ----
let facts_b = [
  synth5_fact_binary("parent", "alice2", "bob2"),
  synth5_fact_binary("parent", "bob2", "carol2"),
  synth5_fact_binary("parent", "dave3", "erin3"),
  synth5_fact_binary("parent", "erin3", "frank3")
]
let queries_b = [
  synth2_query("grandparent", "alice2", true),
  synth2_query("grandparent", "dave3", true)
]
let result_b = synth7_induce("grandparent", ["alice2", "dave3"], queries_b, facts_b, 2)
check("scenario B: pure chain succeeds", result_b[0], "ok")
check("scenario B: induces the expected 2-hop chain", to_num(list_len(result_b[1][0])), 2)
check("scenario B: no unary literals leak in (no unary facts exist in this domain)", to_num(list_len(result_b[1][1][2])), 0)

# ---- scenario C (flagship): a chain ENDING in a conjunctive filter --
# "young_grandparent" -- neither milestone 3 (no chains) nor milestones
# 4-6 (no unary filters) could induce this alone. Also includes a
# distractor unary fact (erin2 is a "manager") on an INTERMEDIATE node,
# to prove it's correctly dropped by intersection even mid-chain, not
# just at the endpoint.
let facts_c = [
  synth5_fact_binary("parent", "alice3", "bob3"),
  synth5_fact_binary("parent", "bob3", "carol3"),
  synth5_fact_unary("young", "carol3"),
  synth5_fact_binary("parent", "dave4", "erin4"),
  synth5_fact_binary("parent", "erin4", "frank4"),
  synth5_fact_unary("young", "frank4"),
  synth5_fact_unary("manager", "erin4"),
  synth5_fact_binary("parent", "george2", "henry2"),
  synth5_fact_binary("parent", "ida2", "jack2"),
  synth5_fact_binary("parent", "jack2", "kevin2")
]
let queries_c = [
  synth2_query("young_grandparent", "alice3", true),
  synth2_query("young_grandparent", "dave4", true),
  synth2_query("young_grandparent", "george2", false),
  synth2_query("young_grandparent", "ida2", false)
]
let result_c = synth7_induce("young_grandparent", ["alice3", "dave4"], queries_c, facts_c, 2)
check("scenario C: the composed chain+filter rule succeeds", result_c[0], "ok")
check("scenario C: induces the expected 2-hop chain", to_num(list_len(result_c[1][0])), 2)
check("scenario C: the mid-chain manager distractor does not survive", synth_list_contains(result_c[1][1][1], "manager"), false)
check("scenario C: the shared 'young' filter on the grandchild survives", synth_list_contains(result_c[1][1][2], "young"), true)

# ---- round-trip check on the flagship scenario ----
let clause_src = synth7_emit_clause("young_grandparent", result_c[1])
let background_src = synth5_facts_to_src(facts_c)
let program_src = background_src + "\n" + clause_src +
  "\nlet sols_alice = solve(\"young_grandparent\", [\"" + synth2_ground("alice3") + "\"])\n" +
  "print(to_num(list_len(sols_alice)) > 0)\n" +
  "let sols_george = solve(\"young_grandparent\", [\"" + synth2_ground("george2") + "\"])\n" +
  "print(to_num(list_len(sols_george)) > 0)\n" +
  "let sols_ida = solve(\"young_grandparent\", [\"" + synth2_ground("ida2") + "\"])\n" +
  "print(to_num(list_len(sols_ida)) > 0)\n"
let out_path = "self_hosting/build/synth_anti_unify_demo.patlang"
write_file(out_path, program_src)
let compiled_exe = "self_hosting/build/synth_anti_unify_demo.exe"
let build = exec_capture("./patc1.exe", out_path, compiled_exe)
check("generated composed chain+filter source compiles via patc1.exe", contains_text(build, "error"), false)
let run_out = exec_capture(compiled_exe)
check("compiled program: alice3 is a young-grandparent, george2 has no grandchild, ida2's grandchild isn't young", run_out, "true\nfalse\nfalse\n\n")

t_report()
