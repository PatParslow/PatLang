# Milestone 12 selftest for cross-entity attribute comparison
# (self_hosting/lib/synthesis_attr.patlang): induces same_class(X, Y)
# and diff_sex(X, Y) -- the exact fantpop-patlang scenario (marriage
# eligibility: same social class OR different sex, both comparisons of
# two individuals' attribute VALUES against each other) that was fully
# blocked before this milestone landed. Also proves the new `neq/2`
# built-in comparison predicate genuinely works: same-value pairs are
# rejected, different-value pairs pass.

include "lib/test.patlang"
include "lib/synthesis.patlang"
include "lib/synthesis_attr.patlang"

t_init()

# ---- "same" comparison: social class ----

let class_facts = [
  synth5_fact_binary("social_class", "alice", "guildsman"),
  synth5_fact_binary("social_class", "bob", "guildsman"),
  synth5_fact_binary("social_class", "carol", "noble"),
  synth5_fact_binary("social_class", "dave", "serf"),
  synth5_fact_binary("is_noble", "carol", "1")
]
let same_pos_pairs = [["alice", "bob"]]
let same_queries = [
  synth10_query("same_class", "alice", "bob", true),
  synth10_query("same_class", "alice", "carol", false),
  synth10_query("same_class", "carol", "dave", false)
]
let same_result = synth12_induce("same_class", same_pos_pairs, same_queries, class_facts, ["social_class", "is_noble"], "same")
check("induces the same-class comparison", same_result[0], "ok")
check("uses social_class as the witnessing attribute (is_noble is a distractor, correctly rejected)", same_result[1], "social_class")

let same_clause_src = synth12_emit_same("same_class", same_result[1])
print(same_clause_src)
let same_background_src = synth5_facts_to_src(class_facts)
let same_program_src = same_background_src + "\n" + same_clause_src +
  "\nlet sols_ab = solve(\"same_class\", [\"" + synth2_ground("alice") + "\", \"" + synth2_ground("bob") + "\"])\n" +
  "print(to_num(list_len(sols_ab)) > 0)\n" +
  "let sols_ac = solve(\"same_class\", [\"" + synth2_ground("alice") + "\", \"" + synth2_ground("carol") + "\"])\n" +
  "print(to_num(list_len(sols_ac)) > 0)\n"
let same_out_path = "self_hosting/build/synth_attr_same_demo.patlang"
write_file(same_out_path, same_program_src)
let same_compiled_exe = "self_hosting/build/synth_attr_same_demo.exe"
let same_build = exec_capture("./patc1.exe", same_out_path, same_compiled_exe)
check("generated same-class source compiles via patc1.exe", contains_text(same_build, "error"), false)
let same_run_out = exec_capture(same_compiled_exe)
check("compiled program: alice/bob genuinely same class, alice/carol are not", same_run_out, "true\nfalse\n\n")

# ---- "diff" comparison: sex, proving neq/2 for real ----

let sex_facts = [
  synth5_fact_binary("sex", "alice", "f"),
  synth5_fact_binary("sex", "bob", "m"),
  synth5_fact_binary("sex", "carol", "f"),
  synth5_fact_binary("social_class", "alice", "guildsman")
]
let diff_pos_pairs = [["alice", "bob"]]
let diff_queries = [
  synth10_query("diff_sex", "alice", "bob", true),
  synth10_query("diff_sex", "alice", "carol", false)
]
let diff_result = synth12_induce("diff_sex", diff_pos_pairs, diff_queries, sex_facts, ["sex", "social_class"], "diff")
check("induces the diff-sex comparison", diff_result[0], "ok")
check("uses sex as the witnessing attribute (social_class only has one value in this data, never witnesses a difference)", diff_result[1], "sex")

let diff_clause_src = synth12_emit_diff("diff_sex", diff_result[1])
print(diff_clause_src)
let diff_background_src = synth5_facts_to_src(sex_facts)
let diff_program_src = diff_background_src + "\n" + diff_clause_src +
  "\nlet sols_ab = solve(\"diff_sex\", [\"" + synth2_ground("alice") + "\", \"" + synth2_ground("bob") + "\"])\n" +
  "print(to_num(list_len(sols_ab)) > 0)\n" +
  "let sols_ac = solve(\"diff_sex\", [\"" + synth2_ground("alice") + "\", \"" + synth2_ground("carol") + "\"])\n" +
  "print(to_num(list_len(sols_ac)) > 0)\n" +
  "let sols_aa = solve(\"diff_sex\", [\"" + synth2_ground("alice") + "\", \"" + synth2_ground("alice") + "\"])\n" +
  "print(to_num(list_len(sols_aa)) > 0)\n"
let diff_out_path = "self_hosting/build/synth_attr_diff_demo.patlang"
write_file(diff_out_path, diff_program_src)
let diff_compiled_exe = "self_hosting/build/synth_attr_diff_demo.exe"
let diff_build = exec_capture("./patc1.exe", diff_out_path, diff_compiled_exe)
check("generated diff-sex source compiles via patc1.exe", contains_text(diff_build, "error"), false)
let diff_run_out = exec_capture(diff_compiled_exe)
check("compiled program: alice/bob genuinely differ, alice/carol (both f) do not, alice/alice (same person) does not", diff_run_out, "true\nfalse\nfalse\n\n")

t_report()
