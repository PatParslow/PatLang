# Milestone 2 selftest for the BDD-driven inductive synthesis engine
# (self_hosting/lib/synthesis_recursive.patlang): reproduces the
# dependency-graph reasoning from self_hosting/examples/
# goal_oriented_build_demo.patlang -- but instead of hand-writing
#   rule_add("buildable", ["X"], [["unchanged", ["X"]]])
#   rule_add("buildable", ["X"], [["dep", ["X", "Y"]], ["buildable", ["Y"]]])
# the RECURSIVE rule is induced from three example queries (two positive,
# one negative) plus the same dep/unchanged background facts the demo
# declares. This is the case milestone 1's flat LGG-by-output-label
# genuinely cannot handle (see the memory note on why it was deliberately
# not attempted alongside milestone 1) -- it needs a real clause BODY
# (dep(X, Y), buildable(Y)), not just another ground fact.

include "lib/test.patlang"
include "lib/synthesis_recursive.patlang"

t_init()

# Exactly the graph goal_oriented_build_demo.patlang declares: a -> b -> c
# (c unchanged), plus d -> e (e never declared unchanged, so d is NOT
# buildable -- the genuinely negative case the resolver must search and
# correctly fail, not just return the first plausible thing).
let background_src =
  "rule dep(\"" + synth2_ground("a") + "\", \"" + synth2_ground("b") + "\").\n" +
  "rule dep(\"" + synth2_ground("b") + "\", \"" + synth2_ground("c") + "\").\n" +
  "rule unchanged(\"" + synth2_ground("c") + "\").\n" +
  "rule dep(\"" + synth2_ground("d") + "\", \"" + synth2_ground("e") + "\").\n"

let queries = [
  synth2_query("buildable", "a", true),
  synth2_query("buildable", "c", true),
  synth2_query("buildable", "d", false)
]

let winner = synth2_induce_chain("buildable", ["unchanged"], ["dep"], background_src, queries)
check("search finds a hypothesis", to_num(list_len(winner)) > 0, true)
check("induces the base clause via unchanged", winner[0], "unchanged")
check("induces the chain clause via dep (the genuinely recursive part)", winner[1], "dep")

# ---- codegen + round-trip: emit real PatLang source for the winning
# hypothesis and confirm the COMPILED program agrees with
# goal_oriented_build_demo.patlang's own printed verdicts (1 solution for
# "a", 0 solutions for "d"). ----
let clause_src = synth2_clauses_for("buildable", winner[0], winner[1])
let program_src = background_src + "\n" + clause_src +
  "\nlet sols_a = solve(\"buildable\", [\"" + synth2_ground("a") + "\"])\n" +
  "print(to_num(list_len(sols_a)))\n" +
  "let sols_d = solve(\"buildable\", [\"" + synth2_ground("d") + "\"])\n" +
  "print(to_num(list_len(sols_d)))\n"

let out_path = "self_hosting/build/synth_buildgraph_demo.patlang"
write_file(out_path, program_src)

let compiled_exe = "self_hosting/build/synth_buildgraph_demo.exe"
let build = exec_capture("./patc1.exe", out_path, compiled_exe)
check("generated build-graph source compiles via patc1.exe", contains_text(build, "error"), false)

let run_out = exec_capture(compiled_exe)
check("compiled program matches goal_oriented_build_demo.patlang's verdicts (a: 1 solution, d: 0 solutions)", run_out, "1\n0\n\n")

t_report()
