# Milestone 8 selftest for the disjunctive-target extension
# (self_hosting/lib/synthesis_disjunctive.patlang): a discount-eligibility
# domain with two structurally UNRELATED reasons to be eligible --
# being a veteran, or being an enrolled student -- that share nothing at
# all, so no single anti-unified clause (milestone 7's engine) could ever
# cover both without either missing one of them or over-generalizing to
# cover ineligible people too.
#
# alice: veteran only              -> eligible (positive, reason 1)
# bob:   student + enrolled        -> eligible (positive, reason 2)
# carol: neither                    -> not eligible (negative)
# dave:  student but NOT enrolled   -> not eligible (negative -- a
#        PARTIAL match of reason 2's conjunction, must not slip through)

include "lib/test.patlang"
include "lib/synthesis.patlang"
include "lib/synthesis_disjunctive.patlang"

t_init()

# ---- scenario A (flagship): genuine disjunction, two clauses required ----
let facts_a = [
  synth5_fact_unary("veteran", "alice"),
  synth5_fact_unary("student", "bob"),
  synth5_fact_unary("enrolled", "bob"),
  synth5_fact_unary("student", "dave")
]
let queries_a = [
  synth2_query("discount_eligible", "alice", true),
  synth2_query("discount_eligible", "bob", true),
  synth2_query("discount_eligible", "carol", false),
  synth2_query("discount_eligible", "dave", false)
]
let result_a = synth8_induce("discount_eligible", ["alice", "bob"], queries_a, facts_a, 2)
check("scenario A: genuine disjunction succeeds", result_a[0], "ok")
check("scenario A: exactly two clauses were needed (a real disjunction, not one collapsed rule)", to_num(list_len(result_a[1])), 2)

# ---- codegen + round-trip on the disjunctive result ----
let clause_src = synth8_emit_clauses("discount_eligible", result_a[1])
let background_src = synth5_facts_to_src(facts_a)
let program_src = background_src + "\n" + clause_src +
  "\nlet sols_alice = solve(\"discount_eligible\", [\"" + synth2_ground("alice") + "\"])\n" +
  "print(to_num(list_len(sols_alice)) > 0)\n" +
  "let sols_bob = solve(\"discount_eligible\", [\"" + synth2_ground("bob") + "\"])\n" +
  "print(to_num(list_len(sols_bob)) > 0)\n" +
  "let sols_carol = solve(\"discount_eligible\", [\"" + synth2_ground("carol") + "\"])\n" +
  "print(to_num(list_len(sols_carol)) > 0)\n" +
  "let sols_dave = solve(\"discount_eligible\", [\"" + synth2_ground("dave") + "\"])\n" +
  "print(to_num(list_len(sols_dave)) > 0)\n"
let out_path = "self_hosting/build/synth_disjunctive_demo.patlang"
write_file(out_path, program_src)
let compiled_exe = "self_hosting/build/synth_disjunctive_demo.exe"
let build = exec_capture("./patc1.exe", out_path, compiled_exe)
check("generated disjunctive source compiles via patc1.exe", contains_text(build, "error"), false)
let run_out = exec_capture(compiled_exe)
check("compiled program: alice/bob eligible (two different reasons), carol/dave not (dave only partially matches)", run_out, "true\ntrue\nfalse\nfalse\n\n")

# ---- scenario B: examples that DO share structure still collapse to one clause, not two ----
let facts_b = [
  synth5_fact_binary("parent", "erin", "frank"),
  synth5_fact_binary("parent", "frank", "george3"),
  synth5_fact_binary("parent", "holly", "ida3"),
  synth5_fact_binary("parent", "ida3", "jack3")
]
let queries_b = [
  synth2_query("grandparent", "erin", true),
  synth2_query("grandparent", "holly", true)
]
let result_b = synth8_induce("grandparent", ["erin", "holly"], queries_b, facts_b, 2)
check("scenario B: shared structure does not get needlessly split into multiple clauses", to_num(list_len(result_b[1])), 1)

t_report()
