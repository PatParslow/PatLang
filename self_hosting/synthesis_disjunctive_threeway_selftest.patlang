# A second, more demanding example for the disjunctive-target extension
# (self_hosting/lib/synthesis_disjunctive.patlang): THREE structurally
# unrelated reasons, not two, stress-testing that the greedy clustering
# scales past a single pairwise split and still finds the right number
# of clauses -- and a partial-match negative again, to confirm the
# clustering doesn't accidentally launder a near-miss into a match.
#
# priority_support(X) :- is_enterprise(X).
# priority_support(X) :- is_paid(X), has_incident(X).
# priority_support(X) :- is_partner(X).

include "lib/test.patlang"
include "lib/synthesis.patlang"
include "lib/synthesis_disjunctive.patlang"

t_init()

let facts = [
  synth5_fact_unary("is_enterprise", "enterprise_co"),
  synth5_fact_unary("is_paid", "paid_co"),
  synth5_fact_unary("has_incident", "paid_co"),
  synth5_fact_unary("is_partner", "partner_co"),
  synth5_fact_unary("is_paid", "paid_only_co")
]
let queries = [
  synth2_query("priority_support", "enterprise_co", true),
  synth2_query("priority_support", "paid_co", true),
  synth2_query("priority_support", "partner_co", true),
  synth2_query("priority_support", "free_co", false),
  synth2_query("priority_support", "paid_only_co", false)
]
let result = synth8_induce("priority_support", ["enterprise_co", "paid_co", "partner_co"], queries, facts, 2)
check("three structurally unrelated reasons all succeed together", result[0], "ok")
check("clustering finds exactly three clauses, not one over-general or three-that-should-be-fewer", to_num(list_len(result[1])), 3)

let clause_src = synth8_emit_clauses("priority_support", result[1])
let background_src = synth5_facts_to_src(facts)
let program_src = background_src + "\n" + clause_src +
  "\nlet sols_ent = solve(\"priority_support\", [\"" + synth2_ground("enterprise_co") + "\"])\n" +
  "print(to_num(list_len(sols_ent)) > 0)\n" +
  "let sols_paid = solve(\"priority_support\", [\"" + synth2_ground("paid_co") + "\"])\n" +
  "print(to_num(list_len(sols_paid)) > 0)\n" +
  "let sols_partner = solve(\"priority_support\", [\"" + synth2_ground("partner_co") + "\"])\n" +
  "print(to_num(list_len(sols_partner)) > 0)\n" +
  "let sols_free = solve(\"priority_support\", [\"" + synth2_ground("free_co") + "\"])\n" +
  "print(to_num(list_len(sols_free)) > 0)\n" +
  "let sols_paidonly = solve(\"priority_support\", [\"" + synth2_ground("paid_only_co") + "\"])\n" +
  "print(to_num(list_len(sols_paidonly)) > 0)\n"
let out_path = "self_hosting/build/synth_disjunctive_threeway_demo.patlang"
write_file(out_path, program_src)
let compiled_exe = "self_hosting/build/synth_disjunctive_threeway_demo.exe"
let build = exec_capture("./patc1.exe", out_path, compiled_exe)
check("generated three-way disjunctive source compiles via patc1.exe", contains_text(build, "error"), false)
let run_out = exec_capture(compiled_exe)
check("compiled program correctly classifies all five companies", run_out, "true\ntrue\ntrue\nfalse\nfalse\n\n")

t_report()
