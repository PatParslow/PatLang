# Milestone 3 selftest for the BDD-driven inductive synthesis engine
# (self_hosting/lib/synthesis_conjunctive.patlang): induces a CONJUNCTIVE
# clause body -- `eligible(X) :- has_job(X), good_credit(X).` -- from
# example people, deliberately including a DISTRACTOR background
# predicate (is_student) that happens to be true of one positive example
# but isn't actually required, to test that the smallest-conjunction
# search doesn't let it leak into the induced rule.
#
# alice: has_job + good_credit -> eligible (positive)
# bob:   has_job only          -> not eligible (negative)
# carol: good_credit only      -> not eligible (negative)
# dave:  has_job + good_credit + is_student -> eligible (positive, the
#        distractor case: is_student is true here but must NOT end up
#        required in the induced rule, since alice is eligible without it)
# eve:   neither                -> not eligible (negative)

include "lib/test.patlang"
include "lib/synthesis.patlang"
include "lib/synthesis_conjunctive.patlang"

t_init()

let background_src =
  "rule has_job(\"" + synth2_ground("alice") + "\").\n" +
  "rule good_credit(\"" + synth2_ground("alice") + "\").\n" +
  "rule has_job(\"" + synth2_ground("bob") + "\").\n" +
  "rule good_credit(\"" + synth2_ground("carol") + "\").\n" +
  "rule has_job(\"" + synth2_ground("dave") + "\").\n" +
  "rule good_credit(\"" + synth2_ground("dave") + "\").\n" +
  "rule is_student(\"" + synth2_ground("dave") + "\").\n"

let queries = [
  synth2_query("eligible", "alice", true),
  synth2_query("eligible", "bob", false),
  synth2_query("eligible", "carol", false),
  synth2_query("eligible", "dave", true),
  synth2_query("eligible", "eve", false)
]

let winner = synth3_induce_conjunction("eligible", ["has_job", "good_credit", "is_student"], background_src, queries)
check("search finds a hypothesis", to_num(list_len(winner)) > 0, true)
check("the smallest separating conjunction has exactly 2 predicates", to_num(list_len(winner)), 2)
check("the distractor is_student does not survive in the induced rule", synth_list_contains(winner, "is_student"), false)
check("has_job is required", synth_list_contains(winner, "has_job"), true)
check("good_credit is required", synth_list_contains(winner, "good_credit"), true)

# ---- codegen + round-trip ----
let clause_src = synth3_clauses_for("eligible", winner)
let program_src = background_src + "\n" + clause_src +
  "\nlet sols_alice = solve(\"eligible\", [\"" + synth2_ground("alice") + "\"])\n" +
  "print(to_num(list_len(sols_alice)) > 0)\n" +
  "let sols_bob = solve(\"eligible\", [\"" + synth2_ground("bob") + "\"])\n" +
  "print(to_num(list_len(sols_bob)) > 0)\n" +
  "let sols_dave = solve(\"eligible\", [\"" + synth2_ground("dave") + "\"])\n" +
  "print(to_num(list_len(sols_dave)) > 0)\n" +
  "let sols_eve = solve(\"eligible\", [\"" + synth2_ground("eve") + "\"])\n" +
  "print(to_num(list_len(sols_eve)) > 0)\n"

let out_path = "self_hosting/build/synth_eligibility_demo.patlang"
write_file(out_path, program_src)

let compiled_exe = "self_hosting/build/synth_eligibility_demo.exe"
let build = exec_capture("./patc1.exe", out_path, compiled_exe)
check("generated eligibility source compiles via patc1.exe", contains_text(build, "error"), false)

let run_out = exec_capture(compiled_exe)
check("compiled program reproduces the intended eligibility verdicts", run_out, "true\nfalse\ntrue\nfalse\n\n")

t_report()
