# GitHub #21: real assertion-based regression coverage for the GOAP
# snippet-synthesis prototype (self_hosting/lib/goap_snippet_synthesis.
# patlang, originally self_hosting/tools/goap_snippet_synthesis_
# prototype.patlang, commit 9de1b81). The prototype worked end-to-end
# but only ever PRINTED its results for a human to eyeball -- no pass/
# fail check of its own, so it could silently bit-rot without ever
# failing a build. This wires the same three demos into `check()`/
# `t_report()` instead, matching every other self_hosting/*_selftest.
# patlang file's own convention, so `run_synthesis_selftests.patlang`
# actually exercises this too.

include "lib/test.patlang"
include "lib/goap_snippet_synthesis.patlang"

t_init()

# ---- demo 1: unparameterized two-step plan, composition + polyglot ----

action_add("gather_wood", [], [["have", ["wood"]]], [], 1)
action_add("build_house", [["have", ["wood"]]], [["have", ["house"]]], [], 1)
let plan1 = plan([["have", ["house"]]])
check("demo 1: plan finds the two-step sequence", to_num(list_len(plan1)), 2)

let synth1_patlang = synthesize_program(plan1, snippet_dict_patlang(), [])
check("demo 1: PatLang synthesis succeeds", synth1_patlang[0], "OK")

let demo1_path = "self_hosting/build/goap_synth_selftest_demo1.patlang"
write_file(demo1_path, synth1_patlang[1])
let run1_out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", demo1_path)
check("demo 1: composition works -- build_house's snippet correctly reads gather_wood's `wood`", run1_out, "gathered wood\nhouse built from wood\n\n")

let synth1_python = synthesize_program(plan1, snippet_dict_python(), [])
check("demo 1: polyglot -- the SAME plan assembles against a Python dictionary too", synth1_python[0], "OK")
check("demo 1: polyglot output is genuinely Python-shaped, not PatLang", contains_text(synth1_python[1], "print('gathered '"), true)

# ---- demo 2: contract-guarded parameterized action ----

action_add("scale", [["input", ["X"]]], [["scaled", ["X"]]], [], 1)
rule_add("input", ["5"], [])
let plan2 = plan([["scaled", ["5"]]])

let passing_clauses = [["require", "X", "<", "10"]]
let synth2_ok = synthesize_program(plan2, snippet_dict_patlang(), passing_clauses)
check("demo 2: a passing contract (X=5 < 10) allows synthesis to proceed", synth2_ok[0], "OK")
check("demo 2: passing contract's output actually substitutes the bound argument", contains_text(synth2_ok[1], "scaled_5"), true)

rule_add("input", ["15"], [])
let plan3 = plan([["scaled", ["15"]]])
let failing_clauses = [["require", "X", "<", "10"]]
let synth2_bad = synthesize_program(plan3, snippet_dict_patlang(), failing_clauses)
check("demo 2: a violating contract (X=15, require X < 10) is rejected before codegen", synth2_bad[0], "ERR")

# ---- error path: no snippet registered for an action ----

action_add("undocumented_step", [], [["have", ["mystery"]]], [], 1)
let plan4 = plan([["have", ["mystery"]]])
let synth_missing = synthesize_program(plan4, snippet_dict_patlang(), [])
check("an action with no registered snippet is reported as an error, not silently skipped", synth_missing[0], "ERR")

t_report()
