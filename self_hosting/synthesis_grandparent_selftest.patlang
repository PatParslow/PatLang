# Milestone 4 selftest for the BDD-driven inductive synthesis engine
# (self_hosting/lib/synthesis_chain.patlang): the classic ILP "grandparent"
# benchmark. Induces `grandparent(X) :- parent(X, Y), parent(Y, Z).` -- a
# genuine two-hop relational join through existential variables -- from
# example people plus a "colleague" DISTRACTOR binary relation placed
# FIRST in the candidate list, so any colleague-containing chain gets
# tried (and rejected) before the correct parent/parent chain is found,
# genuinely exercising predicate discrimination rather than just never
# reaching the distractor.
#
# Family tree: alice -> bob -> carol (alice is a grandparent)
#              dave  -> erin -> frank (dave is a grandparent)
#              george -> henry (henry has no children: george is NOT a
#              grandparent -- this is what rules out the depth-1 "just
#              has a parent-relation to someone" hypothesis, since george
#              would wrongly satisfy it)
#              carol has no children at all (not a grandparent either)
# colleague(alice, dave) is a true but irrelevant fact -- a real relation
# in the background knowledge that doesn't happen to separate the
# examples.

include "lib/test.patlang"
include "lib/synthesis_chain.patlang"

t_init()

let background_src =
  "rule parent(\"" + synth2_ground("alice") + "\", \"" + synth2_ground("bob") + "\").\n" +
  "rule parent(\"" + synth2_ground("bob") + "\", \"" + synth2_ground("carol") + "\").\n" +
  "rule parent(\"" + synth2_ground("dave") + "\", \"" + synth2_ground("erin") + "\").\n" +
  "rule parent(\"" + synth2_ground("erin") + "\", \"" + synth2_ground("frank") + "\").\n" +
  "rule parent(\"" + synth2_ground("george") + "\", \"" + synth2_ground("henry") + "\").\n" +
  "rule colleague(\"" + synth2_ground("alice") + "\", \"" + synth2_ground("dave") + "\").\n"

let queries = [
  synth2_query("grandparent", "alice", true),
  synth2_query("grandparent", "dave", true),
  synth2_query("grandparent", "george", false),
  synth2_query("grandparent", "carol", false)
]

let winner = synth4_induce_chain("grandparent", ["colleague", "parent"], 2, background_src, queries)
check("search finds a hypothesis", to_num(list_len(winner)) > 0, true)
check("the induced chain has depth 2 (a genuine two-hop join, not a shortcut)", to_num(list_len(winner)), 2)
check("hop 1 is parent, not the colleague distractor", winner[0], "parent")
check("hop 2 is parent (grandparent(X) :- parent(X,Y), parent(Y,Z))", winner[1], "parent")

# ---- codegen + round-trip ----
let clause_src = synth4_chain_clause("grandparent", winner)
let program_src = background_src + "\n" + clause_src +
  "\nlet sols_alice = solve(\"grandparent\", [\"" + synth2_ground("alice") + "\"])\n" +
  "print(to_num(list_len(sols_alice)) > 0)\n" +
  "let sols_george = solve(\"grandparent\", [\"" + synth2_ground("george") + "\"])\n" +
  "print(to_num(list_len(sols_george)) > 0)\n" +
  "let sols_carol = solve(\"grandparent\", [\"" + synth2_ground("carol") + "\"])\n" +
  "print(to_num(list_len(sols_carol)) > 0)\n"

let out_path = "self_hosting/build/synth_grandparent_demo.patlang"
write_file(out_path, program_src)

let compiled_exe = "self_hosting/build/synth_grandparent_demo.exe"
let build = exec_capture("./patc1.exe", out_path, compiled_exe)
check("generated grandparent-chain source compiles via patc1.exe", contains_text(build, "error"), false)

let run_out = exec_capture(compiled_exe)
check("compiled program correctly classifies alice/dave as grandparents, george/carol as not", run_out, "true\nfalse\nfalse\n\n")

t_report()
