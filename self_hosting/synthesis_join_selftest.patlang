# Milestone 11 selftest for two-ended relational joins
# (self_hosting/lib/synthesis_join.patlang): induces sibling(X, Y) --
# the exact fantpop-patlang scenario (bdd/ancestry.feature's sibling
# scenarios) that was fully blocked before milestones 10-11 landed.

include "lib/test.patlang"
include "lib/synthesis.patlang"
include "lib/synthesis_join.patlang"

t_init()

# Two families: alice's children (bob, carol) are siblings; george's
# children (helen, ida) are siblings. dave has only one child (erin),
# so erin has no sibling in this data.
let facts = [
  synth5_fact_binary("parent", "alice", "bob"),
  synth5_fact_binary("parent", "alice", "carol"),
  synth5_fact_binary("parent", "dave", "erin"),
  synth5_fact_binary("parent", "george", "helen"),
  synth5_fact_binary("parent", "george", "ida")
]
let pos_pairs = [["bob", "carol"], ["helen", "ida"]]
let queries = [
  synth10_query("sibling", "bob", "carol", true),
  synth10_query("sibling", "helen", "ida", true),
  synth10_query("sibling", "bob", "erin", false),
  synth10_query("sibling", "carol", "erin", false)
]
let result = synth11_induce("sibling", pos_pairs, queries, facts, 2)
check("induces the sibling join", result[0], "ok")
check("the join uses parent on both sides (shared immediate parent)", result[1][0], "parent")
check("the join uses parent on both sides (shared immediate parent)", result[1][1], "parent")

# ---- codegen + round-trip ----
let clause_src = synth11_emit_join("sibling", result[1])
print(clause_src)
let background_src = synth5_facts_to_src(facts)
let program_src = background_src + "\n" + clause_src +
  "\nlet sols_bc = solve(\"sibling\", [\"" + synth2_ground("bob") + "\", \"" + synth2_ground("carol") + "\"])\n" +
  "print(to_num(list_len(sols_bc)) > 0)\n" +
  "let sols_be = solve(\"sibling\", [\"" + synth2_ground("bob") + "\", \"" + synth2_ground("erin") + "\"])\n" +
  "print(to_num(list_len(sols_be)) > 0)\n"
let out_path = "self_hosting/build/synth_join_demo.patlang"
write_file(out_path, program_src)
let compiled_exe = "self_hosting/build/synth_join_demo.exe"
let build = exec_capture("./patc1.exe", out_path, compiled_exe)
check("generated join source compiles via patc1.exe", contains_text(build, "error"), false)
let run_out = exec_capture(compiled_exe)
check("compiled program: bob/carol genuinely siblings, bob/erin (different families) are not", run_out, "true\nfalse\n\n")

# ---- honest gap check: a person is never their own sibling, but our
# induced rule has no X != Y constraint (the engine has no inequality
# operator at all -- see synthesis_join.patlang's own header comment).
# synth11_join_candidates refuses x == y outright during INDUCTION
# (bob is never proposed as bob's own sibling when searching for
# evidence), but the EMITTED rule text itself has no such guard, so
# querying the compiled program directly with the same individual twice
# will incorrectly succeed. This check documents that the gap is real,
# not silently papered over. ----
let self_check_src = background_src + "\n" + clause_src +
  "\nlet sols_self = solve(\"sibling\", [\"" + synth2_ground("bob") + "\", \"" + synth2_ground("bob") + "\"])\n" +
  "print(to_num(list_len(sols_self)) > 0)\n"
let self_out_path = "self_hosting/build/synth_join_self_demo.patlang"
write_file(self_out_path, self_check_src)
let self_compiled_exe = "self_hosting/build/synth_join_self_demo.exe"
exec_capture("./patc1.exe", self_out_path, self_compiled_exe)
let self_run_out = exec_capture(self_compiled_exe)
check("KNOWN GAP, not a bug in this module: the induced rule has no X != Y guard (no inequality operator exists in the engine at all), so querying it with the same individual twice incorrectly succeeds", self_run_out, "true\n\n")

t_report()
