# Closes the gap identified after milestone 5: synth5_induce's structured
# diagnosis ("no_witness" / "conflict") is machine-usable but isn't yet a
# question anyone could act on. self_hosting/lib/synthesis_lgg.patlang's
# synth5_format_diagnosis/synth5_induce_and_ask render it into actual
# plain-English questions addressed to whoever wrote the BDD scenarios --
# this selftest exercises that rendering directly, re-using the same
# gap/conflict scenarios milestone 5 already proved the DIAGNOSIS for, now
# checking the QUESTION TEXT itself names the right things.

include "lib/test.patlang"
include "lib/synthesis.patlang"
include "lib/synthesis_lgg.patlang"

t_init()

let facts = [
  synth5_fact_binary("parent", "alice", "bob"),
  synth5_fact_binary("parent", "bob", "carol"),
  synth5_fact_binary("parent", "dave", "erin"),
  synth5_fact_binary("parent", "erin", "frank")
]

# ---- a successful induction asks no questions at all ----
let queries_ok = [
  synth2_query("grandparent", "alice", true),
  synth2_query("grandparent", "dave", true)
]
let outcome_ok = synth5_induce_and_ask("grandparent", ["alice", "dave"], queries_ok, facts, 2)
check("a successful induction has nothing to ask", to_num(list_len(outcome_ok[1])), 0)

# ---- a no-witness gap asks a targeted question naming the missing value ----
let queries_gap = [
  synth2_query("grandparent", "alice", true),
  synth2_query("grandparent", "isaac", true)
]
let outcome_gap = synth5_induce_and_ask("grandparent", ["alice", "isaac"], queries_gap, facts, 2)
check("a witness gap produces exactly one question", to_num(list_len(outcome_gap[1])), 1)
let gap_question = outcome_gap[1][0]
check("the question names the value with no evidence", contains_text(gap_question, "isaac"), true)
check("the question names the target predicate", contains_text(gap_question, "grandparent"), true)
check("the question actually asks something (ends in a question mark)", contains_text(gap_question, "?"), true)

# ---- a conflict asks a targeted question naming the offending example ----
let facts_conflict = [
  synth5_fact_binary("parent", "alice", "bob"),
  synth5_fact_binary("parent", "bob", "carol"),
  synth5_fact_binary("parent", "dave", "erin"),
  synth5_fact_binary("parent", "erin", "frank"),
  synth5_fact_binary("parent", "eve", "gwen"),
  synth5_fact_binary("parent", "gwen", "holly")
]
let queries_conflict = [
  synth2_query("grandparent", "alice", true),
  synth2_query("grandparent", "dave", true),
  synth2_query("grandparent", "eve", false)
]
let outcome_conflict = synth5_induce_and_ask("grandparent", ["alice", "dave"], queries_conflict, facts_conflict, 2)
check("a conflict produces exactly one question", to_num(list_len(outcome_conflict[1])), 1)
let conflict_question = outcome_conflict[1][0]
check("the question names the offending example", contains_text(conflict_question, "eve"), true)
check("the question asks about a distinguishing fact, matching the conflict's own diagnosis", contains_text(conflict_question, "distinguishes"), true)

t_report()
