# Milestone 5 selftest for the BDD-driven inductive synthesis engine
# (self_hosting/lib/synthesis_lgg.patlang): bottom-up witness search +
# anti-unification (common-prefix LGG over witnessed predicate chains),
# instead of milestones 2-4's blind top-down template enumeration. Three
# scenarios: the success path (derives the same grandparent(X) :-
# parent(X,Y), parent(Y,Z) rule as milestone 4, but by evidence rather
# than exhaustive search), the "no witness" gap-diagnosis path (a positive
# example the background facts say nothing about at all), and the
# "conflict" gap-diagnosis path (a negative example the induced rule
# wrongly covers, because the given background facts don't yet
# distinguish it from the positives).

include "lib/test.patlang"
include "lib/synthesis.patlang"
include "lib/synthesis_lgg.patlang"

t_init()

# ---- scenario A: success path, same domain as the milestone-4 grandparent benchmark ----

let facts_a = [
  synth5_fact_binary("parent", "alice", "bob"),
  synth5_fact_binary("parent", "bob", "carol"),
  synth5_fact_binary("parent", "dave", "erin"),
  synth5_fact_binary("parent", "erin", "frank"),
  synth5_fact_binary("parent", "george", "henry")
]
let queries_a = [
  synth2_query("grandparent", "alice", true),
  synth2_query("grandparent", "dave", true),
  synth2_query("grandparent", "george", false)
]
let result_a = synth5_induce("grandparent", ["alice", "dave"], queries_a, facts_a, 2)
check("scenario A: succeeds", result_a[0], "ok")
check("scenario A: derives the same 2-hop parent/parent chain milestone 4 found, but bottom-up", to_num(list_len(result_a[1])), 2)
check("scenario A: hop 1 is parent", result_a[1][0], "parent")
check("scenario A: hop 2 is parent", result_a[1][1], "parent")

# ---- scenario B: gap diagnosis -- isaac has NO background facts at all ----

let queries_b = [
  synth2_query("grandparent", "alice", true),
  synth2_query("grandparent", "isaac", true)
]
let result_b = synth5_induce("grandparent", ["alice", "isaac"], queries_b, facts_a, 2)
check("scenario B: reports a witness gap, not a blind search failure", result_b[0], "no_witness")
check("scenario B: correctly names isaac as the example with no supporting background fact", synth_list_contains(result_b[1], "isaac"), true)

# ---- scenario C: conflict diagnosis -- eve has the SAME chain shape as the positives but is declared negative ----

let facts_c = [
  synth5_fact_binary("parent", "alice", "bob"),
  synth5_fact_binary("parent", "bob", "carol"),
  synth5_fact_binary("parent", "dave", "erin"),
  synth5_fact_binary("parent", "erin", "frank"),
  synth5_fact_binary("parent", "eve", "gwen"),
  synth5_fact_binary("parent", "gwen", "holly")
]
let queries_c = [
  synth2_query("grandparent", "alice", true),
  synth2_query("grandparent", "dave", true),
  synth2_query("grandparent", "eve", false)
]
let result_c = synth5_induce("grandparent", ["alice", "dave"], queries_c, facts_c, 2)
check("scenario C: reports a conflict, not a silent wrong accept", result_c[0], "conflict")
check("scenario C: exactly one offending example", to_num(list_len(result_c[1])), 1)
let offense = result_c[1][0]
check("scenario C: correctly identifies eve as the offending example", offense[1], "eve")
check("scenario C: correctly diagnoses it as an under-distinguished negative, not a coverage gap", contains_text(offense[3], "wrongly covered"), true)

t_report()
