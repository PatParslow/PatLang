# New domain for the bottom-up LGG engine (self_hosting/lib/
# synthesis_lgg.patlang), distinct from the grandparent benchmark used
# throughout milestones 4-5: a DEPTH-1 chain (`has_mentor(X) :-
# mentored_by(X, Y).`) -- every prior selftest exercised depth-2 chains
# specifically, so this checks the bottom-up witness search and
# common-prefix LGG also work correctly at the shallowest possible depth
# (a single hop), not just the depth the earlier tests happened to use.
# Also exercises the gap-diagnosis question path in a fresh domain.

include "lib/test.patlang"
include "lib/synthesis.patlang"
include "lib/synthesis_lgg.patlang"

t_init()

let facts = [
  synth5_fact_binary("mentored_by", "alice", "grace"),
  synth5_fact_binary("mentored_by", "bob", "grace"),
  synth5_fact_binary("mentored_by", "carol", "henry")
]

# ---- success: a genuine single-hop relation ----
let queries_ok = [
  synth2_query("has_mentor", "alice", true),
  synth2_query("has_mentor", "bob", true),
  synth2_query("has_mentor", "dave", false)
]
let outcome_ok = synth5_induce_and_ask("has_mentor", ["alice", "bob"], queries_ok, facts, 3)
check("depth-1 induction succeeds", outcome_ok[0][0], "ok")
check("the induced chain is exactly one hop, not padded to the max_depth cap", to_num(list_len(outcome_ok[0][1])), 1)
check("the single hop is mentored_by", outcome_ok[0][1][0], "mentored_by")
check("a successful depth-1 induction still asks no questions", to_num(list_len(outcome_ok[1])), 0)

# ---- codegen + round-trip ----
let seq = outcome_ok[0][1]
let clause_src = synth4_chain_clause("has_mentor", seq)
let background_src = synth5_facts_to_src(facts)
let program_src = background_src + "\n" + clause_src +
  "\nlet sols_alice = solve(\"has_mentor\", [\"" + synth2_ground("alice") + "\"])\n" +
  "print(to_num(list_len(sols_alice)) > 0)\n" +
  "let sols_dave = solve(\"has_mentor\", [\"" + synth2_ground("dave") + "\"])\n" +
  "print(to_num(list_len(sols_dave)) > 0)\n"
let out_path = "self_hosting/build/synth_mentor_demo.patlang"
write_file(out_path, program_src)
let compiled_exe = "self_hosting/build/synth_mentor_demo.exe"
let build = exec_capture("./patc1.exe", out_path, compiled_exe)
check("generated depth-1 source compiles via patc1.exe", contains_text(build, "error"), false)
let run_out = exec_capture(compiled_exe)
check("compiled program agrees: alice has a mentor, dave does not", run_out, "true\nfalse\n\n")

# ---- gap: erin has no mentored_by fact at all ----
let queries_gap = [
  synth2_query("has_mentor", "alice", true),
  synth2_query("has_mentor", "erin", true)
]
let outcome_gap = synth5_induce_and_ask("has_mentor", ["alice", "erin"], queries_gap, facts, 3)
check("erin's missing mentor fact is correctly diagnosed as a witness gap", outcome_gap[0][0], "no_witness")
let gap_q = outcome_gap[1][0]
check("the question names erin", contains_text(gap_q, "erin"), true)

t_report()
