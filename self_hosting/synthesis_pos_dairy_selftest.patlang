# Reproduces the dairy-discount categorization from
# self_hosting/lib/pos.patlang: pos_setup() hand-declares
#   fact("dairy", "milk", "yes")
#   fact("dairy", "cheese", "yes")
# and pos_scan()'s `if query("dairy", item, 0) > 0` gate applies a 10%
# discount to dairy items. Here the milestone-1 flat classifier
# (self_hosting/lib/synthesis.patlang) induces the same item -> category
# mapping from example scans instead, over the SAME four products
# pos_setup() actually catalogs (apple, banana, milk, cheese isn't
# catalogued there but is a declared dairy fact -- included here anyway
# as a plain classification example, independent of the product catalog).

include "lib/test.patlang"
include "lib/synthesis.patlang"

t_init()

let pos_feature = "Feature: Classify a scanned item as dairy or not\n" +
  "\n" +
  "Scenario: apple is not dairy\n" +
  "Given the input is \"apple\"\n" +
  "Then the category is \"non_dairy\"\n" +
  "\n" +
  "Scenario: banana is not dairy\n" +
  "Given the input is \"banana\"\n" +
  "Then the category is \"non_dairy\"\n" +
  "\n" +
  "Scenario: milk is dairy (matches pos.patlang's fact(\"dairy\", \"milk\", \"yes\"))\n" +
  "Given the input is \"milk\"\n" +
  "Then the category is \"dairy\"\n" +
  "\n" +
  "Scenario: cheese is dairy (matches pos.patlang's fact(\"dairy\", \"cheese\", \"yes\"))\n" +
  "Given the input is \"cheese\"\n" +
  "Then the category is \"dairy\"\n"

let examples = synth_parse_examples(pos_feature)
check("parses all four example scenarios", to_num(list_len(examples)), 4)

let categories = synth_induce(examples)
check("induction finds exactly 2 real categories (dairy / non_dairy)", to_num(list_len(categories)), 2)

let fail_count = synth_verify(examples)
check("every example item resolves to its category", fail_count, 0)

# Direct reproduction check against pos.patlang's own two dairy facts.
let sols_milk = solve("dairy", ["v:milk"])
check("milk classifies as dairy (matches pos.patlang)", to_num(list_len(sols_milk)) > 0, true)
let sols_cheese = solve("dairy", ["v:cheese"])
check("cheese classifies as dairy (matches pos.patlang)", to_num(list_len(sols_cheese)) > 0, true)
let sols_apple = solve("dairy", ["v:apple"])
check("apple does not classify as dairy (matches pos.patlang's absence of a dairy fact for it)", to_num(list_len(sols_apple)) == 0, true)

let rules_src = synth_emit_rules(examples)
let dispatcher_src = synth_emit_dispatcher(categories, "classify_item")

let out_path = "self_hosting/build/synth_pos_dairy_demo.patlang"
let program_src = rules_src + "\n" + dispatcher_src +
  "\nprint(classify_item(\"apple\"))\n" +
  "print(classify_item(\"milk\"))\n" +
  "print(classify_item(\"cheese\"))\n"
write_file(out_path, program_src)

let compiled_exe = "self_hosting/build/synth_pos_dairy_demo.exe"
let build = exec_capture("./patc1.exe", out_path, compiled_exe)
check("generated classifier source compiles via patc1.exe", contains_text(build, "error"), false)

let run_out = exec_capture(compiled_exe)
check("compiled classifier reproduces pos.patlang's dairy/non_dairy split", run_out, "non_dairy\ndairy\ndairy\n\n")

t_report()
