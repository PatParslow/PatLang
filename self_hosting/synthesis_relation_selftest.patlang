# Milestone 10 selftest for genuine two-argument relations
# (self_hosting/lib/synthesis_relation.patlang): the capability gap
# found stress-testing the engine against fantpop-patlang
# (D:\Projects_Organized\04-Worldbuilding-Games\fantpop-patlang) --
# induces `grandparent_of(X, Y)` as a real binary relation (Y bound as
# a genuine second head argument, not existentially checked), the thing
# is_grandparent(X) (milestone 4-7) could not express.

include "lib/test.patlang"
include "lib/synthesis.patlang"
include "lib/synthesis_relation.patlang"

t_init()

# Same family tree shape as fantpop-patlang's own induction run:
# alice -> bob -> helen (alice is helen's grandparent)
# dave -> erin -> frank (dave is frank's grandparent)
let facts = [
  synth5_fact_binary("parent", "alice", "bob"),
  synth5_fact_binary("parent", "bob", "helen"),
  synth5_fact_binary("parent", "dave", "erin"),
  synth5_fact_binary("parent", "erin", "frank")
]
let pos_pairs = [["alice", "helen"], ["dave", "frank"]]
let queries = [
  synth10_query("grandparent_of", "alice", "helen", true),
  synth10_query("grandparent_of", "dave", "frank", true),
  synth10_query("grandparent_of", "alice", "bob", false),
  synth10_query("grandparent_of", "bob", "helen", false)
]
let result = synth10_induce("grandparent_of", pos_pairs, queries, facts, 2)
check("induces the genuine 2-arg relation", result[0], "ok")
check("the induced chain is 2 hops", to_num(list_len(result[1])), 2)

# ---- codegen + round-trip: prove Y is a real, bindable second argument
# by querying with a VARIABLE-style search -- solve() with a genuine
# constant for both X and Y, distinguishing grandparent_of(alice,helen)
# (true) from grandparent_of(alice,bob) (parent, not grandparent -- one
# hop short) and grandparent_of(bob,helen) (parent, not grandparent --
# checked from the wrong end). ----
let clause_src = synth10_emit_relation("grandparent_of", result[1])
print(clause_src)
let background_src = synth5_facts_to_src(facts)
let program_src = background_src + "\n" + clause_src +
  "\nlet sols_ah = solve(\"grandparent_of\", [\"" + synth2_ground("alice") + "\", \"" + synth2_ground("helen") + "\"])\n" +
  "print(to_num(list_len(sols_ah)) > 0)\n" +
  "let sols_ab = solve(\"grandparent_of\", [\"" + synth2_ground("alice") + "\", \"" + synth2_ground("bob") + "\"])\n" +
  "print(to_num(list_len(sols_ab)) > 0)\n" +
  "let sols_bh = solve(\"grandparent_of\", [\"" + synth2_ground("bob") + "\", \"" + synth2_ground("helen") + "\"])\n" +
  "print(to_num(list_len(sols_bh)) > 0)\n"
let out_path = "self_hosting/build/synth_relation_demo.patlang"
write_file(out_path, program_src)
let compiled_exe = "self_hosting/build/synth_relation_demo.exe"
let build = exec_capture("./patc1.exe", out_path, compiled_exe)
check("generated 2-arg relation source compiles via patc1.exe", contains_text(build, "error"), false)
let run_out = exec_capture(compiled_exe)
check("compiled program: alice/helen genuinely grandparent-related, alice/bob and bob/helen are not (only 1 hop each)", run_out, "true\nfalse\nfalse\n\n")

# ---- gap diagnosis: a pair with no witnessed chain at all ----
let queries_gap = [
  synth10_query("grandparent_of", "alice", "helen", true),
  synth10_query("grandparent_of", "george", "helen", true)
]
let result_gap = synth10_induce("grandparent_of", [["alice", "helen"], ["george", "helen"]], queries_gap, facts, 2)
check("a pair with no witnessed chain is correctly diagnosed as no_witness", result_gap[0], "no_witness")

t_report()
