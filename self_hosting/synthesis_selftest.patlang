# Milestone 1 selftest for the BDD-driven inductive synthesis engine
# (self_hosting/lib/synthesis.patlang). See the plan
# "wondering-about-extending-patlang-modular-shore" for context.
#
# Toy domain: classify a digit 1-9 into a band (low/mid/high). Six example
# scenarios cover three real categories, two examples each -- the
# parsimony check is that induction yields 3 branches (predicates), not 6
# (one per example).

include "lib/test.patlang"
include "lib/synthesis.patlang"

t_init()

let toy_feature = "Feature: Classify a digit into a band\n" +
  "\n" +
  "Scenario: one is low\n" +
  "Given the input is \"1\"\n" +
  "Then the category is \"low\"\n" +
  "\n" +
  "Scenario: two is low\n" +
  "Given the input is \"2\"\n" +
  "Then the category is \"low\"\n" +
  "\n" +
  "Scenario: five is mid\n" +
  "Given the input is \"5\"\n" +
  "Then the category is \"mid\"\n" +
  "\n" +
  "Scenario: six is mid\n" +
  "Given the input is \"6\"\n" +
  "Then the category is \"mid\"\n" +
  "\n" +
  "Scenario: eight is high\n" +
  "Given the input is \"8\"\n" +
  "Then the category is \"high\"\n" +
  "\n" +
  "Scenario: nine is high\n" +
  "Given the input is \"9\"\n" +
  "Then the category is \"high\"\n"

let examples = synth_parse_examples(toy_feature)
check("parses all six example scenarios", to_num(list_len(examples)), 6)

let categories = synth_induce(examples)
check("induction finds exactly 3 real branches, not 6", to_num(list_len(categories)), 3)

let fail_count = synth_verify(examples)
check("every example is provable against the induced rules", fail_count, 0)

let rules_src = synth_emit_rules(examples)
let dispatcher_src = synth_emit_dispatcher(categories, "classify_digit")

let out_path = "self_hosting/build/synth_classify_demo.patlang"
let program_src = rules_src + "\n" + dispatcher_src +
  "\nprint(classify_digit(\"1\"))\n" +
  "print(classify_digit(\"5\"))\n" +
  "print(classify_digit(\"9\"))\n"
write_file(out_path, program_src)

let compiled_exe = "self_hosting/build/synth_classify_demo.exe"
let build = exec_capture("./patc1.exe", out_path, compiled_exe)
check("generated PatLang source compiles via patc1.exe", contains_text(build, "error"), false)

let run_out = exec_capture(compiled_exe)
check("compiled program reproduces every category on round-trip", run_out, "low\nmid\nhigh\n\n")

t_report()
