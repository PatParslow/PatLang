# Another new domain for the bottom-up LGG engine: a DEPTH-3 chain
# (`origin_traceable(X) :- supplies(X,Y), supplies(Y,Z), supplies(Z,W).`),
# deeper than every prior selftest (which used depth 1 or 2). Checks that
# the bottom-up witness search and common-prefix LGG scale past depth 2,
# and that a chain one hop SHORT of the real pattern is correctly
# diagnosed as a conflict (not silently accepted at the wrong depth).
#
# raw material -> component -> assembly -> finished product, three full
# chains deep for mine_a/mine_b/mine_x; mine_x has the IDENTICAL 3-hop
# shape but is declared NOT origin_traceable anyway (standing in for a
# real-world reason the given predicates can't express -- e.g. an audit
# failure) -- the genuine conflict case: a rule generalized purely from
# mine_a/mine_b's witnessed chains will wrongly also prove mine_x, and
# that must be caught, not silently accepted.

include "lib/test.patlang"
include "lib/synthesis.patlang"
include "lib/synthesis_lgg.patlang"

t_init()

let facts = [
  synth5_fact_binary("supplies", "mine_a", "foundry_a"),
  synth5_fact_binary("supplies", "foundry_a", "factory_a"),
  synth5_fact_binary("supplies", "factory_a", "store_a"),
  synth5_fact_binary("supplies", "mine_b", "foundry_b"),
  synth5_fact_binary("supplies", "foundry_b", "factory_b"),
  synth5_fact_binary("supplies", "factory_b", "store_b"),
  synth5_fact_binary("supplies", "shortco", "factory_c"),
  synth5_fact_binary("supplies", "factory_c", "store_c"),
  synth5_fact_binary("supplies", "mine_x", "foundry_x"),
  synth5_fact_binary("supplies", "foundry_x", "factory_x"),
  synth5_fact_binary("supplies", "factory_x", "store_x")
]

# ---- success: two full 3-hop supply chains ----
let queries_ok = [
  synth2_query("origin_traceable", "mine_a", true),
  synth2_query("origin_traceable", "mine_b", true)
]
let outcome_ok = synth5_induce_and_ask("origin_traceable", ["mine_a", "mine_b"], queries_ok, facts, 4)
check("depth-3 induction succeeds", outcome_ok[0][0], "ok")
check("the induced chain is exactly 3 hops deep", to_num(list_len(outcome_ok[0][1])), 3)
check("every hop is supplies", outcome_ok[0][1][0], "supplies")

# ---- codegen + round-trip ----
let seq = outcome_ok[0][1]
let clause_src = synth4_chain_clause("origin_traceable", seq)
let background_src = synth5_facts_to_src(facts)
let program_src = background_src + "\n" + clause_src +
  "\nlet sols_a = solve(\"origin_traceable\", [\"" + synth2_ground("mine_a") + "\"])\n" +
  "print(to_num(list_len(sols_a)) > 0)\n" +
  "let sols_short = solve(\"origin_traceable\", [\"" + synth2_ground("shortco") + "\"])\n" +
  "print(to_num(list_len(sols_short)) > 0)\n"
let out_path = "self_hosting/build/synth_supplychain_demo.patlang"
write_file(out_path, program_src)
let compiled_exe = "self_hosting/build/synth_supplychain_demo.exe"
let build = exec_capture("./patc1.exe", out_path, compiled_exe)
check("generated depth-3 source compiles via patc1.exe", contains_text(build, "error"), false)
let run_out = exec_capture(compiled_exe)
check("compiled program agrees: mine_a is traceable, the 2-hop-short shortco is not", run_out, "true\nfalse\n\n")

# ---- conflict: mine_x has the IDENTICAL 3-hop shape as the positives but is declared negative anyway ----
let queries_conflict = [
  synth2_query("origin_traceable", "mine_a", true),
  synth2_query("origin_traceable", "mine_b", true),
  synth2_query("origin_traceable", "mine_x", false)
]
let outcome_conflict = synth5_induce_and_ask("origin_traceable", ["mine_a", "mine_b"], queries_conflict, facts, 4)
check("a negative example with the same witnessed shape as the positives is diagnosed as a conflict, not silently accepted", outcome_conflict[0][0], "conflict")
let conflict_q = outcome_conflict[1][0]
check("the question names mine_x", contains_text(conflict_q, "mine_x"), true)

t_report()
