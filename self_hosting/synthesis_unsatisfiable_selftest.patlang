# Robustness/edge-case test for the BDD-driven inductive synthesis engine:
# confirms synth3_induce_conjunction (self_hosting/lib/
# synthesis_conjunctive.patlang) honestly reports "no hypothesis found"
# ([]) when the examples are genuinely NOT separable by any conjunction
# of the offered candidate predicates, rather than silently returning a
# wrong/overfit answer. Every other selftest in this suite exercises the
# success path; this is the one that checks the failure path is handled
# honestly.
#
# XOR-shaped counterexample: alice and dave are positive but differ on
# both p and q; bob and carol are negative but ALSO differ on both p and
# q. No conjunction of {p, q} (or the empty/full conjunction) can
# separate this -- it needs disjunction, which conjunctive search doesn't
# attempt (by design; see the module's docstring on scope).
#
# alice: p only       -> target (positive)
# dave:  q only        -> target (positive)
# bob:   p and q both  -> not target (negative)
# carol: neither        -> not target (negative)

include "lib/test.patlang"
include "lib/synthesis.patlang"
include "lib/synthesis_conjunctive.patlang"

t_init()

let background_src =
  "rule p(\"" + synth2_ground("alice") + "\").\n" +
  "rule p(\"" + synth2_ground("bob") + "\").\n" +
  "rule q(\"" + synth2_ground("bob") + "\").\n" +
  "rule q(\"" + synth2_ground("dave") + "\").\n"

let queries = [
  synth2_query("target", "alice", true),
  synth2_query("target", "dave", true),
  synth2_query("target", "bob", false),
  synth2_query("target", "carol", false)
]

let winner = synth3_induce_conjunction("target", ["p", "q"], background_src, queries)
check("XOR-shaped examples are correctly reported unsatisfiable by conjunction, not overfit", to_num(list_len(winner)), 0)

t_report()
