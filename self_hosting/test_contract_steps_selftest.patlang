# lib/test.patlang's run_feature handles Gherkin `require`/`ensure` steps by
# calling handle_contract_step, so a program that includes only test.patlang
# must be able to run them (it used to fail with `host fn 'handle_contract_step'
# not found`, and on x64 compiled that call to a silent 0).
#
# Run from the repo root:
#   rust-runtime/target/release/pat.exe --ir-run self_hosting/test_contract_steps_selftest.patlang

include "lib/test.patlang"

make a function called st_bind_x returns done
  set_var("x", 5)
  return true
end

t_init()
step("a bound x", "st_bind_x")

run_feature("Feature: contract steps through the test runner" + chr(10)
  + "  Scenario: a clause that holds" + chr(10)
  + "    Given a bound x" + chr(10)
  + "    And require x < 10" + chr(10)
  + "    And ensure x < 20" + chr(10))
check("holding require/ensure steps record no failure", get("__vars", "t_fail"), 0)

run_feature("Feature: contract steps through the test runner" + chr(10)
  + "  Scenario: a clause that is violated" + chr(10)
  + "    Given a bound x" + chr(10)
  + "    And require x < 3" + chr(10))
check("a violated require step is recorded as a failure", get("__vars", "t_fail"), 1)
set_var("t_fail", 0)

t_report()
