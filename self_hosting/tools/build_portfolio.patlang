# ---- runtime signals: a process can receive a named signal from OUTSIDE
# itself (another CLI invocation, or a local network call) via signal_claim/
# signal_poll/signal_send/signal_query, dispatched through the existing
# when/emit mechanism. Native-only transcript, not a live "run in browser"
# demo -- see the blurb below for why. This transcript variant simulates
# the primary/secondary roles as two real OS threads instead of two
# separate processes (exec_capture blocks until its child exits, so it
# can't capture a long-running primary + separate signal-sending
# invocations); self_hosting/examples/signals_demo.patlang is the real,
# intended multi-process form a user would actually run.
#
# Manually concatenated (not `include`d) for the SAME reason every other
# multi-file demo in this script is: patc1_compile writes the combined
# source to a scratch path (portfolio/build/<id>.patlang), so a relative
# `include "../lib/signals.patlang"` line -- correct when the file lives at
# its real self_hosting/examples/ location -- would resolve to the WRONG
# path once copied there. The demo file's own `include` line (needed for
# real standalone use, e.g. `pat --patc self_hosting/examples/
# signals_demo_transcript.patlang` directly) is stripped here before
# concatenating, so signals.patlang's content isn't duplicated either.
let signals_demo_raw = read_file("self_hosting/examples/signals_demo_transcript.patlang")
let signals_include_line = "include " + q() + "../lib/signals.patlang" + q()
let signals_include_at = find_substr(signals_demo_raw, signals_include_line)
let signals_demo_body = signals_demo_raw
if signals_include_at >= 0 then
  let signals_demo_body = substr(signals_demo_raw, 0, signals_include_at) + substr(signals_demo_raw, signals_include_at + signals_include_line.length, signals_demo_raw.length - signals_include_at - signals_include_line.length)
end
let signals_src = read_file("self_hosting/lib/signals.patlang") + chr(10) + signals_demo_body
compile_native(signals_src, "signalsdemo")
let signals_native = exec_capture("portfolio/build/signalsdemo.exe")
print("signals demo done")

# ---- build daemon: the exemplar system tying together logic (rule_add/
# solve, "which targets are stale"), goal-seeking (action_add/plan, GOAP,
# cost-weighted by real historical timing), self-timing + persistence
# (now_ms(), a history file surviving between runs), events (when/emit
# driving the dashboard), and runtime signals (status/rebuild/quit) --
# see self_hosting/lib/build_daemon.patlang's own header for the full
# rationale. Same three-include-lines-stripped concatenation as the
# builddaemon precompile-job entry above.
let builddaemon_demo_body = strip_include_line(read_file("self_hosting/examples/build_daemon_demo_transcript.patlang"), "../lib/build_daemon.patlang")
let builddaemon_lib_body = strip_include_line(strip_include_line(read_file("self_hosting/lib/build_daemon.patlang"), "signals.patlang"), "includes.patlang")
let builddaemon_src = read_file("self_hosting/lib/signals.patlang") + chr(10) + read_file("self_hosting/lib/includes.patlang") + chr(10) + builddaemon_lib_body + chr(10) + builddaemon_demo_body
compile_native(builddaemon_src, "builddaemon")
let builddaemon_native = exec_capture("portfolio/build/builddaemon.exe")
print("build daemon demo done")

# User-defined DSL demo: `syntax RouterDSL { ... }` + `routes { ... }` blocks
# in self_hosting/examples/router_dsl_demo.patlang are expanded to plain
# `register_route(...)` calls by self_hosting/lib/syntax_dsl.patlang (a
# source-to-source preprocessing pass, using the general-purpose regex
# engine at self_hosting/lib/regex_dsl.patlang for the per-token patterns),
# BEFORE the result is handed to the ordinary compiler. Both of those lib
# files use `|params| do ... end` closures, which only the self-hosted
# lexer/parser (tokenize/parse_program, included above) understand -- not
# the Rust CLI's own parser -- so they can't be `include`d directly into
# this file; instead we run them as data through the same tokenize/
# parse_program/lower_program/run_ir pipeline used for the wasm builds.
let router_raw = read_file("self_hosting/examples/router_dsl_demo.patlang")
let dsl_driver = read_file("self_hosting/lib/regex_dsl.patlang") + chr(10)
  + read_file("self_hosting/lib/syntax_dsl.patlang") + chr(10)
  + "let raw = read_file(\"self_hosting/examples/router_dsl_demo.patlang\")" + chr(10)
  + "let expanded = expand_syntax_dsls(raw)" + chr(10)
  + "write_file(\"portfolio/build/router_dsl_expanded.patlang\", expanded)" + chr(10)
let dsl_toks = tokenize(dsl_driver)
let dsl_ast = parse_program(dsl_toks)
let dsl_ir = lower_program(dsl_ast)
run_ir(dsl_ir)
let router_src = read_file("portfolio/build/router_dsl_expanded.patlang")
compile_native(router_src, "routerdsl")
let router_native = exec_capture("portfolio/build/routerdsl.exe")
print("router dsl demo done")

