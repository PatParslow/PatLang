# completing its leftover checkpoint).
let queue_demo_body = strip_include_line(strip_include_line(read_file("self_hosting/examples/queue_recovery_demo_transcript.patlang"), "../lib/includes.patlang"), "../lib/queue.patlang")
let queue_lib_body = strip_include_line(read_file("self_hosting/lib/queue.patlang"), "includes.patlang")
