sb_push(gui_body, "<iframe id='gui-frame' style='width:100%;height:20rem;border:1px solid color-mix(in srgb, currentColor 25%, transparent);border-radius:6px' title='PatLang-generated GUI'></iframe>" + nl())
sb_push(gui_body, "<pre class='out' id='out-guidemo' hidden></pre>" + nl())
let gui_sections = list_push(gui_sections, tpl_raw(sb_str(gui_body)))
let gui_sections = list_push(gui_sections, tpl_raw("<details><summary>PatLang source</summary><pre class='src'>" + html_escape(gui_src) + "</pre></details>"))
let gui_sections = list_push(gui_sections, tpl_raw("<p class='label'>Native run on the build machine (writes a real file instead of rendering into an iframe):</p><pre class='out native'>" + html_escape(gui_native) + "</pre>"))
let gui_js = sb_new()
