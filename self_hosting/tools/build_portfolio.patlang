# =============================================================================
# Portfolio builder: generates portfolio/index.html — a self-contained page
# showing PatLang example sources, running them IN THE BROWSER (compiled to
# wasm32-wasip1, embedded as base64, executed via an inline WASI shim), with
# self-reported timings compared against native transcripts captured at
# build time. The builder itself is PatLang, using the self-hosted compiler.
#
# Run from the repo root (requires rustup target add wasm32-wasip1):
#   rust-runtime/target/release/pat --ir-run self_hosting/tools/build_portfolio.patlang
# Then open portfolio/index.html in a browser.
# =============================================================================

include "../lib/lexer.patlang"
include "../lib/parser.patlang"
include "../lib/lower.patlang"
include "../lib/codegen.patlang"
include "../lib/runtime_rs.patlang"
include "../lib/html.patlang"
include "../lib/maze.patlang"

# Build cache: skip re-running tokenize/parse/lower/emit/rustc for a demo
# whose source hasn't changed since the last build. The cache key covers
# BOTH the demo's own source AND a fingerprint of the compiler pipeline
# itself (lexer+parser+lower+codegen+runtime_rs) — so changing the compiler
# invalidates every cached artifact, while editing one demo only rebuilds
# that one. Delete portfolio/build/ to force a full rebuild.
let COMPILER_FINGERPRINT = read_file("self_hosting/lib/lexer.patlang") + read_file("self_hosting/lib/parser.patlang") + read_file("self_hosting/lib/lower.patlang") + read_file("self_hosting/lib/codegen.patlang") + read_file("self_hosting/lib/runtime_rs.patlang")

make a function called cache_key takes src returns key
  return hash_string(src + COMPILER_FINGERPRINT)
end

make a function called cache_valid takes id, src returns valid
  let hashfile = "portfolio/build/" + id + ".srchash"
  if file_exists(hashfile) == "1" then
    return read_file(hashfile) == cache_key(src)
  end
  return false
end

make a function called save_cache takes id, src returns done
  write_file("portfolio/build/" + id + ".srchash", cache_key(src))
  return true
end

make a function called compile_both takes src, id returns wasmb64
  let wasm_path = "portfolio/build/" + id + ".wasm"
  let exe_path = "portfolio/build/" + id + ".exe"
  if cache_valid(id, src) and (file_exists(wasm_path) == "1") and (file_exists(exe_path) == "1") then
    print("[cache] " + id + " unchanged, skipping rebuild")
    return read_file_b64(wasm_path)
  end
  let toks = tokenize(src)
  let ast = parse_program(toks)
  let ir = lower_program(ast)
  let rs = emit_program_rs(ir)
  rustc_build(rs, exe_path)
  rustc_build(rs, wasm_path, "wasm32-wasip1")
  save_cache(id, src)
  return read_file_b64(wasm_path)
end

make a function called compile_wasm_only takes src, id returns wasmb64
  let wasm_path = "portfolio/build/" + id + ".wasm"
  if cache_valid(id, src) and (file_exists(wasm_path) == "1") then
    print("[cache] " + id + " unchanged, skipping rebuild")
    return read_file_b64(wasm_path)
  end
  let toks = tokenize(src)
  let ast = parse_program(toks)
  let ir = lower_program(ast)
  let rs = emit_program_rs(ir)
  rustc_build(rs, wasm_path, "wasm32-wasip1")
  save_cache(id, src)
  return read_file_b64(wasm_path)
end

make a function called compile_native takes src, id returns exe
  let exe_path = "portfolio/build/" + id + ".exe"
  if cache_valid(id, src) and (file_exists(exe_path) == "1") then
    print("[cache] " + id + " unchanged, skipping rebuild")
    return exe_path
  end
  let toks = tokenize(src)
  let ast = parse_program(toks)
  let ir = lower_program(ast)
  let rs = emit_program_rs(ir)
  let exe = rustc_build(rs, exe_path)
  save_cache(id, src)
  return exe
end

make a function called native_card takes b, title, blurb, src, transcript returns done
  sb_push(b, "<div class='card'>" + nl())
  sb_push(b, "<h2>" + html_escape(title) + "</h2>" + nl())
  sb_push(b, "<p>" + blurb + "</p>" + nl())
  sb_push(b, "<details><summary>PatLang source</summary><pre class='src'>" + html_escape(src) + "</pre></details>" + nl())
  sb_push(b, "<p class='label'>Native run on the build machine:</p>" + nl())
  sb_push(b, "<pre class='out native'>" + html_escape(transcript) + "</pre>" + nl())
  sb_push(b, "</div>" + nl())
  return true
end

make a function called demo_card takes b, id, title, blurb, src, transcript returns done
  sb_push(b, "<div class='card'>" + nl())
  sb_push(b, "<h2>" + html_escape(title) + "</h2>" + nl())
  sb_push(b, "<p>" + blurb + "</p>" + nl())
  sb_push(b, "<details><summary>PatLang source</summary><pre class='src' id='src-" + id + "'>" + html_escape(src) + "</pre></details>" + nl())
  sb_push(b, "<p><button onclick='runCard(" + q() + id + q() + ")'>Compile and run in this browser</button> <span class='ms' id='ms-" + id + "'></span></p>" + nl())
  sb_push(b, "<pre class='out' id='out-" + id + "'>(not run yet)</pre>" + nl())
  sb_push(b, "<p class='label'>Native run on the build machine:</p>" + nl())
  sb_push(b, "<pre class='out native'>" + html_escape(transcript) + "</pre>" + nl())
  sb_push(b, "</div>" + nl())
  return true
end

make a function called wasi_shim_js takes b returns done
  sb_push(b, "function b64bytes(s) {" + nl())
  sb_push(b, "  const bin = atob(s);" + nl())
  sb_push(b, "  const a = new Uint8Array(bin.length);" + nl())
  sb_push(b, "  for (let i = 0; i < bin.length; i++) a[i] = bin.charCodeAt(i);" + nl())
  sb_push(b, "  return a;" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "const MODCACHE = {};" + nl())
  sb_push(b, "async function runWasm(outId, wasmId, extraArgs) {" + nl())
  sb_push(b, "  const out = document.getElementById('out-' + outId);" + nl())
  sb_push(b, "  if (out) out.textContent = 'running...';" + nl())
  sb_push(b, "  let stdout = '';" + nl())
  sb_push(b, "  const dec = new TextDecoder();" + nl())
  sb_push(b, "  let mem = null;" + nl())
  sb_push(b, "  const enc = new TextEncoder();" + nl())
  sb_push(b, "  const eargs = (extraArgs && extraArgs.length) ? ['prog'].concat(extraArgs) : [];" + nl())
  sb_push(b, "  const abufs = eargs.map(function(a) { return enc.encode(a); });" + nl())
  sb_push(b, "  const wasi = {" + nl())
  sb_push(b, "    fd_write(fd, iovs, len, nw) {" + nl())
  sb_push(b, "      const dv = new DataView(mem.buffer); let w = 0;" + nl())
  sb_push(b, "      for (let i = 0; i < len; i++) {" + nl())
  sb_push(b, "        const p = iovs + 8 * i;" + nl())
  sb_push(b, "        const ptr = dv.getUint32(p, true), l = dv.getUint32(p + 4, true);" + nl())
  sb_push(b, "        stdout += dec.decode(new Uint8Array(mem.buffer, ptr, l)); w += l;" + nl())
  sb_push(b, "      }" + nl())
  sb_push(b, "      dv.setUint32(nw, w, true); return 0;" + nl())
  sb_push(b, "    }," + nl())
  sb_push(b, "    random_get(p, l) { crypto.getRandomValues(new Uint8Array(mem.buffer, p, l)); return 0; }," + nl())
  sb_push(b, "    clock_time_get(cid, prec, tp) {" + nl())
  sb_push(b, "      const dv = new DataView(mem.buffer);" + nl())
  sb_push(b, "      const ns = BigInt(Math.round((performance.timeOrigin + performance.now()) * 1e6));" + nl())
  sb_push(b, "      dv.setBigUint64(tp, ns, true); return 0;" + nl())
  sb_push(b, "    }," + nl())
  sb_push(b, "    args_sizes_get(pc, ps) {" + nl())
  sb_push(b, "      const dv = new DataView(mem.buffer);" + nl())
  sb_push(b, "      let total = 0; for (const a of abufs) total += a.length + 1;" + nl())
  sb_push(b, "      dv.setUint32(pc, abufs.length, true); dv.setUint32(ps, total, true); return 0;" + nl())
  sb_push(b, "    }," + nl())
  sb_push(b, "    args_get(argvP, dataP) {" + nl())
  sb_push(b, "      const dv = new DataView(mem.buffer); let off = dataP;" + nl())
  sb_push(b, "      for (let i = 0; i < abufs.length; i++) {" + nl())
  sb_push(b, "        dv.setUint32(argvP + 4 * i, off, true);" + nl())
  sb_push(b, "        new Uint8Array(mem.buffer, off, abufs[i].length).set(abufs[i]);" + nl())
  sb_push(b, "        dv.setUint8(off + abufs[i].length, 0); off += abufs[i].length + 1;" + nl())
  sb_push(b, "      }" + nl())
  sb_push(b, "      return 0;" + nl())
  sb_push(b, "    }," + nl())
  sb_push(b, "    environ_sizes_get(pc, ps) { const dv = new DataView(mem.buffer); dv.setUint32(pc, 0, true); dv.setUint32(ps, 0, true); return 0; }," + nl())
  sb_push(b, "    environ_get() { return 0; }," + nl())
  sb_push(b, "    proc_exit(c) { const e = new Error('exit'); e.exitCode = c; throw e; }," + nl())
  sb_push(b, "    fd_close() { return 0; }, fd_fdstat_get() { return 0; }, fd_seek() { return 70; }," + nl())
  sb_push(b, "    fd_read() { return 8; }, fd_prestat_get() { return 8; }, fd_prestat_dir_name() { return 8; }," + nl())
  sb_push(b, "    path_open() { return 76; }, sched_yield() { return 0; }, poll_oneoff() { return 52; }" + nl())
  sb_push(b, "  };" + nl())
  sb_push(b, "  // Unknown WASI imports resolve to a stub returning ENOTSUP (58)" + nl())
  sb_push(b, "  const wasiNs = new Proxy(wasi, { get(t, k) { return k in t ? t[k] : (() => 58); } });" + nl())
  sb_push(b, "  try {" + nl())
  sb_push(b, "    const t0 = performance.now();" + nl())
  sb_push(b, "    if (!MODCACHE[wasmId]) MODCACHE[wasmId] = await WebAssembly.compile(b64bytes(WASMS[wasmId]));" + nl())
  sb_push(b, "    const mod = MODCACHE[wasmId];" + nl())
  sb_push(b, "    const inst = await WebAssembly.instantiate(mod, { wasi_snapshot_preview1: wasiNs });" + nl())
  sb_push(b, "    mem = inst.exports.memory;" + nl())
  sb_push(b, "    try { inst.exports._start(); } catch (e) { if (!(e && e.exitCode === 0)) throw e; }" + nl())
  sb_push(b, "    const ms = (performance.now() - t0).toFixed(1);" + nl())
  sb_push(b, "    if (out) out.textContent = stdout;" + nl())
  sb_push(b, "    const msEl = document.getElementById('ms-' + outId);" + nl())
  sb_push(b, "    if (msEl) msEl.textContent = ms + ' ms wall (compile+run, this browser)';" + nl())
  sb_push(b, "    return stdout;" + nl())
  sb_push(b, "  } catch (e) {" + nl())
  sb_push(b, "    if (out) out.textContent = stdout + ' [error: ' + e + ']';" + nl())
  sb_push(b, "    return stdout;" + nl())
  sb_push(b, "  }" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "const KW = new Set(['let','if','then','else','end','while','do','return','make','a','function','called','takes','returns','when','emit','and','or','not','true','false','print']);" + nl())
  sb_push(b, "function hlHtml(src) {" + nl())
  sb_push(b, "  let out = ''; let i = 0;" + nl())
  sb_push(b, "  const esc = function(t) { return t.replace(/&/g, '&amp;').replace(/</g, '&lt;'); };" + nl())
  sb_push(b, "  while (i < src.length) {" + nl())
  sb_push(b, "    const c = src[i];" + nl())
  sb_push(b, "    if (c === '#') { let j = i; while (j < src.length && src.charCodeAt(j) !== 10) j++; out += '<i class=hc>' + esc(src.slice(i, j)) + '</i>'; i = j; continue; }" + nl())
  sb_push(b, "    if (c === String.fromCharCode(34)) { let j = i + 1; while (j < src.length && src[j] !== c) { if (src[j] === String.fromCharCode(92)) j++; j++; } j++; out += '<i class=hs>' + esc(src.slice(i, j)) + '</i>'; i = j; continue; }" + nl())
  sb_push(b, "    if (c >= '0' && c <= '9') { let j = i; while (j < src.length && ((src[j] >= '0' && src[j] <= '9') || src[j] === '.')) j++; out += '<i class=hn>' + src.slice(i, j) + '</i>'; i = j; continue; }" + nl())
  sb_push(b, "    if (/[A-Za-z_]/.test(c)) { let j = i; while (j < src.length && /[A-Za-z0-9_]/.test(src[j])) j++; const w = src.slice(i, j); out += KW.has(w) ? '<i class=hk>' + w + '</i>' : esc(w); i = j; continue; }" + nl())
  sb_push(b, "    out += esc(c); i++;" + nl())
  sb_push(b, "  }" + nl())
  sb_push(b, "  return out + String.fromCharCode(10);" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "function hlUpdate() { document.getElementById('hl').innerHTML = hlHtml(document.getElementById('ed').value); hlSync(); }" + nl())
  sb_push(b, "function hlSync() { const e = document.getElementById('ed'), h = document.getElementById('hl'); h.scrollTop = e.scrollTop; h.scrollLeft = e.scrollLeft; }" + nl())
  sb_push(b, "function srcText(id) { return document.getElementById('src-' + id).textContent; }" + nl())
  sb_push(b, "function runCard(id) { return runWasm(id, 'playground', [srcText(id)]); }" + nl())
  sb_push(b, "function runPlayground() { return runWasm('playground', 'playground', [document.getElementById('ed').value]); }" + nl())
  sb_push(b, "function loadExample() { const id = document.getElementById('exsel').value; document.getElementById('ed').value = srcText(id); hlUpdate(); }" + nl())
  sb_push(b, "window.addEventListener('DOMContentLoaded', hlUpdate);" + nl())
  return true
end

