# =============================================================================
# Portfolio builder: generates portfolio/index.html and portfolio/demos/ --
# pages showing PatLang example sources, running them IN THE BROWSER (built
# by v2 as WebAssembly, embedded as base64, run on v2's own browser host),
# with self-reported timings compared against native transcripts captured at
# build time. The builder itself is PatLang, built by v2.
#
# Run from the repo root:
#   self_hosting/build/v2.exe self_hosting/tools/build_portfolio.patlang build_portfolio.exe
#   ./build_portfolio.exe
# Then serve portfolio/ over http(s) and open index.html: the WebAssembly
# demos need a cross-origin isolated page, which portfolio/coi-sw.js, a
# service worker, gives on a host that does not send the headers itself.
# =============================================================================

include "../lib/context.patlang"
include "../lib/lexer.patlang"
include "../lib/parser.patlang"
include "../lib/lower.patlang"
include "../lib/includes.patlang"
include "../lib/regex_dsl.patlang"
include "../lib/syntax_dsl.patlang"
include "../lib/html.patlang"
include "../lib/maze.patlang"
include "../lib/template.patlang"
include "../lib/json.patlang"
include "../lib/reflect.patlang"
include "../lib/transpile_ruby.patlang"

# Every demo is compiled by v2 (self_hosting/build/v2.exe), natively for its
# build-machine transcript and as WebAssembly for the browser.
#
# Build cache: a demo whose source is unchanged since the last build, built
# by the same compiler, is not rebuilt. The key is the demo's source and v2's
# own cache key (self_hosting/build/v2.exe.key, the hash of the sources v2
# was built from), so a rebuilt compiler rebuilds every demo once; v2's own
# per-function cache then makes that cheap.
make a function called cache_key takes src returns key
  return hash_string(src + read_file("self_hosting/build/v2.exe.key"))
end

make a function called cache_valid takes id, src returns valid
  let hashfile = "portfolio/build/" + id + ".srchash"
  if file_exists(hashfile) then
    return read_file(hashfile) == cache_key(src)
  end
  return false
end

make a function called save_cache takes id, src returns done
  write_file("portfolio/build/" + id + ".srchash", cache_key(src))
  return true
end

# lib/test.patlang includes gherkin_contracts.patlang (which includes
# includes.patlang). A demo's source is one flat text with no include base, so
# the browser demos splice the three in, each minus its own include lines.
make a function called strip_include_lines takes text returns out
  let lines = split_lines(text)
  let sb = sb_new()
  let i = 0
  while i < list_len(lines) do
    if substr(lines[i], 0, 8) != "include " then
      sb_push(sb, lines[i])
      sb_push(sb, chr(10))
    end
    let i = i + 1
  end
  return sb_str(sb)
end

make a function called test_framework_src returns text
  return strip_include_lines(read_file("self_hosting/lib/includes.patlang")) + chr(10) + strip_include_lines(read_file("self_hosting/lib/context.patlang")) + chr(10) + strip_include_lines(read_file("self_hosting/lib/gherkin_text.patlang")) + chr(10) + strip_include_lines(read_file("self_hosting/lib/gherkin_clauses.patlang")) + chr(10) + strip_include_lines(read_file("self_hosting/lib/step_match.patlang")) + chr(10) + strip_include_lines(read_file("self_hosting/lib/gherkin.patlang"))
end

# True when some line of src declares a `syntax` extension, which
# expand_syntax_dsls (lib/syntax_dsl.patlang) expands before compiling.
make a function called has_syntax_block takes src returns yes
  let lines = split_lines(src)
  let i = 0
  while i < list_len(lines) do
    if str_starts_with(str_trim(lines[i]), "syntax ") then
      return true
    end
    let i = i + 1
  end
  return false
end

# A demo's source as one file v2 can compile: its syntax extensions
# expanded, and its include lines, which name files relative to
# self_hosting/lib, expanded once each.
make a function called portfolio_source takes src returns text
  let text = src
  if has_syntax_block(text) then
    let text = expand_syntax_dsls(text)
  end
  return expand_includes_once(text, "self_hosting/lib")
end

# Writes the demo's source to a scratch file and builds it with v2: an
# executable when target is "", else a WebAssembly module. Gives "" when
# the build succeeded, else what v2 said, with the demo named.
make a function called portfolio_try_compile takes src, id, out_path, target returns failure
  require (value_class(id) == 8) and (value_class(out_path) == 8)
  let scratch = "portfolio/build/" + id + ".patlang"
  if target != "" then
    let scratch = "portfolio/build/" + id + "_wasm.patlang"
  end
  write_file(scratch, portfolio_source(src))
  if target == "" then
    let said = exec_capture("self_hosting/build/v2.exe", scratch, out_path, "--workers", "2")
  else
    let said = exec_capture("self_hosting/build/v2.exe", scratch, out_path, "--wasm", "--workers", "2")
  end
  let failure = ""
  if find_substr(said, "v2: " + out_path) < 0 then
    let failure = "portfolio: v2 could not build " + id + " (" + out_path + "):" + nl() + said
  end
  ensure (failure != "") or file_exists(out_path)
  return failure
end

# portfolio_try_compile, a failure stopping the portfolio.
make a function called portfolio_compile takes src, id, out_path, target returns done
  let failure = portfolio_try_compile(src, id, out_path, target)
  if failure != "" then
    print(failure)
    exit_with(1)
  end
  let done = true
  ensure file_exists(out_path)
  return done
end

# The native and wasm targets for one demo are independent compiles (same
# source, each with a scratch file of its own, a fresh v2.exe each), so they
# run concurrently via parallel_map's threads instead of back-to-back.
make a function called compile_both_target takes job returns done
  let src = job[0]
  let id = job[1]
  let out_path = job[2]
  let target = job[3]
  portfolio_compile(src, id, out_path, target)
  return true
end

make a function called compile_both takes src, id returns wasmb64
  let wasm_path = "portfolio/build/" + id + ".wasm"
  let exe_path = "portfolio/build/" + id + ".exe"
  if cache_valid(id, src) and (file_exists(wasm_path)) and (file_exists(exe_path)) then
    print("[cache] " + id + " unchanged, skipping rebuild")
    return read_file_b64(wasm_path)
  end
  let jobs = [[src, id, exe_path, ""], [src, id, wasm_path, "wasm"]]
  parallel_map(jobs, "compile_both_target")
  save_cache(id, src)
  return read_file_b64(wasm_path)
end

make a function called compile_wasm_only takes src, id returns wasmb64
  let wasm_path = "portfolio/build/" + id + ".wasm"
  if cache_valid(id, src) and (file_exists(wasm_path)) then
    print("[cache] " + id + " unchanged, skipping rebuild")
    return read_file_b64(wasm_path)
  end
  portfolio_compile(src, id, wasm_path, "wasm")
  save_cache(id, src)
  return read_file_b64(wasm_path)
end

# Every v2 module has threads (docs/spec/ir.md, "The WASM form"), so a demo
# that runs threads or fibres is built as any other.
make a function called compile_wasm_threaded_only takes src, id returns wasmb64
  return compile_wasm_only(src, id)
end

make a function called compile_native takes src, id returns exe
  let exe_path = "portfolio/build/" + id + ".exe"
  if cache_valid(id, src) and (file_exists(exe_path)) then
    print("[cache] " + id + " unchanged, skipping rebuild")
    return exe_path
  end
  portfolio_compile(src, id, exe_path, "")
  save_cache(id, src)
  return exe_path
end

make a function called out_path_for takes id, target returns path
  if target != "" then
    return "portfolio/build/" + id + ".wasm"
  end
  return "portfolio/build/" + id + ".exe"
end

# Cross-demo parallel pre-compile pass: every compile below this point
# (compile_native/compile_wasm_only/compile_both/compile_wasm_threaded_only)
# funnels through cache_valid + portfolio_compile, and each portfolio_compile call
# is a fully independent subprocess (own scratch file keyed by id, own
# out_path) -- so the actual stale-vs-cached compiles across ALL demos can
# be dispatched together via parallel_map's real OS threads, instead of
# happening one at a time as the script reaches each demo sequentially.
# This block duplicates each demo's small src-assembly expression (mostly
# one or two read_file/concat lines) rather than restructuring the ~1500
# lines of per-demo page-building logic below -- deliberately: those blocks
# stay exactly as they are today (still calling compile_native/etc in their
# usual place), and will simply hit a warm cache by the time they run,
# since this pass already did the real work. Duplication risk: if a demo's
# src-assembly expression changes below, the copy here needs updating too,
# or that demo silently won't get the parallel-precompile benefit (it will
# still compile correctly, just back on the sequential path) -- not a
# correctness risk, only a missed optimization, so this is a lower-stakes
# drift than the chunk_markers table above.
# A worker builds its demo and writes its cache record, and prints a line as
# it starts and as it finishes; it gives "" or the build's failure. It writes
# nothing another worker reads: the workers run at once, and a count or a log
# they shared would race (CLAUDE.md section 7).
make a function called precompile_job takes job returns failure
  let src = job[0]
  let id = job[1]
  let target = job[2]
  let label = id
  if target != "" then
    let label = id + " (" + target + ")"
  end
  let t0 = now_ms()
  print("[precompile] " + label + " starting")
  let failure = portfolio_try_compile(src, id, out_path_for(id, target), target)
  if failure != "" then
    print("[precompile] " + label + " FAILED")
    return failure
  end
  # Without this, the artifact exists on disk but its .srchash file doesn't
  # get written, so the ordinary sequential compile_native/etc call further
  # down the script would see cache_valid == false and recompile it AGAIN.
  # save_cache is a plain single-file write, safe to call twice for the same
  # id (e.g. playground, which has two targets/two jobs) -- both writes are
  # identical content.
  save_cache(id, src)
  print("[precompile] " + label + " done in " + (now_ms() - t0) + " ms")
  return ""
end

# How many builds run at once: each is a v2.exe of its own, with its own
# workers and memory.
make a function called precompile_batch_size returns n
  return 4
end

make a function called add_job takes jobs, id, src, target returns jobs2
  let out_path = out_path_for(id, target)
  if cache_valid(id, src) and (file_exists(out_path)) then
    return jobs
  end
  return list_push(jobs, [src, id, target])
end

make a function called build_precompile_jobs returns jobs
  let jobs = []
  let jobs = add_job(jobs, "feature", read_file("self_hosting/examples/feature_demo.patlang"), "")
  let jobs = add_job(jobs, "bench", read_file("self_hosting/examples/fib_bench.patlang"), "")
  let gui_src = read_file("self_hosting/lib/html.patlang") + chr(10) + read_file("self_hosting/examples/gui_demo.patlang")
  let jobs = add_job(jobs, "gui", gui_src, "")
  let gui_wasm_src = read_file("self_hosting/lib/html.patlang") + chr(10) + read_file("self_hosting/examples/gui_wasm_main.patlang")
  let jobs = add_job(jobs, "guidemo", gui_wasm_src, "wasm")
  let pos_src = read_file("self_hosting/lib/pos.patlang") + chr(10) + read_file("self_hosting/examples/pos_demo.patlang")
  let jobs = add_job(jobs, "pos", pos_src, "")
  let post_src = test_framework_src() + chr(10) + strip_include_lines(read_file("self_hosting/lib/pos.patlang")) + chr(10) + read_file("self_hosting/examples/pos_tests.patlang")
  let jobs = add_job(jobs, "postests", post_src, "")
  let jobs = add_job(jobs, "contracts", read_file("self_hosting/examples/contracts_demo.patlang"), "")
  let jobs = add_job(jobs, "goaloriented", read_file("self_hosting/examples/goal_oriented_build_demo.patlang"), "")
  let jobs = add_job(jobs, "bitwise", read_file("self_hosting/examples/bitwise_bitfield_demo.patlang"), "")
  let jobs = add_job(jobs, "rulesyntax", read_file("self_hosting/examples/rule_syntax_demo.patlang"), "")
  let jobs = add_job(jobs, "vfsdemo", read_file("self_hosting/examples/vfs_demo.patlang"), "")
  let matchdemo_body = strip_include_line(read_file("self_hosting/examples/match_demo.patlang"), "../lib/regex.patlang")
  let matchdemo_src = read_file("self_hosting/lib/regex.patlang") + chr(10) + matchdemo_body
  let jobs = add_job(jobs, "matchdemo", matchdemo_src, "")

  # signalsdemo: strip the demo's own include line before concatenating
  # (same reason as the real compile site below -- a relative include path
  # doesn't survive being copied to a scratch build path).
  let sig_demo_raw = read_file("self_hosting/examples/signals_demo_transcript.patlang")
  let sig_include_line = "include " + q() + "../lib/signals.patlang" + q()
  let sig_include_at = find_substr(sig_demo_raw, sig_include_line)
  let sig_demo_body = sig_demo_raw
  if sig_include_at >= 0 then
    let sig_demo_body = substr(sig_demo_raw, 0, sig_include_at) + substr(sig_demo_raw, sig_include_at + sig_include_line.length, sig_demo_raw.length - sig_include_at - sig_include_line.length)
  end
  let jobs = add_job(jobs, "signalsdemo", read_file("self_hosting/lib/signals.patlang") + chr(10) + sig_demo_body, "")

  # builddaemon: strip three include lines (its own include of
  # build_daemon.patlang, plus that library's own includes of
  # signals.patlang and includes.patlang) before concatenating all four
  # files' real content in dependency order.
  let bd_demo_body = strip_include_line(read_file("self_hosting/examples/build_daemon_demo_transcript.patlang"), "../lib/build_daemon.patlang")
  let bd_lib_body = strip_include_line(strip_include_line(read_file("self_hosting/lib/build_daemon.patlang"), "signals.patlang"), "includes.patlang")
  let bd_src = read_file("self_hosting/lib/signals.patlang") + chr(10) + read_file("self_hosting/lib/includes.patlang") + chr(10) + bd_lib_body + chr(10) + bd_demo_body
  let jobs = add_job(jobs, "builddaemon", bd_src, "")

  # routerdsl's source is the demo with its DSL expanded
  let router_src = expand_syntax_dsls(read_file("self_hosting/examples/router_dsl_demo.patlang"))
  let jobs = add_job(jobs, "routerdsl", router_src, "")

  let tower_src = read_file("self_hosting/lib/math.patlang") + chr(10) + read_file("self_hosting/examples/numeric_tower_demo.patlang")
  let jobs = add_job(jobs, "towerdemo", tower_src, "")
  let dynsyntax_src = read_file("self_hosting/lib/lexer.patlang") + read_file("self_hosting/lib/parser.patlang") + read_file("self_hosting/lib/lower.patlang") + read_file("self_hosting/lib/regex_dsl.patlang") + read_file("self_hosting/lib/syntax_dsl.patlang") + read_file("self_hosting/lib/interp.patlang") + read_file("self_hosting/examples/dynamic_syntax_demo.patlang")
  let jobs = add_job(jobs, "dynsyntaxdemo", dynsyntax_src, "")
  let jobs = add_job(jobs, "threadingdemo", read_file("self_hosting/examples/threading_demo.patlang"), "")
  let report_lib_src = read_file("self_hosting/lib/report.patlang")
  let report_src = report_lib_src + chr(10) + read_file("self_hosting/examples/report_demo.patlang")
  let jobs = add_job(jobs, "report", report_src, "")
  let report_wasm_src = read_file("self_hosting/lib/lexer.patlang") + chr(10) + read_file("self_hosting/lib/parser.patlang") + chr(10) + read_file("self_hosting/lib/lower.patlang") + chr(10) + report_lib_src + chr(10) + read_file("self_hosting/examples/report_wasm_main.patlang")
  let jobs = add_job(jobs, "report_timeline", report_wasm_src, "wasm")
  let pg_src = read_file("self_hosting/lib/lexer.patlang") + chr(10) + read_file("self_hosting/lib/parser.patlang") + chr(10) + read_file("self_hosting/lib/lower.patlang") + chr(10) + read_file("self_hosting/lib/regex_dsl.patlang") + chr(10) + read_file("self_hosting/lib/syntax_dsl.patlang") + chr(10) + read_file("self_hosting/lib/json.patlang") + chr(10) + read_file("self_hosting/lib/interp.patlang") + chr(10) + read_file("self_hosting/examples/playground_main.patlang")
  let jobs = add_job(jobs, "playground", pg_src, "")
  let jobs = add_job(jobs, "playground", pg_src, "wasm")
  let flow_full = read_file("self_hosting/lib/lexer.patlang") + chr(10) + read_file("self_hosting/lib/parser.patlang") + chr(10) + read_file("self_hosting/lib/lower.patlang") + chr(10) + read_file("self_hosting/lib/html.patlang") + chr(10) + read_file("self_hosting/tools/flowgraph_main.patlang")
  let jobs = add_job(jobs, "flowgraph", flow_full, "")
  let flowgraph_wasm_src = read_file("self_hosting/lib/lexer.patlang") + chr(10) + read_file("self_hosting/lib/parser.patlang") + chr(10) + read_file("self_hosting/lib/lower.patlang") + chr(10) + read_file("self_hosting/lib/html.patlang") + chr(10) + read_file("self_hosting/examples/flowgraph_wasm_main.patlang")
  let jobs = add_job(jobs, "flowgraphdemo", flowgraph_wasm_src, "wasm")
  let maze_wasm_src = read_file("self_hosting/lib/lexer.patlang") + chr(10) + read_file("self_hosting/lib/parser.patlang") + chr(10) + read_file("self_hosting/lib/lower.patlang") + chr(10) + read_file("self_hosting/lib/maze.patlang") + chr(10) + read_file("self_hosting/examples/maze_wasm_main.patlang")
  let jobs = add_job(jobs, "maze", maze_wasm_src, "wasm")
  let jobs = add_job(jobs, "fiber", read_file("self_hosting/examples/fiber_demo.patlang"), "wasm")
  let jobs = add_job(jobs, "robots", read_file("self_hosting/examples/robots_demo.patlang"), "wasm")
  let jobs = add_job(jobs, "cga", read_file("self_hosting/examples/cga_classifier.patlang"), "wasm")
  return jobs
end

print("scanning for stale demos to precompile in parallel...")
let precompile_jobs = build_precompile_jobs()
print("precompiling " + precompile_jobs.length + " stale target(s), " + precompile_batch_size() + " at a time...")
let pj = 0
let precompile_failures = []
while pj < precompile_jobs.length do
  let batch = []
  while (pj < precompile_jobs.length) and (list_len(batch) < precompile_batch_size()) do
    let batch = list_push(batch, precompile_jobs[pj])
    let pj = pj + 1
  end
  let results = parallel_map(batch, "precompile_job")
  let ri = 0
  while ri < list_len(results) do
    if results[ri] != "" then
      let precompile_failures = list_push(precompile_failures, results[ri])
    end
    let ri = ri + 1
  end
  print("[precompile] " + pj + "/" + precompile_jobs.length + " done")
end
if list_len(precompile_failures) > 0 then
  let fi = 0
  while fi < list_len(precompile_failures) do
    print(precompile_failures[fi])
    let fi = fi + 1
  end
  print("portfolio: " + list_len(precompile_failures) + " demo build(s) failed")
  exit_with(1)
end
print("precompile pass done")

# Each demo/native card is now its own fragment-mode page (portfolio/demos/
# <slug>.html), written via lib/template.patlang, instead of one section
# appended into a single monolithic portfolio/index.html. Fragment mode
# emits no <html>/<head>/<body> wrapper -- see template.patlang's header
# comment -- so these files are ready to be embedded, as-is, into
# parslow.net's own page shell (real TOC/nav/breadcrumbs), not just viewed
# standalone.

# native_page: a demo with only a captured build-machine transcript, no
# "run in this browser" button (native-only features: file I/O, subprocess
# calls, etc. that can't run inside the WASI-sandboxed browser demo).
make a function called native_page takes slug, title, blurb, src, transcript returns done
  let sections = [tpl_para(blurb)]
  let sections = list_push(sections, tpl_raw("<details><summary>PatLang source</summary><pre class='src'>" + html_escape(src) + "</pre></details>"))
  let sections = list_push(sections, tpl_raw("<p class='label'>Native run on the build machine:</p>"))
  let sections = list_push(sections, tpl_raw("<pre class='out native'>" + html_escape(transcript) + "</pre>"))
  let page = tpl_page(title, "fragment", sections)
  write_file("portfolio/demos/" + slug + ".html", render_page(page))
  print("wrote portfolio/demos/" + slug + ".html")
  return true
end

# demo_page: a demo runnable live in the browser, PLUS its native
# transcript. The card's program is built by v2 as a WebAssembly module of
# its own (the same source as the native transcript's), and "Run in this
# browser" runs that module.
make a function called demo_page takes slug, title, blurb, src, transcript returns done
  let card_b64 = compile_wasm_only(src, slug + "_card")
  let sections = [tpl_para(blurb)]
  let sections = list_push(sections, tpl_raw("<details><summary>PatLang source</summary><pre class='src' id='src-" + slug + "'>" + html_escape(src) + "</pre></details>"))
  let sections = list_push(sections, tpl_raw("<p><button onclick='runCard(" + q() + slug + q() + ")'>Run in this browser</button> <span class='ms' id='ms-" + slug + "'></span></p>"))
  let sections = list_push(sections, tpl_raw("<pre class='out' id='out-" + slug + "'>(not run yet)</pre>"))
  let sections = list_push(sections, tpl_raw("<p class='label'>Native run on the build machine:</p>"))
  let sections = list_push(sections, tpl_raw("<pre class='out native'>" + html_escape(transcript) + "</pre>"))
  let js = sb_new()
  sb_push(js, "const WASMS = { " + json_quote(slug) + ": '" + card_b64 + "' };" + nl())
  runwasm_core_js(js)
  sb_push(js, "function runCard(id) { return runWasm(id, id, []); }" + nl())
  let sections = list_push(sections, tpl_script(sb_str(js)))
  let page = tpl_page(title, "fragment", sections)
  write_file("portfolio/demos/" + slug + ".html", render_page(page))
  print("wrote portfolio/demos/" + slug + ".html")
  return true
end

# One card of language_flavors_page below: same shape as demo_page's own
# per-demo sections (source + run button + output + native transcript), but
# returned as a Card node instead of writing its own file, so three of them
# can share ONE page (and one embedded copy of the wasm playground module,
# rather than tripling it across three separate files).
make a function called lang_flavor_card takes slug, title, blurb, src, transcript returns node
  let body = [tpl_para(blurb)]
  let body = list_push(body, tpl_raw("<details><summary>" + title + " source</summary><pre class='src' id='src-" + slug + "'>" + html_escape(src) + "</pre></details>"))
  let body = list_push(body, tpl_raw("<p><button onclick='runCard(" + q() + slug + q() + ")'>Compile and run in this browser</button> <span class='ms' id='ms-" + slug + "'></span></p>"))
  let body = list_push(body, tpl_raw("<pre class='out' id='out-" + slug + "'>(not run yet)</pre>"))
  let body = list_push(body, tpl_raw("<p class='label'>Native run on the build machine:</p>"))
  let body = list_push(body, tpl_raw("<pre class='out native'>" + html_escape(transcript) + "</pre>"))
  return tpl_card(title, body)
end

# Three cosmetic-syntax dialects (Java-ese/C++-ese/Python-ese) over one
# page, all built from self_hosting/lib/syntax_dsl.patlang's Block/Many/
# ${...} primitives -- see self_hosting/examples/language_flavors/*_source
# .patlang for the actual `syntax { ... }` declarations. Deliberately one
# page, not three: the point being demonstrated (one generic preprocessing
# mechanism, three differently-dressed skins) reads better as one article
# than three disconnected demo cards, and it avoids embedding the ~2MB wasm
# playground module three times over.
make a function called language_flavors_page takes java_src, java_native, cpp_src, cpp_native, py_src, py_native, pg_b64 returns done
  let intro = "Three tiny cosmetic dialects over the same underlying language, all built from PatLang's own <code>syntax { ... }</code> grammar-extension feature (<code>self_hosting/lib/syntax_dsl.patlang</code>) -- the same source-to-source preprocessing mechanism behind the <a href='patlang-router-dsl.html'>Router DSL</a> and <a href='patlang-dynamic-syntax.html'>Dynamic Syntax</a> demos, extended with two more primitives: <code>Block</code>, which captures a brace-delimited body (possibly spanning many lines) and recursively re-expands it against the same rule set, and <code>Many</code>, which repeats a named rule zero or more times (used here for <code>switch</code>/<code>case</code> clauses and Python-ese's <code>elif</code> chains). Each dialect below is a plain PatLang program with its own <code>syntax</code> declaration at the top -- nothing about the real lexer, parser, or compiler changed to support any of this."
  let disclaimer = "<strong>None of this is a Java, C++, or Python compiler, and it isn't trying to be.</strong> Each dialect is a thin cosmetic skin: keywords and punctuation are pattern-matched and rewritten textually, not parsed against Java's, C++'s, or Python's real grammars. There is no type system, no classes or inheritance, no generics or templates, no exception handling, and expressions are captured as opaque text rather than genuinely parsed -- a header ending in <code>)</code> (an <code>if</code>/<code>while</code>/<code>for</code> condition, a function's parameter list) can't itself contain unbalanced parentheses, and function parameters are bare, untyped names, because that is exactly the shape PatLang's own <code>takes a, b</code> syntax already needs, with no per-parameter type-stripping logic written. Python-ese also cheats on Python's single most recognizable feature: blocks are delimited by <code>{ }</code>, not indentation, because the <code>Block</code> primitive only understands balanced braces -- a genuine indentation-sensitive capture is a different, not-yet-built primitive. Every one of these gaps is a real, fixable next step on top of the same mechanism, not a wall; none of it has been built here."
  let sections = [tpl_para(intro)]
  let sections = list_push(sections, tpl_raw("<p>" + disclaimer + "</p>"))
  let sections = list_push(sections, lang_flavor_card("javaese", "Java-ese", "A function, a checked <code>if</code>/<code>else</code>, a C-style <code>for</code> loop, a <code>while</code> loop, and a <code>switch</code>/<code>case</code> block -- each header's condition or value is captured as real PatLang code (not just a data string) and spliced back in with <code>${...}</code>, so <code>i &lt; 3</code> stays a genuine boolean expression rather than a quoted piece of text.", java_src, java_native))
  let sections = list_push(sections, lang_flavor_card("cppese", "C++-ese", "The same control-flow shapes as Java-ese, dressed differently: <code>std::cout &lt;&lt; x &lt;&lt; std::endl</code> in place of a print statement, and <code>auto</code> alongside typed declarations -- the same two primitives (<code>Block</code>, <code>Many</code>), a different skin.", cpp_src, cpp_native))
  let sections = list_push(sections, lang_flavor_card("pythonese", "Python-ese", "No semicolons, <code>def</code> for functions, an <code>if</code>/<code>elif</code>/<code>else</code> chain (the same <code>Many</code> primitive Java-ese uses for <code>case</code> clauses, applied to a different construct), and <code>for x in range(n)</code> translated into a counting <code>while</code> loop underneath. Blocks still use <code>{ }</code> -- see the disclaimer above.", py_src, py_native))
  let js = sb_new()
  sb_push(js, "const WASMS = { playground: '" + pg_b64 + "' };" + nl())
  wasi_shim_js(js)
  sb_push(js, "function runCard(id) { return runWasm(id, 'playground', [srcText(id)]); }" + nl())
  let sections = list_push(sections, tpl_script(sb_str(js)))
  let page = tpl_page("Wearing Borrowed Syntax: Java, C++, and Python-flavored PatLang", "fragment", sections)
  write_file("portfolio/demos/language-flavors.html", render_page(page))
  print("wrote portfolio/demos/language-flavors.html")
  return true
end

# repl_page: a live, in-browser REPL reusing the SAME shared "playground"
# wasm module every other demo card uses (self_hosting/examples/
# playground_main.patlang, which already takes source text as argv()[0] and
# already checks for parse errors before running -- exactly what a REPL
# needs, no new wasm build required). All new code here is JS state
# management on top of the existing wasi_shim_js runWasm/b64bytes bridge:
# a growing declBuffer (persisted declarations only) plus a transcript,
# mirroring self_hosting/lib/repl_core.patlang's design one-for-one --
# declarations (let/make a function called/rule_add(/action_add(/when /
# include /syntax ) are appended raw to declBuffer and never print
# anything on success, so replaying the whole buffer every turn (the same
# approach the CLI REPL uses, since there's no incremental-eval state to
# carry between runWasm calls either) never re-echoes a past turn's
# output; anything else is wrapped in print(...) and run transiently,
# never persisted. See self_hosting/tools/repl.patlang's header for the
# one shared honest limitation (a `let` with a side-effecting
# right-hand side re-runs that side effect every subsequent turn).
#
# Real bug found and fixed 2026-07-13 via a genuine functional test (a
# Node.js harness driving the actual compiled wasm module, not a mock --
# see self_hosting/lib/repl_core.patlang's session notes): wasi_shim_js's
# runWasm caught a fatal PatLang runtime error (no try/catch in PatLang
# itself -- this is real, not a REPL bug) via JS try/catch, but only put
# the error text in the DOM element, not in the RETURNED string -- so
# `hadError` here, which only inspects the return value, never saw runtime
# failures, only parse errors. A crashed declaration turn was silently
# treated as successful and permanently baked into replDeclBuffer, replaying
# (and re-failing) every subsequent turn. Fixed by making runWasm's catch
# branch return the error-annotated string too, and widening `hadError`
# to check for it. NOTE this is browser-only: the CLI REPL can't have this
# failure mode at all, because a fatal error there kills the whole OS
# process -- there's no continuation to persist a broken entry into.
#
# Also worth knowing, not fixed: an entry that mixes a real declaration
# with OTHER statements on later lines (e.g. `let x = 10` then a `print(...)`
# in the same multi-line entry) gets classified as one unit by its first
# line and, if it runs without error, the WHOLE thing -- including the
# print -- is appended to replDeclBuffer, so that print will re-fire every
# future turn too. One entry should be one statement (a single multi-line
# block like `make a function called ... end` is still fine, since that's
# genuinely one statement) -- mixing several separate statements into one
# entry is a real gap in what this REPL classifies correctly.
make a function called repl_page takes pg_b64 returns done
  let sections = [tpl_para("A live PatLang session, running entirely in this tab -- no server involved. Each entry should be ONE statement -- a single line, or a single multi-line block like <code>make a function called ... end</code> -- press the Run button or Ctrl+Enter to evaluate. This reuses the exact same compiled playground module every other demo card on this site shares, and the exact same session-buffer design as the real, standalone CLI REPL (<code>self_hosting/tools/repl.patlang</code>, <code>pat --ir-run</code> it yourself) -- see the <a href='patlang-paradigms.html'>Paradigms Guide</a> for how PatLang's self-hosted compiler pipeline (tokenize/parse_program/lower_program/run_ir) makes this possible with no new Rust at all.")]
  let sections = list_push(sections, tpl_raw("<pre id='repl-transcript' class='out' style='min-height:12em;white-space:pre-wrap'></pre>"))
  let sections = list_push(sections, tpl_raw("<textarea id='repl-input' rows='3' style='width:100%;font-family:monospace' placeholder='let x = 10' onkeydown='replKeydown(event)'></textarea>"))
  let sections = list_push(sections, tpl_raw("<p><button onclick='replSubmit()'>Run (Ctrl+Enter)</button> <button onclick='replReset()'>Reset session</button></p>"))
  let js = sb_new()
  sb_push(js, "const WASMS = { playground: '" + pg_b64 + "' };" + nl())
  wasi_shim_js(js)
  sb_push(js, "let replDeclBuffer = '';" + nl())
  sb_push(js, "const REPL_DECL_PREFIXES = ['let ', 'make a function called', 'rule_add(', 'action_add(', 'when ', 'include ', 'syntax '];" + nl())
  sb_push(js, "function replIsDeclaration(s) {" + nl())
  sb_push(js, "  const t = s.replace(/^\\s+/, '');" + nl())
  sb_push(js, "  return REPL_DECL_PREFIXES.some(function(p) { return t.indexOf(p) === 0; });" + nl())
  sb_push(js, "}" + nl())
  sb_push(js, "function replAppend(label, text) {" + nl())
  sb_push(js, "  const tEl = document.getElementById('repl-transcript');" + nl())
  sb_push(js, "  tEl.textContent += label + text + String.fromCharCode(10);" + nl())
  sb_push(js, "  tEl.scrollTop = tEl.scrollHeight;" + nl())
  sb_push(js, "}" + nl())
  sb_push(js, "async function replSubmit() {" + nl())
  sb_push(js, "  const inp = document.getElementById('repl-input');" + nl())
  sb_push(js, "  const entry = inp.value.replace(/\\s+$/, '');" + nl())
  sb_push(js, "  if (!entry) return;" + nl())
  sb_push(js, "  const isDecl = replIsDeclaration(entry);" + nl())
  sb_push(js, "  const candidate = replDeclBuffer + (isDecl ? entry + String.fromCharCode(10) : 'print(' + entry + ')' + String.fromCharCode(10));" + nl())
  sb_push(js, "  replAppend('patlang> ', entry);" + nl())
  sb_push(js, "  const output = await runWasm('repl', 'playground', [candidate]);" + nl())
  sb_push(js, "  const hadError = output.indexOf('parse error:') >= 0 || output.indexOf('[error:') >= 0;" + nl())
  sb_push(js, "  if (isDecl && !hadError) {" + nl())
  sb_push(js, "    replDeclBuffer += entry + String.fromCharCode(10);" + nl())
  sb_push(js, "    replAppend('', output ? output : '(ok)');" + nl())
  sb_push(js, "  } else {" + nl())
  sb_push(js, "    replAppend('', output ? output : '(no output)');" + nl())
  sb_push(js, "  }" + nl())
  sb_push(js, "  inp.value = '';" + nl())
  sb_push(js, "  inp.focus();" + nl())
  sb_push(js, "}" + nl())
  sb_push(js, "function replReset() {" + nl())
  sb_push(js, "  replDeclBuffer = '';" + nl())
  sb_push(js, "  document.getElementById('repl-transcript').textContent = '';" + nl())
  sb_push(js, "}" + nl())
  sb_push(js, "function replKeydown(e) {" + nl())
  sb_push(js, "  if (e.ctrlKey && e.key === 'Enter') { e.preventDefault(); replSubmit(); }" + nl())
  sb_push(js, "}" + nl())
  let sections = list_push(sections, tpl_script(sb_str(js)))
  let page = tpl_page("PatLang Live REPL", "fragment", sections)
  write_file("portfolio/demos/repl.html", render_page(page))
  print("wrote portfolio/demos/repl.html")
  return true
end

# hexrts_page: an interactive hex-grid RTS-lite economy sim. Left-click
# selects a unit, right-click issues an order to it (harvest if the
# targeted tile is a resource, otherwise move) -- the unit then works
# autonomously (path there, harvest up to its carry cap, path home,
# deposit, repeat) until the resource tile runs dry, exactly like a real
# RTS gather loop. "B" toggles build mode; the next left-click places a
# trainer, which spends banked ore and, once built, periodically spends
# more to produce new workers. No combat, one faction -- an open sandbox,
# not a scored game.
#
# Reuses runwasm_only_js (not the full wasi_shim_js) since this page has
# its own canvas rendering, not the editor/highlighting machinery the
# playground-based pages use. The compiled hexrts module is a NORMAL
# compiled program (argv in, print out), not a meta-circular compiler-in-
# wasm -- see self_hosting/examples/hexrts_main.patlang. Each tick, JS
# sends the CURRENT state snapshot plus only this tick's new orders and
# gets back the next snapshot -- see self_hosting/lib/hexrts.patlang's own
# header for why this (not replaying an ever-growing order log, the
# REPL's approach) is the right model for something driven by live user
# interaction.
make a function called hexrts_page takes hexrts_b64 returns done
  let sections = [tpl_para("A small hex-grid economy sim, running entirely in this tab. <strong>Left-click</strong> a unit to select it. <strong>Right-click</strong> a tile to send the selected unit there -- a resource tile (gold, with a number) starts an automatic gather loop: the unit paths there, harvests up to its carry capacity, paths home, deposits, and repeats until that tile runs dry. Press <strong>B</strong> to enter build mode, then left-click a grass tile to place a trainer (costs banked ore; once built it periodically spends more ore to produce new workers). No combat, one faction -- an open sandbox, not a scored game. See the <a href='patlang-paradigms.html'>Paradigms Guide</a> and <code>self_hosting/lib/hexrts.patlang</code> for the design: a pure <code>step(state, orders) -&gt; new_state</code> function, with the browser carrying the current snapshot forward one tick at a time rather than replaying history.")]
  let sections = list_push(sections, tpl_raw("<p id='hexrts-ore' class='out' style='font-size:1.3em;font-weight:bold'>Ore: --</p>"))
  let sections = list_push(sections, tpl_raw("<div style='display:flex;gap:10px;flex-wrap:wrap'><canvas id='hexrts-canvas' width='560' height='520' style='background:#1a1a1a;border:1px solid #444'></canvas><pre id='hexrts-log' class='out' style='width:260px;height:520px;overflow-y:auto;margin:0'></pre></div>"))
  let sections = list_push(sections, tpl_raw("<p id='hexrts-info' class='out'>loading...</p>"))
  let js = sb_new()
  sb_push(js, "const WASMS = { hexrts: '" + hexrts_b64 + "' };" + nl())
  runwasm_only_js(js)
  sb_push(js, "const HEX_SIZE = 22;" + nl())
  sb_push(js, "const canvas = document.getElementById('hexrts-canvas');" + nl())
  sb_push(js, "const ctx = canvas.getContext('2d');" + nl())
  sb_push(js, "let currentStateText = '';" + nl())
  sb_push(js, "let gameState = null;" + nl())
  sb_push(js, "let selectedUnitId = null;" + nl())
  sb_push(js, "let buildMode = false;" + nl())
  sb_push(js, "let pendingOrders = [];" + nl())
  sb_push(js, "let eventLog = [];" + nl())
  sb_push(js, "function axialToPixel(q, r) {" + nl())
  sb_push(js, "  const x = HEX_SIZE * Math.sqrt(3) * (q + r / 2);" + nl())
  sb_push(js, "  const y = HEX_SIZE * 1.5 * r;" + nl())
  sb_push(js, "  return [x + canvas.width / 2, y + canvas.height / 2];" + nl())
  sb_push(js, "}" + nl())
  sb_push(js, "function parseState(text) {" + nl())
  sb_push(js, "  const lines = text.split(String.fromCharCode(10));" + nl())
  sb_push(js, "  const state = { resource: 0, units: [], tiles: [], builds: [], events: [] };" + nl())
  sb_push(js, "  for (const raw of lines) {" + nl())
  sb_push(js, "    const line = raw.trim();" + nl())
  sb_push(js, "    if (!line) continue;" + nl())
  sb_push(js, "    if (line.indexOf('RESOURCE:') === 0) {" + nl())
  sb_push(js, "      state.resource = parseInt(line.slice(9), 10);" + nl())
  sb_push(js, "    } else if (line.indexOf('UNIT:') === 0) {" + nl())
  sb_push(js, "      const f = line.slice(5).split(',');" + nl())
  sb_push(js, "      state.units.push({ id: +f[0], q: +f[1], r: +f[2], order: f[5], carrying: +f[6] });" + nl())
  sb_push(js, "    } else if (line.indexOf('TILE:') === 0) {" + nl())
  sb_push(js, "      const f = line.slice(5).split(',');" + nl())
  sb_push(js, "      state.tiles.push({ q: +f[0], r: +f[1], terrain: f[2], amount: +f[3] });" + nl())
  sb_push(js, "    } else if (line.indexOf('BUILD:') === 0) {" + nl())
  sb_push(js, "      const f = line.slice(6).split(',');" + nl())
  sb_push(js, "      state.builds.push({ id: +f[0], type: f[1], q: +f[2], r: +f[3], done: f[5] === '1' });" + nl())
  sb_push(js, "    } else if (line.indexOf('EVENT:') === 0) {" + nl())
  sb_push(js, "      state.events.push(line.slice(6));" + nl())
  sb_push(js, "    }" + nl())
  sb_push(js, "  }" + nl())
  sb_push(js, "  return state;" + nl())
  sb_push(js, "}" + nl())
  sb_push(js, "function hexCorner(cx, cy, i) {" + nl())
  sb_push(js, "  const angle = Math.PI / 180 * (60 * i - 30);" + nl())
  sb_push(js, "  return [cx + HEX_SIZE * Math.cos(angle), cy + HEX_SIZE * Math.sin(angle)];" + nl())
  sb_push(js, "}" + nl())
  sb_push(js, "function drawHex(cx, cy, fillStyle) {" + nl())
  sb_push(js, "  ctx.beginPath();" + nl())
  sb_push(js, "  for (let i = 0; i < 6; i++) {" + nl())
  sb_push(js, "    const c = hexCorner(cx, cy, i);" + nl())
  sb_push(js, "    if (i === 0) ctx.moveTo(c[0], c[1]); else ctx.lineTo(c[0], c[1]);" + nl())
  sb_push(js, "  }" + nl())
  sb_push(js, "  ctx.closePath();" + nl())
  sb_push(js, "  ctx.fillStyle = fillStyle;" + nl())
  sb_push(js, "  ctx.fill();" + nl())
  sb_push(js, "  ctx.strokeStyle = '#222';" + nl())
  sb_push(js, "  ctx.stroke();" + nl())
  sb_push(js, "}" + nl())
  sb_push(js, "function terrainColor(t) {" + nl())
  sb_push(js, "  if (t === 'resource') return '#c9a227';" + nl())
  sb_push(js, "  if (t === 'base') return '#4a7fd6';" + nl())
  sb_push(js, "  return '#3a6b3a';" + nl())
  sb_push(js, "}" + nl())
  sb_push(js, "function render() {" + nl())
  sb_push(js, "  if (!gameState) return;" + nl())
  sb_push(js, "  ctx.clearRect(0, 0, canvas.width, canvas.height);" + nl())
  sb_push(js, "  for (const t of gameState.tiles) {" + nl())
  sb_push(js, "    const p = axialToPixel(t.q, t.r);" + nl())
  sb_push(js, "    drawHex(p[0], p[1], terrainColor(t.terrain));" + nl())
  sb_push(js, "    if (t.terrain === 'resource' && t.amount > 0) {" + nl())
  sb_push(js, "      ctx.fillStyle = '#fff';" + nl())
  sb_push(js, "      ctx.font = '10px monospace';" + nl())
  sb_push(js, "      ctx.textAlign = 'center';" + nl())
  sb_push(js, "      ctx.fillText(String(t.amount), p[0], p[1] + 3);" + nl())
  sb_push(js, "    }" + nl())
  sb_push(js, "  }" + nl())
  sb_push(js, "  for (const b of gameState.builds) {" + nl())
  sb_push(js, "    const p = axialToPixel(b.q, b.r);" + nl())
  sb_push(js, "    ctx.fillStyle = b.done ? '#d64a4a' : '#d6a04a';" + nl())
  sb_push(js, "    ctx.fillRect(p[0] - 7, p[1] - 7, 14, 14);" + nl())
  sb_push(js, "  }" + nl())
  sb_push(js, "  for (const u of gameState.units) {" + nl())
  sb_push(js, "    const p = axialToPixel(u.q, u.r);" + nl())
  sb_push(js, "    ctx.beginPath();" + nl())
  sb_push(js, "    ctx.arc(p[0], p[1], 6, 0, Math.PI * 2);" + nl())
  sb_push(js, "    ctx.fillStyle = u.carrying > 0 ? '#f0d040' : '#e8e8e8';" + nl())
  sb_push(js, "    ctx.fill();" + nl())
  sb_push(js, "    ctx.strokeStyle = u.id === selectedUnitId ? '#ffffff' : '#000000';" + nl())
  sb_push(js, "    ctx.lineWidth = u.id === selectedUnitId ? 3 : 1;" + nl())
  sb_push(js, "    ctx.stroke();" + nl())
  sb_push(js, "    ctx.lineWidth = 1;" + nl())
  sb_push(js, "  }" + nl())
  sb_push(js, "  const info = document.getElementById('hexrts-info');" + nl())
  sb_push(js, "  if (info) {" + nl())
  sb_push(js, "    info.textContent = (buildMode ? 'BUILD MODE -- click a grass tile to place a trainer' : 'Press B to build') + (selectedUnitId !== null ? '  |  selected unit ' + selectedUnitId : '  |  no unit selected');" + nl())
  sb_push(js, "  }" + nl())
  sb_push(js, "  const oreEl = document.getElementById('hexrts-ore');" + nl())
  sb_push(js, "  if (oreEl) { oreEl.textContent = 'Ore: ' + gameState.resource; }" + nl())
  sb_push(js, "  const logEl = document.getElementById('hexrts-log');" + nl())
  sb_push(js, "  if (logEl) { logEl.textContent = eventLog.join(String.fromCharCode(10)); logEl.scrollTop = logEl.scrollHeight; }" + nl())
  sb_push(js, "}" + nl())
  sb_push(js, "function nearestTile(px, py) {" + nl())
  sb_push(js, "  let best = null; let bestD = Infinity;" + nl())
  sb_push(js, "  for (const t of gameState.tiles) {" + nl())
  sb_push(js, "    const p = axialToPixel(t.q, t.r);" + nl())
  sb_push(js, "    const d = (p[0] - px) * (p[0] - px) + (p[1] - py) * (p[1] - py);" + nl())
  sb_push(js, "    if (d < bestD) { bestD = d; best = t; }" + nl())
  sb_push(js, "  }" + nl())
  sb_push(js, "  return best;" + nl())
  sb_push(js, "}" + nl())
  sb_push(js, "function nearestUnit(px, py) {" + nl())
  sb_push(js, "  let best = null; let bestD = Infinity;" + nl())
  sb_push(js, "  for (const u of gameState.units) {" + nl())
  sb_push(js, "    const p = axialToPixel(u.q, u.r);" + nl())
  sb_push(js, "    const d = (p[0] - px) * (p[0] - px) + (p[1] - py) * (p[1] - py);" + nl())
  sb_push(js, "    if (d < bestD && d < HEX_SIZE * HEX_SIZE) { bestD = d; best = u; }" + nl())
  sb_push(js, "  }" + nl())
  sb_push(js, "  return best;" + nl())
  sb_push(js, "}" + nl())
  sb_push(js, "canvas.addEventListener('click', function(e) {" + nl())
  sb_push(js, "  if (!gameState) return;" + nl())
  sb_push(js, "  const rect = canvas.getBoundingClientRect();" + nl())
  sb_push(js, "  const px = e.clientX - rect.left;" + nl())
  sb_push(js, "  const py = e.clientY - rect.top;" + nl())
  sb_push(js, "  if (buildMode) {" + nl())
  sb_push(js, "    const t = nearestTile(px, py);" + nl())
  sb_push(js, "    if (t && t.terrain === 'grass') {" + nl())
  sb_push(js, "      pendingOrders.push('build,trainer,' + t.q + ',' + t.r);" + nl())
  sb_push(js, "      eventLog.push('Queued: place a trainer at (' + t.q + ',' + t.r + ')');" + nl())
  sb_push(js, "    } else {" + nl())
  sb_push(js, "      eventLog.push('Can only build on a plain grass tile');" + nl())
  sb_push(js, "    }" + nl())
  sb_push(js, "    buildMode = false;" + nl())
  sb_push(js, "    render();" + nl())
  sb_push(js, "    return;" + nl())
  sb_push(js, "  }" + nl())
  sb_push(js, "  const u = nearestUnit(px, py);" + nl())
  sb_push(js, "  selectedUnitId = u ? u.id : null;" + nl())
  sb_push(js, "  if (u) { eventLog.push('Selected unit ' + u.id); }" + nl())
  sb_push(js, "  render();" + nl())
  sb_push(js, "});" + nl())
  sb_push(js, "canvas.addEventListener('contextmenu', function(e) {" + nl())
  sb_push(js, "  e.preventDefault();" + nl())
  sb_push(js, "  if (!gameState || selectedUnitId === null) return;" + nl())
  sb_push(js, "  const rect = canvas.getBoundingClientRect();" + nl())
  sb_push(js, "  const px = e.clientX - rect.left;" + nl())
  sb_push(js, "  const py = e.clientY - rect.top;" + nl())
  sb_push(js, "  const t = nearestTile(px, py);" + nl())
  sb_push(js, "  if (!t) return;" + nl())
  sb_push(js, "  if (t.terrain === 'resource') {" + nl())
  sb_push(js, "    pendingOrders.push('harvest,' + selectedUnitId + ',' + t.q + ',' + t.r);" + nl())
  sb_push(js, "    eventLog.push('Unit ' + selectedUnitId + ' ordered to gather at (' + t.q + ',' + t.r + ')');" + nl())
  sb_push(js, "  } else {" + nl())
  sb_push(js, "    pendingOrders.push('move,' + selectedUnitId + ',' + t.q + ',' + t.r);" + nl())
  sb_push(js, "    eventLog.push('Unit ' + selectedUnitId + ' ordered to move to (' + t.q + ',' + t.r + ')');" + nl())
  sb_push(js, "  }" + nl())
  sb_push(js, "  render();" + nl())
  sb_push(js, "});" + nl())
  sb_push(js, "window.addEventListener('keydown', function(e) {" + nl())
  sb_push(js, "  if (e.key === 'b' || e.key === 'B') {" + nl())
  sb_push(js, "    buildMode = !buildMode;" + nl())
  sb_push(js, "    if (buildMode) { eventLog.push('Build mode -- click a grass tile'); }" + nl())
  sb_push(js, "    render();" + nl())
  sb_push(js, "  }" + nl())
  sb_push(js, "});" + nl())
  sb_push(js, "async function hexrtsTick() {" + nl())
  sb_push(js, "  const ordersText = pendingOrders.join(String.fromCharCode(10));" + nl())
  sb_push(js, "  pendingOrders = [];" + nl())
  sb_push(js, "  const out = await runWasm('hexrts-status', 'hexrts', [currentStateText, ordersText]);" + nl())
  sb_push(js, "  if (out.indexOf('[error:') < 0) {" + nl())
  sb_push(js, "    currentStateText = out;" + nl())
  sb_push(js, "    gameState = parseState(out);" + nl())
  sb_push(js, "    for (const e of gameState.events) { eventLog.push(e); }" + nl())
  sb_push(js, "    if (eventLog.length > 200) { eventLog = eventLog.slice(eventLog.length - 200); }" + nl())
  sb_push(js, "  }" + nl())
  sb_push(js, "  render();" + nl())
  sb_push(js, "}" + nl())
  sb_push(js, "async function hexrtsInit() {" + nl())
  sb_push(js, "  const out = await runWasm('hexrts-status', 'hexrts', ['INIT', '']);" + nl())
  sb_push(js, "  currentStateText = out;" + nl())
  sb_push(js, "  gameState = parseState(out);" + nl())
  sb_push(js, "  eventLog.push('Game started -- 2 workers, ' + gameState.resource + ' ore banked.');" + nl())
  sb_push(js, "  render();" + nl())
  sb_push(js, "  setInterval(hexrtsTick, 800);" + nl())
  sb_push(js, "}" + nl())
  sb_push(js, "hexrtsInit();" + nl())
  let sections = list_push(sections, tpl_script(sb_str(js)))
  let page = tpl_page("PatLang Hex RTS", "fragment", sections)
  write_file("portfolio/demos/hexrts.html", render_page(page))
  print("wrote portfolio/demos/hexrts.html")
  return true
end

# family_tree_page: an interactive ancestry/sibling explorer. Type a
# child and a parent id and click "Add relationship" to grow the tree;
# click any drawn node to select it, then Ancestors/Descendants/Siblings
# highlights the matching nodes and prints a text report. Same
# "recompute full state from a snapshot every call" model as hexrts
# above -- self_hosting/examples/family_tree_main.patlang is a normal
# compiled program (argv in, print out), replaying the FULL edge list
# from scratch every call rather than a persistent process, so the
# browser side just accumulates every "child,parent" line ever added
# and resends all of it each time. See self_hosting/lib/family_tree.
# patlang for the actual ancestor/descendant/sibling logic this demo is
# a UI over -- that library has no fantpop-patlang or demo-specific code
# in it at all, so it's exactly as usable from a script as from this
# page (see D:\...\fantpop-patlang\lib\family_tree.patlang, which
# just includes this same file).
make a function called family_tree_page takes family_tree_b64 returns done
  let sections = [tpl_para("Build a family tree by adding <strong>child, parent</strong> relationships, then click any node to explore it. See <code>self_hosting/lib/family_tree.patlang</code> for the underlying ancestor/descendant/sibling logic -- a small, reusable module (SQL-backed durable storage plus an in-memory adjacency index for fast traversal) with no demo-specific code in it, also used as-is by <a href='patlang-inductive-synthesis.html'>fantpop-patlang</a>'s own family tree reporting.")]
  let sections = list_push(sections, tpl_raw("<div style='display:flex;gap:6px;flex-wrap:wrap;align-items:center;margin-bottom:8px'><input id='ft-child' placeholder='child id' style='width:110px'><span>is a child of</span><input id='ft-parent' placeholder='parent id' style='width:110px'><button id='ft-add'>Add relationship</button><button id='ft-example'>Load example tree</button></div>"))
  let sections = list_push(sections, tpl_raw("<div style='display:flex;gap:10px;flex-wrap:wrap'><canvas id='ft-canvas' width='560' height='340' style='background:#1a1a1a;border:1px solid #444'></canvas><div style='width:260px'><div style='margin-bottom:6px'><button id='ft-ancestors'>Ancestors</button> <button id='ft-descendants'>Descendants</button> <button id='ft-siblings'>Siblings</button></div><pre id='ft-report' class='out' style='height:300px;overflow-y:auto;margin:0'>Click a node to select it.</pre></div></div>"))
  let sections = list_push(sections, tpl_raw("<p id='ft-info' class='out'>no node selected</p>"))
  let sections = list_push(sections, tpl_raw("<p id='out-ft-status' class='out' style='display:none'></p>"))
  let js = sb_new()
  sb_push(js, "const WASMS = { familytree: '" + family_tree_b64 + "' };" + nl())
  runwasm_only_js(js)
  sb_push(js, "const canvas = document.getElementById('ft-canvas');" + nl())
  sb_push(js, "const ctx = canvas.getContext('2d');" + nl())
  sb_push(js, "let edgeLines = [];" + nl())
  sb_push(js, "let nodes = [];" + nl())
  sb_push(js, "let edges = [];" + nl())
  sb_push(js, "let hilite = new Set();" + nl())
  sb_push(js, "let selected = null;" + nl())
  sb_push(js, "function parseOutput(text) {" + nl())
  sb_push(js, "  const lines = text.split(String.fromCharCode(10));" + nl())
  sb_push(js, "  const byLevel = {};" + nl())
  sb_push(js, "  const newNodes = []; const newEdges = []; const newHilite = new Set(); const reportLines = [];" + nl())
  sb_push(js, "  for (const raw of lines) {" + nl())
  sb_push(js, "    const line = raw.trim();" + nl())
  sb_push(js, "    if (!line) continue;" + nl())
  sb_push(js, "    if (line.indexOf('NODE:') === 0) {" + nl())
  sb_push(js, "      const f = line.slice(5).split(',');" + nl())
  sb_push(js, "      const level = +f[1];" + nl())
  sb_push(js, "      if (!byLevel[level]) byLevel[level] = 0;" + nl())
  sb_push(js, "      newNodes.push({ id: f[0], level: level, col: byLevel[level] });" + nl())
  sb_push(js, "      byLevel[level] += 1;" + nl())
  sb_push(js, "    } else if (line.indexOf('EDGE:') === 0) {" + nl())
  sb_push(js, "      const f = line.slice(5).split(',');" + nl())
  sb_push(js, "      newEdges.push({ child: f[0], parent: f[1] });" + nl())
  sb_push(js, "    } else if (line.indexOf('HILITE:') === 0) {" + nl())
  sb_push(js, "      newHilite.add(line.slice(7));" + nl())
  sb_push(js, "    } else if (line.indexOf('REPORT:') === 0) {" + nl())
  sb_push(js, "      reportLines.push(line.slice(7));" + nl())
  sb_push(js, "    }" + nl())
  sb_push(js, "  }" + nl())
  sb_push(js, "  nodes = newNodes; edges = newEdges; hilite = newHilite;" + nl())
  sb_push(js, "  if (reportLines.length) {" + nl())
  sb_push(js, "    document.getElementById('ft-report').textContent = reportLines.join(String.fromCharCode(10));" + nl())
  sb_push(js, "  }" + nl())
  sb_push(js, "}" + nl())
  sb_push(js, "function nodePos(n) {" + nl())
  sb_push(js, "  const rowY = 40 + n.level * 70;" + nl())
  sb_push(js, "  const colX = 50 + n.col * 90;" + nl())
  sb_push(js, "  return [colX, rowY];" + nl())
  sb_push(js, "}" + nl())
  sb_push(js, "function findNode(id) {" + nl())
  sb_push(js, "  for (const n of nodes) if (n.id === id) return n;" + nl())
  sb_push(js, "  return null;" + nl())
  sb_push(js, "}" + nl())
  sb_push(js, "function render() {" + nl())
  sb_push(js, "  ctx.clearRect(0, 0, canvas.width, canvas.height);" + nl())
  sb_push(js, "  ctx.strokeStyle = '#666';" + nl())
  sb_push(js, "  for (const e of edges) {" + nl())
  sb_push(js, "    const c = findNode(e.child); const p = findNode(e.parent);" + nl())
  sb_push(js, "    if (!c || !p) continue;" + nl())
  sb_push(js, "    const cp = nodePos(c); const pp = nodePos(p);" + nl())
  sb_push(js, "    ctx.beginPath(); ctx.moveTo(cp[0], cp[1]); ctx.lineTo(pp[0], pp[1]); ctx.stroke();" + nl())
  sb_push(js, "  }" + nl())
  sb_push(js, "  for (const n of nodes) {" + nl())
  sb_push(js, "    const p = nodePos(n);" + nl())
  sb_push(js, "    ctx.beginPath(); ctx.arc(p[0], p[1], 14, 0, Math.PI * 2);" + nl())
  sb_push(js, "    ctx.fillStyle = hilite.has(n.id) ? '#f0d040' : (n.id === selected ? '#4a9fd6' : '#3a6b3a');" + nl())
  sb_push(js, "    ctx.fill();" + nl())
  sb_push(js, "    ctx.strokeStyle = n.id === selected ? '#ffffff' : '#222';" + nl())
  sb_push(js, "    ctx.lineWidth = n.id === selected ? 2 : 1;" + nl())
  sb_push(js, "    ctx.stroke();" + nl())
  sb_push(js, "    ctx.lineWidth = 1;" + nl())
  sb_push(js, "    ctx.fillStyle = '#fff';" + nl())
  sb_push(js, "    ctx.font = '10px monospace';" + nl())
  sb_push(js, "    ctx.textAlign = 'center';" + nl())
  sb_push(js, "    ctx.fillText(n.id, p[0], p[1] + 26);" + nl())
  sb_push(js, "  }" + nl())
  sb_push(js, "  const info = document.getElementById('ft-info');" + nl())
  sb_push(js, "  if (info) info.textContent = selected ? ('selected: ' + selected) : 'no node selected';" + nl())
  sb_push(js, "}" + nl())
  sb_push(js, "async function refresh(queryKind) {" + nl())
  sb_push(js, "  const args = [edgeLines.join(String.fromCharCode(10)), queryKind || '', selected || ''];" + nl())
  sb_push(js, "  const out = await runWasm('ft-status', 'familytree', args);" + nl())
  sb_push(js, "  if (out.indexOf('[error:') < 0) { parseOutput(out); }" + nl())
  sb_push(js, "  render();" + nl())
  sb_push(js, "}" + nl())
  sb_push(js, "canvas.addEventListener('click', function(e) {" + nl())
  sb_push(js, "  const rect = canvas.getBoundingClientRect();" + nl())
  sb_push(js, "  const px = e.clientX - rect.left; const py = e.clientY - rect.top;" + nl())
  sb_push(js, "  let best = null; let bestD = Infinity;" + nl())
  sb_push(js, "  for (const n of nodes) {" + nl())
  sb_push(js, "    const p = nodePos(n);" + nl())
  sb_push(js, "    const d = (p[0]-px)*(p[0]-px) + (p[1]-py)*(p[1]-py);" + nl())
  sb_push(js, "    if (d < bestD && d < 20*20) { bestD = d; best = n; }" + nl())
  sb_push(js, "  }" + nl())
  sb_push(js, "  selected = best ? best.id : null;" + nl())
  sb_push(js, "  hilite = new Set();" + nl())
  sb_push(js, "  document.getElementById('ft-report').textContent = selected ? ('selected ' + selected + ' -- pick Ancestors/Descendants/Siblings') : 'Click a node to select it.';" + nl())
  sb_push(js, "  render();" + nl())
  sb_push(js, "});" + nl())
  sb_push(js, "document.getElementById('ft-add').addEventListener('click', function() {" + nl())
  sb_push(js, "  const c = document.getElementById('ft-child').value.trim();" + nl())
  sb_push(js, "  const p = document.getElementById('ft-parent').value.trim();" + nl())
  sb_push(js, "  if (!c || !p || c === p) return;" + nl())
  sb_push(js, "  edgeLines.push(c + ',' + p);" + nl())
  sb_push(js, "  document.getElementById('ft-child').value = '';" + nl())
  sb_push(js, "  document.getElementById('ft-parent').value = '';" + nl())
  sb_push(js, "  refresh('');" + nl())
  sb_push(js, "});" + nl())
  sb_push(js, "document.getElementById('ft-example').addEventListener('click', function() {" + nl())
  sb_push(js, "  edgeLines = ['bob,alice', 'carol,alice', 'erin,dave', 'frank,erin'];" + nl())
  sb_push(js, "  selected = null;" + nl())
  sb_push(js, "  refresh('');" + nl())
  sb_push(js, "});" + nl())
  sb_push(js, "document.getElementById('ft-ancestors').addEventListener('click', function() { if (selected) refresh('ancestors'); });" + nl())
  sb_push(js, "document.getElementById('ft-descendants').addEventListener('click', function() { if (selected) refresh('descendants'); });" + nl())
  sb_push(js, "document.getElementById('ft-siblings').addEventListener('click', function() { if (selected) refresh('siblings'); });" + nl())
  sb_push(js, "render();" + nl())
  let sections = list_push(sections, tpl_script(sb_str(js)))
  let page = tpl_page("PatLang Family Tree", "fragment", sections)
  write_file("portfolio/demos/family_tree.html", render_page(page))
  print("wrote portfolio/demos/family_tree.html")
  return true
end

# sql_console_page: a live SQL console with a tabbed data browser. Type a
# statement, press Enter/Run; the RESULT section (OK/ERROR/row data) shows
# in the output panel, and the tab bar (one tab per table that currently
# exists) shows the FULL current contents of whichever table is selected --
# parsed straight out of the compiled program's own STATE section
# (self_hosting/lib/rdbms.patlang's rdb_serialize already emits every
# table's full schema+rows every call, so no second query is needed just
# to refresh the tab view). Same "carry the whole snapshot forward"
# browser state model as the hex RTS -- see self_hosting/lib/rdbms.patlang
# and self_hosting/examples/sql_console_main.patlang's own headers for why.
# is_native is always '0' here: there's no real filesystem to flush a
# COMMIT to inside the WASM sandbox -- self_hosting/examples/rdbms_demo.patlang
# is where COMMIT's native disk-flush path is actually exercised.
make a function called sql_console_page takes sql_console_b64 returns done
  let sections = [tpl_para("A small transactional SQL database, running entirely in this tab. Type a statement and press Enter or Run -- try <code>CREATE TABLE people (id INT, name STRING, age INT)</code>, then <code>INSERT INTO people VALUES (1, 'alice', 30)</code>, then <code>SELECT * FROM people WHERE age &gt; 20</code>. <code>BEGIN</code>/<code>COMMIT</code>/<code>ROLLBACK</code> work too -- try inserting a row inside a transaction, then <code>ROLLBACK</code> and see it vanish. The tabs below always show a table's FULL current contents, independent of whatever your last SELECT filtered to. See the <a href='patlang-paradigms.html'>Paradigms Guide</a> and <code>self_hosting/lib/rdbms.patlang</code>/<code>sql.patlang</code> for the design: CSV-backed tables over the existing virtual filesystem, single-writer transactions (no real concurrency control exists to build on), and a hand-rolled SQL tokenizer/parser/executor -- all plain PatLang, no new Rust.")]
  let sections = list_push(sections, tpl_raw("<input id='sql-input' type='text' style='width:100%;font-family:monospace' placeholder=\"CREATE TABLE people (id INT, name STRING, age INT)\" onkeydown='sqlKeydown(event)'>"))
  let sections = list_push(sections, tpl_raw("<p><button onclick='sqlSubmit()'>Run</button></p>"))
  let sections = list_push(sections, tpl_raw("<pre id='sql-result' class='out'>Ready.</pre>"))
  let sections = list_push(sections, tpl_raw("<div id='sql-tabs'></div>"))
  let sections = list_push(sections, tpl_raw("<div id='sql-table' class='out'></div>"))
  let js = sb_new()
  sb_push(js, "const WASMS = { sqlconsole: '" + sql_console_b64 + "' };" + nl())
  runwasm_only_js(js)
  sb_push(js, "let currentDbText = '';" + nl())
  sb_push(js, "let tablesMap = {};" + nl())
  sb_push(js, "let activeTable = null;" + nl())
  sb_push(js, "function parseOutput(out) {" + nl())
  sb_push(js, "  const parts = out.split('===STATE===');" + nl())
  sb_push(js, "  const resultLines = parts[0].split(String.fromCharCode(10)).map(function(s) { return s.trim(); }).filter(function(s) { return s.length > 0; });" + nl())
  sb_push(js, "  const stateText = parts.length > 1 ? parts[1] : '';" + nl())
  sb_push(js, "  const result = { kind: 'error', message: 'no result', cols: [], rows: [] };" + nl())
  sb_push(js, "  if (resultLines.length > 0) {" + nl())
  sb_push(js, "    const first = resultLines[0];" + nl())
  sb_push(js, "    if (first.indexOf('RESULT:OK:') === 0) { result.kind = 'ok'; result.message = first.slice(10); }" + nl())
  sb_push(js, "    else if (first.indexOf('RESULT:ERROR:') === 0) { result.kind = 'error'; result.message = first.slice(13); }" + nl())
  sb_push(js, "    else if (first.indexOf('RESULT:ROWS:') === 0) {" + nl())
  sb_push(js, "      result.kind = 'rows';" + nl())
  sb_push(js, "      for (const line of resultLines.slice(1)) {" + nl())
  sb_push(js, "        if (line.indexOf('COL:') === 0) { result.cols.push(line.slice(4)); }" + nl())
  sb_push(js, "        else if (line.indexOf('ROW:') === 0) { result.rows.push(line.slice(4).split(',')); }" + nl())
  sb_push(js, "      }" + nl())
  sb_push(js, "    }" + nl())
  sb_push(js, "  }" + nl())
  sb_push(js, "  const tables = {};" + nl())
  sb_push(js, "  let curTable = null;" + nl())
  sb_push(js, "  let curStaged = null;" + nl())
  sb_push(js, "  for (const raw of stateText.split(String.fromCharCode(10))) {" + nl())
  sb_push(js, "    const line = raw.trim();" + nl())
  sb_push(js, "    if (!line) continue;" + nl())
  sb_push(js, "    if (line.indexOf('STAGEDTABLE:') === 0) { curStaged = line.slice(12); tables[curStaged] = { cols: [], rows: [] }; }" + nl())
  sb_push(js, "    else if (line.indexOf('STAGEDSCHEMA:') === 0 && curStaged) { tables[curStaged].cols = line.slice(13).split(',').map(function(p) { return p.split(':')[0]; }); }" + nl())
  sb_push(js, "    else if (line.indexOf('STAGEDROW:') === 0 && curStaged) { tables[curStaged].rows.push(line.slice(10).split(',')); }" + nl())
  sb_push(js, "    else if (line.indexOf('TABLE:') === 0) { curTable = line.slice(6); tables[curTable] = { cols: [], rows: [] }; }" + nl())
  sb_push(js, "    else if (line.indexOf('SCHEMA:') === 0 && curTable) { tables[curTable].cols = line.slice(7).split(',').map(function(p) { return p.split(':')[0]; }); }" + nl())
  sb_push(js, "    else if (line.indexOf('ROW:') === 0 && curTable) { tables[curTable].rows.push(line.slice(4).split(',')); }" + nl())
  sb_push(js, "  }" + nl())
  sb_push(js, "  return { result: result, tables: tables, stateText: stateText };" + nl())
  sb_push(js, "}" + nl())
  sb_push(js, "function escHtml(s) { return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;'); }" + nl())
  sb_push(js, "function renderTabs() {" + nl())
  sb_push(js, "  const names = Object.keys(tablesMap);" + nl())
  sb_push(js, "  const tabsEl = document.getElementById('sql-tabs');" + nl())
  sb_push(js, "  if (names.length === 0) { tabsEl.innerHTML = '<em>No tables yet -- try a CREATE TABLE statement.</em>'; return; }" + nl())
  sb_push(js, "  if (!activeTable || names.indexOf(activeTable) < 0) { activeTable = names[0]; }" + nl())
  sb_push(js, "  let html = '';" + nl())
  sb_push(js, "  for (const name of names) {" + nl())
  sb_push(js, "    const isActive = name === activeTable;" + nl())
  sb_push(js, "    html += '<button onclick=\"selectTab(\\'' + name + '\\')\" style=\"font-weight:' + (isActive ? 'bold' : 'normal') + '\">' + escHtml(name) + '</button> ';" + nl())
  sb_push(js, "  }" + nl())
  sb_push(js, "  tabsEl.innerHTML = html;" + nl())
  sb_push(js, "}" + nl())
  sb_push(js, "function renderActiveTable() {" + nl())
  sb_push(js, "  const el = document.getElementById('sql-table');" + nl())
  sb_push(js, "  if (!activeTable || !tablesMap[activeTable]) { el.innerHTML = ''; return; }" + nl())
  sb_push(js, "  const t = tablesMap[activeTable];" + nl())
  sb_push(js, "  let html = \"<table style='border-collapse:collapse;width:100%'><tr>\";" + nl())
  sb_push(js, "  for (const c of t.cols) { html += '<th style=\"border:1px solid #666;padding:4px;text-align:left\">' + escHtml(c) + '</th>'; }" + nl())
  sb_push(js, "  html += '</tr>';" + nl())
  sb_push(js, "  for (const row of t.rows) {" + nl())
  sb_push(js, "    html += '<tr>';" + nl())
  sb_push(js, "    for (const v of row) { html += '<td style=\"border:1px solid #666;padding:4px\">' + escHtml(v) + '</td>'; }" + nl())
  sb_push(js, "    html += '</tr>';" + nl())
  sb_push(js, "  }" + nl())
  sb_push(js, "  html += '</table>';" + nl())
  sb_push(js, "  if (t.rows.length === 0) { html += '<p><em>(no rows)</em></p>'; }" + nl())
  sb_push(js, "  el.innerHTML = html;" + nl())
  sb_push(js, "}" + nl())
  sb_push(js, "function selectTab(name) { activeTable = name; renderTabs(); renderActiveTable(); }" + nl())
  sb_push(js, "function renderResult(result) {" + nl())
  sb_push(js, "  const el = document.getElementById('sql-result');" + nl())
  sb_push(js, "  if (result.kind === 'ok') { el.textContent = 'OK: ' + result.message; }" + nl())
  sb_push(js, "  else if (result.kind === 'error') { el.textContent = 'ERROR: ' + result.message; }" + nl())
  sb_push(js, "  else {" + nl())
  sb_push(js, "    let text = result.rows.length + ' row(s): ' + result.cols.join(', ') + String.fromCharCode(10);" + nl())
  sb_push(js, "    for (const row of result.rows) { text += '  ' + row.join(', ') + String.fromCharCode(10); }" + nl())
  sb_push(js, "    el.textContent = text;" + nl())
  sb_push(js, "  }" + nl())
  sb_push(js, "}" + nl())
  sb_push(js, "async function sqlSubmit() {" + nl())
  sb_push(js, "  const inp = document.getElementById('sql-input');" + nl())
  sb_push(js, "  const stmt = inp.value.trim();" + nl())
  sb_push(js, "  if (!stmt) return;" + nl())
  sb_push(js, "  const out = await runWasm('sql-status', 'sqlconsole', [currentDbText, stmt, '0']);" + nl())
  sb_push(js, "  const parsed = parseOutput(out);" + nl())
  sb_push(js, "  currentDbText = parsed.stateText;" + nl())
  sb_push(js, "  tablesMap = parsed.tables;" + nl())
  sb_push(js, "  renderResult(parsed.result);" + nl())
  sb_push(js, "  renderTabs();" + nl())
  sb_push(js, "  renderActiveTable();" + nl())
  sb_push(js, "  inp.value = '';" + nl())
  sb_push(js, "  inp.focus();" + nl())
  sb_push(js, "}" + nl())
  sb_push(js, "function sqlKeydown(e) { if (e.key === 'Enter') { sqlSubmit(); } }" + nl())
  sb_push(js, "async function sqlInit() {" + nl())
  sb_push(js, "  const out = await runWasm('sql-status', 'sqlconsole', ['INIT', '', '0']);" + nl())
  sb_push(js, "  const parsed = parseOutput(out);" + nl())
  sb_push(js, "  currentDbText = parsed.stateText;" + nl())
  sb_push(js, "  tablesMap = parsed.tables;" + nl())
  sb_push(js, "  renderResult(parsed.result);" + nl())
  sb_push(js, "  renderTabs();" + nl())
  sb_push(js, "  renderActiveTable();" + nl())
  sb_push(js, "}" + nl())
  sb_push(js, "sqlInit();" + nl())
  let sections = list_push(sections, tpl_script(sb_str(js)))
  let page = tpl_page("PatLang SQL Console", "fragment", sections)
  write_file("portfolio/demos/sqlconsole.html", render_page(page))
  print("wrote portfolio/demos/sqlconsole.html")
  return true
end

# coverage_page: paste (or use the preloaded sample) a self-contained
# PatLang program, click Run, get a SimpleCov-style per-function summary
# table plus tabs -- one per function -- listing that function's own
# branches with their condition text and covered/missed status. Two wasm
# calls per run: the small "coverage" module does ONLY the static
# instrument step (self_hosting/examples/coverage_wasm_main.patlang,
# printing the branch catalog then the instrumented source); the
# instrumented source is then run through the SAME shared "playground"
# module the REPL uses, to actually collect which branches were hit --
# no separate execution path needed, reusing the compiler pipeline
# that's already exposed at runtime.
make a function called coverage_page takes pg_b64, coverage_b64 returns done
  let sample = "make a function called classify takes n returns r" + chr(10) + "if n > 100 then" + chr(10) + "  return \"big\"" + chr(10) + "else" + chr(10) + "  if n > 10 then" + chr(10) + "    return \"medium\"" + chr(10) + "  else" + chr(10) + "    return \"small\"" + chr(10) + "  end" + chr(10) + "end" + chr(10) + "end" + chr(10) + "print(classify(5))" + chr(10) + "print(classify(50))"
  let sections = [tpl_para("Paste a self-contained PatLang program (no <code>include</code> lines -- this instruments the text directly) and click Run. The summary table and per-function tabs below show which branches your program's own code actually took while it ran, and which it never did -- the same static-catalog-plus-dynamic-instrumentation technique as the CLI tool (<code>pat --ir-run self_hosting/tools/coverage_main.patlang &lt;test file&gt;</code>), which can report on a whole real test suite including files the browser can't read. See the <a href='patlang-paradigms.html'>Paradigms Guide</a> and <code>self_hosting/lib/coverage.patlang</code> for how instrumentation works and why it's built this way (there's no execution-tracing hook anywhere in PatLang's runtime, so this regenerates the source with a small tracking call wrapped around every branch condition, rather than changing the interpreter).")]
  let sections = list_push(sections, tpl_raw("<textarea id='cov-input' rows='14' style='width:100%;font-family:monospace'>" + html_escape(sample) + "</textarea>"))
  let sections = list_push(sections, tpl_raw("<p><button onclick='runCoverage()'>Run Coverage</button> <span id='cov-status'></span></p>"))
  let sections = list_push(sections, tpl_raw("<div id='cov-summary'></div>"))
  let sections = list_push(sections, tpl_raw("<div id='cov-tabs' style='margin-top:10px'></div>"))
  let sections = list_push(sections, tpl_raw("<div id='cov-detail'></div>"))
  let js = sb_new()
  sb_push(js, "const WASMS = { playground: '" + pg_b64 + "', coverage: '" + coverage_b64 + "' };" + nl())
  runwasm_only_js(js)
  sb_push(js, "function covEsc(s) { return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;'); }" + nl())
  sb_push(js, "function covPercent(covered, total) { return total ? Math.floor(covered * 100 / total) : 100; }" + nl())
  sb_push(js, "async function runCoverage() {" + nl())
  sb_push(js, "  const src = document.getElementById('cov-input').value;" + nl())
  sb_push(js, "  document.getElementById('cov-status').textContent = 'instrumenting...';" + nl())
  sb_push(js, "  const out1 = await runWasm('cov-instrument', 'coverage', [src]);" + nl())
  sb_push(js, "  const parts = out1.split('===INSTRUMENTED===');" + nl())
  sb_push(js, "  const catalogText = parts[0];" + nl())
  sb_push(js, "  const instrumented = parts.length > 1 ? parts[1] : '';" + nl())
  sb_push(js, "  const catalog = [];" + nl())
  sb_push(js, "  let pending = null;" + nl())
  sb_push(js, "  for (const raw of catalogText.split(String.fromCharCode(10))) {" + nl())
  sb_push(js, "    const line = raw.trim();" + nl())
  sb_push(js, "    if (!line) continue;" + nl())
  sb_push(js, "    if (line.indexOf('BRANCH:') === 0) {" + nl())
  sb_push(js, "      const f = line.slice(7).split(',');" + nl())
  sb_push(js, "      pending = { id: +f[0], kind: f[1], line: +f[2], func: f[3] || '(top level)' };" + nl())
  sb_push(js, "    } else if (line.indexOf('COND:') === 0 && pending) {" + nl())
  sb_push(js, "      pending.cond = line.slice(5);" + nl())
  sb_push(js, "      catalog.push(pending);" + nl())
  sb_push(js, "      pending = null;" + nl())
  sb_push(js, "    }" + nl())
  sb_push(js, "  }" + nl())
  sb_push(js, "  document.getElementById('cov-status').textContent = 'running instrumented copy...';" + nl())
  sb_push(js, "  const out2 = await runWasm('cov-run', 'playground', [instrumented]);" + nl())
  sb_push(js, "  const hits = new Set();" + nl())
  sb_push(js, "  for (const raw of out2.split(String.fromCharCode(10))) {" + nl())
  sb_push(js, "    const line = raw.trim();" + nl())
  sb_push(js, "    if (line.indexOf('COV:') === 0) {" + nl())
  sb_push(js, "      const rest = line.slice(4);" + nl())
  sb_push(js, "      const ci = rest.indexOf(':');" + nl())
  sb_push(js, "      if (ci >= 0 && rest.slice(ci + 1) === 'true') { hits.add(+rest.slice(0, ci)); }" + nl())
  sb_push(js, "    }" + nl())
  sb_push(js, "  }" + nl())
  sb_push(js, "  document.getElementById('cov-status').textContent = catalog.length + ' branch(es) tracked.';" + nl())
  sb_push(js, "  renderCovReport(catalog, hits);" + nl())
  sb_push(js, "}" + nl())
  sb_push(js, "function renderCovReport(catalog, hits) {" + nl())
  sb_push(js, "  const groups = {};" + nl())
  sb_push(js, "  const order = [];" + nl())
  sb_push(js, "  for (const b of catalog) {" + nl())
  sb_push(js, "    const fn = b.func;" + nl())
  sb_push(js, "    if (!groups[fn]) { groups[fn] = { total: 0, covered: 0, branches: [] }; order.push(fn); }" + nl())
  sb_push(js, "    const g = groups[fn];" + nl())
  sb_push(js, "    g.total++;" + nl())
  sb_push(js, "    const hit = hits.has(b.id);" + nl())
  sb_push(js, "    if (hit) { g.covered++; }" + nl())
  sb_push(js, "    g.branches.push({ line: b.line, cond: b.cond, kind: b.kind, hit: hit });" + nl())
  sb_push(js, "  }" + nl())
  sb_push(js, "  let totalAll = 0, coveredAll = 0;" + nl())
  sb_push(js, "  let html = \"<table style='border-collapse:collapse;width:100%'><tr><th style='text-align:left'>Function</th><th style='text-align:left'>Branches</th><th style='text-align:left'>Coverage</th></tr>\";" + nl())
  sb_push(js, "  for (const fn of order) {" + nl())
  sb_push(js, "    const g = groups[fn];" + nl())
  sb_push(js, "    totalAll += g.total; coveredAll += g.covered;" + nl())
  sb_push(js, "    html += '<tr><td>' + covEsc(fn) + '</td><td>' + g.covered + '/' + g.total + '</td><td>' + covPercent(g.covered, g.total) + '%</td></tr>';" + nl())
  sb_push(js, "  }" + nl())
  sb_push(js, "  html += '<tr style=\"font-weight:bold\"><td>TOTAL</td><td>' + coveredAll + '/' + totalAll + '</td><td>' + covPercent(coveredAll, totalAll) + '%</td></tr></table>';" + nl())
  sb_push(js, "  document.getElementById('cov-summary').innerHTML = html;" + nl())
  sb_push(js, "  let tabsHtml = '';" + nl())
  sb_push(js, "  for (let idx = 0; idx < order.length; idx++) {" + nl())
  sb_push(js, "    tabsHtml += '<button onclick=\"selectCovTab(' + idx + ')\">' + covEsc(order[idx]) + '</button> ';" + nl())
  sb_push(js, "  }" + nl())
  sb_push(js, "  document.getElementById('cov-tabs').innerHTML = tabsHtml;" + nl())
  sb_push(js, "  window.__covGroups = groups;" + nl())
  sb_push(js, "  window.__covOrder = order;" + nl())
  sb_push(js, "  if (order.length) { selectCovTab(0); }" + nl())
  sb_push(js, "  else { document.getElementById('cov-detail').innerHTML = '<p><em>No branches found -- this program has no if/while statements.</em></p>'; }" + nl())
  sb_push(js, "}" + nl())
  sb_push(js, "function selectCovTab(idx) {" + nl())
  sb_push(js, "  const fn = window.__covOrder[idx];" + nl())
  sb_push(js, "  const g = window.__covGroups[fn];" + nl())
  sb_push(js, "  let html = '<h3>' + covEsc(fn) + '</h3><table style=\"border-collapse:collapse;width:100%\">';" + nl())
  sb_push(js, "  for (const b of g.branches) {" + nl())
  sb_push(js, "    const bg = b.hit ? '#1a3a1a' : '#3a1a1a';" + nl())
  sb_push(js, "    const label = b.hit ? 'covered' : 'MISSED';" + nl())
  sb_push(js, "    html += '<tr style=\"background:' + bg + '\"><td>line ' + b.line + '</td><td>' + covEsc(b.cond) + '</td><td>' + label + '</td></tr>';" + nl())
  sb_push(js, "  }" + nl())
  sb_push(js, "  html += '</table>';" + nl())
  sb_push(js, "  document.getElementById('cov-detail').innerHTML = html;" + nl())
  sb_push(js, "}" + nl())
  let sections = list_push(sections, tpl_script(sb_str(js)))
  let page = tpl_page("PatLang Branch Coverage", "fragment", sections)
  write_file("portfolio/demos/coverage.html", render_page(page))
  print("wrote portfolio/demos/coverage.html")
  return true
end

# A module's text (self_hosting/v2/wasm/*.mjs) as plain statements: its
# import lines dropped and `export ` taken off what it exports, so several
# modules can share one script or one Worker.
make a function called js_module_body takes text returns out
  let lines = split_lines(text)
  let out = sb_new()
  let i = 0
  while i < list_len(lines) do
    if str_starts_with(lines[i], "export ") then
      sb_push(out, substr(lines[i], 7, lines[i].length - 7))
      sb_push(out, nl())
    elif not str_starts_with(lines[i], "import ") then
      sb_push(out, lines[i])
      sb_push(out, nl())
    end
    let i = i + 1
  end
  return sb_str(out)
end

# The runner every page that runs a WebAssembly demo carries: v2's browser
# host (layout, launcher, and the executor as a Worker's source), then
# self_hosting/tools/portfolio_runner.js, which defines runWasm,
# runWasmThreaded and runWasmText over them.
make a function called runwasm_core_js takes b returns done
  let layout = js_module_body(read_file("self_hosting/v2/wasm/layout.mjs"))
  let executor = layout + js_module_body(read_file("self_hosting/v2/wasm/executor.mjs"))
  sb_push(b, "const V2_EXECUTOR_SRC = " + json_quote(executor) + ";" + nl())
  sb_push(b, "function V2_LAUNCHER() {" + nl())
  sb_push(b, layout)
  sb_push(b, js_module_body(read_file("self_hosting/v2/wasm/launcher.mjs")))
  sb_push(b, "return run;" + nl() + "}" + nl())
  sb_push(b, read_file("self_hosting/tools/portfolio_runner.js"))
  return true
end

make a function called runwasm_only_js takes b returns done
  runwasm_core_js(b)
return true
end

make a function called wasi_shim_js takes b returns done
  runwasm_core_js(b)
  sb_push(b, "const KW = new Set(['let','if','then','else','end','while','do','return','make','a','function','called','takes','returns','when','emit','and','or','not','true','false','print']);" + nl())
  sb_push(b, "function hlHtml(src) {" + nl())
  sb_push(b, "  let out = ''; let i = 0;" + nl())
  sb_push(b, "  const esc = function(t) { return t.replace(/&/g, '&amp;').replace(/</g, '&lt;'); };" + nl())
  sb_push(b, "  while (i < src.length) {" + nl())
  sb_push(b, "    const c = src[i];" + nl())
  sb_push(b, "    if (c === '#') { let j = i; while (j < src.length && src.charCodeAt(j) !== 10) j++; out += '<i class=hc>' + esc(src.slice(i, j)) + '</i>'; i = j; continue; }" + nl())
  sb_push(b, "    if (c === String.fromCharCode(34)) { let j = i + 1; while (j < src.length && src[j] !== c) { if (src[j] === String.fromCharCode(92)) j++; j++; } j++; out += '<i class=hs>' + esc(src.slice(i, j)) + '</i>'; i = j; continue; }" + nl())
  sb_push(b, "    if (c >= '0' && c <= '9') { let j = i; while (j < src.length && ((src[j] >= '0' && src[j] <= '9') || src[j] === '.')) j++; out += '<i class=hn>' + src.slice(i, j) + '</i>'; i = j; continue; }" + nl())
  sb_push(b, "    if (/[A-Za-z_]/.test(c)) { let j = i; while (j < src.length && /[A-Za-z0-9_]/.test(src[j])) j++; const w = src.slice(i, j); out += KW.has(w) ? '<i class=hk>' + w + '</i>' : esc(w); i = j; continue; }" + nl())
  sb_push(b, "    out += esc(c); i++;" + nl())
  sb_push(b, "  }" + nl())
  sb_push(b, "  return out + String.fromCharCode(10);" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "function hlUpdate() { const ed = document.getElementById('ed'), hl = document.getElementById('hl'); if (!ed || !hl) return; hl.innerHTML = hlHtml(ed.value); hlSync(); }" + nl())
  sb_push(b, "function hlSync() { const e = document.getElementById('ed'), h = document.getElementById('hl'); if (!e || !h) return; h.scrollTop = e.scrollTop; h.scrollLeft = e.scrollLeft; }" + nl())
  sb_push(b, "function srcText(id) { return document.getElementById('src-' + id).textContent; }" + nl())
  sb_push(b, "function runCard(id) { return runWasm(id, 'playground', [srcText(id)]); }" + nl())
  sb_push(b, "function runPlayground() { return runWasm('playground', 'playground', [document.getElementById('ed').value]); }" + nl())
  sb_push(b, "function loadExample() { const id = document.getElementById('exsel').value; document.getElementById('ed').value = srcText(id); hlUpdate(); }" + nl())
  sb_push(b, "window.addEventListener('DOMContentLoaded', hlUpdate);" + nl())
  return true
end

print("building demos...")
let feature_src = read_file("self_hosting/examples/feature_demo.patlang")
let bench_src = read_file("self_hosting/examples/fib_bench.patlang")
let gui_src = read_file("self_hosting/lib/html.patlang") + chr(10) + read_file("self_hosting/examples/gui_demo.patlang")

compile_native(feature_src, "feature")
let feature_native = exec_capture("portfolio/build/feature.exe")
print("feature demo done")

compile_native(bench_src, "bench")
let bench_native = exec_capture("portfolio/build/bench.exe")
print("bench done")

compile_native(gui_src, "gui")
let gui_native = exec_capture("portfolio/build/gui.exe")
print("gui done")

# gui's in-browser variant: the computation itself never touches the
# filesystem (only the final write_file did) -- see gui_wasm_main.patlang's
# header comment -- so a wasm build that prints the generated page instead
# of writing it works in the sandbox; the JS side renders it live via an
# <iframe srcdoc>.
let gui_wasm_src = read_file("self_hosting/lib/html.patlang") + chr(10) + read_file("self_hosting/examples/gui_wasm_main.patlang")
let gui_wasm_b64 = compile_wasm_only(gui_wasm_src, "guidemo")
print("gui wasm done")

let pos_src = read_file("self_hosting/lib/pos.patlang") + chr(10) + read_file("self_hosting/examples/pos_demo.patlang")
compile_native(pos_src, "pos")
let pos_native = exec_capture("portfolio/build/pos.exe")
print("pos done")

let post_src = test_framework_src() + chr(10) + strip_include_lines(read_file("self_hosting/lib/pos.patlang")) + chr(10) + read_file("self_hosting/examples/pos_tests.patlang")
compile_native(post_src, "postests")
let post_native = exec_capture("portfolio/build/postests.exe")
print("pos tests done")

let contracts_src = read_file("self_hosting/examples/contracts_demo.patlang")
compile_native(contracts_src, "contracts")
let contracts_native = exec_capture("portfolio/build/contracts.exe")
print("contracts done")

# ---- goal-oriented paradigm: real backward-chaining (rule_add/solve) +
# GOAP planning (action_add/plan) + contracts-as-facts, replacing the old
# flat fact/goal/query trio.
let goal_oriented_src = read_file("self_hosting/examples/goal_oriented_build_demo.patlang")
compile_native(goal_oriented_src, "goaloriented")
let goal_oriented_native = exec_capture("portfolio/build/goaloriented.exe")
print("goal-oriented demo done")

# ---- bitwise operators (band/bor/bxor/bnot/shl/shr) + bitfield helpers
# (bit_get/bit_set/bit_slice/bit_set_slice).
let bitwise_src = read_file("self_hosting/examples/bitwise_bitfield_demo.patlang")
compile_native(bitwise_src, "bitwise")
let bitwise_native = exec_capture("portfolio/build/bitwise.exe")
print("bitwise demo done")

# ---- real declarative `rule Head(args) :- Body1, Body2.` syntax, sugar
# over the same rule_add/solve backend as the goal-oriented demo above.
let rulesyntax_src = read_file("self_hosting/examples/rule_syntax_demo.patlang")
compile_native(rulesyntax_src, "rulesyntax")
let rulesyntax_native = exec_capture("portfolio/build/rulesyntax.exe")
print("rule syntax demo done")

# ---- virtual filesystem: vfs_read/write/exists/list/delete work on every
# target including WASM (see this page's live "run in browser" button);
# vfs_flush_to_disk (native-only, not exercised in this demo's main flow)
# is the explicit, security-gated write-through to the real filesystem.
let vfsdemo_src = read_file("self_hosting/examples/vfs_demo.patlang")
compile_native(vfsdemo_src, "vfsdemo")
let vfsdemo_native = exec_capture("portfolio/build/vfsdemo.exe")
print("vfs demo done")

# ---- match/case pattern matching (issue #44): pure syntactic sugar over
# ordinary if/jump instructions (self_hosting/lib/lower.patlang's
# lower_match), so it runs unmodified on every backend -- interpreter,
# native, and this very "compile and run in browser" WASM playground.
let matchdemo_body = strip_include_line(read_file("self_hosting/examples/match_demo.patlang"), "../lib/regex.patlang")
let matchdemo_src = read_file("self_hosting/lib/regex.patlang") + chr(10) + matchdemo_body
compile_native(matchdemo_src, "matchdemo")
let matchdemo_native = exec_capture("portfolio/build/matchdemo.exe")
print("vfs demo done")

# ---- runtime signals: a process can receive a named signal from OUTSIDE
# itself (another CLI invocation, or a local network call) via signal_claim/
# signal_poll/signal_send/signal_query, dispatched through the existing
# when/emit mechanism. Native-only transcript, not a live "run in browser"
# demo -- see the blurb below for why. This transcript variant simulates
# the primary/secondary roles as two real OS threads instead of two
# separate processes (exec_capture blocks until its child exits, so it
# can't capture a long-running primary + separate signal-sending
# invocations); self_hosting/examples/signals_demo.patlang is the real,
# intended multi-process form a user would actually run.
#
# Manually concatenated (not `include`d) for the SAME reason every other
# multi-file demo in this script is: patc1_compile writes the combined
# source to a scratch path (portfolio/build/<id>.patlang), so a relative
# `include "../lib/signals.patlang"` line -- correct when the file lives at
# its real self_hosting/examples/ location -- would resolve to the WRONG
# path once copied there. The demo file's own `include` line (needed for
# real standalone use, e.g. `pat --patc self_hosting/examples/
# signals_demo_transcript.patlang` directly) is stripped here before
# concatenating, so signals.patlang's content isn't duplicated either.
let signals_demo_raw = read_file("self_hosting/examples/signals_demo_transcript.patlang")
let signals_include_line = "include " + q() + "../lib/signals.patlang" + q()
let signals_include_at = find_substr(signals_demo_raw, signals_include_line)
let signals_demo_body = signals_demo_raw
if signals_include_at >= 0 then
  let signals_demo_body = substr(signals_demo_raw, 0, signals_include_at) + substr(signals_demo_raw, signals_include_at + signals_include_line.length, signals_demo_raw.length - signals_include_at - signals_include_line.length)
end
let signals_src = read_file("self_hosting/lib/signals.patlang") + chr(10) + signals_demo_body
compile_native(signals_src, "signalsdemo")
let signals_native = exec_capture("portfolio/build/signalsdemo.exe")
print("signals demo done")

# ---- build daemon: the exemplar system tying together logic (rule_add/
# solve, "which targets are stale"), goal-seeking (action_add/plan, GOAP,
# cost-weighted by real historical timing), self-timing + persistence
# (now_ms(), a history file surviving between runs), events (when/emit
# driving the dashboard), and runtime signals (status/rebuild/quit) --
