# Dynamic syntax demo: unlike router_dsl_demo (a passive `syntax {...}`
# literal that the SURROUNDING playground engine's own expand_syntax_dsls/
# tokenize/parse_program/lower_program calls handle), this demo's own code
# calls expand_syntax_dsls_with/tokenize/parse_program/lower_program itself
# -- so when it's submitted as "user code" to the live playground, it needs
# its OWN copies of those functions in scope, because run_ir's nested
# interpreter (rust-runtime/src/ir/hosts.rs's host_run_ir) starts a fresh,
# isolated Program containing only the functions decoded from whatever was
# just lowered -- it does not inherit the outer compiled binary's own
# lexer/parser/lower/regex_dsl/syntax_dsl functions. Concatenating them
# ahead of the demo (same as the wasm build below) is what makes both the
# native transcript AND the "Compile and run in this browser" button work.
let dynsyntax_src1 = read_file("self_hosting/lib/lexer.patlang")
let dynsyntax_src2 = dynsyntax_src1 + read_file("self_hosting/lib/parser.patlang")
let dynsyntax_src3 = dynsyntax_src2 + read_file("self_hosting/lib/lower.patlang")
let dynsyntax_src4 = dynsyntax_src3 + read_file("self_hosting/lib/regex_dsl.patlang")
let dynsyntax_src5 = dynsyntax_src4 + read_file("self_hosting/lib/syntax_dsl.patlang")
let dynsyntax_src = dynsyntax_src5 + read_file("self_hosting/examples/dynamic_syntax_demo.patlang")
compile_native(dynsyntax_src, "dynsyntaxdemo")
let dynsyntax_native = exec_capture("portfolio/build/dynsyntaxdemo.exe")
print("dynamic syntax demo done")

