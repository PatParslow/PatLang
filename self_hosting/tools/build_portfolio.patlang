# Maze solver page: an interactive page around a small wasm module (lexer +
# parser + lower + lib/maze + a driver taking generate/solve subcommands),
# so mazes of any size/seed are generated and solved live in the browser -
# no rustc beyond this one-time wasm build, matching the IDE/playground.
let maze_src = read_file("self_hosting/lib/maze.patlang")
let maze_wasm_src = read_file("self_hosting/lib/lexer.patlang") + chr(10) + read_file("self_hosting/lib/parser.patlang") + chr(10) + read_file("self_hosting/lib/lower.patlang") + chr(10) + maze_src + chr(10) + read_file("self_hosting/examples/maze_wasm_main.patlang")
let maze_b64 = compile_wasm_only(maze_wasm_src, "maze")
print("maze wasm done")

let maze_body = sb_new()
sb_push(maze_body, "<h1>PatLang maze solver</h1>" + nl())
sb_push(maze_body, "<p>A grid compiled into logic-programming <code>fact</code>s, solved by a recursive depth-first search driven by <code>query</code>, announced with <code>goal</code>, and reported through a <code>solved</code>/<code>unsolved</code> event - generation and solving both run live in this page (compiled to WASM once, no rustc per maze). Pick a size and seed, generate a maze, then watch it solve one visited cell at a time.</p>" + nl())
sb_push(maze_body, maze_css())
sb_push(maze_body, "<style>" + nl())
sb_push(maze_body, ".mz-visited{background:#f6b93b}" + nl())
sb_push(maze_body, "#mz-canvas{display:grid;gap:2px}" + nl())
sb_push(maze_body, "</style>" + nl())
sb_push(maze_body, "<p>" + nl())
sb_push(maze_body, "<label>Width <input id='mz-w' type='number' value='16' min='2' max='60' style='width:4em'></label> " + nl())
sb_push(maze_body, "<label>Height <input id='mz-h' type='number' value='12' min='2' max='60' style='width:4em'></label> " + nl())
sb_push(maze_body, "<label>Seed <input id='mz-seed' type='number' value='1' min='0' max='32767' style='width:5em'></label> " + nl())
sb_push(maze_body, "<button onclick='mzGenerate()'>Generate maze</button> " + nl())
sb_push(maze_body, "<label>Speed <input id='mz-speed' type='range' min='1' max='60' value='25'></label>" + nl())
sb_push(maze_body, "</p>" + nl())
sb_push(maze_body, "<p><button onclick='mzSolve()'>Watch it solve</button> <button onclick='mzSolveInstant()'>Solve instantly</button> <span id='mz-status' class='ms'></span></p>" + nl())
sb_push(maze_body, "<div id='mz-canvas'></div>" + nl())
sb_push(maze_body, "<pre class='out' id='out-maze' hidden></pre>" + nl())
sb_push(maze_body, "<h2>Source</h2>" + nl())
sb_push(maze_body, "<details><summary>lib/maze.patlang</summary><pre class='src'>" + html_escape(maze_src) + "</pre></details>" + nl())

let maze_js = sb_new()
sb_push(maze_js, "const WASMS = {" + nl())
sb_push(maze_js, "  maze: '" + maze_b64 + "'" + nl())
sb_push(maze_js, "};" + nl())
wasi_shim_js(maze_js)
sb_push(maze_js, "let mzCols = 0, mzRows = 0, mzGrid = [], mzCells = [];" + nl())
sb_push(maze_js, "function mzClassFor(c) { if (c === '#') return 'mz-wall'; if (c === 'S') return 'mz-start'; if (c === 'E') return 'mz-end'; return 'mz-open'; }" + nl())
sb_push(maze_js, "function mzRender(grid) {" + nl())
sb_push(maze_js, "  mzGrid = grid; mzRows = grid.length; mzCols = grid[0].length; mzCells = [];" + nl())
sb_push(maze_js, "  const c = document.getElementById('mz-canvas');" + nl())
sb_push(maze_js, "  c.style.gridTemplateColumns = 'repeat(' + mzCols + ', 1.4em)';" + nl())
sb_push(maze_js, "  c.innerHTML = '';" + nl())
sb_push(maze_js, "  for (let y = 0; y < mzRows; y++) for (let x = 0; x < mzCols; x++) {" + nl())
sb_push(maze_js, "    const d = document.createElement('div');" + nl())
sb_push(maze_js, "    d.style.width = d.style.height = '1.4em';" + nl())
sb_push(maze_js, "    d.className = mzClassFor(grid[y][x]);" + nl())
sb_push(maze_js, "    c.appendChild(d); mzCells.push(d);" + nl())
sb_push(maze_js, "  }" + nl())
sb_push(maze_js, "}" + nl())
sb_push(maze_js, "async function mzGenerate() {" + nl())
sb_push(maze_js, "  const w = document.getElementById('mz-w').value, h = document.getElementById('mz-h').value, seed = document.getElementById('mz-seed').value;" + nl())
sb_push(maze_js, "  const text = await runWasm('maze', 'maze', ['generate', w, h, seed]);" + nl())
sb_push(maze_js, "  mzRender(text.split(String.fromCharCode(10)).filter(function(r) { return r.length > 0; }));" + nl())
sb_push(maze_js, "  document.getElementById('mz-status').textContent = 'generated ' + w + 'x' + h + ' maze, seed ' + seed;" + nl())
sb_push(maze_js, "}" + nl())
sb_push(maze_js, "function mzCellIndex(key) { const p = key.split(','); return (Number(p[1]) * mzCols) + Number(p[0]); }" + nl())
sb_push(maze_js, "async function mzRunSolve() {" + nl())
sb_push(maze_js, "  for (const el of mzCells) { el.classList.remove('mz-visited', 'mz-path'); }" + nl())
sb_push(maze_js, "  const text = await runWasm('maze', 'maze', ['solve', mzGrid.join(String.fromCharCode(10))]);" + nl())
sb_push(maze_js, "  const lines = text.split(String.fromCharCode(10));" + nl())
sb_push(maze_js, "  const trace = lines[0] ? lines[0].split(';') : [];" + nl())
sb_push(maze_js, "  const path = lines[1] ? lines[1].split(';') : [];" + nl())
sb_push(maze_js, "  const msg = lines[2] || '';" + nl())
sb_push(maze_js, "  return { trace, path, msg };" + nl())
sb_push(maze_js, "}" + nl())
sb_push(maze_js, "function mzPaintPath(path) {" + nl())
sb_push(maze_js, "  for (const key of path) {" + nl())
sb_push(maze_js, "    const el = mzCells[mzCellIndex(key)];" + nl())
sb_push(maze_js, "    if (el && !el.classList.contains('mz-start') && !el.classList.contains('mz-end')) el.classList.add('mz-path');" + nl())
sb_push(maze_js, "  }" + nl())
sb_push(maze_js, "}" + nl())
sb_push(maze_js, "async function mzSolve() {" + nl())
sb_push(maze_js, "  document.getElementById('mz-status').textContent = 'solving...';" + nl())
sb_push(maze_js, "  const { trace, path, msg } = await mzRunSolve();" + nl())
sb_push(maze_js, "  const speed = 61 - Number(document.getElementById('mz-speed').value);" + nl())
sb_push(maze_js, "  let i = 0;" + nl())
sb_push(maze_js, "  const timer = setInterval(() => {" + nl())
sb_push(maze_js, "    if (i >= trace.length) {" + nl())
sb_push(maze_js, "      clearInterval(timer); mzPaintPath(path); document.getElementById('mz-status').textContent = msg;" + nl())
sb_push(maze_js, "      return;" + nl())
sb_push(maze_js, "    }" + nl())
sb_push(maze_js, "    const el = mzCells[mzCellIndex(trace[i])];" + nl())
sb_push(maze_js, "    if (el && !el.classList.contains('mz-start') && !el.classList.contains('mz-end')) el.classList.add('mz-visited');" + nl())
sb_push(maze_js, "    i++;" + nl())
sb_push(maze_js, "  }, speed);" + nl())
sb_push(maze_js, "}" + nl())
sb_push(maze_js, "async function mzSolveInstant() {" + nl())
sb_push(maze_js, "  document.getElementById('mz-status').textContent = 'solving...';" + nl())
sb_push(maze_js, "  const { trace, path, msg } = await mzRunSolve();" + nl())
sb_push(maze_js, "  for (const key of trace) { const el = mzCells[mzCellIndex(key)]; if (el && !el.classList.contains('mz-start') && !el.classList.contains('mz-end')) el.classList.add('mz-visited'); }" + nl())
sb_push(maze_js, "  mzPaintPath(path);" + nl())
sb_push(maze_js, "  document.getElementById('mz-status').textContent = msg;" + nl())
sb_push(maze_js, "}" + nl())
sb_push(maze_js, "window.addEventListener('DOMContentLoaded', mzGenerate);" + nl())

write_file("portfolio/maze.html", html_page("PatLang maze solver", sb_str(maze_body), sb_str(maze_js)))
print("maze done")

# IDE page: a bigger standalone editor around the same playground.wasm engine
# (no new wasm build - the mode argument added to playground_main.patlang
# already handles run/tokens/ast). Reuses wasi_shim_js's runWasm/hlHtml/
# loadExample helpers unchanged; only ide.html-specific bits are added below.
let ide_body = sb_new()
sb_push(ide_body, "<h1>PatLang IDE</h1>" + nl())
sb_push(ide_body, "<p>The self-hosted compiler (lexer, parser, lowerer), compiled to WebAssembly once and reused for every run in this page. <b>Run</b> executes your program; <b>Tokens</b> and <b>AST</b> show the compiler's own intermediate representations for the same source, with no rustc involved for any of the three. Ctrl+Enter runs. Your code is kept in this browser's local storage.</p>" + nl())
sb_push(ide_body, "<style>" + nl())
sb_push(ide_body, ".edwrap { position: relative; height: 28rem; border: 1px solid color-mix(in srgb, currentColor 25%, transparent); border-radius: 6px; overflow: hidden; }" + nl())
sb_push(ide_body, ".edwrap pre.hl, .edwrap textarea { position: absolute; inset: 0; margin: 0; padding: 0.6rem; font: 0.9rem/1.5 monospace; white-space: pre; overflow: auto; border: 0; background: transparent; }" + nl())
sb_push(ide_body, ".edwrap textarea { color: transparent; caret-color: light-dark(black, white); resize: none; width: 100%; height: 100%; outline: none; }" + nl())
sb_push(ide_body, ".hl i { font-style: normal; } .hk { color: #c678dd; font-weight: 600; } .hs { color: #98c379; } .hn { color: #d19a66; } .hc { color: #7f848e; }" + nl())
sb_push(ide_body, ".out { min-height: 10rem; max-height: 22rem; }" + nl())
sb_push(ide_body, "</style>" + nl())
let ide_examples = [["default", "starter program", "self_hosting/examples/playground_default.patlang"], ["feature", "all paradigms", "self_hosting/examples/feature_demo.patlang"], ["bench", "self-timing benchmark", "self_hosting/examples/fib_bench.patlang"], ["contracts", "design by contract", "self_hosting/examples/contracts_demo.patlang"]]
let k = 0
while k < ide_examples.length do
  let ex = ide_examples[k]
  sb_push(ide_body, "<pre id='src-" + ex[0] + "' hidden>" + html_escape(read_file(ex[2])) + "</pre>" + nl())
  let k = k + 1
end
sb_push(ide_body, "<p><label>Load example: <select id='exsel' onchange='loadExample()'>" + nl())
let k = 0
while k < ide_examples.length do
  let ex = ide_examples[k]
  sb_push(ide_body, "<option value='" + ex[0] + "'>" + ex[1] + "</option>" + nl())
  let k = k + 1
end
sb_push(ide_body, "</select></label> <button onclick='ideReset()'>Reset to selected example</button></p>" + nl())
sb_push(ide_body, "<div class='edwrap'><pre id='hl' class='hl' aria-hidden='true'></pre><textarea id='ed' spellcheck='false' oninput='hlUpdate(); ideSave();' onscroll='hlSync()' onkeydown='ideKey(event)'>" + nl())
sb_push(ide_body, html_escape(read_file("self_hosting/examples/playground_default.patlang")))
sb_push(ide_body, "</textarea></div>" + nl())
sb_push(ide_body, "<p><button onclick=" + q() + "runWasm('ide','playground',[document.getElementById('ed').value,'run'])" + q() + ">Run</button> <button onclick=" + q() + "runWasm('ide','playground',[document.getElementById('ed').value,'tokens'])" + q() + ">Tokens</button> <button onclick=" + q() + "runWasm('ide','playground',[document.getElementById('ed').value,'ast'])" + q() + ">AST</button> <span class='ms' id='ms-ide'></span></p>" + nl())
sb_push(ide_body, "<pre class='out' id='out-ide'>(not run yet)</pre>" + nl())

let ide_js = sb_new()
sb_push(ide_js, "const WASMS = {" + nl())
sb_push(ide_js, "  playground: '" + pg_b64 + "'" + nl())
sb_push(ide_js, "};" + nl())
wasi_shim_js(ide_js)
sb_push(ide_js, "function ideSave() { try { localStorage.setItem('patlang_ide_src', document.getElementById('ed').value); } catch (e) {} }" + nl())
sb_push(ide_js, "function ideReset() { loadExample(); ideSave(); }" + nl())
sb_push(ide_js, "function ideKey(e) { if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') { e.preventDefault(); runWasm('ide', 'playground', [document.getElementById('ed').value, 'run']); } }" + nl())
sb_push(ide_js, "window.addEventListener('DOMContentLoaded', function() { try { const saved = localStorage.getItem('patlang_ide_src'); if (saved) { document.getElementById('ed').value = saved; hlUpdate(); } } catch (e) {} });" + nl())

write_file("portfolio/ide.html", html_page("PatLang IDE", sb_str(ide_body), sb_str(ide_js)))
print("ide done")

# Project report timeline page: an animated Gantt-style chart of the same
# task graph as the report demo card, showing delegation to worker roles
# and the QA review stage per task, replayed from a single precomputed
# event log (see lib/report.patlang's virtual clock).
let rp_body = sb_new()
sb_push(rp_body, "<h1>PatLang project report simulator</h1>" + nl())
sb_push(rp_body, "<p>Writing the abstract requires every other section to exist first, and several sections have real sub-tasks of their own (running experiments, gathering data, and analysing it are separate delegated tasks). Each task is assigned to a worker role, then gated by a QA review before it counts as done. Real projects aren't linear, though: a review can fail and blame an earlier stage instead of approving it, reopening it and everything downstream that depended on it - a dependency DAG resolved goal by goal, with feedback loops, replayed here from a single precomputed event log (a virtual clock, not real time - the whole simulation computes instantly). A <span style='color:#c0392b'>red</span> review segment means that attempt was sent back for rework; a task with more than one attempt shown is labelled <code>(x2)</code> etc.</p>" + nl())
sb_push(rp_body, "<style>" + nl())
sb_push(rp_body, "#rp-chart{position:relative}" + nl())
sb_push(rp_body, ".rp-row{display:flex;align-items:center;height:28px;margin-bottom:2px}" + nl())
sb_push(rp_body, ".rp-label{width:130px;font-size:0.8em;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex-shrink:0}" + nl())
sb_push(rp_body, ".rp-track{position:relative;width:520px;height:18px;background:color-mix(in srgb, currentColor 8%, transparent);border-radius:3px;flex-shrink:0}" + nl())
sb_push(rp_body, ".rp-bar{position:absolute;top:0;height:100%;border-radius:3px;opacity:0.25;transition:opacity 0.15s}" + nl())
sb_push(rp_body, ".rp-bar.rp-active{opacity:1}" + nl())
sb_push(rp_body, ".rp-status{margin-left:0.6em;font-size:0.8em;opacity:0.75;width:15em}" + nl())
sb_push(rp_body, "#rp-playhead{position:absolute;top:0;width:2px;background:crimson;pointer-events:none}" + nl())
sb_push(rp_body, "#rp-legend span{display:inline-block;width:0.8em;height:0.8em;border-radius:2px;margin-right:0.3em;vertical-align:middle}" + nl())
sb_push(rp_body, "</style>" + nl())
sb_push(rp_body, "<p id='rp-legend'></p>" + nl())
sb_push(rp_body, "<p><button onclick='rpGenerate()'>Build schedule</button> <button onclick='rpPlay()'>Play</button> <label>Duration (s) <input id='rp-speed' type='range' min='2' max='20' value='6'></label> <span id='rp-status' class='ms'></span></p>" + nl())
sb_push(rp_body, "<div id='rp-chart'></div>" + nl())
sb_push(rp_body, "<pre class='out' id='out-report_timeline' hidden></pre>" + nl())
sb_push(rp_body, "<pre class='out' id='rp-log' style='max-height:12rem'></pre>" + nl())
sb_push(rp_body, "<h2>Source</h2>" + nl())
sb_push(rp_body, "<details><summary>lib/report.patlang</summary><pre class='src'>" + html_escape(report_lib_src) + "</pre></details>" + nl())

let rp_js = sb_new()
sb_push(rp_js, "const WASMS = {" + nl())
sb_push(rp_js, "  report_timeline: '" + report_b64 + "'" + nl())
sb_push(rp_js, "};" + nl())
wasi_shim_js(rp_js)
sb_push(rp_js, "const RP_COLORS = { researcher:'#4a69bd', writer:'#6ab04c', architect:'#f6b93b', developer:'#e55039', analyst:'#8e44ad', qa:'#95a5a6' };" + nl())
sb_push(rp_js, "let rpTotal = 0, rpOrder = [], rpMap = {}, rpRows = {}, rpTimer = null, rpEvents = [];" + nl())
sb_push(rp_js, "function rpLegend() {" + nl())
sb_push(rp_js, "  const el = document.getElementById('rp-legend');" + nl())
sb_push(rp_js, "  el.innerHTML = Object.keys(RP_COLORS).map(function(k) { return '<span style=" + q() + "background:' + RP_COLORS[k] + '" + q() + "></span>' + k; }).join('  ');" + nl())
sb_push(rp_js, "}" + nl())
sb_push(rp_js, "function rpParse(text) {" + nl())
sb_push(rp_js, "  const lines = text.split(String.fromCharCode(10)).filter(function(l) { return l.length > 0; });" + nl())
sb_push(rp_js, "  const total = Number(lines[0]);" + nl())
sb_push(rp_js, "  const events = (lines[1] || '').split(';').filter(Boolean).map(function(e) {" + nl())
sb_push(rp_js, "    const p = e.split(','); return { t: Number(p[0]), phase: p[1], task: p[2], worker: p[3] };" + nl())
sb_push(rp_js, "  });" + nl())
sb_push(rp_js, "  const order = [], map = {};" + nl())
sb_push(rp_js, "  for (const e of events) {" + nl())
sb_push(rp_js, "    if (!map[e.task]) { map[e.task] = { attempts: [] }; order.push(e.task); }" + nl())
sb_push(rp_js, "    const info = map[e.task];" + nl())
sb_push(rp_js, "    if (e.phase === 'start') { info.attempts.push({ start: e.t, worker: e.worker }); }" + nl())
sb_push(rp_js, "    const cur = info.attempts[info.attempts.length - 1];" + nl())
sb_push(rp_js, "    if (e.phase === 'work_done') cur.work_done = e.t;" + nl())
sb_push(rp_js, "    if (e.phase === 'review_start') cur.review_start = e.t;" + nl())
sb_push(rp_js, "    if (e.phase === 'review_done') { cur.review_done = e.t; cur.outcome = 'approved'; }" + nl())
sb_push(rp_js, "    if (e.phase.indexOf('rework:') === 0) { cur.review_done = e.t; cur.outcome = 'rework'; cur.blame = e.phase.slice(7); }" + nl())
sb_push(rp_js, "  }" + nl())
sb_push(rp_js, "  return { total, events, order, map };" + nl())
sb_push(rp_js, "}" + nl())
sb_push(rp_js, "function rpRender() {" + nl())
sb_push(rp_js, "  const trackW = 520;" + nl())
sb_push(rp_js, "  const chart = document.getElementById('rp-chart');" + nl())
sb_push(rp_js, "  chart.innerHTML = ''; rpRows = {};" + nl())
sb_push(rp_js, "  for (const name of rpOrder) {" + nl())
sb_push(rp_js, "    const info = rpMap[name];" + nl())
sb_push(rp_js, "    const row = document.createElement('div'); row.className = 'rp-row';" + nl())
sb_push(rp_js, "    const label = document.createElement('span'); label.className = 'rp-label';" + nl())
sb_push(rp_js, "    label.textContent = name + (info.attempts.length > 1 ? ' (x' + info.attempts.length + ')' : '');" + nl())
sb_push(rp_js, "    const track = document.createElement('div'); track.className = 'rp-track';" + nl())
sb_push(rp_js, "    const bars = [];" + nl())
sb_push(rp_js, "    for (const attempt of info.attempts) {" + nl())
sb_push(rp_js, "      const workBar = document.createElement('div'); workBar.className = 'rp-bar';" + nl())
sb_push(rp_js, "      workBar.style.left = (attempt.start / rpTotal * trackW) + 'px';" + nl())
sb_push(rp_js, "      workBar.style.width = Math.max(2, (attempt.work_done - attempt.start) / rpTotal * trackW) + 'px';" + nl())
sb_push(rp_js, "      workBar.style.background = RP_COLORS[attempt.worker] || '#888';" + nl())
sb_push(rp_js, "      const reviewBar = document.createElement('div'); reviewBar.className = 'rp-bar';" + nl())
sb_push(rp_js, "      reviewBar.style.left = (attempt.review_start / rpTotal * trackW) + 'px';" + nl())
sb_push(rp_js, "      reviewBar.style.width = Math.max(2, (attempt.review_done - attempt.review_start) / rpTotal * trackW) + 'px';" + nl())
sb_push(rp_js, "      reviewBar.style.background = attempt.outcome === 'rework' ? '#c0392b' : RP_COLORS.qa;" + nl())
sb_push(rp_js, "      track.appendChild(workBar); track.appendChild(reviewBar);" + nl())
sb_push(rp_js, "      bars.push({ workBar, reviewBar });" + nl())
sb_push(rp_js, "    }" + nl())
sb_push(rp_js, "    const status = document.createElement('span'); status.className = 'rp-status'; status.textContent = 'pending';" + nl())
sb_push(rp_js, "    row.appendChild(label); row.appendChild(track); row.appendChild(status);" + nl())
sb_push(rp_js, "    chart.appendChild(row);" + nl())
sb_push(rp_js, "    rpRows[name] = { bars, status, attemptIdx: -1 };" + nl())
sb_push(rp_js, "  }" + nl())
sb_push(rp_js, "  const playhead = document.createElement('div'); playhead.id = 'rp-playhead';" + nl())
sb_push(rp_js, "  playhead.style.left = '130px'; playhead.style.height = (rpOrder.length * 30) + 'px';" + nl())
sb_push(rp_js, "  chart.appendChild(playhead);" + nl())
sb_push(rp_js, "}" + nl())
sb_push(rp_js, "async function rpGenerate() {" + nl())
sb_push(rp_js, "  if (rpTimer) { clearInterval(rpTimer); rpTimer = null; }" + nl())
sb_push(rp_js, "  document.getElementById('rp-log').textContent = '';" + nl())
sb_push(rp_js, "  document.getElementById('rp-status').textContent = 'building...';" + nl())
sb_push(rp_js, "  const text = await runWasm('report_timeline', 'report_timeline', []);" + nl())
sb_push(rp_js, "  const parsed = rpParse(text);" + nl())
sb_push(rp_js, "  rpTotal = parsed.total; rpOrder = parsed.order; rpMap = parsed.map; rpEvents = parsed.events;" + nl())
sb_push(rp_js, "  rpRender();" + nl())
sb_push(rp_js, "  document.getElementById('rp-status').textContent = rpOrder.length + ' tasks, ' + rpTotal + 'ms simulated total. Press Play to watch it run.';" + nl())
sb_push(rp_js, "}" + nl())
sb_push(rp_js, "const RP_PHASE_LABEL = { start: 'in progress', work_done: 'awaiting review', review_start: 'in review (qa)', review_done: 'approved' };" + nl())
sb_push(rp_js, "function rpPhaseLabel(phase) { return phase.indexOf('rework:') === 0 ? 'REWORK - sent back to ' + phase.slice(7) : RP_PHASE_LABEL[phase]; }" + nl())
sb_push(rp_js, "function rpPlay() {" + nl())
sb_push(rp_js, "  if (!rpTotal) return;" + nl())
sb_push(rp_js, "  if (rpTimer) { clearInterval(rpTimer); rpTimer = null; }" + nl())
sb_push(rp_js, "  for (const name of rpOrder) {" + nl())
sb_push(rp_js, "    const row = rpRows[name];" + nl())
sb_push(rp_js, "    for (const b of row.bars) { b.workBar.classList.remove('rp-active'); b.reviewBar.classList.remove('rp-active'); }" + nl())
sb_push(rp_js, "    row.status.textContent = 'pending'; row.attemptIdx = -1;" + nl())
sb_push(rp_js, "  }" + nl())
sb_push(rp_js, "  document.getElementById('rp-log').textContent = '';" + nl())
sb_push(rp_js, "  const trackW = 520;" + nl())
sb_push(rp_js, "  const seconds = Number(document.getElementById('rp-speed').value);" + nl())
sb_push(rp_js, "  const scale = rpTotal / (seconds * 1000);" + nl())
sb_push(rp_js, "  const t0 = performance.now();" + nl())
sb_push(rp_js, "  let i = 0;" + nl())
sb_push(rp_js, "  rpTimer = setInterval(function() {" + nl())
sb_push(rp_js, "    const now = (performance.now() - t0) * scale;" + nl())
sb_push(rp_js, "    document.getElementById('rp-playhead').style.left = (130 + Math.min(now, rpTotal) / rpTotal * trackW) + 'px';" + nl())
sb_push(rp_js, "    while (i < rpEvents.length && rpEvents[i].t <= now) {" + nl())
sb_push(rp_js, "      const e = rpEvents[i];" + nl())
sb_push(rp_js, "      const row = rpRows[e.task];" + nl())
sb_push(rp_js, "      if (row) {" + nl())
sb_push(rp_js, "        if (e.phase === 'start') row.attemptIdx++;" + nl())
sb_push(rp_js, "        const bar = row.bars[row.attemptIdx];" + nl())
sb_push(rp_js, "        if (bar) {" + nl())
sb_push(rp_js, "          if (e.phase === 'start') bar.workBar.classList.add('rp-active');" + nl())
sb_push(rp_js, "          if (e.phase === 'review_start') bar.reviewBar.classList.add('rp-active');" + nl())
sb_push(rp_js, "        }" + nl())
sb_push(rp_js, "        row.status.textContent = rpPhaseLabel(e.phase) + ' (' + e.worker + ')';" + nl())
sb_push(rp_js, "      }" + nl())
sb_push(rp_js, "      const logEl = document.getElementById('rp-log');" + nl())
sb_push(rp_js, "      logEl.textContent += '[' + e.t + 'ms] ' + e.task + ': ' + rpPhaseLabel(e.phase) + ' (' + e.worker + ')' + String.fromCharCode(10);" + nl())
sb_push(rp_js, "      logEl.scrollTop = logEl.scrollHeight;" + nl())
sb_push(rp_js, "      i++;" + nl())
sb_push(rp_js, "    }" + nl())
sb_push(rp_js, "    if (i >= rpEvents.length) { clearInterval(rpTimer); rpTimer = null; document.getElementById('rp-status').textContent = 'done: ' + rpOrder.length + ' tasks, ' + rpTotal + 'ms simulated total.'; }" + nl())
sb_push(rp_js, "  }, 30);" + nl())
sb_push(rp_js, "}" + nl())
sb_push(rp_js, "window.addEventListener('DOMContentLoaded', function() { rpLegend(); rpGenerate(); });" + nl())

write_file("portfolio/report.html", html_page("PatLang project report simulator", sb_str(rp_body), sb_str(rp_js)))
print("report timeline done")

# Compiler self-metrics: the PatLang front+middle end processing its own source
let compiler_src = read_file("self_hosting/lib/lexer.patlang")
let compiler_src = compiler_src + chr(10) + read_file("self_hosting/lib/parser.patlang")
let compiler_src = compiler_src + chr(10) + read_file("self_hosting/lib/lower.patlang")
let compiler_src = compiler_src + chr(10) + read_file("self_hosting/lib/codegen.patlang")
let compiler_src = compiler_src + chr(10) + read_file("self_hosting/lib/runtime_rs.patlang")
let compiler_src = compiler_src + chr(10) + read_file("self_hosting/patc1_main.patlang")
let m0 = now_ms()
let ctoks = tokenize(compiler_src)
let m1 = now_ms()
let cast = parse_program(ctoks)
let m2 = now_ms()
let cir = lower_program(cast)
let m3 = now_ms()
let crs = emit_program_rs(cir)
let m4 = now_ms()
print("compiler metrics done")

# ---- assemble the page ----
let body = sb_new()
sb_push(body, "<h1>PatLang portfolio</h1>" + nl())
sb_push(body, "<p>Each example below is written in PatLang, compiled by the <em>self-hosted</em> PatLang compiler (lexer, parser, lowerer, and code generator all written in PatLang), and embedded here as WebAssembly. Press Run to execute it in your browser; programs time themselves with <code>now_ms()</code>, so you can compare the in-browser numbers with the native transcript captured on the build machine.</p>" + nl())

demo_card(body, "feature", "All paradigms in one program", "Recursion, control flow, lists, <strong>events</strong> (when/emit), <strong>logic</strong> (fact/query), <strong>OO</strong> (new/send/get), and <strong>functional</strong> map/filter via <code>apply</code>.", feature_src, feature_native)
demo_card(body, "bench", "Self-timing benchmark", "fib(27), a 2-million iteration loop, and a 200k-element vector build, each reporting its own elapsed milliseconds.", bench_src, bench_native)
sb_push(body, "<div class='card'>" + nl())
sb_push(body, "<h2>Live playground: the compiler, in your browser</h2>" + nl())
sb_push(body, "<p>The self-hosted PatLang compiler (lexer, parser, lowerer) compiled to WebAssembly. Edit the program, press Run: your source is tokenized, parsed, and lowered by PatLang code running in this page, then executed on the runtime VM. No server, no rustc.</p>" + nl())
sb_push(body, "<style>" + nl())
sb_push(body, ".edwrap { position: relative; height: 16rem; border: 1px solid color-mix(in srgb, currentColor 25%, transparent); border-radius: 6px; overflow: hidden; }" + nl())
sb_push(body, ".edwrap pre.hl, .edwrap textarea { position: absolute; inset: 0; margin: 0; padding: 0.6rem; font: 0.85rem/1.45 monospace; white-space: pre; overflow: auto; border: 0; background: transparent; }" + nl())
sb_push(body, ".edwrap textarea { color: transparent; caret-color: light-dark(black, white); resize: none; width: 100%; height: 100%; outline: none; }" + nl())
sb_push(body, ".hl i { font-style: normal; } .hk { color: #c678dd; font-weight: 600; } .hs { color: #98c379; } .hn { color: #d19a66; } .hc { color: #7f848e; }" + nl())
sb_push(body, "</style>" + nl())
sb_push(body, "<pre id='src-default' hidden>" + html_escape(read_file("self_hosting/examples/playground_default.patlang")) + "</pre>" + nl())
