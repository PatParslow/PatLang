write_file("portfolio/demos/gui.html", render_page(tpl_page("Browser GUI generator", "fragment", gui_sections)))
print("wrote portfolio/demos/gui.html")

# Compiler self-metrics: bespoke content (a stats list, not a source/
# transcript pair), built directly rather than via demo_page/native_page.
let metrics_body = sb_new()
sb_push(metrics_body, "<ul>" + nl())
sb_push(metrics_body, "<li>tokenize: " + vec_len(ctoks) + " tokens in " + (m1 - m0) + " ms</li>" + nl())
sb_push(metrics_body, "<li>parse: " + cast[1].length + " top-level statements in " + (m2 - m1) + " ms</li>" + nl())
sb_push(metrics_body, "<li>lower: " + cir[2].length + " functions in " + (m3 - m2) + " ms</li>" + nl())
sb_push(metrics_body, "<li>codegen: " + crs.length + " chars of Rust in " + (m4 - m3) + " ms</li>" + nl())
sb_push(metrics_body, "</ul>" + nl())
let metrics_sections = [tpl_para("The self-hosted compiler front+middle end processing its own complete source (" + compiler_src.length + " chars), run under the Stage 0 interpreter while building this page:")]
let metrics_sections = list_push(metrics_sections, tpl_raw(sb_str(metrics_body)))
let metrics_sections = list_push(metrics_sections, tpl_para("The natively compiled compiler (patc1) runs the same front end roughly two orders of magnitude faster; rustc then dominates end-to-end compile time."))
write_file("portfolio/demos/compiler-metrics.html", render_page(tpl_page("The compiler, measured on itself", "fragment", metrics_sections)))
print("wrote portfolio/demos/compiler-metrics.html")

# ---- Ruby transpilation: a new demo. Ruby can't run client-side via the
# existing wasm/WASI mechanism, so this shows source next to the
# transpiled Ruby text (both build-time PatLang calls into
# lib/reflect.patlang/lib/transpile_ruby.patlang, included above) plus a
# captured transcript of actually running the transpiled program via a
# real `ruby` subprocess -- proving byte-identical output against the
# interpreted version, exactly what reflect_transpile_selftest.patlang
# already verifies in the test suite.
# feature_demo.patlang uses facts/logic (fact/query) and events, both out
# of the v1 ruby target's scope (see transpile_ruby.patlang's
# ruby_unsupported_host) -- deliberately not used here. This example
# instead covers what v1 DOES support: recursion, loops, exact-rational
# division, complex sqrt, and OO object-slots, matching the program already
# verified byte-identical end-to-end in reflect_transpile_selftest.patlang.
let ruby_demo_src = "make a function called fib takes n returns r
  if n < 2 then
    return n
  else
    return fib(n - 1) + fib(n - 2)
  end
end
let i = 0
while i < 8 do
  print(fib(i))
  let i = i + 1
end
print(10 / 3)
print(sqrt(-4))
new(" + q() + "Counter" + q() + ", " + q() + "c1" + q() + ")
send(" + q() + "c1" + q() + ", " + q() + "set" + q() + ", " + q() + "v" + q() + ", 5)
print(get(" + q() + "c1" + q() + ", " + q() + "v" + q() + "))"
let ruby_toks = tokenize(ruby_demo_src)
let ruby_ast = parse_program(ruby_toks)
let ruby_result = transpile_program(ruby_ast)
let ruby_out_text = ruby_result[1]
if ruby_result[0] == "Err" then
  let ruby_out_text = "(transpile failed: " + ruby_result[1] + ")"
end
let ruby_sections = [tpl_para("A self-hosted Ruby transpiler (<code>lib/transpile_ruby.patlang</code>) walking the PRE-LOWERING AST directly (real <code>if</code>/<code>while</code>/<code>def</code> already present, unlike the flattened jump-based IR the ordinary compiler produces) to emit idiomatic Ruby &mdash; not an embedded PatLang VM ported to Ruby. Unsupported constructs (networking, the facts/logic engine, contracts, meta-compilation) fail the transpile with a named error rather than emitting silently-broken output. Reflection (<code>lib/reflect.patlang</code>, source &#8594; AST &#8594; JSON) is built the same way, reusing the existing self-hosted lexer/parser.")]
let ruby_sections = list_push(ruby_sections, tpl_raw("<p class='label'>PatLang source:</p><pre class='src'>" + html_escape(ruby_demo_src) + "</pre>"))
let ruby_sections = list_push(ruby_sections, tpl_raw("<p class='label'>Transpiled Ruby:</p><pre class='src'>" + html_escape(ruby_out_text) + "</pre>"))
# Written next to lib/patlang_runtime.rb, not portfolio/build/ -- Ruby's
# require_relative resolves relative to the requiring file's own directory.
write_file("self_hosting/lib/_portfolio_ruby_transpile_demo.rb", ruby_out_text)
let ruby_transcript = exec_capture("ruby", "self_hosting/lib/_portfolio_ruby_transpile_demo.rb")
let ruby_sections = list_push(ruby_sections, tpl_raw("<p class='label'>Native run on the build machine (via a real `ruby` subprocess, output byte-identical to the interpreter's own):</p>"))
let ruby_sections = list_push(ruby_sections, tpl_raw("<pre class='out native'>" + html_escape(ruby_transcript) + "</pre>"))
write_file("portfolio/demos/ruby-transpile.html", render_page(tpl_page("Transpilation: PatLang to idiomatic Ruby", "fragment", ruby_sections)))
print("wrote portfolio/demos/ruby-transpile.html")

# ---- index page: a plain navigation index (standalone mode -- this one
# page is NOT meant to be embedded in the site shell, it's a local landing
# page linking out to every split demo page plus the 4 still-standalone
# mini-apps (maze/ide/report/flowgraph), matching their existing role). ----
let demo_links = [
  ["feature", "All paradigms in one program"],
  ["bench", "Self-timing benchmark"],
  ["playground", "Live playground: the compiler, in your browser"],
  ["pos", "Point of sale (events + OO + logic)"],
  ["postests", "BDD framework: unit, integration, Gherkin"],
  ["contracts", "Design by contract"],
  ["goaloriented", "Goal-oriented: backward chaining + GOAP"],
  ["bitwise", "Bitwise operators & bitfields"],
  ["rulesyntax", "Declarative rule syntax"],
  ["vfsdemo", "Virtual filesystem"],
  ["signalsdemo", "Runtime signals: quit and status"],
  ["builddaemon", "Exemplar: logic + GOAP + signals + events + self-timing"],
  ["towerdemo", "Numeric Tower: BigInt, Rational, Complex"],
  ["routerdsl", "User-defined DSL: routes { ... }"],
  ["dynsyntax", "Dynamic syntax: grammar extensions as runtime data"],
  ["report-writer", "Project report writer (goal-oriented)"],
  ["patbuild", "patbuild: a goal-oriented build system"],
  ["flowgraph-demo", "flowgraph: control-flow graphs from the compiler IR"],
  ["gui", "Browser GUI generator"],
  ["compiler-metrics", "The compiler, measured on itself"],
  ["ruby-transpile", "Transpilation: PatLang to idiomatic Ruby"],
  ["threading", "Real OS threads: parallel map-reduce"],
  ["fiber", "Fibers: cooperative coroutines"]
]
let idx_list = sb_new()
sb_push(idx_list, "<ul>" + nl())
let ix = 0
while ix < demo_links.length do
  let d = demo_links[ix]
  sb_push(idx_list, "<li><a href='demos/" + d[0] + ".html'>" + html_escape(d[1]) + "</a></li>" + nl())
  let ix = ix + 1
end
sb_push(idx_list, "<li><a href='demos/maze.html'>Maze solver: logic + goal-oriented + events</a></li>" + nl())
sb_push(idx_list, "<li><a href='demos/ide.html'>IDE</a></li>" + nl())
sb_push(idx_list, "</ul>" + nl())
let idx_sections = [tpl_para("Each example below is written in PatLang, compiled by the <em>self-hosted</em> PatLang compiler (lexer, parser, lowerer, and code generator all written in PatLang). Most run live in your browser via WebAssembly; a few are native-only (file I/O, subprocess calls) and show a transcript captured on the build machine instead.")]
let idx_sections = list_push(idx_sections, tpl_raw(sb_str(idx_list)))
write_file("portfolio/index.html", render_page(tpl_page("PatLang portfolio", "standalone", idx_sections)))
print("wrote portfolio/index.html")
