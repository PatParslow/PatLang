sb_push(body, "<option value='contracts'>design by contract</option>" + nl())
sb_push(body, "</select></label></p>" + nl())
sb_push(body, "<div class='edwrap'><pre id='hl' class='hl' aria-hidden='true'></pre><textarea id='ed' spellcheck='false' oninput='hlUpdate()' onscroll='hlSync()'>" + nl())
sb_push(body, html_escape(read_file("self_hosting/examples/playground_default.patlang")))
sb_push(body, "</textarea></div>" + nl())
sb_push(body, "<p><button onclick='runPlayground()'>Compile and run in this browser</button> <span class='ms' id='ms-playground'></span></p>" + nl())
