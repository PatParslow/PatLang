let gui_sections = [tpl_para("PatLang computing data (a fibonacci table) and generating a well-formed, interactive HTML+JS page around it &mdash; the browser as PatLang's cross-platform GUI. Running live below: the <code>iframe</code> is the actual page this PatLang program just generated, in this browser, right now.")]
