# Project report timeline page: an animated Gantt-style chart of the same
# task graph as the report-writer demo, showing delegation to worker roles
# and the QA review stage per task, replayed from a single precomputed
# event log (see lib/report.patlang's virtual clock). Was previously split
# into two pages (a native-only "report writer" teaser card linking to a
# SEPARATE standalone report.html for the actual animation) -- now one
# fragment-mode page with the full interactive timeline, matching every
# other split-out demo. report.html is retired.
let rp_body = sb_new()
sb_push(rp_body, "<p>Writing the abstract requires every other section to exist first, and several sections have real sub-tasks of their own (running experiments, gathering data, and analysing it are separate delegated tasks). Each task is assigned to a worker role, then gated by a QA review before it counts as done. Real projects aren't linear, though: a review can fail and blame an earlier stage instead of approving it, reopening it and everything downstream that depended on it - a dependency DAG resolved goal by goal, with feedback loops, replayed here from a single precomputed event log (a virtual clock, not real time - the whole simulation computes instantly). A <span style='color:#c0392b'>red</span> review segment means that attempt was sent back for rework; a task with more than one attempt shown is labelled <code>(x2)</code> etc.</p>" + nl())
sb_push(rp_body, "<style>" + nl())
sb_push(rp_body, "#rp-chart{position:relative}" + nl())
sb_push(rp_body, ".rp-row{display:flex;align-items:center;height:28px;margin-bottom:2px}" + nl())
sb_push(rp_body, ".rp-label{width:130px;font-size:0.8em;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex-shrink:0}" + nl())
sb_push(rp_body, ".rp-track{position:relative;width:520px;height:18px;background:color-mix(in srgb, currentColor 8%, transparent);border-radius:3px;flex-shrink:0}" + nl())
sb_push(rp_body, ".rp-bar{position:absolute;top:0;height:100%;border-radius:3px;opacity:0.25;transition:opacity 0.15s}" + nl())
sb_push(rp_body, ".rp-bar.rp-active{opacity:1}" + nl())
sb_push(rp_body, ".rp-status{margin-left:0.6em;font-size:0.8em;opacity:0.75;width:15em}" + nl())
sb_push(rp_body, "#rp-playhead{position:absolute;top:0;width:2px;background:crimson;pointer-events:none}" + nl())
sb_push(rp_body, "#rp-legend span{display:inline-block;width:0.8em;height:0.8em;border-radius:2px;margin-right:0.3em;vertical-align:middle}" + nl())
sb_push(rp_body, "</style>" + nl())
sb_push(rp_body, "<p id='rp-legend'></p>" + nl())
sb_push(rp_body, "<p><button onclick='rpGenerate()'>Build schedule</button> <button onclick='rpPlay()'>Play</button> <label>Duration (s) <input id='rp-speed' type='range' min='2' max='20' value='6'></label> <span id='rp-status' class='ms'></span></p>" + nl())
sb_push(rp_body, "<div id='rp-chart'></div>" + nl())
sb_push(rp_body, "<pre class='out' id='out-report_timeline' hidden></pre>" + nl())
sb_push(rp_body, "<pre class='out' id='rp-log' style='max-height:12rem'></pre>" + nl())
sb_push(rp_body, "<h2>Source</h2>" + nl())
sb_push(rp_body, "<details><summary>lib/report.patlang</summary><pre class='src'>" + html_escape(report_lib_src) + "</pre></details>" + nl())

let rp_js = sb_new()
sb_push(rp_js, "const WASMS = {" + nl())
sb_push(rp_js, "  report_timeline: '" + report_b64 + "'" + nl())
sb_push(rp_js, "};" + nl())
wasi_shim_js(rp_js)
sb_push(rp_js, "const RP_COLORS = { researcher:'#4a69bd', writer:'#6ab04c', architect:'#f6b93b', developer:'#e55039', analyst:'#8e44ad', qa:'#95a5a6' };" + nl())
sb_push(rp_js, "let rpTotal = 0, rpOrder = [], rpMap = {}, rpRows = {}, rpTimer = null, rpEvents = [];" + nl())
sb_push(rp_js, "function rpLegend() {" + nl())
sb_push(rp_js, "  const el = document.getElementById('rp-legend');" + nl())
sb_push(rp_js, "  el.innerHTML = Object.keys(RP_COLORS).map(function(k) { return '<span style=" + q() + "background:' + RP_COLORS[k] + '" + q() + "></span>' + k; }).join('  ');" + nl())
sb_push(rp_js, "}" + nl())
sb_push(rp_js, "function rpParse(text) {" + nl())
sb_push(rp_js, "  const lines = text.split(String.fromCharCode(10)).filter(function(l) { return l.length > 0; });" + nl())
sb_push(rp_js, "  const total = Number(lines[0]);" + nl())
sb_push(rp_js, "  const events = (lines[1] || '').split(';').filter(Boolean).map(function(e) {" + nl())
sb_push(rp_js, "    const p = e.split(','); return { t: Number(p[0]), phase: p[1], task: p[2], worker: p[3] };" + nl())
sb_push(rp_js, "  });" + nl())
sb_push(rp_js, "  const order = [], map = {};" + nl())
sb_push(rp_js, "  for (const e of events) {" + nl())
sb_push(rp_js, "    if (!map[e.task]) { map[e.task] = { attempts: [] }; order.push(e.task); }" + nl())
sb_push(rp_js, "    const info = map[e.task];" + nl())
sb_push(rp_js, "    if (e.phase === 'start') { info.attempts.push({ start: e.t, worker: e.worker }); }" + nl())
sb_push(rp_js, "    const cur = info.attempts[info.attempts.length - 1];" + nl())
sb_push(rp_js, "    if (e.phase === 'work_done') cur.work_done = e.t;" + nl())
sb_push(rp_js, "    if (e.phase === 'review_start') cur.review_start = e.t;" + nl())
sb_push(rp_js, "    if (e.phase === 'review_done') { cur.review_done = e.t; cur.outcome = 'approved'; }" + nl())
sb_push(rp_js, "    if (e.phase.indexOf('rework:') === 0) { cur.review_done = e.t; cur.outcome = 'rework'; cur.blame = e.phase.slice(7); }" + nl())
sb_push(rp_js, "  }" + nl())
sb_push(rp_js, "  return { total, events, order, map };" + nl())
sb_push(rp_js, "}" + nl())
sb_push(rp_js, "function rpRender() {" + nl())
sb_push(rp_js, "  const trackW = 520;" + nl())
sb_push(rp_js, "  const chart = document.getElementById('rp-chart');" + nl())
sb_push(rp_js, "  chart.innerHTML = ''; rpRows = {};" + nl())
sb_push(rp_js, "  for (const name of rpOrder) {" + nl())
sb_push(rp_js, "    const info = rpMap[name];" + nl())
sb_push(rp_js, "    const row = document.createElement('div'); row.className = 'rp-row';" + nl())
sb_push(rp_js, "    const label = document.createElement('span'); label.className = 'rp-label';" + nl())
sb_push(rp_js, "    label.textContent = name + (info.attempts.length > 1 ? ' (x' + info.attempts.length + ')' : '');" + nl())
sb_push(rp_js, "    const track = document.createElement('div'); track.className = 'rp-track';" + nl())
sb_push(rp_js, "    const bars = [];" + nl())
sb_push(rp_js, "    for (const attempt of info.attempts) {" + nl())
sb_push(rp_js, "      const workBar = document.createElement('div'); workBar.className = 'rp-bar';" + nl())
sb_push(rp_js, "      workBar.style.left = (attempt.start / rpTotal * trackW) + 'px';" + nl())
sb_push(rp_js, "      workBar.style.width = Math.max(2, (attempt.work_done - attempt.start) / rpTotal * trackW) + 'px';" + nl())
sb_push(rp_js, "      workBar.style.background = RP_COLORS[attempt.worker] || '#888';" + nl())
sb_push(rp_js, "      const reviewBar = document.createElement('div'); reviewBar.className = 'rp-bar';" + nl())
sb_push(rp_js, "      reviewBar.style.left = (attempt.review_start / rpTotal * trackW) + 'px';" + nl())
sb_push(rp_js, "      reviewBar.style.width = Math.max(2, (attempt.review_done - attempt.review_start) / rpTotal * trackW) + 'px';" + nl())
sb_push(rp_js, "      reviewBar.style.background = attempt.outcome === 'rework' ? '#c0392b' : RP_COLORS.qa;" + nl())
sb_push(rp_js, "      track.appendChild(workBar); track.appendChild(reviewBar);" + nl())
sb_push(rp_js, "      bars.push({ workBar, reviewBar });" + nl())
sb_push(rp_js, "    }" + nl())
sb_push(rp_js, "    const status = document.createElement('span'); status.className = 'rp-status'; status.textContent = 'pending';" + nl())
sb_push(rp_js, "    row.appendChild(label); row.appendChild(track); row.appendChild(status);" + nl())
sb_push(rp_js, "    chart.appendChild(row);" + nl())
sb_push(rp_js, "    rpRows[name] = { bars, status, attemptIdx: -1 };" + nl())
sb_push(rp_js, "  }" + nl())
sb_push(rp_js, "  const playhead = document.createElement('div'); playhead.id = 'rp-playhead';" + nl())
sb_push(rp_js, "  playhead.style.left = '130px'; playhead.style.height = (rpOrder.length * 30) + 'px';" + nl())
sb_push(rp_js, "  chart.appendChild(playhead);" + nl())
sb_push(rp_js, "}" + nl())
sb_push(rp_js, "async function rpGenerate() {" + nl())
sb_push(rp_js, "  if (rpTimer) { clearInterval(rpTimer); rpTimer = null; }" + nl())
sb_push(rp_js, "  document.getElementById('rp-log').textContent = '';" + nl())
sb_push(rp_js, "  document.getElementById('rp-status').textContent = 'building...';" + nl())
sb_push(rp_js, "  const text = await runWasm('report_timeline', 'report_timeline', []);" + nl())
sb_push(rp_js, "  const parsed = rpParse(text);" + nl())
sb_push(rp_js, "  rpTotal = parsed.total; rpOrder = parsed.order; rpMap = parsed.map; rpEvents = parsed.events;" + nl())
sb_push(rp_js, "  rpRender();" + nl())
sb_push(rp_js, "  document.getElementById('rp-status').textContent = rpOrder.length + ' tasks, ' + rpTotal + 'ms simulated total. Press Play to watch it run.';" + nl())
sb_push(rp_js, "}" + nl())
sb_push(rp_js, "const RP_PHASE_LABEL = { start: 'in progress', work_done: 'awaiting review', review_start: 'in review (qa)', review_done: 'approved' };" + nl())
sb_push(rp_js, "function rpPhaseLabel(phase) { return phase.indexOf('rework:') === 0 ? 'REWORK - sent back to ' + phase.slice(7) : RP_PHASE_LABEL[phase]; }" + nl())
sb_push(rp_js, "function rpPlay() {" + nl())
sb_push(rp_js, "  if (!rpTotal) return;" + nl())
sb_push(rp_js, "  if (rpTimer) { clearInterval(rpTimer); rpTimer = null; }" + nl())
sb_push(rp_js, "  for (const name of rpOrder) {" + nl())
sb_push(rp_js, "    const row = rpRows[name];" + nl())
sb_push(rp_js, "    for (const b of row.bars) { b.workBar.classList.remove('rp-active'); b.reviewBar.classList.remove('rp-active'); }" + nl())
sb_push(rp_js, "    row.status.textContent = 'pending'; row.attemptIdx = -1;" + nl())
sb_push(rp_js, "  }" + nl())
sb_push(rp_js, "  document.getElementById('rp-log').textContent = '';" + nl())
sb_push(rp_js, "  const trackW = 520;" + nl())
sb_push(rp_js, "  const seconds = Number(document.getElementById('rp-speed').value);" + nl())
sb_push(rp_js, "  const scale = rpTotal / (seconds * 1000);" + nl())
sb_push(rp_js, "  const t0 = performance.now();" + nl())
sb_push(rp_js, "  let i = 0;" + nl())
sb_push(rp_js, "  rpTimer = setInterval(function() {" + nl())
sb_push(rp_js, "    const now = (performance.now() - t0) * scale;" + nl())
sb_push(rp_js, "    document.getElementById('rp-playhead').style.left = (130 + Math.min(now, rpTotal) / rpTotal * trackW) + 'px';" + nl())
sb_push(rp_js, "    while (i < rpEvents.length && rpEvents[i].t <= now) {" + nl())
sb_push(rp_js, "      const e = rpEvents[i];" + nl())
sb_push(rp_js, "      const row = rpRows[e.task];" + nl())
sb_push(rp_js, "      if (row) {" + nl())
sb_push(rp_js, "        if (e.phase === 'start') row.attemptIdx++;" + nl())
sb_push(rp_js, "        const bar = row.bars[row.attemptIdx];" + nl())
sb_push(rp_js, "        if (bar) {" + nl())
sb_push(rp_js, "          if (e.phase === 'start') bar.workBar.classList.add('rp-active');" + nl())
sb_push(rp_js, "          if (e.phase === 'review_start') bar.reviewBar.classList.add('rp-active');" + nl())
sb_push(rp_js, "        }" + nl())
sb_push(rp_js, "        row.status.textContent = rpPhaseLabel(e.phase) + ' (' + e.worker + ')';" + nl())
sb_push(rp_js, "      }" + nl())
sb_push(rp_js, "      const logEl = document.getElementById('rp-log');" + nl())
sb_push(rp_js, "      logEl.textContent += '[' + e.t + 'ms] ' + e.task + ': ' + rpPhaseLabel(e.phase) + ' (' + e.worker + ')' + String.fromCharCode(10);" + nl())
sb_push(rp_js, "      logEl.scrollTop = logEl.scrollHeight;" + nl())
sb_push(rp_js, "      i++;" + nl())
sb_push(rp_js, "    }" + nl())
sb_push(rp_js, "    if (i >= rpEvents.length) { clearInterval(rpTimer); rpTimer = null; document.getElementById('rp-status').textContent = 'done: ' + rpOrder.length + ' tasks, ' + rpTotal + 'ms simulated total.'; }" + nl())
sb_push(rp_js, "  }, 30);" + nl())
sb_push(rp_js, "}" + nl())
sb_push(rp_js, "window.addEventListener('DOMContentLoaded', function() { rpLegend(); rpGenerate(); });" + nl())

let rp_sections = [tpl_raw(sb_str(rp_body)), tpl_script(sb_str(rp_js))]
write_file("portfolio/demos/report-writer.html", render_page(tpl_page("Project report writer (goal-oriented)", "fragment", rp_sections)))
print("wrote portfolio/demos/report-writer.html")

# Compiler self-metrics: the PatLang front+middle end processing its own source
let compiler_src = read_file("self_hosting/lib/lexer.patlang")
let compiler_src = compiler_src + chr(10) + read_file("self_hosting/lib/parser.patlang")
let compiler_src = compiler_src + chr(10) + read_file("self_hosting/lib/lower.patlang")
let compiler_src = compiler_src + chr(10) + read_file("self_hosting/lib/codegen.patlang")
let compiler_src = compiler_src + chr(10) + read_file("self_hosting/lib/runtime_rs.patlang")
let compiler_src = compiler_src + chr(10) + read_file("self_hosting/patc1_main.patlang")
let m0 = now_ms()
let ctoks = tokenize(compiler_src)
let m1 = now_ms()
let cast = parse_program(ctoks)
let m2 = now_ms()
let cir = lower_program(cast)
let m3 = now_ms()
let crs = emit_program_rs(cir)
let m4 = now_ms()
print("compiler metrics done")

# ---- one fragment page per example ----

demo_page("feature", "All paradigms in one program", "Recursion, control flow, lists, <strong>events</strong> (when/emit), <strong>logic</strong> (fact/query), <strong>OO</strong> (new/send/get), and <strong>functional</strong> map/filter via <code>apply</code>.", feature_src, feature_native, pg_b64)
demo_page("bench", "Self-timing benchmark", "fib(27), a 2-million iteration loop, and a 200k-element vector build, each reporting its own elapsed milliseconds.", bench_src, bench_native, pg_b64)

# Live playground: bespoke content (an editor, not a source/transcript
# pair), so built directly with template.patlang rather than demo_page.
let pgnd_sections = [tpl_para("The self-hosted PatLang compiler (lexer, parser, lowerer) compiled to WebAssembly. Edit the program, press Run: your source is tokenized, parsed, and lowered by PatLang code running in this page, then executed on the runtime VM. No server, no rustc.")]
let pgnd_sections = list_push(pgnd_sections, tpl_style(".edwrap { position: relative; height: 16rem; border: 1px solid color-mix(in srgb, currentColor 25%, transparent); border-radius: 6px; overflow: hidden; } .edwrap pre.hl, .edwrap textarea { position: absolute; inset: 0; margin: 0; padding: 0.6rem; font: 0.85rem/1.45 monospace; white-space: pre; overflow: auto; border: 0; background: transparent; } .edwrap textarea { color: transparent; caret-color: light-dark(black, white); resize: none; width: 100%; height: 100%; outline: none; } .hl i { font-style: normal; } .hk { color: #c678dd; font-weight: 600; } .hs { color: #98c379; } .hn { color: #d19a66; } .hc { color: #7f848e; }"))
let pgnd_body = sb_new()
sb_push(pgnd_body, "<pre id='src-default' hidden>" + html_escape(read_file("self_hosting/examples/playground_default.patlang")) + "</pre>" + nl())
sb_push(pgnd_body, "<p><label>Load example: <select id='exsel' onchange='loadExample()'>" + nl())
sb_push(pgnd_body, "<option value='default'>starter program</option>" + nl())
sb_push(pgnd_body, "</select></label></p>" + nl())
sb_push(pgnd_body, "<div class='edwrap'><pre id='hl' class='hl' aria-hidden='true'></pre><textarea id='ed' spellcheck='false' oninput='hlUpdate()' onscroll='hlSync()'>" + nl())
sb_push(pgnd_body, html_escape(read_file("self_hosting/examples/playground_default.patlang")))
sb_push(pgnd_body, "</textarea></div>" + nl())
sb_push(pgnd_body, "<p><button onclick='runPlayground()'>Compile and run in this browser</button> <span class='ms' id='ms-playground'></span></p>" + nl())
sb_push(pgnd_body, "<pre class='out' id='out-playground'>(not run yet)</pre>" + nl())
let pgnd_sections = list_push(pgnd_sections, tpl_raw(sb_str(pgnd_body)))
let pgnd_js = sb_new()
sb_push(pgnd_js, "const WASMS = { playground: '" + pg_b64 + "' };" + nl())
wasi_shim_js(pgnd_js)
sb_push(pgnd_js, "function runPlayground() { return runWasm('playground', 'playground', [document.getElementById('ed').value]); }" + nl())
let pgnd_sections = list_push(pgnd_sections, tpl_script(sb_str(pgnd_js)))
write_file("portfolio/demos/playground.html", render_page(tpl_page("Live playground: the compiler, in your browser", "fragment", pgnd_sections)))
print("wrote portfolio/demos/playground.html")

demo_page("pos", "Point of sale (events + OO + logic)", "A checkout session as a stream of <code>scan</code>/<code>pay</code> events: the product catalog lives in the object store, and a <code>dairy</code> fact drives the discount rule.", pos_src, pos_native, pg_b64)
demo_page("postests", "BDD framework: unit, integration, Gherkin", "PatLang's own self-hosted Gherkin-style BDD framework (<code>lib/test.patlang</code>: <code>t_init</code>/<code>check</code>/<code>step</code>/<code>run_feature_tagged</code>), running against the point of sale: unit assertions, event-driven integration checks, and a Gherkin feature whose steps dispatch through <code>apply</code>. The same framework drives PatLang's own self-hosted regression suites (<code>self_hosting/reflect_transpile_selftest.patlang</code>, <code>self_hosting/examples/pos_tests.patlang</code>), each wired into <code>cargo test</code> via a thin Rust cucumber step that just asserts on this framework's own <code>ALL TESTS PASSED</code> output.", post_src, post_native, pg_b64)
demo_page("contracts", "Design by contract: require / ensure / assert", "<code>require</code> checks a precondition, <code>ensure</code> a postcondition, and <code>assert</code> is the same primitive used standalone &mdash; all three lower to one <code>contract_check</code> host call, enforced identically whether interpreted, run here via WASM (no rustc at all), or compiled natively. The last line deliberately violates a precondition so you can see enforcement fire.", contracts_src, contracts_native, pg_b64)

demo_page("goaloriented", "Goal-oriented programming: real backward chaining + GOAP planning", "PatLang's goal-oriented paradigm is genuinely real, not a facade: <code>rule_add</code>/<code>solve</code> do actual SLD-style backward-chaining resolution with backtracking (a ground fact is just a rule with an empty body &mdash; the standard Prolog trick), and <code>action_add</code>/<code>plan</code> is a real GOAP planner, doing uniform-cost forward search over actions with preconditions/effects/cost to find the cheapest ordered plan &mdash; not just picking the first path that works. A successful <code>require</code>/<code>ensure</code> check also asserts a <code>contract_holds</code> fact, so design-by-contract checks feed directly into either engine. This demo derives whether a build target is buildable via a genuine multi-hop dependency chain, and separately produces a real 3-step build plan that correctly prefers a cheaper path over a pricier shortcut.", goal_oriented_src, goal_oriented_native, pg_b64)

demo_page("bitwise", "Bitwise operators & bitfields", "Word-form keyword operators &mdash; <code>band</code>/<code>bor</code>/<code>bxor</code>/<code>bnot</code>/<code>shl</code>/<code>shr</code> &mdash; rather than C-style symbols: <code>|</code> and <code>&amp;</code> are already taken by the <code>|&gt;</code> pipeline operator and <code>|params|</code> closure syntax, and PatLang already spells <code>and</code>/<code>or</code>/<code>not</code> as words, so this follows the language's own convention instead of importing symbols that don't fit. Plus four bitfield helpers &mdash; <code>bit_get</code>/<code>bit_set</code>/<code>bit_slice</code>/<code>bit_set_slice</code> &mdash; for packed-integer field access without needing a struct/type system. This demo packs four byte-sized fields into one integer two different ways (via <code>shl</code>/<code>bor</code> directly, and via <code>bit_set_slice</code>) and confirms they agree, then demonstrates flag set/clear/toggle/test.", bitwise_src, bitwise_native, pg_b64)

demo_page("rulesyntax", "Declarative syntax: rule Head(args) :- Body1, Body2.", "The parser has recognized <code>rule ... :- ...</code> syntax for a long time &mdash; it just silently discarded it as a no-op. This makes it real: pure sugar over the same <code>rule_add</code>/<code>solve</code> backend as the goal-oriented demo above, so <code>rule buildable(X) :- unchanged(X).</code> and <code>rule buildable(X) :- dep(X, Y), buildable(Y).</code> now actually declare rules, not decoration. Verified byte-identical against the hand-written <code>rule_add(...)</code> function-call form it desugars to.", rulesyntax_src, rulesyntax_native, pg_b64)

demo_page("vfsdemo", "Virtual filesystem: works in the browser too", "<code>vfs_read</code>/<code>vfs_write</code>/<code>vfs_exists</code>/<code>vfs_list</code>/<code>vfs_delete</code> are an in-memory filesystem available on every target &mdash; including WASM, unlike <code>read_file</code>/<code>write_file</code>, which are real (native-only) disk I/O. Try the <em>Compile and run in this browser</em> button below: this demo runs entirely inside the WASM sandbox with no real filesystem access at all. A separate, explicit, native-only <code>vfs_flush_to_disk</code> (not exercised here) write-throughs to real files, gated by an allowed-root check.", vfsdemo_src, vfsdemo_native, pg_b64)
demo_page("towerdemo", "Numeric Tower: BigInt, Rational, Complex", "Ordinary <code>Int</code> arithmetic stays on the fast path until it can't: <code>factorial(30)</code> overflows a 64-bit integer partway through and the runtime silently promotes to an exact, arbitrary-precision <code>BigInt</code> &mdash; no annotation, no wraparound, no lost digits. <code>10 / 3</code> doesn't divide evenly, so instead of quietly rounding to a float it promotes to an exact <code>Rational</code> and prints <code>10/3</code>. <code>sqrt</code> of a negative number produces a <code>Complex</code> value. The last two lines call into <code>self_hosting/lib/math.patlang</code> (<code>hypot</code>, <code>is_prime</code>, <code>mean</code>), a small PatLang-authored library built entirely on top of a handful of <code>Host::</code> primitives (<code>sqrt</code>/<code>floor</code>/<code>abs</code>/<code>numeric_kind</code>) &mdash; the hybrid design that keeps the primitive surface small while still growing a real standard library. This card runs on the exact same in-browser WASM playground engine as the demos above (no rustc needed to try it live); the compiled path's arithmetic is exact because the emitted Rust program carries its own hand-rolled limb-based BigInt/Rational/Complex implementation rather than depending on a crate (compiled programs are single-file <code>rustc</code> invocations with no <code>Cargo.toml</code>), and a cross-implementation test in the Rust test suite verifies that hand-rolled bignum arithmetic is byte-identical, operation for operation, to the interpreter's own <code>num-bigint</code>-crate-based arithmetic &mdash; two independent implementations kept honest against each other.", tower_src, tower_native, pg_b64)
demo_page("routerdsl", "User-defined DSL: routes { ... }", "A small grammar extension declared entirely in PatLang source (<code>syntax RouterDSL { trigger; tokens { ... }; rule { ... } }</code>), matching HTTP-verb/URL-path tokens with a general-purpose regex engine also written in PatLang (<code>lib/regex_dsl.patlang</code>). A source-to-source preprocessing pass (<code>lib/syntax_dsl.patlang</code>) expands every <code>routes { ... }</code> block into plain <code>register_route(...)</code> calls before the ordinary compiler ever sees them &mdash; run here via the same in-browser WASM playground engine as the demos above (no rustc at all), or compiled natively below.", router_raw, router_native, pg_b64)
# Threading demo: real parallel_map + a purely-illustrative, honestly-
# labeled in-browser mock. The mock does NOT execute PatLang/wasm at all --
# spawning real OS threads has no backing implementation in the WASI
# sandbox (wasm32-wasip1 has no threads proposal enabled here), and rather
# than risk an actual runtime panic/hang trying it live, the "worker
# lanes" animation below is plain JS using the ALREADY-CAPTURED native
# transcript's real numbers, staggered with fake timing purely to
# illustrate the shape of parallel work -- captioned as exactly that.
let threading_sections = [tpl_para("<code>parallel_map(items, " + q() + "func_name" + q() + ")</code> spawns one real OS thread per item (via Rust's <code>std::thread::scope</code>) and runs <code>func_name(item)</code> on each concurrently &mdash; genuine parallelism, mirrored byte-for-byte into the compiled-native runtime (<code>codegen.rs</code> and its self-hosted twin <code>runtime_rs.patlang</code>), so it works whether interpreted, compiled via <code>pat --patc</code>, or compiled via the self-hosted <code>patc1.exe</code>. This demo counts primes below 200,000 by splitting the range into 8 chunks, counting each chunk's primes on its own thread (the MAP step), then summing the per-chunk counts sequentially (the REDUCE step) &mdash; the classic map-reduce shape.")]
let threading_sections = list_push(threading_sections, tpl_raw("<details><summary>PatLang source</summary><pre class='src'>" + html_escape(threading_src) + "</pre></details>"))
let threading_sections = list_push(threading_sections, tpl_raw("<p class='label'>Native run on the build machine (real OS threads, patc1.exe-compiled):</p><pre class='out native'>" + html_escape(threading_native) + "</pre>"))
let threading_sections = list_push(threading_sections, tpl_para("<strong>No real \"run in browser\" button</strong>: the WASM sandbox this playground runs in has no OS-level threading support (wasm32-wasip1 without the threads proposal), so <code>parallel_map</code> has no backing implementation there. The animation below is a purely illustrative, non-functional mock &mdash; plain JavaScript staggering 8 boxes with fake timing to show the SHAPE of the real run above, not a live computation. The numbers it displays are the real transcript's own numbers, baked in statically."))
# total_primes_str is hardcoded to match threading_demo.patlang's fixed
# chunk_size/num_chunks (8 x 25000 = below 200,000) -- if that ever
# changes, the number here should change to match (the real transcript
# shown above it is always the ground truth regardless).
let total_primes_str = "17984"
let threading_body = sb_new()
sb_push(threading_body, "<div class='card'><p class='label'>Simulated (not live &mdash; see note above):</p>" + nl())
sb_push(threading_body, "<div id='tw-lanes' style='display:flex;gap:0.4em;margin:0.6em 0'></div>" + nl())
sb_push(threading_body, "<p><button onclick='twRun()'>Play simulated animation</button> <span id='tw-status' class='ms'></span></p>" + nl())
sb_push(threading_body, "</div>" + nl())
let threading_sections = list_push(threading_sections, tpl_raw(sb_str(threading_body)))
let threading_js = sb_new()
sb_push(threading_js, "const TW_N = 8;" + nl())
sb_push(threading_js, "(function twInit() {" + nl())
sb_push(threading_js, "  const el = document.getElementById('tw-lanes');" + nl())
sb_push(threading_js, "  for (let i = 0; i < TW_N; i++) { const d = document.createElement('div'); d.id = 'tw-' + i; d.style.cssText = 'width:2.4em;height:2.4em;border-radius:4px;background:color-mix(in srgb, currentColor 12%, transparent);display:flex;align-items:center;justify-content:center;font-size:0.8em;transition:background 0.15s'; d.textContent = i; el.appendChild(d); }" + nl())
sb_push(threading_js, "})();" + nl())
sb_push(threading_js, "function twRun() {" + nl())
sb_push(threading_js, "  document.getElementById('tw-status').textContent = 'simulating (fake, staggered timing)...';" + nl())
sb_push(threading_js, "  for (let i = 0; i < TW_N; i++) {" + nl())
sb_push(threading_js, "    const d = document.getElementById('tw-' + i);" + nl())
sb_push(threading_js, "    d.style.background = 'color-mix(in srgb, currentColor 12%, transparent)';" + nl())
sb_push(threading_js, "    setTimeout(() => { d.style.background = '#4a69bd'; d.style.color = '#fff'; }, 80 + Math.random() * 500);" + nl())
sb_push(threading_js, "    setTimeout(() => { d.style.background = '#6ab04c'; }, 600 + Math.random() * 300);" + nl())
sb_push(threading_js, "  }" + nl())
sb_push(threading_js, "  setTimeout(() => { document.getElementById('tw-status').textContent = 'done (simulated) -- real result: " + total_primes_str + " primes, real timing in the native transcript above'; }, 950);" + nl())
sb_push(threading_js, "}" + nl())
let threading_sections = list_push(threading_sections, tpl_script(sb_str(threading_js)))
write_file("portfolio/demos/threading.html", render_page(tpl_page("Real OS threads: parallel map-reduce", "fragment", threading_sections)))
print("wrote portfolio/demos/threading.html")

# Fiber demo: native (interpreted) transcript, PLUS a genuine live "run in
# browser" button -- compiled to wasm32-wasip1-threads and executed for
# real via the hand-rolled WASI-threads shim above (real OS threads via
# real Web Workers, not a mock), requires cross-origin isolation (COOP/
# COEP headers; runWasmThreaded checks self.crossOriginIsolated itself and
# reports plainly if unavailable rather than pretending to run).
let fiber_wasmb64 = compile_wasm_threaded_only(fiber_src, "fiber")
let fiber_sections = [tpl_para("Ruby-style cooperative coroutines (<code>fiber_new</code>/<code>fiber_resume</code>/<code>fiber_yield</code>/<code>fiber_alive</code>), implemented on real OS threads under the hood but never actually running concurrently: a mutex+condvar pair (<code>ir/fiber.rs</code>) ensures only one fiber's thread is ever unparked at a time, so control passes back and forth explicitly, deterministic and effectively single-threaded &mdash; distinct from <code>parallel_map</code> above, which IS real parallelism. This demo is a classic fiber use case: a lazy, infinite Fibonacci generator the caller pulls values from one at a time, plus a second, independent fiber running the same generator function to show each fiber keeps its own state.")]
let fiber_sections = list_push(fiber_sections, tpl_raw("<details><summary>PatLang source</summary><pre class='src'>" + html_escape(fiber_src) + "</pre></details>"))
let fiber_sections = list_push(fiber_sections, tpl_raw("<p class='label'>Interpreted run on the build machine (<code>pat --ir-run</code>):</p><pre class='out native'>" + html_escape(fiber_native) + "</pre>"))
let fiber_sections = list_push(fiber_sections, tpl_para("<strong>Real \"run in browser\" button</strong> below: this compiles to <code>wasm32-wasip1-threads</code> and runs via a hand-rolled implementation of the WASI threads proposal (real <code>Worker</code>s + <code>SharedArrayBuffer</code>-backed shared memory + a pre-warmed worker pool standing in for real thread creation) &mdash; no wasm-bindgen, no mock. Needs cross-origin isolation; the button reports plainly if that's unavailable on this page load rather than silently doing nothing."))
let fiber_body = sb_new()
sb_push(fiber_body, "<div class='card'><p class='label'>Live run, real OS threads, compiled to threaded WASM:</p>" + nl())
sb_push(fiber_body, "<p><button onclick=\"runWasmThreaded('fiber','fiber')\">Run in browser</button> <span id='ms-fiber' class='ms'></span></p>" + nl())
sb_push(fiber_body, "<pre id='out-fiber' class='out'></pre>" + nl())
sb_push(fiber_body, "</div>" + nl())
let fiber_sections = list_push(fiber_sections, tpl_raw(sb_str(fiber_body)))
let fiber_sections = list_push(fiber_sections, tpl_raw(wasi_threads_worker_tag()))
let fiber_js = sb_new()
sb_push(fiber_js, "const WASMS = { fiber: '" + fiber_wasmb64 + "' };" + nl())
b64bytes_only_js(fiber_js)
wasi_threads_shim_js(fiber_js)
let fiber_sections = list_push(fiber_sections, tpl_script(sb_str(fiber_js)))
write_file("portfolio/demos/fiber.html", render_page(tpl_page("Fibers: cooperative coroutines", "fragment", fiber_sections)))
print("wrote portfolio/demos/fiber.html")

# Robots demo: three fibers (real OS threads / real WASI-threads Workers)
# navigate a grid and signal each other via emit() when reaching a
# waypoint -- a live demonstration of the cross-thread EVENT_HANDLERS fix.
let robots_src = read_file("self_hosting/examples/robots_demo.patlang")
let robots_native = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/examples/robots_demo.patlang")
let robots_wasmb64 = compile_wasm_threaded_only(robots_src, "robots")
let robots_sections = [tpl_para("Three robots, each a real fiber, navigate toward two waypoints apiece on a small grid. When a robot reaches a waypoint it calls <code>emit(\"signal\", ...)</code> -- a <code>when signal</code> handler registered on the main thread fires and announces it, even though the emitting code is running on a different real OS thread (or, compiled to threaded WASM, a different real Worker). This is the direct, hands-on demonstration of the cross-thread event fix: previously EVENT_HANDLERS was thread_local, so this exact program's emit() calls would have silently done nothing.")]
let robots_sections = list_push(robots_sections, tpl_raw("<details><summary>PatLang source</summary><pre class='src'>" + html_escape(robots_src) + "</pre></details>"))
let robots_sections = list_push(robots_sections, tpl_raw("<p class='label'>Interpreted run on the build machine (<code>pat --ir-run</code>):</p><pre class='out native'>" + html_escape(robots_native) + "</pre>"))
let robots_sections = list_push(robots_sections, tpl_para("<strong>Real \"run in browser\" button</strong> below: replays the exact step-by-step transcript from a genuine run compiled to <code>wasm32-wasip1-threads</code>, executed live via the hand-rolled WASI-threads shim -- not a hand-authored mock. Real cross-thread synchronization has more overhead in a browser Worker than natively, so this takes roughly 30-60 seconds; the status line explains why rather than leaving you staring at a spinner."))
let robots_body = sb_new()
sb_push(robots_body, "<div class='card'><p class='label'>Live run, real OS threads, real cross-thread signaling:</p>" + nl())
sb_push(robots_body, "<p><button id='robots-run' onclick='runRobotsDemo()'>Run in browser</button> <span id='robots-status' class='ms'></span></p>" + nl())
sb_push(robots_body, "<canvas id='robots-grid' width='400' height='240'></canvas>" + nl())
sb_push(robots_body, "<pre id='robots-log' class='out'></pre>" + nl())
sb_push(robots_body, "</div>" + nl())
let robots_sections = list_push(robots_sections, tpl_raw(sb_str(robots_body)))
let robots_sections = list_push(robots_sections, tpl_raw(wasi_threads_worker_tag()))
let robots_sections = list_push(robots_sections, tpl_style("#robots-grid { background: #1b2a1b; border: 1px solid color-mix(in srgb, currentColor 25%, transparent); } #robots-log { white-space: pre-wrap; font: 12px/1.4 monospace; max-height: 200px; overflow-y: auto; }"))
let robots_js = sb_new()
sb_push(robots_js, "const WASMS = { robots: '" + robots_wasmb64 + "' };" + nl())
b64bytes_only_js(robots_js)
wasi_threads_shim_js(robots_js)
sb_push(robots_js, "const GRID_W = 10, GRID_H = 6, CELL = 40;" + nl())
sb_push(robots_js, "const ROBOTS = {" + nl())
sb_push(robots_js, "  R0: { color: '#e74c3c', start: [0, 0], waypoints: [[5, 2], [9, 5]] }," + nl())
sb_push(robots_js, "  R1: { color: '#3498db', start: [9, 0], waypoints: [[4, 3], [0, 5]] }," + nl())
sb_push(robots_js, "  R2: { color: '#2ecc71', start: [0, 5], waypoints: [[7, 4], [9, 0]] }," + nl())
sb_push(robots_js, "};" + nl())
sb_push(robots_js, "const canvas = document.getElementById('robots-grid');" + nl())
sb_push(robots_js, "const ctx = canvas.getContext('2d');" + nl())
sb_push(robots_js, "const rlog = document.getElementById('robots-log');" + nl())
sb_push(robots_js, "const rstatus = document.getElementById('robots-status');" + nl())
sb_push(robots_js, "function rlogLine(s) { rlog.textContent += s + '\\n'; rlog.scrollTop = rlog.scrollHeight; }" + nl())
sb_push(robots_js, "function robotsDrawGrid() {" + nl())
sb_push(robots_js, "  ctx.clearRect(0, 0, canvas.width, canvas.height);" + nl())
sb_push(robots_js, "  ctx.strokeStyle = '#294029';" + nl())
sb_push(robots_js, "  for (let x = 0; x <= GRID_W; x++) { ctx.beginPath(); ctx.moveTo(x * CELL, 0); ctx.lineTo(x * CELL, GRID_H * CELL); ctx.stroke(); }" + nl())
sb_push(robots_js, "  for (let y = 0; y <= GRID_H; y++) { ctx.beginPath(); ctx.moveTo(0, y * CELL); ctx.lineTo(GRID_W * CELL, y * CELL); ctx.stroke(); }" + nl())
sb_push(robots_js, "  for (const id in ROBOTS) {" + nl())
sb_push(robots_js, "    ctx.fillStyle = ROBOTS[id].color;" + nl())
sb_push(robots_js, "    for (const [wx, wy] of ROBOTS[id].waypoints) {" + nl())
sb_push(robots_js, "      ctx.font = '22px sans-serif';" + nl())
sb_push(robots_js, "      ctx.fillText('\\u{1F6A9}', wx * CELL + 6, wy * CELL + 28);" + nl())
sb_push(robots_js, "    }" + nl())
sb_push(robots_js, "  }" + nl())
sb_push(robots_js, "}" + nl())
sb_push(robots_js, "function robotsDrawAll(positions, flash) {" + nl())
sb_push(robots_js, "  robotsDrawGrid();" + nl())
sb_push(robots_js, "  for (const id in positions) {" + nl())
sb_push(robots_js, "    const [x, y] = positions[id];" + nl())
sb_push(robots_js, "    ctx.fillStyle = ROBOTS[id].color;" + nl())
sb_push(robots_js, "    ctx.beginPath();" + nl())
sb_push(robots_js, "    ctx.arc(x * CELL + CELL / 2, y * CELL + CELL / 2, CELL / 3, 0, Math.PI * 2);" + nl())
sb_push(robots_js, "    ctx.fill();" + nl())
sb_push(robots_js, "    ctx.fillStyle = '#fff';" + nl())
sb_push(robots_js, "    ctx.font = 'bold 12px sans-serif';" + nl())
sb_push(robots_js, "    ctx.textAlign = 'center';" + nl())
sb_push(robots_js, "    ctx.fillText(id, x * CELL + CELL / 2, y * CELL + CELL / 2 + 4);" + nl())
sb_push(robots_js, "    ctx.textAlign = 'left';" + nl())
sb_push(robots_js, "    if (flash === id) {" + nl())
sb_push(robots_js, "      ctx.strokeStyle = '#fff'; ctx.lineWidth = 3;" + nl())
sb_push(robots_js, "      ctx.beginPath();" + nl())
sb_push(robots_js, "      ctx.arc(x * CELL + CELL / 2, y * CELL + CELL / 2, CELL / 2, 0, Math.PI * 2);" + nl())
sb_push(robots_js, "      ctx.stroke();" + nl())
sb_push(robots_js, "      ctx.lineWidth = 1;" + nl())
sb_push(robots_js, "    }" + nl())
sb_push(robots_js, "  }" + nl())
sb_push(robots_js, "}" + nl())
sb_push(robots_js, "async function runRobotsDemo() {" + nl())
sb_push(robots_js, "  const btn = document.getElementById('robots-run');" + nl())
sb_push(robots_js, "  btn.disabled = true;" + nl())
sb_push(robots_js, "  rstatus.textContent = 'starting...';" + nl())
sb_push(robots_js, "  rlog.textContent = '';" + nl())
sb_push(robots_js, "  if (!self.crossOriginIsolated) {" + nl())
sb_push(robots_js, "    rstatus.textContent = 'requires cross-origin isolation (COOP/COEP headers) -- not available on this page load';" + nl())
sb_push(robots_js, "    btn.disabled = false;" + nl())
sb_push(robots_js, "    return;" + nl())
sb_push(robots_js, "  }" + nl())
sb_push(robots_js, "  const module = await WebAssembly.compile(b64bytes(WASMS.robots));" + nl())
sb_push(robots_js, "  const memory = new WebAssembly.Memory({ initial: 64, maximum: 2048, shared: true });" + nl())
sb_push(robots_js, "  const tidCounter = new Int32Array(new SharedArrayBuffer(4));" + nl())
sb_push(robots_js, "  tidCounter[0] = 1;" + nl())
sb_push(robots_js, "  const mainWorker = new Worker(threadWorkerUrl());" + nl())
sb_push(robots_js, "  const messages = [];" + nl())
sb_push(robots_js, "  let startSeen = false;" + nl())
sb_push(robots_js, "  mainWorker.onmessage = (e) => { messages.push(e.data); if (e.data.type === 'start') startSeen = true; };" + nl())
sb_push(robots_js, "  mainWorker.onerror = (e) => rlogLine('WORKER ERROR: ' + e.message);" + nl())
sb_push(robots_js, "  mainWorker.postMessage({ type: 'start', module, memory, tidCounter });" + nl())
sb_push(robots_js, "  // Real cross-thread synchronization (each fiber_resume crosses a real OS" + nl())
sb_push(robots_js, "  // thread boundary via Atomics.wait/notify) has genuinely higher overhead" + nl())
sb_push(robots_js, "  // in a browser Worker than natively -- this takes on the order of a" + nl())
sb_push(robots_js, "  // minute for 3 robots' worth of resume/yield cycles, not because" + nl())
sb_push(robots_js, "  // anything is stuck, just because real thread hand-offs aren't free." + nl())
sb_push(robots_js, "  const t0 = Date.now();" + nl())
sb_push(robots_js, "  const deadline = t0 + 60000;" + nl())
sb_push(robots_js, "  while (!startSeen && Date.now() < deadline) {" + nl())
sb_push(robots_js, "    rstatus.textContent = 'running on real OS threads (~30-60s, genuine cross-thread overhead, not a hang)... ' + Math.round((Date.now() - t0) / 1000) + 's';" + nl())
sb_push(robots_js, "    await new Promise((r) => setTimeout(r, 500));" + nl())
sb_push(robots_js, "  }" + nl())
sb_push(robots_js, "  await new Promise((r) => setTimeout(r, 3000));" + nl())
sb_push(robots_js, "  rstatus.textContent = startSeen ? 'ran successfully, replaying real transcript...' : 'FAILED (see log below)';" + nl())
sb_push(robots_js, "  // The 'start' message's stdout is the main thread's own print() calls --" + nl())
sb_push(robots_js, "  // every movement step (fiber_resume's return value, printed by the" + nl())
sb_push(robots_js, "  // resuming/main thread) in exactly the right order. SIGNAL lines are" + nl())
sb_push(robots_js, "  // printed by whichever fiber thread's emit() handler ran, so they arrive" + nl())
sb_push(robots_js, "  // in separate messages -- matched to the animation by the (robot, x, y)" + nl())
sb_push(robots_js, "  // they report reaching, not by cross-thread message arrival order." + nl())
sb_push(robots_js, "  const startMsg = messages.find((m) => m.type === 'start');" + nl())
sb_push(robots_js, "  const allStdout = messages.map((m) => m.stdout || '').join('\\n');" + nl())
sb_push(robots_js, "  rlogLine(allStdout.trim());" + nl())
sb_push(robots_js, "  const moveLines = (startMsg ? startMsg.stdout : '').split('\\n').filter((l) => /^R\\d,/.test(l));" + nl())
sb_push(robots_js, "  const signalMatches = [...allStdout.matchAll(/SIGNAL (R\\d) reached \\((\\d+),(\\d+)\\)/g)]" + nl())
sb_push(robots_js, "    .map((m) => ({ id: m[1], x: +m[2], y: +m[3] }));" + nl())
sb_push(robots_js, "  const perRobotMoves = { R0: [], R1: [], R2: [] };" + nl())
sb_push(robots_js, "  for (const line of moveLines) {" + nl())
sb_push(robots_js, "    const m = line.match(/^(R\\d),(-?\\d+|DONE),(-?\\d+)?$/);" + nl())
sb_push(robots_js, "    if (!m || m[2] === 'DONE') continue;" + nl())
sb_push(robots_js, "    perRobotMoves[m[1]].push([+m[2], +m[3]]);" + nl())
sb_push(robots_js, "  }" + nl())
sb_push(robots_js, "  const positions = {};" + nl())
sb_push(robots_js, "  for (const id in ROBOTS) positions[id] = ROBOTS[id].start;" + nl())
sb_push(robots_js, "  robotsDrawAll(positions, null);" + nl())
sb_push(robots_js, "  const maxLen = Math.max(...Object.values(perRobotMoves).map((a) => a.length));" + nl())
sb_push(robots_js, "  for (let step = 0; step < maxLen; step++) {" + nl())
sb_push(robots_js, "    for (const id in perRobotMoves) {" + nl())
sb_push(robots_js, "      const pos = perRobotMoves[id][step];" + nl())
sb_push(robots_js, "      if (pos) positions[id] = pos;" + nl())
sb_push(robots_js, "    }" + nl())
sb_push(robots_js, "    let flash = null;" + nl())
sb_push(robots_js, "    for (const sig of signalMatches) {" + nl())
sb_push(robots_js, "      const p = positions[sig.id];" + nl())
sb_push(robots_js, "      if (p && p[0] === sig.x && p[1] === sig.y) flash = sig.id;" + nl())
sb_push(robots_js, "    }" + nl())
sb_push(robots_js, "    robotsDrawAll(positions, flash);" + nl())
sb_push(robots_js, "    await new Promise((r) => setTimeout(r, 220));" + nl())
sb_push(robots_js, "  }" + nl())
sb_push(robots_js, "  rstatus.textContent = 'done -- replayed a real cross-thread run (not a mock)';" + nl())
sb_push(robots_js, "  btn.disabled = false;" + nl())
sb_push(robots_js, "}" + nl())
sb_push(robots_js, "robotsDrawGrid();" + nl())

let robots_sections = list_push(robots_sections, tpl_script(sb_str(robots_js)))
write_file("portfolio/demos/robots.html", render_page(tpl_page("Robots signaling each other", "fragment", robots_sections)))
print("wrote portfolio/demos/robots.html")

# CGA classifier demo: a validated-interval Conformal Geometric Algebra
# point-in-sphere classifier with k-blade dimensionality reduction of a
# sparse 5D dataset, ported from a standalone JS/Canvas prototype into
# real PatLang -- every pixel classification and the Minkowski null-cone
# certification is genuine PatLang computation compiled to WASM, not a
# JS reimplementation with PatLang just narrating it.
let cga_src = read_file("self_hosting/examples/cga_classifier.patlang")
let cga_native = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/examples/cga_classifier.patlang", "xor", "reduced", "12", "250", "250", "160", "1", "cga_sphere")
let cga_wasmb64 = compile_wasm_only(cga_src, "cga")
let cga_sections = [tpl_para("A CGA point embeds a 2D location plus an uncertainty radius as an INTERVAL-valued null vector; a CGA sphere is the same components as plain scalars. Their inner product is therefore an interval, not a single number -- a pixel is only certified inside or outside when zero falls strictly outside that interval; when the interval straddles zero, the classifier honestly reports it ambiguous rather than rounding arbitrarily. Every embedded point is also checked against the Minkowski null-cone identity <code>X&sup2; = 0</code>, certifying the embedding itself, not just the classification built on it.")]
let cga_sections = list_push(cga_sections, tpl_para("The dataset lives in a synthetic 5D sparse space and is projected down to the 2D plane the classifier sees via a structural k-blade (<code>projected = sum(component &times; blade)</code>). Toggle <em>Dimensionality Projection</em> to compare a deliberate blade-guided projection (which cancels most of the hidden dimension's cross-plane noise) against naively summing raw components (which lets that noise bleed straight into the visible plane) -- the same k-blade-instead-of-scalar-tensor idea explored on <a href=" + q() + "k-blade-geometric-algebra-replacement-for-scalar-tensors-in-large-language-models.html" + q() + ">the k-blade page</a>."))
let cga_sections = list_push(cga_sections, tpl_raw("<details><summary>PatLang source</summary><pre class='src'>" + html_escape(cga_src) + "</pre></details>"))
let cga_sections = list_push(cga_sections, tpl_raw("<p class='label'>Interpreted run on the build machine (<code>pat --ir-run</code>, dataset=xor):</p><pre class='out native'>" + html_escape(cga_native) + "</pre>"))
let cga_body = sb_new()
sb_push(cga_body, "<div class='card'>" + nl())
sb_push(cga_body, "<div style='display:flex;gap:16px;flex-wrap:wrap;align-items:flex-start'>" + nl())
sb_push(cga_body, "<div style='min-width:220px'>" + nl())
sb_push(cga_body, "<p class='label'>Dataset (5D sparse space)<br><select id='cga-dataset' onchange='cgaRender()'>" + nl())
sb_push(cga_body, "<option value='xor'>XOR boundary</option>" + nl())
sb_push(cga_body, "<option value='circles'>Concentric rings</option>" + nl())
sb_push(cga_body, "<option value='spiral'>Two spirals</option>" + nl())
sb_push(cga_body, "</select></p>" + nl())
sb_push(cga_body, "<p class='label'>Dimensionality projection<br><select id='cga-mode' onchange='cgaRender()'>" + nl())
sb_push(cga_body, "<option value='reduced'>k-blade contraction (reduced)</option>" + nl())
sb_push(cga_body, "<option value='raw_noisy'>Raw components (noisy)</option>" + nl())
sb_push(cga_body, "</select></p>" + nl())
sb_push(cga_body, "<p class='label'>Classifier engine<br><select id='cga-classifier' onchange='cgaRender()'>" + nl())
sb_push(cga_body, "<option value='cga_sphere'>Conformal GA hypersphere inner product</option>" + nl())
sb_push(cga_body, "<option value='bisection_field'>Hierarchical tree of joins &amp; bisection field</option>" + nl())
sb_push(cga_body, "</select></p>" + nl())
sb_push(cga_body, "<p class='label'>Uncertainty radius &epsilon;: <span id='cga-eps-label'>12</span>px<br><input type='range' id='cga-epsilon' min='2' max='30' value='12' oninput='cgaRender()'></p>" + nl())
sb_push(cga_body, "<p><button onclick='cgaNewLayout()'>New random layout</button></p>" + nl())
sb_push(cga_body, "<p class='label'>Minkowski invariant (X&sup2; = 0)</p>" + nl())
sb_push(cga_body, "<div id='cga-invariant' class='out' style='min-height:3em'></div>" + nl())
sb_push(cga_body, "</div>" + nl())
sb_push(cga_body, "<div>" + nl())
sb_push(cga_body, "<canvas id='cga-grid' width='500' height='500' style='cursor:crosshair'></canvas>" + nl())
sb_push(cga_body, "<p class='ms' id='cga-status'>starting...</p>" + nl())
sb_push(cga_body, "<p class='label'>Click the grid to move the sphere. <span style='color:#5dcaa5'>&#9679;</span> class A &nbsp; <span style='color:#fac775'>&#9679;</span> class B</p>" + nl())
sb_push(cga_body, "</div>" + nl())
sb_push(cga_body, "</div>" + nl())
sb_push(cga_body, "</div>" + nl())
let cga_sections = list_push(cga_sections, tpl_raw(sb_str(cga_body)))
let cga_js = sb_new()
sb_push(cga_js, "const WASMS = { cga: '" + cga_wasmb64 + "' };" + nl())
runwasm_only_js(cga_js)
sb_push(cga_js, "const CGA_W = 500, CGA_H = 500, CGA_STEP = 4;" + nl())
sb_push(cga_js, "const cgaCanvas = document.getElementById('cga-grid');" + nl())
sb_push(cga_js, "const cgaCtx = cgaCanvas.getContext('2d');" + nl())
sb_push(cga_js, "const cgaStatus = document.getElementById('cga-status');" + nl())
sb_push(cga_js, "const cgaInvariant = document.getElementById('cga-invariant');" + nl())
sb_push(cga_js, "const cgaEpsLabel = document.getElementById('cga-eps-label');" + nl())
sb_push(cga_js, "let cgaSeed = 1;" + nl())
sb_push(cga_js, "let cgaSphere = { x: 250, y: 250, r: 160 };" + nl())
sb_push(cga_js, "const CGA_COLORS = ['rgba(45,122,95,0.35)', 'rgba(160,90,26,0.28)', 'rgba(186,117,23,0.55)'];" + nl())
sb_push(cga_js, "const CGA_DOT = ['#5dcaa5', '#fac775'];" + nl())
sb_push(cga_js, "" + nl())
sb_push(cga_js, "function cgaNewLayout() {" + nl())
sb_push(cga_js, "  cgaSeed = 1 + Math.floor(Math.random() * 1000000);" + nl())
sb_push(cga_js, "  cgaRender();" + nl())
sb_push(cga_js, "}" + nl())
sb_push(cga_js, "" + nl())
sb_push(cga_js, "async function cgaRender() {" + nl())
sb_push(cga_js, "  const dataset = document.getElementById('cga-dataset').value;" + nl())
sb_push(cga_js, "  const mode = document.getElementById('cga-mode').value;" + nl())
sb_push(cga_js, "  const classifier = document.getElementById('cga-classifier').value;" + nl())
sb_push(cga_js, "  const epsilon = document.getElementById('cga-epsilon').value;" + nl())
sb_push(cga_js, "  cgaEpsLabel.textContent = epsilon;" + nl())
sb_push(cga_js, "  cgaStatus.textContent = 'classifying...';" + nl())
sb_push(cga_js, "  const args = [dataset, mode, String(epsilon), String(cgaSphere.x), String(cgaSphere.y), String(cgaSphere.r), String(cgaSeed), classifier];" + nl())
sb_push(cga_js, "  const text = await runWasm('cga', 'cga', args);" + nl())
sb_push(cga_js, "  const sections = { GRID: [], POINTS: [], INVARIANT: [] };" + nl())
sb_push(cga_js, "  let current = null;" + nl())
sb_push(cga_js, "  for (const line of text.split('\\n')) {" + nl())
sb_push(cga_js, "    if (line === 'GRID' || line === 'POINTS' || line === 'INVARIANT') { current = line; continue; }" + nl())
sb_push(cga_js, "    if (current && line.length) sections[current].push(line);" + nl())
sb_push(cga_js, "  }" + nl())
sb_push(cga_js, "  cgaCtx.clearRect(0, 0, CGA_W, CGA_H);" + nl())
sb_push(cga_js, "  let row = 0;" + nl())
sb_push(cga_js, "  for (const line of sections.GRID) {" + nl())
sb_push(cga_js, "    for (let col = 0; col < line.length; col++) {" + nl())
sb_push(cga_js, "      const status = +line[col];" + nl())
sb_push(cga_js, "      cgaCtx.fillStyle = CGA_COLORS[status] || CGA_COLORS[2];" + nl())
sb_push(cga_js, "      cgaCtx.fillRect(col * CGA_STEP, row * CGA_STEP, CGA_STEP, CGA_STEP);" + nl())
sb_push(cga_js, "    }" + nl())
sb_push(cga_js, "    row++;" + nl())
sb_push(cga_js, "  }" + nl())
sb_push(cga_js, "  if (classifier === 'cga_sphere') {" + nl())
sb_push(cga_js, "    cgaCtx.beginPath();" + nl())
sb_push(cga_js, "    cgaCtx.arc(cgaSphere.x, cgaSphere.y, cgaSphere.r, 0, Math.PI * 2);" + nl())
sb_push(cga_js, "    cgaCtx.strokeStyle = 'rgba(107,61,140,0.55)';" + nl())
sb_push(cga_js, "    cgaCtx.lineWidth = 2;" + nl())
sb_push(cga_js, "    cgaCtx.setLineDash([6, 4]);" + nl())
sb_push(cga_js, "    cgaCtx.stroke();" + nl())
sb_push(cga_js, "    cgaCtx.setLineDash([]);" + nl())
sb_push(cga_js, "  }" + nl())
sb_push(cga_js, "  for (const line of sections.POINTS) {" + nl())
sb_push(cga_js, "    const parts = line.split(',');" + nl())
sb_push(cga_js, "    const px = +parts[0], py = +parts[1], label = +parts[2];" + nl())
sb_push(cga_js, "    cgaCtx.beginPath();" + nl())
sb_push(cga_js, "    cgaCtx.arc(px, py, 3, 0, Math.PI * 2);" + nl())
sb_push(cga_js, "    cgaCtx.fillStyle = CGA_DOT[label] || '#fff';" + nl())
sb_push(cga_js, "    cgaCtx.fill();" + nl())
sb_push(cga_js, "  }" + nl())
sb_push(cga_js, "  if (sections.INVARIANT.length) {" + nl())
sb_push(cga_js, "    const parts = sections.INVARIANT[0].split(',');" + nl())
sb_push(cga_js, "    const trapped = parts[0] === '1';" + nl())
sb_push(cga_js, "    const lo = (+parts[1]).toFixed(3), hi = (+parts[2]).toFixed(3);" + nl())
sb_push(cga_js, "    cgaInvariant.innerHTML = 'Status: ' + (trapped ? '<span class=" + q() + "cga-pass" + q() + ">CERTIFIED (0 trapped)</span>' : '<span class=" + q() + "cga-fail" + q() + ">FAILED</span>') +" + nl())
sb_push(cga_js, "      '<br>X&sup2; range: [' + lo + ', ' + hi + ']';" + nl())
sb_push(cga_js, "  }" + nl())
sb_push(cga_js, "  const engineLabel = classifier === 'bisection_field' ? 'hierarchical bisection field' : 'CGA sphere inner product';" + nl())
sb_push(cga_js, "  cgaStatus.textContent = 'engine: ' + engineLabel + ' -- dataset: ' + dataset.toUpperCase() + ' -- projection: ' + mode.toUpperCase();" + nl())
sb_push(cga_js, "}" + nl())
sb_push(cga_js, "" + nl())
sb_push(cga_js, "cgaCanvas.addEventListener('click', (e) => {" + nl())
sb_push(cga_js, "  const rect = cgaCanvas.getBoundingClientRect();" + nl())
sb_push(cga_js, "  cgaSphere.x = Math.round((e.clientX - rect.left) * (CGA_W / rect.width));" + nl())
sb_push(cga_js, "  cgaSphere.y = Math.round((e.clientY - rect.top) * (CGA_H / rect.height));" + nl())
sb_push(cga_js, "  cgaRender();" + nl())
sb_push(cga_js, "});" + nl())
sb_push(cga_js, "" + nl())
sb_push(cga_js, "cgaNewLayout();" + nl())

let cga_sections = list_push(cga_sections, tpl_script(sb_str(cga_js)))
write_file("portfolio/demos/cga.html", render_page(tpl_page("CGA Interval Classifier", "fragment", cga_sections)))
print("wrote portfolio/demos/cga.html")

native_page("dynsyntax", "Dynamic syntax: grammar extensions as runtime data", "The DSL page above declares its <code>syntax { ... }</code> block as a literal, expanded once before the compiler ever runs &mdash; indistinguishable from a macro. This one instead computes its trigger keyword and rules from data at runtime, calls <code>expand_syntax_dsls_with(src, existing_defs)</code> itself to define the grammar extension, keeps only the returned <code>defs</code> list, then makes a SEPARATE, later call &mdash; on a string containing only the usage line, no syntax declaration anywhere in it &mdash; passing those <code>defs</code> forward. Two independent calls, composing through nothing but an ordinary list value, exactly like passing along any other piece of program state. The assembled result runs through the same <code>tokenize</code>/<code>parse_program</code>/<code>lower_program</code>/<code>run_ir</code> chain that already powers the playground (see <code>self_hosting/examples/playground_main.patlang</code>) &mdash; PatLang's compiler has always been callable from PatLang code; this demo is the first to close the loop and use that to synthesize a language construct that couldn't have existed until the program ran. <strong>Native transcript only, no &quot;run in browser&quot; button</strong>: because this demo calls the compiler pipeline from inside itself, running it live means the playground's own <code>run_ir</code> (a nested interpreter, isolated from the outer compiled binary's functions) has to tokenize/parse/lower the entire ~85KB pipeline-plus-demo bundle a second time, INSIDE that nested interpreter &mdash; measured at several orders of magnitude slower than the ~2.5 seconds the same bundle takes through the top-level interpreter directly. The underlying capability is proven correct (this transcript matches the interpreted result exactly, and a compiled-native build agrees too); the live-in-browser path for this specific self-referential case is simply not practical yet &mdash; an honest limitation of <code>run_ir</code>'s current performance on large inputs, not of the dynamic-syntax feature itself.", dynsyntax_src, dynsyntax_native)
let manifest_text = read_file("self_hosting/patbuild.manifest")
native_page("patbuild", "patbuild: a goal-oriented build system", "Driven by a manifest file (<code>self_hosting/patbuild.manifest</code>):<pre class='out'>" + html_escape(manifest_text) + "</pre>Targets are objects, dependencies are walked recursively, finished builds become <code>fact</code>s, progress is reported via events. By default each target is only lowered to IR and checked (no rustc at all, matching the in-browser playground); pass <code>--native</code> to also compile every target to a real executable via rustc &mdash; the transcript below was captured that way. <strong>Native transcript only, no &quot;run in browser&quot; button</strong>: unlike the demos above, patbuild genuinely needs real filesystem access it can't get in the WASI sandbox &mdash; it reads the manifest file plus every target's own source file from disk by path, and (with <code>--native</code>) invokes a real <code>rustc</code> subprocess per target, neither of which a browser sandbox can provide. This is a capability limit, not a performance one (compare the dynamic-syntax demo below, which CAN run in-browser, just impractically slowly for now).", patbuild_src, patbuild_native)

native_page("signalsdemo", "Runtime signals: quit and status from outside the process", "A running PatLang program can receive a named signal + optional payload from OUTSIDE itself &mdash; a second CLI invocation (<code>server.exe --quit</code> sent to an already-running server, not a new one) or a local network call &mdash; dispatched through the same <code>when &lt;name&gt; do ... end</code> / <code>emit(...)</code> mechanism every other event in PatLang already uses, not a new handler concept. <code>signal_claim(port)</code> lets a process become the &quot;primary&quot; holder of a port (a second bind to the same port simply failing IS the &quot;is a primary already running&quot; detector, for free); a process that can't claim it instead calls <code>signal_send(port, name, payload)</code> for fire-and-forget signals like <code>quit</code>, or <code>signal_query(port, name, payload)</code> for request/response signals like <code>status</code>, which waits for and returns whatever the primary's handler passed to <code>signal_reply(text)</code>. This demo's real, live state (an uptime counter and a ping tally, both genuinely tracked while the process runs) is what <code>status</code> actually reports back &mdash; not a canned string. <strong>Native transcript only, no &quot;run in browser&quot; button</strong>: this needs real TCP sockets and real separate OS processes, neither available in the WASI sandbox. The transcript below simulates the primary/secondary roles as two real OS threads within one process (build-time transcripts need to run to completion, but a real primary only exits once it receives <code>quit</code>) &mdash; the source shown is the real <code>self_hosting/lib/signals.patlang</code> library plus that thread-based driver; see <code>self_hosting/examples/signals_demo.patlang</code> for the genuine two-separate-process form you'd actually run yourself: start it once in the background, then run it again with <code>quit</code>, <code>status</code>, or <code>ping &lt;message&gt;</code> as arguments.", signals_src, signals_native)

native_page("builddaemon", "Exemplar: a build daemon combining logic, GOAP, signals, events, and self-timing", "A self-hosted build daemon showing five of PatLang's less-usual capabilities working together in one program. <strong>Logic</strong> (<code>rule_add</code>/<code>solve</code>) derives which of six synthetic build targets are stale from <code>dep(target, dependency)</code>/<code>changed(target)</code> facts, by real multi-hop backward chaining, not a hand-written graph walk. <strong>Goal-seeking</strong> (<code>action_add</code>/<code>plan</code>, GOAP) then produces the actual cost-optimal rebuild order &mdash; and the cost of each action is that target's own <em>real, historically measured</em> build duration, not a guess: the planner is reasoning about genuine past performance. <strong>Self-timing</strong> (<code>now_ms()</code>) records every build's real duration to a small history file that survives between runs, seeding both the GOAP costs above and an upfront ETA on the very next run. <strong>Events</strong> (<code>when</code>/<code>emit</code>) drive a live dashboard as each target builds. <strong>Signals</strong> (<code>self_hosting/lib/signals.patlang</code>, unchanged) let a separate CLI invocation query live <code>status</code> (rebuilt count, ETA) or trigger <code>rebuild</code>/<code>quit</code> against the running daemon. The build graph is deliberately synthetic (fake targets, <code>sleep_ms</code> standing in for real compile work) so these five features stay legible rather than the demo being coupled to a slow, real build pipeline. <strong>Native transcript only, no &quot;run in browser&quot; button</strong>: needs real TCP sockets, a real persisted file, and real separate OS processes. The transcript below simulates the primary/secondary roles as two real OS threads within one process, for the same build-time-capture reason the signals demo above does &mdash; see <code>self_hosting/examples/build_daemon_demo.patlang</code> for the genuine two-separate-process form you'd actually run yourself.", builddaemon_src, builddaemon_native)
# flowgraph-demo: live in-browser variant (flowgraph_wasm_b64, built
# above) with a paste-your-own-program editor, PLUS the CLI tool's own
# source and native transcript of the curated multi-program set it renders
# by default (still linking to flowgraph.html, which stays as the
# standalone reference page for that curated set -- only the single-
# program live demo moved in-browser, not flowgraph.html itself).
let fgd_sections = [tpl_para("The same control-flow-graph recovery as the <code>flowgraph</code> CLI tool (<code>flowgraph &lt;output.html&gt; [inputs...]</code>, source below), running live: paste a program, press Render, and see basic blocks and jump edges recovered from the self-hosted compiler's own IR &mdash; one SVG per function, no rustc. Red curves are conditional (<code>JumpIfFalse</code>), blue are unconditional. With no arguments the CLI tool instead renders a curated set spanning the benchmark, the contracts demo, the point-of-sale bundle, and the all-paradigms demo: <a href='demos/flowgraph.html'>open that reference page</a>.")]
let fgd_body = sb_new()
sb_push(fgd_body, "<p><textarea id='fg-src' rows='8' style='width:100%;font:0.85rem/1.4 monospace' spellcheck='false'>" + html_escape(read_file("self_hosting/examples/fib_bench.patlang")) + "</textarea></p>" + nl())
sb_push(fgd_body, "<p><button onclick='runFlowgraphDemo()'>Render flow graph</button> <span class='ms' id='ms-flowgraphdemo'></span></p>" + nl())
sb_push(fgd_body, "<div id='fg-out'></div>" + nl())
sb_push(fgd_body, "<pre class='out' id='out-flowgraphdemo' hidden></pre>" + nl())
let fgd_sections = list_push(fgd_sections, tpl_style("svg text { font: 12px monospace; fill: currentColor; } svg .bh { font-weight: bold; }"))
let fgd_sections = list_push(fgd_sections, tpl_raw(sb_str(fgd_body)))
let fgd_sections = list_push(fgd_sections, tpl_raw("<details><summary>PatLang source: flowgraph_main.patlang</summary><pre class='src'>" + html_escape(flow_src) + "</pre></details>"))
let fgd_sections = list_push(fgd_sections, tpl_raw("<p class='label'>Native run of the CLI tool on the build machine (curated multi-program set):</p><pre class='out native'>" + html_escape(flow_native) + "</pre>"))
let fgd_js = sb_new()
sb_push(fgd_js, "const WASMS = { flowgraphdemo: '" + flowgraph_wasm_b64 + "' };" + nl())
wasi_shim_js(fgd_js)
sb_push(fgd_js, "async function runFlowgraphDemo() {" + nl())
sb_push(fgd_js, "  const src = document.getElementById('fg-src').value;" + nl())
sb_push(fgd_js, "  const html = await runWasm('flowgraphdemo', 'flowgraphdemo', [src]);" + nl())
sb_push(fgd_js, "  document.getElementById('fg-out').innerHTML = html;" + nl())
sb_push(fgd_js, "}" + nl())
let fgd_sections = list_push(fgd_sections, tpl_script(sb_str(fgd_js)))
write_file("portfolio/demos/flowgraph-demo.html", render_page(tpl_page("flowgraph: control-flow graphs from the compiler IR", "fragment", fgd_sections)))
print("wrote portfolio/demos/flowgraph-demo.html")
# gui: live in-browser variant, rendered into an iframe (the page it
