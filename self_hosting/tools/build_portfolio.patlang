sb_push(ide_js, "window.addEventListener('DOMContentLoaded', function() { try { const saved = localStorage.getItem('patlang_ide_src'); if (saved) { document.getElementById('ed').value = saved; hlUpdate(); } } catch (e) {} });" + nl())

