sb_push(body, "<pre class='out' id='out-playground'>(not run yet)</pre>" + nl())
sb_push(body, "</div>" + nl())

demo_card(body, "pos", "Point of sale (events + OO + logic)", "A checkout session as a stream of <code>scan</code>/<code>pay</code> events: the product catalog lives in the object store, and a <code>dairy</code> fact drives the discount rule.", pos_src, pos_native)
demo_card(body, "postests", "Test framework: unit, integration, Gherkin", "A PatLang test framework running against the point of sale: unit assertions, event-driven integration checks, and a Gherkin feature whose steps dispatch through <code>apply</code>.", post_src, post_native)
demo_card(body, "contracts", "Design by contract: require / ensure / assert", "<code>require</code> checks a precondition, <code>ensure</code> a postcondition, and <code>assert</code> is the same primitive used standalone &mdash; all three lower to one <code>contract_check</code> host call, enforced identically whether interpreted, run here via WASM (no rustc at all), or compiled natively. The last line deliberately violates a precondition so you can see enforcement fire.", contracts_src, contracts_native)
let manifest_text = read_file("self_hosting/patbuild.manifest")
sb_push(body, "")
native_card(body, "patbuild: a goal-oriented build system", "Driven by a manifest file (<code>self_hosting/patbuild.manifest</code>):<pre class='out'>" + html_escape(manifest_text) + "</pre>Targets are objects, dependencies are walked recursively, finished builds become <code>fact</code>s, progress is reported via events. By default each target is only lowered to IR and checked (no rustc at all, matching the in-browser playground); pass <code>--native</code> to also compile every target to a real executable via rustc &mdash; the transcript below was captured that way.", patbuild_src, patbuild_native)
native_card(body, "flowgraph: control-flow graphs from the compiler IR", "A CLI tool (<code>flowgraph &lt;output.html&gt; [inputs...]</code>) that lowers programs with the self-hosted compiler, recovers basic blocks and jump edges from the IR, and renders them as SVG &mdash; one section per program. With no arguments it renders a curated set spanning the benchmark, the contracts demo, the point-of-sale bundle, and the all-paradigms demo: <a href='flowgraph.html'>open the generated flow graphs</a>.", flow_src, flow_native)

sb_push(body, "<div class='card'>" + nl())
sb_push(body, "<h2>Maze solver: logic + goal-oriented + events</h2>" + nl())
sb_push(body, "<p>A grid compiled into logic-programming <code>fact</code>s, solved by a recursive depth-first search driven by <code>query</code>, announced with <code>goal</code>, and reported through a <code>solved</code>/<code>unsolved</code> event. Four paradigms, one small program: <a href='maze.html'>open the solved maze</a> (" + maze_path.length + " steps).</p>" + nl())
sb_push(body, "</div>" + nl())

sb_push(body, "<div class='card'>" + nl())
sb_push(body, "<h2>IDE</h2>" + nl())
sb_push(body, "<p>A full-page editor around the same in-browser compiler as the playground below, with <b>Tokens</b> and <b>AST</b> views alongside <b>Run</b>, Ctrl+Enter to run, and your code kept in this browser's local storage between visits: <a href='ide.html'>open the IDE</a>.</p>" + nl())
sb_push(body, "</div>" + nl())

sb_push(body, "<div class='card'>" + nl())
sb_push(body, "<h2>Browser GUI generator</h2>" + nl())
sb_push(body, "<p>This program computes data natively and generates an interactive HTML+JS page (the browser as PatLang's cross-platform GUI). It uses <code>write_file</code>, so it runs natively rather than in the sandboxed WASM here.</p>" + nl())
sb_push(body, "<details><summary>PatLang source</summary><pre class='src'>" + html_escape(gui_src) + "</pre></details>" + nl())
sb_push(body, "<p class='label'>Native run on the build machine:</p>" + nl())
sb_push(body, "<pre class='out native'>" + html_escape(gui_native) + "</pre>" + nl())
sb_push(body, "</div>" + nl())

sb_push(body, "<div class='card'>" + nl())
sb_push(body, "<h2>The compiler, measured on itself</h2>" + nl())
sb_push(body, "<p>The self-hosted compiler front+middle end processing its own complete source (" + compiler_src.length + " chars), run under the Stage 0 interpreter while building this page:</p>" + nl())
sb_push(body, "<ul>" + nl())
sb_push(body, "<li>tokenize: " + vec_len(ctoks) + " tokens in " + (m1 - m0) + " ms</li>" + nl())
sb_push(body, "<li>parse: " + cast[1].length + " top-level statements in " + (m2 - m1) + " ms</li>" + nl())
sb_push(body, "<li>lower: " + cir[2].length + " functions in " + (m3 - m2) + " ms</li>" + nl())
sb_push(body, "<li>codegen: " + crs.length + " chars of Rust in " + (m4 - m3) + " ms</li>" + nl())
sb_push(body, "</ul>" + nl())
sb_push(body, "<p>The natively compiled compiler (patc1) runs the same front end roughly two orders of magnitude faster; rustc then dominates end-to-end compile time.</p>" + nl())
sb_push(body, "</div>" + nl())

let js = sb_new()
