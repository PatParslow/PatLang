# Re-wrap flowgraph.exe's output (a full standalone document, produced as
# a side effect above) into a fragment-mode page for the site, without
# changing flowgraph_main.patlang itself -- it stays a general-purpose
# standalone tool. html_page()'s structure (lib/html.patlang) is fixed and
# known: extract everything between "<body>\n" and the following
# "\n<script>" (flowgraph_main.patlang always calls html_page with an
# empty script, so that boundary is unambiguous).
make a function called find_substr takes hay, needle returns idx
  if needle.length == 0 then
    return 0
  end
  let i = 0
  while i <= (hay.length - needle.length) do
    if substr(hay, i, needle.length) == needle then
      return i
    end
    let i = i + 1
  end
  return -1
end

# Removes one `include "path"` line from src, if present. Every demo whose
# source is fed to patc1_compile via a scratch file (portfolio/build/<id>.
# patlang) needs its include lines stripped and replaced by manually
# concatenating the referenced file's own content first -- a relative
# include path that's correct for the file's real location on disk
# resolves to the wrong place once copied to that scratch path. See
# signalsdemo's own comment (first demo to hit this) for the fuller
# rationale; this is the generalized, reusable version of that same
# one-off strip, since builddaemon needs it applied three times (its own
# include of build_daemon.patlang, plus that library's own two includes of
# signals.patlang and includes.patlang).
make a function called strip_include_line takes src, path returns stripped
  let line = "include " + q() + path + q()
  let at = find_substr(src, line)
  if at < 0 then
    return src
  end
  return substr(src, 0, at) + substr(src, at + line.length, src.length - at - line.length)
end

let flow_doc = read_file("portfolio/flowgraph.html")
let flow_start_marker = "<body>" + nl()
let flow_end_marker = nl() + "<script>"
let flow_start = find_substr(flow_doc, flow_start_marker) + flow_start_marker.length
let flow_end = find_substr(flow_doc, flow_end_marker)
let flow_body_html = substr(flow_doc, flow_start, flow_end - flow_start)
# Strip flowgraph_main.patlang's own embedded <h1> -- tpl_page below
# already supplies one from its title argument, matching every other
# fragment page's shape (one h1, from the page title).
let flow_h1 = "<h1>PatLang control-flow graphs</h1>" + nl()
let flow_h1_at = find_substr(flow_body_html, flow_h1)
let flow_body_html_clean = flow_body_html
if flow_h1_at >= 0 then
  let flow_body_html_clean = substr(flow_body_html, 0, flow_h1_at) + substr(flow_body_html, flow_h1_at + flow_h1.length, flow_body_html.length - flow_h1_at - flow_h1.length)
end
write_file("portfolio/demos/flowgraph.html", render_page(tpl_page("PatLang control-flow graphs", "fragment", [tpl_raw(flow_body_html_clean)])))
print("wrote portfolio/demos/flowgraph.html")

