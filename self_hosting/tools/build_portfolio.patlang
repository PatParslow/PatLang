  sb_push(b, "}" + nl())
  sb_push(b, "const KW = new Set(['let','if','then','else','end','while','do','return','make','a','function','called','takes','returns','when','emit','and','or','not','true','false','print']);" + nl())
  sb_push(b, "function hlHtml(src) {" + nl())
  sb_push(b, "  let out = ''; let i = 0;" + nl())
  sb_push(b, "  const esc = function(t) { return t.replace(/&/g, '&amp;').replace(/</g, '&lt;'); };" + nl())
  sb_push(b, "  while (i < src.length) {" + nl())
  sb_push(b, "    const c = src[i];" + nl())
  sb_push(b, "    if (c === '#') { let j = i; while (j < src.length && src.charCodeAt(j) !== 10) j++; out += '<i class=hc>' + esc(src.slice(i, j)) + '</i>'; i = j; continue; }" + nl())
  sb_push(b, "    if (c === String.fromCharCode(34)) { let j = i + 1; while (j < src.length && src[j] !== c) { if (src[j] === String.fromCharCode(92)) j++; j++; } j++; out += '<i class=hs>' + esc(src.slice(i, j)) + '</i>'; i = j; continue; }" + nl())
  sb_push(b, "    if (c >= '0' && c <= '9') { let j = i; while (j < src.length && ((src[j] >= '0' && src[j] <= '9') || src[j] === '.')) j++; out += '<i class=hn>' + src.slice(i, j) + '</i>'; i = j; continue; }" + nl())
  sb_push(b, "    if (/[A-Za-z_]/.test(c)) { let j = i; while (j < src.length && /[A-Za-z0-9_]/.test(src[j])) j++; const w = src.slice(i, j); out += KW.has(w) ? '<i class=hk>' + w + '</i>' : esc(w); i = j; continue; }" + nl())
  sb_push(b, "    out += esc(c); i++;" + nl())
  sb_push(b, "  }" + nl())
  sb_push(b, "  return out + String.fromCharCode(10);" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "function hlUpdate() { document.getElementById('hl').innerHTML = hlHtml(document.getElementById('ed').value); hlSync(); }" + nl())
  sb_push(b, "function hlSync() { const e = document.getElementById('ed'), h = document.getElementById('hl'); h.scrollTop = e.scrollTop; h.scrollLeft = e.scrollLeft; }" + nl())
  sb_push(b, "function srcText(id) { return document.getElementById('src-' + id).textContent; }" + nl())
  sb_push(b, "function runCard(id) { return runWasm(id, 'playground', [srcText(id)]); }" + nl())
  sb_push(b, "function runPlayground() { return runWasm('playground', 'playground', [document.getElementById('ed').value]); }" + nl())
  sb_push(b, "function loadExample() { const id = document.getElementById('exsel').value; document.getElementById('ed').value = srcText(id); hlUpdate(); }" + nl())
  sb_push(b, "window.addEventListener('DOMContentLoaded', hlUpdate);" + nl())
  return true
end

make a function called wasi_threads_worker_js takes b returns done
  sb_push(b, "// Generic WASI-threads worker: handles either the program's own entrypoint" + nl())
  sb_push(b, "// (_start) or a fiber-spawned thread (wasi_thread_start), both against the" + nl())
  sb_push(b, "// same shared module + shared memory." + nl())
  sb_push(b, "//" + nl())
  sb_push(b, "// Key ordering constraint discovered empirically: `thread-spawn` gets called" + nl())
  sb_push(b, "// SYNCHRONOUSLY from inside a running WASM call stack, and the calling" + nl())
  sb_push(b, "// thread immediately blocks afterward via Condvar::wait() (a native" + nl())
  sb_push(b, "// memory.atomic.wait32 instruction) once it hands back the new tid. A" + nl())
  sb_push(b, "// worker constructed *at that point* (new Worker() issued from inside the" + nl())
  sb_push(b, "// still-executing host import call) never finishes booting -- its startup" + nl())
  sb_push(b, "// appears to need the spawning agent to reach an actual JS event-loop turn," + nl())
  sb_push(b, "// which never happens once parked in a blocking atomic wait." + nl())
  sb_push(b, "//" + nl())
  sb_push(b, "// This isn't just an ordering nuance to work around opportunistically: a" + nl())
  sb_push(b, "// WASM program's execution is ONE continuous synchronous call from" + nl())
  sb_push(b, "// _start() to completion. The only points where the calling worker's" + nl())
  sb_push(b, "// thread stops running WASM are real blocking waits (Atomics.wait," + nl())
  sb_push(b, "// compiled from Condvar::wait()) -- and Atomics.wait does NOT drain the" + nl())
  sb_push(b, "// microtask queue while parked, it's a genuine OS-level thread freeze. So" + nl())
  sb_push(b, "// a burst of thread-spawn calls with no intervening blocking wait (e.g." + nl())
  sb_push(b, "// several fiber_new() calls in a row before any fiber_resume()) gives" + nl())
  sb_push(b, "// async pool replenishment zero opportunity to run: the pool can only ever" + nl())
  sb_push(b, "// contain what was pre-warmed *before* _start() began. Verified directly:" + nl())
  sb_push(b, "// a 20-fiber creation burst against a small pool that tried to grow" + nl())
  sb_push(b, "// on-demand exhausted the pool by fiber #5 and the synchronous fallback" + nl())
  sb_push(b, "// spawns for the rest never finished booting in time (same deadlock class" + nl())
  sb_push(b, "// as the original problem, just delayed) -- because the owning worker was" + nl())
  sb_push(b, "// itself about to block, or already had, with no event-loop turn free for" + nl())
  sb_push(b, "// the fallback workers' boot handshake to complete." + nl())
  sb_push(b, "//" + nl())
  sb_push(b, "// So the real, honest design: pre-warm a generous fixed ceiling BEFORE" + nl())
  sb_push(b, "// _start() runs (below), sized to comfortably cover realistic PatLang" + nl())
  sb_push(b, "// fiber/budgeted usage. Async replenishment (maintainPool, still present" + nl())
  sb_push(b, "// below) then keeps topping back up toward that ceiling as workers are" + nl())
  sb_push(b, "// consumed -- genuinely useful for a long-running program with many" + nl())
  sb_push(b, "// sequential (not all-at-once) fiber operations, since each consumed slot" + nl())
  sb_push(b, "// gets a chance to refill during the *next* blocking wait's aftermath, not" + nl())
  sb_push(b, "// useful for surviving a single burst bigger than the ceiling itself." + nl())
  sb_push(b, "const POOL_CEILING = 64;" + nl())
  sb_push(b, "let mem = null;" + nl())
  sb_push(b, "let tidCounter = null;" + nl())
  sb_push(b, "let pool = [];" + nl())
  sb_push(b, "let refilling = false;" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "function spawnIdleWorker() {" + nl())
  sb_push(b, "  return new Promise((resolve) => {" + nl())
  sb_push(b, "    const w = new Worker(self.location.href);" + nl())
  sb_push(b, "    w.onmessage = (e) => {" + nl())
  sb_push(b, "      if (e.data === 'ready') { resolve(w); return; }" + nl())
  sb_push(b, "      // A job-result message from a worker that was handed a job earlier." + nl())
  sb_push(b, "      self.postMessage(e.data);" + nl())
  sb_push(b, "    };" + nl())
  sb_push(b, "    w.onerror = (e) => self.postMessage({ ok: false, error: '[pool worker error] ' + e.message, type: 'thread' });" + nl())
  sb_push(b, "    w.postMessage({ type: 'init' });" + nl())
  sb_push(b, "  });" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "async function fillPool(n) {" + nl())
  sb_push(b, "  const spawned = await Promise.all(Array.from({ length: n }, spawnIdleWorker));" + nl())
  sb_push(b, "  pool.push(...spawned);" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "// Fire-and-forget: top the pool back up toward POOL_CEILING as consumed" + nl())
  sb_push(b, "// slots free up between blocking waits. Can't help a single burst bigger" + nl())
  sb_push(b, "// than the ceiling (see the note above `POOL_CEILING`), but does mean a" + nl())
  sb_push(b, "// long-running program recovers its full pre-warmed headroom between" + nl())
  sb_push(b, "// separate fiber operations rather than only ever getting it once." + nl())
  sb_push(b, "function maintainPool() {" + nl())
  sb_push(b, "  if (refilling) return;" + nl())
  sb_push(b, "  const need = POOL_CEILING - pool.length;" + nl())
  sb_push(b, "  if (need <= 0) return;" + nl())
  sb_push(b, "  refilling = true;" + nl())
  sb_push(b, "  fillPool(need).finally(() => { refilling = false; });" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "function makeImports(moduleForRespawn) {" + nl())
  sb_push(b, "  let stdout = '';" + nl())
  sb_push(b, "  const dec = new TextDecoder();" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "  const wasi_snapshot_preview1 = {" + nl())
  sb_push(b, "    fd_write(fd, iovs, len, nw) {" + nl())
  sb_push(b, "      const dv = new DataView(mem.buffer);" + nl())
  sb_push(b, "      let w = 0;" + nl())
  sb_push(b, "      for (let i = 0; i < len; i++) {" + nl())
  sb_push(b, "        const p = iovs + 8 * i;" + nl())
  sb_push(b, "        const ptr = dv.getUint32(p, true), l = dv.getUint32(p + 4, true);" + nl())
  sb_push(b, "        // TextDecoder, like crypto.getRandomValues, refuses a view backed" + nl())
  sb_push(b, "        // by SharedArrayBuffer -- copy to a plain buffer first." + nl())
  sb_push(b, "        stdout += dec.decode(new Uint8Array(mem.buffer, ptr, l).slice());" + nl())
  sb_push(b, "        w += l;" + nl())
  sb_push(b, "      }" + nl())
  sb_push(b, "      dv.setUint32(nw, w, true);" + nl())
  sb_push(b, "      return 0;" + nl())
  sb_push(b, "    }," + nl())
  sb_push(b, "    random_get(p, l) {" + nl())
  sb_push(b, "      // crypto.getRandomValues refuses a view backed by SharedArrayBuffer;" + nl())
  sb_push(b, "      // fill a plain scratch buffer and copy it in instead." + nl())
  sb_push(b, "      const tmp = new Uint8Array(l);" + nl())
  sb_push(b, "      crypto.getRandomValues(tmp);" + nl())
  sb_push(b, "      new Uint8Array(mem.buffer, p, l).set(tmp);" + nl())
  sb_push(b, "      return 0;" + nl())
  sb_push(b, "    }," + nl())
  sb_push(b, "    clock_time_get(cid, prec, tp) {" + nl())
  sb_push(b, "      const dv = new DataView(mem.buffer);" + nl())
  sb_push(b, "      const ns = BigInt(Math.round((performance.timeOrigin + performance.now()) * 1e6));" + nl())
  sb_push(b, "      dv.setBigUint64(tp, ns, true);" + nl())
  sb_push(b, "      return 0;" + nl())
  sb_push(b, "    }," + nl())
  sb_push(b, "    args_sizes_get(pc, ps) { const dv = new DataView(mem.buffer); dv.setUint32(pc, 0, true); dv.setUint32(ps, 0, true); return 0; }," + nl())
  sb_push(b, "    args_get() { return 0; }," + nl())
  sb_push(b, "    environ_sizes_get(pc, ps) { const dv = new DataView(mem.buffer); dv.setUint32(pc, 0, true); dv.setUint32(ps, 0, true); return 0; }," + nl())
  sb_push(b, "    environ_get() { return 0; }," + nl())
  sb_push(b, "    proc_exit(c) { const e = new Error('exit'); e.exitCode = c; throw e; }," + nl())
  sb_push(b, "    fd_close() { return 0; }, fd_fdstat_get() { return 0; }, fd_seek() { return 70; }," + nl())
  sb_push(b, "    fd_read() { return 8; }, fd_prestat_get() { return 8; }, fd_prestat_dir_name() { return 8; }," + nl())
  sb_push(b, "    path_open() { return 76; }, sched_yield() { return 0; }, poll_oneoff() { return 52; }," + nl())
  sb_push(b, "  };" + nl())
  sb_push(b, "  const wasiNs = new Proxy(wasi_snapshot_preview1, { get(t, k) { return k in t ? t[k] : (() => 58); } });" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "  const wasi = {" + nl())
  sb_push(b, "    'thread-spawn': (startArg) => {" + nl())
  sb_push(b, "      const tid = Atomics.add(tidCounter, 0, 1);" + nl())
  sb_push(b, "      const w = pool.shift();" + nl())
  sb_push(b, "      if (!w) {" + nl())
  sb_push(b, "        // Pool exhausted -- best-effort synchronous spawn (may deadlock if" + nl())
  sb_push(b, "        // this thread also blocks right after; the pool should be sized" + nl())
  sb_push(b, "        // generously enough in practice that this path isn't hit)." + nl())
  sb_push(b, "        console.log('[thread-worker] pool exhausted, spawning synchronously for tid=' + tid);" + nl())
  sb_push(b, "        const w2 = new Worker(self.location.href);" + nl())
  sb_push(b, "        w2.onmessage = (e) => { if (e.data !== 'ready') self.postMessage(e.data); };" + nl())
  sb_push(b, "        w2.postMessage({ type: 'thread', module: moduleForRespawn, memory: mem, tidCounter, tid, startArg });" + nl())
  sb_push(b, "        return tid;" + nl())
  sb_push(b, "      }" + nl())
  sb_push(b, "      w.onmessage = (e) => self.postMessage(e.data);" + nl())
  sb_push(b, "      w.postMessage({ type: 'thread', module: moduleForRespawn, memory: mem, tidCounter, tid, startArg });" + nl())
  sb_push(b, "      // Replenish asynchronously (and grow the target if demand is" + nl())
  sb_push(b, "      // outpacing it) so later thread-spawn calls still have a ready" + nl())
  sb_push(b, "      // worker even though this one won't help the current call." + nl())
  sb_push(b, "      maintainPool();" + nl())
  sb_push(b, "      return tid;" + nl())
  sb_push(b, "    }," + nl())
  sb_push(b, "  };" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "  return { env: { memory: mem }, wasi_snapshot_preview1: wasiNs, wasi, getStdout: () => stdout };" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "self.onmessage = async (e) => {" + nl())
  sb_push(b, "  const msg = e.data;" + nl())
  sb_push(b, "  if (msg.type === 'init') {" + nl())
  sb_push(b, "    // This worker is being prepared as an idle pool member -- just report" + nl())
  sb_push(b, "    // ready and wait for a real job." + nl())
  sb_push(b, "    self.postMessage('ready');" + nl())
  sb_push(b, "    return;" + nl())
  sb_push(b, "  }" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "  mem = msg.memory;" + nl())
  sb_push(b, "  tidCounter = msg.tidCounter;" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "  if (msg.type === 'start') {" + nl())
  sb_push(b, "    await fillPool(POOL_CEILING);" + nl())
  sb_push(b, "  }" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "  const imports = makeImports(msg.module);" + nl())
  sb_push(b, "  const { env, wasi_snapshot_preview1, wasi } = imports;" + nl())
  sb_push(b, "" + nl())
  sb_push(b, "  try {" + nl())
  sb_push(b, "    const instance = await WebAssembly.instantiate(msg.module, { env, wasi_snapshot_preview1, wasi });" + nl())
  sb_push(b, "    try {" + nl())
  sb_push(b, "      if (msg.type === 'start') {" + nl())
  sb_push(b, "        instance.exports._start();" + nl())
  sb_push(b, "      } else {" + nl())
  sb_push(b, "        instance.exports.wasi_thread_start(msg.tid, msg.startArg);" + nl())
  sb_push(b, "      }" + nl())
  sb_push(b, "      self.postMessage({ ok: true, stdout: imports.getStdout(), type: msg.type, tid: msg.tid });" + nl())
  sb_push(b, "    } catch (err) {" + nl())
  sb_push(b, "      const exitCode = (err && typeof err.exitCode === 'number') ? err.exitCode : null;" + nl())
  sb_push(b, "      self.postMessage({ ok: exitCode === 0, stdout: imports.getStdout(), type: msg.type, tid: msg.tid, error: exitCode === null ? String(err) : null });" + nl())
  sb_push(b, "    }" + nl())
  sb_push(b, "  } catch (err) {" + nl())
  sb_push(b, "    self.postMessage({ ok: false, stdout: " + q() + q() + ", type: msg.type, tid: msg.tid, error: " + q() + "instantiate failed: " + q() + " + err });" + nl())
  sb_push(b, "  }" + nl())
  sb_push(b, "};" + nl())
  return true
end


# Real WASI-threads support: a hand-rolled implementation of the WASI
# threads proposal ABI (env::memory shared import, wasi::thread-spawn
# import, wasi_thread_start export) -- no wasm-bindgen, matching this
# project's existing from-scratch WASI shim philosophy. Spike-verified
# (standalone, headless-browser, single-fiber and 20-fiber-burst cases)
# before folding in here; see wasi_threads_worker_js below for the pool
# design and the hard constraint it exists to work around. Requires
# Cross-Origin-Opener-Policy/Cross-Origin-Embedder-Policy response headers
# (crossOriginIsolated) to unlock SharedArrayBuffer -- callers must check
# self.crossOriginIsolated before offering a threaded run button.
make a function called wasi_threads_worker_tag returns html
  # The pool-based WASI-threads worker script, embedded as a *non-executing*
  # <script type="text/plain"> tag rather than inlined into the page's own
  # executing script -- it must run isolated inside real Worker instances
  # (its own `self` is a WorkerGlobalScope, not the page's window), not as
  # top-level statements in the main script's scope. <script> is a raw-text
  # HTML element regardless of its type attribute, so this is embedded
  # verbatim, unescaped -- entities do NOT get decoded inside it either.
  let tw = sb_new()
  wasi_threads_worker_js(tw)
  return "<script type=" + q() + "text/plain" + q() + " id=" + q() + "thread-worker-src" + q() + ">" + sb_str(tw) + "</script>"
end

make a function called wasi_threads_shim_js takes b returns done
  sb_push(b, "let THREAD_WORKER_URL = null;" + nl())
  sb_push(b, "function threadWorkerUrl() {" + nl())
  sb_push(b, "  if (!THREAD_WORKER_URL) {" + nl())
  sb_push(b, "    THREAD_WORKER_URL = URL.createObjectURL(new Blob([document.getElementById('thread-worker-src').textContent], { type: " + q() + "application/javascript" + q() + " }));" + nl())
  sb_push(b, "  }" + nl())
  sb_push(b, "  return THREAD_WORKER_URL;" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "async function runWasmThreaded(outId, wasmId) {" + nl())
  sb_push(b, "  const out = document.getElementById(" + q() + "out-" + q() + " + outId);" + nl())
  sb_push(b, "  if (!self.crossOriginIsolated) {" + nl())
  sb_push(b, "    if (out) out.textContent = " + q() + "requires cross-origin isolation (COOP/COEP headers) -- not available on this page load" + q() + ";" + nl())
  sb_push(b, "    return;" + nl())
  sb_push(b, "  }" + nl())
  sb_push(b, "  if (out) out.textContent = " + q() + "running (real OS threads via WASI threads proposal)..." + q() + ";" + nl())
  sb_push(b, "  const t0 = performance.now();" + nl())
  sb_push(b, "  try {" + nl())
  sb_push(b, "    const module = await WebAssembly.compile(b64bytes(WASMS[wasmId]));" + nl())
  sb_push(b, "    const memory = new WebAssembly.Memory({ initial: 64, maximum: 2048, shared: true });" + nl())
  sb_push(b, "    const tidCounter = new Int32Array(new SharedArrayBuffer(4));" + nl())
  sb_push(b, "    tidCounter[0] = 1;" + nl())
  sb_push(b, "    const mainWorker = new Worker(threadWorkerUrl());" + nl())
  sb_push(b, "    const result = await new Promise((resolve, reject) => {" + nl())
  sb_push(b, "      mainWorker.onmessage = (e) => resolve(e.data);" + nl())
  sb_push(b, "      mainWorker.onerror = (e) => reject(new Error(e.message));" + nl())
  sb_push(b, "      mainWorker.postMessage({ type: " + q() + "start" + q() + ", module, memory, tidCounter });" + nl())
  sb_push(b, "    });" + nl())
  sb_push(b, "    const ms = (performance.now() - t0).toFixed(1);" + nl())
  sb_push(b, "    if (out) out.textContent = result.stdout + (result.ok ? " + q() + "" + q() + " : " + q() + " [error: " + q() + " + result.error + " + q() + "]" + q() + ");" + nl())
  sb_push(b, "    const msEl = document.getElementById(" + q() + "ms-" + q() + " + outId);" + nl())
  sb_push(b, "    if (msEl) msEl.textContent = ms + " + q() + " ms wall (compile+run, real OS threads, this browser)" + q() + ";" + nl())
  sb_push(b, "  } catch (e) {" + nl())
  sb_push(b, "    if (out) out.textContent = " + q() + "error: " + q() + " + e;" + nl())
  sb_push(b, "  }" + nl())
  sb_push(b, "}" + nl())
  return true
end

