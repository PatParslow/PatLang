# =============================================================================
# Portfolio builder: generates portfolio/index.html — a self-contained page
# showing PatLang example sources, running them IN THE BROWSER (compiled to
# wasm32-wasip1, embedded as base64, executed via an inline WASI shim), with
# self-reported timings compared against native transcripts captured at
# build time. The builder itself is PatLang, using the self-hosted compiler.
#
# Run from the repo root (requires rustup target add wasm32-wasip1):
#   rust-runtime/target/release/pat --ir-run self_hosting/tools/build_portfolio.patlang
# Then open portfolio/index.html in a browser.
# =============================================================================

include "../lib/lexer.patlang"
include "../lib/parser.patlang"
include "../lib/lower.patlang"
include "../lib/codegen.patlang"
include "../lib/runtime_rs.patlang"
include "../lib/html.patlang"
include "../lib/maze.patlang"
include "../lib/template.patlang"
include "../lib/json.patlang"
include "../lib/reflect.patlang"
include "../lib/transpile_ruby.patlang"

# Every demo is compiled by the self-hosted compiler's own COMPILED binary
# (patc1.exe), not the native Rust codegen.rs pipeline (pat --patc) and not
# even the self-hosted compiler's own SOURCE re-interpreted per build (what
# this script used to do, via the included lexer/parser/lower/codegen/
# runtime_rs libs directly) -- patc1.exe runs the identical self-hosted
# logic, just already compiled, which the compiler-self-metrics card's own
# numbers say is roughly two orders of magnitude faster for the front-end
# stage. rustc is still the unavoidable final native-codegen backend patc1
# itself shells out to -- see CLAUDE.md for the fuller convention.
print("ensuring patc1.exe is up to date...")
exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/build_patc1.patlang")

# Build cache: skip recompiling a demo whose source hasn't changed since the
# last build. The cache key covers the demo's own source PLUS a fingerprint
# of only the compiler pieces this demo could plausibly be affected by --
# NOT one blanket hash of the whole compiler pipeline. The old scheme (hash
# of lexer+parser+lower+codegen+runtime_rs concatenated) meant ANY compiler
# change, anywhere, invalidated EVERY cached demo -- e.g. a Logic-chunk-only
# change (rule_add/solve) forcing a full recompile of the CGA classifier,
# which never calls fact/query/goal/rule_add and takes ~30+ minutes to
# recompile through the self-hosted pipeline for no reason.
#
# Front-end changes (lexer/parser/lowering) are still treated as universal --
# shared infrastructure every program goes through, and attributing precise
# per-construct impact there would need real dataflow analysis, not worth it.
# But runtime_rs.patlang/codegen.rs's per-chunk PRELUDE_* text (see
# self_hosting/lib/codegen.patlang's host_chunk_of for the canonical
# name->chunk table) only gets folded into a demo's fingerprint if that
# demo's own source actually looks like it uses that chunk.
#
# Detection is a plain substring scan over the demo's raw source for the
# SOURCE-LEVEL syntax each chunk owns (keywords/call names as a demo author
# actually types them -- contracts in particular are written as `require`/
# `ensure`/`assert`, never a literal call to the `contract_check` host
# function they lower to, so the marker has to be the keyword, not the
# runtime name). Deliberately coarse and biased toward over-inclusion,
# mirroring codegen.rs's required_chunks' own documented "conservative, not
# proven" stance for numeric_tower: a false-positive marker match just costs
# one unnecessary rebuild, never a stale one, so ambiguity always resolves
# in favor of including a chunk. "core"/"numeric_tower"/"math" are treated as
# unconditional -- virtually every real demo touches arithmetic or a list/
# string op, not worth the detection cost.
#
# Hand-maintained and parallel to codegen.patlang's host_chunk_of table --
# if that table gains a new host function, add its source-level spelling
# here too (same discipline as .claude/skills/mirror-check, just for cache
# hit-rate correctness rather than compiled-output correctness: getting this
# wrong only costs an extra rebuild, it can never serve a stale artifact,
# since the underlying src+frontend hash still gates everything).
let FRONTEND_FINGERPRINT = read_file("self_hosting/lib/lexer.patlang") + read_file("self_hosting/lib/parser.patlang") + read_file("self_hosting/lib/lower.patlang") + read_file("self_hosting/lib/codegen.patlang")

let CHUNK_MARKERS = [
  ["strings_ext", ["char_code(", "substr(", "chr(", "to_num(", "hash_string("]],
  ["collections_handles", ["vec_new(", "vec_push(", "vec_set(", "vec_get(", "vec_len(", "vec_to_list(", "str_intern(", "sc_len(", "sc_code(", "sc_char(", "sb_new(", "sb_push(", "sb_str("]],
  ["files", ["read_file(", "write_file(", "touch_file(", "file_exists(", "list_dir(", "rename_file("]],
  ["io_misc", ["now_ms(", "byte_length(", "read_line(", "argv(", "print("]],
  ["oo", ["make a class", "new(", "set_var(", "send("]],
  ["logic", ["fact(", "goal(", "query(", "rule_add(", "solve(", "action_add(", "plan(", "rule ", ":-"]],
  ["contracts", ["require ", "ensure ", "assert "]],
  ["networking", ["tcp_listen(", "tcp_connect(", "tcp_accept(", "tcp_read(", "tcp_write(", "tcp_close(", "sleep_ms("]],
  ["codegen_bootstrap", ["exec_capture(", "compile_shape(", "compile_ir(", "run_ir(", "rustc_build(", "codegen_prelude("]]
]

make a function called str_contains takes haystack, needle returns found
  let hlen = len(haystack)
  let nlen = len(needle)
  if nlen == 0 then
    return true
  end
  if nlen > hlen then
    return false
  end
  let limit = hlen - nlen
  let i = 0
  let found = false
  while i <= limit do
    if found == false then
      if substr(haystack, i, nlen) == needle then
        let found = true
      end
    end
    let i = i + 1
  end
  return found
end

make a function called required_chunk_names takes src returns names
  let names = ["core", "numeric_tower", "math"]
  let ci = 0
  while ci < CHUNK_MARKERS.length do
    let entry = CHUNK_MARKERS[ci]
    let chunk = entry[0]
    let markers = entry[1]
    let mi = 0
    let hit = false
    while mi < markers.length do
      if hit == false then
        if str_contains(src, markers[mi]) then
          let hit = true
        end
      end
      let mi = mi + 1
    end
    if hit then
      if list_contains(names, chunk) == false then
        let names = list_push(names, chunk)
      end
    end
    let ci = ci + 1
  end
  return names
end

make a function called chunk_fingerprint takes names returns fp
  let fp = ""
  let i = 0
  while i < names.length do
    let fp = fp + codegen_prelude_chunk(names[i])
    let i = i + 1
  end
  return fp
end

make a function called cache_key takes src returns key
  let chunks = required_chunk_names(src)
  return hash_string(src + FRONTEND_FINGERPRINT + chunk_fingerprint(chunks))
end

make a function called cache_valid takes id, src returns valid
  let hashfile = "portfolio/build/" + id + ".srchash"
  if file_exists(hashfile) == "1" then
    return read_file(hashfile) == cache_key(src)
  end
  return false
end

make a function called save_cache takes id, src returns done
  write_file("portfolio/build/" + id + ".srchash", cache_key(src))
  return true
end

# Writes src to a scratch .patlang file and shells out to patc1.exe.
# "./patc1.exe", not bare "patc1.exe": Windows' CreateProcess excludes the
# current directory from its search for a bare filename with no path
# separator (SafeProcessSearchMode) -- silently fails with a misleading
# "program not found" even though the file is right there and
# file_exists("patc1.exe") returns true. This was dormant/hidden by the
# per-demo build cache until the first genuinely-uncached demo exercised
# it for real.
make a function called patc1_compile takes src, id, out_path, target returns done
  let scratch = "portfolio/build/" + id + ".patlang"
  write_file(scratch, src)
  if target == "" then
    exec_capture("./patc1.exe", scratch, out_path)
  else
    exec_capture("./patc1.exe", scratch, out_path, target)
  end
  return true
end

# The native and wasm targets for one demo are fully independent compiles
# (same source, different out_path/target passed to patc1_compile, which
# shells out to a fresh ./patc1.exe subprocess each time) -- so they run
# concurrently via parallel_map's real OS threads instead of back-to-back,
# roughly halving this demo's wall-clock compile time whenever both targets
# are actually stale. "playground" (the shared WASM module behind every
# demo_page's "run in this browser" button) is by far the biggest user of
# compile_both, so this is where it matters most. Both threads write the
# SAME scratch file (portfolio/build/<id>.patlang, identical content) --
# harmless: it's the same bytes either way, and each thread only reads
# ./patc1.exe's own out_path afterward, never the scratch file.
make a function called compile_both_target takes job returns done
  let src = job[0]
  let id = job[1]
  let out_path = job[2]
  let target = job[3]
  patc1_compile(src, id, out_path, target)
  return true
end

make a function called compile_both takes src, id returns wasmb64
  let wasm_path = "portfolio/build/" + id + ".wasm"
  let exe_path = "portfolio/build/" + id + ".exe"
  if cache_valid(id, src) and (file_exists(wasm_path) == "1") and (file_exists(exe_path) == "1") then
    print("[cache] " + id + " unchanged, skipping rebuild")
    return read_file_b64(wasm_path)
  end
  let jobs = [[src, id, exe_path, ""], [src, id, wasm_path, "wasm32-wasip1"]]
  parallel_map(jobs, "compile_both_target")
  save_cache(id, src)
  return read_file_b64(wasm_path)
end

make a function called compile_wasm_only takes src, id returns wasmb64
  let wasm_path = "portfolio/build/" + id + ".wasm"
  if cache_valid(id, src) and (file_exists(wasm_path) == "1") then
    print("[cache] " + id + " unchanged, skipping rebuild")
    return read_file_b64(wasm_path)
  end
  patc1_compile(src, id, wasm_path, "wasm32-wasip1")
  save_cache(id, src)
  return read_file_b64(wasm_path)
end

make a function called compile_wasm_threaded_only takes src, id returns wasmb64
  # Same shape as compile_wasm_only, but targets wasm32-wasip1-threads (real
  # OS-thread-backed fibers/budgeted(...), via patc1.exe -> rustc_build's
  # nightly+atomics+shared-memory flags for that one target string) instead
  # of the ordinary non-threaded wasm32-wasip1 target. Opt-in per demo page
  # rather than the default, since it needs a nightly toolchain and the
  # WASI-threads JS shim (wasi_shim_js) to actually run in a browser.
  let wasm_path = "portfolio/build/" + id + "_threaded.wasm"
  if cache_valid(id, src) and (file_exists(wasm_path) == "1") then
    print("[cache] " + id + " (threaded) unchanged, skipping rebuild")
    return read_file_b64(wasm_path)
  end
  patc1_compile(src, id, wasm_path, "wasm32-wasip1-threads")
  save_cache(id, src)
  return read_file_b64(wasm_path)
end

make a function called compile_native takes src, id returns exe
  let exe_path = "portfolio/build/" + id + ".exe"
  if cache_valid(id, src) and (file_exists(exe_path) == "1") then
    print("[cache] " + id + " unchanged, skipping rebuild")
    return exe_path
  end
  patc1_compile(src, id, exe_path, "")
  save_cache(id, src)
  return exe_path
end

make a function called out_path_for takes id, target returns path
  if target == "wasm32-wasip1" then
    return "portfolio/build/" + id + ".wasm"
  end
  if target == "wasm32-wasip1-threads" then
    return "portfolio/build/" + id + "_threaded.wasm"
  end
  return "portfolio/build/" + id + ".exe"
end

# Cross-demo parallel pre-compile pass: every compile below this point
# (compile_native/compile_wasm_only/compile_both/compile_wasm_threaded_only)
# funnels through cache_valid + patc1_compile, and each patc1_compile call
# is a fully independent subprocess (own scratch file keyed by id, own
# out_path) -- so the actual stale-vs-cached compiles across ALL demos can
# be dispatched together via parallel_map's real OS threads, instead of
# happening one at a time as the script reaches each demo sequentially.
# This block duplicates each demo's small src-assembly expression (mostly
# one or two read_file/concat lines) rather than restructuring the ~1500
# lines of per-demo page-building logic below -- deliberately: those blocks
# stay exactly as they are today (still calling compile_native/etc in their
# usual place), and will simply hit a warm cache by the time they run,
# since this pass already did the real work. Duplication risk: if a demo's
# src-assembly expression changes below, the copy here needs updating too,
# or that demo silently won't get the parallel-precompile benefit (it will
# still compile correctly, just back on the sequential path) -- not a
# correctness risk, only a missed optimization, so this is a lower-stakes
# drift than the CHUNK_MARKERS table above.
# Each in-flight job is tracked as a real OO object (new/send/get,
# ChunkId::Oo) rather than a plain value or hand-kept counter -- id/target/
# status/timestamps live on the object, readable by anything (a `when`
# handler, a future `status` signal handler) without threading extra
# parameters through. Safe to mutate from inside a parallel_map worker
# thread specifically because OBJECTS was moved off thread_local onto a
# shared Mutex-backed store this session (see hosts.rs/codegen.rs) -- before
# that fix, each worker thread would have seen its own empty, isolated
# object store, and every send/get here would have silently gone nowhere.
make a function called precompile_job takes job returns done
  let src = job[0]
  let id = job[1]
  let target = job[2]
  let job_name = new("job", id + ":" + target)
  send(job_name, "set", "id", id)
  send(job_name, "set", "target", target)
  send(job_name, "set", "status", "compiling")
  send(job_name, "set", "started_at", now_ms())
  emit("job_started", job_name)
  patc1_compile(src, id, out_path_for(id, target), target)
  # Without this, the artifact exists on disk but its .srchash file doesn't
  # get written, so the ordinary sequential compile_native/etc call further
  # down the script would see cache_valid == false and recompile it AGAIN,
  # silently defeating the whole point of this pass. save_cache is a plain
  # single-file write, safe to call twice for the same id (e.g. playground,
  # which has two targets/two jobs) -- both writes are identical content.
  save_cache(id, src)
  send(job_name, "set", "status", "done")
  send(job_name, "set", "finished_at", now_ms())
  emit("job_finished", job_name)
  return true
end

# Live terminal progress, driven by the real `when`/`emit` event mechanism
# (not a bolted-on print statement) -- already thread-safe across
# parallel_map workers as of earlier this session (EVENT_HANDLERS is a
# shared Mutex-backed registry, not thread_local, for exactly this reason).
# Counters live in the shared __vars object (set_var/get), the same
# mechanism self_hosting/examples/event_loop_server.patlang uses for its
# own cross-handler state. Concurrent print() calls from multiple OS
# threads may interleave at the line level -- acceptable for terminal
# output, not a correctness issue.
when job_started do
  set_var("running", get("__vars", "running") + 1)
  let id = get(event_data, "id")
  let target = get(event_data, "target")
  let label = id
  if target != "" then
    let label = id + " (" + target + ")"
  end
  print("[precompile] " + label + " starting (" + get("__vars", "running") + " running, " + get("__vars", "done") + "/" + get("__vars", "total") + " done)")
end

when job_finished do
  set_var("running", get("__vars", "running") - 1)
  set_var("done", get("__vars", "done") + 1)
  let id = get(event_data, "id")
  let target = get(event_data, "target")
  let label = id
  if target != "" then
    let label = id + " (" + target + ")"
  end
  print("[precompile] " + label + " done (" + get("__vars", "running") + " running, " + get("__vars", "done") + "/" + get("__vars", "total") + " done)")
end

make a function called add_job takes jobs, id, src, target returns jobs2
  let out_path = out_path_for(id, target)
  if cache_valid(id, src) and (file_exists(out_path) == "1") then
    return jobs
  end
  return list_push(jobs, [src, id, target])
end

make a function called build_precompile_jobs returns jobs
  let jobs = []
  let jobs = add_job(jobs, "feature", read_file("self_hosting/examples/feature_demo.patlang"), "")
  let jobs = add_job(jobs, "bench", read_file("self_hosting/examples/fib_bench.patlang"), "")
  let gui_src = read_file("self_hosting/lib/html.patlang") + chr(10) + read_file("self_hosting/examples/gui_demo.patlang")
  let jobs = add_job(jobs, "gui", gui_src, "")
  let gui_wasm_src = read_file("self_hosting/lib/html.patlang") + chr(10) + read_file("self_hosting/examples/gui_wasm_main.patlang")
  let jobs = add_job(jobs, "guidemo", gui_wasm_src, "wasm32-wasip1")
  let pos_src = read_file("self_hosting/lib/pos.patlang") + chr(10) + read_file("self_hosting/examples/pos_demo.patlang")
  let jobs = add_job(jobs, "pos", pos_src, "")
  let post_src = read_file("self_hosting/lib/test.patlang") + chr(10) + read_file("self_hosting/lib/pos.patlang") + chr(10) + read_file("self_hosting/examples/pos_tests.patlang")
  let jobs = add_job(jobs, "postests", post_src, "")
  let jobs = add_job(jobs, "contracts", read_file("self_hosting/examples/contracts_demo.patlang"), "")
  let jobs = add_job(jobs, "goaloriented", read_file("self_hosting/examples/goal_oriented_build_demo.patlang"), "")
  let jobs = add_job(jobs, "bitwise", read_file("self_hosting/examples/bitwise_bitfield_demo.patlang"), "")
  let jobs = add_job(jobs, "rulesyntax", read_file("self_hosting/examples/rule_syntax_demo.patlang"), "")
  let jobs = add_job(jobs, "vfsdemo", read_file("self_hosting/examples/vfs_demo.patlang"), "")

  # signalsdemo: strip the demo's own include line before concatenating
  # (same reason as the real compile site below -- a relative include path
  # doesn't survive being copied to a scratch build path).
  let sig_demo_raw = read_file("self_hosting/examples/signals_demo_transcript.patlang")
  let sig_include_line = "include " + q() + "../lib/signals.patlang" + q()
  let sig_include_at = find_substr(sig_demo_raw, sig_include_line)
  let sig_demo_body = sig_demo_raw
  if sig_include_at >= 0 then
    let sig_demo_body = substr(sig_demo_raw, 0, sig_include_at) + substr(sig_demo_raw, sig_include_at + sig_include_line.length, sig_demo_raw.length - sig_include_at - sig_include_line.length)
  end
  let jobs = add_job(jobs, "signalsdemo", read_file("self_hosting/lib/signals.patlang") + chr(10) + sig_demo_body, "")

  # builddaemon: strip three include lines (its own include of
  # build_daemon.patlang, plus that library's own includes of
  # signals.patlang and includes.patlang) before concatenating all four
  # files' real content in dependency order.
  let bd_demo_body = strip_include_line(read_file("self_hosting/examples/build_daemon_demo_transcript.patlang"), "../lib/build_daemon.patlang")
  let bd_lib_body = strip_include_line(strip_include_line(read_file("self_hosting/lib/build_daemon.patlang"), "signals.patlang"), "includes.patlang")
  let bd_src = read_file("self_hosting/lib/signals.patlang") + chr(10) + read_file("self_hosting/lib/includes.patlang") + chr(10) + bd_lib_body + chr(10) + bd_demo_body
  let jobs = add_job(jobs, "builddaemon", bd_src, "")

  # routerdsl needs its DSL-expansion side effect run first (writes
  # portfolio/build/router_dsl_expanded.patlang), duplicating the same
  # tokenize/parse_program/lower_program/run_ir pipeline used at its real
  # call site below -- cheap and idempotent, not the compile bottleneck.
  let dsl_driver = read_file("self_hosting/lib/regex_dsl.patlang") + chr(10)
    + read_file("self_hosting/lib/syntax_dsl.patlang") + chr(10)
    + "let raw = read_file(\"self_hosting/examples/router_dsl_demo.patlang\")" + chr(10)
    + "let expanded = expand_syntax_dsls(raw)" + chr(10)
    + "write_file(\"portfolio/build/router_dsl_expanded.patlang\", expanded)" + chr(10)
  run_ir(lower_program(parse_program(tokenize(dsl_driver))))
  let router_src = read_file("portfolio/build/router_dsl_expanded.patlang")
  let jobs = add_job(jobs, "routerdsl", router_src, "")

  let tower_src = read_file("self_hosting/lib/math.patlang") + chr(10) + read_file("self_hosting/examples/numeric_tower_demo.patlang")
  let jobs = add_job(jobs, "towerdemo", tower_src, "")
  let dynsyntax_src = read_file("self_hosting/lib/lexer.patlang") + read_file("self_hosting/lib/parser.patlang") + read_file("self_hosting/lib/lower.patlang") + read_file("self_hosting/lib/regex_dsl.patlang") + read_file("self_hosting/lib/syntax_dsl.patlang") + read_file("self_hosting/examples/dynamic_syntax_demo.patlang")
  let jobs = add_job(jobs, "dynsyntaxdemo", dynsyntax_src, "")
  let jobs = add_job(jobs, "threadingdemo", read_file("self_hosting/examples/threading_demo.patlang"), "")
  let report_lib_src = read_file("self_hosting/lib/report.patlang")
  let report_src = report_lib_src + chr(10) + read_file("self_hosting/examples/report_demo.patlang")
  let jobs = add_job(jobs, "report", report_src, "")
  let report_wasm_src = read_file("self_hosting/lib/lexer.patlang") + chr(10) + read_file("self_hosting/lib/parser.patlang") + chr(10) + read_file("self_hosting/lib/lower.patlang") + chr(10) + report_lib_src + chr(10) + read_file("self_hosting/examples/report_wasm_main.patlang")
  let jobs = add_job(jobs, "report_timeline", report_wasm_src, "wasm32-wasip1")
  let pg_src = read_file("self_hosting/lib/lexer.patlang") + chr(10) + read_file("self_hosting/lib/parser.patlang") + chr(10) + read_file("self_hosting/lib/lower.patlang") + chr(10) + read_file("self_hosting/lib/regex_dsl.patlang") + chr(10) + read_file("self_hosting/lib/syntax_dsl.patlang") + chr(10) + read_file("self_hosting/examples/playground_main.patlang")
  let jobs = add_job(jobs, "playground", pg_src, "")
  let jobs = add_job(jobs, "playground", pg_src, "wasm32-wasip1")
  # patbuild is deliberately NOT precompiled here for now -- see the real
  # compile site further down for why (patc1.exe was found to take 45+
  # minutes on this specific job, a ~40x anomaly vs the interpreter doing
  # the identical pipeline in ~66s; logged in the backlog, not yet fixed).
  let flow_full = read_file("self_hosting/lib/lexer.patlang") + chr(10) + read_file("self_hosting/lib/parser.patlang") + chr(10) + read_file("self_hosting/lib/lower.patlang") + chr(10) + read_file("self_hosting/lib/html.patlang") + chr(10) + read_file("self_hosting/tools/flowgraph_main.patlang")
  let jobs = add_job(jobs, "flowgraph", flow_full, "")
  let flowgraph_wasm_src = read_file("self_hosting/lib/lexer.patlang") + chr(10) + read_file("self_hosting/lib/parser.patlang") + chr(10) + read_file("self_hosting/lib/lower.patlang") + chr(10) + read_file("self_hosting/lib/html.patlang") + chr(10) + read_file("self_hosting/examples/flowgraph_wasm_main.patlang")
  let jobs = add_job(jobs, "flowgraphdemo", flowgraph_wasm_src, "wasm32-wasip1")
  let maze_wasm_src = read_file("self_hosting/lib/lexer.patlang") + chr(10) + read_file("self_hosting/lib/parser.patlang") + chr(10) + read_file("self_hosting/lib/lower.patlang") + chr(10) + read_file("self_hosting/lib/maze.patlang") + chr(10) + read_file("self_hosting/examples/maze_wasm_main.patlang")
  let jobs = add_job(jobs, "maze", maze_wasm_src, "wasm32-wasip1")
  let jobs = add_job(jobs, "fiber", read_file("self_hosting/examples/fiber_demo.patlang"), "wasm32-wasip1-threads")
  let jobs = add_job(jobs, "robots", read_file("self_hosting/examples/robots_demo.patlang"), "wasm32-wasip1-threads")
  let jobs = add_job(jobs, "cga", read_file("self_hosting/examples/cga_classifier.patlang"), "wasm32-wasip1")
  return jobs
end

print("scanning for stale demos to precompile in parallel...")
let precompile_jobs = build_precompile_jobs()
set_var("total", precompile_jobs.length)
set_var("running", 0)
set_var("done", 0)
print("precompiling " + precompile_jobs.length + " stale target(s) across real OS threads...")
parallel_map(precompile_jobs, "precompile_job")
print("precompile pass done")

# Each demo/native card is now its own fragment-mode page (portfolio/demos/
# <slug>.html), written via lib/template.patlang, instead of one section
# appended into a single monolithic portfolio/index.html. Fragment mode
# emits no <html>/<head>/<body> wrapper -- see template.patlang's header
# comment -- so these files are ready to be embedded, as-is, into
# parslow.net's own page shell (real TOC/nav/breadcrumbs), not just viewed
# standalone.

# native_page: a demo with only a captured build-machine transcript, no
# "run in this browser" button (native-only features: file I/O, subprocess
# calls, etc. that can't run inside the WASI-sandboxed browser demo).
make a function called native_page takes slug, title, blurb, src, transcript returns done
  let sections = [tpl_para(blurb)]
  let sections = list_push(sections, tpl_raw("<details><summary>PatLang source</summary><pre class='src'>" + html_escape(src) + "</pre></details>"))
  let sections = list_push(sections, tpl_raw("<p class='label'>Native run on the build machine:</p>"))
  let sections = list_push(sections, tpl_raw("<pre class='out native'>" + html_escape(transcript) + "</pre>"))
  let page = tpl_page(title, "fragment", sections)
  write_file("portfolio/demos/" + slug + ".html", render_page(page))
  print("wrote portfolio/demos/" + slug + ".html")
  return true
end

# demo_page: a demo runnable live in the browser, PLUS its native
# transcript. Every such card shares the SAME 'playground' wasm module (the
# self-hosted compiler compiled to wasm once) -- there's no per-demo wasm
# build; "Compile and run" passes this card's own source text as input to
# that shared compiler-in-wasm, exactly matching the original demo_card's
# runCard()/srcText() wiring in wasi_shim_js below. pg_b64 is threaded in as
# a parameter (PatLang functions don't close over outer `let`s).
make a function called demo_page takes slug, title, blurb, src, transcript, pg_b64 returns done
  let sections = [tpl_para(blurb)]
  let sections = list_push(sections, tpl_raw("<details><summary>PatLang source</summary><pre class='src' id='src-" + slug + "'>" + html_escape(src) + "</pre></details>"))
  let sections = list_push(sections, tpl_raw("<p><button onclick='runCard(" + q() + slug + q() + ")'>Compile and run in this browser</button> <span class='ms' id='ms-" + slug + "'></span></p>"))
  let sections = list_push(sections, tpl_raw("<pre class='out' id='out-" + slug + "'>(not run yet)</pre>"))
  let sections = list_push(sections, tpl_raw("<p class='label'>Native run on the build machine:</p>"))
  let sections = list_push(sections, tpl_raw("<pre class='out native'>" + html_escape(transcript) + "</pre>"))
  let js = sb_new()
  sb_push(js, "const WASMS = { playground: '" + pg_b64 + "' };" + nl())
  wasi_shim_js(js)
  sb_push(js, "function runCard(id) { return runWasm(id, 'playground', [srcText(id)]); }" + nl())
  let sections = list_push(sections, tpl_script(sb_str(js)))
  let page = tpl_page(title, "fragment", sections)
  write_file("portfolio/demos/" + slug + ".html", render_page(page))
  print("wrote portfolio/demos/" + slug + ".html")
  return true
end

make a function called b64bytes_only_js takes b returns done
  # Just the base64-decode helper, for pages (like the threaded fiber demo)
  # that need runWasmThreaded but not the rest of wasi_shim_js's playground/
  # highlighting machinery (which assumes an #ed editor element that isn't
  # present on those pages).
  sb_push(b, "function b64bytes(s) {" + nl())
  sb_push(b, "  const bin = atob(s);" + nl())
  sb_push(b, "  const a = new Uint8Array(bin.length);" + nl())
  sb_push(b, "  for (let i = 0; i < bin.length; i++) a[i] = bin.charCodeAt(i);" + nl())
  sb_push(b, "  return a;" + nl())
  sb_push(b, "}" + nl())
  return true
end

make a function called runwasm_only_js takes b returns done
  sb_push(b, "function b64bytes(s) {" + nl())
  sb_push(b, "  const bin = atob(s);" + nl())
  sb_push(b, "  const a = new Uint8Array(bin.length);" + nl())
  sb_push(b, "  for (let i = 0; i < bin.length; i++) a[i] = bin.charCodeAt(i);" + nl())
  sb_push(b, "  return a;" + nl())
  sb_push(b, "}" + nl())
  sb_push(b, "const MODCACHE = {};" + nl())
  sb_push(b, "async function runWasm(outId, wasmId, extraArgs) {" + nl())
  sb_push(b, "  const out = document.getElementById('out-' + outId);" + nl())
  sb_push(b, "  if (out) out.textContent = 'running...';" + nl())
  sb_push(b, "  let stdout = '';" + nl())
  sb_push(b, "  const dec = new TextDecoder();" + nl())
  sb_push(b, "  let mem = null;" + nl())
  sb_push(b, "  const enc = new TextEncoder();" + nl())
  sb_push(b, "  const eargs = (extraArgs && extraArgs.length) ? ['prog'].concat(extraArgs) : [];" + nl())
  sb_push(b, "  const abufs = eargs.map(function(a) { return enc.encode(a); });" + nl())
  sb_push(b, "  const wasi = {" + nl())
  sb_push(b, "    fd_write(fd, iovs, len, nw) {" + nl())
  sb_push(b, "      const dv = new DataView(mem.buffer); let w = 0;" + nl())
  sb_push(b, "      for (let i = 0; i < len; i++) {" + nl())
  sb_push(b, "        const p = iovs + 8 * i;" + nl())
  sb_push(b, "        const ptr = dv.getUint32(p, true), l = dv.getUint32(p + 4, true);" + nl())
  sb_push(b, "        stdout += dec.decode(new Uint8Array(mem.buffer, ptr, l)); w += l;" + nl())
  sb_push(b, "      }" + nl())
  sb_push(b, "      dv.setUint32(nw, w, true); return 0;" + nl())
  sb_push(b, "    }," + nl())
  sb_push(b, "    random_get(p, l) { crypto.getRandomValues(new Uint8Array(mem.buffer, p, l)); return 0; }," + nl())
  sb_push(b, "    clock_time_get(cid, prec, tp) {" + nl())
  sb_push(b, "      const dv = new DataView(mem.buffer);" + nl())
  sb_push(b, "      const ns = BigInt(Math.round((performance.timeOrigin + performance.now()) * 1e6));" + nl())
  sb_push(b, "      dv.setBigUint64(tp, ns, true); return 0;" + nl())
  sb_push(b, "    }," + nl())
  sb_push(b, "    args_sizes_get(pc, ps) {" + nl())
  sb_push(b, "      const dv = new DataView(mem.buffer);" + nl())
  sb_push(b, "      let total = 0; for (const a of abufs) total += a.length + 1;" + nl())
  sb_push(b, "      dv.setUint32(pc, abufs.length, true); dv.setUint32(ps, total, true); return 0;" + nl())
  sb_push(b, "    }," + nl())
  sb_push(b, "    args_get(argvP, dataP) {" + nl())
  sb_push(b, "      const dv = new DataView(mem.buffer); let off = dataP;" + nl())
  sb_push(b, "      for (let i = 0; i < abufs.length; i++) {" + nl())
  sb_push(b, "        dv.setUint32(argvP + 4 * i, off, true);" + nl())
  sb_push(b, "        new Uint8Array(mem.buffer, off, abufs[i].length).set(abufs[i]);" + nl())
  sb_push(b, "        dv.setUint8(off + abufs[i].length, 0); off += abufs[i].length + 1;" + nl())
  sb_push(b, "      }" + nl())
  sb_push(b, "      return 0;" + nl())
  sb_push(b, "    }," + nl())
  sb_push(b, "    environ_sizes_get(pc, ps) { const dv = new DataView(mem.buffer); dv.setUint32(pc, 0, true); dv.setUint32(ps, 0, true); return 0; }," + nl())
  sb_push(b, "    environ_get() { return 0; }," + nl())
  sb_push(b, "    proc_exit(c) { const e = new Error('exit'); e.exitCode = c; throw e; }," + nl())
  sb_push(b, "    fd_close() { return 0; }, fd_fdstat_get() { return 0; }, fd_seek() { return 70; }," + nl())
  sb_push(b, "    fd_read() { return 8; }, fd_prestat_get() { return 8; }, fd_prestat_dir_name() { return 8; }," + nl())
  sb_push(b, "    path_open() { return 76; }, sched_yield() { return 0; }, poll_oneoff() { return 52; }" + nl())
  sb_push(b, "  };" + nl())
  sb_push(b, "  // Unknown WASI imports resolve to a stub returning ENOTSUP (58)" + nl())
  sb_push(b, "  const wasiNs = new Proxy(wasi, { get(t, k) { return k in t ? t[k] : (() => 58); } });" + nl())
  sb_push(b, "  try {" + nl())
  sb_push(b, "    const t0 = performance.now();" + nl())
  sb_push(b, "    if (!MODCACHE[wasmId]) MODCACHE[wasmId] = await WebAssembly.compile(b64bytes(WASMS[wasmId]));" + nl())
  sb_push(b, "    const mod = MODCACHE[wasmId];" + nl())
  sb_push(b, "    const inst = await WebAssembly.instantiate(mod, { wasi_snapshot_preview1: wasiNs });" + nl())
  sb_push(b, "    mem = inst.exports.memory;" + nl())
  sb_push(b, "    try { inst.exports._start(); } catch (e) { if (!(e && e.exitCode === 0)) throw e; }" + nl())
  sb_push(b, "    const ms = (performance.now() - t0).toFixed(1);" + nl())
  sb_push(b, "    if (out) out.textContent = stdout;" + nl())
  sb_push(b, "    const msEl = document.getElementById('ms-' + outId);" + nl())
  sb_push(b, "    if (msEl) msEl.textContent = ms + ' ms wall (compile+run, this browser)';" + nl())
  sb_push(b, "    return stdout;" + nl())
  sb_push(b, "  } catch (e) {" + nl())
  sb_push(b, "    if (out) out.textContent = stdout + ' [error: ' + e + ']';" + nl())
  sb_push(b, "    return stdout;" + nl())
  sb_push(b, "  }" + nl())
  sb_push(b, "}" + nl())
return true
end

