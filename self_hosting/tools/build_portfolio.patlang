# Maze solver page: an interactive page around a small wasm module (lexer +
# parser + lower + lib/maze + a driver taking generate/solve subcommands),
# so mazes of any size/seed are generated and solved live in the browser -
# no rustc beyond this one-time wasm build, matching the IDE/playground.
let maze_src = read_file("self_hosting/lib/maze.patlang")
let maze_wasm_src = read_file("self_hosting/lib/lexer.patlang") + chr(10) + read_file("self_hosting/lib/parser.patlang") + chr(10) + read_file("self_hosting/lib/lower.patlang") + chr(10) + maze_src + chr(10) + read_file("self_hosting/examples/maze_wasm_main.patlang")
let maze_b64 = compile_wasm_only(maze_wasm_src, "maze")
print("maze wasm done")

let maze_body = sb_new()
sb_push(maze_body, "<h1>PatLang maze solver</h1>" + nl())
sb_push(maze_body, "<p>A grid compiled into logic-programming <code>fact</code>s, solved by a recursive depth-first search driven by <code>query</code>, announced with <code>goal</code>, and reported through a <code>solved</code>/<code>unsolved</code> event - generation and solving both run live in this page (compiled to WASM once, no rustc per maze). Pick a size and seed, generate a maze, then watch it solve one visited cell at a time.</p>" + nl())
sb_push(maze_body, maze_css())
sb_push(maze_body, "<style>" + nl())
sb_push(maze_body, ".mz-visited{background:#f6b93b}" + nl())
sb_push(maze_body, "#mz-canvas{display:grid;gap:2px}" + nl())
sb_push(maze_body, "</style>" + nl())
sb_push(maze_body, "<p>" + nl())
sb_push(maze_body, "<label>Width <input id='mz-w' type='number' value='16' min='2' max='60' style='width:4em'></label> " + nl())
sb_push(maze_body, "<label>Height <input id='mz-h' type='number' value='12' min='2' max='60' style='width:4em'></label> " + nl())
sb_push(maze_body, "<label>Seed <input id='mz-seed' type='number' value='1' min='0' max='32767' style='width:5em'></label> " + nl())
sb_push(maze_body, "<button onclick='mzGenerate()'>Generate maze</button> " + nl())
sb_push(maze_body, "<label>Speed <input id='mz-speed' type='range' min='1' max='60' value='25'></label>" + nl())
sb_push(maze_body, "</p>" + nl())
sb_push(maze_body, "<p><button onclick='mzSolve()'>Watch it solve</button> <button onclick='mzSolveInstant()'>Solve instantly</button> <span id='mz-status' class='ms'></span></p>" + nl())
sb_push(maze_body, "<div id='mz-canvas'></div>" + nl())
sb_push(maze_body, "<pre class='out' id='out-maze' hidden></pre>" + nl())
sb_push(maze_body, "<h2>Source</h2>" + nl())
sb_push(maze_body, "<details><summary>lib/maze.patlang</summary><pre class='src'>" + html_escape(maze_src) + "</pre></details>" + nl())

let maze_js = sb_new()
sb_push(maze_js, "const WASMS = {" + nl())
sb_push(maze_js, "  maze: '" + maze_b64 + "'" + nl())
sb_push(maze_js, "};" + nl())
wasi_shim_js(maze_js)
sb_push(maze_js, "let mzCols = 0, mzRows = 0, mzGrid = [], mzCells = [];" + nl())
sb_push(maze_js, "function mzClassFor(c) { if (c === '#') return 'mz-wall'; if (c === 'S') return 'mz-start'; if (c === 'E') return 'mz-end'; return 'mz-open'; }" + nl())
sb_push(maze_js, "function mzRender(grid) {" + nl())
sb_push(maze_js, "  mzGrid = grid; mzRows = grid.length; mzCols = grid[0].length; mzCells = [];" + nl())
sb_push(maze_js, "  const c = document.getElementById('mz-canvas');" + nl())
sb_push(maze_js, "  c.style.gridTemplateColumns = 'repeat(' + mzCols + ', 1.4em)';" + nl())
sb_push(maze_js, "  c.innerHTML = '';" + nl())
sb_push(maze_js, "  for (let y = 0; y < mzRows; y++) for (let x = 0; x < mzCols; x++) {" + nl())
sb_push(maze_js, "    const d = document.createElement('div');" + nl())
sb_push(maze_js, "    d.style.width = d.style.height = '1.4em';" + nl())
sb_push(maze_js, "    d.className = mzClassFor(grid[y][x]);" + nl())
sb_push(maze_js, "    c.appendChild(d); mzCells.push(d);" + nl())
sb_push(maze_js, "  }" + nl())
sb_push(maze_js, "}" + nl())
sb_push(maze_js, "async function mzGenerate() {" + nl())
sb_push(maze_js, "  const w = document.getElementById('mz-w').value, h = document.getElementById('mz-h').value, seed = document.getElementById('mz-seed').value;" + nl())
sb_push(maze_js, "  const text = await runWasm('maze', 'maze', ['generate', w, h, seed]);" + nl())
sb_push(maze_js, "  mzRender(text.split(String.fromCharCode(10)).filter(function(r) { return r.length > 0; }));" + nl())
sb_push(maze_js, "  document.getElementById('mz-status').textContent = 'generated ' + w + 'x' + h + ' maze, seed ' + seed;" + nl())
sb_push(maze_js, "}" + nl())
sb_push(maze_js, "function mzCellIndex(key) { const p = key.split(','); return (Number(p[1]) * mzCols) + Number(p[0]); }" + nl())
sb_push(maze_js, "async function mzRunSolve() {" + nl())
sb_push(maze_js, "  for (const el of mzCells) { el.classList.remove('mz-visited', 'mz-path'); }" + nl())
sb_push(maze_js, "  const text = await runWasm('maze', 'maze', ['solve', mzGrid.join(String.fromCharCode(10))]);" + nl())
sb_push(maze_js, "  const lines = text.split(String.fromCharCode(10));" + nl())
sb_push(maze_js, "  const trace = lines[0] ? lines[0].split(';') : [];" + nl())
sb_push(maze_js, "  const path = lines[1] ? lines[1].split(';') : [];" + nl())
sb_push(maze_js, "  const msg = lines[2] || '';" + nl())
sb_push(maze_js, "  return { trace, path, msg };" + nl())
sb_push(maze_js, "}" + nl())
sb_push(maze_js, "function mzPaintPath(path) {" + nl())
sb_push(maze_js, "  for (const key of path) {" + nl())
sb_push(maze_js, "    const el = mzCells[mzCellIndex(key)];" + nl())
sb_push(maze_js, "    if (el && !el.classList.contains('mz-start') && !el.classList.contains('mz-end')) el.classList.add('mz-path');" + nl())
sb_push(maze_js, "  }" + nl())
sb_push(maze_js, "}" + nl())
sb_push(maze_js, "async function mzSolve() {" + nl())
sb_push(maze_js, "  document.getElementById('mz-status').textContent = 'solving...';" + nl())
sb_push(maze_js, "  const { trace, path, msg } = await mzRunSolve();" + nl())
sb_push(maze_js, "  const speed = 61 - Number(document.getElementById('mz-speed').value);" + nl())
sb_push(maze_js, "  let i = 0;" + nl())
sb_push(maze_js, "  const timer = setInterval(() => {" + nl())
sb_push(maze_js, "    if (i >= trace.length) {" + nl())
sb_push(maze_js, "      clearInterval(timer); mzPaintPath(path); document.getElementById('mz-status').textContent = msg;" + nl())
sb_push(maze_js, "      return;" + nl())
sb_push(maze_js, "    }" + nl())
sb_push(maze_js, "    const el = mzCells[mzCellIndex(trace[i])];" + nl())
sb_push(maze_js, "    if (el && !el.classList.contains('mz-start') && !el.classList.contains('mz-end')) el.classList.add('mz-visited');" + nl())
sb_push(maze_js, "    i++;" + nl())
sb_push(maze_js, "  }, speed);" + nl())
sb_push(maze_js, "}" + nl())
sb_push(maze_js, "async function mzSolveInstant() {" + nl())
sb_push(maze_js, "  document.getElementById('mz-status').textContent = 'solving...';" + nl())
sb_push(maze_js, "  const { trace, path, msg } = await mzRunSolve();" + nl())
sb_push(maze_js, "  for (const key of trace) { const el = mzCells[mzCellIndex(key)]; if (el && !el.classList.contains('mz-start') && !el.classList.contains('mz-end')) el.classList.add('mz-visited'); }" + nl())
sb_push(maze_js, "  mzPaintPath(path);" + nl())
sb_push(maze_js, "  document.getElementById('mz-status').textContent = msg;" + nl())
sb_push(maze_js, "}" + nl())
sb_push(maze_js, "window.addEventListener('DOMContentLoaded', mzGenerate);" + nl())

write_file("portfolio/maze.html", html_page("PatLang maze solver", sb_str(maze_body), sb_str(maze_js)))
print("maze done")

# IDE page: a bigger standalone editor around the same playground.wasm engine
# (no new wasm build - the mode argument added to playground_main.patlang
# already handles run/tokens/ast). Reuses wasi_shim_js's runWasm/hlHtml/
# loadExample helpers unchanged; only ide.html-specific bits are added below.
let ide_body = sb_new()
sb_push(ide_body, "<h1>PatLang IDE</h1>" + nl())
sb_push(ide_body, "<p>The self-hosted compiler (lexer, parser, lowerer), compiled to WebAssembly once and reused for every run in this page. <b>Run</b> executes your program; <b>Tokens</b> and <b>AST</b> show the compiler's own intermediate representations for the same source, with no rustc involved for any of the three. Ctrl+Enter runs. Your code is kept in this browser's local storage.</p>" + nl())
sb_push(ide_body, "<style>" + nl())
sb_push(ide_body, ".edwrap { position: relative; height: 28rem; border: 1px solid color-mix(in srgb, currentColor 25%, transparent); border-radius: 6px; overflow: hidden; }" + nl())
sb_push(ide_body, ".edwrap pre.hl, .edwrap textarea { position: absolute; inset: 0; margin: 0; padding: 0.6rem; font: 0.9rem/1.5 monospace; white-space: pre; overflow: auto; border: 0; background: transparent; }" + nl())
sb_push(ide_body, ".edwrap textarea { color: transparent; caret-color: light-dark(black, white); resize: none; width: 100%; height: 100%; outline: none; }" + nl())
sb_push(ide_body, ".hl i { font-style: normal; } .hk { color: #c678dd; font-weight: 600; } .hs { color: #98c379; } .hn { color: #d19a66; } .hc { color: #7f848e; }" + nl())
sb_push(ide_body, ".out { min-height: 10rem; max-height: 22rem; }" + nl())
sb_push(ide_body, "</style>" + nl())
let ide_examples = [["default", "starter program", "self_hosting/examples/playground_default.patlang"], ["feature", "all paradigms", "self_hosting/examples/feature_demo.patlang"], ["bench", "self-timing benchmark", "self_hosting/examples/fib_bench.patlang"], ["contracts", "design by contract", "self_hosting/examples/contracts_demo.patlang"]]
let k = 0
while k < ide_examples.length do
  let ex = ide_examples[k]
  sb_push(ide_body, "<pre id='src-" + ex[0] + "' hidden>" + html_escape(read_file(ex[2])) + "</pre>" + nl())
  let k = k + 1
end
sb_push(ide_body, "<p><label>Load example: <select id='exsel' onchange='loadExample()'>" + nl())
let k = 0
while k < ide_examples.length do
  let ex = ide_examples[k]
  sb_push(ide_body, "<option value='" + ex[0] + "'>" + ex[1] + "</option>" + nl())
  let k = k + 1
end
sb_push(ide_body, "</select></label> <button onclick='ideReset()'>Reset to selected example</button></p>" + nl())
sb_push(ide_body, "<div class='edwrap'><pre id='hl' class='hl' aria-hidden='true'></pre><textarea id='ed' spellcheck='false' oninput='hlUpdate(); ideSave();' onscroll='hlSync()' onkeydown='ideKey(event)'>" + nl())
sb_push(ide_body, html_escape(read_file("self_hosting/examples/playground_default.patlang")))
sb_push(ide_body, "</textarea></div>" + nl())
sb_push(ide_body, "<p><button onclick=" + q() + "runWasm('ide','playground',[document.getElementById('ed').value,'run'])" + q() + ">Run</button> <button onclick=" + q() + "runWasm('ide','playground',[document.getElementById('ed').value,'tokens'])" + q() + ">Tokens</button> <button onclick=" + q() + "runWasm('ide','playground',[document.getElementById('ed').value,'ast'])" + q() + ">AST</button> <span class='ms' id='ms-ide'></span></p>" + nl())
sb_push(ide_body, "<pre class='out' id='out-ide'>(not run yet)</pre>" + nl())

let ide_js = sb_new()
sb_push(ide_js, "const WASMS = {" + nl())
sb_push(ide_js, "  playground: '" + pg_b64 + "'" + nl())
sb_push(ide_js, "};" + nl())
wasi_shim_js(ide_js)
sb_push(ide_js, "function ideSave() { try { localStorage.setItem('patlang_ide_src', document.getElementById('ed').value); } catch (e) {} }" + nl())
sb_push(ide_js, "function ideReset() { loadExample(); ideSave(); }" + nl())
sb_push(ide_js, "function ideKey(e) { if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') { e.preventDefault(); runWasm('ide', 'playground', [document.getElementById('ed').value, 'run']); } }" + nl())
sb_push(ide_js, "window.addEventListener('DOMContentLoaded', function() { try { const saved = localStorage.getItem('patlang_ide_src'); if (saved) { document.getElementById('ed').value = saved; hlUpdate(); } } catch (e) {} });" + nl())

write_file("portfolio/ide.html", html_page("PatLang IDE", sb_str(ide_body), sb_str(ide_js)))
print("ide done")

# Compiler self-metrics: the PatLang front+middle end processing its own source
let compiler_src = read_file("self_hosting/lib/lexer.patlang")
let compiler_src = compiler_src + chr(10) + read_file("self_hosting/lib/parser.patlang")
let compiler_src = compiler_src + chr(10) + read_file("self_hosting/lib/lower.patlang")
let compiler_src = compiler_src + chr(10) + read_file("self_hosting/lib/codegen.patlang")
let compiler_src = compiler_src + chr(10) + read_file("self_hosting/lib/runtime_rs.patlang")
let compiler_src = compiler_src + chr(10) + read_file("self_hosting/patc1_main.patlang")
let m0 = now_ms()
let ctoks = tokenize(compiler_src)
let m1 = now_ms()
let cast = parse_program(ctoks)
let m2 = now_ms()
let cir = lower_program(cast)
let m3 = now_ms()
let crs = emit_program_rs(cir)
let m4 = now_ms()
print("compiler metrics done")

# ---- assemble the page ----
let body = sb_new()
