# =============================================================================
# PatLang site generator: builds the PatLang section of parslow.net in the
# soft-editorial teaching-page format. End-to-end PatLang: markdown docs are
# rendered by lib/markdown.patlang and wrapped in the site shell.
#
# Run from the repo root:
#   rust-runtime/target/release/pat --ir-run self_hosting/tools/build_site.patlang
# Writes into D:/Projects_Organized/parslow-soft-editorial/publish/patlang/
# =============================================================================

include "../lib/html.patlang"
include "../lib/test.patlang"
include "../lib/markdown.patlang"

let OUT = "D:/Projects_Organized/parslow-soft-editorial/publish/patlang/"

make a function called shell takes title, crumb, toc_items, content returns page
  let b = sb_new()
  sb_push(b, "<!DOCTYPE html>" + nl() + "<html lang=" + q() + "en" + q() + ">" + nl() + "<head>" + nl())
  sb_push(b, "<meta charset=" + q() + "UTF-8" + q() + ">" + nl())
  sb_push(b, "<meta name=" + q() + "viewport" + q() + " content=" + q() + "width=device-width, initial-scale=1.0" + q() + ">" + nl())
  sb_push(b, "<title>" + html_escape(title) + " - Parslow.net</title>" + nl())
  sb_push(b, "<link rel=" + q() + "preconnect" + q() + " href=" + q() + "https://fonts.googleapis.com" + q() + ">" + nl())
  sb_push(b, "<link href=" + q() + "https://fonts.googleapis.com/css2?family=Crimson+Pro:wght@400;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" + q() + " rel=" + q() + "stylesheet" + q() + ">" + nl())
  sb_push(b, "<link rel=" + q() + "stylesheet" + q() + " href=" + q() + "../assets/panels.css" + q() + ">" + nl())
  sb_push(b, "<link rel=" + q() + "stylesheet" + q() + " href=" + q() + "../assets/teaching.css" + q() + ">" + nl())
  sb_push(b, "</head>" + nl() + "<body>" + nl() + "<div class=" + q() + "site-layout" + q() + ">" + nl())
  sb_push(b, "<aside class=" + q() + "toc-panel" + q() + ">" + nl() + "<h3>Contents</h3>" + nl())
  sb_push(b, "<nav class=" + q() + "toc" + q() + "><ul>" + toc_items + "</ul></nav>" + nl() + "</aside>" + nl())
  sb_push(b, "<main class=" + q() + "doc-content" + q() + ">" + nl())
  sb_push(b, "<nav class=" + q() + "breadcrumbs" + q() + " aria-label=" + q() + "Breadcrumb" + q() + "><a href=" + q() + "../index.html" + q() + ">Home</a><span class=" + q() + "separator" + q() + ">/</span>" + crumb + "</nav>" + nl())
  sb_push(b, "<div class=" + q() + "content-card" + q() + ">" + nl())
  sb_push(b, content)
  sb_push(b, "</div>" + nl() + "</main>" + nl() + "</div>" + nl() + "</body>" + nl() + "</html>" + nl())
  return sb_str(b)
end

make a function called doc_page takes out_dir, md_path, out_name, title returns done
  let md = read_file(md_path)
  let toc = sb_new()
  let content = md_to_html(md, toc)
  let crumb = "<a href='index.html'>PatLang</a><span class='separator'>/</span><span class='current'>" + html_escape(title) + "</span>"
  write_file(out_dir + out_name, shell(title, crumb, sb_str(toc), content))
  print("wrote " + out_name)
  return true
end

# ---- index page: topic cards ----
make a function called card takes b, href, title, blurb returns done
  sb_push(b, "<article class='topic-article-card' id='" + slugify(title) + "'>" + nl())
  sb_push(b, "<h3><a href='" + href + "'>" + html_escape(title) + "</a></h3>" + nl())
  sb_push(b, "<p>" + blurb + "</p>" + nl())
  sb_push(b, "</article>" + nl())
  return true
end

let ix = sb_new()
sb_push(ix, "<div class='topic-index'><h1>PatLang</h1>" + nl())
sb_push(ix, "<p class='topic-description'>A multi-paradigm language with a fully self-hosted compiler: the lexer, parser, lowerer, and code generator are written in PatLang and compile themselves. Events, logic facts, objects, functional style, networking, WASM, and a browser playground.</p>" + nl())
sb_push(ix, "<div class='topic-articles'>" + nl())
card(ix, "portfolio.html", "Portfolio & live playground", "Runnable examples compiled to WebAssembly: edit PatLang in the browser and the self-hosted compiler (itself running on WASM) compiles and executes it, with performance self-reported by the programs.")
card(ix, "getting-started.html", "Getting started", "Build the runtime, run and compile your first program, tour the language and all six paradigms, and meet the self-hosting pipeline.")
card(ix, "self-hosting.html", "Self-hosting: the road to the fixpoint", "How PatLang came to compile itself: the staged roadmap from a Rust Stage 0 seed to byte-identical self-compilation, with the runtime library itself expressed as PatLang source.")
card(ix, "flowgraph.html", "Control-flow graphs", "Basic blocks and jump edges recovered from the compiler's own IR, rendered as SVG by a PatLang tool.")
sb_push(ix, "</div></div>" + nl())
let itoc = "<li><a href='portfolio.html'>Portfolio</a></li><li><a href='getting-started.html'>Getting started</a></li><li><a href='self-hosting.html'>Self-hosting</a></li><li><a href='flowgraph.html'>Flow graphs</a></li>"
write_file(OUT + "index.html", shell("PatLang", "<span class='current'>PatLang</span>", itoc, sb_str(ix)))
print("wrote index.html")

# ---- docs from markdown ----
doc_page(OUT, "TUTORIAL.md", "getting-started.html", "Getting started with PatLang")
doc_page(OUT, "PATLANG_SELF_HOSTING_ROADMAP.md", "self-hosting.html", "Self-hosting PatLang")

# ---- self-contained artifacts, copied as-is ----
write_file(OUT + "portfolio.html", read_file("portfolio/index.html"))
print("wrote portfolio.html")
write_file(OUT + "flowgraph.html", read_file("portfolio/flowgraph.html"))
print("wrote flowgraph.html")
print("site done -> " + OUT)
