# Include-dependency graph CLI. See ../lib/depgraph.patlang for how the
# scanning/cycle-detection actually works.
#
# Usage (run from the repo root):
#   pat --ir-run self_hosting/tools/depgraph_main.patlang [--html out.html]

include "../lib/includes.patlang"
include "../lib/depgraph.patlang"
include "../lib/html.patlang"

# The real repo's scan roots, deliberately NOT a blind recursive walk of
# all of self_hosting/, which would also sweep up self_hosting/build/
# (generated scratch output) and self_hosting/runtime/ (generated
# prelude) and produce a misleading graph full of build artifacts.
# self_hosting/ itself would recurse into the other three
# AND self_hosting/build/self_hosting/runtime too if collected the normal
# recursive way -- so it's handled specially: only its own top-level
# *.patlang files (the selftests), not a recursive walk.
make a function called depgraph_main_collect returns files
  let roots = ["self_hosting/lib", "self_hosting/tools", "self_hosting/examples"]
  let files = depgraph_collect_files(roots)
  let entries = list_dir("self_hosting")
  let i = 0
  let n = to_num(list_len(entries))
  while i < n do
    let name = entries[i]
    if str_ends_with(name, ".patlang") then
      let files = list_push(files, path_join("self_hosting", name))
    end
    let i = i + 1
  end
  return files
end

make a function called depgraph_main_build returns graph
  return depgraph_build_from_files(depgraph_main_collect())
end

make a function called depgraph_main_cycle_text takes cyc returns s
  let s = ""
  let i = 0
  let n = to_num(list_len(cyc))
  while i < n do
    if i > 0 then
      let s = s + " -> "
    end
    let s = s + cyc[i]
    let i = i + 1
  end
  return s
end

make a function called depgraph_main_print takes graph, cycles returns done
  if to_num(list_len(cycles)) > 0 then
    print("CYCLES DETECTED (" + list_len(cycles) + "):")
    let i = 0
    let n = to_num(list_len(cycles))
    while i < n do
      print("  " + depgraph_main_cycle_text(cycles[i]))
      let i = i + 1
    end
    print("")
  else
    print("No cycles detected.")
    print("")
  end
  let files = graph[0]
  let i = 0
  let n = to_num(list_len(files))
  while i < n do
    let f = files[i]
    let inc = depgraph_direct_includes(graph, f)
    print(f + " (" + list_len(inc) + " direct include(s)):")
    let j = 0
    let jn = to_num(list_len(inc))
    while j < jn do
      print("  -> " + inc[j])
      let j = j + 1
    end
    let i = i + 1
  end
  return true
end

make a function called depgraph_main_render_html takes graph, cycles returns page
  let b = sb_new()
  sb_push(b, "<h1>Include-dependency graph</h1>" + nl())
  if to_num(list_len(cycles)) > 0 then
    sb_push(b, "<div class='card'>" + nl())
    sb_push(b, "<h2>Cycles detected (" + list_len(cycles) + ")</h2>" + nl())
    sb_push(b, "<ul>" + nl())
    let i = 0
    let n = to_num(list_len(cycles))
    while i < n do
      sb_push(b, "<li>" + html_escape(depgraph_main_cycle_text(cycles[i])) + "</li>" + nl())
      let i = i + 1
    end
    sb_push(b, "</ul>" + nl())
    sb_push(b, "</div>" + nl())
  else
    sb_push(b, "<p>No cycles detected.</p>" + nl())
  end
  let files = graph[0]
  let i = 0
  let n = to_num(list_len(files))
  while i < n do
    let f = files[i]
    let inc = depgraph_direct_includes(graph, f)
    let by = depgraph_included_by(graph, f)
    sb_push(b, "<div class='card'>" + nl())
    sb_push(b, "<h2>" + html_escape(f) + "</h2>" + nl())
    sb_push(b, "<div class='label'>includes (" + list_len(inc) + ")</div>" + nl())
    sb_push(b, "<ul>" + nl())
    let j = 0
    let jn = to_num(list_len(inc))
    while j < jn do
      sb_push(b, "<li>" + html_escape(inc[j]) + "</li>" + nl())
      let j = j + 1
    end
    sb_push(b, "</ul>" + nl())
    sb_push(b, "<div class='label'>included by (" + list_len(by) + ")</div>" + nl())
    sb_push(b, "<ul>" + nl())
    let j = 0
    let jn = to_num(list_len(by))
    while j < jn do
      sb_push(b, "<li>" + html_escape(by[j]) + "</li>" + nl())
      let j = j + 1
    end
    sb_push(b, "</ul>" + nl())
    sb_push(b, "</div>" + nl())
    let i = i + 1
  end
  return html_page("Include-dependency graph", sb_str(b), "")
end

make a function called depgraph_main_run returns done
  let graph = depgraph_main_build()
  let cycles = depgraph_find_cycles(graph)
  depgraph_main_print(graph, cycles)

  let args = argv()
  let i = 0
  let n = to_num(list_len(args))
  while i < n do
    if args[i] == "--html" then
      let i = i + 1
      let html_path = args[i]
      let page = depgraph_main_render_html(graph, cycles)
      write_file(html_path, page)
      print("wrote " + html_path)
    end
    let i = i + 1
  end
  return true
end

depgraph_main_run()
