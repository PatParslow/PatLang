# Regenerates the runtime prelude file that the self-hosted compiler embeds
# in every program it emits. Run from the repo root after changing the
# codegen template:
#   rust-runtime/target/debug/pat --ir-run self_hosting/tools/dump_prelude.patlang

let prelude = codegen_prelude()
write_file("self_hosting/runtime/prelude.rs", prelude)
print("wrote self_hosting/runtime/prelude.rs (" + prelude.length + " chars)")
