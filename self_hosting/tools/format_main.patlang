# Line-based re-indenter CLI. See ../lib/format.patlang for the algorithm
# and why it's line-based rather than a full AST pretty-printer (the
# lexer discards comments entirely, so a parse-rebuild formatter would
# silently delete them).
#
# Usage (run from the repo root):
#   pat --ir-run self_hosting/tools/format_main.patlang <file.patlang> [--write]
#
# Without --write, prints the reindented text to stdout (safe default,
# diffable). --write overwrites the file in place.

include "../lib/lexer.patlang"
include "../lib/includes.patlang"
include "../lib/format.patlang"

make a function called format_main_run returns done
  let args = argv()
  if args.length < 1 then
    print("usage: format_main <file.patlang> [--write]")
    return false
  end
  let file = args[0]
  let write = false
  if args.length >= 2 then
    if args[1] == "--write" then
      let write = true
    end
  end
  let source = read_file(file)
  let out = fmt_reindent(source)
  if write then
    write_file(file, out)
    print("wrote " + file)
  else
    print(out)
  end
  return true
end

format_main_run()
