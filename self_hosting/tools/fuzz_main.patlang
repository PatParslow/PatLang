# Grammar fuzzer CLI. See ../lib/fuzz.patlang for the generation algorithm
# and why it checks parse-only agreement rather than full 3-way execution
# parity (that's tools/parity_main.patlang, for one known file at a time).
#
# Usage (run from the repo root):
#   pat --ir-run self_hosting/tools/fuzz_main.patlang [--seed S] [--iterations N] [--save-failures dir]

include "../lib/lexer.patlang"
include "../lib/parser.patlang"
include "../lib/includes.patlang"
include "../lib/format.patlang"
include "../lib/peg.patlang"
include "../lib/fuzz.patlang"

make a function called fuzz_main_default_pat_exe returns path
  return "rust-runtime/target/release/pat.exe"
end

make a function called fuzz_main_grammar_path returns path
  return "docs/grammar/patlang-full.peg"
end

make a function called fuzz_main_parse_args takes args returns parsed
  # parsed: [seed, iterations, save_dir("" = none)]
  let seed = "patlang-fuzz-default-seed"
  let iterations = 50
  let save_dir = ""
  let i = 0
  let n = to_num(list_len(args))
  while i < n do
    let a = args[i]
    if a == "--seed" then
      let i = i + 1
      let seed = args[i]
    else
      if a == "--iterations" then
        let i = i + 1
        let iterations = to_num(args[i])
      else
        if a == "--save-failures" then
          let i = i + 1
          let save_dir = args[i]
        end
      end
    end
    let i = i + 1
  end
  return [seed, iterations, save_dir]
end

make a function called fuzz_main_run returns done
  let args = argv()
  let parsed = fuzz_main_parse_args(args)
  let seed = parsed[0]
  let iterations = parsed[1]
  let save_dir = parsed[2]
  let pat_exe = fuzz_main_default_pat_exe()
  let peg_grammar_source = read_file(fuzz_main_grammar_path())
  let peg_rules = peg_load_grammar(peg_grammar_source)

  print("Fuzzing " + iterations + " program(s), seed=" + seed + " ...")
  let result = fuzz_run(pat_exe, peg_rules, seed, iterations, "self_hosting/build/fuzz_scratch.patlang")
  let disagreements = result[0]

  if to_num(list_len(disagreements)) == 0 then
    print("No disagreements found across " + iterations + " program(s).")
    return true
  end

  print("DISAGREEMENTS FOUND: " + list_len(disagreements))
  let i = 0
  let n = to_num(list_len(disagreements))
  while i < n do
    let d = disagreements[i]
    let source = d[0]
    let native_ok = d[1]
    let selfhost_ok = d[2]
    let peg_ok = d[3]
    print("--- disagreement " + i + " (native accepts=" + native_ok + ", self-hosted accepts=" + selfhost_ok + ", peg accepts=" + peg_ok + ") ---")
    print(source)
    if save_dir != "" then
      let path = save_dir + "/fuzz_fail_" + i + ".patlang"
      write_file(path, source)
      print("saved to " + path)
    end
    let i = i + 1
  end
  return false
end

fuzz_main_run()
