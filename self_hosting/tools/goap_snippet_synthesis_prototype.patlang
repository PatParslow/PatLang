# GitHub #21 prototype: GOAP code-synthesis via a per-step snippet
# dictionary. Idea being tested: once plan() finds a real sequence of
# actions, look each step's own base name up in a dictionary of source
# templates (potentially one per target language), substitute its bound
# argument values into the template's placeholders, and concatenate the
# results in plan order -- turning a synthesized PLAN directly into a
# synthesized PROGRAM, not just an abstract action sequence.
#
# Deliberately minimal: proves the mechanism end-to-end (plan -> snippet
# lookup -> substitution -> assembly -> a REAL generated program that is
# then actually compiled/run and its output checked) rather than
# building a general framework. Two open questions from the issue are
# addressed directly in the shared machinery this now calls into
# (self_hosting/lib/goap_snippet_synthesis.patlang) -- composition and
# contract interaction; a third (declared snippet interfaces) is still
# an open question, see that file's own header.
#
# The actual synthesis machinery (dictionaries, substitution, assembly)
# now lives in lib/goap_snippet_synthesis.patlang, shared with
# self_hosting/synthesis_goap_snippet_selftest.patlang's real assertion-
# based regression coverage of the same three demos this file prints --
# this file is now just the human-readable, run-it-and-look-at-the-
# output demonstration.

include "../lib/includes.patlang"
include "../lib/goap_snippet_synthesis.patlang"

# ---- worked demo 1: unparameterized two-step plan (gather_wood -> build_house) ----

action_add("gather_wood", [], [["have", ["wood"]]], [], 1)
action_add("build_house", [["have", ["wood"]]], [["have", ["house"]]], [], 1)
let plan1 = plan([["have", ["house"]]])
print("=== Demo 1: unparameterized plan ===")
print("plan: " + plan1)

let synth1_patlang = synthesize_program(plan1, snippet_dict_patlang(), [])
print("--- synthesized PatLang source ---")
print(synth1_patlang[1])

write_file("self_hosting/tools/spec_fixtures/goap_synth_demo1.patlang", synth1_patlang[1])
let run1_out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/tools/spec_fixtures/goap_synth_demo1.patlang")
print("--- running the synthesized program ---")
print(run1_out)

let synth1_python = synthesize_program(plan1, snippet_dict_python(), [])
print("--- same plan, PYTHON snippet dictionary (polyglot proof) ---")
print(synth1_python[1])

# ---- worked demo 2: contract-guarded parameterized action ----

action_add("scale", [["input", ["X"]]], [["scaled", ["X"]]], [], 1)
rule_add("input", ["5"], [])
let plan2 = plan([["scaled", ["5"]]])
print("=== Demo 2: contract-guarded parameterized plan ===")
print("plan: " + plan2)

let passing_clauses = [["require", "X", "<", "10"]]
let synth2_ok = synthesize_program(plan2, snippet_dict_patlang(), passing_clauses)
print("--- passing contract (X=5 < 10): " + synth2_ok[0] + " ---")
print(synth2_ok[1])

rule_add("input", ["15"], [])
let plan3 = plan([["scaled", ["15"]]])
let failing_clauses = [["require", "X", "<", "10"]]
let synth2_bad = synthesize_program(plan3, snippet_dict_patlang(), failing_clauses)
print("--- violating contract (X=15, require X < 10): " + synth2_bad[0] + " ---")
print(synth2_bad[1])

print("=== DONE ===")
print("Open question NOT answered by this prototype: whether a snippet's")
print("interface (declared inputs/outputs) needs to be checked at assembly")
print("time, vs. just trusting adjacent steps' variable names to line up")
print("by convention (as demo 1 does, informally, via the shared name")
print("\"wood\"). A real system would want that declared and validated --")
print("this prototype only proves the mechanism works when names already agree.")
