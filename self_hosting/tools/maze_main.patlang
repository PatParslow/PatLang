# Maze solver page (concatenate after lib/html.patlang + lib/maze.patlang).
# Usage: maze <output.html>
# Renders a curated maze, solved via facts + a goal-announced recursive DFS,
# with solved/unsolved reported through events - logic, goal-oriented,
# functional recursion and events in one runnable page. No rustc: this is
# meant to be run directly via `pat --ir-run`, matching the rest of the
# self-hosted dev tooling.

let args = argv()
let output = "portfolio/maze.html"
if args.length >= 1 then
  let output = args[0]
end

let grid = [
  "S.#........",
  "..#.#####.#",
  "..#.#...#.#",
  ".##.#.###.#",
  "....#.#...#",
  "###.#.#.###",
  "#...#.#.#..",
  "#.###.#.#.#",
  "#.....#...#",
  "#####.###.#",
  "#.........E"
]

when solved do
  set_var("mz_result", event_data)
end
when unsolved do
  set_var("mz_result", "no path found (" + event_data + ")")
end

set_var("mz_result", "")
let path = solve_maze(grid)

let body = sb_new()
sb_push(body, "<h1>PatLang maze solver</h1>" + nl())
sb_push(body, "<p>The grid is compiled into <code>open</code> facts, a <code>solve</code> goal announces intent, a recursive depth-first search does the work using <code>query</code> to check the facts, and a <code>solved</code>/<code>unsolved</code> event reports the outcome. Logic, goal-oriented, functional recursion, and events, in one page.</p>" + nl())
sb_push(body, maze_css())
sb_push(body, render_maze_grid(grid, path))
sb_push(body, "<p>" + html_escape(get("__vars", "mz_result")) + "</p>" + nl())
sb_push(body, "<h2>Source</h2>" + nl())
sb_push(body, "<pre>" + html_escape(read_file("self_hosting/lib/maze.patlang")) + "</pre>" + nl())

let page = html_page("PatLang maze solver", sb_str(body), "")
write_file(output, page)
print("[maze] " + path.length + " step path -> " + output)
