# PEG grammar-conformance checker CLI. See ../lib/peg.patlang for the
# engine and the "PEG shared-grammar validator" plan for why this is a
# validation-only proof-of-concept (Slice 1's deliberately small grammar
# subset), not a parser replacement.
#
# Usage (run from the repo root):
#   pat --ir-run self_hosting/tools/peg_check_main.patlang <file.patlang>

include "../lib/lexer.patlang"
include "../lib/peg.patlang"

make a function called peg_main_grammar_path returns path
  return "docs/grammar/patlang-slice1.peg"
end

make a function called peg_main_run returns done
  let args = argv()
  if args.length < 1 then
    print("usage: peg_check_main <file.patlang>")
    return false
  end
  let file = args[0]
  let grammar_source = read_file(peg_main_grammar_path())
  let rules = peg_load_grammar(grammar_source)
  let source = read_file(file)
  let toks = tokenize(source)
  let ok = peg_accepts(rules, "Program", toks)
  if ok then
    print("ACCEPT: " + file + " conforms to the Slice 1 grammar")
  else
    print("REJECT: " + file + " does not conform to the Slice 1 grammar")
    print("(this may mean the file uses a construct outside the Slice 1 subset -- see docs/grammar/patlang-slice1.peg's header -- not necessarily a real syntax error)")
  end
  return ok
end

peg_main_run()
