# =============================================================================
# Publishes PatLang's per-example fragment pages (portfolio/demos/*.html,
# written by build_portfolio.patlang) into parslow.net's real content
# source directory, and updates site-manifest.json's topic-6-patlang
# articles list to match -- closing the gap left by the old
# tools/build_site.patlang, which wrote directly into publish/ (the site's
# BUILD OUTPUT) and got silently overwritten every time the real generator
# (tools/site/build.py, driven by content/pages/ + site-manifest.json) ran.
# build_site.patlang is retired; this tool is its replacement for the
# publishing role. It does NOT run tools/site/build.py itself, and does NOT
# push/deploy anything -- it only updates content/pages/ and
# site-manifest.json in the working tree, for review before the real site
# build + deploy happens separately.
#
# Does not touch the 4 standalone mini-apps (patlang-ide/maze/flow-graphs/
# report) -- those keep their existing raw-fragment/full-document form and
# existing manifest entries untouched (tools/site/build.py's
# PATLANG_STANDALONE_SLUGS keeps their raw-fragment bypass).
#
# Run from the repo root, AFTER build_portfolio.patlang:
#   rust-runtime/target/release/pat --ir-run self_hosting/tools/publish_patlang_pages.patlang
# =============================================================================

let SITE_ROOT = "D:/Projects_Organized/parslow-soft-editorial/"
let CONTENT_DIR = SITE_ROOT + "content/pages/topics/patlang/"
let MANIFEST_PATH = SITE_ROOT + "site-manifest.json"

# (portfolio/demos slug, article slug (site-wide, "patlang-" prefixed to
# match the existing patlang-ide/patlang-maze/... convention), title)
let PAGES = [
  ["feature", "patlang-feature-demo", "PatLang All Paradigms Demo"],
  ["bench", "patlang-self-timing-benchmark", "PatLang Self-Timing Benchmark"],
  ["playground", "patlang-live-playground", "PatLang Live Playground"],
  ["repl", "patlang-repl", "PatLang Live REPL"],
  ["pos", "patlang-point-of-sale", "PatLang Point of Sale Demo"],
  ["postests", "patlang-bdd-framework", "PatLang BDD Framework"],
  ["contracts", "patlang-design-by-contract", "PatLang Design by Contract"],
  ["towerdemo", "patlang-numeric-tower", "PatLang Numeric Tower"],
  ["routerdsl", "patlang-router-dsl", "PatLang Router DSL"],
  ["dynsyntax", "patlang-dynamic-syntax", "PatLang Dynamic Syntax"],
  ["report-writer", "patlang-report-writer", "PatLang Project Report Writer"],
  ["patbuild", "patlang-patbuild", "PatLang Patbuild"],
  ["flowgraph-demo", "patlang-flowgraph-demo", "PatLang Flow Graph Generator"],
  ["gui", "patlang-gui-generator", "PatLang Browser GUI Generator"],
  ["compiler-metrics", "patlang-compiler-metrics", "PatLang Compiler Self-Metrics"],
  ["ruby-transpile", "patlang-ruby-transpilation", "PatLang Ruby Transpilation"],
  ["maze", "patlang-maze", "PatLang Maze"],
  ["ide", "patlang-ide", "PatLang IDE"],
  ["flowgraph", "patlang-flow-graphs", "PatLang Flow Graphs"],
  ["threading", "patlang-threading", "PatLang Real OS Threads"],
  ["fiber", "patlang-fibers", "PatLang Fibers"]
]

# ---- 1. copy each fragment into the site's real content directory ----

let i = 0
while i < PAGES.length do
  let p = PAGES[i]
  let src_path = "portfolio/demos/" + p[0] + ".html"
  let dst_path = CONTENT_DIR + p[1] + ".html"
  let frag = read_file(src_path)
  write_file(dst_path, frag)
  print("published " + dst_path)
  let i = i + 1
end

# ---- 2. rewrite site-manifest.json's topic-6-patlang articles list ----
# Targeted string replacement (find the exact known block, replace it),
# not a full JSON parse/reserialize -- the manifest is a large, hand-
# maintained file covering many unrelated topics; reserializing all of it
# risks reformatting/reordering content this tool has no business touching.
# Mirrors the same find_substr/replace_first anchor-patching technique
# already used (and proven) by the now-retired build_site.patlang.

make a function called find_substr takes hay, needle returns idx
  if needle.length == 0 then
    return 0
  end
  let i = 0
  while i <= (hay.length - needle.length) do
    if substr(hay, i, needle.length) == needle then
      return i
    end
    let i = i + 1
  end
  return -1
end

make a function called replace_first takes hay, needle, repl returns out
  let idx = find_substr(hay, needle)
  if idx < 0 then
    print("ERROR: manifest patch anchor not found -- site-manifest.json's topic-6-patlang shape changed since this tool was written. Aborting the manifest edit (fragments above were still published).")
    return hay
  end
  return substr(hay, 0, idx) + repl + substr(hay, idx + needle.length, hay.length - idx - needle.length)
end

# site-manifest.json uses CRLF line endings -- built explicitly via
# chr(13)+chr(10) rather than embedded literal newlines in a multi-line
# string literal (which would be LF-only and silently fail to match).
make a function called crlf returns s
  return chr(13) + chr(10)
end

make a function called article_line takes slug, title, is_last returns s
  let comma = ","
  if is_last then
    let comma = ""
  end
  let b = sb_new()
  sb_push(b, "        {" + crlf())
  sb_push(b, "          \"slug\": \"" + slug + "\"," + crlf())
  sb_push(b, "          \"title\": \"" + title + "\"," + crlf())
  sb_push(b, "          \"file\": \"" + slug + ".html\"" + crlf())
  sb_push(b, "        }" + comma + crlf())
  return sb_str(b)
end

# Two possible starting states this tool might find the manifest in:
# the ORIGINAL 5-entry block (first-ever run), or this tool's own
# previously-written output (a re-run, e.g. after report.html was
# retired and patlang-report dropped from the standalone set) -- try
# each in turn so re-running this tool stays idempotent either way.
let ob_first = sb_new()
sb_push(ob_first, "      \"articles\": [" + crlf())
sb_push(ob_first, article_line("patlang-portfolio", "PatLang Portfolio", false))
sb_push(ob_first, article_line("patlang-flow-graphs", "PatLang Flow Graphs", false))
sb_push(ob_first, article_line("patlang-ide", "PatLang IDE", false))
sb_push(ob_first, article_line("patlang-maze", "PatLang Maze", false))
sb_push(ob_first, article_line("patlang-report", "PatLang Report", true))
sb_push(ob_first, "      ]")
let old_articles_first_run = sb_str(ob_first)

# Frozen snapshot of the PAGES list as it was for the previous run of this
# tool (before maze/ide/flowgraph were converted to fragment mode and
# folded into PAGES itself) -- used only to reconstruct what the manifest
# currently looks like, so it can be found and replaced. Do not add new
# pages here; add them to PAGES above instead.
let PAGES_PREV_RUN = [
  ["feature", "patlang-feature-demo", "PatLang All Paradigms Demo"],
  ["bench", "patlang-self-timing-benchmark", "PatLang Self-Timing Benchmark"],
  ["playground", "patlang-live-playground", "PatLang Live Playground"],
  ["pos", "patlang-point-of-sale", "PatLang Point of Sale Demo"],
  ["postests", "patlang-bdd-framework", "PatLang BDD Framework"],
  ["contracts", "patlang-design-by-contract", "PatLang Design by Contract"],
  ["towerdemo", "patlang-numeric-tower", "PatLang Numeric Tower"],
  ["routerdsl", "patlang-router-dsl", "PatLang Router DSL"],
  ["dynsyntax", "patlang-dynamic-syntax", "PatLang Dynamic Syntax"],
  ["report-writer", "patlang-report-writer", "PatLang Project Report Writer"],
  ["patbuild", "patlang-patbuild", "PatLang Patbuild"],
  ["flowgraph-demo", "patlang-flowgraph-demo", "PatLang Flow Graph Generator"],
  ["gui", "patlang-gui-generator", "PatLang Browser GUI Generator"],
  ["compiler-metrics", "patlang-compiler-metrics", "PatLang Compiler Self-Metrics"],
  ["ruby-transpile", "patlang-ruby-transpilation", "PatLang Ruby Transpilation"]
]

let ob_prev = sb_new()
sb_push(ob_prev, "      \"articles\": [" + crlf())
let j0 = 0
while j0 < PAGES_PREV_RUN.length do
  let p = PAGES_PREV_RUN[j0]
  sb_push(ob_prev, article_line(p[1], p[2], false))
  let j0 = j0 + 1
end
sb_push(ob_prev, article_line("patlang-maze", "PatLang Maze", false))
sb_push(ob_prev, article_line("patlang-ide", "PatLang IDE", false))
sb_push(ob_prev, article_line("patlang-flow-graphs", "PatLang Flow Graphs", true))
sb_push(ob_prev, "      ]")
let old_articles_prev_run = sb_str(ob_prev)

# All 18 PAGES now, no separate standalone/legacy block at all -- every
# topic-6-patlang article is fragment mode.
let nb = sb_new()
sb_push(nb, "      \"articles\": [" + crlf())
let j = 0
while j < PAGES.length do
  let p = PAGES[j]
  let is_last = (j == (PAGES.length - 1))
  sb_push(nb, article_line(p[1], p[2], is_last))
  let j = j + 1
end
sb_push(nb, "      ]")
let new_articles = sb_str(nb)

let old_articles = old_articles_prev_run
if find_substr(read_file(MANIFEST_PATH), old_articles_prev_run) < 0 then
  let old_articles = old_articles_first_run
end

let manifest = read_file(MANIFEST_PATH)
let manifest = replace_first(manifest, old_articles, new_articles)
write_file(MANIFEST_PATH, manifest)
print("updated " + MANIFEST_PATH)
print("done. Fragments published and manifest updated. Run tools/site/build.py to regenerate publish/ when ready (not run automatically by this tool).")
