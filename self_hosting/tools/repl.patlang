# A PatLang REPL. Built entirely in PatLang -- no new Rust host functions --
# on top of the same self-hosted compiler pipeline the playground already
# uses (self_hosting/lib/lexer.patlang's tokenize, lib/parser.patlang's
# parse_program, lib/lower.patlang's lower_program, and the run_ir host
# function). See self_hosting/lib/repl_core.patlang for the classification/
# session-buffer logic and its header comment for the one real honest
# limitation of this design (top-level `let`s with side-effecting
# right-hand sides re-run every subsequent turn).
#
# Run:
#   pat --ir-run self_hosting/tools/repl.patlang
#
# Each entry can span multiple lines (needed for `make a function called
# ... end` and other block forms) -- finish an entry with a BLANK line to
# evaluate it. A blank line typed with nothing else pending exits the REPL
# (also how EOF, e.g. piped input running out, naturally ends a session).
#
# A syntax error is recoverable -- the self-hosted parser returns an
# ["Err", message] AST node rather than aborting, so a typo just reports
# "parse error: ..." and re-prompts, the input is discarded, nothing is
# persisted. A genuine RUNTIME error (calling an undefined function,
# dividing by a type that can't divide, a bad host call) is still fatal --
# PatLang has no try/catch anywhere, and this REPL doesn't change that. That
# faithfully reflects how the language actually behaves; it isn't a REPL bug.

include "../lib/includes.patlang"
include "../lib/repl_core.patlang"
include "../lib/lexer.patlang"
include "../lib/parser.patlang"
include "../lib/lower.patlang"

make a function called repl_read_entry returns entry
  let chunk = ""
  let looping = true
  let result = ""
  while looping do
    let line = read_line()
    if line == "" then
      if chunk == "" then
        let result = chr(0)
        let looping = false
      else
        let result = chunk
        let looping = false
      end
    else
      let chunk = chunk + line + chr(10)
    end
  end
  return result
end

make a function called repl_run returns done
  print("PatLang REPL. Multi-line entries end with a blank line; a blank line alone exits.")
  let session_buffer = ""
  let running = true
  while running do
    print("")
    print("patlang>")
    let entry = repl_read_entry()
    if entry == chr(0) then
      let running = false
    else
      let is_decl = repl_is_declaration(entry)
      let candidate = repl_build_candidate(session_buffer, entry, is_decl)
      let toks = tokenize(candidate)
      let ast = parse_program(toks)
      let stmts = ast[1]
      let err = parse_find_error(stmts)
      if err[0] != "" then
        print(format_parse_error(err[0], err[1], candidate))
      else
        let ir = lower_program(ast)
        run_ir(ir)
        if is_decl then
          let session_buffer = session_buffer + entry + chr(10)
        end
      end
    end
  end
  print("bye")
  return true
end

repl_run()
