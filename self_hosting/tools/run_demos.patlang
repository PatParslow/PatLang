# The demo programs (demos/NN_name.patlang), or the showcase programs
# (showcase/NAME.patlang), each run interpreted and compiled, and both outputs
# compared with DIR/expected/NAME.txt.
#
# Usage, from the repository root:
#   self_hosting/build/v2_interp.exe self_hosting/tools/run_demos.patlang [--dir DIR] [--linux] [--list] [PROGRAM...]
#
# --dir names the directory, demos when it is not given. With --list, the
# programs' paths, one a line, and nothing run. With paths, only those run;
# with none, all of them. --linux runs the compiled program as a Linux build
# under WSL. Exits with 1 when one failed. The gates run each as a unit of its
# own (demos/NAME, showcase/NAME in self_hosting/v2/tools/gates.patlang).
#
# The demos are the list below, which the repository checks keep complete; any
# other directory's programs are every .patlang file directly in it. A program
# with DIR/expected/NAME.constant_time.txt is also given to the compiler's
# --constant-time check, whose report and verdict must be that file's.

include "../lib/includes.patlang"
include "../lib/gherkin_text.patlang"
include "../lib/v2_engines.patlang"
include "../lib/program_run.patlang"

make a function called demo_programs returns paths
  return [
    "demos/01_imperative_and_functional.patlang",
    "demos/02_objects_and_events.patlang",
    "demos/03_logic_and_goals.patlang",
    "demos/04_concurrency.patlang",
    "demos/05_files_and_vfs.patlang",
    "demos/06_networking_and_signals.patlang",
    "demos/07_bakery_all_paradigms.patlang"
  ]
end

# The programs of a directory: the demos' list, or the .patlang files in it.
make a function called dir_programs takes dir returns paths
  if dir == "demos" then
    return demo_programs()
  end
  let paths = []
  let entries = list_dir(dir)
  let i = 0
  while i < list_len(entries) do
    if str_ends_with(entries[i], ".patlang") then
      let paths = list_push(paths, dir + "/" + entries[i])
    end
    let i = i + 1
  end
  return paths
end

# DIR/NAME.patlang's name without directory or extension.
make a function called demo_name takes path returns name
  let file = path_basename(path)
  return substr(file, 0, file.length - 8)
end

# Text as its lines joined by newlines, so a file checked out with either line
# ending compares equal to what a program printed.
make a function called demo_lines takes text returns out
  return str_join(split_lines(text), chr(10))
end

make a function called demo_check takes path, engine, result, expected returns ok
  if not result[0] then
    print("  FAIL: " + path + " (" + engine + ") did not exit 0")
    print(result[1])
    return false
  end
  if demo_lines(result[1]) != expected then
    print("  FAIL: " + path + " (" + engine + ") printed")
    print(result[1])
    print("  expected")
    print(expected)
    return false
  end
  print("  ok: " + path + " (" + engine + ")")
  return true
end

# The compiler's --constant-time check of the program, against the report
# DIR/expected/NAME.constant_time.txt holds: a report naming an error is a
# refusal, and the check must refuse exactly then.
make a function called constant_time_check takes path, wanted returns ok
  let expected = demo_lines(read_file(wanted))
  let r = v2_compile([path, "--constant-time"])
  let got = demo_lines(r[0])
  let refused = str_contains(expected, "v2 error")
  if (got != expected) or (r[1] == refused) then
    print("  FAIL: " + path + " (constant-time check) reported")
    print(r[0])
    print("  expected")
    print(expected)
    return false
  end
  print("  ok: " + path + " (constant-time check)")
  return true
end

make a function called run_demo takes dir, path, linux returns ok
  let name = demo_name(path)
  let wanted = dir + "/expected/" + name + ".txt"
  if not file_exists(wanted) then
    print("  FAIL: " + path + " has no " + wanted)
    return false
  end
  let expected = demo_lines(read_file(wanted))
  let a = demo_check(path, "interpreted", run_interpreted(path), expected)
  if linux then
    let b = demo_check(path, "Linux", run_compiled_linux(path, spec_out() + "/demo_" + name), expected)
  else
    let b = demo_check(path, "compiled", run_compiled(path, spec_out() + "/demo_" + name + ".exe"), expected)
  end
  let c = true
  let ct = dir + "/expected/" + name + ".constant_time.txt"
  if file_exists(ct) == true then
    let c = constant_time_check(path, ct)
  end
  return a and b and c
end

make a function called demos_main takes args returns ok
  # the options first: --dir DIR and --linux
  let dir = "demos"
  let linux = false
  let rest = []
  let i = 0
  while i < list_len(args) do
    if (args[i] == "--dir") and (i + 1 < list_len(args)) then
      let dir = args[i + 1]
      let i = i + 1
    elif args[i] == "--linux" then
      let linux = true
    else
      let rest = list_push(rest, args[i])
    end
    let i = i + 1
  end
  let all = dir_programs(dir)
  let chosen = []
  let i = 0
  while i < list_len(rest) do
    if rest[i] == "--list" then
      let k = 0
      while k < list_len(all) do
        print(all[k])
        let k = k + 1
      end
      return true
    end
    let j = 0
    while j < list_len(all) do
      if all[j] == rest[i] then
        let chosen = list_push(chosen, all[j])
      end
      let j = j + 1
    end
    let i = i + 1
  end
  if (list_len(rest) > 0) and (list_len(chosen) == 0) then
    print("no program named " + str_join(rest, " ") + " in " + dir)
    exit_with(1)
  end
  if list_len(chosen) == 0 then
    let chosen = all
  end
  let pass_count = 0
  let fail_count = 0
  let d = 0
  while d < list_len(chosen) do
    if run_demo(dir, chosen[d], linux) then
      let pass_count = pass_count + 1
    else
      let fail_count = fail_count + 1
    end
    let d = d + 1
  end
  print("tests: " + pass_count + " passed, " + fail_count + " failed")
  if fail_count > 0 then
    exit_with(1)
  end
  return true
end

demos_main(argv())
