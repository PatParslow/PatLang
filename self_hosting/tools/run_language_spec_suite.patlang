# GitHub #49: standing regression gate running spec_library/language/*.feature
# through the REAL executable Gherkin runner (self_hosting/lib/test.patlang),
# not just reading as prose. Mirrors run_synthesis_selftests.patlang's own
# pattern (include the framework, register/run, t_report at the end) applied
# to the language spec suite instead of the synthesis selftest suite.
#
# Usage: rust-runtime/target/release/pat.exe --ir-run
#        self_hosting/tools/run_language_spec_suite.patlang
#
# Currently wires: arithmetic_operators, bitwise_operators, comparison_operators
# (spec_library/language/) -- prioritized first because they match this
# session's own tag-collision bug pattern (#24/#46/#48). Remaining
# spec_library/language/*.feature files are backlog; add their step
# registrations to spec_steps_language.patlang (or a sibling file) and list
# the .feature path below as each batch is wired.

include "../lib/test.patlang"
include "../lib/spec_steps_language.patlang"

t_init()
register_language_arith_bitwise_cmp_steps()
register_language_control_flow_steps()
register_language_bindings_closures_oo_steps()
register_language_fn_obj_list_print_steps()
register_language_contracts_include_delims_events_steps()
register_language_logic_goap_contracts_steps()
register_language_host_primitives_steps()

let features = [
  "spec_library/language/arithmetic_operators.feature",
  "spec_library/language/bitwise_operators.feature",
  "spec_library/language/comparison_operators.feature",
  "spec_library/language/if_elif_else.feature",
  "spec_library/language/while_loop.feature",
  "spec_library/language/logical_operators.feature",
  "spec_library/language/let_binding.feature",
  "spec_library/language/closures.feature",
  "spec_library/language/class_inheritance.feature",
  "spec_library/language/traits_composition.feature",
  "spec_library/language/function_definition_and_return.feature",
  "spec_library/language/member_assignment.feature",
  "spec_library/language/new_send_get_basic.feature",
  "spec_library/language/send_method_dispatch.feature",
  "spec_library/language/list_string_literals_indexing.feature",
  "spec_library/language/print_statement.feature",
  "spec_library/language/require_ensure_assert.feature",
  "spec_library/language/include_directive.feature",
  "spec_library/language/alternate_block_delimiters.feature",
  "spec_library/language/when_emit.feature",
  "spec_library/language/action_add_plan.feature",
  "spec_library/language/rule_add_solve.feature",
  "spec_library/language/rule_declaration_sugar.feature",
  "spec_library/language/fact_query.feature",
  "spec_library/language/goal_pursue_activate.feature",
  "spec_library/language/contract_holds_is_queryable.feature",
  "spec_library/language/gherkin_contracts.feature",
  "spec_library/language/tcp_networking_round_trip.feature",
  "spec_library/language/tcp_close_teardown.feature",
  "spec_library/language/signals_claim_and_poll.feature",
  "spec_library/language/sql_engine_end_to_end.feature",
  "spec_library/language/sql_test_environment_isolation.feature",
  "spec_library/language/message_queue.feature",
  "spec_library/language/task_registry_beacon.feature"
]

let i = 0
let n = to_num(list_len(features))
while i < n do
  run_feature_file(list_get(features, i))
  let i = i + 1
end

t_report()
