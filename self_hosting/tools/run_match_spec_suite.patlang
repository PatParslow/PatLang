# Issue #44: standing regression gate for match/case, run through the
# executable Gherkin runner (self_hosting/lib/gherkin.patlang). Each scenario
# carries its program and runs it on both engines (spec_steps_program.patlang).
#
# Usage (from the repo root):
#   self_hosting/build/v2_interp.exe self_hosting/tools/run_match_spec_suite.patlang [FEATURE[@N]] [--list]

include "../lib/gherkin.patlang"
include "../lib/spec_steps_program.patlang"

let ctx = ctx_new()
register_program_steps(ctx)
run_suite(ctx, ["spec_library/language/match_pattern.feature"], argv())
