# Issue #44: standing regression gate for match/case, run through the
# executable Gherkin runner (self_hosting/lib/gherkin.patlang).
#
# Usage (from the repo root):
#   rust-runtime/target/release/pat.exe --ir-run self_hosting/tools/run_match_spec_suite.patlang
# or build it with self_hosting/v2/compile.patlang and run the executable, or
# run it on self_hosting/build/v2_interp.exe.

include "../lib/gherkin.patlang"
include "../lib/spec_steps_match.patlang"

let ctx = ctx_new()
register_language_match_steps(ctx)
run_feature_file(ctx, "spec_library/language/match_pattern.feature")
ctx_report(ctx)
