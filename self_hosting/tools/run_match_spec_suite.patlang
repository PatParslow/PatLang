# Issue #44: standing regression gate for match/case, run through the real
# executable Gherkin runner (self_hosting/lib/test.patlang), mirroring
# run_language_spec_suite.patlang's own pattern -- except this one MUST be
# run through the self-hosted toolchain (patc1.exe), never through native
# `pat.exe --ir-run`: self_hosting/lib/spec_steps_match.patlang genuinely
# contains `match` statements, and native pat.exe has no idea what `match`
# means (deliberately -- see the issue #44 follow-up plan's "PatLang is
# canon, not Rust" directive; v1 scope explicitly excludes rust-runtime/).
#
# Usage (from the repo root):
#   ./patc1.exe lower self_hosting/tools/run_match_spec_suite.patlang /tmp/match_suite.ir
#   ./patc1.exe interpret /tmp/match_suite.ir
# or compile it to a real native binary the same way and run that binary.

include "../lib/test.patlang"
include "../lib/spec_steps_match.patlang"

t_init()
register_language_match_steps()

run_feature_file("spec_library/language/match_pattern.feature")

t_report()
