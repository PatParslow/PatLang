# The strict-names check (review, test-suite recommendation 4): every program a
# gate runs as a whole (the demos and the selftests) calls only names that it or
# the runtime declares. A call of a name nothing declares compiles, and stops
# the program only when reached, so a typo, or a function only the old engines
# had, waits in a path a test does not take: lean_run.patlang's lean_eval_expr
# called to_str and random_int, which v2 has neither of.
#
# Usage, from the repository root:
#   self_hosting/build/v2_interp.exe self_hosting/tools/run_names_check.patlang [--list] [PROGRAM...]
#
# With --list, the programs' paths, one a line. With paths, each is checked with
# `v2.exe PROGRAM --names`; with none, all of them. Exits with 1 when a program
# calls a name nothing declares. The gates run each as a unit of its own
# (names/NAME in self_hosting/v2/tools/gates.patlang).

include "../lib/includes.patlang"
include "../lib/v2_engines.patlang"

# The demos, and the selftests run_selftests.patlang runs.
make a function called names_programs returns paths
  let out = []
  let demos = list_dir("demos")
  let i = 0
  while i < list_len(demos) do
    if str_ends_with(demos[i], ".patlang") then
      let out = list_push(out, "demos/" + demos[i])
    end
    let i = i + 1
  end
  let r = exec_capture_io(program_path(), ["self_hosting/tools/run_selftests.patlang", "--list"], "", 0)
  let lines = split_lines(r[0])
  let i = 0
  while i < list_len(lines) do
    let l = str_trim(lines[i])
    if str_ends_with(l, ".patlang") then
      let out = list_push(out, l)
    end
    let i = i + 1
  end
  return out
end

make a function called names_check takes path returns ok
  let r = v2_compile([path, "--names"])
  if r[1] then
    print("  ok: " + path + " calls only what is declared")
    return true
  end
  print("  FAIL: " + path + ": " + str_trim(r[0]))
  return false
end

make a function called names_main takes args returns ok
  if (list_len(args) == 1) and (args[0] == "--list") then
    let all = names_programs()
    let k = 0
    while k < list_len(all) do
      print(all[k])
      let k = k + 1
    end
    return true
  end
  let chosen = args
  if list_len(chosen) == 0 then
    let chosen = names_programs()
  end
  let passed = 0
  let failed = 0
  let i = 0
  while i < list_len(chosen) do
    if names_check(chosen[i]) then
      let passed = passed + 1
    else
      let failed = failed + 1
    end
    let i = i + 1
  end
  print("tests: " + passed + " passed, " + failed + " failed")
  if failed > 0 then
    exit_with(1)
  end
  return true
end

names_main(argv())
