# Runs ONE spec_library/language feature through the same Gherkin runner and step
# registrations as run_language_spec_suite.patlang, for per-issue verification
# while the full gate (about 23 minutes) is reserved for the pre-commit check.
#
# Usage (from the repo root):
#   rust-runtime/target/release/pat.exe --ir-run \
#     self_hosting/tools/run_one_language_feature.patlang \
#     spec_library/language/<name>.feature <register_fn>[,<register_fn>...]

include "../lib/test.patlang"
include "../lib/spec_steps_language.patlang"

t_init()

let args = argv()
let feature = list_get(args, 0)
let names = list_get(args, 1)
let start = 0
let i = 0
while i <= names.length do
  if (i == names.length) or (substr(names, i, 1) == ",") then
    apply(substr(names, start, i - start))
    let start = i + 1
  end
  let i = i + 1
end
run_feature_file(feature)
t_report()
