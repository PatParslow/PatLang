make a function called run_selftest takes name, path returns ok
  let r = exec_measured("self_hosting/build/v2_interp.exe", [path])
  let passed = r[2] and contains_text(r[0], "ALL TESTS PASSED")
  if passed then
    print("  ok: " + name)
  else
    print("  FAIL: " + name + " (" + path + ")")
    print(r[0] + r[1])
  end
  return passed
end

make a function called selftests_main takes args returns ok
  let suites = selftest_suites()
  let chosen = []
  let i = 0
  while i < list_len(args) do
    if args[i] == "--list" then
      let k = 0
      while k < list_len(suites) do
        print(suites[k][1])
        let k = k + 1
      end
      return true
    end
    if args[i] == "--retired" then
      let retired = retired_selftests()
      let k = 0
      while k < list_len(retired) do
        print(retired[k][0] + chr(9) + retired[k][1])
        let k = k + 1
      end
      return true
    end
    let k = 0
    while k < list_len(suites) do
      if suites[k][1] == args[i] then
        let chosen = list_push(chosen, suites[k])
      end
      let k = k + 1
    end
    let i = i + 1
  end
  if (list_len(args) > 0) and (list_len(chosen) == 0) then
    print("no selftest named " + str_join(args, " "))
    exit_with(1)
  end
  if list_len(chosen) == 0 then
    let chosen = suites
  end
  print("Running " + list_len(chosen) + " selftests...")
  let pass_count = 0
  let fail_count = 0
  let i = 0
  while i < list_len(chosen) do
    if run_selftest(chosen[i][0], chosen[i][1]) then
      let pass_count = pass_count + 1
    else
      let fail_count = fail_count + 1
    end
    let i = i + 1
  end
  print("")
  print("suites: " + pass_count + " passed, " + fail_count + " failed")
  if fail_count > 0 then
    print("SELFTESTS FAILED")
    exit_with(1)
  end
  print("ALL SELFTESTS PASSED")
  return true
end

selftests_main(argv())
