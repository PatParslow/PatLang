# The showcase's comparison sketches (showcase/compare/NAME.py), each run and
# its output compared: with showcase/compare/expected/NAME.txt when the sketch
# stops short of what the PatLang program does, else with the program's own
# showcase/expected/NAME.txt.
#
# Usage, from the repository root:
#   self_hosting/build/v2_interp.exe self_hosting/tools/run_showcase_compare.patlang [--list] [SKETCH...]
#
# With --list, the sketches' paths, one a line, and nothing run. With paths,
# only those run; with none, all of them. A sketch's language must be on the
# machine: without it the sketch fails, naming the program it needs. Exits
# with 1 when one failed. The gates run each as a unit of its own
# (showcase_compare/NAME in self_hosting/v2/tools/gates.patlang).

include "../lib/includes.patlang"
include "../lib/gherkin_text.patlang"
include "../lib/v2_engines.patlang"
include "../lib/program_run.patlang"

make a function called sketch_paths returns paths
  let paths = []
  let entries = list_dir("showcase/compare")
  let i = 0
  while i < list_len(entries) do
    if str_ends_with(entries[i], ".py") then
      let paths = list_push(paths, "showcase/compare/" + entries[i])
    end
    let i = i + 1
  end
  return paths
end

# Text as its lines joined by newlines, so CRLF and LF compare equal.
make a function called sketch_lines takes text returns out
  return str_join(split_lines(text), chr(10))
end

make a function called sketch_name takes path returns name
  let file = path_basename(path)
  return substr(file, 0, file.length - 3)
end

make a function called run_sketch takes path returns ok
  let name = sketch_name(path)
  let own = "showcase/compare/expected/" + name + ".txt"
  let wanted = "showcase/expected/" + name + ".txt"
  if file_exists(own) == true then
    let wanted = own
  end
  if not (file_exists(wanted) == true) then
    print("  FAIL: " + path + " has no " + wanted)
    return false
  end
  if not has_program("py") then
    print("  FAIL: " + path + " needs py (the Python launcher), which is not on the PATH")
    return false
  end
  let r = exec_capture_io("py", ["-3", "-I", path], "", 0)
  if not r[2] then
    print("  FAIL: " + path + " did not exit 0")
    print(r[0] + r[1])
    return false
  end
  let expected = sketch_lines(read_file(wanted))
  if sketch_lines(r[0]) != expected then
    print("  FAIL: " + path + " printed")
    print(r[0])
    print("  expected (" + wanted + ")")
    print(expected)
    return false
  end
  print("  ok: " + path)
  return true
end

make a function called compare_main takes args returns ok
  let all = sketch_paths()
  let chosen = []
  let i = 0
  while i < list_len(args) do
    if args[i] == "--list" then
      let k = 0
      while k < list_len(all) do
        print(all[k])
        let k = k + 1
      end
      return true
    end
    let j = 0
    while j < list_len(all) do
      if all[j] == args[i] then
        let chosen = list_push(chosen, all[j])
      end
      let j = j + 1
    end
    let i = i + 1
  end
  if (list_len(args) > 0) and (list_len(chosen) == 0) then
    print("no sketch named " + str_join(args, " "))
    exit_with(1)
  end
  if list_len(chosen) == 0 then
    let chosen = all
  end
  let pass_count = 0
  let fail_count = 0
  let d = 0
  while d < list_len(chosen) do
    if run_sketch(chosen[d]) then
      let pass_count = pass_count + 1
    else
      let fail_count = fail_count + 1
    end
    let d = d + 1
  end
  print("tests: " + pass_count + " passed, " + fail_count + " failed")
  if fail_count > 0 then
    exit_with(1)
  end
  return true
end

compare_main(argv())
