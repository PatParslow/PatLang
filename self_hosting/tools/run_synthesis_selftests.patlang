# PatLang-native test runner for the inductive-synthesis engine's selftest
# suite (self_hosting/synthesis_*_selftest.patlang) -- runs every suite
# and reports pass/fail, with no dependency on `cargo test`/cucumber. The
# suites used to be wired into rust-runtime/tests/bdd.rs's
# given_selftest_suite + "I run it interpreted"/"the self-hosted suite
# reports all tests passed" steps; this reproduces exactly that check
# (process succeeded AND stdout contains "ALL TESTS PASSED") in plain
# PatLang instead, so the whole synthesis engine can be exercised without
# building or running anything Rust-side beyond the base runtime itself.
#
# Usage: rust-runtime/target/release/pat.exe --ir-run
#        self_hosting/tools/run_synthesis_selftests.patlang
#
# (The base `pat` runtime is still what actually executes PatLang source
# -- that's unavoidable, the same way any language needs some runtime --
# what this removes is the cucumber/cargo-test indirection layered on top
# of it for this suite specifically.)

include "../lib/test.patlang"

make a function called run_suite takes name, path returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", path)
  let passed = contains_text(out, "ALL TESTS PASSED")
  if passed then
    print("  ok: " + name)
  else
    print("  FAIL: " + name)
    print(out)
  end
  return passed
end

let suites = [
  ["milestone 1: flat classification (toy digit classifier)", "self_hosting/synthesis_selftest.patlang"],
  ["milestone 1: router_dsl_demo reproduction", "self_hosting/synthesis_router_selftest.patlang"],
  ["milestone 2: recursive rule (goal_oriented_build_demo reproduction)", "self_hosting/synthesis_buildgraph_selftest.patlang"],
  ["milestone 3: conjunctive rule with distractor rejection", "self_hosting/synthesis_eligibility_selftest.patlang"],
  ["milestone 3: XOR-shaped examples correctly reported unsatisfiable", "self_hosting/synthesis_unsatisfiable_selftest.patlang"],
  ["real-demo reproduction: pos.patlang dairy-discount classification", "self_hosting/synthesis_pos_dairy_selftest.patlang"],
  ["milestone 4: multi-hop relational chain (grandparent benchmark)", "self_hosting/synthesis_grandparent_selftest.patlang"],
  ["milestone 5: bottom-up LGG induction with gap diagnosis", "self_hosting/synthesis_lgg_selftest.patlang"],
  ["milestone 5: gap diagnosis rendered as an actual question", "self_hosting/synthesis_lgg_report_selftest.patlang"],
  ["new domain: depth-1 chain (has_mentor)", "self_hosting/synthesis_mentor_selftest.patlang"],
  ["new domain: depth-3 chain (supply-chain traceability)", "self_hosting/synthesis_supplychain_selftest.patlang"],
  ["milestone 6: branching fact graphs (multiple children, a cycle, no_common_structure)", "self_hosting/synthesis_branching_selftest.patlang"],
  ["milestone 7: general anti-unification (chain + conjunctive filter, composed)", "self_hosting/synthesis_anti_unify_selftest.patlang"],
  ["milestone 8: disjunctive target concepts (two structurally unrelated clauses)", "self_hosting/synthesis_disjunctive_selftest.patlang"],
  ["milestone 8: three-way disjunction, scaling clustering past a single split", "self_hosting/synthesis_disjunctive_threeway_selftest.patlang"],
  ["milestone 9: batched hypothesis testing + two-strategy clustering comparison", "self_hosting/synthesis_batching_selftest.patlang"],
  ["milestone 10: genuine two-argument relations (bound chain endpoints)", "self_hosting/synthesis_relation_selftest.patlang"],
  ["milestone 11: two-ended relational joins (sibling via shared parent)", "self_hosting/synthesis_join_selftest.patlang"],
  ["stochastic BDD verification (tolerance-band checks for probabilistic rules)", "self_hosting/stochastic_bdd_selftest.patlang"]
]

print("Running inductive-synthesis selftest suite (" + list_len(suites) + " suites)...")
let mut pass_count = 0
let mut fail_count = 0
let i = 0
let n = to_num(list_len(suites))
while i < n do
  let entry = suites[i]
  if run_suite(entry[0], entry[1]) then
    pass_count = pass_count + 1
  else
    fail_count = fail_count + 1
  end
  let i = i + 1
end

print("")
print("suites: " + pass_count + " passed, " + fail_count + " failed")
if fail_count == 0 then
  print("ALL SYNTHESIS SUITES PASSED")
else
  print("SYNTHESIS SUITES FAILED")
end
