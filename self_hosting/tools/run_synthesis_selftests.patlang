# The synthesis engine's selftests (self_hosting/*synthesis*_selftest.patlang
# and the GOAP ones beside them), each run in a v2_interp process of its own.
# A suite passes when its process exits 0 and its output says "ALL TESTS
# PASSED".
#
# Usage, from the repository root:
#   self_hosting/build/v2_interp.exe self_hosting/tools/run_synthesis_selftests.patlang [--list] [SELFTEST...]
#
# With --list, the selftests' paths, one a line, and nothing run. With paths,
# only those selftests run; with none, all of them. Exits with 1 when a suite
# failed. The gates run each selftest as a unit of its own (synthesis/NAME in
# self_hosting/v2/tools/gates.patlang, docs/plans/gates.md).
#
# lean_goap_synthesis_selftest needs `lean` on the PATH, and
# synthesis_by_example_selftest needs `ruby`.

include "../lib/includes.patlang"
include "../lib/gherkin_text.patlang"

make a function called synthesis_suites returns suites
  return [
    ["milestone 1: flat classification (toy digit classifier)", "self_hosting/synthesis_selftest.patlang"],
    ["milestone 1: router_dsl_demo reproduction", "self_hosting/synthesis_router_selftest.patlang"],
    ["milestone 2: recursive rule (goal_oriented_build_demo reproduction)", "self_hosting/synthesis_buildgraph_selftest.patlang"],
    ["milestone 3: conjunctive rule with distractor rejection", "self_hosting/synthesis_eligibility_selftest.patlang"],
    ["milestone 3: XOR-shaped examples correctly reported unsatisfiable", "self_hosting/synthesis_unsatisfiable_selftest.patlang"],
    ["real-demo reproduction: pos.patlang dairy-discount classification", "self_hosting/synthesis_pos_dairy_selftest.patlang"],
    ["milestone 4: multi-hop relational chain (grandparent benchmark)", "self_hosting/synthesis_grandparent_selftest.patlang"],
    ["milestone 5: bottom-up LGG induction with gap diagnosis", "self_hosting/synthesis_lgg_selftest.patlang"],
    ["milestone 5: gap diagnosis rendered as an actual question", "self_hosting/synthesis_lgg_report_selftest.patlang"],
    ["new domain: depth-1 chain (has_mentor)", "self_hosting/synthesis_mentor_selftest.patlang"],
    ["new domain: depth-3 chain (supply-chain traceability)", "self_hosting/synthesis_supplychain_selftest.patlang"],
    ["milestone 6: branching fact graphs (multiple children, a cycle, no_common_structure)", "self_hosting/synthesis_branching_selftest.patlang"],
    ["milestone 7: general anti-unification (chain + conjunctive filter, composed)", "self_hosting/synthesis_anti_unify_selftest.patlang"],
    ["milestone 8: disjunctive target concepts (two structurally unrelated clauses)", "self_hosting/synthesis_disjunctive_selftest.patlang"],
    ["milestone 8: three-way disjunction, scaling clustering past a single split", "self_hosting/synthesis_disjunctive_threeway_selftest.patlang"],
    ["milestone 9: batched hypothesis testing + two-strategy clustering comparison", "self_hosting/synthesis_batching_selftest.patlang"],
    ["milestone 10: genuine two-argument relations (bound chain endpoints)", "self_hosting/synthesis_relation_selftest.patlang"],
    ["milestone 11: two-ended relational joins (sibling via shared parent)", "self_hosting/synthesis_join_selftest.patlang"],
    ["milestone 12: cross-entity attribute comparison (same class / different sex via neq)", "self_hosting/synthesis_attr_selftest.patlang"],
    ["stochastic BDD verification (tolerance-band checks for probabilistic rules)", "self_hosting/stochastic_bdd_selftest.patlang"],
    ["effect sandbox: a structural allow/deny gate on the search's Call dispatch", "self_hosting/synthesis_effect_sandbox_selftest.patlang"],
    ["bottom-up synthesis: helper functions derived from input/output examples over the primitive registry", "self_hosting/synthesis_by_example_selftest.patlang"],
    ["primitive registry tags: queryable by tag, and narrowing the primitives a search uses", "self_hosting/primitive_registry_tags_selftest.patlang"],
    ["schema bridge: an induced grandparent rule checked against a GrandparentPolicy schema", "self_hosting/schema_synthesis_bridge_selftest.patlang"],
    ["schema_bdd's synthesis hook (schema_register_synthesis_check / schema_run_synthesis_check)", "self_hosting/schema_synthesis_hook_selftest.patlang"],
    ["GitHub #21: GOAP snippet-synthesis (composition, polyglot, contract-guarded, missing-snippet error)", "self_hosting/synthesis_goap_snippet_selftest.patlang"],
    ["GitHub #21 quick-win #2: classes+traits step interfaces, real formal parameters not name matching", "self_hosting/goap_step_interfaces_selftest.patlang"],
    ["GOAP loop rollup: a discovered flat repeated-action plan rolled up into a real loop, verified behaviorally equivalent by actually running both", "self_hosting/goap_loop_rollup_selftest.patlang"],
    ["GOAP plan assembled as Lean 4 source, checked by lean and by the Lean frontend", "self_hosting/lean_goap_synthesis_selftest.patlang"]
  ]
end

make a function called run_synthesis_suite takes name, path returns ok
  let r = exec_measured("self_hosting/build/v2_interp.exe", [path])
  let passed = r[2] and contains_text(r[0], "ALL TESTS PASSED")
  if passed then
    print("  ok: " + name)
  else
    print("  FAIL: " + name + " (" + path + ")")
    print(r[0] + r[1])
  end
  return passed
end

make a function called synthesis_main takes args returns ok
  let suites = synthesis_suites()
  let chosen = []
  let i = 0
  while i < list_len(args) do
    if args[i] == "--list" then
      let k = 0
      while k < list_len(suites) do
        print(suites[k][1])
        let k = k + 1
      end
      return true
    end
    let k = 0
    while k < list_len(suites) do
      if suites[k][1] == args[i] then
        let chosen = list_push(chosen, suites[k])
      end
      let k = k + 1
    end
    let i = i + 1
  end
  if (list_len(args) > 0) and (list_len(chosen) == 0) then
    print("no synthesis selftest named " + str_join(args, " "))
    exit_with(1)
  end
  if list_len(chosen) == 0 then
    let chosen = suites
  end
  print("Running " + list_len(chosen) + " synthesis selftest suites...")
  let pass_count = 0
  let fail_count = 0
  let i = 0
  while i < list_len(chosen) do
    if run_synthesis_suite(chosen[i][0], chosen[i][1]) then
      let pass_count = pass_count + 1
    else
      let fail_count = fail_count + 1
    end
    let i = i + 1
  end
  print("")
  print("suites: " + pass_count + " passed, " + fail_count + " failed")
  if fail_count > 0 then
    print("SYNTHESIS SUITES FAILED")
    exit_with(1)
  end
  print("ALL SYNTHESIS SUITES PASSED")
  return true
end

synthesis_main(argv())
