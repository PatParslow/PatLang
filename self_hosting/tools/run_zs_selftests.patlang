# Runs every selftest for the schema/scenario work: the function-based schema
# library and its bridges, and the declared-schema layer (parametrised steps,
# the expression language, the loader, the state-space explorer, the feature
# analysis after Liu's process, outcome/negative/sequence checking, data
# refinement, schema-to-Gherkin generation, and the reverse direction:
# inferring a schema skeleton from a feature). A suite passes when its
# process succeeds and its output contains "ALL TESTS PASSED".
#
# Usage: rust-runtime/target/release/pat.exe --ir-run
#        self_hosting/tools/run_zs_selftests.patlang

include "../lib/test.patlang"

make a function called run_suite takes name, path returns ok
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", path)
  let passed = contains_text(out, "ALL TESTS PASSED")
  if passed then
    print("  ok: " + name)
  else
    print("  FAIL: " + name)
    print(out)
  end
  return passed
end

let suites = [
  ["function-based schemas: LibraryLoans through the Gherkin runner", "self_hosting/schema_bdd_selftest.patlang"],
  ["function-based schemas: the fuller LibraryLoans demo", "self_hosting/examples/library_loans_schema_demo.patlang"],
  ["function-based schemas: synthesis hook", "self_hosting/schema_synthesis_hook_selftest.patlang"],
  ["function-based schemas: induced rule checked against a policy", "self_hosting/schema_synthesis_bridge_selftest.patlang"],
  ["function-based schemas: GOAP plan state checked against a policy", "self_hosting/schema_goap_bridge_selftest.patlang"],
  ["parametrised Gherkin steps and the template matcher", "self_hosting/step_match_selftest.patlang"],
  ["schema clause expression language", "self_hosting/zs_expr_selftest.patlang"],
  ["declared schemas: loading, clause-level diagnosis, scenario checks", "self_hosting/zs_schema_selftest.patlang"],
  ["state-space exploration: seeded defects, bounds, refusals, ticks", "self_hosting/zs_explore_selftest.patlang"],
  ["feature analysis after Liu: the thesis's vending machine and planted defects", "self_hosting/zs_feature_selftest.patlang"],
  ["outcome, negative-scenario and sequence checking", "self_hosting/zs_outcome_selftest.patlang"],
  ["data refinement between declared schemas", "self_hosting/zs_refine_selftest.patlang"],
  ["generating Gherkin scenarios from a schema", "self_hosting/zs_generate_selftest.patlang"],
  ["inferring a schema skeleton from a feature, and suggesting requires from facts", "self_hosting/zs_infer_selftest.patlang"]
]

print("Running the schema/scenario selftest suites (" + list_len(suites) + " suites)...")
let mut pass_count = 0
let mut fail_count = 0
let i = 0
let n = to_num(list_len(suites))
while i < n do
  let entry = suites[i]
  if run_suite(entry[0], entry[1]) then
    pass_count = pass_count + 1
  else
    fail_count = fail_count + 1
  end
  let i = i + 1
end

print("")
print("suites: " + pass_count + " passed, " + fail_count + " failed")
if fail_count == 0 then
  print("ALL SCHEMA SUITES PASSED")
else
  print("SCHEMA SUITES FAILED")
end
