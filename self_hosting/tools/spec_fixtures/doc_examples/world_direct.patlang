let w = world_new()
let r = world_call(w, || do
  print("inside the world")
  vfs_write("note.txt", "kept in the world")
  return 6 * 7
end)
print(r)
print(world_output(w))
print(vfs_exists("note.txt"))
let again = world_call(w, || do
  return vfs_read("note.txt")
end)
print(again)
let stopped = world_call(w, || do
  assert 1 == 2
  return 0
end)
print(stopped)
world_steps(w, 100)
let spent = world_call(w, || do
  let i = 0
  while i < 1000 do
    world_step()
    let i = i + 1
  end
  return i
end)
print(spent)
print(world_free(w))
