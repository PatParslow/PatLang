include "../../../lib/context.patlang"
include "../../../lib/interp_run.patlang"
include "../../../lib/world_native.patlang"

let ctx = context_new()
let h = interp_run_full(ctx, "print(\"before\")\nprint(vfs_read(\"nope\"))\nprint(\"after\")\n", [["backend", "world"]])
print(h[2])
print(h[1])
let again = interp_run(ctx, "print(7)\n", [["backend", "world"]])
print(again[2])
print(again[0])
