include "../../../lib/context.patlang"
include "../../../lib/interp_run.patlang"

let ctx = context_new()
let h = interp_run(ctx, "print(\"before\")\nassert 1 == 2\nprint(\"after\")\n", [["backend", "world"]])
print(h[2])
print(h[0])
let again = interp_run(ctx, "print(7)\n", [["backend", "world"]])
print(again[2])
print(again[0])
