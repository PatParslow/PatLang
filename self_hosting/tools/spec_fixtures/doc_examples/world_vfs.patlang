include "../../../lib/context.patlang"
include "../../../lib/interp_run.patlang"
include "../../../lib/world_native.patlang"

let src = "print(vfs_exists(\"a.txt\"))\nvfs_write(\"new.txt\", \"n\")\n"
let ctx = context_new()
let r = interp_run_full(ctx, src, [["backend", "world"], ["vfs_in", [["a.txt", "A"]]], ["vfs_out_prefix", ""]])
print(r[0])
let i = 0
while i < r[3].length do
  print(r[3][i][0])
  let i = i + 1
end
