# GitHub #205 probe: x64_fatal_message_asm's "unsupported primitive" fallback
# must route through halt_process, same as os_exit, so it only ends a world's
# fiber when one is active, not the whole process.
#
# Case A (this file): the unsupported call happens on a fiber marked as a
# world. Expected: fiber_resume returns ["__world_halt", 98] (the suspended-
# fiber yield shape), and "after" still prints -- the process was not killed.

make a function called worker takes arg returns result
  set_var("__in_world", true)
  __definitely_not_a_real_primitive_xyz()
  return 1
end

let fid = fiber_new("worker")
let r = fiber_resume(fid, 0)
print(r[0])
print(r[1])
print("after")
