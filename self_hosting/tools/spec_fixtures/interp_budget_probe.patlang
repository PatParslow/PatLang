# RED/GREEN probe for the interpreter step budget (world_run's max_steps).
# Given a budget of 1000 steps, a 1,000,000-iteration loop must stop with
# ["Err", "step budget exhausted"] rather than run to completion.
# Without the budget compiled into interp.patlang, the loop finishes and
# prints "Ok" instead.

include "../../lib/interp_run.patlang"
include "../../lib/interp.patlang"

let c = interp_compile("let i = 0\nwhile i < 1000000 do\n  let i = i + 1\nend\nprint(i)\n")
set_var("__interp_budget_on", true)
set_var("__interp_steps", 1000)
let r = interpret_ir(c[1])
print(r[0])
print(r[1])
