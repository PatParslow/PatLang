# User function named like a built-in form (emit). Expected: a compile-time
# warning, and the call runs the user function, printing z.
let buf = sb_new()
set_var("__sinkq", |line| { return sb_push(buf, line) })
make a function called emit takes x returns result
  let s = get("__vars", "__sinkq")
  if s then
    let r = s(x)
    return r
  end
  return 0
end
emit("z")
print(sb_str(buf))
