include "../../lib/signals.patlang"

# The primary for signals_full_round_trip.feature and two_process_signals.feature.
# It claims a port the system picks and writes "port N" and a line end to its
# log, answers status, and stops on quit, or after 200 polls.

when status do
  signal_reply("uptime: 42")
end

when quit do
  write_file("self_hosting/tools/spec_fixtures/signal_primary.log", "exited via quit path")
end

let log_path = "self_hosting/tools/spec_fixtures/signal_primary.log"
let port_id = signal_claim(0)
if port_id >= 0 then
  write_file(log_path, "port " + port_id + chr(10))
  let stopped = false
  let iterations = 0
  while (not stopped) and (iterations < 200) do
    let stopped = signal_poll(port_id, 100) == "quit"
    let iterations = iterations + 1
  end
  if not stopped then
    write_file(log_path, "exited via bounded iteration count, not quit")
  end
end
