include "../../lib/signals.patlang"

let SIGNAL_PORT = 9701
let LOG_PATH = "self_hosting/tools/spec_fixtures/signal_primary.log"

when status do
  signal_reply("uptime: 42")
end

when quit do
  write_file(LOG_PATH, "exited via quit path")
  set_var("should_stop", "1")
end

write_file(LOG_PATH, "started")
let port_id = signal_claim(SIGNAL_PORT)
if port_id >= 0 then
  set_var("should_stop", "0")
  let iterations = 0
  while (get("__vars", "should_stop") == "0") and (iterations < 200) do
    signal_poll(port_id, 100)
    let iterations = iterations + 1
  end
  if get("__vars", "should_stop") == "0" then
    write_file(LOG_PATH, "exited via bounded iteration count, not quit")
  end
end
