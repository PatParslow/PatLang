# Two-process fixture for spec_library/block_model/two_process_signals.feature
# (GitHub issue #178). This program is the SECONDARY: it spawns
# signal_primary.patlang as a genuinely separate OS process, queries it over
# the real loopback TCP signal mechanism, tells it to quit, and reports what it
# saw. It is run twice, unchanged: directly under `pat --ir-run` (the
# reference) and through the block-model engine, and the printed lines must
# match. signal_query/signal_send are fatal if nothing is listening, so it
# waits for the child to write the port it claimed to its log.

include "../../lib/signals.patlang"

let LOG_PATH = "self_hosting/tools/spec_fixtures/signal_primary.log"
write_file(LOG_PATH, "")
let pid = spawn("self_hosting/build/v2_interp.exe", "self_hosting/tools/spec_fixtures/signal_primary.patlang")
let port = signal_primary_port(LOG_PATH, pid)
let reply = signal_query(port, "status", "")
print("reply: " + reply)
signal_send(port, "quit", "")
let waited = 0
while is_alive(pid) and (waited < 5000) do
  sleep_ms(50)
  let waited = waited + 50
end
print("child: " + read_file(LOG_PATH))

# The port signal_primary.patlang claimed, read from its log once the whole
# line is there; -1 if it stopped first.
make a function called signal_primary_port takes log_path, pid returns port
  let port = 0 - 1
  let looking = true
  while looking do
    let text = read_file(log_path)
    let n = text.length
    if (n > 6) and (substr(text, 0, 5) == "port ") and (char_code(text, n - 1) == 10) then
      let port = to_num(substr(text, 5, n - 6))
      let looking = false
    elif not is_alive(pid) then
      let looking = false
    else
      sleep_ms(20)
    end
  end
  return port
end
