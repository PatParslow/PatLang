# Two-process fixture for spec_library/block_model/two_process_signals.feature
# (GitHub issue #178). This program is the SECONDARY: it spawns
# signal_primary.patlang as a genuinely separate OS process, queries it over
# the real loopback TCP signal mechanism, tells it to quit, and reports what it
# saw. It is run twice, unchanged: directly under `pat --ir-run` (the
# reference) and through the block-model engine, and the printed lines must
# match. signal_query/signal_send are fatal if nothing is listening, so it
# sleeps for the child to claim its port instead of retrying.

include "../../lib/signals.patlang"

let LOG_PATH = "self_hosting/tools/spec_fixtures/signal_primary.log"
write_file(LOG_PATH, "")
let pid = spawn("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/tools/spec_fixtures/signal_primary.patlang")
sleep_ms(600)
let reply = signal_query(9701, "status", "")
print("reply: " + reply)
signal_send(9701, "quit", "")
let waited = 0
while is_alive(pid) and (waited < 5000) do
  sleep_ms(50)
  let waited = waited + 50
end
print("child: " + read_file(LOG_PATH))
