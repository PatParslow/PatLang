# world_run must refuse while another fiber is suspended, and run again once it
# has finished. Expected: yielded=7, refused, finished=9, after finish ok=true out=2.

include "../../lib/interp_run.patlang"
include "../../lib/world_native.patlang"

make a function called yielder takes arg returns result
  fiber_yield(7)
  return 9
end

let fid = fiber_new("yielder")
let first = fiber_resume(fid, 0)
print("yielded=" + first)
let refused = interp_run("print(1)\n", [["backend", "world"]])
print("while suspended ok=" + refused[2] + " err=" + refused[1])
let second = fiber_resume(fid, 0)
print("finished=" + second)
let ran = interp_run("print(2)\n", [["backend", "world"]])
print("after finish ok=" + ran[2] + " out=" + ran[0])
