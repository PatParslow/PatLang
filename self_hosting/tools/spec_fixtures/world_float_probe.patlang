# Float capture probe. Expected: "ok=true", stdout "1.5", then "float=[1.5]" -- the
# float goes through the world capture, not the console.

include "../../lib/interp_run.patlang"
include "../../lib/world_native.patlang"

let r = interp_run("print(1.5)\n", [["backend", "world"]])
print("ok=" + r[2])
print("float=[" + r[0] + "]")
print("stderr=[" + r[1] + "]")
