# Runtime halt containment probe. Expected lines:
#   halt ok: false
#   halt stdout: [before\n]
#   halt stderr: native halt: exit code 95
#   caller marker: 42
#   second run ok: true out: 7\n
# A second run afterwards proves the variable-table lock was released.

include "../../lib/interp_run.patlang"
include "../../lib/world_native.patlang"

set_var("marker", 42)

let h = interp_run_full("print(\"before\")\nprint(vfs_read(\"nope\"))\nprint(\"after\")\n", [["backend", "world"]])
print("halt ok: " + h[2])
print("halt stdout: [" + h[0] + "]")
print("halt stderr: " + h[1])
print("caller marker: " + get("__vars", "marker"))

let again = interp_run("print(7)\n", [["backend", "world"]])
print("second run ok: " + again[2] + " out: " + again[0])
