# VFS and class hand-over probe for world_run. Expected lines:
#   caller file seen by world (expect 0): 0
#   preloaded file seen by world (expect 1): 1
#   world vfs_out names: a.txt, new.txt  (sorted)
#   caller file leaked after run (expect -1): -1
#   caller class still registered: true
#   classes_out names: Passed
#   caller class in classes_out (expect false): false

include "../../lib/interp_run.patlang"
include "../../lib/world_native.patlang"

class_def_register("Mine", "", [], [], [])
vfs_table_set("caller.txt", "c")

let src = "print(vfs_exists(\"caller.txt\"))\nprint(vfs_exists(\"a.txt\"))\nvfs_write(\"new.txt\", \"n\")\n"
let r = interp_run_full(src, [["backend", "world"], ["vfs_in", [["a.txt", "A"]]], ["vfs_out_prefix", ""]])
print("caller file seen by world (expect 0): " + r[0])
let names = ""
let i = 0
while i < r[3].length do
  let names = names + r[3][i][0] + " "
  let i = i + 1
end
print("world vfs_out names: " + names)
print("caller file leaked after run (expect -1): " + vfs_table_lookup("new.txt"))
print("caller class still registered: " + (class_def_lookup("Mine").length > 0))

let c = interp_compile("print(1)\n")
let w = world_run(c[1], [["classes_in", [["Passed", [], []]]]])
let cnames = ""
let j = 0
while j < w[4].length do
  let cnames = cnames + w[4][j][0] + " "
  let j = j + 1
end
print("classes_out names: " + cnames)
print("caller class in classes_out (expect false): " + (cnames == "Mine "))
