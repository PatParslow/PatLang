# GitHub #201 probe: a genuinely nested world_run, reached the way interpreted
# source actually reaches it (interp.patlang's own dispatcher lets a program
# running inside a world call world_run itself, see its "world_run" CallHost
# case). The inner IR is a literal, hand-built ["ProgramIR", ...] for
# print("inner"), spliced directly into the outer source as a literal
# expression -- avoids needing interp_compile exposed to interpreted code.
#
# Expected: outer ok=true, outer stdout contains only "outer" (its own
# print) then "true" (the outer script's own print(r[2])) -- the inner
# world's "inner" print is captured into the INNER world's own buffer and
# returned as r[0], not forwarded into the outer buffer. Each world_run call
# swaps in its own fresh __output_buffer (world_native.patlang's world_run),
# so a nested call's output stays isolated from its caller's unless the
# caller explicitly re-prints it -- this is the isolation #201's fiber/
# thread-table swap is meant to guarantee, not a leak.

include "../../lib/interp_run.patlang"
include "../../lib/world_native.patlang"

let inner_ir = "[\"ProgramIR\", \"main\", [[\"FuncIR\", \"main\", [], [[\"Const\", \"str\", \"inner\"], [\"CallHost\", \"print\", 1], [\"Return\"]], []]], []]"
let outer_src = "print(\"outer\")\nlet r = world_run(" + inner_ir + ", [])\nprint(r[2])\n"
let outer = interp_run(outer_src, [["backend", "world"]])
print(outer[2])
print(outer[0])
print(outer[1])
