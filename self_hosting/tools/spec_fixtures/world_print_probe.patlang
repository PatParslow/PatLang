# Diagnostic: does a nested program's print reach the console (no world) and
# the world capture (world backend)? Expected: "direct" on the console first,
# then "true" and "cap".

include "../../lib/interp_run.patlang"
include "../../lib/world_native.patlang"

let c = interp_compile("print(\"direct\")\n")
let r0 = interpret_ir(c[1])
print(r0[0])
let r1 = interp_run("print(\"cap\")\n", [["backend", "world"]])
print(r1[2])
print(r1[0])
print(r1[1])
