# RED probe for native world_run parity. Given the interpreter's world backend
# (pat --ir-run) runs a source string in-process and returns its captured stdout,
# when the same program is built with --x64 it must return the same stdout.
# Expected under --ir-run: ok=true, stdout "7\n". Native currently reports the
# world backend as absent.

include "../../lib/interp_run.patlang"
include "../../lib/world_native.patlang"

let r = interp_run("print(3 + 4)\n", [["backend", "world"]])
print(r[2])
print(r[0])
print(r[1])
