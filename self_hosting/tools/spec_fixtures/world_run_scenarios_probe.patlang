# Native world_run scenarios from spec_library/native_parity/world_run.feature.
# Expected lines, in order:
#   caller marker after clean run: 42
#   budget run ok: false
#   budget run stderr: IR runtime error: step budget exhausted
#   crash run ok: false
#   crash run stderr not empty: true
#   stdin run ok: false
#   stdin run stderr: world_run: unsupported: stdin
#   caller marker after all runs: 42

include "../../lib/interp_run.patlang"
include "../../lib/world_native.patlang"

set_var("marker", 42)

let clean = interp_run("print(1)\n", [["backend", "world"]])
print("caller marker after clean run: " + get("__vars", "marker"))

let budget = interp_run("let i = 0\nwhile i < 1000000 do\n  let i = i + 1\nend\nprint(i)\n", [["backend", "world"], ["max_steps", 1000]])
print("budget run ok: " + budget[2])
print("budget run stderr: " + budget[1])

let crash = interp_run("print(nope())\n", [["backend", "world"]])
print("crash run ok: " + crash[2])
print("crash run stderr not empty: " + (crash[1] != ""))

let stdin_run = interp_run("print(1)\n", [["backend", "world"], ["stdin", "x"]])
print("stdin run ok: " + stdin_run[2])
print("stdin run stderr: " + stdin_run[1])

print("caller marker after all runs: " + get("__vars", "marker"))
