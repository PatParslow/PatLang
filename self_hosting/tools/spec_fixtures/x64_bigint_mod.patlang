# Fixture for spec_library/language/x64_bigint_semantics.feature (GitHub #185):
# `%` with a BigInt operand. Run under `pat --ir-run` and compiled with
# `patc1 --x64`; the outputs must match. Native used to exit 97 ("unsupported
# operand") the moment either side of `%` was not a plain fixnum -- BigInt `%`
# had no runtime implementation at all, only a deliberate hard-fail trap.

let s = 2000000000
let big = s * 1103515245 + 12345
print(big)
print(big % 2147483648)
print(0 - big % 2147483648)
print(big % (0 - 2147483648))
let bigger = big * big
print(bigger % 999999937)
print(bigger % big)
print(big % 999999937)
print((0 - big) % 999999937)
print("after")
