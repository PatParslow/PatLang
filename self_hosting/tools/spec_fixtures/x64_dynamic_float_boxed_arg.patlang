include "../../lib/includes.patlang"
include "../../lib/gherkin.patlang"
# A float reaching a function with no float in its own body, read from a list
# so that nothing at the call shows it is a float.
make a function called plus takes a, b returns r
  return a + b
end
let xs = [1.5]
print(plus(xs[0], 2))
print(type_of(plus(xs[0], 2)))
