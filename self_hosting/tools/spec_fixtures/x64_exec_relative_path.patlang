# A program path with a directory separator but no ./ prefix (the shape
# interp_run's default pat path has) must launch: CreateProcessA with a NULL
# application name only treats such a first token as a path when it is
# prefixed, so native normalizes it. Both exec forms are exercised.
include "../../lib/test.patlang"
write_file("self_hosting/build/_exec_rel_probe.patlang", "print(\"probe\")\n")
let a = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", "self_hosting/build/_exec_rel_probe.patlang")
print(contains_text(a, "probe"))
let b = exec_capture_io("rust-runtime/target/release/pat.exe", ["--ir-run", "self_hosting/build/_exec_rel_probe.patlang"], "", 0)
print(contains_text(b[0], "probe"))
print(b[2])
remove_file("self_hosting/build/_exec_rel_probe.patlang")
print("after")
