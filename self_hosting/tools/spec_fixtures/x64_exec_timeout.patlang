# exec_capture_io's 4th argument is a wall-clock timeout in ms: an infinite
# child is killed and reported as a timeout; a quick child with a generous
# timeout is unaffected. Prints one line per property.
include "../../lib/test.patlang"
let pat = "./rust-runtime/target/release/pat.exe"
write_file("self_hosting/build/_exec_timeout_spin.patlang", "while true do\nend\n")
write_file("self_hosting/build/_exec_timeout_quick.patlang", "print(\"quick\")\n")

let t0 = now_ms()
let spun = exec_capture_io(pat, ["--ir-run", "self_hosting/build/_exec_timeout_spin.patlang"], "", 400)
let elapsed = now_ms() - t0
print(spun[2])
print(contains_text(spun[1], "timeout after 400 ms"))
print(elapsed < 6000)

let quick = exec_capture_io(pat, ["--ir-run", "self_hosting/build/_exec_timeout_quick.patlang"], "", 30000)
print(quick[2])
print(contains_text(quick[0], "quick"))
print(contains_text(quick[1], "timeout"))
remove_file("self_hosting/build/_exec_timeout_spin.patlang")
remove_file("self_hosting/build/_exec_timeout_quick.patlang")
print("done")
