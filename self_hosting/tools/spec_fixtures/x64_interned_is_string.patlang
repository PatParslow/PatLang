# Fixture for string_builders_and_vecs.feature: an interned string is an
# ordinary string in both engines. Run on the v2 interpreter and compiled
# by v2; the outputs must match.
let h = str_intern("ab" + "cd")
print(type_of(h))
print(h == "abcd")
print(h + "!")
print(sc_len(h))
print(sc_char(h, 2))
print("after")
