# Out-of-range and wrong-type access answers the way the interpreter does
# instead of dereferencing garbage: an out-of-range list index is Unit, an
# out-of-range string index is "", and list_len of a non-list/non-string is 0.
let e = []
let l = [1, 2, 3]
print(type_of(e[0]))
print(type_of(l[10]))
print(type_of(l[0 - 1]))
print("abc"[10] == "")
print(list_len(e[0]))
print(list_len(5))
print(list_len(l[10]))
print(l[2])
print("after")
