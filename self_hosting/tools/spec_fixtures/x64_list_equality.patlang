# Fixture for spec_library/language/x64_list_semantics.feature (GitHub #113):
# list `==` and `!=` compare STRUCTURALLY, as the interpreter does. Run under
# `pat --ir-run` and compiled with `patc1 --x64`; the two outputs must match.
# Native x64 used to compare lists by pointer identity, so every "true" below
# printed false unless both operands were literally the same list.

let a = ["rare_atlas", "branch_b"]
let b = list_push(list_push([], "rare_atlas"), "branch_b")
print(a == b)
let e = ["no"]
let f = ["no"]
print(e == f)
make a function called mk takes x returns r
  return ["hit", x]
end
print(mk("foo") == ["hit", "foo"])
print([[1], [2, 3]] == [[1], [2, 3]])
print([1, 2] != [1, 2])
print(["a"] == ["b"])
print(["a"] == ["a", "b"])
print([1, 2] != [1, 3])
print([] == [])
print(["a"] == "a")
print(a == a)
