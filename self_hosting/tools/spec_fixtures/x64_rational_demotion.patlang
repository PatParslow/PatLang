# Fixture for x64_bigint_semantics.feature (GitHub #186): an exact result of
# Rational arithmetic demotes to a plain int, an inexact one stays Rational --
# the same on every backend. The interpreter already did this
# (ir/numeric.rs::normalize); native never demoted a Rational result until
# now. Native x64 relies on this: a value's static type decides whether later
# arithmetic on it takes the plain-int or dynamic-mode path, so a Rational
# escaping from an exact `/`/`%` broke ordinary integer idioms downstream
# (e.g. `(n - n % k) / k`, used throughout this codebase) wherever the
# native compiler had assumed a returned value would be a plain int.
let half = 1 / 2
let third = 1 / 3
print(type_of(half + half))
print(half + half)
print(type_of(half + third))
print(half + third)
print(type_of(half * 2))
print(type_of((10 / 3) - (1 / 3)))
print((10 / 3) - (1 / 3))
print(type_of(10 / 2))
print(type_of(10 / 3))
print(type_of(64 % (7 / 2)))
print(64 % (7 / 2))
print("after")
