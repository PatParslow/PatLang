# Fixture for string_builders_and_vecs.feature: a string builder and a vec
# are values with their own type and identity, in both engines. Run under
# `pat --ir-run` and compiled with `patc1 --x64`; the outputs must match.
let b = sb_new()
sb_push(b, "ab")
let b2 = b
sb_push(b2, "cd")
print(sb_str(b))
print(type_of(b))
print(b == b2)
print(b == sb_new())
let v = vec_new()
vec_push(v, 1)
let w = v
vec_push(w, 2)
print(vec_len(v))
print(type_of(v))
let snap = vec_to_list(v)
vec_set(v, 0, 9)
print(snap)
print(vec_to_list(v))
print("after")
