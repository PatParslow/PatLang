# Companion to x64_tag_collision_sweep.patlang: the guard added for #48
# only skips the 8 payload-requiring family checks when the payload is
# EXACTLY zero (see codegen_x64.patlang's r14/je .fc_notinterval_ zero-
# payload skip). A plain int whose bits equal one of the 8 reserved tags
# PLUS a nonzero low-bit payload is NOT covered by that guard -- the
# family-tag mask comparison only looks at the upper bits, so it would
# still match. This sweep checks whether that theoretical gap is real.

let string_tag_plus1 = (2 shl 60) + 1
let bigint_tag_plus1 = ((1 shl 60) bor (1 shl 48)) + 1

print(type_of(string_tag_plus1))
print(type_of(bigint_tag_plus1))
