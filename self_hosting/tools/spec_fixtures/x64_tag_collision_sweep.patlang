# GitHub #49: the actual "prevention invariant" the issue asked for --
# not just per-consumer robustness (the whack-a-mole pattern #24/#46/#48
# each fixed one function at a time), but a sweep confirming that a plain
# int produced by ORDINARY arithmetic/bitwise operations, whose bit
# pattern happens to exactly equal one of the x64 backend's 8 reserved,
# payload-requiring family tags (String/List/Closure/Object/BigInt/
# Rational/Complex/Interval -- see codegen_x64.patlang's fc_ classifier
# around line 4240) with a ZERO payload, is still correctly classified
# as a plain int by type_of/numeric_kind, not misread as that family.
#
# This exercises the fix already shipped for #48 (the zero-payload skip
# guard in both x64_runtime.patlang's print dispatch and
# codegen_x64.patlang's fc_ classifier) as a genuine regression test,
# not a one-off manual check -- run under --x64 specifically, since the
# interpreter (pat --ir-run) uses a real Value::Int enum, not x64's bit-
# packed tagged pointers, so this collision class cannot occur there at
# all; only --x64 output is meaningful here.

let string_tag = 2 shl 60
let list_tag = 3 shl 60
let closure_tag = 4 shl 60
let object_tag = 5 shl 60
let bigint_tag = (1 shl 60) bor (1 shl 48)
let rational_tag = bigint_tag bor (1 shl 49)
let complex_tag = rational_tag bor (1 shl 50)
let interval_tag = (1 shl 60) bor (1 shl 52)

print(type_of(string_tag))
print(type_of(list_tag))
print(type_of(closure_tag))
print(type_of(object_tag))
print(type_of(bigint_tag))
print(type_of(rational_tag))
print(type_of(complex_tag))
print(type_of(interval_tag))
