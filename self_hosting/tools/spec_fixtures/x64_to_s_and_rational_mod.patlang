# Fixture for x64_bigint_semantics.feature (GitHub #187): v.to_s on
# primitives, chr() on a Rational, and Rational %. Run under `pat --ir-run`
# and compiled with `patc1 --x64`; the outputs must match.
#
# `.to_s` is always called through a variable, never on a bare literal
# (`n.to_s`, not `233.to_s`) -- the self-hosted lexer parses the latter as
# the start of a float literal (GitHub #188, filed separately, not this
# fixture's concern).
#
# A prior set_var anywhere is required to reproduce the .to_s crash (the
# ambient namespace table must be non-empty for rt_ns_find to reach the bad
# comparison) -- utf8.patlang's own selftest has one from an earlier test,
# this fixture adds one explicitly so the repro doesn't depend on that.
set_var("warm_the_table", 0)

let a = 233
let b = 7 / 2
let c = true
let d = [1, 2]
print(a.to_s)
print(b.to_s)
print(c.to_s)
print(d.to_s)

let cp = 233
let b0 = 192 + (cp / 64)
let b1 = 128 + (cp % 64)
print(chr(b0).length)
print(char_code(chr(b0), 0))
print(char_code(chr(b1), 0))

print((117 / 4) % 64)
print(64 % (7 / 2))
print((7 / 2) % (5 / 2))
print(((0 - 117) / 4) % 64)
print(((0 - 7) / 2) % 3)
print("after")
