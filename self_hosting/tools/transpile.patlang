# =============================================================================
# Self-hosted transpiler CLI. Translates a PatLang program into idiomatic
# source in another language (currently: ruby only) via the self-hosted
# frontend + lib/transpile_ruby.patlang -- no native Rust CLI flag, this
# IS the CLI surface, matching the existing tools/build_portfolio.patlang /
# tools/build_site.patlang convention of "the tool is a runnable PatLang
# script", not a compiled-in main.rs mode.
#
# Usage (from the repo root):
#   pat --ir-run self_hosting/tools/transpile.patlang <source.patlang> ruby <out.rb>
#
# The emitted <out.rb> requires lib/patlang_runtime.rb via a relative path
# ("patlang_runtime"), so it's written into the same directory as
# lib/patlang_runtime.rb rather than an arbitrary <out.rb> location --
# <out.rb>'s basename is honoured, its directory is not (documented below).
# =============================================================================

include "../lib/lexer.patlang"
include "../lib/parser.patlang"
include "../lib/json.patlang"
include "../lib/reflect.patlang"
include "../lib/transpile_ruby.patlang"

make a function called basename takes path returns b
  let i = path.length - 1
  let looping = true
  while (i >= 0) and looping do
    let c = substr(path, i, 1)
    if (c == "/") or (c == "\\") then
      let looping = false
    else
      let i = i - 1
    end
  end
  return substr(path, i + 1, path.length - i - 1)
end

make a function called transpile_main takes source_path, target, out_path returns done
  if target != "ruby" then
    print("transpile: unsupported target '" + target + "' (only 'ruby' is implemented)")
    return false
  end
  let src = read_file(source_path)
  let toks = tokenize(src)
  let ast = parse_program(toks)
  let result = transpile_program(ast)
  if result[0] == "Err" then
    print("transpile: " + result[1])
    return false
  end
  let out_dir = "self_hosting/lib/"
  let out_file = out_dir + basename(out_path)
  write_file(out_file, result[1])
  print("wrote " + out_file)
  return true
end

let args = argv()
if args.length < 3 then
  print("usage: pat --ir-run self_hosting/tools/transpile.patlang <source.patlang> <target> <out.rb>")
else
  transpile_main(args[0], args[1], args[2])
end
