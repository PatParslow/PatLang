# Live status probe for any in-flight native x64 build(s).
#
# Builds claim a port from a small range (see build_progress.patlang's
# x64_build_signal_port / x64_build_signal_port_last), so several
# concurrent builds can each publish their own telemetry rather than
# whichever started second going silent. This walks the whole range and
# reports every build that answers.
#
# Uses tcp_try_connect to test each port, NOT signal_claim: claiming a
# free port would mean this probe briefly squats every idle port in the
# range, which could make a build starting at that moment skip past it.
# tcp_try_connect is also the only non-fatal option -- plain tcp_connect
# aborts the whole program on a refused connection (PatLang has no
# try/catch), so it would die on the first unused port.
#
# Run from the repo root:
#   rust-runtime/target/release/pat --ir-run self_hosting/tools/x64_build_status.patlang
include "../lib/signals.patlang"

let port = 9410
let last = 9420
let found = 0
while port <= last do
  let conn = tcp_try_connect("127.0.0.1", port)
  if conn >= 0 then
    tcp_write(conn, "x64_status" + chr(10))
    let reply = tcp_read_or_empty(conn)
    tcp_close(conn)
    print("port " + port + ": " + reply)
    let found = found + 1
  end
  let port = port + 1
end
if found == 0 then
  print("no native x64 build is currently publishing status (ports 9410-9420)")
end
