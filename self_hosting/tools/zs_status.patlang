# Ask a running zs_check.patlang what it is doing, or tell it to stop.
#
#   pat.exe --ir-run self_hosting/tools/zs_status.patlang [PORT] [status|quit]
#
# PORT defaults to 9431, the port zs_check.patlang claims unless told otherwise.
# "status" (the default) prints the reply; "quit" asks the search to stop.

include "../lib/signals.patlang"

let args = argv()
let port = 9431
let what = "status"
if args.length >= 1 then
  let port = to_num(args[0])
end
if args.length >= 2 then
  let what = args[1]
end
if what == "quit" then
  signal_send(port, "quit", "")
  print("sent quit to port " + port)
else
  print(signal_query(port, "status", ""))
end
