include "lib/utf8.patlang"

# utf8_selftest.patlang -- BDD-wired selftest for lib/utf8.patlang.
# Run via: pat --ir-run self_hosting/utf8_selftest.patlang
#
# Outputs "ALL TESTS PASSED\n0 failed" on success.
#
# Uses set_var/get("__vars",...) for mutable pass/fail counters so that the
# counter mutations inside helper functions survive the function boundary
# (PatLang `let x = x+1` inside a function only mutates a local copy).

set_var("t_pass", 0)
set_var("t_fail", 0)

make a function called assert_eq takes label, got, expected returns r
  if got == expected then
    set_var("t_pass", get("__vars", "t_pass") + 1)
  else
    print("FAIL: " + label + " -- expected " + expected.to_s + " got " + got.to_s)
    set_var("t_fail", get("__vars", "t_fail") + 1)
  end
end

# ---- utf8_next: ASCII ----
let r = utf8_next("A", 0)
assert_eq("utf8_next ASCII codepoint", r[0], 65)
assert_eq("utf8_next ASCII next", r[1], 1)

# ---- utf8_next: 2-byte sequence (U+00E9 = é, UTF-8: 0xC3 0xA9) ----
let e_acute = utf8_encode(233)
let r2 = utf8_next(e_acute, 0)
assert_eq("utf8_next 2-byte codepoint", r2[0], 233)
assert_eq("utf8_next 2-byte next", r2[1], 2)

# ---- utf8_next: 3-byte sequence (U+2200 = forall, UTF-8: 0xE2 0x88 0x80) ----
# Note: U+03B1 (alpha=945) is 2-byte; use U+2200 (8704) for a real 3-byte test
let forall_char = utf8_encode(8704)
let r3 = utf8_next(forall_char, 0)
assert_eq("utf8_next 3-byte codepoint", r3[0], 8704)
assert_eq("utf8_next 3-byte next", r3[1], 3)

# ---- utf8_next: 4-byte sequence (U+1D400 = 119808 Mathematical Bold A) ----
let math_bold = utf8_encode(119808)
let r4 = utf8_next(math_bold, 0)
assert_eq("utf8_next 4-byte codepoint", r4[0], 119808)
assert_eq("utf8_next 4-byte next", r4[1], 4)

# ---- utf8_encode round-trip ----
let i = 0
let test_cps = [65, 233, 8704, 19968, 119808]
while i < test_cps.length do
  let cp = test_cps[i]
  let encoded = utf8_encode(cp)
  let decoded = utf8_next(encoded, 0)
  assert_eq("round-trip cp " + cp.to_s, decoded[0], cp)
  let i = i + 1
end

# ---- utf8_len ----
# "café" = 4 logical chars, 5 bytes (é is 2 bytes)
let cafe = "caf" + utf8_encode(233)
assert_eq("utf8_len cafe", utf8_len(cafe), 4)
assert_eq("utf8_len ASCII", utf8_len("hello"), 5)
assert_eq("utf8_len empty", utf8_len(""), 0)

# ---- utf8_char_at ----
let s = "A" + utf8_encode(233) + "B"
assert_eq("utf8_char_at 0", utf8_char_at(s, 0), 65)
assert_eq("utf8_char_at 1", utf8_char_at(s, 1), 233)
assert_eq("utf8_char_at 2", utf8_char_at(s, 2), 66)
assert_eq("utf8_char_at oob", utf8_char_at(s, 99), -1)

# ---- utf8_is_alpha ----
assert_eq("is_alpha A", utf8_is_alpha(65), true)
assert_eq("is_alpha z", utf8_is_alpha(122), true)
assert_eq("is_alpha digit", utf8_is_alpha(48), false)
assert_eq("is_alpha alpha U+03B1 (Greek)", utf8_is_alpha(945), true)
assert_eq("is_alpha N-double-struck U+2115", utf8_is_alpha(8469), true)

# ---- utf8_is_digit ----
assert_eq("is_digit 0", utf8_is_digit(48), true)
assert_eq("is_digit 9", utf8_is_digit(57), true)
assert_eq("is_digit A", utf8_is_digit(65), false)

# ---- utf8_is_ident_start ----
assert_eq("ident_start A", utf8_is_ident_start(65), true)
assert_eq("ident_start _", utf8_is_ident_start(95), true)
assert_eq("ident_start alpha U+03B1", utf8_is_ident_start(945), true)
assert_eq("ident_start digit", utf8_is_ident_start(48), false)

# ---- utf8_is_ident_part ----
assert_eq("ident_part digit", utf8_is_ident_part(48), true)
assert_eq("ident_part prime", utf8_is_ident_part(39), true)

# ---- utf8_is_ws ----
assert_eq("is_ws space", utf8_is_ws(32), true)
assert_eq("is_ws newline", utf8_is_ws(10), true)
assert_eq("is_ws A", utf8_is_ws(65), false)
assert_eq("is_ws NBSP U+00A0", utf8_is_ws(160), true)

# ---- summary ----
let t_fail = get("__vars", "t_fail")
let t_pass = get("__vars", "t_pass")
if t_fail == 0 then
  print("ALL TESTS PASSED")
  print("0 failed")
else
  print(t_fail.to_s + " FAILED (passed: " + t_pass.to_s + ")")
end
