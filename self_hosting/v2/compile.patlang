# The v2 compiler (docs/plans/v2-implementation.md):
#
#   pat --ir-run self_hosting/v2/compile.patlang SRC.patlang OUT.exe
#       [--workers N] [--shuffle SEED] [--no-cache]
#
# Stages, each a function of its inputs: parse the runtime and the program,
# lower each declaration (lower.patlang), then one job per function
# (jobs.patlang): the ownership stage (own.patlang), code generation
# (x64.patlang) and assembly (lib/x64_asm.patlang); then linking
# (lib/x64_pe_link.patlang). The runtime is compiled with the program, by
# the same stages. The jobs run on N workers (1 by default), in an order
# shuffled by SEED (0, the default, is declaration order); a job whose key
# was seen before reuses its stored artefacts (self_hosting/build/
# v2_artefacts) unless --no-cache. Besides OUT.exe the build writes
# OUT.asm, OUT.facts (the program facts), OUT.ledger (each job's
# function and whether it was built or reused) and OUT.timing (each
# phase's time in ms).
include "../lib/x64_pe_link.patlang"
include "ir.patlang"
include "lower.patlang"
include "front.patlang"
include "own.patlang"
include "contracts.patlang"
include "x64.patlang"
include "jobs.patlang"

# A name's index in fns, from a table of 1024 buckets of [name, index]; -1 when
# no function declares it.
make a function called v2_index_table takes fns returns table
  let table = vec_new()
  let i = 0
  while i < 1024 do
    vec_push(table, [])
    let i = i + 1
  end
  let i = 0
  while i < list_len(fns) do
    let k = jb_bucket(ir_fn_name(fns[i]))
    vec_set(table, k, list_push(vec_get(table, k), [ir_fn_name(fns[i]), i]))
    let i = i + 1
  end
  return table
end

make a function called v2_index_of takes table, name returns i
  let entries = vec_get(table, jb_bucket(name))
  let k = 0
  while k < list_len(entries) do
    if entries[k][0] == name then
      return entries[k][1]
    end
    let k = k + 1
  end
  return 0 - 1
end

# The functions a function refers to by name: what it calls, and the bodies of
# the closures it makes.
make a function called v2_references takes func returns names
  let names = jb_callees(func)
  let instrs = ir_fn_instrs(func)
  let i = 0
  while i < list_len(instrs) do
    if instrs[i][0] == "closure" then
      let names = list_push(names, instrs[i][2])
    end
    let i = i + 1
  end
  return names
end

# The functions a program can reach, in declaration order, from its top level
# (__main, __register) and the runtime, whose functions the generated code calls
# by name; and a function for each name reached that nothing declares.
make a function called v2_reachable takes fns, runtime_names returns kept
  let table = v2_index_table(fns)
  let seen = vec_new()
  let i = 0
  while i < list_len(fns) do
    vec_push(seen, false)
    let i = i + 1
  end
  let work = vec_new()
  let undeclared = vec_new()
  let roots = list_push(list_push(runtime_names, "__main"), "__register")
  let i = 0
  while i < list_len(roots) do
    vec_push(work, roots[i])
    let i = i + 1
  end
  let at = 0
  while at < vec_len(work) do
    let name = vec_get(work, at)
    let at = at + 1
    let k = v2_index_of(table, name)
    if k < 0 then
      if not v2_contains(vec_to_list(undeclared), name) then
        vec_push(undeclared, name)
      end
    elif not vec_get(seen, k) then
      vec_set(seen, k, true)
      let refs = v2_references(fns[k])
      let r = 0
      while r < list_len(refs) do
        vec_push(work, refs[r])
        let r = r + 1
      end
    end
  end
  let out = vec_new()
  let i = 0
  while i < list_len(fns) do
    if vec_get(seen, i) then
      vec_push(out, fns[i])
    end
    let i = i + 1
  end
  let i = 0
  while i < vec_len(undeclared) do
    vec_push(out, lw_undeclared_function(vec_get(undeclared, i)))
    let i = i + 1
  end
  return vec_to_list(out)
end

# The import list for the linker: every extern_call's library and function,
# and ExitProcess for the entry.
make a function called v2_import_spec takes fns returns spec
  let libs = ["KERNEL32.DLL"]
  let names = [["ExitProcess"]]
  let i = 0
  while i < list_len(fns) do
    let instrs = ir_fn_instrs(fns[i])
    let k = 0
    while k < list_len(instrs) do
      let ins = instrs[k]
      if (ins[0] == "extern") or (ins[0] == "externf") then
        let lib = ins[2]
        let fname = ins[3]
        let li = 0
        let found = 0 - 1
        while li < list_len(libs) do
          if libs[li] == lib then
            let found = li
          end
          let li = li + 1
        end
        if found < 0 then
          let libs = list_push(libs, lib)
          let names = list_push(names, [fname])
        elif not v2_contains(names[found], fname) then
          let names = list_set(names, found, list_push(names[found], fname))
        end
      end
      let k = k + 1
    end
    let i = i + 1
  end
  let spec = []
  let li = 0
  while li < list_len(libs) do
    let spec = list_push(spec, [libs[li], names[li]])
    let li = li + 1
  end
  return spec
end

# The program facts (lower.patlang, lw_program) as the build's facts
# artefact, one per line: "event NAME", "by_name NAME" ("*" when a name is
# computed at run time), "rule PREDICATE/ARITY".
make a function called v2_facts_text takes facts returns text
  let b = sb_new()
  let kinds = ["event", "by_name", "rule"]
  let k = 0
  while k < 3 do
    let items = facts[k]
    let i = 0
    while i < list_len(items) do
      sb_push(b, kinds[k] + " " + items[i] + xv_nl())
      let i = i + 1
    end
    let k = k + 1
  end
  return sb_str(b)
end

make a function called v2_artefact_dir returns dir
  return "self_hosting/build/v2_artefacts"
end

# A phase's time, in ms since the last mark, for OUT.timing. Each mark also
# rewrites OUT.progress, the finished phases so far, so a build can be watched
# from outside: slow and stuck look the same otherwise.
make a function called v2_mark takes times, phase, out_path returns done
  let now = now_ms()
  vec_push(times, [phase, now - vec_get(times, 0)])
  vec_set(times, 0, now)
  write_file(out_path + ".progress", v2_times_text(times))
  return true
end

make a function called v2_times_text takes times returns text
  let tb = sb_new()
  let k = 1
  while k < vec_len(times) do
    sb_push(tb, vec_get(times, k)[0] + " " + vec_get(times, k)[1] + xv_nl())
    let k = k + 1
  end
  return sb_str(tb)
end

make a function called v2_compile takes src_path, out_path, workers, seed, cache returns result
  let times = vec_new()
  vec_push(times, now_ms())
  let front = v2_front_end(src_path, "")
  v2_mark(times, "front end", out_path)
  if front[0] == "error" then
    return front
  end
  let lowered = front[1]
  let fns = v2_reachable(lowered[0], lowered[3])
  write_file(out_path + ".facts", v2_facts_text(lowered[2]))
  let facts = lowered[2]
  let dir = ""
  if cache then
    let dir = v2_artefact_dir()
    if not file_exists(dir) then
      # cmd reads / as a switch: the path with backslashes
      exec_capture("cmd", "/c", "mkdir", "self_hosting" + chr(92) + "build" + chr(92) + "v2_artefacts")
    end
  end
  let base = jb_compiler_hash()
  v2_mark(times, "compiler hash", out_path)
  let table = jb_summaries(fns)
  let entry = xv_entry_asm()
  let jobs = [[0, "asm", entry, facts, jb_key_text(jb_mix_text(base, entry)), dir]]
  let i = 0
  while i < list_len(fns) do
    let jobs = list_push(jobs, [i + 1, "fn", fns[i], facts, jb_fn_key(base, fns[i], facts, table), dir])
    let i = i + 1
  end
  v2_mark(times, "keys", out_path)
  let results = jb_run_all(jobs, workers, seed)
  v2_mark(times, "jobs", out_path)
  let b = sb_new()
  let ledger = sb_new()
  let chunks = []
  let job_ms = [0, 0, 0]
  let i = 0
  while i < list_len(results) do
    let r = results[i]
    let job_ms = [job_ms[0] + r[3][0], job_ms[1] + r[3][1], job_ms[2] + r[3][2]]
    if i == 1 then
      sb_push(b, "section .text" + xv_nl())
    end
    sb_push(b, r[1])
    let name = "(entry)"
    if i > 0 then
      let name = ir_fn_name(fns[i - 1])
    end
    sb_push(ledger, r[2] + " " + name + xv_nl())
    if r[0] == false then
      write_file(out_path + ".asm", sb_str(b))
      return ["error", ["assembly failed for " + name + ": see " + out_path + ".asm"]]
    end
    let chunks = list_push(chunks, r[0])
    let i = i + 1
  end
  write_file(out_path + ".asm", sb_str(b))
  write_file(out_path + ".ledger", sb_str(ledger))
  vec_push(times, ["jobs: reading or generating code", job_ms[0]])
  vec_push(times, ["jobs: assembling", job_ms[1]])
  vec_push(times, ["jobs: storing", job_ms[2]])
  vec_set(times, 0, now_ms())
  let linked = x64_link(chunks, v2_import_spec(fns), "main", out_path)
  v2_mark(times, "link", out_path)
  write_file(out_path + ".timing", v2_times_text(times))
  if str_starts_with(linked, "LINK ERROR") then
    return ["error", [linked]]
  end
  return ["ok", out_path]
end

let args = argv()
if list_len(args) < 2 then
  print("usage: compile.patlang SRC.patlang OUT.exe [--workers N] [--shuffle SEED] [--no-cache]")
  exit_with(2)
else
  let workers = 1
  let seed = 0
  let cache = true
  let i = 2
  while i < list_len(args) do
    if (args[i] == "--workers") and (i + 1 < list_len(args)) then
      let workers = to_num(args[i + 1])
      let i = i + 1
    elif (args[i] == "--shuffle") and (i + 1 < list_len(args)) then
      let seed = to_num(args[i + 1])
      let i = i + 1
    elif args[i] == "--no-cache" then
      let cache = false
    end
    let i = i + 1
  end
  let r = v2_compile(args[0], args[1], workers, seed, cache)
  if r[0] == "ok" then
    print("v2: " + r[1])
  else
    let i = 0
    while i < list_len(r[1]) do
      print("v2 error: " + r[1][i])
      let i = i + 1
    end
    exit_with(1)
  end
end
