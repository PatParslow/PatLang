# Square-and-multiply without a branch: each step multiplies by 1 + bit * (g - 1),
# which is g when the bit is 1 and 1 when it is 0, so every exponent takes the
# same steps. Run the check on it:
#   self_hosting/build/v2.exe self_hosting/v2/examples/ct_clean_pow.patlang --constant-time
# and it finds no value-dependent branch or access.
include "../lib/curve25519.patlang"

make a function called clean_pow takes g, exponent returns acc
  require (type_of(g) == "modint") and (list_len(exponent) == 32)
  let acc = mod_make(1, g)
  let i = 255
  while i >= 0 do
    let bit = cv_bit(exponent, i, g)
    let acc = acc * acc * (1 + bit * (g - 1))
    let i = i - 1
  end
  ensure mod_modulus(acc) == mod_modulus(g)
  return acc
end

let secret = cv_slice(sha512(cv_hex_bytes("736563726574")), 0, 32)
let r = clean_pow(cv_fe(2), secret)
print("done")
