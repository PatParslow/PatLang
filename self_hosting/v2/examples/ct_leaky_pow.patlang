# Square-and-multiply with a branch: g raised to a secret exponent, multiplying
# only when the exponent's bit is 1. How long it runs tells an observer how many
# bits are set, and in what order. Run the check on it:
#   self_hosting/build/v2.exe self_hosting/v2/examples/ct_leaky_pow.patlang --constant-time
# and it reports the branch on a secret.
include "../../../packages/curve25519/curve25519.patlang"

make a function called leaky_pow takes g, exponent returns acc
  require (type_of(g) == "modint") and (list_len(exponent) == 32)
  let acc = mod_make(1, g)
  let i = 255
  while i >= 0 do
    let acc = acc * acc
    if cv_bit(exponent, i, g) == 1 then
      let acc = acc * g
    end
    let i = i - 1
  end
  ensure mod_modulus(acc) == mod_modulus(g)
  return acc
end

let secret = cv_slice(sha512(cv_hex_bytes("736563726574")), 0, 32)
let r = leaky_pow(cv_fe(2), secret)
print("done")
