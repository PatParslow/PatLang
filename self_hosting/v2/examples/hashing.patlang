# Hashing with modint words: SHA-512 from self_hosting/v2/lib/sha512.patlang,
# checked against the FIPS 180-4 examples, and 32-bit FNV-1a written here in a
# few lines, since a word modulo 2^32 wraps on its own.
include "../lib/curve25519.patlang"

# The bytes of text, each a modint modulo 256.
make a function called text_bytes takes text returns bytes
  require type_of(text) == "string"
  let bytes = []
  let i = 0
  while i < str_len(text) do
    let bytes = list_push(bytes, sha512_byte(char_code(text, i)))
    let i = i + 1
  end
  ensure list_len(bytes) == str_len(text)
  return bytes
end

# FNV-1a: for each byte, xor it in and multiply by the FNV prime, modulo 2^32.
make a function called fnv1a32 takes bytes returns h
  require type_of(bytes) == "list"
  let h = mod_make(2166136261, 4294967296)
  let i = 0
  while i < list_len(bytes) do
    let h = (h bxor mod_make(bytes[i], h)) * 16777619
    let i = i + 1
  end
  ensure mod_modulus(h) == 4294967296
  return h
end

let abc = cv_hex(sha512(text_bytes("abc")))
print("SHA-512(\"abc\") = " + abc)
print("matches FIPS 180-4: " + to_s(abc == "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f"))
let empty = cv_hex(sha512([]))
print("SHA-512(\"\") = " + empty)
print("matches FIPS 180-4: " + to_s(empty == "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e"))
let fox = text_bytes("The quick brown fox jumps over the lazy dog")
print("SHA-512(fox) = " + cv_hex(sha512(fox)))
print("FNV-1a(\"hello\") = " + to_s(fnv1a32(text_bytes("hello"))))
print("expected        = " + to_s(mod_make(1335831723, 4294967296)))
