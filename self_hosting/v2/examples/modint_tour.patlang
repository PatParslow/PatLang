# A tour of integers modulo n (spec 1.14). A modint is a residue together with
# its modulus; it prints as "r mod n", and arithmetic on it stays modulo n.

print("-- clock arithmetic, modulo 12 --")
let t = mod_make(9, 12)
print(t)
print(t + 5)
print(t - 11)
print(t * 3)
print(mod_make(0 - 1, 12))

print("-- dividing multiplies by an inverse, modulo the prime 101 --")
let a = mod_make(37, 101)
let inv = pow(a, 0 - 1)
print(inv)
print(a * inv)
print(mod_make(5, 101) / a)

print("-- Fermat: 2^(p-1) is 1 modulo the prime p = 2^255 - 19 --")
let p = 57896044618658097711785492504343953926634992332820282019728792003956564819949
print(pow(mod_make(2, p), p - 1) == 1)

print("-- Diffie-Hellman in miniature: g = 5 modulo 23 --")
let g = mod_make(5, 23)
let alice_public = pow(g, 6)
let bob_public = pow(g, 15)
print(alice_public)
print(bob_public)
print(pow(bob_public, 6))
print(pow(alice_public, 15))

print("-- Chinese remainders: x is 2 mod 3, 3 mod 5 and 2 mod 7 --")
let moduli = [3, 5, 7]
let remainders = [2, 3, 2]
let cofactors = [35, 21, 15]
let x = mod_make(0, 105)
let i = 0
while i < 3 do
  let back = mod_value(pow(mod_make(cofactors[i], moduli[i]), 0 - 1))
  let x = x + mod_make(remainders[i] * cofactors[i] * back, 105)
  let i = i + 1
end
print(x)
print(mod_make(x, 3))
print(mod_make(x, 5))
print(mod_make(x, 7))

print("-- words: modulo 2^32, arithmetic wraps and bits rotate --")
let w = mod_make(4294967295, 4294967296)
print(w + 1)
print(rotl(mod_make(1, 4294967296), 31))
print(mod_make(240, 256) bxor 255)
print(mod_make(240, 256) band 60)
print(mod_make(240, 256) shl 1)
