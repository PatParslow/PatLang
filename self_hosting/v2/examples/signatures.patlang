# Ed25519 signatures (RFC 8032) written in PatLang on modints. A signer makes a
# key pair from a 32-byte seed, signs a message, and anyone holding the public
# key can check it. A changed message, a changed signature or another key all
# fail. (The seed comes from SHA-512 of a passphrase here, standing in for a
# random source, which v2 does not have yet.)
include "../../../packages/curve25519/curve25519.patlang"

make a function called text_bytes takes text returns bytes
  require type_of(text) == "string"
  let bytes = []
  let i = 0
  while i < str_len(text) do
    let bytes = list_push(bytes, cv_byte(char_code(text, i)))
    let i = i + 1
  end
  ensure list_len(bytes) == str_len(text)
  return bytes
end

let seed = cv_slice(sha512(text_bytes("signing passphrase")), 0, 32)
let pk = ed25519_public(seed)
print("public key " + cv_hex(pk))

let msg = text_bytes("Meet at the north gate at noon.")
let sig = ed25519_sign(seed, msg)
print("signature  " + cv_hex(sig))
print("the message verifies: " + to_s(ed25519_verify(pk, msg, sig)))

let forged = text_bytes("Meet at the south gate at noon.")
print("a changed message verifies: " + to_s(ed25519_verify(pk, forged, sig)))

let bent = list_set(sig, 5, sig[5] + 1)
print("a changed signature verifies: " + to_s(ed25519_verify(pk, msg, bent)))

let other = ed25519_public(cv_slice(sha512(text_bytes("someone else")), 0, 32))
print("another key verifies: " + to_s(ed25519_verify(other, msg, sig)))

print("signing is deterministic: " + to_s(cv_hex(ed25519_sign(seed, msg)) == cv_hex(sig)))
