# What the v2 compiler and the v2 interpreter share: from a program's path to its
# IR. Parses the runtime and the program, each file once, and lowers them.
include "../lib/lexer.patlang"
include "../lib/parser.patlang"
include "../lib/includes.patlang"
include "../lib/regex_dsl.patlang"
include "../lib/syntax_dsl.patlang"
include "ir.patlang"
include "lower.patlang"
include "contracts.patlang"
include "index_kinds.patlang"

# The runtime's files for Windows (and WebAssembly, whose host answers the
# Windows calls).
make a function called v2_runtime_files returns files
  return v2_runtime_files_for("windows")
end

# The runtime's files for a target, "windows" or "linux": the same but for the
# file that reaches the system (runtime/os_windows.patlang, os_linux.patlang).
make a function called v2_runtime_files_for takes target returns files
  require (target == "windows") or (target == "linux")
  return ["self_hosting/v2/runtime/os_" + target + ".patlang", "self_hosting/v2/runtime/core.patlang", "self_hosting/v2/runtime/memory.patlang", "self_hosting/v2/runtime/strings.patlang", "self_hosting/v2/runtime/lists.patlang", "self_hosting/v2/runtime/integers.patlang", "self_hosting/v2/runtime/rationals.patlang", "self_hosting/v2/runtime/floats.patlang", "self_hosting/v2/runtime/libm.patlang", "self_hosting/v2/runtime/numbers.patlang", "self_hosting/v2/runtime/closures.patlang", "self_hosting/v2/runtime/objects.patlang", "self_hosting/v2/runtime/logic.patlang", "self_hosting/v2/runtime/vfs.patlang", "self_hosting/v2/runtime/net.patlang", "self_hosting/v2/runtime/hosts.patlang", "self_hosting/v2/runtime/cells.patlang", "self_hosting/v2/runtime/system.patlang", "self_hosting/v2/runtime/threads.patlang", "self_hosting/v2/runtime/fibers.patlang", "self_hosting/v2/runtime/math.patlang", "self_hosting/v2/runtime/worlds.patlang"]
end

# A program's files, each once however many files include it, each before
# the files that include it: pushes [path, text] onto `files`. An include
# line is blank in the text, so line numbers stay the file's own; its path
# resolves against the including file. A file that cannot be read goes on `errors`.
make a function called v2_collect_files takes path, seen, files, errors returns done
  if v2_seen_before(seen, path) then
    return true
  end
  if not file_exists(path) then
    vec_push(errors, "cannot read " + path)
    return false
  end
  return v2_collect_text(path, read_file(path), seen, files, errors)
end

# Whether the path has been collected already; it is recorded if not.
make a function called v2_seen_before takes seen, path returns yes
  let key = path_normalize(path)
  let k = 0
  while k < vec_len(seen) do
    if vec_get(seen, k) == key then
      return true
    end
    let k = k + 1
  end
  vec_push(seen, key)
  return false
end

# As v2_collect_files, for a file whose text is given.
make a function called v2_collect_text takes path, text, seen, files, errors returns done
  let lines = split_lines(text)
  let text = sb_new()
  let i = 0
  while i < list_len(lines) do
    let t = str_trim(lines[i])
    if str_starts_with(t, "include ") then
      v2_collect_files(path_join(path_dirname(path), include_path_of(t)), seen, files, errors)
    else
      sb_push(text, lines[i])
    end
    sb_push(text, chr(10))
    let i = i + 1
  end
  vec_push(files, [path, sb_str(text)])
  return true
end

# Whether this text can hold a `syntax` definition: the word appears in it. A
# definition may stand anywhere a statement may (spec 1.9), so the extractor,
# which skips strings and comments, decides; a file it finds none in comes
# back unchanged.
make a function called v2_defines_syntax takes text returns yes
  require type_of(text) == "string"
  let h = str_intern(text)
  let n = sc_len(h)
  let yes = false
  let i = 0
  while (i < n) and (not yes) do
    if sdsl_starts_keyword_at(h, i, "syntax") then
      let yes = true
    end
    let i = i + 1
  end
  ensure type_of(yes) == "bool"
  return yes
end

# Expands `syntax` definitions in a program's files, in the order they are
# collected: a definition holds in its own file and the files after it. The
# scan is only for files that can need it.
make a function called v2_expand_syntax takes files, first returns defs
  let defs = []
  let i = first
  while i < vec_len(files) do
    let f = vec_get(files, i)
    if (list_len(defs) > 0) or v2_defines_syntax(f[1]) then
      let r = expand_syntax_dsls_with(f[1], defs)
      vec_set(files, i, [f[0], r[0]])
      let defs = r[1]
    end
    let i = i + 1
  end
  return defs
end

# A file's statements, and any parse errors in it: [stmts, errors]. The
# parser leaves ["Err", message, line] where it could not parse, at the top of
# a statement or anywhere inside one.
make a function called v2_parse_file takes path, text returns result
  let ast = parse_program(tokenize(text))
  let stmts = ast[1]
  let found = vec_new()
  v2_parse_errors(stmts, found)
  let errors = []
  let i = 0
  while i < vec_len(found) do
    let e = vec_get(found, i)
    let errors = list_push(errors, path + ": line " + e[2] + ": " + e[1])
    let i = i + 1
  end
  return [stmts, errors]
end

# ---- a loop body that takes the loop's counter for an inner loop (#267) ----
#
# A let has no block scope, so `let s = 1` in a loop's body, followed by an
# inner loop counting with s, loses the outer loop's count (CLAUDE.md 4.6).
# The warning is for exactly that shape: a let directly in the body that sets
# a name the loop's condition reads, from a value that does not read it, and a
# later loop in the same body whose condition reads it. An inner loop that
# moves the shared index on (a lexer skipping spaces) reads the name it sets,
# and is not warned of: over 851 files, this shape was only ever the bug.

# The names a syntax tree reads, pushed onto acc.
make a function called v2_reads_into takes node, acc returns done
  if type_of(node) != "list" then
    return false
  end
  if (list_len(node) == 2) and (node[0] == "Var") and (type_of(node[1]) == "string") then
    vec_push(acc, node[1])
    return true
  end
  let i = 0
  while i < list_len(node) do
    v2_reads_into(node[i], acc)
    let i = i + 1
  end
  return true
end

make a function called v2_reads takes node, name returns yes
  let acc = vec_new()
  v2_reads_into(node, acc)
  let k = 0
  while k < vec_len(acc) do
    if vec_get(acc, k) == name then
      return true
    end
    let k = k + 1
  end
  return false
end

# Pushes a warning onto out for each loop in node that has the shape above.
make a function called v2_loop_rebinds_into takes path, node, out returns done
  if type_of(node) != "list" then
    return false
  end
  if (list_len(node) >= 4) and (node[0] == "While") and (type_of(node[2]) == "list") then
    let body = node[2]
    let j = 0
    while j < list_len(body) do
      let st = body[j]
      if (type_of(st) == "list") and (list_len(st) >= 3) and (st[0] == "Let") and (type_of(st[1]) == "string") then
        if v2_reads(node[1], st[1]) and (not v2_reads(st[2], st[1])) then
          let later = j + 1
          let found = false
          while (later < list_len(body)) and (not found) do
            let st2 = body[later]
            if (type_of(st2) == "list") and (list_len(st2) >= 3) and (st2[0] == "While") and v2_reads(st2[1], st[1]) then
              let found = true
            end
            let later = later + 1
          end
          if found then
            vec_push(out, path + ": line " + node[3] + ": this loop's body sets " + st[1] + ", which the loop's condition reads, then counts an inner loop with it: a let has no block scope, so the loop's own count is lost")
          end
        end
      end
      let j = j + 1
    end
  end
  let i = 0
  while i < list_len(node) do
    v2_loop_rebinds_into(path, node[i], out)
    let i = i + 1
  end
  return true
end

# Pushes onto found each Err node in node, a syntax tree or a list of them,
# in the order they are written.
make a function called v2_parse_errors takes node, found returns done
  if type_of(node) != "list" then return false end
  let n = list_len(node)
  if (n == 3) and (node[0] == "Err") and (type_of(node[2]) == "int") then
    vec_push(found, node)
    return true
  end
  let i = 0
  while i < n do
    v2_parse_errors(node[i], found)
    let i = i + 1
  end
  return true
end

# Function names declared twice, each as its source has it: a program's function
# may have a name the runtime has, but not one another of its files has.
make a function called v2_duplicate_names takes fns returns dups
  let prefix = lw_user_name("")
  let seen = []
  let dups = []
  let i = 0
  while i < list_len(fns) do
    let n = ir_fn_name(fns[i])
    if v2_contains(seen, n) then
      if str_starts_with(n, prefix) then
        let dups = list_push(dups, substr(n, prefix.length, n.length - prefix.length))
      else
        let dups = list_push(dups, n)
      end
    end
    let seen = list_push(seen, n)
    let i = i + 1
  end
  return dups
end

# Whether a file declares quiet_operators() at its top level: its
# operators raise no events (docs/plans/v2-implementation.md, section 4).
make a function called v2_declares_quiet takes stmts returns yes
  return v2_declares(stmts, "quiet_operators")
end

# Whether a file declares runtime_functions_by_name() at its top level: every
# runtime function can then be reached by its name (lower.patlang,
# lw_by_name_registrations). The interpreter is what needs it.
make a function called v2_declares_all_by_name takes stmts returns yes
  return v2_declares(stmts, "runtime_functions_by_name")
end

make a function called v2_declares takes stmts, name returns yes
  let i = 0
  while i < list_len(stmts) do
    let st = stmts[i]
    if (st[0] == "Expr") and (st[1][0] == "Call") and (st[1][1] == name) then
      return true
    end
    let i = i + 1
  end
  return false
end

# ["ok", lw_program's result], or ["error", messages]. The runtime's files are
# found under runtime_root, "" being the current directory; runtime_ensures:
# whether their ensures are checked (--check-runtime, contracts.patlang).
make a function called v2_front_end takes src_path, runtime_root, runtime_ensures returns result
  return v2_front_end_for(src_path, runtime_root, runtime_ensures, "windows")
end

# The front end for a target, "windows" or "linux" (v2_runtime_files_for).
make a function called v2_front_end_for takes src_path, runtime_root, runtime_ensures, target returns result
  let collected = vec_new()
  let seen = vec_new()
  let unread = vec_new()
  let runtime_files = v2_runtime_files_for(target)
  let i = 0
  while i < list_len(runtime_files) do
    v2_collect_files(runtime_root + runtime_files[i], seen, collected, unread)
    let i = i + 1
  end
  let runtime_count = vec_len(collected)
  v2_collect_files(src_path, seen, collected, unread)
  if vec_len(unread) > 0 then
    return ["error", vec_to_list(unread)]
  end
  v2_expand_syntax(collected, runtime_count)
  let files = vec_to_list(collected)
  # the runtime's files parsed as a build before parsed them, when nothing
  # they depend on has changed (v2_runtime_parsed)
  let cache_key = v2_parsed_key(files, runtime_count)
  let cache = runtime_root + "self_hosting/build/v2_runtime_parsed.bin"
  let cached = []
  if cache_key != "" then
    let cached = v2_read_parsed(cache, cache_key, runtime_count)
  end
  let parsed_files = []
  let runtime_stmts = []
  let errors = []
  let warnings = vec_new()
  let own_files = []
  let i = 0
  while i < list_len(files) do
    if (i < runtime_count) and (list_len(cached) == runtime_count) then
      let parsed = [cached[i], []]
    else
      let parsed = v2_parse_file(files[i][0], files[i][1])
    end
    if i < runtime_count then
      let runtime_stmts = list_push(runtime_stmts, parsed[0])
    else
      v2_loop_rebinds_into(files[i][0], parsed[0], warnings)
      let own_files = list_push(own_files, [files[i][0], parsed[0]])
    end
    let parsed_files = list_push(parsed_files, [parsed[0], v2_declares_quiet(parsed[0]), v2_declares_all_by_name(parsed[0]), i < runtime_count, runtime_ensures])
    let errors = v2_concat(errors, parsed[1])
    let i = i + 1
  end
  if list_len(errors) > 0 then
    return ["error", errors]
  end
  # an index that is certainly not an int or a modint (index_kinds.patlang)
  let found = ik_warnings(own_files)
  let w = 0
  while w < list_len(found) do
    vec_push(warnings, found[w])
    let w = w + 1
  end
  if (cache_key != "") and (list_len(cached) != runtime_count) then
    v2_write_parsed(cache, cache_key, runtime_stmts)
  end
  let lowered = lw_program(parsed_files)
  if list_len(lowered[1]) > 0 then
    return ["error", lowered[1]]
  end
  let dups = v2_duplicate_names(lowered[0])
  if list_len(dups) > 0 then
    return ["error", ["declared twice: " + dups]]
  end
  return ["ok", lowered, files, vec_to_list(warnings)]
end

# The path of the executable running; "" in a browser, where the compiler built
# as WebAssembly runs from no file, and so keeps no key and no cache.
make a function called v2_own_path returns path
  let path = program_path()
  ensure type_of(path) == "string"
  return path
end

# ---- the runtime's files, parsed once (review finding O10) ----
#
# Parsing the runtime's 20 files took half of every compile's front end (about
# 2.5 s of 5 s for a one-line program), and a runtime file's statements depend
# on its text and on the parser alone: syntax definitions are expanded in a
# program's files, never the runtime's (v2_expand_syntax). So they are kept in
# self_hosting/build/v2_runtime_parsed.bin, keyed by the compiler's own key
# (which changes with the parser) and each runtime file's path, length and
# hash. A compiler with no key beside it keeps none. The file is only a saving:
# one that is missing, of another key, or damaged is parsed again and written
# again.

# The key of the runtime's parsed files, or "" when this compiler has no key.
make a function called v2_parsed_key takes files, runtime_count returns key
  require runtime_count <= list_len(files)
  let own = v2_own_path()
  let path = own + ".key"
  if (own == "") or (not file_exists(path)) then
    let key = ""
    ensure key == ""
    return key
  end
  let b = sb_new()
  sb_push(b, "v2 parsed runtime 1 " + str_trim(read_file(path)))
  let i = 0
  while i < runtime_count do
    sb_push(b, " " + files[i][0] + " " + str_len(files[i][1]) + " " + str_hash(files[i][1]))
    let i = i + 1
  end
  let key = sb_str(b)
  ensure value_class(key) == 8
  return key
end

# A count, as LEB128: seven bits a byte, low first, the high bit set on all
# but the last.
make a function called v2_put_count takes b, n returns ok
  require (value_class(n) == 2) and (n >= 0)
  let x = n
  while x >= 128 do
    bytes_push(b, (x band 127) bor 128)
    let x = x shr 7
  end
  bytes_push(b, x)
  let ok = true
  ensure ok
  return ok
end

# v appended to b: a list (L, its count, its items), a string (S, its length
# in bytes, its UTF-8 bytes), an int (I or N for a negative, its magnitude),
# true (T) or false (F). False when v holds anything else, or a string that
# would not read back as itself: such a value is not kept.
make a function called v2_ast_put takes b, v returns ok
  let c = value_class(v)
  if c == 9 then
    bytes_push(b, 76)
    v2_put_count(b, list_len(v))
    let i = 0
    while i < list_len(v) do
      if not v2_ast_put(b, v[i]) then
        return false
      end
      let i = i + 1
    end
    return true
  end
  if c == 8 then
    let raw = bytes_from_str(v)
    if bytes_to_str(raw) != v then
      return false
    end
    bytes_push(b, 83)
    v2_put_count(b, bytes_len(raw))
    bytes_extend(b, raw)
    return true
  end
  if c == 2 then
    if v >= 0 then
      bytes_push(b, 73)
      v2_put_count(b, v)
    else
      bytes_push(b, 78)
      v2_put_count(b, 0 - v)
    end
    return true
  end
  if c == 1 then
    if v then
      bytes_push(b, 84)
    else
      bytes_push(b, 70)
    end
    return true
  end
  return false
end

# Reading: st is a vec [position, still good]; a read past the end, or a tag
# that is none of the above, marks it bad and gives 0.
make a function called v2_get_byte takes b, st returns v
  let p = vec_get(st, 0)
  if p >= bytes_len(b) then
    vec_set(st, 1, false)
    return 0
  end
  vec_set(st, 0, p + 1)
  return bytes_get(b, p)
end

make a function called v2_get_count takes b, st returns n
  let n = 0
  let shift = 0
  let going = true
  while going and vec_get(st, 1) do
    let x = v2_get_byte(b, st)
    let n = n bor ((x band 127) shl shift)
    let shift = shift + 7
    let going = (x >= 128) and (shift < 63)
  end
  return n
end

make a function called v2_ast_get takes b, st returns v
  let tag = v2_get_byte(b, st)
  if not vec_get(st, 1) then
    return 0
  end
  if tag == 76 then
    let n = v2_get_count(b, st)
    let out = []
    let i = 0
    while (i < n) and vec_get(st, 1) do
      let out = list_push(out, v2_ast_get(b, st))
      let i = i + 1
    end
    return out
  end
  if tag == 83 then
    let n = v2_get_count(b, st)
    let p = vec_get(st, 0)
    if (not vec_get(st, 1)) or (p + n > bytes_len(b)) then
      vec_set(st, 1, false)
      return ""
    end
    vec_set(st, 0, p + n)
    return bytes_to_str(bytes_slice(b, p, n))
  end
  if tag == 73 then
    return v2_get_count(b, st)
  end
  if tag == 78 then
    return 0 - v2_get_count(b, st)
  end
  if tag == 84 then
    return true
  end
  if tag == 70 then
    return false
  end
  vec_set(st, 1, false)
  return 0
end

# The runtime files' statements kept under this key, n of them, or [] when
# the file is missing, of another key, or damaged. The file is the key, the
# statements' bytes_hash, then the statements: a changed byte that still
# decodes is caught by the hash.
make a function called v2_read_parsed takes cache, key, n returns stmts
  if not file_exists(cache) then
    return []
  end
  let b = read_file_raw(cache)
  let st = vec_new()
  vec_push(st, 0)
  vec_push(st, true)
  let stored_key = v2_ast_get(b, st)
  if (not vec_get(st, 1)) or (stored_key != key) then
    return []
  end
  let h = v2_get_count(b, st)
  let at = vec_get(st, 0)
  if (not vec_get(st, 1)) or (at > bytes_len(b)) then
    return []
  end
  let rest = bytes_slice(b, at, bytes_len(b) - at)
  if bytes_hash(rest) != h then
    return []
  end
  let st = vec_new()
  vec_push(st, 0)
  vec_push(st, true)
  let all = v2_ast_get(rest, st)
  if (not vec_get(st, 1)) or (vec_get(st, 0) != bytes_len(rest)) or (value_class(all) != 9) or (list_len(all) != n) then
    return []
  end
  let stmts = all
  ensure list_len(stmts) == n
  return stmts
end

# Keeps the runtime files' statements under key: written whole under a name of
# its own, then moved over the cache, as the declarations are
# (v2_write_declarations). Nothing is kept when a value cannot be.
make a function called v2_write_parsed takes cache, key, stmts returns done
  let payload = bytes_new(0)
  if not v2_ast_put(payload, stmts) then
    return false
  end
  let b = bytes_new(0)
  v2_ast_put(b, key)
  v2_put_count(b, bytes_hash(payload))
  bytes_extend(b, payload)
  let temp = cache + "." + v2_hex(random_bytes(8)) + ".tmp"
  if write_file_bytes(temp, b) then
    if not try_rename_file(temp, cache) then
      remove_file(temp)
    end
  end
  return true
end

# The runtime as an interpreted program needs it, read and parsed once: its
# files' functions with their declarations alone, since the interpreter calls
# the runtime's own compiled functions and lowering reads only what a
# function takes. [the paths collected, the parsed files].
#
# Parsing the runtime's 20 files took most of an interpreter's start (2.4 s of
# a one-line program, review finding O10), so the declarations are cached in
# self_hosting/build/v2_runtime_declarations.txt, keyed by each runtime
# file's size and time of writing: a start whose key matches reads them from
# there, and any other parses and writes the cache again.
make a function called v2_runtime_declarations takes runtime_root returns rt
  let key = v2_runtime_key(runtime_root)
  let cache = runtime_root + "self_hosting/build/v2_runtime_declarations.txt"
  if file_exists(cache) then
    let cached = v2_read_declarations(read_file(cache), key)
    if list_len(cached) == 2 then
      return cached
    end
  end
  let rt = v2_parse_runtime_declarations(runtime_root)
  v2_write_declarations(cache, key, rt)
  return rt
end

# The runtime files' names, sizes and times of writing, as one line, after the
# files this build of the interpreter reads: an interpreter with another list
# (one built before a file was added) must not take this one's cache, nor this
# one its, though no file has changed.
make a function called v2_runtime_key takes runtime_root returns key
  let rows = dir_files(runtime_root + "self_hosting/v2/runtime")
  let b = sb_new()
  let listed = v2_runtime_files()
  let i = 0
  while i < list_len(listed) do
    sb_push(b, listed[i] + " ")
    let i = i + 1
  end
  sb_push(b, "| ")
  let i = 0
  while i < list_len(rows) do
    sb_push(b, rows[i][0] + ":" + rows[i][1] + ":" + rows[i][2] + " ")
    let i = i + 1
  end
  return sb_str(b)
end

make a function called v2_parse_runtime_declarations takes runtime_root returns rt
  let collected = vec_new()
  let seen = vec_new()
  let unread = vec_new()
  let runtime_files = v2_runtime_files()
  let i = 0
  while i < list_len(runtime_files) do
    v2_collect_files(runtime_root + runtime_files[i], seen, collected, unread)
    let i = i + 1
  end
  let parsed_files = []
  let i = 0
  while i < vec_len(collected) do
    let f = vec_get(collected, i)
    let parsed = v2_parse_file(f[0], f[1])
    let stmts = []
    let k = 0
    while k < list_len(parsed[0]) do
      let st = parsed[0][k]
      if st[0] == "Func" then
        let st = list_set(st, 3, [])
        if list_len(st) > 4 then
          let st = list_set(st, 4, "")
        end
        let stmts = list_push(stmts, st)
      end
      let k = k + 1
    end
    let parsed_files = list_push(parsed_files, [stmts, v2_declares_quiet(parsed[0]), v2_declares_all_by_name(parsed[0]), true, false])
    let i = i + 1
  end
  return [vec_to_list(seen), parsed_files]
end

# The cache's text: the key; a line per path collected; for each file a line,
# then a line per function: its node's length, name, parameters and the
# events it raises; and last the count of functions, so a file cut short is
# never taken for whole.
make a function called v2_write_declarations takes cache, key, rt returns done
  let tab = chr(9)
  let nl = chr(10)
  let b = sb_new()
  sb_push(b, "key" + tab + key + nl)
  let i = 0
  while i < list_len(rt[0]) do
    sb_push(b, "path" + tab + rt[0][i] + nl)
    let i = i + 1
  end
  let count = 0
  let f = 0
  while f < list_len(rt[1]) do
    let file = rt[1][f]
    sb_push(b, "file" + tab + file[1] + tab + file[2] + nl)
    let k = 0
    while k < list_len(file[0]) do
      let st = file[0][k]
      let raises = []
      if list_len(st) > 5 then
        let raises = st[5]
      end
      sb_push(b, "func" + tab + list_len(st) + tab + st[1] + tab + str_join(st[2], ",") + tab + str_join(raises, ",") + nl)
      let count = count + 1
      let k = k + 1
    end
    let f = f + 1
  end
  sb_push(b, "end" + tab + count + nl)
  # written whole under a name of its own, then moved over the cache, so a
  # start reading it at the same moment sees the old file or the new one
  # A cache is only a saving: a write or a move the system refuses (no files in
  # a browser; the cache open in another start) leaves it as it was, and the
  # start goes on
  let temp = cache + "." + v2_hex(random_bytes(8)) + ".tmp"
  if write_file(temp, sb_str(b)) then
    if not try_rename_file(temp, cache) then
      remove_file(temp)
    end
  end
  return true
end

# The declarations in a cache's text, or [] when its key is not this one or
# it is not whole.
make a function called v2_read_declarations takes text, key returns rt
  let lines = split_lines(text)
  let tab = chr(9)
  if (list_len(lines) < 2) or (lines[0] != "key" + tab + key) then
    return []
  end
  let paths = []
  let files = []
  let stmts = []
  let flags = []
  let count = 0
  let i = 1
  while i < list_len(lines) do
    let parts = v2_split_tabs(lines[i])
    if parts[0] == "path" then
      let paths = list_push(paths, parts[1])
    elif parts[0] == "file" then
      if list_len(flags) > 0 then
        let files = list_push(files, [stmts, flags[0], flags[1]])
      end
      let stmts = []
      let flags = [parts[1] == "true", parts[2] == "true"]
    elif parts[0] == "func" then
      let st = ["Func", parts[2], v2_split_commas(parts[3]), []]
      let len = to_num(parts[1])
      if len > 4 then
        let st = list_push(st, "")
      end
      if len > 5 then
        let st = list_push(st, v2_split_commas(parts[4]))
      end
      let stmts = list_push(stmts, st)
      let count = count + 1
    elif parts[0] == "end" then
      if list_len(flags) > 0 then
        let files = list_push(files, [stmts, flags[0], flags[1]])
      end
      if to_num(parts[1]) != count then
        return []
      end
      return [paths, files]
    end
    let i = i + 1
  end
  # no end line: cut short
  return []
end

make a function called v2_split_tabs takes line returns parts
  let parts = []
  let cur = sb_new()
  let i = 0
  while i < line.length do
    if char_code(line, i) == 9 then
      let parts = list_push(parts, sb_str(cur))
      let cur = sb_new()
    else
      sb_push(cur, line[i])
    end
    let i = i + 1
  end
  return list_push(parts, sb_str(cur))
end

make a function called v2_split_commas takes text returns parts
  if text == "" then
    return []
  end
  let parts = []
  let cur = sb_new()
  let i = 0
  while i < text.length do
    if char_code(text, i) == 44 then
      let parts = list_push(parts, sb_str(cur))
      let cur = sb_new()
    else
      sb_push(cur, text[i])
    end
    let i = i + 1
  end
  return list_push(parts, sb_str(cur))
end

# Bytes as lowercase hex, two digits each.
make a function called v2_hex takes bytes returns text
  let digits = "0123456789abcdef"
  let b = sb_new()
  let i = 0
  while i < list_len(bytes) do
    sb_push(b, substr(digits, word_shr(bytes[i], 4), 1))
    sb_push(b, substr(digits, word_and(bytes[i], 15), 1))
    let i = i + 1
  end
  return sb_str(b)
end

# v2_front_end for a program the interpreter runs, given its path and its text,
# with the runtime's declarations (v2_runtime_declarations).
make a function called v2_front_end_text takes rt, src_path, text returns result
  return v2_front_end_text_traced(rt, src_path, text, false)
end

# v2_front_end_text, the program lowered with a trace when trace is true
# (lower.patlang, lw_program_traced).
make a function called v2_front_end_text_traced takes rt, src_path, text, trace returns result
  let collected = vec_new()
  let seen = vec_new()
  let unread = vec_new()
  let i = 0
  while i < list_len(rt[0]) do
    vec_push(seen, rt[0][i])
    let i = i + 1
  end
  v2_seen_before(seen, src_path)
  v2_collect_text(src_path, text, seen, collected, unread)
  if vec_len(unread) > 0 then
    return ["error", vec_to_list(unread)]
  end
  v2_expand_syntax(collected, 0)
  let files = vec_to_list(collected)
  let parsed_files = rt[1]
  let errors = []
  let i = 0
  while i < list_len(files) do
    let parsed = v2_parse_file(files[i][0], files[i][1])
    let parsed_files = list_push(parsed_files, [parsed[0], v2_declares_quiet(parsed[0]), v2_declares_all_by_name(parsed[0])])
    let errors = v2_concat(errors, parsed[1])
    let i = i + 1
  end
  if list_len(errors) > 0 then
    return ["error", errors]
  end
  let lowered = lw_program_traced(parsed_files, trace)
  if list_len(lowered[1]) > 0 then
    return ["error", lowered[1]]
  end
  let dups = v2_duplicate_names(lowered[0])
  if list_len(dups) > 0 then
    return ["error", ["declared twice: " + dups]]
  end
  return ["ok", lowered, files]
end
