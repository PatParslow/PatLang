# The IR's text form (docs/spec/ir.md): what compile.patlang --ir writes for
# a reader to build from.

make a function called it_hex takes n returns s
  require (n >= 0) and (n < 256)
  let digits = "0123456789abcdef"
  let s = digits[floor(n / 16)] + digits[n % 16]
  ensure s.length == 2
  return s
end

# A string between quotes, each byte of its UTF-8 form outside 32 to 126, and
# each quote and backslash, written as a backslash and two hex digits.
make a function called it_push_string takes b, s returns done
  require type_of(s) == "string"
  let bytes = vec_new()
  let i = 0
  while i < s.length do
    xv_utf8(bytes, char_code(s, i))
    let i = i + 1
  end
  sb_push(b, chr(34))
  let i = 0
  while i < vec_len(bytes) do
    let c = vec_get(bytes, i)
    if (c < 32) or (c > 126) or (c == 34) or (c == 92) then
      sb_push(b, chr(92) + it_hex(c))
    else
      sb_push(b, chr(c))
    end
    let i = i + 1
  end
  sb_push(b, chr(34))
  return true
end

# An int, a string or a list of them; the IR holds nothing else.
make a function called it_push_value takes b, v returns done
  let t = type_of(v)
  require (t == "list") or (t == "string") or (t == "int")
  if t == "list" then
    sb_push(b, "[")
    let i = 0
    while i < list_len(v) do
      if i > 0 then
        sb_push(b, " ")
      end
      it_push_value(b, v[i])
      let i = i + 1
    end
    sb_push(b, "]")
    return true
  end
  if t == "string" then
    return it_push_string(b, v)
  end
  sb_push(b, "" + v)
  return true
end

# The program's IR: the format line, the one fact code generation reads,
# then each function after the ownership stage, one per line.
make a function called it_program_text takes fns, facts returns text
  let b = sb_new()
  sb_push(b, "v2-ir 1" + xv_nl())
  let plus = 0
  if xv_facts_used(facts)[0] then
    let plus = 1
  end
  sb_push(b, "plus_events " + plus + xv_nl())
  let i = 0
  while i < list_len(fns) do
    it_push_value(b, own_function(fns[i]))
    sb_push(b, xv_nl())
    let i = i + 1
  end
  let text = sb_str(b)
  ensure str_starts_with(text, "v2-ir 1" + xv_nl())
  return text
end
