# v2 jobs and artefacts (docs/plans/memory-design-review.md section 7;
# docs/plans/v2-implementation.md, milestone 8).
#
# After the lowering, each function is one job: the ownership stage, code
# generation and assembly, giving the function's chunk. A job's key is the
# SHA-256 of everything its output depends on (see "keys" below):
#   - the function's IR;
#   - what code generation reads of the program facts (B2:
#     xv_facts_used);
#   - the ownership summary of every function it calls (never their
#     bodies);
#   - the compiler: its stages' source text.
# Its output is an artefact stored under that key, so a later build whose
# job has the same key reuses it instead of running the job.
#
# The jobs run on a number of workers, each taking its share of the jobs
# in the order given; the chunks are linked in declaration order whatever
# order the jobs ran in, so any worker count gives the same executable.

include "../../packages/sha256/sha256.patlang"

# ---- bucket indexes: two 32-bit FNV-1a lanes ----
#
# A hash is [a, b], for a table's bucket index only: a collision there costs
# a comparison, never a wrong answer. The functions below keep the two lanes
# in locals while they mix a whole string or integer, so each costs one list,
# not one per character. An integer is mixed as its eight bytes, low first
# (its two's complement, so every fixnum has its own bytes).

make a function called jb_hash_new returns h
  let h = [2166136261, 84696351]
  ensure list_len(h) == 2
  return h
end

# Lanes a and b with the code `tag` mixed in (none when tag < 0), then
# each character of s.
make a function called jb_lanes takes a, b, tag, s returns out
  require (a >= 0) and (b >= 0) and (type_of(s) == "string")
  if tag >= 0 then
    let a = ((a bxor tag) * 16777619) % 4294967296
    let b = ((b bxor ((tag + 101) % 256)) * 16777619) % 4294967296
  end
  let n = s.length
  let i = 0
  while i < n do
    let c = char_code(s, i)
    let a = ((a bxor c) * 16777619) % 4294967296
    let b = ((b bxor ((c + 101) % 256)) * 16777619) % 4294967296
    let i = i + 1
  end
  let out = [a, b]
  ensure list_len(out) == 2
  return out
end

# Lanes a and b with the code `tag` mixed in, then the eight bytes of the
# fixnum n.
make a function called jb_lanes_int takes a, b, tag, n returns out
  require (a >= 0) and (b >= 0) and (tag >= 0) and (value_class(n) == 2)
  let a = ((a bxor tag) * 16777619) % 4294967296
  let b = ((b bxor ((tag + 101) % 256)) * 16777619) % 4294967296
  let x = n
  let k = 0
  while k < 8 do
    let c = x band 255
    let a = ((a bxor c) * 16777619) % 4294967296
    let b = ((b bxor ((c + 101) % 256)) * 16777619) % 4294967296
    let x = x shr 8
    let k = k + 1
  end
  let out = [a, b]
  ensure (list_len(out) == 2) and (k == 8)
  return out
end

make a function called jb_mix_text takes h, s returns out
  require list_len(h) == 2
  let h = jb_lanes_int(h[0], h[1], 83, s.length)
  let out = jb_lanes(h[0], h[1], -1, s)
  ensure list_len(out) == 2
  return out
end

# ---- keys: SHA-256 of an encoding ----
#
# A key names an artefact the build reuses unseen, so two inputs must never
# share one: the FNV lanes above are for bucket indexes only, where a
# collision costs a comparison (review finding S13: 64 bits of FNV-1a can be
# made to collide). A key is the SHA-256 of an encoding of its inputs in
# which each item says what it is and how long, so no two inputs encode
# alike: a string is s, its length, :, its text; an int i, its digits, ;; a
# list l, its length, :, then its items; anything else o, its type, :, then
# its printed form as a string.

make a function called jb_enc_text takes b, s returns b2
  sb_push(b, "s" + s.length + ":")
  sb_push(b, s)
  return b
end

make a function called jb_enc_value takes b, v returns b2
  let c = value_class(v)
  if c == 9 then
    sb_push(b, "l" + list_len(v) + ":")
    let i = 0
    while i < list_len(v) do
      jb_enc_value(b, v[i])
      let i = i + 1
    end
    return b
  end
  if c == 8 then
    return jb_enc_text(b, v)
  end
  if c == 2 then
    sb_push(b, "i" + v + ";")
    return b
  end
  sb_push(b, "o" + type_of(v) + ":")
  return jb_enc_text(b, "" + v)
end

# An encoding's key: its SHA-256, in hex (a file name's safe characters).
make a function called jb_digest takes b returns key
  let key = sha256_string_hex(sb_str(b))
  ensure key.length == 64
  return key
end

# ---- ownership summaries ----

# What a caller may assume of a function: under the ownership stage's
# uniform rules (own.patlang), every parameter is borrowed and the result
# is owned by the caller. A function's arity is the only thing that varies.
make a function called jb_summary takes func returns s
  return [ir_fn_name(func), ir_fn_nparams(func), "borrows every parameter", "result owned by the caller"]
end

# The names a function calls.
make a function called jb_callees takes func returns names
  let names = []
  let instrs = ir_fn_instrs(func)
  let i = 0
  while i < list_len(instrs) do
    let ins = instrs[i]
    if ins[0] == "call" then
      if not v2_contains(names, ins[2]) then
        let names = list_push(names, ins[2])
      end
    end
    let i = i + 1
  end
  return names
end

# A table from a function's name to its summary: 1024 buckets by the
# name's hash, each a list of [name, summary].
make a function called jb_bucket takes name returns i
  let h = jb_mix_text(jb_hash_new(), name)
  return h[0] % 1024
end

make a function called jb_summaries takes fns returns table
  let table = vec_new()
  let i = 0
  while i < 1024 do
    vec_push(table, [])
    let i = i + 1
  end
  let i = 0
  while i < list_len(fns) do
    let s = jb_summary(fns[i])
    let k = jb_bucket(s[0])
    vec_set(table, k, list_push(vec_get(table, k), [s[0], s]))
    let i = i + 1
  end
  return table
end

make a function called jb_summary_of takes table, name returns s
  let entries = vec_get(table, jb_bucket(name))
  let i = 0
  while i < list_len(entries) do
    if entries[i][0] == name then
      return entries[i][1]
    end
    let i = i + 1
  end
  # a runtime primitive, or a name the linker will report
  return [name, "no summary"]
end

# ---- keys ----

# The compiler's part of every key identifies the compiler that runs, not the
# sources on disk, which may have changed since it was built (#254). When v2
# builds a program that declares jb_compiler_key, it writes OUT.key beside it:
# the hash of every source the program was built from, as they were read.

# A program's key: its files' texts, in the order they were collected.
make a function called jb_sources_key takes files returns key
  require value_class(files) == 9
  let b = sb_new()
  let i = 0
  while i < list_len(files) do
    jb_enc_text(b, files[i][1])
    let i = i + 1
  end
  let key = jb_digest(b)
  ensure key.length > 0
  return key
end

# The key beside the compiler running, or "" when it has none.
make a function called jb_compiler_key returns key
  let path = v2_own_path() + ".key"
  let key = ""
  if file_exists(path) then
    let key = str_trim(read_file(path))
  end
  ensure type_of(key) == "string"
  return key
end

# A job's key: the compiler's key (base), then what the job's output depends on.
make a function called jb_fn_key takes base, func, facts, table returns key
  let b = sb_new()
  jb_enc_text(b, base)
  jb_enc_value(b, xv_facts_used(facts))
  jb_enc_value(b, func)
  let callees = jb_callees(func)
  let i = 0
  while i < list_len(callees) do
    jb_enc_value(b, jb_summary_of(table, callees[i]))
    let i = i + 1
  end
  return jb_digest(b)
end

# The entry code's key: the compiler's key, then the entry's text.
make a function called jb_entry_key takes base, entry returns key
  let b = sb_new()
  jb_enc_text(b, base)
  jb_enc_text(b, entry)
  return jb_digest(b)
end

# ---- chunk artefacts: the text and data sections' bytes as they are
# (KEY.text, KEY.data), and the rest one record per line, fields
# separated by spaces (KEY.chunk) ----
#   t N               the text section's length
#   d N               the data section's length
#   b N               the bss size
#   s NAME SECTION OFFSET GLOBAL(0|1)
#   r SECTION OFFSET LABEL KIND ADDEND
#   e NAME
# A chunk with a name holding a space or line break is not stored.

make a function called jb_plain takes s returns ok
  let i = 0
  while i < s.length do
    let c = char_code(s, i)
    if (c == 32) or (c == 10) or (c == 13) then
      return false
    end
    let i = i + 1
  end
  return s.length > 0
end

make a function called jb_chunk_text takes chunk returns text
  let b = sb_new()
  sb_push(b, "t " + list_len(chunk[1]) + chr(10))
  sb_push(b, "d " + list_len(chunk[2]) + chr(10))
  sb_push(b, "b " + chunk[3] + chr(10))
  let syms = chunk[4]
  let i = 0
  while i < list_len(syms) do
    let s = syms[i]
    if not (jb_plain(s[0]) and jb_plain(s[1])) then
      return false
    end
    let g = 0
    if s[3] then
      let g = 1
    end
    sb_push(b, "s " + s[0] + " " + s[1] + " " + s[2] + " " + g + chr(10))
    let i = i + 1
  end
  let relocs = chunk[5]
  let i = 0
  while i < list_len(relocs) do
    let r = relocs[i]
    if not (jb_plain(r[0]) and jb_plain(r[2]) and jb_plain(r[3])) then
      return false
    end
    sb_push(b, "r " + r[0] + " " + r[1] + " " + r[2] + " " + r[3] + " " + r[4] + chr(10))
    let i = i + 1
  end
  let ext = chunk[6]
  let i = 0
  while i < list_len(ext) do
    if not jb_plain(ext[i]) then
      return false
    end
    sb_push(b, "e " + ext[i] + chr(10))
    let i = i + 1
  end
  return sb_str(b)
end

# A stored chunk back: its record (KEY.chunk) as text, each line's fields
# cut out where its spaces are, then its sections from KEY.text and KEY.data.
# The record is read through str_intern's handle, so reading a character
# costs the same wherever it is, whatever characters the names hold.
#
# Gives [chunk, assembly text], or false unless every artefact is complete: the
# record ends in its "z" line and each file has the length the record gives. An
# artefact being written, by this build or another, is shorter than that, and a
# job's artefacts are the same bytes whoever writes them.
make a function called jb_chunk_from_text takes text, stem returns stored
  let h = str_intern(text)
  let n = sc_len(h)
  if n < 3 then
    return false
  end
  if (sc_code(h, n - 3) != 10) or (sc_code(h, n - 2) != 122) or (sc_code(h, n - 1) != 10) then
    return false
  end
  let asm_text = ""
  let text_bytes = []
  let data_bytes = []
  let bss = 0
  let syms = []
  let relocs = []
  let ext = []
  let i = 0
  while i < n do
    # the line's fields, each as where it starts and where it ends
    let starts = []
    let pasts = []
    let a = i
    let c = sc_code(h, i)
    while (i < n) and (c != 10) do
      if c == 32 then
        let starts = list_push(starts, a)
        let pasts = list_push(pasts, i)
        let a = i + 1
      end
      let i = i + 1
      let c = sc_code(h, i)
    end
    let past = i
    if (past > a) and (sc_code(h, past - 1) == 13) then
      let past = past - 1
    end
    let starts = list_push(starts, a)
    let pasts = list_push(pasts, past)
    let i = i + 1
    let tag = sc_code(h, starts[0])
    if pasts[0] - starts[0] != 1 then
      let tag = 0
    end
    if tag == 116 then
      let size = jb_num_at(h, starts[1], pasts[1])
      let text_bytes = read_file_bytes(stem + ".text", 0, size)
      if list_len(text_bytes) != size then
        return false
      end
    elif tag == 100 then
      let size = jb_num_at(h, starts[1], pasts[1])
      let data_bytes = read_file_bytes(stem + ".data", 0, size)
      if list_len(data_bytes) != size then
        return false
      end
    elif tag == 97 then
      let asm_text = read_file(stem + ".asm")
      if byte_length(asm_text) != jb_num_at(h, starts[1], pasts[1]) then
        return false
      end
    elif tag == 98 then
      let bss = jb_num_at(h, starts[1], pasts[1])
    elif tag == 115 then
      let syms = list_push(syms, [jb_field(h, starts, pasts, 1), jb_field(h, starts, pasts, 2), jb_num_at(h, starts[3], pasts[3]), jb_field(h, starts, pasts, 4) == "1"])
    elif tag == 114 then
      let relocs = list_push(relocs, [jb_field(h, starts, pasts, 1), jb_num_at(h, starts[2], pasts[2]), jb_field(h, starts, pasts, 3), jb_field(h, starts, pasts, 4), jb_num_at(h, starts[5], pasts[5])])
    elif tag == 101 then
      let ext = list_push(ext, jb_field(h, starts, pasts, 1))
    end
  end
  return [["ChunkImage", text_bytes, data_bytes, bss, syms, relocs, ext], asm_text]
end

# A line's field k, from where it starts to where it ends.
make a function called jb_field takes h, starts, pasts, k returns field
  require (k >= 0) and (k < list_len(starts)) and (list_len(starts) == list_len(pasts))
  let field = sc_substr(h, starts[k], pasts[k] - starts[k])
  ensure field.length == pasts[k] - starts[k]
  return field
end

# The integer written in h, a str_intern handle, from a up to past: digits,
# after a "-" if negative, as "" + n writes it.
make a function called jb_num_at takes h, a, past returns n
  require (a >= 0) and (past >= a) and (past <= sc_len(h))
  let i = a
  let negative = false
  if (i < past) and (sc_code(h, i) == 45) then
    let negative = true
    let i = i + 1
  end
  let n = 0
  while i < past do
    let n = n * 10 + (sc_code(h, i) - 48)
    let i = i + 1
  end
  if negative then
    let n = 0 - n
  end
  ensure (n >= 0) or negative
  return n
end

# ---- running the jobs ----

# ---- eviction ----

# Where the name's extension starts, or -1.
make a function called jb_last_dot takes name returns at
  let i = name.length - 1
  while i >= 0 do
    if char_code(name, i) == 46 then
      return i
    end
    let i = i - 1
  end
  return 0 - 1
end

make a function called jb_stem_bucket takes stem returns b
  return str_hash(stem) % 4096
end

# The store's files, least recently written first, those written at the same
# time by name: a list of [name, bytes]. Read with dir_files, never through a
# shell: a directory's name is not a command.
make a function called jb_store_files takes dir returns files
  let rows = jb_sort_written(dir_files(dir))
  let files = []
  let k = 0
  while k < list_len(rows) do
    if jb_last_dot(rows[k][0]) > 0 then
      let files = list_push(files, [rows[k][0], rows[k][1]])
    end
    let k = k + 1
  end
  return files
end

# dir_files' rows, sorted by when each was written (stable: rows written at
# the same time keep their order, which is by name): a merge sort.
make a function called jb_sort_written takes rows returns sorted
  let n = list_len(rows)
  if n < 2 then
    return rows
  end
  let mid = floor(n / 2)
  let left = []
  let right = []
  let i = 0
  while i < n do
    if i < mid then
      let left = list_push(left, rows[i])
    else
      let right = list_push(right, rows[i])
    end
    let i = i + 1
  end
  let left = jb_sort_written(left)
  let right = jb_sort_written(right)
  let out = []
  let a = 0
  let b = 0
  while (a < list_len(left)) or (b < list_len(right)) do
    if b >= list_len(right) then
      let out = list_push(out, left[a])
      let a = a + 1
    elif a >= list_len(left) then
      let out = list_push(out, right[b])
      let b = b + 1
    elif right[b][2] < left[a][2] then
      let out = list_push(out, right[b])
      let b = b + 1
    else
      let out = list_push(out, left[a])
      let a = a + 1
    end
  end
  return out
end

# Removes whole jobs, least recently used first, until the store is no more than
# keep_bytes: [jobs removed, bytes removed, bytes left]. A job's use is its record's
# time, so a job with no record, left by an interrupted build, goes first. The record
# goes first too: without it the job no longer counts as stored.
make a function called jb_evict takes dir, keep_bytes returns result
  let files = jb_store_files(dir)
  let buckets = vec_new()
  let i = 0
  while i < 4096 do
    vec_push(buckets, [])
    let i = i + 1
  end
  let total = 0
  let order = []
  let stems = []
  let i = 0
  while i < list_len(files) do
    let name = files[i][0]
    let dot = jb_last_dot(name)
    let stem = substr(name, 0, dot)
    let ext = substr(name, dot, name.length - dot)
    let total = total + files[i][1]
    let b = jb_stem_bucket(stem)
    let entries = vec_get(buckets, b)
    let found = 0 - 1
    let k = 0
    while k < list_len(entries) do
      if entries[k][0] == stem then
        let found = k
      end
      let k = k + 1
    end
    if found < 0 then
      let stems = list_push(stems, stem)
      vec_set(buckets, b, list_push(entries, [stem, [files[i]], ext == ".chunk"]))
    else
      let e = entries[found]
      let e = [stem, list_push(e[1], files[i]), e[2] or (ext == ".chunk")]
      vec_set(buckets, b, list_set(entries, found, e))
    end
    if ext == ".chunk" then
      let order = list_push(order, stem)
    end
    let i = i + 1
  end
  let by_age = []
  let i = 0
  while i < list_len(stems) do
    let entries = vec_get(buckets, jb_stem_bucket(stems[i]))
    let k = 0
    while k < list_len(entries) do
      if (entries[k][0] == stems[i]) and (not entries[k][2]) then
        let by_age = list_push(by_age, stems[i])
      end
      let k = k + 1
    end
    let i = i + 1
  end
  let i = 0
  while i < list_len(order) do
    let by_age = list_push(by_age, order[i])
    let i = i + 1
  end
  let jobs = 0
  let removed = 0
  let i = 0
  while (total > keep_bytes) and (i < list_len(by_age)) do
    let stem = by_age[i]
    let entries = vec_get(buckets, jb_stem_bucket(stem))
    let k = 0
    while k < list_len(entries) do
      if entries[k][0] == stem then
        let got = jb_remove_job(dir, stem, entries[k][1])
        let total = total - got
        let removed = removed + got
        let jobs = jobs + 1
      end
      let k = k + 1
    end
    let i = i + 1
  end
  return [jobs, removed, total]
end

# The bytes removed: a file another build holds stays.
make a function called jb_remove_job takes dir, stem, files returns bytes
  let got = 0
  let chunk = dir + "/" + stem + ".chunk"
  let i = 0
  while i < list_len(files) do
    let path = dir + "/" + files[i][0]
    if path == chunk then
      remove_file(path)
      if not file_exists(path) then
        let got = got + files[i][1]
      end
    end
    let i = i + 1
  end
  let i = 0
  while i < list_len(files) do
    let path = dir + "/" + files[i][0]
    if path != chunk then
      remove_file(path)
      if not file_exists(path) then
        let got = got + files[i][1]
      end
    end
    let i = i + 1
  end
  return got
end

make a function called jb_artefact_path takes dir, key, ext returns path
  return dir + "/" + key + ext
end

# One job: [index, kind, payload, facts, key, dir]. Gives [index, chunk,
# assembly text, "reused" or "built", [ms reading or generating code, ms
# assembling, ms storing]]. kind "fn": payload is a function's
# IR; kind "asm": payload is assembly text (the entry). Its artefacts are
# the chunk (KEY.chunk) and the assembly text (KEY.asm); dir "" stores
# nothing.
make a function called jb_run_job takes job returns result
  let dir = job[5]
  let chunk_path = jb_artefact_path(dir, job[4], ".chunk")
  let asm_path = jb_artefact_path(dir, job[4], ".asm")
  let t0 = now_ms()
  if (dir != "") and file_exists(chunk_path) and file_exists(asm_path) then
    let record = read_file(chunk_path)
    let stored = jb_chunk_from_text(record, jb_artefact_path(dir, job[4], ""))
    if stored != false then
      # marks the job as just used, for eviction. The same bytes, so another
      # build reading it finds it whole or short, and a short one is built again.
      write_file(chunk_path, record)
      return [job[0], stored[0], stored[1], "reused", [now_ms() - t0, 0, 0]]
    end
  end
  let asm = job[2]
  if job[1] == "fn" then
    let asm = xv_fn_asm(own_function(job[2]), job[3])
  end
  let t1 = now_ms()
  let chunk = x64_assemble_chunk("section .text" + xv_nl() + asm)
  let t2 = now_ms()
  if (dir != "") and (chunk != false) then
    let text = jb_chunk_text(chunk)
    if text != false then
      write_file(asm_path, asm)
      write_file_bytes(jb_artefact_path(dir, job[4], ".text"), chunk[1])
      write_file_bytes(jb_artefact_path(dir, job[4], ".data"), chunk[2])
      # written last, and checked against the others when read
      write_file(chunk_path, text + "a " + byte_length(asm) + chr(10) + "z" + chr(10))
    end
  end
  return [job[0], chunk, asm, "built", [t1 - t0, t2 - t1, now_ms() - t2]]
end

# A worker's share: its jobs, run in the order given.
make a function called jb_worker takes jobs returns results
  let results = []
  let i = 0
  while i < list_len(jobs) do
    let results = list_push(results, jb_run_job(jobs[i]))
    let i = i + 1
  end
  return results
end

# The order the jobs become ready in: as given, or shuffled by a seed (a
# linear congruential sequence), to show the output does not depend on it.
make a function called jb_order takes n, seed returns order
  let order = []
  let i = 0
  while i < n do
    let order = list_push(order, i)
    let i = i + 1
  end
  if seed == 0 then
    return order
  end
  let x = seed
  let i = n - 1
  while i > 0 do
    let x = (x * 1103515245 + 12345) % 2147483648
    let j = x % (i + 1)
    let t = order[i]
    let order = list_set(order, i, order[j])
    let order = list_set(order, j, t)
    let i = i - 1
  end
  return order
end

# Runs every job on `workers` workers, the ready order shuffled by `seed`;
# gives each job's [chunk, assembly text, how, times] in the jobs' own
# order.
make a function called jb_run_all takes jobs, workers, seed returns results
  let order = jb_order(list_len(jobs), seed)
  let shares = []
  let w = 0
  while w < workers do
    let shares = list_push(shares, [])
    let w = w + 1
  end
  let i = 0
  while i < list_len(order) do
    let w = i % workers
    let shares = list_set(shares, w, list_push(shares[w], jobs[order[i]]))
    let i = i + 1
  end
  let done = []
  if workers == 1 then
    let done = [jb_worker(shares[0])]
  else
    let done = parallel_map(shares, "jb_worker")
  end
  let slots = vec_new()
  let i = 0
  while i < list_len(jobs) do
    vec_push(slots, false)
    let i = i + 1
  end
  let w = 0
  while w < list_len(done) do
    let k = 0
    while k < list_len(done[w]) do
      let r = done[w][k]
      vec_set(slots, r[0], [r[1], r[2], r[3], r[4]])
      let k = k + 1
    end
    let w = w + 1
  end
  return vec_to_list(slots)
end
