# v2 lowering: one declaration's AST to IR (ir.patlang). A pure stage: its
# state is the builder passed to every function here, never __vars
# (docs/spec/values-and-memory.md 2.5). Names synthesized here (labels,
# temporaries) are local to the declaration.
#
# The builder is [instrs, names, slots, counters, errors, decl, lifted,
# ctx, raises]: vecs, so the helpers below can add to them. counters holds
# [next slot, next label, next closure]; decl is the declaration's name,
# from which every name synthesized here is made; lifted collects the
# functions lifted out of it (closures); ctx is [quiet, symbols, ...]:
# whether its file declared quiet_operators(), and the symbol index
# (lw_symbols), then the flags lw_program_traced sets out (lw_ctx_flag);
# raises lists the events the function raises when it returns.

make a function called lw_new_builder takes decl, lifted, ctx, raises returns fb
  # slots, labels, lifted closures, and the line of the statement being
  # lowered (0 until one says), which an error names
  let counters = vec_new()
  vec_push(counters, 0)
  vec_push(counters, 0)
  vec_push(counters, 0)
  vec_push(counters, 0)
  return [vec_new(), vec_new(), vec_new(), counters, vec_new(), decl, lifted, ctx, raises]
end

# The symbol index: every declared function's name and parameter names,
# made before any declaration is lowered (the one program-wide input
# lowering needs).
# ---- a program's functions with a name the runtime has ----
#
# Such a function gets the name lw_user_name gives it, and a call from the
# program's code reaches it by that name. The runtime's code keeps the runtime's
# function: a runtime file is a quiet one.

make a function called lw_user_name takes name returns out
  return "user__" + name
end

make a function called lw_name_bucket takes name returns i
  let n = name.length
  if n == 0 then
    return 0
  end
  return (n + 31 * char_code(name, 0) + 7 * char_code(name, n - 1)) % 1024
end

# The names of the program's functions that the runtime also has, or that are
# primitives. The runtime's names are kept in buckets, since a program as large as
# the compiler has thousands of functions.
make a function called lw_shadowing takes files returns shadows
  let buckets = vec_new()
  let i = 0
  while i < 1024 do
    vec_push(buckets, [])
    let i = i + 1
  end
  let f = 0
  while f < list_len(files) do
    if files[f][1] then
      let stmts = files[f][0]
      let i = 0
      while i < list_len(stmts) do
        if stmts[i][0] == "Func" then
          let b = lw_name_bucket(stmts[i][1])
          vec_set(buckets, b, list_push(vec_get(buckets, b), stmts[i][1]))
        end
        let i = i + 1
      end
    end
    let f = f + 1
  end
  let shadows = []
  let f = 0
  while f < list_len(files) do
    if not files[f][1] then
      let stmts = files[f][0]
      let i = 0
      while i < list_len(stmts) do
        if stmts[i][0] == "Func" then
          let name = stmts[i][1]
          if v2_contains(vec_get(buckets, lw_name_bucket(name)), name) or ir_is_prim(name) then
            if not v2_contains(shadows, name) then
              let shadows = list_push(shadows, name)
            end
          end
        end
        let i = i + 1
      end
    end
    let f = f + 1
  end
  return shadows
end

# The files with those functions under their new names.
make a function called lw_rename_shadowing takes files, shadows returns out
  if list_len(shadows) == 0 then
    return files
  end
  let out = []
  let f = 0
  while f < list_len(files) do
    let file = files[f]
    if not file[1] then
      let renamed = []
      let i = 0
      while i < list_len(file[0]) do
        let st = file[0][i]
        if (st[0] == "Func") and v2_contains(shadows, st[1]) then
          let st = list_set(st, 1, lw_user_name(st[1]))
        end
        let renamed = list_push(renamed, st)
        let i = i + 1
      end
      let file = list_set(file, 0, renamed)
    end
    let out = list_push(out, file)
    let f = f + 1
  end
  return out
end

# A function's name as its source has it.
make a function called lw_source_name takes name returns out
  let prefix = lw_user_name("")
  if str_starts_with(name, prefix) then
    return substr(name, prefix.length, name.length - prefix.length)
  end
  return name
end

# The name a call in this code reaches.
make a function called lw_call_target takes fb, name returns target
  if fb[7][0] then
    return name
  end
  if v2_contains(fb[7][1][2], name) then
    return lw_user_name(name)
  end
  return name
end

make a function called lw_symbols takes files returns symbols
  let names = []
  let params = []
  let f = 0
  while f < list_len(files) do
    let stmts = files[f][0]
    let i = 0
    while i < list_len(stmts) do
      if stmts[i][0] == "Func" then
        let names = list_push(names, stmts[i][1])
        let params = list_push(params, lw_param_names(stmts[i][2]))
      end
      let i = i + 1
    end
    let f = f + 1
  end
  return [names, params]
end

# A declared function's parameter names, or false.
make a function called lw_params_of takes fb, name returns params
  let symbols = fb[7][1]
  let i = 0
  while i < list_len(symbols[0]) do
    if symbols[0][i] == name then
      return symbols[1][i]
    end
    let i = i + 1
  end
  return false
end

make a function called lw_emit takes fb, ins returns done
  vec_push(fb[0], ins)
  return true
end

# The line an error names: the statement's being lowered, or 0 for one that
# carries none, never an earlier statement's. Every statement passes here,
# whether it is lowered for its effect (lw_stmt) or for its block's value
# (lw_block_value).
make a function called lw_note_line takes fb, st returns done
  if st[0] == "QuietStmt" then
    return false
  end
  let at = st[list_len(st) - 1]
  if (type_of(at) == "int") and (at > 0) then
    vec_set(fb[3], 3, at)
  else
    vec_set(fb[3], 3, 0)
  end
  return true
end

make a function called lw_error takes fb, text returns done
  let line = vec_get(fb[3], 3)
  if line > 0 then
    vec_push(fb[4], "line " + line + ": " + text)
  else
    vec_push(fb[4], text)
  end
  return true
end

make a function called lw_new_slot takes fb returns s
  let s = vec_get(fb[3], 0)
  vec_set(fb[3], 0, s + 1)
  return s
end

make a function called lw_new_label takes fb returns l
  let l = vec_get(fb[3], 1)
  vec_set(fb[3], 1, l + 1)
  return l
end

# The slot holding a variable, or -1.
make a function called lw_var_slot takes fb, name returns s
  let names = fb[1]
  let i = 0
  let n = vec_len(names)
  while i < n do
    if vec_get(names, i) == name then
      return vec_get(fb[2], i)
    end
    let i = i + 1
  end
  return 0 - 1
end

make a function called lw_rebind takes fb, name, s returns done
  let names = fb[1]
  let i = 0
  while i < vec_len(names) do
    if vec_get(names, i) == name then
      # the old slot stays a variable, under no name
      let old = vec_get(fb[2], i)
      vec_set(fb[2], i, s)
      vec_push(fb[1], "")
      vec_push(fb[2], old)
      return true
    end
    let i = i + 1
  end
  return false
end

make a function called lw_bind takes fb, name returns s
  let s = lw_var_slot(fb, name)
  if s >= 0 then
    return s
  end
  let s = lw_new_slot(fb)
  vec_push(fb[1], name)
  vec_push(fb[2], s)
  return s
end

# ---- expressions: each leaves its value in a slot and returns the slot ----

make a function called lw_const takes fb, kind, text returns s
  let s = lw_new_slot(fb)
  lw_emit(fb, ["const", s, kind, text])
  return s
end

# A number literal arrives as its text: float if it has a point or an
# exponent; otherwise an int when it fits in 64 bits (spec 1.3), else a
# bigint.
make a function called lw_num_kind takes text returns kind
  let i = 0
  while i < text.length do
    let c = char_code(text, i)
    if (c == 46) or (c == 101) or (c == 69) then
      return "float"
    end
    let i = i + 1
  end
  let max = "9223372036854775807"
  if text.length < max.length then
    return "int"
  end
  if text.length > max.length then
    return "bigint"
  end
  if text <= max then
    return "int"
  end
  return "bigint"
end

make a function called lw_num takes fb, text returns s
  let kind = lw_num_kind(text)
  if kind == "bigint" then
    # built at run time from its digits (runtime/integers.patlang)
    let t = lw_const(fb, "str", text)
    let d = lw_new_slot(fb)
    lw_emit(fb, ["call", d, "int_from_text", [t]])
    return d
  end
  return lw_const(fb, kind, text)
end

make a function called lw_expr takes fb, e returns s
  let kind = e[0]
  if kind == "Num" then
    return lw_num(fb, e[1])
  end
  if kind == "Bool" then
    # the parser keeps a boolean literal as its text
    if (e[1] == true) or (e[1] == "true") then
      return lw_const(fb, "bool", "1")
    end
    return lw_const(fb, "bool", "0")
  end
  if kind == "Str" then
    return lw_const(fb, "str", e[1])
  end
  if kind == "Unit" then
    return lw_const(fb, "unit", "")
  end
  if kind == "Var" then
    let s = lw_var_slot(fb, e[1])
    if (s < 0) and (e[1] == "unit") then
      # spec 1.13: the name unit is the unit value unless the program binds it
      return lw_const(fb, "unit", "")
    end
    if s < 0 then
      lw_error(fb, "undefined variable " + e[1])
      return lw_const(fb, "unit", "")
    end
    return s
  end
  if kind == "Bin" then
    let op = e[1]
    if (op == "and") or (op == "or") then
      return lw_logic(fb, op, e[2], e[3])
    end
    let a = lw_expr(fb, e[2])
    let b = lw_expr(fb, e[3])
    let d = lw_new_slot(fb)
    if (op == "+") and fb[7][0] then
      lw_emit(fb, ["op", d, "q+", a, b])
    else
      lw_emit(fb, ["op", d, op, a, b])
    end
    return d
  end
  if kind == "Un" then
    let a = lw_expr(fb, e[2])
    let d = lw_new_slot(fb)
    lw_emit(fb, ["un", d, e[1], a])
    return d
  end
  if kind == "Call" then
    # a fourth item "runtime" marks a call the lowering made (lw_call_as)
    return lw_call_as(fb, e[1], e[2], (list_len(e) < 4) or (e[3] != "runtime"))
  end
  # A function reached by its name: its wrapper hands its parameters straight
  # on, exactly as given (own.patlang)
  if kind == "CallThrough" then
    let slots = []
    let i = 0
    while i < list_len(e[2]) do
      let slots = list_push(slots, lw_var_slot(fb, e[2][i]))
      let i = i + 1
    end
    let d = lw_new_slot(fb)
    lw_emit(fb, ["call", d, e[1], slots, "through"])
    return d
  end
  # v.name: the runtime's dot_name(v), until classes give every value its
  # methods (docs/plans/v2-implementation.md, milestone 5)
  if kind == "Member" then
    return lw_call_as(fb, "rt_member", [e[1], ["Str", e[2]]], false)
  end
  if kind == "CallExpr" then
    # an expression's value called: a closure, as a variable holding one is
    return lw_callv(fb, lw_expr(fb, e[1]), e[2], 0)
  end
  if kind == "MethodCall" then
    # AST.Name(args): the node ["Name", args...] (spec 1.9), unless a variable has the name
    if (e[1][0] == "Var") and (e[1][1] == "AST") and (lw_var_slot(fb, "AST") < 0) then
      return lw_expr(fb, ["List", v2_concat([["Str", e[2]]], e[3])])
    end
    return lw_call(fb, "send", v2_concat([e[1], ["Str", e[2]]], e[3]))
  end
  if kind == "Index" then
    return lw_call(fb, "index_get", [e[1], e[2]])
  end
  if kind == "Closure" then
    let raises = []
    if list_len(e) > 3 then
      let raises = e[3]
    end
    return lw_closure(fb, e[1], e[2], raises)
  end
  if kind == "Budgeted" then
    return lw_budgeted(fb, e)
  end
  if kind == "List" then
    let slots = []
    let i = 0
    while i < list_len(e[1]) do
      let slots = list_push(slots, lw_expr(fb, e[1][i]))
      let i = i + 1
    end
    let d = lw_new_slot(fb)
    lw_emit(fb, ["list", d, slots])
    return d
  end
  lw_error(fb, "unsupported expression " + kind)
  return lw_const(fb, "unit", "")
end

# a and b: b is evaluated only when a is true; a or b, only when a is false.
# `and` and `or` give a bool, the right side evaluated only when needed.
make a function called lw_logic takes fb, op, ea, eb returns d
  let d = lw_new_slot(fb)
  let a = lw_expr(fb, ea)
  let l_rhs = lw_new_label(fb)
  let l_true = lw_new_label(fb)
  let l_false = lw_new_label(fb)
  let l_end = lw_new_label(fb)
  if op == "and" then
    lw_emit(fb, ["branch", a, l_rhs, l_false])
  else
    lw_emit(fb, ["branch", a, l_true, l_rhs])
  end
  lw_emit(fb, ["label", l_rhs])
  let b = lw_expr(fb, eb)
  lw_emit(fb, ["branch", b, l_true, l_false])
  lw_emit(fb, ["label", l_true])
  lw_emit(fb, ["copy", d, lw_const(fb, "bool", "1")])
  lw_emit(fb, ["jump", l_end])
  lw_emit(fb, ["label", l_false])
  lw_emit(fb, ["copy", d, lw_const(fb, "bool", "0")])
  lw_emit(fb, ["jump", l_end])
  lw_emit(fb, ["label", l_end])
  return d
end

# Whether a name a program writes is the runtime's alone (review finding S8):
# a primitive that reads or writes memory, makes a value from a word, or
# reaches the system or the runtime's state, or a function named rt_ that the
# runtime declares and the program does not. Only a file declaring
# quiet_operators() calls one; the word and float arithmetic, value_class,
# value_live and the constant-time marks are open to every program, since none
# reaches anything the program does not already hold.
make a function called lw_runtime_only takes fb, name returns yes
  let held = ["mem_load", "mem_load_byte", "mem_load_value", "mem_take_value", "mem_store", "mem_store_byte", "mem_store_value", "mem_init_value", "value_make", "value_data", "value_type_word", "atomic_add", "runtime_state", "thread_entry_address", "extern_call", "extern_call_float", "closure_call_unchecked", "runtime_functions_by_name"]
  if v2_contains(held, name) then
    return true
  end
  if not str_starts_with(name, "rt_") then
    return false
  end
  let symbols = fb[7][1]
  return (list_len(symbols) > 4) and v2_contains(symbols[4], name) and (not v2_contains(symbols[2], name))
end

make a function called lw_call takes fb, name, args returns d
  return lw_call_as(fb, name, args, true)
end

# A call; `written` is false for one the lowering itself makes (a member's
# rt_member, a field's rt_field_set, the registrations), which may name the
# runtime's own functions whatever file it is in.
make a function called lw_call_as takes fb, name, args, written returns d
  let fslot = lw_var_slot(fb, name)
  if fslot >= 0 then
    return lw_callv(fb, fslot, args, 0)
  end
  if name == "caught" then
    return lw_caught(fb, args)
  end
  if written and (not fb[7][0]) and lw_runtime_only(fb, name) then
    lw_error(fb, name + " is for the runtime: only a file declaring quiet_operators() uses it")
    return lw_const(fb, "unit", "")
  end
  if name == "closure_call_unchecked" then
    # a closure's call with arguments already fitted to it (rt_apply_unchecked)
    if list_len(args) == 0 then
      lw_error(fb, "closure_call_unchecked needs a closure")
      return lw_const(fb, "unit", "")
    end
    let rest = []
    let i = 1
    while i < list_len(args) do
      let rest = list_push(rest, args[i])
      let i = i + 1
    end
    return lw_callv(fb, lw_expr(fb, args[0]), rest, 1)
  end
  let name = lw_call_target(fb, name)
  if name == "extern_call" then
    return lw_extern(fb, args, "extern")
  end
  if name == "extern_call_float" then
    return lw_extern(fb, args, "externf")
  end
  return lw_call_named(fb, name, args)
end

# caught(f(...)): the call's result as it is, the unwinding mark a stop in a
# world returns included (docs/spec/values-and-memory.md 2.2), where any other
# call's would unwind the caller. For the runtime: only a quiet file may use
# it, and only on a call of a function or a closure.
make a function called lw_caught takes fb, args returns d
  if not fb[7][0] then
    lw_error(fb, "caught is for the runtime: only a file declaring quiet_operators() uses it")
    return lw_const(fb, "unit", "")
  end
  if (list_len(args) != 1) or (args[0][0] != "Call") then
    lw_error(fb, "caught takes one call of a function or a closure")
    return lw_const(fb, "unit", "")
  end
  let d = lw_expr(fb, args[0])
  let n = vec_len(fb[0])
  let last = []
  if n > 0 then
    let last = vec_get(fb[0], n - 1)
  end
  if (list_len(last) < 2) or ((last[0] != "call") and (last[0] != "callv")) or (last[1] != d) then
    lw_error(fb, "caught takes one call of a function or a closure")
    return d
  end
  lw_emit(fb, ["caught", d])
  return d
end

# A call of the closure in slot fslot with these arguments, at most 8
# (runtime/closures.patlang's rt_closure_call_N fit them); unchecked is 1
# when they are already fitted to it (closure_call_unchecked).
make a function called lw_callv takes fb, fslot, args, unchecked returns d
  require fslot >= 0
  if list_len(args) > 8 then
    lw_error(fb, "a closure is called with at most 8 arguments, given " + list_len(args))
  end
  let slots = [fslot]
  let i = 0
  while i < list_len(args) do
    let slots = list_push(slots, lw_expr(fb, args[i]))
    let i = i + 1
  end
  let d = lw_new_slot(fb)
  if unchecked == 1 then
    lw_emit(fb, ["callv", d, slots, 1])
  else
    lw_emit(fb, ["callv", d, slots])
  end
  ensure d >= 0
  return d
end

# A call naming a function, a runtime function or a primitive.
make a function called lw_call_named takes fb, name, args returns d
  let args = lw_fit_args(fb, name, args)
  let slots = []
  let i = 0
  while i < list_len(args) do
    let slots = list_push(slots, lw_expr(fb, args[i]))
    let i = i + 1
  end
  let d = lw_new_slot(fb)
  if (name == "quiet_operators") or (name == "runtime_functions_by_name") then
    return lw_const(fb, "unit", "")
  end
  if ir_is_prim(name) then
    let want = ir_prim_arity(name)
    if (want >= 0) and (want != list_len(slots)) then
      lw_error(fb, name + " takes " + want + " arguments, given " + list_len(slots))
    end
    lw_emit(fb, ["prim", d, name, slots])
  else
    lw_emit(fb, ["call", d, name, slots])
  end
  return d
end

# A call's arguments fitted to the declared function: it takes exactly as
# many as the function has parameters, and a call with another number is an
# error naming the function and both numbers (spec 1.13). When the last
# parameter is named rest, it receives the arguments from its position on as
# a list, and fewer than the parameters before it is too few. Calls of
# undeclared names are left as they are.
make a function called lw_fit_args takes fb, name, args returns fitted
  let params = lw_params_of(fb, name)
  if params == false then
    return args
  end
  let n = list_len(params)
  let k = 0
  while (k < n) and (k < list_len(args)) do
    if params[k] == "by_name" then
      if args[k][0] == "Str" then
        if (not fb[7][0]) and lw_runtime_only(fb, args[k][1]) then
          lw_error(fb, args[k][1] + " is for the runtime: only a file declaring quiet_operators() uses it")
        end
        vec_push(fb[7][2], args[k][1])
      else
        vec_push(fb[7][2], "*")
      end
    end
    let k = k + 1
  end
  if (n > 0) and (params[n - 1] == "rest") then
    if list_len(args) < n - 1 then
      lw_error(fb, lw_shown_name(name) + " takes at least " + lw_count_text(n - 1) + ", given " + list_len(args))
      return args
    end
    let fixed = []
    let i = 0
    while i < n - 1 do
      let fixed = list_push(fixed, args[i])
      let i = i + 1
    end
    let rest = []
    while i < list_len(args) do
      let rest = list_push(rest, args[i])
      let i = i + 1
    end
    return list_push(fixed, ["List", rest])
  end
  if list_len(args) != n then
    lw_error(fb, lw_shown_name(name) + " takes " + lw_count_text(n) + ", given " + list_len(args))
  end
  let fitted = args
  return fitted
end

# "1 argument" or "n arguments".
make a function called lw_count_text takes n returns text
  require n >= 0
  let text = n + " arguments"
  if n == 1 then
    let text = "1 argument"
  end
  ensure text.length > 0
  return text
end

# A function's name as its source has it: a program's own function is lowered
# under a prefix (lw_user_name) that the source never wrote.
make a function called lw_shown_name takes name returns shown
  let prefix = lw_user_name("")
  let shown = name
  if str_starts_with(name, prefix) then
    let shown = substr(name, prefix.length, name.length - prefix.length)
  end
  ensure shown.length > 0
  return shown
end

# extern_call("KERNEL32.DLL", "WriteFile", args...): the library and the
# function are names fixed at compile time, so they must be string
# literals; the arguments are words (ints).
make a function called lw_extern takes fb, args, kind returns d
  let d = lw_new_slot(fb)
  if list_len(args) < 2 then
    lw_error(fb, "extern_call needs a library and a function name")
    return d
  end
  if (args[0][0] != "Str") or (args[1][0] != "Str") then
    lw_error(fb, "extern_call's library and function must be string literals")
    return d
  end
  if list_len(args) > 14 then
    lw_error(fb, "extern_call takes at most 12 words")
  end
  let slots = []
  let i = 2
  while i < list_len(args) do
    let slots = list_push(slots, lw_expr(fb, args[i]))
    let i = i + 1
  end
  lw_emit(fb, [kind, d, args[0][1], args[1][1], slots])
  return d
end

# budgeted(ms, existing) { body }: the body as a closure, which a fiber runs
# (runtime/fibers.patlang). A loop lexically in the body checks the budget at
# its back-edge, in closures inside it too, so the closure's builder says so.
make a function called lw_budgeted takes fb, e returns d
  let ms = lw_expr(fb, e[1])
  let inner = list_set(fb, 7, list_set(fb[7], 5, true))
  let f = lw_closure(inner, ["__budget_arg"], e[3], [])
  let existing = lw_expr(fb, e[2])
  let d = lw_new_slot(fb)
  lw_emit(fb, ["call", d, "rt_budgeted", [ms, f, existing]])
  return d
end

# A loop's back-edge, in a budgeted body.
make a function called lw_back_edge takes fb, l_test returns done
  if fb[7][5] then
    lw_call(fb, "budget_check", [])
  end
  lw_emit(fb, ["jump", l_test])
  return true
end

# A closure literal: its body is lifted to a function of its own, named
# from this declaration, taking the closure itself first and then its
# parameters. The closure holds the values of the variables its body reads
# that are bound here, captured now (by snapshot), and how many parameters
# it takes, and whether the last is named rest (runtime/closures.patlang).
make a function called lw_closure takes fb, params, body, raises returns d
  let n = vec_get(fb[3], 2)
  vec_set(fb[3], 2, n + 1)
  let fname = fb[5] + "__closure_" + n
  let pnames = lw_param_names(params)
  let captured = []
  let slots = []
  let free = lw_free_vars(body, pnames)
  let i = 0
  while i < list_len(free) do
    let s = lw_var_slot(fb, free[i])
    if s >= 0 then
      let captured = list_push(captured, free[i])
      let slots = list_push(slots, s)
    end
    let i = i + 1
  end
  let r = lw_function_with(fname, pnames, body, captured, fb[6], true, fb[7], raises)
  vec_push(fb[6], r[0])
  let k = 0
  while k < list_len(r[1]) do
    lw_error(fb, r[1][k])
    let k = k + 1
  end
  let d = lw_new_slot(fb)
  let takes_rest = 0
  if (list_len(pnames) > 0) and (pnames[list_len(pnames) - 1] == "rest") then
    let takes_rest = 1
  end
  lw_emit(fb, ["closure", d, fname, slots, list_len(pnames), takes_rest])
  return d
end

# The variable names an expression or statement list reads, other than the
# given parameters, each once.
make a function called lw_free_vars takes node, params returns names
  let acc = vec_new()
  lw_collect_vars(node, acc)
  let names = []
  let i = 0
  while i < vec_len(acc) do
    let nm = vec_get(acc, i)
    if (not v2_contains(params, nm)) and (not v2_contains(names, nm)) then
      let names = list_push(names, nm)
    end
    let i = i + 1
  end
  return names
end

make a function called lw_collect_vars takes node, acc returns done
  if type_of(node) != "list" then
    return true
  end
  if list_len(node) == 0 then
    return true
  end
  if (node[0] == "Var") and (list_len(node) == 2) then
    vec_push(acc, node[1])
    return true
  end
  # a call by a local name reads that name too
  if (node[0] == "Call") and (list_len(node) == 3) then
    vec_push(acc, node[1])
  end
  let i = 0
  while i < list_len(node) do
    lw_collect_vars(node[i], acc)
    let i = i + 1
  end
  return true
end

# A using block's statements with the plain forms of a role given the block's
# store, an expression (spec 1.13). Rewriting stops at a named function, whose
# use of a store is in its own text, and at an inner block giving the same
# role. A rule declaration naming its store, and a call giving one, keep it.
make a function called lw_using_rewrite takes node, role, store returns out
  if type_of(node) != "list" then
    return node
  end
  if list_len(node) == 0 then
    return node
  end
  if node[0] == "Func" then
    return node
  end
  if node[0] == "Using" then
    let binds = lw_using_rewrite(node[1], role, store)
    let shadowed = false
    let i = 0
    while i < list_len(node[1]) do
      if node[1][i][1] == role then
        let shadowed = true
      end
      let i = i + 1
    end
    if shadowed then
      return ["Using", binds, node[2]]
    end
    return ["Using", binds, lw_using_rewrite(node[2], role, store)]
  end
  if (node[0] == "RuleDecl") and (list_len(node) == 4) then
    return ["RuleDecl", node[1], node[2], node[3], "", store]
  end
  let out = []
  let i = 0
  while i < list_len(node) do
    let out = list_push(out, lw_using_rewrite(node[i], role, store))
    let i = i + 1
  end
  if (out[0] == "Call") and (list_len(out) == 3) then
    let to = lw_using_form(role, out[1], list_len(out[2]))
    if to != "" then
      return ["Call", to, v2_concat([store], out[2])]
    end
  end
  return out
end

# The form taking a store that a role's plain form becomes in a using block,
# or "" when the name and argument count are not one of the role's forms.
make a function called lw_using_form takes role, name, n returns to
  if role != "logic" then
    return ""
  end
  let forms = [["rule_add", 3, "rule_add_to"], ["solve", 2, "solve_in"], ["fact", 3, "fact_in"], ["query", 3, "query_in"], ["rules_clear", 0, "rules_clear_in"], ["plan", 1, "plan_in"], ["plan_incremental", 1, "plan_in"], ["plan_with_state", 1, "plan_with_state_in"]]
  let i = 0
  while i < list_len(forms) do
    if (forms[i][0] == name) and (forms[i][1] == n) then
      return forms[i][2]
    end
    let i = i + 1
  end
  return ""
end

# ---- tracing (lw_program_traced) ----

make a function called lw_tracing takes fb returns yes
  return (list_len(fb[7]) > 6) and fb[7][6]
end

# A flag of the builder's ctx past its first seven, false when it has none:
# 7 whether the file is one of the runtime's own, 8 whether the build asked
# for the runtime's ensures (contracts.patlang).
make a function called lw_ctx_flag takes fb, at returns yes
  if list_len(fb[7]) <= at then
    return false
  end
  return fb[7][at]
end

make a function called lw_trace_call takes fb, name, args returns done
  let d = lw_new_slot(fb)
  lw_emit(fb, ["call", d, name, args])
  return true
end

# A statement the parser gave a line (its last element): the step it starts.
# The variables are those bound so far under a name of the program's own.
make a function called lw_trace_step takes fb, st returns done
  if not lw_tracing(fb) then return false end
  let line = st[list_len(st) - 1]
  if (type_of(line) != "int") or (line <= 0) then return false end
  let names = vec_new()
  let slots = vec_new()
  let i = 0
  while i < vec_len(fb[1]) do
    let name = vec_get(fb[1], i)
    if (name != "") and (substr(name, 0, 2) != "__") then
      vec_push(names, lw_const(fb, "str", name))
      vec_push(slots, vec_get(fb[2], i))
    end
    let i = i + 1
  end
  let ns = lw_new_slot(fb)
  lw_emit(fb, ["list", ns, vec_to_list(names)])
  let vs = lw_new_slot(fb)
  lw_emit(fb, ["list", vs, vec_to_list(slots)])
  return lw_trace_call(fb, "__trace_step", [lw_const(fb, "int", line.to_s), lw_const(fb, "str", lw_trace_name(fb)), ns, vs])
end

# The function's name as its source has it (lw_user_name).
make a function called lw_trace_name takes fb returns name
  let name = fb[5]
  let prefix = lw_user_name("")
  if str_starts_with(name, prefix) then
    return substr(name, prefix.length, name.length - prefix.length)
  end
  return name
end

# A statement as lw_trace_step leaves it out: its line, if it has one, 0.
make a function called lw_untraced takes st returns out
  let last = list_len(st) - 1
  if type_of(st[last]) == "int" then
    return list_set(st, last, 0)
  end
  return st
end

make a function called lw_trace_enter takes fb returns done
  if (not lw_tracing(fb)) or (fb[5] == "__main") then return false end
  return lw_trace_call(fb, "__trace_enter", [lw_const(fb, "str", lw_trace_name(fb))])
end

make a function called lw_trace_leave takes fb returns done
  if (not lw_tracing(fb)) or (fb[5] == "__main") then return false end
  return lw_trace_call(fb, "__trace_leave", [])
end

# ---- statements ----

make a function called lw_stmts takes fb, stmts returns done
  let i = 0
  while i < list_len(stmts) do
    lw_stmt(fb, stmts[i])
    let i = i + 1
  end
  return true
end

# A block whose value is wanted: its value is its last statement's, unit when it
# has none. Gives the slot holding it.
make a function called lw_block_value takes fb, stmts returns slot
  let n = list_len(stmts)
  if n == 0 then
    return lw_const(fb, "unit", "")
  end
  let i = 0
  while i < n - 1 do
    lw_stmt(fb, stmts[i])
    let i = i + 1
  end
  return lw_stmt_value(fb, stmts[n - 1])
end

# A statement's value: what a `let` bound, an expression's value, the taken
# branch's block for an `if`, the last iteration's block for a `while` (unit if
# none ran); unit for any other.
make a function called lw_stmt_value takes fb, st returns slot
  let kind = st[0]
  lw_note_line(fb, st)
  if kind == "Let" then
    lw_stmt(fb, st)
    return lw_var_slot(fb, st[1])
  end
  if kind == "Expr" then
    lw_trace_step(fb, st)
    return lw_expr(fb, st[1])
  end
  if kind == "If" then
    let d = lw_new_slot(fb)
    let c = lw_expr(fb, st[1])
    let l_then = lw_new_label(fb)
    let l_else = lw_new_label(fb)
    let l_end = lw_new_label(fb)
    lw_emit(fb, ["branch", c, l_then, l_else])
    lw_emit(fb, ["label", l_then])
    lw_emit(fb, ["copy", d, lw_block_value(fb, st[2])])
    lw_emit(fb, ["jump", l_end])
    lw_emit(fb, ["label", l_else])
    lw_emit(fb, ["copy", d, lw_block_value(fb, st[3])])
    lw_emit(fb, ["jump", l_end])
    lw_emit(fb, ["label", l_end])
    return d
  end
  if kind == "Match" then
    return lw_match(fb, st, true)
  end
  if kind == "While" then
    let d = lw_new_slot(fb)
    lw_emit(fb, ["copy", d, lw_const(fb, "unit", "")])
    let l_test = lw_new_label(fb)
    let l_body = lw_new_label(fb)
    let l_end = lw_new_label(fb)
    lw_emit(fb, ["jump", l_test])
    lw_emit(fb, ["label", l_test])
    let c = lw_expr(fb, st[1])
    lw_emit(fb, ["branch", c, l_body, l_end])
    lw_emit(fb, ["label", l_body])
    lw_emit(fb, ["copy", d, lw_block_value(fb, st[2])])
    lw_back_edge(fb, l_test)
    lw_emit(fb, ["label", l_end])
    return d
  end
  lw_stmt(fb, st)
  return lw_const(fb, "unit", "")
end

# An expression that can do nothing but give its value: as a statement, whose
# value nothing takes, it prints it.
make a function called lw_only_a_value takes e returns yes
  let kind = e[0]
  if (kind == "Num") or (kind == "Str") or (kind == "Bool") or (kind == "Var") then
    return true
  end
  if kind == "Un" then
    return lw_only_a_value(e[2])
  end
  if kind == "Bin" then
    return lw_only_a_value(e[2]) and lw_only_a_value(e[3])
  end
  if kind == "List" then
    let i = 0
    while i < list_len(e[1]) do
      if not lw_only_a_value(e[1][i]) then
        return false
      end
      let i = i + 1
    end
    return true
  end
  return false
end

make a function called lw_stmt takes fb, st returns done
  let kind = st[0]
  lw_note_line(fb, st)
  if kind == "QuietStmt" then
    # a top-level statement of a quiet file, lowered in __main as its file
    # is: quiet (lw_program_traced)
    return lw_stmt(list_set(fb, 7, list_set(fb[7], 0, true)), st[1])
  end
  lw_trace_step(fb, st)
  if kind == "Let" then
    if lw_gives_var(fb, st[1], st[2]) and (lw_var_slot(fb, st[1]) >= 0) then
      return lw_let_giving(fb, st[1], st[2])
    end
    if lw_adds_to_var(fb, st[1], st[2]) then
      return lw_let_adding(fb, st[1], st[2])
    end
    let v = lw_expr(fb, st[2])
    let s = lw_bind(fb, st[1])
    if s != v then
      lw_emit(fb, ["copy", s, v])
    end
    return true
  end
  if kind == "Expr" then
    if lw_only_a_value(st[1]) then
      lw_expr(fb, ["Call", "print", [st[1]]])
    else
      lw_expr(fb, st[1])
    end
    return true
  end
  if kind == "Return" then
    let r = lw_expr(fb, st[1])
    lw_raise_events(fb, r)
    lw_trace_leave(fb)
    lw_emit(fb, ["return", r])
    return true
  end
  if kind == "Using" then
    let body = st[2]
    let i = 0
    while i < list_len(st[1]) do
      let n = vec_get(fb[3], 2)
      vec_set(fb[3], 2, n + 1)
      let hidden = "__using_" + n
      lw_stmt(fb, ["Let", hidden, st[1][i][0]])
      let body = lw_using_rewrite(body, st[1][i][1], ["Var", hidden])
      let i = i + 1
    end
    lw_stmts(fb, body)
    return true
  end
  if kind == "RuleDecl" then
    vec_push(fb[7][4], st[1] + "/" + list_len(st[2]))
    if list_len(st) > 5 then
      lw_expr(fb, ["Call", "rule_add_to", [st[5], ["Str", st[1]], lw_rule_tokens(st[2]), lw_rule_goals(st[3])]])
      return true
    end
    if list_len(st) > 4 then
      let store = ["Call", "logic_store_named", [["Str", st[4]]]]
      lw_expr(fb, ["Call", "rule_add_to", [store, ["Str", st[1]], lw_rule_tokens(st[2]), lw_rule_goals(st[3])]])
      return true
    end
    lw_expr(fb, ["Call", "rule_add", [["Str", st[1]], lw_rule_tokens(st[2]), lw_rule_goals(st[3])]])
    return true
  end
  if kind == "GoalDecl" then
    lw_expr(fb, ["Call", "goal_def", [["Str", st[1]], lw_rule_goals(st[2])]])
    return true
  end
  if kind == "When" then
    vec_push(fb[7][3], st[1])
    let h = lw_closure(fb, ["event_name", "event_data"], st[2], [])
    let n = lw_const(fb, "str", st[1])
    let d = lw_new_slot(fb)
    lw_emit(fb, ["call", d, "rt_on", [n, h]])
    return true
  end
  if kind == "MemberAssign" then
    lw_expr(fb, ["Call", "rt_field_set", [st[1], ["Str", st[2]], st[3]], "runtime"])
    return true
  end
  if kind == "If" then
    let c = lw_expr(fb, st[1])
    let l_then = lw_new_label(fb)
    let l_else = lw_new_label(fb)
    let l_end = lw_new_label(fb)
    lw_emit(fb, ["branch", c, l_then, l_else])
    lw_emit(fb, ["label", l_then])
    lw_stmts(fb, st[2])
    lw_emit(fb, ["jump", l_end])
    lw_emit(fb, ["label", l_else])
    lw_stmts(fb, st[3])
    lw_emit(fb, ["jump", l_end])
    lw_emit(fb, ["label", l_end])
    return true
  end
  if kind == "While" then
    let l_test = lw_new_label(fb)
    let l_body = lw_new_label(fb)
    let l_end = lw_new_label(fb)
    lw_emit(fb, ["jump", l_test])
    lw_emit(fb, ["label", l_test])
    let c = lw_expr(fb, st[1])
    lw_emit(fb, ["branch", c, l_body, l_end])
    lw_emit(fb, ["label", l_body])
    lw_stmts(fb, st[2])
    lw_back_edge(fb, l_test)
    lw_emit(fb, ["label", l_end])
    return true
  end
  if kind == "Match" then
    lw_match(fb, st, false)
    return true
  end
  if kind == "Assert" then
    return lw_contract(fb, st[1], st[2], st[3])
  end
  if kind == "Err" then
    lw_error(fb, "line " + st[2] + ": " + st[1])
    return false
  end
  lw_error(fb, "unsupported statement " + kind)
  return false
end

# ---- match ----

# A pattern as ordinary expressions over subject: [test, the lets to run once
# the test has passed].
make a function called lw_pattern takes pat, subject returns r
  let tag = pat[0]
  if tag == "PWild" then
    return [["Bool", "true"], []]
  elif tag == "PBind" then
    return [["Bool", "true"], [["Let", pat[1], subject, false, false]]]
  elif tag == "PLit" then
    return [["Bin", "==", subject, pat[1]], []]
  elif tag == "PCmp" then
    return [["Bin", pat[1], subject, pat[2]], []]
  elif tag == "PGlob" then
    return [["Call", "glob_match", [subject, ["Str", pat[1]]]], []]
  end
  let subs = pat[1]
  let test = ["Bin", "and", ["Bin", "==", ["Call", "type_of", [subject]], ["Str", "list"]], ["Bin", "==", ["Member", subject, "length"], ["Num", "" + list_len(subs)]]]
  let lets = []
  let i = 0
  while i < list_len(subs) do
    let sub = lw_pattern(subs[i], ["Index", subject, ["Num", "" + i]])
    let test = ["Bin", "and", test, sub[0]]
    let j = 0
    while j < list_len(sub[1]) do
      let lets = list_push(lets, sub[1][j])
      let j = j + 1
    end
    let i = i + 1
  end
  return [test, lets]
end

# A match: the scrutinee once, then each arm's test, its bindings, its guard
# (which may read those bindings) and its block. A value no case takes stops
# the program, whether or not contracts are checked. Gives the slot holding the
# taken block's value when wanted.
make a function called lw_match takes fb, st, wanted returns d
  let d = 0 - 1
  if wanted then
    let d = lw_new_slot(fb)
  end
  let v = lw_expr(fb, st[1])
  let tmp = "__match_" + lw_new_label(fb)
  lw_emit(fb, ["copy", lw_bind(fb, tmp), v])
  let subject = ["Var", tmp]
  let l_end = lw_new_label(fb)
  let i = 0
  while i < list_len(st[2]) do
    let arm = st[2][i]
    let comp = lw_pattern(arm[0], subject)
    let c = lw_expr(fb, comp[0])
    let l_bind = lw_new_label(fb)
    let l_next = lw_new_label(fb)
    lw_emit(fb, ["branch", c, l_bind, l_next])
    lw_emit(fb, ["label", l_bind])
    lw_stmts(fb, comp[1])
    if arm[1] != false then
      let g = lw_expr(fb, arm[1])
      let l_body = lw_new_label(fb)
      lw_emit(fb, ["branch", g, l_body, l_next])
      lw_emit(fb, ["label", l_body])
    end
    if wanted then
      lw_emit(fb, ["copy", d, lw_block_value(fb, arm[2])])
    else
      lw_stmts(fb, arm[2])
    end
    lw_emit(fb, ["jump", l_end])
    lw_emit(fb, ["label", l_next])
    let i = i + 1
  end
  let w = lw_const(fb, "str", "assertion")
  let t = lw_const(fb, "str", "match: no case matched the scrutinee value")
  let n = lw_const(fb, "str", fb[5])
  let failed = lw_new_slot(fb)
  lw_emit(fb, ["call", failed, "rt_contract_failed", [w, t, n]])
  if wanted then
    lw_emit(fb, ["copy", d, lw_const(fb, "unit", "")])
  end
  lw_emit(fb, ["jump", l_end])
  lw_emit(fb, ["label", l_end])
  return d
end

# require/ensure/assert COND: when contracts are checked
# (contracts.patlang), a false COND stops the program at this point, naming
# the kind of clause, the function and the condition. Each is checked where
# it is written, as the interpreter checks it.
make a function called lw_contract takes fb, which, cond, line returns done
  if not v2_contracts_checked(which, lw_ctx_flag(fb, 7), lw_ctx_flag(fb, 8)) then
    return true
  end
  let c = lw_expr(fb, cond)
  let l_fail = lw_new_label(fb)
  let l_ok = lw_new_label(fb)
  lw_emit(fb, ["branch", c, l_ok, l_fail])
  lw_emit(fb, ["label", l_fail])
  # the interpreter's wording (spec_library/language/require_ensure_assert)
  let kind = "assertion"
  if which == "require" then
    let kind = "precondition"
  elif which == "ensure" then
    let kind = "postcondition"
  end
  let w = lw_const(fb, "str", kind)
  let t = lw_const(fb, "str", lw_text(cond))
  let n = lw_const(fb, "str", lw_source_name(fb[5]))
  let d = lw_new_slot(fb)
  lw_emit(fb, ["call", d, "rt_contract_failed", [w, t, n]])
  lw_emit(fb, ["jump", l_ok])
  lw_emit(fb, ["label", l_ok])
  # a clause that held is a fact (runtime/logic.patlang); a quiet file's raise
  # nothing, and nor do an engine's
  if (not fb[7][0]) and (not fb[7][1][3]) then
    let held_name = lw_const(fb, "str", lw_source_name(fb[5]))
    let held_kind = lw_const(fb, "str", which)
    let held_text = lw_const(fb, "str", lw_text(cond))
    let held = lw_new_slot(fb)
    lw_emit(fb, ["call", held, "rt_contract_held", [held_name, held_kind, held_text]])
  end
  return true
end

# An expression's source text, for a contract's message.
make a function called lw_text takes e returns text
  let kind = e[0]
  if (kind == "Num") or (kind == "Var") then
    return e[1] + ""
  end
  if kind == "Bool" then
    return e[1] + ""
  end
  if kind == "Str" then
    return chr(34) + e[1] + chr(34)
  end
  if kind == "Bin" then
    return lw_text(e[2]) + " " + e[1] + " " + lw_text(e[3])
  end
  if kind == "Un" then
    if e[1] == "-" then
      return "-" + lw_text(e[2])
    end
    return e[1] + " " + lw_text(e[2])
  end
  if kind == "Member" then
    return lw_text(e[1]) + "." + e[2]
  end
  if (kind == "Call") or (kind == "CallExpr") then
    let b = sb_new()
    if kind == "Call" then
      sb_push(b, e[1] + "(")
    else
      sb_push(b, lw_text(e[1]) + "(")
    end
    let i = 0
    while i < list_len(e[2]) do
      if i > 0 then
        sb_push(b, ", ")
      end
      sb_push(b, lw_text(e[2][i]))
      let i = i + 1
    end
    sb_push(b, ")")
    return sb_str(b)
  end
  if kind == "Index" then
    return lw_text(e[1]) + "[" + lw_text(e[2]) + "]"
  end
  return kind
end

# Whether `let name = rhs` can give name's old value to the call that makes
# its new one: rhs is a call with name as exactly one whole argument. Other
# arguments may read name too: an argument cannot assign the caller's
# variables, so the value is given only once every argument has been
# evaluated, and nothing reads it after that. The call must be one of a named
# function: a closure held in a variable, and the names lw_call lowers in a way
# of their own, go through lw_call like any other call.
make a function called lw_gives_var takes fb, name, rhs returns yes
  if rhs[0] != "Call" then
    return false
  end
  let callee = rhs[1]
  if lw_var_slot(fb, callee) >= 0 then
    return false
  end
  if ir_is_prim(callee) or (callee == "extern_call") or (callee == "extern_call_float") or (callee == "caught") or (callee == "closure_call_unchecked") or (callee == "quiet_operators") or (callee == "runtime_functions_by_name") then
    return false
  end
  let args = rhs[2]
  let whole = 0
  let i = 0
  while i < list_len(args) do
    let a = args[i]
    if (a[0] == "Var") and (a[1] == name) then
      let whole = whole + 1
    end
    let i = i + 1
  end
  return whole == 1
end

# Whether `let name = rhs` adds to name's own value: rhs is name + e, and e does
# not mention it. Nothing reads the old value after the addition.
make a function called lw_adds_to_var takes fb, name, rhs returns yes
  if fb[7][0] or (rhs[0] != "Bin") or (rhs[1] != "+") then
    return false
  end
  let left = rhs[2]
  if (left[0] != "Var") or (left[1] != name) or (list_len(left) != 2) then
    return false
  end
  if lw_mentions(rhs[3], name) then
    return false
  end
  return lw_var_slot(fb, name) >= 0
end

# The value is moved out of the variable, so that op_add_taken, seeing nothing
# else holds a string, can add to it in place.
make a function called lw_let_adding takes fb, name, rhs returns done
  let s = lw_var_slot(fb, name)
  let b = lw_expr(fb, rhs[3])
  let t = lw_new_slot(fb)
  lw_emit(fb, ["take", t, s])
  let d = lw_new_slot(fb)
  lw_emit(fb, ["op", d, "a+", t, b])
  lw_emit(fb, ["copy", s, d])
  return true
end

make a function called lw_mentions takes e, name returns yes
  if type_of(e) != "list" then
    return false
  end
  if list_len(e) == 0 then
    return false
  end
  if (e[0] == "Var") and (list_len(e) == 2) then
    return e[1] == name
  end
  let i = 0
  while i < list_len(e) do
    if lw_mentions(e[i], name) then
      return true
    end
    let i = i + 1
  end
  return false
end

# The call is resolved as lw_call resolves one: the program's function before
# the runtime's of the same name, and the arguments fitted to the declared
# parameters, so the wrong number is refused and rest takes the further ones.
# When fitting puts the variable inside rest's list it is no longer a whole
# argument, and the call is made without giving it.
make a function called lw_let_giving takes fb, name, rhs returns done
  let s = lw_var_slot(fb, name)
  let target = lw_call_target(fb, rhs[1])
  let args = lw_fit_args(fb, target, rhs[2])
  let whole = 0
  let w = 0
  while w < list_len(args) do
    if (args[w][0] == "Var") and (args[w][1] == name) then
      let whole = whole + 1
    end
    let w = w + 1
  end
  if whole != 1 then
    let plain = []
    let p = 0
    while p < list_len(args) do
      let plain = list_push(plain, lw_expr(fb, args[p]))
      let p = p + 1
    end
    let pd = lw_new_slot(fb)
    lw_emit(fb, ["call", pd, target, plain])
    lw_emit(fb, ["copy", s, pd])
    return true
  end
  let slots = []
  let t = -1
  let i = 0
  while i < list_len(args) do
    let a = args[i]
    if (a[0] == "Var") and (a[1] == name) then
      let t = lw_new_slot(fb)
      let slots = list_push(slots, t)
    else
      let slots = list_push(slots, lw_expr(fb, a))
    end
    let i = i + 1
  end
  lw_emit(fb, ["take", t, s])
  let d = lw_new_slot(fb)
  lw_emit(fb, ["call", d, target, slots])
  lw_emit(fb, ["copy", s, d])
  return true
end

# Whether a pattern binds name, at any depth.
make a function called lw_pattern_binds takes pat, name returns yes
  if pat[0] == "PBind" then
    return pat[1] == name
  end
  if pat[0] != "PList" then
    return false
  end
  let i = 0
  while i < list_len(pat[1]) do
    if lw_pattern_binds(pat[1][i], name) then
      return true
    end
    let i = i + 1
  end
  return false
end

# Whether a statement list assigns name anywhere (with let), at any depth.
make a function called lw_assigns takes stmts, name returns yes
  let i = 0
  while i < list_len(stmts) do
    let st = stmts[i]
    if (st[0] == "Let") and (st[1] == name) then
      return true
    end
    if st[0] == "If" then
      if lw_assigns(st[2], name) or lw_assigns(st[3], name) then
        return true
      end
    end
    if st[0] == "While" then
      if lw_assigns(st[2], name) then
        return true
      end
    end
    if st[0] == "Using" then
      if lw_assigns(st[2], name) then
        return true
      end
    end
    if st[0] == "Match" then
      let a = 0
      while a < list_len(st[2]) do
        if lw_pattern_binds(st[2][a][0], name) or lw_assigns(st[2][a][2], name) then
          return true
        end
        let a = a + 1
      end
    end
    let i = i + 1
  end
  return false
end

# Before a return: each event the function raises, with event_data its
# arguments (the receiver first, for a method) and its result r.
make a function called lw_raise_events takes fb, r returns done
  let raises = fb[8]
  if list_len(raises) == 0 then
    return true
  end
  # the payload reads r and so does the return: a variable, under no name
  if not v2_contains(vec_to_list(fb[2]), r) then
    vec_push(fb[1], "")
    vec_push(fb[2], r)
  end
  let first = 0
  if (vec_len(fb[1]) > 0) and (vec_get(fb[1], 0) == "__closure_self") then
    let first = 1
  end
  let slots = []
  let p = first
  while p < vec_get(fb[9], 0) do
    let slots = list_push(slots, p)
    let p = p + 1
  end
  let slots = list_push(slots, r)
  let k = 0
  while k < list_len(raises) do
    let payload = lw_new_slot(fb)
    lw_emit(fb, ["list", payload, slots])
    let n = lw_const(fb, "str", raises[k])
    let d = lw_new_slot(fb)
    lw_emit(fb, ["call", d, "emit", [n, payload]])
    let k = k + 1
  end
  return true
end

# ---- declarations ----

# The parameter names, without the `mut` markers the parser leaves in.
make a function called lw_param_names takes params returns names
  let names = []
  let i = 0
  while i < list_len(params) do
    if params[i] != "mut" then
      let names = list_push(names, params[i])
    end
    let i = i + 1
  end
  return names
end

# One function's IR, and its errors: [func, errors]. Functions lifted out
# of it go to lifted.
make a function called lw_function takes name, params, body, lifted, ctx returns result
  return lw_function_with(name, lw_param_names(params), body, [], lifted, false, ctx, [])
end

# is_closure: a lifted closure, whose first parameter is the closure
# itself (xv_callv passes it); captured: the names it captured, each read
# out of the closure on entry.
make a function called lw_function_with takes name, params, body, captured, lifted, is_closure, ctx, raises returns result
  require (type_of(name) == "string") and (type_of(body) == "list")
  let fb = lw_new_builder(name, lifted, ctx, raises)
  let pnames = params
  if is_closure then
    let pnames = v2_concat(["__closure_self"], params)
  end
  let np = vec_new()
  vec_push(np, list_len(pnames))
  let fb = list_push(fb, np)
  let i = 0
  while i < list_len(pnames) do
    lw_bind(fb, pnames[i])
    let i = i + 1
  end
  # Parameters are borrowed (own.patlang). One the body reassigns gets a
  # local of its own, holding a reference to the argument, and the name
  # means that local from here on.
  let i = 0
  while i < list_len(pnames) do
    if lw_assigns(body, pnames[i]) then
      let local = lw_new_slot(fb)
      lw_emit(fb, ["copy", local, i])
      lw_rebind(fb, pnames[i], local)
    end
    let i = i + 1
  end
  lw_trace_enter(fb)
  if list_len(captured) > 0 then
    # read once per capture, so a variable, under no name
    let block = lw_new_slot(fb)
    vec_push(fb[1], "")
    vec_push(fb[2], block)
    lw_emit(fb, ["prim", block, "value_data", [0]])
    let k = 0
    while k < list_len(captured) do
      let off = lw_const(fb, "int", (48 + 16 * k).to_s)
      let v = lw_new_slot(fb)
      lw_emit(fb, ["prim", v, "mem_load_value", [block, off]])
      let s = lw_bind(fb, captured[k])
      lw_emit(fb, ["copy", s, v])
      let k = k + 1
    end
  end
  # falling off the end returns the body's value; the program's own (__main)
  # is taken by nothing, so its last statement is one like any other, and a
  # bare value there prints as anywhere else (lw_only_a_value)
  if name == "__main" then
    lw_stmts(fb, body)
    let u = lw_const(fb, "unit", "")
  else
    let u = lw_block_value(fb, body)
  end
  lw_raise_events(fb, u)
  lw_trace_leave(fb)
  lw_emit(fb, ["return", u])
  let func = ir_fn(name, list_len(pnames), vec_get(fb[3], 0), vec_to_list(fb[0]), vec_to_list(fb[2]))
  ensure ir_well_formed(func, false) and ir_temps_read_once(func)
  return [func, vec_to_list(fb[4])]
end

# A program's declarations as IR: every function, and __main for the
# top-level statements, its classes registered first. files is a list of
# [stmts, quiet, all_by_name, in_runtime, runtime_ensures]: in_runtime
# whether it is one of the runtime's own files, runtime_ensures whether the
# build asked for their ensures (contracts.patlang); an entry without the
# last two is a program's file. [fns, errors, facts]: facts are the program
# facts code
# generation needs, [the event names some `when` handles].
make a function called lw_program takes files returns result
  return lw_program_traced(files, false)
end

# lw_program, the program's own files traced when trace is true: each
# statement with a line first calls __trace_step with that line, the
# function's name and its named variables' names and values, and each
# function but __main calls __trace_enter on entry and __trace_leave before
# it returns. Nothing declares those names; only the interpreter, asked for a
# trace, gives them (interpreter.patlang, iv_trace_new).
make a function called lw_program_traced takes files, trace returns result
  let shadows = lw_shadowing(files)
  let files = lw_rename_shadowing(files, shadows)
  let symbols = list_push(lw_symbols(files), shadows)
  # an engine's own contracts are not facts of the program it runs: the file
  # that asks for the runtime by name is the interpreter
  let engine = false
  let f = 0
  while f < list_len(files) do
    if files[f][2] then
      let engine = true
    end
    let f = f + 1
  end
  let symbols = list_push(symbols, engine)
  # the names the runtime (its quiet files) declares: an rt_ one is for the
  # runtime alone (lw_runtime_only)
  let declared = []
  let f = 0
  while f < list_len(files) do
    if files[f][1] then
      let stmts = files[f][0]
      let k = 0
      while k < list_len(stmts) do
        if stmts[k][0] == "Func" then
          let declared = list_push(declared, stmts[k][1])
        end
        let k = k + 1
      end
    end
    let f = f + 1
  end
  let symbols = list_push(symbols, declared)
  let by_name = vec_new()
  let handled = vec_new()
  let rules = vec_new()
  let runtime_names = vec_new()
  let fns = []
  let errors = []
  let top = []
  let classes = []
  let lifted = vec_new()
  let f = 0
  while f < list_len(files) do
    let stmts = files[f][0]
    let in_runtime = false
    let runtime_ensures = false
    if list_len(files[f]) > 4 then
      let in_runtime = files[f][3]
      let runtime_ensures = files[f][4]
    end
    let ctx = [files[f][1], symbols, by_name, handled, rules, false, trace and (not files[f][1]), in_runtime, runtime_ensures]
    let i = 0
    while i < list_len(stmts) do
      let st = stmts[i]
      if st[0] == "Func" then
        let raises = []
        if list_len(st) > 5 then
          let raises = st[5]
        end
        # `returns NAME`: the function's result, when the body assigns it
        let body = st[3]
        if (list_len(st) > 4) and (st[4] != "") and lw_assigns(body, st[4]) then
          let body = list_push(body, ["Return", ["Var", st[4]]])
        end
        let r = lw_function_with(st[1], lw_param_names(st[2]), body, [], lifted, false, ctx, raises)
        let fns = list_push(fns, r[0])
        if files[f][1] then
          vec_push(runtime_names, st[1])
        end
        let errors = v2_concat(errors, r[1])
      elif st[0] == "ClassDecl" then
        let classes = list_push(classes, lw_class_registration(st))
        # objects compare by identity (spec 1.5): == and != are never sent to
        # a class, so a method by either name could never be called
        let m = 0
        while m < list_len(st[4]) do
          if (st[4][m][0] == "==") or (st[4][m][0] == "!=") then
            let errors = list_push(errors, "class " + st[1] + ": a method named " + st[4][m][0] + " is never called: objects compare by identity (spec 1.5)")
          end
          let m = m + 1
        end
      elif trace and files[f][1] then
        # a runtime file's statement is no step of the program's
        let top = list_push(top, ["QuietStmt", lw_untraced(st)])
      elif files[f][1] then
        let top = list_push(top, ["QuietStmt", st])
      else
        let top = list_push(top, st)
      end
      let i = i + 1
    end
    let f = f + 1
  end
  # __main registers the functions reached by name first: __register is
  # lowered last, when every by_name call has been seen
  let start = ["Expr", ["Call", "__register", []], 0]
  let r = lw_function_with("__main", [], v2_concat([start], v2_concat(classes, top)), [], lifted, false, [false, symbols, by_name, handled, rules, false, trace], [])
  let fns = list_push(fns, r[0])
  let errors = v2_concat(errors, r[1])
  let registrations = lw_by_name_registrations(files, symbols, vec_to_list(by_name))
  let r = lw_function_with("__register", [], registrations, [], lifted, false, [false, symbols, by_name, handled, rules, false], [])
  let fns = list_push(fns, r[0])
  let errors = v2_concat(errors, r[1])
  # the program facts (B2), each recorded where it was declared: the events
  # handled, the names passed for by_name parameters, the rules
  let facts = [vec_to_list(handled), vec_to_list(by_name), vec_to_list(rules)]
  let fns = v2_concat(fns, vec_to_list(lifted))
  return [fns, errors, facts, vec_to_list(runtime_names)]
end

# What a call to a name nothing declares reaches: it stops the program there,
# the lines before it having run (spec_library/language: "stop at it with host
# fn 'no_such_host' not found"). It takes no parameters: a call of it passes
# none (compile.patlang's v2_without_undeclared_args).
make a function called lw_undeclared_function takes name returns func
  let body = [["Return", ["Call", "rt_undeclared", [["Str", name]], "runtime"]]]
  let r = lw_function_with(name, [], body, [], vec_new(), false, [true, [], vec_new(), vec_new(), vec_new(), false], [])
  return r[0]
end

# A goal's arguments as the logic engine takes them (runtime/logic.patlang):
# each its token's text, a constant, but for a bare capitalised name, which is
# the logic variable of that name (logic_var).
# A rule's terms: a capitalised bare name is a logic variable, any other bare
# name is the string of its name (alice), a string is itself, and anything
# else, a number among them, is the value it is: 12 is the int 12, which a
# comparison goal (gt) can compare. (Every term that was not a variable was
# made a string, so 12 was "12".)
make a function called lw_rule_tokens takes args returns node
  let tokens = []
  let i = 0
  while i < list_len(args) do
    let a = args[i]
    if lw_names_logic_var(a) then
      let tokens = list_push(tokens, ["Call", "logic_var", [["Str", a[1]]]])
    elif (a[0] == "Var") or (a[0] == "Str") then
      let tokens = list_push(tokens, ["Str", a[1]])
    else
      let tokens = list_push(tokens, a)
    end
    let i = i + 1
  end
  return ["List", tokens]
end

# Whether a rule's term is a logic variable: a bare name that starts with a
# capital letter. A quoted string is a constant whatever it starts with.
make a function called lw_names_logic_var takes term returns yes
  if (term[0] != "Var") or (list_len(term) != 2) then
    return false
  end
  if type_of(term[1]) != "string" then
    return false
  end
  if term[1].length == 0 then
    return false
  end
  let c = char_code(term[1], 0)
  return (c >= 65) and (c <= 90)
end

# A list of goals, [pred, args] each, or [pred, args, store name] for a goal
# written with `from`, as a list literal.
make a function called lw_rule_goals takes goals returns node
  let out = []
  let i = 0
  while i < list_len(goals) do
    let g = [["Str", goals[i][0]], lw_rule_tokens(goals[i][1])]
    # not(pred(args)): the goal the runtime reads, ["not", [pred, arg, ...]]
    if (goals[i][0] == "not") and (list_len(goals[i][1]) == 1) and (goals[i][1][0][0] == "Call") then
      let inner = goals[i][1][0]
      let flat = list_push([], ["Str", inner[1]])
      let inner_terms = lw_rule_tokens(inner[2])[1]
      let j = 0
      while j < list_len(inner_terms) do
        let flat = list_push(flat, inner_terms[j])
        let j = j + 1
      end
      let g = [["Str", "not"], ["List", flat]]
    end
    if list_len(goals[i]) > 2 then
      let g = list_push(g, ["Str", goals[i][2]])
    end
    let out = list_push(out, ["List", g])
    let i = i + 1
  end
  return ["List", out]
end

# A class declaration as the statement that registers it: class_define
# (runtime/objects.patlang) with its field defaults, its methods as
# closures (each taking the object first), its traits, and the events its
# methods raise.
make a function called lw_class_registration takes decl returns st
  let defaults = []
  let i = 0
  while i < list_len(decl[3]) do
    let defaults = list_push(defaults, ["List", [["Str", decl[3][i][0]], decl[3][i][1]]])
    let i = i + 1
  end
  let methods = []
  let raises = []
  let i = 0
  while i < list_len(decl[4]) do
    let m = decl[4][i]
    let mr = []
    if list_len(m) > 3 then
      let mr = m[3]
    end
    let methods = list_push(methods, ["List", [["Str", m[0]], ["Closure", m[1], m[2], mr]]])
    let k = 0
    while k < list_len(mr) do
      let raises = list_push(raises, ["Str", mr[k]])
      let k = k + 1
    end
    let i = i + 1
  end
  let traits = []
  let i = 0
  while i < list_len(decl[5]) do
    let traits = list_push(traits, ["Str", decl[5][i]])
    let i = i + 1
  end
  return ["Expr", ["Call", "class_define", [["Str", decl[1]], ["Str", decl[2]], ["List", defaults], ["List", methods], ["List", traits], ["List", raises]]], 0]
end

# The functions a program reaches by name, registered at start
# (runtime/threads.patlang), each with a closure that calls it: every name
# passed as a literal for a by_name parameter; when some call passes a name
# computed at run time ("*"), every function of the program's own files.
make a function called lw_by_name_registrations takes files, symbols, names returns stmts
  let wanted = []
  let all = v2_contains(names, "*")
  let i = 0
  while i < list_len(names) do
    if (names[i] != "*") and (not v2_contains(wanted, names[i])) then
      let wanted = list_push(wanted, names[i])
    end
    let i = i + 1
  end
  let all_runtime = false
  let f = 0
  while f < list_len(files) do
    if files[f][2] then
      let all_runtime = true
    end
    let f = f + 1
  end
  if all or all_runtime then
    let f = 0
    while f < list_len(files) do
      # a program's own files when a name is computed at run time; the runtime's
      # (its quiet files) when a file asks for them
      if (all and (not files[f][1])) or (all_runtime and files[f][1]) then
        let stmts = files[f][0]
        let k = 0
        while k < list_len(stmts) do
          if (stmts[k][0] == "Func") and (not v2_contains(wanted, stmts[k][1])) then
            let wanted = list_push(wanted, stmts[k][1])
          end
          let k = k + 1
        end
      end
      let f = f + 1
    end
  end
  let out = []
  let prefix = lw_user_name("")
  let i = 0
  while i < list_len(wanted) do
    # a name the program has given a function of its own reaches that function
    let key = wanted[i]
    let target = key
    if v2_contains(symbols[2], key) then
      let target = lw_user_name(key)
    elif str_starts_with(key, prefix) then
      let key = substr(key, prefix.length, key.length - prefix.length)
    end
    let params = false
    let k = 0
    while k < list_len(symbols[0]) do
      if symbols[0][k] == target then
        let params = symbols[1][k]
      end
      let k = k + 1
    end
    if params != false then
      let wrapper = ["Closure", params, [["Return", ["CallThrough", target, params], 0]]]
      let out = list_push(out, ["Expr", ["Call", "rt_register_function", [["Str", key], wrapper], "runtime"], 0])
    end
    let i = i + 1
  end
  return out
end

make a function called v2_concat takes a, b returns out
  let out = a
  let i = 0
  while i < list_len(b) do
    let out = list_push(out, b[i])
    let i = i + 1
  end
  return out
end
