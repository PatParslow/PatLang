# v2 lowering: one declaration's AST to IR (ir.patlang). A pure stage: its
# state is the builder passed to every function here, never __vars
# (docs/spec/values-and-memory.md 2.5). Names synthesized here (labels,
# temporaries) are local to the declaration.
#
# The builder is [instrs, names, slots, counters, errors, decl, lifted,
# ctx, raises]: vecs, so the helpers below can add to them. counters holds
# [next slot, next label, next closure]; decl is the declaration's name,
# from which every name synthesized here is made; lifted collects the
# functions lifted out of it (closures); ctx is [quiet, symbols]: whether
# its file declared quiet_operators(), and the symbol index (lw_symbols);
# raises lists the events the function raises when it returns.

make a function called lw_new_builder takes decl, lifted, ctx, raises returns fb
  let counters = vec_new()
  vec_push(counters, 0)
  vec_push(counters, 0)
  vec_push(counters, 0)
  return [vec_new(), vec_new(), vec_new(), counters, vec_new(), decl, lifted, ctx, raises]
end

# The symbol index: every declared function's name and parameter names,
# made before any declaration is lowered (the one program-wide input
# lowering needs).
make a function called lw_symbols takes files returns symbols
  let names = []
  let params = []
  let f = 0
  while f < list_len(files) do
    let stmts = files[f][0]
    let i = 0
    while i < list_len(stmts) do
      if stmts[i][0] == "Func" then
        let names = list_push(names, stmts[i][1])
        let params = list_push(params, lw_param_names(stmts[i][2]))
      end
      let i = i + 1
    end
    let f = f + 1
  end
  return [names, params]
end

# A declared function's parameter names, or false.
make a function called lw_params_of takes fb, name returns params
  let symbols = fb[7][1]
  let i = 0
  while i < list_len(symbols[0]) do
    if symbols[0][i] == name then
      return symbols[1][i]
    end
    let i = i + 1
  end
  return false
end

make a function called lw_emit takes fb, ins returns done
  vec_push(fb[0], ins)
  return true
end

make a function called lw_error takes fb, text returns done
  vec_push(fb[4], text)
  return true
end

make a function called lw_new_slot takes fb returns s
  let s = vec_get(fb[3], 0)
  vec_set(fb[3], 0, s + 1)
  return s
end

make a function called lw_new_label takes fb returns l
  let l = vec_get(fb[3], 1)
  vec_set(fb[3], 1, l + 1)
  return l
end

# The slot holding a variable, or -1.
make a function called lw_var_slot takes fb, name returns s
  let names = fb[1]
  let i = 0
  let n = vec_len(names)
  while i < n do
    if vec_get(names, i) == name then
      return vec_get(fb[2], i)
    end
    let i = i + 1
  end
  return 0 - 1
end

make a function called lw_rebind takes fb, name, s returns done
  let names = fb[1]
  let i = 0
  while i < vec_len(names) do
    if vec_get(names, i) == name then
      # the old slot stays a variable, under no name
      let old = vec_get(fb[2], i)
      vec_set(fb[2], i, s)
      vec_push(fb[1], "")
      vec_push(fb[2], old)
      return true
    end
    let i = i + 1
  end
  return false
end

make a function called lw_bind takes fb, name returns s
  let s = lw_var_slot(fb, name)
  if s >= 0 then
    return s
  end
  let s = lw_new_slot(fb)
  vec_push(fb[1], name)
  vec_push(fb[2], s)
  return s
end

# ---- expressions: each leaves its value in a slot and returns the slot ----

make a function called lw_const takes fb, kind, text returns s
  let s = lw_new_slot(fb)
  lw_emit(fb, ["const", s, kind, text])
  return s
end

# A number literal arrives as its text: float if it has a point or an
# exponent; otherwise an int when it fits in 64 bits (spec 1.3), else a
# bigint.
make a function called lw_num_kind takes text returns kind
  let i = 0
  while i < text.length do
    let c = char_code(text, i)
    if (c == 46) or (c == 101) or (c == 69) then
      return "float"
    end
    let i = i + 1
  end
  let max = "9223372036854775807"
  if text.length < max.length then
    return "int"
  end
  if text.length > max.length then
    return "bigint"
  end
  if text <= max then
    return "int"
  end
  return "bigint"
end

make a function called lw_num takes fb, text returns s
  let kind = lw_num_kind(text)
  if kind == "bigint" then
    # built at run time from its digits (runtime/integers.patlang)
    let t = lw_const(fb, "str", text)
    let d = lw_new_slot(fb)
    lw_emit(fb, ["call", d, "int_from_text", [t]])
    return d
  end
  return lw_const(fb, kind, text)
end

make a function called lw_expr takes fb, e returns s
  let kind = e[0]
  if kind == "Num" then
    return lw_num(fb, e[1])
  end
  if kind == "Bool" then
    # the parser keeps a boolean literal as its text
    if (e[1] == true) or (e[1] == "true") then
      return lw_const(fb, "bool", "1")
    end
    return lw_const(fb, "bool", "0")
  end
  if kind == "Str" then
    return lw_const(fb, "str", e[1])
  end
  if kind == "Unit" then
    return lw_const(fb, "unit", "")
  end
  if kind == "Var" then
    let s = lw_var_slot(fb, e[1])
    if s < 0 then
      lw_error(fb, "undefined variable " + e[1])
      return lw_const(fb, "unit", "")
    end
    return s
  end
  if kind == "Bin" then
    let op = e[1]
    if (op == "and") or (op == "or") then
      return lw_logic(fb, op, e[2], e[3])
    end
    let a = lw_expr(fb, e[2])
    let b = lw_expr(fb, e[3])
    let d = lw_new_slot(fb)
    if (op == "+") and fb[7][0] then
      lw_emit(fb, ["op", d, "q+", a, b])
    else
      lw_emit(fb, ["op", d, op, a, b])
    end
    return d
  end
  if kind == "Un" then
    let a = lw_expr(fb, e[2])
    let d = lw_new_slot(fb)
    lw_emit(fb, ["un", d, e[1], a])
    return d
  end
  if kind == "Call" then
    return lw_call(fb, e[1], e[2])
  end
  # A function reached by its name: its wrapper hands its parameters straight
  # on, exactly as given (own.patlang)
  if kind == "CallThrough" then
    let slots = []
    let i = 0
    while i < list_len(e[2]) do
      let slots = list_push(slots, lw_var_slot(fb, e[2][i]))
      let i = i + 1
    end
    let d = lw_new_slot(fb)
    lw_emit(fb, ["call", d, e[1], slots, "through"])
    return d
  end
  # v.name: the runtime's dot_name(v), until classes give every value its
  # methods (docs/plans/v2-implementation.md, milestone 5)
  if kind == "Member" then
    return lw_call(fb, "rt_member", [e[1], ["Str", e[2]]])
  end
  if kind == "MethodCall" then
    return lw_call(fb, "send", v2_concat([e[1], ["Str", e[2]]], e[3]))
  end
  if kind == "Index" then
    return lw_call(fb, "index_get", [e[1], e[2]])
  end
  if kind == "Closure" then
    let raises = []
    if list_len(e) > 3 then
      let raises = e[3]
    end
    return lw_closure(fb, e[1], e[2], raises)
  end
  if kind == "Budgeted" then
    return lw_budgeted(fb, e)
  end
  if kind == "List" then
    let slots = []
    let i = 0
    while i < list_len(e[1]) do
      let slots = list_push(slots, lw_expr(fb, e[1][i]))
      let i = i + 1
    end
    let d = lw_new_slot(fb)
    lw_emit(fb, ["list", d, slots])
    return d
  end
  lw_error(fb, "unsupported expression " + kind)
  return lw_const(fb, "unit", "")
end

# a and b: b is evaluated only when a is true; a or b, only when a is false.
# `and` and `or` give a bool, the right side evaluated only when needed.
make a function called lw_logic takes fb, op, ea, eb returns d
  let d = lw_new_slot(fb)
  let a = lw_expr(fb, ea)
  let l_rhs = lw_new_label(fb)
  let l_true = lw_new_label(fb)
  let l_false = lw_new_label(fb)
  let l_end = lw_new_label(fb)
  if op == "and" then
    lw_emit(fb, ["branch", a, l_rhs, l_false])
  else
    lw_emit(fb, ["branch", a, l_true, l_rhs])
  end
  lw_emit(fb, ["label", l_rhs])
  let b = lw_expr(fb, eb)
  lw_emit(fb, ["branch", b, l_true, l_false])
  lw_emit(fb, ["label", l_true])
  lw_emit(fb, ["copy", d, lw_const(fb, "bool", "1")])
  lw_emit(fb, ["jump", l_end])
  lw_emit(fb, ["label", l_false])
  lw_emit(fb, ["copy", d, lw_const(fb, "bool", "0")])
  lw_emit(fb, ["jump", l_end])
  lw_emit(fb, ["label", l_end])
  return d
end

make a function called lw_call takes fb, name, args returns d
  let fslot = lw_var_slot(fb, name)
  if fslot >= 0 then
    let slots = [fslot]
    let i = 0
    while i < list_len(args) do
      let slots = list_push(slots, lw_expr(fb, args[i]))
      let i = i + 1
    end
    let d = lw_new_slot(fb)
    lw_emit(fb, ["callv", d, slots])
    return d
  end
  if name == "extern_call" then
    return lw_extern(fb, args, "extern")
  end
  if name == "extern_call_float" then
    return lw_extern(fb, args, "externf")
  end
  let args = lw_fit_args(fb, name, args)
  let slots = []
  let i = 0
  while i < list_len(args) do
    let slots = list_push(slots, lw_expr(fb, args[i]))
    let i = i + 1
  end
  let d = lw_new_slot(fb)
  if (name == "quiet_operators") or (name == "runtime_functions_by_name") then
    return lw_const(fb, "unit", "")
  end
  if ir_is_prim(name) then
    let want = ir_prim_arity(name)
    if (want >= 0) and (want != list_len(slots)) then
      lw_error(fb, name + " takes " + want + " arguments, given " + list_len(slots))
    end
    lw_emit(fb, ["prim", d, name, slots])
  else
    lw_emit(fb, ["call", d, name, slots])
  end
  return d
end

# A call's arguments fitted to the declared function: missing ones are
# unit; when the last parameter is named rest, it receives the arguments
# from its position on as a list. Calls of undeclared names are left as
# they are.
make a function called lw_fit_args takes fb, name, args returns fitted
  let params = lw_params_of(fb, name)
  if params == false then
    return args
  end
  let n = list_len(params)
  let k = 0
  while (k < n) and (k < list_len(args)) do
    if params[k] == "by_name" then
      if args[k][0] == "Str" then
        vec_push(fb[7][2], args[k][1])
      else
        vec_push(fb[7][2], "*")
      end
    end
    let k = k + 1
  end
  if (n > 0) and (params[n - 1] == "rest") then
    let fixed = []
    let i = 0
    while (i < n - 1) and (i < list_len(args)) do
      let fixed = list_push(fixed, args[i])
      let i = i + 1
    end
    let rest = []
    while i < list_len(args) do
      let rest = list_push(rest, args[i])
      let i = i + 1
    end
    while list_len(fixed) < n - 1 do
      let fixed = list_push(fixed, ["Unit"])
    end
    return list_push(fixed, ["List", rest])
  end
  let fitted = args
  while list_len(fitted) < n do
    let fitted = list_push(fitted, ["Unit"])
  end
  return fitted
end

# extern_call("KERNEL32.DLL", "WriteFile", args...): the library and the
# function are names fixed at compile time, so they must be string
# literals; the arguments are words (ints).
make a function called lw_extern takes fb, args, kind returns d
  let d = lw_new_slot(fb)
  if list_len(args) < 2 then
    lw_error(fb, "extern_call needs a library and a function name")
    return d
  end
  if (args[0][0] != "Str") or (args[1][0] != "Str") then
    lw_error(fb, "extern_call's library and function must be string literals")
    return d
  end
  if list_len(args) > 14 then
    lw_error(fb, "extern_call takes at most 12 words")
  end
  let slots = []
  let i = 2
  while i < list_len(args) do
    let slots = list_push(slots, lw_expr(fb, args[i]))
    let i = i + 1
  end
  lw_emit(fb, [kind, d, args[0][1], args[1][1], slots])
  return d
end

# budgeted(ms, existing) { body }: the body as a closure, which a fiber runs
# (runtime/fibers.patlang). A loop lexically in the body checks the budget at
# its back-edge, in closures inside it too, so the closure's builder says so.
make a function called lw_budgeted takes fb, e returns d
  let ms = lw_expr(fb, e[1])
  let inner = list_set(fb, 7, list_set(fb[7], 5, true))
  let f = lw_closure(inner, ["__budget_arg"], e[3], [])
  let existing = lw_expr(fb, e[2])
  let d = lw_new_slot(fb)
  lw_emit(fb, ["call", d, "rt_budgeted", [ms, f, existing]])
  return d
end

# A loop's back-edge, in a budgeted body.
make a function called lw_back_edge takes fb, l_test returns done
  if fb[7][5] then
    lw_call(fb, "budget_check", [])
  end
  lw_emit(fb, ["jump", l_test])
  return true
end

# A closure literal: its body is lifted to a function of its own, named
# from this declaration, taking the closure itself first and then its
# parameters. The closure holds the values of the variables its body reads
# that are bound here, captured now (by snapshot).
make a function called lw_closure takes fb, params, body, raises returns d
  let n = vec_get(fb[3], 2)
  vec_set(fb[3], 2, n + 1)
  let fname = fb[5] + "__closure_" + n
  let pnames = lw_param_names(params)
  let captured = []
  let slots = []
  let free = lw_free_vars(body, pnames)
  let i = 0
  while i < list_len(free) do
    let s = lw_var_slot(fb, free[i])
    if s >= 0 then
      let captured = list_push(captured, free[i])
      let slots = list_push(slots, s)
    end
    let i = i + 1
  end
  let r = lw_function_with(fname, pnames, body, captured, fb[6], true, fb[7], raises)
  vec_push(fb[6], r[0])
  let k = 0
  while k < list_len(r[1]) do
    lw_error(fb, r[1][k])
    let k = k + 1
  end
  let d = lw_new_slot(fb)
  lw_emit(fb, ["closure", d, fname, slots])
  return d
end

# The variable names an expression or statement list reads, other than the
# given parameters, each once.
make a function called lw_free_vars takes node, params returns names
  let acc = vec_new()
  lw_collect_vars(node, acc)
  let names = []
  let i = 0
  while i < vec_len(acc) do
    let nm = vec_get(acc, i)
    if (not v2_contains(params, nm)) and (not v2_contains(names, nm)) then
      let names = list_push(names, nm)
    end
    let i = i + 1
  end
  return names
end

make a function called lw_collect_vars takes node, acc returns done
  if type_of(node) != "list" then
    return true
  end
  if list_len(node) == 0 then
    return true
  end
  if (node[0] == "Var") and (list_len(node) == 2) then
    vec_push(acc, node[1])
    return true
  end
  # a call by a local name reads that name too
  if (node[0] == "Call") and (list_len(node) == 3) then
    vec_push(acc, node[1])
  end
  let i = 0
  while i < list_len(node) do
    lw_collect_vars(node[i], acc)
    let i = i + 1
  end
  return true
end

# ---- statements ----

make a function called lw_stmts takes fb, stmts returns done
  let i = 0
  while i < list_len(stmts) do
    lw_stmt(fb, stmts[i])
    let i = i + 1
  end
  return true
end

# A block whose value is wanted: its value is its last statement's, unit when it
# has none. Gives the slot holding it.
make a function called lw_block_value takes fb, stmts returns slot
  let n = list_len(stmts)
  if n == 0 then
    return lw_const(fb, "unit", "")
  end
  let i = 0
  while i < n - 1 do
    lw_stmt(fb, stmts[i])
    let i = i + 1
  end
  return lw_stmt_value(fb, stmts[n - 1])
end

# A statement's value: what a `let` bound, an expression's value, the taken
# branch's block for an `if`, the last iteration's block for a `while` (unit if
# none ran); unit for any other.
make a function called lw_stmt_value takes fb, st returns slot
  let kind = st[0]
  if kind == "Let" then
    lw_stmt(fb, st)
    return lw_var_slot(fb, st[1])
  end
  if kind == "Expr" then
    return lw_expr(fb, st[1])
  end
  if kind == "If" then
    let d = lw_new_slot(fb)
    let c = lw_expr(fb, st[1])
    let l_then = lw_new_label(fb)
    let l_else = lw_new_label(fb)
    let l_end = lw_new_label(fb)
    lw_emit(fb, ["branch", c, l_then, l_else])
    lw_emit(fb, ["label", l_then])
    lw_emit(fb, ["copy", d, lw_block_value(fb, st[2])])
    lw_emit(fb, ["jump", l_end])
    lw_emit(fb, ["label", l_else])
    lw_emit(fb, ["copy", d, lw_block_value(fb, st[3])])
    lw_emit(fb, ["jump", l_end])
    lw_emit(fb, ["label", l_end])
    return d
  end
  if kind == "Match" then
    return lw_match(fb, st, true)
  end
  if kind == "While" then
    let d = lw_new_slot(fb)
    lw_emit(fb, ["copy", d, lw_const(fb, "unit", "")])
    let l_test = lw_new_label(fb)
    let l_body = lw_new_label(fb)
    let l_end = lw_new_label(fb)
    lw_emit(fb, ["jump", l_test])
    lw_emit(fb, ["label", l_test])
    let c = lw_expr(fb, st[1])
    lw_emit(fb, ["branch", c, l_body, l_end])
    lw_emit(fb, ["label", l_body])
    lw_emit(fb, ["copy", d, lw_block_value(fb, st[2])])
    lw_back_edge(fb, l_test)
    lw_emit(fb, ["label", l_end])
    return d
  end
  lw_stmt(fb, st)
  return lw_const(fb, "unit", "")
end

# An expression that can do nothing but give its value: as a statement, whose
# value nothing takes, it prints it.
make a function called lw_only_a_value takes e returns yes
  let kind = e[0]
  if (kind == "Num") or (kind == "Str") or (kind == "Bool") or (kind == "Var") then
    return true
  end
  if kind == "Un" then
    return lw_only_a_value(e[2])
  end
  if kind == "Bin" then
    return lw_only_a_value(e[2]) and lw_only_a_value(e[3])
  end
  if kind == "List" then
    let i = 0
    while i < list_len(e[1]) do
      if not lw_only_a_value(e[1][i]) then
        return false
      end
      let i = i + 1
    end
    return true
  end
  return false
end

make a function called lw_stmt takes fb, st returns done
  let kind = st[0]
  if kind == "Let" then
    if lw_gives_var(st[1], st[2]) then
      return lw_let_giving(fb, st[1], st[2])
    end
    let v = lw_expr(fb, st[2])
    let s = lw_bind(fb, st[1])
    if s != v then
      lw_emit(fb, ["copy", s, v])
    end
    return true
  end
  if kind == "Expr" then
    if lw_only_a_value(st[1]) then
      lw_expr(fb, ["Call", "print", [st[1]]])
    else
      lw_expr(fb, st[1])
    end
    return true
  end
  if kind == "Return" then
    let r = lw_expr(fb, st[1])
    lw_raise_events(fb, r)
    lw_emit(fb, ["return", r])
    return true
  end
  if kind == "RuleDecl" then
    vec_push(fb[7][4], st[1] + "/" + list_len(st[2]))
    lw_expr(fb, ["Call", "rule_add", [["Str", st[1]], lw_rule_tokens(st[2]), lw_rule_goals(st[3])]])
    return true
  end
  if kind == "GoalDecl" then
    lw_expr(fb, ["Call", "goal_def", [["Str", st[1]], lw_rule_goals(st[2])]])
    return true
  end
  if kind == "When" then
    vec_push(fb[7][3], st[1])
    let h = lw_closure(fb, ["event_name", "event_data"], st[2], [])
    let n = lw_const(fb, "str", st[1])
    let d = lw_new_slot(fb)
    lw_emit(fb, ["call", d, "rt_on", [n, h]])
    return true
  end
  if kind == "MemberAssign" then
    lw_expr(fb, ["Call", "rt_field_set", [st[1], ["Str", st[2]], st[3]]])
    return true
  end
  if kind == "If" then
    let c = lw_expr(fb, st[1])
    let l_then = lw_new_label(fb)
    let l_else = lw_new_label(fb)
    let l_end = lw_new_label(fb)
    lw_emit(fb, ["branch", c, l_then, l_else])
    lw_emit(fb, ["label", l_then])
    lw_stmts(fb, st[2])
    lw_emit(fb, ["jump", l_end])
    lw_emit(fb, ["label", l_else])
    lw_stmts(fb, st[3])
    lw_emit(fb, ["jump", l_end])
    lw_emit(fb, ["label", l_end])
    return true
  end
  if kind == "While" then
    let l_test = lw_new_label(fb)
    let l_body = lw_new_label(fb)
    let l_end = lw_new_label(fb)
    lw_emit(fb, ["jump", l_test])
    lw_emit(fb, ["label", l_test])
    let c = lw_expr(fb, st[1])
    lw_emit(fb, ["branch", c, l_body, l_end])
    lw_emit(fb, ["label", l_body])
    lw_stmts(fb, st[2])
    lw_back_edge(fb, l_test)
    lw_emit(fb, ["label", l_end])
    return true
  end
  if kind == "Match" then
    lw_match(fb, st, false)
    return true
  end
  if kind == "Assert" then
    return lw_contract(fb, st[1], st[2], st[3])
  end
  if kind == "Err" then
    lw_error(fb, "line " + st[2] + ": " + st[1])
    return false
  end
  lw_error(fb, "unsupported statement " + kind)
  return false
end

# ---- match ----

# A pattern as ordinary expressions over subject: [test, the lets to run once
# the test has passed].
make a function called lw_pattern takes pat, subject returns r
  let tag = pat[0]
  if tag == "PWild" then
    return [["Bool", "true"], []]
  elif tag == "PBind" then
    return [["Bool", "true"], [["Let", pat[1], subject, false, false]]]
  elif tag == "PLit" then
    return [["Bin", "==", subject, pat[1]], []]
  elif tag == "PCmp" then
    return [["Bin", pat[1], subject, pat[2]], []]
  elif tag == "PGlob" then
    return [["Call", "glob_match", [subject, ["Str", pat[1]]]], []]
  end
  let subs = pat[1]
  let test = ["Bin", "and", ["Bin", "==", ["Call", "type_of", [subject]], ["Str", "list"]], ["Bin", "==", ["Member", subject, "length"], ["Num", "" + list_len(subs)]]]
  let lets = []
  let i = 0
  while i < list_len(subs) do
    let sub = lw_pattern(subs[i], ["Index", subject, ["Num", "" + i]])
    let test = ["Bin", "and", test, sub[0]]
    let j = 0
    while j < list_len(sub[1]) do
      let lets = list_push(lets, sub[1][j])
      let j = j + 1
    end
    let i = i + 1
  end
  return [test, lets]
end

# A match: the scrutinee once, then each arm's test, its bindings, its guard
# (which may read those bindings) and its block. A value no case takes stops
# the program, whether or not contracts are checked. Gives the slot holding the
# taken block's value when wanted.
make a function called lw_match takes fb, st, wanted returns d
  let d = 0 - 1
  if wanted then
    let d = lw_new_slot(fb)
  end
  let v = lw_expr(fb, st[1])
  let tmp = "__match_" + lw_new_label(fb)
  lw_emit(fb, ["copy", lw_bind(fb, tmp), v])
  let subject = ["Var", tmp]
  let l_end = lw_new_label(fb)
  let i = 0
  while i < list_len(st[2]) do
    let arm = st[2][i]
    let comp = lw_pattern(arm[0], subject)
    let c = lw_expr(fb, comp[0])
    let l_bind = lw_new_label(fb)
    let l_next = lw_new_label(fb)
    lw_emit(fb, ["branch", c, l_bind, l_next])
    lw_emit(fb, ["label", l_bind])
    lw_stmts(fb, comp[1])
    if arm[1] != false then
      let g = lw_expr(fb, arm[1])
      let l_body = lw_new_label(fb)
      lw_emit(fb, ["branch", g, l_body, l_next])
      lw_emit(fb, ["label", l_body])
    end
    if wanted then
      lw_emit(fb, ["copy", d, lw_block_value(fb, arm[2])])
    else
      lw_stmts(fb, arm[2])
    end
    lw_emit(fb, ["jump", l_end])
    lw_emit(fb, ["label", l_next])
    let i = i + 1
  end
  let w = lw_const(fb, "str", "assertion")
  let t = lw_const(fb, "str", "match: no case matched the scrutinee value")
  let n = lw_const(fb, "str", fb[5])
  let failed = lw_new_slot(fb)
  lw_emit(fb, ["call", failed, "rt_contract_failed", [w, t, n]])
  if wanted then
    lw_emit(fb, ["copy", d, lw_const(fb, "unit", "")])
  end
  lw_emit(fb, ["jump", l_end])
  lw_emit(fb, ["label", l_end])
  return d
end

# require/ensure/assert COND: when contracts are checked
# (contracts.patlang), a false COND stops the program at this point, naming
# the kind of clause, the function and the condition. Each is checked where
# it is written, as the interpreter checks it.
make a function called lw_contract takes fb, which, cond, line returns done
  if not v2_contracts_checked() then
    return true
  end
  let c = lw_expr(fb, cond)
  let l_fail = lw_new_label(fb)
  let l_ok = lw_new_label(fb)
  lw_emit(fb, ["branch", c, l_ok, l_fail])
  lw_emit(fb, ["label", l_fail])
  # the interpreter's wording (spec_library/language/require_ensure_assert)
  let kind = "assertion"
  if which == "require" then
    let kind = "precondition"
  elif which == "ensure" then
    let kind = "postcondition"
  end
  let w = lw_const(fb, "str", kind)
  let t = lw_const(fb, "str", lw_text(cond))
  let n = lw_const(fb, "str", fb[5])
  let d = lw_new_slot(fb)
  lw_emit(fb, ["call", d, "rt_contract_failed", [w, t, n]])
  lw_emit(fb, ["jump", l_ok])
  lw_emit(fb, ["label", l_ok])
  # a clause that held is a fact (runtime/logic.patlang); a quiet file's raise
  # nothing
  if not fb[7][0] then
    let held_name = lw_const(fb, "str", fb[5])
    let held_kind = lw_const(fb, "str", which)
    let held_text = lw_const(fb, "str", lw_text(cond))
    let held = lw_new_slot(fb)
    lw_emit(fb, ["call", held, "rt_contract_held", [held_name, held_kind, held_text]])
  end
  return true
end

# An expression's source text, for a contract's message.
make a function called lw_text takes e returns text
  let kind = e[0]
  if (kind == "Num") or (kind == "Var") then
    return e[1] + ""
  end
  if kind == "Bool" then
    return e[1] + ""
  end
  if kind == "Str" then
    return chr(34) + e[1] + chr(34)
  end
  if kind == "Bin" then
    return lw_text(e[2]) + " " + e[1] + " " + lw_text(e[3])
  end
  if kind == "Un" then
    if e[1] == "not" then
      return "not " + lw_text(e[2])
    end
    return e[1] + lw_text(e[2])
  end
  if kind == "Member" then
    return lw_text(e[1]) + "." + e[2]
  end
  if kind == "Call" then
    let b = sb_new()
    sb_push(b, e[1] + "(")
    let i = 0
    while i < list_len(e[2]) do
      if i > 0 then
        sb_push(b, ", ")
      end
      sb_push(b, lw_text(e[2][i]))
      let i = i + 1
    end
    sb_push(b, ")")
    return sb_str(b)
  end
  if kind == "Index" then
    return lw_text(e[1]) + "[" + lw_text(e[2]) + "]"
  end
  return kind
end

# Whether `let name = rhs` can give name's old value to the call that makes
# its new one: rhs is a call whose arguments mention name exactly once, as
# a whole argument. Nothing reads the old value after that argument.
make a function called lw_gives_var takes name, rhs returns yes
  if rhs[0] != "Call" then
    return false
  end
  if ir_is_prim(rhs[1]) or (rhs[1] == "extern_call") then
    return false
  end
  let args = rhs[2]
  let whole = 0
  let i = 0
  while i < list_len(args) do
    let a = args[i]
    if (a[0] == "Var") and (a[1] == name) then
      let whole = whole + 1
    elif lw_mentions(a, name) then
      return false
    end
    let i = i + 1
  end
  return whole == 1
end

make a function called lw_mentions takes e, name returns yes
  if type_of(e) != "list" then
    return false
  end
  if list_len(e) == 0 then
    return false
  end
  if (e[0] == "Var") and (list_len(e) == 2) then
    return e[1] == name
  end
  let i = 0
  while i < list_len(e) do
    if lw_mentions(e[i], name) then
      return true
    end
    let i = i + 1
  end
  return false
end

make a function called lw_let_giving takes fb, name, rhs returns done
  let s = lw_var_slot(fb, name)
  if s < 0 then
    let s = lw_bind(fb, name)
  end
  let args = rhs[2]
  let slots = []
  let i = 0
  while i < list_len(args) do
    let a = args[i]
    if (a[0] == "Var") and (a[1] == name) then
      let t = lw_new_slot(fb)
      lw_emit(fb, ["take", t, s])
      let slots = list_push(slots, t)
    else
      let slots = list_push(slots, lw_expr(fb, a))
    end
    let i = i + 1
  end
  let d = lw_new_slot(fb)
  lw_emit(fb, ["call", d, rhs[1], slots])
  lw_emit(fb, ["copy", s, d])
  return true
end

# Whether a pattern binds name, at any depth.
make a function called lw_pattern_binds takes pat, name returns yes
  if pat[0] == "PBind" then
    return pat[1] == name
  end
  if pat[0] != "PList" then
    return false
  end
  let i = 0
  while i < list_len(pat[1]) do
    if lw_pattern_binds(pat[1][i], name) then
      return true
    end
    let i = i + 1
  end
  return false
end

# Whether a statement list assigns name anywhere (with let), at any depth.
make a function called lw_assigns takes stmts, name returns yes
  let i = 0
  while i < list_len(stmts) do
    let st = stmts[i]
    if (st[0] == "Let") and (st[1] == name) then
      return true
    end
    if st[0] == "If" then
      if lw_assigns(st[2], name) or lw_assigns(st[3], name) then
        return true
      end
    end
    if st[0] == "While" then
      if lw_assigns(st[2], name) then
        return true
      end
    end
    if st[0] == "Match" then
      let a = 0
      while a < list_len(st[2]) do
        if lw_pattern_binds(st[2][a][0], name) or lw_assigns(st[2][a][2], name) then
          return true
        end
        let a = a + 1
      end
    end
    let i = i + 1
  end
  return false
end

# Before a return: each event the function raises, with event_data its
# arguments (the receiver first, for a method) and its result r.
make a function called lw_raise_events takes fb, r returns done
  let raises = fb[8]
  if list_len(raises) == 0 then
    return true
  end
  # the payload reads r and so does the return: a variable, under no name
  if not v2_contains(vec_to_list(fb[2]), r) then
    vec_push(fb[1], "")
    vec_push(fb[2], r)
  end
  let first = 0
  if (vec_len(fb[1]) > 0) and (vec_get(fb[1], 0) == "__closure_self") then
    let first = 1
  end
  let slots = []
  let p = first
  while p < vec_get(fb[9], 0) do
    let slots = list_push(slots, p)
    let p = p + 1
  end
  let slots = list_push(slots, r)
  let k = 0
  while k < list_len(raises) do
    let payload = lw_new_slot(fb)
    lw_emit(fb, ["list", payload, slots])
    let n = lw_const(fb, "str", raises[k])
    let d = lw_new_slot(fb)
    lw_emit(fb, ["call", d, "emit", [n, payload]])
    let k = k + 1
  end
  return true
end

# ---- declarations ----

# The parameter names, without the `mut` markers the parser leaves in.
make a function called lw_param_names takes params returns names
  let names = []
  let i = 0
  while i < list_len(params) do
    if params[i] != "mut" then
      let names = list_push(names, params[i])
    end
    let i = i + 1
  end
  return names
end

# One function's IR, and its errors: [func, errors]. Functions lifted out
# of it go to lifted.
make a function called lw_function takes name, params, body, lifted, ctx returns result
  return lw_function_with(name, lw_param_names(params), body, [], lifted, false, ctx, [])
end

# is_closure: a lifted closure, whose first parameter is the closure
# itself (xv_callv passes it); captured: the names it captured, each read
# out of the closure on entry.
make a function called lw_function_with takes name, params, body, captured, lifted, is_closure, ctx, raises returns result
  require (type_of(name) == "string") and (type_of(body) == "list")
  let fb = lw_new_builder(name, lifted, ctx, raises)
  let pnames = params
  if is_closure then
    let pnames = v2_concat(["__closure_self"], params)
  end
  let np = vec_new()
  vec_push(np, list_len(pnames))
  let fb = list_push(fb, np)
  let i = 0
  while i < list_len(pnames) do
    lw_bind(fb, pnames[i])
    let i = i + 1
  end
  # Parameters are borrowed (own.patlang). One the body reassigns gets a
  # local of its own, holding a reference to the argument, and the name
  # means that local from here on.
  let i = 0
  while i < list_len(pnames) do
    if lw_assigns(body, pnames[i]) then
      let local = lw_new_slot(fb)
      lw_emit(fb, ["copy", local, i])
      lw_rebind(fb, pnames[i], local)
    end
    let i = i + 1
  end
  if list_len(captured) > 0 then
    # read once per capture, so a variable, under no name
    let block = lw_new_slot(fb)
    vec_push(fb[1], "")
    vec_push(fb[2], block)
    lw_emit(fb, ["prim", block, "value_data", [0]])
    let k = 0
    while k < list_len(captured) do
      let off = lw_const(fb, "int", (32 + 16 * k).to_s)
      let v = lw_new_slot(fb)
      lw_emit(fb, ["prim", v, "mem_load_value", [block, off]])
      let s = lw_bind(fb, captured[k])
      lw_emit(fb, ["copy", s, v])
      let k = k + 1
    end
  end
  # falling off the end returns the body's value
  let u = lw_block_value(fb, body)
  lw_raise_events(fb, u)
  lw_emit(fb, ["return", u])
  let func = ir_fn(name, list_len(pnames), vec_get(fb[3], 0), vec_to_list(fb[0]), vec_to_list(fb[2]))
  ensure ir_well_formed(func, false) and ir_temps_read_once(func)
  return [func, vec_to_list(fb[4])]
end

# A program's declarations as IR: every function, and __main for the
# top-level statements, its classes registered first. files is a list of
# [stmts, quiet]. [fns, errors, facts]: facts are the program facts code
# generation needs, [the event names some `when` handles].
make a function called lw_program takes files returns result
  let symbols = lw_symbols(files)
  let by_name = vec_new()
  let handled = vec_new()
  let rules = vec_new()
  let runtime_names = vec_new()
  let fns = []
  let errors = []
  let top = []
  let classes = []
  let lifted = vec_new()
  let f = 0
  while f < list_len(files) do
    let stmts = files[f][0]
    let ctx = [files[f][1], symbols, by_name, handled, rules, false]
    let i = 0
    while i < list_len(stmts) do
      let st = stmts[i]
      if st[0] == "Func" then
        let raises = []
        if list_len(st) > 5 then
          let raises = st[5]
        end
        # `returns NAME`: the function's result, when the body assigns it
        let body = st[3]
        if (list_len(st) > 4) and (st[4] != "") and lw_assigns(body, st[4]) then
          let body = list_push(body, ["Return", ["Var", st[4]]])
        end
        let r = lw_function_with(st[1], lw_param_names(st[2]), body, [], lifted, false, ctx, raises)
        let fns = list_push(fns, r[0])
        if files[f][1] then
          vec_push(runtime_names, st[1])
        end
        let errors = v2_concat(errors, r[1])
      elif st[0] == "ClassDecl" then
        let classes = list_push(classes, lw_class_registration(st))
      else
        let top = list_push(top, st)
      end
      let i = i + 1
    end
    let f = f + 1
  end
  # __main registers the functions reached by name first: __register is
  # lowered last, when every by_name call has been seen
  let start = ["Expr", ["Call", "__register", []], 0]
  let r = lw_function_with("__main", [], v2_concat([start], v2_concat(classes, top)), [], lifted, false, [false, symbols, by_name, handled, rules, false], [])
  let fns = list_push(fns, r[0])
  let errors = v2_concat(errors, r[1])
  let registrations = lw_by_name_registrations(files, symbols, vec_to_list(by_name))
  let r = lw_function_with("__register", [], registrations, [], lifted, false, [false, symbols, by_name, handled, rules, false], [])
  let fns = list_push(fns, r[0])
  let errors = v2_concat(errors, r[1])
  # the program facts (B2), each recorded where it was declared: the events
  # handled, the names passed for by_name parameters, the rules
  let facts = [vec_to_list(handled), vec_to_list(by_name), vec_to_list(rules)]
  let fns = v2_concat(fns, vec_to_list(lifted))
  return [fns, errors, facts, vec_to_list(runtime_names)]
end

# What a call to a name nothing declares reaches: it stops the program there,
# the lines before it having run (spec_library/language: "stop at it with host
# fn 'no_such_host' not found").
make a function called lw_undeclared_function takes name returns func
  let body = [["Return", ["Call", "rt_undeclared", [["Str", name]]]]]
  let r = lw_function_with(name, [], body, [], vec_new(), false, [true, [], vec_new(), vec_new(), vec_new(), false], [])
  return r[0]
end

# A goal's arguments as the logic engine takes them (runtime/logic.patlang):
# each its token's text, a capitalised one a logic variable.
make a function called lw_rule_tokens takes args returns node
  let tokens = []
  let i = 0
  while i < list_len(args) do
    let tokens = list_push(tokens, ["Str", args[i][1]])
    let i = i + 1
  end
  return ["List", tokens]
end

# A list of goals, [pred, args] each, as a list literal.
make a function called lw_rule_goals takes goals returns node
  let out = []
  let i = 0
  while i < list_len(goals) do
    let out = list_push(out, ["List", [["Str", goals[i][0]], lw_rule_tokens(goals[i][1])]])
    let i = i + 1
  end
  return ["List", out]
end

# A class declaration as the statement that registers it: class_define
# (runtime/objects.patlang) with its field defaults, its methods as
# closures (each taking the object first), its traits, and the events its
# methods raise.
make a function called lw_class_registration takes decl returns st
  let defaults = []
  let i = 0
  while i < list_len(decl[3]) do
    let defaults = list_push(defaults, ["List", [["Str", decl[3][i][0]], decl[3][i][1]]])
    let i = i + 1
  end
  let methods = []
  let raises = []
  let i = 0
  while i < list_len(decl[4]) do
    let m = decl[4][i]
    let mr = []
    if list_len(m) > 3 then
      let mr = m[3]
    end
    let methods = list_push(methods, ["List", [["Str", m[0]], ["Closure", m[1], m[2], mr]]])
    let k = 0
    while k < list_len(mr) do
      let raises = list_push(raises, ["Str", mr[k]])
      let k = k + 1
    end
    let i = i + 1
  end
  let traits = []
  let i = 0
  while i < list_len(decl[5]) do
    let traits = list_push(traits, ["Str", decl[5][i]])
    let i = i + 1
  end
  return ["Expr", ["Call", "class_define", [["Str", decl[1]], ["Str", decl[2]], ["List", defaults], ["List", methods], ["List", traits], ["List", raises]]], 0]
end

# The functions a program reaches by name, registered at start
# (runtime/threads.patlang), each with a closure that calls it: every name
# passed as a literal for a by_name parameter; when some call passes a name
# computed at run time ("*"), every function of the program's own files.
make a function called lw_by_name_registrations takes files, symbols, names returns stmts
  let wanted = []
  let all = v2_contains(names, "*")
  let i = 0
  while i < list_len(names) do
    if (names[i] != "*") and (not v2_contains(wanted, names[i])) then
      let wanted = list_push(wanted, names[i])
    end
    let i = i + 1
  end
  let all_runtime = false
  let f = 0
  while f < list_len(files) do
    if files[f][2] then
      let all_runtime = true
    end
    let f = f + 1
  end
  if all or all_runtime then
    let f = 0
    while f < list_len(files) do
      # a program's own files when a name is computed at run time; the runtime's
      # (its quiet files) when a file asks for them
      if (all and (not files[f][1])) or (all_runtime and files[f][1]) then
        let stmts = files[f][0]
        let k = 0
        while k < list_len(stmts) do
          if (stmts[k][0] == "Func") and (not v2_contains(wanted, stmts[k][1])) then
            let wanted = list_push(wanted, stmts[k][1])
          end
          let k = k + 1
        end
      end
      let f = f + 1
    end
  end
  let out = []
  let i = 0
  while i < list_len(wanted) do
    let params = false
    let k = 0
    while k < list_len(symbols[0]) do
      if symbols[0][k] == wanted[i] then
        let params = symbols[1][k]
      end
      let k = k + 1
    end
    if params != false then
      let wrapper = ["Closure", params, [["Return", ["CallThrough", wanted[i], params], 0]]]
      let out = list_push(out, ["Expr", ["Call", "rt_register_function", [["Str", wanted[i]], wrapper]], 0])
    end
    let i = i + 1
  end
  return out
end

make a function called v2_concat takes a, b returns out
  let out = a
  let i = 0
  while i < list_len(b) do
    let out = list_push(out, b[i])
    let i = i + 1
  end
  return out
end
