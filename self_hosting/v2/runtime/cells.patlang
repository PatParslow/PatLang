# v2 runtime: string builders, vecs, bool arrays and bytes (spec 1.5): mutable,
# with identity, so a change through one holder is seen through every
# holder. Each is a counted block; a builder and a bool array keep their
# bytes in a buffer block of their own (an uncounted rt_alloc block, freed
# with them), a vec its list.
#   string builder (class 11): 16 length, 24 capacity, 32 buffer, 40 its users
#   vec (class 12): 16 its list, 32 its users, 40 its place in the registry
#                   of blocks that can close a cycle (memory.patlang)
#   bool array (class 13): 16 length in bits, 24 capacity in words,
#                          32 buffer of 64-bit words, 40 its users
# A rule store (class 14) is a cell too; its layout is in logic.patlang.
#
# A cell belongs to one thread at a time (spec 1.8). Its users word counts the
# threads inside it once a second thread has been started: 1 for each reading
# it, 2^32 for one changing it. A thread that comes to change a cell another
# is using, or to read one another is changing, stops the program saying so
# (98): the alternative is a block freed twice. Threads that only read one
# together are fine, and so is handing a cell from one thread to another. An
# object's fields (objects.patlang) and a rule store (logic.patlang) are kept
# the same way.
quiet_operators()

make a function called rt_cell_shared returns r
  print("a vec, a string builder, a bool array, a bytes, an object's fields or a rule store was changed by one thread while another was using it: each belongs to one thread at a time")
  let r = rt_stop(98)
  ensure false
  return r
end

# Enters the cell whose users word is at `at` to read it: whether it counted
# itself, for rt_cell_read_end.
make a function called rt_cell_read takes at returns entered
  require at != 0
  if mem_load(runtime_state(), 4608) == 0 then
    let entered = false
    ensure value_class(entered) == 1
    return entered
  end
  if atomic_add(at, 1) >= 4294967296 then
    rt_cell_shared()
  end
  let entered = true
  ensure value_class(entered) == 1
  return entered
end

make a function called rt_cell_read_end takes at, entered returns r
  require (at != 0) and (value_class(entered) == 1)
  if entered then
    atomic_add(at, 0 - 1)
  end
  let r = 0
  ensure r == 0
  return r
end

# Enters the cell to change it.
make a function called rt_cell_write takes at returns entered
  require at != 0
  if mem_load(runtime_state(), 4608) == 0 then
    let entered = false
    ensure value_class(entered) == 1
    return entered
  end
  if atomic_add(at, 4294967296) != 0 then
    rt_cell_shared()
  end
  let entered = true
  ensure value_class(entered) == 1
  return entered
end

make a function called rt_cell_write_end takes at, entered returns r
  require (at != 0) and (value_class(entered) == 1)
  if entered then
    atomic_add(at, 0 - 4294967296)
  end
  let r = 0
  ensure r == 0
  return r
end

# ---- string builders ----

make a function called sb_new returns b
  let block = rt_alloc(32)
  mem_store(block, 16, 0)
  mem_store(block, 24, 32)
  mem_store(block, 32, rt_alloc(32))
  mem_store(block, 40, 0)
  let b = value_make(4294967307, block)
  ensure (value_class(b) == 11) and (sb_len(b) == 0)
  return b
end

# Room for at least n bytes, the buffer doubling as it grows.
make a function called rt_sb_reserve takes block, n returns r
  require (block != 0) and (n >= 0)
  let cap = mem_load(block, 24)
  if n <= cap then
    let r = 0
    ensure mem_load(block, 24) >= n
    return r
  end
  let new_cap = cap
  while new_cap < n do
    let new_cap = word_mul(new_cap, 2)
  end
  let old = mem_load(block, 32)
  let buf = rt_alloc(new_cap)
  rt_copy_bytes(buf + 16, old + 16, mem_load(block, 16))
  rt_free(old)
  mem_store(block, 32, buf)
  mem_store(block, 24, new_cap)
  let r = 0
  ensure mem_load(block, 24) >= n
  return r
end

make a function called sb_push takes b, x returns r
  require (value_class(b) == 11) and value_live(x)
  let text = to_s(x)
  let n = str_len(text)
  let block = value_data(b)
  let e = rt_cell_write(block + 40)
  let len = mem_load(block, 16)
  rt_sb_reserve(block, len + n)
  rt_copy_bytes(mem_load(block, 32) + 16 + len, rt_str_bytes(text), n)
  mem_store(block, 16, len + n)
  rt_cell_write_end(block + 40, e)
  let r = b
  ensure value_class(r) == 11
  return r
end

make a function called sb_str takes b returns s
  require value_class(b) == 11
  let block = value_data(b)
  let e = rt_cell_read(block + 40)
  let len = mem_load(block, 16)
  let out = rt_str_alloc(len)
  rt_copy_bytes(out + 32, mem_load(block, 32) + 16, len)
  rt_cell_read_end(block + 40, e)
  let s = value_make(rt_string_heap_type(), out)
  ensure (value_class(s) == 8) and (str_len(s) == len)
  return s
end

make a function called sb_len takes b returns n
  require value_class(b) == 11
  let n = mem_load(value_data(b), 16)
  ensure n >= 0
  return n
end

# ---- vecs ----

make a function called vec_new returns v
  let block = rt_alloc(32)
  mem_store(block, 16, 0)
  mem_store(block, 24, 0)
  mem_store(block, 32, 0)
  mem_store(block, 40, 0)
  mem_init_value(block, 16, [])
  let v = value_make(4294967308, block)
  rt_cycle_register(4294967308, block)
  ensure (value_class(v) == 12) and (vec_len(v) == 0)
  return v
end

# The vec's list taken out (the vec holds unit meanwhile), so its count is
# 1 and list_push and list_set change it in place; then put back.
make a function called vec_push takes v, x returns r
  require (value_class(v) == 12) and value_live(x)
  let block = value_data(v)
  let e = rt_cell_write(block + 32)
  let l = mem_take_value(block, 16)
  let l = list_push(l, x)
  mem_init_value(block, 16, l)
  rt_cell_write_end(block + 32, e)
  let r = v
  ensure value_class(r) == 12
  return r
end

make a function called vec_set takes v, i, x returns r
  require (value_class(v) == 12) and (value_class(i) == 2) and value_live(x)
  let block = value_data(v)
  let e = rt_cell_write(block + 32)
  let l = mem_take_value(block, 16)
  let l = list_set(l, i, x)
  mem_init_value(block, 16, l)
  rt_cell_write_end(block + 32, e)
  let r = v
  ensure value_class(r) == 12
  return r
end

# The vec's last element, taken out of it. The vec's list is taken out while
# it shrinks, as vec_push does; when something else holds it too, the vec
# gets a copy of its own first.
make a function called rt_vec_pop takes v returns x
  require (value_class(v) == 12) and (vec_len(v) > 0)
  let block = value_data(v)
  let e = rt_cell_write(block + 32)
  let l = mem_take_value(block, 16)
  let n = list_len(l)
  if mem_load(value_data(l), 0) != 1 then
    let l = value_make(rt_list_heap_type(), rt_list_copy(l, n))
  end
  let lb = value_data(l)
  let x = mem_take_value(lb, 32 + 16 * (n - 1))
  mem_store(lb, 16, n - 1)
  mem_init_value(block, 16, l)
  rt_cell_write_end(block + 32, e)
  ensure value_live(x)
  return x
end

make a function called vec_get takes v, i returns x
  require value_class(v) == 12
  let block = value_data(v)
  let e = rt_cell_read(block + 32)
  let l = mem_load_value(block, 16)
  rt_cell_read_end(block + 32, e)
  let x = list_get(l, i)
  ensure value_live(x)
  return x
end

make a function called vec_len takes v returns n
  require value_class(v) == 12
  let n = list_len(vec_to_list(v))
  ensure n >= 0
  return n
end

# Every element of a list pushed onto the vec, in place.
# Room is made once (rt_list_reserve), then each element is copied in with
# a reference of its own, as rt_list_copy does. items may be the vec's own
# list: then the vec's list has a second holder, so it is copied first.
make a function called vec_extend takes v, items returns r
  require (value_class(v) == 12) and (value_class(items) == 9)
  let block = value_data(v)
  let e = rt_cell_write(block + 32)
  let l = mem_take_value(block, 16)
  let m = list_len(items)
  let l = rt_list_reserve(l, m)
  let lb = value_data(l)
  let n = mem_load(lb, 16)
  ct_public(n)
  let src = value_data(items)
  let k = 0
  while k < m do
    mem_init_value(lb, 32 + 16 * (n + k), mem_load_value(src, 32 + 16 * k))
    let k = k + 1
  end
  mem_store(lb, 16, n + m)
  mem_init_value(block, 16, l)
  rt_cell_write_end(block + 32, e)
  let r = v
  ensure value_class(r) == 12
  return r
end

# The vec's list as a value: shared until either changes it, when the
# count makes the change copy.
make a function called vec_to_list takes v returns l
  require value_class(v) == 12
  let block = value_data(v)
  let e = rt_cell_read(block + 32)
  let l = mem_load_value(block, 16)
  rt_cell_read_end(block + 32, e)
  ensure (value_class(l) == 9)
  return l
end

# ---- bool arrays ----

make a function called bool_array_new takes n returns a
  require (value_class(n) == 2) and (n >= 0)
  let words = word_shr(n + 63, 6)
  if words < 1 then
    let words = 1
  end
  let block = rt_alloc(32)
  mem_store(block, 16, n)
  mem_store(block, 24, words)
  mem_store(block, 40, 0)
  let buf = rt_alloc(8 * words)
  let k = 0
  while k < words do
    mem_store(buf, 16 + 8 * k, 0)
    let k = k + 1
  end
  mem_store(block, 32, buf)
  let a = value_make(4294967309, block)
  ensure (value_class(a) == 13) and (bool_array_len(a) == n)
  return a
end

make a function called bool_array_len takes a returns n
  require value_class(a) == 13
  let n = mem_load(value_data(a), 16)
  ensure n >= 0
  return n
end

make a function called bool_array_get takes a, i returns v
  require value_class(a) == 13
  let block = value_data(a)
  let e = rt_cell_read(block + 40)
  rt_check_index(i, mem_load(block, 16))
  let word = mem_load(mem_load(block, 32), 16 + 8 * word_shr(i, 6))
  rt_cell_read_end(block + 40, e)
  let v = word_and(word_shr(word, word_and(i, 63)), 1) == 1
  ensure value_class(v) == 1
  return v
end

make a function called bool_array_set takes a, i, v returns r
  require (value_class(a) == 13) and (value_class(v) == 1)
  let block = value_data(a)
  let e = rt_cell_write(block + 40)
  rt_bool_array_store(block, i, v)
  rt_cell_write_end(block + 40, e)
  let r = a
  ensure value_class(r) == 13
  return r
end

# One bit set in a bool array's block, by a caller that has entered it.
make a function called rt_bool_array_store takes block, i, v returns r
  require (block != 0) and (value_class(v) == 1)
  rt_check_index(i, mem_load(block, 16))
  let at = mem_load(block, 32) + 16 + 8 * word_shr(i, 6)
  let mask = word_shl(1, word_and(i, 63))
  if v then
    mem_store(at, 0, word_or(mem_load(at, 0), mask))
  else
    mem_store(at, 0, word_and(mem_load(at, 0), word_xor(mask, 0 - 1)))
  end
  let r = 0
  ensure r == 0
  return r
end

# Grows in place, the buffer doubling: the array stays the same array.
make a function called bool_array_push takes a, v returns r
  require (value_class(a) == 13) and (value_class(v) == 1)
  let block = value_data(a)
  let e = rt_cell_write(block + 40)
  let n = mem_load(block, 16)
  let words = mem_load(block, 24)
  if word_shr(n, 6) >= words then
    let new_words = word_mul(words, 2)
    let old = mem_load(block, 32)
    let buf = rt_alloc(8 * new_words)
    let k = 0
    while k < new_words do
      if k < words then
        mem_store(buf, 16 + 8 * k, mem_load(old, 16 + 8 * k))
      else
        mem_store(buf, 16 + 8 * k, 0)
      end
      let k = k + 1
    end
    rt_free(old)
    mem_store(block, 32, buf)
    mem_store(block, 24, new_words)
  end
  mem_store(block, 16, n + 1)
  rt_bool_array_store(block, n, v)
  rt_cell_write_end(block + 40, e)
  let r = a
  ensure (value_class(r) == 13) and (bool_array_len(r) == n + 1)
  return r
end

# Frees what a freed cell holds (rt_finalize).
make a function called rt_cell_finalize takes cls, block returns r
  require (((cls >= 11) and (cls <= 14)) or (cls == 18)) and (mem_load(block, 0) == 0)
  if cls == 12 then
    rt_release_value_at(block, 16)
  elif cls == 14 then
    # a rule store (logic.patlang): its rules, its index and its facts
    rt_release_value_at(block, 16)
    rt_release_value_at(block, 32)
    rt_release_value_at(block, 48)
  else
    rt_free(mem_load(block, 32))
  end
  let r = 0
  ensure r == 0
  return r
end

# ---- bytes ----
#
# A buffer of bytes with identity, as a vec is (class 18): 16 length, 24
# capacity, 32 the buffer (an uncounted block, its bytes from 16), 40 its
# users. One byte of memory holds one byte, where a list of ints holds a
# 16-byte value for each (review finding O9).

make a function called rt_bytes_heap_type returns t
  let t = 4294967314
  ensure (word_and(t, 4294967295) == 18) and (word_and(t, 4294967296) != 0)
  return t
end

# Where a bytes' first byte is: for the runtime, which copies to and from it.
make a function called rt_bytes_addr takes b returns addr
  require value_class(b) == 18
  let addr = mem_load(value_data(b), 32) + 16
  ensure addr != 0
  return addr
end

make a function called bytes_new takes n returns b
  require (value_class(n) == 2) and (n >= 0)
  let cap = n
  if cap < 16 then
    let cap = 16
  end
  let block = rt_alloc(32)
  mem_store(block, 16, n)
  mem_store(block, 24, cap)
  mem_store(block, 40, 0)
  let buf = rt_alloc(cap)
  let k = 0
  while k < cap do
    mem_store_byte(buf, 16 + k, 0)
    let k = k + 1
  end
  mem_store(block, 32, buf)
  let b = value_make(rt_bytes_heap_type(), block)
  ensure (value_class(b) == 18) and (bytes_len(b) == n)
  return b
end

make a function called bytes_len takes b returns n
  require value_class(b) == 18
  let n = mem_load(value_data(b), 16)
  ensure n >= 0
  return n
end

# A bytes's reads and writes enter its cell only when a second thread exists:
# `(mem_load(runtime_state(), 4608) != 0) and rt_cell_read(at)`, the check
# rt_cell_read makes first, made without the call, which with its pair cost a
# read a third of its time.
make a function called bytes_get takes b, i returns v
  require value_class(b) == 18
  let block = value_data(b)
  let e = (mem_load(runtime_state(), 4608) != 0) and rt_cell_read(block + 40)
  # checked here, as rt_check_index checks, and calling out only to fail
  if (value_class(i) != 2) or (i < 0) or (i >= mem_load(block, 16)) then
    if e then
      rt_cell_read_end(block + 40, e)
    end
    rt_fail_index()
  end
  let v = mem_load_byte(mem_load(block, 32), 16 + i)
  if e then
    rt_cell_read_end(block + 40, e)
  end
  ensure (v >= 0) and (v <= 255)
  return v
end

make a function called bytes_set takes b, i, v returns r
  require (value_class(b) == 18) and (value_class(v) == 2) and (v >= 0) and (v <= 255)
  let block = value_data(b)
  let e = (mem_load(runtime_state(), 4608) != 0) and rt_cell_write(block + 40)
  if (value_class(i) != 2) or (i < 0) or (i >= mem_load(block, 16)) then
    if e then
      rt_cell_write_end(block + 40, e)
    end
    rt_fail_index()
  end
  mem_store_byte(mem_load(block, 32), 16 + i, v)
  if e then
    rt_cell_write_end(block + 40, e)
  end
  let r = b
  ensure value_class(r) == 18
  return r
end

# Room for need bytes in a bytes' block, by a caller that has entered it:
# the buffer at least doubles, so pushing n bytes copies O(n) in all.
make a function called rt_bytes_reserve takes block, need returns r
  require (block != 0) and (need >= 0)
  let cap = mem_load(block, 24)
  if need > cap then
    let new_cap = cap * 2
    if new_cap < need then
      let new_cap = need
    end
    let old = mem_load(block, 32)
    let buf = rt_alloc(new_cap)
    rt_copy_bytes(buf + 16, old + 16, mem_load(block, 16))
    rt_free(old)
    mem_store(block, 32, buf)
    mem_store(block, 24, new_cap)
  end
  let r = 0
  ensure (r == 0) and (mem_load(block, 24) >= need)
  return r
end

# Grows in place: the bytes stays the same bytes.
make a function called bytes_push takes b, v returns r
  require (value_class(b) == 18) and (value_class(v) == 2) and (v >= 0) and (v <= 255)
  let block = value_data(b)
  let e = (mem_load(runtime_state(), 4608) != 0) and rt_cell_write(block + 40)
  let n = mem_load(block, 16)
  # grown only when full: a call on every push made it 165 cycles, 145 without
  if n >= mem_load(block, 24) then
    rt_bytes_reserve(block, n + 1)
  end
  mem_store_byte(mem_load(block, 32), 16 + n, v)
  mem_store(block, 16, n + 1)
  if e then
    rt_cell_write_end(block + 40, e)
  end
  let r = b
  ensure (value_class(r) == 18) and (bytes_len(r) == n + 1)
  return r
end

# Appends another bytes, copied whole, or a list of ints from 0 to 255.
make a function called bytes_extend takes b, more returns r
  require (value_class(b) == 18) and ((value_class(more) == 18) or (value_class(more) == 9))
  let block = value_data(b)
  let n = mem_load(block, 16)
  if value_class(more) == 18 then
    let m = bytes_len(more)
    let e = rt_cell_write(block + 40)
    rt_bytes_reserve(block, n + m)
    # read after reserving: more may be b itself, its buffer just moved
    rt_copy_bytes(mem_load(block, 32) + 16 + n, rt_bytes_addr(more), m)
    mem_store(block, 16, n + m)
    rt_cell_write_end(block + 40, e)
  else
    let m = list_len(more)
    let e = rt_cell_write(block + 40)
    rt_bytes_reserve(block, n + m)
    let buf = mem_load(block, 32)
    let k = 0
    while k < m do
      let v = more[k]
      if (value_class(v) != 2) or (v < 0) or (v > 255) then
        rt_cell_write_end(block + 40, e)
        print("bytes_extend: " + to_s(v) + " is not a byte, an int from 0 to 255")
        rt_stop(70)
      end
      mem_store_byte(buf, 16 + n + k, v)
      let k = k + 1
    end
    mem_store(block, 16, n + m)
    rt_cell_write_end(block + 40, e)
  end
  let r = b
  ensure value_class(r) == 18
  return r
end

# A new bytes holding n bytes of b from start.
make a function called bytes_slice takes b, start, n returns s
  require (value_class(b) == 18) and (value_class(start) == 2) and (value_class(n) == 2) and (start >= 0) and (n >= 0) and (start + n <= bytes_len(b))
  let s = bytes_new(n)
  rt_copy_bytes(rt_bytes_addr(s), rt_bytes_addr(b) + start, n)
  ensure (value_class(s) == 18) and (bytes_len(s) == n)
  return s
end

# Whether two bytes hold the same bytes (== asks whether they are the same
# bytes, as for a vec).
make a function called bytes_eq takes a, b returns yes
  require (value_class(a) == 18) and (value_class(b) == 18)
  let n = bytes_len(a)
  if n != bytes_len(b) then
    let yes = false
    ensure value_class(yes) == 1
    return yes
  end
  let pa = rt_bytes_addr(a)
  let pb = rt_bytes_addr(b)
  let k = 0
  while k < n do
    if mem_load_byte(pa, k) != mem_load_byte(pb, k) then
      let yes = false
      ensure value_class(yes) == 1
      return yes
    end
    let k = k + 1
  end
  let yes = true
  ensure value_class(yes) == 1
  return yes
end

make a function called bytes_from_list takes items returns b
  require value_class(items) == 9
  let b = bytes_new(0)
  bytes_extend(b, items)
  ensure (value_class(b) == 18) and (bytes_len(b) == list_len(items))
  return b
end

make a function called bytes_to_list takes b returns items
  require value_class(b) == 18
  let n = bytes_len(b)
  let items = rt_list_alloc(n)
  let p = rt_bytes_addr(b)
  let k = 0
  while k < n do
    let items = list_set(items, k, mem_load_byte(p, k))
    let k = k + 1
  end
  ensure (value_class(items) == 9) and (list_len(items) == n)
  return items
end

# A string's UTF-8 bytes.
make a function called bytes_from_str takes s returns b
  require value_class(s) == 8
  let n = str_len(s)
  let b = bytes_new(n)
  rt_copy_bytes(rt_bytes_addr(b), rt_str_bytes(s), n)
  ensure (value_class(b) == 18) and (bytes_len(b) == n)
  return b
end

# The string whose UTF-8 bytes these are; a malformed sequence reads as U+FFFD
# (spec 1.10).
make a function called bytes_to_str takes b returns s
  require value_class(b) == 18
  let s = rt_str_from_bytes(rt_bytes_addr(b), bytes_len(b))
  ensure (value_class(s) == 8) and (str_len(s) == bytes_len(b))
  return s
end
