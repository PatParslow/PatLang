# v2 runtime: closures (class 10). A block holding the lifted function's
# code address at 16, the number of captured values at 24, the number of
# parameters it takes at 32, 1 at 40 when its last parameter is named rest,
# and the captured values from 48 (x64.patlang, xv_closure and xv_callv).
quiet_operators()

make a function called rt_closure_heap_type returns t
  let t = 4294967306
  ensure (word_and(t, 4294967295) == 10) and (word_and(t, 4294967296) != 0)
  return t
end

make a function called rt_closure_alloc takes n returns c
  require (value_class(n) == 2) and (n >= 0)
  let block = rt_alloc(32 + 16 * n)
  mem_store(block, 16, 0)
  mem_store(block, 24, n)
  mem_store(block, 32, 0)
  mem_store(block, 40, 0)
  let k = 0
  while k < n do
    mem_store(block, 48 + 16 * k, 0)
    mem_store(block, 56 + 16 * k, 0)
    let k = k + 1
  end
  let c = value_make(rt_closure_heap_type(), block)
  ensure (value_class(c) == 10) and (mem_load(value_data(c), 24) == n)
  return c
end

# Releases a freed closure's captured values (rt_finalize).
make a function called rt_closure_release_captures takes block returns r
  require mem_load(block, 0) == 0
  let n = mem_load(block, 24)
  let k = 0
  while k < n do
    rt_release_value_at(block, 48 + 16 * k)
    let k = k + 1
  end
  let r = 0
  ensure r == 0
  return r
end

# A call of closure f that it does not take as it stands, made by xv_callv
# with the same arguments: its count differs from the call's, or its last
# parameter is named rest. The arguments are fitted as a call naming a
# function fits them (rt_closure_fit), so a call through a variable, apply,
# send, parallel_map and a thread's start all agree (spec 1.13); a closure
# call has at most 8 arguments (lw_call).
make a function called rt_closure_call_0 takes f returns r
  require value_class(f) == 10
  let r = rt_apply_unchecked(f, rt_closure_fit(f, rt_list_alloc(0), "a closure"))
  ensure value_live(r)
  return r
end

make a function called rt_closure_call_1 takes f, a returns r
  require value_class(f) == 10
  let r = rt_apply_unchecked(f, rt_closure_fit(f, [a], "a closure"))
  ensure value_live(r)
  return r
end

make a function called rt_closure_call_2 takes f, a, b returns r
  require value_class(f) == 10
  let r = rt_apply_unchecked(f, rt_closure_fit(f, [a, b], "a closure"))
  ensure value_live(r)
  return r
end

make a function called rt_closure_call_3 takes f, a, b, c returns r
  require value_class(f) == 10
  let r = rt_apply_unchecked(f, rt_closure_fit(f, [a, b, c], "a closure"))
  ensure value_live(r)
  return r
end

make a function called rt_closure_call_4 takes f, a, b, c, d returns r
  require value_class(f) == 10
  let r = rt_apply_unchecked(f, rt_closure_fit(f, [a, b, c, d], "a closure"))
  ensure value_live(r)
  return r
end

make a function called rt_closure_call_5 takes f, a, b, c, d, e returns r
  require value_class(f) == 10
  let r = rt_apply_unchecked(f, rt_closure_fit(f, [a, b, c, d, e], "a closure"))
  ensure value_live(r)
  return r
