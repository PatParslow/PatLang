make a function called rt_closure_call_8 takes f, a, b, c, d, e, g, h, j returns r
  require value_class(f) == 10
  let r = rt_apply_unchecked(f, rt_closure_fit(f, [a, b, c, d, e, g, h, j], "a closure"))
  ensure value_live(r)
  return r
end

# Stops the program: what was called with given arguments where it takes
# wanted (as rt_contract_failed stops it).
make a function called rt_closure_refuse takes what, wanted, given returns r
  require (value_class(what) == 8) and (value_class(wanted) == 8) and (value_class(given) == 2)
  print("contract violation: precondition failed in " + what + ": it takes " + wanted + ", given " + given)
  rt_stop(3)
  let r = 0
  ensure false
  return r
end

# "1 argument" or "n arguments".
make a function called rt_count_text takes n returns text
  require (value_class(n) == 2) and (n >= 0)
  let text = n + " arguments"
  if n == 1 then
    let text = "1 argument"
  end
  ensure value_class(text) == 8
  return text
end

# args fitted to closure f as a call naming a function fits them (spec 1.13):
# exactly as many as it has parameters or, when its last is named rest, those
# before it and a list of any further ones. Another number stops the program
# as a failed precondition of what (the function's name, or "a closure").
make a function called rt_closure_fit takes f, args, what returns fitted
  require (value_class(f) == 10) and (value_class(args) == 9) and (value_class(what) == 8)
  let want = mem_load(value_data(f), 32)
  let n = list_len(args)
  if mem_load(value_data(f), 40) == 0 then
    if n != want then
      rt_closure_refuse(what, rt_count_text(want), n)
    end
    let fitted = args
    ensure list_len(fitted) == want
    return fitted
  end
  if n < want - 1 then
    rt_closure_refuse(what, "at least " + rt_count_text(want - 1), n)
  end
  let fitted = rt_list_alloc(0)
  let rest = rt_list_alloc(0)
  let k = 0
  while k < n do
    if k < want - 1 then
      let fitted = list_push(fitted, args[k])
    else
      let rest = list_push(rest, args[k])
    end
    let k = k + 1
  end
  let fitted = list_push(fitted, rest)
  ensure list_len(fitted) == want
  return fitted
end
