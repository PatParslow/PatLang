# v2 runtime: closures (class 10). A block holding the lifted function's
# code address at 16, the number of captured values at 24, and the
# captured values from 32 (x64.patlang, xv_closure and xv_callv).
quiet_operators()

make a function called rt_closure_heap_type returns t
  let t = 4294967306
  ensure (word_and(t, 4294967295) == 10) and (word_and(t, 4294967296) != 0)
  return t
end

make a function called rt_closure_alloc takes n returns c
  require (value_class(n) == 2) and (n >= 0)
  let block = rt_alloc(16 + 16 * n)
  mem_store(block, 16, 0)
  mem_store(block, 24, n)
  let k = 0
  while k < n do
    mem_store(block, 32 + 16 * k, 0)
    mem_store(block, 40 + 16 * k, 0)
    let k = k + 1
  end
  let c = value_make(rt_closure_heap_type(), block)
  ensure (value_class(c) == 10) and (mem_load(value_data(c), 24) == n)
  return c
end

# Releases a freed closure's captured values (rt_finalize).
make a function called rt_closure_release_captures takes block returns r
  require mem_load(block, 0) == 0
  let n = mem_load(block, 24)
  let k = 0
  while k < n do
    rt_release_value_at(block, 32 + 16 * k)
    let k = k + 1
  end
  let r = 0
  ensure r == 0
  return r
end
