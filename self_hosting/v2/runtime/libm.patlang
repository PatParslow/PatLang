    let fn = fn + 1.0
    let r = x - fn * 1.57079632673412561417e+00
    let w = fn * 6.07710050650619224932e-11
  end
  let y0 = r - w
  let ey = word_and(word_shr(rt_float_bits_of(y0), 52), 2047)
  let ex = word_shr(ix, 20)
  if ex - ey > 16 then
    let t = r
    let w = fn * 6.07710050630396597660e-11
    let r = t - w
    let w = fn * 2.02226624879595063154e-21 - ((t - r) - w)
    let y0 = r - w
    let ey = word_and(word_shr(rt_float_bits_of(y0), 52), 2047)
    if ex - ey > 49 then
      let t = r
      let w = fn * 2.02226624871116645580e-21
      let r = t - w
      let w = fn * 8.47842766036889956997e-32 - ((t - r) - w)
      let y0 = r - w
    end
  end
  let y1 = (r - y0) - w
  return [n, y0, y1]
end

# [n, y0, y1]: x - n * pi/2 = y0 + y1, |y0 + y1| at most about pi/4.
make a function called rt_m_rem_pio2 takes x returns result
  let bits = rt_float_bits_of(x)
  let negative = bits < 0
  let ix = word_and(rt_m_hi(x), 2147483647)
  if ix <= 1074752122 then
    if word_and(ix, 1048575) == 598523 then
      return rt_m_rem_pio2_medium(x, ix)
    end
    if ix <= 1073928572 then
      if not negative then
        let z = x - 1.57079632673412561417e+00
        let y0 = z - 6.07710050650619224932e-11
        return [1, y0, (z - y0) - 6.07710050650619224932e-11]
      end
      let z = x + 1.57079632673412561417e+00
      let y0 = z + 6.07710050650619224932e-11
      return [-1, y0, (z - y0) + 6.07710050650619224932e-11]
    end
    if not negative then
      let z = x - 2.0 * 1.57079632673412561417e+00
      let y0 = z - 2.0 * 6.07710050650619224932e-11
      return [2, y0, (z - y0) - 2.0 * 6.07710050650619224932e-11]
    end
    let z = x + 2.0 * 1.57079632673412561417e+00
    let y0 = z + 2.0 * 6.07710050650619224932e-11
    return [-2, y0, (z - y0) + 2.0 * 6.07710050650619224932e-11]
  end
  if ix <= 1075594811 then
    if ix <= 1075183036 then
      if ix == 1074977148 then
        return rt_m_rem_pio2_medium(x, ix)
      end
      if not negative then
        let z = x - 3.0 * 1.57079632673412561417e+00
        let y0 = z - 3.0 * 6.07710050650619224932e-11
        return [3, y0, (z - y0) - 3.0 * 6.07710050650619224932e-11]
      end
      let z = x + 3.0 * 1.57079632673412561417e+00
      let y0 = z + 3.0 * 6.07710050650619224932e-11
      return [-3, y0, (z - y0) + 3.0 * 6.07710050650619224932e-11]
    end
    if ix == 1075388923 then
      return rt_m_rem_pio2_medium(x, ix)
    end
    if not negative then
      let z = x - 4.0 * 1.57079632673412561417e+00
      let y0 = z - 4.0 * 6.07710050650619224932e-11
      return [4, y0, (z - y0) - 4.0 * 6.07710050650619224932e-11]
    end
    let z = x + 4.0 * 1.57079632673412561417e+00
    let y0 = z + 4.0 * 6.07710050650619224932e-11
    return [-4, y0, (z - y0) + 4.0 * 6.07710050650619224932e-11]
  end
  if ix < 1094263291 then
    return rt_m_rem_pio2_medium(x, ix)
  end
  if ix >= 2146435072 then
    return [0, x - x, x - x]
  end
  # z = |x| scaled to [2^23, 2^24), cut into three 24-bit pieces
  let z = rt_float(word_or(word_and(bits, word_shr(-1, 12)), word_shl(1023 + 23, 52)))
  let tx = vec_new()
  let i = 0
  while i < 2 do
    let piece = rt_m_float(rt_m_toint(z))
    vec_push(tx, piece)
    let z = (z - piece) * 16777216.0
    let i = i + 1
  end
  vec_push(tx, z)
  while vec_get(tx, i) == 0.0 do
    let i = i - 1
  end
  let big = rt_m_rem_pio2_large(tx, word_shr(ix, 20) - (1023 + 23), i + 1)
  if negative then
    return [0 - big[0], rt_m_neg(big[1]), rt_m_neg(big[2])]
  end
  return big
end

# ---- sin, cos, tan ----

make a function called rt_m_sin takes x returns r
  let ix = word_and(rt_m_hi(x), 2147483647)
  if ix <= 1072243195 then
    if ix < 1045430272 then
      return x
    end
    return rt_m_ksin(x, 0.0, 0)
  end
  if ix >= 2146435072 then
    return x - x
  end
  let red = rt_m_rem_pio2(x)
  let q = word_and(red[0], 3)
  if q == 0 then
    return rt_m_ksin(red[1], red[2], 1)
  elif q == 1 then
    return rt_m_kcos(red[1], red[2])
  elif q == 2 then
    return rt_m_neg(rt_m_ksin(red[1], red[2], 1))
  end
  return rt_m_neg(rt_m_kcos(red[1], red[2]))
end

make a function called rt_m_cos takes x returns r
  let ix = word_and(rt_m_hi(x), 2147483647)
  if ix <= 1072243195 then
    if ix < 1044816030 then
      return 1.0
    end
    return rt_m_kcos(x, 0.0)
  end
  if ix >= 2146435072 then
    return x - x
  end
  let red = rt_m_rem_pio2(x)
  let q = word_and(red[0], 3)
  if q == 0 then
    return rt_m_kcos(red[1], red[2])
  elif q == 1 then
    return rt_m_neg(rt_m_ksin(red[1], red[2], 1))
  elif q == 2 then
    return rt_m_neg(rt_m_kcos(red[1], red[2]))
  end
  return rt_m_ksin(red[1], red[2], 1)
end

make a function called rt_m_tan takes x returns r
  let ix = word_and(rt_m_hi(x), 2147483647)
  if ix <= 1072243195 then
    if ix < 1044381696 then
      return x
    end
    return rt_m_ktan(x, 0.0, 0)
  end
  if ix >= 2146435072 then
    return x - x
  end
  let red = rt_m_rem_pio2(x)
  return rt_m_ktan(red[1], red[2], word_and(red[0], 1))
end

# ---- asin, acos, atan, atan2 ----

make a function called rt_m_asin_r takes z returns r
  let p = z * (1.66666666666666657415e-01 + z * (-3.25565818622400915405e-01 + z * (2.01212532134862925881e-01 + z * (-4.00555345006794114027e-02 + z * (7.91534994289814532176e-04 + z * 3.47933107596021167570e-05)))))
  let q = 1.0 + z * (-2.40339491173441421878e+00 + z * (2.02094576023350569471e+00 + z * (-6.88283971605453293030e-01 + z * 7.70381505559019352791e-02)))
  return p / q
end

make a function called rt_m_asin takes x0 returns r
  let x = x0
  let hx = rt_m_hi(x)
  let ix = word_and(hx, 2147483647)
  if ix >= 1072693248 then
    if word_or(ix - 1072693248, rt_m_lo(x)) == 0 then
      return x * 1.57079632679489655800e+00
    end
    return 0.0 / (x - x)
  end
  if ix < 1071644672 then
    if (ix < 1045430272) and (ix >= 1048576) then
      return x
    end
    return x + x * rt_m_asin_r(x * x)
  end
  let z = (1.0 - rt_m_fabs(x)) * 0.5
  let s = rt_m_sqrt(z)
  let r = rt_m_asin_r(z)
  if ix >= 1072640819 then
    let x = 1.57079632679489655800e+00 - (2.0 * (s + s * r) - 6.12323399573676603587e-17)
  else
    let f = rt_m_set_lo(s, 0)
    let c = (z - f * f) / (s + f)
    let x = 0.5 * 1.57079632679489655800e+00 - (2.0 * s * r - (6.12323399573676603587e-17 - 2.0 * c) - (0.5 * 1.57079632679489655800e+00 - 2.0 * f))
  end
  if word_shr(hx, 31) == 1 then
    return rt_m_neg(x)
  end
  return x
end

make a function called rt_m_acos takes x returns r
  let hx = rt_m_hi(x)
  let ix = word_and(hx, 2147483647)
  if ix >= 1072693248 then
    if word_or(ix - 1072693248, rt_m_lo(x)) == 0 then
      if word_shr(hx, 31) == 1 then
        return 2.0 * 1.57079632679489655800e+00
      end
      return 0.0
    end
    return 0.0 / (x - x)
  end
  if ix < 1071644672 then
    if ix <= 1012924416 then
      return 1.57079632679489655800e+00
    end
    return 1.57079632679489655800e+00 - (x - (6.12323399573676603587e-17 - x * rt_m_asin_r(x * x)))
  end
  if word_shr(hx, 31) == 1 then
    let z = (1.0 + x) * 0.5
    let s = rt_m_sqrt(z)
    let w = rt_m_asin_r(z) * s - 6.12323399573676603587e-17
    return 2.0 * (1.57079632679489655800e+00 - (s + w))
  end
  let z = (1.0 - x) * 0.5
  let s = rt_m_sqrt(z)
  let df = rt_m_set_lo(s, 0)
  let c = (z - df * df) / (s + df)
  let w = rt_m_asin_r(z) * s + c
  return 2.0 * (df + w)
end

make a function called rt_m_atan takes x0 returns r
  let x = x0
  let hx = rt_m_hi(x)
  let negative = word_shr(hx, 31) == 1
  let ix = word_and(hx, 2147483647)
  if ix >= 1141899264 then
    if x != x then
      return x
    end
    if negative then
      return -1.57079632679489655800e+00
    end
    return 1.57079632679489655800e+00
  end
  let id = -1
  if ix < 1071382528 then
    if ix < 1044381696 then
      return x
    end
  else
    let x = rt_m_fabs(x)
    if ix < 1072889856 then
      if ix < 1072037888 then
        let id = 0
        let x = (2.0 * x - 1.0) / (2.0 + x)
      else
        let id = 1
        let x = (x - 1.0) / (x + 1.0)
      end
    elif ix < 1073971200 then
      let id = 2
      let x = (x - 1.5) / (1.0 + 1.5 * x)
    else
      let id = 3
      let x = -1.0 / x
    end
  end
  let z = x * x
  let w = z * z
  let s1 = z * (3.33333333333329318027e-01 + w * (1.42857142725034663711e-01 + w * (9.09088713343650656196e-02 + w * (6.66107313738753120669e-02 + w * (4.97687799461593236017e-02 + w * 1.62858201153657823623e-02)))))
  let s2 = w * (-1.99999999998764832476e-01 + w * (-1.11111104054623557880e-01 + w * (-7.69187620504482999495e-02 + w * (-5.83357013379057348645e-02 + w * -3.65315727442169155270e-02))))
  if id < 0 then
    return x - x * (s1 + s2)
  end
  let hi = [4.63647609000806093515e-01, 7.85398163397448278999e-01, 9.82793723247329054082e-01, 1.57079632679489655800e+00]
  let lo = [2.26987774529616870924e-17, 3.06161699786838301793e-17, 1.39033110312309984516e-17, 6.12323399573676603587e-17]
  let z = hi[id] - (x * (s1 + s2) - lo[id] - x)
  if negative then
    return rt_m_neg(z)
  end
  return z
end

make a function called rt_m_atan2 takes y, x returns r
  let pi = 3.1415926535897931160E+00
  let pi_lo = 1.2246467991473531772E-16
  if (x != x) or (y != y) then
    return x + y
  end
  let ix = rt_m_hi(x)
  let lx = rt_m_lo(x)
  let iy = rt_m_hi(y)
  let ly = rt_m_lo(y)
  if (ix == 1072693248) and (lx == 0) then
    return rt_m_atan(y)
  end
  let m = word_or(word_and(word_shr(iy, 31), 1), word_and(word_shr(ix, 30), 2))
  let ix = word_and(ix, 2147483647)
  let iy = word_and(iy, 2147483647)
  if word_or(iy, ly) == 0 then
    if m <= 1 then
      return y
    elif m == 2 then
      return pi
    end
    return rt_m_neg(pi)
  end
  if word_or(ix, lx) == 0 then
    if word_and(m, 1) == 1 then
      return rt_m_neg(pi / 2.0)
    end
    return pi / 2.0
  end
  if ix == 2146435072 then
    if iy == 2146435072 then
      if m == 0 then
        return pi / 4.0
      elif m == 1 then
        return rt_m_neg(pi / 4.0)
      elif m == 2 then
        return 3.0 * pi / 4.0
      end
      return rt_m_neg(3.0 * pi / 4.0)
    end
    if m == 0 then
      return 0.0
    elif m == 1 then
      return rt_m_neg(0.0)
    elif m == 2 then
      return pi
    end
    return rt_m_neg(pi)
  end
  if (ix + 67108864 < iy) or (iy == 2146435072) then
    if word_and(m, 1) == 1 then
      return rt_m_neg(pi / 2.0)
    end
    return pi / 2.0
  end
  if (word_and(m, 2) == 2) and (iy + 67108864 < ix) then
    let z = 0.0
  else
    let z = rt_m_atan(rt_m_fabs(y / x))
  end
  if m == 0 then
    return z
  elif m == 1 then
    return rt_m_neg(z)
  elif m == 2 then
    return pi - (z - pi_lo)
  end
  return (z - pi_lo) - pi
end
