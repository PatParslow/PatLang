# v2 runtime: the math library, in PatLang (docs/spec/values-and-memory.md 1.3).
#
# sin, cos, tan, asin, acos, atan, atan2, exp, log, pow, fmod, sqrt, floor,
# ceil, trunc and round, written here so that every target (Windows, Linux, a
# browser) computes the same bits: the algorithms are musl's, from Sun's
# fdlibm (Copyright (C) 1993 by Sun Microsystems, Inc.; permission to use,
# copy, modify and distribute this software is freely granted, provided that
# this notice is preserved), each within one unit in the last place; sqrt,
# floor, ceil, trunc, round and fmod are exact. A double's words are read and
# made with rt_m_hi, rt_m_lo and rt_m_words; every value here is a float.
# self_hosting/libm_selftest.patlang checks them against correctly rounded
# results, and libm_targets_selftest.patlang that native and WebAssembly agree.
quiet_operators()

# ---- a double's words ----

make a function called rt_m_hi takes x returns hi
  let hi = word_and(word_shr(rt_float_bits_of(x), 32), 4294967295)
  return hi
end

make a function called rt_m_lo takes x returns lo
  let lo = word_and(rt_float_bits_of(x), 4294967295)
  return lo
end

make a function called rt_m_words takes hi, lo returns x
  let x = rt_float(word_or(word_shl(word_and(hi, 4294967295), 32), word_and(lo, 4294967295)))
  return x
end

make a function called rt_m_set_lo takes x, lo returns y
  return rt_m_words(rt_m_hi(x), lo)
end

make a function called rt_m_set_hi takes x, hi returns y
  return rt_m_words(hi, rt_m_lo(x))
end

# A high word as fdlibm's signed int32 reads it.
make a function called rt_m_signed takes w returns s
  if w >= 2147483648 then
    return w - 4294967296
  end
  return w
end

make a function called rt_m_neg takes x returns y
  return rt_float(word_xor(rt_float_bits_of(x), word_shl(1, 63)))
end

make a function called rt_m_fabs takes x returns y
  return rt_float(word_and(rt_float_bits_of(x), 9223372036854775807))
end

# A float's integer part as an int (C's cast: toward zero).
make a function called rt_m_toint takes x returns n
  return float_to_int(rt_float_bits_of(x))
end

make a function called rt_m_float takes n returns x
  return rt_float(int_to_float(n))
end

make a function called rt_m_scalbn takes x, n0 returns r
  let y = x
  let n = n0
  if n > 1023 then
    let y = y * 8.98846567431158e307
    let n = n - 1023
    if n > 1023 then
      let y = y * 8.98846567431158e307
      let n = n - 1023
      if n > 1023 then
        let n = 1023
      end
    end
  elif n < -1022 then
    # 0x1p-1022 * 0x1p53
    let y = y * 2.004168360008973e-292
    let n = n + 969
    if n < -1022 then
      let y = y * 2.004168360008973e-292
      let n = n + 969
      if n < -1022 then
        let n = -1022
      end
    end
  end
  return y * rt_float(word_shl(1023 + n, 52))
end

# ---- exact: floor, ceil, trunc, round, sqrt, fmod ----

make a function called rt_m_floor takes x returns r
  let bits = rt_float_bits_of(x)
  let e = word_and(word_shr(bits, 52), 2047)
  if (e >= 1023 + 52) or (x == 0.0) then
    return x
  end
  let negative = bits < 0
  if negative then
    let y = x - 4503599627370496.0 + 4503599627370496.0 - x
  else
    let y = x + 4503599627370496.0 - 4503599627370496.0 - x
  end
  if e <= 1023 - 1 then
    if negative then
      return -1.0
    end
    return 0.0
  end
  if y > 0.0 then
    return x + y - 1.0
  end
  return x + y
end

make a function called rt_m_ceil takes x returns r
  let bits = rt_float_bits_of(x)
  let e = word_and(word_shr(bits, 52), 2047)
  if (e >= 1023 + 52) or (x == 0.0) then
    return x
  end
  let negative = bits < 0
  if negative then
    let y = x - 4503599627370496.0 + 4503599627370496.0 - x
  else
    let y = x + 4503599627370496.0 - 4503599627370496.0 - x
  end
  if e <= 1023 - 1 then
    if negative then
      return rt_m_neg(0.0)
    end
    return 1.0
  end
  if y < 0.0 then
    return x + y + 1.0
  end
  return x + y
end

make a function called rt_m_trunc takes x returns r
  let bits = rt_float_bits_of(x)
  let e = word_and(word_shr(bits, 52), 2047) - 1023 + 12
  if e >= 52 + 12 then
    return x
  end
  if e < 12 then
    let e = 1
  end
  let m = word_shr(-1, e)
  if word_and(bits, m) == 0 then
    return x
  end
  return rt_float(word_and(bits, word_xor(m, -1)))
end

# Half away from zero, as C's round.
make a function called rt_m_round takes x0 returns r
  let bits = rt_float_bits_of(x0)
  let e = word_and(word_shr(bits, 52), 2047)
  if e >= 1023 + 52 then
    return x0
  end
  let negative = bits < 0
  let x = x0
  if negative then
    let x = rt_m_neg(x0)
  end
  if e < 1023 - 1 then
    return 0.0 * x0
  end
  let y = x + 4503599627370496.0 - 4503599627370496.0 - x
  if y > 0.5 then
    let y = y + x - 1.0
  elif y <= -0.5 then
    let y = y + x + 1.0
  else
    let y = y + x
  end
  if negative then
    return rt_m_neg(y)
  end
  return y
end

# fdlibm's bit-by-bit square root: correctly rounded.
make a function called rt_m_sqrt takes x returns r
  let sign = 2147483648
  let ix0 = rt_m_signed(rt_m_hi(x))
  let ix1 = rt_m_lo(x)
  if word_and(ix0, 2146435072) == 2146435072 then
    return x * x + x
  end
  if ix0 <= 0 then
    if word_or(word_and(ix0, 2147483647), ix1) == 0 then
      return x
    end
    if ix0 < 0 then
      return (x - x) / (x - x)
    end
  end
  let m = word_shr(ix0, 20)
  if m == 0 then
    while ix0 == 0 do
      let m = m - 21
      let ix0 = word_or(ix0, word_shr(ix1, 11))
      let ix1 = word_and(word_shl(ix1, 21), 4294967295)
    end
    let i = 0
    while word_and(ix0, 1048576) == 0 do
      let ix0 = word_shl(ix0, 1)
      let i = i + 1
    end
    let m = m - (i - 1)
    if i > 0 then
      let ix0 = word_or(ix0, word_shr(ix1, 32 - i))
      let ix1 = word_and(word_shl(ix1, i), 4294967295)
    end
  end
  let m = m - 1023
  let ix0 = word_or(word_and(ix0, 1048575), 1048576)
  if word_and(m, 1) == 1 then
    let ix0 = ix0 + ix0 + word_shr(word_and(ix1, sign), 31)
    let ix1 = word_and(ix1 + ix1, 4294967295)
  end
  # m >>= 1, arithmetic
  if m < 0 then
    let m = 0 - word_shr(1 - m, 1)
  else
    let m = word_shr(m, 1)
  end
  let ix0 = ix0 + ix0 + word_shr(word_and(ix1, sign), 31)
  let ix1 = word_and(ix1 + ix1, 4294967295)
  let q = 0
  let q1 = 0
  let s0 = 0
  let s1 = 0
  let r = 2097152
  while r != 0 do
    let t = s0 + r
    if t <= ix0 then
      let s0 = t + r
      let ix0 = ix0 - t
      let q = q + r
    end
    let ix0 = ix0 + ix0 + word_shr(word_and(ix1, sign), 31)
    let ix1 = word_and(ix1 + ix1, 4294967295)
    let r = word_shr(r, 1)
  end
  let r = sign
  while r != 0 do
    let t1 = word_and(s1 + r, 4294967295)
    let t = s0
    if (t < ix0) or ((t == ix0) and (t1 <= ix1)) then
      let s1 = word_and(t1 + r, 4294967295)
      if (word_and(t1, sign) == sign) and (word_and(s1, sign) == 0) then
        let s0 = s0 + 1
      end
      let ix0 = ix0 - t
      if ix1 < t1 then
        let ix0 = ix0 - 1
      end
      let ix1 = word_and(ix1 - t1, 4294967295)
      let q1 = q1 + r
    end
    let ix0 = ix0 + ix0 + word_shr(word_and(ix1, sign), 31)
    let ix1 = word_and(ix1 + ix1, 4294967295)
    let r = word_shr(r, 1)
  end
  # round to nearest: the remainder is not zero, so the result is not exact
  if word_or(ix0, ix1) != 0 then
    if q1 == 4294967295 then
      let q1 = 0
      let q = q + 1
    else
      let q1 = q1 + word_and(q1, 1)
    end
  end
  let hi = word_shr(q, 1) + 1071644672
  let lo = word_shr(q1, 1)
  if word_and(q, 1) == 1 then
    let lo = word_or(lo, sign)
  end
  let hi = hi + m * 1048576
  return rt_m_words(hi, lo)
end

# Unsigned order of two 64-bit words.
make a function called rt_m_ult takes a, b returns yes
  let flip = word_shl(1, 63)
  return word_xor(a, flip) < word_xor(b, flip)
end

# C's fmod: x - n*y with n x/y toward zero, exactly.
make a function called rt_m_fmod takes x, y returns r
  let uxi = rt_float_bits_of(x)
  let uyi = rt_float_bits_of(y)
  let ex = word_and(word_shr(uxi, 52), 2047)
  let ey = word_and(word_shr(uyi, 52), 2047)
  let sx = word_shr(uxi, 63)
  if (word_shl(uyi, 1) == 0) or (y != y) or (ex == 2047) then
    return (x * y) / (x * y)
  end
  let ax = word_shl(uxi, 1)
  let ay = word_shl(uyi, 1)
  if not rt_m_ult(ay, ax) then
    if ax == ay then
      return 0.0 * x
    end
    return x
  end
  if ex == 0 then
    let i = word_shl(uxi, 12)
    while i >= 0 do
      let ex = ex - 1
      let i = word_shl(i, 1)
    end
    let uxi = word_shl(uxi, 1 - ex)
  else
    let uxi = word_or(word_and(uxi, word_shr(-1, 12)), word_shl(1, 52))
  end
  if ey == 0 then
    let i = word_shl(uyi, 12)
    while i >= 0 do
      let ey = ey - 1
      let i = word_shl(i, 1)
    end
    let uyi = word_shl(uyi, 1 - ey)
  else
    let uyi = word_or(word_and(uyi, word_shr(-1, 12)), word_shl(1, 52))
  end
  while ex > ey do
    let i = word_sub(uxi, uyi)
    if i >= 0 then
      if i == 0 then
        return 0.0 * x
      end
      let uxi = i
    end
    let uxi = word_shl(uxi, 1)
    let ex = ex - 1
  end
  let i = word_sub(uxi, uyi)
  if i >= 0 then
    if i == 0 then
      return 0.0 * x
    end
    let uxi = i
  end
  while word_shr(uxi, 52) == 0 do
    let uxi = word_shl(uxi, 1)
    let ex = ex - 1
  end
  if ex > 0 then
    let uxi = word_sub(uxi, word_shl(1, 52))
    let uxi = word_or(uxi, word_shl(ex, 52))
  else
    let uxi = word_shr(uxi, 1 - ex)
  end
  let uxi = word_or(uxi, word_shl(sx, 63))
  return rt_float(uxi)
end

# ---- exp and log ----

# exp is ARM's optimized-routines algorithm, as musl has it (MIT licence,
# Copyright (c) 2018 Arm Limited): x = k ln2/128 + r, exp(x) = 2^(k/128) exp(r),
# 2^(k/128) from a table and exp(r) from a short polynomial; under 0.52 ulp.
# The table is [T(k), H(k) - k * 2^45] for k in 0..127, where H(k) is 2^(k/128)
# rounded and 2^(k/128) = H(k) (1 + T(k)), each as its double's bits
# (tools/gen_libm_vectors.py's mpmath gives the same values).
make a function called rt_m_exp_table returns t
  return [0, 4607182418800017408, 4367149474599452526, 4607171688528556853, -4868004084858692515, 4607161091040444513, -4859280119576434991, 4607150627056680837, 4363093389540324883, 4607140297302181236, -4860564323061625094, 4607130102505797342, 4350749156061923425, 4607120043400338376, 4364168240100004761, 4607110120722592643, 4366128403083131757, 4607100335213349135, 4363624214708482044, 4607090687617419255, 4341116261916187857, 4607081178683658658, -4870076522866643445, 4607071809164989211, -4857881712154133234, 4607062579818421073, -4877256630102726059, 4607053491405074892, -4858881367677209578, 4607044544690204128, 4359717415120819631, 4607035740443217489, -4863857816615152824, 4607027079437701499, -4859630355816238531, 4607018562451443178, 4362731899485115327, 4607010190266452853, -4857455882053489882, 4607001963668987092, 4367063335334195040, 4606993883449571754, -4859410923963139939, 4606985950403025181, 4362421515177083789, 4606978165328481494, 4359618604155798653, 4606970529029414038, 4365834109879625876, 4606963042313658936, 4361558225371547773, 4606955705993438783, 4359562691856033778, 4606948520885386461, -4857492308587640738, 4606941487810569089, 4360319936817113905, 4606934607594512097, -4882709470952570886, 4606927881067223440, 4362641697437125300, 4606921309063217931, 4354440509323660175, 4606914892421541718, 4360414030434708406, 4606908631985796885, 4361245865020257356, 4606902528604166193, 4363949802402347082, 4606896583129437951, -4862018976549545212, 4606890796419031025, -4858738662784151448, 4606885169335019979, -4856841960950780530, 4606879702744160358, -4867878926798276910, 4606874397517914103, -4856823124960863467, 4606869254532475109, 4361066948569222253, 4606864274668794914, -4858519367427004022, 4606859458812608540, -4874962362796897957, 4606854807854460458, -4864964451502548453, 4606850322689730711, 4342424336897059857, 4606846004218661165, 4365789078613288175, 4606841853346381911, 4354643160121541497, 4606837870982937808, 4365113450260533808, 4606834058043315166, 4356828907110576048, 4606830415447468583, 4364865165386375287, 4606826944120347917, -4859502521842818162, 4606823644991925415, -4861672301267803319, 4606820518997222978, -4865894452217038753, 4606817567076339586, -4862178651875353354, 4606814790174478863, 4364890759862540174, 4606812189241976794, 4358244976955136773, 4606809765234329597, 4364097860734309385, 4606807519112221737, 4338311716453074666, 4606805451841554103, 4365169902980743221, 4606803564393472328, -4860258889723447649, 4606801857744395273, -4860452975632495192, 4606800332876043653, -4862669920490755666, 4606798990775468832, -4858312122400614312, 4606797832435081765, 4347962289735735652, 4606796858852682099, -4858341730713460184, 4606796071031487437, -4870059510540748414, 4606795469980162751, -4871936092595705362, 4606795056712849967, -4863645441585018799, 4606794832249197700, -4866104880896786737, 4606794797614391156, -4861936742874514000, 4606794953839182196, -4862171044651866486, 4606795301959919561, 4364160436192007379, 4606795843018579263, -4865239048860621539, 4606796578062795143, 4365374511615819883, 4606797508145889586, 4352143969406577749, 4606798634326904418, -4861457929465508030, 4606799957670631954, -4858423338550479052, 4606801479247646227, -4863783675556659426, 4606803200134334381, -4858024654332078226, 4606805121412928237, 4364178698342926848, 4606807244171536025, 4363345029737015988, 4606809569504174299, -4871286895867992065, 4606812098510800012, 4358348108421357380, 4606814832297342774, -4858529541450220157, 4606817771975737286, -4873552611666813399, 4606820918663955941, -4869477542650660519, 4606824273486041615, -4858747092350994006, 4606827837572140624, -4862257653857481141, 4606831612058535866, 4355455812241575463, 4606835598087680144, 4354367543587795899, 4606839796808229667, -4861700651175763357, 4606844209375077733, 4362612029712904661, 4606848836949388595, -4858896013081134315, 4606853680698631517, 4364212552380330450, 4606858741796615000, 4360726356711135923, 4606864021423521215, -4863078573502718540, 4606869520765940602, 4362891239881388935, 4606875241016906669, -4859248142566958598, 4606881183375930982, -4875775683326071110, 4606887349049038331, -4859203616861915584, 4606893739248802106, -4870406652589927628, 4606900355194379847, -4858839866725070283, 4606907198111549002, 4356388038631218637, 4606914269232742866, -4858893633017702228, 4606921569797086729, 4355946959017544883, 4606929101050434204, 4363674894410448276, 4606936864245403770, 4360857247493478828, 4606944860641415499, 4351547817417644647, 4606953091504727989, 4352565403421120872, 4606961558108475497, -4863735759665056302, 4606970261732705274, -4859474856892171665, 4606979203664415100, -4859368956010059447, 4606988385197591026, 4356286533989107623, 4606997807633245319, -4863164539274780145, 4607007472279454616, 4363524392198705836, 4607017380451398277, 4360674496013757259, 4607027533471396960, -4863090309766824417, 4607037932668951391, -4861307347717911095, 4607048579380781353, 4356306869484685523, 4607059474950864886, 4360546482996998769, 4607070620730477699, -4859393813814996496, 4607082018078232794, -4860036451210660739, 4607093668360120305, 4363640302291525640, 4607105572949547559, 4360658257139329842, 4607117733227379351, 4362409866909812206, 4607130150581978432, -4859885672053611539, 4607142826409246228, 4357102052301720989, 4607155762112663768, 4346824392926350473, 4607168959103332849]
end

# The engine's copy of exp's table, made once at start (runtime_init, before
# any thread) and only read after: its address is at runtime_state() 4704, its
# 256 words from 16 bytes into the block. Made as a list on each call, the
# table took exp to about 15200 cycles a call; read from here, about 530.
make a function called rt_m_init returns r
  let src = rt_m_exp_table()
  let table = rt_alloc(8 * 256)
  let k = 0
  while k < 256 do
    mem_store(table, 16 + 8 * k, src[k])
    let k = k + 1
  end
  mem_store(runtime_state(), 4704, table)
  let r = 0
  ensure r == 0
  return r
end

# exp's result when 2^k may leave the normal range: scaled into it, then out.
make a function called rt_m_exp_special takes tmp, sbits, ki returns r
  if word_and(ki, 2147483648) == 0 then
    let scale = rt_float(word_sub(sbits, word_shl(1009, 52)))
    return 5.486124068793689e+303 * (scale + scale * tmp)
  end
  let scale = rt_float(word_add(sbits, word_shl(1022, 52)))
  let y = scale + scale * tmp
  if y < 1.0 then
    # round to the subnormal precision before scaling, so it is rounded once
    let lo = scale - y + scale * tmp
    let hi = 1.0 + y
    let lo = 1.0 - hi + y + lo
    let y = (hi + lo) - 1.0
    if y == 0.0 then
      let y = 0.0
    end
  end
  return 2.2250738585072014e-308 * y
end

make a function called rt_m_exp takes x returns r
  let bits = rt_float_bits_of(x)
  let abstop = word_and(word_shr(bits, 52), 2047)
  let special = false
  if (abstop < 969) or (abstop >= 1032) then
    if abstop < 969 then
      # |x| < 2^-54
      return 1.0 + x
    end
    if abstop >= 1033 then
      # |x| >= 1024
      if bits == -4503599627370496 then
        return 0.0
      end
      if abstop >= 2047 then
        return 1.0 + x
      end
      if bits < 0 then
        return 0.0
      end
      return 1.0e300 * 1.0e300
    end
    let special = true
  end
  let z = 184.6649652337873 * x
  let kd = z + 6755399441055744.0
  let ki = rt_float_bits_of(kd)
  let kd = kd - 6755399441055744.0
  let rr = x + kd * -0.005415212348111709 + kd * -1.2864023111638346e-14
  let table = mem_load(runtime_state(), 4704)
  let idx = 2 * word_and(ki, 127)
  let tail = rt_float(mem_load(table, 16 + 8 * idx))
  let sbits = word_add(mem_load(table, 24 + 8 * idx), word_shl(ki, 45))
  let r2 = rr * rr
  let tmp = tail + rr + r2 * (0.49999999999996786 + rr * 0.16666666666665886) + r2 * r2 * (0.0416666808410674 + rr * 0.008333335853059549)
  if special then
    return rt_m_exp_special(tmp, sbits, ki)
  end
  let scale = rt_float(sbits)
  return scale + scale * tmp
end

make a function called rt_m_log takes x0 returns r
  let x = x0
  let hx = rt_m_signed(rt_m_hi(x))
  let lx = rt_m_lo(x)
  let k = 0
  if hx < 1048576 then
    if word_or(word_and(hx, 2147483647), lx) == 0 then
      return -1.80143985094819840000e+16 / 0.0
    end
    if hx < 0 then
      return (x - x) / 0.0
    end
    let k = k - 54
    let x = x * 1.80143985094819840000e+16
    let hx = rt_m_signed(rt_m_hi(x))
  end
  if hx >= 2146435072 then
    return x + x
  end
  let k = k + (word_shr(hx, 20) - 1023)
  let hx = word_and(hx, 1048575)
  let i = word_and(hx + 614244, 1048576)
  let x = rt_m_set_hi(x, word_or(hx, word_xor(i, 1072693248)))
  let k = k + word_shr(i, 20)
  let f = x - 1.0
  let dk = rt_m_float(k)
