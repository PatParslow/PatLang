make a function called rt_m_vec_zeros takes n returns v
  let v = vec_new()
  let i = 0
  while i < n do
    vec_push(v, 0.0)
    let i = i + 1
  end
  return v
end

# fdlibm's __kernel_rem_pio2 for doubles: x is the input in 24-bit pieces tx
# (nx of them), e0 its exponent; gives [n mod 8, y0, y1].
make a function called rt_m_rem_pio2_large takes tx, e0, nx returns result
  let ipio2 = rt_m_ipio2()
  let pio2 = rt_m_pio2_parts()
  let jk = 4
  let jp = jk
  let jx = nx - 1
  let jv = word_div(e0 - 3, 24)
  if e0 - 3 < 0 then
    let jv = 0
  end
  if jv < 0 then
    let jv = 0
  end
  let q0 = e0 - 24 * (jv + 1)
  let f = rt_m_vec_zeros(40)
  let q = rt_m_vec_zeros(40)
  let fq = rt_m_vec_zeros(40)
  let iq = vec_new()
  let i = 0
  while i < 40 do
    vec_push(iq, 0)
    let i = i + 1
  end
  let j = jv - jx
  let m = jx + jk
  let i = 0
  while i <= m do
    if j < 0 then
      vec_set(f, i, 0.0)
    else
      vec_set(f, i, rt_m_float(ipio2[j]))
    end
    let i = i + 1
    let j = j + 1
  end
  let i = 0
  while i <= jk do
    let fw = 0.0
    let jj = 0
    while jj <= jx do
      let fw = fw + vec_get(tx, jj) * vec_get(f, jx + i - jj)
      let jj = jj + 1
    end
    vec_set(q, i, fw)
    let i = i + 1
  end
  let jz = jk
  let again = true
  let n = 0
  let ih = 0
  let z = 0.0
  while again do
    let again = false
    # distill q[] into iq[] reversingly
    let i = 0
    let jj = jz
    let z = vec_get(q, jz)
    while jj > 0 do
      let fw = rt_m_float(rt_m_toint(5.9604644775390625e-08 * z))
      vec_set(iq, i, rt_m_toint(z - 16777216.0 * fw))
      let z = vec_get(q, jj - 1) + fw
      let i = i + 1
      let jj = jj - 1
    end
    let z = rt_m_scalbn(z, q0)
    let z = z - 8.0 * rt_m_floor(z * 0.125)
    let n = rt_m_toint(z)
    let z = z - rt_m_float(n)
    let ih = 0
    if q0 > 0 then
      let i = word_shr(vec_get(iq, jz - 1), 24 - q0)
      let n = n + i
      vec_set(iq, jz - 1, vec_get(iq, jz - 1) - word_shl(i, 24 - q0))
      let ih = word_shr(vec_get(iq, jz - 1), 23 - q0)
    elif q0 == 0 then
      let ih = word_shr(vec_get(iq, jz - 1), 23)
    elif z >= 0.5 then
      let ih = 2
    end
    if ih > 0 then
      let n = n + 1
      let carry = 0
      let i = 0
      while i < jz do
        let jj = vec_get(iq, i)
        if carry == 0 then
          if jj != 0 then
            let carry = 1
            vec_set(iq, i, 16777216 - jj)
          end
        else
          vec_set(iq, i, 16777215 - jj)
        end
        let i = i + 1
      end
      if q0 == 1 then
        vec_set(iq, jz - 1, word_and(vec_get(iq, jz - 1), 8388607))
      elif q0 == 2 then
        vec_set(iq, jz - 1, word_and(vec_get(iq, jz - 1), 4194303))
      end
      if ih == 2 then
        let z = 1.0 - z
        if carry != 0 then
          let z = z - rt_m_scalbn(1.0, q0)
        end
      end
    end
    if z == 0.0 then
      let jj = 0
      let i = jz - 1
      while i >= jk do
        let jj = word_or(jj, vec_get(iq, i))
        let i = i - 1
      end
      if jj == 0 then
        let k = 1
        while vec_get(iq, jk - k) == 0 do
          let k = k + 1
        end
        let i = jz + 1
        while i <= jz + k do
          vec_set(f, jx + i, rt_m_float(ipio2[jv + i]))
          let fw = 0.0
          let jj = 0
          while jj <= jx do
            let fw = fw + vec_get(tx, jj) * vec_get(f, jx + i - jj)
            let jj = jj + 1
          end
          vec_set(q, i, fw)
          let i = i + 1
        end
        let jz = jz + k
        let again = true
      end
    end
  end
  if z == 0.0 then
    let jz = jz - 1
    let q0 = q0 - 24
    while vec_get(iq, jz) == 0 do
      let jz = jz - 1
      let q0 = q0 - 24
    end
  else
    let z = rt_m_scalbn(z, 0 - q0)
    if z >= 16777216.0 then
      let fw = rt_m_float(rt_m_toint(5.9604644775390625e-08 * z))
      vec_set(iq, jz, rt_m_toint(z - 16777216.0 * fw))
      let jz = jz + 1
      let q0 = q0 + 24
      vec_set(iq, jz, rt_m_toint(fw))
    else
      vec_set(iq, jz, rt_m_toint(z))
    end
  end
  let fw = rt_m_scalbn(1.0, q0)
  let i = jz
  while i >= 0 do
    vec_set(q, i, fw * rt_m_float(vec_get(iq, i)))
    let fw = fw * 5.9604644775390625e-08
    let i = i - 1
  end
  let i = jz
  while i >= 0 do
    let fw = 0.0
    let k = 0
    while (k <= jp) and (k <= jz - i) do
      let fw = fw + pio2[k] * vec_get(q, i + k)
      let k = k + 1
    end
    vec_set(fq, jz - i, fw)
    let i = i - 1
  end
  let fw = 0.0
  let i = jz
  while i >= 0 do
    let fw = fw + vec_get(fq, i)
    let i = i - 1
  end
  let y0 = fw
  if ih != 0 then
    let y0 = rt_m_neg(fw)
  end
  let fw = vec_get(fq, 0) - fw
  let i = 1
  while i <= jz do
    let fw = fw + vec_get(fq, i)
    let i = i + 1
  end
  let y1 = fw
  if ih != 0 then
    let y1 = rt_m_neg(fw)
  end
  return [word_and(n, 7), y0, y1]
end

