# ---- the trigonometric kernels, on [-pi/4, pi/4] ----

make a function called rt_m_ksin takes x, y, iy returns r
  let z = x * x
  let w = z * z
  let rr = 8.33333333332248946124e-03 + z * (-1.98412698298579493134e-04 + z * 2.75573137070700676789e-06) + z * w * (-2.50507602534068634195e-08 + z * 1.58969099521155010221e-10)
  let v = z * x
  if iy == 0 then
    return x + v * (-1.66666666666666324348e-01 + z * rr)
  end
  return x - ((z * (0.5 * y - v * rr) - y) - v * -1.66666666666666324348e-01)
end

make a function called rt_m_kcos takes x, y returns r
  let z = x * x
  let w = z * z
  let rr = z * (4.16666666666666019037e-02 + z * (-1.38888888888741095749e-03 + z * 2.48015872894767294178e-05)) + w * w * (-2.75573143513906633035e-07 + z * (2.08757232129817482790e-09 + z * -1.13596475577881948265e-11))
  let hz = 0.5 * z
  let w = 1.0 - hz
  return w + (((1.0 - w) - hz) + (z * rr - x * y))
end

make a function called rt_m_ktan takes x0, y0, odd returns r
  let x = x0
  let y = y0
  let hx = rt_m_hi(x)
  let big = word_and(hx, 2147483647) >= 1072010280
  let negative = false
  if big then
    if word_shr(hx, 31) == 1 then
      let negative = true
      let x = rt_m_neg(x)
      let y = rt_m_neg(y)
    end
    let x = (7.85398163397448278999e-01 - x) + (3.06161699786838301793e-17 - y)
    let y = 0.0
  end
  let z = x * x
  let w = z * z
  let rr = 1.33333333333201242699e-01 + w * (2.18694882948595424599e-02 + w * (3.59207910759131235356e-03 + w * (5.88041240820264096874e-04 + w * (7.81794442939557092300e-05 + w * -1.85586374855275456654e-05))))
  let v = z * (5.39682539762260521377e-02 + w * (8.86323982359930005737e-03 + w * (1.45620945432529025516e-03 + w * (2.46463134818469906812e-04 + w * (7.14072491382608190305e-05 + w * 2.59073051863633712884e-05)))))
  let s = z * x
  let rr = y + z * (s * (rr + v) + y) + s * 3.33333333333334091986e-01
  let w = x + rr
  if big then
    let s = rt_m_float(1 - 2 * odd)
    let v = s - 2.0 * (x + (rr - w * w / (w + s)))
    if negative then
      return rt_m_neg(v)
    end
    return v
  end
  if odd == 0 then
    return w
  end
  let w0 = rt_m_set_lo(w, 0)
  let v = rr - (w0 - x)
  let a = -1.0 / w
  let a0 = rt_m_set_lo(a, 0)
  return a0 + a * (1.0 + a0 * w0 + a0 * v)
end

