# v2 runtime: lists. A list's block payload is [len:8][cap:8], then cap
# elements of 16 bytes (type word, data word), from block + 32. A list is a
# value (spec 1.5): list_push and list_set never change a list anyone else
# can see. They change it in place only when its count is 1: the caller
# gave its only reference to the call (own.patlang), so no one else holds
# it. Otherwise they copy. The count is read directly from the parameter's
# block (mem_load of value_data, primitives, which take no reference):
# passing the list to a helper would itself add a reference, so a helper
# never sees a count of 1.
quiet_operators()

make a function called rt_list_heap_type returns t
  let t = 4294967305
  ensure (word_and(t, 4294967295) == 9) and (word_and(t, 4294967296) != 0)
  return t
end

make a function called rt_list_block_alloc takes cap returns block
  require (value_class(cap) == 2) and (cap >= 0)
  let block = rt_alloc(16 + 16 * cap)
  mem_store(block, 16, 0)
  mem_store(block, 24, cap)
  ensure (mem_load(block, 24) == cap) and (mem_load(block, 16) == 0)
  return block
end

# A list of n unit elements (a list literal fills them in, x64.patlang).
make a function called rt_list_alloc takes n returns l
  require (value_class(n) == 2) and (n >= 0)
  let block = rt_list_block_alloc(n)
  mem_store(block, 16, n)
  let k = 0
  while k < n do
    mem_store(block, 32 + 16 * k, 0)
    mem_store(block, 40 + 16 * k, 0)
    let k = k + 1
  end
  let l = value_make(rt_list_heap_type(), block)
  ensure (value_class(l) == 9) and (list_len(l) == n)
  return l
end

# A list's length; a string's; 0 for anything else.
make a function called list_len takes l returns n
  require value_live(l)
  let c = value_class(l)
  let n = 0
  if c == 9 then
    let n = mem_load(value_data(l), 16)
  elif c == 8 then
    let n = rt_str_chars(l)
  elif c == 18 then
    # a bytes: how many bytes it holds
    let n = mem_load(value_data(l), 16)
  end
  # a length depends on how many elements there are, never on what they are
  ct_public(n)
  ensure n >= 0
  return n
end


# The position an index names (spec 1.5): an int as it is, a modint by its
# residue (an int, or a bigint past any end). Anything else stops the program,
# naming its class: a float, even a whole one, is not an index.
make a function called rt_index_of takes i returns j
  require value_live(i)
  let c = value_class(i)
  if c == 2 then
    let j = i
    ensure (value_class(j) == 2) or (value_class(j) == 4)
    return j
  end
  if c == 15 then
    let j = mod_value(i)
    ensure (value_class(j) == 2) or (value_class(j) == 4)
    return j
  end
  print("an index is an int or a modint, not " + rt_class_words(c))
  let j = rt_stop(70)
  ensure false
  return j
end

# The int position i names, which must be below n; anything else stops.
make a function called rt_check_index takes i, n returns j
  require (value_class(n) == 2)
  let j = rt_index_of(i)
  if (value_class(j) != 2) or (j < 0) or (j >= n) then
    rt_fail_index()
  end
  ensure (value_class(j) == 2) and (j >= 0) and (j < n)
  return j
end

make a function called rt_fail_index returns r
  print("index out of range")
  let r = rt_stop(73)
  ensure false
  return r
end

# An element; unit past either end. Anything but a list is index_get's.
make a function called list_get takes l, i returns v
  require value_live(l)
  if value_class(l) != 9 then
    let v = index_get(l, i)
    ensure value_live(v)
    return v
  end
  let v = value_make(0, 0)
  let n = mem_load(value_data(l), 16)
  ct_public(n)
  if value_class(i) != 2 then
    let i = rt_index_of(i)
  end
  if (value_class(i) == 2) and (i >= 0) and (i < n) then
    let v = mem_load_value(value_data(l), 32 + 16 * i)
  end
  ensure value_live(v)
  return v
end

# A copy of l's elements in a block with room for cap, each element with a
# reference of its own.
make a function called rt_list_copy takes l, cap returns block
  require (value_class(l) == 9) and (cap >= list_len(l))
  let n = list_len(l)
  let src = value_data(l)
  let block = rt_list_block_alloc(cap)
  mem_store(block, 16, n)
  let k = 0
  while k < n do
    mem_init_value(block, 32 + 16 * k, mem_load_value(src, 32 + 16 * k))
    let k = k + 1
  end
  ensure (mem_load(block, 16) == list_len(l)) and (mem_load(block, 24) == cap)
  return block
end

make a function called list_push takes l, x returns r
  require (value_class(l) == 9) and value_live(l) and value_live(x)
  let block = value_data(l)
  let n = mem_load(block, 16)
  let count = mem_load(block, 0)
  let room = mem_load(block, 24)
  # the block's count, length and room depend on its use, never on what it holds
  ct_public(n)
  ct_public(count)
  ct_public(room)
  if (count == 1) and (n < room) then
    mem_init_value(block, 32 + 16 * n, x)
    mem_store(block, 16, n + 1)
    let r = l
    ensure (value_class(r) == 9) and (list_len(r) == n + 1)
    return r
  end
  let cap = 4
  if n * 2 > cap then
    let cap = n * 2
  end
  let copy = rt_list_copy(l, cap)
  mem_init_value(copy, 32 + 16 * n, x)
  mem_store(copy, 16, n + 1)
  let r = value_make(rt_list_heap_type(), copy)
  ensure (value_class(r) == 9) and (list_len(r) == n + 1)
  return r
end

# l with room for `extra` more elements and no other holder: l itself when
# its count is 1 and it has the room, otherwise a copy with the room (the
# same capacity rule as list_push, raised to fit).
make a function called rt_list_reserve takes l, extra returns r
  require (value_class(l) == 9) and value_live(l) and (value_class(extra) == 2) and (extra >= 0)
  let block = value_data(l)
  let n = mem_load(block, 16)
  let count = mem_load(block, 0)
  let room = mem_load(block, 24)
  ct_public(n)
  ct_public(count)
  ct_public(room)
  if (count == 1) and (n + extra <= room) then
    let r = l
    ensure (value_class(r) == 9) and (list_len(r) == n)
    return r
  end
  let cap = 4
  if n * 2 > cap then
    let cap = n * 2
  end
  if n + extra > cap then
    let cap = n + extra
  end
  let copy = rt_list_copy(l, cap)
  let r = value_make(rt_list_heap_type(), copy)
  ensure (value_class(r) == 9) and (list_len(r) == n) and (mem_load(value_data(r), 24) >= n + extra)
  return r
end

make a function called list_set takes l, i, x returns r
  require (value_class(l) == 9) and value_live(l) and value_live(x)
  let i = rt_check_index(i, list_len(l))
  let count = mem_load(value_data(l), 0)
  ct_public(count)
  if count == 1 then
    mem_store_value(value_data(l), 32 + 16 * i, x)
    let r = l
    ensure (value_class(r) == 9) and (list_len(r) == list_len(l))
    return r
  end
  let copy = rt_list_copy(l, list_len(l))
  mem_store_value(copy, 32 + 16 * i, x)
  let r = value_make(rt_list_heap_type(), copy)
  ensure (value_class(r) == 9) and (list_len(r) == list_len(l))
  return r
end

# Releases a freed list's elements (rt_finalize).
make a function called rt_list_release_elements takes block returns r
  require mem_load(block, 0) == 0
  let n = mem_load(block, 16)
  ct_public(n)
  let k = 0
  while k < n do
    # a type word depends on the element's class alone
    let tw = mem_load(block, 32 + 16 * k)
    ct_public(tw)
    if word_and(tw, 4294967296) != 0 then
      rt_release(tw, mem_load(block, 40 + 16 * k))
    end
    let k = k + 1
  end
  let r = 0
  ensure r == 0
  return r
end

make a function called rt_list_eq takes a, b returns yes
  require (value_class(a) == 9) and (value_class(b) == 9)
  let n = list_len(a)
  if n != list_len(b) then
    let yes = false
    ensure value_class(yes) == 1
    return yes
  end
  let k = 0
  while k < n do
    if not op_eq(list_get(a, k), list_get(b, k)) then
      let yes = false
      ensure value_class(yes) == 1
      return yes
    end
    let k = k + 1
  end
  let yes = true
  ensure value_class(yes) == 1
  return yes
end

make a function called rt_list_to_s takes l returns s
  require (value_class(l) == 9)
  let parts = []
  let n = list_len(l)
  let k = 0
  while k < n do
    let parts = list_push(parts, to_s(list_get(l, k)))
    let k = k + 1
  end
  let s = "[" + str_join(parts, ", ") + "]"
  ensure value_class(s) == 8
  return s
end

make a function called rt_list_concat takes a, b returns l
  require (value_class(a) == 9) and (value_class(b) == 9)
  let l = rt_list_alloc(0)
  let k = 0
  while k < list_len(a) do
    let l = list_push(l, list_get(a, k))
    let k = k + 1
  end
  let k = 0
  while k < list_len(b) do
    let l = list_push(l, list_get(b, k))
    let k = k + 1
  end
  ensure list_len(l) == list_len(a) + list_len(b)
  return l
end

make a function called index_get takes v, i returns r
  require value_live(v)
  let c = value_class(v)
  if (value_class(i) != 2) and ((c == 9) or (c == 18) or (c == 8) or (c == 12)) then
    let i = rt_index_of(i)
  end
  if c == 12 then
    # a vec reads as vec_get reads
    let r = vec_get(v, i)
    ensure value_live(r)
    return r
  end
  if c == 9 then
    # read here, as list_get reads, not through a call to it: v[i] is the
    # commonest read there is, and the second call cost a third of it
    let r = value_make(0, 0)
    let n = mem_load(value_data(v), 16)
    ct_public(n)
    if (value_class(i) == 2) and (i >= 0) and (i < n) then
      let r = mem_load_value(value_data(v), 32 + 16 * i)
    end
    ensure value_live(r)
    return r
  end
  if c == 18 then
    # a bytes's byte, or unit past either end, as a list gives
    let r = value_make(0, 0)
    let block = value_data(v)
    # where a block is, and a bytes's length, depend on its use, never on what
    # it holds (the constant-time check cannot tell this branch from a modint's)
    ct_public(block)
    # entered only when a second thread exists, as bytes_get enters (see its
    # comment in cells.patlang): the two calls made a bytes's read half as
    # dear again as a list's
    let e = (mem_load(runtime_state(), 4608) != 0) and rt_cell_read(block + 40)
    if (value_class(i) == 2) and (i >= 0) and (i < mem_load(block, 16)) then
      let r = mem_load_byte(mem_load(block, 32), 16 + i)
    end
    if e then
      rt_cell_read_end(block + 40, e)
    end
    ensure (value_class(r) == 0) or ((value_class(r) == 2) and (r >= 0) and (r <= 255))
    return r
  end
  if c == 8 then
    # past either end: the empty string
    let r = ""
    if (value_class(i) == 2) and (i >= 0) then
      let r = substr(v, i, 1)
    end
    ensure value_class(r) == 8
    return r
  end
  # anything else has no elements
  let r = value_make(0, 0)
  ensure value_class(r) == 0
  return r
end
