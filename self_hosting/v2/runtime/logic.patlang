# v2 runtime: rules (logic programming). A rule is registered at start as
# data (lower.patlang, lw_rule_registration), in the list at
# runtime_state() + 4224: [predicate, arity, head terms, body goals]. A term
# is ["var", name] for a logic variable, else its value; a goal is
# [predicate, terms]. Queries over them are milestone 9.
quiet_operators()

make a function called rt_logic_init returns r
  let st = runtime_state()
  mem_store(st, 4224, 0)
  mem_store(st, 4232, 0)
  mem_init_value(st, 4224, [])
  let r = 0
  ensure value_class(rt_global_get(4224)) == 9
  return r
end

make a function called rt_rule_add takes pred, head, body returns r
  require (value_class(pred) == 8) and (value_class(head) == 9) and (value_class(body) == 9)
  rt_global_set(4224, list_push(rt_global_get(4224), [pred, list_len(head), head, body]))
  let r = 0
  ensure r == 0
  return r
end

make a function called rt_rules returns rules
  let rules = rt_global_get(4224)
  ensure value_class(rules) == 9
  return rules
end
