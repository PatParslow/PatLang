# v2 runtime: logic programming and GOAP planning.
#
# A rule is [predicate, head tokens, body goals], a goal being [predicate,
# tokens], or [predicate, tokens, store name] for one written with `from`. A
# token is a constant, or a logic variable, a value of its own class made by
# logic_var(name); a ground fact is a rule with an empty body and no variables.
# Solving is depth-first with backtracking, at most 2000 rules deep: deeper
# stops the program, saying so, rather than giving an answer cut short.
# Planning is uniform-cost search over states, sets of ground facts, with no
# limit: it says there is no plan only when none exists, so a goal that cannot
# be reached over a very large state space searches until it has seen them
# all. An action is [name, preconditions, adds, deletes, cost].
#
# Rules live in stores (spec 1.13). A store is a cell (class 14, cells.patlang)
# whose block holds:
#   16 its rules, a vec, in the order they were added
#   32 its rules by predicate: a list of [predicate, vec of its rules], so a
#      goal visits only its own predicate's rules
#   48 its ground facts, for holding each once: a vec of buckets, each a list
#      of facts [predicate, tokens], the count of buckets a power of two
#   64 a word: how many facts the buckets hold
#   80 a word: its users, as a cell's (cells.patlang): a store belongs to one
#      thread at a time, though several may read it together
#
# State, the world's (worlds.patlang; rt_global_get/set):
#   4464 the named stores: a list of [name, store]. The program's rules are in
#        "default" and contract facts in "contracts".
#   4240 the actions
#   4256 what each action runs: [name, closure]
#   4272 named goals: [name, goals]
#   4288 a counter (a word, not a value) for renaming a rule's variables: the
#        engine's, in runtime_state()
#   4384 words: the clauses that have held: a table of addresses (an uncounted
#   4392 block), how many it holds, and at 4400 its slots, a power of two
quiet_operators()

make a function called rt_logic_init returns r
  mem_store(runtime_state(), 4288, 0)
  let r = rt_logic_state_init()
  ensure r == 0
  return r
end

# The world's stores, actions and goals, in the world the code runs in.
make a function called rt_logic_state_init returns r
  let st = rt_world_base()
  let off = 4240
  while off <= 4272 do
    mem_store(st, off, 0)
    mem_store(st, word_add(off, 8), 0)
    mem_init_value(st, off, [])
    let off = word_add(off, 16)
  end
  mem_store(st, 4464, 0)
  mem_store(st, 4472, 0)
  mem_init_value(st, 4464, [])
  let table = rt_alloc(8 * 256)
  let k = 0
  while k < 256 do
    mem_store(table, 16 + 8 * k, 0)
    let k = k + 1
  end
  mem_store(st, 4384, table)
  mem_store(st, 4392, 0)
  mem_store(st, 4400, 256)
  let r = 0
  ensure r == 0
  return r
end

# ---- stores ----

# n empty buckets, n a power of two.
make a function called rt_buckets_new takes n returns v
  require (n >= 2) and (word_and(n, n - 1) == 0)
  let v = vec_new()
  let k = 0
  while k < n do
    vec_push(v, [])
    let k = k + 1
  end
  ensure (value_class(v) == 12) and (vec_len(v) == n)
  return v
end

# A store's slots set empty: no rules, no index, 64 empty buckets. A fresh
# block's slots hold nothing yet; an old one's are released.
make a function called rt_store_reset takes block, fresh returns r
  require (block != 0) and (value_class(fresh) == 1)
  if fresh then
    mem_store(block, 16, 0)
    mem_store(block, 24, 0)
    mem_init_value(block, 16, vec_new())
    mem_store(block, 32, 0)
    mem_store(block, 40, 0)
    mem_init_value(block, 32, [])
    mem_store(block, 48, 0)
    mem_store(block, 56, 0)
    mem_init_value(block, 48, rt_buckets_new(64))
  else
    mem_store_value(block, 16, vec_new())
    mem_store_value(block, 32, [])
    mem_store_value(block, 48, rt_buckets_new(64))
  end
  mem_store(block, 64, 0)
  mem_store(block, 72, 0)
  let r = 0
  ensure r == 0
  return r
end

make a function called logic_store_new returns store
  let block = rt_alloc(80)
  rt_store_reset(block, true)
  mem_store(block, 80, 0)
  mem_store(block, 88, 0)
  let store = value_make(4294967310, block)
  # 88: its place in the registry of blocks that can close a cycle
  rt_cycle_register(4294967310, block)
  ensure value_class(store) == 14
  return store
end

# Where name is among the named stores, or -1.
make a function called rt_store_name_index takes name returns i
  require value_class(name) == 8
  let i = rt_pairs_index(rt_global_get(4464), name)
  ensure i >= 0 - 1
  return i
end

# The store with that name, made the first time the name is used: looked for
# and added under the state lock (objects.patlang), so two threads asking for a
# new name get one store, and a name already there costs only the look-up. The
# list of names is taken out while it grows, so the push does not copy it.
make a function called logic_store_named takes name returns store
  require value_class(name) == 8
  let held = rt_state_lock()
  let named = rt_global_take(4464)
  let i = rt_pairs_index(named, name)
  if i >= 0 then
    let store = named[i][1]
    rt_global_put(4464, named)
    rt_state_unlock(held)
    ensure value_class(store) == 14
    return store
  end
  rt_global_put(4464, named)
  rt_state_unlock(held)
  # a new name: the store is made outside the lock (making it can run the
  # cycle collector), then added unless another thread added one meanwhile
  let fresh = logic_store_new()
  let held = rt_state_lock()
  let named = rt_global_take(4464)
  let i = rt_pairs_index(named, name)
  let store = fresh
  if i >= 0 then
    let store = named[i][1]
  else
    let named = list_push(named, [name, fresh])
  end
  rt_global_put(4464, named)
  rt_state_unlock(held)
  ensure value_class(store) == 14
  return store
end

# Forgets the name: the store goes when its last holder does, and the name
# then names a new, empty store. Whether the name was in use.
make a function called store_delete takes name returns done
  require value_class(name) == 8
  let i = rt_store_name_index(name)
  if i < 0 then
    let done = false
    ensure value_class(done) == 1
    return done
  end
  rt_global_drop(4464, name)
  let done = true
  ensure value_class(done) == 1
  return done
end

# Whether a value is a store, or a list of stores.
make a function called rt_is_stores takes stores returns yes
  require value_live(stores)
  if value_class(stores) == 14 then
    let yes = true
    ensure value_class(yes) == 1
    return yes
  end
  if value_class(stores) != 9 then
    let yes = false
    ensure value_class(yes) == 1
    return yes
  end
  let k = 0
  while k < list_len(stores) do
    if value_class(stores[k]) != 14 then
      let yes = false
      ensure value_class(yes) == 1
      return yes
    end
    let k = k + 1
  end
  let yes = true
  ensure value_class(yes) == 1
  return yes
end

# A store, or a list of stores, as a list of stores.
make a function called rt_store_list takes stores returns list
  require rt_is_stores(stores)
  if value_class(stores) == 14 then
    let list = [stores]
    ensure value_class(list) == 9
    return list
  end
  let list = stores
  ensure value_class(list) == 9
  return list
end

# What solve, query and plan read: the default store, then the contracts store.
make a function called rt_default_stores returns stores
  let stores = [logic_store_named("default"), logic_store_named("contracts")]
  ensure list_len(stores) == 2
  return stores
end

# A fact's bucket: FNV-1a over its predicate and terms, each term with its
# class, so "1" and 1 differ.
make a function called rt_fact_bucket takes f, n returns at
  require (value_class(f) == 9) and (list_len(f) == 2) and (n >= 2)
  let h = rt_fnv_text(rt_fnv_start(), to_s(f[0]))
  let k = 0
  while k < list_len(f[1]) do
    let h = word_mul(word_xor(h, value_class(f[1][k])), 1099511628211)
    let h = rt_fnv_text(h, to_s(f[1][k]))
    let k = k + 1
  end
  let at = word_and(h, n - 1)
  ensure (at >= 0) and (at < n)
  return at
end

# Twice the buckets, so each holds about one fact or fewer.
make a function called rt_store_grow takes block returns n
  require block != 0
  let old = mem_load_value(block, 48)
  let n = vec_len(old) * 2
  let fresh = rt_buckets_new(n)
  let b = 0
  while b < vec_len(old) do
    let bucket = vec_get(old, b)
    let k = 0
    while k < list_len(bucket) do
      let at = rt_fact_bucket(bucket[k], n)
      vec_set(fresh, at, list_push(vec_get(fresh, at), bucket[k]))
      let k = k + 1
    end
    let b = b + 1
  end
  mem_store_value(block, 48, fresh)
  ensure n >= 128
  return n
end

# Notes a ground fact in a store's buckets: whether it was new.
make a function called rt_store_note_fact takes block, f returns added
  require (block != 0) and (value_class(f) == 9) and (list_len(f) == 2)
  let buckets = mem_load_value(block, 48)
  let at = rt_fact_bucket(f, vec_len(buckets))
  let bucket = vec_get(buckets, at)
  let k = 0
  while k < list_len(bucket) do
    if bucket[k] == f then
      let added = false
      ensure value_class(added) == 1
      return added
    end
    let k = k + 1
  end
  vec_set(buckets, at, list_push(bucket, f))
  mem_store(block, 64, mem_load(block, 64) + 1)
  if mem_load(block, 64) * 2 > vec_len(buckets) then
    rt_store_grow(block)
  end
  let added = true
  ensure value_class(added) == 1
  return added
end

# Where pred is in a store's index, or -1.
make a function called rt_store_pred_index takes block, pred returns i
  require (block != 0) and value_live(pred)
  let i = rt_pairs_index(mem_load_value(block, 32), pred)
  ensure i >= 0 - 1
  return i
end

# The vec of pred's rules in a store, made the first time pred has one there.
# The index is taken out while it grows, so the push does not copy it.
make a function called rt_store_pred_rules takes block, pred returns v
  require (block != 0) and value_live(pred)
  let i = rt_store_pred_index(block, pred)
  if i >= 0 then
    let v = mem_load_value(block, 32)[i][1]
    ensure value_class(v) == 12
    return v
  end
  let v = vec_new()
  mem_init_value(block, 32, list_push(mem_take_value(block, 32), [pred, v, rt_index_new(8)]))
  ensure value_class(v) == 12
  return v
end

# The rule at this place of pred's rules entered in pred's first-argument
# index (a rule of no arguments needs none: every goal looks at them all).
make a function called rt_store_index_rule takes block, pred, head_args, place returns done
  require (block != 0) and value_live(pred) and (value_class(head_args) == 9) and (place >= 0)
  if list_len(head_args) > 0 then
    let i = rt_store_pred_index(block, pred)
    let preds = mem_load_value(block, 32)
    let entry = preds[i]
    let idx = rt_index_add(entry[2], rt_first_key(head_args[0]), place)
    if idx != entry[2] then
      # grown into a new table
      mem_store_value(block, 32, list_set(preds, i, [entry[0], entry[1], idx]))
    end
  end
  let done = true
  ensure value_class(done) == 1
  return done
end

# pred's rules in a store as a list, in the order they were added; [] when it
# has none.
make a function called rt_store_rules_of takes store, pred returns rules
  require (value_class(store) == 14) and value_live(pred)
  let block = value_data(store)
  let e = rt_cell_read(block + 80)
  let i = rt_store_pred_index(block, pred)
  let rules = []
  if i >= 0 then
    let rules = vec_to_list(mem_load_value(block, 32)[i][1])
  end
  rt_cell_read_end(block + 80, e)
  ensure value_class(rules) == 9
  return rules
end

# ---- the first-argument index (review finding O13) ----
#
# Beside each predicate's rules a store keeps an index from a rule head's first
# argument to the rules' places: a hashed table, a vec of [count, bucket 1, ...,
# bucket B], each bucket a list of [key, places], the places ascending. A
# head whose first argument is a variable is under the key "*". A goal whose
# first argument is bound looks only at the rules under its key and under
# "*", in the order they were added, so a chain of n facts is followed in
# time growing as n, where every goal once went through all of them.

# A first argument's key: its class and its text, so "1" and 1 differ; "*"
# for a variable.
make a function called rt_first_key takes term returns key
  require value_live(term)
  if is_logic_var(term) then
    let key = "*"
    ensure value_class(key) == 8
    return key
  end
  let key = "" + value_class(term) + ":" + to_s(term)
  ensure value_class(key) == 8
  return key
end

make a function called rt_index_new takes buckets returns idx
  require (buckets > 0) and (word_and(buckets, buckets - 1) == 0)
  let idx = vec_new()
  vec_push(idx, 0)
  let i = 0
  while i < buckets do
    vec_push(idx, [])
    let i = i + 1
  end
  ensure vec_len(idx) == buckets + 1
  return idx
end

make a function called rt_index_bucket takes idx, key returns at
  require (value_class(idx) == 12) and (value_class(key) == 8)
  let at = 1 + word_and(rt_fnv_text(rt_fnv_start(), key), vec_len(idx) - 2)
  ensure (at >= 1) and (at < vec_len(idx))
  return at
end

# The places under a key, ascending; [] for none.
make a function called rt_index_get takes idx, key returns places
  require (value_class(idx) == 12) and (value_class(key) == 8)
  let bucket = vec_get(idx, rt_index_bucket(idx, key))
  let k = 0
  while k < list_len(bucket) do
    if str_eq(bucket[k][0], key) then
      let places = bucket[k][1]
      ensure value_class(places) == 9
      return places
    end
    let k = k + 1
  end
  let places = []
  ensure value_class(places) == 9
  return places
end

# A place added under a key: the index, twice the buckets when its keys
# outnumber them twice over.
make a function called rt_index_add takes idx, key, place returns out
  require (value_class(idx) == 12) and (value_class(key) == 8) and (place >= 0)
  let at = rt_index_bucket(idx, key)
  let bucket = vec_get(idx, at)
  let k = 0
  let found = false
  while (k < list_len(bucket)) and (not found) do
    if str_eq(bucket[k][0], key) then
      vec_set(idx, at, list_set(bucket, k, [key, list_push(bucket[k][1], place)]))
      let found = true
    end
    let k = k + 1
  end
  let out = idx
  if not found then
    vec_set(idx, at, list_push(bucket, [key, [place]]))
    vec_set(idx, 0, vec_get(idx, 0) + 1)
    if vec_get(idx, 0) > 2 * (vec_len(idx) - 1) then
      let out = rt_index_new(2 * (vec_len(idx) - 1))
      let b = 1
      while b < vec_len(idx) do
        let old = vec_get(idx, b)
        let j = 0
        while j < list_len(old) do
          let to = rt_index_bucket(out, old[j][0])
          vec_set(out, to, list_push(vec_get(out, to), old[j]))
          let j = j + 1
        end
        let b = b + 1
      end
      vec_set(out, 0, vec_get(idx, 0))
    end
  end
  ensure value_class(out) == 12
  return out
end

# Two ascending lists of places as one, ascending.
make a function called rt_places_merge takes a, b returns out
  require (value_class(a) == 9) and (value_class(b) == 9)
  let out = []
  let i = 0
  let j = 0
  while (i < list_len(a)) or (j < list_len(b)) do
    if j >= list_len(b) then
      let out = list_push(out, a[i])
      let i = i + 1
    elif i >= list_len(a) then
      let out = list_push(out, b[j])
      let j = j + 1
    elif a[i] < b[j] then
      let out = list_push(out, a[i])
      let i = i + 1
    else
      let out = list_push(out, b[j])
      let j = j + 1
    end
  end
  ensure list_len(out) == list_len(a) + list_len(b)
  return out
end

# The rules of pred in a store that a goal with these arguments can match, in
# the order they were added: by the index when its first argument is bound,
# all of them when it is not.
make a function called rt_store_candidates takes store, pred, args, subst returns rules
  require (value_class(store) == 14) and value_live(pred) and (value_class(args) == 9) and (value_class(subst) == 9)
  let block = value_data(store)
  let e = rt_cell_read(block + 80)
  let i = rt_store_pred_index(block, pred)
  let rules = []
  if i >= 0 then
    let entry = mem_load_value(block, 32)[i]
    let first = unit
    if list_len(args) > 0 then
      let first = logic_walk(args[0], subst)
    end
    if (list_len(args) == 0) or is_logic_var(first) then
      let rules = vec_to_list(entry[1])
    else
      let places = rt_places_merge(rt_index_get(entry[2], rt_first_key(first)), rt_index_get(entry[2], "*"))
      let k = 0
      while k < list_len(places) do
        let rules = list_push(rules, vec_get(entry[1], places[k]))
        let k = k + 1
      end
    end
  end
  rt_cell_read_end(block + 80, e)
  ensure value_class(rules) == 9
  return rules
end

# Adds a rule to a store, a ground fact only if the store does not hold it:
# whether the store changed.
make a function called rule_add_to takes store, head_pred, head_args, body returns added
  require (value_class(store) == 14) and (value_class(head_pred) == 8) and (value_class(head_args) == 9) and (value_class(body) == 9)
  let block = value_data(store)
  let e = rt_cell_write(block + 80)
  if (list_len(body) == 0) and rt_is_ground(head_args) then
    if not rt_store_note_fact(block, [head_pred, head_args]) then
      rt_cell_write_end(block + 80, e)
      let added = false
      ensure value_class(added) == 1
      return added
    end
  end
  let rule = [head_pred, head_args, body]
  vec_push(mem_load_value(block, 16), rule)
  let rules = rt_store_pred_rules(block, head_pred)
  vec_push(rules, rule)
  rt_store_index_rule(block, head_pred, head_args, vec_len(rules) - 1)
  rt_cell_write_end(block + 80, e)
  let added = true
  ensure value_class(added) == 1
  return added
end

make a function called rule_add takes head_pred, head_args, body returns added
  require (value_class(head_pred) == 8) and (value_class(head_args) == 9) and (value_class(body) == 9)
  let added = rule_add_to(logic_store_named("default"), head_pred, head_args, body)
  ensure value_class(added) == 1
  return added
end

# Empties the default store.
make a function called rules_clear returns done
  rt_store_reset(value_data(logic_store_named("default")), false)
  let done = true
  ensure value_class(done) == 1
  return done
end

# Empties a store.
make a function called rules_clear_in takes store returns done
  require value_class(store) == 14
  let block = value_data(store)
  let e = rt_cell_write(block + 80)
  rt_store_reset(block, false)
  rt_cell_write_end(block + 80, e)
  let done = true
  ensure value_class(done) == 1
  return done
end

# ---- contract clauses that held ----

# Puts an address in a table of cap slots (a power of two) unless it is there:
# whether it was added.
make a function called rt_table_add takes table, cap, addr returns added
  require (table != 0) and (cap >= 2) and (word_and(cap, cap - 1) == 0) and (addr != 0)
  let at = word_and(word_shr(addr, 4), cap - 1)
  while mem_load(table, 16 + 8 * at) != 0 do
    if mem_load(table, 16 + 8 * at) == addr then
      let added = false
      ensure value_class(added) == 1
      return added
    end
    let at = word_and(at + 1, cap - 1)
  end
  mem_store(table, 16 + 8 * at, addr)
  let added = true
  ensure value_class(added) == 1
  return added
end

# Twice the room, so the table stays below half full.
make a function called rt_held_grow returns new_cap
  let st = rt_world_base()
  let old = mem_load(st, 4384)
  let cap = mem_load(st, 4400)
  let new_cap = word_mul(cap, 2)
  let table = rt_alloc(8 * new_cap)
  let k = 0
  while k < new_cap do
    mem_store(table, 16 + 8 * k, 0)
    let k = k + 1
  end
  let k = 0
  while k < cap do
    let addr = mem_load(old, 16 + 8 * k)
    if addr != 0 then
      rt_table_add(table, new_cap, addr)
    end
    let k = k + 1
  end
  mem_store(st, 4384, table)
  mem_store(st, 4400, new_cap)
  rt_free(old)
  ensure new_cap >= 512
  return new_cap
end

# A clause held: the first time, it becomes the fact contract_holds(function,
# "kind:text"). A clause is known by its text literal's address, its own, so
# the repeat costs one table probe and allocates nothing. Only the first thread
# records: the rules are not safe to write from a worker, and a worker's facts
# never reached its parent (the interpreter's rule store is per thread too).
make a function called rt_contract_held takes fname, kind, text returns done
  require (value_class(fname) == 8) and (value_class(kind) == 8) and (value_class(text) == 8)
  if rt_context() != runtime_state() + 12288 then
    let done = false
    ensure value_class(done) == 1
    return done
  end
  let st = rt_world_base()
  if not rt_table_add(mem_load(st, 4384), mem_load(st, 4400), value_data(text)) then
    let done = false
    ensure value_class(done) == 1
    return done
  end
  mem_store(st, 4392, mem_load(st, 4392) + 1)
  if mem_load(st, 4392) * 2 >= mem_load(st, 4400) then
    rt_held_grow()
  end
  rule_add_to(logic_store_named("contracts"), "contract_holds", [fname, kind + ":" + text], [])
  let done = true
  ensure value_class(done) == 1
  return done
end

# ---- terms and substitutions ----

# A logic variable is a value of a class of its own (17; 16 is the unwinding mark's, worlds.patlang), holding its name, a
# string, at 16 in its block. Two with the same name are equal (op_eq), and one
# is never equal to a string: a string is a constant whatever its first letter,
# so data read at run time cannot become a variable (spec 1.13). A capitalised
# name in a rule declaration is lowered to logic_var of that name.
make a function called rt_logic_var_heap_type returns t
  let t = 4294967313
  ensure (word_and(t, 4294967295) == 17) and (word_and(t, 4294967296) != 0)
  return t
end

make a function called logic_var takes name returns v
  require (value_class(name) == 8) and (str_len(name) > 0)
  let v = rt_logic_var_made(name)
  ensure value_class(v) == 17
  return v
end

# A logic variable: its name at 16, and at 32 its key, 56 bits of the name's
# FNV-1a hash, which places it in a substitution (rt_subst_bind). Variables
# with the same name are the same variable, and have the same key.
make a function called rt_logic_var_made takes name returns v
  require (value_class(name) == 8) and (str_len(name) > 0)
  let block = rt_alloc(24)
  mem_store(block, 16, 0)
  mem_store(block, 24, 0)
  mem_init_value(block, 16, name)
  mem_store(block, 32, word_and(rt_fnv_text(rt_fnv_start(), name), 72057594037927935))
  let v = value_make(rt_logic_var_heap_type(), block)
  ensure value_class(v) == 17
  return v
end

make a function called rt_logic_var_key takes v returns key
  require value_class(v) == 17
  let key = mem_load(value_data(v), 32)
  ensure (key >= 0) and (key <= 72057594037927935)
  return key
end

make a function called logic_var_name takes v returns name
  require value_class(v) == 17
  let name = mem_load_value(value_data(v), 16)
  ensure (value_class(name) == 8) and (str_len(name) > 0)
  return name
end

make a function called is_logic_var takes term returns yes
  require value_live(term)
  let yes = value_class(term) == 17
  ensure value_class(yes) == 1
  return yes
end

# A substitution: what each bound variable is bound to. It is a trie on the
# variables' keys (rt_logic_var_key), read from the lowest bit up: [] binds
# nothing; a leaf [key, pairs] binds each [var, value] of pairs, every var
# having that key; a branch [child0, child1, 0] holds below child0 the
# variables whose key has 0 at this level's bit, and the rest below child1.
# Binding copies the path to one leaf, and the substitution it was made from
# is unchanged, so each branch of a search keeps its own. A look-up follows
# the same path, so it costs the same however many variables are bound: a
# chain of bindings was searched from the newest for a variable not yet bound,
# and a rule body of n goals binding n variables took time growing as n
# squared (review finding O13). A variable is bound at most once: unify binds
# only one still unbound.
make a function called rt_subst_bind takes subst, var, value returns out
  require (value_class(subst) == 9) and is_logic_var(var) and value_live(value)
  let out = rt_subst_put(subst, rt_logic_var_key(var), var, value, 0)
  ensure (value_class(out) == 9) and (list_len(out) > 0)
  return out
end

# node with var bound to value, node being the trie below shift bits of key.
make a function called rt_subst_put takes node, key, var, value, shift returns out
  require (value_class(node) == 9) and (shift >= 0) and (shift <= 56)
  let n = list_len(node)
  if n == 0 then
    let out = [key, [[var, value]]]
    ensure list_len(out) == 2
    return out
  end
  if n == 2 then
    if node[0] == key then
      let out = [key, list_push(node[1], [var, value])]
      ensure list_len(out) == 2
      return out
    end
    # two keys meet here: a branch takes this leaf below its bit, and the
    # new one goes in from the branch
    let branch = [[], [], 0]
    let branch = list_set(branch, word_and(word_shr(node[0], shift), 1), node)
    let out = rt_subst_put(branch, key, var, value, shift)
    ensure list_len(out) == 3
    return out
  end
  let side = word_and(word_shr(key, shift), 1)
  let out = list_set(node, side, rt_subst_put(node[side], key, var, value, shift + 1))
  ensure list_len(out) == 3
  return out
end

# A variable's binding, or the variable when it has none; a term that is not
# a variable is itself.
make a function called rt_subst_get takes subst, var returns v
  require (value_class(subst) == 9) and value_live(var)
  if value_class(var) != 17 then
    let v = var
    ensure value_live(v)
    return v
  end
  let key = rt_logic_var_key(var)
  let node = subst
  let shift = 0
  while list_len(node) == 3 do
    let node = node[word_and(word_shr(key, shift), 1)]
    let shift = shift + 1
  end
  if (list_len(node) == 2) and (node[0] == key) then
    let pairs = node[1]
    let i = 0
    while i < list_len(pairs) do
      if pairs[i][0] == var then
        let v = pairs[i][1]
        ensure value_live(v)
        return v
      end
      let i = i + 1
    end
  end
  let v = var
  ensure value_live(v)
  return v
end

# A term followed through the substitution to its end. Unification never
# binds a variable to itself or to one bound back to it, so every chain ends.
make a function called logic_walk takes term, subst returns out
  require value_live(term) and (value_class(subst) == 9)
  let cur = term
  while is_logic_var(cur) do
    let next = rt_subst_get(subst, cur)
    if next == cur then
      let out = cur
      ensure value_live(out)
      return out
    end
    let cur = next
  end
  let out = cur
  ensure value_live(out)
  return out
end

# ["Ok", substitution] when the two lists of terms unify, else ["Err", ""].
make a function called unify_args takes query_args, target_args, subst returns result
  require (value_class(query_args) == 9) and (value_class(target_args) == 9) and (value_class(subst) == 9)
  if list_len(query_args) != list_len(target_args) then
    let result = ["Err", ""]
    ensure list_len(result) == 2
    return result
  end
  let s = subst
  let i = 0
  while i < list_len(query_args) do
    let qw = logic_walk(query_args[i], s)
    let tw = logic_walk(target_args[i], s)
    if qw != tw then
      if is_logic_var(qw) then
        let s = rt_subst_bind(s, qw, tw)
      elif is_logic_var(tw) then
        let s = rt_subst_bind(s, tw, qw)
      else
        let result = ["Err", ""]
        ensure list_len(result) == 2
        return result
      end
    end
    let i = i + 1
  end
  let result = ["Ok", s]
  ensure list_len(result) == 2
  return result
end

make a function called apply_subst takes args, subst returns out
  require (value_class(args) == 9) and (value_class(subst) == 9)
  let out = []
  let i = 0
  while i < list_len(args) do
    let out = list_push(out, logic_walk(args[i], subst))
    let i = i + 1
  end
  ensure list_len(out) == list_len(args)
  return out
end

# ---- solving ----

# A rule with its variables given names no other use of it has, so recursion
# into the same rule keeps each attempt's bindings apart.
make a function called rt_rename_args takes args, suffix returns out
  require (value_class(args) == 9) and (value_class(suffix) == 8)
  let out = []
  let i = 0
  while i < list_len(args) do
    if is_logic_var(args[i]) then
      let out = list_push(out, rt_logic_var_made(logic_var_name(args[i]) + suffix))
    else
      let out = list_push(out, args[i])
    end
    let i = i + 1
  end
  ensure list_len(out) == list_len(args)
  return out
end

make a function called logic_fresh_rename takes rule returns renamed
  require (value_class(rule) == 9) and (list_len(rule) == 3)
  let n = atomic_add(runtime_state() + 4288, 1) + 1
  let suffix = "__" + n
  let body = []
  let i = 0
  while i < list_len(rule[2]) do
    let goal = [rule[2][i][0], rt_rename_args(rule[2][i][1], suffix)]
    if list_len(rule[2][i]) > 2 then
      let goal = list_push(goal, rule[2][i][2])
    end
    let body = list_push(body, goal)
    let i = i + 1
  end
  let renamed = [rule[0], rt_rename_args(rule[1], suffix), body]
  ensure list_len(renamed) == 3
  return renamed
end

# Whether a goal's arguments could unify with a rule's head: false when some
# place holds two different constants, which no renaming changes.
make a function called rt_may_unify takes args, head, subst returns yes
  require (value_class(args) == 9) and (value_class(head) == 9) and (value_class(subst) == 9)
  if list_len(args) != list_len(head) then
    let yes = false
    ensure value_class(yes) == 1
    return yes
  end
  let k = 0
  while k < list_len(head) do
    if not is_logic_var(head[k]) then
      let q = logic_walk(args[k], subst)
      if (not is_logic_var(q)) and (q != head[k]) then
        let yes = false
        ensure value_class(yes) == 1
        return yes
      end
    end
    let k = k + 1
  end
  let yes = true
  ensure value_class(yes) == 1
  return yes
end

# ---- the resolver ----
#
# A proof goes depth first, as Prolog's does. What is left to prove is a
# chain of frames, [stores, body, at, depth, parent]: the goals of body from
# at on, solved against stores, depth rules down, then what is left of the
# parent frame (0 at the end). Each substitution under which nothing is left
# is a solution, pushed onto out in the order found, and the search stops once
# out holds limit of them (-1: every one). A frame names a goal by its place
# in the body, so moving on to the next goal copies nothing: copying the rest
# of the body at each goal made a body of n goals cost n squared, and solving
# every goal in full before the next stopped no search early (review finding
# O13).

make a function called rt_frame takes stores, body, at, depth, parent returns frame
  require (value_class(stores) == 9) and (value_class(body) == 9) and (value_class(at) == 2) and (value_class(depth) == 2)
  let frame = [stores, body, at, depth, parent]
  ensure value_class(frame) == 9
  return frame
end

make a function called rt_resolve_full takes out, limit returns full
  require (value_class(out) == 12) and (value_class(limit) == 2)
  let full = (limit >= 0) and (vec_len(out) >= limit)
  ensure value_class(full) == 1
  return full
end

make a function called rt_prove takes frame, subst, out, limit returns done
  require (value_class(subst) == 9) and (value_class(out) == 12) and (value_class(limit) == 2)
  if rt_resolve_full(out, limit) then
    let done = true
    ensure value_class(done) == 1
    return done
  end
  # the next goal: the first frame, from this one up, with goals left
  let f = frame
  let looking = value_class(f) == 9
  while looking do
    if f[2] < list_len(f[1]) then
      let looking = false
    else
      let f = f[4]
      let looking = value_class(f) == 9
    end
  end
  if value_class(f) != 9 then
    vec_push(out, subst)
    let done = true
    ensure value_class(done) == 1
    return done
  end
  let stores = f[0]
  let goal = f[1][f[2]]
  let depth = f[3]
  let next = rt_frame(stores, f[1], f[2] + 1, depth, f[4])
  if goal[0] == "neq" then
    if logic_walk(goal[1][0], subst) != logic_walk(goal[1][1], subst) then
      rt_prove(next, subst, out, limit)
    end
    let done = true
    ensure value_class(done) == 1
    return done
  end
  let goal_stores = stores
  if list_len(goal) > 2 then
    let goal_stores = [logic_store_named(goal[2])]
  end
  # 2000 deep is as far as every target's stack goes (a browser's ran out
  # between 2000 and 10000, measured 2026-11-17); an answer cut short would
  # read as "no", so the search stops the program instead
  if depth > 2000 then
    print("solve: the search for " + goal[0] + " went deeper than 2000 rules: a rule that leads back to itself, or a chain longer than solve follows (spec 1.13)")
    rt_stop(89)
  end
  let pred = goal[0]
  let args = apply_subst(goal[1], subst)
  let s = 0
  while (s < list_len(goal_stores)) and (not rt_resolve_full(out, limit)) do
    let rules = rt_store_candidates(goal_stores[s], pred, args, subst)
    let i = 0
    while (i < list_len(rules)) and (not rt_resolve_full(out, limit)) do
      let rule = rules[i]
      if rt_may_unify(args, rule[1], subst) then
        if (list_len(rule[2]) > 0) or (not rt_is_ground(rule[1])) then
          let rule = logic_fresh_rename(rule)
        end
        let u = unify_args(args, rule[1], subst)
        if u[0] == "Ok" then
          rt_prove(rt_frame(goal_stores, rule[2], 0, depth + 1, next), u[1], out, limit)
        end
      end
      let i = i + 1
    end
    let s = s + 1
  end
  let done = true
  ensure value_class(done) == 1
  return done
end

# The query's arguments under each of the first limit ways (-1: every way)
# of proving it from a list of stores, in the order the search finds them.
make a function called rt_solve_limited takes stores, pred, query_args, limit returns solutions
  require (value_class(stores) == 9) and value_live(pred) and (value_class(query_args) == 9) and (value_class(limit) == 2)
  let out = vec_new()
  rt_prove(rt_frame(stores, [[pred, query_args]], 0, 0, 0), [], out, limit)
  let found = vec_to_list(out)
  let solutions = []
  let i = 0
  while i < list_len(found) do
    let solutions = list_push(solutions, apply_subst(query_args, found[i]))
    let i = i + 1
  end
  ensure (value_class(solutions) == 9) and ((limit < 0) or (list_len(solutions) <= limit))
  return solutions
end

# The query's arguments under each way of proving it from a store, or a list
# of stores.
make a function called solve_in takes stores, pred, query_args returns solutions
  require rt_is_stores(stores) and value_live(pred) and (value_class(query_args) == 9)
  let solutions = rt_solve_limited(rt_store_list(stores), pred, query_args, 0 - 1)
  ensure value_class(solutions) == 9
  return solutions
end

# The first n of the solutions solve_in gives, in its order: the search stops
# once it has them, so asking whether there is one costs one proof.
make a function called solve_up_to_in takes stores, pred, query_args, n returns solutions
  require rt_is_stores(stores) and value_live(pred) and (value_class(query_args) == 9) and (value_class(n) == 2) and (n >= 0)
  let solutions = rt_solve_limited(rt_store_list(stores), pred, query_args, n)
  ensure (value_class(solutions) == 9) and (list_len(solutions) <= n)
  return solutions
end

make a function called solve_up_to takes pred, query_args, n returns solutions
  require value_live(pred) and (value_class(query_args) == 9) and (value_class(n) == 2) and (n >= 0)
  let solutions = solve_up_to_in(rt_default_stores(), pred, query_args, n)
  ensure (value_class(solutions) == 9) and (list_len(solutions) <= n)
  return solutions
end

make a function called solve takes pred, query_args returns solutions
  require value_live(pred) and (value_class(query_args) == 9)
  let solutions = solve_in(rt_default_stores(), pred, query_args)
  ensure (value_class(solutions) == 9)
  return solutions
end

# What solve_in gives, each solution also added to the target store as a fact.
make a function called solve_into takes target, stores, pred, query_args returns solutions
  require (value_class(target) == 14) and rt_is_stores(stores) and (value_class(pred) == 8) and (value_class(query_args) == 9)
  let solutions = solve_in(stores, pred, query_args)
  let i = 0
  while i < list_len(solutions) do
    rule_add_to(target, pred, solutions[i], [])
    let i = i + 1
  end
  ensure (value_class(solutions) == 9)
  return solutions
end

make a function called fact takes pred, a, b returns done
  require value_live(pred) and value_live(a) and value_live(b)
  rule_add(pred, [a, b], [])
  let done = true
  ensure value_class(done) == 1
  return done
end

make a function called fact_in takes store, pred, a, b returns done
  require (value_class(store) == 14) and value_live(pred) and value_live(a) and value_live(b)
  rule_add_to(store, pred, [a, b], [])
  let done = true
  ensure value_class(done) == 1
  return done
end

make a function called query_in takes stores, pred, a, ignored returns count
  require rt_is_stores(stores) and value_live(pred) and value_live(a)
  let count = list_len(solve_in(stores, pred, [a, logic_var("Q")]))
  ensure count >= 0
  return count
end

make a function called query takes pred, a, ignored returns count
  require value_live(pred) and value_live(a)
  let count = list_len(solve(pred, [a, logic_var("Q")]))
  ensure count >= 0
  return count
end

# ---- planning ----

make a function called action_add takes name, preconds, add_effects, del_effects, cost returns done
  require value_live(name) and value_live(cost) and (value_class(preconds) == 9) and (value_class(add_effects) == 9) and (value_class(del_effects) == 9)
  rt_global_push(4240, [name, preconds, add_effects, del_effects, cost])
  let done = true
  ensure value_class(done) == 1
  return done
end

make a function called rt_is_ground takes args returns yes
  require (value_class(args) == 9)
  let i = 0
  while i < list_len(args) do
    if is_logic_var(args[i]) then
      let yes = false
      ensure value_class(yes) == 1
      return yes
    end
    let i = i + 1
  end
  let yes = true
  ensure value_class(yes) == 1
  return yes
end

# The state a plan starts from: every rule in the stores that is a ground
# fact, store by store.
make a function called rt_ground_facts takes stores returns state
  require value_class(stores) == 9
  let out = []
  let s = 0
  while s < list_len(stores) do
    let sblock = value_data(stores[s])
    let se = rt_cell_read(sblock + 80)
    let rules = vec_to_list(mem_load_value(sblock, 16))
    rt_cell_read_end(sblock + 80, se)
    let i = 0
    while i < list_len(rules) do
      if (list_len(rules[i][2]) == 0) and rt_is_ground(rules[i][1]) then
        let out = list_push(out, [rules[i][0], rules[i][1]])
      end
      let i = i + 1
    end
    let s = s + 1
  end
  let state = out
  ensure (value_class(state) == 9)
  return state
end

make a function called rt_state_contains takes state, f returns yes
  require (value_class(state) == 9) and value_live(f)
  let i = 0
  while i < list_len(state) do
    if state[i] == f then
      let yes = true
      ensure value_class(yes) == 1
      return yes
    end
    let i = i + 1
  end
  let yes = false
  ensure value_class(yes) == 1
  return yes
end

# Every substitution under which all of the preconditions hold in the state:
# added to `out`, starting at precondition k.
make a function called rt_instances takes preconds, k, state, subst, out returns all
  require (value_class(preconds) == 9) and (value_class(state) == 9) and (value_class(subst) == 9) and (value_class(out) == 9) and (value_class(k) == 2)
  if k >= list_len(preconds) then
    let all = list_push(out, subst)
    ensure list_len(all) >= list_len(out)
    return all
  end
  let goal = preconds[k]
  let applied = apply_subst(goal[1], subst)
  let cur = out
  let i = 0
  while i < list_len(state) do
    if state[i][0] == goal[0] then
      let u = unify_args(applied, state[i][1], subst)
      if u[0] == "Ok" then
        let cur = rt_instances(preconds, k + 1, state, u[1], cur)
      end
    end
    let i = i + 1
  end
  let all = cur
  ensure list_len(all) >= list_len(out)
  return all
end

# A plan step (review finding B6): [the action's name, its preconditions'
# variables' values as bound, those variables' names], in the order the
# preconditions first name them. The values keep their types (2 stays an int,
# a text holding a comma stays one value); the names are there so that
# step_label can still write the step as it always was written,
# "build(X=house,Y=2)".
make a function called action_instance_step takes name, preconds, subst returns step
  require (value_class(name) == 8) and (value_class(preconds) == 9) and (value_class(subst) == 9)
  let seen = []
  let i = 0
  while i < list_len(preconds) do
    let args = preconds[i][1]
    let k = 0
    while k < list_len(args) do
      if is_logic_var(args[k]) and (not rt_state_contains(seen, args[k])) then
        let seen = list_push(seen, args[k])
      end
      let k = k + 1
    end
    let i = i + 1
  end
  let values = []
  let names = []
  let j = 0
  while j < list_len(seen) do
    let values = list_push(values, logic_walk(seen[j], subst))
    let names = list_push(names, logic_var_name(seen[j]))
    let j = j + 1
  end
  let step = [name, values, names]
  ensure (list_len(step) == 3) and (list_len(step[1]) == list_len(step[2]))
  return step
end

# A plan step as text: its action's name, with its variables as bound
# ("build(X=house,Y=2)") when it has any.
make a function called step_label takes step returns label
  require (value_class(step) == 9) and (list_len(step) == 3)
  if list_len(step[1]) == 0 then
    let label = step[0]
    ensure value_class(label) == 8
    return label
  end
  let b = sb_new()
  sb_push(b, step[0])
  sb_push(b, "(")
  let j = 0
  while j < list_len(step[1]) do
    if j > 0 then
      sb_push(b, ",")
    end
    sb_push(b, step[2][j])
    sb_push(b, "=")
    sb_push(b, to_s(step[1][j]))
    let j = j + 1
  end
  sb_push(b, ")")
  let label = sb_str(b)
  ensure value_class(label) == 8
  return label
end

# A plan's steps as text, each as step_label writes it.
make a function called plan_labels takes steps returns labels
  require value_class(steps) == 9
  let labels = []
  let i = 0
  while i < list_len(steps) do
    let labels = list_push(labels, step_label(steps[i]))
    let i = i + 1
  end
  ensure list_len(labels) == list_len(steps)
  return labels
end

# A plan step's action name.
make a function called step_name takes step returns name
  require (value_class(step) == 9) and (list_len(step) == 3)
  let name = step[0]
  ensure value_class(name) == 8
  return name
end

# A plan step's bound values, in order, as they were bound.
make a function called step_values takes step returns values
  require (value_class(step) == 9) and (list_len(step) == 3)
  let values = step[1]
  ensure value_class(values) == 9
  return values
end

make a function called rt_fact_text takes f returns s
  require (value_class(f) == 9) and (list_len(f) == 2)
  let b = sb_new()
  sb_push(b, f[0])
  sb_push(b, "(")
  let i = 0
  while i < list_len(f[1]) do
    if i > 0 then
      sb_push(b, ",")
    end
    sb_push(b, f[1][i])
    let i = i + 1
  end
  sb_push(b, ")")
  let s = sb_str(b)
  ensure value_class(s) == 8
  return s
end

# A state's facts as one text, whatever their order.
make a function called rt_state_key takes state returns key
  require (value_class(state) == 9)
  let texts = []
  let i = 0
  while i < list_len(state) do
    let texts = list_push(texts, rt_fact_text(state[i]))
    let i = i + 1
  end
  let key = str_join(rt_sort_strings(texts), "|")
  ensure value_class(key) == 8
  return key
end

make a function called rt_state_without takes state, f returns out
  require (value_class(state) == 9) and value_live(f)
  let out = []
  let i = 0
  while i < list_len(state) do
    if state[i] != f then
      let out = list_push(out, state[i])
    end
    let i = i + 1
  end
  ensure list_len(out) <= list_len(state)
  return out
end

make a function called rt_state_effects takes state, effects, subst, adding returns out
  require (value_class(state) == 9) and (value_class(effects) == 9) and (value_class(subst) == 9) and (value_class(adding) == 1)
  let cur = state
  let i = 0
  while i < list_len(effects) do
    let f = [effects[i][0], apply_subst(effects[i][1], subst)]
    if not adding then
      let cur = rt_state_without(cur, f)
    elif not rt_state_contains(cur, f) then
      let cur = list_push(cur, f)
    end
    let i = i + 1
  end
  let out = cur
  ensure (value_class(out) == 9)
  return out
end

make a function called rt_state_satisfies takes state, goals returns yes
  require (value_class(state) == 9) and (value_class(goals) == 9)
  let i = 0
  while i < list_len(goals) do
    if not rt_state_contains(state, goals[i]) then
      let yes = false
      ensure value_class(yes) == 1
      return yes
    end
    let i = i + 1
  end
  let yes = true
  ensure value_class(yes) == 1
  return yes
end

# ---- the plan search ----
#
# A* from the stores' ground facts (spec 1.13). A node is [f, g, seq, state,
# path, unmet]: g the cost so far, f that plus the estimate below, seq the
# order it was made in, unmet how many goals its state does not meet. The frontier is a binary heap in a vec, the node to expand
# first at index 0: least f, then most g (deeper first, so a run of equally
# good steps is followed to its end), then least seq. A state is expanded
# once, the first time it is taken from the frontier; the search ends with
# the first state taken that meets the goals, or with [] when the frontier
# is empty, every reachable state having been tried. Each expansion makes a
# child for every applicable step, each a copy of the state, so for n
# independent goals the search takes time growing about as n cubed.

# How many of the goals the state does not meet.
make a function called rt_plan_unmet takes state, goals returns unmet
  require (value_class(state) == 9) and (value_class(goals) == 9)
  let unmet = 0
  let i = 0
  while i < list_len(goals) do
    if not rt_state_contains(state, goals[i]) then
      let unmet = unmet + 1
    end
    let i = i + 1
  end
  ensure (unmet >= 0) and (unmet <= list_len(goals))
  return unmet
end

# The goals a step leaves unmet, from those its state left: each goal it adds
# that was not there is met, each goal it deletes that was there is not. A
# step's effects are few, so this costs far less than counting again.
make a function called rt_plan_unmet_after takes unmet, state, effects, subst, adding, goals returns out
  require (value_class(state) == 9) and (value_class(effects) == 9) and (value_class(goals) == 9)
  let out = unmet
  let i = 0
  while i < list_len(effects) do
    let f = [effects[i][0], apply_subst(effects[i][1], subst)]
    if rt_state_contains(goals, f) and (rt_state_contains(state, f) != adding) then
      if adding then
        let out = out - 1
      else
        let out = out + 1
      end
    end
    let i = i + 1
  end
  ensure out >= 0
  return out
end

# The estimate of what is left: the goals not yet met, over the most facts any
# action adds, rounded up, times the cheapest action's cost. No action meets
# more goals than it adds facts or costs less than the cheapest, so it never
# overestimates, and the plan found is a cheapest one.
make a function called rt_plan_estimate takes unmet, most_adds, cheapest returns h
  require (unmet >= 0) and (most_adds >= 1)
  let h = 0
  if (unmet > 0) and (cheapest > 0) then
    let h = word_div(unmet + most_adds - 1, most_adds) * cheapest
  end
  ensure h >= 0
  return h
end

# [the most facts an action adds (at least 1), the cheapest action's cost (0
# when some action costs nothing or there are none)].
make a function called rt_plan_shape takes actions returns shape
  require value_class(actions) == 9
  let most = 1
  let cheapest = 0
  let i = 0
  while i < list_len(actions) do
    if list_len(actions[i][2]) > most then
      let most = list_len(actions[i][2])
    end
    if (i == 0) or (actions[i][4] < cheapest) then
      let cheapest = actions[i][4]
    end
    let i = i + 1
  end
  if cheapest < 0 then
    let cheapest = 0
  end
  let shape = [most, cheapest]
  ensure (list_len(shape) == 2) and (shape[0] >= 1)
  return shape
end

# Whether node a is expanded before node b.
make a function called rt_pq_before takes a, b returns yes
  require (list_len(a) == 6) and (list_len(b) == 6)
  if a[0] != b[0] then
    let yes = a[0] < b[0]
  elif a[1] != b[1] then
    let yes = a[1] > b[1]
  else
    let yes = a[2] < b[2]
  end
  ensure value_class(yes) == 1
  return yes
end

make a function called rt_pq_push takes heap, node returns done
  require (value_class(heap) == 12) and (list_len(node) == 6)
  vec_push(heap, node)
  let i = vec_len(heap) - 1
  let moving = true
  while moving and (i > 0) do
    let up = word_div(i - 1, 2)
    if rt_pq_before(vec_get(heap, i), vec_get(heap, up)) then
      let x = vec_get(heap, i)
      vec_set(heap, i, vec_get(heap, up))
      vec_set(heap, up, x)
      let i = up
    else
      let moving = false
    end
  end
  let done = true
  ensure value_class(done) == 1
  return done
end

# The node to expand first, taken out of the heap.
make a function called rt_pq_pop takes heap returns node
  require (value_class(heap) == 12) and (vec_len(heap) > 0)
  let node = vec_get(heap, 0)
  let n = vec_len(heap) - 1
  let last = rt_vec_pop(heap)
  if n > 0 then
    vec_set(heap, 0, last)
    let i = 0
    let moving = true
    while moving do
      let l = 2 * i + 1
      let r = l + 1
      let best = i
      if (l < n) and rt_pq_before(vec_get(heap, l), vec_get(heap, best)) then
        let best = l
      end
      if (r < n) and rt_pq_before(vec_get(heap, r), vec_get(heap, best)) then
        let best = r
      end
      if best == i then
        let moving = false
      else
        let x = vec_get(heap, i)
        vec_set(heap, i, vec_get(heap, best))
        vec_set(heap, best, x)
        let i = best
      end
    end
  end
  ensure list_len(node) == 6
  return node
end

# The states expanded: 1024 buckets of state keys, by the key's hash.
make a function called rt_key_set_new returns set
  let set = vec_new()
  let i = 0
  while i < 1024 do
    vec_push(set, [])
    let i = i + 1
  end
  ensure vec_len(set) == 1024
  return set
end

# Adds key to the set: true when it was not there.
make a function called rt_key_set_add takes set, key returns added
  require (value_class(set) == 12) and (value_class(key) == 8)
  let k = word_and(rt_fnv_text(rt_fnv_start(), key), 1023)
  let bucket = vec_get(set, k)
  let i = 0
  while i < list_len(bucket) do
    if bucket[i] == key then
      let added = false
      ensure value_class(added) == 1
      return added
    end
    let i = i + 1
  end
  vec_set(set, k, list_push(bucket, key))
  let added = true
  ensure value_class(added) == 1
  return added
end

# [path, the state it reaches], or [[], []] when no plan is found, starting
# from the ground facts of a list of stores.
make a function called rt_plan_from takes stores, goal_facts returns result
  require (value_class(stores) == 9) and (value_class(goal_facts) == 9)
  let actions = rt_global_get(4240)
  let shape = rt_plan_shape(actions)
  let start = rt_ground_facts(stores)
  let heap = vec_new()
  let unmet = rt_plan_unmet(start, goal_facts)
  rt_pq_push(heap, [rt_plan_estimate(unmet, shape[0], shape[1]), 0, 0, start, [], unmet])
  let seq = 1
  let expanded = rt_key_set_new()
  while vec_len(heap) > 0 do
    let node = rt_pq_pop(heap)
    let state = node[3]
    if node[5] == 0 then
      let result = [node[4], state]
      ensure list_len(result) == 2
      return result
    end
    if rt_key_set_add(expanded, rt_state_key(state)) then
      let a = 0
      while a < list_len(actions) do
        let action = actions[a]
        let insts = rt_instances(action[1], 0, state, [], [])
        let k = 0
        while k < list_len(insts) do
          let subst = insts[k]
          let mid = rt_state_effects(state, action[3], subst, false)
          let next = rt_state_effects(mid, action[2], subst, true)
          # a step that changes nothing leads nowhere new
          if next != state then
            let left = rt_plan_unmet_after(node[5], state, action[3], subst, false, goal_facts)
            let left = rt_plan_unmet_after(left, mid, action[2], subst, true, goal_facts)
            let g = node[1] + action[4]
            let path = list_push(node[4], action_instance_step(action[0], action[1], subst))
            rt_pq_push(heap, [g + rt_plan_estimate(left, shape[0], shape[1]), g, seq, next, path, left])
            let seq = seq + 1
          end
          let k = k + 1
        end
        let a = a + 1
      end
    end
  end
  let result = [[], []]
  ensure list_len(result) == 2
  return result
end

# [path, the state it reaches] from the default and contracts stores.
make a function called plan_with_state takes goal_facts returns result
  require (value_class(goal_facts) == 9)
  let result = rt_plan_from(rt_default_stores(), goal_facts)
  ensure list_len(result) == 2
  return result
end

# [path, the state it reaches] from the ground facts of a store, or a list of stores.
make a function called plan_with_state_in takes stores, goal_facts returns result
  require rt_is_stores(stores) and (value_class(goal_facts) == 9)
  let result = rt_plan_from(rt_store_list(stores), goal_facts)
  ensure list_len(result) == 2
  return result
end

make a function called plan takes goal_facts returns path
  require (value_class(goal_facts) == 9)
  let path = rt_plan_from(rt_default_stores(), goal_facts)[0]
  ensure (value_class(path) == 9)
  return path
end

# A plan from the ground facts of a store, or a list of stores.
make a function called plan_in takes stores, goal_facts returns path
  require rt_is_stores(stores) and (value_class(goal_facts) == 9)
  let path = rt_plan_from(rt_store_list(stores), goal_facts)[0]
  ensure (value_class(path) == 9)
  return path
end

# plan_incremental gives what plan gives (spec 1.13): this runtime keeps no
# search work between calls.
make a function called plan_incremental takes goal_facts returns path
  require (value_class(goal_facts) == 9)
  let path = plan(goal_facts)
  ensure (value_class(path) == 9)
  return path
end

# Forgets every action action_add added, and what each runs.
make a function called action_clear returns done
  rt_global_set(4240, [])
  rt_global_set(4256, [])
  let done = true
  ensure value_class(done) == 1
  return done
end

# ---- goals and actions ----

make a function called goal_def takes name, deps returns done
  require value_live(name) and (value_class(deps) == 9)
  rt_global_pair_set(4272, name, deps)
  let done = true
  ensure value_class(done) == 1
  return done
end

# A named goal's plan; a goal never declared has none.
make a function called pursue takes name returns steps
  require value_live(name)
  let goals = rt_global_get(4272)
  let i = rt_pairs_index(goals, name)
  if i < 0 then
    let steps = []
    ensure (value_class(steps) == 9)
    return steps
  end
  let steps = plan(goals[i][1])
  ensure (value_class(steps) == 9)
  return steps
end

make a function called action_bind takes name, closure returns done
  require value_live(name) and value_live(closure)
  rt_global_pair_set(4256, name, closure)
  let done = true
  ensure value_class(done) == 1
  return done
end

make a function called action_lookup takes name returns closure
  require (value_class(name) == 8)
  let bodies = rt_global_get(4256)
  let i = rt_pairs_index(bodies, name)
  if i < 0 then
    print("activate: no action bound to '" + name + "' (call action_bind(\"" + name + "\", ...) first)")
    let closure = rt_stop(99)
    ensure value_class(closure) == 10
    return closure
  end
  let closure = bodies[i][1]
  ensure value_class(closure) == 10
  return closure
end

make a function called rt_byte_index takes s, c returns i
  require (value_class(s) == 8) and (value_class(c) == 2)
  let i = 0
  while i < str_len(s) do
    if rt_byte_at(s, i) == c then
      ensure (i >= 0 - 1) and (i < str_len(s))
      return i
    end
    let i = i + 1
  end
  let i = 0 - 1
  ensure (i >= 0 - 1) and (i < str_len(s))
  return i
end

make a function called action_base_name takes label returns name
  require (value_class(label) == 8)
  let open_at = rt_byte_index(label, 40)
  if open_at < 0 then
    let name = label
    ensure str_len(name) <= str_len(label)
    return name
  end
  let name = rt_byte_substr(label, 0, open_at)
  ensure str_len(name) <= str_len(label)
  return name
end

# A plan step's bound values, in order: "build(X=house,Y=2)" gives
# ["house", "2"].
make a function called action_label_args takes label returns vals
  require (value_class(label) == 8)
  let open_at = rt_byte_index(label, 40)
  let vals = []
  if open_at < 0 then
    ensure (value_class(vals) == 9)
    return vals
  end
  let inner = rt_byte_substr(label, open_at + 1, str_len(label) - open_at - 2)
  let n = str_len(inner)
  if n == 0 then
    ensure (value_class(vals) == 9)
    return vals
  end
  let start = 0
  let i = 0
  while i <= n do
    if (i == n) or (rt_byte_at(inner, i) == 44) then
      let part = rt_byte_substr(inner, start, i - start)
      let eq = rt_byte_index(part, 61)
      let vals = list_push(vals, rt_byte_substr(part, eq + 1, str_len(part) - eq - 1))
      let start = i + 1
    end
    let i = i + 1
  end
  ensure (value_class(vals) == 9)
  return vals
end

# Runs a plan's steps in order, each step's closure given its bound values as
# one list, stopping at the first that returns false. Whether every step ran.
make a function called activate takes steps returns ok
  require (value_class(steps) == 9)
  let ok = true
  let i = 0
  while ok and (i < list_len(steps)) do
    let f = action_lookup(step_name(steps[i]))
    let r = f(step_values(steps[i]))
    if r == false then
      let ok = false
    end
    let i = i + 1
  end
  ensure value_class(ok) == 1
  return ok
end
