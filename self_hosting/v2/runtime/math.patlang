# v2 runtime: powers, trigonometry, rounding, the bits of a word, and the smaller
# file and text functions. Each gives what the interpreter's function of that name
# gives; a value it cannot take stops at its require.
quiet_operators()

make a function called sin takes x returns r
  require rt_is_real(x)
  let r = rt_float(extern_call_float("UCRTBASE.DLL", "sin", rt_float_bits_of(x)))
  ensure value_class(r) == 3
  return r
end

