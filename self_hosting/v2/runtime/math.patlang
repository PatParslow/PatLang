# An exact base to a whole power, squaring.
make a function called rt_pow_exact takes base, e returns r
  require (value_class(e) == 2) and (e >= 0)
  let r = 1
  let b = base
  let n = e
  while n > 0 do
    if word_and(n, 1) == 1 then
      let r = r * b
    end
    let n = word_shr(n, 1)
    if n > 0 then
      let b = b * b
    end
  end
  ensure rt_is_real(r)
  return r
end

make a function called pow takes base, e returns r
  require rt_is_real(base) and rt_is_real(e)
  let c = value_class(base)
  if ((c == 2) or (c == 4) or (c == 5)) and (value_class(e) == 2) then
    if e < 0 then
      let r = 1 / rt_pow_exact(base, 0 - e)
      ensure rt_is_real(r)
      return r
    end
    let r = rt_pow_exact(base, e)
    ensure rt_is_real(r)
    return r
  end
  let r = rt_float(extern_call_float("UCRTBASE.DLL", "pow", rt_float_bits_of(base), rt_float_bits_of(e)))
  ensure rt_is_real(r)
  return r
end

make a function called ceil takes x returns r
  require rt_is_real(x)
  let c = value_class(x)
  if (c == 2) or (c == 4) then
    let r = x
  elif c == 5 then
    let r = rational_floor(x) + 1
  else
    let r = rt_float(extern_call_float("UCRTBASE.DLL", "ceil", rt_float_bits_of(x)))
  end
  ensure rt_is_real(r)
  return r
end

make a function called trunc takes x returns r
  require rt_is_real(x)
  let c = value_class(x)
  if (c == 2) or (c == 4) then
    let r = x
  elif c == 5 then
    if x < 0 then
      let r = rational_floor(x) + 1
    else
      let r = rational_floor(x)
    end
  else
    let r = rt_float(extern_call_float("UCRTBASE.DLL", "trunc", rt_float_bits_of(x)))
  end
  ensure rt_is_real(r)
  return r
end

# To the nearest whole number, a half away from zero.
make a function called round takes x returns r
  require rt_is_real(x)
  let c = value_class(x)
  if (c == 2) or (c == 4) then
    let r = x
  elif c == 5 then
    if x < 0 then
      let r = 0 - floor(1 / 2 - x)
    else
      let r = floor(x + 1 / 2)
    end
  else
    let r = rt_float(extern_call_float("UCRTBASE.DLL", "round", rt_float_bits_of(x)))
  end
  ensure rt_is_real(r)
  return r
end

make a function called abs takes x returns r
  require rt_is_real(x) or (value_class(x) == 6)
  let c = value_class(x)
  if c == 6 then
    let r = sqrt(complex_re(x) * complex_re(x) + complex_im(x) * complex_im(x))
  elif c == 3 then
    let r = rt_float(word_and(rt_float_bits_of(x), 9223372036854775807))
  elif x < 0 then
    let r = 0 - x
  else
    let r = x
  end
  ensure rt_is_real(r)
  return r
end

# ---- a float as fixed-point text: exact, the last place rounded half to even ----

make a function called rt_digits_padded takes n, width returns s
  require (n >= 0) and (width >= 0)
  let s = to_s(n)
  let b = sb_new()
  let k = str_len(s)
  while k < width do
    sb_push(b, "0")
    let k = k + 1
  end
  sb_push(b, s)
  let s = sb_str(b)
  ensure value_class(s) == 8
  return s
end

make a function called to_fixed takes x, places returns s
  require rt_is_real(x) and (value_class(places) == 2)
  let p = places
  if p < 0 then
    let p = 0
  end
  let bits = rt_float_bits_of(x)
  let be = word_and(word_shr(bits, 52), 2047)
  let negative = word_shr(bits, 63) == 1
  let frac = word_and(bits, 4503599627370495)
  if be == 2047 then
    if frac != 0 then
      let s = "NaN"
    elif negative then
      let s = "-inf"
    else
      let s = "inf"
    end
    ensure value_class(s) == 8
    return s
  end
  let m = frac
  let e = 0 - 1074
  if be != 0 then
    let m = frac + 4503599627370496
    let e = be - 1075
  end
  let scaled = m * rt_pow_exact(10, p)
  if e >= 0 then
    let q = scaled * rt_pow_exact(2, e)
  else
    let d = rt_pow_exact(2, 0 - e)
    let q = floor(scaled / d)
    let twice = 2 * (scaled - q * d)
    if (twice > d) or ((twice == d) and ((q % 2) == 1)) then
      let q = q + 1
    end
  end
  let scale = rt_pow_exact(10, p)
  let whole = floor(q / scale)
  let b = sb_new()
  if negative then
    sb_push(b, "-")
  end
  sb_push(b, to_s(whole))
  if p > 0 then
    sb_push(b, ".")
    sb_push(b, rt_digits_padded(q - whole * scale, p))
  end
  let s = sb_str(b)
  ensure value_class(s) == 8
  return s
end

# ---- the bits of a word ----

make a function called rt_low_mask takes width returns mask
  require (value_class(width) == 2) and (width >= 0) and (width <= 64)
  if width == 64 then
    let mask = 0 - 1
    ensure value_class(mask) == 2
    return mask
  end
  let mask = word_sub(word_shl(1, width), 1)
  ensure value_class(mask) == 2
  return mask
end

make a function called bit_get takes n, pos returns bit
  require (value_class(n) == 2) and (value_class(pos) == 2) and (pos >= 0) and (pos < 64)
  let bit = word_and(word_shr(n, pos), 1)
  ensure (bit == 0) or (bit == 1)
  return bit
end

make a function called bit_set takes n, pos, val returns r
  require (value_class(n) == 2) and (value_class(pos) == 2) and (pos >= 0) and (pos < 64) and (value_class(val) == 2)
  let mask = word_shl(1, pos)
  if val != 0 then
    let r = word_or(n, mask)
  else
    let r = word_and(n, word_xor(mask, 0 - 1))
  end
  ensure value_class(r) == 2
  return r
end

make a function called bit_slice takes n, start, width returns r
  require (value_class(n) == 2) and (value_class(start) == 2) and (start >= 0) and (start < 64) and (value_class(width) == 2) and (width >= 0) and (start + width <= 64)
  let r = word_and(word_shr(n, start), rt_low_mask(width))
  ensure value_class(r) == 2
  return r
end

make a function called bit_set_slice takes n, start, width, val returns r
  require (value_class(n) == 2) and (value_class(start) == 2) and (start >= 0) and (start < 64) and (value_class(width) == 2) and (width >= 0) and (start + width <= 64) and (value_class(val) == 2)
  let mask = rt_low_mask(width)
  let cleared = word_and(n, word_xor(word_shl(mask, start), 0 - 1))
  let r = word_or(cleared, word_shl(word_and(val, mask), start))
  ensure value_class(r) == 2
  return r
end

# ---- text and files ----

# A string's or list's length, or an object's field count; 0 for anything else.
make a function called len takes v returns n
  require value_live(v)
  let c = value_class(v)
  let n = 0
  if c == 8 then
    let n = v.length
  elif c == 9 then
    let n = list_len(v)
  end
  ensure value_class(n) == 2
  return n
end

make a function called byte_length takes s returns n
  require value_live(s)
  let n = str_len(to_s(s))
  ensure n >= 0
  return n
end

make a function called max takes a, b returns r
  require value_live(a) and value_live(b)
  let r = b
  if a >= b then
    let r = a
  end
  ensure value_live(r)
  return r
end

make a function called min takes a, b returns r
  require value_live(a) and value_live(b)
  let r = b
  if a <= b then
    let r = a
  end
  ensure value_live(r)
  return r
end

# FNV-1a over a string's bytes, as 16 hex digits.
make a function called hash_string takes s returns digest
  require value_live(s)
  let t = to_s(s)
  let addr = rt_str_bytes(t)
  let n = str_len(t)
  let h = word_add(word_mul(3421674724, 4294967296), 2216829733)
  let i = 0
  while i < n do
    let h = word_mul(word_xor(h, mem_load_byte(addr, i)), 1099511628211)
    let i = i + 1
  end
  let digits = "0123456789abcdef"
  let b = sb_new()
  let k = 60
  while k >= 0 do
    sb_push(b, digits[word_and(word_shr(h, k), 15)])
    let k = k - 4
  end
  let digest = sb_str(b)
  ensure str_len(digest) == 16
  return digest
end

# A file's contents, or "" when it cannot be read.
make a function called try_read_file takes path returns text
  require value_class(path) == 8
  if file_exists(path) then
    let text = read_file(path)
  else
    let text = ""
  end
  ensure value_class(text) == 8
  return text
end

make a function called rename_file takes from, to returns ok
  require (value_class(from) == 8) and (value_class(to) == 8)
  rt_make_parents(to)
  let a = rt_cstr(from)
  let b = rt_cstr(to)
  # MOVEFILE_REPLACE_EXISTING
  let moved = extern_call("KERNEL32.DLL", "MoveFileExA", a + 16, b + 16, 1)
  rt_free(a)
  rt_free(b)
  if word_and(moved, 4294967295) == 0 then
    print("rename_file: " + from + " -> " + to + ": failed")
    exit_with(1)
  end
  let ok = true
  ensure value_class(ok) == 1
  return ok
end

# "OK " and the copy's absolute path, or "ERR: " and what failed.
make a function called copy_file takes from, to returns result
  require (value_class(from) == 8) and (value_class(to) == 8)
  rt_make_parents(to)
  let a = rt_cstr(from)
  let b = rt_cstr(to)
  let copied = extern_call("KERNEL32.DLL", "CopyFileA", a + 16, b + 16, 0)
  rt_free(a)
  if word_and(copied, 4294967295) == 0 then
    rt_free(b)
    let result = "ERR: copy_file: " + from + " -> " + to + ": failed"
    ensure value_class(result) == 8
    return result
  end
  let full = rt_alloc(4096)
  let n = word_and(extern_call("KERNEL32.DLL", "GetFullPathNameA", b + 16, 4096, full + 16, 0), 4294967295)
  rt_free(b)
  let result = "OK " + rt_str_from_bytes(full + 16, n)
  rt_free(full)
  ensure value_class(result) == 8
  return result
end

# One line from standard input, without its line ending; "" at its end.
make a function called read_line returns line
  # STD_INPUT_HANDLE
  let h = extern_call("KERNEL32.DLL", "GetStdHandle", 0 - 10)
  let cell = rt_alloc(16)
  let b = sb_new()
  let more = true
  while more do
    let ok = extern_call("KERNEL32.DLL", "ReadFile", h, cell + 16, 1, cell + 24, 0)
    if (word_and(ok, 4294967295) == 0) or (word_and(mem_load(cell, 24), 4294967295) == 0) then
      let more = false
    else
      let c = mem_load_byte(cell, 16)
      if c == 10 then
        let more = false
      elif c != 13 then
        sb_push(b, chr(c))
      end
    end
  end
  rt_free(cell)
  let line = sb_str(b)
  ensure value_class(line) == 8
  return line
end

make a function called read_file_b64 takes path returns text
  require value_class(path) == 8
  let table = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
  let out = sb_new()
  let offset = 0
  let window = 3145728
  let more = true
  while more do
    let part = read_file_bytes(path, offset, window)
    let n = list_len(part)
    let i = 0
    while i < n do
      let left = n - i
      let b0 = part[i]
      let b1 = 0
      let b2 = 0
      if left > 1 then
        let b1 = part[i + 1]
      end
      if left > 2 then
        let b2 = part[i + 2]
      end
      let w = word_or(word_or(word_shl(b0, 16), word_shl(b1, 8)), b2)
      sb_push(out, table[word_and(word_shr(w, 18), 63)])
      sb_push(out, table[word_and(word_shr(w, 12), 63)])
      if left > 1 then
        sb_push(out, table[word_and(word_shr(w, 6), 63)])
      else
        sb_push(out, "=")
      end
      if left > 2 then
        sb_push(out, table[word_and(w, 63)])
      else
        sb_push(out, "=")
      end
      let i = i + 3
    end
    let offset = offset + n
    let more = n == window
  end
  let text = sb_str(out)
  ensure value_class(text) == 8
  return text
end
