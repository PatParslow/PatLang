# v2 runtime: the operators' slow paths (x64.patlang inlines two ints),
# complex numbers, intervals and integers modulo n. Classes: int 2, float 3,
# bigint 4, rational 5, complex 6, interval 7, modint 15. Mixed real operands take the higher kind: a float makes a
# float; otherwise a rational makes a rational, which is an integer again
# when it divides evenly; otherwise integers. A complex operand makes a
# complex result, which is real again when its imaginary part is zero. An
# interval operand makes an interval, a real operand counting as its own two ends.
quiet_operators()

make a function called rt_complex_heap_type returns t
  let t = 4294967302
  ensure (word_and(t, 4294967295) == 6) and (word_and(t, 4294967296) != 0)
  return t
end

make a function called rt_is_number takes v returns yes
  require value_live(v)
  let c = value_class(v)
  let yes = (c >= 2) and (c <= 7)
  ensure value_class(yes) == 1
  return yes
end

make a function called rt_has_class takes a, b, c returns yes
  require (value_class(c) == 2)
  let yes = (value_class(a) == c) or (value_class(b) == c)
  ensure value_class(yes) == 1
  return yes
end

# ---- complex ----

make a function called complex_re takes z returns v
  require rt_is_number(z)
  if value_class(z) == 6 then
    let v = mem_load_value(value_data(z), 16)
    ensure rt_is_real(v)
    return v
  end
  let v = z
  ensure rt_is_real(v)
  return v
end

make a function called complex_im takes z returns v
  require rt_is_number(z)
  if value_class(z) == 6 then
    let v = mem_load_value(value_data(z), 32)
    ensure rt_is_real(v)
    return v
  end
  let v = 0
  ensure rt_is_real(v)
  return v
end

make a function called rt_is_zero takes v returns yes
  require value_live(v)
  let c = value_class(v)
  if c == 2 then
    let yes = v == 0
    ensure value_class(yes) == 1
    return yes
  end
  if c == 3 then
    let yes = float_eq(value_data(v), 0) == 1
    ensure value_class(yes) == 1
    return yes
  end
  let yes = false
  ensure value_class(yes) == 1
  return yes
end

# re + im i: re itself when im is zero.
make a function called complex_make takes re, im returns z
  require rt_is_real(re) and rt_is_real(im)
  if rt_is_zero(im) then
    let z = re
    ensure rt_is_number(z) and ((value_class(z) == 6) or rt_is_zero(im))
    return z
  end
  let block = rt_alloc(32)
  mem_init_value(block, 16, re)
  mem_init_value(block, 32, im)
  let z = value_make(rt_complex_heap_type(), block)
  ensure rt_is_number(z) and ((value_class(z) == 6) or rt_is_zero(im))
  return z
end

make a function called rt_complex_to_s takes z returns s
  require value_class(z) == 6
  let s = to_s(complex_re(z)) + "+" + to_s(complex_im(z)) + "i"
  ensure value_class(s) == 8
  return s
end

make a function called rt_sqrt_negative takes x returns z
  require rt_is_real(x)
  let z = complex_make(0, sqrt(op_neg(x)))
  ensure rt_is_number(z)
  return z
end

# ---- intervals ----

make a function called rt_interval_heap_type returns t
  let t = 4294967303
  ensure (word_and(t, 4294967295) == 7) and (word_and(t, 4294967296) != 0)
  return t
end

make a function called interval_make takes lo, hi returns z
  require rt_is_real(lo) and rt_is_real(hi) and (lo <= hi)
  let block = rt_alloc(32)
  mem_init_value(block, 16, lo)
  mem_init_value(block, 32, hi)
  let z = value_make(rt_interval_heap_type(), block)
  ensure value_class(z) == 7
  return z
end

# A real number counts as the interval from itself to itself.
make a function called interval_lo takes z returns v
  require rt_is_real(z) or (value_class(z) == 7)
  if value_class(z) == 7 then
    let v = mem_load_value(value_data(z), 16)
    ensure rt_is_real(v)
    return v
  end
  let v = z
  ensure rt_is_real(v)
  return v
end

make a function called interval_hi takes z returns v
  require rt_is_real(z) or (value_class(z) == 7)
  if value_class(z) == 7 then
    let v = mem_load_value(value_data(z), 32)
    ensure rt_is_real(v)
    return v
  end
  let v = z
  ensure rt_is_real(v)
  return v
end

make a function called rt_interval_to_s takes z returns s
  require value_class(z) == 7
  let s = "[" + to_s(interval_lo(z)) + "," + to_s(interval_hi(z)) + "]"
  ensure value_class(s) == 8
  return s
end

make a function called rt_real_min takes a, b returns r
  require rt_is_real(a) and rt_is_real(b)
  let r = a
  if b < a then
    let r = b
  end
  ensure (r <= a) and (r <= b)
  return r
end

make a function called rt_real_max takes a, b returns r
  require rt_is_real(a) and rt_is_real(b)
  let r = a
  if b > a then
    let r = b
  end
  ensure (r >= a) and (r >= b)
  return r
end

make a function called rt_interval_arith takes op, a, b returns r
  require (op >= 0) and (op <= 3) and rt_is_number(a) and rt_is_number(b)
  if (op == 3) or rt_has_class(a, b, 6) then
    let r = rt_fail_class(7)
    ensure value_class(r) == 7
    return r
  end
  let al = interval_lo(a)
  let ah = interval_hi(a)
  let bl = interval_lo(b)
  let bh = interval_hi(b)
  if op == 0 then
    let r = interval_make(al + bl, ah + bh)
    ensure value_class(r) == 7
    return r
  end
  if op == 1 then
    let r = interval_make(al - bh, ah - bl)
    ensure value_class(r) == 7
    return r
  end
  let p1 = al * bl
  let p2 = al * bh
  let p3 = ah * bl
  let p4 = ah * bh
  let r = interval_make(rt_real_min(rt_real_min(p1, p2), rt_real_min(p3, p4)), rt_real_max(rt_real_max(p1, p2), rt_real_max(p3, p4)))
  ensure value_class(r) == 7
  return r
end

# ---- integers modulo n (spec 1.14) ----
# A modint is class 15. Its block holds, from 16:
#   16  n, an int or a bigint (a value, counted)
#   32  L, the number of 32-bit limbs n takes
#   40  the kind of n: 0 for 2^k, 1 for an odd n, 2 for any other
#   48  k, the number of bits of n (for 2^k, that k)
#   56  for an odd n, -1/n modulo 2^32, else 0
#   64  the residue: L limbs, least significant first, each 32 bits in a word;
#       for an odd n in Montgomery form, the residue times 2^(32L) modulo n
#   64 + 8L  n's L limbs
#   64 + 16L  for an odd n, 2^(64L) modulo n, which takes a residue into
#       Montgomery form in one multiplication; else zeros
# The residue is secret (ct_secret), and everything above it depends on n
# alone (ct_public), so each operation's time depends on n alone (spec 1.14,
# checked by the constant-time check, 2.7). Every word holding a limb or a
# value computed from one is changed only by the word primitives, which take
# the same time for any value, and a choice between two results is a mask.
#
# The limb routines below work on arrays given as a block and an offset into
# it; scratch arrays are blocks of their own (rt_lb_new), limbs from 16.

make a function called rt_modint_heap_type returns t
  let t = 4294967311
  ensure (word_and(t, 4294967295) == 15) and (word_and(t, 4294967296) != 0)
  return t
end

make a function called rt_mask32 returns m
  let m = 4294967295
  ensure m == 4294967295
  return m
end

# x modulo n, from 0 to n - 1: int_divmod's remainder takes the dividend's sign.
# For public integers only: its time depends on x.
make a function called rt_mod_reduce takes x, n returns r
  require rt_is_integer(x) and rt_is_integer(n) and (n >= 2)
  let r = int_divmod(x, n)[1]
  if r < 0 then
    let r = r + n
  end
  ensure rt_is_integer(r) and (r >= 0) and (r < n)
  return r
end

# ---- scratch limb arrays ----

make a function called rt_lb_new takes count returns block
  require (value_class(count) == 2) and (count >= 1)
  let block = rt_alloc(8 * count)
  let i = 0
  while i < count do
    mem_store(block, 16 + 8 * i, 0)
    let i = i + 1
  end
  ensure block != 0
  return block
end

# Freeing reads only the block's header, its size, and discards what it held,
# so the pointer is public here.
make a function called rt_lb_free takes block returns r
  require block != 0
  ct_public(block)
  let r = rt_free(block)
  ensure r == 0
  return r
end

# ---- limb arithmetic, each the same steps for any limbs ----

make a function called rt_lb_copy takes d, doff, a, aoff, count returns r
  require (d != 0) and (a != 0) and (count >= 0)
  let i = 0
  while i < count do
    mem_store(d, doff + 8 * i, mem_load(a, aoff + 8 * i))
    let i = i + 1
  end
  let r = 0
  ensure r == 0
  return r
end

make a function called rt_lb_zero takes d, doff, count returns r
  require (d != 0) and (count >= 0)
  let i = 0
  while i < count do
    mem_store(d, doff + 8 * i, 0)
    let i = i + 1
  end
  let r = 0
  ensure r == 0
  return r
end

# d = a + b over count limbs; the carry out, 0 or 1.
make a function called rt_lb_add takes d, doff, a, aoff, b, boff, count returns carry
  require (d != 0) and (a != 0) and (b != 0) and (count >= 1)
  let m = rt_mask32()
  let carry = 0
  let i = 0
  while i < count do
    let s = word_add(word_add(mem_load(a, aoff + 8 * i), mem_load(b, boff + 8 * i)), carry)
    mem_store(d, doff + 8 * i, word_and(s, m))
    let carry = word_shr(s, 32)
    let i = i + 1
  end
  ensure word_shr(carry, 1) == 0
  return carry
end

# d = a - b over count limbs; the borrow out, 0 or 1.
make a function called rt_lb_sub takes d, doff, a, aoff, b, boff, count returns borrow
  require (d != 0) and (a != 0) and (b != 0) and (count >= 1)
  let m = rt_mask32()
  let borrow = 0
  let i = 0
  while i < count do
    let s = word_sub(word_sub(mem_load(a, aoff + 8 * i), mem_load(b, boff + 8 * i)), borrow)
    mem_store(d, doff + 8 * i, word_and(s, m))
    let borrow = word_shr(s, 63)
    let i = i + 1
  end
  ensure word_shr(borrow, 1) == 0
  return borrow
end

# d = a when bit is 1, b when it is 0, by a mask.
make a function called rt_lb_select takes d, doff, a, aoff, b, boff, count, bit returns r
  require (d != 0) and (a != 0) and (b != 0) and (count >= 0)
  let keep = word_sub(0, bit)
  let other = word_xor(keep, 0 - 1)
  let i = 0
  while i < count do
    mem_store(d, doff + 8 * i, word_or(word_and(mem_load(a, aoff + 8 * i), keep), word_and(mem_load(b, boff + 8 * i), other)))
    let i = i + 1
  end
  let r = 0
  ensure r == 0
  return r
end

# a and b exchanged when bit is 1, by a mask.
make a function called rt_lb_cswap takes a, aoff, b, boff, count, bit returns r
  require (a != 0) and (b != 0) and (count >= 0)
  let mask = word_sub(0, bit)
  let i = 0
  while i < count do
    let x = mem_load(a, aoff + 8 * i)
    let y = mem_load(b, boff + 8 * i)
    let t = word_and(word_xor(x, y), mask)
    mem_store(a, aoff + 8 * i, word_xor(x, t))
    mem_store(b, boff + 8 * i, word_xor(y, t))
    let i = i + 1
  end
  let r = 0
  ensure r == 0
  return r
end

# a shifted right by one bit, in place; top is the bit shifted into the top.
make a function called rt_lb_half takes a, aoff, count, top returns r
  require (a != 0) and (count >= 1)
  let m = rt_mask32()
  let i = 0
  while i < count do
    let next = top
    if i + 1 < count then
      let next = mem_load(a, aoff + 8 * (i + 1))
    end
    mem_store(a, aoff + 8 * i, word_and(word_or(word_shr(mem_load(a, aoff + 8 * i), 1), word_shl(word_and(next, 1), 31)), m))
    let i = i + 1
  end
  let r = 0
  ensure r == 0
  return r
end

# 1 when the count limbs at a are all zero, else 0.
make a function called rt_lb_is_zero takes a, aoff, count returns z
  require (a != 0) and (count >= 1)
  let acc = 0
  let i = 0
  while i < count do
    let acc = word_or(acc, mem_load(a, aoff + 8 * i))
    let i = i + 1
  end
  # acc is below 2^32: acc - 1 is negative only when acc is 0
  let z = word_shr(word_sub(acc, 1), 63)
  ensure word_shr(z, 1) == 0
  return z
end

# p, 2 * count limbs, = a * b.
make a function called rt_lb_mul_full takes p, poff, a, aoff, b, boff, count returns r
  require (p != 0) and (a != 0) and (b != 0) and (count >= 1)
  let m = rt_mask32()
  rt_lb_zero(p, poff, 2 * count)
  let i = 0
  while i < count do
    let bi = mem_load(b, boff + 8 * i)
    let carry = 0
    let j = 0
    while j < count do
      let at = poff + 8 * (i + j)
      let x = word_add(word_add(mem_load(p, at), word_mul(mem_load(a, aoff + 8 * j), bi)), carry)
      mem_store(p, at, word_and(x, m))
      let carry = word_shr(x, 32)
      let j = j + 1
    end
    mem_store(p, poff + 8 * (i + count), carry)
    let i = i + 1
  end
  let r = 0
  ensure r == 0
  return r
end

# d, count limbs, = the 32 * plen bits at p modulo the count-limb modulus at
# n, by shifting them in one at a time and subtracting n whenever the
# remainder reaches it.
make a function called rt_lb_reduce takes d, doff, p, poff, plen, n, noff, count returns r
  require (d != 0) and (p != 0) and (n != 0) and (count >= 1) and (plen >= 1)
  let m = rt_mask32()
  let rem = rt_lb_new(count + 1)
  let try = rt_lb_new(count + 1)
  let bit = 32 * plen - 1
  while bit >= 0 do
    # rem = 2 rem + the next bit
    let carry = word_and(word_shr(mem_load(p, poff + 8 * word_shr(bit, 5)), word_and(bit, 31)), 1)
    let i = 0
    while i <= count do
      let x = mem_load(rem, 16 + 8 * i)
      mem_store(rem, 16 + 8 * i, word_and(word_or(word_shl(x, 1), carry), m))
      let carry = word_shr(x, 31)
      let i = i + 1
    end
    # try = rem - n, n's limb above count being 0
    let borrow = rt_lb_sub(try, 16, rem, 16, n, noff, count)
    let top = word_sub(mem_load(rem, 16 + 8 * count), borrow)
    mem_store(try, 16 + 8 * count, word_and(top, m))
    rt_lb_select(rem, 16, rem, 16, try, 16, count + 1, word_shr(top, 63))
    let bit = bit - 1
  end
  rt_lb_copy(d, doff, rem, 16, count)
  rt_lb_free(rem)
  rt_lb_free(try)
  let r = 0
  ensure r == 0
  return r
end

# d = a + b modulo the modulus at n, for a and b below it. d may be a or b,
# at the same offset, but not n: the sum goes into d, limb by limb after each
# limb is read, and one scratch array holds the sum less n.
make a function called rt_lb_add_mod takes d, doff, a, aoff, b, boff, n, noff, count returns r
  require (d != 0) and (a != 0) and (b != 0) and (n != 0) and (count >= 1)
  let u = rt_lb_new(count)
  let carry = rt_lb_add(d, doff, a, aoff, b, boff, count)
  let borrow = rt_lb_sub(u, 16, d, doff, n, noff, count)
  # the sum itself only when it did not carry and is below n
  rt_lb_select(d, doff, d, doff, u, 16, count, word_and(word_xor(carry, 1), borrow))
  rt_lb_free(u)
  let r = 0
  ensure r == 0
  return r
end

# d = a - b modulo the modulus at n, for a and b below it. d may be a or b, as
# for rt_lb_add_mod.
make a function called rt_lb_sub_mod takes d, doff, a, aoff, b, boff, n, noff, count returns r
  require (d != 0) and (a != 0) and (b != 0) and (n != 0) and (count >= 1)
  let u = rt_lb_new(count)
  let borrow = rt_lb_sub(d, doff, a, aoff, b, boff, count)
  rt_lb_add(u, 16, d, doff, n, noff, count)
  rt_lb_select(d, doff, u, 16, d, doff, count, borrow)
  rt_lb_free(u)
  let r = 0
  ensure r == 0
  return r
end

# d = a * b modulo the modulus at n, by the full product and rt_lb_reduce.
make a function called rt_lb_mul_mod takes d, doff, a, aoff, b, boff, n, noff, count returns r
  require (d != 0) and (a != 0) and (b != 0) and (n != 0) and (count >= 1)
  let p = rt_lb_new(2 * count)
  rt_lb_mul_full(p, 16, a, aoff, b, boff, count)
  rt_lb_reduce(d, doff, p, 16, 2 * count, n, noff, count)
  rt_lb_free(p)
  let r = 0
  ensure r == 0
  return r
end

# The count limbs at d keep their low k bits, the rest becoming 0.
make a function called rt_lb_mask_bits takes d, doff, count, k returns r
  require (d != 0) and (count >= 1) and (k >= 0)
  let i = 0
  while i < count do
    let low = 32 * i
    if k <= low then
      mem_store(d, doff + 8 * i, 0)
    elif k < low + 32 then
      mem_store(d, doff + 8 * i, word_and(mem_load(d, doff + 8 * i), word_sub(word_shl(1, k - low), 1)))
    end
    let i = i + 1
  end
  let r = 0
  ensure r == 0
  return r
end

# A k-bit word's limbs, its bits above k cleared.
make a function called rt_lb_mask_top takes d, doff, count, k returns r
  require (d != 0) and (count >= 1) and (k >= 1) and (k <= 32 * count)
  let r = rt_lb_mask_bits(d, doff, count, k)
  ensure r == 0
  return r
end

# Montgomery multiplication: d = a * b / 2^(32 count) modulo the odd modulus at
# n, n0 being -1/n modulo 2^32, for a and b below n.
make a function called rt_lb_mont_mul takes d, doff, a, aoff, b, boff, n, noff, count, n0 returns r
  require (d != 0) and (a != 0) and (b != 0) and (n != 0) and (count >= 1)
  let m = rt_mask32()
  let t = rt_lb_new(count + 2)
  let i = 0
  while i < count do
    let bi = mem_load(b, boff + 8 * i)
    let carry = 0
    let j = 0
    while j < count do
      let x = word_add(word_add(mem_load(t, 16 + 8 * j), word_mul(mem_load(a, aoff + 8 * j), bi)), carry)
      mem_store(t, 16 + 8 * j, word_and(x, m))
      let carry = word_shr(x, 32)
      let j = j + 1
    end
    let x = word_add(mem_load(t, 16 + 8 * count), carry)
    mem_store(t, 16 + 8 * count, word_and(x, m))
    mem_store(t, 16 + 8 * (count + 1), word_shr(x, 32))
    let q = word_and(word_mul(mem_load(t, 16), n0), m)
    let x = word_add(mem_load(t, 16), word_mul(q, mem_load(n, noff)))
    let carry = word_shr(x, 32)
    let j = 1
    while j < count do
      let x = word_add(word_add(mem_load(t, 16 + 8 * j), word_mul(q, mem_load(n, noff + 8 * j))), carry)
      mem_store(t, 16 + 8 * (j - 1), word_and(x, m))
      let carry = word_shr(x, 32)
      let j = j + 1
    end
    let x = word_add(mem_load(t, 16 + 8 * count), carry)
    mem_store(t, 16 + 8 * (count - 1), word_and(x, m))
    mem_store(t, 16 + 8 * count, word_add(mem_load(t, 16 + 8 * (count + 1)), word_shr(x, 32)))
    let i = i + 1
  end
  # t, below 2n, less n unless that borrows past t's top limb
  let u = rt_lb_new(count)
  let borrow = rt_lb_sub(u, 16, t, 16, n, noff, count)
  let keep = word_and(word_xor(mem_load(t, 16 + 8 * count), 1), borrow)
  rt_lb_select(d, doff, t, 16, u, 16, count, keep)
  rt_lb_free(t)
  rt_lb_free(u)
  let r = 0
  ensure r == 0
  return r
end

# ---- a modint's header, all of it computed from n ----

make a function called rt_mod_word takes m, off returns w
  require value_class(m) == 15
  let w = rt_mod_header(value_data(m), off)
  ensure value_class(w) == 2
  return w
end

# A header word of a modint's block, before or after it is wrapped: it
# depends on n alone, so it is public.
make a function called rt_mod_header takes block, off returns w
  require (block != 0) and ((off == 16) or (off == 24) or (off == 32) or (off == 40) or (off == 48) or (off == 56))
  let w = mem_load(block, off)
  ct_public(w)
  ensure value_class(w) == 2
  return w
end

# Whether two modints have one modulus: at once when their modulus slots hold
# the same value word (one int, or one bigint shared), else from the blocks'
# headers and n's limbs, which n alone decides: the limb count, the kind, the
# bit count k, and the limbs, which are zeros for 2^k since k gives that n.
# Comparing these needs no bigint arithmetic. n is public, so the steps may
# depend on it.
make a function called rt_mod_same_modulus takes a, b returns same
  require (value_class(a) == 15) and (value_class(b) == 15)
  let wa = rt_mod_is_word(a)
  let wb = rt_mod_is_word(b)
  if wa or wb then
    # a word's modulus is 2^k: a word of the same k, or a block made from
    # one (rt_mod_box)
    if wa and wb then
      let same = value_type_word(a) == value_type_word(b)
    elif wa then
      let same = (rt_mod_kind(b) == 0) and (rt_mod_word(b, 48) == rt_modw_bits(a))
    else
      let same = (rt_mod_kind(a) == 0) and (rt_mod_word(a, 48) == rt_modw_bits(b))
    end
    ensure value_class(same) == 1
    return same
  end
  if (rt_mod_word(a, 16) == rt_mod_word(b, 16)) and (rt_mod_word(a, 24) == rt_mod_word(b, 24)) then
    let same = true
  elif (rt_mod_word(a, 32) != rt_mod_word(b, 32)) or (rt_mod_word(a, 40) != rt_mod_word(b, 40)) or (rt_mod_word(a, 48) != rt_mod_word(b, 48)) then
    let same = false
  else
    let count = rt_mod_limbs(a)
    let noff = rt_mod_noff(a)
    let pa = value_data(a)
    let pb = value_data(b)
    let same = true
    let i = 0
    while i < count do
      let wa = mem_load(pa, noff + 8 * i)
      let wb = mem_load(pb, noff + 8 * i)
      ct_public(wa)
      ct_public(wb)
      if wa != wb then
        let same = false
      end
      let i = i + 1
    end
  end
  ensure value_class(same) == 1
  return same
end

make a function called rt_mod_limbs takes m returns count
  require value_class(m) == 15
  let count = rt_mod_word(m, 32)
  ensure count >= 1
  return count
end

make a function called rt_mod_kind takes m returns kind
  require value_class(m) == 15
  let kind = rt_mod_word(m, 40)
  ensure (kind >= 0) and (kind <= 2)
  return kind
end

make a function called mod_modulus takes m returns n
  require value_class(m) == 15
  if rt_mod_is_word(m) then
    let n = rt_modw_modulus(rt_modw_bits(m))
    ensure rt_is_integer(n) and (n >= 2)
    return n
  end
  let n = mem_load_value(value_data(m), 16)
  ct_public(n)
  ensure rt_is_integer(n) and (n >= 2)
  return n
end

# The offset of 2^(64L) modulo n's limbs in an odd n's block.
make a function called rt_mod_r2off takes m returns off
  require value_class(m) == 15
  let off = 64 + 16 * rt_mod_limbs(m)
  ensure off >= 80
  return off
end

# The offset of n's limbs in a modint's block.
make a function called rt_mod_noff takes m returns off
  require value_class(m) == 15
  let off = 64 + 8 * rt_mod_limbs(m)
  ensure off >= 72
  return off
end

# n's limbs, written into d (public integers only).
make a function called rt_lb_from_int takes d, doff, x, count returns r
  require (d != 0) and rt_is_integer(x) and (x >= 0) and (count >= 1)
  let rest = x
  let i = 0
  while i < count do
    let qr = int_divmod(rest, 4294967296)
    mem_store(d, doff + 8 * i, qr[1])
    let rest = qr[0]
    let i = i + 1
  end
  let r = 0
  ensure rest == 0
  return r
end

# A new modint's block with m's modulus and header, its residue still zero.
make a function called rt_mod_like takes m returns block
  require value_class(m) == 15
  let count = rt_mod_limbs(m)
  let src = value_data(m)
  let block = rt_alloc(48 + 24 * count)
  # m's modulus value as it is, counted again: mod_modulus would also compare
  # it with 2, which for a bigint costs more than the arithmetic
  mem_init_value(block, 16, mem_load_value(src, 16))
  mem_store(block, 32, count)
  mem_store(block, 40, rt_mod_kind(m))
  mem_store(block, 48, rt_mod_word(m, 48))
  mem_store(block, 56, rt_mod_word(m, 56))
  rt_lb_zero(block, 64, count)
  rt_lb_copy(block, 64 + 8 * count, src, 64 + 8 * count, 2 * count)
  ct_secret(block)
  ensure block != 0
  return block
end

# A modint whose block says its modulus is 2^k, k up to 64, is given as the
# word it holds (spec 2.1); any other as its block. Every modint result is
# made here, so the two forms never meet for one modulus.
make a function called rt_mod_wrap takes block returns m
  require block != 0
  if (rt_mod_header(block, 40) == 0) and (rt_mod_header(block, 48) <= 64) then
    let k = rt_mod_header(block, 48)
    let w = mem_load(block, 64)
    if rt_mod_header(block, 32) > 1 then
      let w = word_or(w, word_shl(mem_load(block, 72), 32))
    end
    rt_release_value_at(block, 16)
    rt_lb_free(block)
    let m = value_make(rt_modw_type(k), word_and(w, rt_modw_mask(k)))
    ensure value_class(m) == 15
    return m
  end
  let m = value_make(rt_modint_heap_type(), block)
  ensure value_class(m) == 15
  return m
end

# A block as a modint the runtime goes on working on as a block, for a modulus
# no word holds: what rt_mod_wrap gives for it, said so where the
# constant-time check cannot read it from the header.
make a function called rt_mod_held takes block returns m
  require (block != 0) and ((rt_mod_header(block, 40) != 0) or (rt_mod_header(block, 48) > 64))
  let m = value_make(rt_modint_heap_type(), block)
  ensure (value_class(m) == 15) and (not rt_mod_is_word(m))
  return m
end

# ---- modints modulo 2^k held as words (spec 2.1) ----
#
# A modint modulo 2^k, for k from 1 to 64, is held in its value's two words,
# as a float is: the type word is class 15 with no heap bit and k in bits 40
# to 46, and the data word is the residue. This is the runtime's affair only:
# a program sees a modint as it always has (vi_modint_word_form). The word is
# secret, as a block's residue is: one made from a public integer goes
# through memory marked ct_secret, and one computed from another word is
# secret already. Operations on words are word arithmetic and a mask, so
# their time depends on k alone. What has no word path here (/, pow, a
# modulus compared with a block's) works on rt_mod_box's block, and its
# result comes back a word at rt_mod_wrap.

# Whether m is a modint held as a word: one whose type word is not a block's.
# Asked so, the constant-time check can answer it from the type word's class
# and follows each kind of modint on its own path (v2/ct.patlang).
make a function called rt_mod_is_word takes m returns yes
  require value_live(m)
  let yes = (value_class(m) == 15) and (value_type_word(m) != rt_modint_heap_type())
  ensure value_class(yes) == 1
  return yes
end

# k, for a modint held as a word.
make a function called rt_modw_bits takes m returns k
  require rt_mod_is_word(m)
  let k = word_and(word_shr(value_type_word(m), 40), 127)
  ensure (k >= 1) and (k <= 64)
  return k
end

# The k low bits set.
make a function called rt_modw_mask takes k returns mask
  require (k >= 1) and (k <= 64)
  if k == 64 then
    let mask = word_sub(0, 1)
  else
    let mask = word_sub(word_shl(1, k), 1)
  end
  ensure value_class(mask) == 2
  return mask
end

# A modint like m, a word, holding w's low k bits: m's type word kept.
make a function called rt_modw_like takes m, w returns r
  require rt_mod_is_word(m) and (value_class(w) == 2)
  let r = value_make(value_type_word(m), word_and(w, rt_modw_mask(rt_modw_bits(m))))
  ensure rt_mod_is_word(r)
  return r
end

# The word x as a secret: through memory the check is told holds one.
make a function called rt_modw_secret takes x returns w
  require value_class(x) == 2
  let cell = rt_alloc(8)
  ct_secret(cell)
  mem_store(cell, 16, x)
  let w = mem_load(cell, 16)
  rt_lb_free(cell)
  ensure value_class(w) == 2
  return w
end

# 2^k, an int or for k from 63 a bigint, as mod_modulus gives it.
make a function called rt_modw_modulus takes k returns n
  require (k >= 1) and (k <= 64)
  if k <= 62 then
    let n = word_shl(1, k)
  else
    let n = 4611686018427387904 * word_shl(1, k - 62)
  end
  ct_public(n)
  ensure rt_is_integer(n) and (n >= 2)
  return n
end

# The modint modulo 2^k holding the int x's low k bits, which is x reduced
# modulo 2^k for a negative x too (two's complement).
make a function called rt_modw_of_int takes k, x returns m
  require (k >= 1) and (k <= 64) and (value_class(x) == 2)
  let m = value_make(rt_modw_type(k), word_and(rt_modw_secret(x), rt_modw_mask(k)))
  ensure rt_mod_is_word(m)
  return m
end

# m as a block, in the layout every modint had before words (above): m itself
# when it is one, else a new block from the word, for an operation with no
# word path. Its result returns to a word at rt_mod_wrap.
make a function called rt_mod_box takes m returns b
  require value_class(m) == 15
  if not rt_mod_is_word(m) then
    let b = m
    ensure value_class(b) == 15
    return b
  end
  let k = rt_modw_bits(m)
  let count = word_shr(k + 31, 5)
  let block = rt_alloc(48 + 24 * count)
  mem_init_value(block, 16, rt_modw_modulus(k))
  mem_store(block, 32, count)
  mem_store(block, 40, 0)
  mem_store(block, 48, k)
  mem_store(block, 56, 0)
  rt_lb_zero(block, 64, 3 * count)
  ct_secret(block)
  let w = value_data(m)
  mem_store(block, 64, word_and(w, rt_mask32()))
  if count > 1 then
    mem_store(block, 72, word_shr(w, 32))
  end
  let b = value_make(rt_modint_heap_type(), block)
  ensure (value_class(b) == 15) and (not rt_mod_is_word(b))
  return b
end

# Whether a and b take the word path: a modint held as a word with a word of
# the same k, or with an int, which counts as the word it reduces to (spec
# 1.14: its low k bits, two's complement for a negative). Anything else (a
# word with a modint of another modulus, a bigint, another class) takes the
# block path, which refuses what spec 1.14 refuses.
make a function called rt_modw_fits takes a, b returns yes
  require value_live(a) and value_live(b)
  let wa = rt_mod_is_word(a)
  let wb = rt_mod_is_word(b)
  if wa and wb then
    let yes = value_type_word(a) == value_type_word(b)
  elif wa then
    let yes = value_class(b) == 2
  elif wb then
    let yes = value_class(a) == 2
  else
    let yes = false
  end
  ensure value_class(yes) == 1
  return yes
end

# k when the int n is 2^k (a modulus held as a word), else 0. n is public.
make a function called rt_modw_pow2_bits takes n returns k
  require value_class(n) == 2
  let k = 0
  if (n >= 2) and (word_and(n, n - 1) == 0) then
    let p = 1
    while p != n do
      let p = word_shl(p, 1)
      let k = k + 1
    end
  end
  ensure (k >= 0) and (k <= 62)
  return k
end

# k, for a shift or rotation of the word m by s: an int from 0 to k, else the
# program stops naming the modint class (spec 1.14).
make a function called rt_modw_count takes m, s returns k
  require rt_mod_is_word(m) and value_live(s)
  let k = rt_modw_bits(m)
  if (value_class(s) != 2) or (s < 0) or (s > k) then
    rt_fail_class(15)
  end
  ensure (k >= 1) and (k <= 64)
  return k
end

# m to the integer power e, for a word: the ladder of rt_modint_pow on words,
# the same steps for every exponent of one size (spec 1.14).
make a function called rt_modw_pow takes m, e returns r
  require rt_mod_is_word(m) and value_live(e)
  if not rt_is_integer(e) then
    rt_fail_class(15)
  end
  let base = m
  if e < 0 then
    let base = rt_mod_inverse(m)
  end
  let mask = rt_modw_mask(rt_modw_bits(m))
  let eb = rt_exponent_bits(e)
  let ecount = rt_exponent_limbs(e)
  let r0 = 1
  let r1 = value_data(base)
  let i = 32 * ecount - 1
  while i >= 0 do
    let bit = word_and(word_shr(mem_load(eb, 16 + 8 * word_shr(i, 5)), word_and(i, 31)), 1)
    let sel = word_sub(0, bit)
    # the ladder step on the pair, exchanged when the bit is 1, by masks
    let d = word_and(word_xor(r0, r1), sel)
    let x0 = word_xor(r0, d)
    let x1 = word_xor(r1, d)
    let n1 = word_and(word_mul(x0, x1), mask)
    let n0 = word_and(word_mul(x0, x0), mask)
    let d2 = word_and(word_xor(n0, n1), sel)
    let r0 = word_xor(n0, d2)
    let r1 = word_xor(n1, d2)
    let i = i - 1
  end
  rt_lb_free(eb)
  let r = rt_modw_like(m, r0)
  ensure rt_mod_is_word(r)
  return r
end

# Whichever of a and b is held as a word (a when both are).
make a function called rt_modw_template takes a, b returns t
  require rt_mod_is_word(a) or rt_mod_is_word(b)
  if rt_mod_is_word(a) then
    let t = a
  else
    let t = b
  end
  ensure rt_mod_is_word(t)
  return t
end

# The word of an operand on the word path: a modint's word, or an int's bits.
# Combined with the other operand's secret word, what it gives is secret.
make a function called rt_modw_w takes v returns w
  require (value_class(v) == 15) or (value_class(v) == 2)
  if value_class(v) == 2 then
    let w = v
  else
    let w = value_data(v)
  end
  ensure value_class(w) == 2
  return w
end

