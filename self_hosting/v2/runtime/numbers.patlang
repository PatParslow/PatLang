# v2 runtime: the operators' slow paths (x64.patlang inlines two ints),
# complex numbers and intervals. Classes: int 2, float 3, bigint 4, rational 5,
# complex 6, interval 7. Mixed real operands take the higher kind: a float makes a
# float; otherwise a rational makes a rational, which is an integer again
# when it divides evenly; otherwise integers. A complex operand makes a
# complex result, which is real again when its imaginary part is zero. An
# interval operand makes an interval, a real operand counting as its own two ends.
quiet_operators()

make a function called rt_complex_heap_type returns t
  let t = 4294967302
  ensure (word_and(t, 4294967295) == 6) and (word_and(t, 4294967296) != 0)
  return t
end

make a function called rt_is_number takes v returns yes
  require value_live(v)
  let c = value_class(v)
  let yes = (c >= 2) and (c <= 7)
  ensure value_class(yes) == 1
  return yes
end

make a function called rt_has_class takes a, b, c returns yes
  require (value_class(c) == 2)
  let yes = (value_class(a) == c) or (value_class(b) == c)
  ensure value_class(yes) == 1
  return yes
end

# ---- complex ----

make a function called complex_re takes z returns v
  require rt_is_number(z)
  if value_class(z) == 6 then
    let v = mem_load_value(value_data(z), 16)
    ensure rt_is_real(v)
    return v
  end
  let v = z
  ensure rt_is_real(v)
  return v
end

make a function called complex_im takes z returns v
  require rt_is_number(z)
  if value_class(z) == 6 then
    let v = mem_load_value(value_data(z), 32)
    ensure rt_is_real(v)
    return v
  end
  let v = 0
  ensure rt_is_real(v)
  return v
end

make a function called rt_is_zero takes v returns yes
  require value_live(v)
  let c = value_class(v)
  if c == 2 then
    let yes = v == 0
    ensure value_class(yes) == 1
    return yes
  end
  if c == 3 then
    let yes = float_eq(value_data(v), 0) == 1
    ensure value_class(yes) == 1
    return yes
  end
  let yes = false
  ensure value_class(yes) == 1
  return yes
end

# re + im i: re itself when im is zero.
make a function called complex_make takes re, im returns z
  require rt_is_real(re) and rt_is_real(im)
  if rt_is_zero(im) then
    let z = re
    ensure rt_is_number(z) and ((value_class(z) == 6) or rt_is_zero(im))
    return z
  end
  let block = rt_alloc(32)
  mem_init_value(block, 16, re)
  mem_init_value(block, 32, im)
  let z = value_make(rt_complex_heap_type(), block)
  ensure rt_is_number(z) and ((value_class(z) == 6) or rt_is_zero(im))
  return z
end

make a function called rt_complex_to_s takes z returns s
  require value_class(z) == 6
  let s = to_s(complex_re(z)) + "+" + to_s(complex_im(z)) + "i"
  ensure value_class(s) == 8
  return s
end

make a function called rt_sqrt_negative takes x returns z
  require rt_is_real(x)
  let z = complex_make(0, sqrt(op_neg(x)))
  ensure rt_is_number(z)
  return z
end

# ---- intervals ----

make a function called rt_interval_heap_type returns t
  let t = 4294967303
  ensure (word_and(t, 4294967295) == 7) and (word_and(t, 4294967296) != 0)
  return t
end

make a function called interval_make takes lo, hi returns z
  require rt_is_real(lo) and rt_is_real(hi) and (lo <= hi)
  let block = rt_alloc(32)
  mem_init_value(block, 16, lo)
  mem_init_value(block, 32, hi)
  let z = value_make(rt_interval_heap_type(), block)
  ensure value_class(z) == 7
  return z
end

# A real number counts as the interval from itself to itself.
make a function called interval_lo takes z returns v
  require rt_is_real(z) or (value_class(z) == 7)
  if value_class(z) == 7 then
    let v = mem_load_value(value_data(z), 16)
    ensure rt_is_real(v)
    return v
  end
  let v = z
  ensure rt_is_real(v)
  return v
end

make a function called interval_hi takes z returns v
  require rt_is_real(z) or (value_class(z) == 7)
  if value_class(z) == 7 then
    let v = mem_load_value(value_data(z), 32)
    ensure rt_is_real(v)
    return v
  end
  let v = z
  ensure rt_is_real(v)
  return v
end

make a function called rt_interval_to_s takes z returns s
  require value_class(z) == 7
  let s = "[" + to_s(interval_lo(z)) + "," + to_s(interval_hi(z)) + "]"
  ensure value_class(s) == 8
  return s
end

make a function called rt_real_min takes a, b returns r
  require rt_is_real(a) and rt_is_real(b)
  let r = a
  if b < a then
    let r = b
  end
  ensure (r <= a) and (r <= b)
  return r
end

make a function called rt_real_max takes a, b returns r
  require rt_is_real(a) and rt_is_real(b)
  let r = a
  if b > a then
    let r = b
  end
  ensure (r >= a) and (r >= b)
  return r
end

make a function called rt_interval_arith takes op, a, b returns r
  require (op >= 0) and (op <= 3) and rt_is_number(a) and rt_is_number(b)
  if (op == 3) or rt_has_class(a, b, 6) then
    let r = rt_fail_class(7)
    ensure value_class(r) == 7
    return r
  end
  let al = interval_lo(a)
  let ah = interval_hi(a)
  let bl = interval_lo(b)
  let bh = interval_hi(b)
  if op == 0 then
    let r = interval_make(al + bl, ah + bh)
    ensure value_class(r) == 7
    return r
  end
  if op == 1 then
    let r = interval_make(al - bh, ah - bl)
    ensure value_class(r) == 7
    return r
  end
  let p1 = al * bl
  let p2 = al * bh
  let p3 = ah * bl
  let p4 = ah * bh
  let r = interval_make(rt_real_min(rt_real_min(p1, p2), rt_real_min(p3, p4)), rt_real_max(rt_real_max(p1, p2), rt_real_max(p3, p4)))
  ensure value_class(r) == 7
  return r
end

# ---- the operators ----

make a function called rt_arith takes op, a, b returns r
  require (op >= 0) and (op <= 3) and rt_is_number(a) and rt_is_number(b)
  if rt_has_class(a, b, 7) then
    let r = rt_interval_arith(op, a, b)
    ensure rt_is_number(r)
    return r
  end
  if rt_has_class(a, b, 6) then
    let r = rt_complex_arith(op, a, b)
    ensure rt_is_number(r)
    return r
  end
  if rt_has_class(a, b, 3) then
    let x = rt_float_bits_of(a)
    let y = rt_float_bits_of(b)
    if op == 0 then
      let r = rt_float(float_add(x, y))
      ensure rt_is_number(r)
      return r
    end
    if op == 1 then
      let r = rt_float(float_sub(x, y))
      ensure rt_is_number(r)
      return r
    end
    if op == 2 then
      let r = rt_float(float_mul(x, y))
      ensure rt_is_number(r)
      return r
    end
    let r = rt_float(float_div(x, y))
    ensure rt_is_number(r)
    return r
  end
  if rt_has_class(a, b, 5) or (op == 3) then
    if op == 0 then
      let r = rational_add(a, b)
      ensure rt_is_number(r)
      return r
    end
    if op == 1 then
      let r = rational_sub(a, b)
      ensure rt_is_number(r)
      return r
    end
    if op == 2 then
      let r = rational_mul(a, b)
      ensure rt_is_number(r)
      return r
    end
    let r = rational_div(a, b)
    ensure rt_is_number(r)
    return r
  end
  if op == 0 then
    let r = int_add(a, b)
    ensure rt_is_number(r)
    return r
  end
  if op == 1 then
    let r = int_sub(a, b)
    ensure rt_is_number(r)
    return r
  end
  let r = int_mul(a, b)
  ensure rt_is_number(r)
  return r
end

make a function called rt_complex_arith takes op, a, b returns r
  require (op >= 0) and (op <= 3) and rt_is_number(a) and rt_is_number(b)
  let ar = complex_re(a)
  let ai = complex_im(a)
  let br = complex_re(b)
  let bi = complex_im(b)
  if op == 0 then
    let r = complex_make(ar + br, ai + bi)
    ensure rt_is_number(r)
    return r
  end
  if op == 1 then
    let r = complex_make(ar - br, ai - bi)
    ensure rt_is_number(r)
    return r
  end
  if op == 2 then
    let r = complex_make(ar * br - ai * bi, ar * bi + ai * br)
    ensure rt_is_number(r)
    return r
  end
  let r = rt_fail_class(6)
  ensure rt_is_number(r)
  return r
end

make a function called rt_check_numbers takes a, b returns r
  require value_live(a) and value_live(b)
  if (not rt_is_number(a)) or (not rt_is_number(b)) then
    rt_fail_class(value_class(a))
  end
  let r = 0
  ensure rt_is_number(a) and rt_is_number(b)
  return r
end

# A program's +: int's + raises its events once a handler for them is
# registered (rt_int_plus_events), and an object's + is its class's method.
# Everything else, and every + in a file declaring quiet_operators(), is
# op_add_quiet.
make a function called op_add takes a, b returns r
  require value_live(a) and value_live(b)
  if (value_class(a) == 2) and (value_class(b) == 2) and rt_event_flag(2) then
    let r = rt_int_plus_events(a, b)
    ensure value_live(r)
    return r
  end
  if rt_is_object(a) then
    let r = send(a, "+", b)
    ensure value_live(r)
    return r
  end
  let r = op_add_quiet(a, b)
  ensure value_live(r)
  return r
end

# A string on either side of +: the two values' texts joined.
make a function called op_add_quiet takes a, b returns r
  require value_live(a) and value_live(b)
  if rt_is_object(a) then
    let r = send(a, "+", b)
    ensure value_live(r)
    return r
  end
  if (value_class(a) == 8) or (value_class(b) == 8) then
    let r = str_concat(to_s(a), to_s(b))
    ensure value_live(r)
    return r
  end
  if (value_class(a) == 9) and (value_class(b) == 9) then
    let r = rt_list_concat(a, b)
    ensure value_live(r)
    return r
  end
  rt_check_numbers(a, b)
  let r = rt_arith(0, a, b)
  ensure value_live(r)
  return r
end

make a function called op_sub takes a, b returns r
  require value_live(a) and value_live(b)
  if rt_is_object(a) then
    let r = send(a, "-", b)
    ensure value_live(r)
    return r
  end
  rt_check_numbers(a, b)
  let r = rt_arith(1, a, b)
  ensure value_live(r)
  return r
end

make a function called op_mul takes a, b returns r
  require value_live(a) and value_live(b)
  if rt_is_object(a) then
    let r = send(a, "*", b)
    ensure value_live(r)
    return r
  end
  rt_check_numbers(a, b)
  let r = rt_arith(2, a, b)
  ensure value_live(r)
  return r
end

make a function called op_div takes a, b returns r
  require value_live(a) and value_live(b)
  if rt_is_object(a) then
    let r = send(a, "/", b)
    ensure value_live(r)
    return r
  end
  rt_check_numbers(a, b)
  let r = rt_arith(3, a, b)
  ensure value_live(r)
  return r
end

# The remainder, truncating: its sign is the dividend's.
make a function called op_mod takes a, b returns r
  require value_live(a) and value_live(b)
  rt_check_numbers(a, b)
  if rt_has_class(a, b, 7) then
    rt_fail_class(7)
  end
  if rt_has_class(a, b, 3) then
    let r = rt_float(extern_call_float("UCRTBASE.DLL", "fmod", rt_float_bits_of(a), rt_float_bits_of(b)))
    ensure value_live(r)
    return r
  end
  if rt_is_integer(a) and rt_is_integer(b) then
    if b == 0 then
      print("division by zero")
      let r = extern_call("KERNEL32.DLL", "ExitProcess", 74)
      ensure value_live(r)
      return r
    end
    let r = int_divmod(a, b)[1]
    ensure value_live(r)
    return r
  end
  # rationals: a - b * trunc(a / b)
  let q = rational_div(a, b)
  let t = q
  if value_class(q) == 5 then
    let t = int_divmod(rational_num(q), rational_den(q))[0]
  end
  let r = rational_sub(a, rational_mul(b, t))
  ensure value_live(r)
  return r
end

make a function called op_neg takes a returns r
  require value_live(a)
  let c = value_class(a)
  if (c == 2) or (c == 4) then
    let r = int_neg(a)
    ensure value_live(r)
    return r
  end
  if c == 3 then
    let r = rt_float(word_xor(value_data(a), 0 - 9223372036854775807 - 1))
    ensure value_live(r)
    return r
  end
  if c == 5 then
    let r = rational_make(int_neg(rational_num(a)), rational_den(a))
    ensure value_live(r)
    return r
  end
  if c == 6 then
    let r = complex_make(op_neg(complex_re(a)), op_neg(complex_im(a)))
    ensure value_live(r)
    return r
  end
  if c == 7 then
    let r = interval_make(op_neg(interval_hi(a)), op_neg(interval_lo(a)))
    ensure value_live(r)
    return r
  end
  let r = rt_fail_class(c)
  ensure value_live(r)
  return r
end

make a function called op_not takes a returns r
  require value_live(a)
  let r = not rt_truthy(a)
  ensure value_class(r) == 1
  return r
end

# A number's float bits, as an int.
make a function called float_to_bits takes v returns bits
  require rt_is_real(v)
  let word = rt_float_bits_of(v)
  # unsigned: the sign bit set makes it a bigint
  let bits = word
  if word < 0 then
    let bits = int_add(int_mul(word_shl(1, 32), word_shl(1, 32)), word)
  end
  ensure rt_is_integer(bits)
  return bits
end

# Whether a value counts as true where a condition reads it: unit, false, a
# zero, the empty string and the empty list do not.
make a function called rt_truthy takes v returns yes
  require value_live(v)
  let c = value_class(v)
  let yes = true
  if c == 0 then
    let yes = false
  elif (c == 1) or (c == 2) then
    let yes = value_data(v) != 0
  elif c == 3 then
    # either zero: the bits without the sign
    let yes = word_shl(value_data(v), 1) != 0
  elif c == 8 then
    let yes = str_len(v) > 0
  elif c == 9 then
    let yes = list_len(v) > 0
  end
  ensure value_class(yes) == 1
  return yes
end

# -1, 0 or 1 for two real numbers.
make a function called rt_real_cmp takes a, b returns c
  require rt_is_real(a) and rt_is_real(b)
  if rt_has_class(a, b, 3) then
    let x = rt_float_bits_of(a)
    let y = rt_float_bits_of(b)
    if float_lt(x, y) == 1 then
      let c = 0 - 1
      ensure (c == 0 - 1) or (c == 0) or (c == 1)
      return c
    end
    if float_lt(y, x) == 1 then
      let c = 1
      ensure (c == 0 - 1) or (c == 0) or (c == 1)
      return c
    end
    let c = 0
    ensure (c == 0 - 1) or (c == 0) or (c == 1)
    return c
  end
  if rt_has_class(a, b, 5) then
    let c = rational_cmp(a, b)
    ensure (c == 0 - 1) or (c == 0) or (c == 1)
    return c
  end
  let c = int_cmp(a, b)
  ensure (c == 0 - 1) or (c == 0) or (c == 1)
  return c
end

make a function called rt_check_reals takes a, b returns r
  require value_live(a) and value_live(b)
  if (not rt_is_real(a)) or (not rt_is_real(b)) then
    rt_fail_class(value_class(a))
  end
  let r = 0
  ensure rt_is_real(a) and rt_is_real(b)
  return r
end

make a function called op_lt takes a, b returns r
  require value_live(a) and value_live(b)
  if rt_is_object(a) then
    let r = send(a, "<", b)
    ensure value_live(r)
    return r
  end
  if (value_class(a) == 8) and (value_class(b) == 8) then
    let r = str_cmp(a, b) < 0
    ensure value_live(r)
    return r
  end
  rt_check_reals(a, b)
  let r = rt_real_cmp(a, b) < 0
  ensure value_live(r)
  return r
end

make a function called op_gt takes a, b returns r
  require value_live(a) and value_live(b)
  let r = op_lt(b, a)
  ensure value_live(r)
  return r
end

make a function called op_le takes a, b returns r
  require value_live(a) and value_live(b)
  let r = not op_lt(b, a)
  ensure value_live(r)
  return r
end

make a function called op_ge takes a, b returns r
  require value_live(a) and value_live(b)
  let r = not op_lt(a, b)
  ensure value_live(r)
  return r
end

make a function called op_eq takes a, b returns r
  require value_live(a) and value_live(b)
  let ca = value_class(a)
  let cb = value_class(b)
  if ca == cb then
    if ca == 8 then
      let r = str_eq(a, b)
      ensure value_class(r) == 1
      return r
    end
    if ca <= 1 then
      let r = value_data(a) == value_data(b)
      ensure value_class(r) == 1
      return r
    end
  end
  if rt_is_real(a) and rt_is_real(b) then
    let r = rt_real_cmp(a, b) == 0
    ensure value_class(r) == 1
    return r
  end
  if ((ca == 7) and (rt_is_real(b) or (cb == 7))) or ((cb == 7) and rt_is_real(a)) then
    let r = op_eq(interval_lo(a), interval_lo(b)) and op_eq(interval_hi(a), interval_hi(b))
    ensure value_class(r) == 1
    return r
  end
  if ca != cb then
    let r = false
    ensure value_class(r) == 1
    return r
  end
  if ca == 9 then
    let r = rt_list_eq(a, b)
    ensure value_class(r) == 1
    return r
  end
  if ca == 6 then
    let r = op_eq(complex_re(a), complex_re(b)) and op_eq(complex_im(a), complex_im(b))
    ensure value_class(r) == 1
    return r
  end
  let r = value_data(a) == value_data(b)
  ensure value_class(r) == 1
  return r
end

make a function called op_ne takes a, b returns r
  require value_live(a) and value_live(b)
  let r = not op_eq(a, b)
  ensure value_class(r) == 1
  return r
end

make a function called op_band takes a, b returns r
  require value_live(a) and value_live(b)
  let r = rt_fail_class(value_class(a))
  ensure false
  return r
end

make a function called op_bor takes a, b returns r
  require value_live(a) and value_live(b)
  let r = rt_fail_class(value_class(a))
  ensure false
  return r
end

make a function called op_bxor takes a, b returns r
  require value_live(a) and value_live(b)
  let r = rt_fail_class(value_class(a))
  ensure false
  return r
end

make a function called op_shl takes a, b returns r
  require value_live(a) and value_live(b)
  let r = rt_fail_class(value_class(a))
  ensure false
  return r
end

make a function called op_shr takes a, b returns r
  require value_live(a) and value_live(b)
  let r = rt_fail_class(value_class(a))
  ensure false
  return r
end

# sqrt of an exact non-negative number: the integer when it is a perfect
# square, else the float.
make a function called rt_sqrt_exact takes x returns r
  require rt_is_real(x) and (value_class(x) != 3)
  let f = extern_call_float("UCRTBASE.DLL", "sqrt", rt_float_bits_of(x))
  if rt_is_integer(x) and rt_float_bits_integral(f) then
    let root = float_to_int(f)
    if root * root == x then
      let r = root
      ensure rt_is_real(r)
      return r
    end
  end
  let r = rt_float(f)
  ensure rt_is_real(r)
  return r
end
