make a function called mod_make takes x, n returns m
  require (rt_is_integer(x) or (value_class(x) == 15)) and ((value_class(n) == 15) or (rt_is_integer(n) and (n >= 2)))
  # to a modulus 2^k, k up to 64: a word (spec 2.1). A word's residue reduced
  # modulo 2^k is its low k bits whichever modulus it had, and so is an int's.
  let k = 0
  if rt_mod_is_word(n) then
    let k = rt_modw_bits(n)
  elif value_class(n) == 2 then
    let k = rt_modw_pow2_bits(n)
  end
  if k > 0 then
    if rt_mod_is_word(x) then
      let m = value_make(rt_modw_type(k), word_and(value_data(x), rt_modw_mask(k)))
      ensure rt_mod_is_word(m)
      return m
    end
    if value_class(x) == 2 then
      let m = rt_modw_of_int(k, x)
      ensure rt_mod_is_word(m)
      return m
    end
  end
  if value_class(n) == 15 then
    # n's modulus, its header already worked out
    if value_class(x) == 15 then
      let m = rt_mod_convert(x, n)
    else
      let m = rt_mod_int_like(n, x)
    end
    ensure (value_class(m) == 15) and rt_mod_same_modulus(m, n)
    return m
  end
  if value_class(x) == 15 then
    let m = rt_mod_convert(x, mod_make(0, n))
    ensure (value_class(m) == 15) and (mod_modulus(m) == n)
    return m
  end
  # n's bits, and whether it is 2^k (n is public: this takes time from n)
  let nc = rt_exponent_limbs(n)
  let nb = rt_exponent_bits(n)
  let k = 0
  let ones = 0
  let i = 0
  while i < 32 * nc do
    if word_and(word_shr(mem_load(nb, 16 + 8 * word_shr(i, 5)), word_and(i, 31)), 1) == 1 then
      let k = i + 1
      let ones = ones + 1
    end
    let i = i + 1
  end
  let kind = 2
  if ones == 1 then
    # 2^k: a k-bit word, one bit shorter than n
    let kind = 0
    let k = k - 1
  elif word_and(mem_load(nb, 16), 1) == 1 then
    let kind = 1
  end
  let count = word_shr(k + 31, 5)
  let block = rt_alloc(48 + 24 * count)
  mem_init_value(block, 16, n)
  mem_store(block, 32, count)
  mem_store(block, 40, kind)
  mem_store(block, 48, k)
  let noff = 64 + 8 * count
  if kind == 0 then
    # a word's arithmetic masks to k bits and never reads n's limbs
    rt_lb_zero(block, noff, count)
  else
    rt_lb_copy(block, noff, nb, 16, count)
  end
  rt_lb_free(nb)
  let n0 = 0
  if kind == 1 then
    # -1/n modulo 2^32 by Newton's iteration, from n's lowest limb
    let low = mem_load(block, noff)
    let y = 1
    let i = 0
    while i < 5 do
      let y = word_and(word_mul(y, word_sub(2, word_and(word_mul(low, y), rt_mask32()))), rt_mask32())
      let i = i + 1
    end
    let n0 = word_and(word_sub(0, y), rt_mask32())
  end
  mem_store(block, 56, n0)
  rt_lb_zero(block, noff + 8 * count, count)
  if kind == 1 then
    # 2^(64 count) modulo n, by reducing it over 2 count + 1 limbs
    let big = rt_lb_new(2 * count + 1)
    mem_store(big, 16 + 16 * count, 1)
    rt_lb_reduce(block, noff + 8 * count, big, 16, 2 * count + 1, block, noff, count)
    rt_lb_free(big)
  end
  rt_mod_set_int(block, x)
  ct_secret(block)
  let m = rt_mod_wrap(block)
  ensure (value_class(m) == 15) and (mod_modulus(m) == n)
  return m
end

# The residue of the public integer x, as the block's kind keeps one, into a
# modint block whose header, modulus and 2^(64 count) modulo n are written:
# x's bits reduced over all its limbs, and for odd n then multiplied into
# Montgomery form.
make a function called rt_mod_set_int takes block, x returns r
  require (block != 0) and rt_is_integer(x)
  let count = rt_mod_header(block, 32)
  let kind = rt_mod_header(block, 40)
  let noff = 64 + 8 * count
  let xc = rt_exponent_limbs(x)
  let xb = rt_exponent_bits(x)
  let zero = rt_lb_new(count)
  if kind == 0 then
    rt_lb_zero(block, 64, count)
    if xc < count then
      rt_lb_copy(block, 64, xb, 16, xc)
    else
      rt_lb_copy(block, 64, xb, 16, count)
    end
    if x < 0 then
      rt_lb_sub(block, 64, zero, 16, block, 64, count)
    end
    rt_lb_mask_top(block, 64, count, rt_mod_header(block, 48))
  else
    if xc < count then
      # n has more than 32 (count - 1) bits and x at most 32 xc, so x is
      # already below n
      rt_lb_zero(block, 64, count)
      rt_lb_copy(block, 64, xb, 16, xc)
    else
      rt_lb_reduce(block, 64, xb, 16, xc, block, noff, count)
    end
    if kind == 1 then
      rt_lb_mont_mul(block, 64, block, 64, block, noff + 8 * count, block, noff, count, rt_mod_header(block, 56))
    end
    if x < 0 then
      rt_lb_sub_mod(block, 64, zero, 16, block, 64, block, noff, count)
    end
  end
  rt_lb_free(zero)
  rt_lb_free(xb)
  let r = 0
  ensure r == 0
  return r
end

# The modint like m holding the public integer x.
make a function called rt_mod_int_like takes m, x returns r
  require (value_class(m) == 15) and rt_is_integer(x)
  if rt_mod_is_word(m) and (value_class(x) == 2) then
    let r = rt_modw_like(m, rt_modw_secret(x))
    ensure rt_mod_is_word(r)
    return r
  end
  let block = rt_mod_like(rt_mod_box(m))
  rt_mod_set_int(block, x)
  let r = rt_mod_wrap(block)
  ensure (value_class(r) == 15) and (rt_mod_same_modulus(r, m))
  return r
end

# x's residue reduced modulo shape's modulus n, in steps fixed by x's modulus
# and n: the low k bits for n = 2^k, else a reduction over all of x's limbs.
make a function called rt_mod_convert takes x0, shape0 returns m
  require (value_class(x0) == 15) and (value_class(shape0) == 15)
  let x = rt_mod_box(x0)
  let shape = rt_mod_box(shape0)
  let count = rt_mod_limbs(shape)
  let sc = rt_mod_limbs(x)
  let plain = rt_mod_plain(x)
  let block = rt_mod_like(shape)
  let t = rt_lb_new(count)
  if rt_mod_kind(shape) == 0 then
    if sc < count then
      rt_lb_copy(t, 16, plain, 16, sc)
    else
      rt_lb_copy(t, 16, plain, 16, count)
    end
    rt_lb_mask_top(t, 16, count, rt_mod_word(shape, 48))
  else
    rt_lb_reduce(t, 16, plain, 16, sc, block, rt_mod_noff(shape), count)
  end
  rt_mod_store_plain(shape, block, 64, t, 16)
  rt_lb_free(t)
  rt_lb_free(plain)
  let m = rt_mod_wrap(block)
  ensure (value_class(m) == 15) and rt_mod_same_modulus(m, shape)
  return m
end

# m's residue as limbs in a new scratch array, out of Montgomery form.
make a function called rt_mod_plain takes m returns block
  require value_class(m) == 15
  let count = rt_mod_limbs(m)
  let src = value_data(m)
  let block = rt_lb_new(count)
  if rt_mod_kind(m) == 1 then
    let one = rt_lb_new(count)
    mem_store(one, 16, 1)
    rt_lb_mont_mul(block, 16, src, 64, one, 16, src, rt_mod_noff(m), count, rt_mod_word(m, 56))
    rt_lb_free(one)
  else
    rt_lb_copy(block, 16, src, 64, count)
  end
  ensure block != 0
  return block
end

# Plain limbs, below n, as m's kind keeps a residue, into d.
make a function called rt_mod_store_plain takes m, d, doff, plain, poff returns r
  require (value_class(m) == 15) and (d != 0) and (plain != 0)
  let count = rt_mod_limbs(m)
  if rt_mod_kind(m) == 1 then
    let src = value_data(m)
    rt_lb_mont_mul(d, doff, plain, poff, src, rt_mod_r2off(m), src, rt_mod_noff(m), count, rt_mod_word(m, 56))
  else
    rt_lb_copy(d, doff, plain, poff, count)
  end
  let r = 0
  ensure r == 0
  return r
end

# The residue, from 0 to n - 1: here it leaves the class, and the
# constant-time check reports it (spec 2.7).
make a function called mod_value takes m returns v
  require value_class(m) == 15
  if rt_mod_is_word(m) then
    let w = value_data(m)
    ct_reveal(w)
    let v = rt_modw_int(w)
    ensure rt_is_integer(v) and (v >= 0)
    return v
  end
  let plain = rt_mod_plain(m)
  ct_reveal(plain)
  let v = rt_mod_plain_int(plain, m)
  ensure rt_is_integer(v) and (v >= 0) and (v < mod_modulus(m))
  return v
end

# mod_value, where the program says the residue is to be public (an AEAD's
# tag check, a signature's verdict): the constant-time check lists it as a
# declared reveal, naming the function that called it, and does not report it.
make a function called mod_reveal takes m returns v
  require value_class(m) == 15
  if rt_mod_is_word(m) then
    let w = value_data(m)
    ct_declassify(w)
    let v = rt_modw_int(w)
    ensure rt_is_integer(v) and (v >= 0)
    return v
  end
  let plain = rt_mod_plain(m)
  ct_declassify(plain)
  let v = rt_mod_plain_int(plain, m)
  ensure rt_is_integer(v) and (v >= 0) and (v < mod_modulus(m))
  return v
end

# A word modint's residue, now public, as an integer: only a 64-bit word can
# have its top bit set, and that residue is a bigint.
make a function called rt_modw_int takes w returns v
  require value_class(w) == 2
  if word_shr(w, 63) == 1 then
    let v = word_shr(w, 32) * 4294967296 + word_and(w, rt_mask32())
  else
    let v = w
  end
  ensure rt_is_integer(v) and (v >= 0)
  return v
end

# A block modint's plain residue (rt_mod_plain), now public, as an integer;
# the copy is freed.
make a function called rt_mod_plain_int takes plain, m returns v
  require (plain != 0) and (value_class(m) == 15)
  let count = rt_mod_limbs(m)
  let v = 0
  let i = count - 1
  while i >= 0 do
    let v = v * 4294967296 + mem_load(plain, 16 + 8 * i)
    let i = i - 1
  end
  rt_lb_free(plain)
  ensure rt_is_integer(v) and (v >= 0)
  return v
end

make a function called rt_modint_to_s takes m returns s
  require value_class(m) == 15
  let s = to_s(mod_value(m)) + " mod " + to_s(mod_modulus(m))
  ensure value_class(s) == 8
  return s
end

# ---- the operations ----

# Whichever operand is a modint, a when both are.
make a function called rt_mod_template takes a, b returns t
  require (value_class(a) == 15) or (value_class(b) == 15)
  if value_class(a) == 15 then
    let t = a
  else
    let t = b
  end
  ensure value_class(t) == 15
  return t
end

# v as a modint modulo n: itself when it is one with that modulus, an integer
# reduced (spec 1.14). Anything else stops the program, naming the class.
make a function called rt_mod_operand takes v, t returns m
  require value_live(v) and (value_class(t) == 15)
  if value_class(v) == 15 then
    if not rt_mod_same_modulus(v, t) then
      rt_fail_class(15)
    end
    # as a block: what takes an operand from here reads its block
    let m = rt_mod_box(v)
    ensure value_class(m) == 15
    return m
  end
  if not rt_is_integer(v) then
    rt_fail_class(15)
  end
  let m = rt_mod_box(rt_mod_int_like(t, v))
  ensure value_class(m) == 15
  return m
end

# a * b for modints of one modulus, into d's residue.
make a function called rt_mod_mul_into takes d, a, b returns r
  require (d != 0) and (value_class(a) == 15) and (value_class(b) == 15)
  let count = rt_mod_limbs(a)
  let pa = value_data(a)
  let pb = value_data(b)
  let noff = rt_mod_noff(a)
  let kind = rt_mod_kind(a)
  if kind == 1 then
    rt_lb_mont_mul(d, 64, pa, 64, pb, 64, pa, noff, count, rt_mod_word(a, 56))
  elif kind == 0 then
    let p = rt_lb_new(2 * count)
    rt_lb_mul_full(p, 16, pa, 64, pb, 64, count)
    rt_lb_copy(d, 64, p, 16, count)
    rt_lb_mask_top(d, 64, count, rt_mod_word(a, 48))
    rt_lb_free(p)
  else
    rt_lb_mul_mod(d, 64, pa, 64, pb, 64, pa, noff, count)
  end
  let r = 0
  ensure r == 0
  return r
end

make a function called rt_modint_arith takes op, a, b returns r
  require (op >= 0) and (op <= 3) and ((value_class(a) == 15) or (value_class(b) == 15))
  if (op <= 2) and rt_modw_fits(a, b) then
    let wa = rt_modw_w(a)
    let wb = rt_modw_w(b)
    if op == 0 then
      let w = word_add(wa, wb)
    elif op == 1 then
      let w = word_sub(wa, wb)
    else
      let w = word_mul(wa, wb)
    end
    let r = rt_modw_like(rt_modw_template(a, b), w)
    ensure rt_mod_is_word(r)
    return r
  end
  let x = rt_mod_operand(a, rt_mod_template(a, b))
  let y = rt_mod_operand(b, rt_mod_template(a, b))
  if op == 3 then
    let y = rt_mod_box(rt_mod_inverse(y))
  end
  let count = rt_mod_limbs(x)
  let px = value_data(x)
  let py = value_data(y)
  let block = rt_mod_like(x)
  if op == 0 then
    if rt_mod_kind(x) == 0 then
      rt_lb_add(block, 64, px, 64, py, 64, count)
      rt_lb_mask_top(block, 64, count, rt_mod_word(x, 48))
    else
      rt_lb_add_mod(block, 64, px, 64, py, 64, px, rt_mod_noff(x), count)
    end
  elif op == 1 then
    if rt_mod_kind(x) == 0 then
      rt_lb_sub(block, 64, px, 64, py, 64, count)
      rt_lb_mask_top(block, 64, count, rt_mod_word(x, 48))
    else
      rt_lb_sub_mod(block, 64, px, 64, py, 64, px, rt_mod_noff(x), count)
    end
  else
    rt_mod_mul_into(block, x, y)
  end
  let r = rt_mod_wrap(block)
  ensure (value_class(r) == 15) and rt_mod_same_modulus(r, rt_mod_template(a, b))
  return r
end

make a function called rt_modint_neg takes a returns r
  require value_class(a) == 15
  if rt_mod_is_word(a) then
    let r = rt_modw_like(a, word_sub(0, value_data(a)))
    ensure rt_mod_is_word(r)
    return r
  end
  let count = rt_mod_limbs(a)
  let pa = value_data(a)
  let block = rt_mod_like(a)
  # block's residue is zero: 0 - a
  if rt_mod_kind(a) == 0 then
    rt_lb_sub(block, 64, block, 64, pa, 64, count)
    rt_lb_mask_top(block, 64, count, rt_mod_word(a, 48))
  else
    rt_lb_sub_mod(block, 64, block, 64, pa, 64, pa, rt_mod_noff(a), count)
  end
  let r = rt_mod_wrap(block)
  ensure (value_class(r) == 15) and (rt_mod_same_modulus(r, a))
  return r
end

# Two modints of one modulus are equal when their residues are: a bool, from
# every limb.
make a function called rt_modint_eq takes a, b returns yes
  require (value_class(a) == 15) and (value_class(b) == 15)
  let count = rt_mod_limbs(a)
  let pa = value_data(a)
  let pb = value_data(b)
  let acc = 0
  let i = 0
  while i < count do
    let acc = word_or(acc, word_xor(mem_load(pa, 64 + 8 * i), mem_load(pb, 64 + 8 * i)))
    let i = i + 1
  end
  let yes = acc == 0
  ensure value_class(yes) == 1
  return yes
end

# ---- inverses: steps fixed by n ----

# 1/a modulo n by the extended Euclidean algorithm, for public a and n only:
# its time depends on them. a must have an inverse.
make a function called rt_int_inverse_public takes a, n returns inv
  require rt_is_integer(a) and rt_is_integer(n) and (a >= 0) and (a < n)
  let old_r = a
  let r = n
  let old_s = 1
  let s = 0
  while r != 0 do
    let q = int_divmod(old_r, r)[0]
    let next_r = old_r - q * r
    let old_r = r
    let r = next_r
    let next_s = old_s - q * s
    let old_s = s
    let s = next_s
  end
  let inv = rt_mod_reduce(old_s, n)
  ensure (old_r == 1) and (rt_mod_reduce(inv * a, n) == 1)
  return inv
end

# Möller's binary inversion modulo an odd modulus (as GMP's mpn_sec_invert):
# v = 1/x modulo the count-limb odd n at noff, x below n, in 2 * bits steps.
# 1 when x has an inverse, else 0.
make a function called rt_lb_invert_odd takes v, voff, x, xoff, n, noff, count, bits returns ok
  require (v != 0) and (x != 0) and (n != 0) and (count >= 1) and (bits >= 1)
  let a = rt_lb_new(count)
  let b = rt_lb_new(count)
  let u = rt_lb_new(count)
  let w = rt_lb_new(count)
  let diff = rt_lb_new(count)
  rt_lb_copy(a, 16, x, xoff, count)
  rt_lb_copy(b, 16, n, noff, count)
  mem_store(u, 16, 1)
  let step = 0
  while step < 2 * bits do
    let odd = word_and(mem_load(a, 16), 1)
    # when a is odd and below b, exchange a with b and u with w
    let below = rt_lb_sub(diff, 16, a, 16, b, 16, count)
    let swap = word_and(odd, below)
    rt_lb_cswap(a, 16, b, 16, count, swap)
    rt_lb_cswap(u, 16, w, 16, count, swap)
    # when a is odd, a = a - b and u = u - w modulo n
    rt_lb_sub(diff, 16, a, 16, b, 16, count)
    rt_lb_select(a, 16, diff, 16, a, 16, count, odd)
    rt_lb_sub_mod(diff, 16, u, 16, w, 16, n, noff, count)
    rt_lb_select(u, 16, diff, 16, u, 16, count, odd)
    # a = a / 2, and u = u / 2 modulo n: u + n first when u is odd
    rt_lb_half(a, 16, count, 0)
    let uodd = word_and(mem_load(u, 16), 1)
    let carry = rt_lb_add(diff, 16, u, 16, n, noff, count)
    rt_lb_select(u, 16, diff, 16, u, 16, count, uodd)
    rt_lb_half(u, 16, count, word_and(carry, uodd))
    let step = step + 1
  end
  # b is now the gcd; w the inverse when it is 1
  let ok = rt_lb_is_zero(a, 16, count)
  mem_store(b, 16, word_xor(mem_load(b, 16), 1))
  let ok = word_and(ok, rt_lb_is_zero(b, 16, count))
  rt_lb_copy(v, voff, w, 16, count)
  rt_lb_free(a)
  rt_lb_free(b)
  rt_lb_free(u)
  rt_lb_free(w)
  rt_lb_free(diff)
  ensure word_shr(ok, 1) == 0
  return ok
end

# y = 1/x modulo 2^k by Newton's iteration, y = y (2 - x y), each step
# doubling the bits that are right; x odd. count limbs.
make a function called rt_lb_invert_pow2 takes y, yoff, x, xoff, count, k returns r
  require (y != 0) and (x != 0) and (count >= 1) and (k >= 1)
  let t = rt_lb_new(count)
  let p = rt_lb_new(2 * count)
  let two = rt_lb_new(count)
  mem_store(two, 16, 2)
  rt_lb_copy(y, yoff, x, xoff, count)
  # an odd x is its own inverse modulo 8
  let good = 3
  while good < k do
    rt_lb_mul_full(p, 16, x, xoff, y, yoff, count)
    rt_lb_sub(t, 16, two, 16, p, 16, count)
    rt_lb_mul_full(p, 16, y, yoff, t, 16, count)
    rt_lb_copy(y, yoff, p, 16, count)
    let good = good * 2
  end
  rt_lb_mask_bits(y, yoff, count, k)
  rt_lb_free(t)
  rt_lb_free(p)
  rt_lb_free(two)
  let r = 0
  ensure r == 0
  return r
end

# The inverse of m: for an odd n by rt_lb_invert_odd; for 2^k by Newton's
# iteration; for 2^s times an odd part q above 1, the two combined by the
# Chinese remainder theorem. No inverse stops the program.
make a function called rt_mod_inverse takes m0 returns r
  require value_class(m0) == 15
  let m = rt_mod_box(m0)
  let count = rt_mod_limbs(m)
  let kind = rt_mod_kind(m)
  let k = rt_mod_word(m, 48)
  let n = mod_modulus(m)
  let pm = value_data(m)
  let plain = rt_mod_plain(m)
  let inv = rt_lb_new(count)
  let ok = 0
  if kind == 1 then
    let ok = rt_lb_invert_odd(inv, 16, plain, 16, pm, rt_mod_noff(m), count, k)
  elif kind == 0 then
    let ok = word_and(mem_load(plain, 16), 1)
    rt_lb_invert_pow2(inv, 16, plain, 16, count, k)
  else
    let ok = rt_mod_inverse_split(inv, plain, n, count)
  end
  if ok == 0 then
    rt_fail_class(15)
  end
  let block = rt_mod_like(m)
  rt_mod_store_plain(m, block, 64, inv, 16)
  rt_lb_free(plain)
  rt_lb_free(inv)
  let r = rt_mod_wrap(block)
  ensure (value_class(r) == 15) and (mod_modulus(r) == n)
  return r
end

# For n = 2^s q, q odd and above 1: inv = 1/x modulo n, from y = 1/x modulo 2^s
# and z = 1/x modulo q, as y + 2^s ((z - y) / 2^s modulo q). 1 when x has an
# inverse, else 0. s, q and 1/2^s modulo q come from n alone.
make a function called rt_mod_inverse_split takes inv, x, n, count returns ok
  require (inv != 0) and (x != 0) and rt_is_integer(n) and (count >= 1)
  let s = 0
  let q = n
  while int_divmod(q, 2)[1] == 0 do
    let q = int_divmod(q, 2)[0]
    let s = s + 1
  end
  let c = rt_int_inverse_public(rt_mod_reduce(rt_pow_exact(2, s), q), q)
  # q's limbs, with count of them (the upper ones zero)
  let qb = rt_lb_new(count)
  rt_lb_from_int(qb, 16, q, count)
  let qbits = 0
  let p = 1
  while p <= q do
    let p = p * 2
    let qbits = qbits + 1
  end
  let cb = rt_lb_new(count)
  rt_lb_from_int(cb, 16, c, count)
  # y = 1/x modulo 2^s
  let x2 = rt_lb_new(count)
  rt_lb_copy(x2, 16, x, 16, count)
  rt_lb_mask_bits(x2, 16, count, s)
  let y = rt_lb_new(count)
  rt_lb_invert_pow2(y, 16, x2, 16, count, s)
  let ok = word_and(mem_load(x, 16), 1)
  # z = 1/x modulo q
  let xq = rt_lb_new(count)
  rt_lb_reduce(xq, 16, x, 16, count, qb, 16, count)
  let z = rt_lb_new(count)
  let ok = word_and(ok, rt_lb_invert_odd(z, 16, xq, 16, qb, 16, count, qbits))
  # t = (z - y) c modulo q
  let yq = rt_lb_new(count)
  rt_lb_reduce(yq, 16, y, 16, count, qb, 16, count)
  let t = rt_lb_new(count)
  rt_lb_sub_mod(t, 16, z, 16, yq, 16, qb, 16, count)
  rt_lb_mul_mod(t, 16, t, 16, cb, 16, qb, 16, count)
  # inv = y + t 2^s, below n
  let shifted = rt_lb_new(2 * count)
  let pow = rt_lb_new(count)
  rt_lb_from_int(pow, 16, rt_pow_exact(2, s), count)
  rt_lb_mul_full(shifted, 16, t, 16, pow, 16, count)
  rt_lb_add(inv, 16, shifted, 16, y, 16, count)
  rt_lb_free(qb)
  rt_lb_free(cb)
  rt_lb_free(x2)
  rt_lb_free(y)
  rt_lb_free(xq)
  rt_lb_free(z)
  rt_lb_free(yq)
  rt_lb_free(t)
  rt_lb_free(shifted)
  rt_lb_free(pow)
  ensure word_shr(ok, 1) == 0
  return ok
end

# ---- powers: a ladder, the same steps for every exponent of one size ----

# How many 32-bit limbs rt_exponent_bits gives for e: 2 for an int, and for a
# bigint enough for its base-10^9 limbs. It depends on e's size alone.
make a function called rt_exponent_limbs takes e returns count
  require rt_is_integer(e)
  if value_class(e) == 2 then
    let count = 2
    ensure count == 2
    return count
  end
  let count = word_shr(30 * list_len(mem_load_value(value_data(e), 24)), 5) + 2
  ensure count >= 2
  return count
end

# The bits of an integer's magnitude as rt_exponent_limbs(e) 32-bit limbs in a
# new scratch array, built by the same steps for any integer of that size.
make a function called rt_exponent_bits takes e returns block
  require rt_is_integer(e)
  let count = rt_exponent_limbs(e)
  if value_class(e) == 2 then
    let mag = e
    if e < 0 then
      let mag = word_sub(0, e)
    end
    let block = rt_lb_new(count)
    mem_store(block, 16, word_and(mag, rt_mask32()))
    mem_store(block, 24, word_shr(mag, 32))
    ensure block != 0
    return block
  end
  let digits = mem_load_value(value_data(e), 24)
  let nd = list_len(digits)
  let block = rt_lb_new(count)
  let i = nd - 1
  while i >= 0 do
    # block = block * 10^9 + digits[i]
    let carry = digits[i]
    let j = 0
    while j < count do
      let x = word_add(word_mul(mem_load(block, 16 + 8 * j), 1000000000), carry)
      mem_store(block, 16 + 8 * j, word_and(x, rt_mask32()))
      let carry = word_shr(x, 32)
      let j = j + 1
    end
    let i = i - 1
  end
  ensure block != 0
  return block
end

# m to the integer power e (spec 1.14): the inverse's power for e below 0.
make a function called rt_modint_pow takes m, e returns r
  require (value_class(m) == 15) and value_live(e)
  if not rt_is_integer(e) then
    rt_fail_class(15)
  end
  if rt_mod_is_word(m) then
    let r = rt_modw_pow(m, e)
    ensure rt_mod_is_word(r)
    return r
  end
  let base = m
  if e < 0 then
    let base = rt_mod_inverse(m)
  end
  let eb = rt_exponent_bits(e)
  let ecount = rt_exponent_limbs(e)
  # m is a block (a word took the path above), so its modulus is not one a
  # word holds, and the ladder works on blocks throughout: rt_mod_box gives
  # a block back as it is, and the steps' results are rt_mod_held
  let r0 = rt_mod_box(rt_mod_int_like(m, 1))
  let r1 = rt_mod_box(base)
  let i = 32 * ecount - 1
  while i >= 0 do
    let bit = word_and(word_shr(mem_load(eb, 16 + 8 * word_shr(i, 5)), word_and(i, 31)), 1)
    let count = rt_mod_limbs(m)
    let p0 = value_data(r0)
    let p1 = value_data(r1)
    # the ladder step on copies, exchanged when the bit is 1
    let a0 = rt_mod_like(m)
    let a1 = rt_mod_like(m)
    rt_lb_copy(a0, 64, p0, 64, count)
    rt_lb_copy(a1, 64, p1, 64, count)
    rt_lb_cswap(a0, 64, a1, 64, count, bit)
    let x0 = rt_mod_held(a0)
    let x1 = rt_mod_held(a1)
    let n1 = rt_mod_like(m)
    let n0 = rt_mod_like(m)
    rt_mod_mul_into(n1, x0, x1)
    rt_mod_mul_into(n0, x0, x0)
    rt_lb_cswap(n0, 64, n1, 64, count, bit)
    let r0 = rt_mod_held(n0)
    let r1 = rt_mod_held(n1)
    let i = i - 1
  end
  rt_lb_free(eb)
  let r = r0
  ensure (value_class(r) == 15) and (rt_mod_same_modulus(r, m))
  return r
end

# ---- words: n = 2^k, k up to 64 ----

# w shifted left or right by s, from 0 to 64, in two shifts of at most 32
# (a machine shift takes its count modulo 64).
make a function called rt_word_shl_full takes w, s returns r
  require (value_class(w) == 2) and (s >= 0) and (s <= 64)
  let h = word_shr(s, 1)
  let r = word_shl(word_shl(w, h), s - h)
  ensure value_class(r) == 2
  return r
end

make a function called rt_word_shr_full takes w, s returns r
  require (value_class(w) == 2) and (s >= 0) and (s <= 64)
  let h = word_shr(s, 1)
  let r = word_shr(word_shr(w, h), s - h)
  ensure value_class(r) == 2
  return r
end

# k when m's modulus is 2^k, for k from 1 to 64; any other modulus stops the
# program, naming the modint class.
make a function called rt_mod_bits takes m returns k
  require value_class(m) == 15
  let k = rt_mod_word(m, 48)
  if (rt_mod_kind(m) != 0) or (k > 64) then
    rt_fail_class(15)
  end
  ensure (k >= 1) and (k <= 64)
  return k
end

# The word of a k-bit modint, k up to 64, as one machine word.
make a function called rt_mod_word_of takes m returns w
  require value_class(m) == 15
  let p = value_data(m)
  let w = mem_load(p, 64)
  if rt_mod_limbs(m) > 1 then
    let w = word_or(w, word_shl(mem_load(p, 72), 32))
  end
  ensure value_class(w) == 2
  return w
end

# A modint like m holding the k-bit word w.
make a function called rt_mod_of_word takes m, w returns r
  require (value_class(m) == 15) and (value_class(w) == 2)
  let block = rt_mod_like(m)
  mem_store(block, 64, word_and(w, rt_mask32()))
  if rt_mod_limbs(m) > 1 then
    mem_store(block, 72, word_shr(w, 32))
  end
  rt_lb_mask_top(block, 64, rt_mod_limbs(m), rt_mod_word(m, 48))
  let r = rt_mod_wrap(block)
  ensure value_class(r) == 15
  return r
end

# band, bor and bxor (op 0, 1, 2) of two k-bit words.
make a function called rt_modint_bitwise takes op, a, b returns r
  require (op >= 0) and (op <= 2) and ((value_class(a) == 15) or (value_class(b) == 15))
  if rt_modw_fits(a, b) then
    let wa = rt_modw_w(a)
    let wb = rt_modw_w(b)
    if op == 0 then
      let w = word_and(wa, wb)
    elif op == 1 then
      let w = word_or(wa, wb)
    else
      let w = word_xor(wa, wb)
    end
    let r = rt_modw_like(rt_modw_template(a, b), w)
    ensure rt_mod_is_word(r)
    return r
  end
  let x = rt_mod_operand(a, rt_mod_template(a, b))
  let y = rt_mod_operand(b, rt_mod_template(a, b))
  rt_mod_bits(x)
  let wx = rt_mod_word_of(x)
  let wy = rt_mod_word_of(y)
  if op == 0 then
    let w = word_and(wx, wy)
  elif op == 1 then
    let w = word_or(wx, wy)
  else
    let w = word_xor(wx, wy)
  end
  let r = rt_mod_of_word(x, w)
  ensure (value_class(r) == 15) and rt_mod_same_modulus(r, rt_mod_template(a, b))
  return r
end

make a function called rt_modint_bnot takes a returns r
  require value_class(a) == 15
  if rt_mod_is_word(a) then
    let r = rt_modw_like(a, word_xor(value_data(a), word_sub(0, 1)))
    ensure rt_mod_is_word(r)
    return r
  end
  let k = rt_mod_bits(a)
  let r = rt_mod_of_word(a, word_xor(rt_mod_word_of(a), rt_word_shr_full(word_sub(0, 1), 64 - k)))
  ensure (value_class(r) == 15) and (rt_mod_same_modulus(r, a))
  return r
end

# The count of a shift or rotation of the word m: an int from 0 to k.
make a function called rt_mod_count takes m, s returns k
  require (value_class(m) == 15) and value_live(s)
  let k = rt_mod_bits(m)
  if (value_class(s) != 2) or (s < 0) or (s > k) then
    rt_fail_class(15)
  end
  ensure (k >= 1) and (k <= 64) and (s >= 0) and (s <= k)
  return k
end

# shl and shr (op 0, 1): the bits shifted out lost, zeros shifted in.
make a function called rt_modint_shift takes op, m, s returns r
  require ((op == 0) or (op == 1)) and value_live(m) and value_live(s)
  if value_class(m) != 15 then
    rt_fail_class(15)
  end
  if rt_mod_is_word(m) then
    let k = rt_modw_count(m, s)
    if op == 0 then
      let r = rt_modw_like(m, rt_word_shl_full(value_data(m), s))
    else
      let r = rt_modw_like(m, rt_word_shr_full(value_data(m), s))
    end
    ensure rt_mod_is_word(r)
    return r
  end
  rt_mod_count(m, s)
  if op == 0 then
    let r = rt_mod_of_word(m, rt_word_shl_full(rt_mod_word_of(m), s))
  else
    let r = rt_mod_of_word(m, rt_word_shr_full(rt_mod_word_of(m), s))
  end
  ensure (value_class(r) == 15) and (rt_mod_same_modulus(r, m))
  return r
end

make a function called rotl takes m, s returns r
  require (value_class(m) == 15) and value_live(s)
  # a word: everything here, with no call, for a cipher's inner loop. Its type
  # word is not a block's (rt_modint_heap_type), asked as rt_mod_is_word asks
  let t = value_type_word(m)
  if t != 4294967311 then
    let k = word_and(word_shr(t, 40), 127)
    if (value_class(s) != 2) or (s < 0) or (s > k) then
      rt_fail_class(15)
    end
    let w = value_data(m)
    # w shl s and w shr (k - s), each in two machine shifts (a machine shift
    # takes its count modulo 64, and either count may be 64)
    let hl = word_shr(s, 1)
    let hr = word_shr(k - s, 1)
    let x = word_or(word_shl(word_shl(w, hl), s - hl), word_shr(word_shr(w, hr), k - s - hr))
    if k < 64 then
      let x = word_and(x, word_sub(word_shl(1, k), 1))
    end
    let r = value_make(t, x)
    ensure rt_mod_is_word(r)
    return r
  end
  let k = rt_mod_count(m, s)
  let w = rt_mod_word_of(m)
  let r = rt_mod_of_word(m, word_or(rt_word_shl_full(w, s), rt_word_shr_full(w, k - s)))
  ensure (value_class(r) == 15) and (rt_mod_same_modulus(r, m))
  return r
end

make a function called rotr takes m, s returns r
  require (value_class(m) == 15) and value_live(s)
  if rt_mod_is_word(m) then
    let k = rt_modw_count(m, s)
    let r = rotl(m, k - s)
    ensure rt_mod_is_word(r)
    return r
  end
  let k = rt_mod_count(m, s)
  let r = rotl(m, k - s)
  ensure (value_class(r) == 15) and (rt_mod_same_modulus(r, m))
  return r
end

# ---- the operators ----

make a function called rt_arith takes op, a, b returns r
  require (op >= 0) and (op <= 3) and rt_is_number(a) and rt_is_number(b)
  if rt_has_class(a, b, 7) then
    let r = rt_interval_arith(op, a, b)
    ensure rt_is_number(r)
    return r
  end
  if rt_has_class(a, b, 6) then
    let r = rt_complex_arith(op, a, b)
    ensure rt_is_number(r)
    return r
  end
  if rt_has_class(a, b, 3) then
    let x = rt_float_bits_of(a)
    let y = rt_float_bits_of(b)
    if op == 0 then
      let r = rt_float(float_add(x, y))
      ensure rt_is_number(r)
      return r
    end
    if op == 1 then
      let r = rt_float(float_sub(x, y))
      ensure rt_is_number(r)
      return r
    end
    if op == 2 then
      let r = rt_float(float_mul(x, y))
      ensure rt_is_number(r)
      return r
    end
    let r = rt_float(float_div(x, y))
    ensure rt_is_number(r)
    return r
  end
  if rt_has_class(a, b, 5) or (op == 3) then
    if op == 0 then
      let r = rational_add(a, b)
      ensure rt_is_number(r)
      return r
    end
    if op == 1 then
      let r = rational_sub(a, b)
      ensure rt_is_number(r)
      return r
    end
    if op == 2 then
      let r = rational_mul(a, b)
      ensure rt_is_number(r)
      return r
    end
    let r = rational_div(a, b)
    ensure rt_is_number(r)
    return r
  end
  if op == 0 then
    let r = int_add(a, b)
    ensure rt_is_number(r)
    return r
  end
  if op == 1 then
    let r = int_sub(a, b)
    ensure rt_is_number(r)
    return r
  end
  let r = int_mul(a, b)
  ensure rt_is_number(r)
  return r
end

make a function called rt_complex_arith takes op, a, b returns r
  require (op >= 0) and (op <= 3) and rt_is_number(a) and rt_is_number(b)
  let ar = complex_re(a)
  let ai = complex_im(a)
  let br = complex_re(b)
  let bi = complex_im(b)
  if op == 0 then
    let r = complex_make(ar + br, ai + bi)
    ensure rt_is_number(r)
    return r
  end
  if op == 1 then
    let r = complex_make(ar - br, ai - bi)
    ensure rt_is_number(r)
    return r
  end
  if op == 2 then
    let r = complex_make(ar * br - ai * bi, ar * bi + ai * br)
    ensure rt_is_number(r)
    return r
  end
  let r = rt_fail_class(6)
  ensure rt_is_number(r)
  return r
end

make a function called rt_check_numbers takes a, b returns r
  require value_live(a) and value_live(b)
  if (not rt_is_number(a)) or (not rt_is_number(b)) then
    rt_fail_class(value_class(a))
  end
  let r = 0
  ensure rt_is_number(a) and rt_is_number(b)
  return r
end

# A program's +: int's + raises its events once a handler for them is
# registered (rt_int_plus_events), and an object's + is its class's method.
# Everything else, and every + in a file declaring quiet_operators(), is
# op_add_quiet. Two ints with no handler add as a compiled + does, the
# runtime's own + being quiet: the interpreter's + comes here every time.
make a function called op_add takes a, b returns r
  require value_live(a) and value_live(b)
  if (value_class(a) == 2) and (value_class(b) == 2) then
    if rt_event_flag(2) then
      let r = rt_int_plus_events(a, b)
      ensure value_live(r)
      return r
    end
    let r = a + b
    ensure value_live(r)
    return r
  end
  if rt_is_object(a) then
    let r = send(a, "+", b)
    ensure value_live(r)
    return r
  end
  let r = op_add_quiet(a, b)
  ensure value_live(r)
  return r
end

# let s = s + x, with s moved out: a count of 1 says nothing else holds a string,
# so it grows in place, in a block with room to spare. A string literal's count
# is 0, and a block with no room gets twice what is needed, so n appends copy
# about 2n bytes in all.
make a function called op_add_taken takes a, b returns r
  require value_live(a) and value_live(b)
  if value_class(a) == 8 then
    let text = to_s(b)
    let la = str_len(a)
    let lb = str_len(text)
    let block = value_data(a)
    if (mem_load(block, 0) == 1) and (la + lb <= mem_load(block, 8) - 32) then
      rt_copy_bytes(block + 32 + la, rt_str_bytes(text), lb)
      mem_store(block, 16, la + lb)
      mem_store(block, 24, 0 - 1)
      let r = a
      ensure value_class(r) == 8
      return r
    end
    let grown = rt_str_alloc(2 * (la + lb))
    mem_store(grown, 16, la + lb)
    rt_copy_bytes(grown + 32, rt_str_bytes(a), la)
    rt_copy_bytes(grown + 32 + la, rt_str_bytes(text), lb)
    let r = value_make(rt_string_heap_type(), grown)
    ensure value_class(r) == 8
    return r
  end
  let r = op_add(a, b)
  ensure value_live(r)
  return r
end

# A string on either side of +: the two values' texts joined.
make a function called op_add_quiet takes a, b returns r
  require value_live(a) and value_live(b)
  if rt_is_object(a) then
    let r = send(a, "+", b)
    ensure value_live(r)
    return r
  end
  if (value_class(a) == 8) or (value_class(b) == 8) then
    let r = str_concat(to_s(a), to_s(b))
    ensure value_live(r)
    return r
  end
  if (value_class(a) == 9) and (value_class(b) == 9) then
    let r = rt_list_concat(a, b)
    ensure value_live(r)
    return r
  end
  if rt_has_class(a, b, 15) then
    let r = rt_modint_arith(0, a, b)
    ensure value_live(r)
    return r
  end
  rt_check_numbers(a, b)
  let r = rt_arith(0, a, b)
  ensure value_live(r)
  return r
end

make a function called op_sub takes a, b returns r
  require value_live(a) and value_live(b)
  if rt_is_object(a) then
    let r = send(a, "-", b)
    ensure value_live(r)
    return r
  end
  if rt_has_class(a, b, 15) then
    let r = rt_modint_arith(1, a, b)
    ensure value_live(r)
    return r
  end
  rt_check_numbers(a, b)
  let r = rt_arith(1, a, b)
  ensure value_live(r)
  return r
end

make a function called op_mul takes a, b returns r
  require value_live(a) and value_live(b)
  if rt_is_object(a) then
    let r = send(a, "*", b)
    ensure value_live(r)
    return r
  end
  if rt_has_class(a, b, 15) then
    let r = rt_modint_arith(2, a, b)
    ensure value_live(r)
    return r
  end
  rt_check_numbers(a, b)
  let r = rt_arith(2, a, b)
  ensure value_live(r)
  return r
end

make a function called op_div takes a, b returns r
  require value_live(a) and value_live(b)
  if rt_is_object(a) then
    let r = send(a, "/", b)
    ensure value_live(r)
    return r
  end
  if rt_has_class(a, b, 15) then
    let r = rt_modint_arith(3, a, b)
    ensure value_live(r)
    return r
  end
  rt_check_numbers(a, b)
  # an exact number over an exact zero has no value (a float's is IEEE's)
  if rt_is_integer(b) and (b == 0) and (rt_is_integer(a) or (value_class(a) == 5)) then
    print("division by zero")
    let r = rt_stop(74)
    ensure value_live(r)
    return r
  end
  let r = rt_arith(3, a, b)
  ensure value_live(r)
  return r
end

# The remainder, truncating: its sign is the dividend's.
make a function called op_mod takes a, b returns r
  require value_live(a) and value_live(b)
  if rt_has_class(a, b, 15) then
    rt_fail_class(15)
  end
  rt_check_numbers(a, b)
  if rt_has_class(a, b, 7) then
    rt_fail_class(7)
  end
  if rt_has_class(a, b, 3) then
    let r = rt_m_fmod(rt_float(rt_float_bits_of(a)), rt_float(rt_float_bits_of(b)))
    ensure value_live(r)
    return r
  end
  if rt_is_integer(a) and rt_is_integer(b) then
    if b == 0 then
      print("division by zero")
      let r = rt_stop(74)
      ensure value_live(r)
      return r
    end
    let r = int_divmod(a, b)[1]
    ensure value_live(r)
    return r
  end
  # rationals: a - b * trunc(a / b)
  let q = rational_div(a, b)
  let t = q
  if value_class(q) == 5 then
    let t = int_divmod(rational_num(q), rational_den(q))[0]
  end
  let r = rational_sub(a, rational_mul(b, t))
  ensure value_live(r)
  return r
end

make a function called op_neg takes a returns r
  require value_live(a)
  let c = value_class(a)
  if (c == 2) or (c == 4) then
    let r = int_neg(a)
    ensure value_live(r)
    return r
  end
  if c == 3 then
    let r = rt_float(word_xor(value_data(a), 0 - 9223372036854775807 - 1))
    ensure value_live(r)
    return r
  end
  if c == 5 then
    let r = rational_make(int_neg(rational_num(a)), rational_den(a))
    ensure value_live(r)
    return r
  end
  if c == 6 then
    let r = complex_make(op_neg(complex_re(a)), op_neg(complex_im(a)))
    ensure value_live(r)
    return r
  end
  if c == 7 then
    let r = interval_make(op_neg(interval_hi(a)), op_neg(interval_lo(a)))
    ensure value_live(r)
    return r
  end
  if c == 15 then
    let r = rt_modint_neg(a)
    ensure value_live(r)
    return r
  end
  let r = rt_fail_class(c)
  ensure value_live(r)
  return r
end

make a function called op_not takes a returns r
  require value_live(a)
  let r = not rt_truthy(a)
  ensure value_class(r) == 1
  return r
end

# A number's float bits, as an int.
make a function called float_to_bits takes v returns bits
  require rt_is_real(v)
  let word = rt_float_bits_of(v)
  # unsigned: the sign bit set makes it a bigint
  let bits = word
  if word < 0 then
    let bits = int_add(int_mul(word_shl(1, 32), word_shl(1, 32)), word)
  end
  ensure rt_is_integer(bits)
  return bits
end

# Whether a value counts as true where a condition reads it: unit, false, a
# zero, the empty string and the empty list do not.
make a function called rt_truthy takes v returns yes
  require value_live(v)
  let c = value_class(v)
  let yes = true
  if c == 0 then
    let yes = false
  elif (c == 1) or (c == 2) then
    let yes = value_data(v) != 0
  elif c == 3 then
    # either zero: the bits without the sign
    let yes = word_shl(value_data(v), 1) != 0
  elif c == 8 then
    let yes = str_len(v) > 0
  elif c == 9 then
    let yes = list_len(v) > 0
  end
  ensure value_class(yes) == 1
  return yes
end

# -1, 0 or 1 for two real numbers.
make a function called rt_real_cmp takes a, b returns c
  require rt_is_real(a) and rt_is_real(b)
  if rt_has_class(a, b, 3) then
    let x = rt_float_bits_of(a)
    let y = rt_float_bits_of(b)
    if float_lt(x, y) == 1 then
      let c = 0 - 1
      ensure (c == 0 - 1) or (c == 0) or (c == 1)
      return c
    end
    if float_lt(y, x) == 1 then
      let c = 1
      ensure (c == 0 - 1) or (c == 0) or (c == 1)
      return c
    end
    let c = 0
    ensure (c == 0 - 1) or (c == 0) or (c == 1)
    return c
  end
  if rt_has_class(a, b, 5) then
    let c = rational_cmp(a, b)
    ensure (c == 0 - 1) or (c == 0) or (c == 1)
    return c
  end
  let c = int_cmp(a, b)
  ensure (c == 0 - 1) or (c == 0) or (c == 1)
  return c
end

make a function called rt_check_reals takes a, b returns r
  require value_live(a) and value_live(b)
  if (not rt_is_real(a)) or (not rt_is_real(b)) then
    rt_fail_class(value_class(a))
  end
  let r = 0
  ensure rt_is_real(a) and rt_is_real(b)
  return r
end

# Whether either is a float NaN: a NaN is ordered against nothing, itself
# included, so every comparison with one is false but != (IEEE 754).
make a function called rt_unordered takes a, b returns yes
  require value_live(a) and value_live(b)
  let yes = false
  if value_class(a) == 3 then
    let x = rt_float_bits_of(a)
    let yes = float_eq(x, x) != 1
  end
  if (not yes) and (value_class(b) == 3) then
    let y = rt_float_bits_of(b)
    let yes = float_eq(y, y) != 1
  end
  ensure value_class(yes) == 1
  return yes
end

# a OP b for the four orderings. Each is a method of its left operand's class
# (spec 1.4): an object is sent OP itself, never another operator derived
# from <, so a class defines the ones it means.
make a function called rt_order takes a, b, op returns r
  require value_live(a) and value_live(b) and (value_class(op) == 8)
  if rt_is_object(a) then
    let r = send(a, op, b)
    ensure value_live(r)
    return r
  end
  if (value_class(a) == 8) and (value_class(b) == 8) then
    let c = str_cmp(a, b)
  else
    if rt_has_class(a, b, 15) then
      rt_fail_class(15)
    end
    rt_check_reals(a, b)
    if rt_unordered(a, b) then
      let r = false
      ensure value_live(r)
      return r
    end
    let c = rt_real_cmp(a, b)
  end
  let r = ((op == "<") and (c < 0)) or ((op == ">") and (c > 0)) or ((op == "<=") and (c <= 0)) or ((op == ">=") and (c >= 0))
  ensure value_live(r)
  return r
end

make a function called op_lt takes a, b returns r
  require value_live(a) and value_live(b)
  let r = rt_order(a, b, "<")
  ensure value_live(r)
  return r
end

make a function called op_gt takes a, b returns r
  require value_live(a) and value_live(b)
  let r = rt_order(a, b, ">")
  ensure value_live(r)
  return r
end

make a function called op_le takes a, b returns r
  require value_live(a) and value_live(b)
  let r = rt_order(a, b, "<=")
  ensure value_live(r)
  return r
end

make a function called op_ge takes a, b returns r
  require value_live(a) and value_live(b)
  let r = rt_order(a, b, ">=")
  ensure value_live(r)
  return r
end

make a function called op_eq takes a, b returns r
  require value_live(a) and value_live(b)
  let ca = value_class(a)
  let cb = value_class(b)
  if ca == cb then
    if ca == 8 then
      let r = str_eq(a, b)
      ensure value_class(r) == 1
      return r
    end
    if ca <= 1 then
      let r = value_data(a) == value_data(b)
      ensure value_class(r) == 1
      return r
    end
    if ca == 17 then
      # logic variables: equal when their names are
      let r = str_eq(logic_var_name(a), logic_var_name(b))
      ensure value_class(r) == 1
      return r
    end
  end
  if ((ca == 15) and ((cb == 15) or rt_is_integer(b))) or ((cb == 15) and rt_is_integer(a)) then
    if rt_modw_fits(a, b) then
      # two words of one k, or a word and an int: equal when their low k bits are
      let r = word_and(word_xor(rt_modw_w(a), rt_modw_w(b)), rt_modw_mask(rt_modw_bits(rt_modw_template(a, b)))) == 0
      ensure value_class(r) == 1
      return r
    end
    if (ca == 15) and (cb == 15) and (not rt_mod_same_modulus(a, b)) then
      let r = false
      ensure value_class(r) == 1
      return r
    end
    let r = rt_modint_eq(rt_mod_operand(a, rt_mod_template(a, b)), rt_mod_operand(b, rt_mod_template(a, b)))
    ensure value_class(r) == 1
    return r
  end
  if rt_is_real(a) and rt_is_real(b) then
    let r = (not rt_unordered(a, b)) and (rt_real_cmp(a, b) == 0)
    ensure value_class(r) == 1
    return r
  end
  if ((ca == 7) and (rt_is_real(b) or (cb == 7))) or ((cb == 7) and rt_is_real(a)) then
    let r = op_eq(interval_lo(a), interval_lo(b)) and op_eq(interval_hi(a), interval_hi(b))
    ensure value_class(r) == 1
    return r
  end
  if ca != cb then
    let r = false
    ensure value_class(r) == 1
    return r
  end
  if ca == 9 then
    let r = rt_list_eq(a, b)
    ensure value_class(r) == 1
    return r
  end
  if ca == 6 then
    let r = op_eq(complex_re(a), complex_re(b)) and op_eq(complex_im(a), complex_im(b))
    ensure value_class(r) == 1
    return r
  end
  let r = value_data(a) == value_data(b)
  ensure value_class(r) == 1
  return r
end

make a function called op_ne takes a, b returns r
  require value_live(a) and value_live(b)
  let r = not op_eq(a, b)
  ensure value_class(r) == 1
  return r
end

make a function called op_band takes a, b returns r
  require value_live(a) and value_live(b)
  if rt_has_class(a, b, 15) then
    let r = rt_modint_bitwise(0, a, b)
    ensure value_class(r) == 15
    return r
  end
  let r = rt_fail_class(value_class(a))
  ensure false
  return r
end

make a function called op_bor takes a, b returns r
  require value_live(a) and value_live(b)
  if rt_has_class(a, b, 15) then
    let r = rt_modint_bitwise(1, a, b)
    ensure value_class(r) == 15
    return r
  end
  let r = rt_fail_class(value_class(a))
  ensure false
  return r
end

make a function called op_bxor takes a, b returns r
  require value_live(a) and value_live(b)
  if rt_has_class(a, b, 15) then
    let r = rt_modint_bitwise(2, a, b)
    ensure value_class(r) == 15
    return r
  end
  let r = rt_fail_class(value_class(a))
  ensure false
  return r
end

# Only reached for a value that is not an int: an int's complement is inline.
# A k-bit word's complement flips its k bits.
make a function called op_bnot takes a returns r
  require value_live(a)
  if value_class(a) == 15 then
    let r = rt_modint_bnot(a)
    ensure value_class(r) == 15
    return r
  end
  let r = rt_fail_class(value_class(a))
  ensure false
  return r
end

make a function called op_shl takes a, b returns r
  require value_live(a) and value_live(b)
  if rt_has_class(a, b, 15) then
    let r = rt_modint_shift(0, a, b)
    ensure value_class(r) == 15
    return r
  end
  let r = rt_fail_class(value_class(a))
  ensure false
  return r
end

make a function called op_shr takes a, b returns r
  require value_live(a) and value_live(b)
  if rt_has_class(a, b, 15) then
    let r = rt_modint_shift(1, a, b)
    ensure value_class(r) == 15
    return r
  end
  let r = rt_fail_class(value_class(a))
  ensure false
  return r
end

# sqrt of an exact non-negative number: the integer when it is a perfect
# square, else the float.
make a function called rt_sqrt_exact takes x returns r
  require rt_is_real(x) and (value_class(x) != 3)
  let f = rt_float_bits_of(rt_m_sqrt(rt_float(rt_float_bits_of(x))))
  if rt_is_integer(x) and rt_float_bits_integral(f) then
    let root = float_to_int(f)
    if root * root == x then
      let r = root
      ensure rt_is_real(r)
      return r
    end
  end
  let r = rt_float(f)
  ensure rt_is_real(r)
  return r
end
