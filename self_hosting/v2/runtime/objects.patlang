# v2 runtime: classes, objects, methods and events
# (docs/spec/values-and-memory.md 1.1, 1.2, 1.4, 1.5, 1.6).
quiet_operators()

# The program's values live in the state of the world it runs in
# (worlds.patlang; rt_global_get/set):
#   4096 event handlers: a list of [event name, closure] (the events whose
#        handlers are running are each thread's: memory.patlang's thread
#        context, rt_active_events)
#   4128 which classes' methods raise which events: [class id, event]
#   4144 the classes: a list of class records (rt_class_*)
#   4160 named objects: the address of their table (rt_named_*), not a value
#   4176 the next class id for a declared class
#   4192 the named table's lock (rt_lock_take)
#   4200 the classes by name: a table's address, not a value (rt_class_by_name)
# (4208 is threads.patlang's functions by name, 4464 logic.patlang's named
# rule stores; 4112, fibers.patlang's jobs, is the engine's: rt_engine_get)
# and, at 2048 + 8 * class id (ids below 256), each class's event flag:
# nonzero once a handler is registered for an event its methods raise.
#
# A class record is [name, id, parent name, field defaults [[name, value]],
# methods [[name, closure]], traits [names], a vec holding what new() starts an
# object's fields from (rt_new_fields)].
#
# An object is a block holding its class id at 16, its name at 24 (unit
# when unnamed), its fields at 40: a list of [name, value], and at 72, once it
# has more than 16 fields, where each name's field is (rt_field_index_*), unit
# before. Its type word is its class id with the heap bit, so value_class
# gives the class.

# ---- the state lock ----
#
# The values in a world's slots and the engine's (rt_engine_get) are read and
# replaced by any thread. Reading one is a load and a count, and replacing one
# a store and a release, so two threads at it together would count a block
# already freed, or free one twice. Each is done under the state lock, the
# engine's one lock (runtime_state() 4616, taken with rt_lock_take; 4624
# unused). A change made from the value itself (a push onto a table) holds
# the lock from its read to its write: rt_global_push, or rt_state_lock,
# rt_global_take, rt_global_put and rt_state_unlock, with nothing between them
# that takes the lock again or can stop the program.
#
# Until a second thread has been started (4608, set by rt_thread_start before
# the thread exists) there is nothing to keep apart, and no lock is taken.

make a function called rt_state_init returns r
  let st = runtime_state()
  mem_store(st, 4608, 0)
  mem_store(st, 4616, 0)
  mem_store(st, 4624, 0)
  let r = 0
  ensure r == 0
  return r
end

# Whether a second thread has been started.
make a function called rt_threaded returns yes
  let yes = mem_load(runtime_state(), 4608) != 0
  ensure value_class(yes) == 1
  return yes
end

make a function called rt_threads_begin returns r
  mem_store(runtime_state(), 4608, 1)
  let r = 0
  ensure (r == 0) and rt_threaded()
  return r
end

# Takes the state lock when there are threads: whether it did, for
# rt_state_unlock.
make a function called rt_state_lock returns held
  let st = runtime_state()
  if mem_load(st, 4608) == 0 then
    let held = false
    ensure value_class(held) == 1
    return held
  end
  rt_lock_take(st + 4616)
  let held = true
  ensure value_class(held) == 1
  return held
end

make a function called rt_state_unlock takes held returns r
  require value_class(held) == 1
  if held then
    rt_lock_give(runtime_state() + 4616)
  end
  let r = 0
  ensure r == 0
  return r
end

make a function called rt_global_get takes off returns v
  require (off >= 4096) and (off < 4560) and (word_and(off, 7) == 0) and (off != 4112)
  let base = rt_world_base()
  let held = rt_state_lock()
  let v = mem_load_value(base, off)
  rt_state_unlock(held)
  ensure value_live(v)
  return v
end

# The old value is released after the lock is given back: freeing what it
# holds can take long.
make a function called rt_global_set takes off, v returns r
  require (off >= 4096) and (off < 4560) and (word_and(off, 7) == 0) and (off != 4112) and value_live(v)
  let base = rt_world_base()
  let held = rt_state_lock()
  let old = mem_take_value(base, off)
  mem_init_value(base, off, v)
  rt_state_unlock(held)
  let r = unit
  ensure value_class(r) == 0
  return r
end

# The slot's value moved out of it, the slot holding unit meanwhile, so a
# list held nowhere else is changed in place. For a caller holding the state
# lock, which puts a value back with rt_global_put before it gives the lock up.
make a function called rt_global_take takes off returns v
  require (off >= 4096) and (off < 4560) and (word_and(off, 7) == 0) and (off != 4112)
  let v = mem_take_value(rt_world_base(), off)
  ensure value_live(v)
  return v
end

make a function called rt_global_put takes off, v returns r
  require (off >= 4096) and (off < 4560) and (word_and(off, 7) == 0) and (off != 4112) and value_live(v)
  mem_init_value(rt_world_base(), off, v)
  let r = 0
  ensure r == 0
  return r
end

# x pushed onto the list in a slot, as one step.
make a function called rt_global_push takes off, x returns r
  require (off >= 4096) and (off < 4560) and (word_and(off, 7) == 0) and (off != 4112) and value_live(x)
  let held = rt_state_lock()
  let l = rt_global_take(off)
  let l = list_push(l, x)
  rt_global_put(off, l)
  rt_state_unlock(held)
  let r = 0
  ensure r == 0
  return r
end

# [key, v] set in the list of pairs in a slot, in place of the pair with that
# key when there is one, as one step.
make a function called rt_global_pair_set takes off, key, v returns r
  require (off >= 4096) and (off < 4560) and (word_and(off, 7) == 0) and (off != 4112) and value_live(key) and value_live(v)
  let held = rt_state_lock()
  let l = rt_global_take(off)
  let i = rt_pairs_index(l, key)
  if i >= 0 then
    let l = list_set(l, i, [key, v])
  else
    let l = list_push(l, [key, v])
  end
  rt_global_put(off, l)
  rt_state_unlock(held)
  let r = 0
  ensure r == 0
  return r
end

# The list of pairs in a slot without those whose first element is key, as one
# step: how many were dropped.
make a function called rt_global_drop takes off, key returns dropped
  require (off >= 4096) and (off < 4560) and (word_and(off, 7) == 0) and (off != 4112) and value_live(key)
  let held = rt_state_lock()
  let l = rt_global_take(off)
  let kept = []
  let k = 0
  while k < list_len(l) do
    if l[k][0] != key then
      let kept = list_push(kept, l[k])
    end
    let k = k + 1
  end
  let dropped = list_len(l) - list_len(kept)
  rt_global_put(off, kept)
  rt_state_unlock(held)
  ensure dropped >= 0
  return dropped
end

# The world's objects, classes and events, in the world the code runs in.
make a function called rt_objects_init returns r
  let st = rt_world_base()
  let offs = [4096, 4128, 4144]
  let k = 0
  while k < 3 do
    mem_store(st, offs[k], 0)
    mem_store(st, word_add(offs[k], 8), 0)
    mem_init_value(st, offs[k], [])
    let k = word_add(k, 1)
  end
  # 4224: the classes by id, a vec: each record at its id, false between
  mem_store(st, 4224, 0)
  mem_store(st, 4232, 0)
  mem_init_value(st, 4224, vec_new())
  mem_store(st, 4192, 0)
  mem_store(st, 4200, rt_named_table_new(1024))
  mem_store(st, 4160, rt_named_table_new(64))
  mem_store(st, 4176, 0)
  mem_store(st, 4184, 0)
  mem_init_value(st, 4176, 64)
  let k = 0
  while k < 256 do
    mem_store(st, word_add(2048, word_mul(8, k)), 0)
    let k = word_add(k, 1)
  end
  rt_builtin_classes()
  let r = 0
  ensure (r == 0) and (list_len(rt_global_get(4144)) == 16)
  return r
end

# ---- classes ----

make a function called rt_class_def takes name, id, parent, defaults, methods, traits returns r
  require (value_class(name) == 8) and (value_class(id) == 2) and (value_class(defaults) == 9) and (value_class(methods) == 9) and (value_class(traits) == 9)
  let start = vec_new()
  vec_push(start, 0 - 1)
  vec_push(start, [])
  let rec = [name, id, parent, defaults, methods, traits, start]
  rt_global_push(4144, rec)
  # and at its id in the vec by id, under the state lock as the list's push is
  let held = rt_state_lock()
  let by_id = rt_global_take(4224)
  while vec_len(by_id) <= id do
    vec_push(by_id, false)
  end
  vec_set(by_id, id, rec)
  rt_global_put(4224, by_id)
  rt_class_index_add(name, rec)
  rt_state_unlock(held)
  let r = id
  ensure r == id
  return r
end

# The classes by name (4200): a table laid out as the named objects' is
# (rt_named_table_new, rt_named_slot), each bucket a list of [name, record]
# holding the first class of each name, as a search of the class list finds
# it. A search of the list compared every class's name with == and took most
# of new()'s time, and the time of every method a class inherits: 62 000
# cycles a new() with no classes of the program's own, 848 000 with 400
# (review finding O2). Its caller holds the state lock.
make a function called rt_class_index_add takes name, rec returns r
  require (value_class(name) == 8) and (value_class(rec) == 9)
  let table = mem_load(rt_world_base(), 4200)
  let off = rt_named_slot(table, name)
  let bucket = mem_take_value(table, off)
  let found = false
  let k = 0
  while (not found) and (k < list_len(bucket)) do
    if str_eq(bucket[k][0], name) then
      let found = true
    end
    let k = word_add(k, 1)
  end
  if not found then
    let bucket = list_push(bucket, [name, rec])
  end
  mem_init_value(table, off, bucket)
  let r = 0
  ensure r == 0
  return r
end

# A declared class: the next id, its methods' events recorded.
make a function called class_define takes name, parent, defaults, methods, traits, raises returns id
  require (value_class(name) == 8) and (value_class(parent) == 8) and (value_class(defaults) == 9) and (value_class(methods) == 9) and (value_class(traits) == 9) and (value_class(raises) == 9)
  let held = rt_state_lock()
  let id = rt_global_take(4176)
  rt_global_put(4176, word_add(id, 1))
  rt_state_unlock(held)
  let k = 0
  while k < list_len(raises) do
    rt_declare_raises(id, raises[k])
    let k = word_add(k, 1)
  end
  let id = rt_class_def(name, id, parent, defaults, methods, traits)
  ensure (id >= 64) and (rt_class_by_id(id) != false)
  return id
end

make a function called rt_class_by_name takes name returns rec
  require (value_class(name) == 8)
  let table = mem_load(rt_world_base(), 4200)
  let off = rt_named_slot(table, name)
  let held = rt_state_lock()
  let bucket = mem_load_value(table, off)
  rt_state_unlock(held)
  let k = 0
  while k < list_len(bucket) do
    if str_eq(bucket[k][0], name) then
      let rec = bucket[k][1]
      ensure (rec == false) or (value_class(rec) == 9)
      return rec
    end
    let k = word_add(k, 1)
  end
  let rec = false
  ensure (rec == false) or (value_class(rec) == 9)
  return rec
end

# A class's record by its id, or false: one look-up in the vec by id (a
# search of the class list cost about as much as the rest of a method call,
# review finding O2).
make a function called rt_class_by_id takes id returns rec
  require (value_class(id) == 2)
  let held = rt_state_lock()
  let by_id = rt_global_take(4224)
  let rec = false
  if (id >= 0) and (id < vec_len(by_id)) then
    let rec = vec_get(by_id, id)
  end
  rt_global_put(4224, by_id)
  rt_state_unlock(held)
  ensure (rec == false) or (value_class(rec) == 9)
  return rec
end

# A method of a class, looked up in the class, then its traits (the last
# listed first), then its parent, and up; false when none has it.
make a function called rt_find_method takes rec, m returns f
  require (value_class(m) == 8)
  if rec == false then
    let f = false
    ensure (f == false) or (value_class(f) == 10)
    return f
  end
  let methods = rec[4]
  let k = 0
  while k < list_len(methods) do
    # a method's name is text: == of two values first asks what each is
    if str_eq(methods[k][0], m) then
      let f = methods[k][1]
      ensure (f == false) or (value_class(f) == 10)
      return f
    end
    let k = word_add(k, 1)
  end
  let traits = rec[5]
  let t = word_sub(list_len(traits), 1)
  while t >= 0 do
    let f = rt_find_method(rt_class_by_name(traits[t]), m)
    if f != false then
      ensure (f == false) or (value_class(f) == 10)
      return f
    end
    let t = word_sub(t, 1)
  end
  if rec[2] == "" then
    let f = false
    ensure (f == false) or (value_class(f) == 10)
    return f
  end
  let f = rt_find_method(rt_class_by_name(rec[2]), m)
  ensure (f == false) or (value_class(f) == 10)
  return f
end

# The field defaults of a class and its ancestors, the class's own last.
make a function called rt_class_defaults takes rec returns pairs
  require (rec == false) or (value_class(rec) == 9)
  if rec == false then
    let pairs = []
    ensure (value_class(pairs) == 9)
    return pairs
  end
  let pairs = []
  if rec[2] != "" then
    let pairs = rt_class_defaults(rt_class_by_name(rec[2]))
  end
  let own = rec[3]
  let k = 0
  while k < list_len(own) do
    let pairs = rt_pairs_set(pairs, own[k][0], own[k][1])
    let k = word_add(k, 1)
  end
  ensure (value_class(pairs) == 9)
  return pairs
end

# The fields an object of the class starts with: its own and its ancestors'
# defaults, then its "type". Kept in the record (its last element, a vec of
# [the next class id when made, the fields]) and made again only once another
# class has been declared, which may be an ancestor declared after it: making
# them for every new() was most of its time (34 000 of 54 000 cycles for a
# class with a parent). Read and kept under the state lock, made outside it,
# since rt_class_by_name takes it.
make a function called rt_new_fields takes rec returns fields
  require (value_class(rec) == 9) and (list_len(rec) == 7)
  let now = rt_global_get(4176)
  let held = rt_state_lock()
  let kept = rec[6]
  let made_at = vec_get(kept, 0)
  let fields = vec_get(kept, 1)
  rt_state_unlock(held)
  if made_at == now then
    ensure value_class(fields) == 9
    return fields
  end
  let fields = rt_pairs_set(rt_class_defaults(rec), "type", rec[0])
  let held = rt_state_lock()
  vec_set(kept, 0, now)
  vec_set(kept, 1, fields)
  rt_state_unlock(held)
  ensure value_class(fields) == 9
  return fields
end

# ---- [name, value] lists ----

make a function called rt_pairs_index takes pairs, key returns i
  require (value_class(pairs) == 9)
  # a name, the common key, compared as text: == of two values first asks
  # what each is
  let text = value_class(key) == 8
  let k = 0
  while k < list_len(pairs) do
    let at = pairs[k][0]
    if (text and (value_class(at) == 8) and str_eq(at, key)) or ((not text) and (at == key)) then
      let i = k
      ensure (i >= 0 - 1) and (i < list_len(pairs))
      return i
    end
    let k = word_add(k, 1)
  end
  let i = 0 - 1
  ensure (i >= 0 - 1) and (i < list_len(pairs))
  return i
end

make a function called rt_pairs_set takes pairs, key, v returns out
  require (value_class(pairs) == 9) and value_live(key) and value_live(v)
  # the postcondition says only what the push or the set gives: a second
  # search on every write cost as much as the first (review finding O7)
  let i = rt_pairs_index(pairs, key)
  if i < 0 then
    let out = list_push(pairs, [key, v])
    ensure list_len(out) == list_len(pairs) + 1
    return out
  end
  let out = list_set(pairs, i, [key, v])
  ensure list_len(out) == list_len(pairs)
  return out
end

# ---- where an object's fields are, by name (review finding O1) ----
#
# A field was found by looking at every field before it: the 512th read cost
# about eighty times the 4th. An object with more than 16 fields keeps an
# index: a list [capacity, bucket, ...], a power of two of buckets, each a list
# of [name, position] holding a name's first field, by str_hash. Only a write
# makes or changes it, under the object's cell, so readers never change it; a
# reader checks the field it finds still has the name, and looks at every
# field when it does not. A position never moves: a field is set in place or
# added at the end, and none is taken away.

make a function called rt_field_index_min returns n
  let n = 16
  ensure n > 0
  return n
end

# The index of a list of fields: twice as many buckets as fields, at least 64.
make a function called rt_field_index_build takes fields returns index
  require value_class(fields) == 9
  let n = list_len(fields)
  let cap = 64
  while cap < 2 * n do
    let cap = cap * 2
  end
  let index = list_set(rt_list_alloc(cap + 1), 0, cap)
  let b = 1
  while b <= cap do
    let index = list_set(index, b, [])
    let b = b + 1
  end
  let p = 0
  while p < n do
    let index = rt_field_index_add(index, fields[p][0], p)
    let p = p + 1
  end
  ensure (value_class(index) == 9) and (list_len(index) == cap + 1)
  return index
end

# The index with a field's name at a position, when the name has none yet.
make a function called rt_field_index_add takes index, name, pos returns out
  require (value_class(index) == 9) and (value_class(name) == 8) and (pos >= 0)
  let cap = index[0]
  let b = 1 + word_and(str_hash(name), cap - 1)
  let bucket = index[b]
  let k = 0
  while k < list_len(bucket) do
    if str_eq(bucket[k][0], name) then
      let out = index
      ensure value_class(out) == 9
      return out
    end
    let k = k + 1
  end
  let out = list_set(index, b, list_push(bucket, [name, pos]))
  ensure (value_class(out) == 9) and (list_len(out) == cap + 1)
  return out
end

# Where the field named key is, -1 when none is: through the index when there
# is one and it is right about the field, else by a look at every field.
make a function called rt_field_pos takes fields, index, key returns i
  require (value_class(fields) == 9) and (value_class(key) == 8)
  if value_class(index) == 9 then
    let bucket = index[1 + word_and(str_hash(key), index[0] - 1)]
    let k = 0
    while k < list_len(bucket) do
      if str_eq(bucket[k][0], key) then
        let at = bucket[k][1]
        if (at < list_len(fields)) and str_eq(fields[at][0], key) then
          let i = at
          ensure (i >= 0 - 1) and (i < list_len(fields))
          return i
        end
        let k = list_len(bucket)
      end
      let k = k + 1
    end
  end
  let i = rt_pairs_index(fields, key)
  ensure (i >= 0 - 1) and (i < list_len(fields))
  return i
end

# An object's index, read as its fields are (rt_fields).
make a function called rt_field_index_of takes o returns index
  require rt_is_object(o)
  let block = value_data(o)
  let e = (mem_load(runtime_state(), 4608) != 0) and rt_cell_read(block + 56)
  let index = mem_load_value(block, 72)
  if e then
    rt_cell_read_end(block + 56, e)
  end
  ensure value_live(index)
  return index
end

# ---- objects ----

make a function called rt_object_alloc takes cid, name, fields returns o
  require (cid >= 63) and (value_class(fields) == 9)
  let block = rt_alloc(72)
  mem_store(block, 16, cid)
  mem_init_value(block, 24, name)
  mem_init_value(block, 40, fields)
  # its users, as a cell's (cells.patlang), and its place in the registry of
  # blocks that can close a cycle (memory.patlang)
  mem_store(block, 56, 0)
  mem_store(block, 64, 0)
  # unit, or its fields' index (rt_field_index_build)
  mem_store(block, 72, 0)
  mem_store(block, 80, 0)
  if list_len(fields) > rt_field_index_min() then
    mem_init_value(block, 72, rt_field_index_build(fields))
  end
  let o = value_make(word_or(cid, 4294967296), block)
  rt_cycle_register(word_or(cid, 4294967296), block)
  ensure value_class(o) == cid
  return o
end

make a function called rt_is_object takes v returns yes
  require value_live(v)
  let yes = value_class(v) >= 63
  ensure value_class(yes) == 1
  return yes
end

# new(class) makes an object of that class, its fields its defaults;
# new(class, name) also names it, findable by that name until
# object_delete. A class never declared is declared here, with no fields.
# ---- named objects ----

# A table is an uncounted block: its count at 16, its capacity, a power of two,
# at 24, and from 32 a value slot per bucket, each a list of [name, object] with
# the earliest object of a name first. The lock lets any thread find or add one.

make a function called rt_named_lock returns r
  let st = rt_world_base()
  rt_lock_take(st + 4192)
  let r = 0
  ensure r == 0
  return r
end

make a function called rt_named_unlock returns r
  rt_lock_give(rt_world_base() + 4192)
  let r = 0
  ensure r == 0
  return r
end

make a function called rt_named_table_new takes cap returns block
  require (cap > 0) and (word_and(cap, cap - 1) == 0)
  let block = rt_alloc(16 + 16 * cap)
  mem_store(block, 16, 0)
  mem_store(block, 24, cap)
  let i = 0
  while i < cap do
    let off = 32 + 16 * i
    mem_store(block, off, 0)
    mem_store(block, off + 8, 0)
    mem_init_value(block, off, [])
    let i = i + 1
  end
  ensure block != 0
  return block
end

# Where a name's bucket is in a table: FNV-1a over the name's bytes.
make a function called rt_named_slot takes block, name returns off
  require (block != 0) and (value_class(name) == 8)
  let h = rt_fnv_text(rt_fnv_start(), name)
  let off = 32 + 16 * word_and(h, mem_load(block, 24) - 1)
  ensure off >= 32
  return off
end

make a function called rt_named_insert takes block, pair returns r
  require (block != 0) and (value_class(pair) == 9)
  let off = rt_named_slot(block, pair[0])
  mem_store_value(block, off, list_push(mem_load_value(block, off), pair))
  mem_store(block, 16, mem_load(block, 16) + 1)
  let r = 0
  ensure r == 0
  return r
end

# The table moved to twice the capacity, each name's objects in their order. The
# caller holds the lock, so nothing is reading the old table when it is freed.
make a function called rt_named_grow returns r
  let st = rt_world_base()
  let old = mem_load(st, 4160)
  let cap = mem_load(old, 24)
  let block = rt_named_table_new(2 * cap)
  let i = 0
  while i < cap do
    let off = 32 + 16 * i
    let bucket = mem_load_value(old, off)
    let k = 0
    while k < list_len(bucket) do
      rt_named_insert(block, bucket[k])
      let k = k + 1
    end
    mem_store_value(old, off, false)
    let i = i + 1
  end
  mem_store(st, 4160, block)
  rt_free(old)
  let r = 0
  ensure r == 0
  return r
end

make a function called rt_named_add takes name, o returns r
  require (value_class(name) == 8) and value_live(o)
  rt_named_lock()
  let block = mem_load(rt_world_base(), 4160)
  if mem_load(block, 16) >= mem_load(block, 24) then
    rt_named_grow()
    let block = mem_load(rt_world_base(), 4160)
  end
  rt_named_insert(block, [name, o])
  rt_named_unlock()
  let r = 0
  ensure r == 0
  return r
end

# The earliest object still alive with this name, else false.
make a function called rt_named_find takes name returns o
  require value_class(name) == 8
  rt_named_lock()
  let block = mem_load(rt_world_base(), 4160)
  let bucket = mem_load_value(block, rt_named_slot(block, name))
  let i = rt_pairs_index(bucket, name)
  let o = false
  if i >= 0 then
    let o = bucket[i][1]
  end
  rt_named_unlock()
  ensure value_live(o)
  return o
end

make a function called rt_named_remove takes name, o returns r
  require (value_class(name) == 8) and value_live(o)
  rt_named_lock()
  let block = mem_load(rt_world_base(), 4160)
  let off = rt_named_slot(block, name)
  let bucket = mem_load_value(block, off)
  let kept = []
  let k = 0
  while k < list_len(bucket) do
    if bucket[k][1] != o then
      let kept = list_push(kept, bucket[k])
    end
    let k = k + 1
  end
  mem_store(block, 16, mem_load(block, 16) - (list_len(bucket) - list_len(kept)))
  mem_store_value(block, off, kept)
  rt_named_unlock()
  let r = 0
  ensure r == 0
  return r
end

make a function called new takes class_name, rest returns o
  require (value_class(class_name) == 8) and (value_class(rest) == 9) and ((list_len(rest) == 0) or (value_class(rest[0]) == 8))
  if list_len(rest) > 1 then
    print("new takes a class and a name; a class declaration says what it inherits")
    let o = rt_stop(75)
    ensure rt_is_object(o) and (type_of(o) == class_name)
    return o
  end
  # the name is optional: an object without one is unnamed
  let name = unit
  if list_len(rest) == 1 then
    let name = rest[0]
  end
  let rec = rt_class_by_name(class_name)
  if rec == false then
    class_define(class_name, "", [], [], [], [])
    let rec = rt_class_by_name(class_name)
  end
  let fields = rt_new_fields(rec)
  if value_class(name) == 8 then
    let fields = rt_pairs_set(fields, "name", name)
  end
  let o = rt_object_alloc(rec[1], name, fields)
  if value_class(name) == 8 then
    rt_named_add(name, o)
  end
  ensure rt_is_object(o) and (type_of(o) == class_name)
  return o
end

# The object a string names, else the value itself: a string that names no
# object is its own receiver.
# A program that declares object_names_explicit() takes objects by value
# alone: from then on, in its world, a string is only a string to member
# access, get, send, field assignment and object_delete, and object_named
# gives the object with a name (review finding S7; spec 1.1). A program that
# declares nothing keeps implicit names. The flag is at 4528 of the world's
# state (worlds.patlang).
make a function called object_names_explicit returns done
  mem_store(rt_world_base(), 4528, 1)
  let done = true
  ensure value_class(done) == 1
  return done
end

# The object with that name, or unit when none has it.
make a function called object_named takes name returns o
  require value_class(name) == 8
  let found = rt_named_find(name)
  if found == false then
    let o = unit
    ensure value_live(o)
    return o
  end
  let o = found
  ensure value_live(o)
  return o
end

make a function called rt_resolve takes v returns o
  require value_live(v)
  if (value_class(v) == 8) and (mem_load(rt_world_base(), 4528) == 0) then
    let found = rt_named_find(v)
    if found != false then
      let o = found
      ensure value_live(o)
      return o
    end
  end
  let o = v
  ensure value_live(o)
  return o
end

make a function called object_delete takes v returns r
  require value_live(v)
  let o = rt_resolve(v)
  if not rt_is_object(o) then
    let r = false
    ensure value_class(r) == 1
    return r
  end
  let name = mem_load_value(value_data(o), 24)
  if value_class(name) == 8 then
    rt_named_remove(name, o)
  end
  let r = true
  ensure value_class(r) == 1
  return r
end

# An object's cell is entered only when a second thread exists, as a bytes's
# is (cells.patlang, bytes_get): the two calls on every field read and write
# were most of what a read cost.
make a function called rt_fields takes o returns f
  require rt_is_object(o)
  let block = value_data(o)
  let e = (mem_load(runtime_state(), 4608) != 0) and rt_cell_read(block + 56)
  let f = mem_load_value(block, 40)
  if e then
    rt_cell_read_end(block + 56, e)
  end
  ensure (value_class(f) == 9)
  return f
end

# get(v, key): the field's value, or unit when v has no such field, so a field
# holding false reads differently from one that is not there.
make a function called get takes v, key returns r
  require value_live(v) and (value_class(key) == 8)
  let o = rt_resolve(v)
  if not rt_is_object(o) then
    let r = unit
    ensure value_live(r)
    return r
  end
  let fields = rt_fields(o)
  let i = rt_field_pos(fields, rt_field_index_of(o), key)
  if i < 0 then
    let r = unit
    ensure value_live(r)
    return r
  end
  let r = fields[i][1]
  ensure value_live(r)
  return r
end

make a function called rt_field_set takes v, key, x returns r
  require value_live(v) and value_live(x) and (value_class(key) == 8)
  let o = rt_resolve(v)
  # the fields are taken out while they change, so a list held nowhere else is
  # changed in place
  let block = value_data(o)
  let e = (mem_load(runtime_state(), 4608) != 0) and rt_cell_write(block + 56)
  let fields = mem_take_value(block, 40)
  let index = mem_take_value(block, 72)
  let i = rt_field_pos(fields, index, key)
  if i >= 0 then
    let fields = list_set(fields, i, [key, x])
  else
    let fields = list_push(fields, [key, x])
    let n = list_len(fields)
    if value_class(index) == 9 then
      if 2 * n > index[0] then
        let index = rt_field_index_build(fields)
      else
        let index = rt_field_index_add(index, key, n - 1)
      end
    elif n > rt_field_index_min() then
      let index = rt_field_index_build(fields)
    end
  end
  mem_init_value(block, 40, fields)
  mem_init_value(block, 72, index)
  if e then
    rt_cell_write_end(block + 56, e)
  end
  let r = x
  ensure value_live(r)
  return r
end

# o.name: a field when the object has one, else the method called with no
# arguments. A string holding an object's name reaches that object, as it does
# for rt_field_set and send.
make a function called rt_member takes v, m returns r
  require value_live(v) and (value_class(m) == 8)
  # the one member read in nearly every loop, not through the method's closure
  if ((value_class(v) == 8) or (value_class(v) == 9)) and (m == "length") then
    let r = dot_length(v)
    ensure value_live(r)
    return r
  end
  let o = rt_resolve(v)
  if rt_is_object(o) then
    let fields = rt_fields(o)
    let i = rt_field_pos(fields, rt_field_index_of(o), m)
    if i >= 0 then
      let r = fields[i][1]
      ensure value_live(r)
      return r
    end
  end
  let r = send(v, m)
  ensure value_live(r)
  return r
end

# send(o, m, args...): the method's call, the object first; "set", when the
# class and its parents have no method of that name, sets a field. A name
# finds a named object.
make a function called send takes v, m, rest returns r
  require value_live(v) and (value_class(m) == 8) and (value_class(rest) == 9)
  let o = rt_resolve(v)
  let f = rt_find_method(rt_class_by_id(value_class(o)), m)
  if (f == false) and str_eq(m, "set") then
    let r = rt_field_set(o, rest[0], rest[1])
    ensure value_live(r)
    return r
  end
  if f == false then
    print("no method " + m + " for " + type_of(o))
    let r = rt_stop(75)
    ensure value_live(r)
    return r
  end
  # a method of no arguments or one, taking exactly that many, is called
  # straight away: making the list of the object and its arguments, and
  # fitting it, cost as much as the rest of the call
  let n = list_len(rest)
  let fb = value_data(f)
  if mem_load(fb, 40) == 0 then
    if (n == 0) and (mem_load(fb, 32) == 1) then
      let r = f(o)
      ensure value_live(r)
      return r
    end
    if (n == 1) and (mem_load(fb, 32) == 2) then
      let r = f(o, rest[0])
      ensure value_live(r)
      return r
    end
  end
  # else the object, then the arguments, set in place in a list made at its
  # length: + on lists went through the operator's event machinery, and pushing
  # onto an empty list grew it
  let args = list_set(rt_list_alloc(n + 1), 0, o)
  let k = 0
  while k < n do
    let args = list_set(args, k + 1, rest[k])
    let k = k + 1
  end
  let r = rt_apply_unchecked(f, rt_closure_fit(f, args, m))
  ensure value_live(r)
  return r
end

# f's call with the arguments in a list.
make a function called rt_apply takes f, args returns r
  require (value_class(f) == 10) and (value_class(args) == 9) and (list_len(args) <= 8)
  let n = list_len(args)
  if n == 0 then
    let r = f()
    ensure value_live(r)
    return r
  end
  if n == 1 then
    let r = f(args[0])
    ensure value_live(r)
    return r
  end
  if n == 2 then
    let r = f(args[0], args[1])
    ensure value_live(r)
    return r
  end
  if n == 3 then
    let r = f(args[0], args[1], args[2])
    ensure value_live(r)
    return r
  end
  if n == 4 then
    let r = f(args[0], args[1], args[2], args[3])
    ensure value_live(r)
    return r
  end
  if n == 5 then
    let r = f(args[0], args[1], args[2], args[3], args[4])
    ensure value_live(r)
    return r
  end
  if n == 6 then
    let r = f(args[0], args[1], args[2], args[3], args[4], args[5])
    ensure value_live(r)
    return r
  end
  if n == 7 then
    let r = f(args[0], args[1], args[2], args[3], args[4], args[5], args[6])
    ensure value_live(r)
    return r
  end
  let r = f(args[0], args[1], args[2], args[3], args[4], args[5], args[6], args[7])
  ensure value_live(r)
  return r
end

# f's call with arguments already fitted to it (rt_closure_fit): each call
# is closure_call_unchecked, which xv_callv makes without comparing counts.
make a function called rt_apply_unchecked takes f, args returns r
  require (value_class(f) == 10) and (value_class(args) == 9) and (list_len(args) <= 8)
  let n = list_len(args)
  if n == 0 then
    let r = closure_call_unchecked(f)
    ensure value_live(r)
    return r
  end
  if n == 1 then
    let r = closure_call_unchecked(f, args[0])
    ensure value_live(r)
    return r
  end
  if n == 2 then
    let r = closure_call_unchecked(f, args[0], args[1])
    ensure value_live(r)
    return r
  end
  if n == 3 then
    let r = closure_call_unchecked(f, args[0], args[1], args[2])
    ensure value_live(r)
    return r
  end
  if n == 4 then
    let r = closure_call_unchecked(f, args[0], args[1], args[2], args[3])
    ensure value_live(r)
    return r
  end
  if n == 5 then
    let r = closure_call_unchecked(f, args[0], args[1], args[2], args[3], args[4])
    ensure value_live(r)
    return r
  end
  if n == 6 then
    let r = closure_call_unchecked(f, args[0], args[1], args[2], args[3], args[4], args[5])
    ensure value_live(r)
    return r
  end
  if n == 7 then
    let r = closure_call_unchecked(f, args[0], args[1], args[2], args[3], args[4], args[5], args[6])
    ensure value_live(r)
    return r
  end
  let r = closure_call_unchecked(f, args[0], args[1], args[2], args[3], args[4], args[5], args[6], args[7])
  ensure value_live(r)
  return r
end

make a function called rt_class_name takes cid returns name
  require (value_class(cid) == 2)
  let rec = rt_class_by_id(cid)
  if rec == false then
    let name = "object"
    ensure value_class(name) == 8
    return name
  end
  let name = rec[0]
  ensure value_class(name) == 8
  return name
end

# ---- events ----

make a function called rt_declare_raises takes cid, event returns r
  require (value_class(cid) == 2) and (value_class(event) == 8)
  rt_global_push(4128, [cid, event])
  let r = 0
  ensure r == 0
  return r
end

# when EVENT: the handler is called for every emit of EVENT; the classes
# whose methods raise it are flagged, so their operators look for it.
make a function called rt_on takes event, handler returns r
  require (value_class(event) == 8) and (value_class(handler) == 10)
  rt_global_push(4096, [event, handler])
  let raises = rt_global_get(4128)
  let k = 0
  while k < list_len(raises) do
    if raises[k][1] == event then
      let cid = raises[k][0]
      if cid < 256 then
        mem_store(rt_world_base(), word_add(2048, word_mul(8, cid)), 1)
      end
    end
    let k = word_add(k, 1)
  end
  let r = 0
  ensure r == 0
  return r
end

make a function called rt_event_flag takes cid returns on
  require (value_class(cid) == 2) and (cid >= 0)
  if cid >= 256 then
    let on = true
    ensure value_class(on) == 1
    return on
  end
  let on = mem_load(rt_world_base(), word_add(2048, word_mul(8, cid))) != 0
  ensure value_class(on) == 1
  return on
end

# The events whose handlers are running on this fiber, or on the thread when
# it runs none: a list kept in the thread's context, unit (an empty list)
# until the first emit. fiber_resume swaps a fiber's own list in and out.
make a function called rt_active_events returns events
  let v = mem_load_value(rt_context(), 2576)
  if value_class(v) != 9 then
    let events = []
    ensure value_class(events) == 9
    return events
  end
  let events = v
  ensure value_class(events) == 9
  return events
end

make a function called rt_set_active_events takes events returns r
  require value_class(events) == 9
  mem_store_value(rt_context(), 2576, events)
  let r = 0
  ensure value_class(mem_load_value(rt_context(), 2576)) == 9
  return r
end

# Calls every handler for the event, unless its handlers are running now on
# this fiber or thread: nothing a handler does raises its own event again
# (spec 1.4).
make a function called emit takes event, data returns r
  require (value_class(event) == 8) and value_live(data)
  let active = rt_active_events()
  if rt_pairs_index_name(active, event) >= 0 then
    let r = false
    ensure value_class(r) == 1
    return r
  end
  rt_set_active_events(list_push(active, event))
  let handlers = rt_global_get(4096)
  let k = 0
  while k < list_len(handlers) do
    if handlers[k][0] == event then
      let h = handlers[k][1]
      h(event, data)
    end
    let k = word_add(k, 1)
  end
  let still = rt_active_events()
  let kept = []
  let k = 0
  while k < list_len(still) do
    if still[k] != event then
      let kept = list_push(kept, still[k])
    end
    let k = word_add(k, 1)
  end
  rt_set_active_events(kept)
  let r = true
  ensure value_class(r) == 1
  return r
end

# The last pair with this key, or -1.
make a function called rt_pairs_last_index takes pairs, key returns i
  require (value_class(pairs) == 9)
  let k = list_len(pairs) - 1
  while k >= 0 do
    if pairs[k][0] == key then
      let i = k
      ensure (i >= 0 - 1) and (i < list_len(pairs))
      return i
    end
    let k = k - 1
  end
  let i = 0 - 1
  ensure (i >= 0 - 1) and (i < list_len(pairs))
  return i
end

make a function called rt_pairs_index_name takes names, x returns i
  require (value_class(names) == 9)
  let k = 0
  while k < list_len(names) do
    if names[k] == x then
      let i = k
      ensure (i >= 0 - 1) and (i < list_len(names))
      return i
    end
    let k = word_add(k, 1)
  end
  let i = 0 - 1
  ensure (i >= 0 - 1) and (i < list_len(names))
  return i
end

# ---- the built-in classes and their methods, declared in PatLang ----

make a function called rt_builtin_classes returns r
  let shared = [["to_s", |v| { return to_s(v) }], ["length", |v| { return dot_length(v) }]]
  let names = ["unit", "bool", "int", "float", "bigint", "rational", "complex", "interval", "string", "list", "closure", "string_builder", "vec", "bool_array", "rule_store", "modint"]
  let k = 0
  while k < list_len(names) do
    if k != 2 then
      rt_class_def(names[k], k, "", [], shared, [])
    end
    let k = word_add(k, 1)
  end
  # int's + raises added_to, once for each operand, then added (spec 1.4)
  let plus = [["+", |a, b| { return rt_int_plus_events(a, b) }]]
  rt_class_def("int", 2, "", [], v2_list_concat(plus, shared), [])
  rt_declare_raises(2, "added_to")
  rt_declare_raises(2, "added")
  let r = 0
  ensure r == 0
  return r
end

make a function called v2_list_concat takes a, b returns out
  require (value_class(a) == 9) and (value_class(b) == 9)
  let out = a
  let k = 0
  while k < list_len(b) do
    let out = list_push(out, b[k])
    let k = word_add(k, 1)
  end
  ensure list_len(out) == list_len(a) + list_len(b)
  return out
end

make a function called rt_int_plus_events takes a, b returns r
  require (value_class(a) == 2) and (value_class(b) == 2)
  let r = op_add_quiet(a, b)
  emit("added_to", [a, b])
  emit("added_to", [b, a])
  emit("added", [a, b, r])
  ensure rt_is_integer(r)
  return r
end
