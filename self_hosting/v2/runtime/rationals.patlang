# v2 runtime: rationals (class 5). A block holding the numerator at 16 and
# the denominator at 32, each an int or a bigint, in lowest terms, the
# denominator positive. A rational whose denominator would be 1 is the
# integer instead, so every value here is a true fraction.
quiet_operators()

make a function called rt_rational_heap_type returns t
  let t = 4294967301
  ensure (word_and(t, 4294967295) == 5) and (word_and(t, 4294967296) != 0)
  return t
end

make a function called rational_num takes r returns n
  require (value_class(r) == 5) and rt_live(r)
  let n = mem_load_value(value_data(r), 16)
  ensure rt_is_integer(n)
  return n
end

make a function called rational_den takes r returns d
  require (value_class(r) == 5) and rt_live(r)
  let d = mem_load_value(value_data(r), 32)
  ensure rt_is_integer(d) and (not rt_int_negative(d)) and (d != 0)
  return d
end

# n / d in lowest terms: an integer when it divides evenly.
make a function called rational_make takes n, d returns r
  require rt_is_integer(n) and rt_is_integer(d)
  if d == 0 then
    print("division by zero")
    let r = extern_call("KERNEL32.DLL", "ExitProcess", 74)
    ensure rt_is_integer(r) or (value_class(r) == 5)
    return r
  end
  let g = int_gcd(n, d)
  let n2 = int_divmod(n, g)[0]
  let d2 = int_divmod(d, g)[0]
  if rt_int_negative(d2) then
    let n2 = int_neg(n2)
    let d2 = int_neg(d2)
  end
  if d2 == 1 then
    let r = n2
    ensure rt_is_integer(r) or (value_class(r) == 5)
    return r
  end
  let block = rt_alloc(32)
  mem_init_value(block, 16, n2)
  mem_init_value(block, 32, d2)
  let r = value_make(rt_rational_heap_type(), block)
  ensure rt_is_integer(r) or (value_class(r) == 5)
  return r
end

# A real exact number (integer or rational) as [num, den].
make a function called rt_as_fraction takes v returns nd
  require rt_is_integer(v) or (value_class(v) == 5)
  if value_class(v) == 5 then
    let nd = [rational_num(v), rational_den(v)]
    ensure list_len(nd) == 2
    return nd
  end
  let nd = [v, 1]
  ensure list_len(nd) == 2
  return nd
end

make a function called rational_add takes a, b returns r
  require (rt_is_integer(a) or (value_class(a) == 5)) and (rt_is_integer(b) or (value_class(b) == 5))
  let x = rt_as_fraction(a)
  let y = rt_as_fraction(b)
  let r = rational_make(int_add(int_mul(x[0], y[1]), int_mul(y[0], x[1])), int_mul(x[1], y[1]))
  ensure rt_is_integer(r) or (value_class(r) == 5)
  return r
end

make a function called rational_sub takes a, b returns r
  require (rt_is_integer(a) or (value_class(a) == 5)) and (rt_is_integer(b) or (value_class(b) == 5))
  let x = rt_as_fraction(a)
  let y = rt_as_fraction(b)
  let r = rational_make(int_sub(int_mul(x[0], y[1]), int_mul(y[0], x[1])), int_mul(x[1], y[1]))
  ensure rt_is_integer(r) or (value_class(r) == 5)
  return r
end

make a function called rational_mul takes a, b returns r
  require (rt_is_integer(a) or (value_class(a) == 5)) and (rt_is_integer(b) or (value_class(b) == 5))
  let x = rt_as_fraction(a)
  let y = rt_as_fraction(b)
  let r = rational_make(int_mul(x[0], y[0]), int_mul(x[1], y[1]))
  ensure rt_is_integer(r) or (value_class(r) == 5)
  return r
end

make a function called rational_div takes a, b returns r
  require (rt_is_integer(a) or (value_class(a) == 5)) and (rt_is_integer(b) or (value_class(b) == 5)) and (b != 0)
  let x = rt_as_fraction(a)
  let y = rt_as_fraction(b)
  let r = rational_make(int_mul(x[0], y[1]), int_mul(x[1], y[0]))
  ensure rt_is_integer(r) or (value_class(r) == 5)
  return r
end

make a function called rational_cmp takes a, b returns c
  require (rt_is_integer(a) or (value_class(a) == 5)) and (rt_is_integer(b) or (value_class(b) == 5))
  let x = rt_as_fraction(a)
  let y = rt_as_fraction(b)
  let c = int_cmp(int_mul(x[0], y[1]), int_mul(y[0], x[1]))
  ensure (c == 0 - 1) or (c == 0) or (c == 1)
  return c
end

# The greatest integer not above r.
make a function called rational_floor takes r returns f
  require value_class(r) == 5
  let qr = int_divmod(rational_num(r), rational_den(r))
  if rt_int_negative(qr[1]) then
    let f = int_sub(qr[0], 1)
    ensure rt_is_integer(f)
    return f
  end
  let f = qr[0]
  ensure rt_is_integer(f)
  return f
end

make a function called rt_rational_to_s takes r returns s
  require value_class(r) == 5
  let s = to_s(rational_num(r)) + "/" + to_s(rational_den(r))
  ensure value_class(s) == 8
  return s
end
