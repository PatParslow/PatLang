# v2 runtime: rationals (class 5). A block holding the numerator at 16 and
# the denominator at 32, each an int or a bigint, in lowest terms, the
# denominator positive. A rational whose denominator would be 1 is the
# integer instead, so every value here is a true fraction.
quiet_operators()

make a function called rt_rational_heap_type returns t
  let t = 4294967301
  ensure (word_and(t, 4294967295) == 5) and (word_and(t, 4294967296) != 0)
  return t
end

make a function called rational_num takes r returns n
  require (value_class(r) == 5) and value_live(r)
  let n = mem_load_value(value_data(r), 16)
  ensure rt_is_integer(n)
  return n
end

make a function called rational_den takes r returns d
  require (value_class(r) == 5) and value_live(r)
  let d = mem_load_value(value_data(r), 32)
  ensure rt_is_integer(d) and (not rt_int_negative(d)) and (d != 0)
  return d
end

# n / d in lowest terms: an integer when it divides evenly.
make a function called rational_make takes n, d returns r
  require rt_is_integer(n) and rt_is_integer(d)
  if d == 0 then
    print("division by zero")
    let r = rt_stop(74)
    ensure rt_is_integer(r) or (value_class(r) == 5)
    return r
  end
  let g = int_gcd(n, d)
  let n2 = int_divmod(n, g)[0]
  let d2 = int_divmod(d, g)[0]
  if rt_int_negative(d2) then
    let n2 = int_neg(n2)
    let d2 = int_neg(d2)
  end
  if d2 == 1 then
    let r = n2
    ensure rt_is_integer(r) or (value_class(r) == 5)
    return r
  end
  let block = rt_alloc(32)
  mem_init_value(block, 16, n2)
  mem_init_value(block, 32, d2)
  let r = value_make(rt_rational_heap_type(), block)
  ensure rt_is_integer(r) or (value_class(r) == 5)
  return r
end

# A real exact number (integer or rational) as [num, den].
make a function called rt_as_fraction takes v returns nd
  require rt_is_integer(v) or (value_class(v) == 5)
  if value_class(v) == 5 then
    let nd = [rational_num(v), rational_den(v)]
    ensure list_len(nd) == 2
    return nd
  end
  let nd = [v, 1]
  ensure list_len(nd) == 2
  return nd
end

# n / d already in lowest terms, d positive: an integer when d is 1.
make a function called rt_rational_lowest takes n, d returns r
  require rt_is_integer(n) and rt_is_integer(d) and (not rt_int_negative(d)) and (d != 0)
  if d == 1 then
    let r = n
    ensure rt_is_integer(r)
    return r
  end
  let block = rt_alloc(32)
  mem_init_value(block, 16, n)
  mem_init_value(block, 32, d)
  let r = value_make(rt_rational_heap_type(), block)
  ensure (value_class(r) == 5) and (int_gcd(n, d) == 1)
  return r
end

# a/b + sign * c/d, each in lowest terms (Knuth, TAOCP 4.5.1): with
# g = gcd(b, d), the sum is (a*(d/g) + sign*c*(b/g)) / (b*(d/g)), and its
# numerator shares with that denominator only factors of g. So the gcds are
# of the two denominators and of the numerator with g, never of the whole
# numerator and denominator: adding 1/k to a sum of many digits costs a
# division by k.
make a function called rt_rational_add_signed takes a, b, negate returns r
  require (rt_is_integer(a) or (value_class(a) == 5)) and (rt_is_integer(b) or (value_class(b) == 5))
  let x = rt_as_fraction(a)
  let y = rt_as_fraction(b)
  let c = y[0]
  if negate then
    let c = int_neg(c)
  end
  let g = int_gcd(x[1], y[1])
  if g == 1 then
    let n = int_add(int_mul(x[0], y[1]), int_mul(c, x[1]))
    let r = rt_rational_lowest(n, int_mul(x[1], y[1]))
    ensure rt_is_integer(r) or (value_class(r) == 5)
    return r
  end
  let s = int_divmod(x[1], g)[0]
  let t = int_divmod(y[1], g)[0]
  let n = int_add(int_mul(x[0], t), int_mul(c, s))
  if n == 0 then
    let r = 0
    ensure rt_is_integer(r) or (value_class(r) == 5)
    return r
  end
  let d = int_mul(x[1], t)
  let g2 = int_gcd(n, g)
  if g2 != 1 then
    let n = int_divmod(n, g2)[0]
    let d = int_divmod(d, g2)[0]
  end
  let r = rt_rational_lowest(n, d)
  ensure rt_is_integer(r) or (value_class(r) == 5)
  return r
end

make a function called rational_add takes a, b returns r
  require (rt_is_integer(a) or (value_class(a) == 5)) and (rt_is_integer(b) or (value_class(b) == 5))
  let r = rt_rational_add_signed(a, b, false)
  ensure rt_is_integer(r) or (value_class(r) == 5)
  return r
end

make a function called rational_sub takes a, b returns r
  require (rt_is_integer(a) or (value_class(a) == 5)) and (rt_is_integer(b) or (value_class(b) == 5))
  let r = rt_rational_add_signed(a, b, true)
  ensure rt_is_integer(r) or (value_class(r) == 5)
  return r
end

# (a/b) * (c/d), each in lowest terms: a shares factors only with d, and c
# only with b, so those are cancelled before multiplying, and the product is
# in lowest terms.
make a function called rt_rational_mul_parts takes a, b, c, d returns r
  require rt_is_integer(a) and rt_is_integer(b) and rt_is_integer(c) and rt_is_integer(d) and (not rt_int_negative(b)) and (not rt_int_negative(d))
  if (a == 0) or (c == 0) then
    let r = 0
    ensure rt_is_integer(r) or (value_class(r) == 5)
    return r
  end
  let g1 = int_gcd(a, d)
  let g2 = int_gcd(c, b)
  let a2 = a
  let d2 = d
  if g1 != 1 then
    let a2 = int_divmod(a, g1)[0]
    let d2 = int_divmod(d, g1)[0]
  end
  let c2 = c
  let b2 = b
  if g2 != 1 then
    let c2 = int_divmod(c, g2)[0]
    let b2 = int_divmod(b, g2)[0]
  end
  let r = rt_rational_lowest(int_mul(a2, c2), int_mul(b2, d2))
  ensure rt_is_integer(r) or (value_class(r) == 5)
  return r
end

make a function called rational_mul takes a, b returns r
  require (rt_is_integer(a) or (value_class(a) == 5)) and (rt_is_integer(b) or (value_class(b) == 5))
  let x = rt_as_fraction(a)
  let y = rt_as_fraction(b)
  let r = rt_rational_mul_parts(x[0], x[1], y[0], y[1])
  ensure rt_is_integer(r) or (value_class(r) == 5)
  return r
end

# (a/b) / (c/d) is (a/b) * (d/c), the sign moved to the numerator.
make a function called rational_div takes a, b returns r
  require (rt_is_integer(a) or (value_class(a) == 5)) and (rt_is_integer(b) or (value_class(b) == 5)) and (b != 0)
  let x = rt_as_fraction(a)
  let y = rt_as_fraction(b)
  let num = y[1]
  let den = y[0]
  if rt_int_negative(den) then
    let num = int_neg(num)
    let den = int_neg(den)
  end
  let r = rt_rational_mul_parts(x[0], x[1], num, den)
  ensure rt_is_integer(r) or (value_class(r) == 5)
  return r
end

make a function called rational_cmp takes a, b returns c
  require (rt_is_integer(a) or (value_class(a) == 5)) and (rt_is_integer(b) or (value_class(b) == 5))
  let x = rt_as_fraction(a)
  let y = rt_as_fraction(b)
  let c = int_cmp(int_mul(x[0], y[1]), int_mul(y[0], x[1]))
  ensure (c == 0 - 1) or (c == 0) or (c == 1)
  return c
end

# The greatest integer not above r.
make a function called rational_floor takes r returns f
  require value_class(r) == 5
  let qr = int_divmod(rational_num(r), rational_den(r))
  if rt_int_negative(qr[1]) then
    let f = int_sub(qr[0], 1)
    ensure rt_is_integer(f)
    return f
  end
  let f = qr[0]
  ensure rt_is_integer(f)
  return f
end

make a function called rt_rational_to_s takes r returns s
  require value_class(r) == 5
  let s = to_s(rational_num(r)) + "/" + to_s(rational_den(r))
  ensure value_class(s) == 8
  return s
end
