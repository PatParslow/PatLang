# v2 runtime: strings. A string is UTF-8: its block payload is [len:8], its bytes;
# [chars:8], its characters, or -1 until they are first counted; then the bytes.
# A literal is data with the same layout and its heap bit clear (x64.patlang,
# xv_str_data), so all three are always at the same offsets from the data word,
# and only a heap string is ever counted.
#
# A program sees characters: length, indexes, substr, char_code and chr
# (system.patlang). The runtime's own text code works in bytes (str_len,
# rt_byte_at, rt_byte_substr). A string of only ASCII has as many characters as
# bytes, so it indexes in O(1); any other walks from its start, and a scan of one
# goes through the cursor (hosts.patlang, str_intern).
quiet_operators()

make a function called rt_string_class returns c
  let c = 8
  ensure c == 8
  return c
end

# A heap string's type word: class 8 with the heap bit (bit 32).
make a function called rt_string_heap_type returns t
  let t = 4294967304
  ensure (word_and(t, 4294967295) == 8) and (word_and(t, 4294967296) != 0)
  return t
end

make a function called str_len takes s returns n
  require (value_class(s) == 8) and value_live(s)
  let n = mem_load(value_data(s), 16)
  ensure n >= 0
  return n
end

make a function called rt_str_bytes takes s returns addr
  require (value_class(s) == 8)
  let addr = value_data(s) + 32
  ensure addr == value_data(s) + 32
  return addr
end

# How many characters a string has, counted once.
make a function called rt_str_chars takes s returns n
  require value_class(s) == 8
  let block = value_data(s)
  let n = mem_load(block, 24)
  if n < 0 then
    let at = block + 32
    let len = mem_load(block, 16)
    let n = 0
    let i = 0
    while i < len do
      if mem_load_byte(at, i) < 128 then
        let i = i + 1
      else
        let i = i + rt_utf8_step(at, i, len)
      end
      let n = n + 1
    end
    mem_store(block, 24, n)
  end
  ensure n >= 0
  return n
end

# Where a string's character i starts, in bytes from its first byte; i may be
# its character count.
make a function called rt_char_offset takes s, i returns at
  require (value_class(s) == 8) and (i >= 0)
  let len = str_len(s)
  if rt_str_chars(s) == len then
    let at = i
    ensure at >= 0
    return at
  end
  let bytes = rt_str_bytes(s)
  let at = 0
  let k = 0
  while (k < i) and (at < len) do
    let at = at + rt_utf8_step(bytes, at, len)
    let k = k + 1
  end
  ensure (at >= 0) and (at <= len)
  return at
end

# The characters of a string's bytes (spec 1.10). At byte `at` of `len` there
# is either a well-formed UTF-8 sequence, wholly within the bytes (Unicode's
# table 3-7: no overlong form, no surrogate, nothing past U+10FFFF), or a byte
# that starts none, which is a character of its own, U+FFFD. Counting,
# stepping and decoding all go by this, and none reads past `len`.

# Whether byte k of the sequence at `at` lies in [lo, hi] and within len.
make a function called rt_utf8_cont takes bytes, at, k, len, lo, hi returns yes
  require (at >= 0) and (k >= 1)
  if at + k >= len then
    let yes = false
    ensure value_class(yes) == 1
    return yes
  end
  let b = mem_load_byte(bytes, at + k)
  let yes = (b >= lo) and (b <= hi)
  ensure value_class(yes) == 1
  return yes
end

# The length of the well-formed sequence at `at`, or 0 when there is none.
make a function called rt_utf8_seq takes bytes, at, len returns w
  require (at >= 0) and (at < len)
  let lead = mem_load_byte(bytes, at)
  let w = 0
  if lead < 128 then
    let w = 1
  elif (lead >= 194) and (lead <= 223) then
    if rt_utf8_cont(bytes, at, 1, len, 128, 191) then
      let w = 2
    end
  elif (lead >= 224) and (lead <= 239) then
    let lo = 128
    let hi = 191
    if lead == 224 then
      let lo = 160
    elif lead == 237 then
      let hi = 159
    end
    if rt_utf8_cont(bytes, at, 1, len, lo, hi) and rt_utf8_cont(bytes, at, 2, len, 128, 191) then
      let w = 3
    end
  elif (lead >= 240) and (lead <= 244) then
    let lo = 128
    let hi = 191
    if lead == 240 then
      let lo = 144
    elif lead == 244 then
      let hi = 143
    end
    if rt_utf8_cont(bytes, at, 1, len, lo, hi) and rt_utf8_cont(bytes, at, 2, len, 128, 191) and rt_utf8_cont(bytes, at, 3, len, 128, 191) then
      let w = 4
    end
  end
  ensure (w >= 0) and (w <= 4) and (at + w <= len)
  return w
end

# How many bytes the character at `at` takes: its sequence, or the one byte.
make a function called rt_utf8_step takes bytes, at, len returns w
  require (at >= 0) and (at < len)
  let w = rt_utf8_seq(bytes, at, len)
  if w == 0 then
    let w = 1
  end
  ensure (w >= 1) and (at + w <= len)
  return w
end

# The code of the character at `at`.
make a function called rt_utf8_code takes bytes, at, len returns code
  require (at >= 0) and (at < len)
  let w = rt_utf8_seq(bytes, at, len)
  let lead = mem_load_byte(bytes, at)
  if w == 0 then
    let code = 65533
  elif w == 1 then
    let code = lead
  else
    let code = word_and(lead, word_shr(127, w))
    let k = 1
    while k < w do
      let code = word_or(word_shl(code, 6), word_and(mem_load_byte(bytes, at + k), 63))
      let k = k + 1
    end
  end
  ensure (code >= 0) and (code < 1114112)
  return code
end

# A new string of len bytes, its bytes not yet written.
make a function called rt_str_alloc takes len returns block
  require (value_class(len) == 2) and (len >= 0)
  let block = rt_alloc(16 + len)
  mem_store(block, 16, len)
  mem_store(block, 24, 0 - 1)
  ensure mem_load(block, 16) == len
  return block
end

make a function called rt_copy_bytes takes dst, src, n returns r
  require (n >= 0) and ((n == 0) or ((dst != 0) and (src != 0)))
  if n >= 256 then
    extern_call("KERNEL32.DLL", "RtlMoveMemory", dst, src, n)
    let r = 0
    ensure r == 0
    return r
  end
  let i = 0
  while i < n do
    mem_store_byte(dst, i, mem_load_byte(src, i))
    let i = i + 1
  end
  let r = 0
  ensure r == 0
  return r
end

make a function called str_concat takes a, b returns s
  require (value_class(a) == 8) and (value_class(b) == 8) and value_live(a) and value_live(b)
  let la = str_len(a)
  let lb = str_len(b)
  let block = rt_str_alloc(la + lb)
  rt_copy_bytes(block + 32, rt_str_bytes(a), la)
  rt_copy_bytes(block + 32 + la, rt_str_bytes(b), lb)
  let s = value_make(rt_string_heap_type(), block)
  ensure (value_class(s) == 8) and (str_len(s) == str_len(a) + str_len(b))
  return s
end

# -1, 0 or 1 comparing bytes, a shorter prefix first.
make a function called str_cmp takes a, b returns c
  require (value_class(a) == 8) and (value_class(b) == 8)
  let la = str_len(a)
  let lb = str_len(b)
  let pa = rt_str_bytes(a)
  let pb = rt_str_bytes(b)
  let i = 0
  while (i < la) and (i < lb) do
    let x = mem_load_byte(pa, i)
    let y = mem_load_byte(pb, i)
    if x != y then
      if x < y then
        let c = 0 - 1
        ensure (c == 0 - 1) or (c == 0) or (c == 1)
        return c
      end
      let c = 1
      ensure (c == 0 - 1) or (c == 0) or (c == 1)
      return c
    end
    let i = i + 1
  end
  if la < lb then
    let c = 0 - 1
    ensure (c == 0 - 1) or (c == 0) or (c == 1)
    return c
  end
  if la > lb then
    let c = 1
    ensure (c == 0 - 1) or (c == 0) or (c == 1)
    return c
  end
  let c = 0
  ensure (c == 0 - 1) or (c == 0) or (c == 1)
  return c
end

# The same block is the same string; different lengths are not. Otherwise the
# bytes, eight at a time while eight are left.
make a function called str_eq takes a, b returns yes
  require (value_class(a) == 8) and (value_class(b) == 8)
  let ba = value_data(a)
  let bb = value_data(b)
  let n = mem_load(ba, 16)
  if (ba == bb) or (n != mem_load(bb, 16)) then
    let yes = ba == bb
    ensure value_class(yes) == 1
    return yes
  end
  let pa = ba + 32
  let pb = bb + 32
  let i = 0
  while i + 8 <= n do
    if mem_load(pa, i) != mem_load(pb, i) then
      let yes = false
      ensure value_class(yes) == 1
      return yes
    end
    let i = i + 8
  end
  while i < n do
    if mem_load_byte(pa, i) != mem_load_byte(pb, i) then
      let yes = false
      ensure value_class(yes) == 1
      return yes
    end
    let i = i + 1
  end
  let yes = true
  ensure value_class(yes) == 1
  return yes
end

# Whether hay holds needle (spec 1.10). It compares UTF-8 bytes: a needle of
# whole characters matches bytes only where it matches characters, and the
# search never counts characters, so it takes time in proportion to the bytes
# whatever the text holds. The empty needle is in every text.
make a function called str_contains takes hay, needle returns yes
  require (value_class(hay) == 8) and (value_class(needle) == 8)
  let n = mem_load(value_data(hay), 16)
  let m = mem_load(value_data(needle), 16)
  let ph = value_data(hay) + 32
  let pn = value_data(needle) + 32
  let yes = m == 0
  if (m > 0) and (m <= n) then
    let first = mem_load_byte(pn, 0)
    let i = 0
    while (not yes) and (i + m <= n) do
      if mem_load_byte(ph, i) == first then
        let k = 1
        while (k < m) and (mem_load_byte(ph, i + k) == mem_load_byte(pn, k)) do
          let k = k + 1
        end
        if k == m then
          let yes = true
        end
      end
      let i = i + 1
    end
  end
  ensure value_class(yes) == 1
  return yes
end

# Whether the whole of text matches a glob pattern (a match case's glob, spec
# 1.13): * matches any run of characters, none included, ? any one character,
# and every other character itself. Text that is not a string matches nothing.
# A * that fails to cover enough is retried one character longer, so the work
# is at most the text's length times the pattern's.
make a function called glob_match takes text, pattern returns yes
  require value_live(text) and (value_class(pattern) == 8)
  if value_class(text) != 8 then
    let yes = false
    ensure value_class(yes) == 1
    return yes
  end
  let t = str_intern(text)
  let p = str_intern(pattern)
  let tn = sc_len(t)
  let pn = sc_len(p)
  let ti = 0
  let pi = 0
  let star = 0 - 1
  let mark = 0
  while ti < tn do
    let pc = 0 - 1
    if pi < pn then
      let pc = sc_code(p, pi)
    end
    if (pc == 63) or ((pc >= 0) and (pc != 42) and (pc == sc_code(t, ti))) then
      let ti = ti + 1
      let pi = pi + 1
    elif pc == 42 then
      let star = pi
      let mark = ti
      let pi = pi + 1
    elif star >= 0 then
      let mark = mark + 1
      let ti = mark
      let pi = star + 1
    else
      let yes = false
      ensure value_class(yes) == 1
      return yes
    end
  end
  while (pi < pn) and (sc_code(p, pi) == 42) do
    let pi = pi + 1
  end
  let yes = pi == pn
  ensure value_class(yes) == 1
  return yes
end

# The decimal text of a 64-bit int.
make a function called rt_int_to_s takes n returns s
  require (value_class(n) == 2)
  let digits = 0
  let v = n
  if v == 0 then
    let digits = 1
  end
  while v != 0 do
    let digits = digits + 1
    let v = word_div(v, 10)
  end
  let len = digits
  if n < 0 then
    let len = len + 1
  end
  let block = rt_str_alloc(len)
  let at = block + 32
  let pos = len - 1
  let v = n
  if v == 0 then
    mem_store_byte(at, 0, 48)
  end
  while v != 0 do
    let digit = word_rem(v, 10)
    if digit < 0 then
      let digit = 0 - digit
    end
    mem_store_byte(at, pos, 48 + digit)
    let pos = pos - 1
    let v = word_div(v, 10)
  end
  if n < 0 then
    mem_store_byte(at, 0, 45)
  end
  let s = value_make(rt_string_heap_type(), block)
  ensure (value_class(s) == 8) and (str_len(s) >= 1)
  return s
end

# Every value's text, as print shows it.
make a function called to_s takes v returns s
  require value_live(v)
  let c = value_class(v)
  if c == 8 then
    let s = v
    ensure value_class(s) == 8
    return s
  end
  if c == 2 then
    let s = rt_int_to_s(value_data(v))
    ensure value_class(s) == 8
    return s
  end
  if c == 1 then
    if value_data(v) == 0 then
      let s = "false"
      ensure value_class(s) == 8
      return s
    end
    let s = "true"
    ensure value_class(s) == 8
    return s
  end
  if c == 0 then
    let s = ""
    ensure value_class(s) == 8
    return s
  end
  if c == 9 then
    let s = rt_list_to_s(v)
    ensure value_class(s) == 8
    return s
  end
  if c == 3 then
    let s = rt_float_text(value_data(v))
    ensure value_class(s) == 8
    return s
  end
  if c == 4 then
    let s = rt_bigint_to_s(v)
    ensure value_class(s) == 8
    return s
  end
  if c == 5 then
    let s = rt_rational_to_s(v)
    ensure value_class(s) == 8
    return s
  end
  if c == 6 then
    let s = rt_complex_to_s(v)
    ensure value_class(s) == 8
    return s
  end
  if c == 7 then
    let s = rt_interval_to_s(v)
    ensure value_class(s) == 8
    return s
  end
  if c == 15 then
    let s = rt_modint_to_s(v)
    ensure value_class(s) == 8
    return s
  end
  if c == 17 then
    let s = logic_var_name(v)
    ensure value_class(s) == 8
    return s
  end
  if c == 10 then
    let s = "<closure>"
    ensure value_class(s) == 8
    return s
  end
  if c == 11 then
    let s = "<string_builder>"
    ensure value_class(s) == 8
    return s
  end
  if c == 12 then
    let s = "<vec>"
    ensure value_class(s) == 8
    return s
  end
  if c == 13 then
    let s = "<bool_array>"
    ensure value_class(s) == 8
    return s
  end
  if c >= 63 then
    let s = "<" + rt_class_name(c) + ">"
    ensure value_class(s) == 8
    return s
  end
  let s = "<" + type_of(v) + ">"
  ensure value_class(s) == 8
  return s
end

make a function called dot_to_s takes v returns s
  require value_live(v)
  let s = to_s(v)
  ensure value_class(s) == 8
  return s
end

make a function called type_of takes v returns name
  require value_live(v)
  let c = value_class(v)
  if c == 0 then
    let name = "unit"
    ensure (value_class(name) == 8) and (str_len(name) > 0)
    return name
  end
  if c == 1 then
    let name = "bool"
    ensure (value_class(name) == 8) and (str_len(name) > 0)
    return name
  end
  if c == 2 then
    let name = "int"
    ensure (value_class(name) == 8) and (str_len(name) > 0)
    return name
  end
  if c == 3 then
    let name = "float"
    ensure (value_class(name) == 8) and (str_len(name) > 0)
    return name
  end
  if c == 4 then
    let name = "bigint"
    ensure (value_class(name) == 8) and (str_len(name) > 0)
    return name
  end
  if c == 5 then
    let name = "rational"
    ensure (value_class(name) == 8) and (str_len(name) > 0)
    return name
  end
  if c == 6 then
    let name = "complex"
    ensure (value_class(name) == 8) and (str_len(name) > 0)
    return name
  end
  if c == 7 then
    let name = "interval"
    ensure (value_class(name) == 8) and (str_len(name) > 0)
    return name
  end
  if c == 8 then
    let name = "string"
    ensure (value_class(name) == 8) and (str_len(name) > 0)
    return name
  end
  if c == 9 then
    let name = "list"
    ensure (value_class(name) == 8) and (str_len(name) > 0)
    return name
  end
  if c == 10 then
    let name = "closure"
    ensure (value_class(name) == 8) and (str_len(name) > 0)
    return name
  end
  if c == 11 then
    let name = "string_builder"
    ensure (value_class(name) == 8) and (str_len(name) > 0)
    return name
  end
  if c == 12 then
    let name = "vec"
    ensure (value_class(name) == 8) and (str_len(name) > 0)
    return name
  end
  if c == 13 then
    let name = "bool_array"
    ensure (value_class(name) == 8) and (str_len(name) > 0)
    return name
  end
  if c == 17 then
    let name = "logic_var"
    ensure (value_class(name) == 8) and (str_len(name) > 0)
    return name
  end
  let name = rt_class_name(c)
  ensure (value_class(name) == 8) and (str_len(name) > 0)
  return name
end

make a function called dot_length takes v returns n
  require (value_class(v) == 8) or (value_class(v) == 9)
  if value_class(v) == 8 then
    let n = rt_str_chars(v)
    ensure n >= 0
    return n
  end
  if value_class(v) == 9 then
    let n = list_len(v)
    ensure n >= 0
    return n
  end
  let n = rt_fail_class(value_class(v))
  ensure n >= 0
  return n
end

# The strings of a list joined with sep between them: the length is summed
# first, then every byte is copied once.
make a function called str_join takes parts, sep returns s
  require (value_class(parts) == 9) and (value_class(sep) == 8)
  let n = list_len(parts)
  let total = 0
  let k = 0
  while k < n do
    let total = total + str_len(list_get(parts, k))
    let k = k + 1
  end
  if n > 1 then
    let total = total + str_len(sep) * (n - 1)
  end
  let block = rt_str_alloc(total)
  let at = block + 32
  let k = 0
  while k < n do
    if k > 0 then
      rt_copy_bytes(at, rt_str_bytes(sep), str_len(sep))
      let at = at + str_len(sep)
    end
    let part = list_get(parts, k)
    rt_copy_bytes(at, rt_str_bytes(part), str_len(part))
    let at = at + str_len(part)
    let k = k + 1
  end
  let s = value_make(rt_string_heap_type(), block)
  ensure value_class(s) == 8
  return s
end
