# v2 runtime: strings' primitives, numbers from text, files, processes,
# the command line and the environment, through the Windows API
# (extern_call). Structures Windows fills in are uncounted rt_alloc blocks,
# their fields from 16, freed after the call.
quiet_operators()

# ---- strings ----

# The character with this code.
make a function called chr takes n returns s
  require (value_class(n) == 2) and (n >= 0) and (n < 1114112)
  if n < 128 then
    let block = rt_str_alloc(1)
    mem_store_byte(block, 32, n)
  elif n < 2048 then
    let block = rt_str_alloc(2)
    mem_store_byte(block, 32, word_or(192, word_shr(n, 6)))
    mem_store_byte(block, 33, word_or(128, word_and(n, 63)))
  elif n < 65536 then
    let block = rt_str_alloc(3)
    mem_store_byte(block, 32, word_or(224, word_shr(n, 12)))
    mem_store_byte(block, 33, word_or(128, word_and(word_shr(n, 6), 63)))
    mem_store_byte(block, 34, word_or(128, word_and(n, 63)))
  else
    let block = rt_str_alloc(4)
    mem_store_byte(block, 32, word_or(240, word_shr(n, 18)))
    mem_store_byte(block, 33, word_or(128, word_and(word_shr(n, 12), 63)))
    mem_store_byte(block, 34, word_or(128, word_and(word_shr(n, 6), 63)))
    mem_store_byte(block, 35, word_or(128, word_and(n, 63)))
  end
  mem_store(block, 24, 1)
  let s = value_make(rt_string_heap_type(), block)
  ensure (value_class(s) == 8) and (rt_str_chars(s) == 1)
  return s
end

# The code of a string's character i; past either end, -1.
make a function called char_code takes s, i returns n
  require (value_class(s) == 8) and (value_class(i) == 2)
  let n = 0 - 1
  if (i >= 0) and (i < rt_str_chars(s)) then
    let n = rt_utf8_decode(rt_str_bytes(s) + rt_char_offset(s, i))
  end
  ensure n >= 0 - 1
  return n
end

# Up to len characters from character start.
make a function called substr takes s, start, len returns r
  require (value_class(s) == 8) and (value_class(start) == 2) and (value_class(len) == 2)
  let n = rt_str_chars(s)
  let from = start
  if from < 0 then
    let from = 0
  end
  if from > n then
    let from = n
  end
  let count = len
  if from + count > n then
    let count = n - from
  end
  if count < 0 then
    let count = 0
  end
  let first = rt_char_offset(s, from)
  let past = first + count
  if n != str_len(s) then
    let bytes = rt_str_bytes(s)
    let past = first
    let k = 0
    while k < count do
      let past = past + rt_utf8_width(mem_load_byte(bytes, past))
      let k = k + 1
    end
  end
  let block = rt_str_alloc(past - first)
  mem_store(block, 24, count)
  rt_copy_bytes(block + 32, rt_str_bytes(s) + first, past - first)
  let r = value_make(rt_string_heap_type(), block)
  ensure (value_class(r) == 8) and (rt_str_chars(r) <= rt_str_chars(s))
  return r
end

make a function called rt_byte_at takes s, i returns n
  require (value_class(s) == 8) and (value_class(i) == 2)
  # past either end: -1
  let n = 0 - 1
  if (i >= 0) and (i < str_len(s)) then
    let n = mem_load_byte(rt_str_bytes(s), i)
  end
  ensure (n >= 0 - 1) and (n < 256)
  return n
end

make a function called rt_byte_substr takes s, start, len returns r
  require (value_class(s) == 8) and (value_class(start) == 2) and (value_class(len) == 2)
  let n = str_len(s)
  let from = start
  if from < 0 then
    let from = 0
  end
  if from > n then
    let from = n
  end
  let count = len
  if from + count > n then
    let count = n - from
  end
  if count < 0 then
    let count = 0
  end
  let block = rt_str_alloc(count)
  rt_copy_bytes(block + 32, rt_str_bytes(s) + from, count)
  let r = value_make(rt_string_heap_type(), block)
  ensure (value_class(r) == 8) and (str_len(r) <= str_len(s))
  return r
end

# A NUL-terminated copy of a string, for Windows: an uncounted block, its
# bytes from 16. The caller frees it.
make a function called rt_cstr takes s returns block
  require (value_class(s) == 8)
  let n = str_len(s)
  let block = rt_alloc(n + 1)
  rt_copy_bytes(block + 16, rt_str_bytes(s), n)
  mem_store_byte(block, 16 + n, 0)
  ensure mem_load_byte(block, 16 + str_len(s)) == 0
  return block
end

# A string of n bytes read from memory.
make a function called rt_str_from_bytes takes addr, n returns s
  require (n >= 0) and ((n == 0) or (addr != 0))
  let block = rt_str_alloc(n)
  rt_copy_bytes(block + 32, addr, n)
  let s = value_make(rt_string_heap_type(), block)
  ensure (value_class(s) == 8) and (str_len(s) == n)
  return s
end

# ---- numbers from text ----

# The bytes [from, to) are all digits, and there is at least one.
make a function called rt_all_digits takes s, from, to returns yes
  require (value_class(s) == 8) and (from >= 0) and (to <= str_len(s))
  let yes = to > from
  let k = from
  while yes and (k < to) do
    let c = rt_byte_at(s, k)
    let yes = (c >= 48) and (c <= 57)
    let k = k + 1
  end
  ensure value_class(yes) == 1
  return yes
end

# A string without the spaces, tabs and line ends around it.
make a function called rt_trim takes s returns t
  require value_class(s) == 8
  let from = 0
  let to = str_len(s)
  while (from < to) and rt_is_space(rt_byte_at(s, from)) do
    let from = from + 1
  end
  while (to > from) and rt_is_space(rt_byte_at(s, to - 1)) do
    let to = to - 1
  end
  let t = rt_byte_substr(s, from, to - from)
  ensure value_class(t) == 8
  return t
end

make a function called rt_is_space takes c returns yes
  require value_class(c) == 2
  let yes = (c == 32) or ((c >= 9) and (c <= 13))
  ensure value_class(yes) == 1
  return yes
end

# Text as the nearest float: [sign] digits [. digits] [e [sign] digits]; 0.0 for
# anything else.
make a function called rt_float_from_text takes t returns v
  require value_class(t) == 8
  let n = str_len(t)
  let at = 0
  let negative = false
  if (n > 0) and ((rt_byte_at(t, 0) == 45) or (rt_byte_at(t, 0) == 43)) then
    let negative = rt_byte_at(t, 0) == 45
    let at = 1
  end
  let digits = sb_new()
  let fraction = 0
  let stage = 0
  let exp_from = n
  let valid = true
  let k = at
  while valid and (k < n) do
    let c = rt_byte_at(t, k)
    if (c >= 48) and (c <= 57) then
      sb_push(digits, chr(c))
      if stage == 1 then
        let fraction = fraction + 1
      end
    elif (c == 46) and (stage == 0) then
      let stage = 1
    elif (c == 101) or (c == 69) then
      let exp_from = k + 1
      let k = n
    else
      let valid = false
    end
    let k = k + 1
  end
  let scale = 0 - fraction
  if valid and (exp_from < n) then
    let from = exp_from
    let exp_negative = rt_byte_at(t, from) == 45
    if exp_negative or (rt_byte_at(t, from) == 43) then
      let from = from + 1
    end
    if rt_all_digits(t, from, n) then
      let e = int_from_text(rt_byte_substr(t, from, n - from))
      if exp_negative then
        let scale = scale - e
      else
        let scale = scale + e
      end
    else
      let valid = false
    end
  end
  if (not valid) or (sb_len(digits) == 0) then
    let v = rt_float(rt_float_bits_of(0))
    ensure value_class(v) == 3
    return v
  end
  let num = int_from_text(sb_str(digits))
  # past these no float can tell the difference: the largest is near 2 ^ 1024,
  # the smallest near 2 ^ -1074
  let bits = 0
  if (num != 0) and (scale > 400) then
    let bits = word_shl(2047, 52)
  elif (num != 0) and (scale + sb_len(digits) >= 0 - 400) then
    let power = 1
    let steps = scale
    if steps < 0 then
      let steps = 0 - steps
    end
    let p = 0
    while p < steps do
      let power = int_mul(power, 10)
      let p = p + 1
    end
    if scale < 0 then
      let bits = rt_ratio_bits(num, power)
    else
      let bits = rt_ratio_bits(int_mul(num, power), 1)
    end
  end
  if negative then
    let bits = word_xor(bits, word_shl(1, 63))
  end
  let v = rt_float(bits)
  ensure value_class(v) == 3
  return v
end

# A number as it is; a bool as 1 or 0; text, trimmed, as the number it spells
# (an int or bigint for digits with an optional sign, else a float, 0.0 when it
# spells none); anything else 0.
make a function called to_num takes s returns v
  require value_live(s)
  let c = value_class(s)
  if (c >= 2) and (c <= 5) then
    let v = s
    ensure value_live(v)
    return v
  end
  if c == 1 then
    let v = 0
    if s then
      let v = 1
    end
    ensure value_live(v)
    return v
  end
  if c != 8 then
    let v = 0
    ensure value_live(v)
    return v
  end
  let t = rt_trim(s)
  let from = 0
  if (str_len(t) > 0) and ((rt_byte_at(t, 0) == 45) or (rt_byte_at(t, 0) == 43)) then
    let from = 1
  end
  if rt_all_digits(t, from, str_len(t)) then
    if (from == 1) and (rt_byte_at(t, 0) == 43) then
      let v = int_from_text(rt_byte_substr(t, 1, str_len(t) - 1))
      ensure value_live(v)
      return v
    end
    let v = int_from_text(t)
    ensure value_live(v)
    return v
  end
  let v = rt_float_from_text(t)
  ensure value_live(v)
  return v
end

# ---- files ----

make a function called read_file takes path returns text
  require (value_class(path) == 8)
  let cpath = rt_cstr(path)
  # GENERIC_READ, FILE_SHARE_READ, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL
  let h = extern_call("KERNEL32.DLL", "CreateFileA", cpath + 16, 2147483648, 1, 0, 3, 128, 0)
  rt_free(cpath)
  if h == 0 - 1 then
    let text = ""
    ensure value_class(text) == 8
    return text
  end
  let size = extern_call("KERNEL32.DLL", "GetFileSize", h, 0)
  let block = rt_str_alloc(size)
  extern_call("KERNEL32.DLL", "ReadFile", h, block + 32, size, rt_out_word(), 0)
  extern_call("KERNEL32.DLL", "CloseHandle", h)
  let text = value_make(rt_string_heap_type(), block)
  ensure value_class(text) == 8
  return text
end

# Every directory above a path, those that exist staying as they are.
make a function called rt_make_parents takes path returns done
  require value_class(path) == 8
  let k = 1
  while k < str_len(path) do
    let c = rt_byte_at(path, k)
    if (c == 47) or (c == 92) then
      let dir = rt_cstr(rt_byte_substr(path, 0, k))
      extern_call("KERNEL32.DLL", "CreateDirectoryA", dir + 16, 0)
      rt_free(dir)
    end
    let k = k + 1
  end
  let done = true
  ensure done
  return done
end

make a function called write_file takes path, text returns ok
  require (value_class(path) == 8) and value_live(text)
  let cpath = rt_cstr(path)
  # GENERIC_WRITE, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL
  let h = extern_call("KERNEL32.DLL", "CreateFileA", cpath + 16, 1073741824, 0, 0, 2, 128, 0)
  if h == 0 - 1 then
    rt_make_parents(path)
    let h = extern_call("KERNEL32.DLL", "CreateFileA", cpath + 16, 1073741824, 0, 0, 2, 128, 0)
  end
  rt_free(cpath)
  if h == 0 - 1 then
    let ok = false
    ensure value_class(ok) == 1
    return ok
  end
  let t = to_s(text)
  extern_call("KERNEL32.DLL", "WriteFile", h, rt_str_bytes(t), str_len(t), rt_out_word(), 0)
  extern_call("KERNEL32.DLL", "CloseHandle", h)
  let ok = true
  ensure value_class(ok) == 1
  return ok
end

make a function called file_exists takes path returns yes
  require (value_class(path) == 8)
  let cpath = rt_cstr(path)
  let attrs = extern_call("KERNEL32.DLL", "GetFileAttributesA", cpath + 16)
  rt_free(cpath)
  let yes = word_and(attrs, 4294967295) != 4294967295
  ensure value_class(yes) == 1
  return yes
end

# ---- the command line and the environment ----

# The program's arguments, its own path left out: the command line split
# by the Windows rules (spaces separate arguments; quotes group; a
# backslash before a quote escapes it).
make a function called argv returns args
  let line = extern_call("KERNEL32.DLL", "GetCommandLineA")
  let n = 0
  while mem_load_byte(line, n) != 0 do
    let n = n + 1
  end
  let parts = rt_split_command_line(rt_str_from_bytes(line, n))
  let out = []
  let k = mem_load(runtime_state(), 4408)
  while k < list_len(parts) do
    let out = list_push(out, parts[k])
    let k = k + 1
  end
  let args = out
  ensure (value_class(args) == 9)
  return args
end

make a function called rt_split_command_line takes s returns parts
  require (value_class(s) == 8)
  let parts = []
  let n = str_len(s)
  let at = rt_str_bytes(s)
  let i = 0
  while i < n do
    while (i < n) and ((mem_load_byte(at, i) == 32) or (mem_load_byte(at, i) == 9)) do
      let i = i + 1
    end
    if i < n then
      let codes = []
      let quoted = false
      let more = true
      while (i < n) and more do
        let c = mem_load_byte(at, i)
        if (c == 92) and (i + 1 < n) and (mem_load_byte(at, i + 1) == 34) then
          let codes = list_push(codes, 34)
          let i = i + 2
        elif c == 34 then
          let quoted = not quoted
          let i = i + 1
        elif ((c == 32) or (c == 9)) and (not quoted) then
          let more = false
        else
          let codes = list_push(codes, c)
          let i = i + 1
        end
      end
      let parts = list_push(parts, rt_str_from_codes(codes))
    end
  end
  ensure (value_class(parts) == 9)
  return parts
end

make a function called rt_str_from_codes takes codes returns s
  require (value_class(codes) == 9)
  let n = list_len(codes)
  let block = rt_str_alloc(n)
  let k = 0
  while k < n do
    mem_store_byte(block, 32 + k, codes[k])
    let k = k + 1
  end
  let s = value_make(rt_string_heap_type(), block)
  ensure (value_class(s) == 8) and (str_len(s) == list_len(codes))
  return s
end

make a function called getenv takes name returns v
  require (value_class(name) == 8)
  let cname = rt_cstr(name)
  let buf = rt_alloc(32768)
  let n = extern_call("KERNEL32.DLL", "GetEnvironmentVariableA", cname + 16, buf + 16, 32767)
  let v = rt_str_from_bytes(buf + 16, n)
  rt_free(buf)
  rt_free(cname)
  ensure value_class(v) == 8
  return v
end

# ---- processes ----

# A program's path for a command line: Windows searches for a first token with
# no leading "./", so a relative path with a directory in it gets one.
make a function called rt_program_token takes program returns t
  require value_live(program)
  let p = to_s(program)
  let n = str_len(p)
  let has_dir = false
  let k = 0
  while k < n do
    let c = rt_byte_at(p, k)
    if (c == 47) or (c == 92) then
      let has_dir = true
    end
    let k = k + 1
  end
  let first = sc_code(p, 0)
  let relative = (first != 46) and (first != 47) and (first != 92) and (sc_code(p, 1) != 58)
  let t = p
  if has_dir and relative then
    let t = "./" + p
  end
  ensure value_class(t) == 8
  return t
end

# One argument as the Windows rules read it back: quoted when it has a
# space, a tab or a quote, a quote escaped with a backslash.
make a function called rt_quote_arg takes a returns q
  require (value_class(a) == 8)
  let n = str_len(a)
  let at = rt_str_bytes(a)
  let needs = n == 0
  let k = 0
  while k < n do
    let c = mem_load_byte(at, k)
    if (c == 32) or (c == 9) or (c == 34) then
      let needs = true
    end
    let k = k + 1
  end
  if not needs then
    let q = a
    ensure (value_class(q) == 8) and (str_len(q) >= str_len(a))
    return q
  end
  let codes = [34]
  let k = 0
  while k < n do
    let c = mem_load_byte(at, k)
    if c == 34 then
      let codes = list_push(codes, 92)
    end
    let codes = list_push(codes, c)
    let k = k + 1
  end
  let codes = list_push(codes, 34)
  let q = rt_str_from_codes(codes)
  ensure (value_class(q) == 8) and (str_len(q) >= str_len(a))
  return q
end

# The program run with its arguments; what it writes to its output and
# its error stream.
make a function called exec_capture takes program, rest returns out
  require value_live(program) and (value_class(rest) == 9)
  let parts = [rt_quote_arg(rt_program_token(program))]
  let k = 0
  while k < list_len(rest) do
    let parts = list_push(parts, rt_quote_arg(to_s(rest[k])))
    let k = k + 1
  end
  let cmd = rt_cstr(str_join(parts, " "))
  # SECURITY_ATTRIBUTES: inheritable handles
  let sa = rt_alloc(24)
  mem_store(sa, 16, 24)
  mem_store(sa, 24, 0)
  mem_store(sa, 32, 1)
  let pipe = rt_alloc(16)
  extern_call("KERNEL32.DLL", "CreatePipe", pipe + 16, pipe + 24, sa + 16, 0)
  let read_end = mem_load(pipe, 16)
  let write_end = mem_load(pipe, 24)
  # the read end stays with this process (HANDLE_FLAG_INHERIT off)
  extern_call("KERNEL32.DLL", "SetHandleInformation", read_end, 1, 0)
  # STARTUPINFOA, 104 bytes: cb, then dwFlags = STARTF_USESTDHANDLES at
  # 60, the standard handles at 80, 88, 96
  let si = rt_alloc(104)
  let k = 0
  while k < 13 do
    mem_store(si, 16 + 8 * k, 0)
    let k = k + 1
  end
  mem_store(si, 16, 104)
  mem_store(si, 76, 256)
  mem_store(si, 96, extern_call("KERNEL32.DLL", "GetStdHandle", 0 - 10))
  mem_store(si, 104, write_end)
  mem_store(si, 112, write_end)
  let pi = rt_alloc(24)
  let ok = extern_call("KERNEL32.DLL", "CreateProcessA", 0, cmd + 16, 0, 0, 1, 0, 0, 0, si + 16, pi + 16)
  extern_call("KERNEL32.DLL", "CloseHandle", write_end)
  let chunks = []
  if ok != 0 then
    let buf = rt_alloc(4096)
    let reading = true
    while reading do
      let w = rt_out_word()
      let got = extern_call("KERNEL32.DLL", "ReadFile", read_end, buf + 16, 4096, w, 0)
      let n = word_and(mem_load(w, 0), 4294967295)
      if (got == 0) or (n == 0) then
        let reading = false
      else
        let chunks = list_push(chunks, rt_str_from_bytes(buf + 16, n))
      end
    end
    rt_free(buf)
    extern_call("KERNEL32.DLL", "WaitForSingleObject", mem_load(pi, 16), 4294967295)
    extern_call("KERNEL32.DLL", "CloseHandle", mem_load(pi, 16))
    extern_call("KERNEL32.DLL", "CloseHandle", mem_load(pi, 24))
  end
  extern_call("KERNEL32.DLL", "CloseHandle", read_end)
  rt_free(cmd)
  rt_free(sa)
  rt_free(pipe)
  rt_free(si)
  rt_free(pi)
  let out = str_join(chunks, "")
  ensure value_class(out) == 8
  return out
end
