# v2 runtime: the in-memory file layer, a list of [path, contents] at
# runtime_state() + 4368, written to disk only by vfs_flush_to_disk.
quiet_operators()

make a function called rt_vfs_init returns r
  let st = runtime_state()
  mem_store(st, 4368, 0)
  mem_store(st, 4376, 0)
  mem_init_value(st, 4368, [])
  let r = 0
  ensure r == 0
  return r
end

make a function called rt_vfs_set takes path, contents returns done
  require (value_class(path) == 8) and value_live(contents)
  let entries = rt_global_get(4368)
  let i = rt_pairs_index(entries, path)
  if i >= 0 then
    rt_global_set(4368, list_set(entries, i, [path, contents]))
  else
    rt_global_set(4368, list_push(entries, [path, contents]))
  end
  let done = true
  ensure value_class(done) == 1
  return done
end

make a function called vfs_read takes path returns contents
  require (value_class(path) == 8)
  let entries = rt_global_get(4368)
  let i = rt_pairs_index(entries, path)
  if i < 0 then
    print("vfs_read: not found: " + path)
    let contents = extern_call("KERNEL32.DLL", "ExitProcess", 95)
    ensure value_live(contents)
    return contents
  end
  let contents = entries[i][1]
  ensure value_live(contents)
  return contents
end

make a function called vfs_write takes path, contents returns result
  require (value_class(path) == 8) and value_live(contents)
  let result = rt_vfs_set(path, contents)
  ensure value_class(result) == 1
  return result
end

make a function called vfs_append takes path, text returns result
  require (value_class(path) == 8) and (value_class(text) == 8)
  let entries = rt_global_get(4368)
  let i = rt_pairs_index(entries, path)
  if i < 0 then
    let result = rt_vfs_set(path, text)
    ensure value_class(result) == 1
    return result
  end
  let result = rt_vfs_set(path, str_concat(entries[i][1], text))
  ensure value_class(result) == 1
  return result
end

make a function called vfs_exists takes path returns result
  require (value_class(path) == 8)
  if rt_pairs_index(rt_global_get(4368), path) >= 0 then
    let result = "1"
    ensure value_class(result) == 8
    return result
  end
  let result = "0"
  ensure value_class(result) == 8
  return result
end

make a function called vfs_delete takes path returns existed
  require (value_class(path) == 8)
  let entries = rt_global_get(4368)
  let out = []
  let existed = false
  let i = 0
  while i < list_len(entries) do
    if entries[i][0] == path then
      let existed = true
    else
      let out = list_push(out, entries[i])
    end
    let i = i + 1
  end
  rt_global_set(4368, out)
  ensure value_class(existed) == 1
  return existed
end

# The paths under a prefix, sorted.
make a function called vfs_list takes prefix returns result
  require (value_class(prefix) == 8)
  let entries = rt_global_get(4368)
  let n = str_len(prefix)
  let matches = []
  let i = 0
  while i < list_len(entries) do
    if substr(entries[i][0], 0, n) == prefix then
      let matches = list_push(matches, entries[i][0])
    end
    let i = i + 1
  end
  let result = rt_sort_strings(matches)
  ensure (value_class(result) == 9)
  return result
end

make a function called vfs_flush_to_disk takes prefix, real_dir returns count
  require (value_class(prefix) == 8) and (value_class(real_dir) == 8)
  let paths = vfs_list(prefix)
  let i = 0
  while i < list_len(paths) do
    write_file(real_dir + "/" + paths[i], vfs_read(paths[i]))
    let i = i + 1
  end
  let count = list_len(paths)
  ensure count >= 0
  return count
end
