# Appending to a string nothing else holds takes about the same time per append however long
# it grows (spec 1.10): four times the appends take no more than about eight times the cycles
# (linear four, quadratic sixteen). Each append adds 16 characters, so that copying the string
# would cost more than running the loop and a copy on every append shows as sixteen times. It
# counts cpu_cycles (issue #268), each count the cheapest of several readings after a warm-up
# (lib/cost_check.patlang, #284).
include "../../../lib/cost_check.patlang"

make a function called appends takes n returns cost
  let t0 = cpu_cycles()
  let s = ""
  let i = 0
  while i < n do
    let s = s + "xxxxxxxxxxxxxxxx"
    let i = i + 1
  end
  if s.length != 16 * n then
    print("wrong length")
  end
  return cpu_cycles() - t0
end

let best = cheapest_cycles([|| do return appends(25000) end, || do return appends(100000) end], cost_rounds())
print(best[1] <= 8 * best[0] + 150000000)
