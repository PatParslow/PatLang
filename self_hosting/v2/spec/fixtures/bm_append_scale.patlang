# Appending to a string nothing else holds takes about the same time per append however long
# it grows (spec 1.10): twice the appends take no more than about three times as long.
make a function called appends takes n returns ms
  let t0 = now_ms()
  let s = ""
  let i = 0
  while i < n do
    let s = s + "x"
    let i = i + 1
  end
  if s.length != n then
    print("wrong length")
  end
  return now_ms() - t0
end

let small = appends(100000)
let large = appends(200000)
print(large <= 3 * small + 50)
