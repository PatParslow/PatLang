# Appending to a string nothing else holds takes about the same time per append however long
# it grows (spec 1.10): twice the appends take no more than about three times as long. Each
# append adds 16 characters, so that copying the string would cost more than running the loop
# and a copy on every append shows as four times as long.
make a function called appends takes n returns ms
  let t0 = now_ms()
  let s = ""
  let i = 0
  while i < n do
    let s = s + "xxxxxxxxxxxxxxxx"
    let i = i + 1
  end
  if s.length != 16 * n then
    print("wrong length")
  end
  return now_ms() - t0
end

let small = appends(50000)
let large = appends(100000)
print(large <= 3 * small + 50)
