# concurrency.feature, spec 1.6: fibers and threads that end hold no memory.
make a function called yields_once takes x returns r
  let got = fiber_yield([x, "yielded"])
  return [got, "returned"]
end

make a function called run takes kind, n returns last
  let last = 0
  let i = 0
  while i < n do
    if kind == "fiber" then
      let id = fiber_new("yields_once")
      fiber_resume(id, i)
      let last = fiber_resume(id, "x" + i)
    elif kind == "budgeted" then
      let m = i
      let last = budgeted(100000) {
        let j = 0
        while j < 3 do
          let j = j + 1
        end
        [m, j]
      }
    elif kind == "thread" then
      let m = i
      let last = thread_result(thread_spawn(|| { return [m, "text " + m] }))
    end
    let i = i + 1
  end
  return last
end

let a = argv()
run(a[0], to_num(a[1]))
print("done")
