# spec 1.6: values that hold each other are freed once nothing else holds them.
# A loop that makes a cycle each iteration and drops it does not grow memory.
# Arguments: the kind of cycle, then N.
class Node {
  field other = 0
  field items = 0
}

make a function called run takes kind, n returns last
  let last = 0
  let i = 0
  while i < n do
    if kind == "two_objects" then
      let a = new("Node")
      let b = new("Node")
      a.other = b
      b.other = a
      let last = i
    elif kind == "vec_in_itself" then
      let v = vec_new()
      vec_push(v, "payload " + i)
      vec_push(v, v)
      let last = i
    elif kind == "object_list_object" then
      let parent = new("Node")
      let child = new("Node")
      child.other = parent
      parent.items = [child, [child, "x" + i]]
      let last = i
    elif kind == "closure_in_vec" then
      let held = vec_new()
      let f = || { return vec_len(held) }
      vec_push(held, f)
      let last = f()
    end
    let i = i + 1
  end
  return last
end

let args = argv()
run(args[0], to_num(args[1]))
# what is still held is untouched by the freeing: a cycle with a holder lives
let keep = new("Node")
let mate = new("Node")
keep.other = mate
mate.other = keep
run("two_objects", 5000)
if keep.other.other == keep then
  print("done")
end
