# spec 1.6: releasing a value takes no more stack however deeply it is
# nested: a list nested a million deep, each level a list holding the one
# below, is built, dropped and built again, and the program ends normally.
make a function called deep takes n returns v
  let v = []
  let i = 0
  while i < n do
    let v = [v]
    let i = i + 1
  end
  return v
end

let n = to_num(argv()[0])
let a = deep(n)
let a = 0
let b = deep(n)
print(list_len(b))
let b = 0
print("done")
