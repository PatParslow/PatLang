# spec_library/values_and_memory, spec 1.6: a loop replacing one value each iteration does not grow memory. Arguments: the producer, then N.
class Widget {
  field n = 0
}

make a function called run takes kind, n returns last
  let last = 0
  let s = ""
  let l = []
  let older = [1, 2, 3, 4, 5, 6, 7, 8]
  let total = 9223372036854775807
  let i = 0
  while i < n do
    if kind == "str_concat" then
      let last = "x" + i
    elif kind == "str_grow" then
      if (i % 100) == 0 then
        let s = ""
      end
      let s = s + "x"
      let last = s
    elif kind == "list3" then
      let last = [i, i + 1, "s"]
    elif kind == "list_push" then
      if (i % 100) == 0 then
        let l = []
      end
      let l = list_push(l, i)
      let last = l
    elif kind == "list_set_older" then
      let newer = list_set(older, 0, i)
      let last = older[1] + newer[0]
    elif kind == "bigint" then
      let total = total + i
      let last = total
    elif kind == "rational" then
      let last = i / 7
    elif kind == "complex" then
      let last = sqrt(0 - 4) * i
    elif kind == "object" then
      let w = new("Widget")
      let last = w
    elif kind == "sb" then
      let b = sb_new()
      let k = 0
      while k < 10 do
        sb_push(b, "ab")
        let k = k + 1
      end
      let last = sb_str(b)
    elif kind == "vec" then
      let v = vec_new()
      let k = 0
      while k < 10 do
        vec_push(v, k)
        let k = k + 1
      end
      let last = vec_len(v)
    elif kind == "bool_array" then
      let ba = bool_array_new(0)
      let k = 0
      while k < 100 do
        bool_array_push(ba, (k % 3) == 0)
        let k = k + 1
      end
      let last = bool_array_len(ba)
    elif kind == "closure" then
      let f = |x| { return x + i }
      let last = f(1)
    elif kind == "exec" then
      let last = exec_capture("cmd", "/c", "echo " + i)
    elif kind == "read_file" then
      let last = read_file("self_hosting/v2/spec/fixtures/bm_loops.patlang")
    end
    let i = i + 1
  end
  return last
end

let args = argv()
let result = run(args[0], to_num(args[1]))
print("done")
