# Finding a named object takes about the same time however many there are (spec 1.6): the
# same lookups at 1,000 and at 16,000 objects, in cpu_cycles (issue #268): a look at every
# object would make it about sixteen times. Each count is the cheapest of several readings
# after a warm-up (lib/cost_check.patlang, #284); the two are read apart, since the objects
# are made between them.
include "../../../lib/cost_check.patlang"

make a function called make_objects takes from, to returns done
  let i = from
  while i < to do
    new("Widget", "w" + i)
    let i = i + 1
  end
  return true
end

make a function called lookups takes n returns cost
  let t0 = cpu_cycles()
  let i = 0
  while i < 20000 do
    get("w" + (i % n), "type")
    let i = i + 1
  end
  return cpu_cycles() - t0
end

make_objects(0, 1000)
let small = cheapest_cycles([|| do return lookups(1000) end], cost_rounds())[0]
make_objects(1000, 16000)
let large = cheapest_cycles([|| do return lookups(16000) end], cost_rounds())[0]
print(large <= 3 * small + 60000000)
