# Finding a named object takes about the same time however many there are (spec 1.6): the
# same lookups at 1,000 and at 16,000 objects, the better of two tries at each.
make a function called make_objects takes from, to returns done
  let i = from
  while i < to do
    new("Widget", "w" + i)
    let i = i + 1
  end
  return true
end

make a function called lookups takes n returns ms
  let t0 = now_ms()
  let i = 0
  while i < 20000 do
    get("w" + (i % n), "type")
    let i = i + 1
  end
  return now_ms() - t0
end

make a function called best_of_two takes n returns ms
  let a = lookups(n)
  let b = lookups(n)
  if a < b then
    return a
  end
  return b
end

make_objects(0, 1000)
let small = best_of_two(1000)
make_objects(1000, 16000)
let large = best_of_two(16000)
print(large <= 3 * small + 20)
