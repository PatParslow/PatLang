# Many named objects: each is found by its name, a repeated name finds the first until that is
# deleted, and a deleted name is gone (spec 1.6).
let n = 5000
let i = 0
while i < n do
  let o = new("Widget", "w" + i)
  o.v = i
  let i = i + 1
end
let total = 0
let i = 0
while i < n do
  let total = total + get("w" + i, "v")
  let i = i + 1
end
print(total)
let first = new("Widget", "same")
first.v = 1
let second = new("Widget", "same")
second.v = 2
print(get("same", "v"))
object_delete(first)
print(get("same", "v"))
object_delete(second)
let i = 0
while i < n do
  object_delete("w" + i)
  let i = i + 1
end
print("w7".length)
let again = new("Widget", "w7")
again.v = 70
print(get("w7", "v"))
