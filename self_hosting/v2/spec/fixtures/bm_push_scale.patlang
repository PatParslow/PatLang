# Pushing onto a list nothing else holds takes about the same time per push however long it
# grows, also when the pushed value reads the list (spec 1.5): twice the pushes take no more
# than about three times as long.
make a function called pushes takes n returns ms
  let t0 = now_ms()
  let out = [1]
  let k = 0
  while k < n do
    let out = list_push(out, out[k] * 3 % 1000)
    let k = k + 1
  end
  if list_len(out) != n + 1 then
    print("wrong length")
  end
  return now_ms() - t0
end

let small = pushes(20000)
let large = pushes(40000)
print(large <= 3 * small + 50)
