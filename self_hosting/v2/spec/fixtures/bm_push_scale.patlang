# Pushing onto a list nothing else holds takes about the same time per push however long it
# grows, also when the pushed value reads the list (spec 1.5): four times the pushes take no
# more than about eight times the cycles (linear four, quadratic sixteen). It counts cpu_cycles
# (issue #268).
make a function called pushes takes n returns cost
  let t0 = cpu_cycles()
  let out = [1]
  let k = 0
  while k < n do
    let out = list_push(out, out[k] * 3 % 1000)
    let k = k + 1
  end
  if list_len(out) != n + 1 then
    print("wrong length")
  end
  return cpu_cycles() - t0
end

let small = pushes(10000)
let large = pushes(40000)
print(large <= 8 * small + 150000000)
