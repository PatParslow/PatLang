# worlds.feature, spec 1.6 and 1.15: a stop in a world gives back what the
# frames it ends held. argv: the kind, then the number of iterations. Each
# iteration's code holds a list of 1000 ints on each of three frames when it
# stops (or, for "suspended", when its world is freed with the fiber paused).
make a function called held_list takes m returns xs
  let xs = []
  let k = 0
  while k < 1000 do
    let xs = list_push(xs, m + k)
    let k = k + 1
  end
  return xs
end

make a function called innermost takes m returns r
  let c = held_list(m)
  exit_with(5)
  return list_len(c)
end

make a function called middle takes m returns r
  let b = held_list(m)
  let r = innermost(m) + list_len(b)
  return r
end

make a function called outer takes m returns r
  let a = held_list(m)
  let r = middle(m) + list_len(a)
  return r
end

make a function called pausing takes m returns r
  let a = held_list(m)
  fiber_yield(list_len(a))
  return list_len(a)
end

make a function called run takes kind, n returns last
  let last = 0
  let i = 0
  while i < n do
    let w = world_new()
    let m = i
    if kind == "stop" then
      let last = world_call(w, || { return outer(m) })
    elif kind == "fiber" then
      let last = world_call(w, || {
        let f = fiber_new("outer")
        return fiber_resume(f, m)
      })
    elif kind == "thread" then
      let last = world_call(w, || {
        let t = thread_spawn(|| { return outer(m) })
        return thread_result(t)
      })
    else
      let last = world_call(w, || {
        let f = fiber_new("pausing")
        return fiber_resume(f, m)
      })
    end
    world_free(w)
    let i = i + 1
  end
  return last
end

let args = argv()
run(args[0], to_num(args[1]))
print("done")
