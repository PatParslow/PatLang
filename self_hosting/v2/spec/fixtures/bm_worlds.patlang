# worlds.feature, spec 1.6 and 1.15: worlds that are freed hold no memory.
make a function called run takes n returns last
  let last = 0
  let i = 0
  while i < n do
    let w = world_new()
    let m = i
    let last = world_call(w, || {
      fact("n", "is", "" + m)
      class_define("Point", "", [["x", m]], [], [], [])
      vfs_write("/f", "file " + m)
      new("Point", "p")
      print(m)
      return [m, query("n", "is", 0)]
    })
    world_free(w)
    let i = i + 1
  end
  return last
end

run(to_num(argv()[0]))
print("done")
