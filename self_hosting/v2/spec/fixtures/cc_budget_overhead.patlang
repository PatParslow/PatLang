# spec 1.8: a budgeted block looks at the clock once per batch of
# iterations, not at every one, so a loop of cheap iterations runs nearly as
# fast budgeted as plain, and still yields close to its deadline.
# - 2 million cheap iterations take no more than twenty times as long
#   budgeted (with a budget too large to run out) as plain, the best of three
#   runs of each: about five times now, where looking at the clock and
#   predicting at every back-edge made it about a hundred (the best of three,
#   since one run of a few milliseconds can be held up by other work)
# - a block of 1 ms iterations given 50 ms yields after between 25 and 80 ms
#   (it yields once the next iteration is judged to pass the deadline),
#   resumed until done, and all its iterations run
# It prints true, then true, then the iteration count.
make a function called plain takes n returns s
  let s = 0
  let i = 0
  while i < n do
    let s = s + i
    let i = i + 1
  end
  return s
end

make a function called plain_ms takes n returns ms
  let t0 = clock_ms()
  plain(n)
  return clock_ms() - t0
end

make a function called budgeted_ms takes n returns ms
  let t0 = clock_ms()
  let s = 0
  budgeted(100000) {
    let i = 0
    while i < n do
      let s = s + i
      let i = i + 1
    end
  }
  return clock_ms() - t0
end

let n = 2000000
let best_plain = plain_ms(n)
let best_budgeted = budgeted_ms(n)
let run = 1
while run < 3 do
  let p = plain_ms(n)
  if p < best_plain then
    let best_plain = p
  end
  let b = budgeted_ms(n)
  if b < best_budgeted then
    let best_budgeted = b
  end
  let run = run + 1
end
print(best_budgeted <= 20 * best_plain + 20)

let t3 = clock_ms()
let r = budgeted(50) {
  let k = 0
  while k < 200 do
    sleep_ms(1)
    let k = k + 1
  end
  k
}
let first = clock_ms() - t3
print((first >= 25) and (first <= 80))
while r[0] == "paused" do
  let r = budgeted(50, r[1]) {
    "not used: the body is already running"
  }
end
print(r[1])
