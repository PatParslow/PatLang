# spec 1.8: threads waiting on one of the runtime's locks give up the
# processor while they wait, so more threads than processors do not hold off
# the one whose turn it is. The same work, 32000 virtual files written, is
# done by 4 threads and then by 16: the 16 take no more than about four times
# as long (spinning, they once took about 165 times as long). It prints the
# two times, then true when that holds.
make a function called writer takes job returns n
  let i = 0
  while i < job[1] do
    vfs_write(job[0] + "/f" + i, "x")
    let i = i + 1
  end
  return i
end

make a function called run takes tag, t returns ms
  let items = []
  let i = 0
  while i < t do
    let items = list_push(items, [tag + i, 32000 / t])
    let i = i + 1
  end
  let t0 = clock_ms()
  parallel_map(items, "writer")
  return clock_ms() - t0
end

let few = run("a", 4)
let many = run("b", 16)
print("4 threads " + few + " ms, 16 threads " + many + " ms")
print(many <= 4 * few + 200)
