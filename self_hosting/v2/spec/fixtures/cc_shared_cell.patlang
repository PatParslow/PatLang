# A vec belongs to the thread using it (spec 1.8). Four threads pushing onto
# one vec either never meet, and every push is there, or two of them are in it
# at once, and the program stops saying so. Memory is never corrupted.
let v = vec_new()
let ids = []
let k = 0
while k < 4 do
  let ids = list_push(ids, thread_spawn(|| do
    let i = 0
    while i < 50000 do
      vec_push(v, i)
      let i = i + 1
    end
    return i
  end))
  let k = k + 1
end
let total = 0
let j = 0
while j < 4 do
  let total = total + thread_result(ids[j])
  let j = j + 1
end
print(total)
print(vec_len(v))
