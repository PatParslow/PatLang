# spec 1.8: threads waiting on one listener at once. tcp_accept_timeout gives
# -1 to each once its time is up, however their waits overlap, and the
# listener still waits for a client in a later tcp_accept. A runtime that
# switched the listener between blocking and non-blocking for each wait left
# one thread blocked in accept for ever.
make a function called wait_on takes pm returns id
  return tcp_accept_timeout(pm[0], pm[1])
end

let port = tcp_listen(0)
let rounds = 0
let all_empty = true
while rounds < 20 do
  let got = parallel_map([[port, 20], [port, 30], [port, 40]], "wait_on")
  if got != [0 - 1, 0 - 1, 0 - 1] then
    let all_empty = false
  end
  let rounds = rounds + 1
end
print(all_empty)
let client = thread_spawn(|| do
  sleep_ms(100)
  let c = tcp_connect("127.0.0.1", port)
  tcp_write(c, "hello")
  tcp_close(c)
  return true
end)
let conn = tcp_accept(port)
print(tcp_read(conn))
tcp_close(conn)
print(thread_result(client))
