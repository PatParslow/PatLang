# The runtime's own tables are safe to change from several threads (spec 1.8):
# four workers write the virtual file system at once, declare handlers and
# actions, and every write is there afterwards.
make a function called writer takes seed returns n
  let i = 0
  while i < 5000 do
    vfs_write("f" + seed + "_" + (i % 50), "x" + i)
    vfs_append("log" + seed, "a")
    if vfs_exists("f" + seed + "_0") then
      let i = i + 1
    end
  end
  action_add("act" + seed, [], [["done", ["" + seed]]], [], 1)
  return i
end
print(parallel_map([1, 2, 3, 4], "writer"))
print(list_len(vfs_list("f")))
print(vfs_read("f3_49"))
print(vfs_read("log2").length)
print(list_len(vfs_list("")))
print(plan_labels(plan([["done", ["4"]]])))
