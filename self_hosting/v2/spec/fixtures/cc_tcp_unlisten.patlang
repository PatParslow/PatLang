# spec 1.8: tcp_unlisten(port) closes this program's listener, and the port is
# free at once: nothing is listening on it, and the program can listen on it
# again. A thread waiting on that listener with tcp_accept_timeout gets -1
# well before its time is up, at its next look, rather than waiting on a
# socket that is gone.
let port = tcp_listen(0)
print(port > 0)
tcp_unlisten(port)
print(tcp_try_connect("127.0.0.1", port))
let again = tcp_try_listen(port)
print(again == port)
let started = clock_ms()
let waiter = thread_spawn(|| do
  return tcp_accept_timeout(port, 10000)
end)
sleep_ms(200)
tcp_unlisten(port)
print(thread_result(waiter))
print(clock_ms() - started < 5000)
let third = tcp_try_listen(port)
print(third == port)
let client = thread_spawn(|| do
  let c = tcp_connect("127.0.0.1", port)
  tcp_write(c, "still a listener")
  tcp_close(c)
  return true
end)
let conn = tcp_accept(port)
print(tcp_read(conn))
tcp_close(conn)
print(thread_result(client))
tcp_unlisten(port)
