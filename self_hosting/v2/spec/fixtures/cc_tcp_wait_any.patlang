# spec 1.8: tcp_wait_any(conns, ports, ms) waits up to ms (-1 for no limit)
# for any of the connections to have something to read or to have ended, or
# any of the listeners to have a client waiting. It gives
# [ready connections, ready ports], each in the order given, and [[], []] when
# the time is up.
let port = tcp_listen(0)
let t0 = clock_ms()
print(tcp_wait_any([], [port], 300))
print(clock_ms() - t0 >= 250)
let a = tcp_connect("127.0.0.1", port)
let got = tcp_wait_any([], [port], 5000)
print(got[0] == [] and got[1] == [port])
let a2 = tcp_accept(port)
let b = tcp_connect("127.0.0.1", port)
let b2 = tcp_accept(port)
print(tcp_wait_any([a, a2, b, b2], [port], 50))
tcp_write(a, "to a2")
let r1 = tcp_wait_any([a, a2, b, b2], [port], 5000)
print(r1[0] == [a2] and r1[1] == [])
print(tcp_read(a2))
tcp_write(b2, "to b")
tcp_write(a2, "to a")
sleep_ms(100)
# given b before a, both ready: b, then a
let r2 = tcp_wait_any([b, a], [], 0 - 1)
print(r2[0] == [b, a])
print(tcp_read(a) + " " + tcp_read(b))
tcp_close(a)
let r3 = tcp_wait_any([a2, b2], [], 5000)
print(r3[0] == [a2])
print(tcp_read_status(a2, 0)[1])
tcp_close(a2)
tcp_close(b)
tcp_close(b2)
