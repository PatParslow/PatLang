# constant_time.feature: AEAD_CHACHA20_POLY1305 (packages/tls) sealing and
# opening with a secret key. Nothing takes time depending on the key or the
# text; the tag check's verdict is the one declared reveal.
include "../../../../packages/tls/tls.patlang"

let key = []
let i = 0
while i < 32 do
  let key = list_push(key, cc_byte(i * 5 + 1))
  let i = i + 1
end
let nonce = [7, 0, 0, 0, 64, 65, 66, 67, 68, 69, 70, 71]
let text = []
let i = 0
while i < 70 do
  let text = list_push(text, cc_byte(i))
  let i = i + 1
end
let sealed = chacha20_poly1305_seal(key, nonce, [80, 81, 82], text)
print(chacha20_poly1305_check(key, nonce, [80, 81, 82], sealed))
print(type_of(chacha20_poly1305_open(key, nonce, [80, 81, 82], sealed)))
