# constant_time.feature: AES-128-GCM (packages/tls) sealing and opening with a
# secret key. The S-box is computed, not looked up, so nothing takes time or
# reads an address depending on the key or the text; the tag check's verdict
# is the one declared reveal.
include "../../../../packages/tls/tls.patlang"

let byte = mod_make(0, 256)
let key = []
let i = 0
while i < 16 do
  let key = list_push(key, mod_make(i * 11 + 5, byte))
  let i = i + 1
end
let nonce = [202, 254, 186, 190, 250, 206, 219, 173, 222, 202, 248, 136]
let text = []
let i = 0
while i < 20 do
  let text = list_push(text, mod_make(i * 3, byte))
  let i = i + 1
end
let sealed = aes128_gcm_seal(key, nonce, [1, 2, 3], text)
let opened = aes128_gcm_open(key, nonce, [1, 2, 3], sealed)
print(type_of(opened))
