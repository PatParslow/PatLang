# constant_time.feature: arithmetic on, and an address from, a word of a
# modint's residue, read from its block.
# It reads the runtime's own state, so it is a runtime file (spec 1.13).
quiet_operators()
let a = mod_make(3, 7)
let w = mem_load(value_data(a), 64)
let x = w + 1
let y = mem_load(value_data(a), w)
