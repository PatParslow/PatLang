# constant_time.feature: modint operations alone, compared only in an assert.
# Nothing here may take time depending on a residue.
let p = 57896044618658097711785492504343953926634992332820282019728792003956564819949
let a = mod_make(9, p)
let b = mod_make(121665, p)
let c = a * b + a - b
let d = c / b
let e = pow(d, 3)
let f = -e
let g = pow(e, 0 - 2)
let q = mod_make(5, 12884901888)
let r = q * q - q / mod_make(7, 12884901888)
let s = mod_make(5, 4294967296)
let t = (rotr(s, 7) bxor (s shl 3)) band (bnot s) bor (s shr 2)
let u = rotl(s, 30) + t * s
assert f == f
assert g != e
assert r == r
assert u == u
print("done")
