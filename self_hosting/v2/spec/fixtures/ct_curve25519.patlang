# constant_time.feature: X25519 key agreement, Ed25519 key making and Ed25519
# signing, written in PatLang on modints; the check finds nothing in them.
include "../../lib/curve25519.patlang"

let k = cv_hex_bytes("a546e36bf0527c9d3b16154b82465edd62144c0ac1fc5a18506a2244ba449ac4")
let u = cv_hex_bytes("e6db6867583030db3594c1a424b15f7c726624ec26b3353b10a903a6d0ab1c4c")
let shared = x25519(k, u)
let seed = cv_hex_bytes("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60")
let pk = ed25519_public(seed)
let sig = ed25519_sign(seed, cv_hex_bytes("af82"))
print("done")
