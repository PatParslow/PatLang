# constant_time.feature: a tag check that makes its verdict public through
# mod_reveal. The comparison runs over every byte whatever they are, and only
# the verdict leaves the class: the check lists it as declared, naming
# tag_matches, and reports nothing.
make a function called tag_matches takes a, b returns ok
  let diff = mod_make(0, 256)
  let i = 0
  while i < 16 do
    let diff = diff bor (mod_make(a[i], 256) bxor mod_make(b[i], 256))
    let i = i + 1
  end
  let ok = mod_reveal(diff) == 0
  return ok
end

let t = []
let u = []
let i = 0
while i < 16 do
  let t = list_push(t, mod_make(i * 7, 256))
  let u = list_push(u, mod_make(i * 7, 256))
  let i = i + 1
end
print(tag_matches(t, u))
print(tag_matches(t, list_set(u, 3, mod_make(1, 256))))
