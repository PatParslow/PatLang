# constant_time.feature: the TLS 1.3 key schedule (packages/tls) on a secret
# input, a shared secret's stand-in: HKDF-Extract, Derive-Secret and
# HKDF-Expand-Label with SHA-256 and SHA-384 on modints. Nothing depends on it.
include "../../../../packages/tls/tls.patlang"

let byte = mod_make(0, 256)
let shared = []
let i = 0
while i < 32 do
  let shared = list_push(shared, mod_make(i * 7 + 3, byte))
  let i = i + 1
end
let algs = ["sha256", "sha384"]
let a = 0
while a < 2 do
  let alg = algs[a]
  let zeros = []
  let i = 0
  while i < tls_hash_len(alg) do
    let zeros = list_push(zeros, 0)
    let i = i + 1
  end
  let early = tls_hkdf_extract(alg, [], zeros)
  let derived = tls_derive_secret(alg, early, "derived", tls_hash(alg, []))
  let hs = tls_hkdf_extract(alg, derived, shared)
  let c_hs = tls_derive_secret(alg, hs, "c hs traffic", tls_hash(alg, [1, 2, 3]))
  let key = tls_expand_label(alg, c_hs, "key", [], 16)
  let iv = tls_expand_label(alg, c_hs, "iv", [], 12)
  print(list_len(key) + list_len(iv))
  let a = a + 1
end
