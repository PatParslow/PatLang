# constant_time.feature: ECDHE on P-256 (packages/tls) with a secret scalar:
# the key share and the shared secret by a ladder whose swaps are arithmetic.
# Nothing depends on the scalar; the public key's coordinates, the check that
# the result is not the point at infinity, and the curve checks of the
# public peer point are the declared reveals.
include "../../../../packages/tls/tls.patlang"

let byte = mod_make(0, 256)
let scalar = []
let i = 0
while i < 32 do
  let scalar = list_push(scalar, mod_make(i * 37 + 11, byte))
  let i = i + 1
end
let share = tls_p256_public(scalar)
let secret = tls_p256_shared(scalar, share)
print(list_len(secret))
