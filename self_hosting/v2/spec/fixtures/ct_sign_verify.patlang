# constant_time.feature: Ed25519 key making, signing and verifying in one
# program, as the trust package's publisher does. A public key and a
# signature are public, so verifying reads their residues with mod_reveal;
# the check lists those reads as declared and reports nothing.
include "../../../../packages/curve25519/curve25519.patlang"

let seed = cv_hex_bytes("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60")
let pk = ed25519_public(seed)
let msg = cv_hex_bytes("af82")
let sig = ed25519_sign(seed, msg)
print(ed25519_verify(pk, msg, sig))
