# constant_time.feature: ChaCha20's quarter round (RFC 8439 2.1) on 32-bit
# modints, the words a stream cipher works on. Nothing here may take time
# depending on a word, however the runtime holds modints modulo 2^32.
make a function called quarter takes s, a, b, c, d returns out
  let x = s
  let x = list_set(x, a, mod_make(x[a], 4294967296) + mod_make(x[b], 4294967296))
  let x = list_set(x, d, rotl(mod_make(x[d], 4294967296) bxor mod_make(x[a], 4294967296), 16))
  let x = list_set(x, c, mod_make(x[c], 4294967296) + mod_make(x[d], 4294967296))
  let x = list_set(x, b, rotl(mod_make(x[b], 4294967296) bxor mod_make(x[c], 4294967296), 12))
  let x = list_set(x, a, mod_make(x[a], 4294967296) + mod_make(x[b], 4294967296))
  let x = list_set(x, d, rotl(mod_make(x[d], 4294967296) bxor mod_make(x[a], 4294967296), 8))
  let x = list_set(x, c, mod_make(x[c], 4294967296) + mod_make(x[d], 4294967296))
  let x = list_set(x, b, rotl(mod_make(x[b], 4294967296) bxor mod_make(x[c], 4294967296), 7))
  return x
end

let s = [mod_make(286331153, 4294967296), mod_make(16909060, 4294967296), mod_make(2609737539, 4294967296), mod_make(19088743, 4294967296)]
let t = quarter(s, 0, 1, 2, 3)
let u = mod_make(t[0], 4294967296) bxor (bnot mod_make(t[3], 4294967296)) - (mod_make(t[1], 4294967296) shr 3) * (mod_make(t[2], 4294967296) shl 2)
assert u == u
print("done")
