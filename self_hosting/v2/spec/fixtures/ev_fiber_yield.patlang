# concurrency.feature, spec 1.4 and 1.8: the events whose handlers are running
# belong to the fiber running them. A handler that yields on a fiber does not
# stop whoever resumed it from raising the same event.
let runs = vec_new()
when ping do
  vec_push(runs, event_data)
  if event_data == "fiber" then
    fiber_yield(0)
  end
end

make a function called pinger takes x returns r
  emit("ping", "fiber")
  return 1
end

let id = fiber_new("pinger")
fiber_resume(id, 0)
emit("ping", "main while it waits")
fiber_resume(id, 0)
emit("ping", "main after")
let k = 0
while k < vec_len(runs) do
  print(vec_get(runs, k))
  let k = k + 1
end
