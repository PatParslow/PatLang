# spec_library/values_and_memory, spec 1.4: int's + raises its three events in order
let log = vec_new()
when added_to do
  vec_push(log, [event_name, event_data])
end
when added do
  vec_push(log, [event_name, event_data])
end
let r = 3 + 5
let e0 = vec_get(log, 0)
let e1 = vec_get(log, 1)
let e2 = vec_get(log, 2)
print(e0)
print(e1)
print(e2)
print(r)
