# spec_library/values_and_memory, spec 1.4: an operator is a method of its left operand's class
class Money {
  field cents = 0
  make a function called + takes self, other returns r
    let m = new("Money")
    m.cents = self.cents + other.cents
    return m
  end
}
let m1 = new("Money")
m1.cents = 150
let m2 = new("Money")
m2.cents = 275
let total = m1 + m2
print(type_of(total))
print(total.cents)
