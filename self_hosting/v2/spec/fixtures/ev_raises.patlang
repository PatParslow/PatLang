# spec_library/values_and_memory, spec 1.4: a method declaration names the events it raises
class Money {
  field cents = 0
  make a function called + takes self, other returns r raises money_added
    let m = new("Money")
    m.cents = self.cents + other.cents
    return m
  end
}
let seen = vec_new()
when money_added do
  vec_push(seen, event_data)
end
let m1 = new("Money")
m1.cents = 150
let m2 = new("Money")
m2.cents = 275
let total = m1 + m2
print(vec_len(seen))
let d = vec_get(seen, 0)
print(d[0] == m1)
print(d[1] == m2)
print(d[2] == total)
