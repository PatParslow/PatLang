# engines_agree.feature: a function that raises an event still returns its
# result when the result is not held in a variable.
class Money {
  field cents = 0
  make a function called + takes self, other returns r raises money_added
    return self.cents + other.cents
  end
}
let seen = vec_new()
when money_added do
  vec_push(seen, event_data[2])
end
let m1 = new("Money")
m1.cents = 150
let m2 = new("Money")
m2.cents = 275
print(m1 + m2)
print(vec_get(seen, 0))
