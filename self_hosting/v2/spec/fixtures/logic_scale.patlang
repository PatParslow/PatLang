# The logic engine's work grows with what a call needs (spec 1.13). It prints three lines,
# each true when its claim holds: four times the rules added take no more than about eight
# times the cycles (linear four, quadratic sixteen); a bound goal costs about the same
# whatever rules of other predicates there are; and four times a goal's solutions take no
# more than about eight times the cycles. It counts cpu_cycles, which the time a run waits
# for a processor does not add to (issue #268: on the clock, twice against three, it failed
# under the gates' load). Each count is the cheapest of several readings after a warm-up
# (lib/cost_check.patlang, #284); each reading of adding rules adds them to a predicate of its
# own, and the bound goal is read alone before any other predicate is added to.
include "../../../lib/cost_check.patlang"

make a function called adds takes pred, n returns cost
  require n > 0
  let t0 = cpu_cycles()
  let i = 0
  while i < n do
    rule_add(pred, ["x" + i, "y"], [])
    let i = i + 1
  end
  let cost = cpu_cycles() - t0
  ensure cost >= 0
  return cost
end

# Every solution of pred(X, "y"), counted.
make a function called open_goal takes pred, want returns cost
  require want >= 0
  let t0 = cpu_cycles()
  let found = solve(pred, [logic_var("X"), "y"])
  if list_len(found) != want then
    print("wrong count of solutions: " + list_len(found))
  end
  let cost = cpu_cycles() - t0
  ensure cost >= 0
  return cost
end

# One bound goal, solved n times.
make a function called bound_goals takes pred, n returns cost
  require n > 0
  let t0 = cpu_cycles()
  let i = 0
  while i < n do
    if list_len(solve(pred, ["x5", "y"])) != 1 then
      print("wrong answer for the bound goal")
    end
    let i = i + 1
  end
  let cost = cpu_cycles() - t0
  ensure cost >= 0
  return cost
end

adds("near", 100)
let alone = cheapest_cycles([|| do return bound_goals("near", 200) end], cost_rounds())[0]
adds("other", 20000)
let crowded = cheapest_cycles([|| do return bound_goals("near", 200) end], cost_rounds())[0]

adds("a", 2000)
adds("b", 8000)
let fresh = vec_new()
let add_small = || do
  vec_push(fresh, 1)
  return adds("small" + vec_len(fresh), 2000)
end
let add_large = || do
  vec_push(fresh, 1)
  return adds("large" + vec_len(fresh), 8000)
end
let added = cheapest_cycles([add_small, add_large], cost_rounds())
let opened = cheapest_cycles([|| do return open_goal("a", 2000) end, || do return open_goal("b", 8000) end], cost_rounds())

print(added[1] <= 8 * added[0] + 150000000)
print(crowded <= 2 * alone + 150000000)
print(opened[1] <= 8 * opened[0] + 150000000)
