# The logic engine's work grows with what a call needs (spec 1.13). It prints three lines,
# each true when its claim holds: twice the rules added take no more than about three times
# as long; a bound goal costs about the same whatever rules of other predicates there are;
# and twice a goal's solutions take no more than about three times as long.

make a function called adds takes pred, n returns ms
  require n > 0
  let t0 = now_ms()
  let i = 0
  while i < n do
    rule_add(pred, ["x" + i, "y"], [])
    let i = i + 1
  end
  let ms = now_ms() - t0
  ensure ms >= 0
  return ms
end

# Every solution of pred(X, "y"), counted, n times over.
make a function called open_goal takes pred, want returns ms
  require want >= 0
  let t0 = now_ms()
  let found = solve(pred, [logic_var("X"), "y"])
  if list_len(found) != want then
    print("wrong count of solutions: " + list_len(found))
  end
  let ms = now_ms() - t0
  ensure ms >= 0
  return ms
end

# One bound goal, solved n times.
make a function called bound_goals takes pred, n returns ms
  require n > 0
  let t0 = now_ms()
  let i = 0
  while i < n do
    if list_len(solve(pred, ["x5", "y"])) != 1 then
      print("wrong answer for the bound goal")
    end
    let i = i + 1
  end
  let ms = now_ms() - t0
  ensure ms >= 0
  return ms
end

let small = adds("a", 4000)
let large = adds("b", 8000)
print(large <= 3 * small + 50)

adds("near", 100)
let alone = bound_goals("near", 200)
adds("other", 20000)
let crowded = bound_goals("near", 200)
print(crowded <= 2 * alone + 50)

let small = open_goal("a", 4000)
let large = open_goal("b", 8000)
print(large <= 3 * small + 50)

