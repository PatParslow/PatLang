# programs.feature: a call naming a function with the wrong number of
# arguments is refused when the program is compiled, as is a closure call
# with more than 8 (spec 1.13).
make a function called two takes a, b returns r
  return a + b
end
make a function called some takes a, rest returns r
  return list_len(rest)
end
print("not reached")
print(two(1))
print(two(1, 2, 3))
print(some())
print(some(1, 2, 3))
let nine = |a, b, c, d, e, f, g, h, i| { return a }
print(nine(1, 2, 3, 4, 5, 6, 7, 8, 9))
