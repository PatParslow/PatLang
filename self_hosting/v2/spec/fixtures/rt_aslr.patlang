# spec 2.5: an executable v2 writes can be loaded anywhere (review finding
# S14): it has a base relocation table and asks for a randomised base, so
# Windows does not load it at its preferred base, 0x140000000. Its code lies
# outside the 256 MB from there, and the program still runs.
# It reads where its code is, so it is a runtime file (spec 1.13).
quiet_operators()
let base = 5368709120
let code = thread_entry_address()
print((code < base) or (code >= base + 268435456))
print("runs")
