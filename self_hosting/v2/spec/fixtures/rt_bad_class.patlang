# contracts.feature: a value whose type word names no class stops at the first
# function requiring a live value.
# It reads the runtime's own state, so it is a runtime file (spec 1.13).
quiet_operators()
make a function called uses takes v returns r
  require value_live(v)
  return 0
end

print(uses(7))
uses(value_make(20, 0))
print("not reached")
