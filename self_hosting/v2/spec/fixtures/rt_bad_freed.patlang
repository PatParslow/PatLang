# contracts.feature: a value with a heap type word and a freed block in its data
# word stops at the first function requiring a live value.
make a function called uses takes v returns r
  require value_live(v)
  return 0
end

let s = "hel" + "lo"
let word = value_type_word(s)
let block = value_data(s)
print(uses(s))
let s = 0
uses(value_make(word, block))
print("not reached")
