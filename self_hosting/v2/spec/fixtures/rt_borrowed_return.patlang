# contracts.feature: a function that says its result has a reference of its own,
# and one changed to hand back its argument without one, made with value_make.
make a function called keeps takes s returns r
  let before = mem_load(value_data(s), 0)
  let r = s
  ensure mem_load(value_data(r), 0) == before + 1
  return r
end

make a function called borrows takes s returns r
  let before = mem_load(value_data(s), 0)
  let r = value_make(value_type_word(s), value_data(s))
  ensure mem_load(value_data(r), 0) == before + 1
  return r
end

let t = "hel" + "lo"
print(keeps(t))
print(borrows(t))
print("not reached")
