# A chunk stored as an artefact record (jb_chunk_text) and read back
# (jb_chunk_from_text) is the chunk that was stored, whatever characters
# its names hold: ASCII, two-byte, three-byte and four-byte UTF-8. Its text
# and data are bytes, read back as bytes with the same contents (bytes_eq
# takes nothing else).
include "../../jobs.patlang"

make a function called same_chunk takes a, b returns same
  if not (bytes_eq(a[1], b[1]) and bytes_eq(a[2], b[2])) then
    return false
  end
  return (a[0] == b[0]) and (a[3] == b[3]) and (a[4] == b[4]) and (a[5] == b[5]) and (a[6] == b[6])
end

let stem = "self_hosting/build/v2_rt_chunk_record"
let names = ["main", "caf" + chr(233), "S_" + chr(955) + "_0", "x" + chr(8364) + chr(128512)]
let syms = [[names[0], "text", 0, true], [names[1], "text", 12, true], [names[2], "data", 0, false], [names[3], "bss", 8, false]]
let relocs = [["text", 1, names[1], "REL32", 0 - 4], ["data", 0, names[2], "ABS64", 16], ["text", 7, names[3], "REL32", 0]]
let chunk = ["ChunkImage", bytes_from_list([232, 0, 0, 0, 0, 195]), bytes_from_list([104, 105, 0]), 24, syms, relocs, ["ExitProcess"]]
let asm = "section .text" + chr(10) + names[1] + ":" + chr(10)
let text = jb_chunk_text(chunk)
if text == false then
  print("not stored")
else
  write_file(stem + ".asm", asm)
  write_file_bytes(stem + ".text", chunk[1])
  write_file_bytes(stem + ".data", chunk[2])
  write_file(stem + ".chunk", text + "a " + byte_length(asm) + chr(10) + "z" + chr(10))
  let back = jb_chunk_from_text(read_file(stem + ".chunk"), stem)
  if back == false then
    print("not read")
  else
    print(same_chunk(back[0], chunk))
    print(back[1] == asm)
    print(back[0][4][3][0] == names[3])
  end
end
