# A passing contract clause is a contract_holds fact, once however many times
# it passes, so a checked function called in a loop adds nothing after the
# first call. Prints the facts after one call and after many.
make a function called safe_divide takes a, b returns q
  require b != 0
  let q = a / b
  ensure q * b == a
  return q
end
print(safe_divide(10, 2))
let first = solve("contract_holds", ["safe_divide", "X"])
print(list_len(first))
print(first[0][1])
print(first[1][1])
let i = 0
while i < 100000 do
  safe_divide(10, 2)
  let i = i + 1
end
print(list_len(solve("contract_holds", ["safe_divide", "X"])))
print(mem_load(runtime_state(), 224))
