# spec_library/values_and_memory, spec 2.3: a block freed on another thread is reused there
make a function called has takes items, x returns yes
  let i = 0
  while i < list_len(items) do
    if items[i] == x then
      return true
    end
    let i = i + 1
  end
  return false
end
make a function called drop_then_make takes v returns reused
  let addrs = []
  let k = 0
  while k < vec_len(v) do
    let addrs = list_push(addrs, value_data(vec_get(v, k)))
    let k = k + 1
  end
  let k = 0
  while k < vec_len(v) do
    vec_set(v, k, 0)
    let k = k + 1
  end
  # made at full length first, so the loop below allocates only the strings
  let made = []
  let k = 0
  while k < list_len(addrs) do
    let made = list_push(made, 0)
    let k = k + 1
  end
  let reused = 0
  let before = mem_load(runtime_state(), 240)
  let k = 0
  while k < list_len(addrs) do
    let made = list_set(made, k, "w" + (100000 + k))
    let k = k + 1
  end
  # a lock moves a batch, never a block: each serves at least half a batch
  let locks = mem_load(runtime_state(), 240) - before
  print(locks * rt_batch_high() <= 2 * list_len(addrs))
  let k = 0
  while k < list_len(made) do
    if has(addrs, value_data(made[k])) then
      let reused = reused + 1
    end
    let k = k + 1
  end
  return reused
end
let v = vec_new()
let k = 0
while k < 2000 do
  vec_push(v, "s" + (100000 + k))
  let k = k + 1
end
# the blocks other strings of the same size made meanwhile (a number's
# text on the way to each new string) may take a few of them
let reused = parallel_map([v], "drop_then_make")[0]
print(reused >= 1990)
