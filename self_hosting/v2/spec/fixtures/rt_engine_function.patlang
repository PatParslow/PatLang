# A program reaches the runtime's functions and its own, and nothing of the
# engine running it (spec 1.7): tokenize is the compiler's lexer, part of the
# interpreter's source and of no program's runtime. Calling it stops the
# program as a call of any name nothing declares does, on both engines.
print("before")
print(vec_len(tokenize("let x = 1")))
print("not reached")
