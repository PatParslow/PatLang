# apply reaches a function by its name: the runtime's and the program's own,
# and nothing of the engine running the program (spec 1.7). iv_bucket is the
# interpreter's own function; the name is computed, so nothing can know it when
# the program is compiled.
make a function called twice takes n returns r
  return n * 2
end
print(apply("twi" + "ce", 21))
print(apply("iv_" + "bucket", "hello"))
print("not reached")
