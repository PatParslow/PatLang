# spec 1.13: a program named with no directory is found through PATH alone.
# Run from a directory that holds a cmd.exe of its own (rt_exec_planted), this
# still runs the system's cmd; on Linux, from one holding an sh, the system's sh.
if os_target() == "linux" then
  print(exec_capture("sh", "-c", "echo from the system"))
else
  print(exec_capture("cmd", "/c", "echo from the system"))
end
