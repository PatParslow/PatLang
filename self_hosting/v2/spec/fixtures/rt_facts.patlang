# spec_library/values_and_memory, spec 2.5: registrations are recorded, not
# rediscovered. A when handler, a rule, and a function reached only through
# apply: the compiler's program facts (OUT.facts) list all three.
make a function called greet takes name returns s
  return "hello " + name
end
rule ancestor(X, Y) :- parent(X, Y).
when tick do
  print("ticked")
end
print(apply("greet", "world"))
emit("tick", 0)
