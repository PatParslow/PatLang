# What read_file gives when the system's calls under it fail (review finding
# S12, test-suite recommendation 5): wasm_fail_selftest.patlang runs this under
# the browser's host with one call made to fail (run_node.mjs --fail). Argument:
# a file the host gives, holding "hello".
let p = argv()[0]
print(file_exists(p))
let t = read_file(p)
print(["read_file", t.length, t])
