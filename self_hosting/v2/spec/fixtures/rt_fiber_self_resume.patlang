# spec 1.8: a fiber runs on one thread at a time and cannot resume itself:
# fiber_resume of a fiber that is running stops the program, saying so, where
# it once ran on and then failed an internal contract.
make a function called loop_back takes id returns r
  print("in the fiber")
  fiber_resume(id, 0)
  print("not reached")
  return 0
end

let f = fiber_new("loop_back")
fiber_resume(f, f)
print("not reached either")
