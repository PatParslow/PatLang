# spec_library/values_and_memory, spec 2.1: a float's data word is its IEEE bits, with no heap block
make a function called round_trip takes n returns last
  let last = 0.0
  let i = 0
  while i < n do
    let l = [1.5]
    let last = l[0]
    let i = i + 1
  end
  return last
end
let warm = round_trip(10)
let before = mem_load(runtime_state(), 144)
let v = round_trip(1000000)
print(mem_load(runtime_state(), 144) - before)
print(v)
