# spec_library/values_and_memory, spec 2.3: a freed block of any size is reused by its size class
make a function called grow takes n returns s
  let s = ""
  let i = 0
  while i < n do
    let s = s + "x"
    let i = i + 1
  end
  return s
end
let warm = grow(100)
let before = mem_load(runtime_state(), 144)
let s = grow(4000)
print(str_len(s))
print(((mem_load(runtime_state(), 144) - before) / 4000) < 40)
