# What the language's logic, planning, file and network primitives give on v2,
# against what the interpreter gives (run this file under both).
rule parent("tom", "bob").
rule parent("bob", "ann").
rule grandparent(X, Z) :- parent(X, Y), parent(Y, Z).
print(solve("grandparent", ["tom", "Who"]))
print(solve("parent", ["Who", "ann"]))
print(list_len(solve("parent", ["nobody", "X"])))
fact("likes", "a", "b")
print(query("likes", "a", "_"))
rule_add("spec_input", ["5"], [])
action_add("scale", [["spec_input", ["X"]]], [["scaled", ["X"]]], [], 1)
print(plan([["scaled", ["5"]]]))
action_add("gather_wood", [], [["have", ["wood"]]], [], 1)
action_add("build_house", [["have", ["wood"]]], [["have", ["house"]]], [], 1)
print(plan([["have", ["house"]]]))
goal_def("shelter", [["have", ["house"]]])
print(pursue("shelter"))
action_bind("gather_wood", |args| do
  print("gathering")
  return true
end)
action_bind("build_house", |args| do
  print("building")
  return false
end)
print(activate(pursue("shelter")))
print(action_base_name("build(X=house,Y=2)"))
print(action_label_args("build(X=house,Y=2)"))
print(numeric_kind(1))
print(numeric_kind(1.5))
print(numeric_kind(9223372036854775807 + 1))
print(numeric_kind(1 / 3))
print(numeric_kind("x"))
vfs_write("/a/two", "2")
vfs_write("/a/one", "1")
vfs_append("/a/one", "x")
print(vfs_read("/a/one"))
print(vfs_list("/a/"))
print(vfs_exists("/a/two"))
print(vfs_delete("/a/two"))
print(vfs_exists("/a/two"))
print(now_ms() > 1700000000000)
let port = tcp_listen(0)
print(port > 0)
print(tcp_try_listen(port))
let client = tcp_connect("127.0.0.1", port)
let server = tcp_accept(port)
tcp_write(client, "ping")
print(tcp_read(server))
tcp_write(server, "pong")
print(tcp_read(client))
tcp_close(client)
print(tcp_read_or_empty(server) == "")
tcp_close(server)
print(tcp_accept_timeout(port, 10))
let client2 = tcp_connect("127.0.0.1", port)
let server2 = tcp_accept_timeout(port, 1000)
print(server2 >= 0)
tcp_write(client2, "again")
print(tcp_read(server2))
tcp_close(client2)
tcp_close(server2)
let path = "self_hosting/build/v2_rt_hosts_probe.txt"
write_file(path, "abcdef")
print(read_file_bytes(path, 1, 3))
print(read_file_bytes(path, 4, 100))
print(read_file_bytes("self_hosting/build/no_such_file", 0, 10))
print(remove_file(path))
print(file_exists(path))
let r = exec_capture_io("cmd", ["/c", "findstr", "b"], "abc", 0)
print(r[2])
print(str_trim_right(r[0]))
let t = exec_capture_io("cmd", ["/c", "ping", "-n", "5", "127.0.0.1"], "", 100)
print(t[2])
let pid = spawn("cmd", "/c", "ping", "-n", "2", "127.0.0.1")
print(is_alive(pid))
kill(pid)
print(is_alive(pid))
print(sc_code(str_intern("A"), 0))
print(sc_code(str_intern("A"), 1))
make a function called str_trim_right takes s returns out
  let n = s.length
  while (n > 0) and ((char_code(s, n - 1) == 10) or (char_code(s, n - 1) == 13)) do
    let n = n - 1
  end
  return substr(s, 0, n)
end
