# spec_library/values_and_memory, spec 2.3: imbalance moves in batches
make a function called drop_all takes v returns n
  let k = 0
  while k < vec_len(v) do
    vec_set(v, k, 0)
    let k = k + 1
  end
  return vec_len(v)
end
make a function called fill takes v, n returns r
  let k = 0
  while k < n do
    vec_set(v, k, "z" + (1000000 + k))
    let k = k + 1
  end
  return n
end
let st = runtime_state()
let n = 200000
let v = vec_new()
let k = 0
while k < n do
  vec_push(v, 0)
  let k = k + 1
end
fill(v, n)
let after_first = mem_load(st, 144)
print(parallel_map([v], "drop_all"))
fill(v, n)
let grew = mem_load(st, 144) - after_first
print(grew < 4194304)
