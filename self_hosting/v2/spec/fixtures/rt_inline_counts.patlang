# spec_library/values_and_memory, spec 2.2: an inline value has nothing to count
make a function called keep takes v returns r
  let a = v
  let b = a
  return b
end
let before = mem_load(runtime_state(), 144)
let i = 0
while i < 10 do
  let x = keep(7)
  let y = keep(2.5)
  let z = keep(true)
  let u = keep(print(""))
  let i = i + 1
end
print(mem_load(runtime_state(), 144) - before)
