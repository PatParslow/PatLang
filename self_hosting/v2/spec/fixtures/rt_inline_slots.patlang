# spec_library/values_and_memory, spec 2.2: a slot that only ever holds an inline value is never tested for a heap block (its assembly is read)
make a function called mix takes x returns h
  let h = word_mul(x, 33)
  let h = word_xor(h, 5)
  let h = word_add(h, 7)
  return h
end

make a function called pick takes n returns s
  let s = to_s(n)
  let s = n
  return s
end

print(mix(10))
print(pick(4))
