# compiler_structure.feature, spec 2.6: a program built from its IR by the
# reader prints what v2's own build of it prints. It reaches each kind of
# instruction: ints past 64 bits, floats, text beyond ASCII, lists, a
# closure, an operator event, a fiber, a thread, a system call (print) and
# a broken contract.
make a function called halve takes n returns r
  require n % 2 == 0
  return n / 2
end

make a function called yields_once takes x returns r
  let got = fiber_yield(x * 10)
  return got + 1
end

let big = 9223372036854775807
print(big + 1)
print(0 - big - 2)
print(7 % 3)
print(6 band 3)
print(1 shl 40)
print(bnot 5)
print(-(3))
print(not false)
print(1.5 * 4)
print(0.1 + 0.2)
print(2 < 3)
print(2.5 > 3)
print("héllo, wörld €" + "!")
let xs = [1, "two", [3.0, true]]
print(xs)
print(list_len(list_push(xs, 4)))
let k = 5
let add_k = |n| { return n + k }
print(add_k(10))
let seen = vec_new()
when added do
  vec_push(seen, event_data)
end
let s = 40 + 2
print(s)
print(vec_len(seen) > 0)
let id = fiber_new("yields_once")
print(fiber_resume(id, 4))
print(fiber_resume(id, 100))
print(thread_result(thread_spawn(|| { return [k, "from a thread"] })))
print(halve(10))
print(halve(7))
print("not reached")
