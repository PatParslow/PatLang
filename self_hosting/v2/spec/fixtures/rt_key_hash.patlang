# A job's key tells values apart by their structure (review finding S13): it
# is the SHA-256 of an encoding in which each item says what it is and how
# long, so values that differ (in type, length, an element, a character, an
# integer's sign or size, or only in where one string ends and the next
# begins) key differently, a value built twice keys the same, and a key is the
# SHA-256, in hex, of the encoding jobs.patlang describes.
include "../../jobs.patlang"

make a function called kh_values takes tail returns values
  require type_of(tail) == "int"
  let long = []
  let i = 0
  while i < 1000 do
    let long = list_push(long, (i * 7919) - 3000)
    let i = i + 1
  end
  let long2 = list_push(long, tail)
  let big = 1180591620717411303424
  let values = [[], [0], [[0]], [0, 0], [1, -2, 0], 0, 1, -1, 255, 256, -256, 1099511627776, 0 - 1099511627776, 4611686018427387903, big, 0 - big, "", "0", "int:0", "a", "b", "ab", "ba", "cafe", "caf" + chr(233), "x" + chr(8364) + chr(128512), "x" + chr(8364), true, false, 1.5, "1.5", [["deep"]], [["deep"], []], ["ab", "c"], ["a", "bc"], ["l1:i0;"], long, long2]
  ensure list_len(values) == 38
  return values
end

make a function called kh_key takes v returns key
  let b = sb_new()
  jb_enc_value(b, v)
  return jb_digest(b)
end

let a = kh_values(7)
let b = kh_values(7)
let keys = []
let same = true
let k = 0
while k < list_len(a) do
  let h = kh_key(a[k])
  let same = same and (h == kh_key(b[k]))
  let keys = list_push(keys, h)
  let k = k + 1
end
let distinct = true
let i = 0
while i < list_len(keys) do
  let j = i + 1
  while j < list_len(keys) do
    if keys[i] == keys[j] then
      print("same key: " + i + " and " + j)
      let distinct = false
    end
    let j = j + 1
  end
  let i = i + 1
end
print(same and distinct)
print(kh_key(["ab", 7]) == sha256_string_hex("l2:s2:abi7;"))
