# A job's key tells values apart by their structure: values that differ
# (in type, length, an element, a character, an integer's sign or size)
# hash differently, a value built twice hashes the same, and a file hashes
# as its length then its bytes.
include "../../jobs.patlang"

make a function called kh_values takes tail returns values
  require type_of(tail) == "int"
  let long = []
  let i = 0
  while i < 1000 do
    let long = list_push(long, (i * 7919) - 3000)
    let i = i + 1
  end
  let long2 = list_push(long, tail)
  let big = 1180591620717411303424
  let values = [[], [0], [[0]], [0, 0], [1, -2, 0], 0, 1, -1, 255, 256, -256, 1099511627776, 0 - 1099511627776, 4611686018427387903, big, 0 - big, "", "0", "int:0", "a", "b", "ab", "ba", "cafe", "caf" + chr(233), "x" + chr(8364) + chr(128512), "x" + chr(8364), true, false, 1.5, [["deep"]], [["deep"], []], long, long2]
  ensure list_len(values) == 34
  return values
end

let base = jb_hash_new()
let a = kh_values(7)
let b = kh_values(7)
let hashes = []
let same = true
let k = 0
while k < list_len(a) do
  let h = jb_mix_value(base, a[k])
  let same = same and (h == jb_mix_value(base, b[k]))
  let hashes = list_push(hashes, h)
  let k = k + 1
end
let distinct = true
let i = 0
while i < list_len(hashes) do
  let j = i + 1
  while j < list_len(hashes) do
    if hashes[i] == hashes[j] then
      print("same hash: " + i + " and " + j)
      let distinct = false
    end
    let j = j + 1
  end
  let i = i + 1
end
print(same and distinct)
let path = "self_hosting/v2/spec/fixtures/rt_key_hash.patlang"
let bytes = jb_read_bytes(path)
let h = jb_mix_int(base, list_len(bytes))
let i = 0
while i < list_len(bytes) do
  let h = jb_mix(h, bytes[i])
  let i = i + 1
end
print(jb_mix_file(base, path) == h)
