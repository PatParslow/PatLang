# spec_library/values_and_memory, spec 2.1: telling kinds apart reads only the type word
# It reads the runtime's own state, so it is a runtime file (spec 1.13).
quiet_operators()
let heap = "a" + "b"
let pointerish = value_make(2, value_data(heap))
print(type_of("literal"))
print(type_of(heap))
print(type_of(pointerish))
print(type_of(2.5))
