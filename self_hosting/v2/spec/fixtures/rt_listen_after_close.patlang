# spec 1.13: a port a program listened on is free once the program has ended,
# even when it closed a connection's end first (on Linux that end waits in
# TIME_WAIT for a minute, and binding without SO_REUSEADDR would be refused).
# With the argument first, this program listens on a port the system picks,
# takes a connection, closes its end first, and prints the port and what the
# client read. With listen PORT it prints what tcp_try_listen gives for PORT,
# and with taken it shows that a port held by a listener is still refused.
let a = argv()
if a[0] == "first" then
  let port = tcp_listen(0)
  let c = tcp_connect("127.0.0.1", port)
  let s = tcp_accept(port)
  tcp_write(s, "x")
  tcp_close(s)
  print(port)
  print(tcp_read_or_empty(c))
  tcp_close(c)
elif a[0] == "listen" then
  print(tcp_try_listen(to_num(a[1])))
else
  let port = tcp_listen(0)
  print(tcp_try_listen(port))
end
