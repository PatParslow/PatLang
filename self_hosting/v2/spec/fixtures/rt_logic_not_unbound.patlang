# spec 1.13: a variable unbound in a not that a later goal of the rule uses
# stops the program: the answer would hang on the order of the goals. (One
# that only the not uses means "for any value", and is fine.)
let kb = logic_store_new()
let x = logic_var("X")
let y = logic_var("Y")
fact_in(kb, "item", "a", true)
fact_in(kb, "owner", "b", "me")
rule_add_to(kb, "odd", [x], [["item", [x, true]], ["not", ["has", y, x]], ["owner", [y, "me"]]])
print(solve_in(kb, "odd", [x]))
print("not reached")
