# spec 2.3: a block larger than an allocation chunk (1 MB) is memory of its
# own, given back to the system when it is freed, where a smaller one goes
# onto a free list for reuse. memory_used() is the program's committed
# private memory in bytes, -1 where the system gives none (a browser).
# - memory_used() is a positive int
# - holding a 320 MB bytes adds at least 300 MB to it
# - letting that bytes go takes all but 16 MB of it off again
let start = memory_used()
print((type_of(start) == "int") and (start > 0))
let b = bytes_new(335544320)
let held = memory_used()
print(held - start >= 300000000)
let b = bytes_new(0)
let after = memory_used()
print(after - start < 16000000)
