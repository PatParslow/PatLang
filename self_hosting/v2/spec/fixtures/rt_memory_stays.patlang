# spec_library/values_and_memory, spec 2.3: freed memory stays with PatLang
make a function called fill takes n returns l
  let l = []
  let k = 0
  while k < n do
    let l = list_push(l, "x" + (1000000 + k))
    let k = k + 1
  end
  return l
end
let st = runtime_state()
let n = 6000000
let a = fill(n)
let first = mem_load(st, 136) - mem_load(st, 128)
let a = 0
let b = fill(n)
let second = mem_load(st, 136) - mem_load(st, 128)
print(first == second)
print(first >= 268435456)
