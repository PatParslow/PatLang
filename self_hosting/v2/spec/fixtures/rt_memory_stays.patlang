# spec_library/values_and_memory, spec 2.3: freed small blocks stay with
# PatLang, and the second fill reuses them. Over 200 MB of the range is the
# strings': the list's buffer, larger than a chunk, is memory of its own.
# It reads the runtime's own state, so it is a runtime file (spec 1.13).
quiet_operators()
make a function called fill takes n returns l
  let l = []
  let k = 0
  while k < n do
    let l = list_push(l, "x" + (1000000 + k))
    let k = k + 1
  end
  return l
end
let st = runtime_state()
let n = 6000000
let a = fill(n)
let first = mem_load(st, 136) - mem_load(st, 128)
let a = 0
let b = fill(n)
let second = mem_load(st, 136) - mem_load(st, 128)
print(first == second)
print(first >= 200000000)
