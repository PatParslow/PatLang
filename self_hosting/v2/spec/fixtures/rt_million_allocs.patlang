# spec_library/values_and_memory, spec 2.3: no system call per allocation
# It reads the runtime's own state, so it is a runtime file (spec 1.13).
quiet_operators()
let i = 0
let last = ""
while i < 1000000 do
  let last = "s" + i
  let i = i + 1
end
print(mem_load(runtime_state(), 232))
print(mem_load(runtime_state(), 224))
