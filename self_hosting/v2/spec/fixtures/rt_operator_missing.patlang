# spec 1.4: a class that defines < but not > is not compared with >: a > b
# stops the program, naming the operator and the class, where it was once
# answered as b < a by b's class.
class P {
  field n = 0
  make a function called < takes self, other returns r
    return self.n < other.n
  end
}

let a = new("P")
let b = new("P")
print(a < b)
print(a > b)
print("not reached")
