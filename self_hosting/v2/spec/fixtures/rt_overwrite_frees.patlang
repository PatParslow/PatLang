# spec_library/values_and_memory, spec 2.2: overwriting a slot releases what it held
class Box {
  field v = 0
}
make a function called address_of takes v returns a
  return value_data(v)
end
make a function called class_head takes payload returns h
  return mem_load(rt_context(), 16 + 8 * rt_class_index(rt_size_class(payload)))
end
let b = new("Box")
b.v = "x" + "yz"
let addr = address_of(b.v)
b.v = "other"
print(class_head(16 + 3) == addr)
