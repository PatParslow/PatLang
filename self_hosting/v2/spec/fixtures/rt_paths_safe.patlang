# spec 1.13: what a path can and cannot do. Argument: the case.
#   nul     a path holding code 0 stops the program, and nothing is created
#   escape  vfs_flush_to_disk refuses a virtual path that leaves its directory
#   inside  a virtual path with .. that stays inside is written where it points
#   long    path_absolute of a path longer than any fixed buffer is whole, or
#           the program stops saying so: it never gives a wrong path
let base = "self_hosting/build/v2_rt_paths"
let kind = argv()[0]
if kind == "nul" then
  write_file(base + "_nul.txt" + chr(0) + ".tmp", "x")
  print("not reached")
elif kind == "escape" then
  vfs_write("pkg/../../v2_rt_paths_escaped.txt", "x")
  vfs_flush_to_disk("pkg/", base + "/a")
  print("not reached")
elif kind == "inside" then
  vfs_write("pkg/sub/../ok.txt", "inside")
  print(vfs_flush_to_disk("pkg/", base + "/b"))
  print(read_file(base + "/b/pkg/ok.txt"))
  remove_file(base + "/b/pkg/ok.txt")
elif kind == "long" then
  let b = sb_new()
  let i = 0
  while i < 1500 do
    sb_push(b, "abc/")
    let i = i + 1
  end
  let p = sb_str(b) + "end.txt"
  let here = path_absolute(".")
  if here[here.length - 1] != "/" then
    let here = here + "/"
  end
  # the whole path, or a stop saying the system could not make it absolute
  # (Windows' ANSI calls take no path this long)
  print(path_absolute(p) == here + p)
end
