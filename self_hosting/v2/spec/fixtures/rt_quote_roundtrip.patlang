# spec 1.13 (review, smaller gaps): a child's arguments arrive as they were
# given. A property test of the two halves, with no child process: for 300
# argument lists made from a seed, of empty strings, spaces, tabs, quotes and
# backslashes (trailing ones too), rt_split_command_line of the arguments each
# quoted by rt_quote_arg, joined by spaces, gives the arguments back. Prints
# how many lists came back whole, then the first that did not, or "none".
# (Without the quoting, 12 of the 300 come back.)
# It calls the runtime's own functions, so it is a runtime file (spec 1.13).
quiet_operators()

make a function called rq_next takes s returns n
  return (s * 1103515245 + 12345) % 2147483648
end

make a function called rq_arg takes s returns result
  let pieces = ["a", "b c", "", " ", chr(9), chr(34), chr(92), chr(92) + chr(92), chr(92) + chr(34), "x" + chr(92), "q" + chr(34) + "r", "tail" + chr(92) + chr(92)]
  let b = sb_new()
  let n = word_shr(s, 8) % 4
  let s = rq_next(s)
  let k = 0
  while k < n do
    sb_push(b, pieces[word_shr(s, 8) % list_len(pieces)])
    let s = rq_next(s)
    let k = k + 1
  end
  return [sb_str(b), s]
end

let whole = 0
let first_bad = ""
let s = 7
let t = 0
while t < 300 do
  let args = []
  let n = 1 + word_shr(s, 8) % 5
  let s = rq_next(s)
  let k = 0
  while k < n do
    let r = rq_arg(s)
    let args = list_push(args, r[0])
    let s = r[1]
    let k = k + 1
  end
  let line = sb_new()
  let k = 0
  while k < list_len(args) do
    if k > 0 then
      sb_push(line, " ")
    end
    sb_push(line, rt_quote_arg(args[k]))
    let k = k + 1
  end
  let back = rt_split_command_line(sb_str(line))
  if back == args then
    let whole = whole + 1
  elif first_bad == "" then
    let first_bad = to_s(args) + " came back as " + to_s(back)
  end
  let t = t + 1
end
print(whole)
if first_bad == "" then
  print("none")
else
  print(first_bad)
end
