# spec_library/values_and_memory, spec 2.2: a call returns a value its caller owns
# It reads the runtime's own state, so it is a runtime file (spec 1.13).
quiet_operators()
make a function called ident takes s returns r
  return s
end
let t = ident("a" + "b")
print(t)
print(mem_load(value_data(t), 0))
