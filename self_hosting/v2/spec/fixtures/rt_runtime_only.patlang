# spec 1.13: the primitives that read or write memory, make a value from a
# word or reach the system, and the runtime's rt_ functions, are the
# runtime's: a program that is not a quiet file calling one is refused before
# anything runs, naming each.
print("not reached")
let st = runtime_state()
print(mem_load(st, 0))
print(rt_alloc(8))
