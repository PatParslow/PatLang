# spec 1.13: solve follows rules as deep as a search needs, up to 2000: a
# chain of 300 next facts reaches n100 and n250 (once cut off at 200 deep, so
# n250 gave [] as if the answer were no). A rule that leads back to itself
# goes deeper than that, and stops the program, naming the goal.
let i = 0
while i < 300 do
  rule_add("next", ["n" + i, "n" + (i + 1)], [])
  let i = i + 1
end
rule_add("reach", [logic_var("A"), logic_var("B")], [["next", [logic_var("A"), logic_var("B")]]])
rule_add("reach", [logic_var("A"), logic_var("C")], [["next", [logic_var("A"), logic_var("B")]], ["reach", [logic_var("B"), logic_var("C")]]])
print(list_len(solve("reach", ["n0", "n100"])))
print(list_len(solve("reach", ["n0", "n250"])))
rule_add("forever", [logic_var("X")], [["forever", [logic_var("X")]]])
print(list_len(solve("forever", ["a"])))
print("not reached")
