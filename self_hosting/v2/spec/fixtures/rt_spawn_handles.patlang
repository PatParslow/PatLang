# spec 1.13: a child gets its own standard handles and nothing else this
# process holds. This program listens on a port, spawns a child that runs on
# for about thirty seconds, prints the port and the child's pid, and ends.
# Whoever captured its output sees the end while the child still runs, and
# the port is free as soon as it has ended: the child holds neither the
# output pipe nor the listening socket.
let port = tcp_listen(0)
let pid = spawn("cmd", "/c", "ping -n 31 127.0.0.1 >nul")
print(port)
print(pid)
