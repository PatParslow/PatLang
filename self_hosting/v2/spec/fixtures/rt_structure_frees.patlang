# spec_library/values_and_memory, spec 2.2: a structure owns what it holds, and releases it when freed
make a function called address_of takes v returns a
  return value_data(v)
end
make a function called class_head takes payload returns h
  return mem_load(rt_context(), 16 + 8 * rt_class_index(rt_size_class(payload)))
end
let l = ["a" + "bc"]
let addr = address_of(l[0])
let l = []
print(class_head(8 + 3) == addr)
