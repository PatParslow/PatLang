# spec 1.8: TCP is on this machine only. tcp_connect takes localhost or a
# 127.x.x.x address; another address, or text that is not an address, stops
# the program saying so. tcp_try_connect gives -1 where nothing listens, where
# tcp_connect stops the program. Argument: the case.
let kind = argv()[0]
if kind == "near" then
  let port = tcp_listen(0)
  let a = tcp_connect("127.0.0.1", port)
  let a_in = tcp_accept(port)
  let b = tcp_connect("localhost", port)
  let b_in = tcp_accept(port)
  tcp_write(a, "one")
  tcp_write(b, "two")
  print(tcp_read(a_in) + " " + tcp_read(b_in))
elif kind == "try" then
  let port = tcp_listen(0)
  let a = tcp_try_connect("127.0.0.1", port)
  let a_in = tcp_accept(port)
  tcp_write(a, "three")
  print(tcp_read(a_in) + " " + (a >= 1))
  print(tcp_try_connect("127.0.0.1", 1))
elif kind == "far" then
  tcp_connect("10.0.0.1", 80)
  print("not reached")
elif kind == "bad" then
  tcp_connect("1.2.3", 80)
  print("not reached")
elif kind == "big" then
  tcp_connect("127.0.0.300", 80)
  print("not reached")
end
