# spec 1.8: tcp_read_status(conn, ms) says what a read found: ["a", "data"]
# for bytes, ["", "wait"] when nothing came within ms, and ["", "end"] once
# the peer has closed, which tcp_read_timeout gives as "" for both. The
# client closes only when the server says "go", after the wait was seen, so
# no step depends on how long another takes.
let port = tcp_listen(0)
let client = thread_spawn(|| do
  let c = tcp_connect("127.0.0.1", port)
  tcp_write(c, "a")
  let go = tcp_read(c)
  tcp_close(c)
  return go
end)
let conn = tcp_accept(port)
print(tcp_read_status(conn, 10000))
print(tcp_read_status(conn, 100))
tcp_write(conn, "go")
print(tcp_read_status(conn, 10000))
print(thread_result(client))
