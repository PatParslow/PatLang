# spec 1.8: TCP reaches beyond this machine only once the program has
# declared tcp_allow_remote() (review finding S15 keeps that the default).
# The first argument picks what is shown:
#   names        dns_resolve without the declaration: it stops the program
#   allowed      the declaration, then dns_resolve of localhost and of an
#                address, and tcp_connect to localhost by name
#   query PORT   dns_query of a DNS server on this machine's PORT (the
#                responder dns_responder.py): two A records, a name that is
#                not there, and a CNAME followed to its A record
#   silent PORT  dns_query of a port where nothing answers: no addresses
let a = argv()
if a[0] == "names" then
  print(dns_resolve("localhost"))
  print("not reached")
elif a[0] == "allowed" then
  tcp_allow_remote()
  print(dns_resolve("localhost"))
  print(dns_resolve("192.0.2.1"))
  let port = tcp_listen(0)
  print(tcp_connect("localhost", port) >= 1)
  print(str_contains(str_join(host_caps(), ","), "tcp_remote") == (program_path() != ""))
elif a[0] == "query" then
  tcp_allow_remote()
  let port = to_num(a[1])
  print(dns_query("127.0.0.1", port, "two.test", 2000))
  print(dns_query("127.0.0.1", port, "missing.test", 2000))
  print(dns_query("127.0.0.1", port, "alias.test", 2000))
elif a[0] == "silent" then
  tcp_allow_remote()
  print(dns_query("127.0.0.1", to_num(a[1]), "two.test", 200))
end
