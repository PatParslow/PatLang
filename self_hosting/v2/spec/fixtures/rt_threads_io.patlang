# concurrency.feature: threads that read files and print numbers together each get what one
# thread alone would (spec 1.8). Each worker reads its own length of one file, again and again,
# and prints a number of seven copies of its own digit; the last line is how many reads gave a
# length other than the one asked for, per worker.
# Where this run writes its scratch files: PATLANG_SPEC_OUT, a directory of
# the run's own (docs/plans/gates.md), else self_hosting/build.
make a function called scratch_path takes name returns path
  let dir = "" + getenv("PATLANG_SPEC_OUT")
  if dir == "" then
    let dir = "self_hosting/build"
  end
  return dir + "/" + name
end

make a function called reader takes d returns bad
  let path = scratch_path("rt_threads_io.txt")
  let want = 100 + 37 * d
  let bad = 0
  let i = 0
  while i < 400 do
    if list_len(read_file_bytes(path, 0, want)) != want then
      let bad = bad + 1
    end
    print(d * 1111111)
    let i = i + 1
  end
  return bad
end
let b = sb_new()
let i = 0
while i < 1000 do
  sb_push(b, "abc")
  let i = i + 1
end
write_file(scratch_path("rt_threads_io.txt"), sb_str(b))
print(parallel_map([1, 2, 3, 4, 5, 6, 7, 8], "reader"))
