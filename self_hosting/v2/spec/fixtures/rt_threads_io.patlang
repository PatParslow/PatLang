# concurrency.feature: threads that read files and print numbers together each get what one
# thread alone would (spec 1.8). Each worker reads its own length of one file, again and again,
# and prints a number of seven copies of its own digit; the last line is how many reads gave a
# length other than the one asked for, per worker.
make a function called reader takes d returns bad
  let path = "self_hosting/build/rt_threads_io.txt"
  let want = 100 + 37 * d
  let bad = 0
  let i = 0
  while i < 400 do
    if list_len(read_file_bytes(path, 0, want)) != want then
      let bad = bad + 1
    end
    print(d * 1111111)
    let i = i + 1
  end
  return bad
end
let b = sb_new()
let i = 0
while i < 1000 do
  sb_push(b, "abc")
  let i = i + 1
end
write_file("self_hosting/build/rt_threads_io.txt", sb_str(b))
print(parallel_map([1, 2, 3, 4, 5, 6, 7, 8], "reader"))
