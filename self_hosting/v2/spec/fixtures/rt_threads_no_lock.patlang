# spec_library/values_and_memory, spec 2.3: a thread allocates and frees without a lock
make a function called churn takes seed returns n
  let i = 0
  let last = ""
  while i < 1000000 do
    let last = "v" + (seed + i)
    let i = i + 1
  end
  return str_len(last)
end
let st = runtime_state()
let before = mem_load(st, 240)
let r = parallel_map([1, 2, 3, 4, 5, 6, 7, 8], "churn")
print(r)
let taken = mem_load(st, 240) - before
print(taken < 1000)
