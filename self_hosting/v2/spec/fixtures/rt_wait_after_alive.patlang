# spec 1.13: is_alive asks whether a process runs and changes nothing, so a
# wait after is_alive has seen the process end still gives its exit code.
# This program spawns a child that exits with code 3 at once, asks is_alive
# until it says false, then prints is_alive once more and the wait's code.
if os_target() == "linux" then
  let pid = spawn("/bin/sh", "-c", "exit 3")
else
  let pid = spawn("cmd", "/c", "exit 3")
end
while is_alive(pid) do
  sleep_ms(10)
end
print(is_alive(pid))
print(wait(pid))
