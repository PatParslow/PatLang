# Calls whose arguments are fitted to the runtime's declarations (spec 1.7): the
# result must not depend on the directory the program is started in.
make a function called add_two takes a, b returns r
  let r = a + b
  return r
end

print(substr(exec_capture("cmd", "/c", "echo hi"), 0, 2))
print(apply("add_two", 1, 2))
print(send(3, "to_s"))
