# spec 1.11: append_file(path, text) and append_file_bytes(path, data) add to
# the end of a file, making it (and the directories above it) when it is not
# there, and give whether they could. Each call's bytes land together at the
# end: 4 threads appending 200 lines each leave 800 whole lines.
let out = "" + getenv("PATLANG_SPEC_OUT")
if out == "" then
  let out = "self_hosting/build/spec_out"
end
# a directory of this run's own: the engines may run this fixture at once
let tag = random_bytes(4)
let dir = out + "/append_" + tag[0] + "_" + tag[1] + "_" + tag[2] + "_" + tag[3]
let path = dir + "/append_fixture/sub/log.txt"
print(append_file(path, "one" + chr(10)))
print(append_file(path, "two" + chr(10)))
print(read_file(path) == "one" + chr(10) + "two" + chr(10))
let bpath = dir + "/append_fixture/data.bin"
if file_exists(bpath) then
  remove_file(bpath)
end
print(append_file_bytes(bpath, [0, 255, 10]))
print(append_file_bytes(bpath, bytes_from_list([128, 7])))
print(bytes_to_list(read_file_raw(bpath)))
let tpath = dir + "/append_fixture/threads.txt"
if file_exists(tpath) then
  remove_file(tpath)
end
make a function called appender takes w returns ok
  let ok = true
  let i = 0
  while i < 200 do
    if not append_file(w[0], "worker " + w[1] + " line " + i + " of two hundred" + chr(10)) then
      let ok = false
    end
    let i = i + 1
  end
  return ok
end
print(parallel_map([[tpath, 1], [tpath, 2], [tpath, 3], [tpath, 4]], "appender"))
let lines = 0
let whole = 0
let text = read_file(tpath)
let b = bytes_from_str(text)
let start = 0
let k = 0
while k < bytes_len(b) do
  if bytes_get(b, k) == 10 then
    let line = bytes_to_str(bytes_slice(b, start, k - start))
    let lines = lines + 1
    if str_contains(line, " of two hundred") and (str_len(line) >= 30) then
      let whole = whole + 1
    end
    let start = k + 1
  end
  let k = k + 1
end
print(lines)
print(whole)
print(append_file(dir + "/append_fixture", "a directory"))
