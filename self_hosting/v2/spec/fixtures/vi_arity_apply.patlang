# programs.feature: a function called by name takes exactly its arguments,
# its rest parameter any further ones as a list (spec 1.13).
make a function called two takes a, b returns r
  return a + b
end
make a function called some takes a, rest returns r
  return [a, rest]
end
print(apply("two", 2, 3))
print(apply("some", 1))
print(apply("some", 1, 2, 3))
print(parallel_map([1, 2], "some"))
