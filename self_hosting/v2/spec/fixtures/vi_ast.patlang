# AST.Name(args) gives the node ["Name", args...], in a rule or in ordinary code (spec 1.9).
syntax RouteNodes {
    trigger: Keyword("nodes");
    tokens {
        HttpVerb(verb) = regex("\b(GET|POST)\b", verb);
        UrlPath(path) = regex("/[a-zA-Z0-9_/:-]*", path);
    }
    rule NodeLine {
        let verb = expect HttpVerb;
        let path = expect UrlPath;
        return handle(AST.Route(verb, path));
    }
}

syntax DiscardedNodes {
    trigger: Keyword("discarded");
    tokens {
        HttpVerb(verb) = regex("\b(GET|POST)\b", verb);
    }
    rule DiscardedLine {
        let verb = expect HttpVerb;
        return AST.Route(verb);
    }
}

make a function called handle takes node returns r
  print(node[0] + " " + node[1] + " " + node[2])
  return node
end

make a function called own_ast takes AST returns r
  return AST.to_s()
end

nodes {
    GET /users
    POST /users/new
}
discarded {
    GET
}
let n = AST.Add(1, AST.Num(2))
print(n[0])
print(n[1])
print(n[2][0])
print(n[2][1])
print(type_of(n))
print(list_len(AST.Empty()))
let f = |x| {
  return AST.Wrap(x)
}
print(f(3)[1])
print(own_ast(5))
print("after")
