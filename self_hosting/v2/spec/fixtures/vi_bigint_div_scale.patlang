# spec 1.3: integer division of bigints is exact, rational arithmetic stays
# in lowest terms, and a gcd of d-digit numbers costs time growing as d
# squared.
# - 10^40 divided by 7 gives 1428571428571428571428571428571428571428 and 4
# - for dividends and divisors of many sizes (one limb, a small top limb, a
#   quotient limb that needs correcting), q * b + r == a and 0 <= r < b, and
#   the same with signs, truncating toward zero
# - reducing F(n+1)/F(n), consecutive Fibonacci numbers (a gcd of n steps,
#   each on numbers of the same length), at about 200 digits costs no more
#   than 16 times its cost at about 50, as a gcd quadratic in the digits
#   does. Measured 2026-11-20: 8.5 times (9.3 and 80 million cycles); long
#   division that searched for each quotient limb by bisection, over every
#   limb of the dividend, was 36 times (178 and 6351 million). Each cost is
#   the cheapest of several readings after a warm-up (lib/cost_check.patlang,
#   #284).
include "../../../lib/cost_check.patlang"

make a function called pow10 takes k returns x
  let x = 1
  let i = 0
  while i < k do
    let x = x * 10
    let i = i + 1
  end
  return x
end

# A number of about k digits whose digits vary, from a seed.
make a function called digits_from takes k, seed returns x
  let x = 1 + seed % 9
  let s = seed
  let i = 1
  while i < k do
    let s = (s * 1103515245 + 12345) % 2147483648
    let x = x * 10 + s % 10
    let i = i + 1
  end
  return x
end

# floor division and remainder truncate toward zero for ints; for bigints
# the same: a = q * b + r, |r| < |b|, r with a's sign
make a function called divides_back takes a, b returns ok
  let q = a / b
  # a / b is a rational unless b divides a: the quotient is its whole part
  let qt = floor(abs(a) / abs(b))
  if (a < 0) != (b < 0) then
    let qt = 0 - qt
  end
  let r = a - qt * b
  if abs(r) >= abs(b) then
    return false
  end
  if (r != 0) and ((r < 0) != (a < 0)) then
    return false
  end
  return (qt * b + r == a) and ((r == 0) == (q == qt))
end

let big = pow10(40)
print([floor(big / 7), big - 7 * floor(big / 7)])

let all = true
let sizes = [1, 9, 10, 18, 19, 27, 40, 81, 120]
let i = 0
while i < list_len(sizes) do
  let j = 0
  while j < list_len(sizes) do
    let a = digits_from(sizes[i] + sizes[j], i * 31 + j)
    let b = digits_from(sizes[j], j * 17 + i + 1)
    # a divisor whose top limb is small, and one just under a power of ten
    let b2 = pow10(sizes[j]) + 1
    let b3 = pow10(sizes[j]) - 1
    if not (divides_back(a, b) and divides_back(a, b2) and divides_back(a, b3)) then
      let all = false
    end
    if not (divides_back(0 - a, b) and divides_back(a, 0 - b2) and divides_back(0 - a, 0 - b3)) then
      let all = false
    end
    let j = j + 1
  end
  let i = i + 1
end
print(all)

# Rational arithmetic stays exact and in lowest terms: known sums and
# products, then identities over fractions with large and small parts (a
# result not in lowest terms would compare unequal to the same value written
# in lowest terms).
print([1 / 6 + 1 / 3, type_of(1 / 6 - 1 / 6), type_of(2 / 3 * (3 / 2)), (0 - 1 / 2) / (0 - 1 / 4), 5 / 12 - 1 / 4])
let fracs = []
let i = 0
while i < 12 do
  let num = digits_from(3 + i * 4, i + 3)
  if i % 3 == 1 then
    let num = 0 - num
  end
  let fracs = list_push(fracs, num / (digits_from(2 + i * 3, i + 7) * 6))
  let i = i + 1
end
let laws = true
let i = 0
while i < list_len(fracs) do
  let j = 0
  while j < list_len(fracs) do
    let x = fracs[i]
    let y = fracs[j]
    if ((x + y) - y != x) or ((x * y) / y != x) or ((x - y) + y != x) or (x + y != y + x) then
      let laws = false
    end
    let j = j + 1
  end
  let i = i + 1
end
print(laws)

make a function called fib_pair takes n returns pair
  let a = 0
  let b = 1
  let i = 0
  while i < n do
    let t = a + b
    let a = b
    let b = t
    let i = i + 1
  end
  return [a, b]
end

make a function called reduce_cost takes n returns cost
  let p = fib_pair(n)
  let t0 = cpu_cycles()
  let q = p[1] / p[0]
  let cost = cpu_cycles() - t0
  # consecutive Fibonacci numbers are coprime: the fraction is already lowest
  assert "" + q == p[1] + "/" + p[0]
  return cost
end

# F(240) has 50 digits, F(960) has 201
let best = cheapest_cycles([|| do return reduce_cost(240) end, || do return reduce_cost(960) end], cost_rounds())
print(best[1] <= 16 * best[0] + 20000000)
