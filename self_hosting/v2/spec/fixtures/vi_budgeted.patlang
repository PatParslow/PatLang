# engines_agree.feature: budgeted(ms) { body } runs the body until its time is
# up: ["done", value] if it finished, else ["paused", handle], which a later
# budgeted(ms, handle) continues. The body sees the variables around it.
make a function called sum_to takes n returns total
  let base = 100
  let total = 0
  let handle = false
  let runs = 0
  while true do
    let out = budgeted(1, handle) {
      let i = 0
      let acc = base
      while i < n do
        let acc = acc + i
        let i = i + 1
      end
      acc
    }
    let runs = runs + 1
    if out[0] == "done" then
      return [out[1], runs > 0]
    end
    let handle = out[1]
  end
end

print(sum_to(1000))
print(sum_to(200000))

let quick = budgeted(5000) {
  1 + 2
}
print(quick[0])
print(quick[1])

let cut = budgeted(0) {
  let i = 0
  while i < 1000000 do
    let i = i + 1
  end
  "ran to its end"
}
print(cut[0])
let finish = budgeted(100000, cut[1]) {
  "not used: the body is already running"
}
print(finish[0])
print(finish[1])
