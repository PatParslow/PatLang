# spec 1.5, 1.10: bytes is a buffer of bytes with identity, as a vec is: one
# byte of memory a byte, where a list holds a 16-byte value for each.
# - bytes_new(n) is n zero bytes; bytes_set and bytes_get read and write
#   them, each an int from 0 to 255; bytes_push grows it in place
# - bytes_extend appends another bytes or a list of ints; bytes_slice copies
#   part; bytes_eq compares contents, == compares identity
# - bytes_from_str and bytes_to_str go through UTF-8; bytes_from_list and
#   bytes_to_list through lists of ints
# - write_file_bytes takes a bytes, and read_file_raw gives one back
# - type_of and to_s name it
# - a million bytes pushed take no more than about eight times as long as
#   250000: linear work takes four times as long and quadratic sixteen, and
#   eight leaves the measurement's noise room either way. The two sizes are
#   timed in turn, three times each, and the cheapest run of each is compared,
#   so a stretch of slow running falls on both.
let b = bytes_new(3)
print(bytes_len(b))
print(bytes_to_list(b))
bytes_set(b, 0, 65)
bytes_set(b, 2, 255)
print(bytes_get(b, 0))
print(bytes_get(b, 2))
let same = b
bytes_push(same, 7)
print(bytes_len(b))
print(bytes_to_list(b))

let c = bytes_from_str("caf" + chr(233))
print(bytes_to_list(c))
print(bytes_to_str(c) == "caf" + chr(233))
bytes_extend(c, bytes_from_list([33, 34]))
bytes_extend(c, [35])
print(bytes_to_list(c))
print(bytes_to_list(bytes_slice(c, 1, 3)))

let d = bytes_from_list([1, 2, 3])
let e = bytes_from_list([1, 2, 3])
print(bytes_eq(d, e))
print(d == e)
print(d == d)
print(bytes_eq(d, bytes_from_list([1, 2])))

print(type_of(d))
print(to_s(d))

# a name of its own: the gates run this on several engines at once
let path = "self_hosting/build/vi_bytes_" + str_hash(to_s(random_bytes(8))) + ".bin"
print(write_file_bytes(path, c))
let back = read_file_raw(path)
print(bytes_eq(back, c))
remove_file(path)
print(bytes_len(read_file_raw(path)))

make a function called push_cost takes n returns cost
  let t0 = cpu_cycles()
  let x = bytes_new(0)
  let i = 0
  while i < n do
    bytes_push(x, i % 256)
    let i = i + 1
  end
  return cpu_cycles() - t0
end
let small = push_cost(250000)
let large = push_cost(1000000)
let k = 1
while k < 3 do
  let small = min(small, push_cost(250000))
  let large = min(large, push_cost(1000000))
  let k = k + 1
end
print(large <= 8 * small + 100000000)
