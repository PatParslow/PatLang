# spec 1.10: bytes_hash(b) is FNV-1a over a bytes's bytes, its low 62 bits as
# an int, as str_hash is over a string's: the same bytes hash the same either
# way, and a change to one byte changes the hash.
let b = bytes_from_str("caf" + chr(233) + " au lait")
print(bytes_hash(b) == str_hash("caf" + chr(233) + " au lait"))
print(bytes_hash(bytes_new(0)) == str_hash(""))
let h = bytes_hash(b)
print((type_of(h) == "int") and (h >= 0))
let c = bytes_slice(b, 0, bytes_len(b))
bytes_set(c, 2, 0)
print(bytes_hash(c) != h)
print(bytes_hash(b) == h)
