# spec 1.5: a bytes is indexed and measured as a list is.
# - b[i] is the byte at i, an int from 0 to 255
# - past either end it is unit, as a list's is (an index that is neither an
#   int nor a modint stops the program, as a list's does: rt_index_float)
# - list_len(b) is how many bytes it holds, as bytes_len is
let b = bytes_from_list([7, 0, 255])
print(b[0])
print(b[2])
print(type_of(b[1]))
print(type_of(b[3]))
print(type_of(b[0 - 1]))
print(list_len(b))
print(list_len(bytes_new(0)))
bytes_push(b, 9)
print(b[3])
print(list_len(b))
