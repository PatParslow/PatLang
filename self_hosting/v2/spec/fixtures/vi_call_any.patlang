# spec 1.13: any expression followed by ( on its line is called, as a closure
# held in a variable is: a call's result, a list element, a bracketed closure.
make a function called make_adder takes n returns f
  return |x| { return x + n }
end

let fs = [|x| { return x * 2 }, |x| { return x * 3 }]
print(make_adder(3)(7))
print(fs[1](5))
print((|x| { return x - 1 })(10))
print(make_adder(1)(make_adder(2)(3)))
