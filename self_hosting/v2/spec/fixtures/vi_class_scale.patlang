# spec 1.1, 1.2: making an object and calling a method it inherits take about
# as long for a class declared after 400 others as for one declared first,
# and the first class declared with a name is the one new() finds.
# - a Leaf's own field, its inherited one, and its inherited method
# - 2000 new() and inherited calls of a class declared after 400 more cost no
#   more than about four times as many cycles as of one declared before them
#   (a search of the classes by name, in the order declared, made it about
#   fourteen times)
# - a second class declared as Leaf changes nothing: new("Leaf") is the first
# - a parent declared after its child had made an object gives the child's
#   next object its field (what new() starts from is made again)
class Base {
  field x = 3
  make a function called area takes self returns r
    return self.x * 2
  end
}
class Leaf inherits Base {
  field z = 5
}

make a function called work takes cls, n returns cost
  let t0 = cpu_cycles()
  let s = 0
  let i = 0
  while i < n do
    let o = new(cls)
    let s = s + o.area()
    let i = i + 1
  end
  if s != 6 * n then
    print("wrong sum " + s)
  end
  return cpu_cycles() - t0
end

let leaf = new("Leaf")
print([leaf.z, leaf.x, leaf.area()])
let before = work("Leaf", 2000)
let i = 0
while i < 400 do
  class_define("Filler" + i, "", [], [], [], [])
  let i = i + 1
end
class_define("LateBase", "", [["x", 3]], [["area", |o| do return o.x * 2 end]], [], [])
class_define("LateLeaf", "LateBase", [["z", 5]], [], [], [])
let late = new("LateLeaf")
print([late.z, late.x, late.area()])
let after = work("LateLeaf", 2000)
print(after <= 4 * before + 50000000)
class_define("Leaf", "", [["z", 9]], [], [], [])
print(new("Leaf").z)

# a parent declared after its child has made an object: the child's next
# object has the parent's field
class_define("Kid", "LaterParent", [["k", 1]], [], [], [])
print(type_of(get(new("Kid"), "p")))
class_define("LaterParent", "", [["p", 2]], [], [], [])
print(new("Kid").p)
