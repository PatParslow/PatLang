# spec 1.13: clock_ms() never goes back and measures an interval: across a
# 50 ms sleep it moves forward by at least 50, and 1000 readings in a row
# never decrease. now_ms() is the wall clock, after 2020.
let a = clock_ms()
sleep_ms(50)
let b = clock_ms()
print(b - a >= 50)
let ok = true
let last = clock_ms()
let i = 0
while i < 1000 do
  let t = clock_ms()
  if t < last then
    let ok = false
  end
  let last = t
  let i = i + 1
end
print(ok)
print(now_ms() > 1577836800000)
