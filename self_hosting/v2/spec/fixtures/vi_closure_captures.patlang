# engines_agree.feature: a closure reads each value it captured, however many.
make a function called add_all takes a, b, c returns r
  let f = |x| { return a + b * c + x }
  return f(1)
end

make a function called through takes n, k returns r
  let g = |p| { return k(n + p) }
  return g(2)
end

print(add_all(2, 3, 4))
print(through(1, |v| { return v * 10 }))
