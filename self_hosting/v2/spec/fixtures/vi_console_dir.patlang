# programs.feature, spec 1.13: with standard input that is not a console,
# console_raw_enable changes nothing and gives -1, and disabling -1 is
# harmless; cwd() is path_absolute("."), and set_cwd moves it and back.
let mode = console_raw_enable()
print(mode)
print(console_raw_disable(mode))
console_echo_str("echo")
console_echo_byte(33)
console_echo_byte(10)
let start = cwd()
print(start == path_absolute("."))
print(set_cwd("self_hosting"))
print(cwd() == start + "/self_hosting")
print(set_cwd(".."))
print(cwd() == start)
print(set_cwd("no/such/directory/here"))
print(cwd() == start)
