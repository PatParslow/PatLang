# spec 1.13: cpu_cycles() counts the processor cycles this thread has run,
# for comparing the cost of two pieces of work: the time it waits for a
# processor is not in it, as it is in the time on a clock. It is a count, not
# a time, and never goes back.
# - it is a non-negative int, and work makes it grow
# - sleeping 200 ms makes it grow far less than 200 ms of work does
# - four times the work counts no more than about eight times the cycles
# It prints true four times.
make a function called work takes n returns s
  let s = 0
  let i = 0
  while i < n do
    let s = s + i % 7
    let i = i + 1
  end
  return s
end

make a function called cycles_for takes n returns c
  let c0 = cpu_cycles()
  work(n)
  return cpu_cycles() - c0
end

let a = cpu_cycles()
print((type_of(a) == "int") and (a >= 0))
work(100000)
print(cpu_cycles() > a)
let busy = cycles_for(2000000)
let s0 = cpu_cycles()
sleep_ms(200)
let slept = cpu_cycles() - s0
print(slept * 10 < busy)
let one = cycles_for(500000)
let four = cycles_for(2000000)
print(four <= 8 * one)
