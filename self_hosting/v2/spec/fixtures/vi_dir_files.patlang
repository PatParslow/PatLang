# spec 1.13: dir_files(path) gives a directory's files, each [name, bytes,
# written], sorted by name; a subdirectory is left out, and a path with no
# directory to read gives []. A file written later has the larger written.
let dir = "self_hosting/build/v2_vi_dir_files"
write_file(dir + "/b_older.txt", "four")
sleep_ms(50)
write_file(dir + "/a_newer.txt", "seven..")
write_file(dir + "/sub/inner.txt", "x")
let files = dir_files(dir)
print(list_len(files))
print(files[0][0] + " " + files[0][1])
print(files[1][0] + " " + files[1][1])
print(files[0][2] > files[1][2])
print(dir_files(dir + "/missing"))
remove_file(dir + "/sub/inner.txt")
remove_file(dir + "/sub")
remove_file(dir + "/a_newer.txt")
remove_file(dir + "/b_older.txt")
