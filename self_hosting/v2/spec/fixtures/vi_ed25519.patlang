# curve25519.feature: Ed25519 written in PatLang on modints, against the
# vectors of RFC 8032 section 7.1: each key and signature as the RFC gives
# them, each signature verifying, and each failing for an altered message.
include "../../../../packages/curve25519/curve25519.patlang"
include "cv_vectors.patlang"

let rows = cv_rfc8032()
let i = 0
while i < list_len(rows) do
  let row = rows[i]
  let seed = cv_hex_bytes(row[1])
  let msg = cv_hex_bytes(row[3])
  let pk = ed25519_public(seed)
  let sig = ed25519_sign(seed, msg)
  let altered = list_push(msg, cv_byte(0))
  print(row[0] + ": public key " + to_s(cv_hex(pk) == row[2]) + ", signature " + to_s(cv_hex(sig) == row[4]) + ", verifies " + to_s(ed25519_verify(pk, msg, sig)) + ", altered message verifies " + to_s(ed25519_verify(pk, altered, sig)))
  let i = i + 1
end
