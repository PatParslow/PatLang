# curve25519.feature: Ed25519 verification written in PatLang against every
# case of Wycheproof's ed25519_test.json: each valid signature accepted, each
# invalid one rejected, and the acceptable ones counted by what happened.
include "../../../../packages/curve25519/curve25519.patlang"
include "cv_vectors.patlang"

let rows = cv_wy_ed25519()
let valid = 0
let invalid = 0
let acc_yes = 0
let acc_no = 0
let i = 0
while i < list_len(rows) do
  let row = rows[i]
  let ok = ed25519_verify(cv_hex_bytes(row[1]), cv_hex_bytes(row[2]), cv_hex_bytes(row[3]))
  if row[4] == "valid" then
    if ok then
      let valid = valid + 1
    else
      print("case " + to_s(row[0]) + ": a valid signature rejected")
    end
  elif row[4] == "invalid" then
    if ok then
      print("case " + to_s(row[0]) + ": an invalid signature accepted")
    else
      let invalid = invalid + 1
    end
  elif ok then
    let acc_yes = acc_yes + 1
  else
    let acc_no = acc_no + 1
  end
  let i = i + 1
end
print("Ed25519 Wycheproof: " + to_s(valid) + " valid accepted, " + to_s(invalid) + " invalid rejected, " + to_s(acc_yes + acc_no) + " acceptable (" + to_s(acc_yes) + " accepted, " + to_s(acc_no) + " rejected)")
