# exec_peak_memory gives a command's output and its peak working set (spec 1.13).
# The commands are cmd's on Windows and sh's on Linux, each printing the same
# lines (cmd's echo keeps the space before its 1>&2, and ends lines with CR LF).
let linux = os_target() == "linux"
make a function called shell takes line returns cmd
  if os_target() == "linux" then
    return ["/bin/sh", ["-c", line]]
  end
  return ["cmd", ["/c", line]]
end
make a function called pick takes win, lin returns line
  if os_target() == "linux" then
    return lin
  end
  return win
end
let c = shell(pick("echo to out& echo quiet 1>&2", "echo to out; echo quiet 1>&2"))
let ok = exec_peak_memory(c[0], c[1])
print("ok:" + ok[0])
print(ok[1] > 0)
let c = shell(pick("echo to out& echo to err 1>&2& exit 3", "echo to out; echo 'to err ' 1>&2; exit 3"))
let failed = exec_peak_memory(c[0], c[1])
print("failed:" + failed[0])
print(failed[1] > 0)
# exec_measured gives both outputs apart, whether the command exited 0, and its
# peak working set (spec 1.13).
let c = shell(pick("echo out& echo err 1>&2& exit 3", "echo out; echo 'err ' 1>&2; exit 3"))
let m = exec_measured(c[0], c[1])
let crlf = pick(chr(13) + chr(10), chr(10))
print("measured:" + (m[0] == "out" + crlf) + "|" + (m[1] == "err " + crlf) + "|" + m[2] + "|" + (m[3] > 0))
let c = shell("echo fine")
print(exec_measured(c[0], c[1])[2])
# a command whose own process is small and whose child commits several hundred
# MB: the measured peak counts the child. On Windows exec_peak_memory's counts
# only the command; Linux's wait4 gives a child's peak with the children it
# waited for, so the two are not apart there, and the line says so.
if linux then
  let tree = exec_measured("/bin/sh", ["-c", "python3 -c 'x = bytearray(300000000); x[-1] = 1'"])
  print("tree:" + (tree[3] >= 200000000) + "|on Linux a command's own peak is not apart from its children's")
else
  let bs = chr(92)
  let child = "self_hosting" + bs + "build" + bs + "v2_interp.exe self_hosting" + bs + "v2" + bs + "spec" + bs + "fixtures" + bs + "vi_exec_alloc.patlang"
  let tree = exec_measured("cmd", ["/c", child])
  let own = exec_peak_memory("cmd", ["/c", child])
  print("tree:" + (tree[3] >= 200000000) + "|" + (own[1] < 100000000))
end
