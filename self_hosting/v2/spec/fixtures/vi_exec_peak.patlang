# exec_peak_memory gives a command's output and its peak working set (spec 1.13).
let ok = exec_peak_memory("cmd", ["/c", "echo to out& echo quiet 1>&2"])
print("ok:" + ok[0])
print(ok[1] > 0)
let failed = exec_peak_memory("cmd", ["/c", "echo to out& echo to err 1>&2& exit 3"])
print("failed:" + failed[0])
print(failed[1] > 0)
# exec_measured gives both outputs apart, whether the command exited 0, and its
# peak working set (spec 1.13).
let m = exec_measured("cmd", ["/c", "echo out& echo err 1>&2& exit 3"])
let crlf = chr(13) + chr(10)
print("measured:" + (m[0] == "out" + crlf) + "|" + (m[1] == "err " + crlf) + "|" + m[2] + "|" + (m[3] > 0))
print(exec_measured("cmd", ["/c", "echo fine"])[2])
# a command whose own process is small and whose child, the interpreter
# building a list of 20 million ints, commits several hundred MB: the
# measured peak counts the child, exec_peak_memory's only the command
let bs = chr(92)
let child = "self_hosting" + bs + "build" + bs + "v2_interp.exe self_hosting" + bs + "v2" + bs + "spec" + bs + "fixtures" + bs + "vi_exec_alloc.patlang"
let tree = exec_measured("cmd", ["/c", child])
let own = exec_peak_memory("cmd", ["/c", child])
print("tree:" + (tree[3] >= 200000000) + "|" + (own[1] < 100000000))
