# exec_capture gives what the command wrote to both of its outputs (spec 1.13).
# cmd on Windows, sh on Linux, each writing the same text.
if os_target() == "linux" then
  print(exec_capture("/bin/sh", "-c", "echo 'to err ' 1>&2; echo to out"))
else
  print(exec_capture("cmd", "/c", "echo to err 1>&2& echo to out"))
end
