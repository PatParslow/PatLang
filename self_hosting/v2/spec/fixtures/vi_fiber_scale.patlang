# spec 1.7: resuming a fiber takes about as long with 2000 fibers paused as
# with 125: a fiber's job is found by its id without a look at every other.
# - each of 2000 fibers is resumed to its end, handing its values in and out
# - a resume among 2000 paused fibers costs no more than about four times the
#   cycles of one among 125 (sixteen times the fibers; a look at every job on
#   each resume made it about sixteen times)
include "../../../lib/cost_check.patlang"

make a function called counter takes start returns r
  let a = fiber_yield(start + 1)
  let b = fiber_yield(a + 1)
  return b + 1
end

make a function called resume_cost takes n returns row
  let ids = []
  let i = 0
  while i < n do
    let ids = list_push(ids, fiber_new("counter"))
    let i = i + 1
  end
  let t0 = cpu_cycles()
  let i = 0
  while i < n do
    fiber_resume(ids[i], i)
    let i = i + 1
  end
  let cost = cpu_cycles() - t0
  let right = 0
  let i = 0
  while i < n do
    if fiber_resume(ids[i], 10) == 11 then
      let right = right + 1
    end
    if fiber_resume(ids[i], 20) == 21 then
      let right = right + 1
    end
    let i = i + 1
  end
  let alive = 0
  let i = 0
  while i < n do
    if fiber_alive(ids[i]) then
      let alive = alive + 1
    end
    let i = i + 1
  end
  return [cost, right == 2 * n, alive]
end

let few = resume_cost(125)
let many = resume_cost(2000)
print([few[1], few[2], many[1], many[2]])
# each cost the cheapest of several readings after a warm-up
# (lib/cost_check.patlang, #284)
let best = cheapest_cycles([|| do return resume_cost(125)[0] end, || do return resume_cost(2000)[0] end], cost_rounds())
print(best[1] / 2000 <= 4 * best[0] / 125 + 20000)
