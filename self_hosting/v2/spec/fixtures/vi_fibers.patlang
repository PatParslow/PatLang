# engines_agree.feature: a fiber runs until it yields, and each resume hands it
# a value and takes back what it yields or, at its end, what it returns.
make a function called counter takes start returns r
  let a = fiber_yield(start + 1)
  let b = fiber_yield(a + 1)
  return b + 1
end

make a function called nested takes n returns r
  let inner = fiber_new("counter")
  let x = fiber_resume(inner, n)
  fiber_yield(x)
  return fiber_resume(inner, x)
end

let id = fiber_new("counter")
print(fiber_alive(id))
print(fiber_resume(id, 10))
print(fiber_resume(id, 20))
print(fiber_alive(id))
print(fiber_resume(id, 30))
print(fiber_alive(id))

let outer = fiber_new("nested")
print(fiber_resume(outer, 1))
print(fiber_resume(outer, 0))
print(fiber_alive(outer))
