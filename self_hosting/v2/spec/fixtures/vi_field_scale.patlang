# spec 1.1 (review finding O1): an object's field is found in about the same
# time wherever it is among the object's fields.
# - an object with 512 fields: its 4th and 512th read back, a field set again
#   keeps its place, a missing one reads as unit, and a new one is added last
# - reading the 512th 20000 times costs no more than about four times the
#   cycles of reading the 4th (a look at every field before it made it about
#   eighty times), each the cheapest of several readings after a warm-up
#   (lib/cost_check.patlang, #284)
# - an object new() makes with more than 16 defaults reads them as well
include "../../../lib/cost_check.patlang"

class Wide {
  field f0 = 0
}
class Many {
  field a0 = 0
  field a1 = 1
  field a2 = 2
  field a3 = 3
  field a4 = 4
  field a5 = 5
  field a6 = 6
  field a7 = 7
  field a8 = 8
  field a9 = 9
  field a10 = 10
  field a11 = 11
  field a12 = 12
  field a13 = 13
  field a14 = 14
  field a15 = 15
  field a16 = 16
  field a17 = 17
  field a18 = 18
  field a19 = 19
}

make a function called read_cost takes o, name, n returns cost
  let t0 = cpu_cycles()
  let s = 0
  let i = 0
  while i < n do
    let s = s + get(o, name)
    let i = i + 1
  end
  return cpu_cycles() - t0
end

let o = new("Wide")
let i = 1
while i < 512 do
  send(o, "set", "f" + i, i)
  let i = i + 1
end
print([get(o, "f3"), o.f511, type_of(get(o, "missing"))])
o.f200 = 7
o.extra = 99
print([o.f200, o.f199, o.f201, o.extra])
let best = cheapest_cycles([|| do return read_cost(o, "f3", 20000) end, || do return read_cost(o, "f511", 20000) end], cost_rounds())
print(best[1] <= 4 * best[0] + 20000000)
let m = new("Many")
print([m.a0, m.a17, m.a19, m.type])
m.a18 = 81
print([m.a18, m.a19])
