# spec 1.3: an operation on two floats costs about what one on two ints does.
# A loop of 200000 float additions and multiplications takes no more than four
# times one of int additions and multiplications, each the cheapest of
# several readings after a warm-up (lib/cost_check.patlang, #284) (it took
# about seventy times when every float operation called the runtime's
# operator function). Prints true.
include "../../../lib/cost_check.patlang"

make a function called int_loop takes n returns cycles
  let t0 = cpu_cycles()
  let a = 1
  let i = 0
  while i < n do
    let a = a * 3 + i
    let a = a - a + 1
    let i = i + 1
  end
  return cpu_cycles() - t0
end

make a function called float_loop takes n returns cycles
  let t0 = cpu_cycles()
  let a = 1.0
  let i = 0
  while i < n do
    let a = a * 1.0000001 + 0.5
    let a = a - a + 1.0
    let i = i + 1
  end
  return cpu_cycles() - t0
end

let best = cheapest_cycles([|| do return int_loop(200000) end, || do return float_loop(200000) end], cost_rounds())
print(best[1] <= 4 * best[0])
