# spec 1.3: an operation on two floats costs about what one on two ints does.
# A loop of 200000 float additions and multiplications takes no more than four
# times one of int additions and multiplications, the best of three runs of
# each (it took about seventy times when every float operation called the
# runtime's operator function). Prints true.
make a function called int_loop takes n returns cycles
  let t0 = cpu_cycles()
  let a = 1
  let i = 0
  while i < n do
    let a = a * 3 + i
    let a = a - a + 1
    let i = i + 1
  end
  return cpu_cycles() - t0
end

make a function called float_loop takes n returns cycles
  let t0 = cpu_cycles()
  let a = 1.0
  let i = 0
  while i < n do
    let a = a * 1.0000001 + 0.5
    let a = a - a + 1.0
    let i = i + 1
  end
  return cpu_cycles() - t0
end

make a function called best takes which, n returns c
  let c = 0
  let k = 0
  while k < 3 do
    if which == 0 then
      let t = int_loop(n)
    else
      let t = float_loop(n)
    end
    if (k == 0) or (t < c) then
      let c = t
    end
    let k = k + 1
  end
  return c
end

let ints = best(0, 200000)
let floats = best(1, 200000)
print(floats <= 4 * ints)
