# spec 1.3: + - * / and the comparisons of two floats are IEEE 754 double
# operations, rounded to nearest; a NaN is unordered and equal to nothing,
# itself included; -0.0 == 0.0. Each result is printed as its bits, so the
# engines and every way of compiling an operation give the same ones.
let inf = float_from_bits(9218868437227405312)
let nan = inf - inf
let values = [1.5, -2.25, 0.1, 3.0e300, 4.9e-324, 0.0, float_from_bits(0 - 9223372036854775808), inf, 0.0 - inf, nan]
let out = sb_new()
let i = 0
while i < list_len(values) do
  let j = 0
  while j < list_len(values) do
    let a = values[i]
    let b = values[j]
    sb_push(out, "" + float_bits(a + b) + " " + float_bits(a - b) + " " + float_bits(a * b) + " " + float_bits(a / b))
    sb_push(out, " " + (a < b) + (a > b) + (a <= b) + (a >= b) + (a == b) + (a != b) + chr(10))
    let j = j + 1
  end
  let i = i + 1
end
print(sb_str(out))
