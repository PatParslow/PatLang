# value_and_identity.feature, spec 1.5: get gives a field's value, or unit when the
# value has no such field, so a field holding false reads differently from one that
# is not there.
let o = new("Widget", "ga1")
send(o, "set", "off", false)
print(get(o, "off"))
print(get(o, "off") == unit)
print(type_of(get(o, "missing")))
print(get(o, "missing") == false)
print(type_of(get("ga1", "missing")))
print(type_of(get(5, "missing")))
