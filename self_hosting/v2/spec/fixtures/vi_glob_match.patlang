# spec 1.13: a match case may be a glob: * is any run of characters, ? is one,
# anything else is itself. It works in any program, with no library included,
# and a subject that is not a string matches no glob.
make a function called kind takes name returns k
  match name do
    case *.txt then
      return "text"
    case img* then
      return "image"
    case *fred* then
      return "fred"
    case _ then
      return "other"
  end
end

print([kind("notes.txt"), kind("img01"), kind("alfred smith"), kind("caf" + chr(233) + ".txt"), kind(".txt"), kind("txt"), kind(42)])
print([glob_match("abc", "a*c"), glob_match("ac", "a*c"), glob_match("abd", "a*c"), glob_match("", "*"), glob_match("a", ""), glob_match("aXbYc", "a*b*c")])
print([glob_match("img1", "img?"), glob_match("img", "img?"), glob_match("caf" + chr(233), "caf?"), glob_match("a.b", "a?b"), glob_match(42, "*")])
