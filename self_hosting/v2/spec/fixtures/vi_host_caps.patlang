# spec 1.13: host_caps() lists what the host running the program can do: a
# native build has x64, subprocess, tcp, tcp_remote and fs; a browser has
# wasm and none of those, so a library choosing a driver by it picks one that
# works.
let caps = host_caps()
if program_path() == "" then
  print(caps == ["wasm"])
else
  print(caps == ["x64", "subprocess", "tcp", "tcp_remote", "fs"])
end
print(list_len(caps) > 0)
