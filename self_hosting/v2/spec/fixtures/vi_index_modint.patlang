# value_and_identity.feature: a modint indexes by its residue (spec 1.5), in
# each place an index is taken. A residue past the end reads as an int's
# would: unit, or "" from a string; a residue of 2^63 or more, a bigint, is
# past any end.
let one = mod_make(1, 8)
let l = [10, 20, 30]
print(l[one])
print(list_get(l, mod_make(2, 7)))
print(l[mod_make(5, 8)])
print("" + list_set(l, one, 99))
let v = vec_new()
vec_push(v, 4)
vec_push(v, 5)
print(vec_get(v, one))
vec_set(v, mod_make(0, 256), 6)
print(vec_get(v, 0))
print([v[0], v[one]])
print(type_of(v[2]) + " " + type_of(v[mod_make(2, 3)]))
let b = bytes_from_list([7, 8, 9])
print(b[one])
print(bytes_get(b, mod_make(2, 4294967296)))
bytes_set(b, one, 200)
print(bytes_get(b, 1))
let a = bool_array_new(3)
bool_array_set(a, mod_make(2, 3), true)
print(bool_array_get(a, mod_make(2, 3)))
print("abc"[mod_make(2, 5)])
print("[" + "abc"[mod_make(4, 5)] + "]")
let big = mod_make(0 - 1, pow(2, 64))
print(type_of(mod_value(big)))
print(l[big])
print([1, 2, 3][mod_make(2, 1000000007)])
