# programs.feature: indexes the compiler does not warn of (spec 1.13): a loop's
# int, floor of a rational, to_int of floor's float, a modint, a parameter, a
# list's element, and a name that is a float on one path and an int on another.
make a function called at takes l, i returns v
  return l[i]
end
let l = [10, 20, 30]
let k = 0
while k < 3 do
  print(l[k])
  let k = k + 1
end
print(l[floor((1 + 4) / 2)])
print(l[to_int(floor(1.5))])
print(l[mod_make(1, 8)])
print(at(l, 0))
print(l[[2][0]])
let x = 1.5
if list_len(l) == 3 then
  let x = 0
end
print(l[x])
