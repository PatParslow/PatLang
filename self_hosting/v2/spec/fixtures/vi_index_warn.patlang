# programs.feature: the compiler warns of an index that is certainly not an
# int or a modint (spec 1.5, 1.13): at a call whose argument a function indexes
# with, through another (line 15), at l[1.5] (line 19), at vec_get given a
# sqrt (line 22), and at a string as an index (line 24). The program is built and
# runs until the first of them.
make a function called sample takes c, i returns v
  return c[i]
end
make a function called pixel takes c, x, y returns col
  let i = (y * 4 + x) * 3
  return sample(c, i)
end
make a function called smooth takes img returns col
  let x0 = floor(2.5)
  return pixel(img, x0, 0)
end
let l = [1, 2, 3]
print("before")
print(l[1.5])
let v = vec_new()
let s = sqrt(2.0)
print(vec_get(v, s))
let t = "1"
print(l[t])
print(smooth(l))
