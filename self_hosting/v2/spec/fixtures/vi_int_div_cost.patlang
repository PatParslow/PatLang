# spec 1.3: / of two ints that divide exactly gives an int, and costs about what
# their remainder (%) does: a loop of 70000 exact divisions takes no more than
# four times one of 70000 remainders, each the cheapest of several readings
# after a warm-up, by cpu_cycles (lib/cost_check.patlang, #284). (Every / of
# two ints went through the rationals, and an exact one cost about 20 us
# compiled, against 0.02 us for %, 2026-11-23.) Prints the quotients' sum,
# which is an int, and true.
include "../../../lib/cost_check.patlang"

make a function called div_loop takes n returns got
  let t0 = cpu_cycles()
  let s = 0
  let i = 0
  while i < n do
    let s = s + (7647 + i * 3) / 3
    let i = i + 1
  end
  return [cpu_cycles() - t0, s]
end

make a function called mod_loop takes n returns got
  let t0 = cpu_cycles()
  let s = 0
  let i = 0
  while i < n do
    let s = s + (7647 + i * 3) % 7
    let i = i + 1
  end
  return [cpu_cycles() - t0, s]
end

let sum = div_loop(70000)[1]
print(sum)
print(type_of(sum))
let best = cheapest_cycles([|| do return div_loop(70000)[0] end, || do return mod_loop(70000)[0] end], cost_rounds())
print(best[0] <= 4 * best[1])
