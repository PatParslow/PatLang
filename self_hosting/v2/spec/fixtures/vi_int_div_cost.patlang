# spec 1.3: / of two ints that divide exactly gives an int, and costs about what
# their remainder (%) does: a loop of 70000 exact divisions takes no more than
# four times one of 70000 remainders, the best of three runs of each, by
# cpu_cycles. (Every / of two ints went through the rationals, and an exact one
# cost about 20 us compiled, against 0.02 us for %, 2026-11-23.) Prints the
# quotients' sum, which is an int, and true.
make a function called div_loop takes n returns got
  let t0 = cpu_cycles()
  let s = 0
  let i = 0
  while i < n do
    let s = s + (7647 + i * 3) / 3
    let i = i + 1
  end
  return [cpu_cycles() - t0, s]
end

make a function called mod_loop takes n returns got
  let t0 = cpu_cycles()
  let s = 0
  let i = 0
  while i < n do
    let s = s + (7647 + i * 3) % 7
    let i = i + 1
  end
  return [cpu_cycles() - t0, s]
end

make a function called best takes which, n returns c
  let c = 0
  let k = 0
  while k < 3 do
    if which == 0 then
      let t = div_loop(n)[0]
    else
      let t = mod_loop(n)[0]
    end
    if (k == 0) or (t < c) then
      let c = t
    end
    let k = k + 1
  end
  return c
end

let sum = div_loop(70000)[1]
print(sum)
print(type_of(sum))
let divs = best(0, 70000)
let mods = best(1, 70000)
print(divs <= 4 * mods)
