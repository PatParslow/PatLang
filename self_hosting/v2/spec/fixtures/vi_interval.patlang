# intervals.feature: every line's value follows from spec 1.12.
let a = interval_make(1, 2)
print(type_of(a))
print(numeric_kind(a))
print(a)
print(interval_lo(a))
print(interval_hi(a))
print(a + interval_make(3, 4))
print(interval_make(1, 5) - interval_make(2, 3))
print(interval_make(2, 3) * interval_make(4, 5))
print(interval_make(0 - 2, 3) * interval_make(4, 5))
print(-a)
print(a == interval_make(1, 2))
print(a == interval_make(3, 4))
print(a != interval_make(3, 4))
print(a + 5)
print(5 + a)
print(10 - a)
print(a * (0 - 1))
print(interval_make(5, 5) == 5)
print(5 == interval_make(5, 5))
print(interval_make(4, 5) == 5)
print(type_of(interval_make(5, 5)))
print(interval_make(1 / 2, 3 / 2) + 1)
print(a * 9223372036854775807)
print(type_of(interval_hi(a * 9223372036854775807)))
print("x" + a)
print([a, a + 1])
print(a)
