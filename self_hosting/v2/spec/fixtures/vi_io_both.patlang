# spec 1.13: exec_capture_io feeds a child's input while it reads the child's
# output, so a child that writes more than a pipe holds before reading its
# input finishes: here cmd types a 300 KB file, then findstr echoes 300 KB of
# input back. (Writing all the input first once left both sides waiting on a
# full pipe until the timeout.)
let path = "self_hosting/build/v2_vi_io_both.txt"
let line = "0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789"
let b = sb_new()
let i = 0
while i < 3000 do
  sb_push(b, line + chr(10))
  let i = i + 1
end
let text = sb_str(b)
write_file(path, text)
let win = sb_new()
let k = 0
while k < path.length do
  if path[k] == "/" then
    sb_push(win, "\\")
  else
    sb_push(win, path[k])
  end
  let k = k + 1
end
let t0 = clock_ms()
let r = exec_capture_io("cmd", ["/c", "type " + sb_str(win) + " & findstr /r ."], text, 60000)
print(r[2])
print(r[0].length >= 2 * text.length)
print(clock_ms() - t0 < 30000)
remove_file(path)
