# `let x = f(x, ...)` is a call like any other (spec 1.13): a closure in a
# variable is called, rest takes the further arguments, and the program's own
# function is reached before the runtime's of the same name.
make a function called twice takes f, x returns r
  let x = f(x)
  let x = f(x)
  return x
end
make a function called sum_all takes first, rest returns s
  let s = first
  let i = 0
  while i < list_len(rest) do
    let s = s + rest[i]
    let i = i + 1
  end
  return s
end
# the program's own max: always 1000
make a function called max takes a, b returns r
  return 1000
end
print(twice(|v| { return v + 1 }, 10))
let y = 5
let fresh = max(y, 7)
print(fresh)
let y = max(y, 7)
print(y)
let acc = 1
let other = sum_all(acc, 2, 3)
print(other)
let acc = sum_all(acc, 2, 3)
print(acc)
