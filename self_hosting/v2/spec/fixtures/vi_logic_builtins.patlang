# spec 1.13: the goals a rule's body may hold beside neq. lt, le, gt and ge
# compare two numbers; ["not", [pred, arg, ...]] holds when pred(arg, ...) has
# no proof from the same stores (negation as failure), a variable only it has
# meaning any value; fact_remove_in(store, pred, args) takes a ground fact out
# of a store, giving whether it was there.
let kb = logic_store_new()
let x = logic_var("X")
let n = logic_var("N")
fact_in(kb, "words", "s1", 12)
fact_in(kb, "words", "s2", 45)
fact_in(kb, "words", "s3", 40)
rule_add_to(kb, "long", [x], [["words", [x, n]], ["gt", [n, 40]]])
rule_add_to(kb, "short_or_forty", [x], [["words", [x, n]], ["le", [n, 40]]])
print(solve_in(kb, "long", [x]))
print(solve_in(kb, "short_or_forty", [x]))
rule_add_to(kb, "between", [x], [["words", [x, n]], ["ge", [n, 12]], ["lt", [n, 45]]])
print(solve_in(kb, "between", [x]))
# a section with no paragraph: not, over what the same stores hold
let s = logic_var("S")
let p = logic_var("P")
fact_in(kb, "section", "intro", true)
fact_in(kb, "section", "empty", true)
fact_in(kb, "has_paragraph", "intro", "p1")
rule_add_to(kb, "bare", [s], [["section", [s, true]], ["not", ["has_paragraph", s, p]]])
print(solve_in(kb, "bare", [s]))
# removing a fact: the rules that read it see it gone
print(fact_remove_in(kb, "words", ["s2", 45]))
print(fact_remove_in(kb, "words", ["s2", 45]))
print(solve_in(kb, "long", [x]))
print(solve_in(kb, "words", [x, n]))
print(fact_remove_in(kb, "has_paragraph", ["intro", "p1"]))
print(solve_in(kb, "bare", [s]))
# the first-argument index still finds the facts left, and a fact added after
# a removal is found
fact_in(kb, "words", "s4", 50)
print(solve_in(kb, "words", ["s4", n]))
print(solve_in(kb, "long", [x]))
