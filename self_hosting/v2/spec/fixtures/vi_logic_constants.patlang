# A logic variable is a value of its own, made by logic_var(name) and by a
# capitalised name in a rule declaration. Every string is a constant, whatever
# its first letter (spec 1.13): data that begins with a capital matches only
# itself.
rule_add("role", ["alice", "admin"], [])
rule_add("role", ["Bob", "user"], [])
print(solve("role", ["mallory", "user"]))
print(solve("role", ["Bob", logic_var("Role")]))
print(solve("role", [logic_var("Who"), "user"]))
print(solve("role", [logic_var("A"), logic_var("B")]))
# a string that looks like a variable is a constant in a query too
print(solve("role", ["alice", "Role"]))

# in a declaration, a capitalised name is a variable and a quoted string is not
rule likes(alice, "Carol").
rule likes("Dave", X) :- likes(alice, X).
print(solve("likes", ["Dave", logic_var("W")]))
print(solve("likes", ["Erin", logic_var("W")]))

# the value itself
let x = logic_var("X")
print(type_of(x))
print(x)
print(x == logic_var("X"))
print(x == logic_var("Y"))
print(x == "X")
print(is_logic_var(x))
print(is_logic_var("X"))

# a fact given a capitalised string by fact() and counted by query()
fact("owner", "Report.txt", "Zoe")
print(query("owner", "Report.txt", 0))
print(query("owner", "Other.txt", 0))

# a planner's facts and goals are constants too
rule_add("have", ["Flour"], [])
action_add("bake", [["have", [logic_var("T")]]], [["baked", [logic_var("T")]]], [], 1)
print(plan_labels(plan([["baked", ["Flour"]]])))
print(plan_labels(plan([["baked", ["Sugar"]]])))
