# spec 1.13: in a rule declaration a number is the number it is (12, not
# "12"), so a comparison goal can compare it, and not(pred(args)) is negation
# as failure, its variables that nothing else uses meaning any value.
rule words("s1", 12).
rule words("s2", 45).
rule long(X) :- words(X, N), gt(N, 40).
rule short(X) :- words(X, N), le(N, 40).
print(solve("long", [logic_var("X")]))
print(solve("short", [logic_var("X")]))
print(type_of(solve("words", ["s1", logic_var("N")])[0][1]))
rule section("intro").
rule section("empty").
rule has_paragraph("intro", "p1").
rule bare(S) :- section(S), not(has_paragraph(S, P)).
print(solve("bare", [logic_var("S")]))
