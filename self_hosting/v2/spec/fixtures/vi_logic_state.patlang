# The logic state holds what the program asserted and its own contracts: nothing of
# the engine running it (spec 1.7).
make a function called checked takes x returns r
  require x > 0
  return x
end
checked(1)
action_add("load_truck", [["at", ["Item", "warehouse"]]], [["at", ["Item", "truck"]]], [["at", ["Item", "warehouse"]]], 1)
rule_add("at", ["box", "warehouse"], [])
let result = plan_with_state([["at", ["box", "truck"]]])
print(result[0].length)
print(result[1].length)
print(list_len(solve("contract_holds", ["checked", "X"])))
print(list_len(solve("contract_holds", ["iv_run", "X"])))
