# Rules live in stores (spec 1.13). Each printed line is one claim.

make a function called double takes x returns y
  require x >= 0
  let y = x * 2
  ensure y >= x
  return y
end

# Solutions as text: each solution's terms joined by commas, solutions by semicolons.
make a function called show takes sols returns text
  require type_of(sols) == "list"
  let parts = []
  let i = 0
  while i < list_len(sols) do
    let parts = list_push(parts, str_join(sols[i], ","))
    let i = i + 1
  end
  let text = "[" + str_join(parts, ";") + "]"
  ensure type_of(text) == "string"
  return text
end

# a store is a value with identity, holding each ground fact once
let a = logic_store_new()
print(type_of(a))
let b = a
rule_add_to(a, "p", ["x"], [])
rule_add_to(b, "p", ["y"], [])
rule_add_to(a, "p", ["x"], [])
print(show(solve_in(a, "p", [logic_var("X")])))
print(show(solve("p", [logic_var("X")])))

# rules declared in a named store, and goals drawing from it by name
rule parent(alice, bob) in family.
rule parent(bob, carol) in family.
let census = logic_store_new()
rule_add_to(census, "lives", ["carol", "york"], [])
rule grandchild_lives(X, T) :- parent(X, Y) from family, parent(Y, Z) from family, lives(Z, T).
print(show(solve_in([logic_store_named("default"), census], "grandchild_lives", ["alice", logic_var("T")])))
print(show(solve("grandchild_lives", ["alice", logic_var("T")])))

# stores in the order listed
let s1 = logic_store_new()
let s2 = logic_store_new()
rule_add_to(s1, "q", ["one"], [])
rule_add_to(s2, "q", ["two"], [])
print(show(solve_in([s1, s2], "q", [logic_var("X")])))
print(show(solve_in([s2, s1], "q", [logic_var("X")])))

# solving into a store, twice, adds each fact once
let derived = logic_store_new()
solve_into(derived, logic_store_named("family"), "parent", [logic_var("X"), logic_var("Y")])
print(show(solve_into(derived, logic_store_named("family"), "parent", [logic_var("X"), logic_var("Y")])))
print(show(solve_in(derived, "parent", [logic_var("X"), logic_var("Y")])))

# planning from a store's facts
action_add("go", [["at", ["home"]]], [["at", ["work"]]], [["at", ["home"]]], 1)
let place = logic_store_new()
rule_add_to(place, "at", ["home"], [])
print(plan_labels(plan([["at", ["work"]]])))
print(plan_labels(plan_in(place, [["at", ["work"]]])))

# contract facts are in the contracts store, which rules_clear leaves alone
double(3)
let held = list_len(solve("contract_holds", ["double", logic_var("K")]))
print(held > 0)
rule_add("mine", ["m"], [])
rules_clear()
print(show(solve("mine", [logic_var("X")])))
print(list_len(solve("contract_holds", ["double", logic_var("K")])) == held)
print(list_len(solve_in(logic_store_named("contracts"), "contract_holds", ["double", logic_var("K")])) == held)

# a deleted name names a new, empty store
store_delete("family")
print(show(solve_in(logic_store_named("family"), "parent", [logic_var("X"), logic_var("Y")])))
