# An inner loop that moves the outer loop's index on, as a lexer skips spaces:
# the index is meant to be shared, and the compiler warns of nothing (#267).
let text = "ab  cd   e"
let i = 0
let words = 0
while i < text.length do
  while (i < text.length) and (text[i] == " ") do
    let i = i + 1
  end
  if i < text.length then
    let words = words + 1
  end
  while (i < text.length) and (text[i] != " ") do
    let i = i + 1
  end
end
print(words)
