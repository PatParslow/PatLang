# A let has no block scope (CLAUDE.md 4.6): the outer loop's counter s is set
# to 1 inside it and an inner loop then counts with it, so the outer loop
# runs once where three suites were meant (GitHub #267). The compiler warns,
# naming the loop on line 7 and s.
let suites = ["a", "b", "c"]
let s = 0
while s < list_len(suites) do
  let n = 3
  let s = 1
  while s <= n do
    let s = s + 1
  end
  print("suite done")
  let s = s + 1
end
