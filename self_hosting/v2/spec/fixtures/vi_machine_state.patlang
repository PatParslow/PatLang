# The machine's processors and memory (spec 1.13): cpu_count, cpu_times and
# memory_status; cpu_times read 100 ms apart, as a scheduler reads it.
let n = cpu_count()
print(n >= 1)
let a = cpu_times()
sleep_ms(100)
let b = cpu_times()
print((list_len(a) == 2) and (a[0] >= 0) and (a[1] >= 0))
print((b[0] >= a[0]) and (b[1] >= a[1]) and (b[0] + b[1] > a[0] + a[1]))
let m = memory_status()
print((list_len(m) == 2) and (m[0] > 0) and (m[1] > 0) and (m[1] <= m[0]))
