# modular_integers.feature: mod_reveal gives what mod_value gives, for a
# modint held as a word, one at the 64-bit boundary, and one in a block; it
# differs only in what the constant-time check says of it (spec 2.7).
let a = mod_make(200, 256)
let b = mod_make(18446744073709551615, 18446744073709551616)
let c = mod_make(123456789, 1000000007)
let d = mod_make(1701411834604692317316873037158841057273, 87112285931760246646623899502532662132737)
print(mod_reveal(a))
print(mod_reveal(b))
print(mod_reveal(c))
print(mod_reveal(d))
print([mod_reveal(a) == mod_value(a), mod_reveal(b) == mod_value(b), mod_reveal(c) == mod_value(c), mod_reveal(d) == mod_value(d)])
print(type_of(mod_reveal(b)))
