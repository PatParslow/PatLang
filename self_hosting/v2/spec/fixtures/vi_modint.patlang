# modular_integers.feature: every line's value follows from spec 1.14.
let a = mod_make(3, 7)
print(type_of(a))
print(numeric_kind(a))
print(a)
print(mod_value(a))
print(mod_modulus(a))
print(mod_make(0 - 1, 7))
print(mod_make(10, 7))
print(a + mod_make(5, 7))
print(a - mod_make(5, 7))
print(a * mod_make(5, 7))
print(-a)
print(a + 10)
print(10 + a)
print(1 - a)
print(a / mod_make(5, 7))
print(a / 2)
print(pow(a, 6))
print(pow(a, 0))
print(pow(a, 0 - 1))
print(pow(a, 100))
print(a == mod_make(10, 7))
print(a == mod_make(3, 11))
print(a == 3)
print(10 == a)
print(a != 4)
let m = 9223372036854775807
let big = mod_make(m * 3, m * 2)
print(big)
print(type_of(mod_modulus(big)))
print(big * big)
print(big + 1)
print(mod_make(5, 12) / mod_make(7, 12))
print(pow(mod_make(3, 256), 0 - 1))
print(pow(mod_make(7, 12884901888), 0 - 1))
print(mod_make(10, 12884901888) / 7)
let p = 57896044618658097711785492504343953926634992332820282019728792003956564819949
print(pow(mod_make(9, p), p - 2) * 9 == 1)
print(pow(mod_make(5, 2305843009213693951), 0 - 3))
let L = 7237005577332262213973186563042994240857116359379907606001950938285454250989
print(mod_make(mod_make(300, 1000), 256))
print(mod_make(mod_make(200, 256), 7))
print(mod_make(mod_make(6, 7), p))
print(mod_make(mod_make(p - 1, p), 256))
print(mod_make(mod_make(p - 1, p), 4294967296))
print(mod_make(mod_make(5, 12), 9))
print(mod_make(mod_make(p - 2, p), L))
print(mod_make(mod_make(L - 1, L), p))
print(mod_make(mod_make(0 - 1, 18446744073709551616), 1000))
print(mod_make(mod_make(12884901887, 12884901888), 4294967296))
print("x" + a)
print([a, a + 1])
print(a)
