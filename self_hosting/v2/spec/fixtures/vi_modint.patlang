# modular_integers.feature: every line's value follows from spec 1.14.
let a = mod_make(3, 7)
print(type_of(a))
print(numeric_kind(a))
print(a)
print(mod_value(a))
print(mod_modulus(a))
print(mod_make(0 - 1, 7))
print(mod_make(10, 7))
print(a + mod_make(5, 7))
print(a - mod_make(5, 7))
print(a * mod_make(5, 7))
print(-a)
print(a + 10)
print(10 + a)
print(1 - a)
print(a / mod_make(5, 7))
print(a / 2)
print(pow(a, 6))
print(pow(a, 0))
print(pow(a, 0 - 1))
print(pow(a, 100))
print(a == mod_make(10, 7))
print(a == mod_make(3, 11))
print(a == 3)
print(10 == a)
print(a != 4)
let m = 9223372036854775807
let big = mod_make(m * 3, m * 2)
print(big)
print(type_of(mod_modulus(big)))
print(big * big)
print(big + 1)
print("x" + a)
print([a, a + 1])
print(a)
