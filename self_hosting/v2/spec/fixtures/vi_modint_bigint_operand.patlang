# spec 1.14: a modint modulo 2^k with a bigint on the other side of an
# operator takes the bigint reduced modulo 2^k, as with an int, and costs
# about what an int there does. A constant at or above 2^63 (a mask of all
# ones, 0xe1 << 56) is a bigint; before 2026-11-24 it sent a word modint to
# the block layout and back, about 200 times an int's cost (343,000 cycles
# against 1,700), and AES-128-GCM's masks made it 29 million cycles a byte.
# - band, bor, bxor, +, - and * with a bigint give what the bigint reduced
#   first gives, for 64- and 32-bit modints, positive and negative bigints
# - band with the bigint 0xffffffffffffffff, held in a variable, costs no
#   more than four times band with the int 0x0101010101010101, each the
#   cheapest of several readings after a warm-up (lib/cost_check.patlang).
#   (Measured after the change: about 4,100 cycles against 1,900. A bigint
#   literal is built from its text each time it is evaluated, about 26,000
#   cycles, so the claim holds the bigint in a variable: #285.)
include "../../../lib/cost_check.patlang"

let m64 = mod_make(12345678901234567, 18446744073709551616)
let m32 = mod_make(3000000000, 4294967296)
let bigs = [18446744073709551615, 16212958658533785600, 18446744073709551621, 0 - 18446744073709551617, 340282366920938463463374607431768211457]
let ok = true
let i = 0
while i < list_len(bigs) do
  let b = bigs[i]
  let r64 = mod_make(b, 18446744073709551616)
  let r32 = mod_make(b, 4294967296)
  let got = [m64 band b, m64 bor b, m64 bxor b, m64 + b, m64 - b, m64 * b, b band m64, m32 band b, m32 + b, m32 * b]
  let want = [m64 band r64, m64 bor r64, m64 bxor r64, m64 + r64, m64 - r64, m64 * r64, r64 band m64, m32 band r32, m32 + r32, m32 * r32]
  if got != want then
    print(["differs for", b, got, want])
    let ok = false
  end
  let i = i + 1
end
print(ok)
print([m64 band 18446744073709551615, type_of(m64 band 18446744073709551615)])

make a function called band_cost takes which returns c
  let m = mod_make(12345678901234567, 18446744073709551616)
  let big = 18446744073709551615
  let t0 = cpu_cycles()
  let k = 0
  while k < 20000 do
    if which == 0 then
      let x = m band 72340172838076673
    else
      let x = m band big
    end
    let k = k + 1
  end
  return cpu_cycles() - t0
end

let c = cheapest_cycles([|| do return band_cost(0) end, || do return band_cost(1) end], cost_rounds())
print(c[1] <= 4 * c[0])
