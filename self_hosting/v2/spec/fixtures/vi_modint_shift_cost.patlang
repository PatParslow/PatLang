# spec 1.14, 2.1: shl, shr, rotl and rotr on a modint modulo 2^k held as a
# word cost about what bxor of two such words does, and give what the rules
# give at the edge counts.
# - for k = 8, 32 and 64 and counts 0, 1, k - 1 and k, each result equals the
#   same shift or rotation done on the residue as an int, masked to k bits
#   (mod_value), shl and shr up to k - 1 (a count of k, for k = 64, is the
#   runtime's, and gives 0 too)
# - each of the four on 32-bit and 64-bit words, 20000 times, costs no more
#   than four times bxor of two words as often, each the cheapest of several
#   readings after a warm-up (lib/cost_check.patlang). Measured 2026-11-24
#   before they were inline: rotr about 660 cycles and shl about 1,070,
#   against about 60 for bxor.
include "../../../lib/cost_check.patlang"

make a function called pow2 takes k returns p
  let p = 1
  let i = 0
  while i < k do
    let p = p * 2
    let i = i + 1
  end
  return p
end

make a function called int_rotl takes v, s, k returns r
  let p = pow2(k)
  if (s == 0) or (s == k) then
    return v
  end
  return (v * pow2(s)) % p + floor(v / pow2(k - s))
end

let ok = true
let ks = [8, 32, 64]
let ki = 0
while ki < 3 do
  let k = ks[ki]
  let p = pow2(k)
  let v = (p - 1) - floor(p / 3)
  let m = mod_make(v, p)
  let counts = [0, 1, k - 1, k]
  let ci = 0
  while ci < 4 do
    let s = counts[ci]
    let got = [mod_value(rotl(m, s)), mod_value(rotr(m, s))]
    let want = [int_rotl(v, s, k), int_rotl(v, k - s, k)]
    if s < k then
      let got = got + [mod_value(m shl s), mod_value(m shr s)]
      let want = want + [(v * pow2(s)) % p, floor(v / pow2(s))]
    end
    if got != want then
      print(["differs", k, s, got, want])
      let ok = false
    end
    let ci = ci + 1
  end
  let ki = ki + 1
end
print(ok)
print([mod_value(mod_make(255, 18446744073709551616) shl 64), mod_value(mod_make(255, 18446744073709551616) shr 64)])

make a function called op_cost takes which returns c
  let a32 = mod_make(2654435761, 4294967296)
  let a64 = mod_make(11400714819323198485, 18446744073709551616)
  let b64 = mod_make(7046029254386353131, 18446744073709551616)
  let t0 = cpu_cycles()
  let k = 0
  while k < 20000 do
    if which == 0 then
      let x = a64 bxor b64
    elif which == 1 then
      let x = a32 shl 7
    elif which == 2 then
      let x = a64 shr 13
    elif which == 3 then
      let x = rotl(a32, 7)
    elif which == 4 then
      let x = rotr(a64, 41)
    end
    let k = k + 1
  end
  return cpu_cycles() - t0
end

let readers = []
let w = 0
while w < 5 do
  let readers = list_push(readers, || do return op_cost(w) end)
  let w = w + 1
end
let c = cheapest_cycles(readers, cost_rounds())
let i = 1
while i < 5 do
  print(c[i] <= 4 * c[0])
  let i = i + 1
end
