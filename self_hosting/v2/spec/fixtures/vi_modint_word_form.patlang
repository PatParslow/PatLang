# spec 1.14: everything a program can see of modints modulo 2^k, for k = 1, 8,
# 32, 63 and 64. Captured from the engines before modints modulo 2^k were
# held as words (2.1), and unchanged since: that change is an optimisation
# only. The last line mixes two moduli, which stops the program.
make a function called show takes label, v returns done
  print(label + ": " + v + " (" + type_of(v) + ", " + numeric_kind(v) + ")")
  return true
end

let ks = [1, 8, 32, 63, 64]
let i = 0
while i < list_len(ks) do
  let k = ks[i]
  let n = pow(2, k)
  let a = mod_make(n - 1, n)
  let b = mod_make(5, n)
  let z = mod_make(0, n)
  print("k = " + k + ", modulus " + mod_modulus(a) + " " + type_of(mod_modulus(a)))
  show("a", a)
  show("b", b)
  show("a + b", a + b)
  show("a - b", a - b)
  show("b - a", b - a)
  show("a * b", a * b)
  show("a * a", a * a)
  show("-b", 0 - b)
  show("unary -a", -a)
  show("a + 3", a + 3)
  show("3 + a", 3 + a)
  show("a * -1", a * (0 - 1))
  show("a band b", a band b)
  show("a bor b", a bor b)
  show("a bxor b", a bxor b)
  show("bnot b", bnot b)
  show("b shl 1", b shl 1)
  show("a shr 1", a shr 1)
  show("a shl k", a shl k)
  show("rotl(b, 1)", rotl(b, 1))
  show("rotr(b, 1)", rotr(b, 1))
  show("rotl(a, 0)", rotl(a, 0))
  show("rotr(b, k)", rotr(b, k))
  print("mod_value(a) " + mod_value(a) + " " + type_of(mod_value(a)))
  print("a == a, a == b, a != b: " + (a == mod_make(n - 1, n)) + " " + (a == b) + " " + (a != b))
  print("a == int: " + (a == (n - 1)) + " " + (b == 5) + " " + (b == 6) + " " + (b == 5 + n))
  print("in lists: " + ([a, b] == [mod_make(n - 1, n), mod_make(5, n)]) + " " + [a, b, z])
  print("mod_make of a modint: " + mod_make(a, 7) + ", " + mod_make(b, n) + ", " + mod_make(a, pow(2, 70)))
  print("mod_make of a negative: " + mod_make(0 - 3, n))
  print("mod_make of a bigint: " + mod_make(pow(2, 100) + 9, n))
  if k > 1 then
    show("b / b", b / b)
    show("a / b", a / b)
  end
  show("pow(b, 3)", pow(b, 3))
  show("pow(a, 0)", pow(a, 0))
  if k > 1 then
    show("pow(b, -1)", pow(b, 0 - 1))
  end
  let i = i + 1
end
let w = mod_make(9, 256)
let total = mod_make(0, 256)
let j = 0
while j < 300 do
  let total = total + w
  let j = j + 1
end
show("300 additions of 9 modulo 256", total)
print([mod_make(1, 2), mod_make(1, 3), mod_make(1, 4)])
print(mod_make(1, 4) == mod_make(1, 8))
show("a value at the top of 64 bits", mod_make(pow(2, 64) - 1, pow(2, 64)) + 1)
print(mod_make(3, 8) + mod_make(3, 16))
print("not reached")
