# modular_integers.feature: modints modulo 2^k are k-bit words (spec 1.14).
let w = mod_make(200, 256)
print(w + mod_make(100, 256))
print(w band mod_make(15, 256))
print(w bor 7)
print(w bxor mod_make(255, 256))
print(bnot w)
print(w shl 1)
print(w shr 3)
print(w shl 8)
print(w shr 0)
print(rotl(w, 1))
print(rotr(mod_make(201, 256), 1))
print(rotl(w, 0))
print(rotr(w, 8))
let x = mod_make(4294967295, 4294967296)
print(x + 1)
print(bnot mod_make(0, 4294967296))
print(rotr(mod_make(1, 4294967296), 1))
let y = mod_make(0 - 1, 4611686018427387904)
print(y)
print(bnot y)
print(y shl 1)
print(rotl(y, 61))
let z = mod_make(0 - 1, 18446744073709551616)
print(z)
print(bnot z)
print(z shl 64)
print(z shr 63)
print(z shr 64)
print(rotl(mod_make(1, 18446744073709551616), 63))
print(rotr(mod_make(1, 18446744073709551616), 0))
print(rotr(mod_make(1, 18446744073709551616), 64))
print(rotr(mod_make(3, 18446744073709551616), 1))
print(mod_make(12345, 18446744073709551616) + z)
print(mod_make(3, 18446744073709551616) * mod_make(9223372036854775808, 18446744073709551616))
print(z bxor mod_make(81985529216486895, 18446744073709551616))
print(z band 255)
print(bnot mod_make(1, 18446744073709551616))
