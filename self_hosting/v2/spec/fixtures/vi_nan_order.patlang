# spec 1.3/1.4: a NaN is ordered against nothing, itself included: ==, <,
# <=, >, >= with a NaN on either side are false, and != is true (IEEE 754).
# Ordinary floats, ints and strings compare as before.
let z = 0.0
let nan = z / z
print([nan == nan, nan != nan, nan == 1.0, 1.0 == nan])
print([nan < 1.0, nan <= 1.0, 1.0 <= nan, nan > 1.0, 1.0 >= nan, nan >= nan, nan <= nan])
print([1.0 <= 2.0, 2.0 >= 2.0, 3 > 2, 2 <= 2, "a" < "b", "b" >= "b", "c" > "d"])
