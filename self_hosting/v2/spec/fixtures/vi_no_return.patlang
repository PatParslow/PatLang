# What a function that ends without return gives (spec 1.13).
make a function called last_expr takes a
  a + 1
end
make a function called last_call takes a
  last_expr(a)
end
make a function called last_let takes a
  let x = a + 2
end
make a function called last_if takes a
  if a > 0 then
    "taken"
  else
    "other"
  end
end
make a function called last_if_untaken takes a
  if a > 0 then
    "taken"
  end
end
make a function called last_while takes a
  let i = 0
  while i < a do
    let i = i + 1
  end
end
make a function called no_statements takes a
end
print(last_expr(1))
print(last_call(1))
print(last_let(1))
print(last_if(1))
print(last_if(0))
print(type_of(last_if_untaken(0)))
print(last_while(2))
print(type_of(last_while(0)))
print(type_of(no_statements(1)))
