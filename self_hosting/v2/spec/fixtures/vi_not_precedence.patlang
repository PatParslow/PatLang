# spec 1.13: not binds more loosely than a comparison and more tightly than
# and/or: not a == b is not (a == b), and not a == b and c is
# (not (a == b)) and c.
let a = 1
let b = 2
print(not a == b)
print(not a < b)
print(not a == b and false)
print(not a == 1 or true)
print(not (a == b))
print((not a) == false)
