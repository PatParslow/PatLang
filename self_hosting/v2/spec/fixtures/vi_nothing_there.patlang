# value_and_identity.feature, spec 1.5: what each lookup gives when nothing is
# there.
let l = [1]
print(type_of(l[5]))
print(type_of(l[0 - 1]))
print(type_of(5[0]))
print(type_of(vec_get(vec_new(), 3)))
print("[" + "ab"[7] + "]")
print(type_of(get(new("Widget", "nt1"), "missing")))
print("[" + getenv("PATLANG_NO_SUCH_VARIABLE") + "]")
print("[" + read_file("self_hosting/no/such/file") + "]")
print(file_exists("self_hosting/no/such/file"))
print(vfs_exists("/no/such/path"))
print(query("no_such_predicate", "x", 0))
