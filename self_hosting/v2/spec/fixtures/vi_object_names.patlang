# spec 1.1: a string equal to a named object's name stands for the object,
# unless the program declares object_names_explicit(): then a string is only
# a string, and object_named(name) gives the object (unit for none). The
# argument says which: "implicit" or "explicit".
class Widget {
  field color = "red"
}
if argv()[0] == "explicit" then
  object_names_explicit()
end
let w = new("Widget", "w1")
print(object_named("w1") == w)
print(object_named("w1").color)
if argv()[0] == "explicit" then
  print("w1".length)
  print(object_delete("w1"))
  print(object_named("w1") == w)
else
  print("w1".color)
  print(object_delete("w1"))
  print(object_named("w1") == unit)
end
print(object_named("nobody") == unit)
