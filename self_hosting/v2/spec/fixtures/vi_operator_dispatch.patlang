# spec 1.4: each of < > <= >= is a method of its left operand's class, sent
# as itself: a class defining only <= is compared with <=, and a > b goes to
# a's class whatever b's defines.
class Score {
  field n = 0
  make a function called <= takes self, other returns r
    return self.n <= other.n
  end
}

class Left {
  make a function called > takes self, other returns r
    return "left's >"
  end
}

class Right {
  make a function called > takes self, other returns r
    return "right's >"
  end
}

let a = new("Score")
a.n = 3
let b = new("Score")
b.n = 5
print([a <= b, b <= a])
print(new("Left") > new("Right"))
print(new("Right") > new("Left"))
