# programs.feature, spec 1.13: path_absolute gives a path in full, from the
# current directory, with / between its parts.
make a function called ends_with takes s, tail returns yes
  if tail.length > s.length then return false end
  return substr(s, s.length - tail.length, tail.length) == tail
end

make a function called has_backslash takes s returns yes
  let i = 0
  while i < s.length do
    if s[i] == chr(92) then return true end
    let i = i + 1
  end
  return false
end

let p = path_absolute("self_hosting/v2/runtime")
print(ends_with(p, "/self_hosting/v2/runtime"))
print(p.length > "self_hosting/v2/runtime".length)
print(has_backslash(p))
print(file_exists(p))
print(path_absolute("self_hosting/../self_hosting/v2/runtime") == p)
print(path_absolute(p) == p)
