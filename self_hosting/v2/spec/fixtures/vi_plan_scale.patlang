# plan (spec 1.13): a cheapest plan, found for many independent goals in time
# that grows about with their number cubed, and [] only when no sequence of
# actions reaches the goals. Prints four lines, each true when its claim holds.

# Two builds in a chain, then n units each needing the second: the goals are
# the n units' verdicts.
make a function called chain_actions takes n returns goals
  require n > 0
  action_clear()
  action_add("compiler", [], [["built", ["compiler"]]], [], 1)
  action_add("interp", [["built", ["compiler"]]], [["built", ["interp"]]], [], 1)
  let goals = []
  let i = 0
  while i < n do
    action_add("u" + i, [["built", ["interp"]]], [["verified", ["u" + i]]], [], 1)
    let goals = list_push(goals, ["verified", ["u" + i]])
    let i = i + 1
  end
  ensure list_len(goals) == n
  return goals
end

make a function called plan_ms takes n returns ms
  let goals = chain_actions(n)
  let t0 = now_ms()
  let p = plan_labels(plan(goals))
  let ms = now_ms() - t0
  if list_len(p) != n + 2 then
    print("wrong plan for " + n + " goals: " + list_len(p) + " steps")
  end
  return ms
end

# ten goals: both builds first, then every unit
let p = plan_labels(plan(chain_actions(10)))
print((list_len(p) == 12) and (p[0] == "compiler") and (p[1] == "interp"))

# a goal no action reaches: [] once every reachable state has been tried
action_clear()
action_add("a", [], [["have", ["a"]]], [], 1)
action_add("b", [["have", ["a"]]], [["have", ["b"]]], [], 1)
print(plan_labels(plan([["have", ["c"]]])) == [])

# the cheaper of two routes, though it takes more steps
action_clear()
action_add("direct", [], [["at", ["far"]]], [], 10)
action_add("step1", [], [["at", ["near"]]], [], 1)
action_add("step2", [["at", ["near"]]], [["at", ["far"]]], [], 1)
print(plan_labels(plan([["at", ["far"]]])) == ["step1", "step2"])

let small = plan_ms(40)
let large = plan_ms(80)
print(large <= 9 * small + 100)
