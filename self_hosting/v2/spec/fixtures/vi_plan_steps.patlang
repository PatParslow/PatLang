# spec 1.13: a plan's steps are [name, values, names]: a value keeps its type
# and a text holding a comma stays one value; activate hands each step's
# closure its values as they were bound, and step_label writes the step as
# text.
action_add("ship", [["parcel", [logic_var("P"), logic_var("N")]]], [["shipped", [logic_var("P")]]], [], 1)
rule_add("parcel", ["a,b", 2], [])
let steps = plan([["shipped", ["a,b"]]])
print(list_len(steps))
print(step_name(steps[0]))
print(step_values(steps[0]))
print(type_of(step_values(steps[0])[1]))
print(plan_labels(steps))
action_bind("ship", |args| {
  print("shipping " + args[0] + " x" + args[1] + " (" + list_len(args) + " values, " + type_of(args[1]) + ")")
  return true
})
print(activate(steps))
