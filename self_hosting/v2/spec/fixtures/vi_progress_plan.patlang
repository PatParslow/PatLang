# progress_report and progress_status, plan_incremental and action_clear (spec 1.13).
print(progress_status() == "")
progress_report("first")
progress_report("second")
print(progress_status())
rule_add("at", ["home"], [])
action_add("go", [["at", ["home"]]], [["at", ["work"]]], [["at", ["home"]]], 1)
let p1 = plan_labels(plan([["at", ["work"]]]))
print(p1)
print(plan_labels(plan_incremental([["at", ["work"]]])) == p1)
action_clear()
print(list_len(plan_labels(plan([["at", ["work"]]]))))
