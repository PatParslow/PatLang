# spec 1.3: arithmetic on rationals whose parts are all under 2^31 is done on
# machine words, at a small part of the cost of the general path.
# - 1/3 + 2/7, 1/3 - 2/7, 1/3 * 2/7, 1/3 / (2/7) and 1/3 < 2/7, each 20000
#   times, cost no more than a quarter of the same with 1/3 made 2147483659/3
#   (a part past 2^31, so the general path; every product still fits a word,
#   so no bigint is made)
# (Two ints divided are words below 2^62 either way, one path: vi_int_div_cost
# checks that.) Both sides of each claim are rational work, so other programs sharing the
# machine slow them alike. (A claim against making a two-element list failed
# under the gates' load, rational work and allocation slowing differently.)
# The cost counted is the operator's: each operator has a loop of its own, and
# the same loop with no operator in it is taken off both sides. (One loop
# choosing the operator by an if chain added the chain's cost to both sides;
# interpreted, that and the loop came to about as much as a small operator, and
# the ratios fell to 4.7 to 7.8, failing under the gates' load, gates run 16.)
# Measured so on 2026-11-25: interpreted 6.6 to 16, compiled 8.6 to 25. The
# interpreter's dispatch, about 3,000 cycles an operator, is the operator's
# cost on that engine and is counted; a quarter leaves it 1.6 times' room.
# Each count is the cheapest of several readings after a warm-up
# (lib/cost_check.patlang). Measured 2026-11-24 after the small fast paths
# (#285): the general path costs 9 to 30 times the small one; before them the
# small parts took the general path too, at about 17,400 cycles an add
# against about 75,000 with the large part, a ratio of 4 at most.
# It prints the results once, to show they are right, then true five times.
include "../../../lib/cost_check.patlang"

make a function called empty_cost takes a, b returns c
  let t0 = cpu_cycles()
  let k = 0
  while k < 20000 do
    let x = b
    let k = k + 1
  end
  return cpu_cycles() - t0
end

make a function called add_cost takes a, b returns c
  let t0 = cpu_cycles()
  let k = 0
  while k < 20000 do
    let x = a + b
    let k = k + 1
  end
  return cpu_cycles() - t0
end

make a function called sub_cost takes a, b returns c
  let t0 = cpu_cycles()
  let k = 0
  while k < 20000 do
    let x = a - b
    let k = k + 1
  end
  return cpu_cycles() - t0
end

make a function called mul_cost takes a, b returns c
  let t0 = cpu_cycles()
  let k = 0
  while k < 20000 do
    let x = a * b
    let k = k + 1
  end
  return cpu_cycles() - t0
end

make a function called div_cost takes a, b returns c
  let t0 = cpu_cycles()
  let k = 0
  while k < 20000 do
    let x = a / b
    let k = k + 1
  end
  return cpu_cycles() - t0
end

make a function called lt_cost takes a, b returns c
  let t0 = cpu_cycles()
  let k = 0
  while k < 20000 do
    let x = a < b
    let k = k + 1
  end
  return cpu_cycles() - t0
end

print([1 / 3 + 2 / 7, 1 / 3 - 2 / 7, 1 / 3 * (2 / 7), 1 / 3 / (2 / 7), 6 / 4, 1 / 3 < 2 / 7])
let s = 1 / 3
let g = 2147483659 / 3
let b = 2 / 7
let readers = [|| do return empty_cost(s, b) end]
let readers = list_push(readers, || do return add_cost(s, b) end)
let readers = list_push(readers, || do return add_cost(g, b) end)
let readers = list_push(readers, || do return sub_cost(s, b) end)
let readers = list_push(readers, || do return sub_cost(g, b) end)
let readers = list_push(readers, || do return mul_cost(s, b) end)
let readers = list_push(readers, || do return mul_cost(g, b) end)
let readers = list_push(readers, || do return div_cost(s, b) end)
let readers = list_push(readers, || do return div_cost(g, b) end)
let readers = list_push(readers, || do return lt_cost(s, b) end)
let readers = list_push(readers, || do return lt_cost(g, b) end)
let c = cheapest_cycles(readers, cost_rounds())
let i = 0
while i < 5 do
  let small = c[2 * i + 1] - c[0]
  let large = c[2 * i + 2] - c[0]
  print(4 * small <= large)
  let i = i + 1
end
