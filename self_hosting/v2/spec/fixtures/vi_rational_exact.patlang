# spec 1.3: rational arithmetic is exact, whatever path a value takes: small
# parts (under 2^31, done on words, #285) and large ones (the general path),
# ints and rationals mixed, both signs. Random operands from a fixed seed;
# one line per pair: a, b, a+b, a-b, a*b, a/b, a<b, a>b, a<=b, a>=b.
# vi_rational_exact.expected is this program's output checked line by line
# with Python's fractions (2026-11-24: 399 lines, 0 mismatches; the checker
# was repro/rat/diff_check.py, reading a and b as printed and computing each
# result with Fraction).
let seed = 12345
let vals = []
let k = 0
while k < 400 do
  let seed = (seed * 1103515245 + 12345) % 2147483648
  let kind = seed % 6
  let seed = (seed * 1103515245 + 12345) % 2147483648
  let n = seed % 2000 - 1000
  let seed = (seed * 1103515245 + 12345) % 2147483648
  let d = seed % 999 + 1
  if kind == 0 then
    let v = n
  elif kind == 1 then
    let v = n / d
  elif kind == 2 then
    let v = (n * 3000000) / (d * 7)
  elif kind == 3 then
    let v = (n * 2147483647) / (d + 2147483000)
  elif kind == 4 then
    let v = (n * 100000000000) / (d * 100003)
  else
    let v = 0 - n / (d * 1000003)
  end
  let vals = list_push(vals, v)
  let k = k + 1
end
let i = 0
while i < list_len(vals) - 1 do
  let a = vals[i]
  let b = vals[i + 1]
  let q = "inf"
  if b != 0 then
    let q = "" + a / b
  end
  print(str_join(["" + a, "" + b, "" + (a + b), "" + (a - b), "" + (a * b), q, "" + (a < b), "" + (a > b), "" + (a <= b), "" + (a >= b)], " "))
  let i = i + 1
end
