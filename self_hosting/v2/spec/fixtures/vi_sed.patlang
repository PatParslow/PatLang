# sed: literal s/pattern/replacement/flags (spec 1.10).
print(sed("s/l/L/g", "hello"))
print(sed("s/l/L/", "hello"))
print(sed("s/L/x/i", "hello"))
print(sed("s/L/x/gi", "hello world"))
print(sed("s/zz/x/g", "hello"))
print(sed("p/l/x/", "hello"))
print(sed("s//x/g", "hello"))
print(sed("s/l", "hello"))
print(sed("s/l/", "hello"))
print(sed("s/o/0/g/extra", "foo boo"))
print(sed("s/ab/X/g", "ababab"))
print(sed("s/é/e/g", "café é"))
print(sed("s/2/two/", 12))
