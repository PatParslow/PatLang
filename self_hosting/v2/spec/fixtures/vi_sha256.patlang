# modular_integers.feature: SHA-256 (FIPS 180-4) on 32-bit words, each a modint
# modulo 2^32 (spec 1.14), printing the digests of the standard's examples.

make a function called sha256_word takes x returns w
  require (type_of(x) == "int") and (x >= 0)
  let w = mod_make(x, 4294967296)
  ensure mod_modulus(w) == 4294967296
  return w
end

make a function called sha256_k returns ks
  let ks = [1116352408, 1899447441, 3049323471, 3921009573, 961987163, 1508970993, 2453635748, 2870763221, 3624381080, 310598401, 607225278, 1426881987, 1925078388, 2162078206, 2614888103, 3248222580, 3835390401, 4022224774, 264347078, 604807628, 770255983, 1249150122, 1555081692, 1996064986, 2554220882, 2821834349, 2952996808, 3210313671, 3336571891, 3584528711, 113926993, 338241895, 666307205, 773529912, 1294757372, 1396182291, 1695183700, 1986661051, 2177026350, 2456956037, 2730485921, 2820302411, 3259730800, 3345764771, 3516065817, 3600352804, 4094571909, 275423344, 430227734, 506948616, 659060556, 883997877, 958139571, 1322822218, 1537002063, 1747873779, 1955562222, 2024104815, 2227730452, 2361852424, 2428436474, 2756734187, 3204031479, 3329325298]
  ensure list_len(ks) == 64
  return ks
end

# The message's bytes, padded to a whole number of 64-byte blocks.
make a function called sha256_pad takes bytes returns padded
  require type_of(bytes) == "list"
  let n = list_len(bytes)
  let padded = vec_new()
  let i = 0
  while i < n do
    vec_push(padded, bytes[i])
    let i = i + 1
  end
  vec_push(padded, 128)
  while vec_len(padded) % 64 != 56 do
    vec_push(padded, 0)
  end
  let bits = n * 8
  let shift = 56
  while shift >= 0 do
    vec_push(padded, (bits shr shift) band 255)
    let shift = shift - 8
  end
  ensure vec_len(padded) % 64 == 0
  return padded
end

make a function called sha256_hex8 takes w returns text
  require type_of(w) == "modint"
  let digits = "0123456789abcdef"
  let v = mod_value(w)
  let b = sb_new()
  let shift = 28
  while shift >= 0 do
    sb_push(b, digits[(v shr shift) band 15])
    let shift = shift - 4
  end
  let text = sb_str(b)
  ensure str_len(text) == 8
  return text
end

make a function called sha256_bytes takes bytes returns digest
  require type_of(bytes) == "list"
  let ks = sha256_k()
  let h = [1779033703, 3144134277, 1013904242, 2773480762, 1359893119, 2600822924, 528734635, 1541459225]
  let hw = []
  let i = 0
  while i < 8 do
    let hw = list_push(hw, sha256_word(h[i]))
    let i = i + 1
  end
  let padded = sha256_pad(bytes)
  let block = 0
  while block < vec_len(padded) do
    let w = vec_new()
    let t = 0
    while t < 16 do
      let at = block + 4 * t
      vec_push(w, sha256_word(vec_get(padded, at) * 16777216 + vec_get(padded, at + 1) * 65536 + vec_get(padded, at + 2) * 256 + vec_get(padded, at + 3)))
      let t = t + 1
    end
    while t < 64 do
      let x = vec_get(w, t - 15)
      let y = vec_get(w, t - 2)
      let s0 = rotr(x, 7) bxor rotr(x, 18) bxor (x shr 3)
      let s1 = rotr(y, 17) bxor rotr(y, 19) bxor (y shr 10)
      vec_push(w, vec_get(w, t - 16) + s0 + vec_get(w, t - 7) + s1)
      let t = t + 1
    end
    let a = hw[0]
    let b = hw[1]
    let c = hw[2]
    let d = hw[3]
    let e = hw[4]
    let f = hw[5]
    let g = hw[6]
    let hh = hw[7]
    let t = 0
    while t < 64 do
      let big1 = rotr(e, 6) bxor rotr(e, 11) bxor rotr(e, 25)
      let ch = (e band f) bxor ((bnot e) band g)
      let t1 = hh + big1 + ch + ks[t] + vec_get(w, t)
      let big0 = rotr(a, 2) bxor rotr(a, 13) bxor rotr(a, 22)
      let maj = (a band b) bxor (a band c) bxor (b band c)
      let t2 = big0 + maj
      let hh = g
      let g = f
      let f = e
      let e = d + t1
      let d = c
      let c = b
      let b = a
      let a = t1 + t2
      let t = t + 1
    end
    let hw = [hw[0] + a, hw[1] + b, hw[2] + c, hw[3] + d, hw[4] + e, hw[5] + f, hw[6] + g, hw[7] + hh]
    let block = block + 64
  end
  let out = sb_new()
  let i = 0
  while i < 8 do
    sb_push(out, sha256_hex8(hw[i]))
    let i = i + 1
  end
  let digest = sb_str(out)
  ensure str_len(digest) == 64
  return digest
end

make a function called sha256_text takes text returns digest
  require type_of(text) == "string"
  let bytes = []
  let i = 0
  while i < str_len(text) do
    let bytes = list_push(bytes, char_code(text, i))
    let i = i + 1
  end
  let digest = sha256_bytes(bytes)
  ensure str_len(digest) == 64
  return digest
end

print(sha256_text("abc"))
print(sha256_text(""))
print(sha256_text("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"))
print(sha256_text("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu"))
