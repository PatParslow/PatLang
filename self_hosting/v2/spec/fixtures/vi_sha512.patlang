# curve25519.feature: SHA-512 (FIPS 180-4) on 64-bit words, each a modint
# modulo 2^64 (spec 1.14), printing the digests of the standard's examples.
include "../../../../packages/curve25519/curve25519.patlang"

make a function called vi_text_bytes takes text returns bytes
  require type_of(text) == "string"
  let bytes = []
  let i = 0
  while i < str_len(text) do
    let bytes = list_push(bytes, cv_byte(char_code(text, i)))
    let i = i + 1
  end
  ensure list_len(bytes) == str_len(text)
  return bytes
end

print(cv_hex(sha512(vi_text_bytes("abc"))))
print(cv_hex(sha512(vi_text_bytes(""))))
print(cv_hex(sha512(vi_text_bytes("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu"))))
