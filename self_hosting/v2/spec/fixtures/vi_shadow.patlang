# A program's function may have a name the runtime has: the program's calls reach
# it, and the runtime goes on using its own (spec 1.13).
make a function called to_s takes x returns r
  return "mine"
end
make a function called list_len takes x returns r
  return 99
end
make a function called emit takes e returns r
  return "my emit " + e
end
print(to_s(5))
print(5)
print(list_len([1]))
print([1, 2].length)
print(emit("x"))
print("joined " + 7)
let f = |x| {
  return to_s(x)
}
print(f(1))
print(apply("to_s", 5))
