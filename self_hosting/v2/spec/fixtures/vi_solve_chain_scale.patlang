# spec 1.13: following a chain of facts takes time growing as its length: a
# goal whose first argument is bound looks only at the facts with that first
# argument, and a look-up of a variable stops at the bindings older than it.
# It prints true when reaching the end of a chain of 1000 facts takes no more
# than about eight times as long as one of 250: linear four, quadratic (as it
# once was) sixteen.
make a function called chain_time takes tag, n returns cost
  let i = 0
  while i < n do
    rule_add(tag + "_next", ["n" + i, "n" + (i + 1)], [])
    let i = i + 1
  end
  rule_add(tag + "_reach", [logic_var("A"), logic_var("B")], [[tag + "_next", [logic_var("A"), logic_var("B")]]])
  rule_add(tag + "_reach", [logic_var("A"), logic_var("C")], [[tag + "_next", [logic_var("A"), logic_var("B")]], [tag + "_reach", [logic_var("B"), logic_var("C")]]])
  let t0 = cpu_cycles()
  if list_len(solve(tag + "_reach", ["n0", "n" + n])) != 1 then
    print("wrong answer for " + tag)
  end
  return cpu_cycles() - t0
end

let small = chain_time("a", 250)
let large = chain_time("b", 1000)
print(large <= 8 * small + 150000000)
