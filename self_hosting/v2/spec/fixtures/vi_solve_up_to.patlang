# spec 1.13: solve_up_to(pred, args, n) gives the first n of the solutions
# solve gives, in the same order, and stops searching once it has them;
# solve_up_to_in does the same against a store or a list of stores.
# - the first 3 of 4000 facts, and the same as solve's first 3
# - a fact asked for by its value: one solution; a missing one: none; n = 0: none
# - the first 2 of a pair rule over 4000 facts (16 million in all, too many
#   for solve to list)
# - a store's own solutions through solve_up_to_in
# - time: one solution from 4000 facts takes about as long as from 1000, and a
#   rule whose body has 800 goals takes no more than about three times as long
#   as one with 400 (copying the rest of the body at each goal made it four).
make a function called items takes tag, n returns done
  let i = 0
  while i < n do
    rule_add(tag, ["k" + i], [])
    let i = i + 1
  end
  return true
end

make a function called long_body takes tag, n returns ms
  let body = []
  let i = 0
  while i < n do
    let body = list_push(body, [tag + "_item", [logic_var("X" + i)]])
    let i = i + 1
  end
  rule_add(tag + "_item", ["only"], [])
  rule_add(tag + "_all", [logic_var("X0")], body)
  let t0 = clock_ms()
  let found = solve_up_to(tag + "_all", [logic_var("Y")], 1)
  if found != [["only"]] then
    print("wrong answer for " + tag)
  end
  return clock_ms() - t0
end

make a function called first_of takes tag, n returns ms
  items(tag, n)
  let t0 = clock_ms()
  let k = 0
  while k < 200 do
    solve_up_to(tag, [logic_var("X")], 1)
    let k = k + 1
  end
  return clock_ms() - t0
end

items("item", 4000)
let x = logic_var("X")
let three = solve_up_to("item", [x], 3)
print(three)
let all = solve("item", [x])
print(three == [all[0], all[1], all[2]])
print(list_len(solve_up_to("item", ["k5"], 1)))
print(list_len(solve_up_to("item", ["none"], 1)))
print(list_len(solve_up_to("item", [x], 0)))
rule_add("pair", [logic_var("A"), logic_var("B")], [["item", [logic_var("A")]], ["item", [logic_var("B")]]])
print(solve_up_to("pair", [logic_var("P"), logic_var("Q")], 2))
let st = logic_store_new()
rule_add_to(st, "colour", ["red"], [])
rule_add_to(st, "colour", ["green"], [])
print(solve_up_to_in(st, "colour", [x], 5))
let few = first_of("few", 1000)
let many = first_of("many", 4000)
print(many <= 2 * few + 50)
let short = long_body("s", 400)
let long = long_body("l", 800)
print(long <= 3 * short + 50)
