# A characterisation test (review, smaller gaps): functions no fixture, step
# file or selftest called, each giving what it gives today (spec 1.5, 1.10,
# 1.13).
# - bool_array_get and bool_array_set read and write one element
# - sb_len is how many bytes a string builder holds
# - fact_in and query_in add and count facts in one store, not the default one
# - plan_with_state_in plans from a store's facts and gives the state reached
# - rules_clear_in empties the store it is given, and only that one
let a = bool_array_new(70)
bool_array_set(a, 3, true)
bool_array_set(a, 69, true)
print([bool_array_get(a, 3), bool_array_get(a, 4), bool_array_get(a, 69)])

let b = sb_new()
sb_push(b, "caf" + chr(233))
print(sb_len(b))

let st = logic_store_new()
fact_in(st, "likes", "ann", "tea")
fact_in(st, "likes", "ann", "toast")
print([query_in(st, "likes", "ann", "_"), query("likes", "ann", "_")])

rule_add_to(st, "have", ["flour"], [])
action_add("bake", [["have", ["flour"]]], [["have", ["bread"]]], [], 1)
let r = plan_with_state_in(st, [["have", ["bread"]]])
print(plan_labels(r[0]))
print(list_len(r[1]))

rule_add("kept", ["yes"], [])
rules_clear_in(st)
print([query_in(st, "likes", "ann", "_"), list_len(solve("kept", [logic_var("X")]))])
