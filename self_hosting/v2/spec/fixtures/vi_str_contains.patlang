# text.feature, spec 1.10: str_contains says whether text holds a needle, for
# text of any characters, in time that grows with the text.
print(str_contains("hello world", "o w"))
print(str_contains("hello world", "hello"))
print(str_contains("hello world", "world"))
print(str_contains("hello world", "worlds"))
print(str_contains("héllo—wörld", "—wö"))
print(str_contains("héllo—wörld", "wo"))
print(str_contains("abc", ""))
print(str_contains("", "a"))
print(str_contains("ab", "abc"))
