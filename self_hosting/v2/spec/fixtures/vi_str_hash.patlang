# spec 1.10: str_hash(s) is a non-negative int from s's UTF-8 bytes (FNV-1a,
# 62 bits): equal strings hash equal, on every engine, and a program
# hashes a name without walking it character by character.
# - "" and "a" hash to FNV-1a's offset basis and its step for one byte
# - two strings built differently but equal hash equal
# - a non-ASCII string hashes by its bytes
# - 1000 different names hash to 1000 different values
make a function called in_list takes items, x returns yes
  let i = 0
  while i < list_len(items) do
    if items[i] == x then
      return true
    end
    let i = i + 1
  end
  return false
end

print(str_hash(""))
print(str_hash("a"))
print(str_hash("abc") == str_hash("ab" + "c"))
print(str_hash("caf" + chr(233)))
print(str_hash("x") >= 0)
let seen = []
let i = 0
while i < 1000 do
  let seen = list_push(seen, str_hash("name_" + i))
  let i = i + 1
end
let distinct = 0
let buckets = vec_new()
let i = 0
while i < 4096 do
  vec_push(buckets, [])
  let i = i + 1
end
let i = 0
while i < 1000 do
  let h = seen[i]
  let b = h % 4096
  if not in_list(vec_get(buckets, b), h) then
    vec_set(buckets, b, list_push(vec_get(buckets, b), h))
    let distinct = distinct + 1
  end
  let i = i + 1
end
print(distinct)

