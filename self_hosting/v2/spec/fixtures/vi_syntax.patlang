# engines_agree.feature: a `syntax` definition expands where its trigger
# appears, before the program is parsed.
syntax RouterDSL {
    trigger: Keyword("routes");
    tokens {
        HttpVerb(verb) = regex("\b(GET|POST)\b", verb);
        UrlPath(path) = regex("/[a-zA-Z0-9_/:-]*", path);
        Arrow = "->";
    }
    rule RouteLine {
        let verb = expect HttpVerb;
        let path = expect UrlPath;
        expect Arrow;
        let action = expect Identifier;
        return register_route(verb, path, action);
    }
}

make a function called register_route takes verb, path, action returns r
  print(verb + " " + path + " " + action)
  return 0
end

routes {
    GET /users -> index
    POST /users/new -> create
}
print("after")
