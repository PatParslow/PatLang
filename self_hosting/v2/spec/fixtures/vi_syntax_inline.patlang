# programs.feature, spec 1.9: a syntax definition may stand anywhere a statement
# may, not only at the start of a line.
print("before"); syntax WaveDSL { trigger: Keyword("waves"); tokens { Name(who) = regex("[a-z]+", who); } rule WaveLine { let who = expect Name; return print("wave to " + who); } }
waves {
  ada
}
