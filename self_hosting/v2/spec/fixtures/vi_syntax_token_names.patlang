# Given a syntax definition whose tokens are named Symbol, Symbols and
# Manyfold, and whose rule also uses the built-in step Symbol("=>"),
# when a block in it runs,
# then each bare name is the token declared with it, and Symbol("=>") still
# matches the literal text: the lines give [*, 2, op_mul] and [/, 3, op_div].

syntax OperatorTable {
    trigger: Keyword("operators");
    tokens {
        Symbol(s) = regex("[-+*/%^]", s);
        Symbols(n) = regex("[0-9]+", n);
        Manyfold(f) = regex("[a-z_]+", f);
    }
    rule OperatorLine {
        let sym = expect Symbol;
        let level = expect Symbols;
        expect Symbol("=>");
        let name = expect Manyfold;
        return rule_add("operator", [sym, to_num(level), name], []);
    }
}

operators {
    * 2 => op_mul
    / 3 => op_div
}

print(solve("operator", [logic_var("S"), logic_var("L"), logic_var("F")]))
