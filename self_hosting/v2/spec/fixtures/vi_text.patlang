# text.feature: a program sees characters, whatever bytes they take.
let s = "héllo→😀"
print(s)
print(s.length)
print(s[1])
print(char_code(s, 1))
print(char_code(s, 5))
print(char_code(s, 6))
print(char_code(s, 7))
print(chr(233))
print(chr(233).length)
print(chr(8594))
print(chr(128512))
print(byte_length(chr(233)))
print(byte_length(s))
print(substr(s, 1, 3))
print(substr(s, 5, 9))
print(s + chr(8594))
print(("é" + "x").length)
write_file("self_hosting/build/vi_text.txt", s)
print(read_file("self_hosting/build/vi_text.txt") == s)
print(s == "héllo→😀")
let h = str_intern(s)
print(sc_len(h))
print(sc_code(h, 1))
print(sc_char(h, 5))
print(sc_substr(h, 1, 2))
print(hash_string(s))
