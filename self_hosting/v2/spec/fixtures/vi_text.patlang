# text.feature: a program sees characters, whatever bytes they take.
let s = "héllo→😀"
print(s)
print(s.length)
print(s[1])
print(char_code(s, 1))
print(char_code(s, 5))
print(char_code(s, 6))
print(char_code(s, 7))
print(chr(233))
print(chr(233).length)
print(chr(8594))
print(chr(128512))
print(byte_length(chr(233)))
print(byte_length(s))
print(substr(s, 1, 3))
print(substr(s, 5, 9))
print(s + chr(8594))
print(("é" + "x").length)
write_file(scratch_path("vi_text.txt"), s)
print(read_file(scratch_path("vi_text.txt")) == s)
print(s == "héllo→😀")
let h = str_intern(s)
print(sc_len(h))
print(sc_code(h, 1))
print(sc_char(h, 5))
print(sc_substr(h, 1, 2))
print(hash_string(s))

# Where this run writes its scratch files: PATLANG_SPEC_OUT, a directory of
# the run's own (docs/plans/gates.md), else self_hosting/build.
make a function called scratch_path takes name returns path
  let dir = "" + getenv("PATLANG_SPEC_OUT")
  if dir == "" then
    let dir = "self_hosting/build"
  end
  return dir + "/" + name
end
