# concurrency.feature: thread_spawn calls its closure with the arguments
# that follow it (spec 1.8).
let add = |a, b| { return a + b }
print(thread_result(thread_spawn(add, 2, 3)))
print(thread_result(thread_spawn(|| { return 7 })))
print(thread_result(thread_spawn(|xs| { return list_len(xs) }, [1, 2, 3])))
