# engines_agree.feature: thread_spawn runs a closure on a thread of its own;
# thread_poll says whether it has finished, thread_result gives what it returned.
make a function called sum_to takes n returns total
  let total = 0
  let i = 1
  while i <= n do
    let total = total + i
    let i = i + 1
  end
  return total
end

make a function called wait_for takes id returns r
  while not thread_poll(id) do
    sleep_ms(1)
  end
  return thread_result(id)
end

let n = 1000
let a = thread_spawn(|| { return sum_to(n) })
let b = thread_spawn(|| { return "text " + n })
let c = thread_spawn(|| { return [n, n + 1] })
print(wait_for(a))
print(wait_for(b))
print(wait_for(c))

let ids = []
let k = 0
while k < 8 do
  let m = k
  let ids = list_push(ids, thread_spawn(|| { return sum_to(m * 1000) }))
  let k = k + 1
end
let k = 0
while k < 8 do
  print(wait_for(ids[k]))
  let k = k + 1
end
