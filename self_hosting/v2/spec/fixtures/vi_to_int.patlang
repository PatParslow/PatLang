# math.feature: to_int gives the int a whole number is (spec 1.11): an int or a
# bigint as it is, a whole float as its int, a bigint when it is 2^63 or more.
print(to_int(7))
print(type_of(to_int(7)))
print(to_int(floor(2.75)))
print(type_of(to_int(floor(2.75))))
print(to_int(-3.0))
print(to_int(0.0))
print(to_int(-0.0))
print(to_int(4611686018427387904.0))
print(to_int(9223372036854775808.0))
print(type_of(to_int(9223372036854775808.0)))
print(to_int(-9223372036854775808.0))
print(type_of(to_int(-9223372036854775808.0)))
print(to_int(1e20))
print(to_int(pow(2, 70)))
print([10, 20, 30][to_int(floor(1.5))])
