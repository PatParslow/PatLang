# spec 1.11: to_num reads back every exact number as it prints.
# Given the texts of fractions (as a rational prints: digits, "/", digits,
# with an optional sign), when to_num reads each, then it gives the rational
# in lowest terms, or the int when it divides evenly; a printed sum reads
# back as itself; a bigint numerator stays exact. A zero denominator spells
# no number, and gives 0.0 as other such text does.
print([to_num("101/4"), type_of(to_num("101/4"))])
print([to_num("-3/4"), to_num("+5/3"), to_num(" 7/9 ")])
print([to_num("6/4"), to_num("4/2"), type_of(to_num("4/2"))])
let s = 1 / 3 + 1 / 6
print(to_num("" + s) == s)
let big = to_num("123456789012345678901234567890/4")
print([big, type_of(big), big * 4 == 123456789012345678901234567890])
print([to_num("1/0"), type_of(to_num("1/0")), to_num("1/"), to_num("/2")])
