# spec 1.8: trust_roots() gives the system's trusted root certificates, each
# a bytes holding one DER certificate (Windows: the ROOT store; Linux: the
# PEM bundle at /etc/ssl/certs/ca-certificates.crt or the like), [] where the
# host has none (a browser). On a Windows or Linux build: a list, more than
# ten roots, and each a DER SEQUENCE whose length takes the whole bytes.
let roots = trust_roots()
print(type_of(roots))
print(list_len(roots) > 10)
let all = true
let i = 0
while i < list_len(roots) do
  let r = roots[i]
  if (type_of(r) != "bytes") or (bytes_len(r) < 4) or (bytes_get(r, 0) != 48) then
    let all = false
  elif bytes_get(r, 1) == 130 then
    # a two-byte length: the SEQUENCE is 4 + that many bytes
    if bytes_len(r) != 4 + bytes_get(r, 2) * 256 + bytes_get(r, 3) then
      let all = false
    end
  end
  let i = i + 1
end
print(all)
