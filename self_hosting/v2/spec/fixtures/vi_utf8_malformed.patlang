# spec 1.10: text from outside holds whatever bytes arrived. A byte that does
# not start a well-formed UTF-8 sequence within the string is a character of
# its own, U+FFFD (65533), and nothing reads past the string's end. The bytes
# are kept as they came.
make a function called from_bytes takes bytes returns s
  write_file_bytes("self_hosting/build/v2_vi_utf8.bin", bytes)
  return read_file("self_hosting/build/v2_vi_utf8.bin")
end

make a function called codes takes s returns out
  let out = []
  let i = 0
  while i < s.length do
    let out = list_push(out, char_code(s, i))
    let i = i + 1
  end
  return out
end

make a function called show takes label, bytes returns done
  let s = from_bytes(bytes)
  print(label + ": " + s.length + " " + codes(s) + " " + char_code(s, s.length) + " " + byte_length(s))
  return true
end

show("cut short at the end", [97, 240])
show("three-byte cut short", [226, 130])
show("overlong slash", [192, 175])
show("stray continuation", [97, 128, 98])
show("surrogate", [237, 160, 128])
show("past U+10FFFF", [244, 144, 128, 128])
show("well formed", [195, 169, 240, 159, 152, 128])
let s = from_bytes([97, 240])
print("substr past the end: " + substr(s, 1, 5).length + " " + char_code(substr(s, 1, 5), 0))
let h = str_intern(from_bytes([97, 128, 98]))
print("cursor: " + sc_code(h, 0) + " " + sc_code(h, 1) + " " + sc_code(h, 2))
print("bytes kept: " + (read_file_bytes("self_hosting/build/v2_vi_utf8.bin", 0, 10) == [97, 128, 98]))
remove_file("self_hosting/build/v2_vi_utf8.bin")
