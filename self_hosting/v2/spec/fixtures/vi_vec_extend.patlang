# spec_library/values_and_memory, spec 1.5: vec_extend appends a list's
# elements in order, in place; a list taken from the vec before is a value
# and stays as it was; a vec extended with its own contents doubles.
let v = vec_new()
vec_push(v, 1)
let before = vec_to_list(v)
vec_extend(v, [2, "three", [4]])
vec_extend(v, [])
let own = vec_to_list(v)
vec_extend(v, own)
let big = []
let i = 0
while i < 10000 do
  let big = list_push(big, i)
  let i = i + 1
end
let w = vec_new()
vec_extend(w, big)
vec_extend(w, big)
print(before == [1])
print(vec_to_list(v) == [1, 2, "three", [4], 1, 2, "three", [4]])
print(own == [1, 2, "three", [4]])
print((vec_len(w) == 20000) and (vec_get(w, 19999) == 9999) and (vec_get(w, 10000) == 0) and (list_len(big) == 10000))
