# vfs_exists gives a bool (spec 1.13), so a condition on it takes the branch it
# says: a missing file's is the false one.
if vfs_exists("/nope") then
  print("a missing file is there")
else
  print("a missing file is not there")
end
vfs_write("/here", "x")
if vfs_exists("/here") then
  print("a written file is there")
else
  print("a written file is not there")
end
print(vfs_exists("/nope"))
print(vfs_exists("/here"))
print(type_of(vfs_exists("/here")))
vfs_delete("/here")
print(vfs_exists("/here"))
