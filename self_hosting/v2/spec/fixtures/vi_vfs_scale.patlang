# spec 1.13: the virtual files' work grows with what each call needs. It
# prints three lines, each true when its claim holds: four times the files
# written take no more than about eight times as long (linear four, quadratic
# sixteen), as do four times the reads, and four times the appends to one file
# (an append copies nothing the file holds). Each count is the cheapest of
# several readings after a warm-up (lib/cost_check.patlang, #284); each
# reading of writes and appends uses files of its own.
include "../../../lib/cost_check.patlang"

make a function called writes takes tag, n returns cost
  let t0 = cpu_cycles()
  let i = 0
  while i < n do
    vfs_write(tag + "/file" + i, "contents " + i)
    let i = i + 1
  end
  return cpu_cycles() - t0
end

make a function called reads takes tag, n returns cost
  let t0 = cpu_cycles()
  let i = 0
  while i < n do
    vfs_read(tag + "/file" + i)
    let i = i + 1
  end
  return cpu_cycles() - t0
end

make a function called appends takes path, n returns cost
  let t0 = cpu_cycles()
  let i = 0
  while i < n do
    vfs_append(path, "0123456789abcdef")
    let i = i + 1
  end
  return cpu_cycles() - t0
end

let fresh = vec_new()
let write_small = || do
  vec_push(fresh, 1)
  return writes("a" + vec_len(fresh), 4000)
end
let write_large = || do
  vec_push(fresh, 1)
  return writes("b" + vec_len(fresh), 16000)
end
let best = cheapest_cycles([write_small, write_large], cost_rounds())
print(best[1] <= 8 * best[0] + 150000000)
writes("a", 4000)
writes("b", 16000)
let best = cheapest_cycles([|| do return reads("a", 4000) end, || do return reads("b", 16000) end], cost_rounds())
print(best[1] <= 8 * best[0] + 150000000)
let append_small = || do
  vec_push(fresh, 1)
  return appends("log_a" + vec_len(fresh), 4000)
end
let append_large = || do
  vec_push(fresh, 1)
  return appends("log_b" + vec_len(fresh), 16000)
end
let best = cheapest_cycles([append_small, append_large], cost_rounds())
print(best[1] <= 8 * best[0] + 150000000)
