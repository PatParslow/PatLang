# spec 1.13: the virtual files' work grows with what each call needs. It
# prints three lines, each true when its claim holds: twice the files written
# take no more than about three times as long, as do twice the reads, and
# twice the appends to one file (an append copies nothing the file holds).
make a function called writes takes tag, n returns ms
  let t0 = clock_ms()
  let i = 0
  while i < n do
    vfs_write(tag + "/file" + i, "contents " + i)
    let i = i + 1
  end
  return clock_ms() - t0
end

make a function called reads takes tag, n returns ms
  let t0 = clock_ms()
  let i = 0
  while i < n do
    vfs_read(tag + "/file" + i)
    let i = i + 1
  end
  return clock_ms() - t0
end

make a function called appends takes path, n returns ms
  let t0 = clock_ms()
  let i = 0
  while i < n do
    vfs_append(path, "0123456789abcdef")
    let i = i + 1
  end
  return clock_ms() - t0
end

let small = writes("a", 8000)
let large = writes("b", 16000)
print(large <= 3 * small + 50)
let small = reads("a", 8000)
let large = reads("b", 16000)
print(large <= 3 * small + 50)
let small = appends("log_a", 8000)
let large = appends("log_b", 16000)
print(large <= 3 * small + 50)
