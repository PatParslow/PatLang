# curve25519.feature: X25519 written in PatLang against every case of
# Wycheproof's x25519_test.json, each shared secret as the case gives it.
include "../../../../packages/curve25519/curve25519.patlang"
include "cv_vectors.patlang"

let rows = cv_wy_x25519()
let agree = 0
let i = 0
while i < list_len(rows) do
  let row = rows[i]
  if cv_hex(x25519(cv_hex_bytes(row[1]), cv_hex_bytes(row[2]))) == row[3] then
    let agree = agree + 1
  else
    print("case " + to_s(row[0]) + " differs")
  end
  let i = i + 1
end
print("X25519 Wycheproof: " + to_s(agree) + " of " + to_s(list_len(rows)) + " shared secrets agree")
