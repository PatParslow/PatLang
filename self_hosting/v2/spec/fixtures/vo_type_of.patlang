# spec_library/values_and_memory, spec 1.1: type_of names the class of every kind of value
let f = |x| { return x + 1 }
let u = print("-")
print(type_of(7))
print(type_of(1180591620717411303424))
print(type_of(1.5))
print(type_of(6 / 4))
print(type_of(true))
print(type_of(u))
print(type_of("hi"))
print(type_of([1, 2]))
print(type_of(f))
print(type_of(sb_new()))
print(type_of(vec_new()))
print(type_of(bool_array_new(3)))
