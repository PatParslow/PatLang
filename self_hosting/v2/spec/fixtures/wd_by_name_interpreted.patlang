# worlds.feature, spec 1.15: a program that asks for every runtime function by
# name, as one that runs source in a world through v2/interpreter.patlang does,
# runs the same interpreted as compiled: the interpreter's runtime functions are
# its own, whatever the program registers under their names. Asking for the
# runtime by name is an engine's, so like the interpreter it is a quiet file.
quiet_operators()
runtime_functions_by_name()
print("a runtime function called directly")
print(apply("list_len", [1, 2, 3]))
let w = world_new()
print(world_call(w, || { return apply("list_len", [4, 5]) }))
world_free(w)
