# worlds.feature, spec 1.15: a fiber runs in the world it was made in, whoever
# resumes it.
make a function called sees takes x returns r
  return [query("place", "made", 0), query("place", "world", 0)]
end

fact("place", "made", "program")
let mine = fiber_new("sees")
let w = world_new()
let theirs = world_call(w, || {
  fact("place", "world", "yes")
  return fiber_new("sees")
})[1]
print(fiber_resume(theirs, 0))
print(world_call(w, || { return fiber_resume(mine, 0) }))
world_free(w)
