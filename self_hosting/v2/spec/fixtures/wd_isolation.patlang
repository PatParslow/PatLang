# worlds.feature, spec 1.15: code in a world sees the world's state and none of
# the caller's, and the caller sees none of the world's.
make a function called mine takes x returns r
  return "the program's " + x
end

let log = vec_new()
when ping do
  vec_push(log, "the program's handler")
end
fact("color", "sky", "blue")
new("Widget", "w1")
class_define("Point", "", [["x", 1]], [], [], [])
vfs_write("/a", "the program's file")
print(apply("mine", "function"))

let w = world_new()
let first = world_call(w, || {
  let seen = [query("color", "sky", 0), get("w1", "type"), get(new("Point"), "x"), vfs_exists("/a")]
  emit("ping", 0)
  fact("color", "grass", "green")
  new("Widget", "w2")
  class_define("Line", "", [["n", 2]], [], [], [])
  vfs_write("/b", "the world's file")
  when ping do
    print("the world's handler")
  end
  return seen
})
print(first)
print([query("color", "grass", 0), get("w2", "type"), get(new("Line"), "n"), vfs_exists("/b")])
emit("ping", 0)
print(vec_to_list(log))
let second = world_call(w, || {
  emit("ping", 0)
  return [query("color", "grass", 0), get("w2", "type"), get(new("Line"), "n"), vfs_read("/b")]
})
print(second)
print(world_call(w, || { return apply("mine", "function") })[1])
print(world_output(w))
world_free(w)
