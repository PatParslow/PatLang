# worlds.feature, spec 1.15: worlds nest, each with its own state.
fact("in", "program", "yes")
let outer = world_new()
let r = world_call(outer, || {
  fact("in", "outer", "yes")
  let inner = world_new()
  let got = world_call(inner, || {
    fact("in", "inner", "yes")
    print("inner prints")
    return [query("in", "program", 0), query("in", "outer", 0), query("in", "inner", 0)]
  })
  let out = world_output(inner)
  world_free(inner)
  print("outer prints")
  return [got, [query("in", "program", 0), query("in", "outer", 0), query("in", "inner", 0)], out]
})
print(r)
print([query("in", "program", 0), query("in", "outer", 0), query("in", "inner", 0)])
print(world_output(outer))
world_free(outer)
