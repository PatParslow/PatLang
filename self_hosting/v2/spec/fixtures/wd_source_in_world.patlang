# compiler_structure.feature, spec 1.15 and docs/spec/ir.md ("The WASM host"): a program's
# text, with an include, compiled by the front end and run in a world of its
# own by lib/interp_run.patlang's world backend. In a browser the runtime's
# files and the include are read from the files the page was given.
include "../../../lib/interp_run.patlang"

let ctx = context_new()
let src = "include \"lib/pset.patlang\"" + chr(10) + "let s = pset_add(pset_add(pset_new(), \"a\"), \"b\")" + chr(10) + "print(pset_size(s))" + chr(10) + "print(\"from the world\")" + chr(10)
let r = interp_run(ctx, src, [["backend", "world"], ["base_dir", "self_hosting"]])
print(r)
let bad = interp_run(ctx, "print(no_such_function(1))", [["backend", "world"]])
print(bad)
print("the program goes on")
