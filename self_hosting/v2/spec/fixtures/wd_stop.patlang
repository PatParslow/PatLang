# worlds.feature, spec 1.15: a stop in a world ends the call and not the program.
make a function called halve takes n returns r
  require n % 2 == 0
  return n / 2
end

let a = world_new()
print(world_call(a, || {
  print("a runs")
  return halve(3)
}))
let b = world_new()
print(world_call(b, || {
  print("b runs")
  exit_with(5)
  return "not reached"
}))
let c = world_new()
print(world_call(c, || {
  print("c runs")
  return no_such_function(1)
}))
print("the program goes on")
print(world_output(a))
print(world_output(b))
print(world_output(c))
world_free(a)
world_free(b)
world_free(c)
