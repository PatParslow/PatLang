# worlds.feature, spec 1.15: a thread runs in the world of the code that
# started it.
let w = world_new()
let r = world_call(w, || {
  fact("seen", "by", "thread")
  let t = thread_spawn(|| { return query("seen", "by", 0) })
  return thread_result(t)
})
print(r)
print(query("seen", "by", 0))
world_free(w)
