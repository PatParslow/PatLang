# worlds.feature, spec 1.15: a thread a stop in a world ends has finished, so
# thread_poll says so, and its result is unit.
let w = world_new()
let r = world_call(w, || {
  let t = thread_spawn(|| {
    exit_with(9)
    return "not reached"
  })
  let waited = 0
  while (not thread_poll(t)) and (waited < 200) do
    sleep_ms(10)
    let waited = waited + 1
  end
  print(thread_poll(t))
  print(type_of(thread_result(t)))
  return "the call returns"
})
print(r)
print(world_output(w))
world_free(w)
