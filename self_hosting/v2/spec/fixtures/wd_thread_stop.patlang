# worlds.feature, spec 1.15: a stop on a thread started in a world ends the
# thread, and world_call gives stopped when its closure returns.
let w = world_new()
let r = world_call(w, || {
  let t = thread_spawn(|| {
    print("thread runs")
    exit_with(9)
    return "not reached"
  })
  let got = thread_result(t)
  print("the call goes on after the thread")
  return got
})
print(r)
print(world_output(w))
print("the program goes on")
world_free(w)
