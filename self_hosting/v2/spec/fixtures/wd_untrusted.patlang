# spec 1.15 (review, smaller gaps: a world given untrusted text): a world
# isolates state, not authority. Text run in a world is a program like any
# other: the runtime's own primitives (mem_store, runtime_state) are refused it
# as they are any program's file (finding S8), and it can write a file, as the
# program running it can.
include "../../../lib/interp_run.patlang"

let ctx = context_new()
let mem = interp_run(ctx, "mem_store(runtime_state(), 0, 1)" + chr(10) + "print(\"not reached\")", [["backend", "world"]])
print([str_contains(to_s(mem), "for the runtime"), str_contains(to_s(mem), "not reached")])
let path = "self_hosting/build/wd_untrusted_" + str_hash(to_s(random_bytes(8))) + ".txt"
let w = interp_run(ctx, "print(write_file(\"" + path + "\", \"from the world\"))", [["backend", "world"]])
print(read_file(path))
remove_file(path)
print("the program goes on")
