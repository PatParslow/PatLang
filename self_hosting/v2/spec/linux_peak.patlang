# Built with --linux and run under WSL by run_values_and_memory.patlang's
# linux engine: runs the program named by its first argument, with the
# arguments in the file its second names (v2_linux_args_file: each argument's
# bytes as hex, one a line, since wsl.exe would parse them again), prints what
# exec_peak_memory gives for it (its output, then its standard error if it
# exited non-zero), then a last line PEAK=N, its peak resident set in bytes from
# wait4 (runtime/os_linux.patlang).
make a function called lp_hex takes c returns v
  if (c >= 48) and (c <= 57) then
    return c - 48
  end
  return c - 87
end

make a function called lp_args takes path returns args
  let text = read_file(path)
  let args = []
  let line = bytes_new(0)
  let i = 0
  while i < text.length do
    let c = char_code(text, i)
    if c == 10 then
      let args = list_push(args, bytes_to_str(line))
      let line = bytes_new(0)
      let i = i + 1
    else
      bytes_push(line, lp_hex(c) * 16 + lp_hex(char_code(text, i + 1)))
      let i = i + 2
    end
  end
  return args
end

let a = argv()
let rest = []
if list_len(a) > 1 then
  let rest = lp_args(a[1])
end
let r = exec_peak_memory(a[0], rest)
let text = r[0]
if (str_len(text) > 0) and (char_code(text, str_len(text) - 1) != 10) then
  let text = text + chr(10)
end
print(text + "PEAK=" + r[1])
