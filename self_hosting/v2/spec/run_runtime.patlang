# Runs spec_library/values_and_memory's @runtime features
# (docs/spec/values-and-memory.md, Part 2) against v2:
#
#   pat --ir-run self_hosting/v2/spec/run_runtime.patlang
#
# Each scenario's fixture is in self_hosting/v2/spec/fixtures/ (rt_*); a
# scenario about the code itself reads the sources.
include "../../lib/includes.patlang"
include "../../lib/gherkin.patlang"

make a function called rr_pat returns p
  return "rust-runtime/target/release/pat.exe"
end

make a function called rr_exe takes name returns path
  return "self_hosting/build/v2_rt_" + name + ".exe"
end

make a function called rr_clean takes text returns out
  let b = sb_new()
  let i = 0
  while i < text.length do
    let c = char_code(text, i)
    if c != 13 then
      sb_push(b, chr(c))
    end
    let i = i + 1
  end
  return str_trim(sb_str(b))
end

make a function called nl returns s
  return chr(10)
end

# A fixture built with v2 (once per run) and run; its output, or the
# compiler's error.
make a function called rr_run takes ctx, name returns out
  let built = ctx_get(ctx, "rr_built_" + name)
  if type_of(built) != "string" then
    let src = "self_hosting/v2/spec/fixtures/" + name + ".patlang"
    let c = exec_capture(rr_pat(), "--ir-run", "self_hosting/v2/compile.patlang", src, rr_exe(name))
    let built = "build failed: " + rr_clean(c)
    if contains_text(c, "v2: " + rr_exe(name)) then
      let built = ""
    end
    ctx_set(ctx, "rr_built_" + name, built)
  end
  if built != "" then
    return built
  end
  return rr_clean(exec_capture(rr_exe(name)))
end

make a function called rr_expect takes ctx, label, name, expected returns ok
  return expect(ctx, label, rr_run(ctx, name), expected)
end

make a function called st_rr_noop takes ctx returns ok
  return true
end

# The lines of a function in a source file, from its declaration to its
# end, joined (line by line: substr at every position of a large file is
# quadratic under the interpreter).
make a function called rr_function_text takes path, fname returns text
  let lines = split_lines(read_file(path))
  let head = "make a function called " + fname + " "
  let out = []
  let inside = false
  let i = 0
  while i < list_len(lines) do
    let line = lines[i]
    if str_starts_with(line, head) then
      let inside = true
    end
    if inside then
      let out = list_push(out, line)
      if line == "end" then
        return str_join_lines(out)
      end
    end
    let i = i + 1
  end
  return str_join_lines(out)
end

make a function called str_join_lines takes lines returns text
  let b = sb_new()
  let i = 0
  while i < list_len(lines) do
    sb_push(b, lines[i])
    sb_push(b, chr(10))
    let i = i + 1
  end
  return sb_str(b)
end

# The lines of a generated function in an assembly file: from its label to
# the next function's.
make a function called rr_asm_function takes path, sym returns text
  let lines = split_lines(read_file(path))
  let out = []
  let inside = false
  let i = 0
  while i < list_len(lines) do
    let line = lines[i]
    if line == sym + ":" then
      let inside = true
    elif inside and str_starts_with(line, "global f_") then
      return str_join_lines(out)
    end
    if inside then
      let out = list_push(out, line)
    end
    let i = i + 1
  end
  return str_join_lines(out)
end

# The code lines of a file: comments and blank lines left out.
make a function called rr_code_lines takes path returns lines
  let all = split_lines(read_file(path))
  let out = []
  let i = 0
  while i < list_len(all) do
    let t = str_trim(all[i])
    if (t != "") and (not str_starts_with(t, "#")) then
      let out = list_push(out, t)
    end
    let i = i + 1
  end
  return out
end

make a function called rr_any_line_has takes path, needle returns yes
  let lines = rr_code_lines(path)
  let i = 0
  while i < list_len(lines) do
    if contains_text(lines[i], needle) then
      return true
    end
    let i = i + 1
  end
  return false
end

make a function called rr_v2 takes f returns path
  return "self_hosting/v2/" + f
end

# ---- runtime_representation.feature (2.1) ----

make a function called st_rr_int_words takes ctx returns ok
  return rr_expect(ctx, "int's type word is 2 and its data word 2^63 - 1", "rt_int_words", "2" + nl() + "9223372036854775807")
end

make a function called st_rr_float_inline takes ctx returns ok
  return rr_expect(ctx, "a million floats through a list leave the heap where it was", "rt_float_inline", "0" + nl() + "1.5")
end

make a function called st_rr_kinds takes ctx returns ok
  let a = rr_expect(ctx, "string, string, int, float", "rt_kinds", "string" + nl() + "string" + nl() + "int" + nl() + "float")
  # type_of reads the class from the type word and nothing else
  let body = rr_function_text(rr_v2("runtime/strings.patlang"), "type_of")
  let b = expect(ctx, "type_of reads no memory and checks no address range", contains_text(body, "mem_load") or contains_text(body, "runtime_state"), false)
  return a and b
end

make a function called st_rr_list_slots takes ctx returns ok
  return rr_expect(ctx, "1000 elements, element 999 at block + 32 + 16 * 999: type word 2, data 999", "rt_list_slots", "1000" + nl() + "2" + nl() + "999")
end

make a function called st_rr_add_flag takes ctx returns ok
  let out = rr_run(ctx, "rt_add_loop")
  let a = expect(ctx, "the loop's sum", out, "45")
  let fn_text = rr_asm_function(rr_exe("rt_add_loop") + ".asm", "f_sum_to")
  let b = expect(ctx, "the addition is a machine add", contains_text(fn_text, "add rax, rcx"), true)
  let c = expect(ctx, "with no handler anywhere in the program, no flag test", contains_text(fn_text, "2064"), false)
  return a and b and c
end

# ---- ownership.feature (2.2) ----

make a function called st_rr_returns_arg takes ctx returns ok
  return rr_expect(ctx, "the returned string reads ab, its count 1", "rt_returns_arg", "ab" + nl() + "1")
end

make a function called st_rr_copy_local takes ctx returns ok
  return rr_expect(ctx, "t is still ab", "rt_copy_local", "ab")
end

make a function called st_rr_structure_frees takes ctx returns ok
  return rr_expect(ctx, "the string's block heads its class's free list", "rt_structure_frees", "true")
end

make a function called st_rr_overwrite_frees takes ctx returns ok
  return rr_expect(ctx, "the overwritten string's block heads its class's free list", "rt_overwrite_frees", "true")
end

make a function called st_rr_inline_counts takes ctx returns ok
  return rr_expect(ctx, "ints, floats, bools and unit passed and copied: the heap untouched", "rt_inline_counts", "0")
end

# The ownership stage names no function: every string in it is an IR
# instruction's name.
make a function called st_rr_no_name_lists takes ctx returns ok
  let ops = ["const", "call", "op", "un", "prim", "extern", "externf", "list", "closure", "callv", "copy", "take", "return", "retain", "release", "move", "clear", "label", "jump", "branch"]
  let lines = rr_code_lines(rr_v2("own.patlang"))
  let bad = []
  let i = 0
  while i < list_len(lines) do
    let line = lines[i]
    let k = 0
    while k < line.length do
      if char_code(line, k) == 34 then
        let e = k + 1
        while (e < line.length) and (char_code(line, e) != 34) do
          let e = e + 1
        end
        let lit = substr(line, k + 1, e - k - 1)
        if not list_has(ops, lit) then
          let bad = list_push(bad, lit)
        end
        let k = e + 1
      else
        let k = k + 1
      end
    end
    let i = i + 1
  end
  return expect(ctx, "the ownership stage names no function (other strings: " + bad + ")", list_len(bad), 0)
end

make a function called list_has takes items, x returns yes
  let i = 0
  while i < list_len(items) do
    if items[i] == x then
      return true
    end
    let i = i + 1
  end
  return false
end

# ---- memory_manager.feature (2.3) ----

make a function called st_rr_million takes ctx returns ok
  return rr_expect(ctx, "one reservation, one commit", "rt_million_allocs", "1" + nl() + "1")
end

make a function called st_rr_grow takes ctx returns ok
  return rr_expect(ctx, "4000 characters for under 40 bytes each", "rt_grow_string", "4000" + nl() + "true")
end

make a function called st_rr_threads takes ctx returns ok
  return rr_expect(ctx, "8 threads, a million strings each, the pool's lock taken under 1000 times", "rt_threads_no_lock", "[8, 8, 8, 8, 8, 8, 8, 8]" + nl() + "true")
end

make a function called st_rr_cross_thread takes ctx returns ok
  return rr_expect(ctx, "of 2000 blocks freed by the thread that did not make them, at least 1990 reused by it, each pool lock it takes serving at least half a batch", "rt_cross_thread", "true" + nl() + "true")
end

make a function called st_rr_imbalance takes ctx returns ok
  return rr_expect(ctx, "the second fill takes the blocks the other thread handed back", "rt_imbalance", "[200000]" + nl() + "true")
end

make a function called st_rr_memory_stays takes ctx returns ok
  return rr_expect(ctx, "the second fill commits nothing more", "rt_memory_stays", "true" + nl() + "true")
end

# ---- contracts.feature (2.4) ----

make a function called st_rr_contracts_everywhere takes ctx returns ok
  let files = ["core", "memory", "strings", "lists", "integers", "rationals", "floats", "numbers", "closures", "objects", "logic", "vfs", "net", "hosts", "cells", "system", "threads"]
  let total = 0
  let missing = 0
  let f = 0
  while f < list_len(files) do
    let src = split_lines(read_file(rr_v2("runtime/" + files[f] + ".patlang")))
    let i = 0
    let in_fn = false
    let has_req = false
    let has_ens = false
    while i < list_len(src) do
      let t = str_trim(src[i])
      if str_starts_with(t, "make a function called ") then
        let in_fn = true
        # a function with no parameters has nothing to require
        let has_req = not contains_text(t, " takes ")
        let has_ens = false
        let total = total + 1
      elif in_fn and str_starts_with(t, "require ") then
        let has_req = true
      elif in_fn and str_starts_with(t, "ensure ") then
        let has_ens = true
      elif in_fn and (src[i] == "end") then
        if not (has_req and has_ens) then
          let missing = missing + 1
        end
        let in_fn = false
      end
      let i = i + 1
    end
    let f = f + 1
  end
  return expect(ctx, "runtime functions with both require and ensure (" + (total - missing) + " of " + total + ")", missing, 0)
end

make a function called st_rr_contract_fails takes ctx returns ok
  let out = rr_run(ctx, "rt_contract_fails")
  let a = expect(ctx, "it stops at the broken require, naming it", contains_text(out, "contract violation: precondition failed in half(): n > 0"), true)
  let b = expect(ctx, "nothing after it runs", contains_text(out, "not reached"), false)
  return a and b
end

make a function called st_rr_match_no_case takes ctx returns ok
  let out = rr_run(ctx, "rt_match_no_case")
  let a = expect(ctx, "a match no case takes stops the program, naming the function", contains_text(out, "contract violation: assertion failed in pick(): match: no case matched the scrutinee value"), true)
  let b = expect(ctx, "the case that matched ran first", contains_text(out, "one"), true)
  let c = expect(ctx, "nothing after it runs", contains_text(out, "not reached"), false)
  let d = expect(ctx, "its exit code says so", wait(spawn(rr_exe("rt_match_no_case"))) != 0, true)
  return a and b and c and d
end

make a function called st_rr_build_failure takes ctx returns ok
  let exe = rr_exe("rt_compile_error")
  if file_exists(exe) then
    remove_file(exe)
  end
  let src = "self_hosting/v2/spec/fixtures/rt_compile_error.patlang"
  let out = exec_capture(rr_pat(), "--ir-run", "self_hosting/v2/compile.patlang", src, exe)
  let a = expect(ctx, "the compiler prints the error", contains_text(out, "v2 error:"), true)
  let b = expect(ctx, "it exits non-zero", wait(spawn(rr_pat(), "--ir-run", "self_hosting/v2/compile.patlang", src, exe)) != 0, true)
  let c = expect(ctx, "it writes no executable", file_exists(exe), false)
  return a and b and c
end

make a function called st_rr_ownership_contract takes ctx returns ok
  let out = rr_run(ctx, "rt_borrowed_return")
  let a = expect(ctx, "a result with its own reference passes", str_starts_with(out, "hello"), true)
  let b = expect(ctx, "it stops at the call, naming the ensure", contains_text(out, "contract violation: postcondition failed in borrows(): "), true)
  let c = expect(ctx, "nothing after it runs", contains_text(out, "not reached"), false)
  return a and b and c
end

make a function called st_rr_big_frame takes ctx returns ok
  return expect(ctx, "it runs", rr_run(ctx, "rt_big_frame"), "2999")
end

make a function called st_rr_representation_contract takes ctx returns ok
  let names = ["rt_bad_class", "rt_bad_freed"]
  let all = true
  let i = 0
  while i < list_len(names) do
    let out = rr_run(ctx, names[i])
    if not expect(ctx, names[i] + " stops at the call, naming the require", contains_text(out, "contract violation: precondition failed in uses(): value_live(v)"), true) then
      let all = false
    end
    if not expect(ctx, names[i] + ": nothing after it runs", contains_text(out, "not reached"), false) then
      let all = false
    end
    let i = i + 1
  end
  return all
end

make a function called st_rr_stage_contracts takes ctx returns ok
  let stages = [[rr_v2("lower.patlang"), "lw_function_with"], [rr_v2("own.patlang"), "own_function"], [rr_v2("x64.patlang"), "xv_fn_asm"]]
  let all = true
  let i = 0
  while i < list_len(stages) do
    let text = rr_function_text(stages[i][0], stages[i][1])
    if not expect(ctx, stages[i][1] + " states require and ensure", contains_text(text, "require ") and contains_text(text, "ensure "), true) then
      let all = false
    end
    let i = i + 1
  end
  return all
end

make a function called st_rr_one_setting takes ctx returns ok
  let files = ["compile.patlang", "lower.patlang", "own.patlang", "x64.patlang", "ir.patlang", "contracts.patlang", "runtime/core.patlang"]
  let readers = []
  let i = 0
  while i < list_len(files) do
    if rr_any_line_has(rr_v2(files[i]), "v2_contracts_checked()") then
      let readers = list_push(readers, files[i])
    end
    let i = i + 1
  end
  return expect(ctx, "v2_contracts_checked is read only by the lowering", readers, ["lower.patlang"])
end

# ---- compiler_structure.feature (2.5) ----

make a function called st_rr_same_stages takes ctx returns ok
  let a = expect(ctx, "the lowering has no branch for the runtime's files", rr_any_line_has(rr_v2("lower.patlang"), "runtime/"), false)
  let b = expect(ctx, "nor does the ownership stage", rr_any_line_has(rr_v2("own.patlang"), "runtime/"), false)
  let c = expect(ctx, "nor code generation", rr_any_line_has(rr_v2("x64.patlang"), "runtime/"), false)
  return a and b and c
end

make a function called st_rr_builtin_method takes ctx returns ok
  let body = rr_function_text(rr_v2("runtime/objects.patlang"), "rt_builtin_classes")
  return expect(ctx, "int's to_s is a method declared in the runtime's PatLang", contains_text(body, "[" + chr(34) + "to_s" + chr(34) + ", |v|"), true)
end

make a function called st_rr_no_vars takes ctx returns ok
  let files = ["compile.patlang", "lower.patlang", "own.patlang", "x64.patlang", "ir.patlang"]
  let all = true
  let i = 0
  while i < list_len(files) do
    let p = rr_v2(files[i])
    let uses = rr_any_line_has(p, "__vars") or rr_any_line_has(p, "set_var(") or rr_any_line_has(p, "set_global(") or rr_any_line_has(p, "get_global(")
    if not expect(ctx, files[i] + " touches no shared state", uses, false) then
      let all = false
    end
    let i = i + 1
  end
  # the assembler is reused unchanged, and keeps its state in named objects
  let asm_uses = rr_any_line_has("self_hosting/lib/x64_asm.patlang", "send(")
  if not expect(ctx, "the assembler touches no shared state", asm_uses, false) then
    let all = false
  end
  return all
end

# A line with what its strings hold taken out: text a program writes for another
# program, or looks for, is not its own state.
make a function called rr_without_strings takes line returns code
  let out = sb_new()
  let in_string = false
  let i = 0
  while i < line.length do
    let c = line[i]
    if in_string then
      if c == chr(92) then
        let i = i + 1
      elif c == chr(34) then
        let in_string = false
      end
    elif c == chr(34) then
      let in_string = true
    else
      sb_push(out, c)
    end
    let i = i + 1
  end
  return sb_str(out)
end

# Whether a file's code, its comments and strings aside, keeps global state.
make a function called rr_keeps_globals takes path returns yes
  let quote = chr(34)
  let needles = ["set_global(", "get_global(", "set_var(", "get(" + quote + "__vars" + quote]
  let lines = rr_code_lines(path)
  let i = 0
  while i < list_len(lines) do
    let n = 0
    while n < list_len(needles) do
      if contains_text(lines[i], needles[n]) then
        # a needle holding a quote is only ever in code as itself
        if (n == 3) or contains_text(rr_without_strings(lines[i]), needles[n]) then
          return true
        end
      end
      let n = n + 1
    end
    let i = i + 1
  end
  return false
end

# The old native runtime's private state, and fixtures testing set_var as a language
# feature, go when the old compiler does (docs/plans/v2-implementation.md).
make a function called rr_may_keep_globals takes path returns yes
  if contains_text(path, "/spec_fixtures/") or str_starts_with(path, "self_hosting/build/") then
    return true
  end
  return list_has(["self_hosting/lib/x64_runtime.patlang", "self_hosting/lib/world_native.patlang", "self_hosting/block_model/heap.patlang"], path)
end

make a function called st_rr_no_globals takes ctx returns ok
  let listed = split_lines(rr_clean(exec_capture("git", "ls-files", "-c")) + chr(10) + rr_clean(exec_capture("git", "ls-files", "-o", "--exclude-standard", "--", "self_hosting")))
  let found = []
  let checked = 0
  let i = 0
  while i < list_len(listed) do
    let p = listed[i]
    if str_ends_with(p, ".patlang") and (not rr_may_keep_globals(p)) and file_exists(p) then
      let checked = checked + 1
      if rr_keeps_globals(p) then
        let found = list_push(found, p)
      end
    end
    let i = i + 1
  end
  let a = expect(ctx, "files were searched", checked > 500, true)
  let b = expect(ctx, "none of them keeps global state", found, [])
  return a and b
end

# A build's ledger (OUT.ledger): "built NAME" or "reused NAME" per job.
make a function called rr_ledger_has takes exe, line returns yes
  return list_has(split_lines(rr_clean(read_file(exe + ".ledger"))), line)
end

make a function called rr_compile takes src, exe, extra returns out
  if list_len(extra) == 0 then
    return exec_capture(rr_pat(), "--ir-run", "self_hosting/v2/compile.patlang", src, exe)
  end
  return exec_capture(rr_pat(), "--ir-run", "self_hosting/v2/compile.patlang", src, exe, extra[0], extra[1], extra[2], extra[3], extra[4])
end

# f calls g; g's body changes, its summary (arity, borrowed parameters, an
# owned result) does not. g's constants are new each run, so no earlier
# run's artefact can stand in for g.
make a function called st_rr_summary_reuse takes ctx returns ok
  let k = now_ms() % 1000000
  let f_src = "make a function called rr_f takes n returns r" + nl() + "  return rr_g(n) * 2" + nl() + "end" + nl()
  let g1 = "make a function called rr_g takes n returns r" + nl() + "  return n + " + k + nl() + "end" + nl()
  let g2 = "make a function called rr_g takes n returns r" + nl() + "  return n + " + (k + 1) + nl() + "end" + nl()
  let tail = "print(rr_f(1))" + nl()
  write_file("self_hosting/build/v2_rt_summary_1.patlang", f_src + g1 + tail)
  write_file("self_hosting/build/v2_rt_summary_2.patlang", f_src + g2 + tail)
  let exe1 = "self_hosting/build/v2_rt_summary_1.exe"
  let exe2 = "self_hosting/build/v2_rt_summary_2.exe"
  rr_compile("self_hosting/build/v2_rt_summary_1.patlang", exe1, [])
  rr_compile("self_hosting/build/v2_rt_summary_2.patlang", exe2, [])
  let a = expect(ctx, "the second build runs with g's new body", rr_clean(exec_capture(exe2)), "" + ((1 + k + 1) * 2))
  let b = expect(ctx, "f's artefact is reused", rr_ledger_has(exe2, "reused rr_f"), true)
  let c = expect(ctx, "g is built again", rr_ledger_has(exe2, "built rr_g"), true)
  return a and b and c
end

# Where a function's artefacts are stored: their common path, found by the label
# its assembly defines, or "" if none has it.
make a function called rr_artefact_stem takes name returns stem
  let out = exec_capture("cmd", "/c", "findstr /m /l " + name + ": self_hosting" + chr(92) + "build" + chr(92) + "v2_artefacts" + chr(92) + "*.asm")
  let lines = split_lines(rr_clean(out))
  if list_len(lines) == 0 then
    return ""
  end
  let first = lines[0]
  if not str_ends_with(first, ".asm") then
    return ""
  end
  return substr(first, 0, first.length - 4)
end

make a function called rr_cut_in_half takes path returns done
  let bytes = read_file_bytes(path, 0, 67108864)
  let half = read_file_bytes(path, 0, floor(list_len(bytes) / 2))
  write_file_bytes(path, half)
  return true
end

# The function's name and constant are new each run, so its artefacts are this run's.
make a function called st_rr_partial_rebuilt takes ctx returns ok
  let k = now_ms() % 1000000
  let name = "rr_part_" + k
  let src = "self_hosting/build/v2_rt_partial.patlang"
  let exe = "self_hosting/build/v2_rt_partial.exe"
  write_file(src, "make a function called " + name + " takes n returns r" + nl() + "  return n + " + k + nl() + "end" + nl() + "print(" + name + "(1))" + nl())
  rr_compile(src, exe, [])
  let wanted = "" + (1 + k)
  let all = expect(ctx, "the first build runs", rr_clean(exec_capture(exe)), wanted)
  let stem = rr_artefact_stem(name)
  if not expect(ctx, "the function's artefacts are found", stem != "", true) then
    return false
  end
  let exts = [".text", ".asm", ".chunk"]
  let i = 0
  while i < list_len(exts) do
    rr_cut_in_half(stem + exts[i])
    rr_compile(src, exe, [])
    let a = expect(ctx, exts[i] + " cut short: the function is built again", rr_ledger_has(exe, "built " + name), true)
    let b = expect(ctx, exts[i] + " cut short: the program runs", rr_clean(exec_capture(exe)), wanted)
    let all = all and a and b
    let i = i + 1
  end
  return all
end

# The program facts are an artefact of the build (OUT.facts), one per line,
# recorded by the lowering where each registration is declared.
make a function called st_rr_facts takes ctx returns ok
  let out = rr_run(ctx, "rt_facts")
  let a = expect(ctx, "the program runs: apply reaches greet, emit reaches the handler", out, "hello world" + nl() + "ticked")
  let facts = []
  if file_exists(rr_exe("rt_facts") + ".facts") then
    let facts = split_lines(rr_clean(read_file(rr_exe("rt_facts") + ".facts")))
  end
  let b = expect(ctx, "the facts list the when handler", list_has(facts, "event tick"), true)
  let c = expect(ctx, "the facts list the rule", list_has(facts, "rule ancestor/2"), true)
  let d = expect(ctx, "the facts list the function reached only through apply", list_has(facts, "by_name greet"), true)
  return a and b and c and d
end

# No artefacts reused, so every job runs in each build.
make a function called st_rr_parallel_build takes ctx returns ok
  let src = "self_hosting/v2/spec/fixtures/rt_facts.patlang"
  let one = "self_hosting/build/v2_rt_workers_1.exe"
  let eight = "self_hosting/build/v2_rt_workers_8.exe"
  rr_compile(src, one, ["--workers", "1", "--shuffle", "0", "--no-cache"])
  rr_compile(src, eight, ["--workers", "8", "--shuffle", "7", "--no-cache"])
  let a = expect(ctx, "the eight-worker build runs", rr_clean(exec_capture(eight)), "hello world" + nl() + "ticked")
  let bytes_one = read_file_bytes(one, 0, 67108864)
  let bytes_eight = read_file_bytes(eight, 0, 67108864)
  let b = expect(ctx, "both executables were written", (list_len(bytes_one) > 0) and (list_len(bytes_eight) > 0), true)
  let c = expect(ctx, "they are byte-identical", bytes_one == bytes_eight, true)
  return a and b and c
end

make a function called st_rr_include_once takes ctx returns ok
  return rr_expect(ctx, "base runs once, then both includers' functions see it", "rt_include", "base runs" + nl() + "42" + nl() + "40")
end

make a function called st_rr_names takes ctx returns ok
  let src_a = "make a function called first takes n returns r" + nl() + "  let f = |x| { return x + n }" + nl() + "  let i = 0" + nl() + "  while i < 2 do" + nl() + "    let i = i + 1" + nl() + "  end" + nl() + "  return f(i)" + nl() + "end" + nl()
  let src_b = "make a function called second takes n returns r" + nl() + "  let g = |y| { return y * n }" + nl() + "  return g(2)" + nl() + "end" + nl()
  let tail = "print(first(1))" + nl() + "print(second(3))" + nl()
  write_file("self_hosting/build/v2_rt_names_ab.patlang", src_a + src_b + tail)
  write_file("self_hosting/build/v2_rt_names_ba.patlang", src_b + src_a + tail)
  exec_capture(rr_pat(), "--ir-run", "self_hosting/v2/compile.patlang", "self_hosting/build/v2_rt_names_ab.patlang", "self_hosting/build/v2_rt_names_ab.exe")
  exec_capture(rr_pat(), "--ir-run", "self_hosting/v2/compile.patlang", "self_hosting/build/v2_rt_names_ba.patlang", "self_hosting/build/v2_rt_names_ba.exe")
  let ab = split_lines(read_file("self_hosting/build/v2_rt_names_ab.exe.asm"))
  let ba = split_lines(read_file("self_hosting/build/v2_rt_names_ba.exe.asm"))
  let a = expect(ctx, "first's closure is first__closure_0, in either order", list_has(ab, "global f_first__closure_0") and list_has(ba, "global f_first__closure_0"), true)
  let b = expect(ctx, "second's closure is second__closure_0, in either order", list_has(ab, "global f_second__closure_0") and list_has(ba, "global f_second__closure_0"), true)
  return a and b
end

make a function called register_runtime_steps takes ctx returns done
  let noops = ["the int 9223372036854775807 in a local", "its two words are read with the runtime's word accessors", "1.5 stored into a list and read back, a million times in a loop", "the heap's bytes in use are compared before and after", "a string literal, a heap string, an int whose bits look like a pointer, and a float", "type_of is applied to each", "a list of 1000 ints", "the list's buffer size is read", "a function adding two ints in a loop, with no handler registered for any event", "its generated code is inspected", "a runtime function returning one of its arguments unchanged", "it is called with a fresh string and the caller releases its own copy of the argument", "s = " + chr(34) + "a" + chr(34) + " + " + chr(34) + "b" + chr(34) + ", t = s, then s is rebound", "t is read", "a list holding a fresh string, the only reference to that string", "the list is released", "an object field holding a fresh string, overwritten with another", "the first string's count is read", "an int, a float, a bool and unit", "each is retained and released ten times", "the compiler's source", "it is searched for lists of runtime function names", "a program making a million small allocations within 100 MB", "its system calls for memory are counted", "a string grown one character at a time to 4000 characters", "the heap's bytes in use are read", "8 threads, each allocating and freeing a million blocks of its own", "the shared pool's lock is counted", "thread A making blocks that thread B releases", "thread B then allocates blocks of the same size class", "thread A only allocating and thread B only releasing, for a million blocks", "the run ends", "a program that allocates 500 MB, frees it, then allocates 500 MB again", "its committed memory is read", "the runtime's source", "each function's declaration is read", "a runtime function changed to return a borrowed argument without a reference of its own", "a program calls it", "a value built with a type word naming no class, or with a heap type word and a freed block in its data word", "it is passed to a function requiring a live value", "a program whose function has a require clause it breaks, built in the default way and in every other build mode", "each build runs", "the compiler and runtime sources", "they are searched for what decides whether a require or ensure is checked", "each compiler stage's job function", "its declaration is read", "the new runtime's source", "it is compiled", "the declaration of int's to_s is looked for", "every compiler stage", "its source is searched for __vars reads and writes", "a program whose function f calls g", "g's body changes without changing its ownership summary", "a program with a when handler, a rule, and a function reached only through apply", "the same input compiled once with one worker and once with eight, with the ready order shuffled", "the two executables are compared", "two functions each containing a closure and a loop", "they are compiled in either order"]
  let i = 0
  while i < list_len(noops) do
    step(ctx, noops[i], "st_rr_noop")
    let i = i + 1
  end
  step(ctx, "the type word names int, and the data word is 9223372036854775807", "st_rr_int_words")
  step(ctx, "they are the same, and the value read back is 1.5", "st_rr_float_inline")
  step(ctx, "they are string, string, int, float, with no address range checked", "st_rr_kinds")
  step(ctx, "it is 1000 slots of 16 bytes, plus the header", "st_rr_list_slots")
  step(ctx, "the addition is the machine add, and at most one flag test guards an event, none where the compiler can see that no handler exists", "st_rr_add_flag")
  step(ctx, "the returned string is still readable, and its count is 1", "st_rr_returns_arg")
  step(ctx, "it is " + chr(34) + "ab" + chr(34), "st_rr_copy_local")
  step(ctx, "the string's block is back on its free list", "st_rr_structure_frees")
  step(ctx, "its block has been freed", "st_rr_overwrite_frees")
  step(ctx, "no heap block is touched and no count changes", "st_rr_inline_counts")
  step(ctx, "there are none: each function's ownership summary is derived from its own source", "st_rr_no_name_lists")
  step(ctx, "there is one reservation and at most one commit", "st_rr_million")
  step(ctx, "they are a few times the final string's size, not the sum of every version", "st_rr_grow")
  step(ctx, "it was taken at most once per batch, never per block", "st_rr_threads")
  step(ctx, "it reuses A's freed blocks, taking no lock per block", "st_rr_cross_thread")
  step(ctx, "A's memory came partly from batches B handed back, and the peak stays within twice the live data", "st_rr_imbalance")
  step(ctx, "it is about 500 MB, not 1 GB, and nothing was returned to the system", "st_rr_memory_stays")
  step(ctx, "each has require and ensure clauses covering its ownership behaviour and its representation invariants", "st_rr_contracts_everywhere")
  step(ctx, "the program stops at that call, naming the broken ensure clause, before anything is released twice", "st_rr_ownership_contract")
  step(ctx, "the program stops at that call, naming the require clause", "st_rr_representation_contract")
  step(ctx, "a program with three thousand functions reached by name", "st_rr_noop")
  step(ctx, "it starts, registering them all from one function", "st_rr_noop")
  step(ctx, "it runs, the stack committed a page at a time", "st_rr_big_frame")
  step(ctx, "each stops at that call, naming the clause", "st_rr_contract_fails")
  step(ctx, "exactly one place reads that setting, and no contract refers to it", "st_rr_one_setting")
  step(ctx, "it requires well-formed input artefacts and ensures a well-formed output artefact", "st_rr_stage_contracts")
  step(ctx, "it goes through the same stages as a user program, with no runtime-only branch in any stage", "st_rr_same_stages")
  step(ctx, "it is a PatLang method declaration in int's class, not a name the compiler recognises", "st_rr_builtin_method")
  step(ctx, "there are none: each takes input artefacts and produces one output artefact", "st_rr_no_vars")
  step(ctx, "every PatLang file but the old runtime's own and the fixtures testing set_var as a language feature", "st_rr_noop")
  step(ctx, "its code is searched for set_global, get_global, set_var and reads of __vars", "st_rr_noop")
  step(ctx, "there are none", "st_rr_no_globals")
  step(ctx, "f's compiled artefact is reused unchanged", "st_rr_summary_reuse")
  step(ctx, "a built program whose function's stored code, assembly or record is then cut short", "st_rr_noop")
  step(ctx, "the program is built again", "st_rr_noop")
  step(ctx, "that function is built again, and the program runs", "st_rr_partial_rebuilt")
  step(ctx, "the program facts list all three, and no stage scans for them", "st_rr_facts")
  step(ctx, "they are byte-identical", "st_rr_parallel_build")
  step(ctx, "each synthesized name is its declaration's name plus a counter local to it", "st_rr_names")
  step(ctx, "a program whose two included files both include a third", "st_rr_noop")
  step(ctx, "it is compiled and run", "st_rr_noop")
  step(ctx, "the third file's statements run once, before the files that include it", "st_rr_include_once")
  step(ctx, "a program that does not parse", "st_rr_noop")
  step(ctx, "the compiler prints the error, exits non-zero, and writes no executable", "st_rr_build_failure")
  step(ctx, "a match no case takes", "st_rr_noop")
  step(ctx, "the program is built and run", "st_rr_noop")
  step(ctx, "it stops at the match, naming the function, with a non-zero exit code", "st_rr_match_no_case")
  return true
end

let ctx = ctx_new()
register_runtime_steps(ctx)
let features = ["runtime_representation", "ownership", "memory_manager", "contracts", "compiler_structure"]
# A feature file named on the command line runs alone.
let only = argv()
let i = 0
while i < list_len(features) do
  if list_len(only) == 0 then
    run_feature_file(ctx, "spec_library/values_and_memory/" + features[i] + ".feature")
  end
  let i = i + 1
end
if list_len(only) > 0 then
  run_feature_file(ctx, only[0])
end
ctx_report(ctx)
