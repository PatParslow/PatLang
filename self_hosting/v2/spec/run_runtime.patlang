# Runs spec_library/values_and_memory's @runtime features
# (docs/spec/values-and-memory.md, Part 2) against v2:
#
#   pat --ir-run self_hosting/v2/spec/run_runtime.patlang
#
# Each scenario's fixture is in self_hosting/v2/spec/fixtures/ (rt_*); a
# scenario about the code itself reads the sources.
include "../../lib/test.patlang"

make a function called rr_pat returns p
  return "rust-runtime/target/release/pat.exe"
end

make a function called rr_exe takes name returns path
  return "self_hosting/build/v2_rt_" + name + ".exe"
end

make a function called rr_clean takes text returns out
  let b = sb_new()
  let i = 0
  while i < text.length do
    let c = char_code(text, i)
    if c != 13 then
      sb_push(b, chr(c))
    end
    let i = i + 1
  end
  return str_trim(sb_str(b))
end

make a function called nl returns s
  return chr(10)
end

# A fixture built with v2 (once per run) and run; its output, or the
# compiler's error.
make a function called rr_run takes name returns out
  let built = get_global("rr_built_" + name)
  if type_of(built) != "string" then
    let src = "self_hosting/v2/spec/fixtures/" + name + ".patlang"
    let c = exec_capture(rr_pat(), "--ir-run", "self_hosting/v2/compile.patlang", src, rr_exe(name))
    let built = "build failed: " + rr_clean(c)
    if contains_text(c, "v2: " + rr_exe(name)) then
      let built = ""
    end
    set_global("rr_built_" + name, built)
  end
  if built != "" then
    return built
  end
  return rr_clean(exec_capture(rr_exe(name)))
end

make a function called rr_expect takes label, name, expected returns ok
  return check(label, rr_run(name), expected)
end

make a function called st_rr_noop returns ok
  return true
end

# The lines of a function in a source file, from its declaration to its
# end, joined (line by line: substr at every position of a large file is
# quadratic under the interpreter).
make a function called rr_function_text takes path, fname returns text
  let lines = split_lines(read_file(path))
  let head = "make a function called " + fname + " "
  let out = []
  let inside = false
  let i = 0
  while i < list_len(lines) do
    let line = lines[i]
    if str_starts_with(line, head) then
      let inside = true
    end
    if inside then
      let out = list_push(out, line)
      if line == "end" then
        return str_join_lines(out)
      end
    end
    let i = i + 1
  end
  return str_join_lines(out)
end

make a function called str_join_lines takes lines returns text
  let b = sb_new()
  let i = 0
  while i < list_len(lines) do
    sb_push(b, lines[i])
    sb_push(b, chr(10))
    let i = i + 1
  end
  return sb_str(b)
end

# The lines of a generated function in an assembly file: from its label to
# the next function's.
make a function called rr_asm_function takes path, sym returns text
  let lines = split_lines(read_file(path))
  let out = []
  let inside = false
  let i = 0
  while i < list_len(lines) do
    let line = lines[i]
    if line == sym + ":" then
      let inside = true
    elif inside and str_starts_with(line, "global f_") then
      return str_join_lines(out)
    end
    if inside then
      let out = list_push(out, line)
    end
    let i = i + 1
  end
  return str_join_lines(out)
end

# The code lines of a file: comments and blank lines left out.
make a function called rr_code_lines takes path returns lines
  let all = split_lines(read_file(path))
  let out = []
  let i = 0
  while i < list_len(all) do
    let t = str_trim(all[i])
    if (t != "") and (not str_starts_with(t, "#")) then
      let out = list_push(out, t)
    end
    let i = i + 1
  end
  return out
end

make a function called rr_any_line_has takes path, needle returns yes
  let lines = rr_code_lines(path)
  let i = 0
  while i < list_len(lines) do
    if contains_text(lines[i], needle) then
      return true
    end
    let i = i + 1
  end
  return false
end

make a function called rr_v2 takes f returns path
  return "self_hosting/v2/" + f
end

# ---- runtime_representation.feature (2.1) ----

make a function called st_rr_int_words returns ok
  return rr_expect("int's type word is 2 and its data word 2^63 - 1", "rt_int_words", "2" + nl() + "9223372036854775807")
end

make a function called st_rr_float_inline returns ok
  return rr_expect("a million floats through a list leave the heap where it was", "rt_float_inline", "0" + nl() + "1.5")
end

make a function called st_rr_kinds returns ok
  let a = rr_expect("string, string, int, float", "rt_kinds", "string" + nl() + "string" + nl() + "int" + nl() + "float")
  # type_of reads the class from the type word and nothing else
  let body = rr_function_text(rr_v2("runtime/strings.patlang"), "type_of")
  let b = check("type_of reads no memory and checks no address range", contains_text(body, "mem_load") or contains_text(body, "runtime_state"), false)
  return a and b
end

make a function called st_rr_list_slots returns ok
  return rr_expect("1000 elements, element 999 at block + 32 + 16 * 999: type word 2, data 999", "rt_list_slots", "1000" + nl() + "2" + nl() + "999")
end

make a function called st_rr_add_flag returns ok
  let out = rr_run("rt_add_loop")
  let a = check("the loop's sum", out, "45")
  let fn_text = rr_asm_function(rr_exe("rt_add_loop") + ".asm", "f_sum_to")
  let b = check("the addition is a machine add", contains_text(fn_text, "add rax, rcx"), true)
  let c = check("with no handler anywhere in the program, no flag test", contains_text(fn_text, "2064"), false)
  return a and b and c
end

# ---- ownership.feature (2.2) ----

make a function called st_rr_returns_arg returns ok
  return rr_expect("the returned string reads ab, its count 1", "rt_returns_arg", "ab" + nl() + "1")
end

make a function called st_rr_copy_local returns ok
  return rr_expect("t is still ab", "rt_copy_local", "ab")
end

make a function called st_rr_structure_frees returns ok
  return rr_expect("the string's block heads its class's free list", "rt_structure_frees", "true")
end

make a function called st_rr_overwrite_frees returns ok
  return rr_expect("the overwritten string's block heads its class's free list", "rt_overwrite_frees", "true")
end

make a function called st_rr_inline_counts returns ok
  return rr_expect("ints, floats, bools and unit passed and copied: the heap untouched", "rt_inline_counts", "0")
end

# The ownership stage names no function: every string in it is an IR
# instruction's name.
make a function called st_rr_no_name_lists returns ok
  let ops = ["const", "call", "op", "un", "prim", "extern", "externf", "list", "closure", "callv", "copy", "take", "return", "retain", "release", "move", "clear", "label", "jump", "branch"]
  let lines = rr_code_lines(rr_v2("own.patlang"))
  let bad = []
  let i = 0
  while i < list_len(lines) do
    let line = lines[i]
    let k = 0
    while k < line.length do
      if char_code(line, k) == 34 then
        let e = k + 1
        while (e < line.length) and (char_code(line, e) != 34) do
          let e = e + 1
        end
        let lit = substr(line, k + 1, e - k - 1)
        if not list_has(ops, lit) then
          let bad = list_push(bad, lit)
        end
        let k = e + 1
      else
        let k = k + 1
      end
    end
    let i = i + 1
  end
  return check("the ownership stage names no function (other strings: " + bad + ")", list_len(bad), 0)
end

make a function called list_has takes items, x returns yes
  let i = 0
  while i < list_len(items) do
    if items[i] == x then
      return true
    end
    let i = i + 1
  end
  return false
end

# ---- memory_manager.feature (2.3) ----

make a function called st_rr_million returns ok
  return rr_expect("one reservation, one commit", "rt_million_allocs", "1" + nl() + "1")
end

make a function called st_rr_grow returns ok
  return rr_expect("4000 characters for under 40 bytes each", "rt_grow_string", "4000" + nl() + "true")
end

make a function called st_rr_threads returns ok
  return rr_expect("8 threads, a million strings each, the pool's lock taken under 1000 times", "rt_threads_no_lock", "[8, 8, 8, 8, 8, 8, 8, 8]" + nl() + "true")
end

make a function called st_rr_cross_thread returns ok
  return rr_expect("of 2000 blocks freed by the thread that did not make them, at least 1990 reused by it, each pool lock it takes serving at least half a batch", "rt_cross_thread", "true" + nl() + "true")
end

make a function called st_rr_imbalance returns ok
  return rr_expect("the second fill takes the blocks the other thread handed back", "rt_imbalance", "[200000]" + nl() + "true")
end

make a function called st_rr_memory_stays returns ok
  return rr_expect("the second fill commits nothing more", "rt_memory_stays", "true" + nl() + "true")
end

# ---- contracts.feature (2.4) ----

make a function called st_rr_contracts_everywhere returns ok
  let files = ["core", "memory", "strings", "lists", "integers", "rationals", "floats", "numbers", "closures", "objects", "logic", "cells", "system", "threads"]
  let total = 0
  let missing = 0
  let f = 0
  while f < list_len(files) do
    let src = split_lines(read_file(rr_v2("runtime/" + files[f] + ".patlang")))
    let i = 0
    let in_fn = false
    let has_req = false
    let has_ens = false
    while i < list_len(src) do
      let t = str_trim(src[i])
      if str_starts_with(t, "make a function called ") then
        let in_fn = true
        # a function with no parameters has nothing to require
        let has_req = not contains_text(t, " takes ")
        let has_ens = false
        let total = total + 1
      elif in_fn and str_starts_with(t, "require ") then
        let has_req = true
      elif in_fn and str_starts_with(t, "ensure ") then
        let has_ens = true
      elif in_fn and (src[i] == "end") then
        if not (has_req and has_ens) then
          let missing = missing + 1
        end
        let in_fn = false
      end
      let i = i + 1
    end
    let f = f + 1
  end
  return check("runtime functions with both require and ensure (" + (total - missing) + " of " + total + ")", missing, 0)
end

make a function called st_rr_contract_fails returns ok
  let out = rr_run("rt_contract_fails")
  let a = check("it stops at the broken require, naming it", contains_text(out, "contract violation: precondition failed in half(): n > 0"), true)
  let b = check("nothing after it runs", contains_text(out, "not reached"), false)
  return a and b
end

make a function called st_rr_not_applicable takes what returns ok
  return check(what + ": not applicable to two-word values as written (docs/plans/v2-implementation.md section 7)", false, true)
end

make a function called st_rr_ownership_contract returns ok
  return st_rr_not_applicable("returning a borrowed argument without a reference")
end

make a function called st_rr_representation_contract returns ok
  return st_rr_not_applicable("an int type word with a pointer in its data word")
end

make a function called st_rr_stage_contracts returns ok
  let stages = [[rr_v2("lower.patlang"), "lw_function_with"], [rr_v2("own.patlang"), "own_function"], [rr_v2("x64.patlang"), "xv_fn_asm"]]
  let all = true
  let i = 0
  while i < list_len(stages) do
    let text = rr_function_text(stages[i][0], stages[i][1])
    if not check(stages[i][1] + " states require and ensure", contains_text(text, "require ") and contains_text(text, "ensure "), true) then
      let all = false
    end
    let i = i + 1
  end
  return all
end

make a function called st_rr_one_setting returns ok
  let files = ["compile.patlang", "lower.patlang", "own.patlang", "x64.patlang", "ir.patlang", "contracts.patlang", "runtime/core.patlang"]
  let readers = []
  let i = 0
  while i < list_len(files) do
    if rr_any_line_has(rr_v2(files[i]), "v2_contracts_checked()") then
      let readers = list_push(readers, files[i])
    end
    let i = i + 1
  end
  return check("v2_contracts_checked is read only by the lowering", readers, ["lower.patlang"])
end

# ---- compiler_structure.feature (2.5) ----

make a function called st_rr_same_stages returns ok
  let a = check("the lowering has no branch for the runtime's files", rr_any_line_has(rr_v2("lower.patlang"), "runtime/"), false)
  let b = check("nor does the ownership stage", rr_any_line_has(rr_v2("own.patlang"), "runtime/"), false)
  let c = check("nor code generation", rr_any_line_has(rr_v2("x64.patlang"), "runtime/"), false)
  return a and b and c
end

make a function called st_rr_builtin_method returns ok
  let body = rr_function_text(rr_v2("runtime/objects.patlang"), "rt_builtin_classes")
  return check("int's to_s is a method declared in the runtime's PatLang", contains_text(body, "[" + chr(34) + "to_s" + chr(34) + ", |v|"), true)
end

make a function called st_rr_no_vars returns ok
  let files = ["compile.patlang", "lower.patlang", "own.patlang", "x64.patlang", "ir.patlang"]
  let all = true
  let i = 0
  while i < list_len(files) do
    let p = rr_v2(files[i])
    let uses = rr_any_line_has(p, "__vars") or rr_any_line_has(p, "set_var(") or rr_any_line_has(p, "set_global(") or rr_any_line_has(p, "get_global(")
    if not check(files[i] + " touches no shared state", uses, false) then
      let all = false
    end
    let i = i + 1
  end
  # the assembler is reused unchanged, and keeps its state in named objects
  let asm_uses = rr_any_line_has("self_hosting/lib/x64_asm.patlang", "send(")
  if not check("the assembler touches no shared state", asm_uses, false) then
    let all = false
  end
  return all
end

# A build's ledger (OUT.ledger): "built NAME" or "reused NAME" per job.
make a function called rr_ledger_has takes exe, line returns yes
  return list_has(split_lines(rr_clean(read_file(exe + ".ledger"))), line)
end

make a function called rr_compile takes src, exe, extra returns out
  if list_len(extra) == 0 then
    return exec_capture(rr_pat(), "--ir-run", "self_hosting/v2/compile.patlang", src, exe)
  end
  return exec_capture(rr_pat(), "--ir-run", "self_hosting/v2/compile.patlang", src, exe, extra[0], extra[1], extra[2], extra[3], extra[4])
end

# f calls g; g's body changes, its summary (arity, borrowed parameters, an
# owned result) does not. g's constants are new each run, so no earlier
# run's artefact can stand in for g.
make a function called st_rr_summary_reuse returns ok
  let k = now_ms() % 1000000
  let f_src = "make a function called rr_f takes n returns r" + nl() + "  return rr_g(n) * 2" + nl() + "end" + nl()
  let g1 = "make a function called rr_g takes n returns r" + nl() + "  return n + " + k + nl() + "end" + nl()
  let g2 = "make a function called rr_g takes n returns r" + nl() + "  return n + " + (k + 1) + nl() + "end" + nl()
  let tail = "print(rr_f(1))" + nl()
  write_file("self_hosting/build/v2_rt_summary_1.patlang", f_src + g1 + tail)
  write_file("self_hosting/build/v2_rt_summary_2.patlang", f_src + g2 + tail)
  let exe1 = "self_hosting/build/v2_rt_summary_1.exe"
  let exe2 = "self_hosting/build/v2_rt_summary_2.exe"
  rr_compile("self_hosting/build/v2_rt_summary_1.patlang", exe1, [])
  rr_compile("self_hosting/build/v2_rt_summary_2.patlang", exe2, [])
  let a = check("the second build runs with g's new body", rr_clean(exec_capture(exe2)), "" + ((1 + k + 1) * 2))
  let b = check("f's artefact is reused", rr_ledger_has(exe2, "reused rr_f"), true)
  let c = check("g is built again", rr_ledger_has(exe2, "built rr_g"), true)
  return a and b and c
end

# The program facts are an artefact of the build (OUT.facts), one per line,
# recorded by the lowering where each registration is declared.
make a function called st_rr_facts returns ok
  let out = rr_run("rt_facts")
  let a = check("the program runs: apply reaches greet, emit reaches the handler", out, "hello world" + nl() + "ticked")
  let facts = []
  if file_exists(rr_exe("rt_facts") + ".facts") then
    let facts = split_lines(rr_clean(read_file(rr_exe("rt_facts") + ".facts")))
  end
  let b = check("the facts list the when handler", list_has(facts, "event tick"), true)
  let c = check("the facts list the rule", list_has(facts, "rule ancestor/2"), true)
  let d = check("the facts list the function reached only through apply", list_has(facts, "by_name greet"), true)
  return a and b and c and d
end

# No artefacts reused, so every job runs in each build.
make a function called st_rr_parallel_build returns ok
  let src = "self_hosting/v2/spec/fixtures/rt_facts.patlang"
  let one = "self_hosting/build/v2_rt_workers_1.exe"
  let eight = "self_hosting/build/v2_rt_workers_8.exe"
  rr_compile(src, one, ["--workers", "1", "--shuffle", "0", "--no-cache"])
  rr_compile(src, eight, ["--workers", "8", "--shuffle", "7", "--no-cache"])
  let a = check("the eight-worker build runs", rr_clean(exec_capture(eight)), "hello world" + nl() + "ticked")
  let bytes_one = read_file_bytes(one, 0, 67108864)
  let bytes_eight = read_file_bytes(eight, 0, 67108864)
  let b = check("both executables were written", (list_len(bytes_one) > 0) and (list_len(bytes_eight) > 0), true)
  let c = check("they are byte-identical", bytes_one == bytes_eight, true)
  return a and b and c
end

make a function called st_rr_names returns ok
  let src_a = "make a function called first takes n returns r" + nl() + "  let f = |x| { return x + n }" + nl() + "  let i = 0" + nl() + "  while i < 2 do" + nl() + "    let i = i + 1" + nl() + "  end" + nl() + "  return f(i)" + nl() + "end" + nl()
  let src_b = "make a function called second takes n returns r" + nl() + "  let g = |y| { return y * n }" + nl() + "  return g(2)" + nl() + "end" + nl()
  let tail = "print(first(1))" + nl() + "print(second(3))" + nl()
  write_file("self_hosting/build/v2_rt_names_ab.patlang", src_a + src_b + tail)
  write_file("self_hosting/build/v2_rt_names_ba.patlang", src_b + src_a + tail)
  exec_capture(rr_pat(), "--ir-run", "self_hosting/v2/compile.patlang", "self_hosting/build/v2_rt_names_ab.patlang", "self_hosting/build/v2_rt_names_ab.exe")
  exec_capture(rr_pat(), "--ir-run", "self_hosting/v2/compile.patlang", "self_hosting/build/v2_rt_names_ba.patlang", "self_hosting/build/v2_rt_names_ba.exe")
  let ab = split_lines(read_file("self_hosting/build/v2_rt_names_ab.exe.asm"))
  let ba = split_lines(read_file("self_hosting/build/v2_rt_names_ba.exe.asm"))
  let a = check("first's closure is first__closure_0, in either order", list_has(ab, "global f_first__closure_0") and list_has(ba, "global f_first__closure_0"), true)
  let b = check("second's closure is second__closure_0, in either order", list_has(ab, "global f_second__closure_0") and list_has(ba, "global f_second__closure_0"), true)
  return a and b
end

make a function called register_runtime_steps returns done
  let noops = ["the int 9223372036854775807 in a local", "its two words are read with the runtime's word accessors", "1.5 stored into a list and read back, a million times in a loop", "the heap's bytes in use are compared before and after", "a string literal, a heap string, an int whose bits look like a pointer, and a float", "type_of is applied to each", "a list of 1000 ints", "the list's buffer size is read", "a function adding two ints in a loop, with no handler registered for any event", "its generated code is inspected", "a runtime function returning one of its arguments unchanged", "it is called with a fresh string and the caller releases its own copy of the argument", "s = " + chr(34) + "a" + chr(34) + " + " + chr(34) + "b" + chr(34) + ", t = s, then s is rebound", "t is read", "a list holding a fresh string, the only reference to that string", "the list is released", "an object field holding a fresh string, overwritten with another", "the first string's count is read", "an int, a float, a bool and unit", "each is retained and released ten times", "the compiler's source", "it is searched for lists of runtime function names", "a program making a million small allocations within 100 MB", "its system calls for memory are counted", "a string grown one character at a time to 4000 characters", "the heap's bytes in use are read", "8 threads, each allocating and freeing a million blocks of its own", "the shared pool's lock is counted", "thread A making blocks that thread B releases", "thread B then allocates blocks of the same size class", "thread A only allocating and thread B only releasing, for a million blocks", "the run ends", "a program that allocates 500 MB, frees it, then allocates 500 MB again", "its committed memory is read", "the runtime's source", "each function's declaration is read", "a runtime function changed to return a borrowed argument without a reference of its own", "a program calls it", "a value built with an int type word and a pointer in its data word", "it is passed to a function requiring an int", "a program whose function has a require clause it breaks, built in the default way and in every other build mode", "each build runs", "the compiler and runtime sources", "they are searched for what decides whether a require or ensure is checked", "each compiler stage's job function", "its declaration is read", "the new runtime's source", "it is compiled", "the declaration of int's to_s is looked for", "every compiler stage", "its source is searched for __vars reads and writes", "a program whose function f calls g", "g's body changes without changing its ownership summary", "a program with a when handler, a rule, and a function reached only through apply", "the same input compiled once with one worker and once with eight, with the ready order shuffled", "the two executables are compared", "two functions each containing a closure and a loop", "they are compiled in either order"]
  let i = 0
  while i < list_len(noops) do
    step(noops[i], "st_rr_noop")
    let i = i + 1
  end
  step("the type word names int, and the data word is 9223372036854775807", "st_rr_int_words")
  step("they are the same, and the value read back is 1.5", "st_rr_float_inline")
  step("they are string, string, int, float, with no address range checked", "st_rr_kinds")
  step("it is 1000 slots of 16 bytes, plus the header", "st_rr_list_slots")
  step("the addition is the machine add, and at most one flag test guards an event, none where the compiler can see that no handler exists", "st_rr_add_flag")
  step("the returned string is still readable, and its count is 1", "st_rr_returns_arg")
  step("it is " + chr(34) + "ab" + chr(34), "st_rr_copy_local")
  step("the string's block is back on its free list", "st_rr_structure_frees")
  step("its block has been freed", "st_rr_overwrite_frees")
  step("no heap block is touched and no count changes", "st_rr_inline_counts")
  step("there are none: each function's ownership summary is derived from its own source", "st_rr_no_name_lists")
  step("there is one reservation and at most one commit", "st_rr_million")
  step("they are a few times the final string's size, not the sum of every version", "st_rr_grow")
  step("it was taken at most once per batch, never per block", "st_rr_threads")
  step("it reuses A's freed blocks, taking no lock per block", "st_rr_cross_thread")
  step("A's memory came partly from batches B handed back, and the peak stays within twice the live data", "st_rr_imbalance")
  step("it is about 500 MB, not 1 GB, and nothing was returned to the system", "st_rr_memory_stays")
  step("each has require and ensure clauses covering its ownership behaviour and its representation invariants", "st_rr_contracts_everywhere")
  step("the program stops at that call, naming the broken ensure clause, before anything is released twice", "st_rr_ownership_contract")
  step("the program stops at that call, naming the require clause", "st_rr_representation_contract")
  step("each stops at that call, naming the clause", "st_rr_contract_fails")
  step("exactly one place reads that setting, and no contract refers to it", "st_rr_one_setting")
  step("it requires well-formed input artefacts and ensures a well-formed output artefact", "st_rr_stage_contracts")
  step("it goes through the same stages as a user program, with no runtime-only branch in any stage", "st_rr_same_stages")
  step("it is a PatLang method declaration in int's class, not a name the compiler recognises", "st_rr_builtin_method")
  step("there are none: each takes input artefacts and produces one output artefact", "st_rr_no_vars")
  step("f's compiled artefact is reused unchanged", "st_rr_summary_reuse")
  step("the program facts list all three, and no stage scans for them", "st_rr_facts")
  step("they are byte-identical", "st_rr_parallel_build")
  step("each synthesized name is its declaration's name plus a counter local to it", "st_rr_names")
  return true
end

t_init()
register_runtime_steps()
let features = ["runtime_representation", "ownership", "memory_manager", "contracts", "compiler_structure"]
let i = 0
while i < list_len(features) do
  run_feature_file("spec_library/values_and_memory/" + features[i] + ".feature")
  let i = i + 1
end
t_report()
