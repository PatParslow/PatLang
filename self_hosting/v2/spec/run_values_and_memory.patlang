make a function called st_pg_spawn_handles takes ctx returns ok
  let out = split_lines(vm_run_on(ctx, vm_engine(), "rt_spawn_handles", []))
  let port = to_num(out[0])
  let pid = out[1]
  # the child runs for about thirty seconds: had the capture waited for it,
  # it would no longer be running now (a fact about the processes, not a time)
  if vm_engine() == "linux" then
    # its pid and port are Linux's: asked there
    let running = exec_capture_io("wsl", ["-d", "Ubuntu-24.04", "-e", "kill", "-0", pid], "", 0)[2]
    let a = expect(ctx, "the capture ended while the child still runs", running, true)
    let b = expect(ctx, "the port can be listened on again", vm_run_on(ctx, "linux", "rt_spawn_handles", ["listen", "" + port]), "" + port)
    exec_capture_io("wsl", ["-d", "Ubuntu-24.04", "-e", "kill", "-9", pid], "", 0)
    return a and b
  end
  let running = contains_text(exec_capture("tasklist", "/FI", "PID eq " + pid, "/NH"), " " + pid + " ")
  let a = expect(ctx, "the capture ended while the child still runs", running, true)
  let b = expect(ctx, "the port can be listened on again", tcp_try_listen(port), port)
  exec_capture("taskkill", "/PID", pid, "/T", "/F")
  return a and b
end

