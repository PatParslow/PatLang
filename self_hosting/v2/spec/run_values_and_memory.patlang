  step(ctx, "each call reaches the program's function, and the runtime goes on using its own", "st_pg_shadow")
  step(ctx, "both engines report that the name is declared twice, and nothing runs", "st_pg_declared_twice")
  step(ctx, "the larger takes no more than about three times as long", "st_bm_named_lookup")
  step(ctx, "it sees the same field the object has, and the string still answers length", "st_member_by_name")
  step(ctx, "each gives minus the int minus one, as an int", "st_bnot_ints")
  step(ctx, "the program stops, reporting the float's class", "st_bnot_float")
  vm_noops(ctx, ["an int, whole floats of either sign and zero, and floats of 2^62, 2^63, -2^63 and 1e20", "a program applies to_int to each", "2.5, an infinite float and a string"])
  step(ctx, "each is the int it is, a bigint from 2^63 up, and floor's float made an int indexes a list", "st_vi_to_int")
  step(ctx, "each stops, saying to_int takes a whole number and naming what it was given", "st_rt_to_int_stops")
  step(ctx, "each gives what spec 1.13 says, and an if or while that ran nothing gives unit", "st_pg_no_return")
  vm_noops(ctx, ["a program that writes unit, and binds unit as a parameter and as a variable", "it runs"])
  step(ctx, "unit is the value a function with no statements gives, and a bound unit is the program's own", "st_pg_unit")
  step(ctx, "it gives both", "st_pg_exec_stderr")
  vm_noops(ctx, ["a command that writes to both outputs, once exiting 0 and once exiting 3", "exec_peak_memory runs each, and exec_measured the second, a command that succeeds, and a command whose child commits several hundred MB"])
  step(ctx, "exec_measured gives the two outputs apart, false then true for the exits, and a peak above 0", "st_pg_exec_measured")
  step(ctx, "exec_measured's peak counts the child's memory, where exec_peak_memory's is the command's own", "st_pg_exec_tree")
  vm_noops(ctx, ["sed commands with and without g and i, with no match, an empty pattern, no replacement, an empty replacement, flags after a slash, characters of two bytes and an int as input", "each is applied", "add, multiply and subtract of ints and of rationals, and calculate, calculate_result, get_value, process and validate of an int, a string and a list"])
  vm_noops(ctx, ["text read from files holding a lead byte at the end, a three-byte character cut short, an overlong slash, a stray continuation byte, an encoded surrogate, a code past U+10FFFF, and well-formed two- and four-byte characters", "a program measures each, reads every character's code, cuts past the end, and reads it through the cursor", "chr of 55295 and then of 55296"])
  step(ctx, "each byte that starts no well-formed sequence is one character with code 65533, the well-formed ones decode as ever, and the bytes are kept", "st_tx_utf8_malformed")
  step(ctx, "the first is one character, and it stops at the second, naming the require clause", "st_tx_chr_surrogate")
  step(ctx, "each gives what spec 1.10 says", "st_tx_sed")
  vm_noops(ctx, ["text of plain and of two- and three-byte characters, a needle at its start, middle and end, a needle it lacks, an empty needle, and a needle longer than the text", "str_contains looks for each"])
  step(ctx, "it is true where the text holds the needle, the empty needle included, and false elsewhere", "st_tx_str_contains")
  vm_noops(ctx, ["a bytes made from a non-ASCII string, an empty bytes, and a copy with one byte changed", "bytes_hash hashes each"])
  step(ctx, "the first two hash as str_hash hashes their strings, the hash is a non-negative int, and the changed copy hashes differently", "st_tx_bytes_hash")
  vm_noops(ctx, ["the empty string, a single letter, two equal strings built differently, a non-ASCII string, and 1000 different names", "str_hash hashes each"])
  step(ctx, "the empty string and the single letter give FNV-1a's values, equal strings hash equal, the non-ASCII one hashes its UTF-8 bytes, and the 1000 hashes are different", "st_tx_str_hash")
  vm_noops(ctx, ["a status read before any report and after two, and a one-action plan found with plan and with plan_incremental, then the actions cleared", "chr of a float"])
  step(ctx, "the status is empty, then the second report; both plans are the action, and after action_clear there is no plan", "st_pg_progress_plan")
  vm_noops(ctx, ["a path with no directory at it, and a directory with files", "list_dir reads each"])
  step(ctx, "the first gives [] and the program goes on, file_exists says the path is missing, and the second gives entries", "st_pg_list_dir_missing")
  vm_noops(ctx, ["a path relative to the current directory, the same path through .., and the full path itself", "path_absolute reads each"])
  step(ctx, "each gives the same full path, longer than the relative one, ending in it, naming a file that exists, with no backslash", "st_pg_path_absolute")
  vm_noops(ctx, ["standard input that is not a console, and the directory the program starts in", "console_raw_enable, console_raw_disable, cwd and set_cwd run"])
  step(ctx, "raw mode gives -1 and changes nothing, the echoes write with no line end, and cwd follows set_cwd there and back, unchanged by a directory that is missing", "st_pg_console_dir")
  vm_noops(ctx, ["write_file of a path whose name is followed by code 0 and .tmp", "it runs"])
  step(ctx, "the program stops saying the path holds code 0, and no file named by the part before it is made", "st_pg_path_nul")
  vm_noops(ctx, ["a virtual file pkg/../../v2_rt_paths_escaped.txt, and another pkg/sub/../ok.txt", "each is flushed to a directory of its own"])
  step(ctx, "the first stops the program naming the file, with nothing written, and the second is written as pkg/ok.txt with no pkg/sub made", "st_pg_vfs_flush_inside")
  vm_noops(ctx, ["a relative path of about 6000 characters", "path_absolute reads it"])
  step(ctx, "it gives the current directory followed by the path, or stops saying the system could not make it absolute", "st_pg_path_absolute_long")
  vm_noops(ctx, ["a listener, and tcp_connect to 127.0.0.1, to localhost, to 10.0.0.1, to 1.2.3 and to 127.0.0.300, tcp_try_connect to the listener and to a port nothing listens on, and tcp_try_write to a peer that has closed", "each is tried"])
  step(ctx, "the first two connect and carry what is written, 10.0.0.1 stops the program saying it is not this machine, the others stop it saying they are not addresses, tcp_try_connect connects to the listener and gives -1 for the other, and tcp_try_write comes to give false while the program goes on", "st_pg_tcp_hosts")
  vm_noops(ctx, ["a bool array set at 3 and 69, a builder holding four characters in five bytes, a store given facts with fact_in, planned from with plan_with_state_in, and emptied with rules_clear_in", "each is read"])
  step(ctx, "the array reads true at 3 and 69 and false at 4, the builder holds 5 bytes, query_in counts the store's facts and not the default store's, the plan is one step reaching four facts, and the emptied store holds none while the default store keeps its rule", "st_pg_store_forms")
  vm_noops(ctx, ["a program that listens on a port, spawns a child that runs on for about six seconds, prints the port and ends", "another program captures its output"])
  step(ctx, "the capture ends in well under the child's six seconds, and the port can be listened on again while the child still runs", "st_pg_spawn_handles")
  vm_noops(ctx, ["a program that spawns a child exiting with code 3, and asks is_alive until it says false", "it then asks is_alive again and waits for the child"])
  step(ctx, "is_alive says false again, and the wait gives 3", "st_pg_wait_after_alive")
  vm_noops(ctx, ["a program that listens on a port, takes a connection, closes its end first and ends", "another program listens on that port straight after, and a third tries a port its own listener holds"])
  step(ctx, "the second gets the port, and the third is refused", "st_pg_listen_after_close")
  vm_noops(ctx, ["a program that asks dns_resolve for a name, one that first declares tcp_allow_remote(), and a DNS server on this machine", "each resolves names and connects"])
  step(ctx, "the first is stopped, the second resolves names and connects to one, and dns_query reads the server's records, its NXDOMAIN and its CNAME, and gives no addresses where nothing answers", "st_pg_tcp_remote")
  vm_noops(ctx, ["a connection whose peer writes one byte, waits for an answer, then closes", "tcp_read_status reads it three times"])
  step(ctx, "it gives the byte as data, a wait while the peer waits, and the end once the peer has closed", "st_pg_tcp_read_status")
  vm_noops(ctx, ["a directory holding a cmd.exe that prints planted, and a program run from it that captures cmd /c echo from the system"])
  step(ctx, "it prints from the system, and the cmd.exe in the directory does not run", "st_pg_exec_search")
  vm_noops(ctx, ["a directory with a four-byte file written first, a seven-byte file written 50 ms later, and a subdirectory", "dir_files reads it, and a path with no directory at it"])
  step(ctx, "it gives the two files by name with their sizes, the later one's written the larger, no subdirectory, and [] for the missing path", "st_pg_dir_files")
  vm_noops(ctx, ["a path whose file and directory are not there, a file of bytes, and 4 threads that each append 200 lines to one file", "each appends"])
  step(ctx, "the file is made and holds what was appended in order, the bytes are whole, the 800 lines are all there whole, and appending to a directory gives false", "st_pg_append_file")
  vm_noops(ctx, ["a program, not a quiet file, that calls runtime_state, mem_load and rt_alloc, and another that names rt_str_alloc as apply's function", "each is built or interpreted"])
  step(ctx, "each is refused before anything runs, naming every such call", "st_pg_runtime_only")
  vm_noops(ctx, ["a program that makes the name rt_str_alloc at run time and applies it", "it runs on either engine"])
  step(ctx, "the lines before it run, and it stops as for a name nothing declares, the same on both", "st_pg_runtime_by_name_made")
  vm_noops(ctx, ["a NaN made by dividing 0.0 by itself, and ordinary floats, ints and strings", "each is compared with == != < <= > and >="])
  step(ctx, "every comparison with the NaN is false but !=, which is true, and the others compare as before", "st_pg_nan_order")
  vm_noops(ctx, ["a class defining only <=, two classes each defining > with a different answer, and a class defining only <", "objects of each are compared"])
  step(ctx, "<= is sent as itself, a > b goes to a's class, and > on the class with only < stops the program naming > and the class", "st_pg_operator_dispatch")
  vm_noops(ctx, ["a class declaring a method named ==", "the program is built or interpreted"])
  step(ctx, "it is refused before anything runs, saying objects compare by identity", "st_pg_eq_method")
  vm_noops(ctx, ["cpu_cycles read before and after some work, across a 200 ms sleep, and around four times the work", "the counts are compared"])
  step(ctx, "the count grows with work, a sleep adds less than a tenth of what the work did, and four times the work counts no more than about eight times as many cycles", "st_pg_cpu_cycles")
  vm_noops(ctx, ["clock_ms read across a 50 ms sleep, and 1000 times in a row", "the readings are compared"])
  step(ctx, "the sleep moved it forward by at least 50, no reading is less than the one before, and now_ms is the wall clock", "st_pg_clock_ms")
  vm_noops(ctx, ["a match with the cases *.txt, img* and *fred*, in a program that includes nothing, and glob_match called with * and ? patterns", "names, a name with a two-byte character and an int are matched"])
  step(ctx, "each takes the case its glob describes, ? is one character, and the int matches no glob", "st_pg_glob_match")
  vm_noops(ctx, ["host_caps() read in a native build and in a browser", "the lists are compared"])
  step(ctx, "the native one is x64, subprocess, tcp and fs, and the browser's is wasm alone", "st_pg_host_caps")
  vm_noops(ctx, ["a chain of 300 next facts with a recursive reach rule, and a rule that leads back to itself", "reach from n0 to n100 and to n250 is solved, and then the rule that leads back to itself"])
  step(ctx, "both reaches have their one answer, and the third stops the program naming the goal, nothing after it running", "st_pg_solve_depth")
  vm_noops(ctx, ["cmd typing a 300 KB file and then echoing its input with findstr, given 300 KB of input", "exec_capture_io runs it with a 60 second timeout"])
  step(ctx, "it succeeds, both outputs are there whole, and it took well under the timeout", "st_pg_io_both")
  vm_noops(ctx, ["not a == b, not a < b, not a == b and false, not a == 1 or true, and the bracketed forms", "each is evaluated with a 1 and b 2"])
  step(ctx, "not applies to the whole comparison, and and and or to the not", "st_pg_not_precedence")
  vm_noops(ctx, ["a call's result, a list element and a bracketed closure, each followed by arguments"])
  step(ctx, "each gives what its closure returns", "st_pg_call_any")
  vm_noops(ctx, ["a program using an undefined variable on line 6, a program dividing 7 by 0, and an operation given a float, a modint and an interval it does not take", "each is built and run"])
  step(ctx, "the first is refused naming line 6, the second stops with division by zero, and the others name the type the operation does not take", "st_pg_error_terms")
  vm_noops(ctx, ["a string opened on line 4 and never closed, a string over three lines followed by a stray ) on line 8, and numbers with exponents", "each is built"])
  step(ctx, "the first is refused at line 4 saying the string is never closed, the second names line 8, and 1e3, 2.5e-2 and 4E+1 are numbers", "st_pg_lexer")
  vm_noops(ctx, ["a program that calls tokenize, which nothing it reaches declares", "v2 builds it"])
  step(ctx, "the build succeeds and warns that tokenize is called and nothing declares it", "st_pg_undeclared_warning")
  vm_noops(ctx, ["a loop on line 7 whose body sets its counter s, then counts an inner loop with s, and a loop whose inner loops move its index on", "v2 builds each"])
  step(ctx, "the first build warns naming line 7 and s, the second warns of nothing, and both programs run as written", "st_pg_loop_rebind_warning")
  vm_noops(ctx, ["a program indexing with a float, a sqrt and a string, and passing floor of a float to a function that indexes with it through another, and a program whose indexes are ints, modints, parameters, elements and a name that is not always a float"])
  step(ctx, "the first build warns of each, naming its line and the call, the second warns of nothing, and the first runs until its first float index", "st_pg_index_warning")
  vm_noops(ctx, ["an object named w1, in a program that declares nothing and in one that declares object_names_explicit()", "each reads it through object_named, reads w1.color or w1.length from the string, and deletes the object given the string"])
  step(ctx, "object_named gives the object in both; without the declaration the string reaches the object and deletes it, and with it the string is only a string and deletes nothing", "st_pg_object_names")
  vm_noops(ctx, ["an action whose step binds a text holding a comma and an int, and a closure bound to it", "the plan is made and activated"])
  step(ctx, "the step's values are the text whole and the int as an int, its label writes both, and the closure is given exactly those two values", "st_pg_plan_steps")
  vm_noops(ctx, ["8000 and 16000 virtual files written, read, and appended to one file 16 bytes at a time", "each phase is timed"])
  step(ctx, "four times the files or appends take no more than about eight times as long", "st_pg_vfs_scale")
  vm_noops(ctx, ["a program the interpreter has run", "the cache of the runtime's declarations is read"])
  step(ctx, "its key names each runtime file with its size and time of writing, and it ends with the count of the functions it holds", "st_pg_runtime_cache")
  vm_noops(ctx, ["a function with a require and an ensure, called once and then 100000 times", "contract_holds is solved for it after the first call and after the rest"])
  step(ctx, "there are two facts, the require's and the ensure's, both times", "st_pg_contract_facts_once")
  vm_noops(ctx, ["4000 facts, a rule pairing them, a store of two colours, and rules whose bodies have 200 and 800 goals", "solve_up_to and solve_up_to_in ask for the first few solutions of each"])
  step(ctx, "each gives solve's first solutions in solve's order, none past n, the pair rule's first two of its 16 million, and the 800-goal body in no more than about eight times the 200-goal body's time", "st_pg_solve_up_to")
  vm_noops(ctx, ["chains of 500 and 1000 next facts and a recursive reach rule", "reach from the first to the last is solved on each"])
  step(ctx, "the four times longer takes no more than about eight times as long", "st_pg_solve_chain_scale")
  vm_noops(ctx, ["cpu_count, cpu_times and memory_status, cpu_times read 100 ms apart", "each is called"])
  step(ctx, "there is at least one processor, the times grow between the readings, and the free memory is no more than the total", "st_pg_machine_state")
  vm_noops(ctx, ["a store with one fact added twice through two holders, rules declared in a named store and read with from, two stores each holding q, a store solved into twice, a plan from a store's facts, a contract checked, the default store cleared and a named store deleted"])
  step(ctx, "each prints what spec 1.13 says of stores", "st_pg_logic_stores")
  vm_noops(ctx, ["a program with `using kb as planner do ... end`", "it is compiled"])
  step(ctx, "the error names the unknown role, and nothing runs", "st_pg_using_unknown_role")
  vm_noops(ctx, ["2,000 and then 8,000 rules added, a bound goal solved before and after 20,000 rules of another predicate are added, and goals with 2,000 and 8,000 solutions"])
  step(ctx, "four times the rules take no more than about eight times as long, the other predicate's rules cost the goal little, and four times the solutions take no more than about eight times as long", "st_pg_logic_scale")
  vm_noops(ctx, ["a chain of two builds and 10 goals each needing the second, a goal no action reaches, two routes of different cost, and 40 then 160 goals timed", "plan is asked for each"])
  step(ctx, "the builds come first and every goal is met, the unreachable goal gives [], the cheaper route is taken, and four times the goals take no more than about 32 times as long", "st_pg_plan_scale")
  step(ctx, "it stops at chr, naming the require clause", "st_tx_chr_float")
  step(ctx, "add, multiply and subtract give the sum, product and difference, and the others give 0 or true", "st_pg_shims")
  step(ctx, "it gives standard output, standard error only from the failure, and a peak above 0", "st_pg_exec_peak")
  step(ctx, "the third file's statements run once, before the files that include it", "st_pg_include_once")
  step(ctx, "both engines print what those calls give", "st_ea_anywhere")
  step(ctx, "both engines report that it cannot be read", "st_ea_no_program")
  step(ctx, "both engines report that the include cannot be read, and nothing of the program runs", "st_ea_no_include")
  vm_noops(ctx, ["a program whose statements are a call whose value nothing uses, a sum, a variable, and last a string and an int", "a function taking two arguments, and one taking one and rest, each called with too few or too many, and a closure called with nine", "the program is compiled", "a closure taking two parameters, called with two and then with one", "apply and parallel_map of a function taking two arguments and of one taking one and rest", "apply of a function taking two arguments, with one", "closures taking two parameters, none and a list, each spawned with that many arguments", "each thread's result is taken", "a closure taking two parameters, spawned with one"])
  vm_noops(ctx, ["a let rebinding a variable to a call that takes it, of a closure held in a parameter, of a function ending in rest with further arguments, and of the program's own max", "a let rebinding a variable to a call of a function taking one argument, given three"])
  step(ctx, "the closure is called, rest holds the further arguments, and the program's max runs, each as through a new name", "st_pg_let_giving_calls")
  vm_noops(ctx, ["a virtual file that was never written, and one that was written and then deleted", "vfs_exists of each is a condition, and is printed"])
  step(ctx, "the missing file takes the false branch and the written one the true, and it gives the bools false and true", "st_pg_vfs_exists")
  vm_noops(ctx, ["arguments that are plain, hold a space, end in a backslash after a space, hold a quote after a backslash, are empty, and end in two backslashes", "a program that prints its argv is run with them"])
  step(ctx, "it has eight arguments, each unchanged", "st_pg_argv_round_trip")
  vm_noops(ctx, ["facts, queries, a rule declaration and a plan whose constants begin with capital letters, and variables made by logic_var and by capitalised names in the declaration"])
  step(ctx, "a capitalised constant matches only itself, a variable matches any constant, and a logic variable is a value of its own type, equal to another of the same name and to no string", "st_pg_logic_constants")
  vm_noops(ctx, ["a store of word counts and sections, rules using gt, le, ge, lt and not, and rule declarations with numbers in them", "they are solved, and facts are taken out with fact_remove_in"])
  step(ctx, "the comparisons and the not answer as they say, a number in a declaration is an int, and a fact taken out is gone from every rule that read it, the store's index still finding the rest", "st_pg_logic_builtins")
  step(ctx, "a comparison of a variable still unbound, and a not whose unbound variable a later goal uses, each stop the program, saying so, and nothing after runs", "st_pg_logic_stops")
  step(ctx, "both engines refuse it, naming the function and both numbers, as for any call, and nothing runs", "st_pg_let_giving_arity")
  step(ctx, "the call's value is not printed, and each bare value is, the last ones included", "st_pg_program_value")
  step(ctx, "both engines refuse it, naming the function and both numbers, and that a closure takes at most 8, and nothing runs", "st_pg_arity_named")
  vm_noops(ctx, ["a closure taking one parameter and rest, called through a variable with one and with three arguments, and on a thread with two", "a closure taking one parameter and rest, called with none"])
  step(ctx, "rest holds the further arguments as a list each time, as for a function", "st_pg_closure_rest")
  step(ctx, "it stops as a failed precondition of the closure, saying it takes at least 1 argument", "st_pg_closure_rest_few")
  step(ctx, "the first call gives its value, and the second stops the program as a failed precondition of the closure, naming both numbers", "st_pg_arity_closure")
  step(ctx, "each gives its value, rest holding the further arguments as a list", "st_pg_arity_apply")
  step(ctx, "it stops as a failed precondition of the function, naming it and both numbers", "st_pg_arity_apply_wrong")
  step(ctx, "each is what its closure returned for those arguments", "st_cc_thread_args")
  step(ctx, "it stops before the thread starts, as a failed precondition of the closure, naming both numbers", "st_cc_thread_args_wrong")
  return true
end

let ctx = ctx_new()
register_values_and_memory_steps(ctx)
register_worlds_steps(ctx)
print("engine: " + vm_engine())
let names = vm_features()
let features = []
let i = 0
while i < list_len(names) do
  let features = list_push(features, "spec_library/values_and_memory/" + names[i] + ".feature")
  let i = i + 1
end
let args = argv()
let rest = []
let i = 1
while i < list_len(args) do
  let rest = list_push(rest, args[i])
  let i = i + 1
end
run_suite(ctx, features, rest)
