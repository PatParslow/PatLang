# ---- bounded_memory.feature (1.6) ----

# The two runs of a fixture, N and 10N: the longer may peak at most 10% higher.
make a function called vm_not_growing takes ctx, label, name, kind, n returns ok
  let args_n = [n.to_s]
  let args_10n = [(n * 10).to_s]
  if kind != "" then
    let args_n = [kind, n.to_s]
    let args_10n = [kind, (n * 10).to_s]
  end
  let short = vm_peak(ctx, name, args_n)
  let long = vm_peak(ctx, name, args_10n)
  if (short <= 0) or (long <= 0) then
    return expect(ctx, label + " (no measurement: the program did not run to its end)", false, true)
  end
  let growth = ((long - short) * 100) / short
  return expect(ctx, label + ": " + vm_mb(short) + " MB at " + n + ", " + vm_mb(long) + " MB at " + (n * 10) + ", grows under 10%", growth < 10, true)
end

make a function called st_bm_loops takes ctx returns ok
  let kinds = ["str_concat", "str_grow", "list3", "list_push", "list_set_older", "bigint", "rational", "complex", "interval", "object", "sb", "vec", "bool_array", "closure", "exec", "read_file"]
  let all = true
  let i = 0
  while i < list_len(kinds) do
    let n = 2000
    if kinds[i] == "exec" then
      let n = 20
    end
    if not vm_not_growing(ctx, kinds[i], "bm_loops", kinds[i], n) then
      let all = false
    end
    let i = i + 1
  end
  return all
end

make a function called st_bm_named_delete takes ctx returns ok
  return vm_not_growing(ctx, "named objects deleted each iteration", "bm_named_delete", "", 2000)
end

make a function called st_bm_named_kept takes ctx returns ok
  return vm_expect(ctx, "w0's field is still red after 100 more objects", "bm_named_kept", "red")
end

