# Whether the threads meet depends on timing: either outcome is the defined
# one, and anything else (a contract failure, a block released twice) is not.
make a function called st_cc_shared_cell takes ctx returns ok
  let out = vm_run(ctx, "cc_shared_cell")
  let whole = out == "200000" + nl() + "200000"
  let stopped = contains_text(out, "was changed by one thread while another was using it") and (not contains_text(out, "contract violation"))
  return expect(ctx, "every push, or the stop that names the rule (got " + out + ")", whole or stopped, true)
end

make a function called st_pg_argv_round_trip takes ctx returns ok
  let bs = chr(92)
  let q = chr(34)
  let args = ["plain", "two words", "C:" + bs + "Program Files" + bs + "dir" + bs, "next", "say " + bs + q + "hi", "", "a" + bs + bs + q + "b", "tail" + bs + bs]
  let b = sb_new()
  sb_push(b, "8")
  let i = 0
  while i < list_len(args) do
    sb_push(b, nl() + "<" + args[i] + ">")
    let i = i + 1
  end
  return expect(ctx, "each argument arrives unchanged", vm_run_on(ctx, vm_engine(), "vi_argv_echo", args), sb_str(b))
end

