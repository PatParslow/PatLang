make a function called st_engines_agree takes ctx returns ok
  let names = ["vi_unit", "vi_max_min", "vi_ast", "vi_append_values", "rt_new_extra", "vi_shadow", "bm_named_many", "vo_member_by_name", "vi_bnot", "rt_bnot_float", "vi_no_return", "vi_exec_stderr", "rt_include", "vo_type_of", "vo_new_object", "vo_keeps_class", "vo_methods", "int_extremes", "int_mid", "int_leave_return", "int_below", "int_division", "int_mul_overflow", "ev_operator_method", "ev_raises", "ev_int_order", "ev_no_change", "ev_no_reentry", "ev_ordinary", "ev_no_handler", "ev_raises_result", "vi_list_set", "vi_list_push", "vi_list_eq", "vi_object_shared", "vi_object_eq", "vi_sb", "vi_vec", "vi_bool_array", "vi_closure_captures", "vi_fibers", "vi_threads", "vi_syntax", "vi_syntax_included", "rt_fiber_finished", "rt_fiber_no_fiber", "rt_thread_taken", "bm_named_kept", "vi_interval", "rt_interval_backwards", "rt_interval_div"]
  let all = true
  let i = 0
  while i < list_len(names) do
    let a = vm_run_on(ctx, "interp", names[i], [])
    let b = vm_run_on(ctx, "v2", names[i], [])
    if not expect(ctx, names[i] + ": the interpreter and v2 print the same", a == b, true) then
      let all = false
    end
    let i = i + 1
  end
  return all
end

