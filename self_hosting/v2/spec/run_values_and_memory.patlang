  let a = vm_ct_reports(ctx, "ct_arith", r, "arithmetic on a secret integer")
  let b = expect(ctx, "ct_arith: an address is computed from a secret", contains_text(r[0], "an address is computed from a secret"), true)
  return a and b
end

