make a function called st_pg_listen_after_close takes ctx returns ok
  let out = split_lines(vm_run_on(ctx, vm_engine(), "rt_listen_after_close", ["first"]))
  let a = expect(ctx, "the first program took a connection and closed its end first", [list_len(out), list_get(out, 1)], [2, "x"])
  let port = "" + list_get(out, 0)
  let b = expect(ctx, "the port is free once that program has ended", vm_run_on(ctx, vm_engine(), "rt_listen_after_close", ["listen", port]), port)
  let c = expect(ctx, "a port a listener holds is still refused", vm_run_on(ctx, vm_engine(), "rt_listen_after_close", ["taken"]), "-1")
  return a and b and c
end

make a function called st_pg_tcp_remote takes ctx returns ok
  let names = vm_run_on(ctx, vm_engine(), "rt_tcp_remote", ["names"])
  let a = expect(ctx, "dns_resolve before tcp_allow_remote() stops the program, saying so (got " + names + ")", str_contains(names, "dns_resolve: the program has not declared tcp_allow_remote()") and (not str_contains(names, "not reached")), true)
  let b = expect(ctx, "after it, localhost and an address resolve, a name connects, host_caps says tcp_remote", vm_run_on(ctx, vm_engine(), "rt_tcp_remote", ["allowed"]), "[127.0.0.1]" + nl() + "[192.0.2.1]" + nl() + "true" + nl() + "true")
  # the DNS server, on the side of the machine the engine runs on: WSL's
  # loopback is its own
  let responder = path_absolute("self_hosting/v2/spec/fixtures/dns_responder.py")
  let port_file = path_absolute(spec_out() + "/dns_port_" + vm_engine() + ".txt")
  if file_exists(port_file) == true then
    remove_file(port_file)
  end
  if vm_engine() == "linux" then
    let pid = spawn("wsl", "-d", "Ubuntu-24.04", "-e", "python3", v2_wsl_path(responder), v2_wsl_path(port_file), "3")
  else
    let pid = spawn("py", "-3", "-I", responder, port_file, "3")
  end
  while (file_exists(port_file) != true) and is_alive(pid) do
    sleep_ms(20)
  end
  let c = expect(ctx, "the DNS server started", file_exists(port_file) == true, true)
  if not c then
    return false
  end
  let port = read_file(port_file)
  let d = expect(ctx, "dns_query: two A records, none for a name not there, a CNAME followed", vm_run_on(ctx, vm_engine(), "rt_tcp_remote", ["query", port]), "[192.0.2.7, 192.0.2.8]" + nl() + "[]" + nl() + "[192.0.2.7]")
  # three queries answered, the server has ended: nothing answers on its port
  wait(pid)
  let e = expect(ctx, "dns_query where nothing answers gives no addresses", vm_run_on(ctx, vm_engine(), "rt_tcp_remote", ["silent", port]), "[]")
  return a and b and c and d and e
end

