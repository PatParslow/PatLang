  return a and b
end

make a function called st_pg_exec_peak takes ctx returns ok
  let out = vm_run(ctx, "vi_exec_peak")
  let a = expect(ctx, "standard output when it exits 0", contains_text(out, "ok:to out"), true)
  let b = expect(ctx, "no standard error when it exits 0", contains_text(out, "quiet"), false)
  let c = expect(ctx, "standard output when it fails", contains_text(out, "failed:to out"), true)
  let d = expect(ctx, "standard error when it fails", contains_text(out, "to err"), true)
  # the commands' own output has line ends in it, so lines are counted, not numbered
  let lines = split_lines(out)
  let trues = 0
  let falses = 0
  let i = 0
  while i < list_len(lines) do
    if lines[i] == "true" then
      let trues = trues + 1
    end
    if lines[i] == "false" then
      let falses = falses + 1
    end
    let i = i + 1
  end
  let e = expect(ctx, "a peak above 0 both times", (trues == 3) and (falses == 0), true)
  ctx_set(ctx, "pg_exec_peak_out", out)
  return a and b and c and d and e
end

make a function called st_pg_exec_tree takes ctx returns ok
  if vm_engine() == "linux" then
    # wait4 gives a child's peak with the children it waited for: the
    # measured peak's half can be checked, the command's own cannot (spec 1.13)
    return expect(ctx, "the child's memory in the measured peak (Linux gives no command's own apart)", contains_text(ctx_get(ctx, "pg_exec_peak_out"), "tree:true|on Linux"), true)
  end
  return expect(ctx, "the child's memory in the measured peak, not in the command's own", contains_text(ctx_get(ctx, "pg_exec_peak_out"), "tree:true|true"), true)
end

make a function called st_pg_exec_measured takes ctx returns ok
  let out = ctx_get(ctx, "pg_exec_peak_out")
  let a = expect(ctx, "the two outputs apart, the exit as false, a peak above 0", contains_text(out, "measured:true|true|false|true"), true)
  let b = expect(ctx, "true for the command that succeeds", contains_text(out, "|true" + nl() + "true" + nl() + "tree:"), true)
  return a and b
end

