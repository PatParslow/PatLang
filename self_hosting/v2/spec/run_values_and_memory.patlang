# Runs spec_library/values_and_memory's @language features
# (docs/spec/values-and-memory.md, Part 1) against one engine:
#
#   pat --ir-run self_hosting/v2/spec/run_values_and_memory.patlang [interp|v2|both|rust]
#
# interp runs each fixture with the v2 interpreter (self_hosting/v2/interp.patlang,
# itself built by v2); v2 compiles it with the new compiler
# (self_hosting/v2/compile.patlang) and runs the executable; both compares them;
# rust runs it with pat --ir-run, the interpreter this replaces. Each
# scenario's fixture is in self_hosting/v2/spec/fixtures/, its expected
# output here. engines_agree.feature runs every fixture on both engines.
include "../../lib/includes.patlang"
include "../../lib/gherkin.patlang"

make a function called vm_engine returns e
  let a = argv()
  if list_len(a) > 0 then
    return a[0]
  end
  return "interp"
end

# The feature files a run covers: a feature named after the engine runs alone.
make a function called vm_features returns names
  let a = argv()
  if list_len(a) > 1 then
    return [a[1]]
  end
  if vm_engine() == "both" then
    return ["engines_agree"]
  end
  return ["values_are_objects", "integers", "operator_events", "value_and_identity", "bounded_memory", "concurrency", "syntax_definitions", "math", "text", "intervals", "programs"]
end

make a function called vm_pat returns p
  return "rust-runtime/target/release/pat.exe"
end

make a function called vm_fixture takes name returns path
  return "self_hosting/v2/spec/fixtures/" + name + ".patlang"
end

# The executable the v2 engine builds for a fixture.
make a function called vm_exe takes name returns path
  return "self_hosting/build/v2_spec_" + name + ".exe"
end

# Output with carriage returns dropped and trailing blank lines removed.
make a function called vm_clean takes text returns out
  let b = sb_new()
  let i = 0
  let n = text.length
  while i < n do
    let c = char_code(text, i)
    if c != 13 then
      sb_push(b, chr(c))
    end
    let i = i + 1
  end
  return str_trim(sb_str(b))
end

# Builds a fixture with the v2 compiler, once per run; "" on success, else
# the compiler's output.
make a function called vm_v2_build takes ctx, name returns err
  let done = ctx_get(ctx, "vm_built_" + name)
  if type_of(done) == "string" then
    return done
  end
  let err = vm_v2_build_now(name)
  ctx_set(ctx, "vm_built_" + name, err)
  return err
end

make a function called vm_v2_build_now takes name returns err
  let out = exec_capture(vm_pat(), "--ir-run", "self_hosting/v2/compile.patlang", vm_fixture(name), vm_exe(name))
  # the compiler prints "v2: OUT" when it wrote the executable
  if contains_text(out, "v2: " + vm_exe(name)) then
    return ""
  end
  return "v2 build failed: " + vm_clean(out)
end

# The v2 interpreter, built once per run.
make a function called vm_interp_exe returns path
  return "self_hosting/build/v2_interp.exe"
end

make a function called vm_interp_build takes ctx returns err
  let done = ctx_get(ctx, "vm_built_interp")
  if type_of(done) == "string" then
    return done
  end
  let out = exec_capture(vm_pat(), "--ir-run", "self_hosting/v2/compile.patlang", "self_hosting/v2/interp.patlang", vm_interp_exe())
  let err = ""
  if not contains_text(out, "v2: " + vm_interp_exe()) then
    let err = "interpreter build failed: " + vm_clean(out)
  end
  ctx_set(ctx, "vm_built_interp", err)
  return err
end

# A fixture run on an engine: [its output, its peak working set], or the build's
# error as its output with a peak of -1.
make a function called vm_exec_on takes ctx, engine, name, args returns r
  if engine == "v2" then
    let err = vm_v2_build(ctx, name)
    if err != "" then
      return [err, 0 - 1]
    end
    return exec_peak_memory(vm_exe(name), args)
  end
  let full = [vm_fixture(name)]
  if engine == "rust" then
    let full = ["--ir-run", vm_fixture(name)]
  end
  let i = 0
  while i < list_len(args) do
    let full = list_push(full, args[i])
    let i = i + 1
  end
  if engine == "rust" then
    return exec_peak_memory(vm_pat(), full)
  end
  let err = vm_interp_build(ctx)
  if err != "" then
    return [err, 0 - 1]
  end
  return exec_peak_memory(vm_interp_exe(), full)
end

make a function called vm_run_on takes ctx, engine, name, args returns out
  return vm_clean(list_get(vm_exec_on(ctx, engine, name, args), 0))
end

make a function called vm_run takes ctx, name returns out
  return vm_run_on(ctx, vm_engine(), name, [])
end

# Peak working set, in bytes, of a fixture run with these arguments, or -1
# unless the run reached its end (printed "done"): a program that stopped
# early proves nothing about its memory.
make a function called vm_peak takes ctx, name, args returns bytes
  let r = vm_exec_on(ctx, vm_engine(), name, args)
  if vm_clean(list_get(r, 0)) != "done" then
    return 0 - 1
  end
  return list_get(r, 1)
end

make a function called vm_mb takes bytes returns mb
  return floor(bytes / 1048576)
end

make a function called vm_expect takes ctx, label, name, expected returns ok
  return expect(ctx, label, vm_run(ctx, name), expected)
end

make a function called nl returns s
  return chr(10)
end

make a function called st_vm_noop takes ctx returns ok
  return true
end

make a function called vm_noops takes ctx, texts returns done
  let i = 0
  while i < list_len(texts) do
    step(ctx, texts[i], "st_vm_noop")
    let i = i + 1
  end
  return true
end

