# Runs spec_library/values_and_memory's @language features
# (docs/spec/values-and-memory.md, Part 1) against one engine:
#
#   self_hosting/build/v2_interp.exe self_hosting/v2/spec/run_values_and_memory.patlang [interp|v2|both]
#
# interp runs each fixture with the v2 interpreter (self_hosting/v2/interp.patlang,
# itself built by v2); v2 compiles it with the native v2 compiler
# (self_hosting/lib/v2_engines.patlang) and runs the executable; both compares
# them. Each
# scenario's fixture is in self_hosting/v2/spec/fixtures/, its expected
# output here. engines_agree.feature runs every fixture on both engines.
include "../../lib/includes.patlang"
include "../../lib/gherkin.patlang"
include "../../lib/v2_engines.patlang"

make a function called vm_engine returns e
  let a = argv()
  if list_len(a) > 0 then
    return a[0]
  end
  return "interp"
end

# The feature files the engine's run covers (spec_library/values_and_memory/
# NAME.feature): engines_agree for both. A feature file's path after the
# engine on the command line runs alone (run_suite).
make a function called vm_features returns names
  if vm_engine() == "both" then
    return ["engines_agree"]
  end
  return ["values_are_objects", "integers", "operator_events", "value_and_identity", "bounded_memory", "concurrency", "syntax_definitions", "math", "text", "intervals", "modular_integers", "constant_time", "curve25519", "programs", "worlds"]
end

make a function called vm_fixture takes name returns path
  return "self_hosting/v2/spec/fixtures/" + name + ".patlang"
end

# The executable the v2 engine builds for a fixture.
make a function called vm_exe takes name returns path
  return spec_out() + "/v2_spec_" + name + ".exe"
end

# Output with carriage returns dropped and trailing blank lines removed.
make a function called vm_clean takes text returns out
  let b = sb_new()
  let i = 0
  let n = text.length
  while i < n do
    let c = char_code(text, i)
    if c != 13 then
      sb_push(b, chr(c))
    end
    let i = i + 1
  end
  return str_trim(sb_str(b))
end

# Builds a fixture with the v2 compiler, once per run; "" on success, else
# the compiler's output.
make a function called vm_v2_build takes ctx, name returns err
  let done = ctx_get(ctx, "vm_built_" + name)
  if type_of(done) == "string" then
    return done
  end
  let err = vm_v2_build_now(name)
  ctx_set(ctx, "vm_built_" + name, err)
  return err
end

make a function called vm_v2_build_now takes name returns err
  let r = v2_compile([vm_fixture(name), vm_exe(name)])
  let out = r[0]
  # the compiler prints "v2: OUT" when it wrote the executable
  if contains_text(out, "v2: " + vm_exe(name)) then
    return ""
  end
  # how it ended and the phases it finished, so a failure says where it stopped
  return "v2 build failed (exited 0: " + r[1] + "; phases: " + vm_clean(read_file(vm_exe(name) + ".progress")) + "): " + vm_clean(out)
end

# The v2 interpreter. The runner runs on it, and Windows won't replace a
# running executable, so self_hosting/v2/tools/gates.sh builds it first.
make a function called vm_interp_exe returns path
  return v2_interpreter()
end

make a function called vm_interp_build takes ctx returns err
  if file_exists(vm_interp_exe()) then
    return ""
  end
  return "no interpreter at " + vm_interp_exe() + ": build it with self_hosting/v2/tools/gates.sh"
end

# A fixture run on an engine: [its output, its peak working set], or the build's
# error as its output with a peak of -1. With fixed, on Linux, at fixed
# addresses (v2_linux_run_unrandomised), so two runs' peaks compare.
make a function called vm_exec_on takes ctx, engine, name, args, fixed returns r
  if engine == "linux" then
    # built with --linux and run under WSL through linux_peak (itself a Linux
    # build), which gives the fixture's output and, on its last line, the
    # fixture's peak resident set: wsl.exe's own peak would say nothing
    let helper = spec_out() + "/v2_linux_peak"
    if type_of(ctx_get(ctx, "vm_built_linux_peak")) != "string" then
      let hb = v2_compile(["self_hosting/v2/spec/linux_peak.patlang", helper, "--linux"])
      if contains_text(hb[0], "v2: " + helper) then
        ctx_set(ctx, "vm_built_linux_peak", "")
      else
        ctx_set(ctx, "vm_built_linux_peak", "v2 --linux build of linux_peak failed: " + vm_clean(hb[0]))
      end
    end
    if ctx_get(ctx, "vm_built_linux_peak") != "" then
      return [ctx_get(ctx, "vm_built_linux_peak"), 0 - 1]
    end
    let key = "vm_built_linux_" + name
    let exe = spec_out() + "/v2_linux_" + name
    if type_of(ctx_get(ctx, key)) != "string" then
      let b = v2_compile([vm_fixture(name), exe, "--linux"])
      if contains_text(b[0], "v2: " + exe) then
        ctx_set(ctx, key, "")
      else
        ctx_set(ctx, key, "v2 --linux build failed: " + vm_clean(b[0]))
      end
    end
    if ctx_get(ctx, key) != "" then
      return [ctx_get(ctx, key), 0 - 1]
    end
    let argfile = v2_linux_args_file(args, spec_out() + "/v2_linux_args_" + name + ".txt")
    let run_args = [v2_wsl_path(exe), v2_wsl_path(argfile)]
    if fixed then
      let run = v2_linux_run_unrandomised(helper, run_args)
    else
      let run = v2_linux_run(helper, run_args)
    end
    let lines = split_lines(vm_clean(run[0]))
    let peak = 0 - 1
    let body = sb_new()
    let k = 0
    while k < list_len(lines) do
      if str_starts_with(lines[k], "PEAK=") and (k == list_len(lines) - 1) then
        let peak = to_num(substr(lines[k], 5, lines[k].length - 5))
      else
        sb_push(body, lines[k])
        sb_push(body, chr(10))
      end
      let k = k + 1
    end
    return [sb_str(body), peak]
  end
  if engine == "v2" then
    let err = vm_v2_build(ctx, name)
    if err != "" then
      return [err, 0 - 1]
    end
    return exec_peak_memory(vm_exe(name), args)
  end
  let full = [vm_fixture(name)]
  let i = 0
  while i < list_len(args) do
    let full = list_push(full, args[i])
    let i = i + 1
  end
  let err = vm_interp_build(ctx)
  if err != "" then
    return [err, 0 - 1]
  end
  return exec_peak_memory(vm_interp_exe(), full)
end

make a function called vm_run_on takes ctx, engine, name, args returns out
  return vm_clean(list_get(vm_exec_on(ctx, engine, name, args, false), 0))
end

make a function called vm_run takes ctx, name returns out
  return vm_run_on(ctx, vm_engine(), name, [])
end

# Peak working set, in bytes, of a fixture run with these arguments, or -1
# unless the run reached its end (printed "done"): a program that stopped
# early proves nothing about its memory.
make a function called vm_peak takes ctx, name, args returns bytes
  let r = vm_exec_on(ctx, vm_engine(), name, args, true)
  if vm_clean(list_get(r, 0)) != "done" then
    return 0 - 1
  end
  return list_get(r, 1)
end

make a function called vm_mb takes bytes returns mb
  return floor(bytes / 1048576)
end

make a function called vm_expect takes ctx, label, name, expected returns ok
  return expect(ctx, label, vm_run(ctx, name), expected)
end

make a function called nl returns s
  return chr(10)
end

make a function called st_vm_noop takes ctx returns ok
  return true
end

make a function called vm_noops takes ctx, texts returns done
  let i = 0
  while i < list_len(texts) do
    step(ctx, texts[i], "st_vm_noop")
    let i = i + 1
  end
  return true
end

