# The constant-time check run on a fixture: [what it printed, whether it exited 0].
make a function called vm_ct takes name returns r
  return v2_compile([vm_fixture(name), "--constant-time"])
end

make a function called st_ct_clean takes ctx returns ok
  let r = vm_ct("ct_clean")
  let a = expect(ctx, "the check's output", vm_clean(r[0]), "v2: no value-dependent branch or access")
  let b = expect(ctx, "it exits 0", r[1], true)
  return a and b
end

make a function called vm_ct_reports takes ctx, name, r, wanted returns ok
  let a = expect(ctx, name + ": " + wanted, contains_text(r[0], wanted), true)
  let b = expect(ctx, name + " exits 1", r[1], false)
  return a and b
end

make a function called st_ct_branch takes ctx returns ok
  return vm_ct_reports(ctx, "ct_branch", vm_ct("ct_branch"), "a branch decides on a secret")
end

make a function called st_ct_arith takes ctx returns ok
