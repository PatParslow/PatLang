make a function called st_wd_memory takes ctx returns ok
  return vm_not_growing(ctx, "worlds", "bm_worlds", "", 200)
end

make a function called register_worlds_steps takes ctx returns done
  step(ctx, "the world sees none of the program's, the program sees none of the world's, a second call in the world sees what the first added, and the function is reached by name in the world too", "st_wd_isolation")
  step(ctx, "standard output has only the program's lines, and world_output gives the world's", "st_wd_output")
  step(ctx, "each call gives stopped and the exit code, the world's output has the line and what the stop said, and the program goes on", "st_wd_stop")
  step(ctx, "each fiber sees the facts of the world it was made in", "st_wd_fibers")
  step(ctx, "the thread saw the world's fact", "st_wd_thread")
  step(ctx, "the call gives stopped with code 9, the world's output has both lines, and the program goes on", "st_wd_thread_stop")
  step(ctx, "both print the same lines", "st_wd_by_name_interpreted")
  step(ctx, "the call gives stopped with code 9, thread_poll said the thread had finished, and its result was unit", "st_wd_thread_poll")
  step(ctx, "for each, the peak memory does not grow as more stops end frames", "st_wd_stops_memory")
  step(ctx, "the peak memory does not grow as more paused fibers are freed with their worlds", "st_wd_suspended_memory")
  step(ctx, "each world sees only its own facts, and the inner world's output is in the inner world", "st_wd_nested")
  step(ctx, "the call gives stopped with code 78, and the world's output says the budget of 1000 steps is exhausted", "st_wd_steps")
  step(ctx, "the peak memory does not grow as more worlds are made and freed", "st_wd_memory")
  vm_noops(ctx, ["a program with a fact, a named object, a class, a handler and a virtual file of its own, and a function it reaches by name", "code in a new world looks for each, adds its own, and the program looks again", "a world whose code prints two lines", "the program prints before and after calling it", "worlds whose code stops by a failed require, by exit_with(5) and by a call to a name nothing declares, each after printing a line", "the program calls each", "a fiber made in a world and a fiber made by the program, each reporting the facts it sees", "the program resumes the world's fiber and code in the world resumes the program's", "code in a world that adds a fact and starts a thread that reports it", "the thread's result is taken", "code in a world that starts a thread which prints a line and stops by exit_with(9)", "the code takes the thread's result and prints a line of its own", "a program that declares runtime_functions_by_name(), as one that runs source in a world through the interpreter does, and reaches a runtime function by name in the program and in a world", "it runs on the interpreter and compiled", "code in a world that starts a thread which stops by exit_with(9)", "the code polls the thread until it has finished, then takes its result", "a loop of N iterations that each call code in a new world which holds a list of 1000 ints on each of three frames and then stops, directly, inside a fiber, or on a thread the code started", "a loop of N iterations that each call code in a new world which starts a fiber that holds a list of 1000 ints and yields, and then free the world", "code in a world that makes a second world and calls into it", "each adds a fact and reports what it sees", "a world with a budget of 1000 steps whose code spends a step on every iteration of a loop that never ends", "it is called", "a loop of N iterations that each make a world, call code in it that adds facts, a class and a file, and free it", "it runs for N and for 10N iterations"])
  return true
end

make a function called register_values_and_memory_steps takes ctx returns done
  vm_noops(ctx, ["the values 7, 2^70, 1.5, 6/4, true, the unit value print returns, \"hi\", [1, 2], a closure, sb_new(), vec_new(), bool_array_new(3) and logic_store_new()", "type_of is applied to each", "w = new(\"Widget\", \"w1\")", "type_of(w) is read", "the value 1.5 stored in a list, passed to a function, returned, and read back", "type_of is applied to what was read back", "3.to_s, 3.14.to_s, [1, 2, 3].length, and n.to_s where n is 42", "each is evaluated"])
  step(ctx, "the results are int, bigint, float, rational, bool, unit, string, list, closure, string_builder, vec, bool_array, rule_store", "st_vo_type_of")
  step(ctx, "it is Widget", "st_vo_new_object")
  step(ctx, "it is float, and the value is 1.5", "st_vo_keeps_class")
  step(ctx, "they are \"3\", \"3.14\", 3 and \"42\"", "st_vo_methods")

  vm_noops(ctx, ["9223372036854775807 and 0 - 9223372036854775807 - 1", "type_of is applied to each", "140737488355327 + 10", "type_of is applied", "big = 9223372036854775807 + 1, and back = big - 1", "low = 0 - 9223372036854775807 - 1 - 1", "3 / 1, 6 / 4 and 2^70 / 2^69", "4294967296 * 4294967296", "it is evaluated"])
  step(ctx, "both are int", "st_int_extremes")
  step(ctx, "it is int, and the value is 140737488355337", "st_int_mid")
  step(ctx, "big is bigint with value 9223372036854775808, and back is int with value 9223372036854775807", "st_int_leave_return")
  step(ctx, "it is bigint, and low + 1 is int", "st_int_below")
  step(ctx, "they are int, rational and int", "st_int_division")
  step(ctx, "it is bigint with value 18446744073709551616", "st_int_mul_overflow")

  vm_noops(ctx, ["a class Money with a field cents and a method + taking other, returning a Money with the two amounts' cents summed", "m1 + m2 is evaluated, with 150 and 275 cents", "a class Money whose + is declared `raises money_added`", "a handler `when money_added do ... end` recording event_data", "m1 + m2 is evaluated", "handlers for added_to and added that append event_name and event_data to a log", "3 + 5 is evaluated", "the value of 3 + 5 is 8", "a handler for added that tries to return 0", "a handler for added that adds 1 + 1 and counts how many times it ran", "a handler for added registered with `when added do ... end`", "emit(\"added\", [1, 2, 3]) is called directly", "no handler registered for any event", "3 + 5, 1.5 * 2 and \"a\" + \"b\" are evaluated"])
  step(ctx, "the result is a Money with 425 cents", "st_ev_operator_method")
  step(ctx, "the handler ran once, with event_data [m1, m2, the result]", "st_ev_raises")
  step(ctx, "the log is: added_to [3, 5], added_to [5, 3], added [3, 5, 8]", "st_ev_int_order")
  step(ctx, "the value is 8", "st_ev_no_change")
  step(ctx, "the handler ran once", "st_ev_no_reentry")
  step(ctx, "the same handler runs, with event_data [1, 2, 3]", "st_ev_ordinary")
  step(ctx, "they print as 8, 3 and ab, and 1.5 * 2 is a float", "st_ev_no_handler")

  vm_noops(ctx, ["a = [1, 2, 3] and b = list_set(a, 0, 9)", "both are read", "a list a built by 10 list_push calls, then b = list_push(a, 99) and c = list_push(a, 77)", "all three are read", "[\"x\", \"y\"] and list_push(list_push([], \"x\"), \"y\")", "they are compared with ==", "o = new(\"Widget\", \"w1\"), p = o, and send(p, \"set\", \"color\", \"red\")", "get(o, \"color\") is read", "two objects of class Point, each with x = 1 and y = 2", "b = sb_new(), c = b, sb_push(c, \"hi\")", "sb_str(b) is read", "v = vec_new(), w = v, vec_push(w, 5)", "vec_len(v) is read", "a = bool_array_new(0), b = a, then 100 bool_array_push calls on a", "bool_array_len(b) is read"])
  step(ctx, "a is [1, 2, 3] and b is [9, 2, 3]", "st_vi_list_set")
  step(ctx, "a has 10 elements, b ends in 99, and c ends in 77", "st_vi_list_push")
  vm_noops(ctx, ["a loop of let out = list_push(out, e), where e reads out, at 20,000 and at 40,000 pushes", "a program times them"])
  step(ctx, "twice the pushes take no more than about three times as long", "st_vi_push_scale")
  step(ctx, "the result is true", "st_vi_list_eq")
  step(ctx, "it is \"red\"", "st_vi_object_shared")
  step(ctx, "the result is false, and an object compared with itself is true", "st_vi_object_eq")
  step(ctx, "it is \"hi\"", "st_vi_sb")
  step(ctx, "it is 1", "st_vi_vec")
  vm_noops(ctx, ["a vec holding 1, a list taken from it, then vec_extend with three elements, with an empty list, and with the vec's own contents, and a second vec extended twice with 10000 numbers", "the vecs and the lists taken from them are read"])
  step(ctx, "the first vec holds its elements twice in order, the lists taken earlier are unchanged, and the second vec holds 20000 numbers", "st_vi_vec_extend")
  step(ctx, "it is 100, and a == b is true", "st_vi_bool_array")

  vm_noops(ctx, ["loops of N iterations that each replace a local every iteration with one of these producers:", "each runs for N and for 10N iterations", "a loop that makes new(\"Widget\", \"w\" + i) and calls object_delete on it each iteration", "it runs for N and for 10N iterations", "a loop that makes new(\"Widget\", \"w\" + i) without object_delete, then reads get of the first", "it runs"])
  step(ctx, "no loop's peak memory grows", "st_bm_loops")
  step(ctx, "the peak memory does not grow", "st_bm_named_delete")
  step(ctx, "the first object's fields are still readable after the loop", "st_bm_named_kept")

  vm_noops(ctx, ["a function counter that yields twice and then returns, on a fiber", "a handler for ping that yields when it runs on a fiber", "a fiber that raises ping", "the fiber is resumed, the program raises ping while the fiber waits, and the fiber is resumed again", "a fiber that starts another fiber and resumes it", "each is resumed until it ends", "budgeted blocks over a loop, with a budget of 1 ms, of 0 ms and of a long time", "each is run, and a paused one continued from its handle", "closures returning an int, a string and a list, each on a thread", "8 threads summing different ranges", "each is polled until it has finished, and its result taken", "a fiber that has returned", "it is resumed", "a program that is running on no fiber", "it calls fiber_yield", "a thread whose result has been taken", "thread_result is called for it again", "loops of N iterations that each run one of these to its end:", "each runs for N and for 10N iterations"])
  step(ctx, "each resume gives what it yielded or returned, and it is alive until it has returned", "st_cc_fibers")
  step(ctx, "a block that finishes gives done and its value, one that does not gives paused and a handle, and continuing it reaches the same value", "st_cc_budgeted")
  step(ctx, "each result is what its closure returned", "st_cc_threads")
  step(ctx, "a function that calls 8 others, none of them called before", "st_vm_noop")
  step(ctx, "parallel_map runs it on 16 threads", "st_vm_noop")
  step(ctx, "each thread gives what one thread alone would give", "st_cc_first_call")
  vm_noops(ctx, ["8 threads, each reading its own length of one file 400 times and printing a number of seven copies of its own digit each time", "parallel_map runs them"])
  step(ctx, "every read gives the length asked for, and every number is printed whole", "st_cc_threads_io")
  step(ctx, "the handler ran for the fiber, for the program while the fiber waited, and for the program after", "st_cc_fiber_events")
  step(ctx, "the program stops at that call, naming the require clause", "st_cc_fiber_finished")
  step(ctx, "the program stops at that call, naming the require clause, and fiber_yield's function", "st_cc_fiber_no_fiber")
  step(ctx, "the program stops, saying the result has been taken", "st_cc_thread_taken")
  step(ctx, "no concurrent loop's peak memory grows", "st_cc_memory")

  vm_noops(ctx, ["powers of exact and float numbers, trigonometric functions, the rounding functions, abs, to_fixed, the bit functions, len, byte_length, hash_string, try_read_file, rename_file, copy_file and read_file_b64", "a program prints each"])
  step(ctx, "it prints what the interpreter prints", "st_math_agrees")
  vm_noops(ctx, ["a string with characters of two, three and four bytes", "a program measures, indexes and cuts it, and writes it to a file and reads it back"])
  step(ctx, "each gives what the interpreter gives, and only byte_length and hash_string see its bytes", "st_text_agrees")

  vm_noops(ctx, ["intervals made with interval_make, with int, rational and bigint ends", "a program prints their class, their ends and their sums, differences, products and negations, alone and with real numbers", "interval_make(2, 1)", "it is called", "interval_make(1, 2) / 2", "it is evaluated"])
  step(ctx, "each prints what the rules of spec 1.12 give", "st_iv_agrees")
  step(ctx, "the program stops at that call, naming interval_make's require clause", "st_iv_backwards")
  step(ctx, "the program stops, naming the interval class", "st_iv_div")

  vm_noops(ctx, ["modints made with mod_make, with int and bigint moduli", "a program prints their class, residues and moduli, their sums, differences, products, quotients, powers and negations, alone and with integers, and compares them, and remakes them modulo other moduli", "modints modulo 2^8, 2^32, 2^62 and 2^64", "a program prints their band, bor, bxor, bnot, shl, shr, rotl and rotr", "a SHA-256 written in PatLang on modints modulo 2^32", "a program prints the digests of \"abc\", the empty message, and the 448-bit and 896-bit messages", "mod_make(3, 1)", "mod_make(1, 7) + mod_make(1, 11)", "mod_make(1, 7) + 1.5", "mod_make(1, 7) < mod_make(2, 7), and mod_make(1, 7) % 2", "each is evaluated", "mod_make(1, 8) / mod_make(2, 8)", "mod_make(1, 7) band mod_make(1, 7), and mod_make(1, 256) shl 9"])
  step(ctx, "each prints what the rules of spec 1.14 give", "st_mi_agrees")
  step(ctx, "each prints what the rules of spec 1.14 give for words", "st_mi_words")
  step(ctx, "each is the digest FIPS 180-4 gives", "st_mi_sha256")
  step(ctx, "the program stops at that call, naming mod_make's require clause", "st_mi_small")
  step(ctx, "the program stops at the sum, naming the modint class", "st_mi_moduli")
  step(ctx, "the program stops at the sum with a float, naming the modint class", "st_mi_float")
  step(ctx, "each program stops, naming the modint class", "st_mi_order")
  step(ctx, "the program stops at the quotient, naming the modint class", "st_mi_no_inverse")
  step(ctx, "each program stops at the bit operator, naming the modint class", "st_mi_bits")

  vm_noops(ctx, ["a program that adds, subtracts, multiplies, divides, negates and raises modints to powers modulo 2^255 - 19 and modulo 2^32 * 3, and rotates, shifts and combines words modulo 2^32, comparing them only in asserts", "the constant-time check reads it", "a program with if a == b, for modints a and b", "a program reading a word of a modint's residue from its block, adding 1 to it, and reading memory at it", "a program printing mod_value of a modint"])
  step(ctx, "it reports nothing and exits 0", "st_ct_clean")
  step(ctx, "it reports a branch deciding on a secret, and exits 1", "st_ct_branch")
  step(ctx, "it reports arithmetic on a secret integer and an address computed from a secret, and exits 1", "st_ct_arith")
  step(ctx, "it reports the residue leaving the class, and exits 1", "st_ct_reveal")
  vm_noops(ctx, ["a program that agrees an X25519 secret, makes an Ed25519 key and signs a message, all written in PatLang on modints"])
  step(ctx, "it reports nothing in them and exits 0", "st_ct_curve25519")

  vm_noops(ctx, ["a SHA-512 written in PatLang on modints modulo 2^64", "a program prints the digests of \"abc\", the empty message and the 896-bit message", "X25519 written in PatLang on modints modulo 2^255 - 19", "a program prints its outputs for the vectors of RFC 7748 sections 5.2 and 6.1, after 1 and 1000 iterations", "it computes the shared secret of every case in Wycheproof's x25519_test.json", "Ed25519 written in PatLang on modints modulo 2^255 - 19 and modulo the group order", "a program makes the key and signature of each vector of RFC 8032 section 7.1, and verifies each signature for its message and for an altered one", "it verifies every case in Wycheproof's ed25519_test.json"])
  step(ctx, "each is the digest FIPS 180-4 gives for it", "st_cv_sha512")
  step(ctx, "each is the output RFC 7748 gives", "st_cv_x25519")
  step(ctx, "all 518 shared secrets agree with the cases", "st_cv_x25519_wycheproof")
  step(ctx, "each key and signature is the one RFC 8032 gives, each verifies, and none verifies for the altered message", "st_cv_ed25519")
  step(ctx, "every valid signature is accepted and every invalid one rejected", "st_cv_ed25519_wycheproof")

  vm_noops(ctx, ["a syntax definition with trigger routes, and a rule giving a call for each line", "a syntax definition written on the same line as a statement before it", "a block in that syntax", "a routes block with two lines", "the program runs", "a file with a syntax definition, and a program that includes it and uses the syntax"])
  step(ctx, "each line runs as that call, in order, and the statements after the block run", "st_sx_block")
  step(ctx, "the included file's definition expands the program's block", "st_sx_included")
  step(ctx, "the statement runs, and the block runs as its rule says", "st_sx_inline")

  vm_noops(ctx, ["each @language scenario in spec_library/values_and_memory", "it runs under the interpreter and as a native executable"])
  step(ctx, "both pass, with the same printed output", "st_engines_agree")
  vm_noops(ctx, ["a program whose calls rely on the runtime's declarations: exec_capture, apply and send", "it is started in a directory other than the repository", "a path with no file at it", "that path is given as the program", "a program that includes a path with no file at it", "that program is given"])
  vm_noops(ctx, ["functions ending in an expression, a call, a let, an if, a while, and nothing", "each is called", "a command that writes to standard error and to standard output", "exec_capture runs it", "a program whose two included files both include a third"])
  vm_noops(ctx, ["ints that are zero, positive, negative and the largest there is", "a program applies bnot to each", "a float", "a program applies bnot to it"])
  vm_noops(ctx, ["an object named a1 with a field, and a string holding that name", "a program reads and assigns the field through the string"])
  vm_noops(ctx, ["thousands of named objects, and two objects with one name", "a program reads each by its name and then deletes them", "the same lookups at 1,000 and at 16,000 named objects", "a program times them"])
  step(ctx, "each read finds its own object, a repeated name finds the first until it is deleted, and a deleted name can be used again", "st_bm_named_many")
  vm_noops(ctx, ["ints, floats, rationals and a bigint", "a program applies max and min", "a program with one contract, one rule and one action", "it reads its state and the contract facts"])
  step(ctx, "each gives the larger or the smaller, keeping its kind", "st_max_min")
  step(ctx, "both engines give the program's own facts alone", "st_ea_logic_state")
  vm_noops(ctx, ["rules and ordinary code using AST.Name(args), nested, in a closure, and with a variable named AST"])
  step(ctx, "each gives a list of the name and its arguments, a function can take it, and the variable keeps its meaning", "st_ast_nodes")
  vm_noops(ctx, ["strings also held by another variable, a list, a closure and a caller", "a program appends to them with let s = s + x", "a loop of let s = s + x, at 100,000 and at 200,000 appends"])
  step(ctx, "what else holds each old string still sees it, and numbers and multi-byte characters add as ever", "st_append_values")
  step(ctx, "twice the appends take no more than about three times as long", "st_append_scale")
  vm_noops(ctx, ["a call of new with further arguments after the name"])
  step(ctx, "it stops there, saying that a class declaration is how to inherit", "st_new_extra")
  vm_noops(ctx, ["the program is given", "a program defining to_s, list_len and emit", "it calls them directly, from a closure and by name", "a program and a file it includes that define one function name"])
  step(ctx, "each call reaches the program's function, and the runtime goes on using its own", "st_pg_shadow")
  step(ctx, "both engines report that the name is declared twice, and nothing runs", "st_pg_declared_twice")
  step(ctx, "the larger takes no more than about three times as long", "st_bm_named_lookup")
  step(ctx, "it sees the same field the object has, and the string still answers length", "st_member_by_name")
  step(ctx, "each gives minus the int minus one, as an int", "st_bnot_ints")
  step(ctx, "the program stops, reporting the float's class", "st_bnot_float")
  step(ctx, "each gives what spec 1.13 says, and an if or while that ran nothing gives unit", "st_pg_no_return")
  vm_noops(ctx, ["a program that writes unit, and binds unit as a parameter and as a variable", "it runs"])
  step(ctx, "unit is the value a function with no statements gives, and a bound unit is the program's own", "st_pg_unit")
  step(ctx, "it gives both", "st_pg_exec_stderr")
  vm_noops(ctx, ["a command that writes to both outputs, once exiting 0 and once exiting 3", "exec_peak_memory runs each, and exec_measured the second, a command that succeeds, and a command whose child commits several hundred MB"])
  step(ctx, "exec_measured gives the two outputs apart, false then true for the exits, and a peak above 0", "st_pg_exec_measured")
  step(ctx, "exec_measured's peak counts the child's memory, where exec_peak_memory's is the command's own", "st_pg_exec_tree")
  vm_noops(ctx, ["sed commands with and without g and i, with no match, an empty pattern, no replacement, an empty replacement, flags after a slash, characters of two bytes and an int as input", "each is applied", "add, multiply and subtract of ints and of rationals, and calculate, calculate_result, get_value, process and validate of an int, a string and a list"])
  step(ctx, "each gives what spec 1.10 says", "st_tx_sed")
  vm_noops(ctx, ["a status read before any report and after two, and a one-action plan found with plan and with plan_incremental, then the actions cleared", "chr of a float"])
  step(ctx, "the status is empty, then the second report; both plans are the action, and after action_clear there is no plan", "st_pg_progress_plan")
  vm_noops(ctx, ["a path with no directory at it, and a directory with files", "list_dir reads each"])
  step(ctx, "the first gives [] and the program goes on, file_exists says the path is missing, and the second gives entries", "st_pg_list_dir_missing")
  vm_noops(ctx, ["cpu_count, cpu_times and memory_status, cpu_times read 100 ms apart", "each is called"])
  step(ctx, "there is at least one processor, the times grow between the readings, and the free memory is no more than the total", "st_pg_machine_state")
  vm_noops(ctx, ["a store with one fact added twice through two holders, rules declared in a named store and read with from, two stores each holding q, a store solved into twice, a plan from a store's facts, a contract checked, the default store cleared and a named store deleted"])
  step(ctx, "each prints what spec 1.13 says of stores", "st_pg_logic_stores")
  vm_noops(ctx, ["a program with `using kb as planner do ... end`", "it is compiled"])
  step(ctx, "the error names the unknown role, and nothing runs", "st_pg_using_unknown_role")
  vm_noops(ctx, ["4,000 and then 8,000 rules added, a bound goal solved before and after 20,000 rules of another predicate are added, and goals with 4,000 and 8,000 solutions"])
  step(ctx, "twice the rules take no more than about three times as long, the other predicate's rules cost the goal little, and twice the solutions take no more than about three times as long", "st_pg_logic_scale")
  vm_noops(ctx, ["a chain of two builds and 10 goals each needing the second, a goal no action reaches, two routes of different cost, and 40 then 80 goals timed", "plan is asked for each"])
  step(ctx, "the builds come first and every goal is met, the unreachable goal gives [], the cheaper route is taken, and twice the goals take no more than about nine times as long", "st_pg_plan_scale")
  step(ctx, "it stops at chr, naming the require clause", "st_tx_chr_float")
  step(ctx, "add, multiply and subtract give the sum, product and difference, and the others give 0 or true", "st_pg_shims")
  step(ctx, "it gives standard output, standard error only from the failure, and a peak above 0", "st_pg_exec_peak")
  step(ctx, "the third file's statements run once, before the files that include it", "st_pg_include_once")
  step(ctx, "both engines print what those calls give", "st_ea_anywhere")
  step(ctx, "both engines report that it cannot be read", "st_ea_no_program")
  step(ctx, "both engines report that the include cannot be read, and nothing of the program runs", "st_ea_no_include")
  vm_noops(ctx, ["a program whose last statements are a call whose value nothing uses, and an int", "a function taking two arguments, and one taking one and rest, each called with too few or too many, and a closure called with nine", "the program is compiled", "a closure taking two parameters, called with two and then with one", "apply and parallel_map of a function taking two arguments and of one taking one and rest", "apply of a function taking two arguments, with one", "closures taking two parameters, none and a list, each spawned with that many arguments", "each thread's result is taken", "a closure taking two parameters, spawned with one"])
  step(ctx, "it prints only what it printed itself", "st_pg_program_value")
  step(ctx, "both engines refuse it, naming the function and both numbers, and that a closure takes at most 8, and nothing runs", "st_pg_arity_named")
  vm_noops(ctx, ["a closure taking one parameter and rest, called through a variable with one and with three arguments, and on a thread with two", "a closure taking one parameter and rest, called with none"])
  step(ctx, "rest holds the further arguments as a list each time, as for a function", "st_pg_closure_rest")
  step(ctx, "it stops as a failed precondition of the closure, saying it takes at least 1 argument", "st_pg_closure_rest_few")
  step(ctx, "the first call gives its value, and the second stops the program as a failed precondition of the closure, naming both numbers", "st_pg_arity_closure")
  step(ctx, "each gives its value, rest holding the further arguments as a list", "st_pg_arity_apply")
  step(ctx, "it stops as a failed precondition of the function, naming it and both numbers", "st_pg_arity_apply_wrong")
  step(ctx, "each is what its closure returned for those arguments", "st_cc_thread_args")
  step(ctx, "it stops before the thread starts, as a failed precondition of the closure, naming both numbers", "st_cc_thread_args_wrong")
  return true
end

let ctx = ctx_new()
register_values_and_memory_steps(ctx)
register_worlds_steps(ctx)
print("engine: " + vm_engine())
let names = vm_features()
let features = []
let i = 0
while i < list_len(names) do
  let features = list_push(features, "spec_library/values_and_memory/" + names[i] + ".feature")
  let i = i + 1
end
let args = argv()
let rest = []
let i = 1
while i < list_len(args) do
  let rest = list_push(rest, args[i])
  let i = i + 1
end
run_suite(ctx, features, rest)
