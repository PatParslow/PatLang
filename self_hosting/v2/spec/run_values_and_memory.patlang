# However the runtime holds modints modulo 2^32, the check sees their words
# as secret: a round of them is clean, and a branch on one is reported.
make a function called st_ct_words takes ctx returns ok
  let r = vm_ct("ct_word_round")
  let a = expect(ctx, "ct_word_round: the check's output", vm_clean(r[0]), "v2: no value-dependent branch or access")
  let b = expect(ctx, "ct_word_round exits 0", r[1], true)
  let c = vm_ct_reports(ctx, "ct_word_branch", vm_ct("ct_word_branch"), "a branch decides on a secret")
  return a and b and c
end

