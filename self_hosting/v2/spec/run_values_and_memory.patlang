# A fixture that stops: its output names the clause, and what follows did not run.
make a function called vm_stops takes ctx, label, name, wanted returns ok
  let out = vm_run(ctx, name)
  let a = expect(ctx, label + ": " + wanted, contains_text(out, wanted), true)
  let b = expect(ctx, label + ": nothing after it runs", contains_text(out, "not reached"), false)
  return a and b
end

# A fixture's output under v2 or its interpreter, against the file of what pat prints.
make a function called st_math_agrees takes ctx returns ok
  return vm_expect(ctx, "each prints what the interpreter prints", "vi_math", vm_clean(read_file("self_hosting/v2/spec/fixtures/vi_math.expected")))
end

