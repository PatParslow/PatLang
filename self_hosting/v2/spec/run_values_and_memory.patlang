make a function called st_pg_tcp_hosts takes ctx returns ok
  let a = expect(ctx, "127.0.0.1 and localhost connect", vm_run_on(ctx, vm_engine(), "rt_tcp_hosts", ["near"]), "one two")
  let far = vm_run_on(ctx, vm_engine(), "rt_tcp_hosts", ["far"])
  let b = expect(ctx, "10.0.0.1 is not this machine (got " + far + ")", contains_text(far, "tcp_connect: 10.0.0.1 is not this machine") and (not contains_text(far, "not reached")), true)
  let bad = vm_run_on(ctx, vm_engine(), "rt_tcp_hosts", ["bad"])
  let c = expect(ctx, "1.2.3 is not an address (got " + bad + ")", contains_text(bad, "tcp_connect: 1.2.3 is not an address") and (not contains_text(bad, "not reached")), true)
  let big = vm_run_on(ctx, vm_engine(), "rt_tcp_hosts", ["big"])
  let d = expect(ctx, "127.0.0.300 is not an address (got " + big + ")", contains_text(big, "tcp_connect: 127.0.0.300 is not an address") and (not contains_text(big, "not reached")), true)
  let e = expect(ctx, "tcp_try_connect connects, and gives -1 where nothing listens", vm_run_on(ctx, vm_engine(), "rt_tcp_hosts", ["try"]), "three true" + nl() + "-1")
  let f = expect(ctx, "tcp_try_write to a peer gone gives false, and the program goes on", vm_run_on(ctx, vm_engine(), "rt_tcp_hosts", ["closed"]), "true" + nl() + "the program goes on")
  return a and b and c and d and e and f
end

