# ---- engines_agree.feature (1.7) ----

# A command run in self_hosting/build, a directory other than the repository.
make a function called vm_in_build_dir takes command returns out
  return vm_clean(exec_capture("cmd", "/c", "cd /d self_hosting" + chr(92) + "build && " + command))
end

make a function called st_ea_anywhere takes ctx returns ok
  let wanted = "hi" + nl() + "3" + nl() + "3"
  let built = vm_v2_build(ctx, "vi_anywhere") + vm_interp_build(ctx)
  let z = expect(ctx, "the fixture and the interpreter build", built, "")
  let dot = "." + chr(92)
  let a = expect(ctx, "v2, started elsewhere", vm_in_build_dir(dot + "v2_spec_vi_anywhere.exe"), wanted)
  let up = ".." + chr(92) + "v2" + chr(92) + "spec" + chr(92) + "fixtures" + chr(92) + "vi_anywhere.patlang"
  let b = expect(ctx, "the interpreter, started elsewhere", vm_in_build_dir(dot + "v2_interp.exe " + up), wanted)
  return z and a and b
end

make a function called vm_reports_missing takes ctx, name, missing returns ok
  let wanted = "cannot read"
  let i = vm_run_on(ctx, "interp", name, [])
  let v = vm_run_on(ctx, "v2", name, [])
  let a = expect(ctx, name + ": the interpreter names " + missing, contains_text(i, wanted) and contains_text(i, missing), true)
  let b = expect(ctx, name + ": v2 names " + missing, contains_text(v, wanted) and contains_text(v, missing), true)
  let c = expect(ctx, name + ": nothing runs", contains_text(i, "not reached") or contains_text(v, "not reached"), false)
  return a and b and c
end

make a function called st_ea_no_program takes ctx returns ok
  return vm_reports_missing(ctx, "no_such_program", "no_such_program")
end

make a function called st_ea_no_include takes ctx returns ok
  return vm_reports_missing(ctx, "rt_missing_include", "no_such_file_here")
end

make a function called st_engines_agree takes ctx returns ok
  let names = ["vi_no_return", "vi_exec_stderr", "rt_include", "vo_type_of", "vo_new_object", "vo_keeps_class", "vo_methods", "int_extremes", "int_mid", "int_leave_return", "int_below", "int_division", "int_mul_overflow", "ev_operator_method", "ev_raises", "ev_int_order", "ev_no_change", "ev_no_reentry", "ev_ordinary", "ev_no_handler", "ev_raises_result", "vi_list_set", "vi_list_push", "vi_list_eq", "vi_object_shared", "vi_object_eq", "vi_sb", "vi_vec", "vi_bool_array", "vi_closure_captures", "vi_fibers", "vi_threads", "vi_syntax", "vi_syntax_included", "rt_fiber_finished", "rt_fiber_no_fiber", "rt_thread_taken", "bm_named_kept", "vi_interval", "rt_interval_backwards", "rt_interval_div"]
  let all = true
  let i = 0
  while i < list_len(names) do
    let a = vm_run_on(ctx, "interp", names[i], [])
    let b = vm_run_on(ctx, "v2", names[i], [])
    if not expect(ctx, names[i] + ": the interpreter and v2 print the same", a == b, true) then
      let all = false
    end
    let i = i + 1
  end
  return all
end

make a function called register_values_and_memory_steps takes ctx returns done
  vm_noops(ctx, ["the values 7, 2^70, 1.5, 6/4, true, the unit value print returns, \"hi\", [1, 2], a closure, sb_new(), vec_new() and bool_array_new(3)", "type_of is applied to each", "w = new(\"Widget\", \"w1\")", "type_of(w) is read", "the value 1.5 stored in a list, passed to a function, returned, and read back", "type_of is applied to what was read back", "3.to_s, 3.14.to_s, [1, 2, 3].length, and n.to_s where n is 42", "each is evaluated"])
  step(ctx, "the results are int, bigint, float, rational, bool, unit, string, list, closure, string_builder, vec, bool_array", "st_vo_type_of")
  step(ctx, "it is Widget", "st_vo_new_object")
  step(ctx, "it is float, and the value is 1.5", "st_vo_keeps_class")
  step(ctx, "they are \"3\", \"3.14\", 3 and \"42\"", "st_vo_methods")

  vm_noops(ctx, ["9223372036854775807 and 0 - 9223372036854775807 - 1", "type_of is applied to each", "140737488355327 + 10", "type_of is applied", "big = 9223372036854775807 + 1, and back = big - 1", "low = 0 - 9223372036854775807 - 1 - 1", "3 / 1, 6 / 4 and 2^70 / 2^69", "4294967296 * 4294967296", "it is evaluated"])
  step(ctx, "both are int", "st_int_extremes")
  step(ctx, "it is int, and the value is 140737488355337", "st_int_mid")
  step(ctx, "big is bigint with value 9223372036854775808, and back is int with value 9223372036854775807", "st_int_leave_return")
  step(ctx, "it is bigint, and low + 1 is int", "st_int_below")
  step(ctx, "they are int, rational and int", "st_int_division")
  step(ctx, "it is bigint with value 18446744073709551616", "st_int_mul_overflow")

  vm_noops(ctx, ["a class Money with a field cents and a method + taking other, returning a Money with the two amounts' cents summed", "m1 + m2 is evaluated, with 150 and 275 cents", "a class Money whose + is declared `raises money_added`", "a handler `when money_added do ... end` recording event_data", "m1 + m2 is evaluated", "handlers for added_to and added that append event_name and event_data to a log", "3 + 5 is evaluated", "the value of 3 + 5 is 8", "a handler for added that tries to return 0", "a handler for added that adds 1 + 1 and counts how many times it ran", "a handler for added registered with `when added do ... end`", "emit(\"added\", [1, 2, 3]) is called directly", "no handler registered for any event", "3 + 5, 1.5 * 2 and \"a\" + \"b\" are evaluated"])
  step(ctx, "the result is a Money with 425 cents", "st_ev_operator_method")
  step(ctx, "the handler ran once, with event_data [m1, m2, the result]", "st_ev_raises")
  step(ctx, "the log is: added_to [3, 5], added_to [5, 3], added [3, 5, 8]", "st_ev_int_order")
  step(ctx, "the value is 8", "st_ev_no_change")
  step(ctx, "the handler ran once", "st_ev_no_reentry")
  step(ctx, "the same handler runs, with event_data [1, 2, 3]", "st_ev_ordinary")
  step(ctx, "they print as 8, 3 and ab, and 1.5 * 2 is a float", "st_ev_no_handler")

  vm_noops(ctx, ["a = [1, 2, 3] and b = list_set(a, 0, 9)", "both are read", "a list a built by 10 list_push calls, then b = list_push(a, 99) and c = list_push(a, 77)", "all three are read", "[\"x\", \"y\"] and list_push(list_push([], \"x\"), \"y\")", "they are compared with ==", "o = new(\"Widget\", \"w1\"), p = o, and send(p, \"set\", \"color\", \"red\")", "get(o, \"color\") is read", "two objects of class Point, each with x = 1 and y = 2", "b = sb_new(), c = b, sb_push(c, \"hi\")", "sb_str(b) is read", "v = vec_new(), w = v, vec_push(w, 5)", "vec_len(v) is read", "a = bool_array_new(0), b = a, then 100 bool_array_push calls on a", "bool_array_len(b) is read"])
  step(ctx, "a is [1, 2, 3] and b is [9, 2, 3]", "st_vi_list_set")
  step(ctx, "a has 10 elements, b ends in 99, and c ends in 77", "st_vi_list_push")
  step(ctx, "the result is true", "st_vi_list_eq")
  step(ctx, "it is \"red\"", "st_vi_object_shared")
  step(ctx, "the result is false, and an object compared with itself is true", "st_vi_object_eq")
  step(ctx, "it is \"hi\"", "st_vi_sb")
  step(ctx, "it is 1", "st_vi_vec")
  step(ctx, "it is 100, and a == b is true", "st_vi_bool_array")

  vm_noops(ctx, ["loops of N iterations that each replace a local every iteration with one of these producers:", "each runs for N and for 10N iterations", "a loop that makes new(\"Widget\", \"w\" + i) and calls object_delete on it each iteration", "it runs for N and for 10N iterations", "a loop that makes new(\"Widget\", \"w\" + i) without object_delete, then reads get of the first", "it runs"])
  step(ctx, "no loop's peak memory grows", "st_bm_loops")
  step(ctx, "the peak memory does not grow", "st_bm_named_delete")
  step(ctx, "the first object's fields are still readable after the loop", "st_bm_named_kept")

  vm_noops(ctx, ["a function counter that yields twice and then returns, on a fiber", "a fiber that starts another fiber and resumes it", "each is resumed until it ends", "budgeted blocks over a loop, with a budget of 1 ms, of 0 ms and of a long time", "each is run, and a paused one continued from its handle", "closures returning an int, a string and a list, each on a thread", "8 threads summing different ranges", "each is polled until it has finished, and its result taken", "a fiber that has returned", "it is resumed", "a program that is running on no fiber", "it calls fiber_yield", "a thread whose result has been taken", "thread_result is called for it again", "loops of N iterations that each run one of these to its end:", "each runs for N and for 10N iterations"])
  step(ctx, "each resume gives what it yielded or returned, and it is alive until it has returned", "st_cc_fibers")
  step(ctx, "a block that finishes gives done and its value, one that does not gives paused and a handle, and continuing it reaches the same value", "st_cc_budgeted")
  step(ctx, "each result is what its closure returned", "st_cc_threads")
  step(ctx, "a function that calls 8 others, none of them called before", "st_vm_noop")
  step(ctx, "parallel_map runs it on 16 threads", "st_vm_noop")
  step(ctx, "each thread gives what one thread alone would give", "st_cc_first_call")
  step(ctx, "the program stops at that call, naming the require clause", "st_cc_fiber_finished")
  step(ctx, "the program stops at that call, naming the require clause, and fiber_yield's function", "st_cc_fiber_no_fiber")
  step(ctx, "the program stops, saying the result has been taken", "st_cc_thread_taken")
  step(ctx, "no concurrent loop's peak memory grows", "st_cc_memory")

  vm_noops(ctx, ["powers of exact and float numbers, trigonometric functions, the rounding functions, abs, to_fixed, the bit functions, len, byte_length, hash_string, try_read_file, rename_file, copy_file and read_file_b64", "a program prints each"])
  step(ctx, "it prints what the interpreter prints", "st_math_agrees")
  vm_noops(ctx, ["a string with characters of two, three and four bytes", "a program measures, indexes and cuts it, and writes it to a file and reads it back"])
  step(ctx, "each gives what the interpreter gives, and only byte_length and hash_string see its bytes", "st_text_agrees")

  vm_noops(ctx, ["intervals made with interval_make, with int, rational and bigint ends", "a program prints their class, their ends and their sums, differences, products and negations, alone and with real numbers", "interval_make(2, 1)", "it is called", "interval_make(1, 2) / 2", "it is evaluated"])
  step(ctx, "each prints what the rules of spec 1.12 give", "st_iv_agrees")
  step(ctx, "the program stops at that call, naming interval_make's require clause", "st_iv_backwards")
  step(ctx, "the program stops, naming the interval class", "st_iv_div")

  vm_noops(ctx, ["a syntax definition with trigger routes, and a rule giving a call for each line", "a routes block with two lines", "the program runs", "a file with a syntax definition, and a program that includes it and uses the syntax"])
  step(ctx, "each line runs as that call, in order, and the statements after the block run", "st_sx_block")
  step(ctx, "the included file's definition expands the program's block", "st_sx_included")

  vm_noops(ctx, ["each @language scenario in spec_library/values_and_memory", "it runs under the interpreter and as a native executable"])
  step(ctx, "both pass, with the same printed output", "st_engines_agree")
  vm_noops(ctx, ["a program whose calls rely on the runtime's declarations: exec_capture, apply and send", "it is started in a directory other than the repository", "a path with no file at it", "that path is given as the program", "a program that includes a path with no file at it", "that program is given"])
  vm_noops(ctx, ["functions ending in an expression, a call, a let, an if, a while, and nothing", "each is called", "a command that writes to standard error and to standard output", "exec_capture runs it", "a program whose two included files both include a third"])
  step(ctx, "each gives what spec 1.13 says, and an if or while that ran nothing gives unit", "st_pg_no_return")
  step(ctx, "it gives both", "st_pg_exec_stderr")
  step(ctx, "the third file's statements run once, before the files that include it", "st_pg_include_once")
  step(ctx, "both engines print what those calls give", "st_ea_anywhere")
  step(ctx, "both engines report that it cannot be read", "st_ea_no_program")
  step(ctx, "both engines report that the include cannot be read, and nothing of the program runs", "st_ea_no_include")
  return true
end

let ctx = ctx_new()
register_values_and_memory_steps(ctx)
print("engine: " + vm_engine())
let features = vm_features()
let i = 0
while i < list_len(features) do
  run_feature_file(ctx, "spec_library/values_and_memory/" + features[i] + ".feature")
  let i = i + 1
end
ctx_report(ctx)
