make a function called st_cc_memory takes ctx returns ok
  let a = vm_not_growing(ctx, "fibers", "bm_concurrent", "fiber", 2000)
  let b = vm_not_growing(ctx, "budgeted blocks", "bm_concurrent", "budgeted", 2000)
  # the lists and the pool settle over the first 2000 threads, flat from there to 32000
  let c = vm_not_growing(ctx, "threads", "bm_concurrent", "thread", 2000)
  return a and b and c
end

