end

make a function called st_pg_exec_search takes ctx returns ok
  if vm_engine() == "linux" then
    # a planted sh in the directory the program runs in: the system's still runs
    let dir = spec_out() + "/v2_exec_search_linux"
    let planted = v2_compile([vm_fixture("rt_exec_planted"), dir + "/sh", "--linux"])
    let built = v2_compile([vm_fixture("rt_exec_search"), dir + "/rt_exec_search", "--linux"])
    if (not planted[1]) or (not built[1]) then
      return expect(ctx, "the planted program and the fixture build for Linux", planted[0] + built[0], "")
    end
    let out = vm_clean(exec_capture_io("wsl", ["-d", "Ubuntu-24.04", "--cd", v2_wsl_path(dir), "-e", "./rt_exec_search"], "", 0)[0])
    let a = expect(ctx, "the system's sh runs (got " + out + ")", contains_text(out, "from the system"), true)
    let b = expect(ctx, "the planted sh does not", contains_text(out, "planted"), false)
    return a and b
  end
  let dir = vm_cmd_path(path_absolute(spec_out() + "/v2_exec_search"))
  let err = vm_v2_build(ctx, "rt_exec_planted")
  if err != "" then
    return expect(ctx, "the planted program builds", err, "")
  end
  write_file_bytes(spec_out() + "/v2_exec_search/cmd.exe", read_file_bytes(vm_exe("rt_exec_planted"), 0, 100000000))
  if vm_engine() == "v2" then
    let err = vm_v2_build(ctx, "rt_exec_search")
    if err != "" then
      return expect(ctx, "the fixture builds", err, "")
    end
    write_file_bytes(spec_out() + "/v2_exec_search/rt_exec_search.exe", read_file_bytes(vm_exe("rt_exec_search"), 0, 100000000))
    # .\ itself: cmd here need not look in the current directory
    # (NoDefaultCurrentDirectoryInExePath)
    let run = ".\\rt_exec_search.exe"
  else
    let run = vm_cmd_path(path_absolute(vm_interp_exe())) + " " + vm_cmd_path(path_absolute(vm_fixture("rt_exec_search")))
  end
  let out = vm_clean(exec_capture("cmd", "/c", "cd /d " + dir + " && " + run))
  let a = expect(ctx, "the system's cmd runs (got " + out + ")", contains_text(out, "from the system"), true)
  let b = expect(ctx, "the planted cmd.exe does not", contains_text(out, "planted"), false)
  return a and b
end

# A path for a cmd command line: backslashes, unquoted. An argument is passed
# with the C runtime's quoting, which cmd does not read (a \" stays), so a
# path that would need quotes, one with a space, stops the step saying so.
make a function called vm_cmd_path takes p returns q
  require not contains_text(p, " ")
  let b = sb_new()
  let i = 0
  while i < p.length do
    if p[i] == "/" then
      sb_push(b, "\\")
    else
      sb_push(b, p[i])
    end
    let i = i + 1
  end
  return sb_str(b)
end

