# A command run in the run's output directory (spec_out), a directory other
# than the repository's root.
make a function called vm_in_build_dir takes command returns out
  return vm_clean(exec_capture("cmd", "/c", "cd /d " + vm_backslashes(spec_out()) + " && " + command))
end

make a function called vm_backslashes takes path returns out
  let b = sb_new()
  let i = 0
  while i < path.length do
    if char_code(path, i) == 47 then
      sb_push(b, chr(92))
    else
      sb_push(b, substr(path, i, 1))
    end
    let i = i + 1
  end
  return sb_str(b)
end

# The repository's root from the output directory: "..\" for each of its parts.
make a function called vm_to_root returns path
  let b = sb_new()
  sb_push(b, "..")
  sb_push(b, chr(92))
  let i = 0
  let dir = spec_out()
  while i < dir.length do
    if char_code(dir, i) == 47 then
      sb_push(b, "..")
      sb_push(b, chr(92))
    end
    let i = i + 1
  end
  return sb_str(b)
end

make a function called st_ea_anywhere takes ctx returns ok
  let wanted = "hi" + nl() + "3" + nl() + "3"
  let built = vm_v2_build(ctx, "vi_anywhere") + vm_interp_build(ctx)
  let z = expect(ctx, "the fixture and the interpreter build", built, "")
  let dot = "." + chr(92)
  let a = expect(ctx, "v2, started elsewhere", vm_in_build_dir(dot + "v2_spec_vi_anywhere.exe"), wanted)
  let up = vm_to_root() + vm_backslashes(vm_fixture("vi_anywhere"))
  let b = expect(ctx, "the interpreter, started elsewhere", vm_in_build_dir(vm_to_root() + vm_backslashes(v2_interpreter()) + " " + up), wanted)
  return z and a and b
end

make a function called vm_reports_missing takes ctx, name, missing returns ok
  let wanted = "cannot read"
  let i = vm_run_on(ctx, "interp", name, [])
  let v = vm_run_on(ctx, "v2", name, [])
  let a = expect(ctx, name + ": the interpreter names " + missing, contains_text(i, wanted) and contains_text(i, missing), true)
  let b = expect(ctx, name + ": v2 names " + missing, contains_text(v, wanted) and contains_text(v, missing), true)
  let c = expect(ctx, name + ": nothing runs", contains_text(i, "not reached") or contains_text(v, "not reached"), false)
  return a and b and c
end

