  let tail = ": an index is an int or a modint, and a list, a vec, a string or a bytes indexed with it stops the program"
  let w1 = "v2 warning: " + f + ": line 15: in smooth, x0, argument 2 of pixel, is a float, and pixel indexes with it (through sample)" + tail + " (to_int gives the int a whole float is)"
  let w2 = "v2 warning: " + f + ": line 19: in the top level, this index is a float" + tail
  let w3 = "v2 warning: " + f + ": line 22: in the top level, the index s is a float" + tail
  let w4 = "v2 warning: " + f + ": line 24: in the top level, the index t is a string" + tail
  let a = expect(ctx, "the call of pixel", contains_text(r[0], w1), true)
  let b = expect(ctx, "l[1.5]", contains_text(r[0], w2), true)
  let c = expect(ctx, "vec_get given s", contains_text(r[0], w3), true)
  let d = expect(ctx, "l[t]", contains_text(r[0], w4), true)
  let r2 = v2_compile([vm_fixture("vi_index_no_warn"), spec_out() + "/v2_index_no_warn.exe"])
  let e = expect(ctx, "the second warns of nothing", contains_text(r2[0], "v2 warning"), false)
  let out = vm_run_on(ctx, vm_engine(), "vi_index_warn", [])
  let g = expect(ctx, "the first runs until l[1.5]", out, "before" + nl() + "an index is an int or a modint, not a float")
  return a and b and c and d and e and g
end

