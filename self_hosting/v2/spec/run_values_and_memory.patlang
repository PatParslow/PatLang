make a function called st_tx_utf8_malformed takes ctx returns ok
  let b = sb_new()
  sb_push(b, "cut short at the end: 2 [97, 65533] -1 2" + nl())
  sb_push(b, "three-byte cut short: 2 [65533, 65533] -1 2" + nl())
  sb_push(b, "overlong slash: 2 [65533, 65533] -1 2" + nl())
  sb_push(b, "stray continuation: 3 [97, 65533, 98] -1 3" + nl())
  sb_push(b, "surrogate: 3 [65533, 65533, 65533] -1 3" + nl())
  sb_push(b, "past U+10FFFF: 4 [65533, 65533, 65533, 65533] -1 4" + nl())
  sb_push(b, "well formed: 2 [233, 128512] -1 6" + nl())
  sb_push(b, "substr past the end: 1 65533" + nl())
  sb_push(b, "cursor: 97 65533 98" + nl())
  sb_push(b, "bytes kept: true")
  return vm_expect(ctx, "each malformed byte is U+FFFD", "vi_utf8_malformed", sb_str(b))
end

