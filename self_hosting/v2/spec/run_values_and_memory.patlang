# The constant-time check run on a fixture: [what it printed, whether it exited 0].
make a function called vm_ct takes name returns r
  return v2_compile([vm_fixture(name), "--constant-time"])
end

make a function called st_ct_clean takes ctx returns ok
  let r = vm_ct("ct_clean")
  let a = expect(ctx, "the check's output", vm_clean(r[0]), "v2: no value-dependent branch or access")
  let b = expect(ctx, "it exits 0", r[1], true)
  return a and b
end

make a function called vm_ct_reports takes ctx, name, r, wanted returns ok
  let a = expect(ctx, name + ": " + wanted, contains_text(r[0], wanted), true)
  let b = expect(ctx, name + " exits 1", r[1], false)
  return a and b
end

make a function called st_ct_branch takes ctx returns ok
  return vm_ct_reports(ctx, "ct_branch", vm_ct("ct_branch"), "a branch decides on a secret")
end

make a function called st_ct_arith takes ctx returns ok
  let r = vm_ct("ct_arith")
  let a = vm_ct_reports(ctx, "ct_arith", r, "arithmetic on a secret integer")
  let b = expect(ctx, "ct_arith: an address is computed from a secret", contains_text(r[0], "an address is computed from a secret"), true)
  return a and b
end

make a function called st_ct_reveal takes ctx returns ok
  return vm_ct_reports(ctx, "ct_reveal", vm_ct("ct_reveal"), "a modint's residue leaves the class")
end

# A reveal the program declares with mod_reveal is listed, naming the
# function that made it, and not counted (spec 2.7).
make a function called st_ct_declared takes ctx returns ok
  let r = vm_ct("ct_declared")
  let a = expect(ctx, "ct_declared: the check's output", vm_clean(r[0]), "v2 constant-time: declared: tag_matches reveals a residue through mod_reveal" + nl() + "v2: no value-dependent branch or access, and 1 declared reveals")
  let b = expect(ctx, "ct_declared exits 0", r[1], true)
  return a and b
end

# The tls package's AEAD: sealing and opening are clean, and the tag check's
# verdict is its one declared reveal.
make a function called st_ct_aes takes ctx returns ok
  let r = vm_ct("ct_aes_gcm")
  let a = expect(ctx, "ct_aes_gcm: the check's output", vm_clean(r[0]), "v2 constant-time: declared: aes128_gcm_check reveals a residue through mod_reveal" + nl() + "v2: no value-dependent branch or access, and 1 declared reveals")
  let b = expect(ctx, "ct_aes_gcm exits 0", r[1], true)
  return a and b
end

