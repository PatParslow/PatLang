make a function called st_pg_runtime_cache takes ctx returns ok
  vm_run_on(ctx, "interp", "vi_unit", [])
  let path = "self_hosting/build/v2_runtime_declarations.txt"
  let lines = split_lines(read_file(path))
  let a = expect(ctx, "the cache is there", file_exists(path), true)
  let b = expect(ctx, "its key names the runtime's files", (list_len(lines) > 2) and str_starts_with(lines[0], "key" + chr(9)) and contains_text(lines[0], "vfs.patlang:") and contains_text(lines[0], "core.patlang:"), true)
  let funcs = 0
  let last = ""
  let i = 0
  while i < list_len(lines) do
    if str_starts_with(lines[i], "func" + chr(9)) then
      let funcs = funcs + 1
    end
    if lines[i] != "" then
      let last = lines[i]
    end
    let i = i + 1
  end
  let c = expect(ctx, "it ends with its count of functions", last, "end" + chr(9) + funcs)
  return a and b and c
end

