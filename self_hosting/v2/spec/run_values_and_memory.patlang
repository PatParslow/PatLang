make a function called vm_stops_alike takes ctx, name, wanted returns ok
  let a = vm_run_on(ctx, "interp", name, [])
  let b = vm_run_on(ctx, "v2", name, [])
  let x = expect(ctx, name + ": the interpreter stops with " + wanted, contains_text(a, wanted), true)
  let y = expect(ctx, name + ": nothing after the call runs", contains_text(a, "not reached"), false)
  let z = expect(ctx, name + ": v2 prints the same", b, a)
  return x and y and z
end

