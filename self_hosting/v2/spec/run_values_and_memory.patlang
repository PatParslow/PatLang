# ---- engines_agree.feature (1.7) ----

# A command run in the run's output directory (spec_out), a directory other
# than the repository's root.
make a function called vm_in_build_dir takes command returns out
  return vm_clean(exec_capture("cmd", "/c", "cd /d " + vm_backslashes(spec_out()) + " && " + command))
end

make a function called vm_backslashes takes path returns out
  let b = sb_new()
  let i = 0
  while i < path.length do
    if char_code(path, i) == 47 then
      sb_push(b, chr(92))
    else
      sb_push(b, substr(path, i, 1))
    end
    let i = i + 1
  end
  return sb_str(b)
end

# The repository's root from the output directory: "..\" for each of its parts.
make a function called vm_to_root returns path
  let b = sb_new()
  sb_push(b, "..")
  sb_push(b, chr(92))
  let i = 0
  let dir = spec_out()
  while i < dir.length do
    if char_code(dir, i) == 47 then
      sb_push(b, "..")
      sb_push(b, chr(92))
    end
    let i = i + 1
  end
  return sb_str(b)
end

make a function called st_ea_anywhere takes ctx returns ok
  let wanted = "hi" + nl() + "3" + nl() + "3"
  let built = vm_v2_build(ctx, "vi_anywhere") + vm_interp_build(ctx)
  let z = expect(ctx, "the fixture and the interpreter build", built, "")
  let dot = "." + chr(92)
  let a = expect(ctx, "v2, started elsewhere", vm_in_build_dir(dot + "v2_spec_vi_anywhere.exe"), wanted)
  let up = vm_to_root() + vm_backslashes(vm_fixture("vi_anywhere"))
  let b = expect(ctx, "the interpreter, started elsewhere", vm_in_build_dir(vm_to_root() + vm_backslashes(v2_interpreter()) + " " + up), wanted)
  return z and a and b
end

make a function called vm_reports_missing takes ctx, name, missing returns ok
  let wanted = "cannot read"
  let i = vm_run_on(ctx, "interp", name, [])
  let v = vm_run_on(ctx, "v2", name, [])
  let a = expect(ctx, name + ": the interpreter names " + missing, contains_text(i, wanted) and contains_text(i, missing), true)
  let b = expect(ctx, name + ": v2 names " + missing, contains_text(v, wanted) and contains_text(v, missing), true)
  let c = expect(ctx, name + ": nothing runs", contains_text(i, "not reached") or contains_text(v, "not reached"), false)
  return a and b and c
end

make a function called st_ea_no_program takes ctx returns ok
  return vm_reports_missing(ctx, "no_such_program", "no_such_program")
end

make a function called st_ea_no_include takes ctx returns ok
  return vm_reports_missing(ctx, "rt_missing_include", "no_such_file_here")
end

make a function called st_engines_agree takes ctx returns ok
  let names = ["vi_unit", "vi_mod_reveal", "vi_syntax_token_names", "vi_bigint_div_scale", "vi_rational_exact", "vi_to_num_exact", "vi_max_min", "vi_ast", "vi_append_values", "rt_new_extra", "vi_shadow", "bm_named_many", "vo_member_by_name", "vi_bnot", "rt_bnot_float", "vi_index_modint", "rt_index_float", "rt_index_vec_text", "rt_index_set_float", "vi_to_int", "rt_to_int_fraction", "rt_to_int_infinite", "rt_to_int_text", "cc_tcp_unlisten", "rt_tcp_unlisten_unknown", "cc_tcp_wait_any", "rt_tcp_wait_any_unknown", "vi_no_return", "vi_exec_stderr", "rt_include", "vo_type_of", "vo_new_object", "vo_keeps_class", "vo_methods", "int_extremes", "int_mid", "int_leave_return", "int_below", "int_division", "int_mul_overflow", "ev_operator_method", "ev_raises", "ev_int_order", "ev_no_change", "ev_no_reentry", "ev_ordinary", "ev_no_handler", "ev_raises_result", "vi_list_set", "vi_list_push", "vi_list_eq", "vi_object_shared", "vi_get_absent", "vi_nothing_there", "vi_path_absolute", "vi_str_contains", "vi_object_eq", "vi_sb", "vi_vec", "vi_bool_array", "vi_closure_captures", "vi_fibers", "vi_threads", "vi_syntax", "vi_syntax_included", "rt_fiber_finished", "rt_fiber_no_fiber", "rt_thread_taken", "bm_named_kept", "vi_interval", "rt_interval_backwards", "rt_interval_div", "vi_let_giving_calls", "vi_logic_constants", "vi_logic_builtins", "vi_logic_decl", "rt_logic_compare_unbound", "rt_logic_not_unbound", "vi_vfs_exists", "vi_utf8_malformed", "vi_dir_files", "vi_append_file", "vi_nan_order", "vi_operator_dispatch", "vi_clock_ms", "vi_glob_match", "vi_host_caps", "vi_not_precedence", "vi_call_any", "vi_plan_steps", "vi_solve_up_to", "rt_hosts", "vi_str_hash", "vi_bytes", "vi_bytes_index", "vi_bytes_hash", "vi_class_scale", "vi_fiber_scale", "vi_field_scale", "vi_store_forms", "vi_cpu_cycles", "vi_float_ops", "vi_console_dir"]
  let all = true
  let i = 0
  while i < list_len(names) do
    let a = vm_run_on(ctx, "interp", names[i], [])
    let b = vm_run_on(ctx, "v2", names[i], [])
    if not expect(ctx, names[i] + ": the interpreter and v2 print the same", a == b, true) then
      let all = false
    end
    let i = i + 1
  end
  return all
end

# ---- worlds.feature (1.15) ----

make a function called st_wd_isolation takes ctx returns ok
  let wanted = "the program's function" + nl() + "[done, [0, , , false]]" + nl() + "[0, , , false]" + nl() + "[the program's handler]" + nl() + "[done, [1, Widget, 2, the world's file]]" + nl() + "the program's function" + nl() + "the world's handler"
  return vm_expect(ctx, "each world sees its own state alone", "wd_isolation", wanted)
end

