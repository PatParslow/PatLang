# A gates unit that fails, saying why: what gates.patlang runs in place of a
# suite whose runner lists nothing (SUITE/listing), so the run fails by name
# and the record keeps it until the runner lists its units again.
#
#   v2_interp.exe self_hosting/v2/tools/gates_fail.patlang REASON...
let a = argv()
print(str_join(a, " "))
exit_with(1)
