# The gates tool's record logic, apart from the tool so a selftest can include
# it (self_hosting/gates_record_selftest.patlang): which record rows are kept,
# which feature files run split by scenario, and which units a run selects.
# A record row is [unit, key, "pass" or "fail", ms, peak bytes].

make a function called gt_row_of takes rows, name returns row
  let i = 0
  while i < list_len(rows) do
    if rows[i][0] == name then return rows[i] end
    let i = i + 1
  end
  return []
end

make a function called gt_member takes names, x returns yes
  let i = 0
  while i < list_len(names) do
    if names[i] == x then return true end
    let i = i + 1
  end
  return false
end

# A feature file runs as one unit per scenario once its whole run took more
# than ten minutes, and stays split once it has scenario rows.
make a function called gt_split_ms returns ms
  return 600000
end

make a function called gt_split_feature takes rows, name returns yes
  let whole = gt_row_of(rows, name)
  if (list_len(whole) == 5) and (whole[3] > gt_split_ms()) then return true end
  return list_len(gt_row_of(rows, name + "@1")) == 5
end

# The units whose last run failed.
make a function called gt_failed_names takes rows returns names
  let names = []
  let i = 0
  while i < list_len(rows) do
    if (list_len(rows[i]) == 5) and (rows[i][2] == "fail") then
      let names = list_push(names, rows[i][0])
    end
    let i = i + 1
  end
  return names
end

# A scenario unit's feature unit: SUITE/NAME for SUITE/NAME@N, and any other
# name as it is.
make a function called gt_whole_name takes name returns whole
  let at = name.length - 1
  while (at >= 0) and (name[at] >= "0") and (name[at] <= "9") do
    let at = at - 1
  end
  if (at > 0) and (at < name.length - 1) and (name[at] == "@") then
    return substr(name, 0, at)
  end
  return name
end

# Whether a unit is one of the goals asked for: only is a prefix of names, or
# a list of names (--failed), where a feature's name also chooses its
# scenario units, since a feature that failed after more than ten minutes
# runs split from then on.
make a function called gt_selected takes name, only returns yes
  if type_of(only) == "list" then
    return gt_member(only, name) or gt_member(only, gt_whole_name(name))
  end
  return str_starts_with(name, only)
end

# The record rows kept, given the names of the units that exist now: a row for
# a unit that no longer exists (a renamed suite, a deleted feature file) is
# dropped. A feature's row, once it runs split, is kept until one of its
# scenario units has a row: it holds the decision to split, and its failure
# for --failed.
make a function called gt_rows_kept takes rows, names returns kept
  let kept = []
  let i = 0
  while i < list_len(rows) do
    let name = rows[i][0]
    if gt_member(names, name) then
      let kept = list_push(kept, rows[i])
    elif gt_member(names, name + "@1") and (list_len(gt_row_of(rows, name + "@1")) == 0) then
      let kept = list_push(kept, rows[i])
    end
    let i = i + 1
  end
  return kept
end
