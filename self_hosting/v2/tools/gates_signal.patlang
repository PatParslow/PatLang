# Sends status or quit to a running gates tool, on the port its status file
# names (self_hosting/build/gates/status, first line "port N"), and prints the
# reply. gates.sh --status and --quit run this.
#
#   self_hosting/build/v2_interp.exe self_hosting/v2/tools/gates_signal.patlang status|quit

include "../../lib/includes.patlang"
include "../../lib/signals.patlang"

make a function called gs_port takes text returns port
  let lines = split_lines(text)
  if list_len(lines) == 0 then return 0 end
  if not str_starts_with(lines[0], "port ") then return 0 end
  return to_num(substr(lines[0], 5, lines[0].length - 5))
end

make a function called gs_main takes args returns ok
  if (list_len(args) != 1) or ((args[0] != "status") and (args[0] != "quit")) then
    print("usage: gates_signal.patlang status|quit")
    exit_with(1)
  end
  let port = gs_port(read_file("self_hosting/build/gates/status"))
  if port <= 0 then
    print("gates: no running gates tool (self_hosting/build/gates/status names no port)")
    exit_with(1)
  end
  print(signal_query(port, args[0], ""))
  return true
end

gs_main(argv())
