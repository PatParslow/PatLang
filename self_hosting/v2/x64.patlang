# v2 code generation: one function's IR (ir.patlang) to NASM-subset text for
# self_hosting/lib/x64_asm.patlang. Values are two words
# (docs/plans/v2-implementation.md, section 2): slot s's type word is at
# [rbp-(16s+16)], its data word at [rbp-(16s+8)]. Parameter i arrives at
# [rbp+16+16i] (type) and [rbp+24+16i] (data). A result returns in rax
# (type word) and rdx (data word).

make a function called xv_nl returns s
  return chr(10)
end

# A function's assembly name: f_ and its name, any character other than a
# letter, digit or underscore written as _xNN_.
make a function called xv_sym takes name returns sym
  let b = sb_new()
  sb_push(b, "f_")
  let i = 0
  while i < name.length do
    let c = char_code(name, i)
    let ok = ((c >= 48) and (c <= 57)) or ((c >= 65) and (c <= 90)) or ((c >= 97) and (c <= 122)) or (c == 95)
    if ok then
      sb_push(b, chr(c))
    else
      sb_push(b, "_x" + c + "_")
    end
    let i = i + 1
  end
  return sb_str(b)
end

make a function called xv_t takes s returns mem
  return "[rbp-" + (16 * s + 16) + "]"
end

make a function called xv_d takes s returns mem
  return "[rbp-" + (16 * s + 8) + "]"
end

make a function called xv_line takes b, text returns done
  sb_push(b, "    " + text + xv_nl())
  return true
end

make a function called xv_label takes fname, n returns l
  return ".L" + n
end

# The class ids (docs/plans/v2-implementation.md, section 2).
make a function called xv_class_of_kind takes kind returns id
  if kind == "unit" then
    return 0
  end
  if kind == "bool" then
    return 1
  end
  if kind == "int" then
    return 2
  end
  if kind == "float" then
    return 3
  end
  return 0 - 1
end

# Store rax as an int into slot d.
make a function called xv_store_int takes b, d returns done
  xv_line(b, "mov rcx, 2")
  xv_line(b, "mov " + xv_t(d) + ", rcx")
  xv_line(b, "mov " + xv_d(d) + ", rax")
  return true
end

make a function called xv_store_result takes b, d returns done
  xv_line(b, "mov " + xv_t(d) + ", rax")
  xv_line(b, "mov " + xv_d(d) + ", rdx")
  return true
end

make a function called xv_push_arg takes b, s returns done
  xv_line(b, "push qword " + xv_d(s))
  xv_line(b, "push qword " + xv_t(s))
  return true
end

# A call: the arguments pushed last first, popped after.
make a function called xv_call takes b, name, slots, d returns done
  let i = list_len(slots) - 1
  while i >= 0 do
    xv_push_arg(b, slots[i])
    let i = i - 1
  end
  xv_line(b, "call " + xv_sym(name))
  if list_len(slots) > 0 then
    xv_line(b, "add rsp, " + (16 * list_len(slots)))
  end
  xv_store_result(b, d)
  return true
end

# The runtime function an operator falls back to when its fast path does
# not apply.
make a function called xv_op_fn takes op returns name
  if op == "+" then
    return "op_add"
  end
  if op == "q+" then
    return "op_add_quiet"
  end
  if op == "a+" then
    return "op_add_taken"
  end
  if op == "-" then
    return "op_sub"
  end
  if op == "*" then
    return "op_mul"
  end
  if op == "/" then
    return "op_div"
  end
  if op == "%" then
    return "op_mod"
  end
  if op == "<" then
    return "op_lt"
  end
  if op == ">" then
    return "op_gt"
  end
  if op == "<=" then
    return "op_le"
  end
  if op == ">=" then
    return "op_ge"
  end
  if op == "==" then
    return "op_eq"
  end
  if op == "!=" then
    return "op_ne"
  end
  if op == "band" then
    return "op_band"
  end
  if op == "bor" then
    return "op_bor"
  end
  if op == "bxor" then
    return "op_bxor"
  end
  if op == "shl" then
    return "op_shl"
  end
  if op == "shr" then
    return "op_shr"
  end
  return "op_unknown"
end

make a function called xv_cmp_jump takes op returns j
  if op == "<" then
    return "jl"
  end
  if op == ">" then
    return "jg"
  end
  if op == "<=" then
    return "jle"
  end
  if op == ">=" then
    return "jge"
  end
  if op == "==" then
    return "je"
  end
  return "jne"
end

# a op b. For two ints: + - * inline, an overflow taking the slow path;
# comparisons inline. Anything else: the operator's runtime function.
make a function called xv_op takes b, op, d, a, c, n, plus_events returns done
  let slow = ".op_slow_" + n
  let done = ".op_done_" + n
  let arith = (op == "+") or (op == "q+") or (op == "a+") or (op == "-") or (op == "*")
  let cmp = (op == "<") or (op == ">") or (op == "<=") or (op == ">=") or (op == "==") or (op == "!=")
  let bits = (op == "band") or (op == "bor") or (op == "bxor") or (op == "shl") or (op == "shr") or (op == "%")
  if bits then
    xv_line(b, "mov rax, " + xv_t(a))
    xv_line(b, "cmp rax, 2")
    xv_line(b, "jne " + slow)
    xv_line(b, "mov rax, " + xv_t(c))
    xv_line(b, "cmp rax, 2")
    xv_line(b, "jne " + slow)
    xv_line(b, "mov rax, " + xv_d(a))
    xv_line(b, "mov rcx, " + xv_d(c))
    if op == "band" then
      xv_line(b, "and rax, rcx")
    elif op == "bor" then
      xv_line(b, "or rax, rcx")
    elif op == "bxor" then
      xv_line(b, "xor rax, rcx")
    elif op == "shl" then
      xv_line(b, "shl rax, cl")
    elif op == "shr" then
      xv_line(b, "sar rax, cl")
    else
      # a zero divisor takes the slow path, which reports it
      xv_line(b, "test rcx, rcx")
      xv_line(b, "jz " + slow)
      xv_line(b, "cqo")
      xv_line(b, "idiv rcx")
      xv_line(b, "mov rax, rdx")
    end
    xv_store_int(b, d)
    xv_line(b, "jmp " + done)
  end
  let floats = arith or cmp or (op == "/")
  let flt = ".op_flt_" + n
  let not_int = slow
  if floats then
    let not_int = flt
  end
  if arith or cmp then
    xv_line(b, "mov rax, " + xv_t(a))
    xv_line(b, "cmp rax, 2")
    xv_line(b, "jne " + not_int)
    xv_line(b, "mov rax, " + xv_t(c))
    xv_line(b, "cmp rax, 2")
    xv_line(b, "jne " + not_int)
    if ((op == "+") or (op == "a+")) and plus_events then
      # int's event flag (runtime/objects.patlang): with a handler for its
      # events, + takes the slow path, which raises them
      xv_line(b, "lea rax, [rel v2_runtime_state]")
      xv_line(b, "mov rax, [rax+2064]")
      xv_line(b, "test rax, rax")
      xv_line(b, "jne " + slow)
    end
    xv_line(b, "mov rax, " + xv_d(a))
    xv_line(b, "mov rcx, " + xv_d(c))
    if arith then
      if (op == "+") or (op == "q+") or (op == "a+") then
        xv_line(b, "add rax, rcx")
      elif op == "-" then
        xv_line(b, "sub rax, rcx")
      else
        xv_line(b, "imul rax, rcx")
      end
      xv_line(b, "jo " + slow)
      xv_store_int(b, d)
    else
      xv_line(b, "cmp rax, rcx")
      xv_line(b, "mov rax, 1")
      xv_line(b, xv_cmp_jump(op) + " " + done + "_t")
      xv_line(b, "mov rax, 0")
      sb_push(b, done + "_t:" + xv_nl())
      xv_line(b, "mov rcx, 1")
      xv_line(b, "mov " + xv_t(d) + ", rcx")
      xv_line(b, "mov " + xv_d(d) + ", rax")
    end
    xv_line(b, "jmp " + done)
  end
  if floats then
    sb_push(b, flt + ":" + xv_nl())
    xv_float_op(b, op, d, a, c, n, plus_events, slow, done)
  end
  sb_push(b, slow + ":" + xv_nl())
  xv_call(b, xv_op_fn(op), [a, c], d)
  sb_push(b, done + ":" + xv_nl())
  return true
end

# a op b for two floats (class 3, the data word the IEEE bits): + - * / with
# SSE, and the comparisons with ucomisd, where a NaN sets the parity flag and
# compares unordered (spec 1.3: not less, not greater, equal to nothing). Not
# two floats: the slow path. With a handler for float's events, + takes the
# slow path, as for ints.
make a function called xv_float_op takes b, op, d, a, c, n, plus_events, slow, done returns ok
  xv_line(b, "mov rax, " + xv_t(a))
  xv_line(b, "cmp rax, 3")
  xv_line(b, "jne " + slow)
  xv_line(b, "mov rax, " + xv_t(c))
  xv_line(b, "cmp rax, 3")
  xv_line(b, "jne " + slow)
  if ((op == "+") or (op == "a+")) and plus_events then
    xv_line(b, "lea rax, [rel v2_runtime_state]")
    xv_line(b, "mov rax, [rax+2072]")
    xv_line(b, "test rax, rax")
    xv_line(b, "jne " + slow)
  end
  xv_line(b, "mov rax, " + xv_d(a))
  xv_line(b, "movq xmm0, rax")
  xv_line(b, "mov rax, " + xv_d(c))
  xv_line(b, "movq xmm1, rax")
  if (op == "+") or (op == "q+") or (op == "a+") or (op == "-") or (op == "*") or (op == "/") then
    if op == "-" then
      xv_line(b, "subsd xmm0, xmm1")
    elif op == "*" then
      xv_line(b, "mulsd xmm0, xmm1")
    elif op == "/" then
      xv_line(b, "divsd xmm0, xmm1")
    else
      xv_line(b, "addsd xmm0, xmm1")
    end
    xv_line(b, "movq rax, xmm0")
    xv_line(b, "mov rcx, 3")
    xv_line(b, "mov " + xv_t(d) + ", rcx")
    xv_line(b, "mov " + xv_d(d) + ", rax")
    xv_line(b, "jmp " + done)
    return true
  end
  let yes = ".flt_t_" + n
  let no = ".flt_f_" + n
  let stored = ".flt_s_" + n
  if (op == "<") or (op == "<=") then
    # a < b is b > a: ja and jae are false when unordered
    xv_line(b, "ucomisd xmm1, xmm0")
  else
    xv_line(b, "ucomisd xmm0, xmm1")
  end
  if (op == "<") or (op == ">") then
    xv_line(b, "ja " + yes)
    xv_line(b, "jmp " + no)
  elif (op == "<=") or (op == ">=") then
    xv_line(b, "jae " + yes)
    xv_line(b, "jmp " + no)
  elif op == "==" then
    xv_line(b, "jp " + no)
    xv_line(b, "je " + yes)
    xv_line(b, "jmp " + no)
  else
    xv_line(b, "jp " + yes)
    xv_line(b, "jne " + yes)
    xv_line(b, "jmp " + no)
  end
  sb_push(b, yes + ":" + xv_nl())
  xv_line(b, "mov rax, 1")
  xv_line(b, "jmp " + stored)
  sb_push(b, no + ":" + xv_nl())
  xv_line(b, "mov rax, 0")
  sb_push(b, stored + ":" + xv_nl())
  xv_line(b, "mov rcx, 1")
  xv_line(b, "mov " + xv_t(d) + ", rcx")
  xv_line(b, "mov " + xv_d(d) + ", rax")
  xv_line(b, "jmp " + done)
  return true
end

make a function called xv_un takes b, op, d, a, n returns done
  let slow = ".un_slow_" + n
  let done = ".un_done_" + n
  if op == "-" then
    xv_line(b, "mov rax, " + xv_t(a))
    xv_line(b, "cmp rax, 2")
    xv_line(b, "jne " + slow)
    xv_line(b, "mov rax, " + xv_d(a))
    xv_line(b, "neg rax")
    xv_line(b, "jo " + slow)
    xv_store_int(b, d)
    xv_line(b, "jmp " + done)
    sb_push(b, slow + ":" + xv_nl())
    xv_call(b, "op_neg", [a], d)
  elif op == "bnot" then
    xv_line(b, "mov rax, " + xv_t(a))
    xv_line(b, "cmp rax, 2")
    xv_line(b, "jne " + slow)
    xv_line(b, "mov rax, " + xv_d(a))
    xv_line(b, "not rax")
    xv_store_int(b, d)
    xv_line(b, "jmp " + done)
    sb_push(b, slow + ":" + xv_nl())
    xv_call(b, "op_bnot", [a], d)
  else
    xv_line(b, "mov rax, " + xv_t(a))
    xv_line(b, "cmp rax, 1")
    xv_line(b, "jne " + slow)
    xv_line(b, "mov rax, " + xv_d(a))
    xv_line(b, "xor rax, 1")
    xv_line(b, "mov rcx, 1")
    xv_line(b, "mov " + xv_t(d) + ", rcx")
    xv_line(b, "mov " + xv_d(d) + ", rax")
    xv_line(b, "jmp " + done)
    sb_push(b, slow + ":" + xv_nl())
    xv_call(b, "op_not", [a], d)
  end
  sb_push(b, done + ":" + xv_nl())
  return true
end

# Machine primitives (ir_prim_arity). A word result is an int.
make a function called xv_prim takes b, name, d, args, n, inline returns done
  if (name == "ct_secret") or (name == "ct_public") or (name == "ct_reveal") then
    # marks for the constant-time check, doing nothing
    xv_line(b, "mov rax, 0")
    xv_line(b, "mov " + xv_t(d) + ", rax")
    xv_line(b, "mov " + xv_d(d) + ", rax")
    return true
  end
  if name == "value_live" then
    # the invariant every value meets: only the type word's defined bits, a
    # class that exists, and a heap value's block still counted
    let bad = ".live_bad_" + n
    let known = ".live_known_" + n
    let good = ".live_good_" + n
    let store = ".live_store_" + n
    xv_line(b, "mov rax, " + xv_t(args[0]))
    xv_line(b, "mov rcx, rax")
    xv_line(b, "shr rcx, 34")
    xv_line(b, "test rcx, rcx")
    xv_line(b, "jne " + bad)
    xv_line(b, "mov rcx, 4294967295")
    xv_line(b, "and rcx, rax")
    xv_line(b, "cmp rcx, " + ir_last_builtin_class())
    xv_line(b, "jle " + known)
    xv_line(b, "cmp rcx, 63")
    xv_line(b, "jl " + bad)
    sb_push(b, known + ":" + xv_nl())
    xv_line(b, "mov rcx, 4294967296")
    xv_line(b, "test rax, rcx")
    xv_line(b, "jz " + good)
    xv_line(b, "mov rcx, " + xv_d(args[0]))
    xv_line(b, "mov rcx, [rcx]")
    xv_line(b, "cmp rcx, 1")
    xv_line(b, "jl " + bad)
    sb_push(b, good + ":" + xv_nl())
    xv_line(b, "mov rax, 1")
    xv_line(b, "jmp " + store)
    sb_push(b, bad + ":" + xv_nl())
    xv_line(b, "mov rax, 0")
    sb_push(b, store + ":" + xv_nl())
    xv_line(b, "mov rcx, 1")
    xv_line(b, "mov " + xv_t(d) + ", rcx")
    xv_line(b, "mov " + xv_d(d) + ", rax")
    return true
  end
  if name == "value_class" then
    xv_line(b, "mov rax, " + xv_t(args[0]))
    xv_line(b, "mov rcx, 4294967295")
    xv_line(b, "and rax, rcx")
    return xv_store_int(b, d)
  end
  if name == "value_data" then
    xv_line(b, "mov rax, " + xv_d(args[0]))
    return xv_store_int(b, d)
  end
  if name == "value_type_word" then
    xv_line(b, "mov rax, " + xv_t(args[0]))
    return xv_store_int(b, d)
  end
  if name == "value_make" then
    xv_line(b, "mov rax, " + xv_d(args[0]))
    xv_line(b, "mov rdx, " + xv_d(args[1]))
    return xv_store_result(b, d)
  end
  if name == "runtime_state" then
    xv_line(b, "lea rax, [rel v2_runtime_state]")
    return xv_store_int(b, d)
  end
  if name == "thread_entry_address" then
    xv_line(b, "lea rax, [rel v2_thread_entry]")
    return xv_store_int(b, d)
  end
  if name == "atomic_add" then
    xv_line(b, "mov rax, " + xv_d(args[0]))
    xv_line(b, "mov rcx, " + xv_d(args[1]))
    xv_line(b, "lock xadd [rax], rcx")
    xv_line(b, "mov rax, rcx")
    return xv_store_int(b, d)
  end
  if name == "mem_load_value" then
    # the value read, with a reference of its own (rule 1)
    xv_line(b, "mov rax, " + xv_d(args[0]))
    xv_line(b, "mov rcx, " + xv_d(args[1]))
    xv_line(b, "add rax, rcx")
    xv_line(b, "mov rcx, [rax]")
    xv_line(b, "mov " + xv_t(d) + ", rcx")
    xv_line(b, "mov rcx, [rax+8]")
    xv_line(b, "mov " + xv_d(d) + ", rcx")
    return xv_count(b, "rt_retain", d, "ml" + n)
  end
  if name == "mem_take_value" then
    # the value moved out, the memory left unit: no count changes
    xv_line(b, "mov rax, " + xv_d(args[0]))
    xv_line(b, "mov rcx, " + xv_d(args[1]))
    xv_line(b, "add rax, rcx")
    xv_line(b, "mov rcx, [rax]")
    xv_line(b, "mov " + xv_t(d) + ", rcx")
    xv_line(b, "mov rcx, [rax+8]")
    xv_line(b, "mov " + xv_d(d) + ", rcx")
    xv_line(b, "mov rcx, 0")
    xv_line(b, "mov [rax], rcx")
    xv_line(b, "mov [rax+8], rcx")
    return true
  end
  if (name == "mem_store_value") or (name == "mem_init_value") then
    # the memory takes a reference to the value (rule 3); mem_store_value
    # releases the value it overwrites, read into d first
    xv_count_unless_inline(b, "rt_retain", args[2], "ms" + n, inline)
    if name == "mem_store_value" then
      xv_line(b, "mov rax, " + xv_d(args[0]))
      xv_line(b, "mov rcx, " + xv_d(args[1]))
      xv_line(b, "add rax, rcx")
      xv_line(b, "mov rcx, [rax]")
      xv_line(b, "mov " + xv_t(d) + ", rcx")
      xv_line(b, "mov rcx, [rax+8]")
      xv_line(b, "mov " + xv_d(d) + ", rcx")
      xv_count(b, "rt_release", d, "mo" + n)
    end
    xv_line(b, "mov rax, " + xv_d(args[0]))
    xv_line(b, "mov rcx, " + xv_d(args[1]))
    xv_line(b, "add rax, rcx")
    xv_line(b, "mov rcx, " + xv_t(args[2]))
    xv_line(b, "mov [rax], rcx")
    xv_line(b, "mov rcx, " + xv_d(args[2]))
    xv_line(b, "mov [rax+8], rcx")
    xv_line(b, "mov rax, 0")
    xv_line(b, "mov " + xv_t(d) + ", rax")
    xv_line(b, "mov " + xv_d(d) + ", rax")
    return true
  end
  if (name == "mem_load") or (name == "mem_load_byte") or (name == "mem_store") or (name == "mem_store_byte") then
    xv_line(b, "mov rax, " + xv_d(args[0]))
    xv_line(b, "mov rcx, " + xv_d(args[1]))
    xv_line(b, "add rax, rcx")
    if name == "mem_load" then
      xv_line(b, "mov rax, [rax]")
      return xv_store_int(b, d)
    end
    if name == "mem_load_byte" then
      xv_line(b, "movzx rax, byte [rax]")
      return xv_store_int(b, d)
    end
    xv_line(b, "mov rcx, " + xv_d(args[2]))
    if name == "mem_store" then
      xv_line(b, "mov [rax], rcx")
    else
      xv_line(b, "mov byte [rax], cl")
    end
    xv_line(b, "mov rax, 0")
    xv_line(b, "mov " + xv_t(d) + ", rax")
    xv_line(b, "mov " + xv_d(d) + ", rax")
    return true
  end
  if (name == "int_to_float") or (name == "float_to_int") then
    xv_line(b, "mov rax, " + xv_d(args[0]))
    if name == "int_to_float" then
      xv_line(b, "cvtsi2sd xmm0, rax")
      xv_line(b, "movq rax, xmm0")
    else
      xv_line(b, "movq xmm0, rax")
      xv_line(b, "cvttsd2si rax, xmm0")
    end
    return xv_store_int(b, d)
  end
  if (name == "float_add") or (name == "float_sub") or (name == "float_mul") or (name == "float_div") or (name == "float_lt") or (name == "float_eq") then
    xv_line(b, "mov rax, " + xv_d(args[0]))
    xv_line(b, "movq xmm0, rax")
    xv_line(b, "mov rax, " + xv_d(args[1]))
    xv_line(b, "movq xmm1, rax")
    if name == "float_lt" then
      # 1 when a < b, that is b > a: CF and ZF both clear after b ? a
      xv_line(b, "ucomisd xmm1, xmm0")
      xv_line(b, "mov rax, 0")
      xv_line(b, "seta al")
      return xv_store_int(b, d)
    end
    if name == "float_eq" then
      # 1 when ZF is set and the comparison was ordered (PF clear)
      xv_line(b, "ucomisd xmm0, xmm1")
      xv_line(b, "mov rax, 0")
      xv_line(b, "jne .fe_" + n)
      xv_line(b, "jp .fe_" + n)
      xv_line(b, "mov rax, 1")
      sb_push(b, ".fe_" + n + ":" + xv_nl())
      return xv_store_int(b, d)
    end
    if name == "float_add" then
      xv_line(b, "addsd xmm0, xmm1")
    elif name == "float_sub" then
      xv_line(b, "subsd xmm0, xmm1")
    elif name == "float_mul" then
      xv_line(b, "mulsd xmm0, xmm1")
    else
      xv_line(b, "divsd xmm0, xmm1")
    end
    xv_line(b, "movq rax, xmm0")
    return xv_store_int(b, d)
  end
  xv_line(b, "mov rax, " + xv_d(args[0]))
  xv_line(b, "mov rcx, " + xv_d(args[1]))
  if name == "word_add" then
    xv_line(b, "add rax, rcx")
  elif name == "word_sub" then
    xv_line(b, "sub rax, rcx")
  elif name == "word_mul" then
    xv_line(b, "imul rax, rcx")
  elif name == "word_and" then
    xv_line(b, "and rax, rcx")
  elif name == "word_or" then
    xv_line(b, "or rax, rcx")
  elif name == "word_xor" then
    xv_line(b, "xor rax, rcx")
  elif name == "word_shl" then
    xv_line(b, "shl rax, cl")
  elif name == "word_shr" then
    xv_line(b, "shr rax, cl")
  elif (name == "word_div") or (name == "word_rem") then
    xv_line(b, "cqo")
    xv_line(b, "idiv rcx")
    if name == "word_rem" then
      xv_line(b, "mov rax, rdx")
    end
  end
  return xv_store_int(b, d)
end

# A Linux system call (extern_call("LINUX", "syscall", number, args...),
# runtime/os_linux.patlang): the number in rax, up to six arguments in rdi,
# rsi, rdx, r10, r8 and r9, the result in rax. syscall clobbers rcx and r11,
# which hold nothing across an instruction here.
make a function called xv_syscall takes b, d, args returns done
  let regs = ["rax", "rdi", "rsi", "rdx", "r10", "r8", "r9"]
  let k = 0
  while (k < list_len(args)) and (k < 7) do
    xv_line(b, "mov " + regs[k] + ", " + xv_d(args[k]))
    let k = k + 1
  end
  xv_line(b, "syscall")
  return xv_store_int(b, d)
end

# Linux's machine-level operations, for runtime/os_linux.patlang only
# (extern_call("LINUX", NAME, args...)):
#   syscall      a system call (xv_syscall)
#   fs_load      the word at fs:[offset], this thread's block
#   fs_store     the word value at fs:[offset]; gives 0
#   clone_thread clone(flags, stack, 0, ctid, tls) for a thread: the child, on
#                its own stack with the job at its top, runs rt_thread_main(job)
#                and exits the thread (exit, not exit_group); the parent gets
#                the thread's id, or -errno
#   fiber_switch saves the callee-saved registers and rsp in from's record
#                (word 0), makes to the thread's current fiber (fs:[16]), and
#                resumes to: where it last switched away, or v2_fiber_start
make a function called xv_linux takes b, fname, d, args, n returns done
  if fname == "syscall" then
    return xv_syscall(b, d, args)
  end
  if fname == "fs_load" then
    xv_line(b, "mov rcx, " + xv_d(args[0]))
    xv_line(b, "fsload_rcx")
    return xv_store_int(b, d)
  end
  if fname == "fs_store" then
    xv_line(b, "mov rcx, " + xv_d(args[0]))
    xv_line(b, "mov rdx, " + xv_d(args[1]))
    xv_line(b, "fsstore_rcx")
    xv_line(b, "mov rax, 0")
    return xv_store_int(b, d)
  end
  if fname == "clone_thread" then
    let parent = ".clone_parent_" + n
    # the job at the new stack's top, for the child to take
    xv_line(b, "mov rax, " + xv_d(args[1]))
    xv_line(b, "mov rcx, " + xv_d(args[4]))
    xv_line(b, "mov [rax], rcx")
    xv_line(b, "mov rdi, " + xv_d(args[0]))
    xv_line(b, "mov rsi, " + xv_d(args[1]))
    # the thread id at ctid as the parent sees clone return (CLONE_PARENT_SETTID),
    # and cleared there when the thread ends (CLONE_CHILD_CLEARTID)
    xv_line(b, "mov rdx, " + xv_d(args[2]))
    xv_line(b, "mov r10, " + xv_d(args[2]))
    xv_line(b, "mov r8, " + xv_d(args[3]))
    xv_line(b, "mov rax, 56")
    xv_line(b, "syscall")
    xv_line(b, "test rax, rax")
    xv_line(b, "jne " + parent)
    # the child: rsp is the new stack, the job at [rsp]
    xv_line(b, "mov rcx, [rsp]")
    xv_line(b, "mov rax, 0")
    xv_line(b, "push rax")
    xv_line(b, "push rax")
    xv_line(b, "mov rbp, rsp")
    xv_line(b, "push rcx")
    xv_line(b, "mov rax, 2")
    xv_line(b, "push rax")
    xv_line(b, "call " + xv_sym("rt_thread_main"))
    xv_line(b, "mov rax, 60")
    xv_line(b, "mov rdi, 0")
    xv_line(b, "syscall")
    sb_push(b, parent + ":" + xv_nl())
    return xv_store_int(b, d)
  end
  if fname == "fiber_switch" then
    let resume = ".fiber_resume_" + n
    xv_line(b, "mov rax, " + xv_d(args[0]))
    xv_line(b, "mov rcx, " + xv_d(args[1]))
    xv_line(b, "push rbx")
    xv_line(b, "push rbp")
    xv_line(b, "push r12")
    xv_line(b, "push r13")
    xv_line(b, "push r14")
    xv_line(b, "push r15")
    xv_line(b, "lea rdx, [rel " + resume + "]")
    xv_line(b, "push rdx")
    xv_line(b, "mov [rax], rsp")
    xv_line(b, "mov rax, rcx")
    xv_line(b, "fsstore 16, rax")
    xv_line(b, "mov rsp, [rcx]")
    xv_line(b, "ret")
    sb_push(b, resume + ":" + xv_nl())
    xv_line(b, "pop r15")
    xv_line(b, "pop r14")
    xv_line(b, "pop r13")
    xv_line(b, "pop r12")
    xv_line(b, "pop rbp")
    xv_line(b, "pop rbx")
    xv_line(b, "mov rax, 0")
    return xv_store_int(b, d)
  end
  if fname == "spawn_exec" then
    # clone(CLONE_VM | CLONE_VFORK | SIGCHLD) onto a stack of its own; the
    # child only makes system calls, from a block the parent made: 0 the path,
    # 8 argv, 16 envp, 24/32/40 the descriptors for 0/1/2 (-1 to keep one), 48
    # 1 for a process group of its own; then execve, or exit(127). The parent
    # resumes once the child has called execve or exited, with its pid.
    let parent = ".spawn_parent_" + n
    xv_line(b, "push r12")
    xv_line(b, "mov r12, " + xv_d(args[1]))
    xv_line(b, "mov rsi, " + xv_d(args[0]))
    xv_line(b, "mov rdi, 16657")
    xv_line(b, "mov rdx, 0")
    xv_line(b, "mov r10, 0")
    xv_line(b, "mov r8, 0")
    xv_line(b, "mov rax, 56")
    xv_line(b, "syscall")
    xv_line(b, "test rax, rax")
    xv_line(b, "jne " + parent)
    let k = 0
    while k < 3 do
      let skip = ".spawn_keep_" + n + "_" + k
      xv_line(b, "mov rdi, [r12+" + (24 + 8 * k) + "]")
      xv_line(b, "cmp rdi, 0")
      xv_line(b, "jl " + skip)
      xv_line(b, "mov rsi, " + k)
      xv_line(b, "mov rax, 33")
      xv_line(b, "syscall")
      sb_push(b, skip + ":" + xv_nl())
      let k = k + 1
    end
    # 48: 0 nothing, 1 a process group of its own (setpgid), 2 a session of
    # its own (setsid), so it outlives the session that started its parent
    let solo = ".spawn_nogroup_" + n
    let session = ".spawn_session_" + n
    xv_line(b, "mov rax, [r12+48]")
    xv_line(b, "test rax, rax")
    xv_line(b, "je " + solo)
    xv_line(b, "cmp rax, 2")
    xv_line(b, "je " + session)
    xv_line(b, "mov rdi, 0")
    xv_line(b, "mov rsi, 0")
    xv_line(b, "mov rax, 109")
    xv_line(b, "syscall")
    xv_line(b, "jmp " + solo)
    sb_push(b, session + ":" + xv_nl())
    xv_line(b, "mov rax, 112")
    xv_line(b, "syscall")
    sb_push(b, solo + ":" + xv_nl())
    xv_line(b, "mov rdi, [r12]")
    xv_line(b, "mov rsi, [r12+8]")
    xv_line(b, "mov rdx, [r12+16]")
    xv_line(b, "mov rax, 59")
    xv_line(b, "syscall")
    xv_line(b, "mov rdi, 127")
    xv_line(b, "mov rax, 60")
    xv_line(b, "syscall")
    sb_push(b, parent + ":" + xv_nl())
    xv_line(b, "pop r12")
    return xv_store_int(b, d)
  end
  print("x64: no Linux operation " + fname)
  return false
end

# A Windows x64 call: rsp aligned, 32 bytes of shadow space, the first four
# words in rcx, rdx, r8, r9 and the rest on the stack after the shadow
# space. rsp is restored from rbp after it (frame_bytes below rbp).
make a function called xv_extern takes b, fname, d, args, frame_bytes, floats returns done
  let n = list_len(args)
  let extra = 0
  if n > 4 then
    let extra = 8 * (n - 4)
  end
  let space = 32 + extra
  if (space % 16) != 0 then
    let space = space + 8
  end
  xv_line(b, "and rsp, -16")
  xv_line(b, "sub rsp, " + space)
  let k = 4
  while k < n do
    xv_line(b, "mov rax, " + xv_d(args[k]))
    xv_line(b, "mov [rsp+" + (32 + 8 * (k - 4)) + "], rax")
    let k = k + 1
  end
  let regs = ["rcx", "rdx", "r8", "r9"]
  let xregs = ["xmm0", "xmm1", "xmm2", "xmm3"]
  let k = 0
  while (k < n) and (k < 4) do
    if floats then
      xv_line(b, "mov rax, " + xv_d(args[k]))
      xv_line(b, "movq " + xregs[k] + ", rax")
    else
      xv_line(b, "mov " + regs[k] + ", " + xv_d(args[k]))
    end
    let k = k + 1
  end
  xv_line(b, "call " + fname)
  if floats then
    xv_line(b, "movq rax, xmm0")
  end
  xv_line(b, "lea rsp, [rbp-" + frame_bytes + "]")
  return xv_store_int(b, d)
end

# retain/release (ownership stage only): a call to the runtime's rt_retain
# or rt_release, made only when the type word's heap bit (bit 32) is set.
# rt_retain/rt_release take the value's type word and data word as two
# ints, so compiling them by the ownership rules calls nothing.
make a function called xv_count takes b, which, s, n returns done
  let skip = ".rc_skip_" + n
  xv_line(b, "mov rax, " + xv_t(s))
  xv_line(b, "mov rcx, 4294967296")
  xv_line(b, "test rax, rcx")
  xv_line(b, "jz " + skip)
  xv_line(b, "mov rcx, " + xv_d(s))
  if which == "rt_retain" then
    xv_line(b, "mov rax, 1")
    xv_line(b, "lock xadd [rcx], rax")
    xv_line(b, "cmp rax, 1")
    xv_line(b, "jge " + skip)
    xv_line(b, "call " + xv_sym("rt_fail_released_twice"))
  else
    xv_line(b, "mov rax, -1")
    xv_line(b, "lock xadd [rcx], rax")
    xv_line(b, "cmp rax, 1")
    xv_line(b, "jg " + skip)
    # the last reference, or one too many: the runtime's to deal with, given
    # the type word, the block and the count before, each as an int
    xv_line(b, "mov rcx, 2")
    xv_line(b, "push rax")
    xv_line(b, "push rcx")
    xv_line(b, "push qword " + xv_d(s))
    xv_line(b, "push rcx")
    xv_line(b, "push qword " + xv_t(s))
    xv_line(b, "push rcx")
    xv_line(b, "call " + xv_sym("rt_release_last"))
    xv_line(b, "add rsp, 48")
  end
  sb_push(b, skip + ":" + xv_nl())
  return true
end

# A string literal is data laid out as a heap string ([count][size][len]
# [bytes]) with its heap bit clear, so it is read like one and never counted.
# A character's UTF-8 bytes, onto a vec.
make a function called xv_utf8 takes bytes, c returns done
  if c < 128 then
    vec_push(bytes, c)
  elif c < 2048 then
    vec_push(bytes, 192 + floor(c / 64))
    vec_push(bytes, 128 + c % 64)
  elif c < 65536 then
    vec_push(bytes, 224 + floor(c / 4096))
    vec_push(bytes, 128 + floor(c / 64) % 64)
    vec_push(bytes, 128 + c % 64)
  else
    vec_push(bytes, 240 + floor(c / 262144))
    vec_push(bytes, 128 + floor(c / 4096) % 64)
    vec_push(bytes, 128 + floor(c / 64) % 64)
    vec_push(bytes, 128 + c % 64)
  end
  return true
end

# A string literal's data: strings.patlang gives the layout.
make a function called xv_str_data takes label, text returns asm
  let chars = text.length
  let bytes = vec_new()
  let i = 0
  while i < chars do
    xv_utf8(bytes, char_code(text, i))
    let i = i + 1
  end
  let n = vec_len(bytes)
  let b = sb_new()
  sb_push(b, "align 8" + xv_nl())
  sb_push(b, label + ":" + xv_nl())
  sb_push(b, "    dq 0, 0, " + n + ", " + chars + xv_nl())
  let i = 0
  while i < n do
    let line = sb_new()
    sb_push(line, "    db ")
    let k = 0
    while (k < 32) and (i < n) do
      if k > 0 then
        sb_push(line, ", ")
      end
      sb_push(line, vec_get(bytes, i) + "")
      let k = k + 1
      let i = i + 1
    end
    sb_push(b, sb_str(line) + xv_nl())
  end
  return sb_str(b)
end

# A list literal: rt_list_alloc(n), then each element, with a reference of
# its own (rule 3), written at block + 32 + 16k.
make a function called xv_list takes b, d, slots, n, inline returns done
  let count = list_len(slots)
  xv_line(b, "mov rax, " + count)
  xv_line(b, "push rax")
  xv_line(b, "mov rax, 2")
  xv_line(b, "push rax")
  xv_line(b, "call " + xv_sym("rt_list_alloc"))
  xv_line(b, "add rsp, 16")
  xv_store_result(b, d)
  let k = 0
  while k < count do
    xv_count_unless_inline(b, "rt_retain", slots[k], "li" + n + "_" + k, inline)
    xv_line(b, "mov rax, " + xv_d(d))
    xv_line(b, "mov rcx, " + xv_t(slots[k]))
    xv_line(b, "mov [rax+" + (32 + 16 * k) + "], rcx")
    xv_line(b, "mov rcx, " + xv_d(slots[k]))
    xv_line(b, "mov [rax+" + (40 + 16 * k) + "], rcx")
    let k = k + 1
  end
  return true
end

# A closure: rt_closure_alloc(n), its code address at block + 16, the number
# of parameters it takes at block + 32, 1 at block + 40 when the last is named
# rest, then each captured value, with a reference of its own, at
# block + 48 + 16k (runtime/closures.patlang).
make a function called xv_closure takes b, d, fname, slots, nparams, takes_rest, n, inline returns done
  let count = list_len(slots)
  xv_line(b, "mov rax, " + count)
  xv_line(b, "push rax")
  xv_line(b, "mov rax, 2")
  xv_line(b, "push rax")
  xv_line(b, "call " + xv_sym("rt_closure_alloc"))
  xv_line(b, "add rsp, 16")
  xv_store_result(b, d)
  xv_line(b, "mov rcx, " + xv_d(d))
  xv_line(b, "lea rax, [rel " + xv_sym(fname) + "]")
  xv_line(b, "mov [rcx+16], rax")
  xv_line(b, "mov rax, " + nparams)
  xv_line(b, "mov [rcx+32], rax")
  xv_line(b, "mov rax, " + takes_rest)
  xv_line(b, "mov [rcx+40], rax")
  let k = 0
  while k < count do
    xv_count_unless_inline(b, "rt_retain", slots[k], "cl" + n + "_" + k, inline)
    xv_line(b, "mov rax, " + xv_d(d))
    xv_line(b, "mov rcx, " + xv_t(slots[k]))
    xv_line(b, "mov [rax+" + (48 + 16 * k) + "], rcx")
    xv_line(b, "mov rcx, " + xv_d(slots[k]))
    xv_line(b, "mov [rax+" + (56 + 16 * k) + "], rcx")
    let k = k + 1
  end
  return true
end

# A call of the closure in slots[0]: every slot pushed as an argument, the
# closure first, then a call to the code address it holds. When the closure
# takes another number of parameters, or its last is named rest, the same
# arguments go to rt_closure_call_N (N the call's count, at most 8: lw_call),
# which fits them as a call naming a function does (spec 1.13).
# closure_call_unchecked (unchecked = 1), for arguments already fitted, calls
# the code address alone.
make a function called xv_callv takes b, d, slots, unchecked, n returns done
  let given = list_len(slots) - 1
  let i = list_len(slots) - 1
  while i >= 0 do
    xv_push_arg(b, slots[i])
    let i = i - 1
  end
  xv_line(b, "mov rax, " + xv_d(slots[0]))
  if unchecked == 1 then
    xv_line(b, "mov rax, [rax+16]")
  else
    let fit = ".cv_fit_" + n
    let go = ".cv_call_" + n
    xv_line(b, "mov rcx, [rax+32]")
    xv_line(b, "mov rdx, " + given)
    xv_line(b, "cmp rcx, rdx")
    xv_line(b, "jne " + fit)
    xv_line(b, "mov rcx, [rax+40]")
    xv_line(b, "mov rdx, 0")
    xv_line(b, "cmp rcx, rdx")
    xv_line(b, "jne " + fit)
    xv_line(b, "mov rax, [rax+16]")
    xv_line(b, "jmp " + go)
    sb_push(b, fit + ":" + xv_nl())
    xv_line(b, "lea rax, [rel " + xv_sym(xv_closure_fitter(given)) + "]")
    sb_push(b, go + ":" + xv_nl())
  end
  xv_line(b, "call rax")
  xv_line(b, "add rsp, " + (16 * list_len(slots)))
  xv_store_result(b, d)
  return true
end

# The runtime function that fits a closure call of given arguments
# (runtime/closures.patlang).
make a function called xv_closure_fitter takes given returns name
  require (given >= 0) and (given <= 8)
  let name = "rt_closure_call_" + given
  ensure name.length > 0
  return name
end

make a function called xv_const takes b, ins, data, label returns done
  let d = ins[1]
  let kind = ins[2]
  if kind == "str" then
    sb_push(data, xv_str_data(label, ins[3]))
    xv_line(b, "mov rax, 8")
    xv_line(b, "mov " + xv_t(d) + ", rax")
    xv_line(b, "lea rax, [rel " + label + "]")
    xv_line(b, "mov " + xv_d(d) + ", rax")
    return true
  end
  if kind == "float" then
    let bits = float_to_bits(to_num(ins[3]))
    if bits >= 9223372036854775808 then
      let bits = bits - 18446744073709551616
    end
    xv_line(b, "mov rax, 3")
    xv_line(b, "mov " + xv_t(d) + ", rax")
    xv_line(b, "mov rax, " + bits)
    xv_line(b, "mov " + xv_d(d) + ", rax")
    return true
  end
  let cls = xv_class_of_kind(kind)
  if cls < 0 then
    xv_line(b, "; unsupported constant kind " + kind)
    return false
  end
  xv_line(b, "mov rax, " + cls)
  xv_line(b, "mov " + xv_t(d) + ", rax")
  if (kind == "unit") then
    xv_line(b, "mov rax, 0")
  else
    xv_line(b, "mov rax, " + ins[3])
  end
  xv_line(b, "mov " + xv_d(d) + ", rax")
  return true
end

# What code generation reads of the program facts (lower.patlang,
# lw_program), and all it reads: whether some `when` handles int's +
# events, added_to or added (runtime/objects.patlang). A function's code
# depends on the facts through this alone, so it is what a job's key
# holds (jobs.patlang).
make a function called xv_facts_used takes facts returns used
  return [v2_contains(facts[0], "added") or v2_contains(facts[0], "added_to")]
end

# Whether an instruction's result is always an inline value, whatever its
# operands hold: a literal (a string literal's heap bit is clear), a machine
# primitive's word or bool, an extern's word, or a cleared slot. Three
# primitives give a value from memory or from two words, which may be counted.
make a function called xv_writes_inline takes ins returns yes
  let op = ins[0]
  if (op == "const") or (op == "extern") or (op == "externf") or (op == "clear") then
    return true
  end
  if op == "prim" then
    let name = ins[2]
    return (name != "value_make") and (name != "mem_load_value") and (name != "mem_take_value")
  end
  return false
end

# For each slot, whether it only ever holds an inline value (spec 2.2, rule 5):
# it is written, every write to it is inline (xv_writes_inline) or a copy or
# move from such a slot, and it is no parameter, which its caller wrote. Its
# retains and releases then do nothing, so none is emitted. Order does not
# matter: a slot is inline only if each of its writes is.
make a function called xv_inline_slots takes func returns inline
  require ir_well_formed(func, true)
  let nslots = ir_fn_nslots(func)
  let written = vec_new()
  let bad = vec_new()
  let k = 0
  while k < nslots do
    vec_push(written, false)
    vec_push(bad, k < ir_fn_nparams(func))
    let k = k + 1
  end
  let from = vec_new()
  let into = vec_new()
  let instrs = ir_fn_instrs(func)
  let i = 0
  while i < list_len(instrs) do
    let ins = instrs[i]
    let op = ins[0]
    let writes = (op != "label") and (op != "jump") and (op != "branch") and (op != "return") and (op != "retain") and (op != "release") and (op != "unwound") and (op != "unwind")
    if writes then
      let d = ins[1]
      vec_set(written, d, true)
      if (op == "copy") or (op == "move") then
        vec_push(from, ins[2])
        vec_push(into, d)
      elif not xv_writes_inline(ins) then
        vec_set(bad, d, true)
      end
    end
    let i = i + 1
  end
  # a copy of a slot that may hold a counted value may hold one too
  let changed = true
  while changed do
    let changed = false
    let e = 0
    while e < vec_len(from) do
      if vec_get(bad, vec_get(from, e)) and (not vec_get(bad, vec_get(into, e))) then
        vec_set(bad, vec_get(into, e), true)
        let changed = true
      end
      let e = e + 1
    end
  end
  let inline = vec_new()
  let k = 0
  while k < nslots do
    vec_push(inline, vec_get(written, k) and (not vec_get(bad, k)))
    let k = k + 1
  end
  ensure vec_len(inline) == nslots
  return inline
end

# A retain or release of slot s, unless s only ever holds an inline value.
make a function called xv_count_unless_inline takes b, which, s, n, inline returns done
  if vec_get(inline, s) then
    return true
  end
  return xv_count(b, which, s, n)
end

# facts: the program facts.
make a function called xv_fn_asm takes func, facts returns asm
  require ir_well_formed(func, true)
  # int's + tests its event flag only when its events are handled
  let plus_events = xv_facts_used(facts)[0]
  let b = sb_new()
  let name = ir_fn_name(func)
  let nslots = ir_fn_nslots(func)
  let frame_bytes = 16 * nslots
  let sym = xv_sym(name)
  sb_push(b, "global " + sym + xv_nl())
  sb_push(b, sym + ":" + xv_nl())
  xv_line(b, "push rbp")
  xv_line(b, "mov rbp, rsp")
  if frame_bytes > 0 then
    # the ownership stage clears the slots that need it. The system commits a
    # stack a page at a time as its guard page is touched, so a longer frame
    # touches each page on the way down.
    let left = frame_bytes
    while left > 4096 do
      xv_line(b, "sub rsp, 4096")
      xv_line(b, "mov rax, [rsp]")
      let left = left - 4096
    end
    xv_line(b, "sub rsp, " + left)
  end
  let p = 0
  while p < ir_fn_nparams(func) do
    xv_line(b, "mov rax, [rbp+" + (16 + 16 * p) + "]")
    xv_line(b, "mov " + xv_t(p) + ", rax")
    xv_line(b, "mov rax, [rbp+" + (24 + 16 * p) + "]")
    xv_line(b, "mov " + xv_d(p) + ", rax")
    let p = p + 1
  end
  let data = sb_new()
  let inline = xv_inline_slots(func)
  let instrs = ir_fn_instrs(func)
  let i = 0
  while i < list_len(instrs) do
    let ins = instrs[i]
    let op = ins[0]
    if op == "const" then
      xv_const(b, ins, data, sym + "_s" + i)
    elif op == "copy" then
      xv_line(b, "mov rax, " + xv_t(ins[2]))
      xv_line(b, "mov " + xv_t(ins[1]) + ", rax")
      xv_line(b, "mov rax, " + xv_d(ins[2]))
      xv_line(b, "mov " + xv_d(ins[1]) + ", rax")
    elif op == "call" then
      xv_call(b, ins[2], ins[3], ins[1])
    elif op == "op" then
      xv_op(b, ins[2], ins[1], ins[3], ins[4], i, plus_events)
    elif op == "un" then
      xv_un(b, ins[2], ins[1], ins[3], i)
    elif op == "prim" then
      xv_prim(b, ins[2], ins[1], ins[3], i, inline)
    elif (op == "extern") and (ins[2] == "LINUX") then
      xv_linux(b, ins[3], ins[1], ins[4], i)
    elif op == "extern" then
      xv_extern(b, ins[3], ins[1], ins[4], frame_bytes, false)
    elif op == "externf" then
      xv_extern(b, ins[3], ins[1], ins[4], frame_bytes, true)
    elif op == "label" then
      sb_push(b, xv_label(name, ins[1]) + ":" + xv_nl())
    elif op == "jump" then
      xv_line(b, "jmp " + xv_label(name, ins[1]))
    elif op == "branch" then
      # unit, a bool and an int are true by their data word; any other value
      # by rt_truthy (runtime/numbers.patlang)
      xv_line(b, "mov rax, " + xv_t(ins[1]))
      xv_line(b, "cmp rax, 2")
      xv_line(b, "jg .br_slow_" + i)
      xv_line(b, "mov rax, " + xv_d(ins[1]))
      xv_line(b, "jmp .br_test_" + i)
      sb_push(b, ".br_slow_" + i + ":" + xv_nl())
      xv_line(b, "push qword " + xv_d(ins[1]))
      xv_line(b, "push qword " + xv_t(ins[1]))
      xv_line(b, "call " + xv_sym("rt_truthy"))
      xv_line(b, "add rsp, 16")
      xv_line(b, "mov rax, rdx")
      sb_push(b, ".br_test_" + i + ":" + xv_nl())
      xv_line(b, "test rax, rax")
      xv_line(b, "jz " + xv_label(name, ins[3]))
      xv_line(b, "jmp " + xv_label(name, ins[2]))
    elif op == "return" then
      xv_line(b, "mov rax, " + xv_t(ins[1]))
      xv_line(b, "mov rdx, " + xv_d(ins[1]))
      xv_line(b, "leave")
      xv_line(b, "ret")
    elif op == "retain" then
      xv_count_unless_inline(b, "rt_retain", ins[1], i, inline)
    elif op == "release" then
      xv_count_unless_inline(b, "rt_release", ins[1], i, inline)
    elif op == "clear" then
      xv_line(b, "mov rax, 0")
      xv_line(b, "mov " + xv_t(ins[1]) + ", rax")
    elif op == "list" then
      xv_list(b, ins[1], ins[2], i, inline)
    elif op == "closure" then
      xv_closure(b, ins[1], ins[2], ins[3], ins[4], ins[5], i, inline)
    elif op == "callv" then
      xv_callv(b, ins[1], ins[2], ir_callv_unchecked(ins), i)
    elif op == "unwound" then
      # the unwinding mark (type word 16) goes to the unwind tail; a slot only
      # ever holding an inline value never holds it
      if not vec_get(inline, ins[1]) then
        xv_line(b, "mov rax, " + xv_t(ins[1]))
        xv_line(b, "cmp rax, 16")
        xv_line(b, "je " + xv_label(name, ins[2]))
      end
    elif op == "unwind" then
      xv_line(b, "mov rax, 16")
      xv_line(b, "mov rdx, 0")
      xv_line(b, "leave")
      xv_line(b, "ret")
    elif op == "move" then
      xv_line(b, "mov rax, " + xv_t(ins[2]))
      xv_line(b, "mov " + xv_t(ins[1]) + ", rax")
      xv_line(b, "mov rax, " + xv_d(ins[2]))
      xv_line(b, "mov " + xv_d(ins[1]) + ", rax")
      xv_line(b, "mov rax, 0")
      xv_line(b, "mov " + xv_t(ins[2]) + ", rax")
    end
    let i = i + 1
  end
  let d = sb_str(data)
  if d.length > 0 then
    sb_push(b, "section .data" + xv_nl())
    sb_push(b, d)
    sb_push(b, "section .text" + xv_nl())
  end
  let asm = sb_str(b)
  # the text declares the function's symbol and defines it
  ensure str_starts_with(asm, "global " + sym + xv_nl() + sym + ":")
  return asm
end

# The program's entry: the runtime's initialisation, the program's
# top-level statements (__main), then ExitProcess(0); and the runtime's
# state area.
make a function called xv_entry_asm returns asm
  let b = sb_new()
  sb_push(b, "default rel" + xv_nl())
  sb_push(b, "section .text" + xv_nl())
  sb_push(b, "global main" + xv_nl())
  sb_push(b, "main:" + xv_nl())
  xv_line(b, "push rbp")
  xv_line(b, "mov rbp, rsp")
  xv_line(b, "call " + xv_sym("runtime_init"))
  xv_line(b, "call " + xv_sym("__main"))
  xv_line(b, "and rsp, -16")
  xv_line(b, "sub rsp, 32")
  xv_line(b, "mov rcx, 0")
  xv_line(b, "call ExitProcess")
  # A thread's start (CreateThread, runtime/threads.patlang): the Windows
  # convention passes the job in rcx; rt_thread_main(job) takes it as an
  # int, and the thread's result is 0.
  sb_push(b, "global v2_thread_entry" + xv_nl())
  sb_push(b, "v2_thread_entry:" + xv_nl())
  xv_line(b, "push rbp")
  xv_line(b, "mov rbp, rsp")
  xv_line(b, "push rcx")
  xv_line(b, "mov rax, 2")
  xv_line(b, "push rax")
  xv_line(b, "call " + xv_sym("rt_thread_main"))
  xv_line(b, "mov rax, 0")
  xv_line(b, "leave")
  xv_line(b, "ret")
  sb_push(b, "section .bss" + xv_nl())
  sb_push(b, "global v2_runtime_state" + xv_nl())
  sb_push(b, "v2_runtime_state resb 65536" + xv_nl())
  return sb_str(b)
end

# The entry for a target: "windows" (main, above) or "linux".
make a function called xv_entry_asm_for takes target returns asm
  if target == "linux" then
    return xv_entry_asm_linux()
  end
  return xv_entry_asm()
end

# A static Linux executable's entry (lib/x64_elf_link.patlang): the kernel
# starts _start with rsp at argc, then argv's pointers, a 0, then envp's. That
# stack pointer is kept at runtime_state() + 4720 for argv and getenv
# (runtime/os_linux.patlang); a zero where a return address would be makes the
# frame a call's; the program ends with exit_group(0).
make a function called xv_entry_asm_linux returns asm
  let b = sb_new()
  sb_push(b, "default rel" + xv_nl())
  sb_push(b, "section .text" + xv_nl())
  sb_push(b, "global _start" + xv_nl())
  sb_push(b, "_start:" + xv_nl())
  xv_line(b, "mov rax, rsp")
  xv_line(b, "lea rcx, [rel v2_runtime_state]")
  xv_line(b, "mov [rcx+4720], rax")
  # the image is wherever the kernel put it (a static PIE): _start is at 4096
  # from its start, and the fix-up table (lib/x64_elf_link.patlang), whose
  # offset is at 232, lists each absolute address in the data, written as an
  # offset, to which the load address is added here, before anything runs
  xv_line(b, "lea rbx, [rel _start]")
  xv_line(b, "sub rbx, 4096")
  xv_line(b, "mov rcx, [rbx+232]")
  xv_line(b, "add rcx, rbx")
  xv_line(b, "mov rdx, [rcx]")
  xv_line(b, "add rcx, 8")
  sb_push(b, ".fix_next:" + xv_nl())
  xv_line(b, "test rdx, rdx")
  xv_line(b, "je .fix_done")
  xv_line(b, "mov rax, [rcx]")
  xv_line(b, "add rax, rbx")
  xv_line(b, "mov r8, [rax]")
  xv_line(b, "add r8, rbx")
  xv_line(b, "mov [rax], r8")
  xv_line(b, "add rcx, 8")
  xv_line(b, "sub rdx, 1")
  xv_line(b, "jmp .fix_next")
  sb_push(b, ".fix_done:" + xv_nl())
  xv_line(b, "mov rax, 0")
  xv_line(b, "push rax")
  xv_line(b, "push rbp")
  xv_line(b, "mov rbp, rsp")
  xv_line(b, "call " + xv_sym("runtime_init"))
  xv_line(b, "call " + xv_sym("__main"))
  xv_line(b, "mov rax, 231")
  xv_line(b, "mov rdi, 0")
  xv_line(b, "syscall")
  # A fiber's start (os_fiber_create, runtime/os_linux.patlang): the first
  # switch to a new fiber returns here, on its own stack; its record is the
  # thread's current fiber (fs:[16]) and holds the job at 8, which
  # rt_thread_main(job) runs as a fiber. A thread does not start here:
  # clone_thread calls rt_thread_main itself.
  sb_push(b, "global v2_thread_entry" + xv_nl())
  sb_push(b, "v2_thread_entry:" + xv_nl())
  xv_line(b, "fsload rax, 16")
  xv_line(b, "mov rcx, [rax+8]")
  xv_line(b, "and rsp, -16")
  xv_line(b, "mov rax, 0")
  xv_line(b, "push rax")
  xv_line(b, "push rax")
  xv_line(b, "mov rbp, rsp")
  xv_line(b, "push rcx")
  xv_line(b, "mov rax, 2")
  xv_line(b, "push rax")
  xv_line(b, "call " + xv_sym("rt_thread_main"))
  # a fiber's function ends by switching back, so this is not reached
  xv_line(b, "mov rax, 60")
  xv_line(b, "mov rdi, 99")
  xv_line(b, "syscall")
  sb_push(b, "section .bss" + xv_nl())
  sb_push(b, "global v2_runtime_state" + xv_nl())
  sb_push(b, "v2_runtime_state resb 65536" + xv_nl())
  return sb_str(b)
end
