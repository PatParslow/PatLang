# Failure injection through the browser's host (review, test-suite
# recommendation 5; finding S12, results not checked). The host implements each
# system call in JavaScript, so it can make the nth call to one fail as the
# system's would (run_node.mjs --fail NAME:N). A program reading a file is run
# with the open, the size and the read each made to fail, and gives what
# read_file gives for a file that cannot be read: "" (spec 1.13), not what the
# memory happened to hold.
#
#   self_hosting/build/v2_interp.exe self_hosting/wasm_fail_selftest.patlang
include "lib/gherkin.patlang"
include "lib/v2_engines.patlang"
include "lib/program_run.patlang"

let ctx = ctx_new()
let dir = spec_out() + "/wasm_fail"
write_file(dir + "/data/in.txt", "hello")
let wasm = dir + "/rt_fail_read.wasm"
let built = v2_compile(["self_hosting/v2/spec/fixtures/rt_fail_read.patlang", wasm, "--wasm"])
expect(ctx, "the program builds for the browser", built[1], true)
expect(ctx, "node is on the PATH", has_program("node"), true)

make a function called wf_run takes dir, wasm, fail returns out
  let args = ["self_hosting/v2/wasm/run_node.mjs", "--files", dir + "/data"]
  if fail != "" then
    let args = list_push(list_push(args, "--fail"), fail)
  end
  let args = list_push(list_push(args, wasm), dir + "/data/in.txt")
  let r = exec_capture_io("node", args, "", 0)
  return str_trim(r[0])
end

let nl = chr(10)
expect(ctx, "with nothing failing it reads the file", wf_run(dir, wasm, ""), "true" + nl + "[read_file, 5, hello]")
let fails = ["CreateFileA:1", "GetFileSize:1", "ReadFile:1"]
let i = 0
while i < list_len(fails) do
  expect(ctx, "with " + fails[i] + " failing, read_file gives the empty string", wf_run(dir, wasm, fails[i]), "true" + nl + "[read_file, 0, ]")
  let i = i + 1
end
ctx_report(ctx)
