# Selftest for self_hosting/lib/parser.patlang's parse_check_when_placement:
# `when` handlers are a genuine top-level-only declaration, and nesting
# one inside if/while/a function body is now a real parse error instead
# of silently compiling into a handler that never fires. See that
# function's own header comment for the design rationale (handlers are
# collected once, statically -- this matters for signal_discovery.
# patlang's capability-description system staying honest) and
# self_hosting/examples/microservices_demo.patlang for the real bug that
# prompted this: a worker whose handlers were registered conditionally
# received every signal and answered none of them, silently.

include "lib/test.patlang"
include "lib/lexer.patlang"
include "lib/parser.patlang"

t_init()

make a function called check_source takes label, source, expect_error returns done
  let toks = tokenize(source)
  let ast = parse_program(toks)
  let stmts = ast[1]
  let placement = parse_check_when_placement(stmts, 0)
  let found_error = placement[0] != ""
  check(label, found_error, expect_error)
  return true
end

check_source(
  "when nested inside 'if' is rejected",
  "if true then" + chr(10) + "  when greet do" + chr(10) + "    print(1)" + chr(10) + "  end" + chr(10) + "end",
  true
)

check_source(
  "when nested inside 'while' is rejected",
  "let x = 0" + chr(10) + "while x < 1 do" + chr(10) + "  when greet do" + chr(10) + "    print(1)" + chr(10) + "  end" + chr(10) + "  let x = x + 1" + chr(10) + "end",
  true
)

check_source(
  "when nested inside a function body is rejected",
  "make a function called f returns r" + chr(10) + "  when greet do" + chr(10) + "    print(1)" + chr(10) + "  end" + chr(10) + "  return true" + chr(10) + "end",
  true
)

check_source(
  "when at genuine top level is accepted",
  "when greet do" + chr(10) + "  print(1)" + chr(10) + "end",
  false
)

check_source(
  "a program with no 'when' at all is accepted",
  "let x = 1" + chr(10) + "print(x)",
  false
)

check_source(
  "multiple top-level whens are all accepted",
  "when greet do" + chr(10) + "  print(1)" + chr(10) + "end" + chr(10) + "when quit do" + chr(10) + "  print(2)" + chr(10) + "end",
  false
)

# The actual bug shape from microservices_demo.patlang's first draft:
# nested two levels deep (inside an if, inside... well, just the if is
# enough, but confirm the line number reported is the 'when' itself,
# not the enclosing 'if').
let nested_source = "let role = \"greeter\"" + chr(10) + "if role == \"greeter\" then" + chr(10) + "  when greet do" + chr(10) + "    print(1)" + chr(10) + "  end" + chr(10) + "end"
let toks = tokenize(nested_source)
let ast = parse_program(toks)
let placement = parse_check_when_placement(ast[1], 0)
check("the reported line is the 'when' line itself, not the enclosing 'if'", placement[1], 3)

let formatted = format_parse_error(placement[0], placement[1], nested_source)
check("the formatted diagnostic explains WHY, not just that it's wrong", contains_text(formatted, "registered once, statically"), true)
check("the formatted diagnostic's suggestion offers the actual workaround", contains_text(formatted, "unconditionally"), true)

t_report()
