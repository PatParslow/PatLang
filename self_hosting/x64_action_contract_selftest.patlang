# Stage 0 selftest (GitHub #25 roadmap, post-#26/#27): action_bind/
# action_lookup/action_base_name/action_label_args + contract_check.
#
# Hand-computed expected output:
#   42                (closure bound to "build", looked up and called)
#   build             (action_base_name of a bare label, no args)
#   0                 (action_label_args of a bare label -- empty list)
#   build             (action_base_name of a parameterized label)
#   2                 (action_label_args length -- two bound values)
#   house
#   2
#   1                 (contract_holds recorded a fact after a passing check)

action_bind("build", |x| { return 42 })
let f = action_lookup("build")
print(f(0))

print(action_base_name("build"))
print(action_label_args("build").length)

let parts = action_label_args("build(X=house,Y=2)")
print(action_base_name("build(X=house,Y=2)"))
print(parts.length)
print(parts[0])
print(parts[1])

make a function called half takes n returns result
  require n >= 0
  let result = n / 2
  ensure result >= 0
  return result
end
let h = half(10)
let sols = solve("contract_holds", ["half", "X"])
print(sols.length)
