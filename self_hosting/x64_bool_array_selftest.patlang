# GitHub #45 (Slice 1): real check()/t_report() regression coverage for
# the x64 backend's bit-packed bool_array container (self_hosting/lib/
# x64_runtime.patlang's bool_array_new/get/set/len/push, family tag 7
# shl 60 in codegen_x64.patlang's x64_family_code_asm). Compiles and
# runs self_hosting/examples/x64_bool_array_demo.patlang as a real
# --x64 subprocess (via patc1.exe) and asserts on its actual output,
# the same way this session's other x64-backend selftests do -- an
# in-process interpreter run can't exercise this at all, since the
# container only exists in the x64 codegen path.

include "lib/test.patlang"

t_init()

let build = exec_capture("./patc1.exe", "self_hosting/examples/x64_bool_array_demo.patlang", "self_hosting/build/x64_bool_array_selftest_demo.exe", "--x64")
check("demo compiles cleanly via patc1.exe --x64", contains_text(build, "patc1:"), true)

let out = exec_capture("self_hosting/build/x64_bool_array_selftest_demo.exe")
let expected = "0\nfalse\nfalse\ntrue\n3\n65\n0\ntrue\ntrue\ntrue\n<bool_array len=65>\n"
check("bool_array demo's actual runtime output matches exactly (new/get/set/len/push, growth past one word, false-vs-true both correctly recognized as Bool)", out, expected)

t_report()
