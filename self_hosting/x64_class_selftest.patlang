# Real x64 class support selftest (GitHub incremental-compile-caching
# plan, Slice 0): single class with fields + a method taking `self`, NO
# `inherits` -- deliberately narrower than
# self_hosting/examples/paradigm_gallery/oo_inheritance_methods.patlang,
# matching this slice's own documented scope limit (see
# x64_runtime.patlang's "real classes for x64" header).
class Animal {
  field legs = 4
  field sound = "..."
  make a function called speak takes self returns msg
    return get(self, "sound")
  end
}

let a = new("Animal", "a1")
print(send(a, "speak"))
print(get(a, "legs"))

# obj.prop = value sugar (lowers to send(obj,"set",prop,value)) --
# exercise rt_send_prepare's own "set" special-case too.
a.sound = "woof"
print(send(a, "speak"))
