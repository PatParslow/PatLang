# Compiles lib/x64_runtime.patlang + examples/x64_closure_demo.patlang,
# proving Slice 5 closures. Run from the repo root:
#   rust-runtime/target/release/pat --ir-run self_hosting/x64_closure_driver.patlang

include "lib/lexer.patlang"
include "lib/parser.patlang"
include "lib/lower.patlang"
include "lib/codegen_x64.patlang"

let src = read_file("self_hosting/lib/x64_runtime.patlang")
let src = src + chr(10) + read_file("self_hosting/examples/x64_closure_demo.patlang")

let toks = tokenize(src)
let ast = parse_program(toks)
let ir = lower_program(ast)
let asm = emit_program_x64(ir)

write_file("self_hosting/build/x64_closure_demo.asm", asm)
print("wrote self_hosting/build/x64_closure_demo.asm")
