# Slice 1 driver: compiles self_hosting/lib/x64_runtime.patlang +
# self_hosting/examples/x64_codegen_demo.patlang through the ordinary
# self-hosted lex/parse/lower pipeline, then through the NEW
# codegen_x64.patlang backend, to a real standalone .exe -- NO rustc
# anywhere in this path. Run from the repo root:
#   rust-runtime/target/release/pat --ir-run self_hosting/x64_codegen_driver.patlang

include "lib/lexer.patlang"
include "lib/parser.patlang"
include "lib/lower.patlang"
include "lib/codegen_x64.patlang"

let src = read_file("self_hosting/lib/x64_runtime.patlang")
let src = src + chr(10) + read_file("self_hosting/examples/x64_codegen_demo.patlang")

let toks = tokenize(src)
print("TOKENS: " + vec_len(toks))
let ast = parse_program(toks)
print("STMTS: " + ast[1].length)
let ir = lower_program(ast)
print("FUNCS: " + ir[2].length)
let asm = emit_program_x64(ir, true, [])
print("ASM CHARS: " + asm.length)

write_file("self_hosting/build/x64_codegen_demo.asm", asm)
print("wrote self_hosting/build/x64_codegen_demo.asm")
