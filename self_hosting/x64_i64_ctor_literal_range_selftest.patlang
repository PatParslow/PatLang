# Regression coverage for the compile-time i64-range check added to
# x64_emit_instr's tower-constructor-argument literal handling
# (self_hosting/lib/codegen_x64.patlang, x64_check_i64_ctor_literal_
# range). Found while investigating GitHub #58: a literal passed
# DIRECTLY as an argument to rt_bigint_from_i64/rt_rational_from_i64/
# rt_complex_from_i64/rt_interval_from_i64 that does not fit a genuine
# i64 (e.g. rt_bigint_from_i64(99999999999999999999)) used to compile
# silently -- NASM's own `mov reg64, imm` wraps the oversized decimal
# with no error at all, producing a garbage value at runtime instead
# of a compile-time diagnostic. This selftest runs two REAL compiles
# (via a throwaway driver script, exec_capture'd as its own process,
# since the check deliberately halts the interpreter -- see the
# checked-in comment in x64_check_i64_ctor_literal_range for why there
# is no real "halt" primitive to call otherwise) and asserts on the
# actual compiler output, not just on the helper functions in
# isolation.

include "lib/test.patlang"

t_init()

make a function called compile_one_liner takes tail_source returns out
  let driver = "include \"../lib/lexer.patlang\"\ninclude \"../lib/parser.patlang\"\ninclude \"../lib/lower.patlang\"\ninclude \"../lib/codegen_x64.patlang\"\nlet src = read_file(\"self_hosting/lib/x64_runtime.patlang\")\nlet src = src + chr(10) + " + tail_source + "\nlet toks = tokenize(src)\nlet ast = parse_program(toks)\nlet ir = lower_program(ast)\nlet asm = emit_program_x64(ir, true, [])\nprint(\"COMPILED OK\")\n"
  let driver_path = "self_hosting/build/x64_i64_range_selftest_driver.patlang"
  write_file(driver_path, driver)
  let out = exec_capture("rust-runtime/target/release/pat.exe", "--ir-run", driver_path)
  return out
end

let out_of_range = compile_one_liner("\"print(rt_bigint_from_i64(99999999999999999999))\"")
check("an i64-overflowing literal passed to rt_bigint_from_i64 is rejected at compile time, not silently miscompiled", contains_text(out_of_range, "COMPILE ERROR: literal 99999999999999999999 passed directly to rt_bigint_from_i64()"), true)
check("the rejected compile never reaches emission", contains_text(out_of_range, "COMPILED OK"), false)

let in_range = compile_one_liner("\"print(rt_bigint_from_i64(9223372036854775807))\"")
check("a literal exactly at i64::MAX is NOT a false positive", contains_text(in_range, "COMPILE ERROR"), false)
check("the in-range compile reaches emission normally", contains_text(in_range, "COMPILED OK"), true)

let small_valid = compile_one_liner("\"print(rt_bigint_from_i64(42))\"")
check("an ordinary small literal to rt_bigint_from_i64 is unaffected", contains_text(small_valid, "COMPILED OK"), true)

t_report()
