# Ground facts + variable unification + backtracking, via the ordinary
# user-facing rule_add/solve interface -- run interpreted (real Rust
# host_rule_add/host_solve, ground truth) and compiled via --x64
# (this session's new x64_runtime.patlang implementation), output
# byte-compared. GitHub #26, Stage 1 slice 3.
#
# Hand-computed expected output:
#   parent(tom,bob) -> [[tom,bob]]                  (single ground fact)
#   parent(tom,X) -> [[tom,bob]]                     (one solution, X=bob)
#   grandparent(tom,X) -> [[tom,ann]]                (via transitive rule)
#   grandparent(X,ann) -> [[bob,ann]]                (via transitive rule, other direction)

rule_add("parent", ["tom", "bob"], [])
rule_add("parent", ["bob", "ann"], [])
rule_add("grandparent", ["X", "Z"], [["parent", ["X", "Y"]], ["parent", ["Y", "Z"]]])

let r1 = solve("parent", ["tom", "bob"])
print(r1.length)
print(r1[0][0])
print(r1[0][1])

let r2 = solve("parent", ["tom", "X"])
print(r2.length)
print(r2[0][0])
print(r2[0][1])

let r3 = solve("grandparent", ["tom", "X"])
print(r3.length)
print(r3[0][0])
print(r3[0][1])

let r4 = solve("grandparent", ["X", "ann"])
print(r4.length)
print(r4[0][0])
print(r4[0][1])

# Genuine multi-solution backtracking: bob has two children, so
# grandparent(tom, X) must yield TWO solutions, not one.
rule_add("parent", ["bob", "sue"], [])
let r5 = solve("grandparent", ["tom", "X"])
print(r5.length)
print(r5[0][1])
print(r5[1][1])
