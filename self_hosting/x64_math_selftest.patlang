# Math library selftest (GitHub #25 roadmap, past Stage 0/A/B): real C
# runtime calls for sqrt/sin/cos/pow/atan2/log/exp/abs/ceil/round/trunc.
# The leading 3.5 forces float_mode for the whole program (this
# backend's per-function ALL-int-or-ALL-float classification) -- abs's
# own int-classification path is tested separately in
# x64_math_abs_int_selftest.patlang, a plain (non-float-mode) program,
# since mixing int arithmetic literals into a float-mode function is a
# separate, orthogonal known limitation (see x64_emit_instr's own
# warning), not something this selftest is meant to probe.

let force_float = 3.5

print(sqrt(2.0))
print(sin(0.0))
print(cos(0.0))
print(pow(2.0, 10.0))
print(atan2(1.0, 1.0))
print(log(1.0))
print(exp(1.0))
print(abs(0.0 - 2.5))
print(ceil(2.1))
print(round(2.5))
print(trunc(2.9))
