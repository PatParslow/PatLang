# Tiny helper .exe for x64_stagea_spawn_selftest.patlang: exits 0
# immediately, used as a spawn() target that doesn't need cmd.exe
# quoting (rt_exec_join_args's blanket per-token quoting breaks cmd's
# own quirky /c parsing -- an orthogonal, pre-existing limitation, not
# a spawn/wait bug -- so the lifecycle selftest spawns a real .exe
# directly instead).
os_exit(0)
