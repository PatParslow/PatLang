# Stage A selftest (GitHub #25 roadmap, past Stage 0): spawn/is_alive/
# wait/kill/sleep_ms.
#
# Spawns real .exe files directly (not via `cmd.exe /c`) -- cmd.exe's
# own quirky /c argument parsing breaks under rt_exec_join_args's
# blanket per-token quoting (confirmed separately: quoting each token,
# including /c itself, makes cmd.exe fail with exit code 1), an
# orthogonal pre-existing limitation shared with exec_capture, not a
# spawn/wait bug -- so this selftest sidesteps it entirely by spawning
# ping.exe (a real Win32 executable) and a tiny helper .exe that calls
# os_exit(0) (self_hosting/x64_stagea_exit0_helper.patlang, prebuilt to
# self_hosting/build/exit0_helper.exe).
#
# Hand-computed expected output:
#   1                 (is_alive true right after spawning a slow child)
#   0                 (wait() exit code for the exit0_helper child)
#   1                 (kill() on a still-running child returns true)
#   0                 (is_alive false after kill, since the process is gone)

let slow_pid = spawn("ping", "-n", "5", "127.0.0.1")
print(is_alive(slow_pid))

let done_pid = spawn("self_hosting/build/exit0_helper.exe")
print(wait(done_pid))

print(kill(slow_pid))
sleep_ms(200)
print(is_alive(slow_pid))
