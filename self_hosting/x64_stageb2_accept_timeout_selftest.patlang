# Stage B, part 2 selftest (GitHub #25 roadmap): tcp_accept_timeout.
#
# Hand-computed expected output:
#   -1                (timeout expiry: nothing connects within 100ms)
#   ok                (a connection arriving well within the timeout succeeds)

let port = tcp_listen(0)
let timed_out = tcp_accept_timeout(port, 100)
print(timed_out)

let client = tcp_connect("127.0.0.1", port)
let accepted = tcp_accept_timeout(port, 5000)
if accepted == 0 - 1 then
  print("FAILED: should have accepted")
else
  print("ok")
end
