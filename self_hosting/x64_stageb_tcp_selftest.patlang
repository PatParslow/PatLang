# Stage B, part 1 selftest (GitHub #25 roadmap, past Stage A): real TCP
# loopback round-trip. connect() doesn't need accept() to have run
# first -- the kernel completes the handshake via the listen backlog on
# its own -- so this works single-threaded: listen, connect (succeeds
# immediately via the backlog), accept (dequeues the already-established
# connection), then a real two-way message exchange.
#
# Hand-computed expected output:
#   1                 (tcp_try_listen on an already-bound port returns -1)
#   hello from client (server's tcp_read of the client's tcp_write)
#   hi back           (client's tcp_read of the server's tcp_write)

let port = tcp_listen(0)

let busy = tcp_try_listen(port)
print(busy == 0 - 1)

let client = tcp_connect("127.0.0.1", port)
let server_conn = tcp_accept(port)

tcp_write(client, "hello from client")
print(tcp_read(server_conn))

tcp_write(server_conn, "hi back")
print(tcp_read(client))

tcp_close(client)
tcp_close(server_conn)
