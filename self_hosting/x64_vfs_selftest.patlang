# VFS layer selftest (GitHub #25 roadmap, past math/bitfield): vfs_write/
# vfs_read/vfs_append/vfs_exists/vfs_list/vfs_delete.
vfs_write("/tmp/b.txt", "second")
vfs_write("/tmp/a.txt", "first")
vfs_append("/tmp/a.txt", "-appended")
print(vfs_read("/tmp/a.txt"))
print(vfs_exists("/tmp/a.txt"))
print(vfs_exists("/tmp/missing.txt"))
let listed = vfs_list("/tmp/")
print(listed.length)
print(listed[0])
print(listed[1])
print(vfs_delete("/tmp/a.txt"))
print(vfs_exists("/tmp/a.txt"))
print(vfs_delete("/tmp/a.txt"))
