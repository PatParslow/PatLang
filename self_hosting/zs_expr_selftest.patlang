# Selftest for self_hosting/lib/zs_expr.patlang: the small expression language
# schema clauses are written in (Z-flavoured: sets, maps, quantifiers,
# primed after-state names). Each check states what a clause must mean and
# compares the evaluator's answer with it.
#
# Run from the repo root:
#   rust-runtime/target/release/pat.exe --ir-run self_hosting/zs_expr_selftest.patlang

include "lib/includes.patlang"
include "lib/gherkin.patlang"
include "lib/zs_expr.patlang"

# Environment used by most checks: a number, two strings, a set, a map.
make a function called env_basic returns env
  let books = pset_add(pset_add(pset_add(pset_new(), "Dune"), "Neuromancer"), "Foundation")
  let loans = pmap_put(pmap_put(pmap_new(), "Dune", "A. Diallo"), "Foundation", "S. Okonkwo")
  let counts = pmap_put(pmap_put(pmap_new(), "A. Diallo", 2), "S. Okonkwo", 1)
  return [["x", 5], ["name", "Dune"], ["books", books], ["loans", loans], ["counts", counts], ["flag", true]]
end

# Evaluates clause text in env_basic; "PARSE ERROR: ..." if it does not parse.
make a function called ev takes ctx, text returns v
  let p = ze_parse(ctx, text)
  if p[0] != "ok" then
    return "PARSE ERROR: " + p[1]
  end
  ze_rt_clear(ctx)
  return ze_eval(ctx, p[1], env_basic())
end

let ctx = ctx_new()

# ---- arithmetic, comparison, precedence ----
expect(ctx, "addition and multiplication respect precedence", ev(ctx, "1 + 2 * 3"), 7)
expect(ctx, "parentheses override precedence", ev(ctx, "(1 + 2) * 3"), 9)
expect(ctx, "subtraction and unary minus", ev(ctx, "x - 2 + -1"), 2)
expect(ctx, "modulo", ev(ctx, "x % 3"), 2)
expect(ctx, "comparison <=", ev(ctx, "x <= 5"), true)
expect(ctx, "comparison >", ev(ctx, "x > 5"), false)
expect(ctx, "string equality", ev(ctx, "name == \"Dune\""), true)
expect(ctx, "inequality", ev(ctx, "name != \"Dune\""), false)

# ---- boolean connectives ----
expect(ctx, "and", ev(ctx, "x > 1 and x < 10"), true)
expect(ctx, "or", ev(ctx, "x > 9 or x == 5"), true)
expect(ctx, "not", ev(ctx, "not (x == 5)"), false)
expect(ctx, "implies: false antecedent holds vacuously", ev(ctx, "x > 9 implies false"), true)
expect(ctx, "implies: true antecedent needs the consequent", ev(ctx, "x == 5 implies x > 9"), false)
expect(ctx, "implies is right-associative", ev(ctx, "false implies false implies false"), true)
expect(ctx, "boolean variable", ev(ctx, "flag and true"), true)

# ---- sets ----
expect(ctx, "membership with in", ev(ctx, "name in books"), true)
expect(ctx, "non-membership", ev(ctx, "\"Hobbit\" in books"), false)
expect(ctx, "set_size", ev(ctx, "size(books)"), 3)
expect(ctx, "set_add grows a set", ev(ctx, "size(set_add(books, \"Hobbit\"))"), 4)
expect(ctx, "set_add of a member changes nothing", ev(ctx, "size(set_add(books, \"Dune\"))"), 3)
expect(ctx, "set_remove", ev(ctx, "\"Dune\" in set_remove(books, \"Dune\")"), false)
expect(ctx, "subset holds", ev(ctx, "subset(set_of(\"Dune\"), books)"), true)
expect(ctx, "subset fails", ev(ctx, "subset(set_of(\"Dune\", \"Hobbit\"), books)"), false)
expect(ctx, "set_union size", ev(ctx, "size(set_union(books, set_of(\"Hobbit\", \"Dune\")))"), 4)
expect(ctx, "set_diff size", ev(ctx, "size(set_diff(books, set_of(\"Dune\")))"), 2)
expect(ctx, "set_inter size", ev(ctx, "size(set_inter(books, set_of(\"Dune\", \"Hobbit\")))"), 1)

# ---- maps ----
expect(ctx, "map_has present", ev(ctx, "map_has(loans, \"Dune\")"), true)
expect(ctx, "map_has absent", ev(ctx, "map_has(loans, \"Neuromancer\")"), false)
expect(ctx, "map_get", ev(ctx, "map_get(loans, \"Dune\")"), "A. Diallo")
expect(ctx, "map_get_or default for a missing key", ev(ctx, "map_get_or(counts, \"Nobody\", 0)"), 0)
expect(ctx, "map_get_or finds a stored value", ev(ctx, "map_get_or(counts, \"A. Diallo\", 0)"), 2)
expect(ctx, "map_put adds a key", ev(ctx, "map_size(map_put(loans, \"Neuromancer\", \"X\"))"), 3)
expect(ctx, "map_remove drops a key", ev(ctx, "map_has(map_remove(loans, \"Dune\"), \"Dune\")"), false)
expect(ctx, "map_count_val counts the keys holding a value", ev(ctx, "map_count_val(loans, \"A. Diallo\")"), 1)
expect(ctx, "map_count_val is zero for a value nobody holds", ev(ctx, "map_count_val(loans, \"Nobody\")"), 0)
expect(ctx, "dom is the key set", ev(ctx, "size(dom(loans))"), 2)
expect(ctx, "dom membership", ev(ctx, "\"Dune\" in dom(loans)"), true)
expect(ctx, "ran is the value set", ev(ctx, "size(ran(loans))"), 2)
expect(ctx, "ran membership", ev(ctx, "\"A. Diallo\" in ran(loans)"), true)
expect(ctx, "ran drops duplicate values", ev(ctx, "size(ran(map_of(\"a\", 1, \"b\", 1, \"c\", 2)))"), 2)
expect(ctx, "image is the values reached from a set of keys", ev(ctx, "image(loans, set_of(\"Dune\")) == set_of(\"A. Diallo\")"), true)
expect(ctx, "image over the whole domain equals ran", ev(ctx, "image(loans, dom(loans)) == ran(loans)"), true)
expect(ctx, "image over an empty set of keys is empty", ev(ctx, "size(image(loans, empty_set()))"), 0)
expect(ctx, "image ignores a key not in the map", ev(ctx, "size(image(loans, set_of(\"Hobbit\")))"), 0)
expect(ctx, "map_of builds from key/value pairs", ev(ctx, "map_get(map_of(\"a\", 1, \"b\", 2), \"b\")"), 2)
expect(ctx, "empty_map has size 0", ev(ctx, "map_size(empty_map())"), 0)
expect(ctx, "empty_set has size 0", ev(ctx, "size(empty_set())"), 0)

# ---- quantifiers ----
expect(ctx, "forall over a set (true)", ev(ctx, "forall m in dom(counts) : map_get(counts, m) <= 3"), true)
expect(ctx, "forall over a set (false)", ev(ctx, "forall m in dom(counts) : map_get(counts, m) <= 1"), false)
expect(ctx, "forall over an empty set is true", ev(ctx, "forall t in empty_set() : false"), true)
expect(ctx, "exists (true)", ev(ctx, "exists m in dom(counts) : map_get(counts, m) == 2"), true)
expect(ctx, "exists over an empty set is false", ev(ctx, "exists t in empty_set() : true"), false)
expect(ctx, "subset written with a quantifier", ev(ctx, "forall t in dom(loans) : t in books"), true)
expect(ctx, "quantifier inside a conjunction (parenthesised)", ev(ctx, "x == 5 and (forall t in dom(loans) : t in books)"), true)

# ---- equality on collections ignores order ----
expect(ctx, "sets with the same members are equal in any order", ev(ctx, "set_of(\"a\", \"b\", \"c\") == set_of(\"c\", \"a\", \"b\")"), true)
expect(ctx, "sets with different members are unequal", ev(ctx, "set_of(\"a\", \"b\") == set_of(\"a\", \"c\")"), false)
expect(ctx, "sets of different size are unequal", ev(ctx, "set_of(\"a\") == set_of(\"a\", \"b\")"), false)
expect(ctx, "maps with the same pairs are equal in any order", ev(ctx, "map_of(\"a\", 1, \"b\", 2) == map_of(\"b\", 2, \"a\", 1)"), true)
expect(ctx, "maps with a different value are unequal", ev(ctx, "map_of(\"a\", 1) == map_of(\"a\", 2)"), false)
expect(ctx, "an empty set equals an empty map", ev(ctx, "empty_set() == empty_map()"), true)
expect(ctx, "a number never equals a string", ev(ctx, "5 == \"5\""), false)
# An int and a float of the same value are equal. A backend that tags a
# computed integer as a float where a literal digit stays an int (a real,
# confirmed WASM-interpreter quirk, not a native one) would otherwise fail
# every numeric comparison whose two sides took different routes to the same
# value -- exactly what "size(a_set) == 3" does once size's own to_num call
# retags its already-integer result.
expect(ctx, "an int and a float of the same value are equal", ze_val_eq(3, 3.0), true)
expect(ctx, "an int and a float of different values are not", ze_val_eq(3, 4.0), false)
# ze_eval's own "==" operator calls ze_val_eq directly, so the fix covers a
# parsed clause too; there is no float literal syntax to write inside clause
# text to test this natively (the tokenizer only scans digits, no decimal
# point -- a separate, smaller gap, not needed for this fix, since every
# float this bug involves is computed, e.g. by size(), never written literally).

# ---- canonical form (used to recognise a state already seen) ----
expect(ctx, "canonical form ignores set order", ze_canon(pset_add(pset_add(pset_new(), "a"), "b")), ze_canon(pset_add(pset_add(pset_new(), "b"), "a")))
expect(ctx, "canonical form ignores map order", ze_canon(pmap_put(pmap_put(pmap_new(), "a", 1), "b", 2)), ze_canon(pmap_put(pmap_put(pmap_new(), "b", 2), "a", 1)))
expect(ctx, "canonical form separates different sets", ze_canon(pset_add(pset_new(), "a")) != ze_canon(pset_add(pset_new(), "b")), true)
expect(ctx, "canonical form separates 1 from \"1\"", ze_canon(1) != ze_canon("1"), true)
expect(ctx, "canonical form separates a value in a map from a value as a key", ze_canon(pmap_put(pmap_new(), "a", "b")) != ze_canon(pmap_put(pmap_new(), "b", "a")), true)

# ---- values as a person would write them ----
expect(ctx, "a string is quoted", ze_show("Dune"), "\"Dune\"")
expect(ctx, "a number is digits", ze_show(10), "10")
expect(ctx, "a set is braced", ze_show(pset_add(pset_add(pset_new(), "a"), "b")), "{\"a\", \"b\"}")
expect(ctx, "a map shows key arrows", ze_show(pmap_put(pmap_new(), "a", 1)), "{\"a\" -> 1}")
expect(ctx, "an empty collection", ze_show([]), "{}")

# ---- free variables ----
let fv = ze_free_vars(ze_parse(ctx, "x > 1 and name in books")[1])
expect(ctx, "free variables are collected without duplicates", to_num(list_len(fv)), 3)
let fv2 = ze_free_vars(ze_parse(ctx, "forall m in dom(counts) : map_get(counts, m) <= x")[1])
expect(ctx, "a quantifier's own variable is not free", to_num(list_len(fv2)), 2)
let fv3 = ze_free_vars(ze_parse(ctx, "books' == set_add(books, t)")[1])
expect(ctx, "a primed name is a distinct free variable", to_num(list_len(fv3)), 3)

# ---- errors are reported, not silently false ----
expect(ctx, "a dangling operator is a parse error", ev(ctx, "1 +")[0], "P")
let bad = ze_parse(ctx, "x >")
expect(ctx, "parse errors carry a tag", bad[0], "error")
let bad2 = ze_parse(ctx, "x $ 3")
expect(ctx, "an unknown character is a parse error", bad2[0], "error")
let bad3 = ze_parse(ctx, "foo(")
expect(ctx, "an unclosed call is a parse error", bad3[0], "error")
ze_rt_clear(ctx)
let unbound = ze_eval(ctx, ze_parse(ctx, "nosuchvar + 1")[1], env_basic())
expect(ctx, "an unbound name sets the runtime error", ze_rt_error(ctx) != "", true)

ctx_report(ctx)
