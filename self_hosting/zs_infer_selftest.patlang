# Selftest for lib/zs_infer.patlang: inferring a declared-schema skeleton from
# an existing Gherkin feature, the reverse of zs_generate (schema -> Gherkin).
#
# What is inferable from Gherkin text alone, and what is not, drives the
# whole design. A quoted span or a bare number that recurs with a different
# value is a real, mechanical signal for a capture -- the same convention
# every hand-written feature in this codebase already follows (Liu's own
# "Bowen inserts 10 dollars" quotes nothing but generalises the number; this
# project's own scenarios quote every value meant to vary). What a phrase
# ASSERTS about the state is not inferable at all: nothing in Gherkin text
# names a state model. So the skeleton gets real capture structure -- fact,
# then and do templates, one operation per goal, correctly arITied inputs --
# and vacuous `require true`/`ensure true` placeholders a person replaces
# with real meaning. The skeleton is valid PatLang from the moment it is
# written: it loads (zs_load) immediately, though exploring it needs the
# domain and state lines a person must still add (flagged as TODO comments,
# never guessed at).
#
# Run from the repo root:
#   rust-runtime/target/release/pat.exe --ir-run self_hosting/zs_infer_selftest.patlang

include "lib/test.patlang"
include "lib/zs_infer.patlang"

make a function called borrowing_feature returns text
  return "Feature: Borrowing a book
  A member wants to borrow a book

  Scenario: An available title
    Given \"Dune\" is in the catalogue
    When \"A. Diallo\" borrows \"Dune\"
    Then \"Dune\" is borrowed by \"A. Diallo\"

  Scenario: A different title and member
    Given \"Neuromancer\" is in the catalogue
    When \"S. Okonkwo\" borrows \"Neuromancer\"
    Then \"Neuromancer\" is borrowed by \"S. Okonkwo\"
"
end

# Checks a zi_match_require/zi_match_ensure result by its tag and clause
# text separately, rather than comparing the whole ["hit", text] or ["no"]
# result as one list: the native x64 backend's `==` does not do value
# equality on List (confirmed with a minimal repro -- ["no"] == ["no"] is
# false there, unrelated to anything this file tests), so a whole-list
# comparison would read as a real failure natively while the actual result
# is correct. Every other check in this file already compares scalar
# sub-fields for the same reason; this keeps that convention.
make a function called check_match takes label, hit, expected_tag, expected_text returns ok
  let tag_ok = check(label + " (tag)", hit[0], expected_tag)
  if expected_tag != "hit" then
    return tag_ok
  end
  let text_ok = check(label + " (clause)", hit[1], expected_text)
  return tag_ok and text_ok
end

make a function called count_occurrences takes text, needle returns n
  let h = str_intern(text)
  let hn = sc_len(h)
  let count = 0
  let i = 0
  while i + sc_len(str_intern(needle)) <= hn do
    if sm_at(h, hn, needle, i) then
      let count = count + 1
    end
    let i = i + 1
  end
  return count
end

t_init()

# ---- the capture-inference mechanism on its own ----
let r1 = zi_templatize("\"Dune\" is in the catalogue")
check("a quoted span becomes a placeholder", r1[0], "\"{p1}\" is in the catalogue")
check("its captured value is recorded", r1[1][0], "Dune")

let r2 = zi_templatize("Bowen inserts 10 dollars")
check("a bare number becomes a placeholder", r2[0], "Bowen inserts {p1} dollars")
check("its captured value is recorded as text", r2[1][0], "10")

let r3 = zi_templatize("cookie is in stock")
check("plain unquoted words are left alone (a real, documented limitation)", r3[0], "cookie is in stock")
check("no captures are invented for them", to_num(list_len(r3[1])), 0)

let r4 = zi_templatize("\"A. Diallo\" borrows \"Dune\"")
check("two quoted spans become two placeholders", r4[0], "\"{p1}\" borrows \"{p2}\"")
check("captures are positional and in order", r4[1][0], "A. Diallo")
check("second capture in order", r4[1][1], "Dune")

let r5 = zi_templatize("the library holds its standard catalogue")
check("a line with nothing to capture is left exactly as written", r5[0], "the library holds its standard catalogue")

# ---- the full skeleton ----
let skeleton = zi_infer_skeleton(borrowing_feature())
check("the skeleton names a schema", contains_text(skeleton, "schema "), true)
check("the operation is named from the goal", contains_text(skeleton, "operation BorrowABook("), true)
check("the operation has two inputs, from the When line's two captures", contains_text(skeleton, "operation BorrowABook(p1, p2)"), true)
check("a placeholder precondition is present", contains_text(skeleton, "require true"), true)
check("a placeholder postcondition is present", contains_text(skeleton, "ensure true"), true)
check("the Given fact is inferred, deduplicated across both scenarios", count_occurrences(skeleton, "fact \"{p1}\" is in the catalogue => true"), 1)
check("the When action is inferred as a do line", contains_text(skeleton, "do \"{p1}\" borrows \"{p2}\" => BorrowABook(p1, p2)"), true)
check("the Then outcome is inferred as a then line", contains_text(skeleton, "then \"{p1}\" is borrowed by \"{p2}\" => true"), true)
check("the goal line maps the narrative to the inferred operation", contains_text(skeleton, "goal borrow a book => BorrowABook"), true)
check("a TODO marks where state variables belong", contains_text(skeleton, "TODO"), true)

# ---- the skeleton is real, loadable PatLang, from the moment it is written ----
let loaded = zs_load(skeleton)
check("the skeleton loads without a syntax error", loaded[0], "ok")

# Exploring it honestly fails: no domain was declared for either input, and
# none was guessed at.
let name = loaded[1]
check("exploring the bare skeleton is refused, not guessed at", zs_explore(name, 1000)[0], "missing_domain")

# ---- a feature with only one scenario still infers correctly (no repeat needed) ----
let single_feature = "Feature: A single scenario
  Someone wants to do a thing

  Scenario: Only one
    Given \"X\" is ready
    When \"X\" is used
    Then \"X\" is consumed
"
let single_skeleton = zi_infer_skeleton(single_feature)
check("a single occurrence still infers a capture (quoting is the signal, not repetition)", contains_text(single_skeleton, "fact \"{p1}\" is ready => true"), true)

# ---- a feature with no goal narrative still infers something usable ----
let no_goal_feature = "Feature: No narrative
  Scenario: Something happens
    Given \"X\" exists
    When \"X\" is touched
    Then \"X\" changes
"
let no_goal_skeleton = zi_infer_skeleton(no_goal_feature)
check("a missing goal narrative gets a generic operation name, not a crash", contains_text(no_goal_skeleton, "operation Op1("), true)
check("no goal line is written when there is no narrative to draw one from", contains_text(no_goal_skeleton, "goal "), false)

# ---- Phase 3: real require/ensure clauses from a closed phrase vocabulary ----
#
# zi_word_to_number: digits and the small closed set of number words this
# phase recognises.
check("a digit string is a number", zi_word_to_number("10"), 10)
check("the indefinite article means one", zi_word_to_number("a"), 1)
check("\"an\" also means one", zi_word_to_number("an"), 1)
check("\"one\" spelled out", zi_word_to_number("one"), 1)
check("\"ten\" spelled out", zi_word_to_number("ten"), 10)
check("an unrecognised word is not a number", zi_word_to_number("dog"), -1)

# zi_match_require: the map-shaped and scalar-shaped precondition patterns.
let states1 = ["inventory", "balance"]
check_match("a map \"contains at least\" phrase becomes a real require clause",
  zi_match_require("vending machine inventory contains at least one cookie", states1),
  "hit", "map_get_or(inventory, \"cookie\", 0) >= 1")
check_match("\"contains at most\" becomes <=",
  zi_match_require("inventory contains at most 3 chips", states1),
  "hit", "map_get_or(inventory, \"chips\", 0) <= 3")
check_match("a possessive \"is at least\" phrase becomes a real require clause",
  zi_match_require("Bowen's balance is at least 10 dollars", states1),
  "hit", "balance >= 10")
check_match("\"is exactly\" becomes ==",
  zi_match_require("Bowen's balance is exactly 5 dollars", states1),
  "hit", "balance == 5")
check_match("an unresolved subject is refused, not guessed at",
  zi_match_require("the queue contains at least one ticket", states1),
  "no", "")
check_match("plain prose with no pattern is left alone",
  zi_match_require("cookie is in stock", states1),
  "no", "")

# zi_match_ensure: the map-shaped and scalar-shaped postcondition patterns.
check_match("a map \"subtracts\" phrase becomes a real ensure clause",
  zi_match_ensure("the vending machine inventory subtracts a cookie", states1),
  "hit", "inventory' == map_put(inventory, \"cookie\", map_get(inventory, \"cookie\") - 1)")
check_match("\"adds\" becomes +",
  zi_match_ensure("inventory adds 2 chips", states1),
  "hit", "inventory' == map_put(inventory, \"chips\", map_get(inventory, \"chips\") + 2)")
check_match("a possessive \"is decreased by\" phrase becomes a real ensure clause",
  zi_match_ensure("Bowen's balance is decreased by 10 dollars", states1),
  "hit", "balance' == balance - 10")
check_match("\"is increased by\" becomes +",
  zi_match_ensure("Bowen's balance is increased by 5 dollars", states1),
  "hit", "balance' == balance + 5")
check_match("\"becomes\" sets the value directly",
  zi_match_ensure("Bowen's balance becomes 0 dollars", states1),
  "hit", "balance' == 0")
check_match("an unrelated Then phrase is left alone",
  zi_match_ensure("the vending machine dispenses a cookie", states1),
  "no", "")

# The full skeleton, given the real state names, with the user's own example.
let priced_feature = "Feature: Buying a snack using money
  As a user
  Bowen wants to buy a snack with money
  So that Bowen can get a snack to eat

  Scenario: Buying a cookie using money when the cookie is in stock
    Given cookie is in stock
    And vending machine inventory contains at least one cookie
    And Bowen's balance is at least 10 dollars
    When Bowen inserts 10 dollars
    And Bowen selects cookie
    Then the vending machine dispenses a cookie
    And the vending machine inventory subtracts a cookie
    And Bowen's balance is decreased by 10 dollars
"
let priced_skeleton = zi_infer_skeleton_with_state(priced_feature, ["inventory", "balance"])
check("state is declared for real once the caller supplies real names", contains_text(priced_skeleton, "state inventory, balance"), true)
check("the map precondition is inferred", contains_text(priced_skeleton, "require map_get_or(inventory, \"cookie\", 0) >= 1"), true)
check("the scalar precondition is inferred", contains_text(priced_skeleton, "require balance >= 10"), true)
check("the placeholder require is dropped once real ones exist", contains_text(priced_skeleton, "require true"), false)
check("the map postcondition is inferred", contains_text(priced_skeleton, "ensure inventory' == map_put(inventory, \"cookie\", map_get(inventory, \"cookie\") - 1)"), true)
check("the scalar postcondition is inferred", contains_text(priced_skeleton, "ensure balance' == balance - 10"), true)
check("the placeholder ensure is dropped once real ones exist", contains_text(priced_skeleton, "ensure true"), false)
check("the plain, pattern-less Given still becomes a vacuous fact, unchanged", contains_text(priced_skeleton, "fact cookie is in stock => true"), true)
check("the plain, pattern-less Then still becomes a vacuous then, unchanged", contains_text(priced_skeleton, "then the vending machine dispenses a cookie => true"), true)

# The inferred clauses must be real PatLang that a fully-specified schema
# (init added by hand, since no phrase says what things start at) actually
# loads and explores -- not merely text that looks right.
let priced_full = priced_skeleton + "\ninit inventory = map_of(\"cookie\", 2)\ninit balance = 0\n"
let priced_loaded = zs_load(priced_full)
check("the inferred clauses parse as real, loadable clause expressions", priced_loaded[0], "ok")

# Backward compatibility: the original one-argument entry point must behave
# exactly as before -- no state names in means no real clauses out.
let unstated_skeleton = zi_infer_skeleton(priced_feature)
check("with no state names supplied, the placeholder require is unchanged", contains_text(unstated_skeleton, "require true"), true)
check("with no state names supplied, the placeholder ensure is unchanged", contains_text(unstated_skeleton, "ensure true"), true)
check("with no state names supplied, the TODO state comment is unchanged", contains_text(unstated_skeleton, "TODO: this schema has no state yet"), true)

# ---- Also inferring the state variables themselves, from the same table ----
#
# A variable is only ever proposed when some phrase names it through one of
# zi_match_require/zi_match_ensure's own recognised shapes -- never guessed
# from an ordinary noun like the item ("cookie") or the actor ("Bowen").
check("a map-shaped phrase names its own subject as a candidate variable",
  zi_candidate_state_var("vending machine inventory contains at least one cookie"), "inventory")
check("a scalar-shaped phrase names its own field as a candidate variable",
  zi_candidate_state_var("Bowen's balance is at least 10 dollars"), "balance")
check("an ensure-shaped phrase names its subject too",
  zi_candidate_state_var("the vending machine inventory subtracts a cookie"), "inventory")
check("plain prose with no recognised shape names no candidate",
  zi_candidate_state_var("cookie is in stock"), "")
check("an unrelated Then phrase names no candidate",
  zi_candidate_state_var("the vending machine dispenses a cookie"), "")

let auto_vars = zi_infer_state_vars(priced_feature)
check("both real variables are found across the feature", to_num(list_len(auto_vars)), 2)
check("inventory is found, in the order its phrase first appears", auto_vars[0], "inventory")
check("balance is found second, matching its phrase's position", auto_vars[1], "balance")

# The fully-automatic entry point needs no state names supplied at all, and
# produces exactly what handing the same inferred names to
# zi_infer_skeleton_with_state would -- it is that function, not a
# different, looser one.
let auto_skeleton = zi_infer_skeleton_auto(priced_feature)
check("the automatic pipeline matches calling zi_infer_skeleton_with_state with its own inferred names", auto_skeleton, priced_skeleton)

# A feature with no recognised quantity/arithmetic phrase at all -- the
# project's own real vending-machine feature -- proposes no state variables,
# and the automatic pipeline falls back to exactly Phase 1's own output;
# nothing is invented just because automatic inference was asked for.
let plain_feature = read_file("self_hosting/examples/zs/vending_machine.feature")
check("a feature with no recognised phrase gets no proposed state variables", to_num(list_len(zi_infer_state_vars(plain_feature))), 0)
check("the automatic pipeline then matches Phase 1 alone, unchanged", zi_infer_skeleton_auto(plain_feature), zi_infer_skeleton(plain_feature))

# ---- Phase 2: proposing already-declared facts as candidate requires ----
#
# A person has filled in real facts on a schema; some traced-through states
# are known (from checking a feature) to precede an ACCEPTED scenario's
# operation, others to precede a REJECTED one. A fact that holds in every
# accepted state and fails in some rejected one is a real, checkable
# correlation -- worth proposing as a `require`, though never as more than
# that.
let induction_schema = "schema Induction
  state cnt, amt
  init cnt = 0
  init amt = 0

  fact balance is positive => cnt > 0
  fact amount is small => amt <= 10
"
let iloaded = zs_load(induction_schema)
check("the induction test schema loads", iloaded[0], "ok")
let ientry = zs_entry(iloaded[1])

let accepted_envs = [[["cnt", 5], ["amt", 1]], [["cnt", 5], ["amt", 2]]]
let rejected_envs = [[["cnt", 5], ["amt", 100]]]
let suggestions = zi_suggest_requires(ientry, accepted_envs, rejected_envs)

check("exactly one fact is proposed: the one that actually discriminates", to_num(list_len(suggestions)), 1)
check("the proposed fact is the discriminating one, not the always-true one", suggestions[0][0], "amount is small")
check("it reports its support count across accepted states", suggestions[0][1], 2)
check("it reports how many rejected states it correctly excludes", suggestions[0][2], 1)
check("it reports the total rejected states it was checked against", suggestions[0][3], 1)

# A fact true everywhere (accepted AND rejected) is a real fact, but does
# not discriminate, so it is correctly left unsuggested -- not every true
# fact is a precondition, and this must not over-claim that it is.
let always_true_envs = [[["cnt", 5], ["amt", 1]]]
let no_signal = zi_suggest_requires(ientry, accepted_envs, always_true_envs)
check("a fact holding in every accepted AND every rejected state is not proposed", to_num(list_len(no_signal)), 0)

# With no accepted states at all, there is nothing to require support from,
# so nothing is proposed -- an empty accepted set must never be treated as
# vacuously satisfied.
let no_accepted = zi_suggest_requires(ientry, [], rejected_envs)
check("no accepted states means no suggestions, not a vacuous true", to_num(list_len(no_accepted)), 0)

t_report()
