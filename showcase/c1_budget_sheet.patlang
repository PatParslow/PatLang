# A household budget that checks its own sums.
#
# Paradigms: objects, events, exact numbers and contracts.
#
# Each budget line is an object; changing one raises an event, and a handler
# brings the totals up to date. Every method that moves money states, as a
# contract, what must be true afterwards: a transfer between lines leaves the
# total unchanged, a split divides an amount into parts that add back to it
# exactly. Because the amounts are exact fractions, those contracts can use ==
# and still hold after a third of 100.00 has been moved three ways. A wrong
# change stops at the method that made it, before anything is moved; the last
# part tries one inside a world, so only that world stops.

class Line {
  field name = ""
  field amount = 0
  make a function called set takes self, v returns value raises line_changed
    self.amount = v
    return v
  end
}

class Budget {
  field lines = 0
  field total = 0
  field changes = 0
}

make a function called budget_new returns b
  let b = new("Budget")
  b.lines = vec_new()
  return b
end

make a function called add_line takes b, name, amount returns l
  let l = new("Line")
  l.name = name
  l.amount = amount
  vec_push(b.lines, l)
  b.total = b.total + amount
  return l
end

make a function called line takes b, name returns l
  let i = 0
  while i < vec_len(b.lines) do
    let l = vec_get(b.lines, i)
    if l.name == name then
      return l
    end
    let i = i + 1
  end
  assert false
  return l
end

make a function called sum_lines takes b returns s
  let s = 0
  let i = 0
  while i < vec_len(b.lines) do
    let l = vec_get(b.lines, i)
    let s = s + l.amount
    let i = i + 1
  end
  return s
end

# Moves amount from one line to another; the total is unchanged, exactly.
make a function called transfer takes b, from, to, amount returns total
  require amount > 0
  let before = sum_lines(b)
  line(b, from).set(line(b, from).amount - amount)
  line(b, to).set(line(b, to).amount + amount)
  let total = sum_lines(b)
  ensure total == before
  return total
end

# Moves a line's whole amount into others, in equal shares, exactly.
make a function called split takes b, from, into returns shares
  require list_len(into) > 0
  let amount = line(b, from).amount
  let share = amount / list_len(into)
  let before = sum_lines(b)
  line(b, from).set(0)
  let i = 0
  while i < list_len(into) do
    line(b, into[i]).set(line(b, into[i]).amount + share)
    let i = i + 1
  end
  let shares = share
  ensure (shares * list_len(into) == amount) and (sum_lines(b) == before)
  return shares
end

make a function called money takes x returns text
  let pennies = floor(x * 100 + 1 / 2)
  let pad = ""
  if pennies % 100 < 10 then
    let pad = "0"
  end
  return "" + floor(pennies / 100) + "." + pad + (pennies % 100)
end

make a function called show takes b returns done
  let i = 0
  while i < vec_len(b.lines) do
    let l = vec_get(b.lines, i)
    print("  " + l.name + ": " + money(l.amount) + "  (exactly " + l.amount + ")")
    let i = i + 1
  end
  print("  total " + money(b.total) + ", after " + b.changes + " changes")
  return true
end

let budget = budget_new()

# The handler keeps the running total; it sees every change to every line.
when line_changed do
  budget.changes = budget.changes + 1
  budget.total = sum_lines(budget)
end

add_line(budget, "rent", 900)
add_line(budget, "food", 300)
add_line(budget, "savings", 100)
add_line(budget, "fun", 0)
add_line(budget, "gifts", 0)
add_line(budget, "repairs", 0)

print("== the budget ==")
show(budget)

print("== 50 moved from food to fun ==")
transfer(budget, "food", "fun", 50)
show(budget)

print("== savings split three ways ==")
let share = split(budget, "savings", ["fun", "gifts", "repairs"])
print("  each share is " + share + ", and three shares are " + (share * 3))
show(budget)

# A transfer of a negative amount breaks transfer's require. Tried in a world
# of its own, the stop ends that world and the program carries on.
print("== a transfer of -20, tried in a world of its own ==")
let w = world_new()
let tried = world_call(w, || do
  return transfer(budget, "fun", "food", 0 - 20)
end)
world_free(w)
print("  the world " + tried[0] + "; the total is still " + money(sum_lines(budget)) + ", after " + budget.changes + " changes")
