# Two agents after the same coins.
#
# Paradigms: goal-oriented planning, fibres, events and worlds.
#
# A row of seven squares holds two coins. Each agent wants a coin and plans
# the cheapest way to get one. The agents are fibres: the game resumes each in
# turn, and each yields the one move it wants to make. Each agent plans in a
# world of its own, so its planning facts and numbers are its own; two agents
# planning at once cannot see or disturb each other's plans. When an agent
# takes a coin the game raises an event; the other agent's plan may be aimed
# at that coin, so it marks itself stale and plans again next turn.

class Game {
  field coins = []
  field log = 0
}

class Agent {
  field name = ""
  field pos = 0
  field has_coin = 0
  field stale = true
  field plan = []
}

# The agent's plan from the game as it is now, made in a world of its own:
# the actions and numbers it plans with exist only there, and go with it.
make a function called plan_for takes agent, game returns steps
  let pos = agent.pos
  let coins = game.coins
  let w = world_new()
  let r = world_call(w, || do
    fluent_set("pos", pos)
    fluent_set("has_coin", 0)
    action_add_numeric("right", [], [["pos", "<", 6]], [], [], [["pos", "+=", 1]], 1)
    action_add_numeric("left", [], [["pos", ">", 0]], [], [], [["pos", "-=", 1]], 1)
    let i = 0
    while i < list_len(coins) do
      action_add_numeric("take_at_" + coins[i], [], [["pos", "==", coins[i]]], [], [], [["has_coin", "=", 1]], 1)
      let i = i + 1
    end
    return plan_numeric([], [["has_coin", "==", 1]])
  end)
  world_free(w)
  # a world's call gives ["done", value], or says how it stopped
  assert r[0] == "done"
  let steps = r[1]
  return steps
end

# An agent, as a fibre: plans when its plan is stale, then yields its next
# move. The first resume passes in [agent, game].
make a function called agent_loop takes start returns last
  let agent = start[0]
  let game = start[1]
  while agent.has_coin == 0 do
    if agent.stale then
      agent.plan = plan_for(agent, game)
      agent.stale = false
      vec_push(game.log, agent.name + " plans: " + plan_labels(agent.plan))
    end
    let move = step_name(agent.plan[0])
    agent.plan = list_drop_first(agent.plan)
    fiber_yield(move)
  end
  while true do
    fiber_yield("done")
  end
  return 0
end

make a function called list_drop_first takes items returns rest
  let rest = []
  let i = 1
  while i < list_len(items) do
    let rest = list_push(rest, items[i])
    let i = i + 1
  end
  return rest
end

make a function called without takes items, x returns rest
  let rest = []
  let i = 0
  while i < list_len(items) do
    if items[i] != x then
      let rest = list_push(rest, items[i])
    end
    let i = i + 1
  end
  return rest
end

# Carries out a move; a take of a coin still there raises coin_taken.
make a function called apply_move takes game, agent, move returns done
  if move == "right" then
    agent.pos = agent.pos + 1
  elif move == "left" then
    agent.pos = agent.pos - 1
  elif move != "done" then
    let at = agent.pos
    if list_len(without(game.coins, at)) < list_len(game.coins) then
      game.coins = without(game.coins, at)
      agent.has_coin = 1
      emit("coin_taken", [agent.name, at])
    else
      # the coin went before this agent got there: plan again
      agent.stale = true
    end
  end
  return true
end

let game = new("Game")
game.coins = [2, 5]
game.log = vec_new()

let ann = new("Agent")
ann.name = "ann"
ann.pos = 0
let bo = new("Agent")
bo.name = "bo"
bo.pos = 3
let agents = [ann, bo]

# Every agent still after a coin hears that one is gone, and plans again.
when coin_taken do
  vec_push(game.log, event_data[0] + " takes the coin at " + event_data[1])
  let k = 0
  while k < list_len(agents) do
    let other = agents[k]
    if (other.name != event_data[0]) and (other.has_coin == 0) then
      other.stale = true
    end
    let k = k + 1
  end
end

let fibres = [fiber_new("agent_loop"), fiber_new("agent_loop")]
let turn = 0
while ((ann.has_coin == 0) or (bo.has_coin == 0)) and (turn < 20) do
  let a = 0
  while a < list_len(agents) do
    let agent = agents[a]
    if agent.has_coin == 0 then
      let move = fiber_resume(fibres[a], [agent, game])
      apply_move(game, agent, move)
      vec_push(game.log, "turn " + (turn + 1) + ": " + agent.name + " " + move + ", now on " + agent.pos)
    end
    let a = a + 1
  end
  let turn = turn + 1
end

print(str_join(vec_to_list(game.log), chr(10)))
print("ann has a coin: " + (ann.has_coin == 1) + ", bo has a coin: " + (bo.has_coin == 1))
