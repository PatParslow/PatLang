# A build system in a page.
#
# Paradigms: logic programming, parallel functional code and a durable queue.
#
# Targets and what each depends on are facts; a rule says what a target
# needs, directly or not. The builder works in waves: every target whose
# dependencies are built is ready, and the ready ones are built at the same
# time by parallel_map. Each finished target is recorded in a queue on disk
# as soon as it is built, so a build that is interrupted resumes where it
# stopped and rebuilds nothing it already has.
#
# "Building" a target here is computing a checksum of its name and its
# dependencies' checksums, so a change anywhere shows in everything above it.
#
# Given --page PATH, the program also draws the dependency graph as a web
# page, from the same facts the builder uses: a column for each wave, its
# targets grouped, a curve from each dependency to what needs it, and each
# target titled with its checksum (lib/dom.patlang).

include "../self_hosting/lib/queue.patlang"
include "../self_hosting/lib/dom.patlang"

rule depends(app, ui).
rule depends(app, core).
rule depends(app, net).
rule depends(ui, core).
rule depends(net, core).
rule depends(core, util).
rule depends(tests, app).
rule depends(tests, util).
rule target(util).
rule target(core).
rule target(net).
rule target(ui).
rule target(app).
rule target(tests).
rule needs(T, D) :- depends(T, D).
rule needs(T, D) :- depends(T, X), needs(X, D).

make a function called has takes items, x returns yes
  let i = 0
  while i < list_len(items) do
    if items[i] == x then
      return true
    end
    let i = i + 1
  end
  return false
end

make a function called direct_deps takes t returns deps
  let sols = solve("depends", [t, logic_var("D")])
  let deps = []
  let i = 0
  while i < list_len(sols) do
    let deps = list_push(deps, sols[i][1])
    let i = i + 1
  end
  return deps
end

# The targets not yet built whose dependencies all are.
make a function called ready takes built returns out
  let all = solve("target", [logic_var("T")])
  let out = []
  let i = 0
  while i < list_len(all) do
    let t = all[i][0]
    if not has(built, t) then
      let deps = direct_deps(t)
      let ok = true
      let k = 0
      while k < list_len(deps) do
        if not has(built, deps[k]) then
          let ok = false
        end
        let k = k + 1
      end
      if ok then
        let out = list_push(out, t)
      end
    end
    let i = i + 1
  end
  return out
end

# A checksum of a text: the sum of its bytes times their positions, mod 9973.
make a function called checksum takes text returns c
  let b = bytes_from_str(text)
  let c = 0
  let i = 0
  while i < bytes_len(b) do
    let c = (c + b[i] * (i + 1)) % 9973
    let i = i + 1
  end
  return c
end

# One build job: [target, its dependencies' checksums] -> [target, checksum].
make a function called build_one takes job returns result
  return [job[0], checksum(job[0] + ":" + str_join(job[1], ","))]
end

let topic = "showcase_c3_built"
queue_remove_topic(topic)

# The build, in waves, starting from the [target, checksum] pairs already
# built. stop_after_waves < 0 builds everything; otherwise the builder stops
# after that many waves, as an interrupted build would.
make a function called build takes topic, sums, stop_after_waves returns built
  let built = []
  let i = 0
  while i < list_len(sums) do
    let built = list_push(built, sums[i][0])
    let i = i + 1
  end
  let wave = 0
  while true do
    let todo = ready(built)
    if list_len(todo) == 0 then
      if wave == 0 then
        print("  nothing to build: every target is up to date")
      end
      return built
    end
    if wave == stop_after_waves then
      print("  interrupted before building " + str_join(todo, ", "))
      return built
    end
    let jobs = []
    let j = 0
    while j < list_len(todo) do
      let deps = direct_deps(todo[j])
      let dep_sums = []
      let d = 0
      while d < list_len(deps) do
        let k = 0
        while k < list_len(sums) do
          if sums[k][0] == deps[d] then
            let dep_sums = list_push(dep_sums, "" + sums[k][1])
          end
          let k = k + 1
        end
        let d = d + 1
      end
      let jobs = list_push(jobs, [todo[j], dep_sums])
      let j = j + 1
    end
    let results = parallel_map(jobs, "build_one")
    let r = 0
    while r < list_len(results) do
      queue_publish(topic, results[r][0] + " " + results[r][1])
      let sums = list_push(sums, results[r])
      let built = list_push(built, results[r][0])
      let r = r + 1
    end
    print("  wave " + (wave + 1) + ": built " + str_join(todo, ", "))
    let wave = wave + 1
  end
  return built
end

# What earlier runs recorded: each message is "target checksum", read back as
# [target, checksum]. (q_read gives each message as [id, status, payload].)
make a function called sums_on_disk takes topic returns sums
  let rows = q_read(topic)
  let sums = []
  let i = 0
  while i < list_len(rows) do
    let text = rows[i][2]
    let sp = 0
    while text[sp] != " " do
      let sp = sp + 1
    end
    let sums = list_push(sums, [substr(text, 0, sp), to_num(substr(text, sp + 1, text.length - sp - 1))])
    let i = i + 1
  end
  return sums
end

# ---- the page ----

# The waves a build from nothing makes: each the targets ready once the
# earlier waves are built.
make a function called waves_of returns waves
  let waves = []
  let built = []
  let todo = ready(built)
  while list_len(todo) > 0 do
    let waves = list_push(waves, todo)
    let t = 0
    while t < list_len(todo) do
      let built = list_push(built, todo[t])
      let t = t + 1
    end
    let todo = ready(built)
  end
  return waves
end

# [wave index, row in it] of target t.
make a function called place_of takes waves, t returns at
  let k = 0
  while k < list_len(waves) do
    let i = 0
    while i < list_len(waves[k]) do
      if waves[k][i] == t then
        return [k, i]
      end
      let i = i + 1
    end
    let k = k + 1
  end
  assert false
  return [0, 0]
end

make a function called sum_of takes sums, t returns c
  let i = 0
  while i < list_len(sums) do
    if sums[i][0] == t then
      return sums[i][1]
    end
    let i = i + 1
  end
  return 0
end

# A column of 120 per wave, rows of 50 from 80. Each edge is a curve that
# arcs up 30 for each wave it passes over, so it clears the boxes between.
make a function called graph_page takes sums returns page
  let waves = waves_of()
  let page = dom_page("The build's dependencies")
  let body = dom_body(page)
  dom_set_text(dom_append(body, dom_element("h1")), "The build's dependencies")
  let rows = 0
  let k = 0
  while k < list_len(waves) do
    let rows = max(rows, list_len(waves[k]))
    let k = k + 1
  end
  let svg = dom_append(body, dom_element("svg"))
  dom_set_attr(svg, "width", "" + (20 + 120 * list_len(waves)))
  dom_set_attr(svg, "height", "" + (80 + 50 * rows))
  let count = 0
  let k = 0
  while k < list_len(waves) do
    let i = 0
    while i < list_len(waves[k]) do
      let t = waves[k][i]
      let count = count + 1
      let deps = direct_deps(t)
      let d = 0
      while d < list_len(deps) do
        let from = place_of(waves, deps[d])
        let x1 = 20 + 120 * from[0] + 80
        let y1 = 80 + 50 * from[1] + 15
        let x2 = 20 + 120 * k
        let y2 = 80 + 50 * i + 15
        let bend = 0 - 30 * (k - from[0] - 1)
        let path = dom_append(svg, dom_element("path"))
        dom_set_attr(path, "d", "M " + x1 + " " + y1 + " C " + (x1 + 40) + " " + (y1 + bend) + " " + (x2 - 40) + " " + (y2 + bend) + " " + x2 + " " + y2)
        dom_set_attr(path, "fill", "none")
        dom_set_attr(path, "stroke", "#94a3b8")
        let d = d + 1
      end
      let i = i + 1
    end
    let k = k + 1
  end
  let k = 0
  while k < list_len(waves) do
    let x = 20 + 120 * k
    let g = dom_append(svg, dom_element("g"))
    dom_set_attr(g, "id", "wave-" + (k + 1))
    let label = dom_set_text(dom_append(g, dom_element("text")), "wave " + (k + 1))
    dom_set_attr(label, "x", "" + (x + 40))
    dom_set_attr(label, "y", "40")
    dom_set_attr(label, "text-anchor", "middle")
    let i = 0
    while i < list_len(waves[k]) do
      let t = waves[k][i]
      let y = 80 + 50 * i
      let box = dom_append(g, dom_element("rect"))
      dom_set_attr(box, "x", "" + x)
      dom_set_attr(box, "y", "" + y)
      dom_set_attr(box, "width", "80")
      dom_set_attr(box, "height", "30")
      dom_set_attr(box, "rx", "4")
      dom_set_attr(box, "fill", "#e0e7ff")
      dom_set_attr(box, "stroke", "#6366f1")
      dom_set_text(dom_append(box, dom_element("title")), t + ", checksum " + sum_of(sums, t))
      let name = dom_set_text(dom_append(g, dom_element("text")), t)
      dom_set_attr(name, "x", "" + (x + 40))
      dom_set_attr(name, "y", "" + (y + 20))
      dom_set_attr(name, "text-anchor", "middle")
      let i = i + 1
    end
    let k = k + 1
  end
  dom_set_text(dom_append(body, dom_element("p")), "" + count + " targets in " + list_len(waves) + " waves")
  return page
end

print("== what app needs, directly or not ==")
let needs = solve("needs", ["app", logic_var("D")])
let names = []
let i = 0
while i < list_len(needs) do
  if not has(names, needs[i][1]) then
    let names = list_push(names, needs[i][1])
  end
  let i = i + 1
end
print("  " + str_join(names, ", "))

print("== a build, interrupted after two waves ==")
build(topic, sums_on_disk(topic), 2)
print("  recorded on disk: " + list_len(sums_on_disk(topic)) + " targets")

print("== the build run again: it starts from what is on disk ==")
build(topic, sums_on_disk(topic), 0 - 1)
let all = sums_on_disk(topic)
print("  recorded on disk: " + list_len(all) + " targets")
print("  checksums: " + all)

print("== and once more, with nothing left to do ==")
build(topic, sums_on_disk(topic), 0 - 1)
queue_remove_topic(topic)

let args = argv()
if (list_len(args) == 2) and (args[0] == "--page") then
  write_file(args[1], dom_document_html(graph_page(all)))
end
