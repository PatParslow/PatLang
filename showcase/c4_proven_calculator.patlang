# Formulas over measured values, with answers that come with proof.
#
# Paradigms: syntax definitions, exact numbers and intervals, operator
# methods, and contracts.
#
# Measurements are written as a lab notebook writes them, "mass = 1250/1000
# +- 5/1000 kg", in a notation defined at the top of the file. Each one
# becomes a Measured value holding its nominal figure, exactly, and the
# interval it is known to lie in. Measured defines + - * and / as methods, so
# a formula is written as ordinary arithmetic and carries both through. Each
# operator's contract checks that the nominal result lies inside the result's
# interval, so every figure printed comes with bounds that have been checked,
# not estimated.

syntax LabNotebook {
    trigger: Keyword("measurements");
    tokens {
        Name(n) = regex("[a-z_]+", n);
        Num(v) = regex("[0-9]+", v);
        Slash = "/";
        Equals = "=";
        PlusMinus = "+-";
    }
    rule Reading {
        let name = expect Name;
        expect Equals;
        let top = expect Num;
        expect Slash;
        let bottom = expect Num;
        expect PlusMinus;
        let tol_top = expect Num;
        expect Slash;
        let tol_bottom = expect Num;
        let unit = expect Name;
        return rule_add("reading", [name, to_num(top) / to_num(bottom), to_num(tol_top) / to_num(tol_bottom), unit], []);
    }
}

class Measured {
  field nominal = 0
  field range = 0
  make a function called + takes self, other returns sum
    return measured_from(self.nominal + nominal_of(other), self.range + range_of(other))
  end
  make a function called - takes self, other returns diff
    return measured_from(self.nominal - nominal_of(other), self.range - range_of(other))
  end
  make a function called * takes self, other returns product
    return measured_from(self.nominal * nominal_of(other), self.range * range_of(other))
  end
  # Intervals have no division of their own: dividing by [c,d] is multiplying
  # by [1/d, 1/c], which is an interval only when [c,d] leaves out zero.
  make a function called / takes self, other returns quotient
    let d = range_of(other)
    require (interval_lo(d) > 0) or (interval_hi(d) < 0)
    let reciprocal = interval_make(1 / interval_hi(d), 1 / interval_lo(d))
    return measured_from(self.nominal / nominal_of(other), self.range * reciprocal)
  end
}

# A plain number in a formula is exact: its range is itself.
make a function called nominal_of takes x returns n
  if type_of(x) == "Measured" then
    return x.nominal
  end
  return x
end

make a function called range_of takes x returns r
  if type_of(x) == "Measured" then
    return x.range
  end
  return interval_make(x, x)
end

# The contract every result keeps: its nominal figure lies in its range.
make a function called measured_from takes nominal, range returns m
  require (interval_lo(range) <= nominal) and (nominal <= interval_hi(range))
  let m = new("Measured")
  m.nominal = nominal
  m.range = range
  ensure (interval_lo(m.range) <= m.nominal) and (m.nominal <= interval_hi(m.range))
  return m
end

make a function called reading takes name returns m
  let sols = solve("reading", [name, logic_var("V"), logic_var("T"), logic_var("U")])
  assert list_len(sols) == 1
  let v = sols[0][1]
  let t = sols[0][2]
  return measured_from(v, interval_make(v - t, v + t))
end

# x to four places: rounded to the nearest (way 0), down (way -1) or up (way
# 1). A bound is printed rounded outwards, so the printed range still holds.
make a function called decimal takes x, way returns text
  let n = floor(x * 10000 + 1 / 2)
  if way < 0 then
    let n = floor(x * 10000)
  elif way > 0 then
    let n = 0 - floor(0 - x * 10000)
  end
  let frac = "" + (n % 10000)
  let pad = ""
  if frac.length == 1 then
    let pad = "000"
  elif frac.length == 2 then
    let pad = "00"
  elif frac.length == 3 then
    let pad = "0"
  end
  return "" + floor(n / 10000) + "." + pad + frac
end

make a function called report takes label, m returns done
  print(label + ": " + decimal(m.nominal, 0) + ", certainly between " + decimal(interval_lo(m.range), -1) + " and " + decimal(interval_hi(m.range), 1))
  return true
end

measurements {
    mass = 1250/1000 +- 5/1000 kg
    speed = 340/100 +- 2/100 m_per_s
    drop = 2/1 +- 1/100 m
    g = 981/100 +- 1/100 m_per_s_squared
}

let mass = reading("mass")
let speed = reading("speed")
let drop = reading("drop")
let g = reading("g")

print("== readings ==")
report("mass (kg)", mass)
report("speed (m/s)", speed)

print("== formulas ==")
let kinetic = mass * speed * speed / 2
report("kinetic energy, m v^2 / 2 (J)", kinetic)
let potential = mass * g * drop
report("potential energy, m g h (J)", potential)
let total = kinetic + potential
report("their sum (J)", total)
print("the kinetic energy exactly: " + kinetic.nominal)
