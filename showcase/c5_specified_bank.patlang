# A bank account, specified, explored, implemented and tested.
#
# Paradigms: declared schemas, contracts, exact numbers, objects and
# executable specifications.
#
# The account is first specified as a schema: its state, what must always be
# true of it, and its operations with their preconditions and effects. The
# explorer visits every state the operations can reach and checks the
# invariants in each. A first version of the schema forgets that a withdrawal
# needs the money to be there; the explorer finds the shortest sequence of
# operations that breaks the invariant. The corrected schema explores clean.
#
# The account is then written as a class whose methods carry the corrected
# schema's preconditions and effects as require and ensure clauses, on exact
# amounts, and a Gherkin feature exercises it.

include "../self_hosting/lib/includes.patlang"
include "../self_hosting/lib/gherkin.patlang"
include "../self_hosting/lib/zs_explore.patlang"

make a function called schema_text takes checked returns text
  let guard = ""
  if checked then
    let guard = "  require balance >= amount" + chr(10)
  end
  return str_join([
    "schema Account",
    "state balance",
    "init balance = 0",
    "domain amount = set_of(20, 50)",
    "invariant balance >= 0",
    "invariant balance <= 100",
    "",
    "operation Deposit(amount)",
    "  require balance + amount <= 100",
    "  ensure balance' == balance + amount",
    "end",
    "",
    "operation Withdraw(amount)",
    guard + "  ensure balance' == balance - amount",
    "end",
    ""
  ], chr(10))
end

make a function called explore takes ctx, label, checked returns verdict
  let loaded = zs_load(ctx, schema_text(checked))
  assert loaded[0] == "ok"
  let r = zs_explore(ctx, "Account", 10000)
  print("== " + label + " ==")
  let lines = zs_format_exploration(r)
  let i = 0
  while i < list_len(lines) do
    print("  " + lines[i])
    let i = i + 1
  end
  return r[0]
end

# ---- the implementation, carrying the schema's clauses ----

class Account {
  field balance = 0
  make a function called deposit takes self, amount returns balance
    require (amount > 0) and (self.balance + amount <= 100)
    let before = self.balance
    self.balance = self.balance + amount
    let balance = self.balance
    ensure (balance == before + amount) and (balance >= 0) and (balance <= 100)
    return balance
  end
  make a function called withdraw takes self, amount returns balance
    require (amount > 0) and (self.balance >= amount)
    let before = self.balance
    self.balance = self.balance - amount
    let balance = self.balance
    ensure (balance == before - amount) and (balance >= 0)
    return balance
  end
}

make a function called st_account takes ctx returns ok
  let a = new("Account")
  ctx_set(ctx, "account", a)
  return true
end

make a function called st_deposit takes ctx returns ok
  let a = ctx_get(ctx, "account")
  a.deposit(to_num(step_arg(ctx, "n")))
  return true
end

make a function called st_withdraw takes ctx returns ok
  let a = ctx_get(ctx, "account")
  a.withdraw(to_num(step_arg(ctx, "n")))
  return true
end

make a function called st_balance takes ctx returns ok
  let a = ctx_get(ctx, "account")
  return expect(ctx, "the balance", "" + a.balance, step_arg(ctx, "n"))
end

let ctx = ctx_new()
explore(ctx, "the first schema: withdrawal unchecked", false)
explore(ctx, "the corrected schema", true)

print("== the implementation, against its feature ==")
let feature = str_join([
  "Feature: an account",
  "",
  "  Scenario: deposits add up exactly",
  "    Given a new account",
  "    When 20 is deposited",
  "    And 101/4 is deposited",
  "    Then the balance is 181/4",
  "",
  "  Scenario: a withdrawal takes away exactly what was asked",
  "    Given a new account",
  "    When 50 is deposited",
  "    And 1/3 is withdrawn",
  "    Then the balance is 149/3"
], chr(10))
step(ctx, "a new account", "st_account")
step(ctx, "{n} is deposited", "st_deposit")
step(ctx, "{n} is withdrawn", "st_withdraw")
step(ctx, "the balance is {n}", "st_balance")
run_feature(ctx, feature)
ctx_report(ctx)
