# A PIN check written the obvious way, and why it leaks.
#
# The loop stops at the first digit that differs, so a guess with the first
# digit right takes a little longer than one with it wrong. Timing many
# guesses finds the PIN a digit at a time. The digits are held as modints, so
# the compiler treats them as secret, and
#
#   v2.exe showcase/p10_ct_leaky.patlang --constant-time
#
# reports the branch that decides on them, naming pin_matches.

make a function called pin_matches takes pin, guess returns same
  let i = 0
  while i < list_len(pin) do
    if mod_make(pin[i], 10) != mod_make(guess[i], 10) then
      return false
    end
    let i = i + 1
  end
  return true
end

print(pin_matches([4, 7, 1, 9], [4, 7, 2, 0]))
