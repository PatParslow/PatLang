# A delivery robot that plans, acts, and plans again when the world changes.
#
# Paradigms: goal-oriented planning and events.
#
# The robot must carry a parcel from the dock to an office. It knows its
# actions (pick up, walk, go through a door, take the lift, hand over), each
# with what it needs, what it changes and what it costs, and it asks the
# planner for the cheapest way to "delivered". It then carries the plan out a
# step at a time.
#
# The building is not under its control. While the robot is in the hall, the
# building raises an event: the door to the office has been locked. A handler
# records the change and marks the plan stale; before its next step the robot
# notices, plans again from where it now is, and takes the slower lift. The
# planning code is the same both times; only the state it starts from has
# changed.

class Robot {
  field pos = 0
  field carrying = 0
  field delivered = 0
  field door_open = 1
  field stale = false
  field log = 0
}

# Where the robot is, as text.
make a function called place takes pos returns name
  match pos do
    case 0 then
      return "dock"
    case 1 then
      return "hall"
    case _ then
      return "office"
  end
end

# The planner's numbers, from the robot's state as it is now.
make a function called observe takes r returns done
  fluent_set("pos", r.pos)
  fluent_set("carrying", r.carrying)
  fluent_set("delivered", r.delivered)
  fluent_set("door_open", r.door_open)
  return true
end

make a function called replan takes r returns steps
  observe(r)
  r.stale = false
  let steps = plan_numeric([], [["delivered", "==", 1]])
  vec_push(r.log, "plan from the " + place(r.pos) + ": " + plan_labels(steps))
  return steps
end

let robot = new("Robot")
robot.log = vec_new()

# ---- the actions: needs, changes, cost ----

action_add_numeric("pick_up", [], [["pos", "==", 0], ["carrying", "==", 0]], [], [], [["carrying", "=", 1]], 1)
action_add_numeric("walk_to_hall", [], [["pos", "==", 0]], [], [], [["pos", "=", 1]], 2)
action_add_numeric("through_door", [], [["pos", "==", 1], ["door_open", "==", 1]], [], [], [["pos", "=", 2]], 1)
action_add_numeric("take_lift", [], [["pos", "==", 1]], [], [], [["pos", "=", 2]], 6)
action_add_numeric("hand_over", [], [["pos", "==", 2], ["carrying", "==", 1]], [], [], [["carrying", "=", 0], ["delivered", "=", 1]], 1)

# ---- what each action does when carried out ----

action_bind("pick_up", |args| do
  robot.carrying = 1
  return true
end)
action_bind("walk_to_hall", |args| do
  robot.pos = 1
  # the building, not the robot, decides this
  emit("door_locked", "office door")
  return true
end)
action_bind("through_door", |args| do
  robot.pos = 2
  return true
end)
action_bind("take_lift", |args| do
  robot.pos = 2
  return true
end)
action_bind("hand_over", |args| do
  robot.carrying = 0
  robot.delivered = 1
  return true
end)

# ---- the event: the world changed under the plan ----

when door_locked do
  robot.door_open = 0
  robot.stale = true
  vec_push(robot.log, "event: the " + event_data + " is locked")
end

# ---- act, a step at a time, replanning when the plan goes stale ----

let steps = replan(robot)
let i = 0
while robot.delivered == 0 do
  if robot.stale then
    let steps = replan(robot)
    let i = 0
  end
  let s = steps[i]
  activate([s])
  vec_push(robot.log, "did " + step_label(s) + ", now in the " + place(robot.pos))
  let i = i + 1
end

print(str_join(vec_to_list(robot.log), chr(10)))
print("delivered: " + (robot.delivered == 1))
