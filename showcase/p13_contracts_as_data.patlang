# A program that knows which of its own contracts have been checked.
#
# Paradigms: design by contract and logic programming.
#
# Each require and ensure clause that passes leaves a fact behind in the
# store named "contracts", contract_holds(function, clause), the clause
# written as "require:" or "ensure:" and its text as the runtime prints it,
# recorded once however often it passes. So
# a program can ask, with an ordinary query, which of its contracts have
# actually been exercised, and which functions have never been checked at
# all. Here a small stock-keeping module is exercised by a few calls, then
# reports its own contract coverage: every clause it has, and whether a run so
# far has checked it.

class Stock {
  field counts = 0
}

make a function called stock_new returns s
  let s = new("Stock")
  s.counts = vec_new()
  return s
end

# The count for an item, or 0.
make a function called count_of takes s, item returns n
  let i = 0
  while i < vec_len(s.counts) do
    let entry = vec_get(s.counts, i)
    if entry[0] == item then
      return entry[1]
    end
    let i = i + 1
  end
  return 0
end

make a function called set_count takes s, item, n returns done
  let i = 0
  while i < vec_len(s.counts) do
    let entry = vec_get(s.counts, i)
    if entry[0] == item then
      vec_set(s.counts, i, [item, n])
      return true
    end
    let i = i + 1
  end
  vec_push(s.counts, [item, n])
  return true
end

make a function called receive takes s, item, n returns total
  require n > 0
  let before = count_of(s, item)
  set_count(s, item, before + n)
  let total = count_of(s, item)
  ensure total == before + n
  return total
end

make a function called dispatch takes s, item, n returns total
  require (n > 0) and (n <= count_of(s, item))
  let before = count_of(s, item)
  set_count(s, item, before - n)
  let total = count_of(s, item)
  ensure (total == before - n) and (total >= 0)
  return total
end

make a function called write_off takes s, item returns lost
  require count_of(s, item) > 0
  let lost = count_of(s, item)
  set_count(s, item, 0)
  ensure count_of(s, item) == 0
  return lost
end

# The clauses each checked function has, in the form the facts record them:
# what coverage is measured against.
make a function called declared returns clauses
  return [
    ["receive", "require:n > 0"],
    ["receive", "ensure:total == before + n"],
    ["dispatch", "require:n > 0 and n <= count_of(s, item)"],
    ["dispatch", "ensure:total == before - n and total >= 0"],
    ["write_off", "require:count_of(s, item) > 0"],
    ["write_off", "ensure:count_of(s, item) == 0"]
  ]
end

make a function called contract_facts takes fn_name, clause returns found
  return solve_in(logic_store_named("contracts"), "contract_holds", [fn_name, clause])
end

make a function called checked takes fn_name, clause returns yes
  return list_len(contract_facts(fn_name, clause)) > 0
end

make a function called coverage_report returns covered
  let all = declared()
  let covered = 0
  let i = 0
  while i < list_len(all) do
    let mark = "never checked"
    if checked(all[i][0], all[i][1]) then
      let mark = "checked"
      let covered = covered + 1
    end
    print("  " + all[i][0] + ": " + all[i][1] + "  -- " + mark)
    let i = i + 1
  end
  print("  " + covered + " of " + list_len(all) + " clauses checked")
  return covered
end

let s = stock_new()
receive(s, "bolts", 40)
receive(s, "nuts", 25)
dispatch(s, "bolts", 15)

print("== coverage after receiving and dispatching ==")
coverage_report()

print("== the functions checked so far, asked directly ==")
let fns = contract_facts(logic_var("F"), logic_var("C"))
let names = []
let i = 0
while i < list_len(fns) do
  let n = fns[i][0]
  let seen = false
  let k = 0
  while k < list_len(names) do
    if names[k] == n then
      let seen = true
    end
    let k = k + 1
  end
  if not seen then
    let names = list_push(names, n)
  end
  let i = i + 1
end
print("  " + str_join(names, ", "))

print("== after a write-off ==")
write_off(s, "nuts")
coverage_report()
