# A loan and its schedule, to the penny.
#
# Paradigms: exact numbers and design by contract.
#
# A loan of 10,000 at 6% a year, repaid in 12 monthly payments. In PatLang the
# rate 6/100 is the fraction 3/50 exactly, not the nearest binary float to
# 0.06, and arithmetic on fractions stays exact. So the contracts can use ==
# where float code would need a tolerance: after the last payment the balance
# is zero, not "close to zero", and the rounded schedule pays back exactly what
# was lent plus exactly the interest it charged.
#
# The same schedule in floats is printed at the end, for comparison.

# ---- exact arithmetic ----

# x to the power n, for a whole n >= 0, by repeated multiplication: exact for
# any exact x.
make a function called power takes x, n returns p
  require n >= 0
  let p = 1
  let i = 0
  while i < n do
    let p = p * x
    let i = i + 1
  end
  return p
end

# The fixed monthly payment that repays principal over the given months:
# P r / (1 - (1 + r)^-n), with r the monthly rate.
make a function called monthly_payment takes principal, yearly_rate, months returns payment
  require (principal > 0) and (months > 0)
  let r = yearly_rate / 12
  let growth = power(1 + r, months)
  let payment = principal * r * growth / (growth - 1)
  ensure payment * months > principal
  return payment
end

# The exact schedule: each month's interest, and what is left. The contract is
# the point: after the last payment nothing is owed, exactly.
make a function called exact_balance_after takes principal, yearly_rate, months returns balance
  let r = yearly_rate / 12
  let payment = monthly_payment(principal, yearly_rate, months)
  let balance = principal
  let m = 0
  while m < months do
    let balance = balance + balance * r - payment
    let m = m + 1
  end
  ensure balance == 0
  return balance
end

# ---- money in pennies ----

# The nearest whole number to an exact x >= 0 (a half rounds up).
make a function called nearest takes x returns n
  return floor(x + 1 / 2)
end

make a function called money takes pennies returns text
  let pad = ""
  if pennies % 100 < 10 then
    let pad = "0"
  end
  return "" + floor(pennies / 100) + "." + pad + (pennies % 100)
end

# A number to the given places, rounded: for showing an exact value.
make a function called decimal takes x, places returns text
  let scale = power(10, places)
  let n = nearest(x * scale)
  let frac = sb_new()
  let digits = "" + (n % scale)
  let k = digits.length
  while k < places do
    sb_push(frac, "0")
    let k = k + 1
  end
  sb_push(frac, digits)
  return "" + floor(n / scale) + "." + sb_str(frac)
end

# The schedule as a bank prints it, in whole pennies: each month's interest is
# rounded to the penny, and the last payment is whatever clears the balance.
# Its contract: what was paid is exactly what was lent plus the interest
# charged, and nothing is left.
make a function called print_schedule takes principal, yearly_rate, months returns total_paid
  let r = yearly_rate / 12
  let payment = nearest(monthly_payment(principal, yearly_rate, months) * 100)
  let balance = principal * 100
  let total_paid = 0
  let total_interest = 0
  let m = 1
  while m <= months do
    let interest = nearest(balance * r)
    let pay = payment
    if m == months then
      let pay = balance + interest
    end
    let balance = balance + interest - pay
    let total_paid = total_paid + pay
    let total_interest = total_interest + interest
    print("  month " + m + ": interest " + money(interest) + ", paid " + money(pay) + ", owed " + money(balance))
    let m = m + 1
  end
  print("  paid " + money(total_paid) + " in all, of which interest " + money(total_interest))
  ensure (balance == 0) and (total_paid == principal * 100 + total_interest)
  return total_paid
end

# ---- the same in floats ----

make a function called float_balance_after takes principal, yearly_rate, months returns balance
  let r = yearly_rate / 12.0
  let growth = 1.0
  let i = 0
  while i < months do
    let growth = growth * (1.0 + r)
    let i = i + 1
  end
  let payment = principal * r * growth / (growth - 1.0)
  let balance = principal
  let m = 0
  while m < months do
    let balance = balance + balance * r - payment
    let m = m + 1
  end
  return balance
end

# ---- the loan ----

let principal = 10000
let rate = 6 / 100
let months = 12

print("== the rate ==")
print("6/100 is " + rate + ", a " + type_of(rate))
print("1/10 + 2/10 == 3/10: " + (1 / 10 + 2 / 10 == 3 / 10))
print("0.1 + 0.2 == 0.3: " + (0.1 + 0.2 == 0.3))

print("== the exact payment ==")
let exact = monthly_payment(principal, rate, months)
print("monthly payment, to 12 places: " + decimal(exact, 12))
print("owed after 12 exact payments: " + exact_balance_after(principal, rate, months))

print("== the schedule, in pennies ==")
print_schedule(principal, rate, months)

print("== the same in floats ==")
let left = float_balance_after(10000.0, 0.06, 12)
print("owed after 12 float payments: " + left)
print("is it zero? " + (left == 0.0))
