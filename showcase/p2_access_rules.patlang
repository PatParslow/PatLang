# Who may do what, and why.
#
# Paradigms: objects and logic programming.
#
# People, groups and documents are objects with methods, as anywhere. What the
# methods do is state facts: "ada owns the budget", "bob is in finance",
# "finance may edit the budget". Three rules then say what follows, including
# through delegation, and each answer comes with its reason: the rule that gave
# it and through whom. Adding a fact later changes the answers with no code
# changed; the policy itself is the three rules below.
#
# Given --page PATH, the program also writes the policy as it finally stands
# as a web page: a table of people against documents and actions, each cell
# holding its reason, filled by one query per column (lib/dom.patlang).

include "../self_hosting/lib/dom.patlang"

class Org {
  field store = 0
}

class Person {
  field name = ""
  field org = 0
  make a function called join takes self, group returns me
    rule_add_to(self.org.store, "member", [self.name, group.name], [])
    return self
  end
  make a function called owns takes self, doc returns me
    rule_add_to(self.org.store, "owns", [self.name, doc.name], [])
    return self
  end
  # Lets another person do on doc whatever this one may.
  make a function called delegate takes self, to, doc returns me
    require to.name != self.name
    rule_add_to(self.org.store, "delegate", [self.name, to.name, doc.name], [])
    return self
  end
}

class Group {
  field name = ""
  field org = 0
  make a function called grant takes self, action, doc returns me
    rule_add_to(self.org.store, "grant", [self.name, action, doc.name], [])
    return self
  end
}

class Document {
  field name = ""
}

make a function called new_org returns org
  let org = new("Org")
  org.store = logic_store_new()
  using org.store as logic do
    rule action(read).
    rule action(edit).
    rule action(share).
    # An owner may do anything to what they own.
    rule can(U, A, D, owner, U) :- owns(U, D), action(A).
    # A member may do what their group is granted.
    rule can(U, A, D, group, G) :- member(U, G), grant(G, A, D).
    # Whoever is delegated to may do what the delegator may.
    rule can(U, A, D, delegated, V) :- delegate(V, U, D), can(V, A, D, How, Via).
  end
  return org
end

make a function called person takes org, name returns p
  let p = new("Person")
  p.name = name
  p.org = org
  return p
end

make a function called group takes org, name returns g
  let g = new("Group")
  g.name = name
  g.org = org
  return g
end

make a function called document takes name returns d
  let d = new("Document")
  d.name = name
  return d
end

# Each person who may do action to doc, with the reason, one a line.
make a function called who_may takes org, action, doc returns n
  let sols = solve_in(org.store, "can", [logic_var("Who"), action, doc.name, logic_var("How"), logic_var("Via")])
  print("who may " + action + " the " + doc.name + ":")
  if list_len(sols) == 0 then
    print("  nobody")
  end
  let i = 0
  while i < list_len(sols) do
    let s = sols[i]
    print("  " + s[0] + ", as " + s[3] + " (" + s[4] + ")")
    let i = i + 1
  end
  return list_len(sols)
end

# Whether one person may, and if not, that no rule says so.
make a function called may takes org, who, action, doc returns yes
  let sols = solve_in(org.store, "can", [who.name, action, doc.name, logic_var("How"), logic_var("Via")])
  let yes = list_len(sols) > 0
  if yes then
    print(who.name + " may " + action + " the " + doc.name + ", as " + sols[0][3])
  else
    print(who.name + " may not " + action + " the " + doc.name + ": no rule gives it")
  end
  return yes
end

# ---- the page: everyone against every document and action ----

make a function called access_page takes org, people, docs, actions returns page
  let page = dom_page("Who may do what")
  let body = dom_body(page)
  dom_set_text(dom_append(body, dom_element("h1")), "Who may do what")
  let table = dom_append(body, dom_element("table"))
  let docs_row = dom_append(table, dom_element("tr"))
  let actions_row = dom_append(table, dom_element("tr"))
  dom_append(docs_row, dom_element("th"))
  dom_append(actions_row, dom_element("th"))
  let d = 0
  while d < list_len(docs) do
    let th = dom_set_text(dom_append(docs_row, dom_element("th")), docs[d].name)
    dom_set_attr(th, "colspan", "" + list_len(actions))
    let a = 0
    while a < list_len(actions) do
      dom_set_text(dom_append(actions_row, dom_element("th")), actions[a])
      let a = a + 1
    end
    let d = d + 1
  end
  # every cell starts as no
  let p = 0
  while p < list_len(people) do
    let row = dom_append(table, dom_element("tr"))
    dom_set_text(dom_append(row, dom_element("th")), people[p].name)
    let d2 = 0
    while d2 < list_len(docs) do
      let a2 = 0
      while a2 < list_len(actions) do
        let td = dom_set_text(dom_append(row, dom_element("td")), "no")
        dom_set_attr(td, "id", people[p].name + "-" + actions[a2] + "-" + docs[d2].name)
        dom_set_attr(td, "class", "no")
        let a2 = a2 + 1
      end
      let d2 = d2 + 1
    end
    let p = p + 1
  end
  # one query per column: everyone who may, with the first reason found
  let d3 = 0
  while d3 < list_len(docs) do
    let a3 = 0
    while a3 < list_len(actions) do
      let sols = solve_in(org.store, "can", [logic_var("Who"), actions[a3], docs[d3].name, logic_var("How"), logic_var("Via")])
      let s = 0
      while s < list_len(sols) do
        let td = dom_by_id(page, sols[s][0] + "-" + actions[a3] + "-" + docs[d3].name)
        if dom_has_class(td, "no") then
          dom_set_attr(td, "class", "yes")
          dom_set_text(td, sols[s][3] + " (" + sols[s][4] + ")")
        end
        let s = s + 1
      end
      let a3 = a3 + 1
    end
    let d3 = d3 + 1
  end
  return page
end

let org = new_org()
let ada = person(org, "ada")
let bob = person(org, "bob")
let carol = person(org, "carol")
let dan = person(org, "dan")
let finance = group(org, "finance")
let budget = document("budget")
let roadmap = document("roadmap")

ada.owns(budget)
bob.join(finance)
finance.grant("read", budget)
finance.grant("edit", budget)
dan.owns(roadmap)
dan.delegate(carol, roadmap)

print("== the policy, applied ==")
who_may(org, "edit", budget)
who_may(org, "share", roadmap)
may(org, carol, "edit", budget)

print("== carol joins finance ==")
carol.join(finance)
may(org, carol, "edit", budget)
who_may(org, "read", budget)

print("== ada delegates the budget to dan ==")
ada.delegate(dan, budget)
may(org, dan, "share", budget)

let args = argv()
if (list_len(args) == 2) and (args[0] == "--page") then
  let page = access_page(org, [ada, bob, carol, dan], [budget, roadmap], ["read", "edit", "share"])
  write_file(args[1], dom_document_html(page))
end
