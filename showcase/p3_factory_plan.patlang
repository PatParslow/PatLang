# A small factory, planned.
#
# Paradigms: goal-oriented planning and numbers.
#
# A workshop makes widgets: steel is cut into blanks, and a press turns a blank
# into a widget using power from a battery that must be charged. Steel can be
# bought, the press must be switched on first, and widgets can also be bought
# in, at a price. Each action says what it needs and what it changes, in facts
# ("the press is on") and in numbers ("steel >= 1", "power -= 2"). The planner
# finds the cheapest order of actions that reaches a goal such as "at least 3
# widgets". No step order is written anywhere in the program.
#
# The fluents are kept bounded (steel below 2 to buy more, power below 4 to
# charge), so the planner's search space is finite.
#
# Given --page PATH, the program also writes its plans as a web page: a row
# per goal, each step a cell coloured by its kind (lib/dom.patlang).

include "../self_hosting/lib/dom.patlang"

# What each action costs, as given to action_add below, to total a plan.
make a function called cost_of takes name returns c
  match name do
    case "switch_on" then
      return 1
    case "switch_off" then
      return 1
    case "buy_steel" then
      return 4
    case "cut" then
      return 1
    case "charge" then
      return 1
    case "press" then
      return 2
    case "buy_widget" then
      return 7
    case _ then
      return 0
  end
end

make a function called plan_cost takes steps returns total
  let total = 0
  let i = 0
  while i < list_len(steps) do
    let total = total + cost_of(step_name(steps[i]))
    let i = i + 1
  end
  return total
end

# What kind of step an action is, for the page's colours.
make a function called kind_of takes name returns kind
  if substr(name, 0, 4) == "buy_" then
    return "buy"
  end
  if (name == "cut") or (name == "press") then
    return "make"
  end
  return "machine"
end

# The page: a row per goal, its cost, then its steps.
make a function called plans_page takes plans returns page
  let page = dom_page("The factory's plans")
  let style = dom_append(dom_by_tag(page, "head")[0], dom_element("style"))
  dom_set_text(style, "td.machine { background: #bfdbfe } td.make { background: #bbf7d0 } td.buy { background: #fde68a }")
  let body = dom_body(page)
  dom_set_text(dom_append(body, dom_element("h1")), "The factory's plans")
  let table = dom_append(body, dom_element("table"))
  let head = dom_append(table, dom_element("tr"))
  dom_set_text(dom_append(head, dom_element("th")), "goal")
  dom_set_text(dom_append(head, dom_element("th")), "cost")
  dom_set_text(dom_append(head, dom_element("th")), "steps")
  let i = 0
  while i < vec_len(plans) do
    let goal = vec_get(plans, i)[0]
    let steps = vec_get(plans, i)[1]
    let row = dom_append(table, dom_element("tr"))
    dom_set_text(dom_append(row, dom_element("th")), goal)
    dom_set_attr(dom_set_text(dom_append(row, dom_element("td")), "" + plan_cost(steps)), "class", "cost")
    let j = 0
    while j < list_len(steps) do
      let name = step_name(steps[j])
      dom_set_attr(dom_set_text(dom_append(row, dom_element("td")), name), "class", kind_of(name))
      let j = j + 1
    end
    let i = i + 1
  end
  return page
end

# Prints the plan for goal, and keeps it for the page.
make a function called show_plan takes plans, goal, steps returns steps
  print("== " + goal + " ==")
  print(describe(steps))
  vec_push(plans, [goal, steps])
  return steps
end

make a function called describe takes steps returns text
  let total = plan_cost(steps)
  let noun = " steps: "
  if list_len(steps) == 1 then
    let noun = " step: "
  end
  return "cost " + total + ", " + list_len(steps) + noun + plan_labels(steps)
end

fluent_set("steel", 1)
fluent_set("blanks", 0)
fluent_set("power", 0)
fluent_set("widgets", 0)

# action_add_numeric(name, facts needed, numbers needed, facts added,
#                    facts removed, number changes, cost)
action_add("switch_on", [], [["on", ["press"]]], [], 1)
action_add_numeric("buy_steel", [], [["steel", "<", 2]], [], [], [["steel", "+=", 1]], 4)
action_add_numeric("cut", [], [["steel", ">=", 1]], [], [], [["steel", "-=", 1], ["blanks", "+=", 1]], 1)
action_add_numeric("charge", [], [["power", "<", 4]], [], [], [["power", "+=", 2]], 1)
action_add_numeric("press", [["on", ["press"]]], [["blanks", ">=", 1], ["power", ">=", 2]], [], [], [["blanks", "-=", 1], ["power", "-=", 2], ["widgets", "+=", 1]], 2)
action_add_numeric("buy_widget", [], [], [], [], [["widgets", "+=", 1]], 7)

# Making a widget from the steel in stock costs 5 (switch on, cut, charge,
# press); each further one needs steel bought first, 8, more than buying a
# widget in at 7. So the cheapest way to three makes one and buys two.
let plans = vec_new()
show_plan(plans, "one widget", plan_numeric([], [["widgets", ">=", 1]]))
show_plan(plans, "three widgets", plan_numeric([], [["widgets", ">=", 3]]))

# A fact goal and a number goal together: the plan must end with the press
# off, which needs an action that removes the fact.
action_add("switch_off", [["on", ["press"]]], [["off", ["press"]]], [["on", ["press"]]], 1)
show_plan(plans, "three widgets, and the press switched off again", plan_numeric([["off", ["press"]]], [["widgets", ">=", 3]]))

# The same actions from another starting state: making one would now cost 9,
# so the plan buys it in. Only the number changed.
fluent_set("steel", 0)
show_plan(plans, "one widget, starting with no steel", plan_numeric([], [["widgets", ">=", 1]]))

let args = argv()
if (list_len(args) == 2) and (args[0] == "--page") then
  write_file(args[1], dom_document_html(plans_page(plans)))
end
