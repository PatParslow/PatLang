# Answers with guaranteed bounds.
#
# Paradigms: interval arithmetic and design by contract.
#
# An interval is a number known only to lie between two bounds. Arithmetic on
# intervals gives an interval that contains every possible result, and with
# exact (rational) bounds nothing is lost to rounding on the way. Contracts
# then state what the bounds promise, and are checked on every call.
#
# Two uses: a measurement carried through a formula, with its error, and the
# square root of 2 squeezed between bounds until they are a millionth apart,
# with a contract at every step that the root really is between them.
#
# Given --page PATH, the program also draws the squeezing as a web page: each
# step's interval a bar in an SVG drawing, its exact bounds as the bar's
# title, narrowing on the float sqrt(2.0). SVG elements are nodes of the same
# tree as the rest of the page (lib/dom.patlang).

include "../self_hosting/lib/dom.patlang"

# ---- a measurement and its error ----

# A value measured to within plus or minus tol, as the interval it lies in.
make a function called measured takes value, tol returns iv
  require tol >= 0
  let iv = interval_make(value - tol, value + tol)
  ensure (interval_lo(iv) <= value) and (value <= interval_hi(iv))
  return iv
end

# The area of a rectangle and its perimeter, from measured sides.
make a function called area takes w, h returns a
  let a = w * h
  ensure interval_lo(a) <= interval_hi(a)
  return a
end

print("== a measured rectangle ==")
let w = measured(2, 1 / 100)
let h = measured(3, 1 / 100)
print("width " + w + ", height " + h)
let a = area(w, h)
print("area lies in " + a)
print("so the area is " + interval_lo(a) + " at least and " + interval_hi(a) + " at most")
print("perimeter lies in " + (w * 2 + h * 2))

# ---- the square root of 2, squeezed ----

# One bisection step on [lo, hi]: keeps the half where x*x - 2 changes sign.
# The contract is the claim being made: the root is in the new interval,
# which is checked exactly, by squaring the bounds.
make a function called narrow takes iv returns half
  require (interval_lo(iv) * interval_lo(iv) <= 2) and (interval_hi(iv) * interval_hi(iv) >= 2)
  let lo = interval_lo(iv)
  let hi = interval_hi(iv)
  let mid = (lo + hi) / 2
  let half = interval_make(mid, hi)
  if mid * mid > 2 then
    let half = interval_make(lo, mid)
  end
  ensure (interval_lo(half) * interval_lo(half) <= 2) and (interval_hi(half) * interval_hi(half) >= 2)
  return half
end

make a function called width takes iv returns w
  return interval_hi(iv) - interval_lo(iv)
end

# The page: [1, 2] drawn 400 wide, a bar 10 high for each interval in turn,
# and a line where the float sqrt(2.0) is.
make a function called squeeze_page takes seen, f returns page
  let page = dom_page("Squeezing the square root of 2")
  let body = dom_body(page)
  dom_set_text(dom_append(body, dom_element("h1")), "Squeezing the square root of 2")
  let height = "" + (vec_len(seen) * 10)
  let svg = dom_append(body, dom_element("svg"))
  dom_set_attr(svg, "width", "400")
  dom_set_attr(svg, "height", height)
  let k = 0
  while k < vec_len(seen) do
    let iv = vec_get(seen, k)
    let bar = dom_append(svg, dom_element("rect"))
    dom_set_attr(bar, "x", to_fixed((interval_lo(iv) - 1) * 400, 3))
    dom_set_attr(bar, "y", "" + (k * 10))
    dom_set_attr(bar, "width", to_fixed(width(iv) * 400, 3))
    dom_set_attr(bar, "height", "8")
    dom_set_attr(bar, "fill", "#60a5fa")
    dom_set_text(dom_append(bar, dom_element("title")), "" + iv)
    let k = k + 1
  end
  let x = to_fixed((f - 1) * 400, 3)
  let line = dom_append(svg, dom_element("line"))
  dom_set_attr(line, "x1", x)
  dom_set_attr(line, "y1", "0")
  dom_set_attr(line, "x2", x)
  dom_set_attr(line, "y2", height)
  dom_set_attr(line, "stroke", "#dc2626")
  let last = vec_get(seen, vec_len(seen) - 1)
  dom_set_text(dom_append(body, dom_element("p")), "after " + (vec_len(seen) - 1) + " steps the root lies in " + last)
  return page
end

print("== the square root of 2 ==")
let root = interval_make(1, 2)
let seen = vec_new()
vec_push(seen, root)
let steps = 0
while width(root) > 1 / 1000000 do
  let root = narrow(root)
  vec_push(seen, root)
  let steps = steps + 1
end
print("after " + steps + " steps the root lies in " + root)
print("width " + width(root) + ", under a millionth: " + (width(root) < 1 / 1000000))
let f = sqrt(2.0)
print("the float sqrt(2.0) = " + f + " lies inside: " + ((interval_lo(root) <= f) and (f <= interval_hi(root))))

# Interval arithmetic itself confirms the bracket: x*x - 2 evaluated over the
# whole interval contains zero.
let g = root * root - 2
print("x*x - 2 over the interval lies in " + g + ", which contains zero: " + ((interval_lo(g) <= 0) and (0 <= interval_hi(g))))

let args = argv()
if (list_len(args) == 2) and (args[0] == "--page") then
  write_file(args[1], dom_document_html(squeeze_page(seen, f)))
end
