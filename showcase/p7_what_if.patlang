# What if we changed the rules?
#
# Paradigms: worlds and logic programming.
#
# A course catalogue is a set of facts and rules: which course needs which
# first, and from those, what a student must have taken before each course.
# Proposed changes to the catalogue are tried one at a time, each in a world
# of its own: a world has its own facts, its own files and its own output, and
# nothing done inside it reaches the program. Each world loads the catalogue,
# applies one change and checks what must stay true. A change that breaks the
# catalogue is reported and thrown away with its world; one whose check fails
# outright stops only its world. The program's own catalogue is never touched,
# so there is nothing to undo.

# The catalogue, in whichever store is current: the program's, or a world's.
make a function called load_catalogue returns done
  rule needs(algorithms, programming).
  rule needs(databases, programming).
  rule needs(compilers, algorithms).
  rule needs(compilers, theory).
  rule needs(theory, discrete_maths).
  rule before(A, B) :- needs(A, B).
  rule before(A, C) :- needs(A, B), before(B, C).
  return true
end

make a function called has takes items, x returns yes
  let i = 0
  while i < list_len(items) do
    if items[i] == x then
      return true
    end
    let i = i + 1
  end
  return false
end

# The courses a course needs, directly or not, each once.
make a function called all_before takes course returns courses
  let sols = solve("before", [course, logic_var("X")])
  let courses = []
  let i = 0
  while i < list_len(sols) do
    if not has(courses, sols[i][1]) then
      let courses = list_push(courses, sols[i][1])
    end
    let i = i + 1
  end
  return courses
end

# A course that needs itself through a chain of needs, or "" for none. A
# walk over the needs facts, not the recursive before rule, which would never
# finish on a cycle.
make a function called course_in_cycle returns course
  let edges = solve("needs", [logic_var("A"), logic_var("B")])
  let i = 0
  while i < list_len(edges) do
    let start = edges[i][0]
    let seen = []
    let todo = [start]
    let pos = 0
    while pos < list_len(todo) do
      let at = todo[pos]
      let pos = pos + 1
      let k = 0
      while k < list_len(edges) do
        if edges[k][0] == at then
          if edges[k][1] == start then
            return start
          end
          if not has(seen, edges[k][1]) then
            let seen = list_push(seen, edges[k][1])
            let todo = list_push(todo, edges[k][1])
          end
        end
        let k = k + 1
      end
    end
    let i = i + 1
  end
  return ""
end

# A proposal: its name and the facts it adds, as [name, [[course, prereq], ...]].
# In its world: the catalogue, the change, then the checks. A cycle is a
# problem reported; a course needing more than four others breaks the
# faculty's rule, an assert, and stops the world.
make a function called try_change takes proposal returns verdict
  let w = world_new()
  let result = world_call(w, || do
    load_catalogue()
    let added = proposal[1]
    let i = 0
    while i < list_len(added) do
      rule_add("needs", added[i], [])
      let i = i + 1
    end
    let looped = course_in_cycle()
    if looped != "" then
      return ["a course needs itself: " + looped]
    end
    assert list_len(all_before("compilers")) <= 4
    return []
  end)
  world_free(w)
  let verdict = [proposal[0], result]
  return verdict
end

# A world's call gives ["done", what the code returned], here its list of
# problems, or ["stopped", the code it stopped with].
make a function called report takes verdict returns ok
  let result = verdict[1]
  if result[0] == "stopped" then
    print(verdict[0] + ": stopped inside its world (code " + result[1] + "), the program carries on")
    return false
  end
  let problems = result[1]
  if list_len(problems) == 0 then
    print(verdict[0] + ": fine")
    return true
  end
  print(verdict[0] + ": refused, " + str_join(problems, "; "))
  return false
end

load_catalogue()
print("== the catalogue ==")
print("compilers needs, directly or not: " + all_before("compilers"))

print("== proposals, each in its own world ==")
let proposals = [
  ["databases needs algorithms", [["databases", "algorithms"]]],
  ["programming needs compilers", [["programming", "compilers"]]],
  ["discrete_maths needs databases", [["discrete_maths", "databases"]]]
]
let i = 0
while i < list_len(proposals) do
  report(try_change(proposals[i]))
  let i = i + 1
end

print("== the program's catalogue afterwards ==")
print("does programming need compilers here? " + (list_len(solve("needs", ["programming", "compilers"])) > 0))
print("compilers needs, directly or not: " + all_before("compilers"))
