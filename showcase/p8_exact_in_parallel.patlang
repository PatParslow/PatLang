# Exact sums, in parallel, with the same answer every time.
#
# Paradigms: parallel functional code and exact numbers.
#
# The harmonic number H(n) = 1 + 1/2 + ... + 1/n is a fraction whose
# numerator and denominator grow to hundreds of digits. The sum is split into
# ranges, each range summed on its own thread by parallel_map, and the parts
# added. Fraction addition is exact and associative, so the result is the
# same to the last digit however the work is split: one part, two, four or
# eight. Floating-point sums split the same ways can differ in the last
# places, because float addition is not associative; that is shown at the end.

# The sum of 1/k for k from range[0] up to range[1] - 1, exactly.
make a function called partial_sum takes range returns s
  let s = 0
  let k = range[0]
  while k < range[1] do
    let s = s + 1 / k
    let k = k + 1
  end
  return s
end

# The same in floats.
make a function called partial_sum_float takes range returns s
  let s = 0.0
  let k = range[0]
  while k < range[1] do
    let s = s + 1.0 / k
    let k = k + 1
  end
  return s
end

# 1..n split into parts ranges of (nearly) equal length.
make a function called split takes n, parts returns ranges
  let ranges = []
  let p = 0
  while p < parts do
    let lo = 1 + floor(n * p / parts)
    let hi = 1 + floor(n * (p + 1) / parts)
    let ranges = list_push(ranges, [lo, hi])
    let p = p + 1
  end
  return ranges
end

make a function called total takes items returns s
  let s = items[0]
  let i = 1
  while i < list_len(items) do
    let s = s + items[i]
    let i = i + 1
  end
  return s
end

# The number of digits in a fraction's numerator: the text before its "/".
make a function called numerator_digits takes q returns d
  let text = "" + q
  let i = 0
  while i < text.length do
    if text[i] == "/" then
      return i
    end
    let i = i + 1
  end
  return text.length
end

let n = 3000
print("== H(" + n + ") exactly ==")
let answers = []
let parts = [1, 2, 4, 8]
let i = 0
while i < list_len(parts) do
  let h = total(parallel_map(split(n, parts[i]), "partial_sum"))
  let answers = list_push(answers, h)
  print("split into " + parts[i] + ": a fraction whose numerator has " + numerator_digits(h) + " digits")
  let i = i + 1
end
let same = true
let j = 1
while j < list_len(answers) do
  if answers[j] != answers[0] then
    let same = false
  end
  let j = j + 1
end
print("all four splits give the same fraction: " + same)
print("H(" + n + ") is about " + (answers[0] * 1.0))

print("== the same sums in floats ==")
let floats = []
let k = 0
while k < list_len(parts) do
  let f = total(parallel_map(split(n, parts[k]), "partial_sum_float"))
  let floats = list_push(floats, f)
  print("split into " + parts[k] + ": " + f)
  let k = k + 1
end
let fsame = true
let m = 1
while m < list_len(floats) do
  if floats[m] != floats[0] then
    let fsame = false
  end
  let m = m + 1
end
print("all four float splits agree: " + fsame)
