include "spreadsheet.patlang"

print("SHEET LOG:")
clear_sheet()
send("sheet", "set", "A1", "10")
send("sheet", "set", "B1", "=A1+5")

print("A1 raw: " + get("sheet", "A1"))
print("B1 raw: " + get("sheet", "B1"))

print("evaluating A1...")
let v1 = eval_cell("A1")
print("A1: " + v1)

print("evaluating B1...")
let v2 = eval_cell("B1")
print("B1: " + v2)
