include "../self_hosting/lib/json.patlang"

let input_str = "{\"cells\":{\"A1\":\"10\",\"B1\":\"=A1+5\"},\"max_col\":2,\"max_row\":2}"
print("Input string: " + input_str)

let root = json_parse(input_str)
print("Root type: " + root[0])

let cells_obj = json_get(root, "cells")
print("Cells type: " + cells_obj[0])

let cells_pairs = cells_obj[1]
print("Cells length: " + cells_pairs.length)

let i = 0
while i < cells_pairs.length do
  let pair = cells_pairs[i]
  print("Cell: " + pair[0] + " = " + json_str(pair[1]))
  let i = i + 1
end

let max_col = json_num(json_get(root, "max_col"))
print("max_col: " + max_col)
