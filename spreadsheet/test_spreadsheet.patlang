include "spreadsheet.patlang"

print("Starting debug test...")
let input_str = "{\"cells\":{\"A1\":\"10\",\"B1\":\"=A1+5\"},\"max_col\":2,\"max_row\":2}"
print("Input string: " + input_str)

clear_sheet()
let root = json_parse(input_str)
print("Root parsed type: " + root[0])

let cells_obj = json_get(root, "cells")
print("Cells parsed type: " + cells_obj[0])

let cells_pairs = cells_obj[1]
print("Cells length: " + cells_pairs.length)

let i = 0
while i < cells_pairs.length do
  let pair = cells_pairs[i]
  let name = pair[0]
  let val_node = pair[1]
  let val = json_str(val_node)
  print("Cell " + name + " = " + val)
  send("sheet", "set", name, val)
  let i = i + 1
end

print("Evaluating cells...")
let vA1 = eval_cell("A1")
print("Evaluated A1: " + vA1)

let vB1 = eval_cell("B1")
print("Evaluated B1: " + vB1)
