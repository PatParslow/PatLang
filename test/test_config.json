{
  "coverage": {
    "targets": {
      "default": {
        "line": 90,
        "branch": 90
      },
      "components": {
        "AST Nodes": {
          "line": 90,
          "branch": 90,
          "file_pattern": "ast_nodes.rb"
        },
        "Lexer": {
          "line": 90,
          "branch": 90,
          "file_pattern": "lexer.rb"
        },
        "Token": {
          "line": 90,
          "branch": 90,
          "file_pattern": "token.rb"
        },
        "Parser": {
          "line": 90,
          "branch": 90,
          "file_pattern": "parser*.rb"
        },
        "Evaluator": {
          "line": 90,
          "branch": 90,
          "file_pattern": "evaluator*.rb"
        },
        "Object Model": {
          "line": 90,
          "branch": 90,
          "file_pattern": "object_model*.rb"
        },
        "Reasoning": {
          "line": 90,
          "branch": 90,
          "file_pattern": "reasoning*.rb"
        }
      }
    },
    "thresholds": {
      "minimum_line": 70,
      "minimum_branch": 60,
      "warning_line": 80,
      "warning_branch": 75
    },
    "reporting": {
      "output_directory": "test/coverage",
      "formats": ["html", "json", "simple"],
      "save_reports": true,
      "command_name": "PatLang Test Suite"
    }
  },
  "test_categories": {
    "phase_1": {
      "name": "Phase 1 - Foundation Components",
      "description": "Core foundation testing for AST, Lexer, and Token components",
      "test_files": [
        "test/core/test_ast_nodes_comprehensive.rb",
        "test/core/test_lexer_comprehensive.rb"
      ],
      "source_files": [
        "src/ast_nodes.rb",
        "src/lexer.rb",
        "src/token.rb"
      ],
      "coverage_targets": {
        "AST Nodes": 90,
        "Lexer": 90,
        "Token": 90
      }
    },
    "infrastructure": {
      "name": "Infrastructure Components",
      "description": "Core infrastructure including parser, evaluator, and utilities",
      "test_directory": "test/infrastructure",
      "source_patterns": [
        "src/parser*.rb",
        "src/evaluator*.rb",
        "src/facts_database*.rb",
        "src/unification_engine*.rb"
      ]
    },
    "patlang_language": {
      "name": "PatLang Language Features",
      "description": "Language-specific features and functionality",
      "test_directory": "test/patlang_language",
      "source_patterns": [
        "src/evaluator*.rb",
        "src/object_model*.rb",
        "src/reasoning*.rb"
      ]
    },
    "ruby_implementation": {
      "name": "Ruby Implementation",
      "description": "Ruby-specific implementation details",
      "test_directory": "test/ruby_implementation",
      "source_patterns": [
        "src/evaluator*.rb",
        "src/object_model*.rb"
      ]
    },
    "branch_coverage": {
      "name": "Branch Coverage Tests",
      "description": "Specialized tests for branch coverage improvement",
      "test_directory": "test/branch_coverage",
      "focus_on_branches": true
    },
    "integration": {
      "name": "Integration Tests",
      "description": "End-to-end integration testing",
      "test_directory": "test/integration",
      "timeout_multiplier": 2.0
    }
  },
  "timeouts": {
    "default_test_timeout": 30,
    "integration_test_timeout": 60,
    "branch_coverage_timeout": 45,
    "phase_test_timeout": 120,
    "global_timeout_multiplier": 1.0
  },
  "discovery": {
    "auto_discover_tests": true,
    "test_file_patterns": [
      "test/**/test_*.rb",
      "test/**/*_test.rb"
    ],
    "exclude_patterns": [
      "test/helpers/**",
      "test/**/temp_*.rb",
      "test/**/*_backup*.rb"
    ]
  },
  "simplecov": {
    "filters": [
      "/test/",
      "/examples/",
      "/archive/",
      "/tools/",
      "/docs/"
    ],
    "groups": {
      "Core Components": ["src/ast_nodes.rb", "src/lexer.rb", "src/token.rb"],
      "Parser": "src/parser",
      "Evaluator": "src/evaluator",
      "Object Model": "src/object_model",
      "Reasoning": "src/reasoning",
      "Utilities": "src/utils"
    },
    "track_files": "src/**/*.rb",
    "enable_branch_coverage": true
  },
  "environment": {
    "allow_environment_overrides": true,
    "environment_variables": {
      "CI_MIN_COVERAGE": "Minimum coverage percentage for CI",
      "CI_MIN_BRANCH_COVERAGE": "Minimum branch coverage percentage for CI",
      "TEST_TIMEOUT": "Global test timeout override",
      "COVERAGE_DIR": "Coverage output directory override",
      "DISABLE_COVERAGE": "Disable coverage collection entirely"
    }
  },
  "validation": {
    "require_all_components": true,
    "fail_on_missing_files": false,
    "warn_on_low_coverage": true,
    "generate_recommendations": true
  },
  "metadata": {
    "version": "1.0.0",
    "created": "2025-06-17",
    "description": "Comprehensive test configuration for PatLang test infrastructure",
    "maintainer": "PatLang Development Team"
  }
}