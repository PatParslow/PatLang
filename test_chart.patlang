chart = html_element_with_content("div",{"class":"chart-container"},html_element_with_content("h3",{},"Priority Distribution")+html_element_with_content("canvas",{"id":"priority-chart","width":"400","height":"200"},"")+script_tag("var c=document.getElementById('priority-chart');var x=c.getContext('2d');var d={critical:1,high:2,medium:1,low:1};var t=5;sx=200;sy=100;r=80;sa=-1.57;var l=['Critical','High','Medium','Low'];var v=[1,2,1,1];var cl=['#e74c3c','#e67e22','#f39c12','#27ae60'];v.forEach(function(n,i){a=(n/t)*6.28;x.beginPath();x.moveTo(sx,sy);x.arc(sx,sy,r,sa,sa+a);x.closePath();x.fillStyle=cl[i];x.fill();ma=sa+a/2;lx=sx+Math.cos(ma)*(r+20);ly=sy+Math.sin(ma)*(r+20);x.fillStyle='#333';x.font='12px sans-serif';x.textAlign='center';x.fillText(l[i]+' ('+n+')',lx,ly);sa+=a;});x.font='11px sans-serif';x.textAlign='left';l.forEach(function(k,i){y=20+i*20;x.fillStyle=cl[i];x.fillRect(320,y,12,12);x.fillStyle='#333';x.fillText(k+': '+v[i],340,y+9);});"))
print(chart)