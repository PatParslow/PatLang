make a function called is_even takes: x {
  return x % 2 == 0
}

make a function called filter takes: f, list {
  if list == [] then
    return []
  else if call f with list[0] then
    return [list[0]] + call filter with f, list[1:]
  else
    return call filter with f, list[1:]
  end
}

print(call filter with is_even, [1, 2, 3, 4, 5, 6])