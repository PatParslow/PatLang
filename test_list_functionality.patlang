# Test basic list functionality
empty = make_empty_list()
print("Empty list created")
print(empty.is_empty())

# Create a simple list
list1 = make_list(1, make_empty_list())
print("List with one element created")
print(list1.head().value)
print(list1.tail().is_empty())

# Create a longer list
list2 = make_list(1, make_list(2, make_list(3, make_empty_list())))
print("List with multiple elements created")
print(list2.to_array())