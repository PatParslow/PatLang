# Test native Patlang functional programming with "make a function called..." syntax

make a function called double takes: x {
  return x * 2
}

print("Testing native functional programming...")

# Test the double function
result1 = call double with 5
print("Double of 5:")
print(result1)

# Create a simple list using native list functions
list1 = call make_list with 10, call make_empty_list
print("Created list with 10:")
print(list1.to_array())

# Test list methods
is_empty_result = list1.is_empty()
print("Is list empty?")
print(is_empty_result)

head_result = list1.head()
print("Head of list:")
print(head_result.value)

print("Native functional programming working!")