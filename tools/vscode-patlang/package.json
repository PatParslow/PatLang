{
    "name": "patlang-syntax",
    "displayName": "Patlang Language Support",
    "description": "Syntax highlighting for the Patlang programming language",
    "version": "0.2.1",
    "publisher": "patlang",
    "engines": {
        "vscode": "^1.74.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "keywords": [
        "patlang",
        "programming language",
        "interpreter"
    ],
    "contributes": {
        "languages": [
            {
                "id": "patlang",
                "aliases": [
                    "Patlang",
                    "patlang"
                ],
                "extensions": [
                    ".pat",
                    ".patlang"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "patlang",
                "scopeName": "source.patlang",
                "path": "./syntaxes/patlang.tmLanguage.json"
            }
        ]
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/patlang/patlang"
    }
}
